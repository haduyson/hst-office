#. hstMacroFormat
#: include/sfx2/strings.hrc
msgctxt "STR_HST_MACRO_FORMAT_TITLE"
msgid "Save a Document with Macros"
msgstr "Lưu tài liệu có macro"

#. hstMacroFormat
#: include/sfx2/strings.hrc
msgctxt "STR_HST_MACRO_FORMAT_TEXT"
msgid "This document has macros (VBA or Basic), but the format %FORMATNAME cannot keep them. If you save in this format, the saved file has no macros."
msgstr "Tài liệu này có macro (VBA hoặc Basic), nhưng định dạng %FORMATNAME không giữ được macro. Nếu lưu ở định dạng này, tệp được lưu sẽ không có macro."

#. hstMacroFormat
#: include/sfx2/strings.hrc
msgctxt "STR_HST_MACRO_FORMAT_HINT"
msgid "To keep the macros, choose the format %FORMATNAME."
msgstr "Để giữ macro, hãy chọn định dạng %FORMATNAME."

#. hstMacroFormat
#: include/sfx2/strings.hrc
msgctxt "STR_HST_MACRO_FORMAT_LOSE"
msgid "Save without Macros"
msgstr "Lưu không có macro"

#. hstMacroFormat
#: include/sfx2/strings.hrc
msgctxt "STR_HST_MACRO_FORMAT_BACK"
msgid "Choose Another Format"
msgstr "Chọn định dạng khác"

#. hstMacroEdits
#: include/sfx2/strings.hrc
msgctxt "STR_HST_MACRO_EDITS_TEXT"
msgid "You edited the macros of this document, but this Word format keeps the original VBA project from the file: your macro edits will not be saved in it. To keep the edits, choose an OpenDocument format such as .odt."
msgstr "Bạn đã sửa macro của tài liệu này, nhưng định dạng Word này giữ nguyên dự án VBA gốc trong tệp: phần sửa macro sẽ không được lưu vào tệp. Để giữ phần sửa, hãy chọn định dạng OpenDocument như .odt."

#. hstMacroEdits
#: include/sfx2/strings.hrc
msgctxt "STR_HST_MACRO_EDITS_EXCEL"
msgid "You edited the macros of this workbook, but it has VBA UserForms, which HST Office cannot yet write in a form Excel can load. So this format keeps the original VBA project from the file: your macro edits will not be saved in it. To keep the edits, choose an OpenDocument format such as .ods."
msgstr "Bạn đã sửa macro của sổ tính này, nhưng sổ tính có biểu mẫu VBA (UserForm) mà HST Office chưa ghi được để Excel mở. Vì vậy định dạng này giữ nguyên dự án VBA gốc trong tệp: phần sửa macro sẽ không được lưu vào tệp. Để giữ phần sửa, hãy chọn định dạng OpenDocument như .ods."

#. hstMacroEdits
#: include/sfx2/strings.hrc
msgctxt "STR_HST_MACRO_EDITS_LOSE"
msgid "Save without the Macro Edits"
msgstr "Lưu, bỏ phần sửa macro"

