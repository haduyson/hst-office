#. hstFindInDocument
#: include/sfx2/strings.hrc
msgctxt "STR_HST_FIND_IN_DOCUMENT"
msgid "Find “%1” in the document"
msgstr "Tìm “%1” trong tài liệu"

#. hstOleCannotEdit
#: include/sfx2/strings.hrc
msgctxt "STR_HST_OLE_CANNOT_EDIT"
msgid "This embedded object cannot be opened for editing: the program that made it (for example MathType for a MathType formula) is not installed on this computer, or this system cannot run Windows OLE objects.\nThe object still shows and prints as it is."
msgstr "Không mở được đối tượng nhúng này để chỉnh sửa: máy tính chưa cài chương trình đã tạo ra nó (ví dụ MathType với công thức MathType), hoặc hệ điều hành này không chạy được đối tượng OLE của Windows.\nĐối tượng vẫn hiển thị và in như cũ."

#. hstRibbonPin
#: include/sfx2/strings.hrc
msgctxt "STR_HST_RIBBON_PIN"
msgid "Pin the Toolbar (Ctrl+F1)"
msgstr "Ghim thanh công cụ (Ctrl+F1)"

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:AVMediaPlayer"
msgid "Open the player to play audio and video."
msgstr "Mở trình phát để nghe nhạc và xem phim."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:AVMediaToolBox"
msgid "Play, pause or stop the selected audio or video."
msgstr "Phát, tạm dừng hoặc dừng âm thanh, video đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:About"
msgid "See the version and information about HST Office."
msgstr "Xem phiên bản và thông tin về HST Office."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:AboveSpacing"
msgid "Change the space above the paragraph."
msgstr "Đổi khoảng cách phía trên đoạn văn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:AcceptAllTrackedChanges"
msgid "Keep every tracked change in the document."
msgstr "Chấp nhận mọi thay đổi đã theo dõi trong tài liệu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:AcceptChanges"
msgid "Review the tracked changes and accept or reject each one."
msgstr "Xem lại các thay đổi đã theo dõi để chấp nhận hoặc từ chối từng cái."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:AcceptTrackedChange"
msgid "Keep this change."
msgstr "Chấp nhận thay đổi này."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:AcceptTrackedChangeToNext"
msgid "Keep this change and go to the next one."
msgstr "Chấp nhận thay đổi này và chuyển sang thay đổi kế tiếp."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:AcceptTrackedChanges"
msgid "Review the tracked changes and accept or reject each one."
msgstr "Xem lại các thay đổi đã theo dõi để chấp nhận hoặc từ chối từng cái."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:AddName"
msgid "Give a name to a cell or range to use it in formulas."
msgstr "Đặt tên cho ô hoặc vùng ô để dùng trong công thức."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:AddPrintArea"
msgid "Add the selected cells to the print range."
msgstr "Thêm các ô đang chọn vào vùng in."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:AdvancedMode"
msgid "Rotate, skew or distort the selected object."
msgstr "Xoay, nghiêng hoặc bóp méo đối tượng đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:AlignBlock"
msgid "Spread the text evenly across the cell width."
msgstr "Căn đều chữ theo bề rộng của ô."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:AlignBottom"
msgid "Put the content at the bottom of the cell."
msgstr "Đặt nội dung sát cạnh dưới của ô."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:AlignCenter"
msgid "Center the selected objects horizontally."
msgstr "Căn giữa các đối tượng đang chọn theo chiều ngang."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:AlignDown"
msgid "Line up the bottom edges of the selected objects."
msgstr "Căn thẳng cạnh dưới của các đối tượng đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:AlignHorizontalCenter"
msgid "Center the content horizontally in the cell."
msgstr "Căn giữa nội dung theo chiều ngang trong ô."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:AlignLeft"
msgid "Align the content to the left of the cell."
msgstr "Căn nội dung sang trái ô."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:AlignMiddle"
msgid "Center the selected objects vertically."
msgstr "Căn giữa các đối tượng đang chọn theo chiều dọc."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:AlignRight"
msgid "Align the content to the right of the cell."
msgstr "Căn nội dung sang phải ô."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:AlignTop"
msgid "Put the content at the top of the cell."
msgstr "Đặt nội dung sát cạnh trên của ô."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:AlignUp"
msgid "Line up the top edges of the selected objects."
msgstr "Căn thẳng cạnh trên của các đối tượng đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:AlignVCenter"
msgid "Center the content vertically in the cell."
msgstr "Căn giữa nội dung theo chiều dọc trong ô."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:AnalysisOfVarianceDialog"
msgid "Compare the means of several groups of data (ANOVA)."
msgstr "So sánh giá trị trung bình của nhiều nhóm dữ liệu (ANOVA)."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:AnchorMenu"
msgid "Choose what the object is attached to: page, paragraph or character."
msgstr "Chọn chỗ neo đối tượng: trang, đoạn văn hoặc ký tự."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:AnimationEffects"
msgid "Set what happens when an object is clicked during the show."
msgstr "Đặt việc sẽ xảy ra khi bấm vào đối tượng lúc trình chiếu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ArrowShapes"
msgid "Draw a block arrow."
msgstr "Vẽ một mũi tên khối."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ArrowsToolbox"
msgid "Draw a line or an arrow."
msgstr "Vẽ đường thẳng hoặc mũi tên."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:AssignMacro"
msgid "Run a macro when this object is clicked."
msgstr "Chạy một macro khi bấm vào đối tượng này."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:AutoControlFocus"
msgid "Put the cursor in the first form control when the form opens."
msgstr "Đưa con trỏ vào điều khiển đầu tiên khi mở biểu mẫu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:AutoFormat"
msgid "Apply a ready-made style to the table."
msgstr "Áp dụng một kiểu có sẵn cho bảng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:AutoSum"
msgid "Add up the numbers above or to the left of the cell."
msgstr "Cộng các số phía trên hoặc bên trái ô."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:AutomaticCalculation"
msgid "Recalculate formulas automatically after every change."
msgstr "Tự động tính lại công thức sau mỗi thay đổi."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:BackgroundColor"
msgid "Fill the background with a colour."
msgstr "Tô màu nền."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:BasicIDEAppear"
msgid "Open the editor to write and change macros."
msgstr "Mở trình soạn thảo để viết và sửa macro."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:BasicShapes"
msgid "Draw a basic shape such as a rectangle or a circle."
msgstr "Vẽ hình cơ bản như hình chữ nhật, hình tròn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:BasicShapes.ellipse"
msgid "Draw an ellipse or a circle."
msgstr "Vẽ hình elip hoặc hình tròn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:BasicShapes.rectangle"
msgid "Draw a rectangle or a square."
msgstr "Vẽ hình chữ nhật hoặc hình vuông."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:BelowSpacing"
msgid "Change the space below the paragraph."
msgstr "Đổi khoảng cách phía dưới đoạn văn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:BezierFill"
msgid "Draw a closed curve filled with colour."
msgstr "Vẽ một hình cong khép kín có tô màu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Bezier_Unfilled"
msgid "Draw a smooth curved line."
msgstr "Vẽ một đường cong trơn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:BorderDialog"
msgid "Add a border around the page."
msgstr "Thêm viền quanh trang."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Break"
msgid "Split the selected object into separate parts."
msgstr "Tách đối tượng đang chọn thành các phần riêng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:BringToFront"
msgid "Put the selected object in front of all others."
msgstr "Đặt đối tượng đang chọn lên trên cùng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:BrowseView"
msgid "Show the document as a web page, without page breaks."
msgstr "Xem tài liệu như một trang web, không chia trang."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:CalcPageMargin"
msgid "Choose the margins of the printed page."
msgstr "Chọn lề của trang in."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:CalcPageSize"
msgid "Choose the paper size for printing."
msgstr "Chọn khổ giấy để in."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Calculate"
msgid "Recalculate all formulas now."
msgstr "Tính lại mọi công thức ngay bây giờ."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:CalculatedFieldRun"
msgid "Insert or edit a field calculated from other fields."
msgstr "Chèn hoặc sửa trường được tính từ các trường khác."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:CalloutShapes"
msgid "Draw a speech bubble or another callout."
msgstr "Vẽ khung lời thoại hoặc khung chú dẫn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:CapturePoint"
msgid "Add a guide line or point that objects snap to."
msgstr "Thêm đường hoặc điểm gióng để đối tượng bám vào."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:CellVertBottom"
msgid "Put the text at the bottom of the cell."
msgstr "Đặt chữ sát cạnh dưới của ô."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:CellVertCenter"
msgid "Center the text vertically in the cell."
msgstr "Căn giữa chữ theo chiều dọc trong ô."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:CellVertTop"
msgid "Put the text at the top of the cell."
msgstr "Đặt chữ sát cạnh trên của ô."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ChainFrames"
msgid "Let text flow from this frame into another."
msgstr "Cho chữ chảy tiếp từ khung này sang khung khác."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ChangeCaseRotateCase"
msgid "Switch the selection between sentence case, upper case and lower case."
msgstr "Đổi chữ đang chọn qua lại giữa viết hoa đầu câu, chữ hoa, chữ thường."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ChangePicture"
msgid "Replace the picture but keep its size and position."
msgstr "Thay ảnh khác nhưng giữ nguyên cỡ và vị trí."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ChangeTheme"
msgid "Switch between the light and dark appearance."
msgstr "Chuyển qua lại giữa giao diện sáng và tối."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:CharBackColor"
msgid "Highlight the text with a colour."
msgstr "Tô sáng chữ bằng một màu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:CharFontName"
msgid "Choose a font for the text."
msgstr "Chọn phông chữ cho văn bản."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:CharmapControl"
msgid "Insert a symbol or a character not on the keyboard."
msgstr "Chèn ký hiệu hoặc ký tự không có trên bàn phím."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:CheckBox"
msgid "Add a check box to the form."
msgstr "Thêm ô đánh dấu vào biểu mẫu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ChiSquareTestDialog"
msgid "Test whether two sets of data are related (chi-square)."
msgstr "Kiểm tra hai bộ dữ liệu có liên quan nhau không (khi bình phương)."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ChooseDesign"
msgid "Apply a colour and font theme to the spreadsheet."
msgstr "Áp dụng chủ đề màu và phông chữ cho bảng tính."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ClearArrows"
msgid "Remove all the arrows that trace formulas."
msgstr "Xóa mọi mũi tên dò công thức."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ClearContents"
msgid "Clear the contents of the selected cells."
msgstr "Xóa nội dung của các ô đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:CloseMasterView"
msgid "Go back to editing the slides."
msgstr "Quay lại sửa các trang chiếu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ClosePreview"
msgid "Close the print preview."
msgstr "Đóng chế độ xem trước khi in."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Color"
msgid "Change the colour of the text."
msgstr "Đổi màu chữ."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ColorSettings"
msgid "Show the colour palette to fill objects."
msgstr "Hiện bảng màu để tô đối tượng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ColumnWidth"
msgid "Set an exact width for the selected columns."
msgstr "Đặt bề rộng chính xác cho các cột đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Combine"
msgid "Combine the selected shapes into one shape."
msgstr "Kết hợp các hình đang chọn thành một hình."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ComboBox"
msgid "Add a box where the user types or picks from a list."
msgstr "Thêm ô cho phép gõ hoặc chọn từ danh sách."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:CompareDocuments"
msgid "Compare this document with another version and see what changed."
msgstr "So sánh tài liệu với một bản khác để thấy chỗ thay đổi."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:CompressGraphic"
msgid "Make the picture smaller in file size."
msgstr "Giảm dung lượng của ảnh."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ConditionalFormatMenu"
msgid "Format cells automatically according to their values."
msgstr "Tự động định dạng ô theo giá trị trong ô."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Connect"
msgid "Join the selected lines into one line."
msgstr "Nối các đường đang chọn thành một đường."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ConnectorToolbox"
msgid "Draw a connector line that stays attached to shapes."
msgstr "Vẽ đường nối luôn bám theo các hình."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ContentControlProperties"
msgid "Change the settings of the selected content control."
msgstr "Đổi thiết lập của điều khiển nội dung đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ContourDialog"
msgid "Edit the outline that text wraps around."
msgstr "Sửa đường bao để chữ chạy quanh đối tượng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ControlCodes"
msgid "Show or hide paragraph marks, spaces and other hidden marks."
msgstr "Hiện hoặc ẩn dấu đoạn văn, dấu cách và các ký hiệu ẩn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ControlProperties"
msgid "Change the settings of the selected form control."
msgstr "Đổi thiết lập của điều khiển biểu mẫu đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ConvertTableToText"
msgid "Turn the table into plain text."
msgstr "Chuyển bảng thành văn bản thường."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:CorrelationDialog"
msgid "Measure how strongly two sets of data are related."
msgstr "Đo mức tương quan giữa hai bộ dữ liệu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:CovarianceDialog"
msgid "Measure how two sets of data vary together."
msgstr "Đo mức hai bộ dữ liệu cùng biến thiên."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:CreateNames"
msgid "Create names for ranges from the row or column labels."
msgstr "Tạo tên vùng từ nhãn của hàng hoặc cột."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:CrookSlant"
msgid "Bend the selected object along a circle."
msgstr "Uốn đối tượng đang chọn theo một đường tròn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Crop"
msgid "Cut off the parts of the picture you don't need."
msgstr "Cắt bỏ phần ảnh không cần."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:CurrencyField"
msgid "Add a field for money amounts to the form."
msgstr "Thêm ô nhập số tiền vào biểu mẫu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:CustomShowDialog"
msgid "Choose which slides to show and in what order."
msgstr "Chọn trang chiếu sẽ trình chiếu và thứ tự của chúng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DataConsolidate"
msgid "Combine data from several ranges into one table."
msgstr "Gộp dữ liệu từ nhiều vùng vào một bảng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DataFilterHideAutoFilter"
msgid "Hide the filter buttons of the selected range."
msgstr "Ẩn các nút lọc của vùng đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DataFilterSpecialFilter"
msgid "Filter with conditions written in other cells."
msgstr "Lọc dữ liệu theo điều kiện ghi ở các ô khác."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DataFilterStandardFilter"
msgid "Filter the rows that meet the conditions you set."
msgstr "Lọc các hàng thỏa điều kiện bạn đặt."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DataInColumns"
msgid "Take the chart series from the columns."
msgstr "Lấy chuỗi dữ liệu của biểu đồ theo cột."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DataInRows"
msgid "Take the chart series from the rows."
msgstr "Lấy chuỗi dữ liệu của biểu đồ theo hàng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DataPilotFilter"
msgid "Filter the data shown in the pivot table."
msgstr "Lọc dữ liệu hiện trong bảng tổng hợp."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DataProvider"
msgid "Load data from a file or a web address into a range."
msgstr "Nạp dữ liệu từ tệp tin hoặc địa chỉ web vào vùng ô."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DataProviderRefresh"
msgid "Load the latest data from the data source again."
msgstr "Nạp lại dữ liệu mới nhất từ nguồn dữ liệu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DataRanges"
msgid "Choose the cells the chart takes its data from."
msgstr "Chọn các ô mà biểu đồ lấy dữ liệu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DataStreams"
msgid "Fill cells from a data stream that keeps updating."
msgstr "Điền ô từ một luồng dữ liệu liên tục cập nhật."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DateField"
msgid "Add a date field to the form."
msgstr "Thêm ô nhập ngày vào biểu mẫu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DecrementIndent"
msgid "Move the paragraph closer to the margin."
msgstr "Đưa đoạn văn lùi về gần lề."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DefineDBName"
msgid "Name a range so it can be sorted and filtered as a table."
msgstr "Đặt tên cho vùng dữ liệu để sắp xếp và lọc như một bảng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DefinePrintArea"
msgid "Print only the selected cells."
msgstr "Chỉ in các ô đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Delete"
msgid "Choose what to clear from the cells: contents, formats or comments."
msgstr "Chọn phần cần xóa khỏi ô: nội dung, định dạng hoặc chú thích."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DeleteAllAnnotation"
msgid "Delete every comment in the document."
msgstr "Xóa mọi chú thích trong tài liệu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DeleteAllBreaks"
msgid "Remove all manual page breaks."
msgstr "Bỏ mọi ngắt trang đặt bằng tay."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DeleteAllNotes"
msgid "Delete every comment in the sheet."
msgstr "Xóa mọi chú thích trong trang tính."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DeleteAnnotation"
msgid "Delete the selected comment."
msgstr "Xóa chú thích đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DeleteCell"
msgid "Delete the selected cells and move the others to fill the gap."
msgstr "Xóa các ô đang chọn và dồn các ô còn lại vào chỗ trống."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DeleteColumnbreak"
msgid "Remove the manual column break."
msgstr "Bỏ ngắt cột đặt bằng tay."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DeleteColumns"
msgid "Delete the selected columns."
msgstr "Xóa các cột đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DeleteComment"
msgid "Delete the selected comment."
msgstr "Xóa chú thích đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DeleteMasterPage"
msgid "Delete the selected master."
msgstr "Xóa trang cái đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DeleteNote"
msgid "Delete the comments of the selected cells."
msgstr "Xóa chú thích của các ô đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DeletePage"
msgid "Delete the current page."
msgstr "Xóa trang hiện tại."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DeletePivotTable"
msgid "Delete the selected pivot table."
msgstr "Xóa bảng tổng hợp đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DeletePrintArea"
msgid "Remove the print range and print the whole sheet."
msgstr "Bỏ vùng in để in cả trang tính."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DeleteRowbreak"
msgid "Remove the manual row break."
msgstr "Bỏ ngắt hàng đặt bằng tay."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DeleteRows"
msgid "Delete the selected rows."
msgstr "Xóa các hàng đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DeleteTable"
msgid "Delete the whole table."
msgstr "Xóa toàn bộ bảng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DescriptiveStatisticsDialog"
msgid "Get the mean, median, spread and other figures of the data."
msgstr "Tính trung bình, trung vị, độ phân tán và các số liệu khác."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DesignerDialog"
msgid "Show every style in the side panel."
msgstr "Hiện mọi kiểu trong ngăn bên."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DiagramArea"
msgid "Format the background area of the chart."
msgstr "Định dạng vùng nền của biểu đồ."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DiagramData"
msgid "Show or edit the data table of the chart."
msgstr "Hiện hoặc sửa bảng dữ liệu của biểu đồ."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DiagramType"
msgid "Change the type of the chart, such as column, line or pie."
msgstr "Đổi loại biểu đồ, ví dụ cột, đường hoặc tròn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DiagramWall"
msgid "Format the wall behind the chart data."
msgstr "Định dạng mặt tường phía sau dữ liệu biểu đồ."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Dismantle"
msgid "Split the combined shape back into its parts."
msgstr "Tách hình đã kết hợp trở lại thành các phần."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DisplayMasterBackground"
msgid "Show or hide the master's background on this slide."
msgstr "Hiện hoặc ẩn nền của trang cái trên trang chiếu này."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DisplayMasterObjects"
msgid "Show or hide the master's objects on this slide."
msgstr "Hiện hoặc ẩn đối tượng của trang cái trên trang chiếu này."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DistributeColumns"
msgid "Make the selected columns the same width."
msgstr "Làm các cột đang chọn rộng bằng nhau."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DistributeRows"
msgid "Make the selected rows the same height."
msgstr "Làm các hàng đang chọn cao bằng nhau."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DistributeSelection"
msgid "Space three or more objects evenly."
msgstr "Giãn đều khoảng cách giữa ba đối tượng trở lên."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DrawCaption"
msgid "Draw a callout that points to something."
msgstr "Vẽ khung chú dẫn chỉ vào một chỗ."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DrawText"
msgid "Draw a text box."
msgstr "Vẽ một hộp văn bản."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:DuplicatePage"
msgid "Make a copy of the current page."
msgstr "Tạo một bản sao của trang hiện tại."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Edit"
msgid "Add a text box to the form."
msgstr "Thêm ô nhập chữ vào biểu mẫu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:EditAnnotation"
msgid "Edit the selected comment."
msgstr "Sửa chú thích đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:EditDoc"
msgid "Switch between reading and editing the document."
msgstr "Chuyển qua lại giữa chế độ đọc và chế độ sửa."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:EditGlossary"
msgid "Save and insert text you use often."
msgstr "Lưu và chèn đoạn chữ hay dùng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:EditHeaderAndFooter"
msgid "Edit the headers and footers of the printed pages."
msgstr "Sửa đầu trang và chân trang của trang in."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:EditLinks"
msgid "See and update the links to other files."
msgstr "Xem và cập nhật các liên kết tới tệp tin khác."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:EditPrintArea"
msgid "Set the print range and the rows or columns repeated on every page."
msgstr "Đặt vùng in và hàng, cột lặp lại trên mỗi trang."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:EndPara"
msgid "Align the paragraph to the right."
msgstr "Căn đoạn văn sang phải."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:EnterGroup"
msgid "Enter the group to edit its objects one by one."
msgstr "Vào trong nhóm để sửa từng đối tượng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:EntireCell"
msgid "Select the whole table cell."
msgstr "Chọn cả ô của bảng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:EntireColumn"
msgid "Select the whole column."
msgstr "Chọn cả cột."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:EntireRow"
msgid "Select the whole row."
msgstr "Chọn cả hàng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:EqualizeHeight"
msgid "Make the selected objects the same height."
msgstr "Làm các đối tượng đang chọn cao bằng nhau."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:EqualizeWidth"
msgid "Make the selected objects the same width."
msgstr "Làm các đối tượng đang chọn rộng bằng nhau."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ExtensionManager"
msgid "Add, update or remove extensions."
msgstr "Thêm, cập nhật hoặc gỡ phần mở rộng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Extrusion3DColor"
msgid "Change the colour of the 3D sides."
msgstr "Đổi màu các mặt 3D."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ExtrusionDepthFloater"
msgid "Change how deep the 3D shape looks."
msgstr "Đổi độ sâu của hình 3D."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ExtrusionDirectionFloater"
msgid "Change the direction the 3D shape faces."
msgstr "Đổi hướng nhìn của hình 3D."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ExtrusionSurfaceFloater"
msgid "Change the surface of the 3D shape, such as matte or metal."
msgstr "Đổi bề mặt hình 3D, ví dụ mờ hoặc kim loại."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ExtrusionToggle"
msgid "Turn the 3D effect of the shape on or off."
msgstr "Bật hoặc tắt hiệu ứng 3D của hình."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:FTestDialog"
msgid "Compare the spread of two sets of data (F-test)."
msgstr "So sánh độ phân tán của hai bộ dữ liệu (kiểm định F)."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:FileControl"
msgid "Add a box for choosing a file to the form."
msgstr "Thêm ô chọn tệp tin vào biểu mẫu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:FillDown"
msgid "Copy the top cell into the selected cells below it."
msgstr "Chép ô trên cùng xuống các ô đang chọn bên dưới."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:FillLeft"
msgid "Copy the rightmost cell into the selected cells to its left."
msgstr "Chép ô bên phải nhất sang các ô đang chọn bên trái."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:FillPageColor"
msgid "Fill the page background with a colour."
msgstr "Tô màu nền trang."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:FillRight"
msgid "Copy the leftmost cell into the selected cells to its right."
msgstr "Chép ô bên trái nhất sang các ô đang chọn bên phải."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:FillSeries"
msgid "Fill the cells with a series of numbers or dates."
msgstr "Điền vào ô một dãy số hoặc ngày tăng dần."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:FillShadow"
msgid "Add a shadow to the selected object."
msgstr "Thêm bóng đổ cho đối tượng đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:FillStyle"
msgid "Choose how the object is filled: colour, gradient, picture or none."
msgstr "Chọn cách tô đối tượng: màu, chuyển sắc, ảnh hoặc không tô."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:FillTable"
msgid "Copy the selected cells to the same place on other sheets."
msgstr "Chép các ô đang chọn sang cùng vị trí ở trang tính khác."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:FillUp"
msgid "Copy the bottom cell into the selected cells above it."
msgstr "Chép ô dưới cùng lên các ô đang chọn bên trên."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:FirstPage"
msgid "Go to the first page."
msgstr "Tới trang đầu tiên."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:FlipHorizontal"
msgid "Flip the selected object from left to right."
msgstr "Lật đối tượng đang chọn từ trái sang phải."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:FlipVertical"
msgid "Flip the selected object upside down."
msgstr "Lật ngược đối tượng đang chọn từ trên xuống dưới."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:FlowChartShapes"
msgid "Draw a flowchart shape."
msgstr "Vẽ một hình của lưu đồ."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:FontDialog"
msgid "Open all the font settings: font, size, effects and spacing."
msgstr "Mở mọi thiết lập phông chữ: phông, cỡ, hiệu ứng và giãn cách."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:FontHeight"
msgid "Change the size of the text."
msgstr "Đổi cỡ chữ."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:FontworkAlignmentFloater"
msgid "Align the decorative text."
msgstr "Căn chỉnh chữ nghệ thuật."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:FontworkCharacterSpacingFloater"
msgid "Change the spacing between the letters of the decorative text."
msgstr "Đổi khoảng cách giữa các chữ của chữ nghệ thuật."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:FontworkGalleryFloater"
msgid "Insert decorative text."
msgstr "Chèn chữ trang trí."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:FontworkSameLetterHeights"
msgid "Make all letters of the decorative text the same height."
msgstr "Làm mọi chữ của chữ nghệ thuật cao bằng nhau."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:FontworkShapeType"
msgid "Change the shape the decorative text follows."
msgstr "Đổi hình dáng mà chữ nghệ thuật uốn theo."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:FootnoteDialog"
msgid "Set how footnotes and endnotes are numbered and placed."
msgstr "Đặt cách đánh số và vị trí ghi chú, chú thích cuối."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:FormProperties"
msgid "Change the settings of the form."
msgstr "Đổi thiết lập của biểu mẫu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:FormatArea"
msgid "Fill the object with a colour, gradient, picture or pattern."
msgstr "Tô đối tượng bằng màu, chuyển sắc, ảnh hoặc hoa văn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:FormatCellDialog"
msgid "Open all the cell settings, such as number, font and borders."
msgstr "Mở mọi thiết lập của ô như số, phông chữ và đường viền."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:FormatDropcap"
msgid "Make the first letter of the paragraph large."
msgstr "Phóng to chữ cái đầu của đoạn văn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:FormatGroup"
msgid "Group the selected objects so they move together."
msgstr "Gộp các đối tượng đang chọn thành nhóm để di chuyển cùng nhau."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:FormatLine"
msgid "Change the style, colour and width of the line."
msgstr "Đổi kiểu, màu và độ dày của đường."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:FormatSelection"
msgid "Format the selected part of the chart."
msgstr "Định dạng phần biểu đồ đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:FormatUngroup"
msgid "Split the group into separate objects."
msgstr "Tách nhóm thành các đối tượng riêng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:FormattedField"
msgid "Add a field that shows numbers in a set format."
msgstr "Thêm ô hiện số theo định dạng đã đặt."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:FourierAnalysisDialog"
msgid "Break the data down into frequencies (Fourier analysis)."
msgstr "Phân tích dữ liệu thành các tần số (phân tích Fourier)."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:FrameDialog"
msgid "Change the size, position, borders and wrap of the selected object."
msgstr "Đổi cỡ, vị trí, viền và cách chữ bao quanh đối tượng đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:FrameLineColor"
msgid "Change the colour of the borders."
msgstr "Đổi màu đường viền."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Freeline"
msgid "Draw a freehand shape filled with colour."
msgstr "Vẽ tay một hình có tô màu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Freeline_Unfilled"
msgid "Draw a freehand line."
msgstr "Vẽ tay một đường tự do."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:FullScreen"
msgid "Show only the document on the whole screen."
msgstr "Chỉ hiện tài liệu trên toàn màn hình."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:FunctionBox"
msgid "Show the list of functions in the side panel."
msgstr "Hiện danh sách hàm ở ngăn bên."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Gallery"
msgid "Insert clip art and media from the gallery."
msgstr "Chèn hình mẫu và tệp đa phương tiện từ thư viện."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:GoToEndOfDoc"
msgid "Go to the end of the document."
msgstr "Tới cuối tài liệu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:GoToStartOfDoc"
msgid "Go to the start of the document."
msgstr "Về đầu tài liệu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:GoToStartOfPage"
msgid "Go to the start of the page."
msgstr "Tới đầu trang."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:GrafContrast"
msgid "Change the contrast of the picture."
msgstr "Đổi độ tương phản của ảnh."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:GrafGamma"
msgid "Change the gamma of the picture to lighten or darken the midtones."
msgstr "Đổi gamma của ảnh để làm sáng hoặc tối vùng màu trung gian."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:GrafLuminance"
msgid "Change the brightness of the picture."
msgstr "Đổi độ sáng của ảnh."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:GrafMode"
msgid "Show the picture in colour, grey, black and white or as a watermark."
msgstr "Hiện ảnh màu, xám, đen trắng hoặc dạng hình mờ."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:GrafTransparence"
msgid "Make the picture partly transparent."
msgstr "Làm ảnh trong suốt một phần."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:GraphicDialog"
msgid "Change the size, position, crop and borders of the picture."
msgstr "Đổi cỡ, vị trí, phần cắt và viền của ảnh."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:GraphicFilterToolbox"
msgid "Apply an effect to the picture, such as sharpen or blur."
msgstr "Áp dụng hiệu ứng cho ảnh, ví dụ làm nét hoặc làm mờ."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Grid"
msgid "Add a table control to the form."
msgstr "Thêm điều khiển bảng vào biểu mẫu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:GridUse"
msgid "Make objects snap to the grid when moved."
msgstr "Cho đối tượng bám vào lưới khi di chuyển."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:GridVisible"
msgid "Show or hide the grid."
msgstr "Hiện hoặc ẩn lưới."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Group"
msgid "Group the selected rows or columns so they can be collapsed."
msgstr "Nhóm các hàng hoặc cột đang chọn để thu gọn được."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:GroupBox"
msgid "Add a frame that groups form controls."
msgstr "Thêm khung để nhóm các điều khiển biểu mẫu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Grow"
msgid "Make the text a little bigger."
msgstr "Tăng cỡ chữ một chút."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:HandoutMode"
msgid "Edit the layout of the printed handouts."
msgstr "Sửa bố cục của bản phát tay khi in."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:HangingIndent"
msgid "Indent every line of the paragraph except the first."
msgstr "Thụt lề mọi dòng của đoạn văn trừ dòng đầu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:HeaderAndFooter"
msgid "Add the date, footer text and slide numbers."
msgstr "Thêm ngày, chữ chân trang và số trang chiếu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:HeadingRowsRepeat"
msgid "Repeat the heading rows at the top of every page."
msgstr "Lặp lại hàng tiêu đề ở đầu mỗi trang."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:HelpIndex"
msgid "Open the help."
msgstr "Mở trợ giúp."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:HelplinesMove"
msgid "Show guide lines while moving an object."
msgstr "Hiện đường gióng khi di chuyển đối tượng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:HelplinesUse"
msgid "Make objects snap to the guide lines."
msgstr "Cho đối tượng bám vào đường gióng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:HelplinesVisible"
msgid "Show or hide the guide lines."
msgstr "Hiện hoặc ẩn đường gióng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Hide"
msgid "Hide the selected sheet."
msgstr "Ẩn trang tính đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:HideAllNotes"
msgid "Hide all comments in the sheet."
msgstr "Ẩn mọi chú thích trong trang tính."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:HideColumn"
msgid "Hide the selected columns."
msgstr "Ẩn các cột đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:HideDetail"
msgid "Collapse the selected group to hide its rows or columns."
msgstr "Thu gọn nhóm đang chọn để ẩn các hàng hoặc cột."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:HideRow"
msgid "Hide the selected rows."
msgstr "Ẩn các hàng đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:HstDifferentFirstPage"
msgid "Use another header and footer on the first page."
msgstr "Dùng đầu trang, chân trang khác cho trang đầu tiên."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:HstDifferentOddEven"
msgid "Use different headers and footers on odd and even pages."
msgstr "Dùng đầu trang, chân trang khác nhau cho trang chẵn và trang lẻ."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:HstPictureStyles"
msgid "Apply a ready-made frame, border or shadow to the picture."
msgstr "Áp dụng khung, viền hoặc bóng có sẵn cho ảnh."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:HstRotatePageLeft"
msgid "Rotate the page 90° to the left."
msgstr "Xoay trang 90° sang trái."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:HstRotatePageRight"
msgid "Rotate the page 90° to the right."
msgstr "Xoay trang 90° sang phải."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:HstTableStyles"
msgid "Apply a ready-made style to the table."
msgstr "Áp dụng một kiểu có sẵn cho bảng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Hyphenate"
msgid "Break long words at the line ends with hyphens."
msgstr "Ngắt từ dài ở cuối dòng bằng dấu gạch nối."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ImageControl"
msgid "Add a picture box to the form."
msgstr "Thêm ô hiện ảnh vào biểu mẫu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Imagebutton"
msgid "Add a button with a picture to the form."
msgstr "Thêm nút có hình vào biểu mẫu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ImportFromFile"
msgid "Insert pages from another file."
msgstr "Chèn các trang từ tệp tin khác."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:IncrementIndent"
msgid "Move the paragraph further from the margin."
msgstr "Đẩy đoạn văn thụt vào xa lề hơn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InputLineVisible"
msgid "Show or hide the formula bar."
msgstr "Hiện hoặc ẩn thanh công thức."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Insert"
msgid "Add a new sheet."
msgstr "Thêm trang tính mới."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertAVMedia"
msgid "Insert an audio or video file."
msgstr "Chèn tệp âm thanh hoặc video."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertAuthorField"
msgid "Insert the author's name."
msgstr "Chèn tên tác giả."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertBookmark"
msgid "Mark a place in the document so you can jump to it."
msgstr "Đánh dấu một chỗ trong tài liệu để nhảy tới nhanh."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertBreak"
msgid "Insert a line, column or page break."
msgstr "Chèn ngắt dòng, ngắt cột hoặc ngắt trang."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertCell"
msgid "Insert cells and move the others aside."
msgstr "Chèn ô và đẩy các ô khác sang bên."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertCheckboxContentControl"
msgid "Insert a check box the reader can tick."
msgstr "Chèn hộp kiểm để người đọc tích chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertColumnBreak"
msgid "Start a new column from the selected cell."
msgstr "Sang cột in mới từ ô đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertColumnsAfter"
msgid "Insert a column to the right."
msgstr "Chèn một cột bên phải."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertColumnsBefore"
msgid "Insert a column to the left."
msgstr "Chèn một cột bên trái."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertComboBoxContentControl"
msgid "Insert a box where the reader types or picks from a list."
msgstr "Chèn ô để người đọc gõ hoặc chọn từ danh sách."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertContentControl"
msgid "Insert a box the reader fills with formatted text."
msgstr "Chèn ô để người đọc nhập chữ có định dạng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertCurrentDate"
msgid "Insert today's date in the cell."
msgstr "Chèn ngày hôm nay vào ô."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertCurrentTime"
msgid "Insert the current time in the cell."
msgstr "Chèn giờ hiện tại vào ô."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertDateAndTime"
msgid "Insert the date and time on the slide."
msgstr "Chèn ngày và giờ vào trang chiếu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertDateContentControl"
msgid "Insert a box where the reader picks a date."
msgstr "Chèn ô để người đọc chọn ngày."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertDateField"
msgid "Insert today's date; it does not change later."
msgstr "Chèn ngày hôm nay, không tự đổi về sau."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertDateFieldVar"
msgid "Insert the date; it updates each time the file opens."
msgstr "Chèn ngày, tự cập nhật mỗi lần mở tệp tin."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertDropdownContentControl"
msgid "Insert a list the reader picks one item from."
msgstr "Chèn danh sách để người đọc chọn một mục."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertEndnote"
msgid "Add a note at the end of the document."
msgstr "Thêm chú thích ở cuối tài liệu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertEnvelope"
msgid "Create an envelope with the addresses."
msgstr "Tạo phong bì có địa chỉ người gửi và người nhận."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertExternalDataSource"
msgid "Insert data from another file or a web page."
msgstr "Chèn dữ liệu từ tệp tin khác hoặc trang web."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertFieldCtrl"
msgid "Insert a field such as the page number, date or title."
msgstr "Chèn trường như số trang, ngày hoặc tiêu đề."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertFormula"
msgid "Insert a formula into a table cell."
msgstr "Chèn công thức vào ô của bảng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertIndexesEntry"
msgid "Mark the selected word for the index."
msgstr "Đánh dấu từ đang chọn để đưa vào chỉ mục."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertLabels"
msgid "Create pages of address labels."
msgstr "Tạo trang nhãn in địa chỉ."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertLinebreak"
msgid "Start a new line in the same paragraph."
msgstr "Xuống dòng mới trong cùng đoạn văn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertMasterPage"
msgid "Add a new master."
msgstr "Thêm trang cái mới."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertMath"
msgid "Insert a mathematical formula."
msgstr "Chèn công thức toán học."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertMenuAxes"
msgid "Show or hide the axes of the chart."
msgstr "Hiện hoặc ẩn các trục của biểu đồ."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertMenuDataLabels"
msgid "Show the values on the chart's data points."
msgstr "Hiện giá trị trên các điểm dữ liệu của biểu đồ."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertMenuGrids"
msgid "Show or hide the grid lines of the chart."
msgstr "Hiện hoặc ẩn đường lưới của biểu đồ."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertMenuLegend"
msgid "Choose where the chart legend goes."
msgstr "Chọn vị trí chú giải của biểu đồ."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertMenuTitles"
msgid "Add titles to the chart and its axes."
msgstr "Thêm tiêu đề cho biểu đồ và các trục."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertMenuTrendlines"
msgid "Add a trend line to the data series."
msgstr "Thêm đường xu hướng cho chuỗi dữ liệu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertName"
msgid "Use a named range in the formula."
msgstr "Dùng một vùng đã đặt tên trong công thức."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertObject"
msgid "Insert an object from another program."
msgstr "Chèn đối tượng từ chương trình khác."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertObjectStarMath"
msgid "Insert a mathematical formula."
msgstr "Chèn công thức toán học."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertPage"
msgid "Add a new page after the current one."
msgstr "Thêm trang mới sau trang hiện tại."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertPageField"
msgid "Insert the page number."
msgstr "Chèn số trang."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertPageFooter"
msgid "Add or remove the footer of the page."
msgstr "Thêm hoặc bỏ chân trang."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertPageHeader"
msgid "Add or remove the header of the page."
msgstr "Thêm hoặc bỏ đầu trang."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertPagesField"
msgid "Insert the total number of pages."
msgstr "Chèn tổng số trang."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertPictureContentControl"
msgid "Insert a box where the reader adds a picture."
msgstr "Chèn ô để người đọc thêm ảnh."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertPlainTextContentControl"
msgid "Insert a box the reader fills with plain text."
msgstr "Chèn ô để người đọc nhập chữ thường."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertReferenceField"
msgid "Refer to a heading, figure or table elsewhere in the document."
msgstr "Dẫn chiếu tới đề mục, hình hoặc bảng ở chỗ khác trong tài liệu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertRowBreak"
msgid "Start a new printed page from the selected row."
msgstr "Sang trang in mới từ hàng đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertRowDialog"
msgid "Insert rows into the table."
msgstr "Chèn hàng vào bảng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertRowsAfter"
msgid "Insert a row below."
msgstr "Chèn một hàng bên dưới."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertRowsBefore"
msgid "Insert a row above."
msgstr "Chèn một hàng bên trên."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertSignatureLine"
msgid "Add a line where the document can be signed."
msgstr "Thêm dòng chữ ký để ký vào tài liệu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertSlideField"
msgid "Insert the slide number."
msgstr "Chèn số trang chiếu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertSparkline"
msgid "Draw a tiny chart inside a cell."
msgstr "Vẽ biểu đồ nhỏ ngay trong ô."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:InsertTimeFieldVar"
msgid "Insert the time; it updates each time the file opens."
msgstr "Chèn giờ, tự cập nhật mỗi lần mở tệp tin."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Intersect"
msgid "Keep only the area where the selected shapes overlap."
msgstr "Chỉ giữ phần các hình đang chọn chồng lên nhau."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Italic"
msgid "Make the text italic."
msgstr "Làm chữ nghiêng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:JumpToFooter"
msgid "Move the cursor to the footer."
msgstr "Đưa con trỏ xuống chân trang."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:JumpToHeader"
msgid "Move the cursor to the header."
msgstr "Đưa con trỏ lên đầu trang."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:JumpToSpecificPage"
msgid "Go to the page with the number you enter."
msgstr "Tới trang có số bạn nhập."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:JustifyPara"
msgid "Justify the paragraph."
msgstr "Căn đều hai bên đoạn văn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Label"
