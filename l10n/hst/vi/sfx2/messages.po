msgstr "Thêm nhãn chữ vào biểu mẫu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:LastPage"
msgid "Go to the last page."
msgstr "Tới trang cuối cùng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:LeaveGroup"
msgid "Leave the group you are editing."
msgstr "Thoát khỏi nhóm đang sửa."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:LeftPaneDraw"
msgid "Show or hide the page thumbnails."
msgstr "Hiện hoặc ẩn hình thu nhỏ của các trang."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:LeftPaneImpress"
msgid "Show or hide the slide thumbnails."
msgstr "Hiện hoặc ẩn hình thu nhỏ của các trang chiếu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:LeftParaMargin"
msgid "Change the indent of the paragraph from the left margin."
msgstr "Đổi khoảng thụt lề trái của đoạn văn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Legend"
msgid "Show, hide or format the chart legend."
msgstr "Hiện, ẩn hoặc định dạng chú giải của biểu đồ."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Line"
msgid "Draw a straight line."
msgstr "Vẽ một đường thẳng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:LineArrowEnd"
msgid "Draw a line that ends with an arrow."
msgstr "Vẽ đường thẳng có mũi tên ở cuối."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:LineEndStyle"
msgid "Choose the arrowheads at the ends of the line."
msgstr "Chọn kiểu mũi tên ở hai đầu đường."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:LineNumberingDialog"
msgid "Number the lines in the margin."
msgstr "Đánh số các dòng ở lề."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:LineStyle"
msgid "Change the style of the borders."
msgstr "Đổi kiểu đường viền."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:LineToolbox"
msgid "Draw a curve, a polygon or a freehand line."
msgstr "Vẽ đường cong, đa giác hoặc đường tự do."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:LineWidth"
msgid "Change the thickness of the line."
msgstr "Đổi độ dày của đường."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ListBox"
msgid "Add a list to pick from to the form."
msgstr "Thêm danh sách để chọn vào biểu mẫu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:MacroDialog"
msgid "Run, edit or organize macros."
msgstr "Chạy, sửa hoặc sắp xếp các macro."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:MacroRecorder"
msgid "Record your actions as a macro to repeat them later."
msgstr "Ghi lại thao tác thành macro để lặp lại về sau."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ManageXMLSource"
msgid "Import data from an XML file into the cells."
msgstr "Nhập dữ liệu từ tệp tin XML vào các ô."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Margins"
msgid "Choose the margins of the printed page."
msgstr "Chọn lề của trang in."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Marks"
msgid "Show fields with a grey background."
msgstr "Tô nền xám cho các trường."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:MasterLayouts"
msgid "Choose which placeholders the master shows, such as date or number."
msgstr "Chọn các ô giữ chỗ trang cái hiện ra, như ngày hoặc số trang."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Menubar"
msgid "Show or hide the menu bar."
msgstr "Hiện hoặc ẩn thanh trình đơn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Merge"
msgid "Merge the selected shapes into one outline."
msgstr "Hợp các hình đang chọn thành một đường bao."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:MergeCells"
msgid "Join the selected cells into one cell."
msgstr "Gộp các ô đang chọn thành một ô."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:MergeDocuments"
msgid "Bring the changes from another copy of the document into this one."
msgstr "Đưa các thay đổi từ một bản khác của tài liệu vào bản này."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Morphing"
msgid "Change one shape into another in several steps."
msgstr "Biến dần hình này thành hình khác qua nhiều bước."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:MovePageDown"
msgid "Move the page one place down."
msgstr "Chuyển trang xuống sau một vị trí."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:MovePageUp"
msgid "Move the page one place up."
msgstr "Chuyển trang lên trước một vị trí."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:NavigationBar"
msgid "Add record navigation buttons to the form."
msgstr "Thêm thanh nút chuyển bản ghi vào biểu mẫu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Navigator"
msgid "Show headings, sheets, objects and names to move around quickly."
msgstr "Hiện đề mục, trang tính, đối tượng và tên để di chuyển nhanh."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:NewWindow"
msgid "Open another window of the same document."
msgstr "Mở thêm một cửa sổ của cùng tài liệu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:NextAnnotation"
msgid "Go to the next comment."
msgstr "Tới chú thích kế tiếp."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:NextPage"
msgid "Go to the next page."
msgstr "Tới trang sau."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:NextTrackedChange"
msgid "Go to the next tracked change."
msgstr "Tới thay đổi kế tiếp."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:NotesMasterPage"
msgid "Edit the layout of the notes pages."
msgstr "Sửa bố cục của trang ghi chú."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:NotesMode"
msgid "Show each slide with the speaker notes below it."
msgstr "Hiện từng trang chiếu với ghi chú của người trình bày bên dưới."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:NumberFormatCurrency"
msgid "Format numbers as currency."
msgstr "Định dạng số theo kiểu tiền tệ."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:NumberFormatDate"
msgid "Show the numbers as dates."
msgstr "Hiện số dưới dạng ngày."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:NumberFormatDecimal"
msgid "Show the numbers with a thousands separator and two decimals."
msgstr "Hiện số có dấu phân cách hàng nghìn và hai chữ số thập phân."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:NumberFormatPercent"
msgid "Show numbers as percentages."
msgstr "Hiện số dưới dạng phần trăm."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:NumberFormatType"
msgid "Choose how the numbers are shown: number, money, date or percent."
msgstr "Chọn cách hiện số: số, tiền tệ, ngày hoặc phần trăm."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:NumericField"
msgid "Add a field for numbers to the form."
msgstr "Thêm ô nhập số vào biểu mẫu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ObjectAlign"
msgid "Line up the selected objects."
msgstr "Căn các đối tượng đang chọn theo cạnh hoặc theo giữa."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ObjectAlignLeft"
msgid "Line up the left edges of the selected objects."
msgstr "Căn thẳng cạnh trái của các đối tượng đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ObjectAlignRight"
msgid "Line up the right edges of the selected objects."
msgstr "Căn thẳng cạnh phải của các đối tượng đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ObjectBackOne"
msgid "Move the object one layer back."
msgstr "Đưa đối tượng lùi xuống một lớp."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ObjectForwardOne"
msgid "Move the object one layer forward."
msgstr "Đưa đối tượng lên trên một lớp."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ObjectTitleDescription"
msgid "Describe the object for people using a screen reader."
msgstr "Mô tả đối tượng cho người dùng trình đọc màn hình."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Objects3DToolbox"
