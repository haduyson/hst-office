msgstr "Vẽ khối 3D như hình lập phương, hình cầu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:OpenReadOnly"
msgid "Open forms in design mode so they can be edited."
msgstr "Mở biểu mẫu ở chế độ thiết kế để sửa được."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:OptimizeTable"
msgid "Make the rows and columns of the table fit their contents."
msgstr "Chỉnh hàng và cột của bảng vừa với nội dung."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:OptionsSecurityDialog"
msgid "Choose which macros are allowed to run."
msgstr "Chọn những macro được phép chạy."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:OptionsTreeDialog"
msgid "Change the settings of HST Office."
msgstr "Đổi thiết lập của HST Office."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Orientation"
msgid "Switch between portrait and landscape pages."
msgstr "Đổi trang dọc hoặc trang ngang."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:OriginalSize"
msgid "Give the object back its original size."
msgstr "Đưa đối tượng về kích cỡ gốc."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:OutlineCollapse"
msgid "Hide the subpoints of the selected paragraph."
msgstr "Ẩn các ý phụ của đoạn đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:OutlineCollapseAll"
msgid "Show only the slide titles."
msgstr "Chỉ hiện tiêu đề các trang chiếu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:OutlineDown"
msgid "Move the selected paragraphs down."
msgstr "Chuyển các đoạn đang chọn xuống dưới."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:OutlineExpand"
msgid "Show the subpoints of the selected paragraph."
msgstr "Hiện các ý phụ của đoạn đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:OutlineExpandAll"
msgid "Show all levels of the outline."
msgstr "Hiện mọi cấp của dàn ý."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:OutlineFont"
msgid "Show the letters as hollow outlines."
msgstr "Hiện chữ thành nét viền rỗng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:OutlineFormat"
msgid "Show or hide the text formatting in the outline."
msgstr "Hiện hoặc ẩn định dạng chữ trong dàn ý."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:OutlineLeft"
msgid "Raise the selected paragraphs one level."
msgstr "Nâng các đoạn đang chọn lên một cấp."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:OutlineMode"
msgid "Show the text of all slides as an outline."
msgstr "Hiện chữ của mọi trang chiếu dưới dạng dàn ý."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:OutlineRight"
msgid "Lower the selected paragraphs one level."
msgstr "Hạ các đoạn đang chọn xuống một cấp."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:OutlineUp"
msgid "Move the selected paragraphs up."
msgstr "Chuyển các đoạn đang chọn lên trên."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:OutputQualityColor"
msgid "Show the document in colour."
msgstr "Hiện tài liệu có màu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:OutputQualityGrayscale"
msgid "Show the document in shades of grey."
msgstr "Hiện tài liệu theo thang xám."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:PageDialog"
msgid "Set the paper size, margins and layout of the page."
msgstr "Đặt khổ giấy, lề và bố cục trang."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:PageDown"
msgid "Go to the next page."
msgstr "Tới trang sau."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:PageFormatDialog"
msgid "Set the paper, margins, headers and footers of the printed page."
msgstr "Đặt khổ giấy, lề, đầu trang và chân trang khi in."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:PageSetup"
msgid "Set the size, orientation and margins of the page."
msgstr "Đặt cỡ, hướng và lề của trang."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:PageUp"
msgid "Go to the previous page."
msgstr "Về trang trước."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ParaLeftToRight"
msgid "Write the paragraph from left to right."
msgstr "Viết đoạn văn từ trái sang phải."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ParaRightToLeft"
msgid "Write the paragraph from right to left."
msgstr "Viết đoạn văn từ phải sang trái."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ParagraphDialog"
msgid "Open all the paragraph settings, such as indents, spacing and tabs."
msgstr "Mở mọi thiết lập đoạn văn như thụt lề, giãn cách và điểm dừng tab."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ParaspaceDecrease"
msgid "Reduce the space above and below the paragraph."
msgstr "Giảm khoảng cách trên và dưới đoạn văn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ParaspaceIncrease"
msgid "Increase the space above and below the paragraph."
msgstr "Tăng khoảng cách trên và dưới đoạn văn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:PasteSpecial"
msgid "Paste in another format, such as values only or plain text."
msgstr "Dán theo cách khác, ví dụ chỉ giá trị hoặc chữ thường."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:PatternField"
msgid "Add a field that accepts text in a set pattern."
msgstr "Thêm ô nhập chữ theo một mẫu định sẵn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:PhotoAlbumDialog"
msgid "Create slides from a set of pictures."
msgstr "Tạo các trang chiếu từ một loạt ảnh."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Polygon_Diagonal"
msgid "Draw a filled shape with straight sides at 45° steps."
msgstr "Vẽ hình có tô màu với các cạnh thẳng theo góc 45°."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Polygon_Diagonal_Unfilled"
msgid "Draw lines with straight sides at 45° steps."
msgstr "Vẽ đường gấp khúc với các cạnh theo góc 45°."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Polygon_Unfilled"
msgid "Draw lines with straight sides."
msgstr "Vẽ đường gấp khúc."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:PresentationDialog"
msgid "Choose how the slide show runs: range, screen and timing."
msgstr "Chọn cách chạy trình chiếu: phạm vi, màn hình và thời gian."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:PresentationLayout"
msgid "Choose another master for the slides."
msgstr "Chọn trang cái khác cho các trang chiếu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:PreviewZoom"
msgid "Zoom the print preview in or out."
msgstr "Phóng to hoặc thu nhỏ bản xem trước khi in."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:PreviousAnnotation"
msgid "Go to the previous comment."
msgstr "Về chú thích trước."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:PreviousPage"
msgid "Go to the previous page."
msgstr "Về trang trước."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:PreviousTrackedChange"
msgid "Go to the previous tracked change."
msgstr "Về thay đổi trước."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Print"
msgid "Choose a printer and print the document."
msgstr "Chọn máy in và in tài liệu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:PrintLayout"
msgid "Show the pages as they will be printed."
msgstr "Hiện các trang như khi in ra."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:PrintPreview"
msgid "See the pages as they will be printed."
msgstr "Xem trang như khi in ra giấy."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ProtectTraceChangeMode"
msgid "Stop others turning off change tracking without a password."
msgstr "Chặn người khác tắt theo dõi thay đổi nếu không có mật khẩu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Pushbutton"
msgid "Add a button to the form."
msgstr "Thêm nút bấm vào biểu mẫu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:RadioButton"
msgid "Add an option button to the form; only one in a group can be chosen."
msgstr "Thêm nút tùy chọn vào biểu mẫu; mỗi nhóm chỉ chọn được một."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:RecalcPivotTable"
msgid "Update the pivot table with the latest data."
msgstr "Cập nhật bảng tổng hợp theo dữ liệu mới nhất."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:RedactDoc"
msgid "Make a copy with the content you mark blacked out for good."
msgstr "Tạo bản sao có phần nội dung đã đánh dấu bị che kín hoàn toàn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:RegressionDialog"
msgid "Find the line or curve that best fits the data."
msgstr "Tìm đường thẳng hoặc đường cong khớp nhất với dữ liệu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:RejectAllTrackedChanges"
msgid "Undo every tracked change in the document."
msgstr "Từ chối mọi thay đổi đã theo dõi trong tài liệu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:RejectTrackedChange"
msgid "Undo this change."
msgstr "Từ chối thay đổi này."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:RejectTrackedChangeToNext"
msgid "Undo this change and go to the next one."
msgstr "Từ chối thay đổi này và chuyển sang thay đổi kế tiếp."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Remove"
msgid "Delete the selected sheet."
msgstr "Xóa trang tính đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:RemoveCalcTable"
msgid "Delete the selected table."
msgstr "Xóa bảng đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:RenameMasterPage"
msgid "Rename the selected master."
msgstr "Đổi tên trang cái đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:RenamePage"
msgid "Rename the current page."
msgstr "Đổi tên trang hiện tại."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:RenameTable"
msgid "Rename the selected sheet."
msgstr "Đổi tên trang tính đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ReplyComment"
msgid "Reply to the selected comment."
msgstr "Trả lời chú thích đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ResetAllDataPoints"
msgid "Give every data point back the format of its series."
msgstr "Đưa mọi điểm dữ liệu về định dạng của chuỗi."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ResetAttributes"
msgid "Remove direct formatting from the selection."
msgstr "Xóa định dạng trực tiếp, đưa chữ về kiểu đang dùng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ResetDataPoint"
msgid "Give the data point back the format of its series."
msgstr "Đưa điểm dữ liệu về định dạng của chuỗi."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:RightParaMargin"
msgid "Change the indent of the paragraph from the right margin."
msgstr "Đổi khoảng thụt lề phải của đoạn văn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:RotateLeft"
msgid "Rotate the picture 90° to the left."
msgstr "Xoay ảnh 90° sang trái."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:RotateRight"
msgid "Rotate the picture 90° to the right."
msgstr "Xoay ảnh 90° sang phải."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:RowHeight"
msgid "Set an exact height for the selected rows."
msgstr "Đặt chiều cao chính xác cho các hàng đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Ruler"
msgid "Show or hide the rulers."
msgstr "Hiện hoặc ẩn thước."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:RunMacro"
msgid "Choose a macro and run it."
msgstr "Chọn một macro và chạy."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SaveBackground"
msgid "Save the background picture as a file."
msgstr "Lưu ảnh nền thành tệp tin."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SaveGraphic"
msgid "Save the picture as a file."
msgstr "Lưu ảnh thành tệp tin."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SearchDialog"
msgid "Find text and replace it."
msgstr "Tìm chữ và thay bằng chữ khác."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SelectAll"
msgid "Select everything."
msgstr "Chọn tất cả."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SelectBackground"
msgid "Use a picture as the page background."
msgstr "Dùng một ảnh làm nền trang."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SelectData"
msgid "Select the data range around the current cell."
msgstr "Chọn vùng dữ liệu quanh ô hiện tại."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SelectObject"
msgid "Click objects to select them."
msgstr "Bấm vào đối tượng để chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SelectTable"
msgid "Select the whole table."
msgstr "Chọn cả bảng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SelectUnprotectedCells"
msgid "Select the cells that can be edited in a protected sheet."
msgstr "Chọn các ô sửa được trong trang tính đã khóa."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SelectionModeBlock"
msgid "Select a rectangular block of text."
msgstr "Chọn một khối chữ hình chữ nhật."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SendToBack"
msgid "Put the selected object behind all others."
msgstr "Đặt đối tượng đang chọn xuống dưới cùng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SetAnchorAtChar"
msgid "Attach the object to a character so it moves with it."
msgstr "Neo đối tượng vào một ký tự để di chuyển theo ký tự đó."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SetAnchorToChar"
msgid "Place the object in the line like a character."
msgstr "Đặt đối tượng nằm trong dòng chữ như một ký tự."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SetAnchorToPage"
msgid "Keep the object at a fixed place on the page."
msgstr "Giữ đối tượng cố định ở một chỗ trên trang."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SetAnchorToPara"
msgid "Attach the object to a paragraph so it moves with it."
msgstr "Neo đối tượng vào đoạn văn để di chuyển theo đoạn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SetBorderStyle"
msgid "Add or remove borders around the selection."
msgstr "Thêm hoặc bỏ đường viền quanh vùng chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SetColumnWidth"
msgid "Set an exact width for the selected columns."
msgstr "Đặt bề rộng chính xác cho các cột đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SetDefault"
msgid "Remove direct formatting from the selection."
msgstr "Xóa định dạng trực tiếp, đưa chữ về kiểu đang dùng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SetLanguageAllTextMenu"
msgid "Set the language of the whole text for spell checking."
msgstr "Đặt ngôn ngữ của toàn bộ văn bản để kiểm tra chính tả."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SetLanguageParagraphMenu"
msgid "Set the language of this paragraph for spell checking."
msgstr "Đặt ngôn ngữ của đoạn này để kiểm tra chính tả."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SetLanguageSelectionMenu"
msgid "Set the language of the selected text for spell checking."
msgstr "Đặt ngôn ngữ của chữ đang chọn để kiểm tra chính tả."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SetOptimalColumnWidth"
msgid "Fit the column width to its contents."
msgstr "Chỉnh bề rộng cột vừa với nội dung."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SetOptimalRowHeight"
msgid "Fit the row height to its contents."
msgstr "Chỉnh chiều cao hàng vừa với nội dung."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SetOutline"
msgid "Choose a ready-made style for a multilevel list."
msgstr "Chọn kiểu có sẵn cho danh sách nhiều cấp."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SetRowHeight"
msgid "Set an exact height for the selected rows."
msgstr "Đặt chiều cao chính xác cho các hàng đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SetTabBgColor"
msgid "Colour the tab of the sheet."
msgstr "Tô màu nhãn của trang tính."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Shadowed"
msgid "Add a shadow to the text."
msgstr "Thêm bóng đổ cho chữ."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ShareDocument"
msgid "Let several people edit the spreadsheet at the same time."
msgstr "Cho nhiều người cùng sửa bảng tính một lúc."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Shear"
msgid "Slant or distort the selected object."
msgstr "Làm nghiêng hoặc bóp méo đối tượng đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Show"
msgid "Show a hidden sheet again."
msgstr "Hiện lại trang tính đã ẩn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ShowAllNotes"
msgid "Show all comments in the sheet."
msgstr "Hiện mọi chú thích trong trang tính."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ShowAnnotations"
msgid "Show or hide the comments."
msgstr "Hiện hoặc ẩn các chú thích."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ShowBookview"
msgid "See the pages side by side like an open book."
msgstr "Xem các trang cạnh nhau như cuốn sách đang mở."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ShowColumn"
msgid "Show the hidden columns in the selection again."
msgstr "Hiện lại các cột bị ẩn trong vùng chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ShowDetail"
msgid "Expand the selected group to show its rows or columns."
msgstr "Mở rộng nhóm đang chọn để hiện các hàng hoặc cột."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ShowErrors"
msgid "Draw arrows to the cells that cause the error."
msgstr "Vẽ mũi tên tới các ô gây ra lỗi."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ShowFmExplorer"
msgid "Show the forms and their controls as a tree."
msgstr "Hiện các biểu mẫu và điều khiển dưới dạng cây."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ShowMultiplePages"
msgid "See several pages at once in the preview."
msgstr "Xem nhiều trang cùng lúc khi xem trước."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ShowRow"
msgid "Show the hidden rows in the selection again."
msgstr "Hiện lại các hàng bị ẩn trong vùng chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ShowRuler"
msgid "Show or hide the rulers."
msgstr "Hiện hoặc ẩn thước."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ShowSinglePage"
msgid "See one page at a time in the preview."
msgstr "Xem từng trang một khi xem trước."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ShowSlide"
msgid "Show the hidden slide again in the slide show."
msgstr "Cho trang chiếu đã ẩn hiện lại khi trình chiếu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ShowTrackedChanges"
msgid "Show or hide the tracked changes in the text."
msgstr "Hiện hoặc ẩn các thay đổi đã theo dõi trong văn bản."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ShowTwoPages"
msgid "See two pages side by side in the preview."
msgstr "Xem hai trang cạnh nhau khi xem trước."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ShowWhitespace"
msgid "Show or hide the space between pages."
msgstr "Hiện hoặc ẩn khoảng trống giữa các trang."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Shrink"
msgid "Make the text a little smaller."
msgstr "Giảm cỡ chữ một chút."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Sidebar"
msgid "Show or hide the side panel."
msgstr "Hiện hoặc ẩn ngăn bên."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SidebarDeck.A11yCheckDeck"
msgid "Find content that is hard to read for people with disabilities."
msgstr "Tìm nội dung khó đọc đối với người khuyết tật."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SidebarDeck.PropertyDeck"
msgid "Change the background of the slide in the side panel."
msgstr "Đổi nền của trang chiếu ở ngăn bên."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SlideChangeWindow"
msgid "Set the speed, sound and timing of slide transitions."
msgstr "Đặt tốc độ, âm thanh và thời gian chuyển trang chiếu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SmallCaps"
msgid "Write lowercase letters as small capitals."
msgstr "Viết chữ thường thành chữ in hoa nhỏ."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SnapBorder"
msgid "Make objects snap to the page margins."
msgstr "Cho đối tượng bám vào lề trang."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SnapFrame"
msgid "Make objects snap to the edges of other objects."
msgstr "Cho đối tượng bám vào cạnh đối tượng khác."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SnapPoints"
msgid "Make objects snap to the points of other objects."
msgstr "Cho đối tượng bám vào các điểm của đối tượng khác."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SolverDialog"
msgid "Find the values that give the result you want."
msgstr "Tìm các giá trị cho ra kết quả mong muốn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SortAscending"
msgid "Sort from smallest to largest, or from A to Z."
msgstr "Sắp xếp từ nhỏ đến lớn hoặc từ A đến Z."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SortDescending"
msgid "Sort from largest to smallest, or from Z to A."
msgstr "Sắp xếp từ lớn đến nhỏ hoặc từ Z đến A."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SortDialog"
msgid "Sort the selected paragraphs or table rows."
msgstr "Sắp xếp các đoạn hoặc hàng bảng đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SpacePara1"
msgid "Set single line spacing."
msgstr "Đặt giãn dòng đơn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SpacePara15"
msgid "Set line spacing to 1.5 lines."
msgstr "Đặt giãn dòng 1,5 dòng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SpacePara2"
msgid "Set double line spacing."
msgstr "Đặt giãn dòng gấp đôi."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Spacing"
msgid "Change the space between the characters."
msgstr "Đổi khoảng cách giữa các ký tự."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SpellOnline"
msgid "Underline misspelt words while you type."
msgstr "Gạch dưới từ sai chính tả ngay khi gõ."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SplitCell"
msgid "Split the selected cell into several cells."
msgstr "Tách ô đang chọn thành nhiều ô."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SplitTable"
msgid "Split the table into two at the current row."
msgstr "Tách bảng làm hai tại hàng hiện tại."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SplitWindow"
msgid "Split the window to see two parts of the sheet at once."
msgstr "Chia cửa sổ để xem hai phần của trang tính cùng lúc."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:StarShapes"
msgid "Draw a star or a banner."
msgstr "Vẽ hình ngôi sao hoặc băng rôn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:StartPara"
msgid "Align the paragraph to the left."
msgstr "Căn đoạn văn sang trái."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Strikeout"
msgid "Draw a line through the text."
msgstr "Gạch ngang qua chữ."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:StyleApply"
msgid "Apply this style to the selected cells."
msgstr "Áp dụng kiểu này cho các ô đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:StylesPreview"
msgid "Pick a style for the paragraph from the gallery."
msgstr "Chọn kiểu cho đoạn văn từ thư viện kiểu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SubScript"
msgid "Make the text small and below the line."
msgstr "Viết chữ nhỏ ở dưới dòng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Substract"
msgid "Cut the shapes on top out of the bottom shape."
msgstr "Khoét phần các hình bên trên ra khỏi hình dưới cùng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SuperScript"
msgid "Make the text small and above the line."
msgstr "Viết chữ nhỏ ở trên dòng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SwitchControlDesignMode"
msgid "Switch between editing and using the form controls."
msgstr "Chuyển qua lại giữa sửa và dùng các điều khiển biểu mẫu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:SymbolShapes"
msgid "Draw a symbol such as a smiley face or a heart."
msgstr "Vẽ hình biểu tượng như mặt cười, trái tim."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:TTestDialog"
msgid "Compare the means of two paired sets of data (t-test)."
msgstr "So sánh trung bình của hai bộ dữ liệu ghép cặp (kiểm định t)."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:TabDialog"
msgid "Set the order in which Tab moves through the form controls."
msgstr "Đặt thứ tự phím Tab đi qua các điều khiển biểu mẫu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:TableCellBackgroundColor"
msgid "Fill the selected table cells with a colour."
msgstr "Tô màu nền cho các ô bảng đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:TableDesign"
msgid "Apply a ready-made design to the table."
msgstr "Áp dụng mẫu thiết kế có sẵn cho bảng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:TableDialog"
msgid "Change the size, borders and background of the table."
msgstr "Đổi cỡ, viền và nền của bảng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:TableNumberFormatDialog"
msgid "Choose how numbers are shown in the table cells."
msgstr "Chọn cách hiện số trong ô bảng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:TableSort"
msgid "Sort the rows of the table."
msgstr "Sắp xếp các hàng của bảng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:TemplateManager"
msgid "Start a document from a template or manage templates."
msgstr "Tạo tài liệu từ mẫu hoặc quản lý các mẫu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:TextWrap"
msgid "Choose how the text wraps around the object."
msgstr "Chọn cách chữ bao quanh đối tượng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:TextdirectionLeftToRight"
msgid "Write the text from left to right, in horizontal lines."
msgstr "Viết chữ từ trái sang phải theo dòng ngang."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:TextdirectionTopToBottom"
msgid "Write the text from top to bottom."
msgstr "Viết chữ theo chiều từ trên xuống dưới."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ThemeDialog"
msgid "Apply a colour and font theme to the document."
msgstr "Áp dụng chủ đề màu và phông chữ cho tài liệu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ThemeSelectorPanel"
msgid "Apply a colour and font theme to the presentation."
msgstr "Áp dụng chủ đề màu và phông chữ cho bài trình chiếu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ThesaurusDialog"
msgid "Find words with a similar meaning."
msgstr "Tìm từ có nghĩa tương tự."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:TimeField"
msgid "Add a time field to the form."
msgstr "Thêm ô nhập giờ vào biểu mẫu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:TipOfTheDay"
msgid "Show a useful tip."
msgstr "Hiện một mẹo sử dụng hữu ích."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:TitlePageDialog"
msgid "Add a cover page or make a page the title page."
msgstr "Thêm trang bìa hoặc đặt một trang làm trang tiêu đề."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ToggleFormula"
msgid "Show the formulas in the cells instead of their results."
msgstr "Hiện công thức trong ô thay cho kết quả."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ToggleObjectBezierMode"
msgid "Edit the points of the selected shape."
msgstr "Sửa các điểm của hình đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ToggleObjectRotateMode"
msgid "Rotate the selected object with the mouse."
msgstr "Xoay đối tượng đang chọn bằng chuột."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ToggleSheetGrid"
msgid "Show or hide the grid lines between cells."
msgstr "Hiện hoặc ẩn đường lưới giữa các ô."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ToggleTabBarVisibility"
msgid "Show or hide the tabs of the views."
msgstr "Hiện hoặc ẩn các thẻ chế độ xem."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:TransformDialog"
msgid "Set the exact position, size and rotation of the object."
msgstr "Đặt chính xác vị trí, cỡ và góc xoay của đối tượng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Underline"
msgid "Underline the text."
msgstr "Gạch dưới chữ."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Ungroup"
msgid "Remove the grouping of the selected rows or columns."
msgstr "Bỏ nhóm của các hàng hoặc cột đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:UnhainFrames"
msgid "Stop text flowing from this frame into the next."
msgstr "Ngừng cho chữ chảy từ khung này sang khung kế tiếp."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:UpdateAll"
msgid "Update fields, links, indexes and charts."
msgstr "Cập nhật trường, liên kết, mục lục và biểu đồ."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:UseWizards"
msgid "Open a helper when you add a form control."
msgstr "Mở trình hướng dẫn khi thêm điều khiển biểu mẫu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:VerticalText"
msgid "Draw a text box with vertical text."
msgstr "Vẽ hộp văn bản viết chữ theo chiều dọc."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ViewColumnRowHighlighting"
msgid "Highlight the row and column of the current cell."
msgstr "Tô sáng hàng và cột của ô hiện tại."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ViewDataSourceBrowser"
msgid "Show the data sources and their tables."
msgstr "Hiện các nguồn dữ liệu và bảng của chúng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ViewHiddenColRow"
msgid "Mark the places where rows or columns are hidden."
msgstr "Đánh dấu chỗ có hàng hoặc cột bị ẩn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ViewRowColumnHeaders"
msgid "Show or hide the row numbers and column letters."
msgstr "Hiện hoặc ẩn số hàng và chữ cột."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ViewValueHighlighting"
msgid "Show numbers in blue, text in black and formulas in green."
msgstr "Hiện số màu xanh dương, chữ màu đen và công thức màu xanh lá."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Watermark"
msgid "Put faint text behind the content of every page."
msgstr "Đặt chữ mờ phía sau nội dung của mọi trang."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Window3D"
msgid "Change the 3D effects of the selected object."
msgstr "Đổi hiệu ứng 3D của đối tượng đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:WrapIdeal"
msgid "Wrap the text tightly around the object."
msgstr "Cho chữ bao sát quanh đối tượng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:WrapLeft"
msgid "Put the text only on the left of the object."
msgstr "Chỉ đặt chữ bên trái đối tượng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:WrapOff"
msgid "Put the text above and below the object only."
msgstr "Chỉ đặt chữ phía trên và phía dưới đối tượng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:WrapOn"
msgid "Wrap the text around the object's frame."
msgstr "Cho chữ bao quanh khung của đối tượng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:WrapRight"
msgid "Put the text only on the right of the object."
msgstr "Chỉ đặt chữ bên phải đối tượng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:WrapThrough"
msgid "Put the object behind or in front of the text."
msgstr "Đặt đối tượng phía sau hoặc phía trước chữ."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:XLineColor"
msgid "Change the color of the shape's outline."
msgstr "Đổi màu viền của hình đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:XLineStyle"
msgid "Choose the line style: solid, dashed or dotted."
msgstr "Chọn kiểu đường: liền, gạch hoặc chấm."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ZTestDialog"
msgid "Compare the mean of the data with a known value (z-test)."
msgstr "So sánh trung bình dữ liệu với một giá trị đã biết (kiểm định z)."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Zoom"
msgid "Choose how large the document looks on screen."
msgstr "Chọn mức phóng to tài liệu trên màn hình."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:Zoom100Percent"
msgid "Show the document at its real size."
msgstr "Xem tài liệu ở cỡ thật 100%."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ZoomMinus"
msgid "Make the view smaller."
msgstr "Thu nhỏ khung nhìn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ZoomMode"
msgid "Click to zoom in, drag with Shift to move the view."
msgstr "Bấm để phóng to, giữ Shift và kéo để dời khung nhìn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ZoomNext"
msgid "Go back to the next zoom level."
msgstr "Chuyển tới mức phóng kế tiếp."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ZoomOptimal"
msgid "Zoom to fit the selection or the content."
msgstr "Phóng vừa với vùng chọn hoặc nội dung."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ZoomPage"
msgid "Show the whole page in the window."
msgstr "Hiện trọn trang trong cửa sổ."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ZoomPageWidth"
msgid "Fit the page width to the window."
msgstr "Phóng vừa bề rộng trang với cửa sổ."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ZoomPlus"
msgid "Make the view bigger."
msgstr "Phóng to khung nhìn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|.uno:ZoomPrevious"
msgid "Go back to the previous zoom level."
msgstr "Quay về mức phóng trước."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|org.hst.office.mailmerge:AddressBlock"
msgid "Insert the recipient's address from the list."
msgstr "Chèn địa chỉ người nhận lấy từ danh sách."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|org.hst.office.mailmerge:Check"
msgid "Check the merge for errors before you finish."
msgstr "Kiểm tra lỗi trộn thư trước khi hoàn tất."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|org.hst.office.mailmerge:EditRecipients"
msgid "Choose and edit the people who receive the letter."
msgstr "Chọn và sửa danh sách người nhận thư."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|org.hst.office.mailmerge:Find"
msgid "Find a recipient in the list."
msgstr "Tìm một người nhận trong danh sách."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|org.hst.office.mailmerge:Finish"
msgid "Create the merged letters, print them or save them."
msgstr "Tạo các thư đã trộn, in ra hoặc lưu lại."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|org.hst.office.mailmerge:First"
msgid "Show the letter of the first recipient."
msgstr "Xem thư của người nhận đầu tiên."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|org.hst.office.mailmerge:Greeting"
msgid "Insert a greeting line such as \"Kính gửi\" and the name."
msgstr "Chèn dòng chào như \"Kính gửi\" kèm họ tên."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|org.hst.office.mailmerge:InsertField"
msgid "Insert a field from the recipient list, such as the name."
msgstr "Chèn một trường từ danh sách người nhận, ví dụ họ tên."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|org.hst.office.mailmerge:Last"
msgid "Show the letter of the last recipient."
msgstr "Xem thư của người nhận cuối cùng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|org.hst.office.mailmerge:Next"
msgid "Show the letter of the next recipient."
msgstr "Xem thư của người nhận kế tiếp."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|org.hst.office.mailmerge:Prev"
msgid "Show the letter of the previous recipient."
msgstr "Xem thư của người nhận trước."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|org.hst.office.mailmerge:Preview"
msgid "Show the letter with the data of a recipient."
msgstr "Xem thư với dữ liệu của một người nhận."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|org.hst.office.mailmerge:Recipients"
msgid "Choose the list of people who receive the letter."
msgstr "Chọn danh sách người nhận thư."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|org.hst.office.mailmerge:Record"
msgid "Go to the recipient with this number."
msgstr "Tới người nhận có số thứ tự này."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|org.hst.office.mailmerge:Rules"
msgid "Show text only when a condition on the data is met."
msgstr "Chỉ hiện chữ khi dữ liệu thỏa một điều kiện."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|org.hst.office.mailmerge:Start"
msgid "Start a mail merge: letters, envelopes or labels."
msgstr "Bắt đầu trộn thư: thư, phong bì hoặc nhãn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|org.hst.office.update:Check"
msgid "Check whether a newer version of HST Office is available."
msgstr "Kiểm tra xem đã có phiên bản HST Office mới hơn chưa."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|org.hst.office.vi:CitationBibliography"
msgid "Insert the list of sources cited in the document."
msgstr "Chèn danh mục tài liệu tham khảo đã trích dẫn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|org.hst.office.vi:CitationInsert"
msgid "Cite a source at the cursor."
msgstr "Trích dẫn một nguồn tại vị trí con trỏ."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|org.hst.office.vi:CitationLibrary"
msgid "Add, edit or delete the sources you cite."
msgstr "Thêm, sửa hoặc xóa các nguồn trích dẫn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|org.hst.office.vi:CitationReinsert"
msgid "Insert again a source you cited before."
msgstr "Chèn lại một nguồn đã trích dẫn trước đó."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|org.hst.office.vi:CitationStyle"
msgid "Choose the citation style, such as APA or IEEE."
msgstr "Chọn kiểu trích dẫn, ví dụ APA hoặc IEEE."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|org.hst.office.vi:CitationUpdate"
msgid "Update the citations and the list of sources."
msgstr "Cập nhật các trích dẫn và danh mục tài liệu tham khảo."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|org.hst.office.vi:ConvertEncoding"
msgid "Convert TCVN3 or VNI text to Unicode."
msgstr "Chuyển chữ gõ bằng bảng mã TCVN3 (ABC) hoặc VNI sang Unicode."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|org.hst.office.vi:DeleteBlankRows"
msgid "Delete the empty rows in the selection."
msgstr "Xóa các dòng trống trong vùng chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|org.hst.office.vi:EditVba"
msgid "Open the VBA macros of the document."
msgstr "Mở các macro VBA của tài liệu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|org.hst.office.vi:FormatPercent"
msgid "Show the numbers as percentages."
msgstr "Hiện số dưới dạng phần trăm."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|org.hst.office.vi:KeyboardShortcuts"
msgid "See the list of keyboard shortcuts."
msgstr "Xem danh sách phím tắt."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|org.hst.office.vi:Nd30Wizard"
msgid "Create an administrative document with the official layout."
msgstr "Soạn văn bản hành chính đúng thể thức Nghị định 30/2020/NĐ-CP."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|org.hst.office.vi:NumberToWords"
msgid "Write the selected number in Vietnamese words."
msgstr "Đọc số đang chọn thành chữ tiếng Việt."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|org.hst.office.vi:OpenInHstPdf"
msgid "Open this file in HST PDF to read or sign it."
msgstr "Mở tệp tin này bằng HST PDF để đọc hoặc ký."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|org.hst.office.vi:RemoveDiacritics"
msgid "Remove the Vietnamese accents from the selected text."
msgstr "Bỏ dấu tiếng Việt khỏi chữ đang chọn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|org.hst.office.vi:ReportError"
msgid "Send HASON TECH a report about a problem."
msgstr "Gửi báo cáo lỗi cho HASON TECH."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|org.hst.office.vi:SetupUsbToken"
msgid "Set up the USB token that holds your digital signature certificate."
msgstr "Thiết lập USB token chứa chứng thư số để ký số tài liệu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|org.hst.office.vi:ShowSolutions"
msgid "See the products and services of HASON TECH."
msgstr "Xem các sản phẩm và dịch vụ của HASON TECH."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|org.hst.office.vi:SortByGivenName"
msgid "Sort Vietnamese names by given name, then by family name."
msgstr "Sắp xếp họ tên tiếng Việt theo tên, rồi theo họ."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|org.hst.office.vi:SplitName"
msgid "Split full names into family name, middle name and given name."
msgstr "Tách họ tên thành họ, tên đệm và tên."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|org.hst.office.vi:UILanguageEn"
msgid "Show the interface in English."
msgstr "Hiện giao diện bằng tiếng Anh."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|org.hst.office.vi:UILanguageSystem"
msgid "Use the language of the computer for the interface."
msgstr "Dùng ngôn ngữ của máy tính cho giao diện."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|org.hst.office.vi:UILanguageVi"
msgid "Show the interface in Vietnamese."
msgstr "Hiện giao diện bằng tiếng Việt."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|org.hst.office.vi:WhereIsCommand"
msgid "Find where a familiar command is in the ribbon."
msgstr "Tìm vị trí của một lệnh quen thuộc trên thanh công cụ."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|writer|.uno:AddDirect"
msgid "Create a new blank document."
msgstr "Tạo một tài liệu trống mới."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|writer|.uno:BackgroundColor"
msgid "Colour the background of the whole paragraph."
msgstr "Tô màu nền cho cả đoạn văn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|writer|.uno:BasicShapes"
msgid "Draw rectangles, arrows, connectors and more."
msgstr "Vẽ hình chữ nhật, mũi tên, đường nối."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|writer|.uno:ChangeCaseRotateCase"
msgid "Cycle between lowercase, UPPERCASE and Capitalized Words."
msgstr "Xoay vòng giữa chữ thường, chữ hoa và hoa đầu từ."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|writer|.uno:CharmapControl"
msgid "Insert a special symbol such as ©, € or ±."
msgstr "Chèn ký hiệu đặc biệt như ©, €, ±."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|writer|.uno:ControlCodes"
msgid "Show paragraph marks, spaces and tabs."
msgstr "Hiện dấu đoạn, dấu cách và dấu tab."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|writer|.uno:DecrementIndent"
msgid "Move the paragraph one step out."
msgstr "Kéo đoạn văn ra ngoài một nấc."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|writer|.uno:DesignerDialog"
msgid "Pick a ready-made paragraph style; open the Styles pane to see them all."
msgstr "Chọn kiểu đoạn văn có sẵn; mở bảng Kiểu để xem hết."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|writer|.uno:EditGlossary"
msgid "Insert a piece of text you use often, saved beforehand."
msgstr "Chèn đoạn chữ hay dùng đã lưu sẵn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|writer|.uno:FontworkGalleryFloater"
msgid "Insert decorative text with effects."
msgstr "Chèn chữ trang trí có hiệu ứng."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|writer|.uno:Gallery"
msgid "Open the collection of ready-made pictures and themes."
msgstr "Mở kho hình và chủ đề có sẵn."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|writer|.uno:Grow"
msgid "Make the selected text one step larger."
msgstr "Làm chữ đã chọn to hơn một bậc."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|writer|.uno:HangingIndent"
msgid "The first line sticks out, the next lines are indented."
msgstr "Dòng đầu nhô ra, các dòng sau thụt vào."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|writer|.uno:IncrementIndent"
msgid "Move the paragraph one step in."
msgstr "Đẩy đoạn văn vào trong một nấc."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|writer|.uno:InsertBookmark"
msgid "Name a place so that you can jump to it quickly."
msgstr "Đặt tên cho một vị trí để nhảy tới nhanh."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|writer|.uno:InsertColumnBreak"
msgid "Continue the text in the next column."
msgstr "Đưa chữ tiếp theo sang cột kế tiếp."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|writer|.uno:InsertDateField"
msgid "Insert today's date as dd/mm/yyyy."
msgstr "Chèn ngày hôm nay dạng dd/mm/yyyy."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|writer|.uno:InsertFieldCtrl"
msgid "Insert a field that updates itself: page number, date, author and more."
msgstr "Chèn trường tự cập nhật: số trang, ngày, tác giả."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|writer|.uno:InsertObject"
msgid "Insert a spreadsheet, a drawing or another file into the document."
msgstr "Chèn bảng tính, bản vẽ hoặc tệp khác vào tài liệu."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|writer|.uno:InsertObjectStarMath"
msgid "Write a mathematical formula."
msgstr "Viết công thức toán học."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|writer|.uno:InsertPageFooter"
msgid "Add or edit the page footer."
msgstr "Thêm hoặc sửa phần chân trang."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|writer|.uno:InsertPageHeader"
msgid "Add or edit the page header."
msgstr "Thêm hoặc sửa phần đầu trang."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
msgctxt "HstRibbonTip|writer|.uno:InsertReferenceField"
msgid "Refer to another heading, figure or table and update its number by itself."
msgstr "Dẫn tới tiêu đề, hình hoặc bảng khác và tự cập nhật số."

#. hstTip
#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
