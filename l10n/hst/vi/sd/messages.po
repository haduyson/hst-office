#: sd/uiconfig/sdraw/ui/insertlayer.ui
msgctxt "insertlayer|extended_tip|InsertLayerDialog"
msgid "Inserts a new layer in the document. Layers are only available in Draw, not in Slides."
msgstr "Chèn một lớp phủ mới vào tài liệu. Các lớp phủ chỉ khả dụng trong Draw, không có trong Slides."

#: sd/uiconfig/simpress/ui/optimpressgeneralpage.ui
msgctxt "extended_tip|cbCompatibility"
msgid "Specifies that Slides calculates the paragraph spacing exactly like Microsoft PowerPoint."
msgstr "Chỉ định rằng Slides tính toán khoảng cách đoạn văn chính xác như Microsoft PowerPoint."

#: sd/uiconfig/simpress/ui/presentationdialog.ui
msgctxt "presentationdialog|extended_tip|alwaysontop"
msgid "The Slides window remains on top during the presentation. No other program will show its window in front of your presentation."
msgstr "Cửa sổ Slides giữ ở trên cùng trong khi trình chiếu. Không có chương trình nào khác sẽ hiển thị cửa sổ trước bài trình chiếu của bạn."

#: sd/uiconfig/simpress/ui/presentationdialog.ui
msgctxt "presentationdialog|extended_tip|enableinteractivemode"
msgid "The Slides main document window remains active during the presentation. Users can continue editing slide content, which will be reflected in the running slideshow."
msgstr "Cửa sổ tài liệu chính của Slides vẫn hoạt động trong khi trình chiếu. Người dùng có thể tiếp tục chỉnh sửa nội dung trang chiếu và các thay đổi sẽ được thể hiện trong trình chiếu đang chạy."

#: sd/uiconfig/simpress/ui/presentationdialog.ui
msgctxt "presentationdialog|learnmore|tooltip_text"
msgid "Download the remote control app to control the presentation from your smartphone or smartwatch."
msgstr "Tải ứng dụng điều khiển trình chiếu từ xa bằng điện thoại thông minh hoặc đồng hồ thông minh."

#: sd/uiconfig/simpress/ui/presentationdialog.ui
msgctxt "presentationdialog|extended_tip|window"
msgid "Slide show runs in the Slides program window."
msgstr "Trình chiếu chạy trong cửa sổ chương trình Slides."

#: sd/uiconfig/simpress/ui/remotedialog.ui
msgctxt "remotedialog|extended_tip|RemoteDialog"
msgid "List all Slides Remote available connections."
msgstr "Liệt kê các kết nối điều khiển Slides có sẵn."

#: sd/uiconfig/simpress/ui/remotedialog.ui
msgctxt "remotedialog|RemoteDialog"
msgid "Slides Remote"
msgstr "Điều khiển Slides"
