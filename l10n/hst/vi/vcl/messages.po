#. hstBP
#: vcl/uiconfig/ui/hstprintpanel.ui
msgctxt "hstprintpanel|cancel"
msgid "Canc_el"
msgstr "Hủ_y"

#. hstBP
#: vcl/uiconfig/ui/hstprintpanel.ui
msgctxt "hstprintpanel|canceltip"
msgid "Close without printing and undo the margins changed on this page"
msgstr "Đóng mà không in và hoàn tác lề trang đã đổi ở trang này"

#. hstBP
#: vcl/uiconfig/ui/hstprintpanel.ui
msgctxt "hstprintpanel|extended_tip|cancel"
msgid "Closes the print page without printing: the print settings and the margins changed on this page are discarded."
msgstr "Đóng trang In mà không in: bỏ các thiết lập in và lề trang đã đổi ở trang này."

#. hstBP
#: vcl/uiconfig/ui/hstprintpanel.ui
msgctxt "hstprintpanel|back"
msgid "_Back"
msgstr "_Quay lại"

#. hstBP
#: vcl/uiconfig/ui/hstprintpanel.ui
msgctxt "hstprintpanel|backtip"
msgid "Return to the document (Esc)"
msgstr "Quay lại tài liệu (Esc)"

#. hstBP
#: vcl/uiconfig/ui/hstprintpanel.ui
msgctxt "hstprintpanel|extended_tip|back"
msgid "Closes the print page and returns to the document, like Esc and the back arrow."
msgstr "Đóng trang In và quay lại tài liệu, như phím Esc và nút mũi tên quay lại."

