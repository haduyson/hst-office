#. hstPSC
#: vcl/uiconfig/ui/printdialog.ui
msgctxt "printdialog|scalingboxlabel"
msgid "Scal_ing:"
msgstr "T_hu phóng:"

#. hstPSC
#: vcl/uiconfig/ui/printdialog.ui
msgctxt "printdialog|extended_tip|scalingbox"
msgid "Choose how the printed sheets are scaled: actual size, the whole sheet on one page, all columns on one page or all rows on one page."
msgstr "Chọn cách thu phóng các trang tính khi in: kích thước thật, cả trang tính trên một trang, tất cả các cột trên một trang hoặc tất cả các hàng trên một trang."

#. hstBP
#: vcl/uiconfig/ui/hstprintpanel.ui
msgctxt "hstprintpanel|pagesetup"
msgid "Page Set_up…"
msgstr "Thiết _lập trang"

#. hstBP
#: vcl/uiconfig/ui/hstprintpanel.ui
msgctxt "hstprintpanel|pagesetuptip"
