#: include/fpicker/strings.hrc
msgctxt "STR_FILESAVE_SELECTION"
msgid "Exports only the selected graphic objects in %PRODUCTNAME Draw and Slides to another format. If this box is not checked, the entire document is exported."
msgstr "Chỉ xuất các đối tượng đồ họa đã chọn trong %PRODUCTNAME Draw và Slides sang định dạng khác. Nếu không chọn ô này, toàn bộ tài liệu sẽ được xuất."
