#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_SIGN"
msgid "Sign"
msgstr "Ký số"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_SIGN_SAVE"
msgid "Sign and Save a Copy…"
msgstr "Ký và lưu bản sao"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_SIGNATURE_PLACE"
msgid "Digital signature here"
msgstr "Vị trí chữ ký số"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_PAGE_STATUS"
msgid "Page %1 / %2"
msgstr "Trang %1 / %2"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_OPEN_TIME"
msgid "Opened in %1 s"
msgstr "Mở trong %1 giây"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_NOT_SIGNED"
msgid "Not signed"
msgstr "Chưa ký"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_SIG_CHECKING"
msgid "Checking signatures…"
msgstr "Đang kiểm tra chữ ký số…"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_SIG_VALID"
msgid "Signed: %1 valid signature(s)"
msgstr "Đã ký: %1 chữ ký số hợp lệ"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_SIG_UNTRUSTED"
msgid "Signed, but the certificate could not be validated"
msgstr "Đã ký, chưa xác thực được chứng thư số"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_SIG_INVALID"
msgid "Invalid signature"
msgstr "Chữ ký số không hợp lệ"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_SIG_STATUS_VALID"
msgid "valid"
msgstr "hợp lệ"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_SIG_STATUS_PARTIAL"
msgid "valid, the file was extended after signing"
msgstr "hợp lệ, tệp có thêm nội dung sau khi ký"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_SIG_STATUS_UNTRUSTED"
msgid "certificate not validated"
msgstr "chưa xác thực được chứng thư"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_SIG_STATUS_INVALID"
msgid "invalid"
msgstr "không hợp lệ"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_EXISTING"
msgid "Signatures in this document:"
msgstr "Chữ ký số trong tài liệu:"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_SIG_INVALID_REASON"
msgid "Invalid signature: %1"
msgstr "Chữ ký số không hợp lệ: %1"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_SIG_SHORT_REWRITTEN"
msgid "the content of the file changed after signing. Ask the sender for the original file to check it."
msgstr "nội dung tệp đã thay đổi sau khi ký. Hãy xin tệp gốc từ người gửi để kiểm tra."

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_SIG_SHORT_INCOMPLETE"
msgid "the file is shorter than the signed data"
msgstr "tệp ngắn hơn phần dữ liệu đã ký"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_SIG_SHORT_MODIFIED"
msgid "the file was edited after signing"
msgstr "tệp đã được sửa thêm sau khi ký"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_SIG_SHORT_CONTENT"
msgid "the content does not match the signature"
msgstr "nội dung không khớp với chữ ký"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_SIG_SHORT_BROKEN"
msgid "the signature data is damaged"
msgstr "dữ liệu chữ ký bị hỏng"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_SIG_WHY_REWRITTEN"
msgid "The content of the file changed after signing. Ask the sender for the original file to check it."
msgstr "Nội dung tệp đã thay đổi sau khi ký. Hãy xin tệp gốc từ người gửi để kiểm tra."

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_SIG_WHY_INCOMPLETE"
msgid "The file ends before the signed data does, for example after a download that did not finish. Download it again or ask the sender for the original file."
msgstr "Tệp kết thúc trước phần dữ liệu đã ký, ví dụ do tải về chưa hết. Hãy tải lại hoặc xin tệp gốc từ người gửi."

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_SIG_WHY_MODIFIED"
msgid "After signing, the file was edited in a way the signature does not allow. Ask the sender for the original file to check it."
msgstr "Sau khi ký, tệp đã được sửa thêm theo cách mà chữ ký không cho phép. Hãy xin tệp gốc từ người gửi để kiểm tra."

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_SIG_WHY_CONTENT"
msgid "The content of the file no longer matches the signature: the file was edited after signing, or the signature is damaged."
msgstr "Nội dung tệp không còn khớp với chữ ký: tệp đã bị sửa sau khi ký hoặc chữ ký bị hỏng."

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_SIG_WHY_BROKEN"
msgid "The signature data is damaged or cannot be read."
msgstr "Dữ liệu chữ ký bị hỏng hoặc không đọc được."

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_SIGNER_UNKNOWN"
msgid "Unknown signer"
msgstr "Không rõ người ký"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_SIGNER_UNVERIFIED"
msgid "Signed by (not verified): %1"
msgstr "Ký bởi (chưa xác minh): %1"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_SIGNED_AT_UNVERIFIED"
msgid "Time of signing (not verified): %1"
msgstr "Thời điểm ký (chưa xác minh): %1"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_NO_CERT"
msgid "No certificate chosen"
msgstr "Chưa chọn chứng thư số"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_NO_CERT_HINT"
msgid "Plug in your USB token, then choose a certificate."
msgstr "Cắm USB Token rồi chọn chứng thư số."

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_CERT_EXPIRES"
msgid "expires %1"
msgstr "hết hạn %1"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_CERT_EXPIRED"
msgid "expired %1"
msgstr "đã hết hạn %1"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_CHOOSE_CERT"
msgid "~Choose Certificate…"
msgstr "~Chọn chứng thư số"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_CHOOSE_OTHER_CERT"
msgid "~Choose Another Certificate…"
msgstr "~Chọn chứng thư khác"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_SIGNED_BY"
msgid "Signed by: %1"
msgstr "Ký bởi: %1"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_SIGNER_ORG"
msgid "Organization: %1"
msgstr "Cơ quan: %1"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_SIGNED_ON"
msgid "Signing time: %1"
msgstr "Thời gian ký: %1"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_REASON"
msgid "Reason: %1"
msgstr "Lý do: %1"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_SIGN_FAILED"
msgid "The PDF could not be signed. Check that the USB token is plugged in and the PIN is correct, then try again."
msgstr "Không ký được tệp PDF. Hãy kiểm tra USB Token đã cắm và mã PIN đúng, rồi thử lại."

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_SIGN_NO_KEY"
msgid "The PDF could not be signed: the USB token or the private key of the certificate was not found. Plug in the USB token, wait a few seconds, then try again."
msgstr "Không ký được tệp PDF: không tìm thấy USB Token hoặc khóa bí mật của chứng thư số. Hãy cắm USB Token, chờ vài giây rồi thử lại."

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_SIGN_CANCELLED"
msgid "Signing was cancelled: the PIN was not entered. The PDF is not signed."
msgstr "Đã hủy ký: chưa nhập mã PIN. Tệp PDF chưa được ký."

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_SIGN_WRONG_PIN"
msgid "The PDF could not be signed: the PIN is not correct or the USB token is locked. Enter the PIN again; if the token is locked, contact the provider of your certificate."
msgstr "Không ký được tệp PDF: mã PIN không đúng hoặc USB Token đã bị khóa. Hãy nhập lại mã PIN; nếu USB Token đã bị khóa, hãy liên hệ nhà cung cấp chứng thư số."

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_SIGN_DETAILS"
msgid "Technical details: %1"
msgstr "Thông tin kỹ thuật: %1"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_SIGN_UNSUPPORTED"
msgid "HST PDF cannot add a signature to this file: its internal structure or its kind of encryption cannot be updated. The file is unchanged."
msgstr "HST PDF không thêm được chữ ký vào tệp này vì không cập nhật được cấu trúc bên trong hoặc kiểu mã hóa của tệp. Tệp không bị thay đổi."

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_SIGN_NOT_PERMITTED"
msgid "The sender's file does not allow digital signing: its security settings forbid changing it and adding signature fields. The file is unchanged. Ask the sender for a copy that allows signing, or enter the permissions password."
msgstr "Tệp của người gửi không cho phép ký số: thiết lập bảo mật của tệp cấm sửa đổi và thêm ô chữ ký. Tệp không bị thay đổi. Hãy xin người gửi bản cho phép ký, hoặc nhập mật khẩu quyền."

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_SIGN_PERMISSIONS_PASSWORD"
msgid "Enter Permissions Password"
msgstr "Nhập mật khẩu quyền"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_SIGN_PERMISSIONS_WRONG"
msgid "The permissions password is not correct, so the file cannot be signed. The file is unchanged."
msgstr "Mật khẩu quyền không đúng nên chưa ký được tệp. Tệp không bị thay đổi."

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_SIGN_NEEDS_PASSWORD"
msgid "This PDF needs its password to be signed. Open it again with its password, then sign."
msgstr "Tệp PDF này cần mật khẩu mới ký được. Hãy mở lại tệp bằng mật khẩu rồi ký."

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_SAME_FILE"
msgid "The signed PDF is saved as a copy: choose a new file name. The original file stays unchanged."
msgstr "Tệp PDF đã ký được lưu thành bản sao: hãy chọn tên tệp mới. Tệp gốc giữ nguyên."

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_SIGNED_SAVED"
msgid "Signed and saved as %1"
msgstr "Đã ký và lưu thành %1"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_SAVE_TITLE"
msgid "Save the Signed Copy"
msgstr "Lưu bản sao đã ký"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_SIGNED_SUFFIX"
msgid "-signed"
msgstr "-da-ky"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_MATCHES"
msgid "Match %1 of %2"
msgstr "Kết quả %1/%2"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_NO_MATCH"
msgid "“%1” not found"
msgstr "Không tìm thấy “%1”"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_SELECTION"
msgid "%1 characters selected (Ctrl+C copies)"
msgstr "Đã chọn %1 ký tự (Ctrl+C để chép)"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_PRINT_PAGES"
msgid "Pages"
msgstr "Trang in"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_PRINT_ALL"
msgid "~All pages"
msgstr "~Tất cả các trang"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_PRINT_RANGE"
msgid "Pa~ges:"
msgstr "Các ~trang:"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_PRINT_CURRENT"
msgid "~Current page"
msgstr "Trang ~hiện tại"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_SAVE_COPY_TITLE"
msgid "Save a Copy"
msgstr "Lưu bản sao"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_COPY_SAME_FILE"
msgid "The copy needs a new file name: the file chosen is the one open now."
msgstr "Bản sao cần một tên tệp mới: tệp đã chọn chính là tệp đang mở."

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_COPY_FAILED"
msgid "The copy could not be saved. Check the folder and that you may write to it, then try again."
msgstr "Không lưu được bản sao. Hãy kiểm tra thư mục và quyền ghi vào thư mục đó rồi thử lại."

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_COPY_SAVED"
msgid "Copy saved as %1"
msgstr "Đã lưu bản sao: %1"

