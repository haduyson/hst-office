msgid "Edit PDF File"
msgstr "Sửa tệp PDF"

#. hstPDF
#: xmlsecurity/uiconfig/ui/hstpdfviewer.ui
msgctxt "hstpdfviewer|edit|tooltip_text"
msgid "Edit in HST Draw"
msgstr "Sửa trong HST Draw"

#. hstPDF
#: xmlsecurity/uiconfig/ui/hstpdfviewer.ui
msgctxt "hstpdfviewer|extended_tip|edit"
