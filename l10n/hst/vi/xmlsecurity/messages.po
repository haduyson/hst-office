msgstr "Ký số tệp PDF này bằng chứng thư số (USB Token)"

#. hstPDF
#: xmlsecurity/uiconfig/ui/hstpdfviewer.ui
msgctxt "hstpdfviewer|thumbs|tooltip_text"
