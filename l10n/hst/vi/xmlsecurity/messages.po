msgstr "Ví dụ: Đồng ý phê duyệt"

#. hstPDF
#: xmlsecurity/uiconfig/ui/hstpdfviewer.ui
msgctxt "hstpdfviewer|visiblesig"
msgid "_Show the signature on the page"
msgstr "_Hiện hình chữ ký trên trang"

#. hstPDF
#: xmlsecurity/uiconfig/ui/hstpdfviewer.ui
msgctxt "hstpdfviewer|signsave"
msgid "Sign and _Save a Copy…"
