#. hstPDF
#: xmlsecurity/uiconfig/ui/hstpdfviewer.ui
msgctxt "hstpdfviewer|signhint"
msgid "Drag a box on the page to place the signature, or sign without a visible signature."
msgstr "Kéo khung chọn vị trí chữ ký trên trang, hoặc ký không hiện hình."

#. hstPDF
#: xmlsecurity/uiconfig/ui/hstpdfviewer.ui
