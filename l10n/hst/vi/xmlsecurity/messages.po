#. hstPDF
#: xmlsecurity/uiconfig/ui/hstpdfviewer.ui
msgctxt "hstpdfviewer|zoom|tooltip_text"
msgid "Zoom"
msgstr "Thu phóng"

#. hstPDF
#: xmlsecurity/uiconfig/ui/hstpdfviewer.ui
msgctxt "hstpdfviewer|zoomwidth"
msgid "Fit Width"
msgstr "Vừa bề rộng"

#. hstPDF
#: xmlsecurity/uiconfig/ui/hstpdfviewer.ui
msgctxt "hstpdfviewer|zoomin|tooltip_text"
msgid "Zoom In (Ctrl++)"
msgstr "Phóng to (Ctrl++)"

#. hstPDF
#: xmlsecurity/uiconfig/ui/hstpdfviewer.ui
msgctxt "hstpdfviewer|fitpage"
msgid "Fit Page"
msgstr "Vừa trang"

#. hstPDF
#: xmlsecurity/uiconfig/ui/hstpdfviewer.ui
msgctxt "hstpdfviewer|fitpage|tooltip_text"
msgid "Show the whole page"
msgstr "Hiện trọn một trang"

#. hstPDF
#: xmlsecurity/uiconfig/ui/hstpdfviewer.ui
msgctxt "hstpdfviewer|pagelabel"
msgid "Page"
msgstr "Trang"

#. hstPDF
#: xmlsecurity/uiconfig/ui/hstpdfviewer.ui
msgctxt "hstpdfviewer|page|tooltip_text"
