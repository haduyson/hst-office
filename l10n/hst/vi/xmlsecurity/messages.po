msgctxt "hstpdfviewer|pages-atkobject"
msgid "Page view"
msgstr "Vùng xem trang"

#. hstPDF
#: xmlsecurity/uiconfig/ui/hstpdfviewer.ui
msgctxt "hstpdfviewer|certcard-atkobject"
msgid "Chosen certificate"
msgstr "Chứng thư số đã chọn"

#. hstPDF
#: xmlsecurity/uiconfig/ui/hstpdfviewer.ui
msgctxt "hstpdfviewer|savecopy"
msgid "Save a Copy…"
msgstr "Lưu bản sao"

#. hstPDF
#: xmlsecurity/uiconfig/ui/hstpdfviewer.ui
msgctxt "hstpdfviewer|savecopy|tooltip_text"
msgid "Save a copy of this PDF (Ctrl+Shift+S)"
msgstr "Lưu một bản sao của tệp PDF này (Ctrl+Shift+S)"

#. hstPDF
#: xmlsecurity/uiconfig/ui/hstpdfviewer.ui
msgctxt "hstpdfviewer|fitwidth"
msgid "Fit Width"
msgstr "Vừa bề rộng"

#. hstPDF
#: xmlsecurity/uiconfig/ui/hstpdfviewer.ui
msgctxt "hstpdfviewer|fitwidth|tooltip_text"
msgid "Fit the page width to the window (Ctrl+2)"
msgstr "Cho trang vừa bề rộng cửa sổ (Ctrl+2)"

#. hstPDF
#: xmlsecurity/uiconfig/ui/hstpdfviewer.ui
msgctxt "hstpdfviewer|rotate|tooltip_text"
msgid "Rotate the pages 90° clockwise (Ctrl+R)"
msgstr "Xoay trang 90° theo chiều kim đồng hồ (Ctrl+R)"

#. hstPDF
#: xmlsecurity/uiconfig/ui/hstpdfviewer.ui
msgctxt "hstpdfviewer|prevpage|tooltip_text"
msgid "Previous page (Ctrl+Page Up)"
msgstr "Trang trước (Ctrl+Page Up)"

#. hstPDF
#: xmlsecurity/uiconfig/ui/hstpdfviewer.ui
msgctxt "hstpdfviewer|nextpage|tooltip_text"
msgid "Next page (Ctrl+Page Down)"
msgstr "Trang sau (Ctrl+Page Down)"

#. hstPDF
#: xmlsecurity/uiconfig/ui/hstpdfviewer.ui
msgctxt "hstpdfviewer|menu|tooltip_text"
msgid "Help, report a problem, about HST Office"
msgstr "Trợ giúp, báo lỗi, giới thiệu HST Office"

#. hstPDF
#: xmlsecurity/uiconfig/ui/hstpdfviewer.ui
msgctxt "hstpdfviewer|help"
msgid "HST Office Help"
msgstr "Trợ giúp HST Office"

#. hstPDF
#: xmlsecurity/uiconfig/ui/hstpdfviewer.ui
msgctxt "hstpdfviewer|reporterror"
msgid "Report a Problem to HASON TECH"
msgstr "Báo lỗi cho HASON TECH"

#. hstPDF
#: xmlsecurity/uiconfig/ui/hstpdfviewer.ui
msgctxt "hstpdfviewer|about"
msgid "About HST Office"
msgstr "Về HST Office"

#. hstSG1
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HST_SIGNER_NOT_VERIFIED"
msgid "%1 (not verified)"
msgstr "%1 (chưa xác minh)"

#. hstSG2
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HST_SIGNATURE_NOT_VALID_CERTIFICATE"
msgid "The signature is not valid or has not been verified. The details below are about the certificate only, not the signature."
msgstr "Chữ ký không hợp lệ hoặc chưa được xác minh. Thông tin bên dưới chỉ nói về chứng chỉ, không xác nhận chữ ký."

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_CHOOSE_SIGNATURE_IMAGE"
msgid "Choose a Signature Image"
msgstr "Chọn ảnh chữ ký"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_CHOOSE_SEAL_IMAGE"
msgid "Choose a Seal Image"
msgstr "Chọn ảnh con dấu"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_IMAGE_FILTER"
msgid "Images (PNG, JPEG)"
msgstr "Ảnh (PNG, JPEG)"

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_IMAGE_FILE_TOO_LARGE"
msgid "The image file is larger than 5 MB. Choose a smaller image."
msgstr "Tệp ảnh lớn hơn 5 MB. Hãy chọn ảnh nhỏ hơn."

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_IMAGE_TOO_MANY_PIXELS"
msgid "The image is too large: at most %1 × %1 pixels. Choose a smaller image."
msgstr "Ảnh quá lớn: tối đa %1 × %1 điểm ảnh. Hãy chọn ảnh nhỏ hơn."

#. hstPDF
#: xmlsecurity/inc/strings.hrc
msgctxt "STR_HSTPDF_IMAGE_UNREADABLE"
msgid "The file cannot be read as a PNG or JPEG image."
msgstr "Không đọc được tệp này dưới dạng ảnh PNG hoặc JPEG."

#. hstPDF
#: xmlsecurity/uiconfig/ui/hstpdfviewer.ui
msgctxt "hstpdfviewer|useimages"
msgid "_Add a signature or seal image"
msgstr "Chèn ả_nh chữ ký/con dấu"

#. hstPDF
#: xmlsecurity/uiconfig/ui/hstpdfviewer.ui
msgctxt "hstpdfviewer|choosesignatureimage"
msgid "_Signature Image…"
msgstr "Ảnh _chữ ký…"

#. hstPDF
#: xmlsecurity/uiconfig/ui/hstpdfviewer.ui
msgctxt "hstpdfviewer|choosesealimage"
msgid "S_eal Image…"
msgstr "Ảnh con _dấu…"

#. hstPDF
#: xmlsecurity/uiconfig/ui/hstpdfviewer.ui
msgctxt "hstpdfviewer|imagelayout"
msgid "Image on the left, text on the right"
msgstr "Ảnh bên trái, chữ bên phải"

#. hstPDF
#: xmlsecurity/uiconfig/ui/hstpdfviewer.ui
msgctxt "hstpdfviewer|imagelayout"
msgid "Image above, text below"
msgstr "Ảnh phía trên, chữ phía dưới"

#. hstPDF
#: xmlsecurity/uiconfig/ui/hstpdfviewer.ui
msgctxt "hstpdfviewer|imagelayout-atkobject"
msgid "Image layout"
msgstr "Bố cục ảnh"

#. hstPDF
#: xmlsecurity/uiconfig/ui/hstpdfviewer.ui
msgctxt "hstpdfviewer|noimages"
msgid "_Do Not Use Images"
msgstr "_Không dùng ảnh"

#. hstPDF
#: xmlsecurity/uiconfig/ui/hstpdfviewer.ui
msgctxt "hstpdfviewer|signatureimage-atkobject"
msgid "Signature image"
msgstr "Ảnh chữ ký"

#. hstPDF
#: xmlsecurity/uiconfig/ui/hstpdfviewer.ui
msgctxt "hstpdfviewer|sealimage-atkobject"
msgid "Seal image"
msgstr "Ảnh con dấu"
