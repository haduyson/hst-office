msgstr "Đi tới trang"

#. hstPDF
#: xmlsecurity/uiconfig/ui/hstpdfviewer.ui
msgctxt "hstpdfviewer|search"
msgid "Search in document"
msgstr "Tìm trong tài liệu"

#. hstPDF
#: xmlsecurity/uiconfig/ui/hstpdfviewer.ui
msgctxt "hstpdfviewer|search|tooltip_text"
msgid "Search in document (Ctrl+F). Enter: next match"
msgstr "Tìm trong tài liệu (Ctrl+F). Enter: kết quả tiếp theo"

#. hstPDF
#: xmlsecurity/uiconfig/ui/hstpdfviewer.ui
msgctxt "hstpdfviewer|findprev|tooltip_text"
msgid "Previous match (Shift+Enter)"
msgstr "Kết quả trước (Shift+Enter)"

#. hstPDF
#: xmlsecurity/uiconfig/ui/hstpdfviewer.ui
msgctxt "hstpdfviewer|findnext|tooltip_text"
msgid "Next match (Enter)"
msgstr "Kết quả tiếp theo (Enter)"

#. hstPDF
#: xmlsecurity/uiconfig/ui/hstpdfviewer.ui
