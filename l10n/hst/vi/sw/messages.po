#. hstG10
#: sw/uiconfig/swriter/ui/notebookbar.ui
msgctxt "TabbedWriter|hstG10Label"
msgid "Position"
msgstr "Vị trí"

#. HST override: ribbon: label and tooltip of the menu buttons that replace an oversized group (gap list G10)
#. hstG10
#: sw/uiconfig/swriter/ui/notebookbar.ui
msgctxt "TabbedWriter|hstG10Tip"
msgid "Choose what the selected object stays with: the page, a paragraph or a character."
msgstr "Đặt đối tượng đang chọn cố định trên trang, đi theo đoạn văn hoặc theo ký tự."

#. HST override: ribbon: label and tooltip of the menu buttons that replace an oversized group (gap list G10)
#. hstG10
#: sw/uiconfig/swriter/ui/notebookbar.ui
msgctxt "TabbedWriter|hstG10Label"
msgid "Wrap Text"
msgstr "Bao quanh văn bản"

#. HST override: ribbon: label and tooltip of the menu buttons that replace an oversized group (gap list G10)
#. hstG10
#: sw/uiconfig/swriter/ui/notebookbar.ui
msgctxt "TabbedWriter|hstG10Tip"
msgid "Choose how the text flows around the selected object."
msgstr "Chọn cách văn bản bao quanh đối tượng đang chọn."

#. HST override: ribbon: label and tooltip of the menu buttons that replace an oversized group (gap list G10)
#. hstG10
#: sw/uiconfig/swriter/ui/notebookbar.ui
msgctxt "TabbedWriter|hstG10Label"
msgid "Bring Forward"
msgstr "Tiến lên"

#. HST override: ribbon: label and tooltip of the menu buttons that replace an oversized group (gap list G10)
#. hstG10
#: sw/uiconfig/swriter/ui/notebookbar.ui
msgctxt "TabbedWriter|hstG10Tip"
msgid "Bring the selected object one step forward or in front of all others."
msgstr "Đưa đối tượng đang chọn lên trước một lớp hoặc lên trên cùng."

#. HST override: ribbon: label and tooltip of the menu buttons that replace an oversized group (gap list G10)
#. hstG10
#: sw/uiconfig/swriter/ui/notebookbar.ui
msgctxt "TabbedWriter|hstG10Label"
msgid "Send Backward"
msgstr "Lùi xuống"

#. HST override: ribbon: label and tooltip of the menu buttons that replace an oversized group (gap list G10)
#. hstG10
#: sw/uiconfig/swriter/ui/notebookbar.ui
msgctxt "TabbedWriter|hstG10Tip"
msgid "Send the selected object one step back or behind all others."
msgstr "Đưa đối tượng đang chọn lùi sau một lớp hoặc xuống dưới cùng."

#. HST override: ribbon: label and tooltip of the menu buttons that replace an oversized group (gap list G10)
#. hstG10
#: sw/uiconfig/swriter/ui/notebookbar.ui
msgctxt "TabbedWriter|hstG10Label"
msgid "Align"
msgstr "Căn chỉnh"

#. HST override: ribbon: label and tooltip of the menu buttons that replace an oversized group (gap list G10)
#. hstG10
#: sw/uiconfig/swriter/ui/notebookbar.ui
msgctxt "TabbedWriter|hstG10Tip"
msgid "Line up the selected objects with each other or with the page."
msgstr "Căn thẳng các đối tượng đang chọn với nhau hoặc với trang."

#. HST override: ribbon: label and tooltip of the menu buttons that replace an oversized group (gap list G10)
#. hstG10
#: sw/uiconfig/swriter/ui/notebookbar.ui
msgctxt "TabbedWriter|hstG10Label"
msgid "Group"
msgstr "Nhóm"

#. HST override: ribbon: label and tooltip of the menu buttons that replace an oversized group (gap list G10)
#. hstG10
#: sw/uiconfig/swriter/ui/notebookbar.ui
msgctxt "TabbedWriter|hstG10Tip"
msgid "Join objects so that they move and are formatted as one, or split a group."
msgstr "Gộp các đối tượng để di chuyển và định dạng như một, hoặc tách nhóm."

#. HST override: ribbon: label and tooltip of the menu buttons that replace an oversized group (gap list G10)
#. hstG10
#: sw/uiconfig/swriter/ui/notebookbar.ui
msgctxt "TabbedWriter|hstG10Label"
msgid "Rotate"
msgstr "Xoay"

#. HST override: ribbon: label and tooltip of the menu buttons that replace an oversized group (gap list G10)
#. hstG10
#: sw/uiconfig/swriter/ui/notebookbar.ui
msgctxt "TabbedWriter|hstG10Tip"
msgid "Rotate the selected object by 90 degrees or flip it."
msgstr "Xoay đối tượng đang chọn 90 độ hoặc lật đối tượng."

#. HST override: ribbon: label and tooltip of the menu buttons that replace an oversized group (gap list G10)
#. hstG10
#: sw/uiconfig/swriter/ui/notebookbar.ui
msgctxt "TabbedWriter|hstG10Label"
msgid "Accept"
msgstr "Chấp nhận"

#. HST override: ribbon: label and tooltip of the menu buttons that replace an oversized group (gap list G10)
#. hstG10
#: sw/uiconfig/swriter/ui/notebookbar.ui
msgctxt "TabbedWriter|hstG10Tip"
msgid "Keep this change, keep it and go to the next one, or keep every change."
msgstr "Chấp nhận thay đổi này, chấp nhận rồi sang thay đổi kế tiếp, hoặc chấp nhận tất cả."

#. HST override: ribbon: label and tooltip of the menu buttons that replace an oversized group (gap list G10)
#. hstG10
#: sw/uiconfig/swriter/ui/notebookbar.ui
msgctxt "TabbedWriter|hstG10Label"
msgid "Reject"
msgstr "Từ chối"

#. HST override: ribbon: label and tooltip of the menu buttons that replace an oversized group (gap list G10)
#. hstG10
#: sw/uiconfig/swriter/ui/notebookbar.ui
msgctxt "TabbedWriter|hstG10Tip"
msgid "Undo this change, undo it and go to the next one, or undo every change."
msgstr "Từ chối thay đổi này, từ chối rồi sang thay đổi kế tiếp, hoặc từ chối tất cả."

