#: cui/inc/uimode.hrc
msgctxt "RID_CUI_UIMODES"
msgid "The Tabbed Compact variant keeps the familiar ribbon-style layout, yet occupies less space for smaller screens."
msgstr "Biến thể thẻ gọn giữ thanh công cụ dạng thẻ quen thuộc nhưng chiếm ít không gian hơn, phù hợp màn hình nhỏ."

#: cui/inc/uimode.hrc
msgctxt "RID_CUI_UIMODES"
msgid "The Tabbed user interface is the familiar ribbon-style layout. It organizes functions in tabs and makes the main menu obsolete."
msgstr "Giao diện dạng thẻ với thanh công cụ quen thuộc, sắp xếp các chức năng theo thẻ và không cần đến thanh trình đơn chính."

#: cui/uiconfig/ui/optctlpage.ui
msgctxt "extended_tip|numerals"
msgid "Selects the type of numerals used within text, text in objects, fields, and controls, in all office suite modules. Only cell contents of Sheets are not affected."
msgstr "Chọn loại chữ số được sử dụng trong văn bản, văn bản trong đối tượng, trường và điều khiển, trong tất cả các mô-đun bộ ứng dụng văn phòng. Chỉ nội dung ô của Sheets không bị ảnh hưởng."

