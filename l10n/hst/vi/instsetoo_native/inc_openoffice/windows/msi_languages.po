#. hstMSI
#: Control.ulf
msgctxt ""
"Control.ulf\n"
"OOO_CONTROL_HST_DEFAULT_APPS\n"
"LngText.text"
msgid "Use HST Office to open office documents"
msgstr "Dùng HST Office để mở tài liệu văn phòng"

#. hstMSI
#: Control.ulf
msgctxt ""
"Control.ulf\n"
"OOO_CONTROL_HST_DESKTOP_SHORTCUTS\n"
"LngText.text"
msgid "Create desktop shortcuts"
msgstr "Tạo lối tắt trên màn hình nền"

#. hstMSI
#: Control.ulf
msgctxt ""
"Control.ulf\n"
"OOO_CONTROL_HST_LEGACY_BETA\n"
"LngText.text"
msgid "An earlier HST Office test version is installed on this computer. Setup will remove it and then install the new version. Your documents are not affected."
msgstr "Máy đang có bản HST Office thử nghiệm cũ. Bộ cài sẽ gỡ bản cũ rồi cài bản mới. Tài liệu của bạn không bị ảnh hưởng."

#. hstMSI
#: Control.ulf
msgctxt ""
"Control.ulf\n"
"OOO_CONTROL_HST_LEGACY_CONTINUE\n"
"LngText.text"
msgid "Continue"
msgstr "Tiếp tục"

#. hstMSI
#: Control.ulf
msgctxt ""
"Control.ulf\n"
"OOO_CONTROL_HST_LEGACY_EXIT\n"
"LngText.text"
msgid "Exit"
msgstr "Thoát"
