#: sc/inc/scfuncs.hrc
msgctxt "ocGROUPBY"
msgid "Groups the rows of a range by one or more fields and aggregates the values of each group."
msgstr "Nhóm các hàng của một vùng theo một hoặc nhiều trường và tổng hợp giá trị của từng nhóm."

#: sc/inc/scfuncs.hrc
msgctxt "ocGROUPBY"
msgid "Row fields"
msgstr "Trường hàng"

#: sc/inc/scfuncs.hrc
msgctxt "ocGROUPBY"
msgid "The columns whose values form the groups."
msgstr "Các cột có giá trị dùng để tạo nhóm."

#: sc/inc/scfuncs.hrc
msgctxt "ocGROUPBY"
msgid "Values"
msgstr "Giá trị"

#: sc/inc/scfuncs.hrc
msgctxt "ocGROUPBY"
msgid "The columns of values to aggregate."
msgstr "Các cột giá trị cần tổng hợp."

#: sc/inc/scfuncs.hrc
msgctxt "ocGROUPBY"
msgid "Function"
msgstr "Hàm"

#: sc/inc/scfuncs.hrc
msgctxt "ocGROUPBY"
msgid "The function that aggregates each group, for example SUM, AVERAGE, COUNTA, PERCENTOF or a LAMBDA."
msgstr "Hàm tổng hợp từng nhóm, ví dụ SUM, AVERAGE, COUNTA, PERCENTOF hoặc một hàm LAMBDA."

#: sc/inc/scfuncs.hrc
msgctxt "ocGROUPBY"
msgid "Field headers"
msgstr "Tiêu đề trường"

#: sc/inc/scfuncs.hrc
msgctxt "ocGROUPBY"
msgid "0 - none. 1 - present, not shown. 2 - none, generate them. 3 - present and shown. Omitted - present and shown when the first row of values is text and the second a number."
msgstr "0 - không có. 1 - có, không hiển thị. 2 - không có, tự tạo. 3 - có và hiển thị. Bỏ trống - có và hiển thị nếu hàng đầu của giá trị là văn bản và hàng thứ hai là số."

#: sc/inc/scfuncs.hrc
msgctxt "ocGROUPBY"
msgid "Total depth"
msgstr "Mức tổng"

#: sc/inc/scfuncs.hrc
msgctxt "ocGROUPBY"
msgid "0 - no totals. 1 - grand total (default). 2 - grand total and subtotals. -1, -2 - the same at the top."
msgstr "0 - không có tổng. 1 - tổng chung (mặc định). 2 - tổng chung và tổng phụ. -1, -2 - như trên nhưng đặt ở đầu."

#: sc/inc/scfuncs.hrc
msgctxt "ocGROUPBY"
msgid "Sort order"
msgstr "Thứ tự sắp xếp"

#: sc/inc/scfuncs.hrc
msgctxt "ocGROUPBY"
msgid "Column indexes to sort by, negative for descending order. Omitted - ascending by the fields."
msgstr "Chỉ số các cột dùng để sắp xếp, số âm là giảm dần. Bỏ trống - tăng dần theo các trường."

#: sc/inc/scfuncs.hrc
msgctxt "ocGROUPBY"
msgid "Filter array"
msgstr "Mảng lọc"

#: sc/inc/scfuncs.hrc
msgctxt "ocGROUPBY"
msgid "A column of logical values; only the rows that are TRUE are used."
msgstr "Một cột giá trị lô-gic; chỉ dùng các hàng có giá trị TRUE."

#: sc/inc/scfuncs.hrc
msgctxt "ocGROUPBY"
msgid "Field relationship"
msgstr "Quan hệ trường"

#: sc/inc/scfuncs.hrc
msgctxt "ocGROUPBY"
msgid "0 or omitted - hierarchy. 1 - table, every field sorted on its own, no subtotals."
msgstr "0 hoặc bỏ trống - phân cấp. 1 - dạng bảng, mỗi trường sắp xếp riêng, không có tổng phụ."

#: sc/inc/scfuncs.hrc
msgctxt "ocPIVOTBY"
msgid "Summarizes the values of a range by row fields and column fields."
msgstr "Tổng hợp các giá trị của một vùng theo trường hàng và trường cột."

#: sc/inc/scfuncs.hrc
msgctxt "ocPIVOTBY"
msgid "Row fields"
msgstr "Trường hàng"

#: sc/inc/scfuncs.hrc
msgctxt "ocPIVOTBY"
msgid "The columns whose values form the rows of the summary."
msgstr "Các cột có giá trị tạo thành các hàng của bảng tổng hợp."

#: sc/inc/scfuncs.hrc
msgctxt "ocPIVOTBY"
msgid "Column fields"
msgstr "Trường cột"

#: sc/inc/scfuncs.hrc
msgctxt "ocPIVOTBY"
msgid "The columns whose values form the columns of the summary."
msgstr "Các cột có giá trị tạo thành các cột của bảng tổng hợp."

#: sc/inc/scfuncs.hrc
msgctxt "ocPIVOTBY"
msgid "Values"
msgstr "Giá trị"

#: sc/inc/scfuncs.hrc
msgctxt "ocPIVOTBY"
msgid "The columns of values to aggregate."
msgstr "Các cột giá trị cần tổng hợp."

#: sc/inc/scfuncs.hrc
msgctxt "ocPIVOTBY"
msgid "Function"
msgstr "Hàm"

#: sc/inc/scfuncs.hrc
msgctxt "ocPIVOTBY"
msgid "The function that aggregates each group, for example SUM, AVERAGE, COUNTA, PERCENTOF or a LAMBDA."
msgstr "Hàm tổng hợp từng nhóm, ví dụ SUM, AVERAGE, COUNTA, PERCENTOF hoặc một hàm LAMBDA."

#: sc/inc/scfuncs.hrc
msgctxt "ocPIVOTBY"
msgid "Field headers"
msgstr "Tiêu đề trường"

#: sc/inc/scfuncs.hrc
msgctxt "ocPIVOTBY"
msgid "0 - none. 1 - present, not shown. 2 - none, generate them. 3 - present and shown. Omitted - present and shown when the first row of values is text and the second a number."
msgstr "0 - không có. 1 - có, không hiển thị. 2 - không có, tự tạo. 3 - có và hiển thị. Bỏ trống - có và hiển thị nếu hàng đầu của giá trị là văn bản và hàng thứ hai là số."

#: sc/inc/scfuncs.hrc
msgctxt "ocPIVOTBY"
msgid "Row total depth"
msgstr "Mức tổng theo hàng"

#: sc/inc/scfuncs.hrc
msgctxt "ocPIVOTBY"
msgid "0 - no totals. 1 - grand total (default). 2 - grand total and subtotals. -1, -2 - the same at the top."
msgstr "0 - không có tổng. 1 - tổng chung (mặc định). 2 - tổng chung và tổng phụ. -1, -2 - như trên nhưng đặt ở đầu."

#: sc/inc/scfuncs.hrc
msgctxt "ocPIVOTBY"
msgid "Row sort order"
msgstr "Thứ tự sắp xếp hàng"

#: sc/inc/scfuncs.hrc
msgctxt "ocPIVOTBY"
msgid "Column indexes to sort by, negative for descending order. Omitted - ascending by the fields."
msgstr "Chỉ số các cột dùng để sắp xếp, số âm là giảm dần. Bỏ trống - tăng dần theo các trường."

#: sc/inc/scfuncs.hrc
msgctxt "ocPIVOTBY"
msgid "Column total depth"
msgstr "Mức tổng theo cột"

#: sc/inc/scfuncs.hrc
msgctxt "ocPIVOTBY"
msgid "Column sort order"
msgstr "Thứ tự sắp xếp cột"

#: sc/inc/scfuncs.hrc
msgctxt "ocPIVOTBY"
msgid "Filter array"
msgstr "Mảng lọc"

#: sc/inc/scfuncs.hrc
msgctxt "ocPIVOTBY"
msgid "A column of logical values; only the rows that are TRUE are used."
msgstr "Một cột giá trị lô-gic; chỉ dùng các hàng có giá trị TRUE."

#: sc/inc/scfuncs.hrc
msgctxt "ocPIVOTBY"
msgid "Relative to"
msgstr "Tương đối với"

#: sc/inc/scfuncs.hrc
msgctxt "ocPIVOTBY"
msgid "What a two-parameter function such as PERCENTOF gets as the whole: 0 or omitted - column totals. 1 - row totals. 2 - grand total. 3 - parent column total. 4 - parent row total."
msgstr "Phần tổng thể mà hàm hai tham số như PERCENTOF nhận được: 0 hoặc bỏ trống - tổng cột. 1 - tổng hàng. 2 - tổng chung. 3 - tổng cột cấp cha. 4 - tổng hàng cấp cha."

#: sc/inc/scfuncs.hrc
msgctxt "ocBYCOL"
msgid "Applies a function to each column of an array. Returns a single-row array of the same width."
msgstr "Áp dụng một hàm cho từng cột của mảng. Trả về mảng một hàng có cùng độ rộng."

#: sc/inc/scfuncs.hrc
msgctxt "ocBYCOL"
msgid "Array"
msgstr "Mảng"

#: sc/inc/scfuncs.hrc
msgctxt "ocBYCOL"
msgid "An array to calculate."
msgstr "Mảng cần tính."

#: sc/inc/scfuncs.hrc
msgctxt "ocBYCOL"
msgid "Function"
msgstr "Hàm"

#: sc/inc/scfuncs.hrc
msgctxt "ocBYCOL"
msgid "A function (LAMBDA or otherwise) that will be called on each column of the array."
msgstr "Hàm (LAMBDA hoặc hàm khác) được gọi cho từng cột của mảng."

#: sc/inc/scfuncs.hrc
msgctxt "ocBYROW"
msgid "Applies a function to each row of an array. Returns a single-column array of the same height."
msgstr "Áp dụng một hàm cho từng hàng của mảng. Trả về mảng một cột có cùng chiều cao."

#: sc/inc/scfuncs.hrc
msgctxt "ocBYROW"
msgid "Array"
msgstr "Mảng"

#: sc/inc/scfuncs.hrc
msgctxt "ocBYROW"
msgid "An array to calculate."
msgstr "Mảng cần tính."

#: sc/inc/scfuncs.hrc
msgctxt "ocBYROW"
msgid "Function"
msgstr "Hàm"

#: sc/inc/scfuncs.hrc
msgctxt "ocBYROW"
msgid "A function (LAMBDA or otherwise) that will be called on each row of the array."
msgstr "Hàm (LAMBDA hoặc hàm khác) được gọi cho từng hàng của mảng."

#: sc/inc/scfuncs.hrc
msgctxt "ocMAKEARRAY"
msgid "Array generation. Creates an array of certain dimensions, with generated contents."
msgstr "Tạo mảng. Tạo một mảng có kích thước cho trước với nội dung được sinh ra."

#: sc/inc/scfuncs.hrc
msgctxt "ocMAKEARRAY"
msgid "Rows"
msgstr "Số hàng"

#: sc/inc/scfuncs.hrc
msgctxt "ocMAKEARRAY"
msgid "The number of rows the new array should have."
msgstr "Số hàng của mảng mới."

#: sc/inc/scfuncs.hrc
msgctxt "ocMAKEARRAY"
msgid "Columns"
msgstr "Số cột"

#: sc/inc/scfuncs.hrc
msgctxt "ocMAKEARRAY"
msgid "The number of columns the new array should have."
msgstr "Số cột của mảng mới."

#: sc/inc/scfuncs.hrc
msgctxt "ocMAKEARRAY"
msgid "Generator"
msgstr "Hàm sinh"

#: sc/inc/scfuncs.hrc
msgctxt "ocMAKEARRAY"
msgid "A LAMBDA function that is called with (row, column) values to generate each element of the array."
msgstr "Hàm LAMBDA được gọi với (hàng, cột) để sinh từng phần tử của mảng."

#: sc/inc/scfuncs.hrc
msgctxt "ocMAP"
msgid "Applies a function to each cell of one or more arrays."
msgstr "Áp dụng một hàm cho từng ô của một hoặc nhiều mảng."

#: sc/inc/scfuncs.hrc
msgctxt "ocMAP"
msgid "Array 1"
msgstr "Mảng 1"

#: sc/inc/scfuncs.hrc
msgctxt "ocMAP"
msgid "The array that provides the first arguments to the function."
msgstr "Mảng cung cấp đối số thứ nhất cho hàm."

#: sc/inc/scfuncs.hrc
msgctxt "ocMAP"
msgid "Function or Array "
msgstr "Hàm hoặc mảng "

#: sc/inc/scfuncs.hrc
msgctxt "ocMAP"
msgid "A function (usually built with LAMBDA) that receives the data provided in the array(s). More than one array may be provided; their corresponding cells are all passed to the function. The function must accept that many parameters."
msgstr "Hàm (thường tạo bằng LAMBDA) nhận dữ liệu từ các mảng. Có thể đưa vào nhiều mảng; các ô tương ứng của chúng đều được truyền cho hàm. Hàm phải nhận đúng số tham số đó."

#: sc/inc/scfuncs.hrc
msgctxt "ocREDUCE"
msgid "Applies a custom LAMBDA function to each element in a given array and accumulates results to a single value."
msgstr "Áp dụng một hàm LAMBDA cho từng phần tử của mảng và tích lũy kết quả thành một giá trị."

#: sc/inc/scfuncs.hrc
msgctxt "ocREDUCE"
msgid "Initial Value"
msgstr "Giá trị ban đầu"

#: sc/inc/scfuncs.hrc
msgctxt "ocREDUCE"
msgid "Optional initial value of the accumulator."
msgstr "Giá trị ban đầu của biến tích lũy (không bắt buộc)."

#: sc/inc/scfuncs.hrc
msgctxt "ocREDUCE"
msgid "Array"
msgstr "Mảng"

#: sc/inc/scfuncs.hrc
msgctxt "ocREDUCE"
msgid "The array to be reduced."
msgstr "Mảng cần rút gọn."

#: sc/inc/scfuncs.hrc
msgctxt "ocREDUCE"
msgid "Formula"
msgstr "Công thức"

#: sc/inc/scfuncs.hrc
msgctxt "ocREDUCE"
msgid "A formula expression or LAMBDA function that will be called on each cell of the array."
msgstr "Biểu thức công thức hoặc hàm LAMBDA được gọi cho từng ô của mảng."

#: sc/inc/scfuncs.hrc
msgctxt "ocSCAN"
msgid "Progressively applies a LAMBDA function to each element in an array and returns an array of all intermediate values."
msgstr "Lần lượt áp dụng một hàm LAMBDA cho từng phần tử của mảng và trả về mảng gồm mọi giá trị trung gian."

#: sc/inc/scfuncs.hrc
msgctxt "ocSCAN"
msgid "Initial value"
msgstr "Giá trị ban đầu"

#: sc/inc/scfuncs.hrc
msgctxt "ocSCAN"
msgid "Optional initial value of the accumulator."
msgstr "Giá trị ban đầu của biến tích lũy (không bắt buộc)."

#: sc/inc/scfuncs.hrc
msgctxt "ocSCAN"
msgid "Array"
msgstr "Mảng"

#: sc/inc/scfuncs.hrc
msgctxt "ocSCAN"
msgid "The array to be scanned."
msgstr "Mảng cần duyệt."

#: sc/inc/scfuncs.hrc
msgctxt "ocSCAN"
msgid "Formula"
msgstr "Công thức"

#: sc/inc/scfuncs.hrc
msgctxt "ocSCAN"
msgid "A LAMBDA function that will be called on each cell of the array."
msgstr "Hàm LAMBDA được gọi cho từng ô của mảng."

#: sc/inc/scfuncs.hrc
msgctxt "ocLAMBDA"
msgid "Creates a custom, reusable %PRODUCTNAME function. The function accepts a set of parameters and one formula expression."
msgstr "Tạo một hàm %PRODUCTNAME tùy chỉnh, dùng lại được. Hàm nhận một tập tham số và một biểu thức công thức."

#: sc/inc/scfuncs.hrc
msgctxt "ocLAMBDA"
msgid "Parameter 1"
msgstr "Tham số 1"

#: sc/inc/scfuncs.hrc
msgctxt "ocLAMBDA"
msgid "The name of the first parameter to the function. The name must follow the range naming rules and cannot be the output of a text formula."
msgstr "Tên tham số thứ nhất của hàm. Tên phải theo quy tắc đặt tên vùng và không được là kết quả của một công thức văn bản."

#: sc/inc/scfuncs.hrc
msgctxt "ocLAMBDA"
msgid "Formula or Parameter "
msgstr "Công thức hoặc tham số "

#: sc/inc/scfuncs.hrc
msgctxt "ocLAMBDA"
msgid "An additional parameter or a formula expression. If entered as a formula, it must be the last argument of the function."
msgstr "Một tham số nữa hoặc biểu thức công thức. Nếu nhập công thức thì đó phải là đối số cuối cùng của hàm."

#: sc/inc/scfuncs.hrc
msgctxt "ocIS_OMITTED"
msgid "Reports whether a LAMBDA parameter was provided (FALSE) or omitted (TRUE). Only valid within a LAMBDA."
msgstr "Cho biết một tham số LAMBDA đã được truyền (FALSE) hay bị bỏ qua (TRUE). Chỉ dùng được bên trong LAMBDA."

#: sc/inc/scfuncs.hrc
msgctxt "ocIS_OMITTED"
msgid "Name"
msgstr "Tên"

#: sc/inc/scfuncs.hrc
msgctxt "ocIS_OMITTED"
msgid "The name of the parameter to check."
msgstr "Tên tham số cần kiểm tra."

#: sc/inc/scfuncs.hrc
msgctxt "STR_LONG_ERR_NOT_FUNC"
msgid "Error: Attempted to call non-function"
msgstr "Lỗi: Gọi một giá trị không phải là hàm"

#: sc/inc/scfuncs.hrc
msgctxt "ocARRAYTOTEXT"
msgid "Returns the values of a range or array as one text string."
msgstr "Trả về các giá trị của một vùng hoặc mảng dưới dạng một chuỗi văn bản."

#: sc/inc/scfuncs.hrc
msgctxt "ocARRAYTOTEXT"
msgid "Array"
msgstr "Mảng"

#: sc/inc/scfuncs.hrc
msgctxt "ocARRAYTOTEXT"
msgid "The range or array to return as text."
msgstr "Vùng hoặc mảng cần trả về dưới dạng văn bản."

#: sc/inc/scfuncs.hrc
msgctxt "ocARRAYTOTEXT"
msgid "Format"
msgstr "Định dạng"

#: sc/inc/scfuncs.hrc
msgctxt "ocARRAYTOTEXT"
msgid "The format of the returned text. 0 or omitted - concise format, the values separated by commas (default). 1 - strict format, an array constant in braces with quoted text, comma column separators and semicolon row separators."
msgstr "Định dạng của văn bản trả về. 0 hoặc bỏ trống - dạng ngắn gọn, các giá trị cách nhau bằng dấu phân cách đối số (mặc định). 1 - dạng chặt chẽ, một hằng mảng trong dấu ngoặc nhọn, văn bản đặt trong dấu nháy kép."

#: sc/inc/scfuncs.hrc
msgctxt "ocVALUETOTEXT"
msgid "Returns text from any value: text stays as it is, numbers, logical values and errors become their text."
msgstr "Trả về văn bản từ một giá trị bất kỳ: văn bản giữ nguyên, số, giá trị lô-gic và lỗi được chuyển thành văn bản."

#: sc/inc/scfuncs.hrc
msgctxt "ocVALUETOTEXT"
msgid "Value"
msgstr "Giá trị"

#: sc/inc/scfuncs.hrc
msgctxt "ocVALUETOTEXT"
msgid "The value to return as text."
msgstr "Giá trị cần trả về dưới dạng văn bản."

#: sc/inc/scfuncs.hrc
msgctxt "ocVALUETOTEXT"
msgid "Format"
msgstr "Định dạng"

#: sc/inc/scfuncs.hrc
msgctxt "ocVALUETOTEXT"
msgid "0 or omitted - concise format, as the cell shows it with the general format (default). 1 - strict format, text is enclosed in quotes."
msgstr "0 hoặc bỏ trống - dạng ngắn gọn, như ô hiển thị với định dạng chung (mặc định). 1 - dạng chặt chẽ, văn bản được đặt trong dấu nháy kép."

#: sc/inc/scfuncs.hrc
msgctxt "ocDBCS"
msgid "Converts half-width (single-byte) letters and katakana within a text to full-width (double-byte) characters."
msgstr "Chuyển các chữ cái và chữ katakana nửa độ rộng (một byte) trong văn bản thành ký tự toàn độ rộng (hai byte)."

#: sc/inc/scfuncs.hrc
msgctxt "ocDBCS"
msgid "Text"
msgstr "Văn bản"

#: sc/inc/scfuncs.hrc
msgctxt "ocDBCS"
msgid "The text or a reference to a cell that contains the text to convert."
msgstr "Văn bản hoặc tham chiếu tới ô chứa văn bản cần chuyển đổi."

#: sc/inc/scfuncs.hrc
msgctxt "ocPHONETIC"
msgid "Returns the phonetic guide (furigana) text of a cell. When the cell has no phonetic guide, its text is returned."
msgstr "Trả về văn bản hướng dẫn phát âm (furigana) của một ô. Nếu ô không có hướng dẫn phát âm thì trả về chính văn bản của ô."

#: sc/inc/scfuncs.hrc
msgctxt "ocPHONETIC"
msgid "Reference"
msgstr "Tham chiếu"

#: sc/inc/scfuncs.hrc
msgctxt "ocPHONETIC"
msgid "The cell that contains the text. For a range, its upper-left cell is used."
msgstr "Ô chứa văn bản. Với một vùng, ô ở góc trên bên trái được dùng."

#: sc/inc/scfuncs.hrc
msgctxt "ocPERCENTOF"
msgid "Returns the sum of a subset of values divided by the sum of all the values."
msgstr "Trả về tổng của một tập con các giá trị chia cho tổng của tất cả các giá trị."

#: sc/inc/scfuncs.hrc
msgctxt "ocPERCENTOF"
msgid "Data subset"
msgstr "Tập con dữ liệu"

#: sc/inc/scfuncs.hrc
msgctxt "ocPERCENTOF"
msgid "The values that are part of the whole."
msgstr "Các giá trị thuộc một phần của tổng thể."

#: sc/inc/scfuncs.hrc
msgctxt "ocPERCENTOF"
msgid "Data all"
msgstr "Toàn bộ dữ liệu"

#: sc/inc/scfuncs.hrc
msgctxt "ocPERCENTOF"
msgid "All the values; their sum is the whole."
msgstr "Tất cả các giá trị; tổng của chúng là tổng thể."

#: sc/inc/scfuncs.hrc
msgctxt "ocREGEXTEST"
msgid "Checks whether any part of a text matches a regular expression. Returns TRUE or FALSE."
msgstr "Kiểm tra xem có phần nào của văn bản khớp với biểu thức chính quy hay không. Trả về TRUE hoặc FALSE."

#: sc/inc/scfuncs.hrc
msgctxt "ocREGEXTEST"
msgid "Text"
msgstr "Văn bản"

#: sc/inc/scfuncs.hrc
msgctxt "ocREGEXTEST"
msgid "The text or a reference to a cell that contains the text to check."
msgstr "Văn bản hoặc tham chiếu tới ô chứa văn bản cần kiểm tra."

#: sc/inc/scfuncs.hrc
msgctxt "ocREGEXTEST"
msgid "Pattern"
msgstr "Mẫu"

#: sc/inc/scfuncs.hrc
msgctxt "ocREGEXTEST"
msgid "The regular expression that describes the text to find."
msgstr "Biểu thức chính quy mô tả văn bản cần tìm."

#: sc/inc/scfuncs.hrc
msgctxt "ocREGEXTEST"
msgid "Case sensitivity"
msgstr "Phân biệt chữ hoa"

#: sc/inc/scfuncs.hrc
msgctxt "ocREGEXTEST"
msgid "0 or omitted - case-sensitive. 1 - case-insensitive."
msgstr "0 hoặc bỏ trống - phân biệt chữ hoa, chữ thường. 1 - không phân biệt."

#: sc/inc/scfuncs.hrc
msgctxt "ocREGEXEXTRACT"
msgid "Extracts the parts of a text that match a regular expression."
msgstr "Trích xuất các phần của văn bản khớp với biểu thức chính quy."

#: sc/inc/scfuncs.hrc
msgctxt "ocREGEXEXTRACT"
msgid "Text"
msgstr "Văn bản"

#: sc/inc/scfuncs.hrc
msgctxt "ocREGEXEXTRACT"
msgid "The text or a reference to a cell that contains the text to extract from."
msgstr "Văn bản hoặc tham chiếu tới ô chứa văn bản cần trích xuất."

#: sc/inc/scfuncs.hrc
msgctxt "ocREGEXEXTRACT"
msgid "Pattern"
msgstr "Mẫu"

#: sc/inc/scfuncs.hrc
msgctxt "ocREGEXEXTRACT"
msgid "The regular expression that describes the text to extract."
msgstr "Biểu thức chính quy mô tả văn bản cần trích xuất."

#: sc/inc/scfuncs.hrc
msgctxt "ocREGEXEXTRACT"
msgid "Return mode"
msgstr "Chế độ trả về"

#: sc/inc/scfuncs.hrc
msgctxt "ocREGEXEXTRACT"
msgid "0 or omitted - the first match. 1 - all matches as an array. 2 - the capturing groups of the first match as an array."
msgstr "0 hoặc bỏ trống - kết quả khớp đầu tiên. 1 - tất cả kết quả khớp dưới dạng mảng. 2 - các nhóm bắt của kết quả khớp đầu tiên dưới dạng mảng."

#: sc/inc/scfuncs.hrc
msgctxt "ocREGEXEXTRACT"
msgid "Case sensitivity"
msgstr "Phân biệt chữ hoa"

#: sc/inc/scfuncs.hrc
msgctxt "ocREGEXEXTRACT"
msgid "0 or omitted - case-sensitive. 1 - case-insensitive."
msgstr "0 hoặc bỏ trống - phân biệt chữ hoa, chữ thường. 1 - không phân biệt."

#: sc/inc/scfuncs.hrc
msgctxt "ocREGEXREPLACE"
msgid "Replaces the parts of a text that match a regular expression."
msgstr "Thay thế các phần của văn bản khớp với biểu thức chính quy."

#: sc/inc/scfuncs.hrc
msgctxt "ocREGEXREPLACE"
msgid "Text"
msgstr "Văn bản"

#: sc/inc/scfuncs.hrc
msgctxt "ocREGEXREPLACE"
msgid "The text or a reference to a cell that contains the text to change."
msgstr "Văn bản hoặc tham chiếu tới ô chứa văn bản cần thay đổi."

#: sc/inc/scfuncs.hrc
msgctxt "ocREGEXREPLACE"
msgid "Pattern"
msgstr "Mẫu"

#: sc/inc/scfuncs.hrc
msgctxt "ocREGEXREPLACE"
msgid "The regular expression that describes the text to replace."
msgstr "Biểu thức chính quy mô tả văn bản cần thay thế."

#: sc/inc/scfuncs.hrc
msgctxt "ocREGEXREPLACE"
msgid "Replacement"
msgstr "Thay bằng"

#: sc/inc/scfuncs.hrc
msgctxt "ocREGEXREPLACE"
msgid "The replacement text. $1, $2... insert the capturing groups."
msgstr "Văn bản thay thế. $1, $2... chèn các nhóm bắt."

#: sc/inc/scfuncs.hrc
msgctxt "ocREGEXREPLACE"
msgid "Occurrence"
msgstr "Lần xuất hiện"

#: sc/inc/scfuncs.hrc
msgctxt "ocREGEXREPLACE"
msgid "0 or omitted - replace every match. A positive number replaces that match, a negative number counts from the end."
msgstr "0 hoặc bỏ trống - thay mọi kết quả khớp. Số dương thay kết quả khớp thứ đó, số âm đếm từ cuối."

#: sc/inc/scfuncs.hrc
msgctxt "ocREGEXREPLACE"
msgid "Case sensitivity"
msgstr "Phân biệt chữ hoa"

#: sc/inc/scfuncs.hrc
msgctxt "ocREGEXREPLACE"
msgid "0 or omitted - case-sensitive. 1 - case-insensitive."
msgstr "0 hoặc bỏ trống - phân biệt chữ hoa, chữ thường. 1 - không phân biệt."

#: sc/inc/scfuncs.hrc
msgctxt "ocTRIMRANGE"
msgid "Removes the blank rows and columns at the edges of a range or array."
msgstr "Loại bỏ các hàng và cột trống ở mép của một vùng hoặc mảng."

#: sc/inc/scfuncs.hrc
msgctxt "ocTRIMRANGE"
msgid "Range"
msgstr "Vùng"

#: sc/inc/scfuncs.hrc
msgctxt "ocTRIMRANGE"
msgid "The range or array to trim."
msgstr "Vùng hoặc mảng cần cắt bớt."

#: sc/inc/scfuncs.hrc
msgctxt "ocTRIMRANGE"
msgid "Trim rows"
msgstr "Cắt hàng"

#: sc/inc/scfuncs.hrc
msgctxt "ocTRIMRANGE"
msgid "0 - none. 1 - leading blank rows. 2 - trailing blank rows. 3 or omitted - both."
msgstr "0 - không cắt. 1 - các hàng trống ở đầu. 2 - các hàng trống ở cuối. 3 hoặc bỏ trống - cả hai."

#: sc/inc/scfuncs.hrc
msgctxt "ocTRIMRANGE"
msgid "Trim columns"
msgstr "Cắt cột"

#: sc/inc/scfuncs.hrc
msgctxt "ocTRIMRANGE"
msgid "0 - none. 1 - leading blank columns. 2 - trailing blank columns. 3 or omitted - both."
msgstr "0 - không cắt. 1 - các cột trống ở đầu. 2 - các cột trống ở cuối. 3 hoặc bỏ trống - cả hai."

#. hstPSC
#: sc/inc/strings.hrc
msgctxt "STR_PRINTSCALE_NONE"
msgid "No Scaling (print sheets at their actual size)"
msgstr "Không thu phóng (in kích thước thật)"

#. hstPSC
#: sc/inc/strings.hrc
msgctxt "STR_PRINTSCALE_FIT_SHEET"
msgid "Fit Sheet on One Page"
msgstr "Vừa trang tính trên một trang"

#. hstPSC
#: sc/inc/strings.hrc
msgctxt "STR_PRINTSCALE_FIT_COLUMNS"
msgid "Fit All Columns on One Page"
msgstr "Vừa tất cả các cột trên một trang"

#. hstPSC
#: sc/inc/strings.hrc
msgctxt "STR_PRINTSCALE_FIT_ROWS"
msgid "Fit All Rows on One Page"
msgstr "Vừa tất cả các hàng trên một trang"

#. hstPSC
#: sc/inc/strings.hrc
msgctxt "STR_PRINTSCALE_CUSTOM_PERCENT"
msgid "Custom Scaling: %1%"
msgstr "Thu phóng tùy chỉnh: %1%"

#. hstPSC
#: sc/inc/strings.hrc
msgctxt "STR_PRINTSCALE_CUSTOM_PAGES"
msgid "Custom Scaling: fit on %1 pages"
msgstr "Thu phóng tùy chỉnh: vừa %1 trang"

#. hstPSC
#: sc/inc/strings.hrc
msgctxt "STR_PRINTSCALE_CUSTOM_SIZE"
msgid "Custom Scaling: %1 pages wide by %2 pages tall"
msgstr "Thu phóng tùy chỉnh: rộng %1 trang, cao %2 trang"

#. hstPSC
#: sc/inc/strings.hrc
msgctxt "STR_PRINTSCALE_AUTOMATIC"
msgid "automatic"
msgstr "tự động"

#. hstCF
#: sc/inc/strings.hrc
msgctxt "STR_HST_CONDFORMAT_STYLE_LIGHT_RED"
msgid "Light Red Fill with Dark Red Text"
msgstr "Nền đỏ nhạt, chữ đỏ đậm"

#. hstCF
#: sc/inc/strings.hrc
msgctxt "STR_HST_CONDFORMAT_STYLE_YELLOW"
msgid "Yellow Fill with Dark Yellow Text"
msgstr "Nền vàng, chữ vàng đậm"

#. hstCF
#: sc/inc/strings.hrc
msgctxt "STR_HST_CONDFORMAT_STYLE_GREEN"
msgid "Green Fill with Dark Green Text"
msgstr "Nền xanh lục, chữ xanh lục đậm"

#. hstTextNumber
#: sc/inc/strings.hrc
msgctxt "STR_HST_TEXT_NUMBER"
msgid "Number Stored as Text"
msgstr "Số được lưu dưới dạng văn bản"

#. hstTextNumberUndo
#: sc/inc/strings.hrc
msgctxt "STR_HST_UNDO_TEXT_TO_NUMBER"
msgid "Convert to Number"
msgstr "Chuyển thành số"

#. hstFlashFillUndo
#: sc/inc/strings.hrc
msgctxt "STR_HST_UNDO_FLASH_FILL"
msgid "Flash Fill"
msgstr "Tự điền nhanh"

#. hstFlashFillNoData
#: sc/inc/strings.hrc
msgctxt "STR_HST_FLASH_FILL_NO_DATA"
msgid "Flash Fill needs data in a column next to the cell, and an example of the result typed in the cell's column."
msgstr "Tự điền nhanh cần dữ liệu ở cột bên cạnh ô và một ví dụ về kết quả đã gõ trong cột của ô."

#. hstFlashFillNoPattern
#: sc/inc/strings.hrc
msgctxt "STR_HST_FLASH_FILL_NO_PATTERN"
msgid "Flash Fill did not recognize a pattern. Type one or two more examples of the result in the column, then try again."
