#: sc/uiconfig/scalc/ui/externaldata.ui
msgctxt "externaldata|extended_tip|ExternalDataDialog"
msgid "Inserts data from an HTML, Sheets, CSV or Excel file into the current sheet as a link. The data must be located within a named range."
msgstr "Chèn dữ liệu từ tệp tin HTML, Sheets, CSV hoặc Excel vào trang tính hiện tại dưới dạng liên kết. Dữ liệu phải nằm trong một phạm vi được đặt tên."

#: sc/uiconfig/scalc/ui/formulacalculationoptions.ui
