#. LWUhA
#: uui/uiconfig/ui/unknownauthdialog.ui:112
msgctxt "unknownauthdialog|examine"
msgid "Examine Certificate…"
msgstr "Nghiên cứu chứng chỉ"

#. hstDS
#: uui/inc/strings.hrc
msgctxt "STR_TITLE_ENTER_TOKEN_PIN"
msgid "Enter PIN"
msgstr "Nhập mã PIN"

#. hstDS
#: uui/inc/strings.hrc
msgctxt "STR_ENTER_TOKEN_PIN"
msgid "Enter the PIN of the signing device (USB token or smart card) “%s”."
msgstr "Nhập mã PIN của thiết bị ký số (USB Token hoặc thẻ thông minh) “%s”."

#. hstDS
#: uui/inc/strings.hrc
msgctxt "STR_TOKEN_PIN_LABEL"
msgid "_PIN:"
msgstr "Mã _PIN:"

#. hstDS
#: uui/inc/strings.hrc
msgctxt "STR_ERROR_TOKEN_PIN_WRONG"
msgid "The PIN is incorrect. Enter it again. The device may lock itself after several incorrect attempts."
msgstr "Mã PIN không đúng. Hãy nhập lại. Thiết bị có thể tự khóa nếu nhập sai nhiều lần."
