#. hstLS
#: cui/inc/strings.hrc
msgctxt "RID_CUISTR_UI_LANGUAGE_NOT_SAVED"
msgid "The user interface language could not be changed. The setting may be managed by your administrator."
msgstr "The user interface language could not be changed. The setting may be managed by your administrator."

#. hstTD
#: cui/inc/tipoftheday.hrc
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Can’t find a command? Press Alt+Q and type its name; accents are optional."
msgstr "Can’t find a command? Press Alt+Q and type its name; accents are optional."

#. hstTD
#: cui/inc/tipoftheday.hrc
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Press Alt on its own: every ribbon tab and button shows a letter. Type the letters to run a command without the mouse."
msgstr "Press Alt on its own: every ribbon tab and button shows a letter. Type the letters to run a command without the mouse."

#. hstTD
#: cui/inc/tipoftheday.hrc
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Write an administrative document in the layout of Decree 30/2020/NĐ-CP: press Alt+Q and type “van ban hanh chinh”."
msgstr "Write an administrative document in the layout of Decree 30/2020/NĐ-CP: press Alt+Q and type “van ban hanh chinh”."

#. hstTD
#: cui/inc/tipoftheday.hrc
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Printing an administrative document on both sides? Alt+Q, “in hai mat” sets mirrored margins as Decree 30 requires."
msgstr "Printing an administrative document on both sides? Alt+Q, “in hai mat” sets mirrored margins as Decree 30 requires."

#. hstTD
#: cui/inc/tipoftheday.hrc
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Show amounts in Vietnamese đồng (1.234.567 ₫) in HST Sheets: select the cells, press Alt+Q and type “tien vnd”."
msgstr "Show amounts in Vietnamese đồng (1.234.567 ₫) in HST Sheets: select the cells, press Alt+Q and type “tien vnd”."

#. hstTD
#: cui/inc/tipoftheday.hrc
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Write a number in Vietnamese words in HST Sheets with =DOCSO(A1), or an amount with =DOCTIEN(A1)."
msgstr "Write a number in Vietnamese words in HST Sheets with =DOCSO(A1), or an amount with =DOCTIEN(A1)."

#. hstTD
#: cui/inc/tipoftheday.hrc
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Need a number in words in HST Writer? Select it, press Alt+Q and type “doc so”."
msgstr "Need a number in words in HST Writer? Select it, press Alt+Q and type “doc so”."

#. hstTD
#: cui/inc/tipoftheday.hrc
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Old text typed in TCVN3 (ABC) or VNI shows strange characters? Alt+Q, “chuyen ma” converts it to Unicode."
msgstr "Old text typed in TCVN3 (ABC) or VNI shows strange characters? Alt+Q, “chuyen ma” converts it to Unicode."

#. hstTD
#: cui/inc/tipoftheday.hrc
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Show dates as dd/mm/yyyy in HST Sheets: select the cells, press Alt+Q and type “dinh dang ngay”."
msgstr "Show dates as dd/mm/yyyy in HST Sheets: select the cells, press Alt+Q and type “dinh dang ngay”."

#. hstTD
#: cui/inc/tipoftheday.hrc
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Split full names into family, middle and given name in HST Sheets: Alt+Q, “tach ho ten”."
msgstr "Split full names into family, middle and given name in HST Sheets: Alt+Q, “tach ho ten”."

#. hstTD
#: cui/inc/tipoftheday.hrc
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Sort a class or staff list by given name, the Vietnamese way: Alt+Q, “sap xep theo ten”."
msgstr "Sort a class or staff list by given name, the Vietnamese way: Alt+Q, “sap xep theo ten”."

#. hstTD
#: cui/inc/tipoftheday.hrc
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Remove the Vietnamese accents from the selected cells, e.g. for user names or e-mail addresses: Alt+Q, “bo dau”."
msgstr "Remove the Vietnamese accents from the selected cells, e.g. for user names or e-mail addresses: Alt+Q, “bo dau”."

#. hstTD
#: cui/inc/tipoftheday.hrc
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Import a CSV file with Vietnamese text without broken characters: Alt+Q, “csv”."
msgstr "Import a CSV file with Vietnamese text without broken characters: Alt+Q, “csv”."

#. hstTD
#: cui/inc/tipoftheday.hrc
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Saved over a file by mistake? Alt+Q, “phien ban truoc” brings back an earlier version."
msgstr "Saved over a file by mistake? Alt+Q, “phien ban truoc” brings back an earlier version."

#. hstTD
#: cui/inc/tipoftheday.hrc
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Sign documents with a USB token: Alt+Q, “usb token” sets it up once, then File ▸ Digital Signatures."
msgstr "Sign documents with a USB token: Alt+Q, “usb token” sets it up once, then File ▸ Digital Signatures."

#. hstTD
#: cui/inc/tipoftheday.hrc
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Looking for a command you know from another office suite? Help tab ▸ “Lệnh quen thuộc ở đâu?” shows where it is."
msgstr "Looking for a command you know from another office suite? Help tab ▸ “Lệnh quen thuộc ở đâu?” shows where it is."

#. hstTD
#: cui/inc/tipoftheday.hrc
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Need to send a .docx, .xlsx or .pptx file? Use File ▸ Save As (F12) and choose the format."
msgstr "Need to send a .docx, .xlsx or .pptx file? Use File ▸ Save As (F12) and choose the format."

#. hstTD
#: cui/inc/tipoftheday.hrc
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Press F1 at any time for the user guide. It works without an Internet connection."
msgstr "Press F1 at any time for the user guide. It works without an Internet connection."

#. hstTD
#: cui/inc/tipoftheday.hrc
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Paste text without its formatting with %MOD1+%SHIFT+V. Help tab ▸ “Phím tắt” lists the other shortcuts."
msgstr "Paste text without its formatting with %MOD1+%SHIFT+V. Help tab ▸ “Phím tắt” lists the other shortcuts."

#. hstTD
#: cui/inc/tipoftheday.hrc
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Vietnamese spelling is checked as you type: right-click a word with a red wavy underline for suggestions, or press F7."
msgstr "Vietnamese spelling is checked as you type: right-click a word with a red wavy underline for suggestions, or press F7."

