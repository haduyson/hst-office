#. hstBk
#: filter/uiconfig/ui/pdfgeneralpage.ui
msgctxt "pdfgeneralpage|booklet"
msgid "Boo_klet (two pages per sheet side, fold in half)"
msgstr "Boo_klet (two pages per sheet side, fold in half)"

#. hstBt
#: filter/uiconfig/ui/pdfgeneralpage.ui
msgctxt "pdfgeneralpage|extended_tip|booklet"
msgid "Arranges the pages two per sheet side in folding order, adding blank pages up to a multiple of four. Print the PDF double-sided, flipping on the short edge, then fold the stack in half. Tags, links, outlines, comments and form fields are not exported."
msgstr "Arranges the pages two per sheet side in folding order, adding blank pages up to a multiple of four. Print the PDF double-sided, flipping on the short edge, then fold the stack in half. Tags, links, outlines, comments and form fields are not exported."

#: filter/uiconfig/ui/pdfgeneralpage.ui
msgctxt "pdfgeneralpage|extended_tip|comments"
msgid "Select to export comments of Writer and Sheets documents as PDF annotations."
msgstr "Select to export comments of Writer and Sheets documents as PDF annotations."

#: filter/uiconfig/ui/pdfuserinterfacepage.ui
msgctxt "pdfuserinterfacepage|extended_tip|effects"
msgid "Select to export Slides slide transition effects to respective PDF effects."
msgstr "Select to export Slides slide transition effects to respective PDF effects."
