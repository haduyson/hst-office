{"file": "sysui/desktop/share.po", "msgctxt": "launcher.ulf\\nwriter_Comment\\nLngText.text", "msgid": "Create and edit text and graphics in letters, reports, documents and Web pages.", "msgstr": "Tạo và sửa văn bản và đồ họa trong thư, báo cáo, tài liệu và trang web."}
{"file": "sysui/desktop/share.po", "msgctxt": "launcher.ulf\\nimpress_Comment\\nLngText.text", "msgid": "Create and edit presentations for slideshows, meetings and Web pages.", "msgstr": "Tạo và sửa trình chiếu cho buổi trình diễn, cuộc họp và trang web."}
{"file": "sysui/desktop/share.po", "msgctxt": "launcher.ulf\\ndraw_Comment\\nLngText.text", "msgid": "Create and edit drawings, flow charts and logos.", "msgstr": "Tạo và sửa bản vẽ, lưu đồ và logo."}
{"file": "sysui/desktop/share.po", "msgctxt": "launcher.ulf\\ncalc_Comment\\nLngText.text", "msgid": "Perform calculations, analyze information and manage lists in spreadsheets.", "msgstr": "Thực hiện tính toán, phân tích thông tin và quản lý danh sách trong bảng tính."}
{"file": "sysui/desktop/share.po", "msgctxt": "launcher.ulf\\nbase_Comment\\nLngText.text", "msgid": "Manage databases, create queries and reports to track and manage your information.", "msgstr": "Quản lý cơ sở dữ liệu, tạo truy vấn và báo cáo để theo dõi và quản lý thông tin của bạn."}
