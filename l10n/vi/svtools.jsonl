{"file": "svtools/messages.po", "msgctxt": "graphicexport|extended_tip|widthmf", "msgid": "Specifies the width.", "msgstr": "Xác định chiều rộng."}
{"file": "svtools/messages.po", "msgctxt": "graphicexport|extended_tip|widthlb", "msgid": "Specifies the measurement units.", "msgstr": "Xác định đơn vị đo."}
{"file": "svtools/messages.po", "msgctxt": "graphicexport|losslesscb", "msgid": "Lossless", "msgstr": "Không mất dữ liệu"}
{"file": "svtools/messages.po", "msgctxt": "graphicexport|extended_tip|losslesscb", "msgid": "Lossless images do not lose quality but result in larger files.", "msgstr": "Ảnh không mất dữ liệu sẽ giữ nguyên chất lượng nhưng tạo ra tập tin lớn hơn."}
{"file": "svtools/messages.po", "msgctxt": "graphicexport|extended_tip|compressionjpgwebpnf", "msgid": "Sets the quality for the export. Choose from a low quality with minimal file size, up to a high quality and big file size.", "msgstr": "Đặt chất lượng khi xuất. Chọn từ chất lượng thấp với kích thước tập tin nhỏ nhất, đến chất lượng cao với kích thước tập tin lớn."}
{"file": "svtools/messages.po", "msgctxt": "graphicexport|extended_tip|compressionpngnf", "msgid": "Sets the compression for the export. A high compression means a smaller, but slower to load image.", "msgstr": "Đặt mức nén khi xuất. Nén cao nghĩa là ảnh nhỏ hơn nhưng nạp chậm hơn."}
