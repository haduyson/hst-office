{"file": "svtools/messages.po", "msgctxt": "restartdialog|no", "msgid": "Restart _Later", "msgstr": "Khởi động lại _sau"}
{"file": "svtools/messages.po", "msgctxt": "restartdialog|reason_java", "msgid": "For the selected Java runtime environment to work properly, %PRODUCTNAME must be restarted.", "msgstr": "Để môi trường chạy Java đã chọn hoạt động đúng, cần khởi động lại %PRODUCTNAME."}
{"file": "svtools/messages.po", "msgctxt": "restartdialog|reason_mailmerge_install", "msgid": "For mail merge to work properly, %PRODUCTNAME must be restarted.", "msgstr": "Để trộn thư hoạt động đúng, cần khởi động lại %PRODUCTNAME."}
{"file": "svtools/messages.po", "msgctxt": "restartdialog|reason_bibliography_install", "msgid": "For the bibliography to work properly, %PRODUCTNAME must be restarted.", "msgstr": "Để thư tịch hoạt động đúng, cần khởi động lại %PRODUCTNAME."}
{"file": "svtools/messages.po", "msgctxt": "restartdialog|reason_assigning_folders", "msgid": "For the assigned folders and archives to take effect, %PRODUCTNAME must be restarted.", "msgstr": "Để các thư mục và kho lưu trữ đã gán có hiệu lực, cần khởi động lại %PRODUCTNAME."}
{"file": "svtools/messages.po", "msgctxt": "restartdialog|reason_assigning_javaparameters", "msgid": "For the assigned Java parameters to take effect, %PRODUCTNAME must be restarted.", "msgstr": "Để các tham số Java đã gán có hiệu lực, cần khởi động lại %PRODUCTNAME."}
{"file": "svtools/messages.po", "msgctxt": "restartdialog|reason_adding_path", "msgid": "For the added path to take effect, %PRODUCTNAME must be restarted.", "msgstr": "Để đường dẫn đã thêm có hiệu lực, cần khởi động lại %PRODUCTNAME."}
{"file": "svtools/messages.po", "msgctxt": "restartdialog|reason_language_change", "msgid": "For the updated UI language setting to take effect, %PRODUCTNAME must be restarted.", "msgstr": "Để thiết lập ngôn ngữ giao diện mới có hiệu lực, cần khởi động lại %PRODUCTNAME."}
{"file": "svtools/messages.po", "msgctxt": "restartdialog|reason_exp_features", "msgid": "For the modified experimental features to take effect, %PRODUCTNAME must be restarted.", "msgstr": "Để các tính năng thử nghiệm đã sửa đổi có hiệu lực, cần khởi động lại %PRODUCTNAME."}
{"file": "svtools/messages.po", "msgctxt": "restartdialog|reason_extension_install", "msgid": "For the extension to work properly, %PRODUCTNAME must be restarted.", "msgstr": "Để phần mở rộng hoạt động đúng, cần khởi động lại %PRODUCTNAME."}
{"file": "svtools/messages.po", "msgctxt": "restartdialog|reason_theme_reload", "msgid": "To apply theme changes, %PRODUCTNAME must be restarted.", "msgstr": "Để áp dụng thay đổi chủ đề, cần khởi động lại %PRODUCTNAME."}
{"file": "svtools/messages.po", "msgctxt": "restartdialog|reason_calculation", "msgid": "For the Calculation settings changes to take effect, %PRODUCTNAME must be restarted.", "msgstr": "Để các thay đổi thiết lập Tính toán có hiệu lực, cần khởi động lại %PRODUCTNAME."}
{"file": "svtools/messages.po", "msgctxt": "restartdialog|label", "msgid": "Do you want to restart %PRODUCTNAME now?", "msgstr": "Bạn có muốn khởi động lại %PRODUCTNAME ngay không?"}
{"file": "svtools/messages.po", "msgctxt": "restartdialog|reason_skia", "msgid": "For the Skia changes to take effect, %PRODUCTNAME must be restarted.", "msgstr": "Để các thay đổi Skia có hiệu lực, cần khởi động lại %PRODUCTNAME."}
