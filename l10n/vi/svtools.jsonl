{"file": "svtools/messages.po", "msgctxt": "printersetupdialog|extended_tip|name", "msgid": "Lists the installed printers on your operating system. To change the default printer, select a printer name from the list.", "msgstr": "Liệt kê các máy in đã cài đặt trên hệ điều hành của bạn. Để thay đổi máy in mặc định, hãy chọn tên máy in trong danh sách."}
{"file": "svtools/messages.po", "msgctxt": "printersetupdialog|extended_tip|properties", "msgid": "Changes the printer settings of your operating system for the current document.", "msgstr": "Thay đổi thiết lập máy in của hệ điều hành cho tài liệu hiện tại."}
{"file": "svtools/messages.po", "msgctxt": "printersetupdialog|extended_tip|PrinterSetupDialog", "msgid": "Select the default printer for the current document.", "msgstr": "Chọn máy in mặc định cho tài liệu hiện tại."}
