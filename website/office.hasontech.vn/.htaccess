# HST Office — document root Apache sau nginx / DirectAdmin.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # nginx phải ghi đè X-Forwarded-Proto bằng giao thức thực của client.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
  RewriteRule ^ https://office.hasontech.vn%{REQUEST_URI} [R=301,L]

  # Chỉ phục vụ tài sản website, không phục vụ thư mục công cụ/báo cáo.
  RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
  RewriteRule ^(?:plans|docs)(?:/|$) - [F,L,NC]
  RewriteRule ^README\.md$ - [F,L,NC]

  # Bản hiện hành: v1.0.0-beta.3. Dùng 302 để link chia sẻ không bị ghim bản cũ.
  RewriteRule ^tai/windows/?$ https://github.com/haduyson/hst-office/releases/download/v1.0.0-beta.3/HSTOffice_1.0.0_Win_x86-64_en-US_vi.msi [R=302,L,QSD]
  RewriteRule ^tai/macos-arm/?$ https://github.com/haduyson/hst-office/releases/download/v1.0.0-beta.3/HSTOffice_1.0.0_macOS_arm64.dmg [R=302,L,QSD]
  RewriteRule ^tai/macos-intel/?$ https://github.com/haduyson/hst-office/releases/download/v1.0.0-beta.3/HSTOffice_1.0.0_macOS_x86_64.dmg [R=302,L,QSD]
  RewriteRule ^tai/linux/?$ https://github.com/haduyson/hst-office/releases/download/v1.0.0-beta.3/HSTOffice_1.0.0_Linux_x86-64.deb [R=302,L,QSD]
  # SHA256SUMS phục vụ ngay trên domain (tai/SHA256SUMS, bản sao từ release) để mọi trình duyệt tải thẳng, không hiện GitHub.
  # Ra bản mới: đổi tag/tên tệp trong 4 dòng trên và thay tệp tai/SHA256SUMS (mỗi dòng ứng với một tệp đang được tải ở trên).
  RewriteRule ^tai/sha256/?$ /tai/SHA256SUMS [L]
</IfModule>

<IfModule mod_dir.c>
  DirectoryIndex index.html
</IfModule>
<IfModule core.c>
  ErrorDocument 404 /404.html
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.(?:css|js|woff2|webp|png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Config thay đổi theo bản phát hành, luôn xác thực lại cùng HTML.
  <FilesMatch "(?:\.html$|^config\.js$)">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Manifest kiểm tra cập nhật (docs/UPDATE_CHECK.md): cache ngắn để bản mới đến người dùng trong vài phút.
  <FilesMatch "^latest(?:-[0-9]+)?\.json(?:\.sig)?$">
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
  </IfModule>
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/json .json
  AddType text/plain .sig
  AddType image/svg+xml .svg
  AddType application/x-msi .msi
  AddType application/x-apple-diskimage .dmg
  AddType application/vnd.debian.binary-package .deb
</IfModule>

# Bộ cài HST Office phục vụ trực tiếp từ tai/<phiên bản>/: tải xuống với tên tệp gốc, tải tiếp được (Range),
# không nén, cache dài vì mỗi thư mục phiên bản là bất biến.
<FilesMatch "^(?<installer>[^/]+\.(?:msi|dmg|deb))$">
  SetEnv no-gzip 1
  <IfModule mod_headers.c>
    Header set Content-Disposition "attachment; filename=\"%{MATCH_INSTALLER}e\""
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header unset Content-Encoding
  </IfModule>
</FilesMatch>

# Tải thẳng SHA256SUMS (tệp không có đuôi) như một tệp văn bản.
<Files "SHA256SUMS">
  ForceType text/plain
  <IfModule mod_headers.c>
    Header set Content-Disposition "attachment; filename=SHA256SUMS"
    Header set Cache-Control "no-cache, must-revalidate"
  </IfModule>
</Files>
