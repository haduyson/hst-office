# HST Office — document root Apache sau nginx / DirectAdmin.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # nginx phải ghi đè X-Forwarded-Proto bằng giao thức thực của client.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
  RewriteRule ^ https://office.hasontech.vn%{REQUEST_URI} [R=301,L]

  # Chỉ phục vụ tài sản website, không phục vụ thư mục công cụ/báo cáo.
  RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
  RewriteRule ^(?:plans|docs)(?:/|$) - [F,L,NC]
  RewriteRule ^README\.md$ - [F,L,NC]

  # Bản hiện hành: v1.0.0-beta.1. Dùng 302 để link chia sẻ không bị ghim bản cũ.
  RewriteRule ^tai/windows/?$ https://github.com/haduyson/hst-office/releases/download/v1.0.0-beta.1/HSTOffice_1.0.0_Win_x86-64_en-US_vi.msi [R=302,L,QSD]
  RewriteRule ^tai/linux/?$ https://github.com/haduyson/hst-office/releases/download/v1.0.0-beta.1/HSTOffice_1.0.0_Linux_x86-64_deb.tar.gz [R=302,L,QSD]
  RewriteRule ^tai/sha256/?$ https://github.com/haduyson/hst-office/releases/download/v1.0.0-beta.1/SHA256SUMS [R=302,L,QSD]
  RewriteRule ^tai/macos-(arm|intel)/?$ /#tai-ve [R=302,L,NE,QSD]

  # Beta.2: thay các dòng hiện hành ở trên, KHÔNG bật đồng thời hai bộ quy tắc.
  # RewriteRule ^tai/windows/?$ https://github.com/haduyson/hst-office/releases/download/v1.0.0-beta.2/HSTOffice_1.0.0_Win_x86-64_en-US_vi.msi [R=302,L,QSD]
  # RewriteRule ^tai/linux/?$ https://github.com/haduyson/hst-office/releases/download/v1.0.0-beta.2/HSTOffice_1.0.0_Linux_x86-64_deb.tar.gz [R=302,L,QSD]
  # RewriteRule ^tai/sha256/?$ https://github.com/haduyson/hst-office/releases/download/v1.0.0-beta.2/SHA256SUMS [R=302,L,QSD]
  # RewriteRule ^tai/macos-arm/?$ https://github.com/haduyson/hst-office/releases/download/v1.0.0-beta.2/HSTOffice_1.0.0_macOS_arm64.dmg [R=302,L,QSD]
  # RewriteRule ^tai/macos-intel/?$ https://github.com/haduyson/hst-office/releases/download/v1.0.0-beta.2/HSTOffice_1.0.0_macOS_x86_64.dmg [R=302,L,QSD]
</IfModule>

<IfModule mod_dir.c>
  DirectoryIndex index.html
</IfModule>
<IfModule core.c>
  ErrorDocument 404 /404.html
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.(?:css|js|woff2|webp|png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Config thay đổi theo bản phát hành, luôn xác thực lại cùng HTML.
  <FilesMatch "(?:\.html$|^config\.js$)">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Manifest kiểm tra cập nhật (docs/UPDATE_CHECK.md): cache ngắn để bản mới đến người dùng trong vài phút.
  <FilesMatch "^latest\.json(?:\.sig)?$">
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
  </IfModule>
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/json .json
  AddType text/plain .sig
  AddType image/svg+xml .svg
</IfModule>
