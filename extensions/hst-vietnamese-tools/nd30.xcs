<?xml version="1.0" encoding="UTF-8"?>
<oor:component-schema xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema"
                      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                      oor:name="Nd30" oor:package="org.hasontech.hstoffice" xml:lang="en-US">
  <info>
    <desc>Per-user choices of the ND30 wizard "Văn bản hành chính" (hst_office/nd30_prefs.py), remembered from the
      last accepted wizard. No document text is kept. No data leaves the machine.</desc>
  </info>
  <component>
    <prop oor:name="AgencyRule" oor:type="xs:string" oor:nillable="false">
      <info>
        <desc>Length of the rule under the agency name: 1/3, 2/5, 1/2 of the agency line, "parent" (as long as the line
          above it) or "mm:LENGTH" (typed in millimetres). Anything else reads as 2/5.</desc>
      </info>
      <value>2/5</value>
    </prop>
  </component>
</oor:component-schema>
