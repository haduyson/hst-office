<?xml version="1.0" encoding="UTF-8"?>
<oor:component-schema xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema"
                      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                      oor:name="NumberWords" oor:package="org.hasontech.hstoffice" xml:lang="en-US">
  <info>
    <desc>Per-user last choice of the dialog "Đọc số thành chữ" (hst_office/number_words_prefs.py); the dialog opens
      with it unless the spreadsheet carries its own default unit. Cells are never kept. No data leaves the machine.</desc>
  </info>
  <component>
    <prop oor:name="Money" oor:type="xs:boolean" oor:nillable="false">
      <info>
        <desc>Read as money (DOCTIEN) rather than as a number (DOCSO).</desc>
      </info>
      <value>false</value>
    </prop>
    <prop oor:name="Unit" oor:type="xs:string" oor:nillable="false">
      <info>
        <desc>Money unit last used, e.g. đồng or dollar (at most 40 characters).</desc>
      </info>
      <value>đồng</value>
    </prop>
    <prop oor:name="SubUnit" oor:type="xs:string" oor:nillable="false">
      <info>
        <desc>Sub-unit last used, e.g. xu or cent; empty reads whole units only.</desc>
      </info>
      <value></value>
    </prop>
    <prop oor:name="Thousand" oor:type="xs:string" oor:nillable="false">
      <info>
        <desc>nghìn or ngàn.</desc>
      </info>
      <value>nghìn</value>
    </prop>
    <prop oor:name="Odd" oor:type="xs:string" oor:nillable="false">
      <info>
        <desc>lẻ or linh (zero tens).</desc>
      </info>
      <value>lẻ</value>
    </prop>
    <prop oor:name="Four" oor:type="xs:string" oor:nillable="false">
      <info>
        <desc>bốn or tư (4 after mươi).</desc>
      </info>
      <value>bốn</value>
    </prop>
    <prop oor:name="Language" oor:type="xs:string" oor:nillable="false">
      <info>
        <desc>vi or en.</desc>
      </info>
      <value>vi</value>
    </prop>
    <prop oor:name="Formula" oor:type="xs:boolean" oor:nillable="false">
      <info>
        <desc>Sheets: write a DOCSO/DOCTIEN formula rather than plain words.</desc>
      </info>
      <value>false</value>
    </prop>
  </component>
</oor:component-schema>
