<?xml version="1.0" encoding="UTF-8"?>
<oor:component-schema xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema"
                      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                      oor:name="NumberWords" oor:package="org.hasontech.hstoffice" xml:lang="en-US">
  <info>
    <desc>Per-user default of number and money reading (hst_office/number_words_prefs.py): set in Tùy chọn ▸ HST
      Office ▸ Đọc số và tiền and by the dialog "Đọc số thành chữ", which opens with it unless the spreadsheet has its
      own default. DOCSO/DOCTIEN in a cell never read it. Cells are never kept. No data leaves the machine.</desc>
  </info>
  <component>
    <prop oor:name="Money" oor:type="xs:boolean" oor:nillable="false">
      <info>
        <desc>The dialog last read money (DOCTIEN) rather than a number (DOCSO).</desc>
      </info>
      <value>false</value>
    </prop>
    <prop oor:name="Formula" oor:type="xs:boolean" oor:nillable="false">
      <info>
        <desc>Sheets: the dialog last wrote a DOCSO/DOCTIEN formula rather than plain words.</desc>
      </info>
      <value>false</value>
    </prop>
    <prop oor:name="Unit" oor:type="xs:string" oor:nillable="false">
      <info>
        <desc>Default money unit, e.g. đồng or dollar (at most 40 characters).</desc>
      </info>
      <value>đồng</value>
    </prop>
    <prop oor:name="SubUnit" oor:type="xs:string" oor:nillable="false">
      <info>
        <desc>Default sub-unit, e.g. xu or cent; empty reads whole units only.</desc>
      </info>
      <value></value>
    </prop>
    <prop oor:name="MoneyOptions" oor:type="xs:string" oor:nillable="false">
      <info>
        <desc>Default reading options of money, as DOCTIEN accepts them (e.g. ngàn linh tư en); empty: nghìn lẻ bốn, Vietnamese.</desc>
      </info>
      <value></value>
    </prop>
    <prop oor:name="NumberOptions" oor:type="xs:string" oor:nillable="false">
      <info>
        <desc>Default reading options of numbers, as DOCSO accepts them; empty: nghìn lẻ bốn, Vietnamese.</desc>
      </info>
      <value></value>
    </prop>
  </component>
</oor:component-schema>
