<?xml version="1.0" encoding="UTF-8"?>
<!-- Sheets functions of HST Office (python/hst_office/calc_functions.py, types/hst-calc-functions.rdb).
     Category "Vietnamese" is shown as "Tiếng Việt" (hst-calc-vietnamese-category.patch; "Add-in" without it).
     CompatibilityName is the name written into .xlsx files, so HST reads them back as the same functions.
     Parameter node names equal the IDL parameter names (idl/XCalcFunctions.idl). -->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="CalcAddIns" oor:package="org.openoffice.Office">
  <node oor:name="AddInInfo">
    <node oor:name="org.hst.office.vi.CalcFunctions" oor:op="replace">
      <node oor:name="AddInFunctions">
        <node oor:name="docso" oor:op="replace">
          <prop oor:name="DisplayName">
            <value xml:lang="en-US">DOCSO</value>
            <value xml:lang="vi">DOCSO</value>
          </prop>
          <prop oor:name="Description">
            <value xml:lang="en-US">Reads a number as Vietnamese words, e.g. 105 as “Một trăm lẻ năm”, -2.5 as “Âm hai phẩy năm”. At most 15 integer digits.</value>
            <value xml:lang="vi">Đọc số thành chữ tiếng Việt, ví dụ 105 thành “Một trăm lẻ năm”, -2,5 thành “Âm hai phẩy năm”. Tối đa 15 chữ số phần nguyên.</value>
          </prop>
          <prop oor:name="Category"><value>Vietnamese</value></prop>
          <prop oor:name="CompatibilityName"><value xml:lang="en-US">DOCSO</value></prop>
          <node oor:name="Parameters">
            <node oor:name="Number" oor:op="replace">
              <prop oor:name="DisplayName">
                <value xml:lang="en-US">number</value>
                <value xml:lang="vi">số</value>
              </prop>
              <prop oor:name="Description">
                <value xml:lang="en-US">The number to read.</value>
                <value xml:lang="vi">Số cần đọc.</value>
              </prop>
            </node>
            <node oor:name="ReadingOptions" oor:op="replace">
              <prop oor:name="DisplayName">
                <value xml:lang="en-US">options</value>
                <value xml:lang="vi">cách_đọc</value>
              </prop>
              <prop oor:name="Description">
                <value xml:lang="en-US">Optional. One or more words: “ngàn” (instead of “nghìn”), “linh” (instead of “lẻ”), “tư” (hai mươi tư instead of hai mươi bốn), “en” (English words).</value>
                <value xml:lang="vi">Không bắt buộc. Một hoặc vài từ: “ngàn” (thay “nghìn”), “linh” (thay “lẻ”), “tư” (hai mươi tư thay hai mươi bốn), “en” (đọc tiếng Anh).</value>
              </prop>
            </node>
          </node>
        </node>
        <node oor:name="doctien" oor:op="replace">
          <prop oor:name="DisplayName">
            <value xml:lang="en-US">DOCTIEN</value>
            <value xml:lang="vi">DOCTIEN</value>
          </prop>
          <prop oor:name="Description">
            <value xml:lang="en-US">Reads an amount of money as words, e.g. 10000000 as “Mười triệu đồng chẵn”, 1500.75 as “Một nghìn năm trăm đồng bảy mươi lăm xu”.</value>
            <value xml:lang="vi">Đọc số tiền thành chữ, ví dụ 10000000 thành “Mười triệu đồng chẵn”, 1500,75 thành “Một nghìn năm trăm đồng bảy mươi lăm xu”.</value>
          </prop>
          <prop oor:name="Category"><value>Vietnamese</value></prop>
          <prop oor:name="CompatibilityName"><value xml:lang="en-US">DOCTIEN</value></prop>
          <node oor:name="Parameters">
            <node oor:name="Number" oor:op="replace">
              <prop oor:name="DisplayName">
                <value xml:lang="en-US">amount</value>
                <value xml:lang="vi">số_tiền</value>
              </prop>
              <prop oor:name="Description">
                <value xml:lang="en-US">The amount to read.</value>
                <value xml:lang="vi">Số tiền cần đọc.</value>
              </prop>
            </node>
            <node oor:name="UnitName" oor:op="replace">
              <prop oor:name="DisplayName">
                <value xml:lang="en-US">unit</value>
                <value xml:lang="vi">đơn_vị</value>
              </prop>
              <prop oor:name="Description">
                <value xml:lang="en-US">Optional. Name of the currency unit; “đồng” by default (“dollar” in English).</value>
                <value xml:lang="vi">Không bắt buộc. Tên đơn vị tiền, mặc định “đồng” (“dollar” khi đọc tiếng Anh).</value>
              </prop>
            </node>
            <node oor:name="SubUnitName" oor:op="replace">
              <prop oor:name="DisplayName">
                <value xml:lang="en-US">subunit</value>
                <value xml:lang="vi">đơn_vị_lẻ</value>
              </prop>
              <prop oor:name="Description">
                <value xml:lang="en-US">Optional. Name of the unit of the two decimals; “xu” by default (“cent” in English). Use "" to round to whole units.</value>
                <value xml:lang="vi">Không bắt buộc. Tên đơn vị của hai chữ số thập phân, mặc định “xu” (“cent” khi đọc tiếng Anh). Ghi "" để làm tròn tới đơn vị.</value>
              </prop>
            </node>
            <node oor:name="ReadingOptions" oor:op="replace">
              <prop oor:name="DisplayName">
                <value xml:lang="en-US">options</value>
                <value xml:lang="vi">cách_đọc</value>
              </prop>
              <prop oor:name="Description">
                <value xml:lang="en-US">Optional. One or more words: “ngàn” (instead of “nghìn”), “linh” (instead of “lẻ”), “tư” (hai mươi tư instead of hai mươi bốn), “en” (English words).</value>
                <value xml:lang="vi">Không bắt buộc. Một hoặc vài từ: “ngàn” (thay “nghìn”), “linh” (thay “lẻ”), “tư” (hai mươi tư thay hai mươi bốn), “en” (đọc tiếng Anh).</value>
              </prop>
            </node>
          </node>
        </node>
        <node oor:name="bodau" oor:op="replace">
          <prop oor:name="DisplayName">
            <value xml:lang="en-US">BODAU</value>
            <value xml:lang="vi">BODAU</value>
          </prop>
          <prop oor:name="Description">
            <value xml:lang="en-US">Removes Vietnamese diacritics: “Nguyễn Văn Đức” becomes “Nguyen Van Duc”.</value>
            <value xml:lang="vi">Bỏ dấu tiếng Việt: “Nguyễn Văn Đức” thành “Nguyen Van Duc”.</value>
          </prop>
          <prop oor:name="Category"><value>Vietnamese</value></prop>
          <prop oor:name="CompatibilityName"><value xml:lang="en-US">BODAU</value></prop>
          <node oor:name="Parameters">
            <node oor:name="Text" oor:op="replace">
              <prop oor:name="DisplayName">
                <value xml:lang="en-US">text</value>
                <value xml:lang="vi">văn_bản</value>
              </prop>
              <prop oor:name="Description">
                <value xml:lang="en-US">The text.</value>
                <value xml:lang="vi">Văn bản cần bỏ dấu.</value>
              </prop>
            </node>
          </node>
        </node>
        <node oor:name="tachho" oor:op="replace">
          <prop oor:name="DisplayName">
            <value xml:lang="en-US">TACHHO</value>
            <value xml:lang="vi">TACHHO</value>
          </prop>
          <prop oor:name="Description">
            <value xml:lang="en-US">Family and middle names of a full name: “Nguyễn Thị Minh Khai” gives “Nguyễn Thị Minh”.</value>
            <value xml:lang="vi">Họ và tên đệm của một họ tên: “Nguyễn Thị Minh Khai” thành “Nguyễn Thị Minh”.</value>
          </prop>
          <prop oor:name="Category"><value>Vietnamese</value></prop>
          <prop oor:name="CompatibilityName"><value xml:lang="en-US">TACHHO</value></prop>
          <node oor:name="Parameters">
            <node oor:name="Text" oor:op="replace">
              <prop oor:name="DisplayName">
                <value xml:lang="en-US">full_name</value>
                <value xml:lang="vi">họ_tên</value>
              </prop>
              <prop oor:name="Description">
                <value xml:lang="en-US">The full name.</value>
                <value xml:lang="vi">Họ và tên đầy đủ.</value>
              </prop>
            </node>
          </node>
        </node>
        <node oor:name="tachten" oor:op="replace">
          <prop oor:name="DisplayName">
            <value xml:lang="en-US">TACHTEN</value>
            <value xml:lang="vi">TACHTEN</value>
          </prop>
          <prop oor:name="Description">
            <value xml:lang="en-US">Given name (last word) of a full name: “Nguyễn Thị Minh Khai” gives “Khai”.</value>
            <value xml:lang="vi">Tên (từ cuối) của một họ tên: “Nguyễn Thị Minh Khai” thành “Khai”.</value>
          </prop>
          <prop oor:name="Category"><value>Vietnamese</value></prop>
          <prop oor:name="CompatibilityName"><value xml:lang="en-US">TACHTEN</value></prop>
          <node oor:name="Parameters">
            <node oor:name="Text" oor:op="replace">
              <prop oor:name="DisplayName">
                <value xml:lang="en-US">full_name</value>
                <value xml:lang="vi">họ_tên</value>
              </prop>
              <prop oor:name="Description">
                <value xml:lang="en-US">The full name.</value>
                <value xml:lang="vi">Họ và tên đầy đủ.</value>
              </prop>
            </node>
          </node>
        </node>
      </node>
    </node>
  </node>
</oor:component-data>
