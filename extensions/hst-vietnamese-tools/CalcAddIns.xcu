<?xml version="1.0" encoding="UTF-8"?>
<!-- Sheets functions of HST Office (python/hst_office/calc_functions.py, types/hst-calc-functions.rdb).
     Category "Vietnamese" is shown as "Tiếng Việt" (hst-calc-vietnamese-category.patch; "Add-in" without it).
     CompatibilityName is the name written into .xlsx files, so HST reads them back as the same functions.
     Parameter node names equal the IDL parameter names (idl/XCalcFunctions.idl). -->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="CalcAddIns" oor:package="org.openoffice.Office">
  <node oor:name="AddInInfo">
    <node oor:name="org.hst.office.vi.CalcFunctions" oor:op="replace">
      <node oor:name="AddInFunctions">
        <node oor:name="docso" oor:op="replace">
          <prop oor:name="DisplayName">
            <value xml:lang="en-US">DOCSO</value>
            <value xml:lang="vi">DOCSO</value>
          </prop>
          <prop oor:name="Description">
            <value xml:lang="en-US">Reads a number as Vietnamese words, e.g. 105 as “Một trăm lẻ năm”, -2.5 as “Âm hai phẩy năm”. At most 15 integer digits.</value>
            <value xml:lang="vi">Đọc số thành chữ tiếng Việt, ví dụ 105 thành “Một trăm lẻ năm”, -2,5 thành “Âm hai phẩy năm”. Tối đa 15 chữ số phần nguyên.</value>
          </prop>
          <prop oor:name="Category"><value>Vietnamese</value></prop>
          <prop oor:name="CompatibilityName"><value xml:lang="en-US">DOCSO</value></prop>
          <node oor:name="Parameters">
            <node oor:name="Number" oor:op="replace">
              <prop oor:name="DisplayName">
                <value xml:lang="en-US">number</value>
                <value xml:lang="vi">số</value>
              </prop>
              <prop oor:name="Description">
                <value xml:lang="en-US">The number to read.</value>
                <value xml:lang="vi">Số cần đọc.</value>
              </prop>
            </node>
            <node oor:name="ReadingOptions" oor:op="replace">
              <prop oor:name="DisplayName">
                <value xml:lang="en-US">options</value>
                <value xml:lang="vi">cách_đọc</value>
              </prop>
              <prop oor:name="Description">
                <value xml:lang="en-US">Optional. One or more words: “ngàn” (instead of “nghìn”), “linh” (instead of “lẻ”), “tư” (hai mươi tư instead of hai mươi bốn), “en” (English words). Left out: the file’s default reading (set in the “Đọc số thành chữ” dialog), else nghìn, lẻ, bốn in Vietnamese.</value>
                <value xml:lang="vi">Không bắt buộc. Một hoặc vài từ: “ngàn” (thay “nghìn”), “linh” (thay “lẻ”), “tư” (hai mươi tư thay hai mươi bốn), “en” (đọc tiếng Anh). Bỏ trống: theo cách đọc mặc định của tệp (đặt trong hộp thoại “Đọc số thành chữ”), không có thì đọc nghìn, lẻ, bốn, tiếng Việt.</value>
              </prop>
            </node>
          </node>
        </node>
        <node oor:name="doctien" oor:op="replace">
          <prop oor:name="DisplayName">
            <value xml:lang="en-US">DOCTIEN</value>
            <value xml:lang="vi">DOCTIEN</value>
          </prop>
          <prop oor:name="Description">
            <value xml:lang="en-US">Reads an amount of money as words, e.g. 10000000 as “Mười triệu đồng chẵn”; by default it reads whole đồng, 1500.75 as “Một nghìn năm trăm lẻ một đồng chẵn”.</value>
            <value xml:lang="vi">Đọc số tiền thành chữ, ví dụ 10000000 thành “Mười triệu đồng chẵn”; mặc định đọc tròn tới đồng, 1500,75 thành “Một nghìn năm trăm lẻ một đồng chẵn”.</value>
          </prop>
          <prop oor:name="Category"><value>Vietnamese</value></prop>
          <prop oor:name="CompatibilityName"><value xml:lang="en-US">DOCTIEN</value></prop>
          <node oor:name="Parameters">
            <node oor:name="Number" oor:op="replace">
              <prop oor:name="DisplayName">
                <value xml:lang="en-US">amount</value>
                <value xml:lang="vi">số_tiền</value>
              </prop>
              <prop oor:name="Description">
                <value xml:lang="en-US">The amount to read.</value>
                <value xml:lang="vi">Số tiền cần đọc.</value>
              </prop>
            </node>
            <node oor:name="UnitName" oor:op="replace">
              <prop oor:name="DisplayName">
                <value xml:lang="en-US">unit</value>
                <value xml:lang="vi">đơn_vị</value>
              </prop>
              <prop oor:name="Description">
                <value xml:lang="en-US">Optional. Name of the currency unit. Left out: the file’s default unit and sub-unit, else “đồng” (“dollar” in English).</value>
                <value xml:lang="vi">Không bắt buộc. Tên đơn vị tiền. Bỏ trống: theo đơn vị và đơn vị lẻ mặc định của tệp, không có thì “đồng” (“dollar” khi đọc tiếng Anh).</value>
              </prop>
            </node>
            <node oor:name="SubUnitName" oor:op="replace">
              <prop oor:name="DisplayName">
                <value xml:lang="en-US">subunit</value>
                <value xml:lang="vi">đơn_vị_lẻ</value>
              </prop>
              <prop oor:name="Description">
                <value xml:lang="en-US">Optional. Name of the unit of the two decimals, e.g. “xu”. "": the amount is rounded half up to whole units. Left out: with the unit left out, the file’s default; otherwise rounded to whole units (in English the default is “cent”).</value>
                <value xml:lang="vi">Không bắt buộc. Tên đơn vị của hai chữ số thập phân, ví dụ “xu”. Ghi "": làm tròn tới đồng, từ 0,5 trở lên làm tròn lên. Bỏ trống: nếu cũng bỏ trống đơn vị thì theo mặc định của tệp, không thì làm tròn tới đồng (khi đọc tiếng Anh, mặc định là “cent”).</value>
              </prop>
            </node>
            <node oor:name="ReadingOptions" oor:op="replace">
              <prop oor:name="DisplayName">
                <value xml:lang="en-US">options</value>
                <value xml:lang="vi">cách_đọc</value>
              </prop>
              <prop oor:name="Description">
                <value xml:lang="en-US">Optional. One or more words: “ngàn” (instead of “nghìn”), “linh” (instead of “lẻ”), “tư” (hai mươi tư instead of hai mươi bốn), “en” (English words). Left out: the file’s default reading (set in the “Đọc số thành chữ” dialog), else nghìn, lẻ, bốn in Vietnamese.</value>
                <value xml:lang="vi">Không bắt buộc. Một hoặc vài từ: “ngàn” (thay “nghìn”), “linh” (thay “lẻ”), “tư” (hai mươi tư thay hai mươi bốn), “en” (đọc tiếng Anh). Bỏ trống: theo cách đọc mặc định của tệp (đặt trong hộp thoại “Đọc số thành chữ”), không có thì đọc nghìn, lẻ, bốn, tiếng Việt.</value>
              </prop>
            </node>
          </node>
        </node>
        <node oor:name="bodau" oor:op="replace">
          <prop oor:name="DisplayName">
            <value xml:lang="en-US">BODAU</value>
            <value xml:lang="vi">BODAU</value>
          </prop>
          <prop oor:name="Description">
            <value xml:lang="en-US">Removes Vietnamese diacritics: “Nguyễn Văn Đức” becomes “Nguyen Van Duc”.</value>
            <value xml:lang="vi">Bỏ dấu tiếng Việt: “Nguyễn Văn Đức” thành “Nguyen Van Duc”.</value>
          </prop>
          <prop oor:name="Category"><value>Vietnamese</value></prop>
          <prop oor:name="CompatibilityName"><value xml:lang="en-US">BODAU</value></prop>
          <node oor:name="Parameters">
            <node oor:name="Text" oor:op="replace">
              <prop oor:name="DisplayName">
                <value xml:lang="en-US">text</value>
                <value xml:lang="vi">văn_bản</value>
              </prop>
              <prop oor:name="Description">
                <value xml:lang="en-US">The text.</value>
                <value xml:lang="vi">Văn bản cần bỏ dấu.</value>
              </prop>
            </node>
          </node>
        </node>
        <node oor:name="tachho" oor:op="replace">
          <prop oor:name="DisplayName">
            <value xml:lang="en-US">TACHHO</value>
            <value xml:lang="vi">TACHHO</value>
          </prop>
          <prop oor:name="Description">
            <value xml:lang="en-US">Family and middle names of a full name: “Nguyễn Thị Minh Khai” gives “Nguyễn Thị Minh”.</value>
            <value xml:lang="vi">Họ và tên đệm của một họ tên: “Nguyễn Thị Minh Khai” thành “Nguyễn Thị Minh”.</value>
          </prop>
          <prop oor:name="Category"><value>Vietnamese</value></prop>
          <prop oor:name="CompatibilityName"><value xml:lang="en-US">TACHHO</value></prop>
          <node oor:name="Parameters">
            <node oor:name="Text" oor:op="replace">
              <prop oor:name="DisplayName">
                <value xml:lang="en-US">full_name</value>
                <value xml:lang="vi">họ_tên</value>
              </prop>
              <prop oor:name="Description">
                <value xml:lang="en-US">The full name.</value>
                <value xml:lang="vi">Họ và tên đầy đủ.</value>
              </prop>
            </node>
          </node>
        </node>
        <node oor:name="tachten" oor:op="replace">
          <prop oor:name="DisplayName">
            <value xml:lang="en-US">TACHTEN</value>
            <value xml:lang="vi">TACHTEN</value>
          </prop>
          <prop oor:name="Description">
            <value xml:lang="en-US">Given name (last word) of a full name: “Nguyễn Thị Minh Khai” gives “Khai”.</value>
            <value xml:lang="vi">Tên (từ cuối) của một họ tên: “Nguyễn Thị Minh Khai” thành “Khai”.</value>
          </prop>
          <prop oor:name="Category"><value>Vietnamese</value></prop>
          <prop oor:name="CompatibilityName"><value xml:lang="en-US">TACHTEN</value></prop>
          <node oor:name="Parameters">
            <node oor:name="Text" oor:op="replace">
              <prop oor:name="DisplayName">
                <value xml:lang="en-US">full_name</value>
                <value xml:lang="vi">họ_tên</value>
              </prop>
              <prop oor:name="Description">
                <value xml:lang="en-US">The full name.</value>
                <value xml:lang="vi">Họ và tên đầy đủ.</value>
              </prop>
            </node>
          </node>
        </node>
        <node oor:name="vnd" oor:op="replace">
          <prop oor:name="DisplayName">
            <value xml:lang="en-US">VND</value>
            <value xml:lang="vi">VND</value>
          </prop>
          <prop oor:name="Description">
            <value xml:lang="en-US">Reads a number as Vietnamese words like the VND() of Vietnamese Excel add-ins, so their files calculate: =VND(1234) gives “Một ngàn hai trăm ba mươi bốn”, =VND(123000; TRUE) gives “Một trăm hai mươi ba ngàn đồng”, =VND(15,79; TRUE) gives “Mười lăm đồng bảy mươi chín xu”. At most 15 integer digits.</value>
            <value xml:lang="vi">Đọc số thành chữ tiếng Việt như hàm VND() của các add-in Excel Việt Nam, để tệp dùng các add-in đó tính được: =VND(1234) thành “Một ngàn hai trăm ba mươi bốn”, =VND(123000; TRUE) thành “Một trăm hai mươi ba ngàn đồng”, =VND(15,79; TRUE) thành “Mười lăm đồng bảy mươi chín xu”. Tối đa 15 chữ số phần nguyên.</value>
          </prop>
          <prop oor:name="Category"><value>Vietnamese</value></prop>
          <prop oor:name="CompatibilityName"><value xml:lang="en-US">VND</value></prop>
          <node oor:name="Parameters">
            <node oor:name="Number" oor:op="replace">
              <prop oor:name="DisplayName">
                <value xml:lang="en-US">number</value>
                <value xml:lang="vi">số</value>
              </prop>
              <prop oor:name="Description">
                <value xml:lang="en-US">The number or amount to read.</value>
                <value xml:lang="vi">Số hoặc số tiền cần đọc.</value>
              </prop>
            </node>
            <node oor:name="Option" oor:op="replace">
              <prop oor:name="DisplayName">
                <value xml:lang="en-US">add_unit</value>
                <value xml:lang="vi">có_đơn_vị</value>
              </prop>
              <prop oor:name="Description">
                <value xml:lang="en-US">Optional. TRUE: read the unit (“đồng”) and the two decimals as the sub-unit (“xu”). FALSE or left out: only the number, decimals after “phẩy”. A number 1–3 (the character set of older files) also reads the unit; the result is always Unicode.</value>
                <value xml:lang="vi">Không bắt buộc. TRUE: đọc kèm đơn vị (“đồng”) và hai chữ số thập phân thành đơn vị lẻ (“xu”). FALSE hoặc bỏ trống: chỉ đọc số, phần thập phân sau “phẩy”. Số 1–3 (bảng mã của tệp cũ) cũng đọc kèm đơn vị; kết quả luôn là Unicode.</value>
              </prop>
            </node>
            <node oor:name="Option3" oor:op="replace">
              <prop oor:name="DisplayName">
                <value xml:lang="en-US">charset_or_unit</value>
                <value xml:lang="vi">bảng_mã_hoặc_đơn_vị</value>
              </prop>
              <prop oor:name="Description">
                <value xml:lang="en-US">Optional. A number: the character set of older files, ignored. A text: the unit, as in =VND(12,5; ; "đồng"; "hào"; 10); the unit is then always read.</value>
                <value xml:lang="vi">Không bắt buộc. Một số: bảng mã của tệp cũ, bỏ qua. Một chữ: tên đơn vị, ví dụ =VND(12,5; ; "đồng"; "hào"; 10); khi đó luôn đọc kèm đơn vị.</value>
              </prop>
            </node>
            <node oor:name="Option4" oor:op="replace">
              <prop oor:name="DisplayName">
                <value xml:lang="en-US">unit_or_subunit</value>
                <value xml:lang="vi">đơn_vị_hoặc_đơn_vị_lẻ</value>
              </prop>
              <prop oor:name="Description">
                <value xml:lang="en-US">Optional. With add_unit TRUE: the unit (default “đồng”). When the third argument is a unit: the sub-unit (default “xu”).</value>
                <value xml:lang="vi">Không bắt buộc. Khi có_đơn_vị là TRUE: tên đơn vị (mặc định “đồng”). Khi đối số thứ ba là đơn vị: tên đơn vị lẻ (mặc định “xu”).</value>
              </prop>
            </node>
            <node oor:name="Option5" oor:op="replace">
              <prop oor:name="DisplayName">
                <value xml:lang="en-US">subunit_or_factor</value>
                <value xml:lang="vi">đơn_vị_lẻ_hoặc_hệ_số</value>
              </prop>
              <prop oor:name="Description">
                <value xml:lang="en-US">Optional. With add_unit TRUE: the sub-unit (default “xu”; "" rounds to whole units). When the third argument is a unit: how many sub-units make one unit (default: hundredths), e.g. 60 for hours and minutes.</value>
                <value xml:lang="vi">Không bắt buộc. Khi có_đơn_vị là TRUE: tên đơn vị lẻ (mặc định “xu”; "" làm tròn tới đơn vị). Khi đối số thứ ba là đơn vị: số đơn vị lẻ trong một đơn vị (mặc định: phần trăm), ví dụ 60 cho giờ và phút.</value>
              </prop>
            </node>
            <node oor:name="Option6" oor:op="replace">
              <prop oor:name="DisplayName">
                <value xml:lang="en-US">grouping</value>
                <value xml:lang="vi">phân_nhóm</value>
              </prop>
              <prop oor:name="Description">
                <value xml:lang="en-US">Optional. TRUE: a comma after each triệu/ngàn/tỷ group: “Ba trăm lẻ chín triệu, tám trăm bốn mươi tám ngàn, năm trăm sáu mươi đồng”. The unit is then always read.</value>
                <value xml:lang="vi">Không bắt buộc. TRUE: thêm dấu phẩy sau mỗi nhóm triệu/ngàn/tỷ: “Ba trăm lẻ chín triệu, tám trăm bốn mươi tám ngàn, năm trăm sáu mươi đồng”. Khi đó luôn đọc kèm đơn vị.</value>
              </prop>
            </node>
          </node>
        </node>
        <node oor:name="usd" oor:op="replace">
          <prop oor:name="DisplayName">
            <value xml:lang="en-US">USD</value>
            <value xml:lang="vi">USD</value>
          </prop>
          <prop oor:name="Description">
            <value xml:lang="en-US">Reads a number as English words like the USD() of Vietnamese Excel add-ins: =USD(125000) gives “One hundred and twenty-five thousand”, =USD(123,45; TRUE) gives “One hundred and twenty-three dollars and forty-five cents”. At most 15 integer digits.</value>
            <value xml:lang="vi">Đọc số thành chữ tiếng Anh như hàm USD() của các add-in Excel Việt Nam: =USD(125000) thành “One hundred and twenty-five thousand”, =USD(123,45; TRUE) thành “One hundred and twenty-three dollars and forty-five cents”. Tối đa 15 chữ số phần nguyên.</value>
          </prop>
          <prop oor:name="Category"><value>Vietnamese</value></prop>
          <prop oor:name="CompatibilityName"><value xml:lang="en-US">USD</value></prop>
          <node oor:name="Parameters">
            <node oor:name="Number" oor:op="replace">
              <prop oor:name="DisplayName">
                <value xml:lang="en-US">number</value>
                <value xml:lang="vi">số</value>
              </prop>
              <prop oor:name="Description">
                <value xml:lang="en-US">The number or amount to read.</value>
                <value xml:lang="vi">Số hoặc số tiền cần đọc.</value>
              </prop>
            </node>
            <node oor:name="Option" oor:op="replace">
              <prop oor:name="DisplayName">
                <value xml:lang="en-US">add_unit_or_unit</value>
                <value xml:lang="vi">có_đơn_vị_hoặc_đơn_vị</value>
              </prop>
              <prop oor:name="Description">
                <value xml:lang="en-US">Optional. TRUE: read “dollars” and the two decimals as “cents”. FALSE or left out: only the number. A text: the unit, e.g. "VND"; the unit is then always read.</value>
                <value xml:lang="vi">Không bắt buộc. TRUE: đọc kèm “dollars” và hai chữ số thập phân thành “cents”. FALSE hoặc bỏ trống: chỉ đọc số. Một chữ: tên đơn vị, ví dụ "VND"; khi đó luôn đọc kèm đơn vị.</value>
              </prop>
            </node>
            <node oor:name="Option3" oor:op="replace">
              <prop oor:name="DisplayName">
                <value xml:lang="en-US">subunit</value>
                <value xml:lang="vi">đơn_vị_lẻ</value>
              </prop>
              <prop oor:name="Description">
                <value xml:lang="en-US">Optional, when the second argument is a unit: the sub-unit (default “cent”; "" rounds to whole units).</value>
                <value xml:lang="vi">Không bắt buộc, khi đối số thứ hai là đơn vị: tên đơn vị lẻ (mặc định “cent”; "" làm tròn tới đơn vị).</value>
              </prop>
            </node>
            <node oor:name="Option4" oor:op="replace">
              <prop oor:name="DisplayName">
                <value xml:lang="en-US">subunit_factor</value>
                <value xml:lang="vi">hệ_số_đơn_vị_lẻ</value>
              </prop>
              <prop oor:name="Description">
                <value xml:lang="en-US">Optional, when the second argument is a unit: how many sub-units make one unit (default: hundredths).</value>
                <value xml:lang="vi">Không bắt buộc, khi đối số thứ hai là đơn vị: số đơn vị lẻ trong một đơn vị (mặc định: phần trăm).</value>
              </prop>
            </node>
            <node oor:name="Option5" oor:op="replace">
              <prop oor:name="DisplayName">
                <value xml:lang="en-US">grouping</value>
                <value xml:lang="vi">phân_nhóm</value>
              </prop>
              <prop oor:name="Description">
                <value xml:lang="en-US">Optional, when the second argument is a unit. TRUE: a comma after each thousand/million/billion group.</value>
                <value xml:lang="vi">Không bắt buộc, khi đối số thứ hai là đơn vị. TRUE: thêm dấu phẩy sau mỗi nhóm thousand/million/billion.</value>
              </prop>
            </node>
          </node>
        </node>
      </node>
    </node>
  </node>
</oor:component-data>
