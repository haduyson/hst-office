<?xml version="1.0" encoding="UTF-8"?>
<!-- AutoRecovery information every 3 minutes instead of 10, so an unexpected exit loses at most a few minutes of
     work (help/khoi-phuc-tai-lieu.html). UserAutoSaveEnabled (owner decision 21/11/2026): every opened document
     starts with "Tự động lưu" on and saves itself into its own file on the same timer, but only when that is safe
     (patches/libreoffice/hst-user-autosave-filter.patch: ODF or .docx/.xlsx/.pptx on a file: URL, not read only, not
     signed, no macros the format drops, never a dialog); the toggle of the tab row turns it off for one document
     and session. Without that patch in the series this must stay false. A user or administrator value wins. -->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Recovery" oor:package="org.openoffice.Office">
  <node oor:name="AutoSave">
    <prop oor:name="TimeIntervall">
      <value>3</value>
    </prop>
    <prop oor:name="UserAutoSaveEnabled">
      <value>true</value>
    </prop>
  </node>
</oor:component-data>
