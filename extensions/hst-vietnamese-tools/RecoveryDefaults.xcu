<?xml version="1.0" encoding="UTF-8"?>
<!-- AutoRecovery information every 3 minutes instead of 10, so an unexpected exit loses at most a few minutes of
     work (help/khoi-phuc-tai-lieu.html). Only the recovery copies in the profile's backup folder are written that
     often; the user's own file is never saved automatically (UserAutoSaveEnabled stays false). A user or
     administrator value wins over this default. -->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Recovery" oor:package="org.openoffice.Office">
  <node oor:name="AutoSave">
    <prop oor:name="TimeIntervall">
      <value>3</value>
    </prop>
    <prop oor:name="UserAutoSaveEnabled">
      <value>false</value>
    </prop>
  </node>
</oor:component-data>
