<?xml version="1.0" encoding="UTF-8"?>
<oor:component-schema xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema"
                      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                      oor:name="Citations" oor:package="org.hasontech.hstoffice" xml:lang="en-US">
  <info>
    <desc>Citations (Trích dẫn) in HST Writer. The reference library itself is a file in the user profile
      (hst-citations/library.json), not configuration. Online lookup runs only when the user clicks "Tra cứu trực
      tuyến" in the source form (hst_office/citation_lookup_action.py); see docs/PRIVACY.md.</desc>
  </info>
  <component>
    <prop oor:name="LookupEnabled" oor:type="xs:boolean" oor:nillable="false">
      <info>
        <desc>Allow looking up a reference online by DOI, ISBN, PubMed ID or arXiv ID when the user clicks the button.
          Administrators set it to false (and lock it) to remove every lookup request.</desc>
      </info>
      <value>true</value>
    </prop>
    <prop oor:name="LookupContact" oor:type="xs:string" oor:nillable="false">
      <info>
        <desc>Contact address sent with lookups to Crossref (mailto) and NCBI (email) as those services ask; empty
          sends HST's project address (citation_lookup.DEFAULT_CONTACT). Never the user's address unless an
          administrator sets it.</desc>
      </info>
      <value></value>
    </prop>
  </component>
</oor:component-schema>
