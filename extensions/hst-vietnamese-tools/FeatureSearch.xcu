<?xml version="1.0" encoding="UTF-8"?>
<!-- Extra search words for "Tìm tính năng…" (Shift+Esc): typing any of them finds the command.
     Matching ignores case and diacritics; schema in search.xcs. -->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="FeatureSearch" oor:package="org.hasontech.hstoffice">
  <node oor:name="Keywords">
    <node oor:name="nd30" oor:op="replace">
      <prop oor:name="Command"><value>org.hst.office.vi:Nd30Wizard</value></prop>
      <prop oor:name="Words"><value>nd30 nđ 30 nghị định 30 công văn tờ trình quyết định thông báo văn thư thể thức</value></prop>
    </node>
    <node oor:name="convert" oor:op="replace">
      <prop oor:name="Command"><value>org.hst.office.vi:ConvertEncoding</value></prop>
      <prop oor:name="Words"><value>chuyển mã tcvn3 abc vni unicode font phông chữ lỗi font vntime</value></prop>
    </node>
    <node oor:name="date" oor:op="replace">
      <prop oor:name="Command"><value>org.hst.office.vi:FormatDate</value></prop>
      <prop oor:name="Words"><value>ngày tháng định dạng ngày dd/mm/yyyy date</value></prop>
    </node>
    <node oor:name="vnd" oor:op="replace">
      <prop oor:name="Command"><value>org.hst.office.vi:FormatVnd</value></prop>
      <prop oor:name="Words"><value>tiền đồng vnd tiền tệ đơn vị tiền currency</value></prop>
    </node>
    <node oor:name="percent" oor:op="replace">
      <prop oor:name="Command"><value>org.hst.office.vi:FormatPercent</value></prop>
      <prop oor:name="Words"><value>phần trăm % percent</value></prop>
    </node>
    <node oor:name="csv" oor:op="replace">
      <prop oor:name="Command"><value>org.hst.office.vi:ImportCsv</value></prop>
      <prop oor:name="Words"><value>csv nhập dữ liệu utf-8 import mở tệp csv</value></prop>
    </node>
    <node oor:name="token" oor:op="replace">
      <prop oor:name="Command"><value>org.hst.office.vi:SetupUsbToken</value></prop>
      <prop oor:name="Words"><value>chữ ký số ký số token usb token chứng thư số pkcs11</value></prop>
    </node>
    <node oor:name="vba" oor:op="replace">
      <prop oor:name="Command"><value>org.hst.office.vi:EditVba</value></prop>
      <prop oor:name="Words"><value>vba macro visual basic lập trình tự động hóa</value></prop>
    </node>
    <node oor:name="solutions" oor:op="replace">
      <prop oor:name="Command"><value>org.hst.office.vi:ShowSolutions</value></prop>
      <prop oor:name="Words"><value>hason tech giải pháp sản phẩm aios echatbot zalo mini app</value></prop>
    </node>
    <node oor:name="update" oor:op="replace">
      <prop oor:name="Command"><value>org.hst.office.update:Check</value></prop>
      <prop oor:name="Words"><value>cập nhật phiên bản mới update</value></prop>
    </node>
    <node oor:name="uilang" oor:op="replace">
      <prop oor:name="Command"><value>org.hst.office.vi:UILanguageVi</value></prop>
      <prop oor:name="Words"><value>ngôn ngữ giao diện tiếng việt</value></prop>
    </node>
    <node oor:name="uilangen" oor:op="replace">
      <prop oor:name="Command"><value>org.hst.office.vi:UILanguageEn</value></prop>
      <prop oor:name="Words"><value>ngôn ngữ giao diện tiếng anh english</value></prop>
    </node>
    <node oor:name="uilangsys" oor:op="replace">
      <prop oor:name="Command"><value>org.hst.office.vi:UILanguageSystem</value></prop>
      <prop oor:name="Words"><value>ngôn ngữ giao diện theo hệ điều hành</value></prop>
    </node>
  </node>
</oor:component-data>
