          </prop>
              <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
              <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.drawing.DrawingDocument,com.sun.star.frame.StartModule</value></prop>
            </node>
            <node oor:name="m2" oor:op="replace">
              <prop oor:name="URL" oor:type="xs:string"><value>org.hst.office.vi:ConvertEncoding</value></prop>
              <prop oor:name="Title" oor:type="xs:string">
            <value>Chuyển TCVN3/VNI sang Unicode</value>
            <value xml:lang="en-US">Chuyển TCVN3/VNI sang Unicode</value>
            <value xml:lang="vi">Chuyển TCVN3/VNI sang Unicode</value>
          </prop>
              <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
              <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
            </node>
            <node oor:name="m4" oor:op="replace">
              <prop oor:name="URL" oor:type="xs:string"><value>org.hst.office.vi:FormatVnd</value></prop>
              <prop oor:name="Title" oor:type="xs:string">
            <value>Định dạng tiền VND</value>
            <value xml:lang="en-US">Định dạng tiền VND</value>
            <value xml:lang="vi">Định dạng tiền VND</value>
          </prop>
              <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
              <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
            </node>
            <node oor:name="m5" oor:op="replace">
              <prop oor:name="URL" oor:type="xs:string"><value>org.hst.office.vi:FormatPercent</value></prop>
              <prop oor:name="Title" oor:type="xs:string">
