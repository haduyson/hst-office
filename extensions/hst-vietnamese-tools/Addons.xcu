<?xml version="1.0" encoding="UTF-8"?>
<!-- Labels must equal locales/en.json and locales/vi.json "menu" (scripts/check-extensions.py verifies).
     The HST menu offers every command. The Extensions tab of the Tabbed UI ribbon is authored in the
     notebookbar.ui files (hst-ribbon-extensions-tab.patch: large buttons in groups) and keeps the HST tools
     only; there is no OfficeNotebookBar entry, so the tab's trailing "Extensions" menu lists third-party
     add-ons alone. The other commands sit where Office has them (hst-ribbon-hst-commands.patch,
     hst-vba-authoring.patch): Macro VBA on the Developer tab, Ngôn ngữ giao diện on the Review tab,
     Thiết lập USB Token on File ▸ Info next to Chữ ký số, Kiểm tra cập nhật in the Help menu and the
     Help section of the ≡ menu. There is deliberately no OfficeToolBar, which would open a floating
     "Add-ons" toolbar window over the ribbon. -->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Addons" oor:package="org.openoffice.Office">
  <node oor:name="AddonUI">
    <node oor:name="OfficeMenuBar">
      <node oor:name="org.hst.office.vi" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string">
            <value>HST</value>
            <value xml:lang="en-US">HST</value>
            <value xml:lang="vi">HST</value>
          </prop>
        <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
        <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.drawing.DrawingDocument,com.sun.star.frame.StartModule</value></prop>
        <node oor:name="Submenu">
            <node oor:name="m1" oor:op="replace">
              <prop oor:name="URL" oor:type="xs:string"><value>org.hst.office.vi:Nd30Wizard</value></prop>
