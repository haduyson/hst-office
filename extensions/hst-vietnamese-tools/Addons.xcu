            </node>
            <node oor:name="m12" oor:op="replace">
              <!-- VBA editor on the document's VBA module (also Tools tab button and Alt+F11) -->
              <prop oor:name="URL" oor:type="xs:string"><value>org.hst.office.vi:EditVba</value></prop>
              <prop oor:name="Title" oor:type="xs:string">
