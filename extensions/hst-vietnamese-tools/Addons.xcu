            </node>
            <node oor:name="m13" oor:op="replace">
              <!-- Feature search (Help ▸ Tìm tính năng…, Shift+Esc); not in the Start Center: it needs a document -->
              <prop oor:name="URL" oor:type="xs:string"><value>.uno:CommandPopup</value></prop>
              <prop oor:name="Title" oor:type="xs:string">
