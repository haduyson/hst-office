<?xml version="1.0" encoding="UTF-8"?>
<!-- Labels must equal locales/en.json and locales/vi.json "menu" (scripts/check-extensions.py verifies).
     The commands are offered in the HST menu and in the Extension tab of the Tabbed UI ribbon
     (OfficeNotebookBar); there is deliberately no OfficeToolBar, which would open a floating
     "Add-ons" toolbar window over the ribbon. -->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Addons" oor:package="org.openoffice.Office">
  <node oor:name="AddonUI">
    <node oor:name="OfficeMenuBar">
      <node oor:name="org.hst.office.vi" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string">
            <value>HST</value>
            <value xml:lang="en-US">HST</value>
            <value xml:lang="vi">HST</value>
          </prop>
        <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
        <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.frame.StartModule</value></prop>
        <node oor:name="Submenu">
            <node oor:name="m1" oor:op="replace">
              <prop oor:name="URL" oor:type="xs:string"><value>org.hst.office.vi:Nd30Wizard</value></prop>
              <prop oor:name="Title" oor:type="xs:string">
            <value>Văn bản theo NĐ 30…</value>
            <value xml:lang="en-US">Văn bản theo NĐ 30…</value>
            <value xml:lang="vi">Văn bản theo NĐ 30…</value>
          </prop>
              <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
              <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.frame.StartModule</value></prop>
            </node>
            <node oor:name="m2" oor:op="replace">
              <prop oor:name="URL" oor:type="xs:string"><value>org.hst.office.vi:ConvertEncoding</value></prop>
              <prop oor:name="Title" oor:type="xs:string">
            <value>Chuyển TCVN3/VNI sang Unicode...</value>
            <value xml:lang="en-US">Chuyển TCVN3/VNI sang Unicode...</value>
            <value xml:lang="vi">Chuyển TCVN3/VNI sang Unicode...</value>
          </prop>
              <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
              <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
            </node>
            <node oor:name="m3" oor:op="replace">
              <prop oor:name="URL" oor:type="xs:string"><value>org.hst.office.vi:FormatDate</value></prop>
              <prop oor:name="Title" oor:type="xs:string">
            <value>Định dạng ngày (dd/mm/yyyy)</value>
            <value xml:lang="en-US">Định dạng ngày (dd/mm/yyyy)</value>
            <value xml:lang="vi">Định dạng ngày (dd/mm/yyyy)</value>
          </prop>
              <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
              <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
            </node>
            <node oor:name="m4" oor:op="replace">
              <prop oor:name="URL" oor:type="xs:string"><value>org.hst.office.vi:FormatVnd</value></prop>
              <prop oor:name="Title" oor:type="xs:string">
            <value>Định dạng tiền VND</value>
            <value xml:lang="en-US">Định dạng tiền VND</value>
            <value xml:lang="vi">Định dạng tiền VND</value>
          </prop>
              <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
              <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
            </node>
            <node oor:name="m5" oor:op="replace">
              <prop oor:name="URL" oor:type="xs:string"><value>org.hst.office.vi:FormatPercent</value></prop>
              <prop oor:name="Title" oor:type="xs:string">
            <value>Định dạng phần trăm</value>
            <value xml:lang="en-US">Định dạng phần trăm</value>
            <value xml:lang="vi">Định dạng phần trăm</value>
          </prop>
              <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
              <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
            </node>
            <node oor:name="m6" oor:op="replace">
              <prop oor:name="URL" oor:type="xs:string"><value>org.hst.office.vi:ImportCsv</value></prop>
              <prop oor:name="Title" oor:type="xs:string">
            <value>Nhập CSV (UTF-8)...</value>
            <value xml:lang="en-US">Nhập CSV (UTF-8)...</value>
            <value xml:lang="vi">Nhập CSV (UTF-8)...</value>
          </prop>
              <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
              <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.frame.StartModule</value></prop>
            </node>
            <node oor:name="m7" oor:op="replace">
              <prop oor:name="URL" oor:type="xs:string"><value>org.hst.office.vi:ShowSolutions</value></prop>
              <prop oor:name="Title" oor:type="xs:string">
            <value>Giải pháp HASON TECH...</value>
            <value xml:lang="en-US">Giải pháp HASON TECH...</value>
            <value xml:lang="vi">Giải pháp HASON TECH...</value>
          </prop>
              <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
              <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.frame.StartModule</value></prop>
            </node>
            <node oor:name="m8" oor:op="replace">
              <prop oor:name="URL" oor:type="xs:string"><value>org.hst.office.update:Check</value></prop>
              <prop oor:name="Title" oor:type="xs:string">
            <value/>
            <value xml:lang="en-US">Check for Updates…</value>
            <value xml:lang="vi">Kiểm tra cập nhật…</value>
          </prop>
              <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
              <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.frame.StartModule</value></prop>
            </node>
        </node>
      </node>
    </node>
    <node oor:name="OfficeHelp">
      <node oor:name="org.hst.office.update.help" oor:op="replace">
        <prop oor:name="URL" oor:type="xs:string"><value>org.hst.office.update:Check</value></prop>
        <prop oor:name="Title" oor:type="xs:string">
            <value/>
            <value xml:lang="en-US">Check for HST Office Updates…</value>
            <value xml:lang="vi">Kiểm tra cập nhật HST Office…</value>
          </prop>
        <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
        <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.frame.StartModule</value></prop>
      </node>
    </node>
    <node oor:name="OfficeNotebookBar">
      <node oor:name="org.hst.office.vi.notebookbar" oor:op="replace">
          <node oor:name="m1" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>org.hst.office.vi:Nd30Wizard</value></prop>
            <prop oor:name="Title" oor:type="xs:string">
            <value>Văn bản theo NĐ 30…</value>
            <value xml:lang="en-US">Văn bản theo NĐ 30…</value>
            <value xml:lang="vi">Văn bản theo NĐ 30…</value>
          </prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Style" oor:type="xs:string"><value>Text</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument</value></prop>
          </node>
          <node oor:name="m2" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>org.hst.office.vi:ConvertEncoding</value></prop>
            <prop oor:name="Title" oor:type="xs:string">
            <value>Chuyển TCVN3/VNI sang Unicode...</value>
            <value xml:lang="en-US">Chuyển TCVN3/VNI sang Unicode...</value>
            <value xml:lang="vi">Chuyển TCVN3/VNI sang Unicode...</value>
          </prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Style" oor:type="xs:string"><value>Text</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
