              <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.drawing.DrawingDocument,com.sun.star.frame.StartModule</value></prop>
            </node>
            <node oor:name="m8" oor:op="replace">
              <prop oor:name="Title" oor:type="xs:string">
            <value>Ngôn ngữ giao diện</value>
            <value xml:lang="en-US">Ngôn ngữ giao diện</value>
            <value xml:lang="vi">Ngôn ngữ giao diện</value>
          </prop>
