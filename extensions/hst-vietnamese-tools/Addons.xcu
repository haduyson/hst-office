    <!-- Tệp tin ▸ Phiên bản trước, after Phiên bản (.uno:VersionDialog) in the classic File menu of Writer, Sheets and
         Slides; the File panel of the Tabbed UI has it on its Info page (hst-backstage-previous-versions.patch) -->
    <node oor:name="OfficeMenuBarMerging">
      <node oor:name="org.hst.office.vi.versions" oor:op="replace">
        <node oor:name="m1" oor:op="replace">
          <prop oor:name="MergePoint"><value>.uno:PickList\.uno:VersionDialog</value></prop>
          <prop oor:name="MergeCommand"><value>AddAfter</value></prop>
          <prop oor:name="MergeFallback"><value>Ignore</value></prop>
          <prop oor:name="MergeContext"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument</value></prop>
          <node oor:name="MenuItems">
            <node oor:name="m1" oor:op="replace">
              <prop oor:name="URL" oor:type="xs:string"><value>org.hst.office.vi:PreviousVersions</value></prop>
              <prop oor:name="Title" oor:type="xs:string">
                <value>Phiên bản trước</value>
                <value xml:lang="en-US">Phiên bản trước</value>
                <value xml:lang="vi">Phiên bản trước</value>
              </prop>
              <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            </node>
          </node>
        </node>
      </node>
    </node>
    <node oor:name="OfficeHelp">
      <node oor:name="org.hst.office.update.help" oor:op="replace">
        <prop oor:name="URL" oor:type="xs:string"><value>org.hst.office.update:Check</value></prop>
        <prop oor:name="Title" oor:type="xs:string">
            <value/>
            <value xml:lang="en-US">Check for HST Office Updates…</value>
