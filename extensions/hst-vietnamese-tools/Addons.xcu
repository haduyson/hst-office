                </node>
                <node oor:name="m3" oor:op="replace">
                  <prop oor:name="URL" oor:type="xs:string"><value>org.hst.office.vi:UILanguageSystem</value></prop>
                  <prop oor:name="Title" oor:type="xs:string">
            <value>Theo máy</value>
            <value xml:lang="en-US">Theo máy</value>
            <value xml:lang="vi">Theo máy</value>
          </prop>
                  <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
                  <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.drawing.DrawingDocument,com.sun.star.frame.StartModule</value></prop>
                </node>
              </node>
            </node>
            <!-- Vietnamese utilities (labels without "...": they read as clipped text); the Extensions tab gets
                 the same commands from the ribbon layout -->
