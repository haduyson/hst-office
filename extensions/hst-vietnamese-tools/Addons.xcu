                  <value xml:lang="en-US">Xóa dòng trống</value>
                  <value xml:lang="vi">Xóa dòng trống</value>
                </prop>
                <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
                <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
              </node>
              <node oor:name="m7" oor:op="replace">
                <prop oor:name="Title" oor:type="xs:string">
                  <value>Định dạng ngày tháng</value>
                  <value xml:lang="en-US">Định dạng ngày tháng</value>
                  <value xml:lang="vi">Định dạng ngày tháng</value>
