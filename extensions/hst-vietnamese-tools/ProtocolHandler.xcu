<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="ProtocolHandler" oor:package="org.openoffice.Office">
  <node oor:name="HandlerSet">
    <node oor:name="org.hst.office.vi.DispatchProvider" oor:op="replace">
      <prop oor:name="Protocols" oor:type="oor:string-list">
        <value>org.hst.office.vi:*</value>
      </prop>
    </node>
    <node oor:name="org.hst.office.vi.UpdateDispatchProvider" oor:op="replace">
      <prop oor:name="Protocols" oor:type="oor:string-list">
        <value>org.hst.office.update:*</value>
      </prop>
    </node>
  </node>
</oor:component-data>
