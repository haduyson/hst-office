<?xml version="1.0" encoding="UTF-8"?>
<oor:component-schema xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema"
                      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                      oor:name="ErrorReport" oor:package="org.hasontech.hstoffice" xml:lang="en-US">
  <info>
    <desc>Per-user state of the HST Office error report (Help > Báo lỗi cho HASON TECH…). Nothing is sent without the user's click in the report dialog.</desc>
  </info>
  <component>
    <prop oor:name="AskAfterCrash" oor:type="xs:boolean" oor:nillable="false">
      <info>
        <desc>True: after an abnormal exit the next start asks once whether to send a crash report. "Không hỏi lại" sets it to false.</desc>
      </info>
      <value>true</value>
    </prop>
  </component>
</oor:component-schema>
