<?xml version="1.0" encoding="UTF-8"?>
<oor:component-schema xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema"
                      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                      oor:name="Welcome" oor:package="org.hasontech.hstoffice" xml:lang="en-US">
  <info>
    <desc>Per-user state of the HST Office welcome dialog. No data leaves the machine.</desc>
  </info>
  <component>
    <prop oor:name="Shown" oor:type="xs:boolean" oor:nillable="false">
      <info>
        <desc>True once the welcome dialog has been displayed; the dialog is then not shown at start-up again.</desc>
      </info>
      <value>false</value>
    </prop>
  </component>
</oor:component-schema>
