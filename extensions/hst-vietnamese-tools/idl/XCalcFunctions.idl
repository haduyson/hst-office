/* Sheets functions of HST Office in the "Tiếng Việt" category (CalcAddIns.xcu): DOCSO, DOCTIEN, BODAU, TACHHO, TACHTEN.
   Compiled into ../types/hst-calc-functions.rdb by scripts/build-calc-functions-rdb.py (unoidl-write of the build);
   the parameter names are the node names in CalcAddIns.xcu. Document (XPropertySet) is Calc's hidden caller
   argument: Calc passes the calling document and never shows it, so the formula syntax and the arguments of saved
   formulas stay as they were (sc/source/core/tool/addincol.cxx, SC_ADDINARG_CALLER). */

module org { module hst { module office { module vi {

interface XCalcFunctions : com::sun::star::uno::XInterface
{
    string docso([in] com::sun::star::beans::XPropertySet Document, [in] double Number, [in] any ReadingOptions);
    string doctien([in] com::sun::star::beans::XPropertySet Document, [in] double Number, [in] any UnitName,
                   [in] any SubUnitName, [in] any ReadingOptions);
    string bodau([in] string Text);
    string tachho([in] string Text);
    string tachten([in] string Text);
};

}; }; }; };
