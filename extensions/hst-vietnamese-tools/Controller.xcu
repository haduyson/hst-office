<?xml version="1.0" encoding="UTF-8"?>
<!-- Trộn thư: the ▾ menus of the Gửi thư tab. ToolBar: the ribbon buttons get a drop-down (GenericPopupToolbarController;
     an empty Value makes the whole button open the menu, a command makes it a split button); PopupMenu: the menu
     content comes from org.hst.office.vi.MailMergeMenu (python/hst_office/mail_merge_menu.py). -->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Controller" oor:package="org.openoffice.Office.UI">
  <node oor:name="Registered">
    <node oor:name="ToolBar">
      <node oor:name="org.hst.office.mailmerge.Start" oor:op="replace">
        <prop oor:name="Command"><value>org.hst.office.mailmerge:Start</value></prop>
        <prop oor:name="Module"><value>com.sun.star.text.TextDocument</value></prop>
        <prop oor:name="Controller"><value>com.sun.star.comp.framework.GenericPopupToolbarController</value></prop>
        <prop oor:name="Value"><value></value></prop>
      </node>
      <node oor:name="org.hst.office.mailmerge.Recipients" oor:op="replace">
        <prop oor:name="Command"><value>org.hst.office.mailmerge:Recipients</value></prop>
        <prop oor:name="Module"><value>com.sun.star.text.TextDocument</value></prop>
        <prop oor:name="Controller"><value>com.sun.star.comp.framework.GenericPopupToolbarController</value></prop>
        <prop oor:name="Value"><value></value></prop>
      </node>
      <node oor:name="org.hst.office.mailmerge.InsertField" oor:op="replace">
        <prop oor:name="Command"><value>org.hst.office.mailmerge:InsertField</value></prop>
        <prop oor:name="Module"><value>com.sun.star.text.TextDocument</value></prop>
        <prop oor:name="Controller"><value>com.sun.star.comp.framework.GenericPopupToolbarController</value></prop>
        <prop oor:name="Value"><value>org.hst.office.mailmerge:InsertField</value></prop>
      </node>
      <node oor:name="org.hst.office.mailmerge.Rules" oor:op="replace">
        <prop oor:name="Command"><value>org.hst.office.mailmerge:Rules</value></prop>
        <prop oor:name="Module"><value>com.sun.star.text.TextDocument</value></prop>
        <prop oor:name="Controller"><value>com.sun.star.comp.framework.GenericPopupToolbarController</value></prop>
        <prop oor:name="Value"><value></value></prop>
      </node>
      <node oor:name="org.hst.office.mailmerge.Finish" oor:op="replace">
        <prop oor:name="Command"><value>org.hst.office.mailmerge:Finish</value></prop>
        <prop oor:name="Module"><value>com.sun.star.text.TextDocument</value></prop>
        <prop oor:name="Controller"><value>com.sun.star.comp.framework.GenericPopupToolbarController</value></prop>
        <prop oor:name="Value"><value></value></prop>
      </node>
    </node>
    <node oor:name="PopupMenu">
      <node oor:name="org.hst.office.mailmerge.Start" oor:op="replace">
        <prop oor:name="Command"><value>org.hst.office.mailmerge:Start</value></prop>
        <prop oor:name="Module"><value>com.sun.star.text.TextDocument</value></prop>
        <prop oor:name="Controller"><value>org.hst.office.vi.MailMergeMenu</value></prop>
      </node>
      <node oor:name="org.hst.office.mailmerge.Recipients" oor:op="replace">
        <prop oor:name="Command"><value>org.hst.office.mailmerge:Recipients</value></prop>
        <prop oor:name="Module"><value>com.sun.star.text.TextDocument</value></prop>
        <prop oor:name="Controller"><value>org.hst.office.vi.MailMergeMenu</value></prop>
      </node>
      <node oor:name="org.hst.office.mailmerge.InsertField" oor:op="replace">
        <prop oor:name="Command"><value>org.hst.office.mailmerge:InsertField</value></prop>
        <prop oor:name="Module"><value>com.sun.star.text.TextDocument</value></prop>
        <prop oor:name="Controller"><value>org.hst.office.vi.MailMergeMenu</value></prop>
      </node>
      <node oor:name="org.hst.office.mailmerge.Rules" oor:op="replace">
        <prop oor:name="Command"><value>org.hst.office.mailmerge:Rules</value></prop>
        <prop oor:name="Module"><value>com.sun.star.text.TextDocument</value></prop>
        <prop oor:name="Controller"><value>org.hst.office.vi.MailMergeMenu</value></prop>
      </node>
      <node oor:name="org.hst.office.mailmerge.Finish" oor:op="replace">
        <prop oor:name="Command"><value>org.hst.office.mailmerge:Finish</value></prop>
        <prop oor:name="Module"><value>com.sun.star.text.TextDocument</value></prop>
        <prop oor:name="Controller"><value>org.hst.office.vi.MailMergeMenu</value></prop>
      </node>
    </node>
  </node>
</oor:component-data>
