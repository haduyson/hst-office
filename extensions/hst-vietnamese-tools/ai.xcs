<?xml version="1.0" encoding="UTF-8"?>
<oor:component-schema xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema"
                      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                      oor:name="AI" oor:package="org.hasontech.hstoffice" xml:lang="en-US">
  <info>
    <desc>Trợ lý AI (hst_office/ai_*.py): off by default, no provider chosen by default. The user turns it on in
      Tùy chọn ▸ HST Office ▸ Trợ lý AI, picks OpenAI, Google Gemini or Anthropic Claude and enters their own API
      key, which is kept in the operating system's credential store (ai_keystore.py), never here. A request leaves
      the machine only when the user presses a send button; see docs/PRIVACY.md. Administrators can set Enabled to
      false and lock it to remove the assistant.</desc>
  </info>
  <component>
    <prop oor:name="Enabled" oor:type="xs:boolean" oor:nillable="false">
      <info>
        <desc>The assistant's commands work (otherwise they are greyed out). Default off.</desc>
      </info>
      <value>false</value>
    </prop>
    <prop oor:name="Provider" oor:type="xs:string" oor:nillable="false">
      <info>
        <desc>openai, gemini or claude; empty (the default) means none chosen yet.</desc>
      </info>
      <value></value>
    </prop>
    <prop oor:name="OpenAIModel" oor:type="xs:string" oor:nillable="false">
      <info>
        <desc>Model ID used with OpenAI; empty: the first of ai_providers.PROVIDERS["openai"]["models"].</desc>
      </info>
      <value></value>
    </prop>
    <prop oor:name="GeminiModel" oor:type="xs:string" oor:nillable="false">
      <info>
        <desc>Model ID used with Google Gemini; empty: the first suggested one.</desc>
      </info>
      <value></value>
    </prop>
    <prop oor:name="ClaudeModel" oor:type="xs:string" oor:nillable="false">
      <info>
        <desc>Model ID used with Anthropic Claude; empty: the first suggested one.</desc>
      </info>
      <value></value>
    </prop>
  </component>
</oor:component-schema>
