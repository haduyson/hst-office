<?xml version="1.0" encoding="UTF-8"?>
<oor:component-schema xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema"
                      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                      oor:name="PreviousVersions" oor:package="org.hasontech.hstoffice" xml:lang="en-US">
  <info>
    <desc>"Phiên bản trước" (docs/PREVIOUS_VERSIONS.md): before a save overwrites a file, HST Office keeps the file as
      it was in the user profile (hst-versions). Copies stay on the machine and are never sent anywhere.</desc>
  </info>
  <component>
    <prop oor:name="Enabled" oor:type="xs:boolean" oor:nillable="false">
      <info>
        <desc>Keep a copy of a file before a save overwrites it (Tùy chọn ▸ HST Office ▸ Phiên bản trước). An
          administrator can lock it (hst_office/version_config.py: Windows policy key, macOS profile, or a finalized
          value from a shared policy extension).</desc>
      </info>
      <value>true</value>
    </prop>
  </component>
</oor:component-schema>
