<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dlg:window PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "dialog.dtd">
<!-- Tùy chọn ▸ HST Office ▸ Trợ lý AI (hst_office/ai_options.py: settings of /org.hasontech.hstoffice.AI saved on OK;
     the API key goes to the OS credential store through ai_keystore, never into the settings) -->
<dlg:window xmlns:dlg="http://openoffice.org/2000/dialog" xmlns:script="http://openoffice.org/2000/script"
            dlg:id="AI" dlg:left="0" dlg:top="0" dlg:width="260" dlg:height="232" dlg:withtitlebar="false">
  <dlg:bulletinboard>
    <dlg:fixedline dlg:id="heading" dlg:tab-index="0" dlg:left="6" dlg:top="3" dlg:width="248" dlg:height="10"
                   dlg:value="Trợ lý AI"/>
    <dlg:checkbox dlg:id="enabled" dlg:tab-index="1" dlg:left="12" dlg:top="17" dlg:width="242" dlg:height="10"
                  dlg:checked="false" dlg:value="Bật Trợ lý AI"
                  dlg:help-text="Bật Trợ lý AI: viết và giải thích công thức, hỗ trợ viết, hỏi cách dùng"/>
    <dlg:text dlg:id="note" dlg:tab-index="2" dlg:left="22" dlg:top="29" dlg:width="232" dlg:height="44" dlg:multiline="true"
              dlg:value="Trợ lý dùng dịch vụ AI do bạn chọn, bằng khóa API của chính bạn (nhà cung cấp tính phí theo khóa). Nội dung chỉ được gửi khi bạn bấm Gửi trong hộp thoại Trợ lý AI, và bạn xem được đúng nội dung đó trước khi gửi. HST Office không gửi gì cho HASON TECH, không lưu nội dung và không theo dõi cách dùng."/>
    <dlg:text dlg:id="l_provider" dlg:tab-index="3" dlg:left="12" dlg:top="80" dlg:width="56" dlg:height="10" dlg:value="Nhà cung cấp:"/>
    <dlg:menulist dlg:id="provider" dlg:tab-index="4" dlg:left="70" dlg:top="78" dlg:width="184" dlg:height="12" dlg:spin="true"
                  dlg:help-text="Nhà cung cấp dịch vụ AI"/>
    <dlg:text dlg:id="l_model" dlg:tab-index="5" dlg:left="12" dlg:top="96" dlg:width="56" dlg:height="10" dlg:value="Mô hình:"/>
    <dlg:combobox dlg:id="model" dlg:tab-index="6" dlg:left="70" dlg:top="94" dlg:width="118" dlg:height="12" dlg:spin="true"
                  dlg:help-text="Mã mô hình AI"/>
    <dlg:button dlg:id="loadModels" dlg:tab-index="7" dlg:left="192" dlg:top="93" dlg:width="62" dlg:height="14"
                dlg:value="Tải danh sách" dlg:help-text="Hỏi nhà cung cấp danh sách mô hình dùng được với khóa của bạn">
      <script:event script:event-name="on-performaction" script:macro-name="vnd.sun.star.UNO:loadModels" script:language="UNO"/>
    </dlg:button>
    <dlg:text dlg:id="l_key" dlg:tab-index="8" dlg:left="12" dlg:top="114" dlg:width="56" dlg:height="10" dlg:value="Khóa API:"/>
    <dlg:textfield dlg:id="key" dlg:tab-index="9" dlg:left="70" dlg:top="112" dlg:width="184" dlg:height="12"
                   dlg:help-text="Khóa API mới; để trống để giữ khóa đã lưu"/>
    <dlg:text dlg:id="keyStatus" dlg:tab-index="10" dlg:left="70" dlg:top="127" dlg:width="184" dlg:height="20" dlg:multiline="true"
              dlg:value=""/>
    <dlg:button dlg:id="deleteKey" dlg:tab-index="11" dlg:left="70" dlg:top="148" dlg:width="56" dlg:height="14"
                dlg:value="Xóa khóa" dlg:help-text="Xóa khóa API đã lưu của nhà cung cấp này">
      <script:event script:event-name="on-performaction" script:macro-name="vnd.sun.star.UNO:deleteKey" script:language="UNO"/>
    </dlg:button>
    <dlg:button dlg:id="test" dlg:tab-index="12" dlg:left="130" dlg:top="148" dlg:width="70" dlg:height="14"
                dlg:value="Kiểm tra khóa" dlg:help-text="Gửi một câu hỏi ngắn để kiểm tra khóa và mô hình">
      <script:event script:event-name="on-performaction" script:macro-name="vnd.sun.star.UNO:testKey" script:language="UNO"/>
    </dlg:button>
    <dlg:linklabel dlg:id="keysPage" dlg:tab-index="13" dlg:left="204" dlg:top="150" dlg:width="50" dlg:height="10"
                   dlg:tabstop="true" dlg:value="Lấy khóa API"
                   dlg:help-text="Mở trang tạo khóa API của nhà cung cấp trong trình duyệt"/>
    <dlg:text dlg:id="status" dlg:tab-index="14" dlg:left="12" dlg:top="168" dlg:width="242" dlg:height="30" dlg:multiline="true"
              dlg:value=""/>
    <dlg:linklabel dlg:id="privacy" dlg:tab-index="15" dlg:left="12" dlg:top="202" dlg:width="100" dlg:height="10"
                   dlg:tabstop="true" dlg:value="Chính sách quyền riêng tư"
                   dlg:help-text="Mở trang Chính sách quyền riêng tư của HST Office trong trình duyệt"/>
    <dlg:text dlg:id="locked" dlg:tab-index="16" dlg:left="12" dlg:top="216" dlg:width="242" dlg:height="10"
              dlg:value="Bộ phận CNTT đã khóa một số cài đặt của Trợ lý AI."/>
  </dlg:bulletinboard>
</dlg:window>
