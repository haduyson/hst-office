<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dlg:window PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "dialog.dtd">
<!-- Tùy chọn ▸ HST Office ▸ Mở tài liệu (hst_office/options_page.py handles the buttons). The "Lối tắt ứng dụng"
     section is labelled per OS when the page opens (hst_office/app_shortcuts_ui.py) and hidden on Windows. -->
<dlg:window xmlns:dlg="http://openoffice.org/2000/dialog" xmlns:script="http://openoffice.org/2000/script"
            dlg:id="DefaultApps" dlg:left="0" dlg:top="0" dlg:width="260" dlg:height="130" dlg:withtitlebar="false">
  <dlg:bulletinboard>
    <dlg:fixedline dlg:id="heading" dlg:tab-index="0" dlg:left="6" dlg:top="3" dlg:width="248" dlg:height="10"
                   dlg:value="Tài liệu văn phòng"/>
    <dlg:text dlg:id="note" dlg:tab-index="1" dlg:left="12" dlg:top="17" dlg:width="242" dlg:height="28" dlg:multiline="true"
              dlg:value="Mở tài liệu văn bản (.doc, .docx, .odt), bảng tính (.xls, .xlsx, .ods) và bản trình chiếu (.ppt, .pptx, .odp) bằng HST Office khi nhấp đúp vào tệp."/>
    <dlg:button dlg:id="defaultApps" dlg:tab-index="2" dlg:left="12" dlg:top="48" dlg:width="160" dlg:height="14"
                dlg:value="Dùng HST Office để mở tài liệu văn phòng"
                dlg:help-text="Dùng HST Office để mở tài liệu văn phòng">
      <script:event script:event-name="on-performaction" script:macro-name="vnd.sun.star.UNO:defaultApps" script:language="UNO"/>
    </dlg:button>
    <dlg:fixedline dlg:id="shortcutsHeading" dlg:tab-index="3" dlg:left="6" dlg:top="70" dlg:width="248" dlg:height="10"
                   dlg:value="Lối tắt ứng dụng"/>
    <dlg:text dlg:id="shortcutsNote" dlg:tab-index="4" dlg:left="12" dlg:top="84" dlg:width="242" dlg:height="18" dlg:multiline="true"
              dlg:value="Lối tắt HST Writer, HST Sheets và HST Slides."/>
    <dlg:button dlg:id="appShortcuts" dlg:tab-index="5" dlg:left="12" dlg:top="104" dlg:width="160" dlg:height="14"
                dlg:value="Lối tắt ứng dụng" dlg:help-text="Lối tắt ứng dụng">
      <script:event script:event-name="on-performaction" script:macro-name="vnd.sun.star.UNO:appShortcuts" script:language="UNO"/>
    </dlg:button>
  </dlg:bulletinboard>
</dlg:window>
