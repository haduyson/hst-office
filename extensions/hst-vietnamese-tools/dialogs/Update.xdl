<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dlg:window PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "dialog.dtd">
<!-- Tùy chọn ▸ HST Office ▸ Cập nhật (hst_office/update_options.py loads and saves SendInstallId and wires the privacy link) -->
<dlg:window xmlns:dlg="http://openoffice.org/2000/dialog" xmlns:script="http://openoffice.org/2000/script"
            dlg:id="Update" dlg:left="0" dlg:top="0" dlg:width="260" dlg:height="106" dlg:withtitlebar="false">
  <dlg:bulletinboard>
    <dlg:fixedline dlg:id="heading" dlg:tab-index="0" dlg:left="6" dlg:top="3" dlg:width="248" dlg:height="10"
                   dlg:value="Kiểm tra cập nhật"/>
    <dlg:checkbox dlg:id="sendInstallId" dlg:tab-index="1" dlg:left="12" dlg:top="17" dlg:width="242" dlg:height="20"
                  dlg:multiline="true" dlg:checked="true"
                  dlg:value="Gửi mã máy ẩn danh khi kiểm tra cập nhật và báo lỗi (giúp HASON TECH biết số máy đang dùng)"
                  dlg:help-text="Gửi mã máy ẩn danh khi kiểm tra cập nhật và báo lỗi"/>
    <dlg:text dlg:id="note" dlg:tab-index="2" dlg:left="22" dlg:top="40" dlg:width="232" dlg:height="36" dlg:multiline="true"
              dlg:value="Mã máy là một dãy ký tự ngẫu nhiên do HST Office tạo ra, không lấy từ phần cứng, tên máy hay tên người dùng. Mã được gửi cùng lần kiểm tra cập nhật và trong báo cáo lỗi bạn tự gửi. Bỏ chọn thì không gửi mã; HST Office vẫn kiểm tra cập nhật như thường."/>
    <dlg:linklabel dlg:id="privacy" dlg:tab-index="3" dlg:left="22" dlg:top="78" dlg:width="100" dlg:height="10"
                   dlg:tabstop="true" dlg:value="Chính sách quyền riêng tư"
                   dlg:help-text="Mở trang Chính sách quyền riêng tư của HST Office trong trình duyệt"/>
    <dlg:text dlg:id="locked" dlg:tab-index="4" dlg:left="22" dlg:top="92" dlg:width="232" dlg:height="10"
              dlg:value="Bộ phận CNTT đã khóa cài đặt này."/>
  </dlg:bulletinboard>
</dlg:window>
