<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dlg:window PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "dialog.dtd">
<!-- Tùy chọn ▸ HST Office ▸ Giao diện (hst_office/appearance_options.py loads and saves the choice) -->
<dlg:window xmlns:dlg="http://openoffice.org/2000/dialog" xmlns:script="http://openoffice.org/2000/script"
            dlg:id="Appearance" dlg:left="0" dlg:top="0" dlg:width="260" dlg:height="110" dlg:withtitlebar="false">
  <dlg:bulletinboard>
    <dlg:fixedline dlg:id="heading" dlg:tab-index="0" dlg:left="6" dlg:top="3" dlg:width="248" dlg:height="10"
                   dlg:value="Kiểu biểu tượng"/>
    <dlg:radiogroup>
      <dlg:radio dlg:id="modern" dlg:tab-index="1" dlg:left="12" dlg:top="18" dlg:width="110" dlg:height="10"
                 dlg:value="Hiện đại (nhiều màu)" dlg:help-text="Biểu tượng hiện đại, nhiều màu"/>
      <dlg:radio dlg:id="classic" dlg:tab-index="2" dlg:left="134" dlg:top="18" dlg:width="110" dlg:height="10"
                 dlg:value="Cổ điển" dlg:help-text="Biểu tượng cổ điển, nét đơn sắc"/>
    </dlg:radiogroup>
    <dlg:img dlg:id="modernPreview" dlg:tab-index="3" dlg:left="22" dlg:top="32" dlg:width="100" dlg:height="24"
             dlg:scale-image="false" dlg:help-text="Xem trước biểu tượng hiện đại"/>
    <dlg:img dlg:id="classicPreview" dlg:tab-index="4" dlg:left="144" dlg:top="32" dlg:width="100" dlg:height="24"
             dlg:scale-image="false" dlg:help-text="Xem trước biểu tượng cổ điển"/>
    <dlg:text dlg:id="note" dlg:tab-index="5" dlg:left="12" dlg:top="62" dlg:width="242" dlg:height="20" dlg:multiline="true"
              dlg:value="Biểu tượng đổi ngay khi bấm OK. Ở chế độ tối, HST Office dùng biểu tượng sáng màu tương ứng."/>
  </dlg:bulletinboard>
</dlg:window>
