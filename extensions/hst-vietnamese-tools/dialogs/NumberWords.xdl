<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dlg:window PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "dialog.dtd">
<!-- Tùy chọn ▸ HST Office ▸ Đọc số và tiền (hst_office/number_words_options.py fills the lists and loads and saves
     the user default of /org.hasontech.hstoffice.NumberWords; saved on OK, Cancel keeps the old values) -->
<dlg:window xmlns:dlg="http://openoffice.org/2000/dialog" xmlns:script="http://openoffice.org/2000/script"
            dlg:id="NumberWords" dlg:left="0" dlg:top="0" dlg:width="260" dlg:height="190" dlg:withtitlebar="false">
  <dlg:bulletinboard>
    <dlg:fixedline dlg:id="heading" dlg:tab-index="0" dlg:left="6" dlg:top="3" dlg:width="248" dlg:height="10"
                   dlg:value="Mặc định khi đọc số và tiền"/>
    <dlg:text dlg:id="h_number" dlg:tab-index="1" dlg:left="82" dlg:top="17" dlg:width="84" dlg:height="10" dlg:value="Đọc số (DOCSO)"/>
    <dlg:text dlg:id="h_money" dlg:tab-index="2" dlg:left="170" dlg:top="17" dlg:width="84" dlg:height="10" dlg:value="Đọc tiền (DOCTIEN)"/>
    <dlg:text dlg:id="l_thousand" dlg:tab-index="3" dlg:left="12" dlg:top="32" dlg:width="68" dlg:height="10" dlg:value="Hàng nghìn:"/>
    <dlg:menulist dlg:id="n_thousand" dlg:tab-index="4" dlg:left="82" dlg:top="30" dlg:width="84" dlg:height="12" dlg:spin="true"
                  dlg:help-text="Hàng nghìn đọc số"/>
    <dlg:menulist dlg:id="m_thousand" dlg:tab-index="5" dlg:left="170" dlg:top="30" dlg:width="84" dlg:height="12" dlg:spin="true"
                  dlg:help-text="Hàng nghìn đọc tiền"/>
    <dlg:text dlg:id="l_odd" dlg:tab-index="6" dlg:left="12" dlg:top="48" dlg:width="68" dlg:height="10" dlg:value="Số 0 hàng chục:"/>
    <dlg:menulist dlg:id="n_odd" dlg:tab-index="7" dlg:left="82" dlg:top="46" dlg:width="84" dlg:height="12" dlg:spin="true"
                  dlg:help-text="Số 0 hàng chục đọc số"/>
    <dlg:menulist dlg:id="m_odd" dlg:tab-index="8" dlg:left="170" dlg:top="46" dlg:width="84" dlg:height="12" dlg:spin="true"
                  dlg:help-text="Số 0 hàng chục đọc tiền"/>
    <dlg:text dlg:id="l_four" dlg:tab-index="9" dlg:left="12" dlg:top="64" dlg:width="68" dlg:height="10" dlg:value="Số 4 sau mươi:"/>
    <dlg:menulist dlg:id="n_four" dlg:tab-index="10" dlg:left="82" dlg:top="62" dlg:width="84" dlg:height="12" dlg:spin="true"
                  dlg:help-text="Số 4 sau mươi đọc số"/>
    <dlg:menulist dlg:id="m_four" dlg:tab-index="11" dlg:left="170" dlg:top="62" dlg:width="84" dlg:height="12" dlg:spin="true"
                  dlg:help-text="Số 4 sau mươi đọc tiền"/>
    <dlg:text dlg:id="l_language" dlg:tab-index="12" dlg:left="12" dlg:top="80" dlg:width="68" dlg:height="10" dlg:value="Ngôn ngữ:"/>
    <dlg:menulist dlg:id="n_language" dlg:tab-index="13" dlg:left="82" dlg:top="78" dlg:width="84" dlg:height="12" dlg:spin="true"
                  dlg:help-text="Ngôn ngữ đọc số"/>
    <dlg:menulist dlg:id="m_language" dlg:tab-index="14" dlg:left="170" dlg:top="78" dlg:width="84" dlg:height="12" dlg:spin="true"
                  dlg:help-text="Ngôn ngữ đọc tiền"/>
    <dlg:text dlg:id="l_unit" dlg:tab-index="15" dlg:left="12" dlg:top="96" dlg:width="68" dlg:height="10" dlg:value="Đơn vị:"/>
    <dlg:textfield dlg:id="m_unit" dlg:tab-index="16" dlg:left="170" dlg:top="94" dlg:width="84" dlg:height="12" dlg:help-text="Đơn vị đọc tiền"/>
    <dlg:text dlg:id="l_sub" dlg:tab-index="17" dlg:left="12" dlg:top="112" dlg:width="68" dlg:height="10" dlg:value="Đơn vị lẻ:"/>
    <dlg:textfield dlg:id="m_sub" dlg:tab-index="18" dlg:left="170" dlg:top="110" dlg:width="84" dlg:height="12" dlg:help-text="Đơn vị lẻ đọc tiền"/>
    <dlg:text dlg:id="note" dlg:tab-index="19" dlg:left="12" dlg:top="130" dlg:width="242" dlg:height="46" dlg:multiline="true"
              dlg:value="Hộp thoại “Đọc số thành chữ” mở với các giá trị này và ghi lại lựa chọn bạn dùng lần cuối; bảng tính có mặc định riêng (ô “Dùng làm mặc định cho tệp này”) thì dùng mặc định của tệp. Hàm DOCSO, DOCTIEN trong ô không dùng các giá trị này: phần không ghi trong hàm theo mặc định của tệp, nếu không có thì đọc “đồng”, không đọc xu, nên tệp đọc giống nhau trên mọi máy."/>
  </dlg:bulletinboard>
</dlg:window>
