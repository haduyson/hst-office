<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dlg:window PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "dialog.dtd">
<!-- Tùy chọn ▸ HST Office ▸ Phiên bản trước (hst_office/version_options.py loads and saves Enabled, shows the store's
     size and clears it after a confirmation on the page itself) -->
<dlg:window xmlns:dlg="http://openoffice.org/2000/dialog" xmlns:script="http://openoffice.org/2000/script"
            dlg:id="PreviousVersions" dlg:left="0" dlg:top="0" dlg:width="260" dlg:height="176" dlg:withtitlebar="false">
  <dlg:bulletinboard>
    <dlg:fixedline dlg:id="heading" dlg:tab-index="0" dlg:left="6" dlg:top="3" dlg:width="248" dlg:height="10"
                   dlg:value="Phiên bản trước"/>
    <dlg:checkbox dlg:id="enabled" dlg:tab-index="1" dlg:left="12" dlg:top="17" dlg:width="242" dlg:height="10"
                  dlg:checked="true" dlg:value="Lưu phiên bản trước khi ghi đè tệp"
                  dlg:help-text="Lưu phiên bản trước khi ghi đè tệp"/>
    <dlg:text dlg:id="note" dlg:tab-index="2" dlg:left="22" dlg:top="30" dlg:width="232" dlg:height="46" dlg:multiline="true"
              dlg:value="Mỗi lần bạn lưu đè lên một tệp đã có, HST Office cất bản cũ của tệp trong hồ sơ người dùng trên máy này; bản cất không được gửi đi đâu. Mỗi tệp giữ tối đa 10 bản hoặc 30 ngày, cả kho tối đa 2 GB (bản cũ nhất bị xóa trước); tệp lớn hơn 100 MB không được cất. Xem và khôi phục bằng lệnh Phiên bản trước của Tệp tin."/>
    <dlg:text dlg:id="locked" dlg:tab-index="3" dlg:left="22" dlg:top="78" dlg:width="232" dlg:height="10"
              dlg:value="Bộ phận CNTT đã khóa cài đặt này."/>
    <dlg:fixedline dlg:id="storeHeading" dlg:tab-index="4" dlg:left="6" dlg:top="94" dlg:width="248" dlg:height="10"
                   dlg:value="Kho phiên bản"/>
    <dlg:text dlg:id="usage" dlg:tab-index="5" dlg:left="12" dlg:top="108" dlg:width="242" dlg:height="10"
              dlg:value="Chưa có phiên bản nào được lưu."/>
    <dlg:button dlg:id="clear" dlg:tab-index="6" dlg:left="12" dlg:top="122" dlg:width="140" dlg:height="14"
                dlg:value="Xóa toàn bộ phiên bản đã lưu" dlg:help-text="Xóa toàn bộ phiên bản đã lưu">
      <script:event script:event-name="on-performaction" script:macro-name="vnd.sun.star.UNO:clearVersions" script:language="UNO"/>
    </dlg:button>
    <dlg:text dlg:id="confirmText" dlg:tab-index="7" dlg:left="12" dlg:top="140" dlg:width="242" dlg:height="18" dlg:multiline="true"
              dlg:value="Xóa vĩnh viễn mọi phiên bản đã lưu của mọi tệp? Các tệp của bạn không bị ảnh hưởng."/>
    <dlg:button dlg:id="confirmClear" dlg:tab-index="8" dlg:left="12" dlg:top="158" dlg:width="60" dlg:height="14"
                dlg:value="Xóa" dlg:help-text="Xóa toàn bộ phiên bản đã lưu">
      <script:event script:event-name="on-performaction" script:macro-name="vnd.sun.star.UNO:confirmClear" script:language="UNO"/>
    </dlg:button>
    <dlg:button dlg:id="cancelClear" dlg:tab-index="9" dlg:left="76" dlg:top="158" dlg:width="60" dlg:height="14"
                dlg:value="Không xóa" dlg:help-text="Không xóa">
      <script:event script:event-name="on-performaction" script:macro-name="vnd.sun.star.UNO:cancelClear" script:language="UNO"/>
    </dlg:button>
  </dlg:bulletinboard>
</dlg:window>
