<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dlg:window PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "dialog.dtd">
<!-- Tùy chọn ▸ HST Office ▸ Ribbon (hst_office/ribbon_options.py: "Tùy chỉnh ribbon" opens the core's dialog for the
     current document's ribbon; the recently used tab's switch is saved on OK; "Xóa lịch sử" clears at once) -->
<dlg:window xmlns:dlg="http://openoffice.org/2000/dialog" xmlns:script="http://openoffice.org/2000/script"
            dlg:id="Ribbon" dlg:left="0" dlg:top="0" dlg:width="260" dlg:height="176" dlg:withtitlebar="false">
  <dlg:bulletinboard>
    <dlg:fixedline dlg:id="customizeHeading" dlg:tab-index="0" dlg:left="6" dlg:top="3" dlg:width="248" dlg:height="10"
                   dlg:value="Tùy chỉnh ribbon"/>
    <dlg:text dlg:id="customizeNote" dlg:tab-index="1" dlg:left="12" dlg:top="16" dlg:width="242" dlg:height="20" dlg:multiline="true"
              dlg:value="Thêm thẻ và nhóm của bạn, ẩn hoặc sắp xếp lại các nhóm và lệnh của ribbon trong ứng dụng đang mở. Bạn cũng có thể nhấp chuột phải vào ribbon."/>
    <dlg:button dlg:id="customize" dlg:tab-index="2" dlg:left="12" dlg:top="38" dlg:width="100" dlg:height="14"
                dlg:value="Tùy chỉnh ribbon" dlg:help-text="Tùy chỉnh ribbon của ứng dụng đang mở">
      <script:event script:event-name="on-performaction" script:macro-name="vnd.sun.star.UNO:customize" script:language="UNO"/>
    </dlg:button>
    <dlg:fixedline dlg:id="recentHeading" dlg:tab-index="3" dlg:left="6" dlg:top="60" dlg:width="248" dlg:height="10"
                   dlg:value="Thẻ Sử dụng gần đây"/>
    <dlg:checkbox dlg:id="recentEnabled" dlg:tab-index="4" dlg:left="12" dlg:top="74" dlg:width="242" dlg:height="10"
                  dlg:checked="true" dlg:value="Hiện thẻ Sử dụng gần đây"
                  dlg:help-text="Hiện thẻ Sử dụng gần đây"/>
    <dlg:text dlg:id="recentNote" dlg:tab-index="5" dlg:left="22" dlg:top="87" dlg:width="232" dlg:height="38" dlg:multiline="true"
              dlg:value="Thẻ đứng sau Trang đầu và hiện các lệnh bạn dùng nhiều trong 30 ngày qua. Lịch sử dùng lệnh chỉ được lưu trong hồ sơ người dùng trên máy này, không được gửi đi đâu; khi tắt thẻ, HST Office ngừng ghi lại lệnh."/>
    <dlg:button dlg:id="clearHistory" dlg:tab-index="6" dlg:left="12" dlg:top="128" dlg:width="100" dlg:height="14"
                dlg:value="Xóa lịch sử" dlg:help-text="Xóa lịch sử dùng lệnh của mọi ứng dụng">
      <script:event script:event-name="on-performaction" script:macro-name="vnd.sun.star.UNO:clearHistory" script:language="UNO"/>
    </dlg:button>
    <dlg:text dlg:id="status" dlg:tab-index="7" dlg:left="12" dlg:top="146" dlg:width="242" dlg:height="20" dlg:multiline="true"
              dlg:value=""/>
  </dlg:bulletinboard>
</dlg:window>
