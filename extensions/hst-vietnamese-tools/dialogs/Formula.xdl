<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dlg:window PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "dialog.dtd">
<!-- Tùy chọn ▸ HST Office ▸ Công thức (hst_office/formula_options.py loads and saves
     /org.openoffice.Office.Common/Filter/Microsoft/Import/MathType5ToMath on OK; Cancel keeps the old value) -->
<dlg:window xmlns:dlg="http://openoffice.org/2000/dialog" xmlns:script="http://openoffice.org/2000/script"
            dlg:id="Formula" dlg:left="0" dlg:top="0" dlg:width="260" dlg:height="90" dlg:withtitlebar="false">
  <dlg:bulletinboard>
    <dlg:fixedline dlg:id="heading" dlg:tab-index="0" dlg:left="6" dlg:top="3" dlg:width="248" dlg:height="10"
                   dlg:value="HST Công thức"/>
    <dlg:checkbox dlg:id="convertOnOpen" dlg:tab-index="1" dlg:left="12" dlg:top="17" dlg:width="242" dlg:height="20"
                  dlg:multiline="true" dlg:checked="false"
                  dlg:value="Tự chuyển công thức MathType thành công thức sửa được khi mở tài liệu"
                  dlg:help-text="Tự chuyển công thức MathType khi mở tài liệu"/>
    <dlg:text dlg:id="note" dlg:tab-index="2" dlg:left="22" dlg:top="40" dlg:width="232" dlg:height="44" dlg:multiline="true"
              dlg:value="Khi tắt, công thức MathType vẫn hiện như ảnh; bấm đúp vào một công thức hoặc dùng Chèn ▸ Chuyển công thức để chuyển khi cần (hoàn tác được bằng Ctrl+Z). Công thức nào không đọc được thì giữ nguyên như cũ."/>
  </dlg:bulletinboard>
</dlg:window>
