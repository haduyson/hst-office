<?xml version="1.0" encoding="UTF-8"?>
<oor:component-schema xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema"
                      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                      oor:name="SaveFormatCheck" oor:package="org.hasontech.hstoffice" xml:lang="en-US">
  <info>
    <desc>Per-user answer of the warning shown when a Sheets document whose cells use DOCSO, DOCTIEN, BODAU, TACHHO
      or TACHTEN is saved as .xlsx/.xls (hst_office/save_format_prefs.py). Stored only when "Không hỏi lại" is
      ticked; Tùy chọn ▸ HST Office ▸ Đọc số và tiền shows it and turns the question back on.</desc>
  </info>
  <component>
    <prop oor:name="Remembered" oor:type="xs:string" oor:nillable="false">
      <info>
        <desc>Empty: ask every time. "convert": the saved file holds the results of those cells (the open document
          keeps its formulas). "keep": the saved file keeps the formulas.</desc>
      </info>
      <value></value>
    </prop>
  </component>
</oor:component-schema>
