<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Jobs" oor:package="org.openoffice.Office">
  <node oor:name="Jobs">
    <node oor:name="org.hst.office.BannerStartup" oor:op="replace">
      <prop oor:name="Service"><value>org.hst.office.BannerStartup</value></prop>
    </node>
    <!-- the one start-up dispatcher: crash question, macOS move, welcome, default apps, update notice; at most one
         modal question per start (hst_office/startup_prompts.py) -->
    <node oor:name="org.hst.office.vi.StartupPromptsJob" oor:op="replace">
      <prop oor:name="Service"><value>org.hst.office.vi.StartupPromptsJob</value></prop>
    </node>
    <!-- after an abnormal exit: OnStartApp reads the recovery state and HST's session marker, OnCloseApp removes the
         marker; the start-up dispatcher asks (hst_office/error_report_crash.py, hst_office/diag_crash.py) -->
    <node oor:name="org.hst.office.vi.CrashReportJob" oor:op="replace">
      <prop oor:name="Service"><value>org.hst.office.vi.CrashReportJob</value></prop>
    </node>
    <!-- after saving an Excel file: warn that VBA UserForms are not written (hst_office/vba_save_check.py) -->
    <node oor:name="org.hst.office.vi.VbaSaveCheckJob" oor:op="replace">
      <prop oor:name="Service"><value>org.hst.office.vi.VbaSaveCheckJob</value></prop>
    </node>
    <!-- Phiên bản trước: copy a document's file in the background once it is modified, keep that copy at OnSave
         (before the office writes the file), record the file written at OnSaveDone/OnSaveAsDone (an unmodified re-save
         keeps nothing), drop it at OnUnload (hst_office/version_job.py, version_capture.py) -->
    <node oor:name="org.hst.office.vi.PreviousVersionsJob" oor:op="replace">
      <prop oor:name="Service"><value>org.hst.office.vi.PreviousVersionsJob</value></prop>
    </node>
  </node>
  <node oor:name="Events">
    <node oor:name="onFirstVisibleTask" oor:op="fuse">
      <node oor:name="JobList">
        <node oor:name="org.hst.office.BannerStartup" oor:op="replace"/>
        <node oor:name="org.hst.office.vi.StartupPromptsJob" oor:op="replace"/>
      </node>
    </node>
    <node oor:name="OnStartApp" oor:op="fuse">
      <node oor:name="JobList">
        <node oor:name="org.hst.office.vi.CrashReportJob" oor:op="replace"/>
      </node>
    </node>
    <node oor:name="OnCloseApp" oor:op="fuse">
      <node oor:name="JobList">
        <node oor:name="org.hst.office.vi.CrashReportJob" oor:op="replace"/>
      </node>
    </node>
    <node oor:name="OnModifyChanged" oor:op="fuse">
      <node oor:name="JobList">
        <node oor:name="org.hst.office.vi.PreviousVersionsJob" oor:op="replace"/>
      </node>
    </node>
    <node oor:name="OnSave" oor:op="fuse">
      <node oor:name="JobList">
        <node oor:name="org.hst.office.vi.PreviousVersionsJob" oor:op="replace"/>
      </node>
    </node>
    <node oor:name="OnUnload" oor:op="fuse">
      <node oor:name="JobList">
        <node oor:name="org.hst.office.vi.PreviousVersionsJob" oor:op="replace"/>
      </node>
    </node>
    <node oor:name="OnSaveDone" oor:op="fuse">
      <node oor:name="JobList">
        <node oor:name="org.hst.office.vi.VbaSaveCheckJob" oor:op="replace"/>
        <node oor:name="org.hst.office.vi.PreviousVersionsJob" oor:op="replace"/>
      </node>
    </node>
    <node oor:name="OnSaveAsDone" oor:op="fuse">
      <node oor:name="JobList">
        <node oor:name="org.hst.office.vi.VbaSaveCheckJob" oor:op="replace"/>
        <node oor:name="org.hst.office.vi.PreviousVersionsJob" oor:op="replace"/>
      </node>
    </node>
  </node>
</oor:component-data>
