<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: AGPL-3.0-only -->
<!-- The HST templates in this extension (template/<group>/, generated by
     scripts/build-extensions.py) appear in the Template Manager. -->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    oor:name="Paths" oor:package="org.openoffice.Office">
  <node oor:name="Paths">
    <node oor:name="Template" oor:op="fuse">
      <node oor:name="InternalPaths">
        <node oor:name="%origin%/template" oor:op="fuse"/>
      </node>
    </node>
  </node>
</oor:component-data>
