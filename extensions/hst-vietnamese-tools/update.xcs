<?xml version="1.0" encoding="UTF-8"?>
<oor:component-schema xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema"
                      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                      oor:name="UpdateCheck" oor:package="org.hasontech.hstoffice" xml:lang="en-US">
  <info>
    <desc>HST Office update check (docs/UPDATE_CHECK.md). Administrators can lock AutoCheck with a finalized
      configuration layer. Only the product version, the OS name and (unless SendInstallId is false) the anonymous
      InstallId are sent to office.hasontech.vn.</desc>
  </info>
  <component>
    <prop oor:name="AutoCheck" oor:type="xs:boolean" oor:nillable="false">
      <info>
        <desc>Check for a new HST Office version at start-up, at most once every 24 hours.</desc>
      </info>
      <value>true</value>
    </prop>
    <prop oor:name="AllowInstall" oor:type="xs:boolean" oor:nillable="false">
      <info>
        <desc>Offer "Cập nhật ngay" (download, verify, and install after the user agrees). When false, only the
          manual download link is offered. Administrators can lock it with a finalized configuration layer.</desc>
      </info>
      <value>true</value>
    </prop>
    <prop oor:name="LastCheck" oor:type="xs:long" oor:nillable="false">
      <info>
        <desc>Unix time (seconds) of the last automatic check attempt.</desc>
      </info>
      <value>0</value>
    </prop>
    <prop oor:name="SkippedVersion" oor:type="xs:string" oor:nillable="false">
      <info>
        <desc>Version the user chose to skip ("Bỏ qua phiên bản này"); it is not announced again.</desc>
      </info>
      <value/>
    </prop>
    <prop oor:name="SendInstallId" oor:type="xs:boolean" oor:nillable="false">
      <info>
        <desc>Send InstallId with the update check (Tùy chọn ▸ HST Office ▸ Cập nhật), so HASON TECH can count the
          machines in use. When false, no ID is sent and none is created; the update check works the same.
          The core /org.openoffice.Office.HSTUpdate/SendInstallId takes precedence when the core has it; this one
          is its fallback and can be locked by a shared policy extension (docs/UPDATE_ADMIN.md).</desc>
      </info>
      <value>true</value>
    </prop>
    <prop oor:name="InstallId" oor:type="xs:string" oor:nillable="false">
      <info>
        <desc>Anonymous install ID: a random UUID4 created at the first update check, derived from nothing on the
          machine. Lives only in this user profile; a new profile gets a new ID.</desc>
      </info>
      <value/>
    </prop>
  </component>
</oor:component-schema>
