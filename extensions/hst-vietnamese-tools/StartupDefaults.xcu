<?xml version="1.0" encoding="UTF-8"?>
<!-- Windows: the upstream start-up check for default file associations is replaced by HST's own question
     (hst_office/default_apps.py), so the two are never shown together. A user or administrator value wins.
     UseOpenCL: Calc's first use of OpenCL in a new profile ended the office on a Windows PC with an older NVIDIA
     driver (GeForce GT 730, driver 456.71): the first spreadsheet with formulas crashed it once, then OpenCL was
     turned off for that profile. Calculation runs on the processor instead. -->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Common" oor:package="org.openoffice.Office">
  <node oor:name="Misc">
    <prop oor:name="PerformFileExtCheck">
      <value>false</value>
    </prop>
    <prop oor:name="UseOpenCL">
      <value>false</value>
    </prop>
  </node>
</oor:component-data>
