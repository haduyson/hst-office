<?xml version="1.0" encoding="UTF-8"?>
<!-- HST Office: the Microsoft Office VBA shortcuts in HST Writer and HST Sheets.
     Alt+F11 (Option+F11 on macOS) opens the VBA editor on the document's VBA module ("Macro VBA",
     org.hst.office.vi:EditVba); it replaces, in these two modules only, the global Alt+F11 of the
     Basic Macros dialog (.uno:MacroDialog). Alt+F8 opens that dialog (run/edit/create macros, the
     Office "Macros" dialog) in HST Sheets and HST Writer, as in Excel and Word; in Writer this
     replaces the extended-selection key (still on the status bar's selection mode control,
     owner decision 2026-11-04). Checked by tests/runtime/check-vba.py. -->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Accelerators" oor:package="org.openoffice.Office">
  <node oor:name="PrimaryKeys">
    <node oor:name="Modules">
      <node oor:name="com.sun.star.sheet.SpreadsheetDocument">
        <node oor:name="F11_MOD2" oor:op="replace">
          <prop oor:name="Command"><value xml:lang="en-US">org.hst.office.vi:EditVba</value></prop>
        </node>
        <node oor:name="F8_MOD2" oor:op="replace">
          <prop oor:name="Command"><value xml:lang="en-US">.uno:MacroDialog</value></prop>
        </node>
      </node>
      <node oor:name="com.sun.star.text.TextDocument">
        <node oor:name="F11_MOD2" oor:op="replace">
          <prop oor:name="Command"><value xml:lang="en-US">org.hst.office.vi:EditVba</value></prop>
        </node>
        <node oor:name="F8_MOD2" oor:op="replace">
          <prop oor:name="Command"><value xml:lang="en-US">.uno:MacroDialog</value></prop>
        </node>
        <!-- Trích dẫn: type [3 or [3, tr. 15 and press Alt+Shift+I (Option+Shift+I on macOS) to cite source
             number 3 again (hst_office/citation_cite_actions.py); a free key in HST Writer -->
        <node oor:name="I_SHIFT_MOD2" oor:op="replace">
          <prop oor:name="Command"><value xml:lang="en-US">org.hst.office.vi:CitationReinsert</value></prop>
        </node>
      </node>
    </node>
  </node>
</oor:component-data>
