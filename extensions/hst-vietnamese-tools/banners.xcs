<?xml version="1.0" encoding="UTF-8"?>
<oor:component-schema xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema"
                      oor:name="Banners" oor:package="org.hasontech.hstoffice" xml:lang="en-US">
  <info><desc>Shared solution banner feed. No visibility or disable setting exists.</desc></info>
  <component>
    <prop oor:name="FeedURL" oor:type="xs:string" oor:nillable="false">
      <info><desc>Expert testing override: HTTPS only; empty or invalid values use the production endpoint.
      Content must still carry a valid banner signature and use allowed item/image hosts.</desc></info>
      <value></value>
    </prop>
  </component>
</oor:component-schema>
