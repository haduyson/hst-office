<?xml version="1.0" encoding="UTF-8"?>
<oor:component-schema xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema"
                      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                      oor:name="Formula" oor:package="org.hasontech.hstoffice" xml:lang="en-US">
  <info>
    <desc>HST Công thức. "Mẫu công thức" (hst_office/formula_action.py) sets OpenTemplates before it inserts a
      formula; the formula editor's Elements panel then opens on the "Mẫu Toán" category and clears it
      (starmath/source/hst/elementtemplates.cxx, hst-math-constructs-mathtype5.patch).</desc>
  </info>
  <component>
    <prop oor:name="OpenTemplates" oor:type="xs:boolean" oor:nillable="false">
      <info>
        <desc>The next Elements panel opens on the HST template categories (one time).</desc>
      </info>
      <value>false</value>
    </prop>
  </component>
</oor:component-schema>
