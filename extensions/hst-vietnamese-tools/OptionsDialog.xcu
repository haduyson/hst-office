<?xml version="1.0" encoding="UTF-8"?>
<!-- Tùy chọn ▸ HST Office ▸ Mở tài liệu: a node labelled exactly like the product group joins that group
     (cui treeopt.cxx lcl_insertLeaf matches the label), so the page sits next to Chung. -->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="OptionsDialog" oor:package="org.openoffice.Office">
  <node oor:name="Nodes">
    <node oor:name="vn.hasontech.hstoffice.Options" oor:op="fuse">
      <prop oor:name="Label"><value>HST Office</value></prop>
      <!-- shown from every module (Start Center, Writer, Sheets, Slides), not only one -->
      <prop oor:name="AllModules"><value>true</value></prop>
      <node oor:name="Leaves">
        <node oor:name="vn.hasontech.hstoffice.Options.DefaultApps" oor:op="fuse">
          <prop oor:name="Id"><value>vn.hasontech.hst.vietnamese-tools</value></prop>
          <prop oor:name="Label"><value>Mở tài liệu</value></prop>
          <prop oor:name="OptionsPage"><value>%origin%/dialogs/DefaultApps.xdl</value></prop>
          <prop oor:name="EventHandlerService"><value>org.hst.office.vi.OptionsPage</value></prop>
        </node>
        <node oor:name="vn.hasontech.hstoffice.Options.Appearance" oor:op="fuse">
          <prop oor:name="Id"><value>vn.hasontech.hst.vietnamese-tools</value></prop>
          <prop oor:name="Label"><value>Giao diện</value></prop>
          <prop oor:name="OptionsPage"><value>%origin%/dialogs/Appearance.xdl</value></prop>
          <prop oor:name="EventHandlerService"><value>org.hst.office.vi.OptionsAppearance</value></prop>
        </node>
        <node oor:name="vn.hasontech.hstoffice.Options.Update" oor:op="fuse">
          <prop oor:name="Id"><value>vn.hasontech.hst.vietnamese-tools</value></prop>
          <prop oor:name="Label"><value>Cập nhật</value></prop>
          <prop oor:name="OptionsPage"><value>%origin%/dialogs/Update.xdl</value></prop>
          <prop oor:name="EventHandlerService"><value>org.hst.office.vi.OptionsUpdate</value></prop>
        </node>
        <node oor:name="vn.hasontech.hstoffice.Options.PreviousVersions" oor:op="fuse">
          <prop oor:name="Id"><value>vn.hasontech.hst.vietnamese-tools</value></prop>
          <prop oor:name="Label"><value>Phiên bản trước</value></prop>
          <prop oor:name="OptionsPage"><value>%origin%/dialogs/PreviousVersions.xdl</value></prop>
          <prop oor:name="EventHandlerService"><value>org.hst.office.vi.OptionsPreviousVersions</value></prop>
        </node>
        <node oor:name="vn.hasontech.hstoffice.Options.NumberWords" oor:op="fuse">
          <prop oor:name="Id"><value>vn.hasontech.hst.vietnamese-tools</value></prop>
          <prop oor:name="Label"><value>Đọc số và tiền</value></prop>
          <prop oor:name="OptionsPage"><value>%origin%/dialogs/NumberWords.xdl</value></prop>
          <prop oor:name="EventHandlerService"><value>org.hst.office.vi.OptionsNumberWords</value></prop>
        </node>
      </node>
    </node>
  </node>
</oor:component-data>
