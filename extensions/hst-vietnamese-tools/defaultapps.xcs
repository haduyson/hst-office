<?xml version="1.0" encoding="UTF-8"?>
<oor:component-schema xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema"
                      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                      oor:name="DefaultApps" oor:package="org.hasontech.hstoffice" xml:lang="en-US">
  <info>
    <desc>Per-user state of the start-up question "open office documents with HST Office" (hst_office/default_apps.py). No data leaves the machine.</desc>
  </info>
  <component>
    <prop oor:name="Ask" oor:type="xs:boolean" oor:nillable="false">
      <info>
        <desc>Ask at start-up at all. An administrator can lock it to false; the HST menu and the options page still work.</desc>
      </info>
      <value>true</value>
    </prop>
    <prop oor:name="Asked" oor:type="xs:int" oor:nillable="false">
      <info>
        <desc>How many times the question was shown at start-up (at most 3).</desc>
      </info>
      <value>0</value>
    </prop>
    <prop oor:name="LastAsked" oor:type="xs:long" oor:nillable="false">
      <info>
        <desc>When it was last shown (seconds since 1970); "later" asks again 14 days after it.</desc>
      </info>
      <value>0</value>
    </prop>
    <prop oor:name="Done" oor:type="xs:boolean" oor:nillable="false">
      <info>
        <desc>True once the user agreed, or HST was found to already open the office document types.</desc>
      </info>
      <value>false</value>
    </prop>
  </component>
</oor:component-schema>
