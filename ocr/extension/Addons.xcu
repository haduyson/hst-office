<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: LicenseRef-HST-Proprietary -->
<!-- Chèn ▸ Nhận dạng chữ từ ảnh, after Hình ảnh (.uno:InsertGraphic) in HST Writer's classic Insert menu. A ribbon
     button needs a core .ui change (Tabbed UI has no merge point for extensions); see the prototype report. -->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Addons" oor:package="org.openoffice.Office">
  <node oor:name="AddonUI">
    <node oor:name="OfficeMenuBarMerging">
      <node oor:name="vn.hasontech.hst.ocr" oor:op="replace">
        <node oor:name="m1" oor:op="replace">
          <prop oor:name="MergePoint"><value>.uno:InsertMenu\.uno:InsertGraphic</value></prop>
          <prop oor:name="MergeCommand"><value>AddAfter</value></prop>
          <prop oor:name="MergeFallback"><value>AddPath</value></prop>
          <prop oor:name="MergeContext"><value>com.sun.star.text.TextDocument</value></prop>
          <node oor:name="MenuItems">
            <node oor:name="m1" oor:op="replace">
              <prop oor:name="URL" oor:type="xs:string"><value>vn.hasontech.hst.ocr:RecognizeText</value></prop>
              <prop oor:name="Title" oor:type="xs:string">
                <value>Nhận dạng chữ từ ảnh…</value>
                <value xml:lang="en-US">Nhận dạng chữ từ ảnh…</value>
                <value xml:lang="vi">Nhận dạng chữ từ ảnh…</value>
              </prop>
              <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            </node>
          </node>
        </node>
      </node>
    </node>
  </node>
</oor:component-data>
