# Scripts and patches run under Cygwin must keep LF line endings on Windows checkouts.
*.sh text eol=lf
*.patch text eol=lf
*.py text eol=lf
*.conf text eol=lf
patches/libreoffice/series text eol=lf
# Update-lock templates of the user guide: Windows .reg files keep CRLF, byte for byte as generated.
extensions/hst-vietnamese-tools/help/files/*.reg -text
