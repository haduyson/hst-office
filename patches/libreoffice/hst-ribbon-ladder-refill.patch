+tools::Long PriorityMergedHBox::HstMinWidth() const
+{
+    if (!m_bInitialized || !hst::ribbon::collapseLadderEnabled())
+        return -1;
+    tools::Long nMin = 0;
+    sal_uInt16 nGroups = 0;
+    for (vcl::Window* pChild = GetWindow(GetWindowType::FirstChild); pChild;
+         pChild = pChild->GetWindow(GetWindowType::Next))
+    {
+        if (pChild == m_pButton)
+            continue;
+        const auto it = m_aHstWidths.find(pChild);
+        if (it == m_aHstWidths.end() || it->second.second.empty())
+            return -1;
+        nMin += *std::min_element(it->second.second.begin(), it->second.second.end());
+        ++nGroups;
+    }
+    return nGroups ? nMin + get_spacing() * (nGroups - 1) : -1;
 }
 
