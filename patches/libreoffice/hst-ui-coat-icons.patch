+/// Menu items show LibreOffice's own icons in every HST style (owner decision of 20/11/2026): the HST
+/// glyphs stay on the ribbon and the frame, menus take the SVG Colibre of the same brightness and fall
+/// back to the HST style only for commands Colibre does not draw. Returns that Colibre theme for an
+/// HST style, or empty for any other theme (whose menus are left as they are).
+inline OUString menuIconTheme(std::u16string_view rTheme)
+{
+    if (!o3tl::starts_with(rTheme, u"hst"))
+        return OUString();
+    return o3tl::ends_with(rTheme, u"_dark") ? u"colibre_dark_svg"_ustr : u"colibre_svg"_ustr;
+}
+
+/// The small icon of a plain ".uno:" command, as the image managers name it ("cmd/sc_<name>.png",
+/// lower case); empty for commands with arguments or other protocols (left to the image managers).
+inline OUString menuIconName(std::u16string_view rCommand)
+{
+    if (!o3tl::starts_with(rCommand, u".uno:") || rCommand.size() <= 5
+        || rCommand.find_first_of(u"?/:", 5) != std::u16string_view::npos)
+        return OUString();
+    return "cmd/sc_" + OUString(rCommand.substr(5)).toAsciiLowerCase() + ".png";
+}
+
 /// Name of the stamp file inside each "<UserInstallation>/cache/<theme>" directory.
 inline constexpr OUString ICON_CACHE_STAMP_FILE = u"hst-icon-cache-version"_ustr;
 
