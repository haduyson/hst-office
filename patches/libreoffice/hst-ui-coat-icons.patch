+Image GetLibreOfficeMenuImage(const OUString& rsCommandName)
+{
+    // HST Office: menus show LibreOffice's icons, the HST glyphs stay on the ribbon and the frame
+    const OUString aTheme = vcl::hst::menuIconTheme(
+        Application::GetSettings().GetStyleSettings().DetermineIconTheme());
+    const OUString aName = vcl::hst::menuIconName(rsCommandName);
+    if (aTheme.isEmpty() || aName.isEmpty())
+        return Image();
+    Bitmap aBitmap;
+    if (!ImageTree::get().loadImage(aName, aTheme, aBitmap, true))
+        return Image();
+    return Image(aBitmap);
+}
