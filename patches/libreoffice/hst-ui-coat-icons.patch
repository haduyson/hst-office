+/// Whether the user (module image manager, user layer) or the document assigned an image of its own
+/// to the command.
+bool lcl_hasCustomizedImage(const OUString& rCommand, const Reference<XFrame>& rxFrame)
+{
+    const sal_Int16 nType = css::ui::ImageType::COLOR_NORMAL | css::ui::ImageType::SIZE_DEFAULT;
+    try
+    {
+        // the document image manager has no theme layer: any image it has is the document's own
+        Reference<XController> xController(rxFrame->getController(), UNO_SET_THROW);
+        Reference<css::ui::XUIConfigurationManagerSupplier> xSupplier(xController->getModel(), UNO_QUERY);
+        if (xSupplier.is())
+        {
+            Reference<css::ui::XImageManager> xDocImages(
+                xSupplier->getUIConfigurationManager()->getImageManager(), UNO_QUERY);
+            if (xDocImages.is() && xDocImages->hasImage(nType, rCommand))
+                return true;
+        }
+    }
+    catch (const Exception&)
+    {
+    }
+    try
+    {
+        Reference<css::ui::XModuleUIConfigurationManagerSupplier> xModules
+            = css::ui::theModuleUIConfigurationManagerSupplier::get(comphelper::getProcessComponentContext());
+        Reference<css::ui::XUIConfigurationManager> xModule(xModules->getUIConfigurationManager(
+            vcl::CommandInfoProvider::GetModuleIdentifier(rxFrame)));
+        Reference<XInterface> xImages(xModule->getImageManager());
+        if (auto* pImages = dynamic_cast<ImageManager*>(xImages.get()))
+            return pImages->hasUserImage(nType, rCommand);
+    }
+    catch (const Exception&)
+    {
+    }
+    return false;
+}
+}
+
+Image GetMenuImageForCommand(const OUString& rCommand, const Reference<XFrame>& rxFrame)
+{
+    // HST Office: menus show LibreOffice's icons unless the user or the document chose one
+    Image aLibreOffice = vcl::CommandInfoProvider::GetLibreOfficeMenuImage(rCommand);
+    if (!!aLibreOffice && !lcl_hasCustomizedImage(rCommand, rxFrame))
+        return aLibreOffice;
+    return vcl::CommandInfoProvider::GetImageForCommand(rCommand, rxFrame);
+}
