         vcl::ImageType eImageType = vcl::ImageType::Small,
         vcl::ImageWritingDirection eImageDir = vcl::ImageWritingDirection::DontCare);
 
+    /** The image of a menu item for a command: in the HST styles LibreOffice's own (Colibre) icon
+        of the command at the display's icon scale, else (no Colibre icon, other themes, commands with
+        arguments) GetImageForCommand.
+    */
+    VCL_DLLPUBLIC Image GetMenuImageForCommand(
+        const OUString& rsCommandName,
+        const css::uno::Reference<css::frame::XFrame>& rxFrame);
+
     VCL_DLLPUBLIC sal_Int32 GetPropertiesForCommand(
         const OUString& rsCommandName,
