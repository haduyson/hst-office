+/// Menu item images in the HST icon styles: an image the user or the document assigned to a command
+/// wins over LibreOffice's icon, which wins over the HST glyph.
+class MenuImagesTest : public UnoApiTest
+{
+public:
+    MenuImagesTest()
+        : UnoApiTest(u"/framework/qa/cppunit/data/"_ustr)
+    {
+    }
+};
+
+uno::Reference<graphic::XGraphic> solid(Color aColor)
+{
+    Bitmap aBitmap(Size(16, 16), vcl::PixelFormat::N24_BPP);
+    aBitmap.Erase(aColor);
+    return Graphic(aBitmap).GetXGraphic();
+}
+
+Color centre(const Image& rImage)
+{
+    const Bitmap aBitmap = rImage.GetBitmap();
+    const Size aSize = aBitmap.GetSizePixel();
+    return aBitmap.GetPixelColor(aSize.Width() / 2, aSize.Height() / 2);
+}
+
+void setIconTheme(const OUString& rTheme)
+{
+    AllSettings aSettings = Application::GetSettings();
+    StyleSettings aStyle = aSettings.GetStyleSettings();
+    aStyle.SetIconTheme(rTheme);
+    aSettings.SetStyleSettings(aStyle);
+    Application::SetSettings(aSettings);
+}
+
+CPPUNIT_TEST_FIXTURE(MenuImagesTest, testCustomizedImagesWinOverLibreOfficeIcons)
+{
+    setIconTheme(u"hst_classic"_ustr);
+    loadFromURL(u"private:factory/swriter"_ustr);
+    SolarMutexGuard aGuard;
+    uno::Reference<frame::XModel> xModel(mxComponent, uno::UNO_QUERY_THROW);
+    uno::Reference<frame::XFrame> xFrame = xModel->getCurrentController()->getFrame();
+    const sal_Int16 nType = ui::ImageType::COLOR_NORMAL | ui::ImageType::SIZE_DEFAULT;
+    const OUString aUser(u".uno:SearchDialog"_ustr), aDocument(u".uno:Cut"_ustr),
+        aPlain(u".uno:Copy"_ustr);
+
+    // precondition: the HST style is active and Colibre draws the three commands
+    CPPUNIT_ASSERT_EQUAL(u"hst_classic"_ustr,
+                         Application::GetSettings().GetStyleSettings().DetermineIconTheme());
+    for (const OUString& rCommand : { aUser, aDocument, aPlain })
+        CPPUNIT_ASSERT(!!vcl::CommandInfoProvider::GetLibreOfficeMenuImage(rCommand));
+
+    // an uncustomized command shows LibreOffice's icon
+    CPPUNIT_ASSERT_EQUAL(centre(vcl::CommandInfoProvider::GetLibreOfficeMenuImage(aPlain)),
+                         centre(framework::GetMenuImageForCommand(aPlain, xFrame)));
+
+    // the user's own icon (module image manager, user layer)
+    uno::Reference<ui::XModuleUIConfigurationManagerSupplier> xModules
+        = ui::theModuleUIConfigurationManagerSupplier::get(m_xContext);
+    uno::Reference<ui::XImageManager> xModuleImages(
+        xModules->getUIConfigurationManager(u"com.sun.star.text.TextDocument"_ustr)->getImageManager(),
+        uno::UNO_QUERY_THROW);
+    xModuleImages->replaceImages(nType, { aUser }, { solid(COL_LIGHTMAGENTA) });
+    // the document's own icon
+    uno::Reference<ui::XUIConfigurationManagerSupplier> xSupplier(mxComponent, uno::UNO_QUERY_THROW);
+    uno::Reference<ui::XImageManager> xDocumentImages(
+        xSupplier->getUIConfigurationManager()->getImageManager(), uno::UNO_QUERY_THROW);
+    xDocumentImages->replaceImages(nType, { aDocument }, { solid(COL_LIGHTCYAN) });
+
+    const Color aUserColour = centre(framework::GetMenuImageForCommand(aUser, xFrame));
+    const Color aDocumentColour = centre(framework::GetMenuImageForCommand(aDocument, xFrame));
+    xModuleImages->removeImages(nType, { aUser });
+    xDocumentImages->removeImages(nType, { aDocument });
+    setIconTheme(OUString());
+
+    CPPUNIT_ASSERT_EQUAL(COL_LIGHTMAGENTA, aUserColour);
+    CPPUNIT_ASSERT_EQUAL(COL_LIGHTCYAN, aDocumentColour);
+}
+}
