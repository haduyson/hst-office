+bool ImageManagerImpl::hasUserImage( ::sal_Int16 nImageType, const OUString& aCommandURL )
+{
+    SolarMutexGuard g;
+
+    if ( m_bDisposed )
+        throw DisposedException();
+
+    auto nIndex = implts_convertImageTypeToIndex(nImageType);
+    if (!nIndex.has_value())
+        throw IllegalArgumentException();
+
+    ImageList* pImageList = implts_getUserImageList(std::get<0>(*nIndex));
+    return pImageList && pImageList->GetImagePos( aCommandURL ) != IMAGELIST_IMAGE_NOTFOUND;
+}
