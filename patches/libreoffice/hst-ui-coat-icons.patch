+void HstIconThemeTest::MenusUseLibreOfficeIcons()
+{
+    // every HST style takes the menu icons from the SVG Colibre of its brightness
+    CPPUNIT_ASSERT_EQUAL(u"colibre_svg"_ustr, vcl::hst::menuIconTheme(u"hst_classic"));
+    CPPUNIT_ASSERT_EQUAL(u"colibre_svg"_ustr, vcl::hst::menuIconTheme(u"hst_modern"));
+    CPPUNIT_ASSERT_EQUAL(u"colibre_svg"_ustr, vcl::hst::menuIconTheme(u"hst"));
+    CPPUNIT_ASSERT_EQUAL(u"colibre_dark_svg"_ustr, vcl::hst::menuIconTheme(u"hst_classic_dark"));
+    CPPUNIT_ASSERT_EQUAL(u"colibre_dark_svg"_ustr, vcl::hst::menuIconTheme(u"hst_modern_dark"));
+    // other themes keep their own menus
+    CPPUNIT_ASSERT(vcl::hst::menuIconTheme(u"colibre").isEmpty());
+    CPPUNIT_ASSERT(vcl::hst::menuIconTheme(u"breeze_dark").isEmpty());
+    CPPUNIT_ASSERT_EQUAL(u"cmd/sc_searchdialog.png"_ustr, vcl::hst::menuIconName(u".uno:SearchDialog"));
+    CPPUNIT_ASSERT(vcl::hst::menuIconName(u".uno:InsertField?Type:short=0").isEmpty());
+    CPPUNIT_ASSERT(vcl::hst::menuIconName(u"org.hst.office.vi:NumberToWords").isEmpty());
+    CPPUNIT_ASSERT(vcl::hst::menuIconName(u".uno:").isEmpty());
+}
+
 CPPUNIT_TEST_SUITE_REGISTRATION(HstIconThemeTest);
 
