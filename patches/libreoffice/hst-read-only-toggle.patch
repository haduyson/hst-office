--- a/fpicker/source/win32/VistaFilePickerImpl.cxx
+++ b/fpicker/source/win32/VistaFilePickerImpl.cxx
@@ -488,10 +488,55 @@ void VistaFilePickerImpl::impl_sta_InitDialog(Request& rRequest, DWORD nOrFlags)
 }
 
 
+namespace
+{
+enum class HstPickerKind
+{
+    Open,
+    Save,
+    Folder
+};
+
+/** HST Office: the system dialog draws its title, its OK button and the label of the name box in the language of
+    Windows, so an English Windows showed "Open", "Save As", "File name:" around a Vietnamese office. They are set
+    here in the UI language of the office; a title the caller sets later (Insert Image, Export...) replaces this one.
+    The Cancel button, the "Save as type:" label and the navigation pane have no interface and stay as Windows
+    draws them. */
+void lcl_hstSetUiLanguageTexts(const TFileDialog& iDialog, HstPickerKind eKind)
+{
+    if (!iDialog.is())
+        return;
+    OUString aTitle, aOk, aName;
+    switch (eKind)
+    {
+        case HstPickerKind::Open:
+            aTitle = FpsResId(STR_FILEDLG_OPEN);
+            aOk = aTitle;
+            aName = FpsResId(STR_HST_FILEDLG_FILE_NAME);
+            break;
+        case HstPickerKind::Save:
+            aTitle = FpsResId(STR_HST_FILEDLG_SAVE_AS);
+            aOk = FpsResId(STR_FILEDLG_SAVE);
+            aName = FpsResId(STR_HST_FILEDLG_FILE_NAME);
+            break;
+        case HstPickerKind::Folder:
+            aTitle = FpsResId(STR_SVT_FOLDERPICKER_DEFAULT_TITLE);
+            aOk = FpsResId(STR_HST_FILEDLG_SELECT_FOLDER);
+            aName = FpsResId(STR_HST_FILEDLG_FOLDER);
+            break;
+    }
+    // the texts are only the dialog's looks: a failure leaves the Windows texts
+    iDialog->SetTitle(o3tl::toW(aTitle.getStr()));
+    iDialog->SetOkButtonLabel(o3tl::toW(SOfficeToWindowsLabel(aOk).getStr()));
+    iDialog->SetFileNameLabel(o3tl::toW(SOfficeToWindowsLabel(aName).getStr()));
+}
+}
