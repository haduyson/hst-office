@@ -356,6 +377,71 @@ CPPUNIT_TEST_FIXTURE(HstAutoSaveTest, testToggleIsPerSessionOnly)
     CPPUNIT_ASSERT_EQUAL(std::string("true"), wantsAutoSave());
     CPPUNIT_ASSERT_EQUAL(std::string("on"), toggleState());
