+
+CPPUNIT_TEST_FIXTURE(HstAutoSaveTest, testEditModeOpensTheFileForWriting)
+{
+    // opened read only (the "Read-only" box of the Open dialog), then "Edit Document"
+    const OUString aURL = makeWriterFile(u"edit.docx", u"MS Word 2007 XML"_ustr);
+    open(aURL, /*bReadOnly=*/true);
+    CPPUNIT_ASSERT(isReadOnly());
+    CPPUNIT_ASSERT(titleSaysReadOnly());
+    CPPUNIT_ASSERT_EQUAL(std::string("dimmed"), toggleState());
+
+    switchEditMode();
+    CPPUNIT_ASSERT(!isReadOnly());
+    CPPUNIT_ASSERT(!titleSaysReadOnly());
+    // AutoSave is back as for a document opened for editing, and Save writes the file in place
+    CPPUNIT_ASSERT_EQUAL(std::string("on"), toggleState());
+    CPPUNIT_ASSERT_EQUAL(std::string("true"), wantsAutoSave());
+    const std::string aBefore = fileBytes(aURL);
+    typeText(u" edited");
+    uno::Reference<frame::XStorable>(mxComponent, uno::UNO_QUERY_THROW)->store();
+    CPPUNIT_ASSERT(aBefore != fileBytes(aURL));
+
+    // and back to read only
+    switchEditMode();
+    CPPUNIT_ASSERT(isReadOnly());
+    CPPUNIT_ASSERT(titleSaysReadOnly());
+    CPPUNIT_ASSERT_EQUAL(std::string("dimmed"), toggleState());
+}
+
+CPPUNIT_TEST_FIXTURE(HstAutoSaveTest, testEditModeKeepsTheAutoSaveChoice)
+{
+    open(makeWriterFile(u"choice.docx", u"MS Word 2007 XML"_ustr));
+    clickToggle(); // the user turns AutoSave off for this document
+    CPPUNIT_ASSERT_EQUAL(std::string("off"), toggleState());
+    switchEditMode(u".uno:ReadOnlyDoc"_ustr); // the View tab's "Chỉ đọc": read only
+    CPPUNIT_ASSERT(isReadOnly());
+    CPPUNIT_ASSERT(titleSaysReadOnly());
+    switchEditMode(u".uno:ReadOnlyDoc"_ustr); // editing again
+    CPPUNIT_ASSERT(!isReadOnly());
+    CPPUNIT_ASSERT_EQUAL(std::string("off"), toggleState());
+}
+
+CPPUNIT_TEST_FIXTURE(HstAutoSaveTest, testEditModeOnAReadOnlyFile)
+{
+    // the read-only attribute of the file system (Windows Properties > Read-only, chmod a-w)
+    const OUString aURL = makeWriterFile(u"attribute.docx", u"MS Word 2007 XML"_ustr);
+    CPPUNIT_ASSERT_EQUAL(osl::FileBase::E_None,
+                         osl::File::setAttributes(aURL, osl_File_Attribute_OwnRead | osl_File_Attribute_GrpRead
+                                                            | osl_File_Attribute_OthRead));
+    loadFromURL(aURL); // as a double click: an explicit ReadOnly=false fails on a file that cannot be written
+    if (!isReadOnly())
+    {
+        // a user who may write every file (root) does not see the attribute: nothing to check
+        osl::File::setAttributes(aURL, osl_File_Attribute_OwnRead | osl_File_Attribute_OwnWrite);
+        return;
+    }
+    CPPUNIT_ASSERT(titleSaysReadOnly());
+    switchEditMode();
+    // editable (Save asks for another name), so the title no longer says read only; AutoSave cannot write the file
+    CPPUNIT_ASSERT(!isReadOnly());
+    CPPUNIT_ASSERT(!titleSaysReadOnly());
+    CPPUNIT_ASSERT_EQUAL(std::string("dimmed"), toggleState());
+    CPPUNIT_ASSERT_EQUAL(std::string("false"), wantsAutoSave());
+    closeDocument();
+    osl::File::setAttributes(aURL, osl_File_Attribute_OwnRead | osl_File_Attribute_OwnWrite);
+}
 }
 
