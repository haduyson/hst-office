+/* HST Office: a condition with relative references is evaluated through a temporary formula cell
+   per cell, and that cell compiled the formula's RPN again every time (pFormula1 holds no RPN). The
+   optimal row height pass after loading a workbook evaluates the conditions of every cell, so an
+   expression rule over a whole table compiled the same formula hundreds of thousands of times. The
+   RPN is now compiled once, into a copy that shares the code tokens with pFormula1 (in-place
+   reference updates stay visible; every place that drops pFCell1/2 drops the copy too). Only
+   formulas whose RPN cannot depend on the position: single references, values, operators and
+   functions; anything else (ranges, names, labels, table and external references) keeps the old
+   per-cell compilation. */
+static bool lcl_IsPositionIndependentCode( const ScTokenArray& rArr )
+{
+    for (const formula::FormulaToken* t : rArr.Tokens())
+    {
+        switch (t->GetType())
+        {
+            case formula::svByte:
+            case formula::svDouble:
+            case formula::svString:
+            case formula::svSingleRef:
+            case formula::svMissing:
+            case formula::svSep:
+            case formula::svJump:
+                break;
+            default:
+                return false;
+        }
+        switch (t->GetOpCode())
+        {
+            case ocName: case ocColRowName: case ocTableRef: case ocDBArea: case ocMacro:
+            case ocExternal: case ocDde: case ocWebservice:
+            case ocTableRefOpen: case ocTableRefClose: case ocTableRefItemAll:
+                return false;
+            default:
+                break;
+        }
+    }
+    return true;
+}
+
+const ScTokenArray& ScConditionEntry::GetRelCode( std::unique_ptr<ScTokenArray>& rCache,
+                                                  const ScTokenArray& rFormula, const ScAddress& rPos )
+{
+    if (!rCache)
+    {
+        rCache.reset(new ScTokenArray(rFormula));
+        if (rCache->GetLen() && !rCache->GetCodeLen() && rCache->GetCodeError() == FormulaError::NONE
+            && lcl_IsPositionIndependentCode(*rCache))
+        {
+            // the same compilation as ScFormulaCell's constructor does for every temporary cell
+            ScCompiler aComp(mrDoc, rPos, *rCache, formula::FormulaGrammar::GRAM_DEFAULT, true, false);
+            aComp.CompileTokenArray();
+        }
+    }
+    return rCache->GetCodeLen() ? *rCache : rFormula;
+}
