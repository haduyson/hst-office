+/* HST Office: may a conditional format of this pattern give the cell a style whose items change
+   the size GetNeededSize computes? Evaluating the conditions of every cell (GetCondResult) is the
+   largest part of the optimal row height pass after loading a workbook with conditional formats.
+   Only items GetNeededSize never reads from the conditional set count as harmless (font colour,
+   background, borders, shadow); the style's parents are included, as GetNeededSize searches them.
+   Colour scales, data bars and icon sets have no cell style. */
+static bool lcl_CondFormatMayChangeSize( const ScDocument& rDoc, SCTAB nTab, const ScPatternAttr& rPattern )
+{
+    const ScCondFormatIndexes& rIndex = rPattern.GetItem(ATTR_CONDITIONAL).GetCondFormatData();
+    if (rIndex.empty())
+        return false; // GetCondResult has nothing to evaluate either
+    const ScConditionalFormatList* pList = rDoc.GetCondFormList(nTab);
+    ScStyleSheetPool* pStylePool = rDoc.GetStyleSheetPool();
+    if (!pList || !pStylePool)
+        return true;
+    for (sal_uInt32 nKey : rIndex)
+    {
+        const ScConditionalFormat* pForm = pList->GetFormat(nKey);
+        if (!pForm)
+            continue;
+        for (size_t i = 0; i < pForm->size(); ++i)
+        {
+            const ScFormatEntry* pEntry = pForm->GetEntry(i);
+            OUString aStyle;
+            if (pEntry->GetType() == ScFormatEntry::Type::Condition
+                || pEntry->GetType() == ScFormatEntry::Type::ExtCondition)
+                aStyle = static_cast<const ScCondFormatEntry*>(pEntry)->GetStyle();
+            else if (pEntry->GetType() == ScFormatEntry::Type::Date)
+                aStyle = static_cast<const ScCondDateFormatEntry*>(pEntry)->GetStyleName();
+            else
+                continue;
+            if (aStyle.isEmpty())
+                continue;
+            SfxStyleSheetBase* pStyle = pStylePool->Find(aStyle, SfxStyleFamily::Para);
+            if (!pStyle)
+                continue; // GetCondResult treats a missing style like no condition
+            for (const SfxItemSet* pSet = &pStyle->GetItemSet(); pSet; pSet = pSet->GetParent())
+            {
+                for (SfxItemIter aIter(*pSet); !aIter.IsAtEnd(); aIter.NextItem())
+                {
+                    switch (aIter.GetCurWhich())
+                    {
+                        case ATTR_FONT_COLOR: case ATTR_BACKGROUND: case ATTR_BORDER:
+                        case ATTR_BORDER_TLBR: case ATTR_BORDER_BLTR: case ATTR_SHADOW:
+                            break;
+                        default:
+                            return true;
+                    }
+                }
+            }
+        }
+    }
+    return false;
+}
