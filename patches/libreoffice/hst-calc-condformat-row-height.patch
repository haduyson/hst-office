+CPPUNIT_TEST_FIXTURE(TestCondformat, testCondFormatRelativeExpressionCompiledOnce)
+{
+    // A relative expression is compiled once and then evaluated at many positions (optimal row
+    // heights evaluate every cell); each position must still see its own row.
+    m_pDoc->InsertTab(0, u"Test"_ustr);
+    for (SCROW nRow = 0; nRow < 20; ++nRow)
+        m_pDoc->SetValue(ScAddress(0, nRow, 0), 1.0); // the formatted cells themselves are not blank
+
+    ScConditionEntry aSingle(ScConditionMode::Direct, u"B1>9"_ustr, u""_ustr, *m_pDoc,
+                             ScAddress(0, 0, 0), u""_ustr, u""_ustr,
+                             formula::FormulaGrammar::GRAM_DEFAULT,
+                             formula::FormulaGrammar::GRAM_DEFAULT);
+    // a range reference keeps the per-cell compilation
+    ScConditionEntry aRange(ScConditionMode::Direct, u"SUM(B1:B2)>9"_ustr, u""_ustr, *m_pDoc,
+                            ScAddress(0, 0, 0), u""_ustr, u""_ustr,
+                            formula::FormulaGrammar::GRAM_DEFAULT,
+                            formula::FormulaGrammar::GRAM_DEFAULT);
+    for (SCROW nOffset : { 0, 5 })
+    {
+        // changed values are seen by the compiled code on the next evaluation
+        for (SCROW nRow = 0; nRow < 20; ++nRow)
+            m_pDoc->SetValue(ScAddress(1, nRow, 0), nRow + nOffset);
+        for (SCROW nRow = 0; nRow < 19; ++nRow)
+        {
+            ScRefCellValue aCell(*m_pDoc, ScAddress(0, nRow, 0));
+            CPPUNIT_ASSERT_EQUAL(nRow + nOffset > 9, aSingle.IsCellValid(aCell, ScAddress(0, nRow, 0)));
+            CPPUNIT_ASSERT_EQUAL(2 * (nRow + nOffset) + 1 > 9,
+                                 aRange.IsCellValid(aCell, ScAddress(0, nRow, 0)));
+        }
+    }
+
+    m_pDoc->DeleteTab(0);
+}
