+
+namespace vcl
+{
+namespace
+{
+PrintJobPanel::Host& lcl_host()
+{
+    static PrintJobPanel::Host aHost;
+    return aHost;
+}
+}
+
+void PrintJobPanel::SetHost(Host aHost) { lcl_host() = std::move(aHost); }
+
+bool PrintJobPanel::HandOver(const std::shared_ptr<PrinterController>& rxController)
+{
+    const Host& rHost = lcl_host();
+    if (!rHost || !rxController)
+        return false;
+    try
+    {
+        return rHost(rxController, rxController->getWindow());
+    }
+    catch (const std::exception& rException)
+    {
+        // the classic dialog then shows the job
+        SAL_WARN("vcl.print", "the print panel host failed: " << rException.what());
+        return false;
+    }
+}
+
+PrintJobPanel::PrintJobPanel(std::shared_ptr<PrinterController> xController)
+    : m_xController(std::move(xController))
+    , m_pParent(nullptr)
+    , m_bPending(true)
+{
+}
+
+PrintJobPanel::~PrintJobPanel()
+{
+    // the settings first: their preview must not ask the job for pages any more
+    m_xSettings.reset();
+    if (m_bPending)
+        Printer::CancelPrintJob(m_xController);
+}
+
+void PrintJobPanel::Show(weld::Container* pParent)
+{
+    DBG_ASSERT(pParent, "PrintJobPanel::Show: no container");
+    if (!pParent || !m_bPending)
+        return;
+    m_xSettings.reset(); // before the new one: both would sit in pParent
+    m_pParent = pParent;
+    m_xSettings = std::make_unique<PrintDialog>(pParent, m_xController->getWindow(), m_xController);
+    m_xSettings->setPanelHdls(LINK(this, PrintJobPanel, PrintHdl),
+                              LINK(this, PrintJobPanel, MoreOptionsHdl),
+                              LINK(this, PrintJobPanel, PageSetupHdl));
+}
+
+void PrintJobPanel::Print()
+{
+    if (!m_bPending)
+        return;
+    const bool bPrintToFile = m_xSettings && m_xSettings->isPrintToFile();
+    const bool bSingleJobs = m_xSettings && m_xSettings->isSingleJobs();
+    // the settings go first, as the dialog does before the job prints: no preview while printing
+    m_xSettings.reset();
+    m_bPending = false;
+    Printer::ResumePrintJob(m_xController, bPrintToFile, bSingleJobs);
+}
+
+bool PrintJobPanel::RunClassicDialog()
+{
+    if (!m_bPending)
+        return false;
+    auto xDialog = std::make_unique<PrintDialog>(m_xController->getWindow(), m_xController);
+    if (m_xSettings)
+        xDialog->takeSettings(*m_xSettings);
+    if (xDialog->run() == RET_OK)
+    {
+        const bool bPrintToFile = xDialog->isPrintToFile();
+        const bool bSingleJobs = xDialog->isSingleJobs();
+        xDialog.reset();
+        m_xSettings.reset();
+        m_bPending = false;
+        Printer::ResumePrintJob(m_xController, bPrintToFile, bSingleJobs);
+        return true;
+    }
+    // cancelled: the job keeps what the dialog set (the options of the application are values of
+    // the job), so the panel is made again from the job and gets the dialog's other choices
+    if (m_pParent)
+    {
+        Show(m_pParent);
+        if (m_xSettings)
+            m_xSettings->takeSettings(*xDialog);
+    }
+    return false;
+}
+
+void PrintJobPanel::Cancel()
+{
+    m_xSettings.reset();
+    if (!m_bPending)
+        return;
+    m_bPending = false;
+    Printer::CancelPrintJob(m_xController);
+}
+
+void PrintJobPanel::SetHdls(const Link<PrintJobPanel&, void>& rPrint,
+                            const Link<PrintJobPanel&, void>& rMoreOptions,
+                            const Link<PrintJobPanel&, void>& rPageSetup)
+{
+    m_aPrintHdl = rPrint;
+    m_aMoreOptionsHdl = rMoreOptions;
+    m_aPageSetupHdl = rPageSetup;
+}
+
+// The host acts on these after the click (it must not destroy the settings inside their handler).
+IMPL_LINK_NOARG(PrintJobPanel, PrintHdl, PrintDialog&, void) { m_aPrintHdl.Call(*this); }
+
+IMPL_LINK_NOARG(PrintJobPanel, MoreOptionsHdl, PrintDialog&, void)
+{
+    m_aMoreOptionsHdl.Call(*this);
+}
+
+IMPL_LINK_NOARG(PrintJobPanel, PageSetupHdl, PrintDialog&, void) { m_aPageSetupHdl.Call(*this); }
+}
