+void ToggleBackstage(const uno::Reference<frame::XFrame>& rxFrame)
+{
+    BackstageWindow* pBackstage = lcl_ensureBackstage(rxFrame);
+    if (!pBackstage)
+        return;
+    if (pBackstage->IsOpen())
+        pBackstage->Close();
+    else
+        pBackstage->Open();
 }
 
