+
+// HST Office: a print job that waits in the panel form of the print dialog (vcl::PrintJobPanel).
+
+#include <salinst.hxx>
+#include <svdata.hxx>
+
+#include <stdexcept>
+
+#include <com/sun/star/awt/Size.hpp>
+#include <com/sun/star/view/PrintableState.hpp>
+#include <comphelper/propertyvalue.hxx>
+#include <test/bootstrapfixture.hxx>
+#include <vcl/hstprintjobpanel.hxx>
+#include <vcl/print.hxx>
+#include <vcl/weld/Builder.hxx>
+#include <vcl/weld/Container.hxx>
+
+namespace
+{
+/// Three A4 pages; counts how often the job ended and how.
+class TestController final : public vcl::PrinterController
+{
+public:
+    explicit TestController(const VclPtr<Printer>& rPrinter)
+        : PrinterController(rPrinter, nullptr)
+    {
+    }
+    int getPageCount() const override { return 3; }
+    css::uno::Sequence<css::beans::PropertyValue> getPageParameters(int) const override
+    {
+        return { comphelper::makePropertyValue(u"PageSize"_ustr, css::awt::Size(21000, 29700)) };
+    }
+    void printPage(int) const override {}
+    // both: the base's are not exported, the vtable of this class must not need them
+    void jobStarted() override {}
+    void jobFinished(css::view::PrintableState eState) override
+    {
+        ++mnFinished;
+        meState = eState;
+    }
+
+    int mnFinished = 0;
+    css::view::PrintableState meState = css::view::PrintableState_JOB_STARTED;
+};
+
+class HstPrintJobPanelTest : public test::BootstrapFixture
+{
+public:
+    HstPrintJobPanelTest()
+        : BootstrapFixture(true, false)
+    {
+    }
+
+    void setUp() override
+    {
+        test::BootstrapFixture::setUp();
+        m_xBuilder = GetSalInstance()->CreateBuilder(
+            nullptr, m_directories.getURLFromSrc(u"vcl/qa/cppunit/data/"),
+            u"hstprintpanelhost.ui"_ustr);
+        m_xHost = m_xBuilder->weld_container(u"host"_ustr);
+    }
+
+    void tearDown() override
+    {
+        vcl::PrintJobPanel::SetHost({});
+        m_xHost.reset();
+        m_xBuilder.reset();
+        test::BootstrapFixture::tearDown();
+    }
+
+    static std::shared_ptr<TestController> makeJob()
+    {
+        return std::make_shared<TestController>(VclPtr<Printer>::Create());
+    }
+
+    void testDestructionCancels()
+    {
+        auto xJob = makeJob();
+        {
+            vcl::PrintJobPanel aPanel(xJob);
+            // every widget of the print dialog code is in the panel form (a missing id crashes)
+            aPanel.Show(m_xHost.get());
+            CPPUNIT_ASSERT(aPanel.IsPending());
+            CPPUNIT_ASSERT_EQUAL(0, xJob->mnFinished);
+            CPPUNIT_ASSERT_EQUAL(sal_Int32(3), sal_Int32(xJob->getFilteredPageCount()));
+        }
+        CPPUNIT_ASSERT_EQUAL(1, xJob->mnFinished);
+        CPPUNIT_ASSERT_EQUAL(css::view::PrintableState_JOB_ABORTED, xJob->meState);
+    }
+
+    void testCancelEndsOnce()
+    {
+        auto xJob = makeJob();
+        {
+            vcl::PrintJobPanel aPanel(xJob);
+            aPanel.Show(m_xHost.get());
+            aPanel.Show(m_xHost.get()); // made again in the same container (after the dialog)
+            aPanel.Cancel();
+            CPPUNIT_ASSERT(!aPanel.IsPending());
+            CPPUNIT_ASSERT_EQUAL(1, xJob->mnFinished);
+            aPanel.Print(); // an ended job does not print
+            aPanel.Cancel();
+        }
+        CPPUNIT_ASSERT_EQUAL(1, xJob->mnFinished);
+        CPPUNIT_ASSERT_EQUAL(css::view::PrintableState_JOB_ABORTED, xJob->meState);
+    }
+
+    void testHandOver()
+    {
+        auto xJob = makeJob();
+        // no host: the dialog shows the job
+        CPPUNIT_ASSERT(!vcl::PrintJobPanel::HandOver(xJob));
+
+        std::shared_ptr<vcl::PrinterController> xTaken;
+        vcl::PrintJobPanel::SetHost(
+            [&xTaken](const std::shared_ptr<vcl::PrinterController>& rxJob, weld::Window*)
+            {
+                xTaken = rxJob;
+                return true;
+            });
+        CPPUNIT_ASSERT(vcl::PrintJobPanel::HandOver(xJob));
+        CPPUNIT_ASSERT_EQUAL(static_cast<vcl::PrinterController*>(xJob.get()), xTaken.get());
+        CPPUNIT_ASSERT(!vcl::PrintJobPanel::HandOver(nullptr));
+        // handed over, the job waits for its panel; the panel ends it
+        CPPUNIT_ASSERT_EQUAL(0, xJob->mnFinished);
+        vcl::PrintJobPanel(xTaken).Cancel();
+        CPPUNIT_ASSERT_EQUAL(1, xJob->mnFinished);
+    }
+
+    void testHostDeclinesOrFails()
+    {
+        auto xJob = makeJob();
+        vcl::PrintJobPanel::SetHost(
+            [](const std::shared_ptr<vcl::PrinterController>&, weld::Window*) { return false; });
+        CPPUNIT_ASSERT(!vcl::PrintJobPanel::HandOver(xJob));
+        vcl::PrintJobPanel::SetHost(
+            [](const std::shared_ptr<vcl::PrinterController>&, weld::Window*) -> bool
+            { throw std::runtime_error("host failed"); });
+        CPPUNIT_ASSERT(!vcl::PrintJobPanel::HandOver(xJob));
+        CPPUNIT_ASSERT_EQUAL(0, xJob->mnFinished);
+    }
+
+    CPPUNIT_TEST_SUITE(HstPrintJobPanelTest);
+    CPPUNIT_TEST(testDestructionCancels);
+    CPPUNIT_TEST(testCancelEndsOnce);
+    CPPUNIT_TEST(testHandOver);
+    CPPUNIT_TEST(testHostDeclinesOrFails);
+    CPPUNIT_TEST_SUITE_END();
+
+private:
+    std::unique_ptr<weld::Builder> m_xBuilder;
+    std::unique_ptr<weld::Container> m_xHost;
+};
+}
+
+CPPUNIT_TEST_SUITE_REGISTRATION(HstPrintJobPanelTest);
+
+CPPUNIT_PLUGIN_IMPLEMENT();
