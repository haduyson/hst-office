+/* Print jobs with dialogs (File ▸ Print, Ctrl+P, the ribbon) of a document frame open the File
+   panel on its Print page instead of the print dialog (vcl::PrintJobPanel). Other jobs (no frame of
+   the four applications, LibreOfficeKit) keep the dialog. */
+bool lcl_takePrintJob(const std::shared_ptr<vcl::PrinterController>& rxController,
+                      weld::Window* pDocumentWindow)
+{
+    if (comphelper::LibreOfficeKit::isActive() || !rxController)
+        return false;
+    // the frame whose view started the job (with document tabs several frames share one window)
+    for (SfxViewFrame* pFrame = SfxViewFrame::GetFirst(); pFrame;
+         pFrame = SfxViewFrame::GetNext(*pFrame))
+    {
+        SfxViewShell* pShell = pFrame->GetViewShell();
+        if (!pShell || pShell->GetPrinterController() != rxController)
+            continue;
+        uno::Reference<frame::XFrame> xFrame = pFrame->GetFrame().GetFrameInterface();
+        vcl::Window* pContainer = lcl_containerWindow(xFrame);
+        if (!pContainer || pContainer->GetFrameWeld() != pDocumentWindow)
+            return false; // not shown in its own window (an embedded or hidden view)
+        BackstageWindow* pBackstage = lcl_ensureBackstage(xFrame);
+        return pBackstage && pBackstage->ShowPrintJob(rxController);
+    }
+    return false;
+}
+}
