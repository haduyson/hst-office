+namespace sfx2::hst
+{
+/* HST Office: the Print page ("In") of the File panel.
+
+   The page shows a real print job of the document: the print dialog's settings and preview in
+   their panel form (vcl::PrintJobPanel), so the options, the preview and the printout are the
+   ones of File ▸ Print. A job reaches the page in two ways, both through the print command:
+   - the page is shown (its item in the left column): it runs .uno:Print for the frame;
+   - .uno:Print runs elsewhere (Ctrl+P, the ribbon, the menu): vcl hands the job to the File panel
+     (see TakePrintJob in hstbackstage.cxx), which opens on this page.
+   The job waits until the big Print button prints it, "More Options..." gives it to the classic
+   dialog, or the page goes away (another page, the panel closes): then it is cancelled, as the
+   dialog's Cancel would. "Page Setup..." cancels it and opens the page style dialog. */
+class BackstagePrintPage final
+{
+public:
+    /// rClosePanel closes the File panel; rShowPage opens it on this page.
+    BackstagePrintPage(weld::Builder& rBuilder, css::uno::Reference<css::frame::XFrame> xFrame,
+                       BackstageApp eApp, std::function<void()> aClosePanel,
+                       std::function<void()> aShowPage);
+    ~BackstagePrintPage();
+    BackstagePrintPage(const BackstagePrintPage&) = delete;
+    BackstagePrintPage& operator=(const BackstagePrintPage&) = delete;
+
+    /// The page is shown: without a job, ask the frame for one.
+    void Activate();
+    /// The page is left or the panel closed: cancel the waiting job.
+    void Deactivate();
+    /// A job of this frame that vcl hands over; the caller shows the page next.
+    void TakeJob(const std::shared_ptr<vcl::PrinterController>& rxController);
+    bool HasJob() const { return bool(m_xJob); }
+    /// Focus the print button (or the page while it waits for the job).
+    void GrabFocus();
+
+private:
+    enum class Action
+    {
+        RequestJob,
+        Print,
+        MoreOptions,
+        PageSetup
+    };
+    /// Run eAction after the current event (a click must not destroy the widget it came from).
+    void Post(Action eAction);
+    void Run(Action eAction);
+    void ShowWaiting(bool bWaiting);
+
+    DECL_LINK(PrintHdl, vcl::PrintJobPanel&, void);
+    DECL_LINK(MoreOptionsHdl, vcl::PrintJobPanel&, void);
+    DECL_LINK(PageSetupHdl, vcl::PrintJobPanel&, void);
+    DECL_LINK(ActionHdl, void*, void);
+
+    css::uno::Reference<css::frame::XFrame> m_xFrame;
+    BackstageApp m_eApp;
