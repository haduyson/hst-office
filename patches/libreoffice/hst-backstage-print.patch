+/* HST Office: a print job that waits in a page of the application (the Print page of the File
+   panel) instead of in the print dialog.
+
+   When a print job with dialogs starts (File ▸ Print, Ctrl+P), vcl asks the host set with
+   SetHost() first; a host that takes the job wraps it in a PrintJobPanel. The panel shows the
+   settings and the preview of the print dialog (the same code, controls and options, see
+   vcl::PrintDialog) in a container of the host, and the job waits until the panel prints it, the
+   classic dialog prints it, or the panel goes away (which cancels it). The printout is the one of
+   the dialog: Print() ends the job as the dialog's Print button would. */
+class VCL_DLLPUBLIC PrintJobPanel final
+{
+public:
+    /// Takes a job: called with the job and the window of its document; true when taken (the host
+    /// then owns a PrintJobPanel made for the job), false to show the classic dialog.
+    using Host = std::function<bool(const std::shared_ptr<PrinterController>&, weld::Window*)>;
+    static void SetHost(Host aHost);
+    /// Offer a job to the host (Printer::PreparePrintJob does, in place of the dialog); true when
+    /// it took it. A host that throws takes nothing.
+    static bool HandOver(const std::shared_ptr<PrinterController>& rxController);
+
+    explicit PrintJobPanel(std::shared_ptr<PrinterController> xController);
+    ~PrintJobPanel(); ///< cancels the job unless it ended
+    PrintJobPanel(const PrintJobPanel&) = delete;
+    PrintJobPanel& operator=(const PrintJobPanel&) = delete;
+
+    /// Show the settings and the preview in pParent, which must outlive this panel.
+    void Show(weld::Container* pParent);
+
+    /// Print with the shown settings; ends the job.
+    void Print();
+    /// The classic print dialog for this job, with the panel's choices. True when it printed (the
+    /// job ended); false when it was cancelled: the job waits and the panel shows the dialog's
+    /// choices (the options of the application went to the job already).
+    bool RunClassicDialog();
+    /// End the job without printing.
+    void Cancel();
+    bool IsPending() const { return m_bPending; }
+
+    /// The print button of the panel, its "More Options..." and "Page Setup..." links.
+    void SetHdls(const Link<PrintJobPanel&, void>& rPrint,
+                 const Link<PrintJobPanel&, void>& rMoreOptions,
+                 const Link<PrintJobPanel&, void>& rPageSetup);
+
+private:
+    DECL_LINK(PrintHdl, PrintDialog&, void);
+    DECL_LINK(MoreOptionsHdl, PrintDialog&, void);
+    DECL_LINK(PageSetupHdl, PrintDialog&, void);
+
+    std::shared_ptr<PrinterController> m_xController;
+    weld::Container* m_pParent;
+    std::unique_ptr<PrintDialog> m_xSettings; ///< the panel form of the print dialog, when shown
+    bool m_bPending;
+    Link<PrintJobPanel&, void> m_aPrintHdl;
+    Link<PrintJobPanel&, void> m_aMoreOptionsHdl;
+    Link<PrintJobPanel&, void> m_aPageSetupHdl;
+};
+}
