+
+void PrintDialog::takeSettings(const PrintDialog& rOther)
+{
+    // the printer (the controller has it, but not whether it prints to a file)
+    if (rOther.isPrintToFile() != isPrintToFile()
+        || rOther.mxPrinters->get_active_text() != mxPrinters->get_active_text())
+    {
+        mxPrinters->set_active(rOther.mxPrinters->get_active());
+        SelectPrinterHdl(*mxPrinters);
+    }
+    if (mxPaperSizeBox->get_sensitive()
+        && mxPaperSizeBox->find_text(rOther.mxPaperSizeBox->get_active_text()) != -1)
+    {
+        mxPaperSizeBox->set_active_text(rOther.mxPaperSizeBox->get_active_text());
+        SelectPaperSizeHdl(*mxPaperSizeBox);
+    }
+    if (mxOrientationBox->get_sensitive())
+    {
+        mxOrientationBox->set_active(rOther.mxOrientationBox->get_active());
+        SelectOrientationHdl(*mxOrientationBox);
+    }
+    if (mxPaperSidesBox->get_sensitive())
+    {
+        mxPaperSidesBox->set_active(rOther.mxPaperSidesBox->get_active());
+        SelectPaperSidesHdl(*mxPaperSidesBox);
+    }
+    mxCopyCountField->set_value(rOther.mxCopyCountField->get_value());
+    SpinModifyHdl(*mxCopyCountField);
+    mxCollateBox->set_active(rOther.mxCollateBox->get_active());
+    ToggleCollateHdl(*mxCollateBox);
+    if (mxNupPagesBox->get_sensitive())
+    {
+        mxNupRowsEdt->set_value(rOther.mxNupRowsEdt->get_value());
+        mxNupColEdt->set_value(rOther.mxNupColEdt->get_value());
+        mxNupPagesBox->set_active(rOther.mxNupPagesBox->get_active());
+        SelectNupPagesHdl(*mxNupPagesBox);
+    }
+    schedulePreviewUpdate(false);
+}
+
+IMPL_LINK(PrintDialog, ClickPanelHdl, weld::Button&, rButton, void)
+{
+    if (&rButton == mxMoreOptionsBtn.get())
+        maPanelMoreOptionsHdl.Call(*this);
+    else if (&rButton == mxPageSetupBtn.get())
+        maPanelPageSetupHdl.Call(*this);
+    else if (&rButton == mxZoomFitBtn.get())
+        setZoom(0);
+    else
+    {
+        // from the fitted page, the steps start at the zoom it shows
+        const int nCurrent = mnZoom > 0 ? mnZoom : mxPreview->getFitPercent();
+        const int nStep = &rButton == mxZoomInBtn.get() ? PANEL_ZOOM_STEP : -PANEL_ZOOM_STEP;
+        setZoom(std::clamp((nCurrent + nStep) / PANEL_ZOOM_STEP * PANEL_ZOOM_STEP, PANEL_ZOOM_MIN,
+                           PANEL_ZOOM_MAX));
+    }
+}
+
+IMPL_LINK_NOARG(PrintDialog, ZoomScaleHdl, weld::Scale&, void)
+{
+    setZoom(mxZoomScale->get_value());
+}
+
+void PrintDialog::setZoom(int nPercent)
+{
+    // 0: the whole page fits the preview area (no scroll bars, the drawing area fills it);
+    // otherwise the page at nPercent of its real size, scrolled in the area
+    mnZoom = nPercent;
+    mxPreview->setZoomed(nPercent > 0);
+    const VclPolicyType ePolicy = nPercent > 0 ? VclPolicyType::AUTOMATIC : VclPolicyType::NEVER;
+    mxPreviewScroll->set_hpolicy(ePolicy);
+    mxPreviewScroll->set_vpolicy(ePolicy);
+    const Size aSize(nPercent > 0 ? mxPreview->getZoomedSize(nPercent) : Size(-1, -1));
+    mxPreviewWindow->set_size_request(aSize.Width(), aSize.Height());
+    updateZoomText();
+}
+
+void PrintDialog::updateZoomText()
+{
+    if (!mxZoomText || !mxZoomScale)
+        return;
+    const int nShown = mnZoom > 0 ? mnZoom : mxPreview->getFitPercent();
+    mxZoomScale->set_value(nShown);
+    mxZoomText->set_label(OUString::number(nShown) + "%");
+}
