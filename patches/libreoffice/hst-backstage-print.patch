+/// What the print dialog (or panel) adds to the job when it is confirmed: the output file (which
+/// the user picks now) or one job per copy. False when no file was picked: the job is aborted.
+bool lcl_applyDialogResult(const std::shared_ptr<PrinterController>& xController, bool bPrintToFile,
+                           bool bSingleJobs)
+{
+    if (bPrintToFile)
+    {
+        OUString aJobName;
+        css::beans::PropertyValue* pJobNameVal = xController->getValue( u"JobName"_ustr );
+        if( pJobNameVal )
+            pJobNameVal->Value >>= aJobName;
+        OUString aFile = queryFile( xController->getPrinter().get(), aJobName );
+        if( aFile.isEmpty() )
+        {
+            xController->abortJob();
+            return false;
+        }
+        xController->setValue( u"LocalFileName"_ustr,
+                               css::uno::Any( aFile ) );
+    }
+    else if (bSingleJobs)
+    {
+        xController->getPrinter()->SetSinglePrintJobs(true);
+    }
+    return true;
+}
