@@ -0,0 +1,178 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This file is part of HST Office, based on LibreOffice.
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+#include "hstbackstageprint.hxx"
+
+#include <utility>
+
+#include <comphelper/dispatchcommand.hxx>
+#include <sal/log.hxx>
+#include <vcl/hstprintjobpanel.hxx>
+#include <vcl/svapp.hxx>
+
+using namespace css;
+
+namespace sfx2::hst
+{
+namespace
+{
+/// The page style dialog of the application: margins, paper size and orientation.
+OUString lcl_pageSetupCommand(BackstageApp eApp)
+{
+    switch (eApp)
+    {
+        case BackstageApp::Writer:
+            return u".uno:PageDialog"_ustr;
+        case BackstageApp::Calc:
+            return u".uno:PageFormatDialog"_ustr;
+        case BackstageApp::Impress:
+        case BackstageApp::Draw:
+            return u".uno:PageSetup"_ustr;
+        case BackstageApp::Other:
+            break;
+    }
+    return OUString();
+}
+}
+
+BackstagePrintPage::BackstagePrintPage(weld::Builder& rBuilder, uno::Reference<frame::XFrame> xFrame,
+                                       BackstageApp eApp, std::function<void()> aClosePanel,
+                                       std::function<void()> aShowPage)
+    : m_xFrame(std::move(xFrame))
+    , m_eApp(eApp)
+    , m_aClosePanel(std::move(aClosePanel))
+    , m_aShowPage(std::move(aShowPage))
+    , m_xHost(rBuilder.weld_container(u"printhost"_ustr))
+    , m_xWaiting(rBuilder.weld_label(u"printwait"_ustr))
+    , m_bRequested(false)
+    , m_pEvent(nullptr)
+    , m_ePosted(Action::RequestJob)
+{
+}
+
+BackstagePrintPage::~BackstagePrintPage()
+{
+    if (m_pEvent)
+        Application::RemoveUserEvent(m_pEvent);
+    m_xJob.reset(); // cancels a waiting job
+}
+
+void BackstagePrintPage::Activate()
+{
+    if (m_xJob || m_bRequested)
+        return;
+    m_bRequested = true;
+    ShowWaiting(true);
+    Post(Action::RequestJob);
+}
+
+void BackstagePrintPage::Deactivate()
+{
+    if (m_pEvent)
+    {
+        Application::RemoveUserEvent(m_pEvent);
+        m_pEvent = nullptr;
+    }
+    m_bRequested = false;
+    m_xJob.reset(); // cancels the job, like the Cancel button of the print dialog
+    ShowWaiting(false);
+}
+
+void BackstagePrintPage::TakeJob(const std::shared_ptr<vcl::PrinterController>& rxController)
+{
+    m_bRequested = false;
+    m_xJob.reset(); // an older job (should not happen: the print command waits for it)
+    m_xJob = std::make_unique<vcl::PrintJobPanel>(rxController);
+    m_xJob->SetHdls(LINK(this, BackstagePrintPage, PrintHdl),
+                    LINK(this, BackstagePrintPage, MoreOptionsHdl),
+                    LINK(this, BackstagePrintPage, PageSetupHdl));
+    ShowWaiting(false);
+    m_xJob->Show(m_xHost.get());
+}
+
+void BackstagePrintPage::GrabFocus()
+{
+    if (m_xJob)
+        m_xHost->child_grab_focus();
+}
+
+void BackstagePrintPage::ShowWaiting(bool bWaiting)
+{
+    m_xWaiting->set_visible(bWaiting);
+    m_xHost->set_visible(!bWaiting);
+}
+
+void BackstagePrintPage::Post(Action eAction)
+{
+    if (m_pEvent)
+        Application::RemoveUserEvent(m_pEvent);
+    m_ePosted = eAction;
+    m_pEvent = Application::PostUserEvent(LINK(this, BackstagePrintPage, ActionHdl));
+}
+
+IMPL_LINK_NOARG(BackstagePrintPage, ActionHdl, void*, void)
+{
+    m_pEvent = nullptr;
+    Run(m_ePosted);
+}
+
+void BackstagePrintPage::Run(Action eAction)
+{
+    if (eAction == Action::RequestJob)
+    {
+        // the print command of the frame, as from the menu: vcl hands its job back (TakeJob)
+        if (!comphelper::dispatchCommand(u".uno:Print"_ustr, m_xFrame, {}))
+        {
+            SAL_WARN("sfx.backstage", "the document does not print");
+            Deactivate();
+        }
+        return;
+    }
+    // the job leaves the page before the panel closes (closing it cancels a job on the page)
+    std::unique_ptr<vcl::PrintJobPanel> xJob(std::move(m_xJob));
+    if (!xJob)
+        return;
+    if (eAction == Action::PageSetup)
+    {
+        // the page style changes the pages: this job ends, Ctrl+P makes a new one
+        xJob.reset();
+        m_aClosePanel();
+        const OUString aCommand = lcl_pageSetupCommand(m_eApp);
+        if (!aCommand.isEmpty())
+            comphelper::dispatchCommand(aCommand, m_xFrame, {});
+        return;
+    }
+    m_aClosePanel();
+    if (eAction == Action::Print)
+    {
+        xJob->Print();
+        return;
+    }
+    // "More Options...": the classic dialog for the same job; cancelled, it comes back here
+    if (!xJob->RunClassicDialog() && xJob->IsPending())
+    {
+        m_xJob = std::move(xJob);
+        m_aShowPage();
+    }
+}
+
+IMPL_LINK_NOARG(BackstagePrintPage, PrintHdl, vcl::PrintJobPanel&, void) { Post(Action::Print); }
+
+IMPL_LINK_NOARG(BackstagePrintPage, MoreOptionsHdl, vcl::PrintJobPanel&, void)
+{
+    Post(Action::MoreOptions);
+}
+
+IMPL_LINK_NOARG(BackstagePrintPage, PageSetupHdl, vcl::PrintJobPanel&, void)
+{
+    Post(Action::PageSetup);
+}
+}
+
