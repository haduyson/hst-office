 ThemeColorsPaneWrapper::~ThemeColorsPaneWrapper() { disposeOnce(); }
 
-void ThemeColorsPaneWrapper::SetOptimalSize() { SetSizePixel(GetOptimalSize()); }
+namespace
+{
+// HST Office: on the ribbon, the gallery shows 6, 4 or 3 themes in a row (large, medium, small state) of
+// HST_ITEM_WIDTH px (the .ui's item-width plus its padding) and is never taller than HST_MAX_HEIGHT: the
+// Windows icon view asked for the height of every row, which made the Design tab taller than the others
+constexpr int HST_COLUMNS[] = { 6, 4, 3 };
+constexpr int HST_ITEM_WIDTH = 108;
+constexpr int HST_FRAME_WIDTH = 32; // margins, frame and the vertical scroll bar
+constexpr int HST_HEIGHT = 88; // the .ui's height-request: one row of themes with their names
+constexpr int HST_MAX_HEIGHT = 96;
+}
+
+void ThemeColorsPaneWrapper::SetOptimalSize()
+{
+    Size aSize = GetOptimalSize();
+    const tools::Long nMax = HST_MAX_HEIGHT * GetDPIScaleFactor();
+    if (aSize.Height() > nMax)
+        aSize.setHeight(nMax);
+    SetSizePixel(aSize);
+}
+
+void ThemeColorsPaneWrapper::HstApplyColumns()
+{
+    if (!m_xHstScroll)
+        return;
+    const double fScale = GetDPIScaleFactor();
+    m_xHstScroll->set_size_request(
+        (HST_COLUMNS[m_nHstState] * HST_ITEM_WIDTH + HST_FRAME_WIDTH) * fScale, HST_HEIGHT * fScale);
+}
+
+bool ThemeColorsPaneWrapper::set_property(const OUString& rKey, const OUString& rValue)
+{
+    if (rKey != "hst-gallery-state")
+        return InterimItemWindow::set_property(rKey, rValue);
+    const int nState = std::clamp<int>(rValue.toInt32(), 0, std::size(HST_COLUMNS) - 1);
+    if (nState == m_nHstState)
+        return false; // nothing changed: the ladder need not lay the toolbox out again
+    m_nHstState = nState;
+    HstApplyColumns();
+    SetOptimalSize();
+    return true;
+}
 
 void ThemeColorsPaneWrapper::refreshThemeColors() { initColorSets(); }
 
 void ThemeColorsPaneWrapper::dispose()
 {
+    m_xHstScroll.reset();
     mxIconViewThemeColors.reset();
     InterimItemWindow::dispose();
 }
