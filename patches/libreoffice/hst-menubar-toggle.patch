-        // Alt+letter: the tab with that letter, then its commands. Other Alt keys are shortcuts.
-        const char cLetter = rCode.IsMod2() && !rCode.IsMod1() && !rCode.IsShift() ? LetterOf(rCode) : 0;
+        const bool bMenubar = MenubarShown();
+        // F10 alone: the shown menu bar takes it (VCL and GTK select its first menu); without one it shows
+        // the tips, as in Office.
+        if (IsF10(rCode))
+        {
+            if (bMenubar)
+                return false;
+            ShowTabs();
+            return true;
+        }
+        // Alt+letter: the tab with that letter, then its commands. Other Alt keys are shortcuts. A shown
+        // menu bar keeps its mnemonics (Alt+T opens Tệp tin), so the letter goes on to it.
+        const char cLetter
+            = rCode.IsMod2() && !rCode.IsMod1() && !rCode.IsShift() && !bMenubar ? LetterOf(rCode) : 0;
         if (!cLetter || cLetter == 'F') // Alt+F has its own accelerator, the File view
             return false;
         ShowTabs();
