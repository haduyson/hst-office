+    /// Whether the classic menu bar of the window is shown (its toggle is in the View menu, the View tab and
+    /// the "≡" menu). Its Alt+letter mnemonics and F10 then belong to it; the ribbon keeps Alt alone.
+    bool MenubarShown() const
+    {
+        const SystemWindow* pSystem = m_xTabs ? m_xTabs->GetSystemWindow() : nullptr;
+        const MenuBar* pMenuBar = pSystem ? pSystem->GetMenuBar() : nullptr;
+        return pMenuBar && pMenuBar->IsDisplayable();
+    }
+
