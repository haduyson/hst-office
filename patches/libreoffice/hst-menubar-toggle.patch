+    /// F10 without modifiers; VCL delivers it as KEY_F10, or as KEY_MENU when it retries the key for a menu bar.
+    static bool IsF10(const vcl::KeyCode& rKey)
+    {
+        return (rKey.GetCode() == KEY_F10 || rKey.GetCode() == KEY_MENU) && !rKey.GetModifier();
+    }
+
     static char LetterOf(const vcl::KeyCode& rKey)
     {
         const sal_uInt16 nCode = rKey.GetCode();
@@ -420,8 +436,20 @@
 
     if (m_eLevel == Level::None)
