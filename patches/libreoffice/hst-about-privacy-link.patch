     , m_pWebsiteButton(m_xBuilder->weld_link_button(u"btnWebsite"_ustr))
     , m_pReleaseNotesButton(m_xBuilder->weld_link_button(u"btnReleaseNotes"_ustr))
+    , m_pPrivacyButton(m_xBuilder->weld_link_button(u"btnPrivacy"_ustr))
     , m_pCloseButton(m_xBuilder->weld_button(u"btnClose"_ustr))
     , m_pCopyButton(m_xBuilder->weld_button(u"btnCopyVersion"_ustr))
     , m_pBrandImage(m_xBuilder->weld_image(u"imBrand"_ustr))
@@ -123,6 +124,11 @@
                   + "?utm_source=hst-office&utm_medium=about&utm_campaign=hst-office-1-0");
     m_pWebsiteButton->set_uri(sURL);
 
+    // HST Office: privacy policy page, opened in the system browser only when clicked
+    // (same UTM convention as the website link; docs/PRIVACY.md).
+    m_pPrivacyButton->set_uri(u"https://office.hasontech.vn/quyen-rieng-tu/"
+                              "?utm_source=hst-office&utm_medium=about&utm_campaign=hst-office-1-0"_ustr);
+
     // HST Office: no Release Notes link (it would lead to a website outside the product).
     m_pReleaseNotesButton->hide();
 
