+
+#include <test/bootstrapfixture.hxx>
+
+#include <svx/ThemeColorsToolBoxControl.hxx>
+#include <vcl/wrkwin.hxx>
+
+namespace
+{
+class HstThemeGalleryColumnsTest : public test::BootstrapFixture
+{
+};
+
+// The ribbon's theme gallery shows 6, 4 or 3 themes in a row at its large, medium and small state. The vcl builder
+// used here (headless) is the one of Windows and macOS: it drops the .ui's scrolled window, so the gallery must
+// size its icon view instead, or it keeps the width of the large state at every state.
+CPPUNIT_TEST_FIXTURE(HstThemeGalleryColumnsTest, testColumnsFollowTheRibbonState)
+{
+    ScopedVclPtrInstance<WorkWindow> pParent(nullptr, WB_STDWORK);
+    VclPtr<ThemeColorsPaneWrapper> pGallery
+        = VclPtr<ThemeColorsPaneWrapper>::Create(pParent.get(), nullptr);
+    const tools::Long nLarge = pGallery->GetSizePixel().Width();
+    CPPUNIT_ASSERT(pGallery->set_property(u"hst-gallery-state"_ustr, u"1"_ustr));
+    const tools::Long nMedium = pGallery->GetSizePixel().Width();
+    CPPUNIT_ASSERT(pGallery->set_property(u"hst-gallery-state"_ustr, u"2"_ustr));
+    const tools::Long nSmall = pGallery->GetSizePixel().Width();
+    CPPUNIT_ASSERT_GREATER(nMedium, nLarge);
+    CPPUNIT_ASSERT_GREATER(nSmall, nMedium);
+    // 6 -> 4 columns is two theme widths narrower, 4 -> 3 one
+    CPPUNIT_ASSERT_EQUAL(2 * (nMedium - nSmall), nLarge - nMedium);
+    // back to the large state: the first width again
+    CPPUNIT_ASSERT(pGallery->set_property(u"hst-gallery-state"_ustr, u"0"_ustr));
+    CPPUNIT_ASSERT_EQUAL(nLarge, pGallery->GetSizePixel().Width());
+    pGallery.disposeAndClear();
+}
+}
+
+/* vim:set shiftwidth=4 softtabstop=4 expandtab: */
