@@ -144,11 +144,24 @@ void ThemeColorsPaneWrapper::SetOptimalSize()
 
 void ThemeColorsPaneWrapper::HstApplyColumns()
 {
-    if (!m_xHstScroll)
-        return;
     const double fScale = GetDPIScaleFactor();
-    m_xHstScroll->set_size_request(
-        (HST_COLUMNS[m_nHstState] * HST_ITEM_WIDTH + HST_FRAME_WIDTH) * fScale, HST_HEIGHT * fScale);
+    const int nColumns = HST_COLUMNS[m_nHstState];
+    if (m_xHstScroll)
+    {
+        m_xHstScroll->set_size_request((nColumns * HST_ITEM_WIDTH + HST_FRAME_WIDTH) * fScale,
+                                       HST_HEIGHT * fScale);
+        return;
+    }
+    if (!mxIconViewThemeColors)
+        return;
+    // The vcl builder (Windows, macOS, Qt, headless) drops the scrolled window, as the vcl icon view scrolls by
+    // itself, and the icon view lays out as many columns as its width holds: size the icon view for the columns,
+    // with its own item width (it grows to fit the theme previews and their names)
+    int nItemWidth = mxIconViewThemeColors->get_item_width();
+    if (nItemWidth <= 0)
+        nItemWidth = HST_ITEM_WIDTH * fScale;
+    mxIconViewThemeColors->set_size_request(nColumns * nItemWidth + HST_FRAME_WIDTH * fScale,
+                                            HST_HEIGHT * fScale);
 }
 
