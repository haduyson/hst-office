+// Written when "Use HST Office to open office documents" is ticked (HSTDEFAULTAPPS=1): the first
+// start does not ask again. Its own hidden module, so that only this key carries the condition.
+CONDITIONAL_MODULE_ENTRY(DefaultApps, gid_Module_Root)
+
+RegistryItem gid_Regitem_Software_Manufacturer_Productname_DefaultApps_ChosenAtInstall
+    ParentID = PREDEFINED_HKEY_LOCAL_MACHINE;
+    Subkey = "Software\%MANUFACTURER\%PRODUCTNAME\DefaultApps";
+    ModuleID = gid_Module_Root_Reg_DefaultApps;
+    Name = "ChosenAtInstall";
+    Value = "#1";
+    ComponentCondition = "HSTDEFAULTAPPS=1";
+End
