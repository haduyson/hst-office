+
+IMPL_LINK_NOARG(HstQuickAccess, PlainNewHdl, void*, void)
+{
+    m_pPlainEvent = nullptr;
+    if (m_xQat->isDisposed())
+        return;
+    for (ToolBox::ImplToolItems::size_type i = 0; i < m_xQat->GetItemCount(); ++i)
+    {
+        const ToolBoxItemId nId = m_xQat->GetItemId(i);
+        if (m_xQat->GetItemCommand(nId) == ".uno:AddDirect")
+            m_xQat->SetItemBits(nId, m_xQat->GetItemBits(nId) & ~ToolBoxItemBits::DROPDOWNONLY);
