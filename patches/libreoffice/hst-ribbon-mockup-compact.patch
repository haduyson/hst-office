+        auto aPop = rDev.ScopedPush(vcl::PushFlags::LINECOLOR);
+        rDev.SetLineColor(hst::ribbon::ownerDrawAllowed(rStyle) ? hst::ribbon::paletteFor(rStyle).aSeparator
