+        for (ImplToolItems::size_type i = 0; i < GetItemCount(); ++i)
+        {
+            if (GetItemType(i) != ToolBoxItemType::SEPARATOR)
+                continue;
+            const Point aMid = GetItemPosRect(i).Center();
+            rDev.DrawLine(Point(aMid.X(), aMid.Y() - nHalf), Point(aMid.X(), aMid.Y() + nHalf - 1));
+        }
+    }
 };
