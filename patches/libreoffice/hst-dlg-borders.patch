+short SwBorderDlg::Ok()
+{
+    const short nRet = SfxTabDialogController::Ok();
+    if (auto* pPageBorder = dynamic_cast<SwHstPageBorderPage*>(GetTabPage(u"hstpageborder")))
+        pPageBorder->Apply();
+    if (!m_xApplyBox->get_visible() || m_xApplyLB->get_active() != 1)
+        return nRet;
+
+    // Text: the same border and shading as character attributes, for w:bdr and w:shd on the run.
+    auto* pOut = const_cast<SfxItemSet*>(GetOutputItemSet());
+    if (!pOut)
+        return nRet;
+    SfxItemSet aChar(SfxItemSet::makeFixedSfxItemSet<RES_CHRATR_BOX, RES_CHRATR_BOX, RES_CHRATR_SHADOW,
+                                                     RES_CHRATR_SHADOW, RES_CHRATR_BACKGROUND,
+                                                     RES_CHRATR_BACKGROUND>(*pOut->GetPool()));
+    if (const SvxBoxItem* pBox = pOut->GetItemIfSet(RES_BOX, false))
+    {
+        SvxBoxItem aBox(*pBox);
+        aBox.SetWhich(RES_CHRATR_BOX);
+        aChar.Put(aBox);
+    }
+    if (const SvxShadowItem* pShadow = pOut->GetItemIfSet(RES_SHADOW, false))
+    {
+        SvxShadowItem aShadow(*pShadow);
+        aShadow.SetWhich(RES_CHRATR_SHADOW);
+        aChar.Put(aShadow);
+    }
+    if (const SvxBrushItem* pBrush = pOut->GetItemIfSet(RES_BACKGROUND, false))
+    {
+        SvxBrushItem aBrush(*pBrush);
+        aBrush.SetWhich(RES_CHRATR_BACKGROUND);
+        aChar.Put(aBrush);
+    }
+    pOut->ClearItem(RES_BOX);
+    pOut->ClearItem(RES_SHADOW);
+    pOut->ClearItem(RES_BACKGROUND);
+    pOut->ClearItem(SID_ATTR_BORDER_INNER);
+    if (aChar.Count())
+        m_pShell->SetAttrSet(aChar);
+    return nRet;
+}
 
