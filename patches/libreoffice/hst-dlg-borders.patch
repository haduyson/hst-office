+public:
+    SwHstPageBorderPage(weld::Container* pPage, weld::DialogController* pController, const SfxItemSet& rSet)
+        : SfxTabPage(pPage, pController, u"modules/swriter/ui/hstpageborderpage.ui"_ustr, u"HstPageBorderPage"_ustr, &rSet)
+        , m_xArea(m_xBuilder->weld_container(u"hstpageborderarea"_ustr))
+        , m_xApplyLB(m_xBuilder->weld_combo_box(u"hstpageapplyto"_ustr))
+        , m_aPageSet(SfxItemSet::makeFixedSfxItemSet<RES_BOX, RES_SHADOW, SID_ATTR_BORDER_INNER, SID_ATTR_BORDER_INNER>(*rSet.GetPool()))
+        , m_aOutSet(m_aPageSet)
+        , m_pShell(::GetActiveWrtShell())
+    {
+        m_aOutSet.ClearItem();
+        const SwPageDesc& rDesc = m_pShell->GetPageDesc(m_pShell->GetCurPageDesc());
+        const SwFrameFormat& rShown = !rDesc.IsFirstShared() && !rDesc.GetMaster().GetBox().GetTop()
+                                              && !rDesc.GetMaster().GetBox().GetLeft()
+                                          ? rDesc.GetFirstMaster()
+                                          : rDesc.GetMaster();
+        m_aPageSet.Put(rShown.GetFormatAttr(RES_BOX));
+        m_aPageSet.Put(rShown.GetFormatAttr(RES_SHADOW));
+        ::PrepareBoxInfo(m_aPageSet, *m_pShell);
+        SvxBoxInfoItem aInfo(m_aPageSet.Get(SID_ATTR_BORDER_INNER));
+        aInfo.SetTable(false);
+        aInfo.SetMinDist(false);
+        m_aPageSet.Put(aInfo);
+
+        SfxAbstractDialogFactory* pFact = SfxAbstractDialogFactory::Create();
+        m_xBorderPage = (*pFact->GetTabPageCreatorFunc(RID_SVXPAGE_BORDER))(m_xArea.get(), pController, &m_aPageSet);
+        SfxAllItemSet aModes(*rSet.GetPool());
+        aModes.Put(SfxUInt16Item(SID_SWMODE_TYPE, static_cast<sal_uInt16>(SwBorderModes::PARA)));
+        m_xBorderPage->PageCreated(aModes);
+        m_xBorderPage->Reset(&m_aPageSet);
+        // What the page style has now: a border on the first page only or on the others only.
+        const SwPageDesc& rCurrent = m_pShell->GetPageDesc(m_pShell->GetCurPageDesc());
+        const auto lcl_HasBorder = [](const SwFrameFormat& rFormat) {
+            const SvxBoxItem& rItem = rFormat.GetBox();
+            return rItem.GetTop() || rItem.GetBottom() || rItem.GetLeft() || rItem.GetRight();
+        };
+        const bool bMaster = lcl_HasBorder(rCurrent.GetMaster());
+        const bool bFirst = lcl_HasBorder(rCurrent.GetFirstMaster());
+        m_xApplyLB->set_active(rCurrent.IsFirstShared() || bMaster == bFirst ? 1 : bFirst ? 2 : 3);
+        m_xApplyLB->save_value();
+    }
+
+    static std::unique_ptr<SfxTabPage> Create(weld::Container* pPage, weld::DialogController* pController, const SfxItemSet* pSet)
+    {
+        return std::make_unique<SwHstPageBorderPage>(pPage, pController, *pSet);
+    }
+
+    virtual void Reset(const SfxItemSet*) override {}
+
+    // Nothing for the dialog's set, whose RES_BOX belongs to the selection.
+    virtual bool FillItemSet(SfxItemSet*) override
+    {
+        m_aOutSet.ClearItem();
+        m_xBorderPage->FillItemSet(&m_aOutSet);
+        return false;
+    }
+
+    /// Word's Apply to: 0 Whole document, 1 This section, 2 First page only, 3 All except first page.
+    /// A section here is a page style, which is what a Word section becomes on import.
+    void Apply()
+    {
+        const SvxBoxItem* pBox = m_aOutSet.GetItemIfSet(RES_BOX, false);
+        const SvxShadowItem* pShadow = m_aOutSet.GetItemIfSet(RES_SHADOW, false);
+        const int nApply = m_xApplyLB->get_active();
+        if (!pBox && !pShadow && !m_xApplyLB->get_value_changed_from_saved())
+            return;
+        const SvxBoxItem& rBox = pBox ? *pBox : m_aPageSet.Get(RES_BOX);
+        const SvxShadowItem& rShadow = pShadow ? *pShadow : m_aPageSet.Get(RES_SHADOW);
+        const size_t nCurrent = m_pShell->GetCurPageDesc();
+        m_pShell->StartUndo();
+        for (size_t n = 0; n < m_pShell->GetPageDescCnt(); ++n)
+        {
+            if (nApply != 0 && n != nCurrent)
+                continue;
+            SwPageDesc aDesc(m_pShell->GetPageDesc(n));
+            SwFrameFormat& rMaster = aDesc.GetMaster();
+            SwFrameFormat& rFirst = aDesc.GetFirstMaster();
+            rMaster.ResetFormatAttr(RES_BOX, RES_SHADOW);
+            rFirst.ResetFormatAttr(RES_BOX, RES_SHADOW);
+            // The first page's own format needs "different first page"; its header and footer
+            // content is copied from the other pages by SwDoc::ChgPageDesc.
+            if (nApply >= 2)
+                aDesc.ChgFirstShare(false);
+            std::map<OUString, css::uno::Any> aBag = rMaster.GetAttrSet().Get(RES_FRMATR_GRABBAG).GetGrabBag();
+            if (nApply >= 2)
+                aBag[u"hstBorderApply"_ustr] <<= sal_Int32(nApply);
+            else
+                aBag.erase(u"hstBorderApply"_ustr);
+            rMaster.SetFormatAttr(SfxGrabBagItem(RES_FRMATR_GRABBAG, std::move(aBag)));
+            if (nApply != 2)
+            {
+                rMaster.SetFormatAttr(rBox);
+                rMaster.SetFormatAttr(rShadow);
+            }
+            if (nApply != 3)
+            {
+                rFirst.SetFormatAttr(rBox);
+                rFirst.SetFormatAttr(rShadow);
+            }
+            m_pShell->ChgPageDesc(n, aDesc);
+        }
+        m_pShell->EndUndo();
+    }
+};
+}
 
