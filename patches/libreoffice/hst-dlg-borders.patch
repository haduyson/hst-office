+/// The border page once more, on the current page style instead of the selection.
+class SwHstPageBorderPage final : public SfxTabPage
+{
+    std::unique_ptr<weld::Container> m_xArea;
+    std::unique_ptr<weld::ComboBox> m_xApplyLB;
+    SfxItemSet m_aPageSet;
+    SfxItemSet m_aOutSet;
+    std::unique_ptr<SfxTabPage> m_xBorderPage;
