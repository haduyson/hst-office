+
+Bitmap readPng(const sal_uInt8* pData, size_t nSize)
+{
+    // a read-only stream over the embedded bytes: SvMemoryStream takes a non-const buffer but never
+    // writes it in StreamMode::READ
+    SvMemoryStream aStream(const_cast<sal_uInt8*>(pData), nSize, StreamMode::READ);
+    vcl::PngImageReader aReader(aStream);
+    return aReader.read();
+}
+}
+
+Bitmap RenderSolutionLogo(int nIndex, tools::Long nSize)
+{
+    if (nIndex < 0 || nIndex >= static_cast<int>(std::size(LOGOS)) || nSize <= 0)
+        return Bitmap();
+    const Logo& rLogo = LOGOS[nIndex];
+    // the 1x image at its own size; any other size from the 2x image, scaled down
+    Bitmap aBitmap = readPng(rLogo.pSmall, rLogo.nSmall);
+    if (aBitmap.GetSizePixel() != Size(nSize, nSize))
+        aBitmap = readPng(rLogo.pLarge, rLogo.nLarge);
+    if (aBitmap.IsEmpty())
+        return aBitmap;
+    if (aBitmap.GetSizePixel() != Size(nSize, nSize))
+        aBitmap.Scale(Size(nSize, nSize), BmpScaleFlag::BestQuality);
+    return aBitmap;
+}
+
+Bitmap RenderAppIconRaster(std::string_view aName, tools::Long nSize)
+{
+    if (nSize <= 0)
+        return Bitmap();
+    // the smallest image shipped at least as large: its own pixels at a shipped size, scaled down
+    // otherwise (never up)
+    for (const AppRaster& rRaster : APP_RASTERS)
+    {
+        if (rRaster.aName != aName || rRaster.nSize < nSize)
+            continue;
+        Bitmap aBitmap = readPng(rRaster.pData, rRaster.nLen);
+        if (!aBitmap.IsEmpty() && aBitmap.GetSizePixel() != Size(nSize, nSize))
+            aBitmap.Scale(Size(nSize, nSize), BmpScaleFlag::BestQuality);
+        return aBitmap;
+    }
+    return Bitmap();
+}
+}
