+void HstStartCenterWindow::dispose()
+{
+    mpTimes->Cancel(); // no file times arrive after this
+    if (mpPendingEvent)
+    {
+        Application::RemoveUserEvent(mpPendingEvent);
+        mpPendingEvent = nullptr;
+    }
+    if (mxDropTarget.is() && mxDropListener.is())
+    {
+        try
+        {
+            mxDropTarget->removeDropTargetListener(mxDropListener);
+            mxDropTarget->setActive(false);
+        }
+        catch (const uno::Exception&)
+        {
+            TOOLS_WARN_EXCEPTION("sfx.startcenter", "drop target");
+        }
+    }
+    mxDropTarget.clear();
+    mxDropListener.clear();
+    mpAccExec.reset();
+
+    for (VclPtr<vcl::Window>& rWindow : maActionWindows)
+        rWindow.disposeAndClear();
+    maActionWindows.clear();
+    mxSearch.reset();
+    mxSearchHost.disposeAndClear();
+    mxCanvas.disposeAndClear();
+    vcl::Window::dispose();
+}
