+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * This file is part of HST Office.
+ */
+
+#pragma once
+
+#include <rtl/ustring.hxx>
+#include <tools/datetime.hxx>
+
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <vector>
+
+/* HST Office Start Center: the recent documents as the table and the pinned column show them.
+   The list itself comes from the profile's history (the same list, order and pinning as the
+   rest of the office); reading it touches no file on disk. The file times shown in the "Opened"
+   column are read on a worker thread, because a recent file on a slow or unreachable drive must
+   never hold up the start of the office. */
+namespace sfx2::hst::startcenter
+{
+struct RecentFile
+{
+    OUString aURL;
+    OUString aName; ///< file name with its extension
+    OUString aFolder; ///< name of the folder that holds the file
+    OUString aFolderURL;
+    OUString aFolderPath; ///< system path of that folder, for tooltips
+    OUString aIcon; ///< image id of the file type
+    OUString aFolded; ///< FoldForSearch(aName)
+    bool bPinned = false;
+    bool bReadOnly = false;
+};
+
+/** The recent documents, pinned ones first, each group in history order. */
+std::vector<RecentFile> LoadRecentFiles();
+
+/** Hands the modification times of files to the main thread. Start() reads them on a worker
+    thread; the callback then runs on the main thread with one DateTime per URL (empty when the
+    file could not be read), unless Cancel() was called first. */
+class RecentFileTimes
+{
+public:
+    using Callback = std::function<void(const std::vector<DateTime>&)>;
+
+    RecentFileTimes() = default;
+    ~RecentFileTimes() { Cancel(); }
+    RecentFileTimes(const RecentFileTimes&) = delete;
+    RecentFileTimes& operator=(const RecentFileTimes&) = delete;
+
+    void Start(std::vector<OUString> aURLs, Callback aCallback);
+    /** No callback runs after this returns (the worker itself is left to finish on its own). */
+    void Cancel();
+
+    struct Guard
+    {
+        std::mutex aMutex;
+        bool bCancelled = false;
+    };
+
+private:
+    std::shared_ptr<Guard> mpGuard;
+};
+}
+
