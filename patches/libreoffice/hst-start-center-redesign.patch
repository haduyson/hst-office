+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * This file is part of HST Office.
+ */
+
+// The painting of the Start Center canvas. The geometry comes from the Layout; the order is
+// background, left panel, centre (heading, search frame, tiles), Recent table, Pinned card.
+
+#include "hststartcentercanvas.hxx"
+
+#include "../backstage/hstbackstagedata.hxx"
+#include <startcenter/hststartcentericons.hxx>
+
+#include <vcl/hst/drawhelpers.hxx>
+
+#include <vcl/image.hxx>
+#include <vcl/rendercontext/AntialiasingFlags.hxx>
+#include <vcl/settings.hxx>
+
+namespace sfx2::hst::startcenter
+{
+namespace design = ::hst::design;
+using namespace ::hst::design;
+
+namespace
+{
+constexpr Glyph NAV_GLYPHS[NAV_COUNT] = { Glyph::Home,   Glyph::NewDocument, Glyph::Open,  Glyph::Unsaved,
+                                          Glyph::Recent, Glyph::Pinned,      Glyph::Update };
+constexpr AppIcon TILE_ICONS[TILE_COUNT] = { AppIcon::Writer, AppIcon::Sheets, AppIcon::Slides };
+
+tools::Rectangle centred(const tools::Rectangle& rIn, tools::Long nSize, tools::Long nLeft = -1)
+{
+    const tools::Long nX = nLeft >= 0 ? nLeft : rIn.Left() + (rIn.GetWidth() - nSize) / 2;
+    return tools::Rectangle(Point(nX, rIn.Top() + (rIn.GetHeight() - nSize) / 2), Size(nSize, nSize));
+}
+
+/** One line of text, shortened with an ellipsis to nMaxWidth, vertically centred on nCentreY. */
+void drawLine(vcl::RenderContext& rDev, tools::Long nX, tools::Long nCentreY, tools::Long nMaxWidth,
+              const OUString& rText, const Color& rColor)
+{
+    if (nMaxWidth <= 0 || rText.isEmpty())
+        return;
+    rDev.SetTextColor(rColor);
+    rDev.DrawText(Point(nX, nCentreY - rDev.GetTextHeight() / 2), rDev.GetEllipsisString(rText, nMaxWidth));
+}
+
+tools::Rectangle inset(const tools::Rectangle& rRect, tools::Long nDX, tools::Long nDY)
+{
+    return tools::Rectangle(rRect.Left() + nDX, rRect.Top() + nDY, rRect.Right() - nDX, rRect.Bottom() - nDY);
+}
+
+void hLine(vcl::RenderContext& rDev, tools::Long nX1, tools::Long nX2, tools::Long nY, const Color& rColor)
+{
+    rDev.SetLineColor(rColor);
+    rDev.DrawLine(Point(nX1, nY), Point(nX2, nY));
+}
+}
+
+void HstStartCenterCanvas::Paint(vcl::RenderContext& rDev, const tools::Rectangle& /*rRect*/)
+{
+    auto aPop = rDev.ScopedPush(vcl::PushFlags::ALL);
+    rDev.SetAntialiasing(AntialiasingFlags::Enable);
+    const tools::Rectangle aAll(Point(0, 0), GetOutputSizePixel());
+    DrawBackground(rDev, aAll, maPalette, maLayout.fScale);
+    PaintLeft(rDev);
+    PaintCentre(rDev);
+    PaintRecent(rDev);
+    if (maLayout.bShowRight)
+        PaintPinned(rDev);
+}
+
+bool HstStartCenterCanvas::ShowFocus(const Hit& rHit) const
+{
+    return mbKeyboardFocus && HasFocus() && maFocus == rHit;
+}
+
+void HstStartCenterCanvas::PaintLeft(vcl::RenderContext& rDev)
+{
+    const Layout& L = maLayout;
+    DrawSidePanel(rDev, L.aLeft, maPalette);
+    auto aClip = rDev.ScopedPush(vcl::PushFlags::CLIPREGION | vcl::PushFlags::FONT | vcl::PushFlags::TEXTCOLOR);
+    rDev.IntersectClipRegion(L.aLeft);
+
+    const Bitmap& rLogo = maLogo[maPalette.bDark ? 1 : 0];
+    if (!L.bCompact && !rLogo.IsEmpty())
+    {
+        const Size aLogo = rLogo.GetSizePixel();
+        rDev.DrawBitmap(Point(L.aLogo.Left(), L.aLogo.Top() + (L.aLogo.GetHeight() - aLogo.Height()) / 2), rLogo);
+    }
+
+    // the menu: a rounded pill for the selected item, a lighter one under the mouse
+    const tools::Long nGlyph = L.px(icon::Nav);
+    for (int i = 0; i < NAV_COUNT; ++i)
+    {
+        const tools::Rectangle& rItem = L.aNav[i];
+        const bool bSelected = i == maModel.nSelectedNav;
+        const Hit aHit{ Part::Nav, i };
+        if (bSelected || maHover == aHit)
+            DrawPill(rDev, rItem, maPalette, bSelected, L.fScale);
+        if (ShowFocus(aHit))
+            DrawFocusRing(rDev, rItem, L.px(radius::Control), maPalette, L.fScale);
+        const Color aInk = bSelected ? maPalette.aAccent : maPalette.aIcon;
+        const tools::Rectangle aGlyph = centred(rItem, nGlyph, L.bCompact ? -1 : rItem.Left() + L.px(space::M));
+        DrawGlyph(rDev, aGlyph, NAV_GLYPHS[i], aInk);
+        if (L.bCompact)
+            continue;
+        UseFont(rDev, bSelected ? design::type::NavSelected : design::type::Nav);
+        const tools::Long nTextX = aGlyph.Right() + L.px(space::M);
+        drawLine(rDev, nTextX, rItem.Center().Y(), rItem.Right() - nTextX - L.px(space::S), maTexts.aNav[i],
+                 bSelected ? maPalette.aAccent : maPalette.aText);
+    }
+    if (L.bCompact)
+        return;
+
+    hLine(rDev, L.aSeparator.Left(), L.aSeparator.Right(), L.aSeparator.Top(), maPalette.aCardBorder);
+
+    // the HASON TECH block: the banner (a child window in L.aBanner), the heading, the cards, the link
+    UseFont(rDev, design::type::Strong);
+    rDev.SetTextColor(maPalette.aText);
+    rDev.DrawText(L.aSolutionsTitle, maTexts.aSolutionsTitle,
+                  DrawTextFlags::Left | DrawTextFlags::Top | DrawTextFlags::WordBreak | DrawTextFlags::MultiLine);
+    for (int i = 0; i < SOLUTION_COUNT; ++i)
+    {
+        const tools::Rectangle& rCard = L.aSolutions[i];
+        const Hit aHit{ Part::Solution, i };
+        const bool bHover = maHover == aHit;
+        DrawRoundRect(rDev, rCard, L.px(radius::Control), bHover ? maPalette.aHover : maPalette.aCard,
+                      bHover ? maPalette.aAccent : maPalette.aCardBorder);
+        if (ShowFocus(aHit))
+            DrawFocusRing(rDev, rCard, L.px(radius::Control), maPalette, L.fScale);
+        const tools::Long nX = rCard.Left() + L.px(space::M);
+        const tools::Long nWidth = rCard.GetWidth() - L.px(space::XL);
+        UseFont(rDev, design::type::CardTitle);
+        const tools::Long nNameH = rDev.GetTextHeight();
+        drawLine(rDev, nX, rCard.Top() + L.px(space::S) + nNameH / 2, nWidth, maTexts.aSolutionName[i], maPalette.aText);
+        UseFont(rDev, design::type::Caption);
+        drawLine(rDev, nX, rCard.Top() + L.px(space::S) + nNameH + rDev.GetTextHeight() / 2, nWidth,
+                 maTexts.aSolutionTagline[i], maPalette.aMuted);
+    }
+    const Hit aMore{ Part::MoreSolutions, 0 };
+    vcl::Font aLink;
+    UseFont(rDev, design::type::Body);
+    if (maHover == aMore)
+    {
+        aLink = rDev.GetFont();
+        aLink.SetUnderline(LINESTYLE_SINGLE);
+        rDev.SetFont(aLink);
+    }
+    drawLine(rDev, L.aMore.Left() + L.px(space::XS), L.aMore.Center().Y(), L.aMore.GetWidth() - L.px(space::S),
+             maTexts.aMore, maPalette.aAccent);
+    if (ShowFocus(aMore))
+        DrawFocusRing(rDev, L.aMore, L.px(radius::Row), maPalette, L.fScale);
+
+    const tools::Rectangle aTrack = L.LeftScrollTrack();
+    if (!aTrack.IsEmpty())
+    {
+        // the thumb in proportion to the visible part of the column
+        const tools::Long nContent = std::max<tools::Long>(1, L.nLeftContent);
+        const tools::Long nThumb = std::max(L.px(space::XL), aTrack.GetHeight() * L.aLeft.GetHeight() / nContent);
+        const tools::Long nRange = std::max<tools::Long>(1, L.nLeftContent - L.aLeft.GetHeight());
+        const tools::Long nTop = aTrack.Top() + (aTrack.GetHeight() - nThumb) * L.nLeftScroll / nRange;
+        DrawRoundRect(rDev, tools::Rectangle(Point(aTrack.Left(), nTop), Size(aTrack.GetWidth(), nThumb)),
+                      aTrack.GetWidth() / 2.0, maPalette.aCardBorder, COL_TRANSPARENT);
+    }
+}
+
+void HstStartCenterCanvas::PaintCentre(vcl::RenderContext& rDev)
+{
+    const Layout& L = maLayout;
+    auto aPop = rDev.ScopedPush(vcl::PushFlags::FONT | vcl::PushFlags::TEXTCOLOR);
+    UseFont(rDev, design::type::Display);
+    drawLine(rDev, L.aWelcome.Left(), L.aWelcome.Center().Y(), L.aWelcome.GetWidth(), maTexts.aWelcome,
+             maPalette.aHeading);
+
+    // the search field's frame; the entry itself is a child window inside it
+    DrawRoundRect(rDev, L.aSearch, L.px(radius::Control), maPalette.aCard,
+                  mbSearchFocused ? maPalette.aAccent : maPalette.aCardBorder,
+                  mbSearchFocused ? FIELD_FOCUS_BORDER * L.fScale : 1.0);
+    DrawGlyph(rDev, L.aSearchIcon, Glyph::Search, maPalette.aMuted);
+
+    UseFont(rDev, design::type::Title);
+    drawLine(rDev, L.aQuickTitle.Left(), L.aQuickTitle.Center().Y(), L.aQuickTitle.GetWidth(),
+             maTexts.aQuickTitle, maPalette.aText);
+    for (int i = 0; i < TILE_COUNT; ++i)
+    {
+        const tools::Rectangle& rTile = L.aTiles[i];
+        const Hit aHit{ Part::Tile, i };
+        const bool bActive = maHover == aHit || maPressed == aHit;
+        DrawRoundRect(rDev, rTile, L.px(radius::Card), bActive ? maPalette.aTintHover[i] : maPalette.aTint[i],
+                      maPalette.aTintBorder[i]);
+        if (ShowFocus(aHit))
+            DrawFocusRing(rDev, rTile, L.px(radius::Card), maPalette, L.fScale);
+        const tools::Long nIcon = std::min(L.px(icon::Tile), rTile.GetHeight() - L.px(space::L));
+        const tools::Rectangle aIcon = centred(rTile, nIcon, rTile.Left() + L.px(space::L));
+        const Bitmap& rIcon = Icon(static_cast<int>(TILE_ICONS[i]), nIcon);
+        DrawBadge(rDev, aIcon, rIcon);
+        const tools::Long nChevron = L.px(icon::Chevron);
+        const tools::Rectangle aChevron = centred(rTile, nChevron, rTile.Right() - L.px(space::L) - nChevron);
+        DrawGlyph(rDev, aChevron, Glyph::Chevron, maPalette.aIcon);
+        UseFont(rDev, design::type::Subtitle);
+        const tools::Long nTextX = aIcon.Right() + L.px(space::M);
+        drawLine(rDev, nTextX, rTile.Center().Y(), aChevron.Left() - nTextX - L.px(space::S), maTexts.aTiles[i],
+                 maPalette.aText);
+    }
+
+    UseFont(rDev, design::type::Title);
+    drawLine(rDev, L.aRecentTitle.Left(), L.aRecentTitle.Center().Y(), L.aRecentTitle.GetWidth(),
+             maModel.bPinnedOnly ? maTexts.aPinnedTitle : maTexts.aRecentTitle, maPalette.aText);
+}
+
+void HstStartCenterCanvas::PaintFileIcon(vcl::RenderContext& rDev, const RecentFile& rFile,
+                                         const tools::Rectangle& rBox)
+{
+    const AppIcon eIcon = AppIconForURL(rFile.aURL);
+    if (eIcon != AppIcon::None)
+    {
+        const Bitmap& rIcon = Icon(static_cast<int>(eIcon), rBox.GetWidth());
+        if (!rIcon.IsEmpty())
+        {
+            DrawBadge(rDev, rBox, rIcon);
+            return;
+        }
+    }
+    // a file of no HST application: the icon theme's file type icon, at its own size
+    const Image aImage(StockImage::Yes, rFile.aIcon);
+    const Size aSize = aImage.GetSizePixel();
+    rDev.DrawImage(Point(rBox.Left() + (rBox.GetWidth() - aSize.Width()) / 2,
+                         rBox.Top() + (rBox.GetHeight() - aSize.Height()) / 2),
+                   aImage);
+}
+
+void HstStartCenterCanvas::PaintScrollBar(vcl::RenderContext& rDev, const tools::Rectangle& rTrack,
+                                          int nFirst, int nShown, int nTotal)
+{
+    if (rTrack.IsEmpty() || nTotal <= 0)
+        return;
+    const tools::Long nThumb = std::max(maLayout.px(space::XL), rTrack.GetHeight() * nShown / nTotal);
+    const int nRange = std::max(1, nTotal - nShown);
+    const tools::Long nTop = rTrack.Top() + (rTrack.GetHeight() - nThumb) * nFirst / nRange;
+    DrawRoundRect(rDev, tools::Rectangle(Point(rTrack.Left(), nTop), Size(rTrack.GetWidth(), nThumb)),
+                  rTrack.GetWidth() / 2.0, maPalette.aCardBorder, COL_TRANSPARENT);
+}
+
+void HstStartCenterCanvas::PaintRecent(vcl::RenderContext& rDev)
+{
+    const Layout& L = maLayout;
+    auto aPop = rDev.ScopedPush(vcl::PushFlags::FONT | vcl::PushFlags::TEXTCOLOR | vcl::PushFlags::CLIPREGION
+                                | vcl::PushFlags::LINECOLOR);
+    DrawCard(rDev, L.aRecentCard, maPalette, L.fScale);
+
+    UseFont(rDev, design::type::Label);
+    const tools::Long nHeaderY = L.aRecentHeader.Center().Y();
+    drawLine(rDev, L.nColIcon, nHeaderY, L.nColOpened - L.nColIcon - L.px(space::S), maTexts.aColName, maPalette.aText);
+    drawLine(rDev, L.nColOpened, nHeaderY, L.nColFolderIcon - L.nColOpened - L.px(space::S), maTexts.aColOpened,
+             maPalette.aText);
+    drawLine(rDev, L.nColFolderIcon, nHeaderY, L.nColPin - L.nColFolderIcon, maTexts.aColLocation,
+             maPalette.aText);
+    hLine(rDev, L.aRecentCard.Left() + 1, L.aRecentCard.Right() - 1, L.aRecentHeader.Bottom(),
+          maPalette.aCardBorder);
+
+    rDev.IntersectClipRegion(L.aRecentBody);
+    const int nRows = static_cast<int>(maModel.aRecent.size());
+    if (nRows == 0)
+    {
+        UseFont(rDev, design::type::Body);
+        rDev.SetTextColor(maPalette.aMuted);
+        OUString aText = maTexts.aRecentEmpty;
+        if (!maModel.aQuery.isEmpty() && !maModel.aFiles.empty())
+            aText = maTexts.aNoMatch.replaceFirst("%1", maModel.aQuery);
+        else if (maModel.bPinnedOnly)
+            aText = maTexts.aPinnedEmpty;
+        tools::Rectangle aText_(L.aRecentBody);
+        aText_.shrink(L.px(space::XL));
+        rDev.DrawText(aText_, aText, DrawTextFlags::Left | DrawTextFlags::Top | DrawTextFlags::WordBreak
+                                         | DrawTextFlags::MultiLine);
+        return;
+    }
+
+    const DateTime aNow(DateTime::SYSTEM);
+    const tools::Long nIcon = L.px(icon::Row);
+    const tools::Long nGlyph = L.px(icon::Action);
+    const int nLast = std::min(nRows, L.nRecentFirst + L.RecentVisibleRows() + 1);
+    for (int nRow = L.nRecentFirst; nRow < nLast; ++nRow)
+    {
+        const RecentFile& rFile = maModel.aFiles[maModel.aRecent[nRow]];
+        const tools::Rectangle aRow = L.RecentRow(nRow);
+        const Hit aHit{ Part::Recent, nRow };
+        const bool bRowHover = maHover.nIndex == nRow
+                               && (maHover.ePart == Part::Recent || maHover.ePart == Part::RecentPin
+                                   || maHover.ePart == Part::RecentMore);
+        tools::Rectangle aInset(aRow);
+        aInset = inset(aInset, L.px(space::S), L.px(space::XS));
+        if (bRowHover)
+            DrawRoundRect(rDev, aInset, L.px(radius::Row), maPalette.aHover, COL_TRANSPARENT);
+        if (ShowFocus(aHit))
+            DrawFocusRing(rDev, aInset, L.px(radius::Row), maPalette, L.fScale);
+        if (nRow + 1 < nRows)
+            hLine(rDev, L.nColIcon - L.px(space::XS), L.nColEnd - L.px(space::XS), aRow.Bottom(), maPalette.aSeparator);
+
+        const tools::Long nY = aRow.Center().Y();
+        PaintFileIcon(rDev, rFile, centred(aRow, nIcon, L.nColIcon));
+        UseFont(rDev, design::type::Body);
+        drawLine(rDev, L.nColName, nY, L.nColOpened - L.nColName - L.px(space::M), rFile.aName, maPalette.aText);
+        auto it = maModel.aTimes.find(rFile.aURL);
+        if (it != maModel.aTimes.end())
+            drawLine(rDev, L.nColOpened, nY, L.nColFolderIcon - L.nColOpened - L.px(space::S),
+                     sfx2::hst::FormatRecentDate(it->second, aNow), maPalette.aMuted);
+        DrawGlyph(rDev, centred(aRow, nGlyph, L.nColFolderIcon), Glyph::Open, maPalette.aIcon);
+        drawLine(rDev, L.nColFolder, nY, L.nColPin - L.nColFolder - L.px(space::S), rFile.aFolder, maPalette.aText);
+        const Hit aPin{ Part::RecentPin, nRow };
+        DrawGlyph(rDev, centred(L.RecentPin(nRow), nGlyph), Glyph::Pinned,
+                  rFile.bPinned || maHover == aPin ? maPalette.aAccent : maPalette.aIcon, rFile.bPinned);
+        DrawGlyph(rDev, centred(L.RecentMore(nRow), nGlyph), Glyph::More,
+                  maHover == Hit{ Part::RecentMore, nRow } ? maPalette.aAccent : maPalette.aIcon);
+    }
+    PaintScrollBar(rDev, L.RecentScrollTrack(), L.nRecentFirst, L.RecentVisibleRows(), nRows);
+}
+
+void HstStartCenterCanvas::PaintPinned(vcl::RenderContext& rDev)
+{
+    const Layout& L = maLayout;
+    auto aPop = rDev.ScopedPush(vcl::PushFlags::FONT | vcl::PushFlags::TEXTCOLOR | vcl::PushFlags::CLIPREGION
+                                | vcl::PushFlags::LINECOLOR);
+    DrawCard(rDev, L.aPinnedCard, maPalette, L.fScale);
+    UseFont(rDev, design::type::Title);
+    drawLine(rDev, L.aPinnedTitle.Left(), L.aPinnedTitle.Center().Y(), L.aPinnedTitle.GetWidth(),
+             maTexts.aPinnedTitle, maPalette.aText);
+
+    rDev.IntersectClipRegion(L.aPinnedBody);
+    const int nItems = static_cast<int>(maModel.aPinned.size());
+    if (nItems == 0)
+    {
+        UseFont(rDev, design::type::Body);
+        rDev.SetTextColor(maPalette.aMuted);
+        tools::Rectangle aText(L.aPinnedBody);
+        aText = inset(aText, L.px(space::XS), L.px(space::M));
+        rDev.DrawText(aText, maTexts.aPinnedEmpty, DrawTextFlags::Left | DrawTextFlags::Top
+                                                       | DrawTextFlags::WordBreak | DrawTextFlags::MultiLine);
+        return;
+    }
+    const tools::Long nIcon = L.px(icon::Row);
+    const int nLast = std::min(nItems, L.nPinnedFirst + L.PinnedVisibleItems() + 1);
+    for (int nItem = L.nPinnedFirst; nItem < nLast; ++nItem)
+    {
+        const RecentFile& rFile = maModel.aFiles[maModel.aPinned[nItem]];
+        const tools::Rectangle aItem = L.PinnedItem(nItem);
+        const Hit aHit{ Part::Pinned, nItem };
+        hLine(rDev, aItem.Left() + L.px(space::XS), aItem.Right() - L.px(space::XS), aItem.Top(), maPalette.aSeparator);
+        if (nItem + 1 == nItems)
+            hLine(rDev, aItem.Left() + L.px(space::XS), aItem.Right() - L.px(space::XS), aItem.Bottom(), maPalette.aSeparator);
+        tools::Rectangle aInset(aItem);
+        aInset = inset(aInset, L.px(space::XXS), L.px(space::XS));
+        if (maHover == aHit)
+            DrawRoundRect(rDev, aInset, L.px(radius::Row), maPalette.aHover, COL_TRANSPARENT);
+        if (ShowFocus(aHit))
+            DrawFocusRing(rDev, aInset, L.px(radius::Row), maPalette, L.fScale);
+
+        UseFont(rDev, design::type::Body);
+        const tools::Long nName = rDev.GetTextHeight();
+        UseFont(rDev, design::type::Caption);
+        const tools::Long nSmall = rDev.GetTextHeight();
+        const tools::Long nTop = aItem.Top() + (aItem.GetHeight() - nName - L.px(space::XS) - nSmall) / 2;
+        const tools::Long nX = aItem.Left() + L.px(space::S);
+        PaintFileIcon(rDev, rFile, tools::Rectangle(Point(nX, nTop + (nName - nIcon) / 2), Size(nIcon, nIcon)));
+        const tools::Long nTextX = nX + nIcon + L.px(space::M);
+        const tools::Long nWidth = aItem.Right() - nTextX - L.px(space::S);
+        UseFont(rDev, design::type::Body);
+        drawLine(rDev, nTextX, nTop + nName / 2, nWidth, rFile.aName, maPalette.aText);
+        const tools::Long nLine = nTop + nName + L.px(space::XS);
+        const tools::Long nGlyph = std::min(nSmall, L.px(icon::Caption));
+        DrawGlyph(rDev, tools::Rectangle(Point(nTextX, nLine + (nSmall - nGlyph) / 2), Size(nGlyph, nGlyph)),
+                  Glyph::Open, maPalette.aMuted);
+        UseFont(rDev, design::type::Caption);
+        const tools::Long nFolderX = nTextX + nGlyph + L.px(space::S);
+        drawLine(rDev, nFolderX, nLine + nSmall / 2, aItem.Right() - nFolderX - L.px(space::S), rFile.aFolder,
+                 maPalette.aMuted);
+    }
+    PaintScrollBar(rDev, L.PinnedScrollTrack(), L.nPinnedFirst, L.PinnedVisibleItems(), nItems);
+}
+}
