+CPPUNIT_TEST_FIXTURE(HstStartCenterTest, testPinPersists)
+{
+    openStartCenter();
+    CPPUNIT_ASSERT_EQUAL(sal_Int64(0), rows(u"Pinned files"));
+
+    // keyboard: find the file, Enter goes to it in the table, Space pins it
