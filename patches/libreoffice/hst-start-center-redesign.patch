diff --git a/include/vcl/hst/designtokens.hxx b/include/vcl/hst/designtokens.hxx
new file mode 100644
index 0000000..5479202
--- /dev/null
+++ b/include/vcl/hst/designtokens.hxx
@@ -0,0 +1,137 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * This file is part of HST Office.
+ */
+
+#pragma once
+
+#include <tools/color.hxx>
+#include <tools/fontenum.hxx>
+#include <vcl/dllapi.h>
+#include <vcl/font.hxx>
+
+class StyleSettings;
+
+/* The HST Office design tokens: every visual constant of the HST look in one place — the light and
+   dark palettes, the type scale, corner radii, spacing, the card shadow, the interaction states and
+   the icon sizes. Lengths are logical pixels (multiply by the window's DPI scale). Every HST surface
+   drawn in this style (the Start Center first) takes its values from here and its shapes from
+   <vcl/hst/drawhelpers.hxx>, so the surfaces stay alike and the look changes in one place. */
+namespace hst::design
+{
+/** The colour roles of the HST look. */
+struct Palette
+{
+    bool bDark = false;
+    Color aBackTop; ///< the window background gradient, top left ...
+    Color aBackBottom; ///< ... to bottom right
+    Color aWave; ///< the large soft curve of the background
+    Color aWaveLine; ///< its light edge
+    Color aSide; ///< a side panel, top ...
+    Color aSideBottom; ///< ... to bottom
+    Color aText;
+    Color aMuted; ///< secondary text: locations, dates, taglines, placeholders
+    Color aHeading; ///< display headings
+    Color aAccent; ///< selection, links, focus rings, an active toggle
+    Color aPill; ///< the selected item of a navigation list
+    Color aHover; ///< an item under the mouse
+    Color aPressed; ///< an item being pressed
+    Color aCard; ///< cards and input fields
+    Color aCardBorder;
+    Color aSeparator; ///< lines between rows
+    Color aIcon; ///< outline glyphs
+    Color aLogoTile; ///< behind a brand logo on a dark card, so dark artwork stays legible (light: none)
+    Color aShadow; ///< the card shadow's colour (see SHADOW_OPACITY)
+    /** Tinted surfaces (the quick-create tiles): fill, border and hover per tint. */
+    Color aTint[3];
+    Color aTintBorder[3];
+    Color aTintHover[3];
+};
+
+/** The tints, in the order of the tiles: documents, spreadsheets, presentations. */
+enum class Tint
+{
+    Blue,
+    Green,
+    Orange,
+};
+
+/** Whether the theme of rStyle is dark (its window colour is). */
+VCL_DLLPUBLIC bool IsDark(const StyleSettings& rStyle);
+VCL_DLLPUBLIC const Palette& GetPalette(bool bDark);
+inline const Palette& GetPalette(const StyleSettings& rStyle) { return GetPalette(IsDark(rStyle)); }
+
+/** A step of the type scale: a size relative to the application font and a weight. */
+struct TypeStyle
+{
+    double fScale;
+    FontWeight eWeight;
+};
+
+namespace type
+{
+constexpr TypeStyle Display{ 2.75, WEIGHT_ULTRABOLD }; ///< the welcome heading
+constexpr TypeStyle Title{ 1.32, WEIGHT_BOLD }; ///< section titles
+constexpr TypeStyle Subtitle{ 1.22, WEIGHT_SEMIBOLD }; ///< tile labels
+constexpr TypeStyle Nav{ 1.32, WEIGHT_NORMAL }; ///< navigation items
+constexpr TypeStyle NavSelected{ 1.32, WEIGHT_BOLD };
+constexpr TypeStyle Row{ 1.2, WEIGHT_NORMAL }; ///< the rows of a list of files
+constexpr TypeStyle Body{ 1.0, WEIGHT_NORMAL };
+constexpr TypeStyle Label{ 1.1, WEIGHT_SEMIBOLD }; ///< table headers
+constexpr TypeStyle Strong{ 1.0, WEIGHT_BOLD }; ///< small section headings
+constexpr TypeStyle CardTitle{ 0.95, WEIGHT_SEMIBOLD };
+constexpr TypeStyle Caption{ 0.85, WEIGHT_NORMAL }; ///< second lines, taglines
+}
+
+/** The application font of rStyle at the size and weight of rType (its height in points). */
+VCL_DLLPUBLIC vcl::Font MakeFont(const StyleSettings& rStyle, const TypeStyle& rType);
+
+/** The same font with its height in pixels for a device of nDpiY, without rounding the scaled size to
+    whole points first (MakeFont's 9.5 pt is 10 pt; here it stays 9.5 pt, 12.7 px at 96 DPI). */
+VCL_DLLPUBLIC vcl::Font MakePixelFont(const StyleSettings& rStyle, const TypeStyle& rType, sal_Int32 nDpiY);
+
+/** Corner radii. */
+namespace radius
+{
+constexpr double Control = 8; ///< input fields, navigation pills, small cards
+constexpr double Card = 10; ///< cards and tiles
+constexpr double Row = 6; ///< the hover of a row inside a card
+}
+
+/** The spacing scale. */
+namespace space
+{
+constexpr double XXS = 2;
+constexpr double XS = 4;
+constexpr double S = 8;
+constexpr double M = 12;
+constexpr double L = 16;
+constexpr double XL = 24;
+}
+
+/** The card shadow: layers of growing size and falling opacity below a card. */
+constexpr int SHADOW_LAYERS = 3;
+constexpr double SHADOW_STEP = 1; ///< growth and drop per layer
+constexpr double SHADOW_OPACITY_LIGHT = 0.045; ///< the innermost layer's opacity
+constexpr double SHADOW_OPACITY_DARK = 0.14;
+
+/** Interaction states: the focus ring (keyboard focus only) and the border of a focused field. */
+constexpr double FOCUS_RING_WIDTH = 2;
+constexpr double FOCUS_RING_GAP = 2;
+constexpr double FIELD_FOCUS_BORDER = 2;
+
+/** Icon sizes. */
+namespace icon
+{
+constexpr double Tile = 44; ///< application icon of a tile
+constexpr double Row = 24; ///< application icon of a file row
+constexpr double Nav = 20; ///< navigation glyph
+constexpr double Action = 18; ///< glyph of a row action (pin, more, folder)
+constexpr double Chevron = 16;
+constexpr double Caption = 15; ///< glyph beside a caption line
+}
+}
+
