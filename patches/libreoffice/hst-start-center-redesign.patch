HST Office: the new Start Center (the window shown when no document is open), drawn in the HST look.

- One VCL canvas draws the whole Start Center with anti-aliased vectors, alike on Windows, Linux and macOS:
  the light-blue background with its soft curve, the pale blue left panel, rounded pills, cards, tiles and
  focus rings, in a light and a dark palette. Only the search entry and the HASON TECH banner are toolkit
  widgets, placed into the canvas's slots (the banner's slot is width x HstBannerWidget::HeightForWidth).
- Left: the HST Office logo; Trang chủ, Tài liệu mới (menu: Văn bản, Bảng tính, Trình chiếu, Bản vẽ, Từ mẫu…),
  Mở tệp, Tài liệu chưa lưu (org.hst.office.vi:UnsavedDocuments), Gần đây, Đã ghim, Cập nhật HST Office
  (org.hst.office.update:Check); below a separator the banner, "Các giải pháp chuyển đổi số của HASON TECH",
  six solution cards (name and tagline) in two columns and the link to hasontech.vn. No shared files, no account.
- Centre: "Chào mừng bạn quay lại", a search field that filters the recent documents with or without Vietnamese
  accents, three tinted tiles with the HST application icons, and the "Gần đây" table (Tên, Đã mở, Vị trí,
  pin, "⋯" menu: Mở, Mở vị trí tệp, Ghim/Bỏ ghim, Xóa khỏi danh sách).
- Right: the "Được ghim" card (the history's own pinned flag, kept in the profile).
- The canvas does its own hit-testing, hover, press, focus and scrolling; Tab, arrows, Home/End, Page Up/Down,
  Enter, Space, the context menu key and F6 work everywhere. Every drawn item is an accessible object
  (regions, push buttons, list items) with name, description, states and actions.
- The colours, type scale, radii, spacing, shadow, states and icon sizes are the HST design tokens
  (include/vcl/hst/designtokens.hxx) and the shapes the HST drawing helpers (include/vcl/hst/drawhelpers.hxx),
  shared by every HST surface drawn in this look.
- Narrow windows: the Pinned card folds into the table, then the menu shows glyphs only; a short window scrolls
  the left column. File times are read on a worker thread; no thumbnails are loaded.

Hook: sfx2/source/dialog/backingcomp.cxx creates HstStartCenterWindow instead of BackingWindow (4 lines);
makefile and translation entries. The logic is in new HST files (LicenseRef-HST-Proprietary):
sfx2/source/startcenter/*, sfx2/inc/startcenter/*, sfx2/uiconfig/ui/hststartcenter.ui, include/vcl/hst/*,
vcl/source/hst/*.
Test: CppunitTest_sfx2_hst_startcenter.
---
diff --git a/include/vcl/hst/designtokens.hxx b/include/vcl/hst/designtokens.hxx
new file mode 100644
index 0000000..94ee667
--- /dev/null
+++ b/include/vcl/hst/designtokens.hxx
@@ -0,0 +1,131 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * This file is part of HST Office.
+ */
+
+#pragma once
+
+#include <tools/color.hxx>
+#include <tools/fontenum.hxx>
+#include <vcl/dllapi.h>
+#include <vcl/font.hxx>
+
+class StyleSettings;
+
+/* The HST Office design tokens: every visual constant of the HST look in one place — the light and
+   dark palettes, the type scale, corner radii, spacing, the card shadow, the interaction states and
+   the icon sizes. Lengths are logical pixels (multiply by the window's DPI scale). Every HST surface
+   drawn in this style (the Start Center first) takes its values from here and its shapes from
+   <vcl/hst/drawhelpers.hxx>, so the surfaces stay alike and the look changes in one place. */
+namespace hst::design
+{
+/** The colour roles of the HST look. */
+struct Palette
+{
+    bool bDark = false;
+    Color aBackTop; ///< the window background gradient, top left ...
+    Color aBackBottom; ///< ... to bottom right
+    Color aWave; ///< the large soft curve of the background
+    Color aWaveLine; ///< its light edge
+    Color aSide; ///< a side panel, top ...
+    Color aSideBottom; ///< ... to bottom
+    Color aText;
+    Color aMuted; ///< secondary text: locations, dates, taglines, placeholders
+    Color aHeading; ///< display headings
+    Color aAccent; ///< selection, links, focus rings, an active toggle
+    Color aPill; ///< the selected item of a navigation list
+    Color aHover; ///< an item under the mouse
+    Color aPressed; ///< an item being pressed
+    Color aCard; ///< cards and input fields
+    Color aCardBorder;
+    Color aSeparator; ///< lines between rows
+    Color aIcon; ///< outline glyphs
+    Color aShadow; ///< the card shadow's colour (see SHADOW_OPACITY)
+    /** Tinted surfaces (the quick-create tiles): fill, border and hover per tint. */
+    Color aTint[3];
+    Color aTintBorder[3];
+    Color aTintHover[3];
+};
+
+/** The tints, in the order of the tiles: documents, spreadsheets, presentations. */
+enum class Tint
+{
+    Blue,
+    Green,
+    Orange,
+};
+
+/** Whether the theme of rStyle is dark (its window colour is). */
+VCL_DLLPUBLIC bool IsDark(const StyleSettings& rStyle);
+VCL_DLLPUBLIC const Palette& GetPalette(bool bDark);
+inline const Palette& GetPalette(const StyleSettings& rStyle) { return GetPalette(IsDark(rStyle)); }
+
+/** A step of the type scale: a size relative to the application font and a weight. */
+struct TypeStyle
+{
+    double fScale;
+    FontWeight eWeight;
+};
+
+namespace type
+{
+constexpr TypeStyle Display{ 2.35, WEIGHT_BOLD }; ///< the welcome heading
+constexpr TypeStyle Title{ 1.32, WEIGHT_BOLD }; ///< section titles
+constexpr TypeStyle Subtitle{ 1.22, WEIGHT_SEMIBOLD }; ///< tile labels
+constexpr TypeStyle Nav{ 1.12, WEIGHT_NORMAL }; ///< navigation items
+constexpr TypeStyle NavSelected{ 1.12, WEIGHT_BOLD };
+constexpr TypeStyle Body{ 1.0, WEIGHT_NORMAL };
+constexpr TypeStyle Label{ 1.0, WEIGHT_SEMIBOLD }; ///< table headers
+constexpr TypeStyle Strong{ 1.0, WEIGHT_BOLD }; ///< small section headings
+constexpr TypeStyle CardTitle{ 0.95, WEIGHT_BOLD };
+constexpr TypeStyle Caption{ 0.9, WEIGHT_NORMAL }; ///< second lines, taglines
+}
+
+/** The application font of rStyle at the size and weight of rType (its height in points). */
+VCL_DLLPUBLIC vcl::Font MakeFont(const StyleSettings& rStyle, const TypeStyle& rType);
+
+/** Corner radii. */
+namespace radius
+{
+constexpr double Control = 8; ///< input fields, navigation pills, small cards
+constexpr double Card = 10; ///< cards and tiles
+constexpr double Row = 6; ///< the hover of a row inside a card
+}
+
+/** The spacing scale. */
+namespace space
+{
+constexpr double XXS = 2;
+constexpr double XS = 4;
+constexpr double S = 8;
+constexpr double M = 12;
+constexpr double L = 16;
+constexpr double XL = 24;
+}
+
+/** The card shadow: layers of growing size and falling opacity below a card. */
+constexpr int SHADOW_LAYERS = 3;
+constexpr double SHADOW_STEP = 1; ///< growth and drop per layer
+constexpr double SHADOW_OPACITY_LIGHT = 0.045; ///< the innermost layer's opacity
+constexpr double SHADOW_OPACITY_DARK = 0.14;
+
+/** Interaction states: the focus ring (keyboard focus only) and the border of a focused field. */
+constexpr double FOCUS_RING_WIDTH = 2;
+constexpr double FOCUS_RING_GAP = 2;
+constexpr double FIELD_FOCUS_BORDER = 2;
+
+/** Icon sizes. */
+namespace icon
+{
+constexpr double Tile = 44; ///< application icon of a tile
+constexpr double Row = 24; ///< application icon of a file row
+constexpr double Nav = 20; ///< navigation glyph
+constexpr double Action = 18; ///< glyph of a row action (pin, more, folder)
+constexpr double Chevron = 16;
+constexpr double Caption = 15; ///< glyph beside a caption line
+}
+}
+
+/* vim:set shiftwidth=4 softtabstop=4 expandtab: */
diff --git a/include/vcl/hst/drawhelpers.hxx b/include/vcl/hst/drawhelpers.hxx
new file mode 100644
index 0000000..a707849
--- /dev/null
+++ b/include/vcl/hst/drawhelpers.hxx
@@ -0,0 +1,57 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * This file is part of HST Office.
+ */
+
+#pragma once
+
+#include <tools/color.hxx>
+#include <tools/gen.hxx>
+#include <vcl/dllapi.h>
+
+class Bitmap;
+class OutputDevice;
+
+/* The shapes of the HST look, drawn with anti-aliased vectors so they are alike on every platform
+   and at every scale. fScale is the window's DPI scale; the colours and measures come from
+   <vcl/hst/designtokens.hxx>. */
+namespace hst::design
+{
+struct Palette;
+
+/** A rounded rectangle filled with rFill and outlined with rBorder (COL_TRANSPARENT: none). */
+VCL_DLLPUBLIC void DrawRoundRect(OutputDevice& rDev, const tools::Rectangle& rRect, double fRadius,
+                                 const Color& rFill, const Color& rBorder, double fBorderWidth = 1.0);
+
+/** A card: its shadow, its fill and its border, with the card radius. */
+VCL_DLLPUBLIC void DrawCard(OutputDevice& rDev, const tools::Rectangle& rRect, const Palette& rPalette,
+                            double fScale);
+
+/** The soft shadow below a card of radius fRadius. */
+VCL_DLLPUBLIC void DrawCardShadow(OutputDevice& rDev, const tools::Rectangle& rRect, double fRadius,
+                                  const Palette& rPalette, double fScale);
+
+/** A pill: the background of a selected (bSelected) or hovered navigation item. */
+VCL_DLLPUBLIC void DrawPill(OutputDevice& rDev, const tools::Rectangle& rRect, const Palette& rPalette,
+                            bool bSelected, double fScale);
+
+/** A badge: an icon (a rendered application icon) centred in rBox at its own pixel size, never
+    scaled, so it stays crisp. */
+VCL_DLLPUBLIC void DrawBadge(OutputDevice& rDev, const tools::Rectangle& rBox, const Bitmap& rIcon);
+
+/** The keyboard focus ring around rRect, an item of radius fRadius. */
+VCL_DLLPUBLIC void DrawFocusRing(OutputDevice& rDev, const tools::Rectangle& rRect, double fRadius,
+                                 const Palette& rPalette, double fScale);
+
+/** The window background: the diagonal gradient and the large soft curve at the top right. */
+VCL_DLLPUBLIC void DrawBackground(OutputDevice& rDev, const tools::Rectangle& rArea,
+                                  const Palette& rPalette, double fScale);
+
+/** A side panel: a vertical gradient of the side colour. */
+VCL_DLLPUBLIC void DrawSidePanel(OutputDevice& rDev, const tools::Rectangle& rArea,
+                                 const Palette& rPalette);
+}
+
