+/** One item of a region: a button or a file. */
+class CanvasItemAccessible final
+    : public cppu::ImplInheritanceHelper<comphelper::OAccessible, XAccessibleAction>
+{
+public:
+    CanvasItemAccessible(CanvasRegionAccessible& rRegion, CanvasAccessible& rRoot, const Hit& rHit)
+        : mrRegion(rRegion)
+        , mrRoot(rRoot)
+        , maHit(rHit)
+    {
+    }
+
+    const Hit& GetHit() const { return maHit; }
+    void Notify(sal_Int16 nEventId, const uno::Any& rOld, const uno::Any& rNew)
+    {
+        NotifyAccessibleEvent(nEventId, rOld, rNew);
+    }
+
+    virtual sal_Int64 SAL_CALL getAccessibleChildCount() override { return 0; }
+    virtual uno::Reference<XAccessible> SAL_CALL getAccessibleChild(sal_Int64) override
+    {
+        throw lang::IndexOutOfBoundsException();
+    }
+    virtual uno::Reference<XAccessible> SAL_CALL getAccessibleParent() override;
+    virtual sal_Int64 SAL_CALL getAccessibleIndexInParent() override
+    {
+        SolarMutexGuard aGuard;
+        ensureAlive();
+        return maHit.ePart == Part::MoreSolutions ? SOLUTION_COUNT : maHit.nIndex;
+    }
+    virtual sal_Int16 SAL_CALL getAccessibleRole() override
+    {
+        return maHit.ePart == Part::Recent || maHit.ePart == Part::Pinned ? AccessibleRole::LIST_ITEM
+                                                                         : AccessibleRole::PUSH_BUTTON;
+    }
+    virtual OUString SAL_CALL getAccessibleDescription() override
+    {
+        SolarMutexGuard aGuard;
+        ensureAlive();
+        HstStartCenterCanvas* pCanvas = mrRoot.GetCanvas();
+        return pCanvas ? pCanvas->ItemDescription(maHit) : OUString();
+    }
+    virtual OUString SAL_CALL getAccessibleName() override
+    {
+        SolarMutexGuard aGuard;
+        ensureAlive();
+        HstStartCenterCanvas* pCanvas = mrRoot.GetCanvas();
+        return pCanvas ? pCanvas->ItemName(maHit) : OUString();
+    }
+    virtual uno::Reference<XAccessibleRelationSet> SAL_CALL getAccessibleRelationSet() override
+    {
+        return new utl::AccessibleRelationSetHelper;
+    }
+    virtual sal_Int64 SAL_CALL getAccessibleStateSet() override
+    {
+        SolarMutexGuard aGuard;
+        sal_Int64 nStates = 0;
+        HstStartCenterCanvas* pCanvas = mrRoot.GetCanvas();
+        if (!isAlive() || !pCanvas)
+            return AccessibleStateType::DEFUNC;
+        nStates |= AccessibleStateType::ENABLED | AccessibleStateType::SENSITIVE
+                   | AccessibleStateType::FOCUSABLE | AccessibleStateType::VISIBLE;
+        if (pCanvas->IsReallyVisible() && pCanvas->IsItemShowing(maHit))
+            nStates |= AccessibleStateType::SHOWING;
+        const bool bFocused = pCanvas->HasFocus() && pCanvas->GetFocusItem() == maHit;
+        if (bFocused)
+            nStates |= AccessibleStateType::FOCUSED;
+        if (maHit.ePart == Part::Recent || maHit.ePart == Part::Pinned)
+        {
+            nStates |= AccessibleStateType::SELECTABLE;
+            if (pCanvas->GetFocusItem() == maHit)
+                nStates |= AccessibleStateType::SELECTED;
+        }
+        if (maHit.ePart == Part::Nav && pCanvas->GetModel().nSelectedNav == maHit.nIndex)
+            nStates |= AccessibleStateType::SELECTED;
+        return nStates;
+    }
+    virtual uno::Reference<XAccessible> SAL_CALL getAccessibleAtPoint(const awt::Point&) override
+    {
+        return nullptr;
+    }
+    virtual void SAL_CALL grabFocus() override
+    {
+        SolarMutexGuard aGuard;
+        ensureAlive();
+        if (HstStartCenterCanvas* pCanvas = mrRoot.GetCanvas())
+            pCanvas->FocusItem(maHit);
+    }
+    virtual sal_Int32 SAL_CALL getForeground() override
+    {
+        SolarMutexGuard aGuard;
+        HstStartCenterCanvas* pCanvas = mrRoot.GetCanvas();
+        return pCanvas ? sal_Int32(pCanvas->GetPalette().aText) : 0;
+    }
+    virtual sal_Int32 SAL_CALL getBackground() override
+    {
+        SolarMutexGuard aGuard;
+        HstStartCenterCanvas* pCanvas = mrRoot.GetCanvas();
+        return pCanvas ? sal_Int32(pCanvas->GetPalette().aCard) : 0;
+    }
+
+    // XAccessibleAction
+    virtual sal_Int32 SAL_CALL getAccessibleActionCount() override
+    {
+        return maHit.ePart == Part::Recent || maHit.ePart == Part::Pinned ? 3 : 1;
+    }
+    virtual sal_Bool SAL_CALL doAccessibleAction(sal_Int32 nIndex) override
+    {
+        SolarMutexGuard aGuard;
+        ensureAlive();
+        if (nIndex < 0 || nIndex >= getAccessibleActionCount())
+            throw lang::IndexOutOfBoundsException();
+        HstStartCenterCanvas* pCanvas = mrRoot.GetCanvas();
+        if (!pCanvas)
+            return false;
+        pCanvas->DoAction(maHit, nIndex);
+        return true;
+    }
+    virtual OUString SAL_CALL getAccessibleActionDescription(sal_Int32 nIndex) override
+    {
+        if (nIndex < 0 || nIndex >= getAccessibleActionCount())
+            throw lang::IndexOutOfBoundsException();
+        if (getAccessibleActionCount() == 1)
+            return u"press"_ustr;
+        static constexpr OUString aNames[3] = { u"open"_ustr, u"pin"_ustr, u"menu"_ustr };
+        return aNames[nIndex];
+    }
+    virtual uno::Reference<XAccessibleKeyBinding>
+        SAL_CALL getAccessibleActionKeyBinding(sal_Int32 nIndex) override
+    {
+        if (nIndex < 0 || nIndex >= getAccessibleActionCount())
+            throw lang::IndexOutOfBoundsException();
+        return nullptr;
+    }
+
+protected:
+    virtual awt::Rectangle implGetBounds() override;
+
+private:
+    CanvasRegionAccessible& mrRegion;
+    CanvasAccessible& mrRoot;
+    Hit maHit;
+};
