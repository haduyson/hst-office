diff --git a/vcl/source/hst/drawhelpers.cxx b/vcl/source/hst/drawhelpers.cxx
new file mode 100644
index 0000000..78e7525
--- /dev/null
+++ b/vcl/source/hst/drawhelpers.cxx
@@ -0,0 +1,193 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * This file is part of HST Office.
+ */
+
+#include <vcl/hst/drawhelpers.hxx>
+#include <vcl/hst/designtokens.hxx>
+
+#include <basegfx/matrix/b2dhommatrix.hxx>
+#include <basegfx/point/b2dpoint.hxx>
+#include <basegfx/polygon/b2dpolygon.hxx>
+#include <basegfx/polygon/b2dpolygontools.hxx>
+#include <basegfx/polygon/b2dpolypolygon.hxx>
+#include <basegfx/range/b2drange.hxx>
+#include <com/sun/star/awt/GradientStyle.hpp>
+#include <tools/poly.hxx>
+#include <vcl/bitmap.hxx>
+#include <vcl/gradient.hxx>
+#include <vcl/outdev.hxx>
+#include <vcl/rendercontext/AntialiasingFlags.hxx>
+
+#include <algorithm>
+
+namespace hst::design
+{
+namespace
+{
+/** Anti-aliasing on for one shape, the device's own setting back afterwards (the device may be a
+    control's, whose later drawing must not change). */
+class ScopedAntialiasing
+{
+public:
+    explicit ScopedAntialiasing(OutputDevice& rDev)
+        : mrDev(rDev)
+        , meOld(rDev.GetAntialiasing())
+    {
+        rDev.SetAntialiasing(meOld | AntialiasingFlags::Enable);
+    }
+    ~ScopedAntialiasing() { mrDev.SetAntialiasing(meOld); }
+
+private:
+    OutputDevice& mrDev;
+    AntialiasingFlags meOld;
+};
+
+basegfx::B2DPolygon roundedRect(const basegfx::B2DRange& rRange, double fRadius)
+{
+    const double fHalfW = std::max(1.0, rRange.getWidth() / 2);
+    const double fHalfH = std::max(1.0, rRange.getHeight() / 2);
+    return basegfx::utils::createPolygonFromRect(rRange, std::min(1.0, fRadius / fHalfW),
+                                                 std::min(1.0, fRadius / fHalfH));
+}
+}
+
+void DrawRoundRect(OutputDevice& rDev, const tools::Rectangle& rRect, double fRadius, const Color& rFill,
+                   const Color& rBorder, double fBorderWidth)
+{
+    if (rRect.IsEmpty())
+        return;
+    // Cairo fills polygons on pixel edges and strokes lines half a pixel further (it adds that offset
+    // itself; Skia adds it to lines and to rounded fills alike). So the fill covers the rectangle's
+    // pixels, and an outline of width w lies w/2 - 0.5 inside the edge: its outer edge is the edge
+    // pixel, crisp at any w. Under an outline the fill stops half a pixel inside, where the outline
+    // paints over it on both backends, so no fill bleeds beside the border.
+    const bool bBorder = rBorder != COL_TRANSPARENT;
+    const double fFillIn = bBorder ? 0.5 : 0.0;
+    const basegfx::B2DRange aFillRange(rRect.Left() + fFillIn, rRect.Top() + fFillIn,
+                                       rRect.Right() + 1.0 - fFillIn, rRect.Bottom() + 1.0 - fFillIn);
+    const double fInset = std::max(0.0, fBorderWidth / 2 - 0.5);
+    const basegfx::B2DRange aLineRange(rRect.Left() + fInset, rRect.Top() + fInset, rRect.Right() - fInset,
+                                       rRect.Bottom() - fInset);
+    auto aPop = rDev.ScopedPush(vcl::PushFlags::LINECOLOR | vcl::PushFlags::FILLCOLOR);
+    ScopedAntialiasing aAntialiasing(rDev);
+    if (rFill != COL_TRANSPARENT)
+    {
+        rDev.SetLineColor();
+        rDev.SetFillColor(rFill);
+        rDev.DrawPolygon(roundedRect(aFillRange, fRadius));
+    }
+    if (bBorder)
+    {
+        rDev.SetFillColor();
+        rDev.SetLineColor(rBorder);
+        rDev.DrawPolyLine(roundedRect(aLineRange, std::max(0.0, fRadius - fInset)), fBorderWidth);
+    }
+}
+
+void DrawCardShadow(OutputDevice& rDev, const tools::Rectangle& rRect, double fRadius,
+                    const Palette& rPalette, double fScale)
+{
+    if (rRect.IsEmpty())
+        return;
+    auto aPop = rDev.ScopedPush(vcl::PushFlags::LINECOLOR | vcl::PushFlags::FILLCOLOR);
+    ScopedAntialiasing aAntialiasing(rDev);
+    rDev.SetLineColor();
+    rDev.SetFillColor(rPalette.aShadow);
+    const double fOpacity = rPalette.bDark ? SHADOW_OPACITY_DARK : SHADOW_OPACITY_LIGHT;
+    // each layer is wider, reaches lower and is fainter than the one inside it
+    for (int i = 1; i <= SHADOW_LAYERS; ++i)
+    {
+        const double fGrow = i * SHADOW_STEP * fScale;
+        const basegfx::B2DRange aRange(rRect.Left() - fGrow, rRect.Top(),
+                                       rRect.Right() + 1 + fGrow, rRect.Bottom() + 1 + 2 * fGrow);
+        const double fLayer = fOpacity * (SHADOW_LAYERS + 1 - i) / SHADOW_LAYERS;
+        rDev.DrawTransparent(basegfx::B2DHomMatrix(),
+                             basegfx::B2DPolyPolygon(roundedRect(aRange, fRadius + fGrow)),
+                             1.0 - fLayer);
+    }
+}
+
+void DrawCard(OutputDevice& rDev, const tools::Rectangle& rRect, const Palette& rPalette, double fScale)
+{
+    const double fRadius = radius::Card * fScale;
+    DrawCardShadow(rDev, rRect, fRadius, rPalette, fScale);
+    DrawRoundRect(rDev, rRect, fRadius, rPalette.aCard, rPalette.aCardBorder);
+}
+
+void DrawPill(OutputDevice& rDev, const tools::Rectangle& rRect, const Palette& rPalette, bool bSelected,
+              double fScale)
+{
+    DrawRoundRect(rDev, rRect, radius::Control * fScale, bSelected ? rPalette.aPill : rPalette.aHover,
+                  COL_TRANSPARENT);
+}
+
+void DrawBadge(OutputDevice& rDev, const tools::Rectangle& rBox, const Bitmap& rIcon)
+{
+    if (rIcon.IsEmpty())
+        return;
+    const Size aSize = rIcon.GetSizePixel();
+    rDev.DrawBitmap(Point(rBox.Left() + (rBox.GetWidth() - aSize.Width()) / 2,
+                          rBox.Top() + (rBox.GetHeight() - aSize.Height()) / 2),
+                    rIcon);
+}
+
+void DrawFocusRing(OutputDevice& rDev, const tools::Rectangle& rRect, double fRadius,
+                   const Palette& rPalette, double fScale)
+{
+    // the ring is drawn inside its rectangle, so that lies the gap and the ring's width outside
+    const tools::Long nOut = static_cast<tools::Long>((FOCUS_RING_GAP + FOCUS_RING_WIDTH) * fScale + 0.5);
+    tools::Rectangle aRing(rRect);
+    aRing.expand(nOut);
+    DrawRoundRect(rDev, aRing, fRadius + nOut, COL_TRANSPARENT, rPalette.aAccent, FOCUS_RING_WIDTH * fScale);
+}
+
+void DrawBackground(OutputDevice& rDev, const tools::Rectangle& rArea, const Palette& rPalette,
+                    double fScale)
+{
+    if (rArea.IsEmpty())
+        return;
+    auto aPop = rDev.ScopedPush(vcl::PushFlags::CLIPREGION | vcl::PushFlags::LINECOLOR
+                                | vcl::PushFlags::FILLCOLOR);
+    rDev.IntersectClipRegion(rArea);
+    Gradient aGradient(css::awt::GradientStyle_LINEAR, rPalette.aBackTop, rPalette.aBackBottom);
+    aGradient.SetAngle(Degree10(300)); // from the top left to the bottom right
+    // no step count on any gradient here: with one set, Cairo and Skia refuse to draw it natively and
+    // VCL paints every step clipped to the shape, which costs tens of milliseconds at start-up
+    rDev.DrawGradient(rArea, aGradient);
+
+    // The soft curve at the top right: the upper left part of a large circle whose centre lies
+    // beyond the right edge, filled with a fade from the wave colour into the background, with a
+    // lighter band inside it and a light edge.
+    const double fW = rArea.GetWidth();
+    const double fH = rArea.GetHeight();
+    const basegfx::B2DPoint aCentre(rArea.Left() + fW * 1.08, rArea.Top() + fH * 0.92);
+    const double fR = std::max(fW * 0.52, fH * 0.82);
+    ScopedAntialiasing aAntialiasing(rDev);
+    for (int nBand = 0; nBand < 2; ++nBand)
+    {
+        const basegfx::B2DPolygon aCircle
+            = basegfx::utils::createPolygonFromCircle(aCentre, fR * (nBand == 0 ? 1.0 : 0.94));
+        Color aTop = rPalette.aWave;
+        if (nBand == 1)
+            aTop.Merge(rPalette.aBackBottom, 150);
+        Gradient aFade(css::awt::GradientStyle_LINEAR, aTop, rPalette.aBackBottom);
+        rDev.DrawGradient(tools::PolyPolygon(tools::Polygon(aCircle)), aFade);
+        rDev.SetFillColor();
+        rDev.SetLineColor(rPalette.aWaveLine);
+        rDev.DrawPolyLine(aCircle, 1.5 * fScale);
+    }
+}
+
+void DrawSidePanel(OutputDevice& rDev, const tools::Rectangle& rArea, const Palette& rPalette)
+{
+    if (rArea.IsEmpty())
+        return;
+    Gradient aGradient(css::awt::GradientStyle_LINEAR, rPalette.aSide, rPalette.aSideBottom);
+    rDev.DrawGradient(rArea, aGradient);
+}
+}
+
+/* vim:set shiftwidth=4 softtabstop=4 expandtab: */
