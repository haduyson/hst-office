+void HstStartCenterWindow::InitTexts()
+{
+    CanvasTexts aTexts;
+    const TranslateId aNav[NAV_COUNT]
+        = { STR_HST_SC_NAV_HOME,   STR_HST_SC_NAV_NEW,    STR_HST_SC_NAV_OPEN,  STR_HST_SC_NAV_UNSAVED,
+            STR_HST_SC_NAV_RECENT, STR_HST_SC_NAV_PINNED, STR_HST_SC_NAV_UPDATE };
+    for (int i = 0; i < NAV_COUNT; ++i)
+        aTexts.aNav[i] = SfxResId(aNav[i]);
+    const TranslateId aTiles[TILE_COUNT] = { STR_HST_SC_TILE_WRITER, STR_HST_SC_TILE_CALC, STR_HST_SC_TILE_IMPRESS };
+    for (int i = 0; i < TILE_COUNT; ++i)
+        aTexts.aTiles[i] = SfxResId(aTiles[i]);
+    aTexts.aWelcome = SfxResId(STR_HST_SC_WELCOME);
+    aTexts.aQuickTitle = SfxResId(STR_HST_SC_QUICK_TITLE);
+    aTexts.aRecentTitle = SfxResId(STR_HST_SC_RECENT_TITLE);
+    aTexts.aColName = SfxResId(STR_HST_SC_COL_NAME);
+    aTexts.aColOpened = SfxResId(STR_HST_SC_COL_OPENED);
+    aTexts.aColLocation = SfxResId(STR_HST_SC_COL_LOCATION);
+    aTexts.aPinnedTitle = SfxResId(STR_HST_SC_PINNED_TITLE);
+    aTexts.aRecentEmpty = SfxResId(STR_HST_SC_RECENT_EMPTY);
+    aTexts.aNoMatch = SfxResId(STR_HST_SC_NO_MATCH);
+    aTexts.aPinnedEmpty = SfxResId(STR_HST_SC_PINNED_EMPTY);
+    aTexts.aPinnedState = SfxResId(STR_HST_SC_PINNED_STATE);
+    aTexts.aRowHint = SfxResId(STR_HST_SC_RECENT_HINT);
+    aTexts.aMenuName = SfxResId(STR_HST_SC_MENU_NAME);
+    aTexts.aRecentName = SfxResId(STR_HST_SC_RECENT_NAME);
+    aTexts.aPinnedName = SfxResId(STR_HST_SC_PINNED_NAME);
+    aTexts.aSolutionsTitle = SfxResId(STR_HST_SC_SOLUTIONS_TITLE);
+    aTexts.aMore = MORE_SOLUTIONS_TEXT;
+    // the short tagline in the UI's language: Vietnamese, or English for every other language
+    const bool bVietnamese = Application::GetSettings().GetUILanguageTag().getLanguage() == "vi";
+    for (int i = 0; i < SOLUTION_COUNT; ++i)
+    {
+        aTexts.aSolutionName[i] = aSolutions[i].aName;
+        const OUString& rShort = bVietnamese ? aSolutions[i].aShort : aSolutions[i].aShortEn;
+        aTexts.aSolutionTagline[i] = rShort.isEmpty() ? aSolutions[i].aTagline : rShort;
+        aTexts.aSolutionDescription[i] = aSolutions[i].aTagline;
+    }
+    mxCanvas->SetTexts(std::move(aTexts));
+}
