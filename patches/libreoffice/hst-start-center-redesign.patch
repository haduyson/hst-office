+
+namespace
+{
+// The update check of the bundled HST extension (the same command as the ribbon's Help tab).
+constexpr OUString UPDATE_CHECK = u"org.hst.office.update:Check"_ustr;
+// "Tài liệu chưa lưu" of the bundled HST extension (the same command as the File panel's entry).
+constexpr OUString UNSAVED_DOCUMENTS = u"org.hst.office.vi:UnsavedDocuments"_ustr;
+
+// The HASON TECH solutions: name, tagline and site, in display order (the same as the solutions of
+// data/hst/solutions.json; tests/unit checks that they stay alike). The texts are Vietnamese in
+// every interface language, as everywhere HASON TECH presents itself in HST Office.
+struct Solution
+{
+    OUString aName;
+    OUString aTagline;
+    OUString aURL;
+};
+
+const Solution aSolutions[] = {
+    { u"AIOS"_ustr,
+      u"Trợ lý AI cá nhân, như một trợ lý thực thụ"_ustr,
+      u"https://aios.hasontech.vn"_ustr },
+    { u"eChatbot"_ustr,
+      u"Chatbot AI – trợ lý số cho cơ quan chính quyền, doanh nghiệp, giáo dục"_ustr,
+      u"https://echatbot.vn"_ustr },
+    { u"Zalo Mini App"_ustr,
+      u"Mini App trên ứng dụng Zalo dành cho chính quyền số, doanh nghiệp"_ustr,
+      u"https://espace.vn/zaloapp"_ustr },
+    { u"HST SEO"_ustr,
+      u"SEO tự động hóa thông minh bằng AI"_ustr,
+      u"https://seo.hasontech.vn"_ustr },
+    { u"HST Post"_ustr,
+      u"Công cụ đăng bài bằng AI trên hàng loạt nền tảng mạng xã hội"_ustr,
+      u"https://post.hasontech.vn"_ustr },
+    { u"AI Dễ Lắm"_ustr,
+      u"Bộ công cụ hỗ trợ sử dụng AI thành thạo"_ustr,
+      u"https://aidelam.com"_ustr },
+};
+static_assert(std::size(aSolutions) == SOLUTION_COUNT);
+constexpr OUString MORE_SOLUTIONS_TEXT = u"Xem thêm các giải pháp khác →"_ustr;
+constexpr OUString MORE_SOLUTIONS_URL = u"https://hasontech.vn"_ustr;
+// UTM only tells the site where the click came from; the application sends no data.
+constexpr OUString SOLUTION_UTM
+    = u"utm_source=hst-office&utm_medium=start-center&utm_campaign=hst-office-1-0"_ustr;
+
+// The tiles, then the documents automation creates by the former Start Center's ids.
+const std::pair<OUString, OUString> aFactories[] = {
+    { u"writer_all"_ustr, u"private:factory/swriter"_ustr },
+    { u"calc_all"_ustr, u"private:factory/scalc"_ustr },
+    { u"impress_all"_ustr, u"private:factory/simpress?slot=6686"_ustr },
+    { u"draw_all"_ustr, u"private:factory/sdraw"_ustr },
+    { u"math_all"_ustr, u"private:factory/smath"_ustr },
+    { u"database_all"_ustr, u"private:factory/sdatabase?Interactive"_ustr },
