+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * This file is part of HST Office.
+ */
+
+#include <vcl/hst/designtokens.hxx>
+
+#include <vcl/settings.hxx>
+
+namespace hst::design
+{
+namespace
+{
+// The light look: a pale blue side panel, a blue-to-white background with a soft curve, white
+// cards with light borders and tinted tiles. The dark look keeps the same structure and hues on a
+// dark navy base, so the two never mix flat grey with colour.
+Palette makeLight()
+{
+    Palette p;
+    p.bDark = false;
+    p.aBackTop = Color(0xEC, 0xF3, 0xFC);
+    p.aBackBottom = Color(0xFB, 0xFC, 0xFE);
+    p.aWave = Color(0xCB, 0xE3, 0xFB);
+    p.aWaveLine = Color(0xF4, 0xF9, 0xFF);
+    p.aSide = Color(0xEA, 0xF2, 0xFD);
+    p.aSideBottom = Color(0xE6, 0xF0, 0xFD);
+    p.aText = Color(0x1F, 0x29, 0x37);
+    p.aMuted = Color(0x6B, 0x72, 0x80);
+    p.aHeading = Color(0x0A, 0x47, 0x96);
+    p.aAccent = Color(0x1A, 0x56, 0xC8);
+    p.aPill = Color(0xD5, 0xE5, 0xFA);
+    p.aHover = Color(0xE1, 0xEC, 0xFB);
+    p.aPressed = Color(0xCC, 0xDF, 0xF8);
+    p.aCard = Color(0xFF, 0xFF, 0xFF);
+    p.aCardBorder = Color(0xD9, 0xE1, 0xEB);
+    p.aSeparator = Color(0xE8, 0xEC, 0xF2);
+    p.aIcon = Color(0x37, 0x41, 0x51);
+    p.aShadow = Color(0x1E, 0x3A, 0x6E);
+    const Color aFill[3] = { Color(0xEB, 0xF3, 0xFE), Color(0xE9, 0xF7, 0xEE), Color(0xFE, 0xF2, 0xE7) };
+    const Color aBorder[3] = { Color(0xCF, 0xE0, 0xFA), Color(0xC9, 0xEA, 0xD4), Color(0xF9, 0xDC, 0xC3) };
+    const Color aHover[3] = { Color(0xDE, 0xEB, 0xFD), Color(0xDB, 0xF1, 0xE3), Color(0xFC, 0xE7, 0xD4) };
+    for (int i = 0; i < 3; ++i)
+    {
+        p.aTint[i] = aFill[i];
+        p.aTintBorder[i] = aBorder[i];
+        p.aTintHover[i] = aHover[i];
+    }
+    p.aLogoTile = COL_TRANSPARENT;
+    return p;
+}
+
+Palette makeDark()
+{
+    Palette p;
+    p.bDark = true;
+    p.aBackTop = Color(0x1A, 0x22, 0x31);
+    p.aBackBottom = Color(0x12, 0x17, 0x20);
+    p.aWave = Color(0x22, 0x36, 0x55);
+    p.aWaveLine = Color(0x33, 0x4D, 0x75);
+    p.aSide = Color(0x18, 0x21, 0x30);
+    p.aSideBottom = Color(0x15, 0x1C, 0x29);
+    p.aText = Color(0xE5, 0xE7, 0xEB);
+    p.aMuted = Color(0x9C, 0xA3, 0xAF);
+    p.aHeading = Color(0x8A, 0xB4, 0xF8);
+    p.aAccent = Color(0x8A, 0xB4, 0xF8);
+    p.aPill = Color(0x26, 0x3B, 0x5E);
+    p.aHover = Color(0x22, 0x30, 0x47);
+    p.aPressed = Color(0x2A, 0x3D, 0x5C);
+    p.aCard = Color(0x1E, 0x25, 0x32);
+    p.aCardBorder = Color(0x31, 0x3C, 0x4E);
+    p.aSeparator = Color(0x2B, 0x34, 0x44);
+    p.aIcon = Color(0xC9, 0xCF, 0xD8);
+    p.aShadow = COL_BLACK;
+    const Color aFill[3] = { Color(0x1E, 0x2D, 0x4A), Color(0x1B, 0x33, 0x2A), Color(0x3A, 0x2A, 0x1F) };
+    const Color aBorder[3] = { Color(0x2F, 0x4A, 0x7A), Color(0x2B, 0x5A, 0x42), Color(0x6A, 0x46, 0x2A) };
+    const Color aHover[3] = { Color(0x25, 0x38, 0x5C), Color(0x21, 0x40, 0x34), Color(0x47, 0x33, 0x25) };
+    for (int i = 0; i < 3; ++i)
+    {
+        p.aTint[i] = aFill[i];
+        p.aTintBorder[i] = aBorder[i];
+        p.aTintHover[i] = aHover[i];
+    }
+    p.aLogoTile = Color(0xFF, 0xFF, 0xFF);
+    return p;
+}
+}
+
+bool IsDark(const StyleSettings& rStyle) { return rStyle.GetWindowColor().IsDark(); }
+
+const Palette& GetPalette(bool bDark)
+{
+    static const Palette aLight = makeLight();
+    static const Palette aDark = makeDark();
+    return bDark ? aDark : aLight;
+}
+
+vcl::Font MakeFont(const StyleSettings& rStyle, const TypeStyle& rType)
+{
+    vcl::Font aFont(rStyle.GetAppFont());
+    const tools::Long nBase = aFont.GetFontHeight() > 0 ? aFont.GetFontHeight() : 9;
+    aFont.SetFontHeight(static_cast<tools::Long>(nBase * rType.fScale + 0.5));
+    aFont.SetWeight(rType.eWeight);
+    return aFont;
+}
+
+vcl::Font MakePixelFont(const StyleSettings& rStyle, const TypeStyle& rType, sal_Int32 nDpiY)
+{
+    vcl::Font aFont(rStyle.GetAppFont());
+    const double fBase = aFont.GetFontHeight() > 0 ? aFont.GetFontHeight() : 9;
+    const double fDpi = nDpiY > 0 ? nDpiY : 96;
+    aFont.SetFontSize(Size(0, static_cast<tools::Long>(fBase * rType.fScale * fDpi / 72.0 + 0.5)));
+    aFont.SetWeight(rType.eWeight);
+    return aFont;
+}
+}
+
