+awt::Rectangle toAwt(const tools::Rectangle& rRect, const Point& rOrigin)
+{
+    if (rRect.IsEmpty())
+        return awt::Rectangle();
+    return awt::Rectangle(rRect.Left() - rOrigin.X(), rRect.Top() - rOrigin.Y(), rRect.GetWidth(),
+                          rRect.GetHeight());
+}
+
+/** The area of a region on the canvas (the union of its items, or its card body). */
+tools::Rectangle regionRect(const HstStartCenterCanvas& rCanvas, Part eRegion)
+{
+    const Layout& L = rCanvas.GetLayout();
+    tools::Rectangle aRect;
+    switch (eRegion)
+    {
+        case Part::Nav:
+            for (const tools::Rectangle& r : L.aNav)
+                aRect.Union(r);
+            break;
+        case Part::Tile:
+            for (const tools::Rectangle& r : L.aTiles)
+                aRect.Union(r);
+            break;
+        case Part::Recent:
+            aRect = L.aRecentBody;
+            break;
+        case Part::Pinned:
+            aRect = L.aPinnedBody;
+            break;
+        case Part::Solution:
+            for (const tools::Rectangle& r : L.aSolutions)
+                aRect.Union(r);
+            aRect.Union(L.aMore);
+            break;
+        default:
+            break;
+    }
+    return aRect;
+}
