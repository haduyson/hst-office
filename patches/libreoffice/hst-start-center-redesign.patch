+/** The row names of the recent documents table, top to bottom. */
+std::vector<OUString> recentNames(const uno::Reference<XAccessibleContext>& xRecent)
+{
+    std::vector<OUString> aRows;
+    for (sal_Int64 i = 0; i < xRecent->getAccessibleChildCount(); ++i)
+        aRows.push_back(context(xRecent->getAccessibleChild(i))->getAccessibleName());
+    return aRows;
