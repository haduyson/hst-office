+    const OUString aIds[] = { u"writer_all"_ustr, u"calc_all"_ustr, u"impress_all"_ustr };
+    // the drawn tiles (as assistive tools press them), then the ids automation uses
+    for (int nWay = 0; nWay < 2; ++nWay)
+    {
+        for (size_t i = 0; i < std::size(aServices); ++i)
+        {
+            openStartCenter();
+            if (nWay == 0)
+                press(u"Quickly Create a New Document", i);
+            else
+            {
+                child(aIds[i])->execute(u"CLICK"_ustr, {});
+                Scheduler::ProcessEventsToIdle();
+            }
+            uno::Reference<frame::XController> xController = mxFrame->getController();
+            CPPUNIT_ASSERT_MESSAGE(aServices[i].toUtf8().getStr(), xController.is());
+            uno::Reference<lang::XServiceInfo> xModel(xController->getModel(), uno::UNO_QUERY);
+            CPPUNIT_ASSERT_MESSAGE(aServices[i].toUtf8().getStr(), xModel.is());
+            CPPUNIT_ASSERT_MESSAGE(aServices[i].toUtf8().getStr(), xModel->supportsService(aServices[i]));
+        }
+    }
+}
+
+CPPUNIT_TEST_FIXTURE(HstStartCenterTest, testRendering)
+{
+    openStartCenter();
+    vcl::Window* pCanvas = canvas();
+    const Size aSize = pCanvas->GetOutputSizePixel();
+    CPPUNIT_ASSERT_EQUAL(Size(1366, 707), aSize);
+    ScopedVclPtrInstance<VirtualDevice> xDev;
+    xDev->SetOutputSizePixel(aSize);
+    pCanvas->PaintToDevice(*xDev, Point(0, 0));
+
+    // the tiles: rounded (the corner shows the blue background) and tinted green and orange inside
+    uno::Reference<XAccessibleContext> xTiles = region(u"Quickly Create a New Document");
+    CPPUNIT_ASSERT_EQUAL(sal_Int64(3), xTiles->getAccessibleChildCount());
+    const Point aTilesAt = bounds(xTiles).TopLeft();
+    for (sal_Int64 i = 1; i < 3; ++i)
+    {
+        tools::Rectangle aTile = bounds(context(xTiles->getAccessibleChild(i)));
+        aTile.Move(aTilesAt.X(), aTilesAt.Y());
+        const Color aCorner = xDev->GetPixel(aTile.TopLeft());
+        const Color aInside = xDev->GetPixel(Point(aTile.Left() + 6, aTile.Center().Y()));
+        CPPUNIT_ASSERT_MESSAGE("rounded tile corner", isBluish(aCorner));
+        if (i == 1) // green
+            CPPUNIT_ASSERT(aInside.GetGreen() > aInside.GetRed() + 8 && aInside.GetGreen() > aInside.GetBlue());
+        else // orange
+            CPPUNIT_ASSERT(aInside.GetRed() > aInside.GetBlue() + 12);
+    }
+
+    // the HASON TECH block: the banner above the six solution cards, each with its tagline
+    uno::Reference<XAccessibleContext> xSolutions = region(u"HASON TECH digital transformation solutions");
+    CPPUNIT_ASSERT_EQUAL(sal_Int64(7), xSolutions->getAccessibleChildCount()); // and "Xem thêm"
+    const tools::Rectangle aSolutionsArea = bounds(xSolutions);
+    for (sal_Int64 i = 0; i < 6; ++i)
+    {
+        uno::Reference<XAccessibleContext> xCard = context(xSolutions->getAccessibleChild(i));
+        CPPUNIT_ASSERT(!xCard->getAccessibleDescription().isEmpty());
+        CPPUNIT_ASSERT(xCard->getAccessibleStateSet() & AccessibleStateType::SHOWING);
+        tools::Rectangle aCard = bounds(xCard);
+        aCard.Move(aSolutionsArea.Left(), aSolutionsArea.Top());
+        // a white card with rounded corners on the pale blue panel
+        CPPUNIT_ASSERT_EQUAL(COL_WHITE, xDev->GetPixel(Point(aCard.Left() + 3, aCard.Center().Y())));
+        const Color aCorner = xDev->GetPixel(aCard.TopLeft());
+        CPPUNIT_ASSERT_MESSAGE("rounded card corner", aCorner != COL_WHITE && isBluish(aCorner)
+                                                          && aCorner.GetRed() >= 0xE0);
+    }
+    // the banner: the toolkit child in the left column (the search field is in the centre)
+    vcl::Window* pBanner = nullptr;
+    for (sal_uInt16 i = 0; i < pCanvas->GetChildCount(); ++i)
+    {
+        vcl::Window* pChild = pCanvas->GetChild(i);
+        if (pChild->IsVisible() && pChild->GetPosPixel().X() < aSolutionsArea.Right())
+            pBanner = pChild;
+    }
+    CPPUNIT_ASSERT_MESSAGE("banner shown", pBanner);
+    const tools::Rectangle aBanner(pBanner->GetPosPixel(), pBanner->GetSizePixel());
+    tools::Rectangle aFirstCard = bounds(context(xSolutions->getAccessibleChild(0)));
+    aFirstCard.Move(aSolutionsArea.Left(), aSolutionsArea.Top());
+    // above the heading and the cards, exactly as wide as the two columns of cards
+    CPPUNIT_ASSERT(aBanner.Bottom() + 20 < aFirstCard.Top());
+    CPPUNIT_ASSERT_EQUAL(aSolutionsArea.Left(), aBanner.Left());
+    CPPUNIT_ASSERT_EQUAL(aSolutionsArea.GetWidth(), aBanner.GetWidth());
+    // 1366 x 707 at 100 %: the whole column fits, down to "Xem thêm các giải pháp khác →"
+    uno::Reference<XAccessibleContext> xMore = context(xSolutions->getAccessibleChild(6));
+    CPPUNIT_ASSERT(xMore->getAccessibleStateSet() & AccessibleStateType::SHOWING);
+    CPPUNIT_ASSERT(aSolutionsArea.Bottom() < aSize.Height());
+
+    // the Recent table and the Pinned card are white cards
+    const tools::Rectangle aRecent = bounds(region(u"Recent documents"));
+    CPPUNIT_ASSERT_EQUAL(COL_WHITE, xDev->GetPixel(Point(aRecent.Right() - 2, aRecent.Bottom() - 2)));
+    const tools::Rectangle aPinned = bounds(region(u"Pinned files"));
+    CPPUNIT_ASSERT_EQUAL(COL_WHITE, xDev->GetPixel(Point(aPinned.Left() + 2, aPinned.Bottom() - 2)));
+}
+}
