diff --git a/sfx2/inc/startcenter/hststartcentericons.hxx b/sfx2/inc/startcenter/hststartcentericons.hxx
new file mode 100644
index 0000000..33be1ab
--- /dev/null
+++ b/sfx2/inc/startcenter/hststartcentericons.hxx
@@ -0,0 +1,43 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * This file is part of HST Office.
+ */
+
+#pragma once
+
+#include <rtl/ustring.hxx>
+#include <sfx2/dllapi.h>
+#include <tools/long.hxx>
+#include <vcl/bitmap.hxx>
+
+#include <string_view>
+
+/* HST Office Start Center: the HST application icons (Văn bản, Bảng tính, Trình chiếu, Bản vẽ,
+   PDF) of the documents and the "create" tiles. They are the vector icons of the HST brand
+   (assets/brand/icons; tests/unit checks that the copies here stay identical), rendered for the
+   exact pixel size they are shown at, so they are sharp at every scale. */
+namespace sfx2::hst::startcenter
+{
+enum class AppIcon
+{
+    Writer,
+    Sheets,
+    Slides,
+    Draw,
+    Pdf,
+    None, ///< a file of no HST application: the theme's file icon is shown instead
+};
+
+/** The application of a document, by the extension of its URL. */
+SFX2_DLLPUBLIC AppIcon AppIconForURL(std::u16string_view aURL);
+
+/** The SVG source of an application icon (empty for AppIcon::None). */
+SFX2_DLLPUBLIC std::string_view AppIconSvg(AppIcon eIcon);
+
+/** The icon rendered as an nSize x nSize bitmap with transparency (empty if it cannot be rendered). */
+SFX2_DLLPUBLIC Bitmap RenderAppIcon(AppIcon eIcon, tools::Long nSize);
+}
