+DateTime toLocalDateTime(const TimeValue& rUTC)
+{
+    TimeValue aLocal;
+    oslDateTime aParts;
+    if (!osl_getLocalTimeFromSystemTime(&rUTC, &aLocal)
+        || !osl_getDateTimeFromTimeValue(&aLocal, &aParts))
+        return DateTime(DateTime::EMPTY);
+    return DateTime(Date(aParts.Day, aParts.Month, aParts.Year),
+                    tools::Time(aParts.Hours, aParts.Minutes, aParts.Seconds));
+}
+
+/** Modification time of a local file, empty for other schemes or when it cannot be read. */
+DateTime readModifyTime(const OUString& rURL)
+{
+    if (!rURL.startsWithIgnoreAsciiCase("file:"))
+        return DateTime(DateTime::EMPTY);
+    osl::DirectoryItem aItem;
+    osl::FileStatus aStatus(osl_FileStatus_Mask_ModifyTime);
+    if (osl::DirectoryItem::get(rURL, aItem) != osl::FileBase::E_None
+        || aItem.getFileStatus(aStatus) != osl::FileBase::E_None
+        || !aStatus.isValid(osl_FileStatus_Mask_ModifyTime))
+        return DateTime(DateTime::EMPTY);
+    return toLocalDateTime(aStatus.getModifyTime());
+}
+
+/** What the worker hands to the main thread. */
+struct TimesResult
+{
+    std::shared_ptr<RecentFileTimes::Guard> pGuard;
+    RecentFileTimes::Callback aCallback;
+    std::vector<DateTime> aTimes;
+};
+
+void deliverTimes(void*, void* pData)
+{
+    std::unique_ptr<TimesResult> pResult(static_cast<TimesResult*>(pData));
+    {
+        std::scoped_lock aLock(pResult->pGuard->aMutex);
+        if (pResult->pGuard->bCancelled)
+            return;
+    }
+    // main thread: Cancel() also runs here, so the window cannot go away during the call
+    pResult->aCallback(pResult->aTimes);
+}
+
+class TimesThread final : public salhelper::Thread
+{
+public:
+    TimesThread(std::vector<OUString> aURLs, std::shared_ptr<RecentFileTimes::Guard> pGuard,
+                RecentFileTimes::Callback aCallback)
+        : salhelper::Thread("HstStartCenterTimes")
+        , maURLs(std::move(aURLs))
+        , mpGuard(std::move(pGuard))
+        , maCallback(std::move(aCallback))
+    {
+    }
+
+private:
+    void execute() override
+    {
+        std::vector<DateTime> aTimes;
+        aTimes.reserve(maURLs.size());
+        for (const OUString& rURL : maURLs)
+        {
+            {
+                std::scoped_lock aLock(mpGuard->aMutex);
+                if (mpGuard->bCancelled)
+                    return;
+            }
+            aTimes.push_back(readModifyTime(rURL));
+        }
+        auto pResult = std::make_unique<TimesResult>(
+            TimesResult{ mpGuard, std::move(maCallback), std::move(aTimes) });
+        // posting under the guard: once Cancel() returned (before VCL shuts down) nothing is posted
+        std::scoped_lock aLock(mpGuard->aMutex);
+        if (mpGuard->bCancelled)
+            return;
+        if (Application::PostUserEvent(LINK_NONMEMBER(nullptr, deliverTimes), pResult.get()))
+            pResult.release();
+    }
+
+    std::vector<OUString> maURLs;
+    std::shared_ptr<RecentFileTimes::Guard> mpGuard;
+    RecentFileTimes::Callback maCallback;
+};
+}
+
+std::vector<RecentFile> LoadRecentFiles()
+{
+    std::vector<RecentFile> aFiles;
+    for (const SvtHistoryOptions::HistoryItem& rItem :
+         SvtHistoryOptions::GetList(EHistoryType::PickList))
+    {
+        if (rItem.sURL.isEmpty())
+            continue;
+        const INetURLObject aURL(rItem.sURL);
+        RecentFile aFile;
+        aFile.aURL = rItem.sURL;
+        aFile.aName = aURL.getName(INetURLObject::LAST_SEGMENT, true,
+                                   INetURLObject::DecodeMechanism::WithCharset);
+        if (aFile.aName.isEmpty())
+            aFile.aName = rItem.sTitle;
+        INetURLObject aFolder(aURL);
+        if (aFolder.removeSegment())
+        {
+            aFile.aFolderURL = aFolder.GetMainURL(INetURLObject::DecodeMechanism::NONE);
+            aFile.aFolder = aFolder.getName(INetURLObject::LAST_SEGMENT, true,
+                                            INetURLObject::DecodeMechanism::WithCharset);
+            aFile.aFolderPath = sfx2::hst::GetDisplayPath(aFile.aFolderURL);
+            if (aFile.aFolder.isEmpty()) // a file at the root of a drive
+                aFile.aFolder = aFile.aFolderPath;
+        }
+        aFile.aIcon = SvFileInformationManager::GetFileImageId(aURL); // by the extension: no disk access
+        aFile.aFolded = FoldForSearch(aFile.aName);
+        aFile.bPinned = rItem.isPinned;
+        aFile.bReadOnly = rItem.isReadOnly;
+        aFiles.push_back(std::move(aFile));
+    }
+    std::stable_partition(aFiles.begin(), aFiles.end(),
+                          [](const RecentFile& rFile) { return rFile.bPinned; });
+    return aFiles;
+}
+
+void RecentFileTimes::Start(std::vector<OUString> aURLs, Callback aCallback)
+{
+    Cancel();
+    mpGuard = std::make_shared<Guard>();
+    try
+    {
+        rtl::Reference<TimesThread> xThread(
+            new TimesThread(std::move(aURLs), mpGuard, std::move(aCallback)));
+        xThread->launch();
+    }
+    catch (const std::exception& rException)
+    {
+        // without the worker the column simply stays empty
+        SAL_WARN("sfx.startcenter", "file times not read: " << rException.what());
+    }
+}
+
+void RecentFileTimes::Cancel()
+{
+    if (!mpGuard)
+        return;
+    std::scoped_lock aLock(mpGuard->aMutex);
+    mpGuard->bCancelled = true;
+}
+}
