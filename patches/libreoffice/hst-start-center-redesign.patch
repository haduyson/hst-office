diff --git a/sfx2/source/startcenter/hststartcenterlayout.hxx b/sfx2/source/startcenter/hststartcenterlayout.hxx
new file mode 100644
index 0000000..546696d
--- /dev/null
+++ b/sfx2/source/startcenter/hststartcenterlayout.hxx
@@ -0,0 +1,161 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * This file is part of HST Office.
+ */
+
+#pragma once
+
+#include <tools/gen.hxx>
+
+#include <array>
+
+/* HST Office Start Center: the geometry of the canvas. ComputeLayout() turns the window size, the
+   DPI scale and the heights of the fonts into the rectangle of every part (the left panel with its
+   menu and the HASON TECH solutions, the centre with the heading, search field, tiles and the Recent
+   table, the Pinned card at the right). The painting, the mouse, the keyboard and the accessibility
+   objects all read the same Layout, so what is drawn is what is hit and what is announced. All
+   rectangles are in the canvas's device pixels; the left column is already moved by its scroll. */
+namespace sfx2::hst::startcenter
+{
+constexpr int NAV_COUNT = 7;
+constexpr int TILE_COUNT = 3;
+constexpr int SOLUTION_COUNT = 6;
+/** The left column's width and padding, in layout pixels (inner width 260: two solution cards). */
+constexpr double LEFT_WIDTH = 292;
+constexpr double LEFT_PAD = 16;
+
+/** What a point of the canvas is: an item, a part of a row, or a scroll bar. */
+enum class Part
+{
+    None,
+    Nav,
+    Tile,
+    Recent, ///< a row of the Recent table (opens the file)
+    RecentPin, ///< the pin of a row
+    RecentMore, ///< the "⋯" of a row
+    Pinned, ///< an item of the Pinned card
+    Solution,
+    MoreSolutions,
+    RecentScroll,
+    PinnedScroll,
+    LeftScroll,
+};
+
+struct Hit
+{
+    Part ePart = Part::None;
+    int nIndex = -1;
+    bool operator==(const Hit&) const = default;
+};
+
+struct LayoutInput
+{
+    Size aSize; ///< the canvas
+    double fScale = 1.0; ///< device pixels per layout pixel
+    /** The scale the Pinned card's fold is decided at (0: fScale): the window's own scale, so that
+        fitting a short window by a smaller fScale does not bring the card back. */
+    double fModeScale = 0;
+    // heights of the text lines, in device pixels
+    tools::Long nBody = 16; ///< table rows, search text, pinned names
+    tools::Long nNav = 18; ///< the menu items
+    tools::Long nWelcome = 40; ///< "Chào mừng bạn quay lại"
+    tools::Long nTitle = 22; ///< "Tạo nhanh tài liệu mới", "Gần đây", "Được ghim"
+    tools::Long nSmall = 14; ///< solution taglines
+    tools::Long nCardTitle = 16; ///< solution names
+    tools::Long nRow = 18; ///< the names, dates and folders of the file lists
+    int nSolutionLines = 1; ///< lines of the longest solution tagline (they wrap, never cut)
+    tools::Long nSolutionsTitle = 36; ///< the HASON TECH heading, wrapped to the column
+    int nRecent = 0; ///< rows of the Recent table
+    int nPinned = 0; ///< items of the Pinned card
+    tools::Long nLeftScroll = 0; ///< wanted scroll of the left column (clamped)
+    int nRecentFirst = 0; ///< wanted first row of the Recent table (clamped)
+    int nPinnedFirst = 0; ///< wanted first item of the Pinned card (clamped)
+};
+
+struct Layout
+{
+    Size aSize;
+    double fScale = 1.0;
+    bool bCompact = false; ///< a narrow window: the menu shows glyphs only, no HASON TECH block
+    bool bShowRight = true; ///< a wide enough window for the Pinned card
+
+    tools::Rectangle aLeft; ///< the left panel (the visible part)
+    tools::Long nLeftContent = 0; ///< the height of the left column's content
+    tools::Long nLeftScroll = 0;
+    tools::Rectangle aLogo;
+    std::array<tools::Rectangle, NAV_COUNT> aNav;
+    tools::Rectangle aSeparator;
+    tools::Rectangle aSolutionsTitle;
+    std::array<tools::Rectangle, SOLUTION_COUNT> aSolutions;
+    tools::Rectangle aMore;
+
+    tools::Rectangle aCentre; ///< the column of the heading, search, tiles and Recent table
+    tools::Rectangle aWelcome;
+    tools::Rectangle aSearch; ///< the rounded field
+    tools::Rectangle aSearchIcon;
+    tools::Rectangle aSearchText; ///< where the text entry sits inside the field
+    tools::Rectangle aQuickTitle;
+    std::array<tools::Rectangle, TILE_COUNT> aTiles;
+    tools::Rectangle aRecentTitle;
+    tools::Rectangle aRecentCard;
+    tools::Rectangle aRecentHeader;
+    tools::Rectangle aRecentBody;
+    /** The height the centre needs: down to the Recent table with its header and two rows. */
+    tools::Long nCentreContent = 0;
+    tools::Long nRowHeight = 0;
+    int nRecent = 0;
+    int nRecentFirst = 0;
+    // the columns of the Recent table: left edges of the parts, in canvas x
+    tools::Long nColIcon = 0, nColName = 0, nColOpened = 0, nColFolderIcon = 0, nColFolder = 0,
+                nColPin = 0, nColMore = 0, nColEnd = 0;
+
+    tools::Rectangle aPinnedCard;
+    tools::Rectangle aPinnedTitle;
+    tools::Rectangle aPinnedBody;
+    tools::Long nPinnedHeight = 0;
+    int nPinned = 0;
+    int nPinnedFirst = 0;
+
+    tools::Rectangle RecentRow(int nRow) const;
+    tools::Rectangle RecentPin(int nRow) const;
+    tools::Rectangle RecentMore(int nRow) const;
+    tools::Rectangle PinnedItem(int nItem) const;
+    int RecentVisibleRows() const;
+    int PinnedVisibleItems() const;
+    /** The scroll bars: the track at the right edge of the area, empty when all of it fits. */
+    tools::Rectangle RecentScrollTrack() const;
+    tools::Rectangle PinnedScrollTrack() const;
+    tools::Rectangle LeftScrollTrack() const;
+    /** The parts of a menu item and of a tile, as painted: the glyph or icon, the room of the label. */
+    tools::Rectangle NavGlyph(int nItem) const;
+    tools::Rectangle NavText(int nItem) const;
+    tools::Rectangle TileIcon(int nTile) const;
+    tools::Rectangle TileChevron(int nTile) const;
+    tools::Rectangle TileText(int nTile) const;
+
+    Hit HitTest(const Point& rPos) const;
+    /** The rectangle of an item (Nav, Tile, Recent, Pinned, Solution, MoreSolutions). */
+    tools::Rectangle ItemRect(const Hit& rHit) const;
+
+    tools::Long px(double f) const { return static_cast<tools::Long>(f * fScale + 0.5); }
+};
+
+Layout ComputeLayout(const LayoutInput& rIn);
+/** The scale of the layout: the UI scale factor, or the display's DPI against 96 when that is larger.
+    The type is in points, so it grows with the DPI (Windows at 125 % keeps the UI factor at 1 while
+    the text grows by a quarter): the columns grow with it, and the text keeps fitting them. */
+double UiScale(double fDpiScaleFactor, double fDpiX);
+
+/** The width the tagline of a solution card wraps to, in device pixels. */
+tools::Long SolutionTextWidth(double fScale);
+/** Padding inside a solution card, in layout pixels: at the sides, and above and below. */
+constexpr double SOLUTION_PAD = 9;
+constexpr double SOLUTION_PAD_TOP = 6;
+/** The logo of a solution card, and the gap from it down to the name, in layout pixels. */
+constexpr double SOLUTION_LOGO = 20;
+constexpr double SOLUTION_NAME_GAP = 3;
+}
+
+/* vim:set shiftwidth=4 softtabstop=4 expandtab: */
