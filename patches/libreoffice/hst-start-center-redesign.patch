+
+#include "hststartcenterpaint.hxx"
+
+#include <basegfx/point/b2dpoint.hxx>
+#include <basegfx/polygon/b2dpolygon.hxx>
+#include <com/sun/star/drawing/LineCap.hpp>
+#include <vcl/outdev.hxx>
+
+#include <cmath>
+#include <initializer_list>
+
+namespace sfx2::hst::startcenter
+{
+namespace
+{
+/** Maps glyph coordinates (a 20 x 20 design grid) into the box. */
+class Grid
+{
+public:
+    explicit Grid(const tools::Rectangle& rBox)
+        : mfX(rBox.Left())
+        , mfY(rBox.Top())
+        , mfUnit(std::min(rBox.GetWidth(), rBox.GetHeight()) / 20.0)
+    {
+    }
+
+    basegfx::B2DPoint at(double fX, double fY) const
+    {
+        return basegfx::B2DPoint(mfX + fX * mfUnit, mfY + fY * mfUnit);
+    }
+
+    basegfx::B2DPolygon line(std::initializer_list<std::pair<double, double>> aPoints,
+                             bool bClosed = false) const
+    {
+        basegfx::B2DPolygon aPoly;
+        for (const auto& [fX, fY] : aPoints)
+            aPoly.append(at(fX, fY));
+        aPoly.setClosed(bClosed);
+        return aPoly;
+    }
+
+    basegfx::B2DPolygon arc(double fCX, double fCY, double fR, double fFromDeg, double fToDeg) const
+    {
+        basegfx::B2DPolygon aPoly;
+        const int nSteps = 32;
+        for (int i = 0; i <= nSteps; ++i)
+        {
+            const double fAngle = (fFromDeg + (fToDeg - fFromDeg) * i / nSteps) * M_PI / 180.0;
+            aPoly.append(at(fCX + fR * std::cos(fAngle), fCY + fR * std::sin(fAngle)));
+        }
+        return aPoly;
+    }
+
+    double unit() const { return mfUnit; }
+
+private:
+    double mfX;
+    double mfY;
+    double mfUnit;
+};
+
+void stroke(OutputDevice& rDev, const Grid& rGrid, const basegfx::B2DPolygon& rPoly)
+{
+    rDev.DrawPolyLine(rPoly, std::max(1.0, 1.5 * rGrid.unit()), basegfx::B2DLineJoin::Round,
+                      css::drawing::LineCap_ROUND);
+}
+
+void fill(OutputDevice& rDev, const basegfx::B2DPolygon& rPoly, const Color& rColor)
+{
+    rDev.SetLineColor();
+    rDev.SetFillColor(rColor);
+    rDev.DrawPolygon(rPoly);
+}
+
+}
+
+void DrawGlyph(OutputDevice& rDev, const tools::Rectangle& rBox, Glyph eGlyph, const Color& rColor,
+               bool bFilled)
+{
+    const Grid aGrid(rBox);
+    rDev.SetLineColor(rColor);
+    rDev.SetFillColor();
+    switch (eGlyph)
+    {
+        case Glyph::Home:
+            stroke(rDev, aGrid, aGrid.line({ { 2, 10 }, { 10, 3 }, { 18, 10 } }));
+            stroke(rDev, aGrid, aGrid.line({ { 4.5, 8.5 }, { 4.5, 17 }, { 15.5, 17 }, { 15.5, 8.5 } }));
+            stroke(rDev, aGrid, aGrid.line({ { 8.5, 17 }, { 8.5, 12 }, { 11.5, 12 }, { 11.5, 17 } }));
+            break;
+        case Glyph::NewDocument:
+            stroke(rDev, aGrid,
+                   aGrid.line({ { 4.5, 2 }, { 11.5, 2 }, { 15.5, 6 }, { 15.5, 18 }, { 4.5, 18 } }, true));
+            stroke(rDev, aGrid, aGrid.line({ { 11.5, 2 }, { 11.5, 6 }, { 15.5, 6 } }));
+            stroke(rDev, aGrid, aGrid.line({ { 10, 9 }, { 10, 15 } }));
+            stroke(rDev, aGrid, aGrid.line({ { 7, 12 }, { 13, 12 } }));
+            break;
+        case Glyph::Open:
+            stroke(rDev, aGrid,
+                   aGrid.line({ { 2, 4.5 }, { 7.5, 4.5 }, { 9.5, 6.5 }, { 18, 6.5 }, { 18, 16 }, { 2, 16 } },
+                              true));
+            stroke(rDev, aGrid, aGrid.line({ { 2, 9 }, { 18, 9 } }));
+            break;
+        case Glyph::Unsaved:
+            // a page with a small clock: kept documents waiting to be recovered
+            stroke(rDev, aGrid, aGrid.line({ { 10, 18 }, { 3.5, 18 }, { 3.5, 2 }, { 10.5, 2 }, { 14.5, 6 }, { 14.5, 9 } }));
+            stroke(rDev, aGrid, aGrid.line({ { 10.5, 2 }, { 10.5, 6 }, { 14.5, 6 } }));
+            stroke(rDev, aGrid, aGrid.arc(14.5, 14.5, 4.5, 0, 360));
+            stroke(rDev, aGrid, aGrid.line({ { 14.5, 12 }, { 14.5, 14.5 }, { 16.5, 15.5 } }));
+            break;
+        case Glyph::Recent:
+            stroke(rDev, aGrid, aGrid.arc(10, 10, 7.5, 0, 360));
+            stroke(rDev, aGrid, aGrid.line({ { 10, 5.5 }, { 10, 10 }, { 13.5, 12 } }));
+            break;
+        case Glyph::Pinned:
+        {
+            // a push pin leaning to the left: head at the top right, needle to the bottom left
+            const basegfx::B2DPolygon aPin = aGrid.line(
+                { { 12, 2.5 }, { 17.5, 8 }, { 15.5, 9 }, { 12, 12.5 }, { 12.5, 15.5 }, { 4.5, 7.5 },
+                  { 7.5, 8 }, { 11, 4.5 } },
+                true);
+            if (bFilled)
+                fill(rDev, aPin, rColor);
+            rDev.SetLineColor(rColor);
+            stroke(rDev, aGrid, aPin);
+            stroke(rDev, aGrid, aGrid.line({ { 8.5, 11.5 }, { 3, 17 } }));
+            break;
+        }
+        case Glyph::Update:
+        {
+            stroke(rDev, aGrid, aGrid.arc(10, 10, 7, -60, 240));
+            // arrow head at the start of the arc (the upper right)
+            const basegfx::B2DPoint aTip = aGrid.at(10 + 7 * std::cos(-M_PI / 3), 10 + 7 * std::sin(-M_PI / 3));
+            basegfx::B2DPolygon aHead;
+            aHead.append(basegfx::B2DPoint(aTip.getX() - 4 * aGrid.unit(), aTip.getY()));
+            aHead.append(aTip);
+            aHead.append(basegfx::B2DPoint(aTip.getX(), aTip.getY() - 4 * aGrid.unit()));
+            stroke(rDev, aGrid, aHead);
+            break;
+        }
+        case Glyph::More:
+            for (double fX : { 4.0, 10.0, 16.0 })
+                fill(rDev, aGrid.arc(fX, 10, 1.6, 0, 360), rColor);
+            break;
+        case Glyph::Chevron:
+            stroke(rDev, aGrid, aGrid.line({ { 8, 5 }, { 13, 10 }, { 8, 15 } }));
+            break;
+        case Glyph::Search:
+            stroke(rDev, aGrid, aGrid.arc(8.5, 8.5, 5.5, 0, 360));
+            stroke(rDev, aGrid, aGrid.line({ { 12.5, 12.5 }, { 17.5, 17.5 } }));
+            break;
+        case Glyph::ExternalLink:
+            stroke(rDev, aGrid, aGrid.line({ { 6, 14 }, { 14, 6 } }));
+            stroke(rDev, aGrid, aGrid.line({ { 7.5, 6 }, { 14, 6 }, { 14, 12.5 } }));
+            break;
+    }
+}
+
+}
