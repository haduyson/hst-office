+    css::uno::Reference<css::datatransfer::dnd::XDropTarget> mxDropTarget;
+    css::uno::Reference<css::datatransfer::dnd::XDropTargetListener> mxDropListener;
+    std::unique_ptr<svt::AcceleratorExecute> mpAccExec;
