diff --git a/include/vcl/hst/drawhelpers.hxx b/include/vcl/hst/drawhelpers.hxx
new file mode 100644
index 0000000..a707849
--- /dev/null
+++ b/include/vcl/hst/drawhelpers.hxx
@@ -0,0 +1,57 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * This file is part of HST Office.
+ */
+
+#pragma once
+
+#include <tools/color.hxx>
+#include <tools/gen.hxx>
+#include <vcl/dllapi.h>
+
+class Bitmap;
+class OutputDevice;
+
+/* The shapes of the HST look, drawn with anti-aliased vectors so they are alike on every platform
+   and at every scale. fScale is the window's DPI scale; the colours and measures come from
+   <vcl/hst/designtokens.hxx>. */
+namespace hst::design
+{
+struct Palette;
+
+/** A rounded rectangle filled with rFill and outlined with rBorder (COL_TRANSPARENT: none). */
+VCL_DLLPUBLIC void DrawRoundRect(OutputDevice& rDev, const tools::Rectangle& rRect, double fRadius,
+                                 const Color& rFill, const Color& rBorder, double fBorderWidth = 1.0);
+
+/** A card: its shadow, its fill and its border, with the card radius. */
+VCL_DLLPUBLIC void DrawCard(OutputDevice& rDev, const tools::Rectangle& rRect, const Palette& rPalette,
+                            double fScale);
+
+/** The soft shadow below a card of radius fRadius. */
+VCL_DLLPUBLIC void DrawCardShadow(OutputDevice& rDev, const tools::Rectangle& rRect, double fRadius,
+                                  const Palette& rPalette, double fScale);
+
+/** A pill: the background of a selected (bSelected) or hovered navigation item. */
+VCL_DLLPUBLIC void DrawPill(OutputDevice& rDev, const tools::Rectangle& rRect, const Palette& rPalette,
+                            bool bSelected, double fScale);
+
+/** A badge: an icon (a rendered application icon) centred in rBox at its own pixel size, never
+    scaled, so it stays crisp. */
+VCL_DLLPUBLIC void DrawBadge(OutputDevice& rDev, const tools::Rectangle& rBox, const Bitmap& rIcon);
+
+/** The keyboard focus ring around rRect, an item of radius fRadius. */
+VCL_DLLPUBLIC void DrawFocusRing(OutputDevice& rDev, const tools::Rectangle& rRect, double fRadius,
+                                 const Palette& rPalette, double fScale);
+
+/** The window background: the diagonal gradient and the large soft curve at the top right. */
+VCL_DLLPUBLIC void DrawBackground(OutputDevice& rDev, const tools::Rectangle& rArea,
+                                  const Palette& rPalette, double fScale);
+
+/** A side panel: a vertical gradient of the side colour. */
+VCL_DLLPUBLIC void DrawSidePanel(OutputDevice& rDev, const tools::Rectangle& rArea,
+                                 const Palette& rPalette);
+}
+
