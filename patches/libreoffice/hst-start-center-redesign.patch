+CPPUNIT_TEST_FIXTURE(HstStartCenterTest, testReloadKeepsFocusedFile)
+{
+    // A file leaves the history (Remove from list in a row's menu) while another row has the
+    // focus: the focus stays on the file it was on. The focused file used to be looked up with
+    // the rows of the old list in the new list, so it landed on another file, or past the new
+    // list's end when the last row had the focus, and the office crashed.
+    openStartCenter();
+    canvas()->GrabFocus();
+    Scheduler::ProcessEventsToIdle();
+    key(KEY_TAB); // the search field
+    key(KEY_TAB); // the tiles
+    key(KEY_TAB); // the recent documents
+    CPPUNIT_ASSERT_EQUAL(u"Recent documents"_ustr, focused().first);
+    key(KEY_DOWN);
+    const std::vector<OUString> aBefore = recentNames(region(u"Recent documents"));
+    CPPUNIT_ASSERT_EQUAL(size_t(3), aBefore.size());
+    CPPUNIT_ASSERT_EQUAL(aBefore[1], focused().second);
+
+    // the file above the focused one leaves the history; the Start Center reads it again
+    SvtHistoryOptions::DeleteItem(EHistoryType::PickList, fileURL(aBefore[0]));
+    dispatchToStartCenter(u"vnd.org.libreoffice.recentdocs:ClearRecentFileList"_ustr);
+    CPPUNIT_ASSERT_EQUAL(sal_Int64(2), rows(u"Recent documents"));
+    CPPUNIT_ASSERT_EQUAL(u"Recent documents"_ustr, focused().first);
+    CPPUNIT_ASSERT_EQUAL(aBefore[1], focused().second);
+}
