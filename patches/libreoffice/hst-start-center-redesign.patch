+/** A hidden window that only carries an id automation knows (writer_all, open_all...): "CLICK" on
+    its UI test object runs the action. */
+class ActionWindow final : public vcl::Window
+{
+public:
+    ActionWindow(vcl::Window* pParent, const OUString& rId, std::function<void()> aAction)
+        : vcl::Window(pParent, 0)
+        , maAction(std::move(aAction))
+    {
+        set_id(rId);
+    }
+    void Run() const
+    {
+        if (maAction)
+            maAction();
+    }
+    virtual FactoryFunction GetUITestFactory() const override;
+
+private:
+    std::function<void()> maAction;
+};
+
+class ActionUIObject final : public WindowUIObject
+{
+public:
+    explicit ActionUIObject(const VclPtr<ActionWindow>& xWindow)
+        : WindowUIObject(xWindow)
+        , mxAction(xWindow)
+    {
+    }
+    virtual void execute(const OUString& rAction, const StringMap& rParameters) override
+    {
+        if (rAction == "CLICK")
+            mxAction->Run();
+        else
+            WindowUIObject::execute(rAction, rParameters);
+    }
+    static std::unique_ptr<UIObject> create(vcl::Window* pWindow)
+    {
+        return std::make_unique<ActionUIObject>(static_cast<ActionWindow*>(pWindow));
+    }
+
+protected:
+    virtual OUString get_name() const override { return u"HstStartCenterActionUIObject"_ustr; }
+
+private:
+    VclPtr<ActionWindow> mxAction;
+};
+
+FactoryFunction ActionWindow::GetUITestFactory() const { return ActionUIObject::create; }
