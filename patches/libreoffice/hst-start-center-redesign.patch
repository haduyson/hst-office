+void StartCenterActions::Activate(const Hit& rHit, bool bPin)
+{
+    const tools::Rectangle aAt = mrWindow.mxCanvas->GetLayout().ItemRect(rHit);
+    switch (rHit.ePart)
+    {
+        case Part::Nav:
+            mrWindow.PostAction(u"nav"_ustr, OUString(), rHit.nIndex, aAt);
+            break;
+        case Part::Tile:
+            mrWindow.PostAction(u"tile"_ustr, OUString(), rHit.nIndex);
+            break;
+        case Part::Recent:
+        case Part::Pinned:
+            if (const RecentFile* pFile = mrWindow.mxCanvas->ItemFile(rHit))
+                mrWindow.PostAction(bPin ? u"pin"_ustr : u"open"_ustr, pFile->aURL, -1);
+            break;
+        case Part::Solution:
+            mrWindow.OpenSolution(rHit.nIndex);
+            break;
+        case Part::MoreSolutions:
+            mrWindow.OpenSolution(-1);
+            break;
+        default:
+            break;
+    }
+}
