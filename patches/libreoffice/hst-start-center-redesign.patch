+struct ImplDispatch
+{
+    uno::Reference<frame::XDispatch> xDispatch;
+    util::URL aURL;
+    uno::Sequence<beans::PropertyValue> aArgs;
+};
+
+void dispatchLater(void*, void* pData)
+{
+    std::unique_ptr<ImplDispatch> pDispatch(static_cast<ImplDispatch*>(pData));
+    try
+    {
+        pDispatch->xDispatch->dispatch(pDispatch->aURL, pDispatch->aArgs);
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("sfx.startcenter", "dispatch of " << pDispatch->aURL.Complete);
+    }
+}
