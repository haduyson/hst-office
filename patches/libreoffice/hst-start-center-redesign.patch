diff --git a/sfx2/source/startcenter/hststartcentercanvas.cxx b/sfx2/source/startcenter/hststartcentercanvas.cxx
new file mode 100644
index 0000000..c46e207
--- /dev/null
+++ b/sfx2/source/startcenter/hststartcentercanvas.cxx
@@ -0,0 +1,924 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * This file is part of HST Office.
+ */
+
+// The Start Center canvas: layout, the model of what it shows, mouse, keyboard, scrolling and
+// tooltips. The painting is in hststartcentercanvaspaint.cxx, the accessibility objects in
+// hststartcenteraccessible.cxx.
+
+#include "hststartcentercanvas.hxx"
+#include "hststartcenteraccessible.hxx"
+
+#include "../backstage/hstbackstagedata.hxx"
+#include <startcenter/hststartcentericons.hxx>
+#include <startcenter/hststartcenterlogos.hxx>
+
+#include <sal/log.hxx>
+#include <sfx2/app.hxx>
+#include <vcl/commandevent.hxx>
+#include <vcl/event.hxx>
+#include <vcl/help.hxx>
+#include <vcl/ptrstyle.hxx>
+#include <vcl/settings.hxx>
+
+#include <algorithm>
+
+namespace sfx2::hst::startcenter
+{
+namespace design = ::hst::design;
+
+namespace
+{
+/** A part that is a whole item for focus and activation (the pin and "⋯" belong to their row). */
+Hit itemOf(const Hit& rHit)
+{
+    if (rHit.ePart == Part::RecentPin || rHit.ePart == Part::RecentMore)
+        return { Part::Recent, rHit.nIndex };
+    return rHit;
+}
+
+/** The smallest share of its size the Start Center shrinks to so that a small window still shows all
+    of it; a window too small even then scrolls the left column. */
+constexpr double MIN_FIT = 0.6;
+/** Halving steps of the search for the largest fitting share (it ends within 0.4 % of it). */
+constexpr int FIT_STEPS = 7;
+
+bool isItem(Part ePart)
+{
+    switch (ePart)
+    {
+        case Part::Nav:
+        case Part::Tile:
+        case Part::Recent:
+        case Part::RecentPin:
+        case Part::RecentMore:
+        case Part::Pinned:
+        case Part::Solution:
+        case Part::MoreSolutions:
+            return true;
+        default:
+            return false;
+    }
+}
+}
+
+HstStartCenterCanvas::HstStartCenterCanvas(vcl::Window* pParent, CanvasListener& rListener)
+    : Control(pParent, WB_TABSTOP | WB_CLIPCHILDREN)
+    , mrListener(rListener)
+{
+    SetBackground(); // every pixel is painted
+    RequestDoubleBuffering(true);
+    UpdatePalette();
+}
+
+HstStartCenterCanvas::~HstStartCenterCanvas() { disposeOnce(); }
+
+void HstStartCenterCanvas::dispose()
+{
+    if (mxAccessible.is())
+    {
+        mxAccessible->CanvasDisposed();
+        mxAccessible.clear();
+    }
+    maIcons.clear();
+    mxSearchWindow.reset();
+    // The double buffering asked for in the constructor belongs to the whole frame, not to the canvas,
+    // and the frame stays when a document replaces the Start Center in it. Left on, it is copied over
+    // what a window paints straight onto itself instead of into its render context: Sheets' grid, with
+    // its cells, grid lines and cell cursor, stayed blank. Give it back and repaint the frame, in case
+    // the document painted before the Start Center went away.
+    if (SupportsDoubleBuffering())
+    {
+        RequestDoubleBuffering(false);
+        if (vcl::Window* pFrame = GetFrameWindow(); pFrame && !pFrame->isDisposed())
+            pFrame->Invalidate(InvalidateFlags::Children);
+    }
+    Control::dispose();
+}
+
+void HstStartCenterCanvas::SetTexts(CanvasTexts aTexts)
+{
+    maTexts = std::move(aTexts);
+    Relayout();
+    Invalidate();
+}
+
+void HstStartCenterCanvas::SetLogoWidth(int nWidth)
+{
+    mnLogoWidth = nWidth;
+    UpdateLogoWidth();
+    Invalidate();
+}
+
+void HstStartCenterCanvas::UpdateLogoWidth()
+{
+    // the logo shrinks with the layout of a small window
+    const int nWidth = static_cast<int>(mnLogoWidth * mfFit + 0.5);
+    if (nWidth == mnLogoShownWidth)
+        return;
+    mnLogoShownWidth = nWidth;
+    maLogo[0] = maLogo[1] = Bitmap();
+    mbLogoLoaded[0] = mbLogoLoaded[1] = false;
+}
+
+const Bitmap& HstStartCenterCanvas::Logo(bool bDark)
+{
+    // only the artwork of the theme shown is rendered (an SVG costs start-up time); the other one
+    // follows when the theme changes
+    const int i = bDark ? 1 : 0;
+    if (!mbLogoLoaded[i])
+    {
+        mbLogoLoaded[i] = true;
+        if (!SfxApplication::loadBrandSvg(bDark ? u"shell/logo-sc_inverted" : u"shell/logo-sc", maLogo[i],
+                                          mnLogoShownWidth))
+        {
+            if (bDark)
+                maLogo[1] = Logo(false);
+            else
+                SAL_WARN("sfx.startcenter", "no Start Center logo");
+        }
+    }
+    return maLogo[i];
+}
+
+void HstStartCenterCanvas::ModelChanged()
+{
+    // the focus stays on an existing item
+    const int nCount = ItemCount(maFocus.ePart);
+    if (maFocus.ePart != Part::None && maFocus.nIndex >= nCount)
+        maFocus = nCount > 0 ? Hit{ maFocus.ePart, nCount - 1 } : Hit{};
+    if (maHover.nIndex >= ItemCount(itemOf(maHover).ePart))
+        maHover = {};
+    Relayout();
+    Invalidate();
+    if (mxAccessible.is())
+        mxAccessible->ChildrenChanged();
+}
+
+void HstStartCenterCanvas::TimesChanged() { Invalidate(maLayout.aRecentBody); }
+
+void HstStartCenterCanvas::SetSearchFocused(bool bFocused)
+{
+    if (mbSearchFocused == bFocused)
+        return;
+    mbSearchFocused = bFocused;
+    tools::Rectangle aField(maLayout.aSearch);
+    aField.expand(maLayout.px(design::space::XS));
+    Invalidate(aField);
+}
+
+void HstStartCenterCanvas::UseFont(vcl::RenderContext& rDev, const ::hst::design::TypeStyle& rType) const
+{
+    // the type scale is in points, converted to the device's pixels without rounding to whole points;
+    // a window too small for the design's sizes takes the share of them the fit found
+    vcl::Font aFont = ::hst::design::MakePixelFont(GetSettings().GetStyleSettings(), rType, GetOutDev()->GetDPIY());
+    if (mfFont < 1.0)
+        aFont.SetFontSize(Size(0, std::max<tools::Long>(1, static_cast<tools::Long>(aFont.GetFontSize().Height() * mfFont + 0.5))));
+    rDev.SetFont(aFont);
+}
+
+void HstStartCenterCanvas::UpdatePalette()
+{
+    maPalette = ::hst::design::GetPalette(GetSettings().GetStyleSettings());
+}
+
+const Bitmap& HstStartCenterCanvas::Icon(int nKind, tools::Long nSize)
+{
+    auto aKey = std::make_pair(nKind, nSize);
+    auto it = maIcons.find(aKey);
+    if (it == maIcons.end())
+        it = maIcons.emplace(aKey, RenderAppIcon(static_cast<AppIcon>(nKind), nSize)).first;
+    return it->second;
+}
+
+const Bitmap& HstStartCenterCanvas::SolutionLogo(int nIndex, tools::Long nSize)
+{
+    // the logos share the cache with the application icons, after all of their kinds
+    constexpr int LOGO_KINDS = 1000;
+    auto aKey = std::make_pair(LOGO_KINDS + nIndex, nSize);
+    auto it = maIcons.find(aKey);
+    if (it == maIcons.end())
+        it = maIcons.emplace(aKey, RenderSolutionLogo(nIndex, nSize)).first;
+    return it->second;
+}
+
+LayoutInput HstStartCenterCanvas::MeasureInput(double fScale)
+{
+    OutputDevice& rDev = *GetOutDev();
+    auto aPop = rDev.ScopedPush(vcl::PushFlags::FONT);
+    LayoutInput aIn;
+    aIn.aSize = GetOutputSizePixel();
+    aIn.fScale = fScale;
+    UseFont(rDev, design::type::Body);
+    aIn.nBody = rDev.GetTextHeight();
+    UseFont(rDev, design::type::Nav);
+    aIn.nNav = rDev.GetTextHeight();
+    UseFont(rDev, design::type::Display);
+    aIn.nWelcome = rDev.GetTextHeight();
+    UseFont(rDev, design::type::Title);
+    aIn.nTitle = rDev.GetTextHeight();
+    UseFont(rDev, design::type::Row);
+    aIn.nRow = rDev.GetTextHeight();
+    UseFont(rDev, design::type::CardTitle);
+    aIn.nCardTitle = rDev.GetTextHeight();
+    UseFont(rDev, design::type::Caption);
+    aIn.nSmall = rDev.GetTextHeight();
+    // the taglines wrap within the cards: the cards are as tall as the longest needs
+    const tools::Long nTagline = SolutionTextWidth(aIn.fScale);
+    aIn.nSolutionLines = 1;
+    for (const OUString& rTagline : maTexts.aSolutionTagline)
+    {
+        const tools::Long nHeight
+            = rDev.GetTextRect(tools::Rectangle(Point(0, 0), Size(nTagline, 10000)), rTagline,
+                               DrawTextFlags::Left | DrawTextFlags::Top | DrawTextFlags::WordBreak
+                                   | DrawTextFlags::MultiLine)
+                  .GetHeight();
+        aIn.nSolutionLines = std::max<int>(aIn.nSolutionLines, (nHeight + aIn.nSmall / 2) / std::max<tools::Long>(1, aIn.nSmall));
+    }
+    UseFont(rDev, design::type::Strong);
+    // the heading wraps within the left column (its width without the panel's padding)
+    const tools::Long nColumn = static_cast<tools::Long>((LEFT_WIDTH - 2 * LEFT_PAD) * aIn.fScale);
+    aIn.nSolutionsTitle
+        = rDev.GetTextRect(tools::Rectangle(Point(0, 0), Size(nColumn, 10000)), maTexts.aSolutionsTitle,
+                           DrawTextFlags::Left | DrawTextFlags::Top | DrawTextFlags::WordBreak
+                               | DrawTextFlags::MultiLine)
+              .GetHeight();
+    aIn.nRecent = static_cast<int>(maModel.aRecent.size());
+    aIn.nPinned = static_cast<int>(maModel.aPinned.size());
+    aIn.nLeftScroll = mnLeftScroll;
+    aIn.nRecentFirst = mnRecentFirst;
+    aIn.nPinnedFirst = mnPinnedFirst;
+    return aIn;
+}
+
+double HstStartCenterCanvas::LeftTextRoom(const Layout& rLayout)
+{
+    // the one-line labels of the left column: the menu (in the selected item's bold, the widest) and
+    // the names of the solution cards. The column grows with the type, so only a platform's type
+    // that runs wider than the design's leaves them too little room; then the type alone shrinks.
+    if (rLayout.bCompact)
+        return 1.0;
+    OutputDevice& rDev = *GetOutDev();
+    auto aPop = rDev.ScopedPush(vcl::PushFlags::FONT);
+    double fRoom = 1.0;
+    const auto fit = [&fRoom](tools::Long nRoom, tools::Long nWidth) {
+        if (nWidth > nRoom && nWidth > 0)
+            fRoom = std::min(fRoom, std::max<double>(nRoom, 1) / nWidth);
+    };
+    UseFont(rDev, design::type::NavSelected);
+    for (int i = 0; i < NAV_COUNT; ++i)
+        fit(rLayout.NavText(i).GetWidth(), rDev.GetTextWidth(maTexts.aNav[i]));
+    UseFont(rDev, design::type::CardTitle);
+    for (const OUString& rName : maTexts.aSolutionName)
+        fit(SolutionTextWidth(rLayout.fScale), rDev.GetTextWidth(rName));
+    return fRoom;
+}
+
+bool HstStartCenterCanvas::Fits(const Layout& rLayout)
+{
+    // every part shows whole: the left column without scrolling, the centre down to two rows of the
+    // Recent table inside the window, and the one-line texts of the centre without an ellipsis
+    const Size aSize = GetOutputSizePixel();
+    if (rLayout.bCompact || rLayout.nLeftContent > aSize.Height() || rLayout.nCentreContent > aSize.Height()
+        || rLayout.aRecentCard.Right() >= aSize.Width())
+        return false;
+    OutputDevice& rDev = *GetOutDev();
+    auto aPop = rDev.ScopedPush(vcl::PushFlags::FONT);
+    UseFont(rDev, design::type::Display);
+    if (rDev.GetTextWidth(maTexts.aWelcome) > rLayout.aWelcome.GetWidth())
+        return false;
+    UseFont(rDev, design::type::Title);
+    const OUString& rRecentTitle = maModel.bPinnedOnly ? maTexts.aPinnedTitle : maTexts.aRecentTitle;
+    if (rDev.GetTextWidth(maTexts.aQuickTitle) > rLayout.aQuickTitle.GetWidth()
+        || rDev.GetTextWidth(rRecentTitle) > rLayout.aRecentTitle.GetWidth())
+        return false;
+    UseFont(rDev, design::type::Subtitle);
+    for (int i = 0; i < TILE_COUNT; ++i)
+        if (rDev.GetTextWidth(maTexts.aTiles[i]) > rLayout.TileText(i).GetWidth())
+            return false;
+    return true;
+}
+
+Layout HstStartCenterCanvas::LayoutAt(double fBaseScale, double fFit)
+{
+    // the layout at a share of the design's size: its measures and its type; the type shrinks
+    // further when the left column's labels need it (LeftTextRoom)
+    mfFit = fFit;
+    mfFont = fFit;
+    LayoutInput aIn = MeasureInput(fBaseScale * fFit);
+    aIn.fModeScale = fBaseScale;
+    Layout aLayout = ComputeLayout(aIn);
+    for (int nTry = 0; nTry < 3; ++nTry)
+    {
+        const double fRoom = LeftTextRoom(aLayout);
+        if (fRoom >= 1.0)
+            break;
+        // a little below the measured share: the type does not shrink exactly in proportion
+        mfFont = std::max(MIN_FIT * MIN_FIT, mfFont * fRoom * 0.98);
+        aIn = MeasureInput(fBaseScale * fFit);
+        aIn.fModeScale = fBaseScale;
+        aLayout = ComputeLayout(aIn);
+    }
+    return aLayout;
+}
+
+void HstStartCenterCanvas::Relayout()
+{
+    const double fBaseScale = UiScale(GetDPIScaleFactor(), GetOutDev()->GetDPIX());
+    const Size aSize = GetOutputSizePixel();
+    Layout aLayout = LayoutAt(fBaseScale, 1.0);
+    if (aSize.Width() > 0 && aSize.Height() > 0 && !Fits(aLayout))
+    {
+        // a window too small for the design's sizes: the largest share of them at which all of the
+        // Start Center shows, its measures, icons, spacing and type alike
+        double fLow = MIN_FIT, fHigh = 1.0;
+        Layout aSmall = LayoutAt(fBaseScale, MIN_FIT);
+        const double fSmallFont = mfFont;
+        double fFound = MIN_FIT, fFoundFont = fSmallFont;
+        for (int nStep = 0; nStep < FIT_STEPS; ++nStep)
+        {
+            const double fMid = (fLow + fHigh) / 2;
+            Layout aTry = LayoutAt(fBaseScale, fMid);
+            if (Fits(aTry))
+            {
+                fLow = fMid;
+                fFound = fMid;
+                fFoundFont = mfFont;
+                aSmall = std::move(aTry);
+            }
+            else
+                fHigh = fMid;
+        }
+        aLayout = std::move(aSmall);
+        mfFit = fFound;
+        mfFont = fFoundFont;
+    }
+    maLayout = std::move(aLayout);
+    UpdateLogoWidth();
+    mnLeftScroll = maLayout.nLeftScroll;
+    mnRecentFirst = maLayout.nRecentFirst;
+    mnPinnedFirst = maLayout.nPinnedFirst;
+    mrListener.LayoutChanged();
+}
+
+void HstStartCenterCanvas::Resize()
+{
+    Control::Resize();
+    const bool bShowRight = maLayout.bShowRight;
+    const bool bCompact = maLayout.bCompact;
+    Relayout();
+    Invalidate();
+    if (!mxAccessible.is())
+        return;
+    // the Pinned card or the solutions come or go with the width
+    if (bShowRight != maLayout.bShowRight || bCompact != maLayout.bCompact)
+        mxAccessible->ChildrenChanged();
+    else
+        mxAccessible->VisibleDataChanged();
+}
+
+int HstStartCenterCanvas::ItemCount(Part ePart) const
+{
+    switch (ePart)
+    {
+        case Part::Nav:
+            return NAV_COUNT;
+        case Part::Tile:
+            return TILE_COUNT;
+        case Part::Recent:
+            return static_cast<int>(maModel.aRecent.size());
+        case Part::Pinned:
+            return maLayout.bShowRight ? static_cast<int>(maModel.aPinned.size()) : 0;
+        case Part::Solution:
+            return maLayout.bCompact ? 0 : SOLUTION_COUNT;
+        case Part::MoreSolutions:
+            return maLayout.bCompact ? 0 : 1;
+        default:
+            return 0;
+    }
+}
+
+bool HstStartCenterCanvas::HasRows(Part eRegion) const { return ItemCount(eRegion) > 0; }
+
+void HstStartCenterCanvas::DoAction(const Hit& rHit, int nAction)
+{
+    const bool bFile = rHit.ePart == Part::Recent || rHit.ePart == Part::Pinned;
+    if (nAction == 2 && bFile)
+        mrListener.ContextMenu(rHit, maLayout.ItemRect(rHit));
+    else
+        mrListener.Activate(rHit, nAction == 1 && bFile);
+}
+
+const RecentFile* HstStartCenterCanvas::ItemFile(const Hit& rHit) const
+{
+    const Hit aItem = itemOf(rHit);
+    if (aItem.nIndex < 0)
+        return nullptr;
+    if (aItem.ePart == Part::Recent && o3tl::make_unsigned(aItem.nIndex) < maModel.aRecent.size())
+        return &maModel.aFiles[maModel.aRecent[aItem.nIndex]];
+    if (aItem.ePart == Part::Pinned && o3tl::make_unsigned(aItem.nIndex) < maModel.aPinned.size())
+        return &maModel.aFiles[maModel.aPinned[aItem.nIndex]];
+    return nullptr;
+}
+
+OUString HstStartCenterCanvas::ItemName(const Hit& rHit) const
+{
+    const Hit aItem = itemOf(rHit);
+    if (aItem.nIndex < 0)
+        return OUString();
+    switch (aItem.ePart)
+    {
+        case Part::Nav:
+            return aItem.nIndex < NAV_COUNT ? maTexts.aNav[aItem.nIndex] : OUString();
+        case Part::Tile:
+            return aItem.nIndex < TILE_COUNT ? maTexts.aTiles[aItem.nIndex] : OUString();
+        case Part::Recent:
+        case Part::Pinned:
+        {
+            const RecentFile* pFile = ItemFile(aItem);
+            return pFile ? pFile->aName : OUString();
+        }
+        case Part::Solution:
+            return aItem.nIndex < SOLUTION_COUNT ? maTexts.aSolutionName[aItem.nIndex] : OUString();
+        case Part::MoreSolutions:
+            return maTexts.aMore;
+        default:
+            return OUString();
+    }
+}
+
+OUString HstStartCenterCanvas::ItemDescription(const Hit& rHit) const
+{
+    const Hit aItem = itemOf(rHit);
+    if (aItem.ePart == Part::Solution && aItem.nIndex >= 0 && aItem.nIndex < SOLUTION_COUNT)
+        return maTexts.aSolutionDescription[aItem.nIndex];
+    const RecentFile* pFile = ItemFile(aItem);
+    if (!pFile)
+        return OUString();
+    OUString aText = pFile->aFolderPath;
+    auto it = maModel.aTimes.find(pFile->aURL);
+    if (aItem.ePart == Part::Recent && it != maModel.aTimes.end())
+        aText += u" · " + sfx2::hst::FormatRecentDate(it->second, DateTime(DateTime::SYSTEM));
+    if (pFile->bPinned)
+        aText += u" · " + maTexts.aPinnedState;
+    return aText;
+}
+
+bool HstStartCenterCanvas::IsItemShowing(const Hit& rHit) const
+{
+    const Hit aItem = itemOf(rHit);
+    if (aItem.nIndex < 0 || aItem.nIndex >= ItemCount(aItem.ePart))
+        return false;
+    if (aItem.ePart == Part::Recent)
+        return aItem.nIndex >= maLayout.nRecentFirst
+               && aItem.nIndex < maLayout.nRecentFirst + maLayout.RecentVisibleRows();
+    if (aItem.ePart == Part::Pinned)
+        return aItem.nIndex >= maLayout.nPinnedFirst
+               && aItem.nIndex < maLayout.nPinnedFirst + maLayout.PinnedVisibleItems();
+    const tools::Rectangle aRect = maLayout.ItemRect(aItem);
+    return !aRect.IsEmpty() && aRect.Bottom() >= 0 && aRect.Top() < maLayout.aSize.Height();
+}
+
+void HstStartCenterCanvas::InvalidateItem(const Hit& rHit)
+{
+    if (rHit.ePart == Part::None)
+        return;
+    tools::Rectangle aRect = maLayout.ItemRect(itemOf(rHit));
+    if (aRect.IsEmpty())
+        return;
+    aRect.expand(maLayout.px(design::space::S)); // the focus ring, a card's shadow and its lift
+    Invalidate(aRect);
+}
+
+void HstStartCenterCanvas::SetHover(const Hit& rHit)
+{
+    if (rHit == maHover)
+        return;
+    InvalidateItem(maHover);
+    maHover = rHit;
+    InvalidateItem(maHover);
+}
+
+void HstStartCenterCanvas::SetFocusItem(const Hit& rHit)
+{
+    if (rHit == maFocus)
+        return;
+    const Hit aOld = maFocus;
+    InvalidateItem(aOld);
+    maFocus = rHit;
+    InvalidateItem(maFocus);
+    if (mxAccessible.is())
+        mxAccessible->FocusChanged(aOld, maFocus);
+}
+
+void HstStartCenterCanvas::EnsureVisible(const Hit& rHit)
+{
+    const Hit aItem = itemOf(rHit);
+    bool bScrolled = false;
+    if (aItem.ePart == Part::Recent)
+    {
+        const int nShown = maLayout.RecentVisibleRows();
+        const int nFirst = std::clamp(mnRecentFirst, aItem.nIndex - nShown + 1, aItem.nIndex);
+        bScrolled = nFirst != mnRecentFirst;
+        mnRecentFirst = nFirst;
+    }
+    else if (aItem.ePart == Part::Pinned)
+    {
+        const int nShown = maLayout.PinnedVisibleItems();
+        const int nFirst = std::clamp(mnPinnedFirst, aItem.nIndex - nShown + 1, aItem.nIndex);
+        bScrolled = nFirst != mnPinnedFirst;
+        mnPinnedFirst = nFirst;
+    }
+    else if (aItem.ePart == Part::Nav || aItem.ePart == Part::Solution || aItem.ePart == Part::MoreSolutions)
+    {
+        const tools::Rectangle aRect = maLayout.ItemRect(aItem);
+        tools::Long nScroll = mnLeftScroll;
+        if (aRect.Top() < maLayout.px(design::space::XS))
+            nScroll -= maLayout.px(design::space::XS) - aRect.Top();
+        else if (aRect.Bottom() > maLayout.aLeft.Bottom() - maLayout.px(design::space::XS))
+            nScroll += aRect.Bottom() - (maLayout.aLeft.Bottom() - maLayout.px(design::space::XS));
+        bScrolled = nScroll != mnLeftScroll;
+        mnLeftScroll = nScroll;
+    }
+    if (bScrolled)
+    {
+        Relayout();
+        Invalidate();
+        if (mxAccessible.is())
+            mxAccessible->VisibleDataChanged();
+    }
+}
+
+void HstStartCenterCanvas::FocusItem(const Hit& rHit, bool bKeyboard)
+{
+    // the focus ring shows once the keyboard is used (a click or the window's first focus keep it hidden)
+    if (bKeyboard)
+        mbKeyboardFocus = true;
+    SetFocusItem(itemOf(rHit));
+    EnsureVisible(rHit);
+    if (!HasFocus())
+        GrabFocus();
+}
+
+Hit HstStartCenterCanvas::FirstItem(Part eRegion) const
+{
+    if (ItemCount(eRegion) == 0)
+        return {};
+    switch (eRegion)
+    {
+        case Part::Nav:
+            return { Part::Nav, std::clamp(maModel.nSelectedNav, 0, NAV_COUNT - 1) };
+        case Part::Recent:
+            return { Part::Recent, std::clamp(mnRecentFirst, 0, ItemCount(Part::Recent) - 1) };
+        case Part::Pinned:
+            return { Part::Pinned, std::clamp(mnPinnedFirst, 0, ItemCount(Part::Pinned) - 1) };
+        default:
+            return { eRegion, 0 };
+    }
+}
+
+bool HstStartCenterCanvas::FocusRegion(Part eRegion, bool bKeyboard)
+{
+    const Hit aFirst = FirstItem(eRegion);
+    if (aFirst.ePart == Part::None)
+        return false;
+    FocusItem(aFirst, bKeyboard);
+    return true;
+}
+
+void HstStartCenterCanvas::SetSearchWindow(vcl::Window* pSearch)
+{
+    mxSearchWindow = pSearch;
+    if (mxAccessible.is())
+        mxAccessible->ChildrenChanged();
+}
+
+void HstStartCenterCanvas::FocusRegionBefore(Part eRegion)
+{
+    mbKeyboardFocus = true;
+    const std::vector<Part> aRegions = Regions();
+    auto it = std::find(aRegions.begin(), aRegions.end(), eRegion);
+    const int nCount = static_cast<int>(aRegions.size());
+    const int nAt = it == aRegions.end() ? 0 : static_cast<int>(it - aRegions.begin());
+    FocusRegion(aRegions[(nAt - 1 + nCount) % nCount]);
+}
+
+std::vector<Part> HstStartCenterCanvas::Regions() const
+{
+    // the Tab order; the search field (a child window) sits between the menu and the tiles
+    std::vector<Part> aRegions{ Part::Nav, Part::Tile };
+    for (Part ePart : { Part::Recent, Part::Pinned, Part::Solution, Part::MoreSolutions })
+        if (ItemCount(ePart) > 0)
+            aRegions.push_back(ePart);
+    return aRegions;
+}
+
+bool HstStartCenterCanvas::MoveFocus(int nDelta, bool bVertical)
+{
+    const Hit aFocus = maFocus;
+    const int nCount = ItemCount(aFocus.ePart);
+    if (nCount == 0)
+        return false;
+    int nNext = aFocus.nIndex;
+    switch (aFocus.ePart)
+    {
+        case Part::Nav:
+        case Part::Recent:
+        case Part::Pinned:
+            if (!bVertical)
+                return false;
+            nNext += nDelta;
+            break;
+        case Part::Tile:
+            if (bVertical)
+                return false;
+            nNext += nDelta;
+            break;
+        case Part::Solution:
+            nNext += bVertical ? 2 * nDelta : nDelta;
+            if (bVertical && nDelta > 0 && nNext >= nCount)
+            {
+                FocusItem({ Part::MoreSolutions, 0 });
+                return true;
+            }
+            break;
+        case Part::MoreSolutions:
+            if (bVertical && nDelta < 0)
+            {
+                FocusItem({ Part::Solution, SOLUTION_COUNT - 1 });
+                return true;
+            }
+            return false;
+        default:
+            return false;
+    }
+    nNext = std::clamp(nNext, 0, nCount - 1);
+    if (nNext != aFocus.nIndex)
+        FocusItem({ aFocus.ePart, nNext });
+    return true;
+}
+
+void HstStartCenterCanvas::Scroll(Part eArea, int nDelta)
+{
+    switch (eArea)
+    {
+        case Part::LeftScroll:
+            mnLeftScroll += nDelta;
+            break;
+        case Part::RecentScroll:
+            mnRecentFirst += nDelta;
+            break;
+        case Part::PinnedScroll:
+            mnPinnedFirst += nDelta;
+            break;
+        default:
+            return;
+    }
+    Relayout();
+    Invalidate();
+    if (mxAccessible.is())
+        mxAccessible->VisibleDataChanged();
+}
+
+void HstStartCenterCanvas::MouseMove(const MouseEvent& rMEvt)
+{
+    if (rMEvt.IsLeaveWindow())
+    {
+        SetHover({});
+        SetPointer(PointerStyle::Arrow);
+        return;
+    }
+    const Hit aHit = maLayout.HitTest(rMEvt.GetPosPixel());
+    const bool bItem = isItem(aHit.ePart);
+    SetHover(bItem ? aHit : Hit{});
+    SetPointer(bItem ? PointerStyle::RefHand : PointerStyle::Arrow);
+}
+
+void HstStartCenterCanvas::MouseButtonDown(const MouseEvent& rMEvt)
+{
+    if (!rMEvt.IsLeft())
+        return Control::MouseButtonDown(rMEvt);
+    mbKeyboardFocus = false;
+    const Point aPos = rMEvt.GetPosPixel();
+    const Hit aHit = maLayout.HitTest(aPos);
+    // a click on a scroll bar's track pages towards it
+    if (aHit.ePart == Part::RecentScroll || aHit.ePart == Part::PinnedScroll || aHit.ePart == Part::LeftScroll)
+    {
+        const bool bRecent = aHit.ePart == Part::RecentScroll;
+        const bool bLeft = aHit.ePart == Part::LeftScroll;
+        const tools::Rectangle aTrack = bLeft ? maLayout.LeftScrollTrack()
+                                        : bRecent ? maLayout.RecentScrollTrack()
+                                                  : maLayout.PinnedScrollTrack();
+        const bool bDown = aPos.Y() > aTrack.Center().Y();
+        if (bLeft)
+            Scroll(aHit.ePart, (bDown ? 1 : -1) * maLayout.aLeft.GetHeight() * 3 / 4);
+        else
+            Scroll(aHit.ePart, (bDown ? 1 : -1)
+                                   * (bRecent ? maLayout.RecentVisibleRows() : maLayout.PinnedVisibleItems()));
+        return;
+    }
+    maPressed = aHit;
+    if (isItem(aHit.ePart))
+    {
+        SetFocusItem(itemOf(aHit));
+        InvalidateItem(aHit);
+    }
+    if (!HasFocus())
+        GrabFocus();
+}
+
+void HstStartCenterCanvas::MouseButtonUp(const MouseEvent& rMEvt)
+{
+    if (!rMEvt.IsLeft())
+        return Control::MouseButtonUp(rMEvt);
+    const Hit aHit = maLayout.HitTest(rMEvt.GetPosPixel());
+    const Hit aPressed = maPressed;
+    maPressed = {};
+    InvalidateItem(aPressed);
+    if (aHit != aPressed || !isItem(aHit.ePart))
+        return;
+    if (aHit.ePart == Part::RecentPin)
+        mrListener.Activate({ Part::Recent, aHit.nIndex }, true);
+    else if (aHit.ePart == Part::RecentMore)
+        mrListener.ContextMenu({ Part::Recent, aHit.nIndex }, maLayout.RecentMore(aHit.nIndex));
+    else
+        mrListener.Activate(aHit, false);
+}
+
+void HstStartCenterCanvas::KeyInput(const KeyEvent& rKEvt)
+{
+    const vcl::KeyCode& rKey = rKEvt.GetKeyCode();
+    const bool bMod = rKey.IsMod1() || rKey.IsMod2();
+    if (bMod)
+        return Control::KeyInput(rKEvt);
+    mbKeyboardFocus = true;
+    if (maFocus.ePart == Part::None)
+    {
+        FocusRegion(Part::Nav);
+        if (rKey.GetCode() != KEY_TAB)
+            return;
+    }
+    switch (rKey.GetCode())
+    {
+        case KEY_TAB:
+        {
+            // the next region; the search field sits between the menu and the tiles
+            const int nDelta = rKey.IsShift() ? -1 : 1;
+            if ((maFocus.ePart == Part::Nav && nDelta > 0) || (maFocus.ePart == Part::Tile && nDelta < 0))
+                return mrListener.FocusSearch();
+            const std::vector<Part> aRegions = Regions();
+            auto it = std::find(aRegions.begin(), aRegions.end(), maFocus.ePart);
+            const int nAt = it == aRegions.end() ? 0 : static_cast<int>(it - aRegions.begin());
+            const int nCount = static_cast<int>(aRegions.size());
+            const Part eNext = aRegions[(nAt + nDelta + nCount) % nCount];
+            FocusRegion(eNext);
+            return;
+        }
+        case KEY_UP:
+            MoveFocus(-1, true);
+            return;
+        case KEY_DOWN:
+            MoveFocus(1, true);
+            return;
+        case KEY_LEFT:
+            MoveFocus(-1, false);
+            return;
+        case KEY_RIGHT:
+            MoveFocus(1, false);
+            return;
+        case KEY_HOME:
+            FocusItem({ maFocus.ePart, 0 });
+            return;
+        case KEY_END:
+            FocusItem({ maFocus.ePart, std::max(0, ItemCount(maFocus.ePart) - 1) });
+            return;
+        case KEY_PAGEUP:
+        case KEY_PAGEDOWN:
+        {
+            const int nPage = maFocus.ePart == Part::Pinned ? maLayout.PinnedVisibleItems()
+                                                            : maLayout.RecentVisibleRows();
+            const int nDelta = rKey.GetCode() == KEY_PAGEUP ? -nPage : nPage;
+            if (maFocus.ePart == Part::Recent || maFocus.ePart == Part::Pinned)
+                FocusItem({ maFocus.ePart,
+                            std::clamp(maFocus.nIndex + nDelta, 0, ItemCount(maFocus.ePart) - 1) });
+            return;
+        }
+        case KEY_RETURN:
+            if (maFocus.ePart != Part::None)
+                mrListener.Activate(maFocus, false);
+            return;
+        case KEY_SPACE:
+            // Space pins or unpins a file (the files open with Enter); it presses the other items
+            if (maFocus.ePart != Part::None)
+                mrListener.Activate(maFocus, maFocus.ePart == Part::Recent || maFocus.ePart == Part::Pinned);
+            return;
+        default:
+            break;
+    }
+    Control::KeyInput(rKEvt);
+}
+
+void HstStartCenterCanvas::Command(const CommandEvent& rCEvt)
+{
+    if (rCEvt.GetCommand() == CommandEventId::Wheel)
+    {
+        const CommandWheelData* pData = rCEvt.GetWheelData();
+        if (!pData || pData->GetMode() != CommandWheelMode::SCROLL)
+            return Control::Command(rCEvt);
+        const int nNotches = pData->GetNotchDelta() > 0 ? -1 : 1;
+        const Point aPos = rCEvt.GetMousePosPixel();
+        if (maLayout.aLeft.Contains(aPos))
+            Scroll(Part::LeftScroll, nNotches * maLayout.px(48));
+        else if (maLayout.aRecentBody.Contains(aPos))
+            Scroll(Part::RecentScroll, nNotches * 2);
+        else if (maLayout.bShowRight && maLayout.aPinnedCard.Contains(aPos))
+            Scroll(Part::PinnedScroll, nNotches);
+        return;
+    }
+    if (rCEvt.GetCommand() == CommandEventId::ContextMenu)
+    {
+        Hit aHit = maFocus;
+        tools::Rectangle aAt;
+        if (rCEvt.IsMouseEvent())
+        {
+            aHit = itemOf(maLayout.HitTest(rCEvt.GetMousePosPixel()));
+            aAt = tools::Rectangle(rCEvt.GetMousePosPixel(), Size(1, 1));
+            if (aHit.ePart == Part::Recent || aHit.ePart == Part::Pinned)
+                SetFocusItem(aHit);
+        }
+        else
+            aAt = maLayout.ItemRect(aHit);
+        if (aHit.ePart == Part::Recent || aHit.ePart == Part::Pinned)
+            mrListener.ContextMenu(aHit, aAt);
+        return;
+    }
+    Control::Command(rCEvt);
+}
+
+void HstStartCenterCanvas::RequestHelp(const HelpEvent& rHEvt)
+{
+    if (!(rHEvt.GetMode() & (HelpEventMode::QUICK | HelpEventMode::BALLOON)))
+        return Control::RequestHelp(rHEvt);
+    const Hit aHit = itemOf(maLayout.HitTest(ScreenToOutputPixel(rHEvt.GetMousePosPixel())));
+    OUString aText;
+    if (aHit.ePart == Part::Recent || aHit.ePart == Part::Pinned)
+        aText = ItemName(aHit) + u"\n" + ItemDescription(aHit); // the full name: the row may cut it
+    else if (aHit.ePart == Part::Solution)
+        aText = ItemName(aHit) + u" — " + ItemDescription(aHit);
+    else if (aHit.ePart == Part::Nav && maLayout.bCompact)
+        aText = ItemName(aHit);
+    if (aText.isEmpty())
+        return Control::RequestHelp(rHEvt);
+    const tools::Rectangle aRect = maLayout.ItemRect(aHit);
+    const Point aTopLeft = OutputToScreenPixel(aRect.TopLeft());
+    Help::ShowQuickHelp(this, tools::Rectangle(aTopLeft, aRect.GetSize()), aText);
+}
+
+void HstStartCenterCanvas::GetFocus()
+{
+    Control::GetFocus();
+    const GetFocusFlags nFlags = GetGetFocusFlags();
+    if (nFlags & GetFocusFlags::F6)
+        mbKeyboardFocus = true;
+    if (maFocus.ePart == Part::None)
+        SetFocusItem(FirstItem(Part::Nav));
+    else
+        InvalidateItem(maFocus);
+    if (mxAccessible.is())
+        mxAccessible->FocusChanged(Hit{}, maFocus);
+}
+
+void HstStartCenterCanvas::LoseFocus()
+{
+    InvalidateItem(maFocus);
+    if (mxAccessible.is())
+        mxAccessible->FocusChanged(maFocus, Hit{});
+    Control::LoseFocus();
+}
+
+void HstStartCenterCanvas::DataChanged(const DataChangedEvent& rDCEvt)
+{
+    Control::DataChanged(rDCEvt);
+    if ((rDCEvt.GetType() == DataChangedEventType::SETTINGS
+         && (rDCEvt.GetFlags() & AllSettingsFlags::STYLE))
+        || rDCEvt.GetType() == DataChangedEventType::FONTS)
+    {
+        UpdatePalette();
+        maIcons.clear();
+        Relayout();
+        Invalidate();
+    }
+}
+
+rtl::Reference<comphelper::OAccessible> HstStartCenterCanvas::CreateAccessible()
+{
+    if (!mxAccessible.is())
+        mxAccessible = new CanvasAccessible(*this);
+    return mxAccessible;
+}
+}
