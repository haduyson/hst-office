+
+void HstStartCenterWindow::InitSearch()
+{
+    mxSearchHost = VclPtr<ChildHost>::Create(mxCanvas.get(), u"sfx/ui/hststartcentersearch.ui"_ustr, u"SearchBox"_ustr);
+    mxSearch = mxSearchHost->GetBuilder().weld_entry(u"search"_ustr);
+    mxSearchHost->SetFocusWidget(mxSearch.get());
+    // the entry sits on the canvas's rounded field, in the field's colour
+    const ::hst::design::Palette& rPalette = ::hst::design::GetPalette(GetSettings().GetStyleSettings());
+    mxSearchHost->SetBackground(rPalette.aCard);
+    mxSearchHost->GetContainer().set_background(rPalette.aCard);
+    mxSearch->set_background(rPalette.aCard);
+    mxSearch->connect_changed(LINK(this, HstStartCenterWindow, SearchChangedHdl));
+    mxSearch->connect_activate(LINK(this, HstStartCenterWindow, SearchActivateHdl));
+    mxSearch->connect_focus_in(LINK(this, HstStartCenterWindow, SearchFocusHdl));
+    mxSearch->connect_focus_out(LINK(this, HstStartCenterWindow, SearchFocusHdl));
+    mxSearchHost->Show();
+}
+
+void HstStartCenterWindow::InitActionWindows()
+{
+    SvtModuleOptions aModules;
+    const bool bInstalled[] = { aModules.IsWriterInstalled(), aModules.IsCalcInstalled(),
+                                aModules.IsImpressInstalled(), aModules.IsDrawInstalled(),
+                                aModules.IsMathInstalled(),    aModules.IsDataBaseInstalled() };
+    for (size_t i = 0; i < std::size(aFactories); ++i)
+    {
+        const OUString aFactory = aFactories[i].second;
+        maActionWindows.push_back(VclPtr<ActionWindow>::Create(
+            this, aFactories[i].first, bInstalled[i] ? std::function<void()>([this, aFactory] {
+                CreateDocument(aFactory);
+            })
+                                                     : std::function<void()>()));
+    }
+    maActionWindows.push_back(
+        VclPtr<ActionWindow>::Create(this, u"open_all"_ustr, [this] { RunNav(NAV_OPEN); }));
+}
+
+
+void HstStartCenterWindow::Resize()
+{
+    vcl::Window::Resize();
+    if (mxCanvas)
+        mxCanvas->SetPosSizePixel(Point(0, 0), GetOutputSizePixel());
+}
+
+void HstStartCenterWindow::PlaceChildren()
+{
+    if (!mxCanvas || !mxSearchHost)
+        return;
+    const Layout& L = mxCanvas->GetLayout();
+    // the entry's type shrinks with the canvas's (its own font, untouched while the canvas has the
+    // design's size)
+    const double fFont = mxCanvas->GetFontShare();
+    if (mxSearch && std::abs(fFont - mfSearchFont) > 0.001)
+    {
+        if (!moSearchFont)
+            moSearchFont = mxSearch->get_font();
+        vcl::Font aFont(*moSearchFont);
+        if (fFont < 1.0)
+            aFont.SetFontSize(Size(0, std::max<tools::Long>(
+                                          1, static_cast<tools::Long>(aFont.GetFontSize().Height() * fFont + 0.5))));
+        mxSearch->set_font(aFont);
+        mfSearchFont = fFont;
+    }
+    mxSearchHost->SetPosSizePixel(L.aSearchText.TopLeft(), L.aSearchText.GetSize());
+    // the pinned files have their own card again once the window is wide enough
+    if (L.bShowRight && mxCanvas->GetModel().bPinnedOnly)
+    {
+        mxCanvas->GetModel().bPinnedOnly = false;
+        PostAction(u"refill"_ustr, OUString(), -1);
+    }
+}
+
+void HstStartCenterWindow::setOwningFrame(const uno::Reference<frame::XFrame>& xFrame)
+{
+    mxFrame = xFrame;
+    if (mxDropTarget.is() && !mxDropListener.is())
+    {
+        try
+        {
+            mxDropListener.set(new OpenFileDropTargetListener(
+                comphelper::getProcessComponentContext(), mxFrame));
+            mxDropTarget->addDropTargetListener(mxDropListener);
+            mxDropTarget->setActive(true);
+        }
+        catch (const uno::Exception&)
+        {
+            TOOLS_WARN_EXCEPTION("sfx.startcenter", "drop target");
+        }
+    }
+    uno::Reference<frame::XFramesSupplier> xFrames(mxDesktop, uno::UNO_QUERY);
+    if (xFrames.is())
+        xFrames->setActiveFrame(mxFrame);
+}
+
+void HstStartCenterWindow::Dispatch(const OUString& rURL, const OUString& rTarget, bool bViaFrame,
+                                    const uno::Sequence<beans::PropertyValue>& rArgs)
+{
+    uno::Reference<frame::XDispatchProvider> xProvider(
+        bViaFrame ? uno::Reference<frame::XDispatchProvider>(mxFrame, uno::UNO_QUERY) : mxDesktop);
+    if (!xProvider.is())
+        return;
+    try
+    {
+        auto pDispatch = std::make_unique<ImplDispatch>();
+        pDispatch->aURL.Complete = rURL;
+        util::URLTransformer::create(comphelper::getProcessComponentContext())
+            ->parseStrict(pDispatch->aURL);
+        pDispatch->xDispatch = xProvider->queryDispatch(pDispatch->aURL, rTarget, 0);
+        if (!pDispatch->xDispatch.is())
+        {
+            SAL_WARN("sfx.startcenter", "no dispatch for " << rURL);
+            return;
+        }
+        pDispatch->aArgs = rArgs;
+        // after this event returns: the dispatch may replace this window
+        if (Application::PostUserEvent(LINK_NONMEMBER(nullptr, dispatchLater), pDispatch.get()))
+            pDispatch.release();
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("sfx.startcenter", "dispatch of " << rURL);
+    }
+}
+
+void HstStartCenterWindow::CreateDocument(const OUString& rFactory)
+{
+    Dispatch(rFactory, u"_default"_ustr, false);
+}
+
+void HstStartCenterWindow::RunNav(int nIndex)
+{
+    CanvasModel& rModel = mxCanvas->GetModel();
+    switch (nIndex)
+    {
+        case NAV_HOME:
+            rModel.bPinnedOnly = false;
+            rModel.nSelectedNav = NAV_HOME;
+            mxSearch->set_text(OUString());
+            FillLists();
+            FocusSearch();
+            break;
+        case NAV_NEW:
+            ShowNewMenu(mxCanvas->GetLayout().ItemRect({ Part::Nav, NAV_NEW }));
+            break;
+        case NAV_OPEN:
+            Dispatch(u".uno:Open"_ustr, OUString(), true,
+                     { comphelper::makePropertyValue(u"Referer"_ustr, u"private:user"_ustr) });
+            break;
+        case NAV_UNSAVED:
+            // documents closed without saving, kept for 7 days (dialog of the bundled HST extension)
+            Dispatch(UNSAVED_DOCUMENTS, OUString(), true);
+            break;
+        case NAV_RECENT:
+            rModel.bPinnedOnly = false;
+            rModel.nSelectedNav = NAV_RECENT;
+            FillLists();
+            if (!mxCanvas->FocusRegion(Part::Recent))
+                mxCanvas->FocusItem({ Part::Nav, NAV_RECENT });
+            break;
+        case NAV_PINNED:
+            rModel.nSelectedNav = NAV_PINNED;
+            // no room for the Pinned card: the Recent table shows the pinned files
+            rModel.bPinnedOnly = !mxCanvas->GetLayout().bShowRight;
+            FillLists();
+            if (!mxCanvas->FocusRegion(rModel.bPinnedOnly ? Part::Recent : Part::Pinned))
+                mxCanvas->FocusItem({ Part::Nav, NAV_PINNED });
+            break;
+        case NAV_UPDATE:
+            Dispatch(UPDATE_CHECK, OUString(), true);
+            break;
+        default:
+            break;
+    }
+}
+
+void HstStartCenterWindow::ShowNewMenu(const tools::Rectangle& rAt)
+{
+    // every kind of document the installation can create, and the templates
+    SvtModuleOptions aModules;
+    ScopedVclPtrInstance<PopupMenu> xMenu;
+    const std::tuple<sal_uInt16, TranslateId, bool, OUString> aItems[] = {
+        { 1, STR_HST_SC_NEW_WRITER, aModules.IsWriterInstalled(), aFactories[0].second },
+        { 2, STR_HST_SC_NEW_CALC, aModules.IsCalcInstalled(), aFactories[1].second },
+        { 3, STR_HST_SC_NEW_IMPRESS, aModules.IsImpressInstalled(), aFactories[2].second },
+        { 4, STR_HST_SC_NEW_DRAW, aModules.IsDrawInstalled(), aFactories[3].second },
+    };
+    for (const auto& [nId, aText, bInstalled, rFactory] : aItems)
+        if (bInstalled)
+            xMenu->InsertItem(nId, menuText(aText));
+    xMenu->InsertSeparator();
+    xMenu->InsertItem(5, menuText(STR_HST_SC_NEW_TEMPLATE));
+    const sal_uInt16 nChoice = xMenu->Execute(mxCanvas.get(), rAt, PopupMenuFlags::ExecuteRight);
+    for (const auto& [nId, aText, bInstalled, rFactory] : aItems)
+        if (nChoice == nId)
+            return CreateDocument(rFactory);
+    if (nChoice == 5)
+        Dispatch(u".uno:NewDoc"_ustr, OUString(), true);
+}
+
+void HstStartCenterWindow::OpenSolution(int nIndex)
+{
+    const OUString aURL = nIndex >= 0 && nIndex < SOLUTION_COUNT ? aSolutions[nIndex].aURL : MORE_SOLUTIONS_URL;
+    try
+    {
+        system::SystemShellExecute::create(comphelper::getProcessComponentContext())
+            ->execute(aURL + "?" + SOLUTION_UTM, OUString(), system::SystemShellExecuteFlags::URIS_ONLY);
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("sfx.startcenter", "opening the HASON TECH page failed");
+    }
+}
+
+void HstStartCenterWindow::PostAction(const OUString& rAction, const OUString& rURL, int nIndex,
+                                      const tools::Rectangle& rAt)
+{
+    // the canvas's model is rebuilt by most actions: never inside its own event handlers
+    maPendingAction = rAction;
+    maPendingURL = rURL;
+    mnPendingIndex = nIndex;
+    maPendingAt = rAt;
+    if (!mpPendingEvent)
+        mpPendingEvent = Application::PostUserEvent(LINK(this, HstStartCenterWindow, PendingActionHdl));
+}
+
+IMPL_LINK_NOARG(HstStartCenterWindow, PendingActionHdl, void*, void)
+{
+    mpPendingEvent = nullptr;
+    const OUString aAction = std::exchange(maPendingAction, OUString());
+    const OUString aURL = maPendingURL;
+    if (aAction == "nav")
+        RunNav(mnPendingIndex);
+    else if (aAction == "tile" && mnPendingIndex >= 0 && mnPendingIndex < TILE_COUNT)
+        CreateDocument(aFactories[mnPendingIndex].second);
+    else if (aAction == "pin")
+        TogglePinned(aURL);
+    else if (aAction == "open")
+        OpenFile(aURL);
+    else if (aAction == "menu")
+        ShowFileMenu(aURL, maPendingAt);
+    else if (aAction == "refill")
+        FillLists();
+}
+
+bool HstStartCenterWindow::SearchHasFocus() const { return mxSearch && mxSearch->has_focus(); }
+
+void HstStartCenterWindow::FocusSearch()
+{
+    if (mxSearch)
+        mxSearch->grab_focus();
+}
+
+IMPL_LINK(HstStartCenterWindow, SearchFocusHdl, weld::Widget&, rWidget, void)
+{
+    if (mxCanvas)
+        mxCanvas->SetSearchFocused(rWidget.has_focus());
+}
+
+void HstStartCenterWindow::FocusRegion(int nDelta)
+{
+    // F6 regions: the menu, the search field, the recent table, the pinned card, the HASON TECH block
+    enum
+    {
+        MENU,
+        SEARCH,
+        RECENT,
+        PINNED,
+        SOLUTIONS
+    };
+    std::vector<int> aRegions{ MENU, SEARCH };
+    if (mxCanvas->HasRows(Part::Recent))
+        aRegions.push_back(RECENT);
+    if (mxCanvas->HasRows(Part::Pinned))
+        aRegions.push_back(PINNED);
+    if (mxCanvas->HasRows(Part::Solution))
+        aRegions.push_back(SOLUTIONS);
+    int nCurrent = -1;
+    if (SearchHasFocus())
+        nCurrent = SEARCH;
+    else if (mxCanvas->HasFocus())
+    {
+        switch (mxCanvas->GetFocusItem().ePart)
+        {
+            case Part::Recent:
+                nCurrent = RECENT;
+                break;
+            case Part::Pinned:
+                nCurrent = PINNED;
+                break;
+            case Part::Solution:
+            case Part::MoreSolutions:
+                nCurrent = SOLUTIONS;
+                break;
+            default:
+                nCurrent = MENU; // the tiles belong to the menu's region
+                break;
+        }
+    }
+    auto it = std::find(aRegions.begin(), aRegions.end(), nCurrent);
+    const int nCount = aRegions.size();
+    const int nAt = it == aRegions.end() ? -1 : static_cast<int>(it - aRegions.begin());
+    const int nNext = nAt < 0 ? 0 : (nAt + nDelta + nCount) % nCount;
+    switch (aRegions[nNext])
+    {
+        case MENU:
+            mxCanvas->FocusRegion(Part::Nav);
+            break;
+        case SEARCH:
+            FocusSearch();
+            break;
+        case RECENT:
+            mxCanvas->FocusRegion(Part::Recent);
+            break;
+        case PINNED:
+            mxCanvas->FocusRegion(Part::Pinned);
+            break;
+        case SOLUTIONS:
+            mxCanvas->FocusRegion(Part::Solution);
+            break;
+    }
+}
+
+bool HstStartCenterWindow::PreNotify(NotifyEvent& rNEvt)
+{
+    if (rNEvt.GetType() == NotifyEventType::KEYINPUT && mxCanvas)
+    {
+        const vcl::KeyCode& rKey = rNEvt.GetKeyEvent()->GetKeyCode();
+        if (rKey.GetCode() == KEY_F6 && !rKey.IsMod1() && !rKey.IsMod2())
+        {
+            FocusRegion(rKey.IsShift() ? -1 : 1);
+            return true;
+        }
+        // Tab out of the search field into the canvas's regions
+        if (rKey.GetCode() == KEY_TAB && !rKey.IsMod1() && !rKey.IsMod2())
+        {
+            if (SearchHasFocus())
+            {
+                if (rKey.IsShift())
+                    mxCanvas->FocusRegionBefore(Part::Tile);
+                else
+                    mxCanvas->FocusRegion(Part::Tile);
+                return true;
+            }
+        }
+        // the office's shortcuts (Ctrl+N, Ctrl+O, Ctrl+Q...), except the editing keys of the search field
+        const bool bTyping = SearchHasFocus()
+                             && (!rKey.IsMod1() || rKey.GetCode() == KEY_A || rKey.GetCode() == KEY_C
+                                 || rKey.GetCode() == KEY_V || rKey.GetCode() == KEY_X
+                                 || rKey.GetCode() == KEY_Z || rKey.GetCode() == KEY_Y);
+        if (!bTyping && mxFrame.is())
+        {
+            if (!mpAccExec)
+            {
+                mpAccExec = svt::AcceleratorExecute::createAcceleratorHelper();
+                mpAccExec->init(comphelper::getProcessComponentContext(), mxFrame);
+            }
+            const OUString aCommand
+                = mpAccExec->findCommand(svt::AcceleratorExecute::st_VCLKey2AWTKey(rKey));
+            if (aCommand != "vnd.sun.star.findbar:FocusToFindbar" && mpAccExec->execute(rKey))
+                return true;
+        }
+    }
+    return vcl::Window::PreNotify(rNEvt);
+}
+
+void HstStartCenterWindow::GetFocus()
+{
+    if (!mxCanvas)
+        return vcl::Window::GetFocus();
+    const GetFocusFlags nFlags = GetParent() ? GetParent()->GetGetFocusFlags() : GetFocusFlags::NONE;
+    // F6 from the menu bar: the first region; backwards: the last list
+    if ((nFlags & GetFocusFlags::F6) && !(nFlags & GetFocusFlags::Forward))
+    {
+        if (!mxCanvas->FocusRegion(Part::Recent))
+            mxCanvas->FocusRegion(Part::Nav);
+        return;
+    }
+    mxCanvas->FocusRegion(Part::Nav, false); // no focus ring before the keyboard is used
+}
+
