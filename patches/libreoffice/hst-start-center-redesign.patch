+void HstStartCenterWindow::InitSearch()
+{
+    mxSearchHost = VclPtr<ChildHost>::Create(mxCanvas.get(), u"SearchBox"_ustr);
+    mxSearch = mxSearchHost->GetBuilder().weld_entry(u"search"_ustr);
+    mxSearchHost->SetFocusWidget(mxSearch.get());
+    // the entry sits on the canvas's rounded field, in the field's colour
+    const ::hst::design::Palette& rPalette = ::hst::design::GetPalette(GetSettings().GetStyleSettings());
+    mxSearchHost->SetBackground(rPalette.aCard);
+    mxSearchHost->GetContainer().set_background(rPalette.aCard);
+    mxSearch->set_background(rPalette.aCard);
+    mxSearch->connect_changed(LINK(this, HstStartCenterWindow, SearchChangedHdl));
+    mxSearch->connect_activate(LINK(this, HstStartCenterWindow, SearchActivateHdl));
+    mxSearch->connect_focus_in(LINK(this, HstStartCenterWindow, SearchFocusHdl));
+    mxSearch->connect_focus_out(LINK(this, HstStartCenterWindow, SearchFocusHdl));
+    mxSearchHost->Show();
+}
