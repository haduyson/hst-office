+void HstStartCenterWindow::InitMenu()
+{
+    const std::pair<OUString, Glyph> aItems[] = {
+        { u"nav_home"_ustr, Glyph::Home },     { u"nav_new"_ustr, Glyph::NewDocument },
+        { u"open_all"_ustr, Glyph::Open },     { u"nav_recent"_ustr, Glyph::Recent },
+        { u"nav_pinned"_ustr, Glyph::Pinned }, { u"nav_update"_ustr, Glyph::Update },
+    };
+    for (const auto& [rId, eGlyph] : aItems)
+    {
+        MenuItem aItem;
+        aItem.xButton = m_xBuilder->weld_button(rId);
+        aItem.eGlyph = eGlyph;
+        aItem.aText = aItem.xButton->get_label();
+        aItem.xButton->set_accessible_name(aItem.aText);
+        aItem.xButton->connect_clicked(LINK(this, HstStartCenterWindow, MenuClickHdl));
+        aItem.xHover.reset(new HoverWatch(*this, maMenu.size(), -1));
+        aItem.xButton->connect_mouse_move(LINK(aItem.xHover.get(), HoverWatch, MouseHdl));
+        maMenu.push_back(std::move(aItem));
+    }
+
+    // "New document": every kind of document the installation can create, and the templates
+    SvtModuleOptions aModules;
+    mxNewMenu->set_visible(u"new_writer"_ustr, aModules.IsWriterInstalled());
+    mxNewMenu->set_visible(u"new_calc"_ustr, aModules.IsCalcInstalled());
+    mxNewMenu->set_visible(u"new_impress"_ustr, aModules.IsImpressInstalled());
+    mxNewMenu->set_visible(u"new_draw"_ustr, aModules.IsDrawInstalled());
+}
