+void HstStartCenterWindow::setOwningFrame(const uno::Reference<frame::XFrame>& xFrame)
+{
+    mxFrame = xFrame;
+    if (mxDropTarget.is() && !mxDropListener.is())
+    {
+        try
+        {
+            mxDropListener.set(new OpenFileDropTargetListener(
+                comphelper::getProcessComponentContext(), mxFrame));
+            mxDropTarget->addDropTargetListener(mxDropListener);
+            mxDropTarget->setActive(true);
+        }
+        catch (const uno::Exception&)
+        {
+            TOOLS_WARN_EXCEPTION("sfx.startcenter", "drop target");
+        }
+    }
+    uno::Reference<frame::XFramesSupplier> xFrames(mxDesktop, uno::UNO_QUERY);
+    if (xFrames.is())
+        xFrames->setActiveFrame(mxFrame);
+}
+
+void HstStartCenterWindow::Dispatch(const OUString& rURL, const OUString& rTarget, bool bViaFrame,
+                                    const uno::Sequence<beans::PropertyValue>& rArgs)
+{
+    uno::Reference<frame::XDispatchProvider> xProvider(
+        bViaFrame ? uno::Reference<frame::XDispatchProvider>(mxFrame, uno::UNO_QUERY) : mxDesktop);
+    if (!xProvider.is())
+        return;
+    try
+    {
+        auto pDispatch = std::make_unique<ImplDispatch>();
+        pDispatch->aURL.Complete = rURL;
+        util::URLTransformer::create(comphelper::getProcessComponentContext())
+            ->parseStrict(pDispatch->aURL);
+        pDispatch->xDispatch = xProvider->queryDispatch(pDispatch->aURL, rTarget, 0);
+        if (!pDispatch->xDispatch.is())
+        {
+            SAL_WARN("sfx.startcenter", "no dispatch for " << rURL);
+            return;
+        }
+        pDispatch->aArgs = rArgs;
+        // after this event returns: the dispatch may replace this window
+        if (Application::PostUserEvent(LINK_NONMEMBER(nullptr, dispatchLater), pDispatch.get()))
+            pDispatch.release();
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("sfx.startcenter", "dispatch of " << rURL);
+    }
+}
+
+void HstStartCenterWindow::CreateDocument(const OUString& rFactory)
+{
+    Dispatch(rFactory, u"_default"_ustr, false);
+}
+
+void HstStartCenterWindow::RunNav(int nIndex)
+{
+    CanvasModel& rModel = mxCanvas->GetModel();
+    switch (nIndex)
+    {
+        case NAV_HOME:
+            rModel.bPinnedOnly = false;
+            rModel.nSelectedNav = NAV_HOME;
+            mxSearch->set_text(OUString());
+            FillLists();
+            FocusSearch();
+            break;
+        case NAV_NEW:
+            ShowNewMenu(mxCanvas->GetLayout().ItemRect({ Part::Nav, NAV_NEW }));
+            break;
+        case NAV_OPEN:
+            Dispatch(u".uno:Open"_ustr, OUString(), true,
+                     { comphelper::makePropertyValue(u"Referer"_ustr, u"private:user"_ustr) });
+            break;
+        case NAV_UNSAVED:
+            // documents closed without saving, kept for 7 days (dialog of the bundled HST extension)
+            Dispatch(UNSAVED_DOCUMENTS, OUString(), true);
+            break;
+        case NAV_RECENT:
+            rModel.bPinnedOnly = false;
+            rModel.nSelectedNav = NAV_RECENT;
+            FillLists();
+            if (!mxCanvas->FocusRegion(Part::Recent))
+                mxCanvas->FocusItem({ Part::Nav, NAV_RECENT });
+            break;
+        case NAV_PINNED:
+            rModel.nSelectedNav = NAV_PINNED;
+            // no room for the Pinned card: the Recent table shows the pinned files
+            rModel.bPinnedOnly = !mxCanvas->GetLayout().bShowRight;
+            FillLists();
+            if (!mxCanvas->FocusRegion(rModel.bPinnedOnly ? Part::Recent : Part::Pinned))
+                mxCanvas->FocusItem({ Part::Nav, NAV_PINNED });
+            break;
+        case NAV_UPDATE:
+            Dispatch(UPDATE_CHECK, OUString(), true);
+            break;
+        default:
+            break;
+    }
+}
+
+void HstStartCenterWindow::ShowNewMenu(const tools::Rectangle& rAt)
+{
+    // every kind of document the installation can create, and the templates
+    SvtModuleOptions aModules;
+    ScopedVclPtrInstance<PopupMenu> xMenu;
+    const std::tuple<sal_uInt16, TranslateId, bool, OUString> aItems[] = {
+        { 1, STR_HST_SC_NEW_WRITER, aModules.IsWriterInstalled(), aFactories[0].second },
+        { 2, STR_HST_SC_NEW_CALC, aModules.IsCalcInstalled(), aFactories[1].second },
+        { 3, STR_HST_SC_NEW_IMPRESS, aModules.IsImpressInstalled(), aFactories[2].second },
+        { 4, STR_HST_SC_NEW_DRAW, aModules.IsDrawInstalled(), aFactories[3].second },
+    };
+    for (const auto& [nId, aText, bInstalled, rFactory] : aItems)
+        if (bInstalled)
+            xMenu->InsertItem(nId, menuText(aText));
+    xMenu->InsertSeparator();
+    xMenu->InsertItem(5, menuText(STR_HST_SC_NEW_TEMPLATE));
+    const sal_uInt16 nChoice = xMenu->Execute(mxCanvas.get(), rAt, PopupMenuFlags::ExecuteRight);
+    for (const auto& [nId, aText, bInstalled, rFactory] : aItems)
+        if (nChoice == nId)
+            return CreateDocument(rFactory);
+    if (nChoice == 5)
+        Dispatch(u".uno:NewDoc"_ustr, OUString(), true);
+}
+
+void HstStartCenterWindow::OpenSolution(int nIndex)
+{
+    const OUString aURL = nIndex >= 0 && nIndex < SOLUTION_COUNT ? aSolutions[nIndex].aURL : MORE_SOLUTIONS_URL;
+    try
+    {
+        system::SystemShellExecute::create(comphelper::getProcessComponentContext())
+            ->execute(aURL + "?" + SOLUTION_UTM, OUString(), system::SystemShellExecuteFlags::URIS_ONLY);
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("sfx.startcenter", "opening the HASON TECH page failed");
+    }
+}
+
+void HstStartCenterWindow::PostAction(const OUString& rAction, const OUString& rURL, int nIndex,
+                                      const tools::Rectangle& rAt)
+{
+    // the canvas's model is rebuilt by most actions: never inside its own event handlers
+    maPendingAction = rAction;
+    maPendingURL = rURL;
+    mnPendingIndex = nIndex;
+    maPendingAt = rAt;
+    if (!mpPendingEvent)
+        mpPendingEvent = Application::PostUserEvent(LINK(this, HstStartCenterWindow, PendingActionHdl));
+}
+
+IMPL_LINK_NOARG(HstStartCenterWindow, PendingActionHdl, void*, void)
+{
+    mpPendingEvent = nullptr;
+    const OUString aAction = std::exchange(maPendingAction, OUString());
+    const OUString aURL = maPendingURL;
+    if (aAction == "nav")
+        RunNav(mnPendingIndex);
+    else if (aAction == "tile" && mnPendingIndex >= 0 && mnPendingIndex < TILE_COUNT)
+        CreateDocument(aFactories[mnPendingIndex].second);
+    else if (aAction == "pin")
+        TogglePinned(aURL);
+    else if (aAction == "open")
+        OpenFile(aURL);
+    else if (aAction == "menu")
+        ShowFileMenu(aURL, maPendingAt);
+    else if (aAction == "refill")
+        FillLists();
+}
