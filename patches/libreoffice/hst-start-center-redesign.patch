+void HstStartCenterWindow::InitBanner()
+{
+    // the rotating HASON TECH banner: signed feed, fetched and counted on worker threads
+    mxBannerHost = VclPtr<ChildHost>::Create(mxCanvas.get(), u"BannerBox"_ustr);
+    mxBanner.reset(new HstBannerWidget(mxBannerHost.get()));
+    mxBannerWeld.reset(new weld::CustomWeld(mxBannerHost->GetBuilder(), u"banner"_ustr, *mxBanner));
+    mxBanner->SetArtChangedHdl(LINK(this, HstStartCenterWindow, BannerArtChangedHdl));
+    UpdateBannerRatio();
+}
+
+void HstStartCenterWindow::InitActionWindows()
+{
+    SvtModuleOptions aModules;
+    const bool bInstalled[] = { aModules.IsWriterInstalled(), aModules.IsCalcInstalled(),
+                                aModules.IsImpressInstalled(), aModules.IsDrawInstalled(),
+                                aModules.IsMathInstalled(),    aModules.IsDataBaseInstalled() };
+    for (size_t i = 0; i < std::size(aFactories); ++i)
+    {
+        const OUString aFactory = aFactories[i].second;
+        maActionWindows.push_back(VclPtr<ActionWindow>::Create(
+            this, aFactories[i].first, bInstalled[i] ? std::function<void()>([this, aFactory] {
+                CreateDocument(aFactory);
+            })
+                                                     : std::function<void()>()));
+    }
+    maActionWindows.push_back(
+        VclPtr<ActionWindow>::Create(this, u"open_all"_ustr, [this] { RunNav(NAV_OPEN); }));
+}
+
+void HstStartCenterWindow::UpdateBannerRatio()
+{
+    if (!mxBanner || !mxCanvas)
+        return;
+    // the slot is exactly as tall as the banner is at the column's inner width
+    const tools::Long nWidth = static_cast<tools::Long>((LEFT_WIDTH - 2 * LEFT_PAD) * mfScale + 0.5);
+    const tools::Long nHeight = mxBanner->HeightForWidth(nWidth);
+    if (nWidth > 0 && nHeight > 0)
+        mxCanvas->SetBannerRatio(Size(nWidth, nHeight));
+}
+
+IMPL_LINK_NOARG(HstStartCenterWindow, BannerArtChangedHdl, HstBannerWidget&, void) { UpdateBannerRatio(); }
