+{
+// columns of the recent table as weld numbers them (the file icon shares the name's column)
+constexpr int COL_OPENED = 1;
+constexpr int COL_FOLDER = 2;
+constexpr int COL_PIN = 3;
+constexpr int COL_MORE = 4;
+
+/** A glyph of the table as a small image on the window colour. */
+ScopedVclPtr<VirtualDevice> glyphImage(weld::Widget& rWidget, double fScale, Glyph eGlyph,
+                                       const Color& rColor, const Color& rBack, bool bFilled)
+{
+    ScopedVclPtr<VirtualDevice> xDev = rWidget.create_virtual_device();
+    const tools::Long nSize = static_cast<tools::Long>(16 * fScale + 0.5);
+    xDev->SetOutputSizePixel(Size(nSize, nSize));
+    xDev->SetAntialiasing(AntialiasingFlags::Enable);
+    xDev->SetBackground(Wallpaper(rBack));
+    xDev->Erase();
+    DrawGlyph(*xDev, tools::Rectangle(Point(0, 0), Size(nSize, nSize)), eGlyph, rColor, bFilled);
+    return xDev;
+}
+
+/** Selects and focuses the row of rURL, if the list shows it. */
+void selectRow(weld::TreeView& rList, const OUString& rURL)
+{
+    const int nRow = rURL.isEmpty() ? -1 : rList.find_id(rURL);
+    if (nRow >= 0)
+        rList.set_cursor(nRow);
+}
+}
+
+void HstStartCenterWindow::InitLists()
+{
+    maRecentTitleText = mxRecentTitle->get_label();
+    maRecentEmptyText = mxRecentEmpty->get_label();
+    maPinnedEmptyText = mxPinnedEmpty->get_label();
+
+    mxRecentList->set_accessible_description(SfxResId(STR_HST_SC_RECENT_HINT));
+    mxRecentList->connect_item_activated(LINK(this, HstStartCenterWindow, RecentActivatedHdl));
+    mxRecentList->connect_key_press(LINK(this, HstStartCenterWindow, RecentKeyHdl));
+    mxRecentList->connect_mouse_release(LINK(this, HstStartCenterWindow, RecentMouseHdl));
+    mxRecentList->connect_command(LINK(this, HstStartCenterWindow, RecentCommandHdl));
+    mxRecentList->connect_query_tooltip(LINK(this, HstStartCenterWindow, RecentTooltipHdl));
+    mxRecentList->connect_size_allocate(LINK(this, HstStartCenterWindow, RecentSizeHdl));
+
+    mxPinnedList->set_accessible_description(SfxResId(STR_HST_SC_RECENT_HINT));
+    mxPinnedList->connect_item_activated(LINK(this, HstStartCenterWindow, PinnedActivatedHdl));
+    mxPinnedList->connect_key_press(LINK(this, HstStartCenterWindow, PinnedKeyHdl));
+    mxPinnedList->connect_command(LINK(this, HstStartCenterWindow, PinnedCommandHdl));
+    mxPinnedList->connect_query_tooltip(LINK(this, HstStartCenterWindow, PinnedTooltipHdl));
+
+    mxSearch->connect_activate(LINK(this, HstStartCenterWindow, SearchActivateHdl));
+}
+
+void HstStartCenterWindow::ReloadFiles()
+{
+    maFiles = LoadRecentFiles();
+    FillRecentList();
+    FillPinnedList();
+
+    // file times not read yet: on a worker thread, the table shows them when they arrive
+    std::vector<OUString> aURLs;
+    for (const RecentFile& rFile : maFiles)
+        if (maTimes.find(rFile.aURL) == maTimes.end())
+            aURLs.push_back(rFile.aURL);
+    if (aURLs.empty())
+        return;
+    mpTimes->Start(aURLs, [this, aURLs](const std::vector<DateTime>& rTimes) {
+        SetFileTimes(aURLs, rTimes);
+    });
+}
+
+void HstStartCenterWindow::SetFileTimes(const std::vector<OUString>& rURLs,
+                                        const std::vector<DateTime>& rTimes)
+{
+    if (!mxRecentList)
+        return;
+    for (size_t i = 0; i < rURLs.size() && i < rTimes.size(); ++i)
+        maTimes.insert_or_assign(rURLs[i], rTimes[i]);
+    // only the date column changes: the rows, the selection and the scroll position stay
+    const DateTime aNow(DateTime::SYSTEM);
+    const int nRows = mxRecentList->n_children();
+    for (int nRow = 0; nRow < nRows; ++nRow)
+    {
+        auto it = maTimes.find(mxRecentList->get_id(nRow));
+        if (it != maTimes.end())
+            mxRecentList->set_text(nRow, sfx2::hst::FormatRecentDate(it->second, aNow), COL_OPENED);
+    }
+}
+
+const RecentFile* HstStartCenterWindow::FindFile(const OUString& rURL) const
+{
+    for (const RecentFile& rFile : maFiles)
+        if (rFile.aURL == rURL)
+            return &rFile;
+    return nullptr;
+}
+
+void HstStartCenterWindow::FillRecentList()
+{
+    if (!mxRecentList || !mpPalette)
+        return;
+    const Palette& rPalette = *mpPalette;
+    const OUString aQuery = FoldForSearch(mxSearch->get_text());
+    const OUString aKeep = mxRecentList->get_selected_id();
+
+    ScopedVclPtr<VirtualDevice> xPinned
+        = glyphImage(*mxRecentList, mfScale, Glyph::Pinned, rPalette.aAccent, rPalette.aWindow, true);
+    ScopedVclPtr<VirtualDevice> xUnpinned
+        = glyphImage(*mxRecentList, mfScale, Glyph::Pinned, rPalette.aMuted, rPalette.aWindow, false);
+    ScopedVclPtr<VirtualDevice> xMore
+        = glyphImage(*mxRecentList, mfScale, Glyph::More, rPalette.aMuted, rPalette.aWindow, false);
+
+    const DateTime aNow(DateTime::SYSTEM);
+    mxRecentList->freeze();
+    mxRecentList->clear();
+    for (const RecentFile& rFile : maFiles)
+    {
+        if ((mbPinnedOnly && !rFile.bPinned) || !MatchesFoldedQuery(rFile.aFolded, aQuery))
+            continue;
+        mxRecentList->insert(-1, rFile.aName, &rFile.aURL, &rFile.aIcon, nullptr);
+        const int nRow = mxRecentList->n_children() - 1;
+        auto it = maTimes.find(rFile.aURL);
+        mxRecentList->set_text(nRow, it == maTimes.end() ? OUString()
+                                                          : sfx2::hst::FormatRecentDate(it->second, aNow),
+                               COL_OPENED);
+        mxRecentList->set_text(nRow, rFile.aFolder, COL_FOLDER);
+        mxRecentList->set_image(nRow, rFile.bPinned ? *xPinned : *xUnpinned, COL_PIN);
+        mxRecentList->set_image(nRow, *xMore, COL_MORE);
+    }
+    mxRecentList->thaw();
+
+    const bool bEmpty = mxRecentList->n_children() == 0;
+    if (bEmpty && !maFiles.empty() && !aQuery.isEmpty())
+        mxRecentEmpty->set_label(SfxResId(STR_HST_SC_NO_MATCH).replaceFirst("%1", mxSearch->get_text()));
+    else if (bEmpty && mbPinnedOnly)
+        mxRecentEmpty->set_label(maPinnedEmptyText);
+    else
+        mxRecentEmpty->set_label(maRecentEmptyText);
+    mxRecentEmpty->set_visible(bEmpty);
+    mxRecentList->set_visible(!bEmpty);
+    mxRecentTitle->set_label(mbPinnedOnly ? mxPinnedTitle->get_label() : maRecentTitleText);
+    selectRow(*mxRecentList, aKeep);
+}
+
+void HstStartCenterWindow::FillPinnedList()
+{
+    if (!mxPinnedList)
+        return;
+    const OUString aKeep = mxPinnedList->get_selected_id();
+    mxPinnedList->freeze();
+    mxPinnedList->clear();
+    for (const RecentFile& rFile : maFiles)
+        if (rFile.bPinned)
+            mxPinnedList->insert(-1, rFile.aName, &rFile.aURL, &rFile.aIcon, nullptr);
+    mxPinnedList->thaw();
+    const bool bEmpty = mxPinnedList->n_children() == 0;
+    mxPinnedEmpty->set_visible(bEmpty);
+    mxPinnedList->set_visible(!bEmpty);
+    selectRow(*mxPinnedList, aKeep);
+}
+
+void HstStartCenterWindow::clearRecentFileList()
+{
+    maTimes.clear();
+    ReloadFiles();
+}
+
+void HstStartCenterWindow::TogglePinned(const OUString& rURL)
+{
+    if (!FindFile(rURL))
+        return;
+    // the history keeps the pin in the profile, so it stays after a restart
+    SvtHistoryOptions::TogglePinItem(EHistoryType::PickList, rURL);
+    ReloadFiles();
+    selectRow(*mxRecentList, rURL);
+}
+
+void HstStartCenterWindow::RemoveFromList(const OUString& rURL)
+{
+    // removes the entry from the history only; the file itself stays where it is
+    SvtHistoryOptions::DeleteItem(EHistoryType::PickList, rURL, true);
+    maTimes.erase(rURL);
+    ReloadFiles();
+}
+
+void HstStartCenterWindow::OpenFile(const OUString& rURL)
+{
+    const RecentFile* pFile = FindFile(rURL);
+    if (!pFile)
+        return;
+    uno::Sequence<beans::PropertyValue> aArgs{
+        comphelper::makePropertyValue(u"Referer"_ustr, u"private:user"_ustr),
+        comphelper::makePropertyValue(u"AsTemplate"_ustr, false) // a recent file is never a template
+    };
+    if (pFile->bReadOnly)
+    {
+        aArgs.realloc(3);
+        aArgs.getArray()[2] = comphelper::makePropertyValue(u"ReadOnly"_ustr, true);
+    }
+    Dispatch(rURL, u"_default"_ustr, false, aArgs);
+}
+
+void HstStartCenterWindow::OpenFolder(const OUString& rURL)
+{
+    const RecentFile* pFile = FindFile(rURL);
+    if (!pFile || pFile->aFolderURL.isEmpty())
+        return;
+    try
+    {
+        system::SystemShellExecute::create(comphelper::getProcessComponentContext())
+            ->execute(pFile->aFolderURL, OUString(), system::SystemShellExecuteFlags::URIS_ONLY);
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("sfx.startcenter", "opening the folder failed");
+    }
+}
+
+void HstStartCenterWindow::ShowFileMenu(weld::TreeView& rList, const OUString& rURL,
+                                        const tools::Rectangle& rRect)
+{
+    const RecentFile* pFile = FindFile(rURL);
+    if (!pFile)
+        return;
+    mxFileMenu->set_visible(u"menu_pin"_ustr, !pFile->bPinned);
+    mxFileMenu->set_visible(u"menu_unpin"_ustr, pFile->bPinned);
+    mxFileMenu->set_sensitive(u"menu_folder"_ustr, pFile->aFolderURL.startsWithIgnoreAsciiCase("file:"));
+    const OUString aChoice = mxFileMenu->popup_at_rect(&rList, rRect);
+    if (aChoice == "menu_open")
+        OpenFile(rURL);
+    else if (aChoice == "menu_folder")
+        OpenFolder(rURL);
+    else if (aChoice == "menu_pin" || aChoice == "menu_unpin")
+        TogglePinned(rURL);
+    else if (aChoice == "menu_remove")
+        RemoveFromList(rURL);
+}
+
+void HstStartCenterWindow::PostAction(const OUString& rAction, const OUString& rURL,
+                                      weld::TreeView* pList, const tools::Rectangle& rRect)
+{
+    // the lists are rebuilt by most actions: never inside their own event handlers
+    maPendingAction = rAction;
+    maPendingURL = rURL;
+    mpPendingList = pList;
+    maPendingRect = rRect;
+    if (!mpPendingEvent)
+        mpPendingEvent = Application::PostUserEvent(LINK(this, HstStartCenterWindow, PendingActionHdl));
+}
+
+IMPL_LINK_NOARG(HstStartCenterWindow, PendingActionHdl, void*, void)
+{
+    mpPendingEvent = nullptr;
+    const OUString aAction = std::exchange(maPendingAction, OUString());
+    RunAction(aAction, maPendingURL, mpPendingList, maPendingRect);
+}
+
+void HstStartCenterWindow::RunAction(const OUString& rAction, const OUString& rURL,
+                                     weld::TreeView* pList, const tools::Rectangle& rRect)
+{
+    if (rAction == "pin")
+        TogglePinned(rURL);
+    else if (rAction == "open")
+        OpenFile(rURL);
+    else if (rAction == "menu" && pList)
+        ShowFileMenu(*pList, rURL, rRect);
+}
+
+void HstStartCenterWindow::ShowContextMenu(weld::TreeView& rList, const CommandEvent& rEvent)
+{
+    std::unique_ptr<weld::TreeIter> xIter;
+    tools::Rectangle aRect;
+    if (rEvent.IsMouseEvent())
+    {
+        xIter = rList.get_dest_row_at_pos(rEvent.GetMousePosPixel(), false, false);
+        aRect = tools::Rectangle(rEvent.GetMousePosPixel(), Size(1, 1));
+    }
+    else
+    {
+        xIter = rList.get_cursor();
+        if (xIter)
+            aRect = rList.get_row_area(*xIter);
+    }
+    if (!xIter)
+        return;
+    rList.set_cursor(*xIter);
+    PostAction(u"menu"_ustr, rList.get_id(*xIter), &rList, aRect);
+}
+
+IMPL_LINK_NOARG(HstStartCenterWindow, SearchChangedHdl, weld::Entry&, void)
+{
+    if (meSection != Section::Home)
+        SelectSection(Section::Home);
+    FillRecentList();
+}
+
+IMPL_LINK_NOARG(HstStartCenterWindow, SearchActivateHdl, weld::Entry&, bool)
+{
+    // Enter in the search box: to the first file found
+    if (mxRecentList->get_visible() && mxRecentList->n_children() > 0)
+    {
+        mxRecentList->set_cursor(0);
+        mxRecentList->grab_focus();
+    }
+    return true;
+}
+
+IMPL_LINK(HstStartCenterWindow, RecentActivatedHdl, const weld::TreeIter&, rIter, bool)
+{
+    PostAction(u"open"_ustr, mxRecentList->get_id(rIter));
+    return true;
+}
+
+IMPL_LINK(HstStartCenterWindow, PinnedActivatedHdl, const weld::TreeIter&, rIter, bool)
+{
+    PostAction(u"open"_ustr, mxPinnedList->get_id(rIter));
+    return true;
+}
+
+IMPL_LINK(HstStartCenterWindow, RecentKeyHdl, const KeyEvent&, rEvent, bool)
+{
+    // Space pins or unpins the file of the focused row
+    if (rEvent.GetKeyCode().GetFullCode() != KEY_SPACE)
+        return false;
+    std::unique_ptr<weld::TreeIter> xIter = mxRecentList->get_cursor();
+    if (!xIter)
+        return false;
+    PostAction(u"pin"_ustr, mxRecentList->get_id(*xIter));
+    return true;
+}
+
+IMPL_LINK(HstStartCenterWindow, PinnedKeyHdl, const KeyEvent&, rEvent, bool)
+{
+    if (rEvent.GetKeyCode().GetFullCode() != KEY_SPACE)
+        return false;
+    std::unique_ptr<weld::TreeIter> xIter = mxPinnedList->get_cursor();
+    if (!xIter)
+        return false;
+    PostAction(u"pin"_ustr, mxPinnedList->get_id(*xIter));
+    return true;
+}
+
+IMPL_LINK(HstStartCenterWindow, RecentMouseHdl, const MouseEvent&, rEvent, bool)
+{
+    // a click on the pin or on "⋯" of a row
+    if (!rEvent.IsLeft() || rEvent.GetClicks() != 1 || maRecentWidths.size() <= COL_MORE)
+        return false;
+    const Point aPos = rEvent.GetPosPixel();
+    std::unique_ptr<weld::TreeIter> xIter = mxRecentList->get_dest_row_at_pos(aPos, false, false);
+    if (!xIter)
+        return false;
+    tools::Long nRight = 0;
+    int nColumn = -1;
+    for (size_t i = 0; i < maRecentWidths.size(); ++i)
+    {
+        nRight += maRecentWidths[i];
+        if (aPos.X() < nRight)
+        {
+            nColumn = i;
+            break;
+        }
+    }
+    if (nColumn < 0) // the last column takes the rest of the width
+        nColumn = COL_MORE;
+    const OUString aURL = mxRecentList->get_id(*xIter);
+    if (nColumn == COL_PIN)
+        PostAction(u"pin"_ustr, aURL);
+    else if (nColumn == COL_MORE)
+        PostAction(u"menu"_ustr, aURL, mxRecentList.get(), tools::Rectangle(aPos, Size(1, 1)));
+    else
+        return false;
+    return true;
+}
+
+IMPL_LINK(HstStartCenterWindow, RecentCommandHdl, const CommandEvent&, rEvent, bool)
+{
+    if (rEvent.GetCommand() != CommandEventId::ContextMenu)
+        return false;
+    ShowContextMenu(*mxRecentList, rEvent);
+    return true;
+}
+
+IMPL_LINK(HstStartCenterWindow, PinnedCommandHdl, const CommandEvent&, rEvent, bool)
+{
+    if (rEvent.GetCommand() != CommandEventId::ContextMenu)
+        return false;
+    ShowContextMenu(*mxPinnedList, rEvent);
+    return true;
+}
+
+IMPL_LINK(HstStartCenterWindow, RecentTooltipHdl, const weld::TreeIter&, rIter, OUString)
+{
+    const RecentFile* pFile = FindFile(mxRecentList->get_id(rIter));
+    if (!pFile)
+        return OUString();
+    return pFile->bPinned ? pFile->aFolderPath + u" · "_ustr + SfxResId(STR_HST_SC_PINNED_STATE)
+                          : pFile->aFolderPath;
+}
+
+IMPL_LINK(HstStartCenterWindow, PinnedTooltipHdl, const weld::TreeIter&, rIter, OUString)
+{
+    const RecentFile* pFile = FindFile(mxPinnedList->get_id(rIter));
+    return pFile ? pFile->aFolderPath : OUString();
+}
+
+IMPL_LINK(HstStartCenterWindow, RecentSizeHdl, const Size&, rSize, void)
+{
+    // name (with the file icon) | opened | folder | pin | ⋯ ; the name takes what is left
+    const auto px = [this](double f) { return static_cast<int>(f * mfScale + 0.5); };
+    const bool bNarrow = rSize.Width() < px(560);
+    const int nOpened = px(bNarrow ? 110 : 130);
+    const int nFolder = px(bNarrow ? 100 : 150);
+    const int nPin = px(36);
+    const int nMore = px(36);
+    const int nName = std::max(px(120), static_cast<int>(rSize.Width()) - nOpened - nFolder - nPin - nMore - px(4));
+    std::vector<int> aWidths{ nName, nOpened, nFolder, nPin, nMore };
+    if (aWidths == maRecentWidths)
+        return;
+    maRecentWidths = aWidths;
+    aWidths.pop_back(); // the last column fills the rest
+    mxRecentList->set_column_fixed_widths(aWidths);
+}
+
+/* vim:set shiftwidth=4 softtabstop=4 expandtab: */
diff --git a/sfx2/source/startcenter/hststartcenterpaint.cxx b/sfx2/source/startcenter/hststartcenterpaint.cxx
new file mode 100644
index 0000000..86b370d
--- /dev/null
+++ b/sfx2/source/startcenter/hststartcenterpaint.cxx
@@ -0,0 +1,289 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * This file is part of HST Office.
+ */
+
+#include "hststartcenterpaint.hxx"
+
+#include <basegfx/point/b2dpoint.hxx>
+#include <basegfx/polygon/b2dpolygon.hxx>
+#include <com/sun/star/drawing/LineCap.hpp>
+#include <vcl/font.hxx>
+#include <vcl/outdev.hxx>
+#include <vcl/rendercontext/AntialiasingFlags.hxx>
+#include <vcl/settings.hxx>
+#include <vcl/wall.hxx>
+
+#include <cmath>
+#include <initializer_list>
+
+namespace sfx2::hst::startcenter
+{
+namespace
+{
+Color merged(Color aBase, const Color& rOther, sal_uInt8 nKeep)
+{
+    aBase.Merge(rOther, nKeep);
+    return aBase;
+}
+
+/** Maps glyph coordinates (a 20 x 20 design grid) into the box. */
+class Grid
+{
+public:
+    explicit Grid(const tools::Rectangle& rBox)
+        : mfX(rBox.Left())
+        , mfY(rBox.Top())
+        , mfUnit(std::min(rBox.GetWidth(), rBox.GetHeight()) / 20.0)
+    {
+    }
+
+    basegfx::B2DPoint at(double fX, double fY) const
+    {
+        return basegfx::B2DPoint(mfX + fX * mfUnit, mfY + fY * mfUnit);
+    }
+
+    basegfx::B2DPolygon line(std::initializer_list<std::pair<double, double>> aPoints,
+                             bool bClosed = false) const
+    {
+        basegfx::B2DPolygon aPoly;
+        for (const auto& [fX, fY] : aPoints)
+            aPoly.append(at(fX, fY));
+        aPoly.setClosed(bClosed);
+        return aPoly;
+    }
+
+    basegfx::B2DPolygon arc(double fCX, double fCY, double fR, double fFromDeg, double fToDeg) const
+    {
+        basegfx::B2DPolygon aPoly;
+        const int nSteps = 32;
+        for (int i = 0; i <= nSteps; ++i)
+        {
+            const double fAngle = (fFromDeg + (fToDeg - fFromDeg) * i / nSteps) * M_PI / 180.0;
+            aPoly.append(at(fCX + fR * std::cos(fAngle), fCY + fR * std::sin(fAngle)));
+        }
+        return aPoly;
+    }
+
+    double unit() const { return mfUnit; }
+
+private:
+    double mfX;
+    double mfY;
+    double mfUnit;
+};
+
+void stroke(OutputDevice& rDev, const Grid& rGrid, const basegfx::B2DPolygon& rPoly)
+{
+    rDev.DrawPolyLine(rPoly, std::max(1.0, 1.5 * rGrid.unit()), basegfx::B2DLineJoin::Round,
+                      css::drawing::LineCap_ROUND);
+}
+
+void fill(OutputDevice& rDev, const basegfx::B2DPolygon& rPoly, const Color& rColor)
+{
+    rDev.SetLineColor();
+    rDev.SetFillColor(rColor);
+    rDev.DrawPolygon(rPoly);
+}
+
+/** Draws a tile's application mark: a rounded square in the tile colour with a white sign. */
+void drawAppMark(OutputDevice& rDev, const tools::Rectangle& rBox, int nKind, const Color& rColor)
+{
+    const tools::Long nRadius = rBox.GetWidth() / 5;
+    rDev.SetLineColor();
+    rDev.SetFillColor(rColor);
+    rDev.DrawRect(rBox, nRadius, nRadius);
+    tools::Rectangle aInner(rBox);
+    aInner.shrink(rBox.GetWidth() / 5);
+    const Glyph eGlyph = nKind == 0 ? Glyph::Document
+                         : nKind == 1 ? Glyph::Spreadsheet
+                                      : Glyph::Presentation;
+    DrawGlyph(rDev, aInner, eGlyph, COL_WHITE);
+}
+
+/** Text, shortened with an ellipsis to nMaxWidth, vertically centred on nCentreY. */
+void drawText(OutputDevice& rDev, tools::Long nX, tools::Long nCentreY, tools::Long nMaxWidth,
+              const OUString& rText)
+{
+    if (nMaxWidth <= 0)
+        return;
+    const OUString aShown = rDev.GetEllipsisString(rText, nMaxWidth);
+    rDev.DrawText(Point(nX, nCentreY - rDev.GetTextHeight() / 2), aShown);
+}
+}
+
+Palette MakePalette(const StyleSettings& rStyle)
+{
+    Palette aPalette;
+    aPalette.aWindow = rStyle.GetWindowColor();
+    aPalette.aText = rStyle.GetWindowTextColor();
+    aPalette.bDark = aPalette.aWindow.IsDark();
+    const bool bDark = aPalette.bDark;
+    aPalette.aAccent = bDark ? Color(0x8A, 0xB4, 0xF8) : Color(0x1A, 0x56, 0xC8);
+    aPalette.aMuted = merged(aPalette.aText, aPalette.aWindow, 150);
+    aPalette.aSide = bDark ? merged(aPalette.aWindow, COL_WHITE, 242)
+                           : merged(aPalette.aWindow, Color(0x1A, 0x56, 0xC8), 245);
+    aPalette.aSelected = merged(aPalette.aSide, aPalette.aAccent, bDark ? 205 : 220);
+    aPalette.aHover = merged(aPalette.aSide, aPalette.aAccent, bDark ? 232 : 240);
+    aPalette.aBorder = merged(aPalette.aWindow, aPalette.aText, 222);
+    aPalette.aCard = bDark ? merged(aPalette.aWindow, COL_WHITE, 248) : aPalette.aWindow;
+
+    // Document blue, Spreadsheet green, Presentation orange
+    const Color aHue[3] = { Color(0x2B, 0x6C, 0xE6), Color(0x1E, 0x9E, 0x54), Color(0xF0, 0x6E, 0x22) };
+    for (int i = 0; i < 3; ++i)
+    {
+        aPalette.aTileAccent[i] = aHue[i];
+        aPalette.aTile[i] = merged(aPalette.aWindow, aHue[i], bDark ? 215 : 240);
+        aPalette.aTileBorder[i] = merged(aPalette.aWindow, aHue[i], bDark ? 160 : 205);
+    }
+    return aPalette;
+}
+
+void DrawGlyph(OutputDevice& rDev, const tools::Rectangle& rBox, Glyph eGlyph, const Color& rColor,
+               bool bFilled)
+{
+    const Grid aGrid(rBox);
+    rDev.SetLineColor(rColor);
+    rDev.SetFillColor();
+    switch (eGlyph)
+    {
+        case Glyph::Home:
+            stroke(rDev, aGrid, aGrid.line({ { 2, 10 }, { 10, 3 }, { 18, 10 } }));
+            stroke(rDev, aGrid, aGrid.line({ { 4.5, 8.5 }, { 4.5, 17 }, { 15.5, 17 }, { 15.5, 8.5 } }));
+            stroke(rDev, aGrid, aGrid.line({ { 8.5, 17 }, { 8.5, 12 }, { 11.5, 12 }, { 11.5, 17 } }));
+            break;
+        case Glyph::NewDocument:
+            stroke(rDev, aGrid,
+                   aGrid.line({ { 4.5, 2 }, { 11.5, 2 }, { 15.5, 6 }, { 15.5, 18 }, { 4.5, 18 } }, true));
+            stroke(rDev, aGrid, aGrid.line({ { 11.5, 2 }, { 11.5, 6 }, { 15.5, 6 } }));
+            stroke(rDev, aGrid, aGrid.line({ { 10, 9 }, { 10, 15 } }));
+            stroke(rDev, aGrid, aGrid.line({ { 7, 12 }, { 13, 12 } }));
+            break;
+        case Glyph::Open:
+            stroke(rDev, aGrid,
+                   aGrid.line({ { 2, 4.5 }, { 7.5, 4.5 }, { 9.5, 6.5 }, { 18, 6.5 }, { 18, 16 }, { 2, 16 } },
+                              true));
+            stroke(rDev, aGrid, aGrid.line({ { 2, 9 }, { 18, 9 } }));
+            break;
+        case Glyph::Recent:
+            stroke(rDev, aGrid, aGrid.arc(10, 10, 7.5, 0, 360));
+            stroke(rDev, aGrid, aGrid.line({ { 10, 5.5 }, { 10, 10 }, { 13.5, 12 } }));
+            break;
+        case Glyph::Pinned:
+        {
+            // a push pin leaning to the left: head at the top right, needle to the bottom left
+            const basegfx::B2DPolygon aPin = aGrid.line(
+                { { 12, 2.5 }, { 17.5, 8 }, { 15.5, 9 }, { 12, 12.5 }, { 12.5, 15.5 }, { 4.5, 7.5 },
+                  { 7.5, 8 }, { 11, 4.5 } },
+                true);
+            if (bFilled)
+                fill(rDev, aPin, rColor);
+            rDev.SetLineColor(rColor);
+            stroke(rDev, aGrid, aPin);
+            stroke(rDev, aGrid, aGrid.line({ { 8.5, 11.5 }, { 3, 17 } }));
+            break;
+        }
+        case Glyph::Update:
+        {
+            stroke(rDev, aGrid, aGrid.arc(10, 10, 7, -60, 240));
+            // arrow head at the start of the arc (the upper right)
+            const basegfx::B2DPoint aTip = aGrid.at(10 + 7 * std::cos(-M_PI / 3), 10 + 7 * std::sin(-M_PI / 3));
+            basegfx::B2DPolygon aHead;
+            aHead.append(basegfx::B2DPoint(aTip.getX() - 4 * aGrid.unit(), aTip.getY()));
+            aHead.append(aTip);
+            aHead.append(basegfx::B2DPoint(aTip.getX(), aTip.getY() - 4 * aGrid.unit()));
+            stroke(rDev, aGrid, aHead);
+            break;
+        }
+        case Glyph::More:
+            for (double fX : { 4.0, 10.0, 16.0 })
+                fill(rDev, aGrid.arc(fX, 10, 1.6, 0, 360), rColor);
+            break;
+        case Glyph::Chevron:
+            stroke(rDev, aGrid, aGrid.line({ { 8, 5 }, { 13, 10 }, { 8, 15 } }));
+            break;
+        case Glyph::Document:
+            for (double fY : { 5.0, 10.0, 15.0 })
+                stroke(rDev, aGrid, aGrid.line({ { 3, fY }, { fY == 15.0 ? 12.0 : 17.0, fY } }));
+            break;
+        case Glyph::Spreadsheet:
+            stroke(rDev, aGrid, aGrid.line({ { 3, 3 }, { 17, 3 }, { 17, 17 }, { 3, 17 } }, true));
+            stroke(rDev, aGrid, aGrid.line({ { 3, 8 }, { 17, 8 } }));
+            stroke(rDev, aGrid, aGrid.line({ { 3, 12.5 }, { 17, 12.5 } }));
+            stroke(rDev, aGrid, aGrid.line({ { 9, 3 }, { 9, 17 } }));
+            break;
+        case Glyph::Presentation:
+            stroke(rDev, aGrid, aGrid.line({ { 2.5, 3.5 }, { 17.5, 3.5 }, { 17.5, 13.5 }, { 2.5, 13.5 } }, true));
+            stroke(rDev, aGrid, aGrid.line({ { 10, 13.5 }, { 10, 17.5 } }));
+            fill(rDev, aGrid.line({ { 8.5, 6 }, { 13, 8.5 }, { 8.5, 11 } }, true), rColor);
+            break;
+    }
+}
+
+void PaintMenuItem(OutputDevice& rDev, const Size& rSize, double fScale, Glyph eGlyph,
+                   const OUString& rText, const vcl::Font& rFont, const Palette& rPalette,
+                   bool bSelected, bool bHover, bool bCompact)
+{
+    const auto px = [fScale](double f) { return static_cast<tools::Long>(f * fScale + 0.5); };
+    rDev.SetAntialiasing(AntialiasingFlags::Enable);
+    rDev.SetBackground(Wallpaper(rPalette.aSide));
+    rDev.Erase();
+    if (bSelected || bHover)
+    {
+        rDev.SetLineColor();
+        rDev.SetFillColor(bSelected ? rPalette.aSelected : rPalette.aHover);
+        rDev.DrawRect(tools::Rectangle(Point(0, 0), rSize), px(8), px(8));
+    }
+    const Color aInk = bSelected ? rPalette.aAccent : rPalette.aText;
+    const tools::Long nGlyph = px(20);
+    const tools::Long nGlyphX = bCompact ? (rSize.Width() - nGlyph) / 2 : px(14);
+    DrawGlyph(rDev, tools::Rectangle(Point(nGlyphX, (rSize.Height() - nGlyph) / 2), Size(nGlyph, nGlyph)),
+              eGlyph, aInk);
+    if (bCompact)
+        return;
+    vcl::Font aFont(rFont);
+    aFont.SetWeight(bSelected ? WEIGHT_BOLD : WEIGHT_NORMAL);
+    aFont.SetColor(aInk);
+    rDev.SetFont(aFont);
+    rDev.SetTextColor(aInk);
+    const tools::Long nTextX = nGlyphX + nGlyph + px(14);
+    drawText(rDev, nTextX, rSize.Height() / 2, rSize.Width() - nTextX - px(8), rText);
+}
+
+void PaintTile(OutputDevice& rDev, const Size& rSize, double fScale, int nKind,
+               const OUString& rText, const vcl::Font& rFont, const Palette& rPalette, bool bHover)
+{
+    const auto px = [fScale](double f) { return static_cast<tools::Long>(f * fScale + 0.5); };
+    rDev.SetAntialiasing(AntialiasingFlags::Enable);
+    rDev.SetBackground(Wallpaper(rPalette.aWindow));
+    rDev.Erase();
+    const tools::Rectangle aTile(Point(0, 0), Size(rSize.Width() - 1, rSize.Height() - 1));
+    rDev.SetLineColor(bHover ? rPalette.aTileAccent[nKind] : rPalette.aTileBorder[nKind]);
+    rDev.SetFillColor(bHover ? merged(rPalette.aTile[nKind], rPalette.aTileAccent[nKind], 225)
+                             : rPalette.aTile[nKind]);
+    rDev.DrawRect(aTile, px(10), px(10));
+
+    const tools::Long nMark = std::min(px(40), rSize.Height() - px(16));
+    const tools::Long nMarkX = px(16);
+    drawAppMark(rDev, tools::Rectangle(Point(nMarkX, (rSize.Height() - nMark) / 2), Size(nMark, nMark)),
+                nKind, rPalette.aTileAccent[nKind]);
+
+    const tools::Long nChevron = px(16);
+    const tools::Long nChevronX = rSize.Width() - nChevron - px(12);
+    DrawGlyph(rDev, tools::Rectangle(Point(nChevronX, (rSize.Height() - nChevron) / 2),
+                                     Size(nChevron, nChevron)),
+              Glyph::Chevron, rPalette.aText);
+
+    vcl::Font aFont(rFont);
+    aFont.SetWeight(WEIGHT_SEMIBOLD);
+    aFont.SetColor(rPalette.aText);
+    rDev.SetFont(aFont);
+    rDev.SetTextColor(rPalette.aText);
+    const tools::Long nTextX = nMarkX + nMark + px(14);
+    drawText(rDev, nTextX, rSize.Height() / 2, nChevronX - nTextX - px(6), rText);
+}
+}
+
+/* vim:set shiftwidth=4 softtabstop=4 expandtab: */
