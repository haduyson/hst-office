+void HstStartCenterWindow::InitSolutions()
+{
+    for (size_t i = 0; i < std::size(aSolutions); ++i)
+    {
+        std::unique_ptr<weld::Button> xButton
+            = m_xBuilder->weld_button(u"btnSolution" + OUString::number(i));
+        xButton->set_label(aSolutions[i].aName);
+        xButton->set_tooltip_text(aSolutions[i].aTagline);
+        xButton->set_accessible_name(aSolutions[i].aName);
+        xButton->set_accessible_description(aSolutions[i].aTagline);
+        xButton->connect_clicked(LINK(this, HstStartCenterWindow, SolutionClickHdl));
+        maSolutionButtons.push_back(std::move(xButton));
+    }
+    mxMoreSolutions->set_label(u"Xem thêm các giải pháp khác →"_ustr);
+    mxMoreSolutions->connect_clicked(LINK(this, HstStartCenterWindow, SolutionClickHdl));
+
+    // the rotating HASON TECH banner: signed feed, fetched and counted on worker threads
+    mxBanner.reset(new HstBannerWidget(this));
+    mxBannerWeld.reset(new weld::CustomWeld(*m_xBuilder, u"banner"_ustr, *mxBanner));
+}
+
+void HstStartCenterWindow::InitTiles()
+{
+    const std::pair<OUString, OUString> aTiles[] = {
+        { u"writer_all"_ustr, u"private:factory/swriter"_ustr },
+        { u"calc_all"_ustr, u"private:factory/scalc"_ustr },
+        { u"impress_all"_ustr, u"private:factory/simpress?slot=6686"_ustr },
+    };
+    SvtModuleOptions aModules;
+    const bool bInstalled[] = { aModules.IsWriterInstalled(), aModules.IsCalcInstalled(),
+                                aModules.IsImpressInstalled() };
+    for (size_t i = 0; i < std::size(aTiles); ++i)
+    {
+        Tile aTile;
+        aTile.xButton = m_xBuilder->weld_button(aTiles[i].first);
+        aTile.aText = aTile.xButton->get_label();
+        aTile.aFactory = aTiles[i].second;
+        aTile.xButton->set_accessible_name(aTile.aText);
+        aTile.xButton->set_sensitive(bInstalled[i]);
+        aTile.xButton->connect_clicked(LINK(this, HstStartCenterWindow, TileClickHdl));
+        aTile.xHover.reset(new HoverWatch(*this, -1, maTiles.size()));
+        aTile.xButton->connect_mouse_move(LINK(aTile.xHover.get(), HoverWatch, MouseHdl));
+        maTiles.push_back(std::move(aTile));
+    }
+    // not shown, but automation creates these documents from the Start Center by their ids
+    for (weld::Button* pButton : { mxDrawButton.get(), mxMathButton.get(), mxBaseButton.get() })
+        pButton->connect_clicked(LINK(this, HstStartCenterWindow, TileClickHdl));
+
+    mxSearch->connect_changed(LINK(this, HstStartCenterWindow, SearchChangedHdl));
+}
