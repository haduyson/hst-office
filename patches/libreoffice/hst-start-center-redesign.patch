+constexpr Logo LOGOS[] = {
+    { PNG_AIOS_24, sizeof(PNG_AIOS_24), PNG_AIOS_48, sizeof(PNG_AIOS_48) },
+    { PNG_ECHATBOT_24, sizeof(PNG_ECHATBOT_24), PNG_ECHATBOT_48, sizeof(PNG_ECHATBOT_48) },
