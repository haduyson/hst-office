+class OutputDevice;
+
+/* HST Office Start Center: the outline glyphs of the menu and the file rows, drawn with
+   anti-aliased vectors on a 20 x 20 grid so they look the same on every platform and at every scale.
+   The colours, measures and shapes come from the HST design tokens (<vcl/hst/designtokens.hxx>,
+   <vcl/hst/drawhelpers.hxx>). */
+namespace sfx2::hst::startcenter
+{
+enum class Glyph
+{
+    Home,
+    NewDocument,
+    Open, ///< also the folder before a location
+    Unsaved,
+    Recent,
+    Pinned,
+    Update,
+    More,
+    Chevron,
+    Search,
+    ExternalLink, ///< "↗": the item opens a web page
+};
+
+/** Draws an outline glyph into the square rBox in rColor; bFilled fills the pin. */
+void DrawGlyph(OutputDevice& rDev, const tools::Rectangle& rBox, Glyph eGlyph, const Color& rColor,
+               bool bFilled = false);
+
+}
