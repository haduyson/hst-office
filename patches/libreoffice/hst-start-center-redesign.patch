+HstStartCenterWindow::HstStartCenterWindow(vcl::Window* pParent)
+    : vcl::Window(pParent, WB_DIALOGCONTROL | WB_CLIPCHILDREN)
+    , mpActions(std::make_unique<StartCenterActions>(*this))
+    , mpTimes(std::make_unique<RecentFileTimes>())
+{
+    SetPaintTransparent(false);
+    SetBackground(); // the canvas covers the window
+    mfScale = std::max(1.0, static_cast<double>(GetDPIScaleFactor()));
+    set_width_request(static_cast<int>(MIN_WINDOW_WIDTH * mfScale));
+
+    try
+    {
+        mxDesktop = frame::Desktop::create(comphelper::getProcessComponentContext());
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("sfx.startcenter", "no desktop");
+    }
+
+    mxCanvas = VclPtr<HstStartCenterCanvas>::Create(this, *mpActions);
+    mxCanvas->SetAccessibleName(SfxResId(STR_HST_SC_NAME));
+    InitTexts();
+    InitLogo();
+    InitSearch();
+    InitBanner();
+    InitActionWindows();
+    mxCanvas->SetChildWindows(mxSearchHost.get(), mxBannerHost.get());
+    mxCanvas->Show();
+    ReloadFiles();
+    mxDropTarget = GetDropTarget();
+}
+
+HstStartCenterWindow::~HstStartCenterWindow() { disposeOnce(); }
+
+void HstStartCenterWindow::dispose()
+{
+    mpTimes->Cancel(); // no file times arrive after this
+    if (mpPendingEvent)
+    {
+        Application::RemoveUserEvent(mpPendingEvent);
+        mpPendingEvent = nullptr;
+    }
+    if (mxDropTarget.is() && mxDropListener.is())
+    {
+        try
+        {
+            mxDropTarget->removeDropTargetListener(mxDropListener);
+            mxDropTarget->setActive(false);
+        }
+        catch (const uno::Exception&)
+        {
+            TOOLS_WARN_EXCEPTION("sfx.startcenter", "drop target");
+        }
+    }
+    mxDropTarget.clear();
+    mxDropListener.clear();
+    mpAccExec.reset();
+
+    for (VclPtr<vcl::Window>& rWindow : maActionWindows)
+        rWindow.disposeAndClear();
+    maActionWindows.clear();
+    mxBannerWeld.reset(); // before the drawing area goes with the builder
+    mxBanner.reset();
+    mxBannerHost.disposeAndClear();
+    mxSearch.reset();
+    mxSearchHost.disposeAndClear();
+    mxCanvas.disposeAndClear();
+    vcl::Window::dispose();
+}
