+    /** The URL of the file whose row has the focus, empty when no file row has it. */
+    OUString FocusedFileURL() const;
+    void TogglePinned(const OUString& rURL);
+    void RemoveFromList(const OUString& rURL);
+    void OpenFile(const OUString& rURL);
+    void OpenFolder(const OUString& rURL);
+    void OpenSolution(int nIndex);
+    void ShowNewMenu(const tools::Rectangle& rAt);
+    void ShowFileMenu(const OUString& rURL, const tools::Rectangle& rAt);
+    void RunNav(int nIndex);
+    /** Creates a document of a factory (private:factory/...). */
+    void CreateDocument(const OUString& rFactory);
+    void Dispatch(const OUString& rURL, const OUString& rTarget, bool bViaFrame,
+                  const css::uno::Sequence<css::beans::PropertyValue>& rArgs = {});
+    /** Runs rAction (pin, open, menu, nav, tile, solution) after the current event: actions
+        rebuild the model, or replace this window. */
