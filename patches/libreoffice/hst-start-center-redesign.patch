+void HstStartCenterWindow::ApplyStyle()
+{
+    const StyleSettings& rStyle = Application::GetSettings().GetStyleSettings();
+    *mpPalette = MakePalette(rStyle);
+    const Palette& rPalette = *mpPalette;
+
+    SetBackground(Wallpaper(rPalette.aWindow));
+    m_xContainer->set_background(rPalette.aWindow);
+    mxLeft->set_background(rPalette.aSide);
+    mxSolutions->set_background(rPalette.aSide);
+    mxSeparator->set_background(rPalette.aBorder);
+    mxRight->set_background(rPalette.aCard);
+
+    const vcl::Font& rLabelFont = rStyle.GetLabelFont();
+    vcl::Font aWelcome(rLabelFont);
+    aWelcome.SetFontHeight(rLabelFont.GetFontHeight() * 2.2);
+    aWelcome.SetWeight(WEIGHT_BOLD);
+    mxWelcome->set_font(aWelcome);
+    mxWelcome->set_font_color(rPalette.aAccent);
+
+    vcl::Font aHeading(rLabelFont);
+    aHeading.SetFontHeight(rLabelFont.GetFontHeight() * 1.3);
+    aHeading.SetWeight(WEIGHT_BOLD);
+    for (weld::Label* pLabel : { mxQuickTitle.get(), mxRecentTitle.get(), mxPinnedTitle.get() })
+        pLabel->set_font(aHeading);
+
+    vcl::Font aSmallHeading(rLabelFont);
+    aSmallHeading.SetWeight(WEIGHT_BOLD);
+    mxSolutionsTitle->set_font(aSmallHeading);
+    for (weld::Label* pLabel : { mxRecentEmpty.get(), mxPinnedEmpty.get() })
+        pLabel->set_font_color(rPalette.aMuted);
+
+    // the logo: the light or the inverted artwork, as wide as the menu leaves room for
+    Bitmap aLogo;
+    if (SfxApplication::loadBrandSvg(rPalette.bDark ? u"shell/logo-sc_inverted" : u"shell/logo-sc",
+                                     aLogo, static_cast<int>(170 * mfScale)))
+    {
+        ScopedVclPtr<VirtualDevice> xDev = mxLogo->create_virtual_device();
+        xDev->SetOutputSizePixel(aLogo.GetSizePixel());
+        xDev->SetBackground(Wallpaper(rPalette.aSide));
+        xDev->Erase();
+        xDev->DrawBitmap(Point(0, 0), aLogo);
+        mxLogo->set_image(xDev.get());
+    }
+
+    for (size_t i = 0; i < maMenu.size(); ++i)
+        PaintMenuItem(i);
+    for (size_t i = 0; i < maTiles.size(); ++i)
+        PaintTile(i);
+    FillRecentList(); // the glyphs of the table follow the colours
+}
+
+void HstStartCenterWindow::PaintMenuItem(size_t nIndex)
+{
+    MenuItem& rItem = maMenu[nIndex];
+    const bool bSelected = (nIndex == 0 && meSection == Section::Home)
+                           || (rItem.eGlyph == Glyph::Recent && meSection == Section::Recent)
+                           || (rItem.eGlyph == Glyph::Pinned && meSection == Section::Pinned);
+    const Size aSize(static_cast<tools::Long>((mbCompact ? LEFT_COMPACT_WIDTH - 12 : LEFT_WIDTH - 40) * mfScale),
+                     static_cast<tools::Long>(MENU_HEIGHT * mfScale));
+    ScopedVclPtr<VirtualDevice> xDev = rItem.xButton->create_virtual_device();
+    xDev->SetOutputSizePixel(aSize);
+    vcl::Font aFont(Application::GetSettings().GetStyleSettings().GetLabelFont());
+    aFont.SetFontHeight(aFont.GetFontHeight() * 1.1);
+    // the style font height is in points, the device draws in pixels
+    aFont.SetFontHeight(aFont.GetFontHeight() * xDev->GetDPIY() / 72.0);
+    sfx2::hst::startcenter::PaintMenuItem(*xDev, aSize, mfScale, rItem.eGlyph, rItem.aText, aFont,
+                                          *mpPalette, bSelected, static_cast<int>(nIndex) == mnHoverMenu,
+                                          mbCompact);
+    rItem.xButton->set_size_request(aSize.Width(), aSize.Height());
+    rItem.xButton->set_custom_button(xDev.get());
+    rItem.xButton->set_tooltip_text(mbCompact ? rItem.aText : OUString());
+}
+
+void HstStartCenterWindow::PaintTile(size_t nIndex)
+{
+    Tile& rTile = maTiles[nIndex];
+    const tools::Long nWidth
+        = std::max<tools::Long>(rTile.nWidth, static_cast<tools::Long>(150 * mfScale));
+    const Size aSize(nWidth, static_cast<tools::Long>(TILE_HEIGHT * mfScale));
+    ScopedVclPtr<VirtualDevice> xDev = rTile.xButton->create_virtual_device();
+    xDev->SetOutputSizePixel(aSize);
+    vcl::Font aFont(Application::GetSettings().GetStyleSettings().GetLabelFont());
+    aFont.SetFontHeight(aFont.GetFontHeight() * 1.25 * xDev->GetDPIY() / 72.0);
+    sfx2::hst::startcenter::PaintTile(*xDev, aSize, mfScale, nIndex, rTile.aText, aFont, *mpPalette,
+                                      static_cast<int>(nIndex) == mnHoverTile);
+    rTile.xButton->set_size_request(aSize.Width(), aSize.Height());
+    rTile.xButton->set_custom_button(xDev.get());
+}
+
+void HstStartCenterWindow::SetHover(int nMenu, int nTile)
+{
+    const int nOldMenu = mnHoverMenu;
+    const int nOldTile = mnHoverTile;
+    mnHoverMenu = nMenu;
+    mnHoverTile = nTile;
+    for (int nIndex : { nOldMenu, nMenu })
+        if (nIndex >= 0 && nOldMenu != nMenu)
+            PaintMenuItem(nIndex);
+    for (int nIndex : { nOldTile, nTile })
+        if (nIndex >= 0 && nOldTile != nTile)
+            PaintTile(nIndex);
+}
+
+void HstStartCenterWindow::Resize()
+{
+    InterimItemWindow::Resize();
+    UpdateLayout();
+}
+
+void HstStartCenterWindow::UpdateLayout()
+{
+    if (!mxLeft)
+        return;
+    const double fWidth = GetOutputSizePixel().Width() / mfScale;
+    if (fWidth <= 0)
+        return;
+    const bool bCompact = fWidth < COMPACT_WINDOW;
+    const bool bShowRight = fWidth >= RIGHT_COLUMN_MIN_WINDOW;
+    if (bCompact != mbCompact)
+    {
+        mbCompact = bCompact;
+        for (size_t i = 0; i < maMenu.size(); ++i)
+            PaintMenuItem(i);
+        mxSolutions->set_visible(!mbCompact);
+        mxSeparator->set_visible(!mbCompact);
+        mxLogo->set_visible(!mbCompact);
+    }
+    // the left column is at least as wide as the banner needs
+    const Size aBanner = HstBannerWidget::MinimumSize(GetDPIScaleFactor());
+    const int nLeft = mbCompact ? static_cast<int>(LEFT_COMPACT_WIDTH * mfScale)
+                                : std::max(static_cast<int>(LEFT_WIDTH * mfScale),
+                                           static_cast<int>(aBanner.Width() + 32 * mfScale));
+    mxLeft->set_size_request(nLeft, -1);
+
+    if (bShowRight != mbShowRight)
+    {
+        mbShowRight = bShowRight;
+        mxRight->set_visible(mbShowRight);
+        if (mbShowRight && mbPinnedOnly)
+        {
+            // the pinned files have their own column again
+            mbPinnedOnly = false;
+            FillRecentList();
+        }
+    }
+
+    // three tiles share the centre column; they repaint only when their width really changes
+    const double fRight = mbShowRight ? RIGHT_WIDTH : 0;
+    const double fCentre = fWidth - nLeft / mfScale - fRight - 64; // the centre's margins
+    const tools::Long nTile
+        = static_cast<tools::Long>(std::max(150.0, (fCentre - 2 * 16) / 3 - 12) * mfScale);
+    for (size_t i = 0; i < maTiles.size(); ++i)
+    {
+        if (std::abs(maTiles[i].nWidth - nTile) > 2)
+        {
+            maTiles[i].nWidth = nTile;
+            PaintTile(i);
+        }
+    }
+}
+
+void HstStartCenterWindow::SelectSection(Section eSection)
+{
+    meSection = eSection;
+    for (size_t i = 0; i < maMenu.size(); ++i)
+        PaintMenuItem(i);
+}
+
+void HstStartCenterWindow::setOwningFrame(const uno::Reference<frame::XFrame>& xFrame)
+{
+    mxFrame = xFrame;
+    if (mxDropTarget.is() && !mxDropListener.is())
+    {
+        try
+        {
+            mxDropListener.set(new OpenFileDropTargetListener(
+                comphelper::getProcessComponentContext(), mxFrame));
+            mxDropTarget->addDropTargetListener(mxDropListener);
+            mxDropTarget->setActive(true);
+        }
+        catch (const uno::Exception&)
+        {
+            TOOLS_WARN_EXCEPTION("sfx.startcenter", "drop target");
+        }
+    }
+    uno::Reference<frame::XFramesSupplier> xFrames(mxDesktop, uno::UNO_QUERY);
+    if (xFrames.is())
+        xFrames->setActiveFrame(mxFrame);
+}
+
+void HstStartCenterWindow::Dispatch(const OUString& rURL, const OUString& rTarget, bool bViaFrame,
+                                    const uno::Sequence<beans::PropertyValue>& rArgs)
+{
+    uno::Reference<frame::XDispatchProvider> xProvider(
+        bViaFrame ? uno::Reference<frame::XDispatchProvider>(mxFrame, uno::UNO_QUERY) : mxDesktop);
+    if (!xProvider.is())
+        return;
+    try
+    {
+        auto pDispatch = std::make_unique<ImplDispatch>();
+        pDispatch->aURL.Complete = rURL;
+        util::URLTransformer::create(comphelper::getProcessComponentContext())
+            ->parseStrict(pDispatch->aURL);
+        pDispatch->xDispatch = xProvider->queryDispatch(pDispatch->aURL, rTarget, 0);
+        if (!pDispatch->xDispatch.is())
+        {
+            SAL_WARN("sfx.startcenter", "no dispatch for " << rURL);
+            return;
+        }
+        pDispatch->aArgs = rArgs;
+        // after this click returns: the dispatch may replace this window
+        if (Application::PostUserEvent(LINK_NONMEMBER(nullptr, dispatchLater), pDispatch.get()))
+            pDispatch.release();
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("sfx.startcenter", "dispatch of " << rURL);
+    }
+}
+
+IMPL_LINK(HstStartCenterWindow, MenuClickHdl, weld::Button&, rButton, void)
+{
+    const OUString aId = rButton.get_buildable_name();
+    if (aId == "nav_home")
+    {
+        mbPinnedOnly = false;
+        mxSearch->set_text(OUString());
+        FillRecentList();
+        SelectSection(Section::Home);
+        mxSearch->grab_focus();
+    }
+    else if (aId == "nav_new")
+    {
+        int nX, nY, nWidth, nHeight;
+        if (!rButton.get_extents_relative_to(rButton, nX, nY, nWidth, nHeight))
+            return;
+        const OUString aChoice
+            = mxNewMenu->popup_at_rect(&rButton, tools::Rectangle(Point(0, 0), Size(nWidth, nHeight)),
+                                       weld::Placement::End);
+        if (aChoice == "new_writer")
+            Dispatch(maTiles[0].aFactory, u"_default"_ustr, false);
+        else if (aChoice == "new_calc")
+            Dispatch(maTiles[1].aFactory, u"_default"_ustr, false);
+        else if (aChoice == "new_impress")
+            Dispatch(maTiles[2].aFactory, u"_default"_ustr, false);
+        else if (aChoice == "new_draw")
+            Dispatch(u"private:factory/sdraw"_ustr, u"_default"_ustr, false);
+        else if (aChoice == "new_template")
+            Dispatch(u".uno:NewDoc"_ustr, OUString(), true);
+    }
+    else if (aId == "open_all")
+        Dispatch(u".uno:Open"_ustr, OUString(), true,
+                 { comphelper::makePropertyValue(u"Referer"_ustr, u"private:user"_ustr) });
+    else if (aId == "nav_recent")
+    {
+        mbPinnedOnly = false;
+        FillRecentList();
+        SelectSection(Section::Recent);
+        mxRecentList->grab_focus();
+    }
+    else if (aId == "nav_pinned")
+    {
+        SelectSection(Section::Pinned);
+        if (mbShowRight)
+            mxPinnedList->grab_focus();
+        else
+        {
+            // no room for the pinned column: the recent table shows the pinned files
+            mbPinnedOnly = true;
+            FillRecentList();
+            mxRecentList->grab_focus();
+        }
+    }
+    else if (aId == "nav_update")
+        Dispatch(UPDATE_CHECK, OUString(), true);
+}
+
+IMPL_LINK(HstStartCenterWindow, TileClickHdl, weld::Button&, rButton, void)
+{
+    for (const Tile& rTile : maTiles)
+        if (rTile.xButton.get() == &rButton)
+            return Dispatch(rTile.aFactory, u"_default"_ustr, false);
+    if (&rButton == mxDrawButton.get())
+        Dispatch(u"private:factory/sdraw"_ustr, u"_default"_ustr, false);
+    else if (&rButton == mxMathButton.get())
+        Dispatch(u"private:factory/smath"_ustr, u"_default"_ustr, false);
+    else if (&rButton == mxBaseButton.get())
+        Dispatch(u"private:factory/sdatabase?Interactive"_ustr, u"_default"_ustr, false);
+}
+
+IMPL_LINK(HstStartCenterWindow, SolutionClickHdl, weld::Button&, rButton, void)
+{
+    OUString aURL;
+    if (&rButton == mxMoreSolutions.get())
+        aURL = MORE_SOLUTIONS_URL;
+    for (size_t i = 0; aURL.isEmpty() && i < maSolutionButtons.size(); ++i)
+        if (maSolutionButtons[i].get() == &rButton)
+            aURL = aSolutions[i].aURL;
+    if (aURL.isEmpty())
+        return;
+    try
+    {
+        system::SystemShellExecute::create(comphelper::getProcessComponentContext())
+            ->execute(aURL + "?" + SOLUTION_UTM, OUString(),
+                      system::SystemShellExecuteFlags::URIS_ONLY);
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("sfx.startcenter", "opening the HASON TECH page failed");
+    }
+}
+
+void HstStartCenterWindow::FocusRegion(int nDelta)
+{
+    // F6 regions: the left menu, the search box, the recent table, the pinned list
+    std::vector<weld::Widget*> aRegions{ maMenu.front().xButton.get(), mxSearch.get() };
+    if (mxRecentList->get_visible())
+        aRegions.push_back(mxRecentList.get());
+    if (mbShowRight && mxPinnedList->get_visible())
+        aRegions.push_back(mxPinnedList.get());
+    int nCurrent = -1;
+    for (size_t i = 0; i < aRegions.size(); ++i)
+        if (aRegions[i]->has_focus())
+            nCurrent = i;
+    if (nCurrent < 0)
+        for (const MenuItem& rItem : maMenu)
+            if (rItem.xButton->has_focus())
+                nCurrent = 0;
+    const int nCount = aRegions.size();
+    const int nNext = nCurrent < 0 ? 0 : (nCurrent + nDelta + nCount) % nCount;
+    aRegions[nNext]->grab_focus();
+}
+
+bool HstStartCenterWindow::PreNotify(NotifyEvent& rNEvt)
+{
+    if (rNEvt.GetType() == NotifyEventType::KEYINPUT && mxSearch)
+    {
+        const vcl::KeyCode& rKey = rNEvt.GetKeyEvent()->GetKeyCode();
+        if (rKey.GetCode() == KEY_F6 && !rKey.IsMod1() && !rKey.IsMod2())
+        {
+            FocusRegion(rKey.IsShift() ? -1 : 1);
+            return true;
+        }
+        // the office's shortcuts (Ctrl+N, Ctrl+O, Ctrl+Q...), except the editing keys of the search box
+        const bool bTyping = mxSearch->has_focus() && (!rKey.IsMod1() || rKey.GetCode() == KEY_A
+                                                       || rKey.GetCode() == KEY_C || rKey.GetCode() == KEY_V
+                                                       || rKey.GetCode() == KEY_X || rKey.GetCode() == KEY_Z
+                                                       || rKey.GetCode() == KEY_Y);
+        if (!bTyping && mxFrame.is())
+        {
+            if (!mpAccExec)
+            {
+                mpAccExec = svt::AcceleratorExecute::createAcceleratorHelper();
+                mpAccExec->init(comphelper::getProcessComponentContext(), mxFrame);
+            }
+            const OUString aCommand
+                = mpAccExec->findCommand(svt::AcceleratorExecute::st_VCLKey2AWTKey(rKey));
+            if (aCommand != "vnd.sun.star.findbar:FocusToFindbar" && mpAccExec->execute(rKey))
+                return true;
+        }
+    }
+    return InterimItemWindow::PreNotify(rNEvt);
+}
+
+void HstStartCenterWindow::GetFocus()
+{
+    const GetFocusFlags nFlags = GetParent()->GetGetFocusFlags();
+    if (mxSearch && (nFlags & GetFocusFlags::F6))
+    {
+        if (nFlags & GetFocusFlags::Forward)
+            maMenu.front().xButton->grab_focus();
+        else
+            mxRecentList->grab_focus();
+        return;
+    }
+    InterimItemWindow::GetFocus();
+}
+
+void HstStartCenterWindow::DataChanged(const DataChangedEvent& rDCEvt)
+{
+    InterimItemWindow::DataChanged(rDCEvt);
+    if (rDCEvt.GetType() == DataChangedEventType::SETTINGS
+        && (rDCEvt.GetFlags() & AllSettingsFlags::STYLE) && mxLeft)
+    {
+        ApplyStyle();
+        Invalidate();
+    }
+}
