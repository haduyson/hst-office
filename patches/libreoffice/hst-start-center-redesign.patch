+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * This file is part of HST Office.
+ */
+
+#pragma once
+
+#include <rtl/ustring.hxx>
+#include <tools/color.hxx>
+#include <tools/gen.hxx>
+
+class Image;
+class OutputDevice;
+class StyleSettings;
+namespace vcl
+{
+class Font;
+}
+
+/* HST Office Start Center: colours of the light and dark looks, and the drawing of the parts the
+   toolkits cannot style alike on every platform (the left menu items, the three "create" tiles and
+   the small glyphs of the recent table). Every glyph is drawn here from simple lines, in the text
+   colour of the theme, so it follows light and dark without image files. */
+namespace sfx2::hst::startcenter
+{
+struct Palette
+{
+    bool bDark = false;
+    Color aWindow; ///< centre and right column
+    Color aText;
+    Color aMuted; ///< secondary text (folders, dates, hints)
+    Color aSide; ///< the left column
+    Color aAccent; ///< headings, the selected menu item, a pinned file
+    Color aSelected; ///< background of the selected menu item
+    Color aHover; ///< background of a hovered menu item
+    Color aBorder; ///< card and tile borders, the separator
+    Color aCard; ///< the "Pinned" card
+    Color aTile[3]; ///< Document, Spreadsheet, Presentation tiles
+    Color aTileBorder[3];
+    Color aTileAccent[3];
+};
+
+Palette MakePalette(const StyleSettings& rStyle);
+
+enum class Glyph
+{
+    Home,
+    NewDocument,
+    Open,
+    Recent,
+    Pinned,
+    Update,
+    More,
+    Chevron,
+    Document,
+    Spreadsheet,
+    Presentation,
+};
+
+/** Draws rGlyph in the square rBox with strokes in rColor; bFilled fills the pin. */
+void DrawGlyph(OutputDevice& rDev, const tools::Rectangle& rBox, Glyph eGlyph, const Color& rColor,
+               bool bFilled = false);
+
+/** One item of the left menu (bCompact: the glyph alone, for a narrow window). */
+void PaintMenuItem(OutputDevice& rDev, const Size& rSize, double fScale, Glyph eGlyph,
+                   const OUString& rText, const vcl::Font& rFont, const Palette& rPalette,
+                   bool bSelected, bool bHover, bool bCompact);
+
+/** A "create" tile: nKind 0 Document, 1 Spreadsheet, 2 Presentation. */
+void PaintTile(OutputDevice& rDev, const Size& rSize, double fScale, int nKind,
+               const OUString& rText, const vcl::Font& rFont, const Palette& rPalette, bool bHover);
+}
+
+/* vim:set shiftwidth=4 softtabstop=4 expandtab: */
