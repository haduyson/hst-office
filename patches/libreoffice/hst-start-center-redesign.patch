+/** A region of the canvas: the menu, the tiles, a list of files or the solutions. */
+class CanvasRegionAccessible final : public comphelper::OAccessible
+{
+public:
+    CanvasRegionAccessible(CanvasAccessible& rRoot, Part eRegion, sal_Int64 nIndexInParent)
+        : mrRoot(rRoot)
+        , meRegion(eRegion)
+        , mnIndexInParent(nIndexInParent)
+    {
+    }
+
+    Part GetRegion() const { return meRegion; }
+
+    /** The items: the files of a list, the buttons of the other regions ("Xem thêm" after the
+        solutions). */
+    int ItemCount() const
+    {
+        HstStartCenterCanvas* pCanvas = mrRoot.GetCanvas();
+        if (!pCanvas)
+            return 0;
+        if (meRegion == Part::Solution)
+            return pCanvas->ItemCount(Part::Solution) + pCanvas->ItemCount(Part::MoreSolutions);
+        return pCanvas->ItemCount(meRegion);
+    }
+
+    Hit HitOf(int nIndex) const
+    {
+        if (meRegion == Part::Solution && nIndex == SOLUTION_COUNT)
+            return { Part::MoreSolutions, 0 };
+        return { meRegion, nIndex };
+    }
+
+    CanvasItemAccessible* Item(int nIndex)
+    {
+        if (nIndex < 0 || nIndex >= ItemCount())
+            return nullptr;
+        if (static_cast<int>(maItems.size()) <= nIndex)
+            maItems.resize(nIndex + 1);
+        if (!maItems[nIndex].is())
+            maItems[nIndex] = new CanvasItemAccessible(*this, mrRoot, HitOf(nIndex));
+        return maItems[nIndex].get();
+    }
+
+    CanvasItemAccessible* ItemFor(const Hit& rHit)
+    {
+        if (rHit.ePart == Part::MoreSolutions)
+            return Item(SOLUTION_COUNT);
+        return Item(rHit.nIndex);
+    }
+
+    void Notify(sal_Int16 nEventId, const uno::Any& rOld, const uno::Any& rNew)
+    {
+        NotifyAccessibleEvent(nEventId, rOld, rNew);
+    }
+
+    tools::Rectangle Area() const
+    {
+        HstStartCenterCanvas* pCanvas = mrRoot.GetCanvas();
+        return pCanvas ? regionRect(*pCanvas, meRegion) : tools::Rectangle();
+    }
+
+    virtual sal_Int64 SAL_CALL getAccessibleChildCount() override
+    {
+        SolarMutexGuard aGuard;
+        ensureAlive();
+        return ItemCount();
+    }
+    virtual uno::Reference<XAccessible> SAL_CALL getAccessibleChild(sal_Int64 nIndex) override
+    {
+        SolarMutexGuard aGuard;
+        ensureAlive();
+        CanvasItemAccessible* pItem = nIndex <= SAL_MAX_INT32 ? Item(static_cast<int>(nIndex)) : nullptr;
+        if (!pItem)
+            throw lang::IndexOutOfBoundsException();
+        return pItem;
+    }
+    virtual uno::Reference<XAccessible> SAL_CALL getAccessibleParent() override { return &mrRoot; }
+    virtual sal_Int64 SAL_CALL getAccessibleIndexInParent() override { return mnIndexInParent; }
+    virtual sal_Int16 SAL_CALL getAccessibleRole() override
+    {
+        return meRegion == Part::Recent || meRegion == Part::Pinned ? AccessibleRole::LIST
+                                                                    : AccessibleRole::PANEL;
+    }
+    virtual OUString SAL_CALL getAccessibleDescription() override
+    {
+        SolarMutexGuard aGuard;
+        HstStartCenterCanvas* pCanvas = mrRoot.GetCanvas();
+        if (!pCanvas || (meRegion != Part::Recent && meRegion != Part::Pinned))
+            return OUString();
+        return pCanvas->GetTexts().aRowHint;
+    }
+    virtual OUString SAL_CALL getAccessibleName() override
+    {
+        SolarMutexGuard aGuard;
+        HstStartCenterCanvas* pCanvas = mrRoot.GetCanvas();
+        if (!pCanvas)
+            return OUString();
+        const CanvasTexts& rTexts = pCanvas->GetTexts();
+        switch (meRegion)
+        {
+            case Part::Nav:
+                return rTexts.aMenuName;
+            case Part::Tile:
+                return rTexts.aQuickTitle;
+            case Part::Recent:
+                return rTexts.aRecentName;
+            case Part::Pinned:
+                return rTexts.aPinnedName;
+            case Part::Solution:
+                return rTexts.aSolutionsTitle;
+            default:
+                return OUString();
+        }
+    }
+    virtual uno::Reference<XAccessibleRelationSet> SAL_CALL getAccessibleRelationSet() override
+    {
+        return new utl::AccessibleRelationSetHelper;
+    }
+    virtual sal_Int64 SAL_CALL getAccessibleStateSet() override
+    {
+        SolarMutexGuard aGuard;
+        HstStartCenterCanvas* pCanvas = mrRoot.GetCanvas();
+        if (!isAlive() || !pCanvas)
+            return AccessibleStateType::DEFUNC;
+        sal_Int64 nStates = AccessibleStateType::ENABLED | AccessibleStateType::SENSITIVE
+                            | AccessibleStateType::VISIBLE;
+        if (pCanvas->IsReallyVisible())
+            nStates |= AccessibleStateType::SHOWING;
+        if (meRegion == Part::Recent || meRegion == Part::Pinned)
+            nStates |= AccessibleStateType::MANAGES_DESCENDANTS;
+        return nStates;
+    }
+    virtual uno::Reference<XAccessible> SAL_CALL getAccessibleAtPoint(const awt::Point& rPoint) override
+    {
+        SolarMutexGuard aGuard;
+        ensureAlive();
+        const tools::Rectangle aArea = Area();
+        const Point aPos(aArea.Left() + rPoint.X, aArea.Top() + rPoint.Y);
+        for (int i = 0; i < ItemCount(); ++i)
+        {
+            HstStartCenterCanvas* pCanvas = mrRoot.GetCanvas();
+            const Hit aHit = HitOf(i);
+            if (pCanvas && pCanvas->IsItemShowing(aHit) && pCanvas->GetLayout().ItemRect(aHit).Contains(aPos))
+                return Item(i);
+        }
+        return nullptr;
+    }
+    virtual void SAL_CALL grabFocus() override
+    {
+        SolarMutexGuard aGuard;
+        if (HstStartCenterCanvas* pCanvas = mrRoot.GetCanvas())
+            pCanvas->FocusRegion(meRegion);
+    }
+    virtual sal_Int32 SAL_CALL getForeground() override
+    {
+        SolarMutexGuard aGuard;
+        HstStartCenterCanvas* pCanvas = mrRoot.GetCanvas();
+        return pCanvas ? sal_Int32(pCanvas->GetPalette().aText) : 0;
+    }
+    virtual sal_Int32 SAL_CALL getBackground() override
+    {
+        SolarMutexGuard aGuard;
+        HstStartCenterCanvas* pCanvas = mrRoot.GetCanvas();
+        return pCanvas ? sal_Int32(pCanvas->GetPalette().aCard) : 0;
+    }
+
+protected:
+    virtual awt::Rectangle implGetBounds() override { return toAwt(Area(), Point(0, 0)); }
+
+    virtual void SAL_CALL disposing() override
+    {
+        for (rtl::Reference<CanvasItemAccessible>& rItem : maItems)
+            if (rItem.is())
+                rItem->dispose();
+        maItems.clear();
+        comphelper::OAccessible::disposing();
+    }
+
+private:
+    CanvasAccessible& mrRoot;
+    Part meRegion;
+    sal_Int64 mnIndexInParent;
+    std::vector<rtl::Reference<CanvasItemAccessible>> maItems;
+};
+
+uno::Reference<XAccessible> SAL_CALL CanvasItemAccessible::getAccessibleParent() { return &mrRegion; }
+
+awt::Rectangle CanvasItemAccessible::implGetBounds()
+{
+    HstStartCenterCanvas* pCanvas = mrRoot.GetCanvas();
+    if (!pCanvas)
+        return awt::Rectangle();
+    return toAwt(pCanvas->GetLayout().ItemRect(maHit), mrRegion.Area().TopLeft());
+}
