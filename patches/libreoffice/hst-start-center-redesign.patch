+/** The rectangle of an accessible object in the coordinates of its parent. */
+tools::Rectangle bounds(const uno::Reference<XAccessibleContext>& xContext)
+{
+    uno::Reference<XAccessibleComponent> xComponent(xContext, uno::UNO_QUERY_THROW);
+    const awt::Rectangle aRect = xComponent->getBounds();
+    return tools::Rectangle(Point(aRect.X, aRect.Y), Size(aRect.Width, aRect.Height));
+}
