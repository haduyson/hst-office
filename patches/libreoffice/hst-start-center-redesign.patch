+CPPUNIT_TEST_FIXTURE(HstStartCenterTest, testCrispBorders)
+{
+    // a 1 px border is one column of its own colour, not a half-and-half mix with the fill or
+    // the background beside it; and a 2 px ring is two such columns
+    const Color aBack(0xEE, 0xF2, 0xF8), aFill(COL_WHITE), aBorder(0xD9, 0xE1, 0xEB);
+    ScopedVclPtrInstance<VirtualDevice> xDev;
+    xDev->SetOutputSizePixel(Size(80, 60));
+    xDev->SetBackground(Wallpaper(aBack));
+    xDev->Erase();
+    const tools::Rectangle aRect(Point(10, 10), Size(50, 30));
+    ::hst::design::DrawRoundRect(*xDev, aRect, 10, aFill, aBorder);
+    const tools::Long nMidY = aRect.Center().Y(), nMidX = aRect.Center().X();
+    CPPUNIT_ASSERT_EQUAL(aBack, xDev->GetPixel(Point(aRect.Left() - 1, nMidY)));
+    CPPUNIT_ASSERT_EQUAL(aBorder, xDev->GetPixel(Point(aRect.Left(), nMidY)));
+    CPPUNIT_ASSERT_EQUAL(aFill, xDev->GetPixel(Point(aRect.Left() + 1, nMidY)));
+    CPPUNIT_ASSERT_EQUAL(aFill, xDev->GetPixel(Point(aRect.Right() - 1, nMidY)));
+    CPPUNIT_ASSERT_EQUAL(aBorder, xDev->GetPixel(Point(aRect.Right(), nMidY)));
+    CPPUNIT_ASSERT_EQUAL(aBack, xDev->GetPixel(Point(aRect.Right() + 1, nMidY)));
+    CPPUNIT_ASSERT_EQUAL(aBack, xDev->GetPixel(Point(nMidX, aRect.Top() - 1)));
+    CPPUNIT_ASSERT_EQUAL(aBorder, xDev->GetPixel(Point(nMidX, aRect.Top())));
+    CPPUNIT_ASSERT_EQUAL(aFill, xDev->GetPixel(Point(nMidX, aRect.Top() + 1)));
+    CPPUNIT_ASSERT_EQUAL(aBorder, xDev->GetPixel(Point(nMidX, aRect.Bottom())));
+    CPPUNIT_ASSERT_EQUAL(aBack, xDev->GetPixel(Point(nMidX, aRect.Bottom() + 1)));
+
+    // a fill without border covers exactly its pixels
+    xDev->Erase();
+    ::hst::design::DrawRoundRect(*xDev, aRect, 10, aBorder, COL_TRANSPARENT);
+    CPPUNIT_ASSERT_EQUAL(aBack, xDev->GetPixel(Point(aRect.Left() - 1, nMidY)));
+    CPPUNIT_ASSERT_EQUAL(aBorder, xDev->GetPixel(Point(aRect.Left(), nMidY)));
+    CPPUNIT_ASSERT_EQUAL(aBorder, xDev->GetPixel(Point(aRect.Right(), nMidY)));
+    CPPUNIT_ASSERT_EQUAL(aBack, xDev->GetPixel(Point(aRect.Right() + 1, nMidY)));
+
+    // a 2 px outline: both columns inside the rectangle, crisp
+    xDev->Erase();
+    ::hst::design::DrawRoundRect(*xDev, aRect, 10, COL_TRANSPARENT, aBorder, 2.0);
+    CPPUNIT_ASSERT_EQUAL(aBack, xDev->GetPixel(Point(aRect.Left() - 1, nMidY)));
+    CPPUNIT_ASSERT_EQUAL(aBorder, xDev->GetPixel(Point(aRect.Left(), nMidY)));
+    CPPUNIT_ASSERT_EQUAL(aBorder, xDev->GetPixel(Point(aRect.Left() + 1, nMidY)));
+    CPPUNIT_ASSERT_EQUAL(aBack, xDev->GetPixel(Point(aRect.Left() + 2, nMidY)));
+}
