+namespace sfx2::hst::startcenter
+{
+namespace
+{
+// Layout pixels (multiplied by the scale); the proportions follow the owner's mockup, fitted to a
+// 1366 x 768 window at 100 %.
+constexpr double LEFT_COMPACT_WIDTH = 64;
+constexpr double LOGO_HEIGHT = 36;
+// the menu rows with the mockup's spacing (a 40 px pill every 44 px), tightened only when the
+// column would otherwise scroll
+constexpr double NAV_HEIGHT = 40;
+constexpr double NAV_MIN_HEIGHT = 24;
+constexpr double NAV_GAP = 4;
+constexpr double CARD_GAP = 7; // between the solution cards
+constexpr double RIGHT_WIDTH = 288;
+constexpr double OUTER = 24; // window edge to the Pinned card, and below the cards
+constexpr double CENTRE_LEFT = 44;
+constexpr double CENTRE_RIGHT = 28;
+constexpr double SEARCH_HEIGHT = 42;
+constexpr double SEARCH_MAX_WIDTH = 600;
+constexpr double TILE_HEIGHT = 76;
+constexpr double TILE_GAP = 16;
+constexpr double HEADER_HEIGHT = 42;
+constexpr double ROW_HEIGHT = 52;
+constexpr double SCROLL_WIDTH = 6;
+// the window widths (layout pixels) below which the Pinned card folds away / the menu narrows
+constexpr double SHOW_RIGHT_MIN = 1180;
+constexpr double COMPACT_BELOW = 860;
+
+tools::Rectangle rect(tools::Long nX, tools::Long nY, tools::Long nWidth, tools::Long nHeight)
+{
+    return tools::Rectangle(Point(nX, nY), Size(std::max<tools::Long>(nWidth, 0),
+                                                std::max<tools::Long>(nHeight, 0)));
+}
+
+tools::Rectangle moved(tools::Rectangle aRect, tools::Long nDY)
+{
+    aRect.Move(0, nDY);
+    return aRect;
+}
+
+/** A square of nSize centred vertically in rIn, at nLeft (or centred horizontally too). */
+tools::Rectangle centred(const tools::Rectangle& rIn, tools::Long nSize, tools::Long nLeft = -1)
+{
+    const tools::Long nX = nLeft >= 0 ? nLeft : rIn.Left() + (rIn.GetWidth() - nSize) / 2;
+    return tools::Rectangle(Point(nX, rIn.Top() + (rIn.GetHeight() - nSize) / 2), Size(nSize, nSize));
+}
+}
+
+double UiScale(double fDpiScaleFactor, double fDpiX)
+{
+    return std::max({ 1.0, fDpiScaleFactor, fDpiX > 0 ? fDpiX / 96.0 : 1.0 });
+}
+
+tools::Long SolutionTextWidth(double fScale)
+{
+    Layout L;
+    L.fScale = fScale > 0 ? fScale : 1.0;
+    const tools::Long nInner = L.px(LEFT_WIDTH) - 2 * L.px(LEFT_PAD);
+    return (nInner - L.px(CARD_GAP)) / 2 - 2 * L.px(SOLUTION_PAD);
+}
+
+Layout ComputeLayout(const LayoutInput& rIn)
+{
+    Layout L;
+    L.aSize = rIn.aSize;
+    L.fScale = rIn.fScale > 0 ? rIn.fScale : 1.0;
+    const double fLogicalWidth = rIn.aSize.Width() / L.fScale;
+    L.bCompact = fLogicalWidth < COMPACT_BELOW;
+    L.bShowRight = rIn.aSize.Width() / (rIn.fModeScale > 0 ? rIn.fModeScale : L.fScale) >= SHOW_RIGHT_MIN;
+    const tools::Long W = rIn.aSize.Width();
+    const tools::Long H = rIn.aSize.Height();
+
+    // ---- the left panel: logo, menu, then the HASON TECH block; it scrolls as one column
+    const tools::Long nLeftW = L.px(L.bCompact ? LEFT_COMPACT_WIDTH : LEFT_WIDTH);
+    L.aLeft = rect(0, 0, nLeftW, H);
+    const tools::Long nPad = L.px(LEFT_PAD);
+    const tools::Long nInner = nLeftW - 2 * nPad;
+    // the column fits the 741 px of a 1366 x 768 screen below the menu bar without scrolling; laid
+    // out for a given menu row height, it returns its height
+    auto layoutLeft = [&](tools::Long nNavH) {
+        tools::Long y = L.px(10);
+        if (!L.bCompact)
+        {
+            L.aLogo = rect(nPad + L.px(6), y, nInner - L.px(6), L.px(LOGO_HEIGHT));
+            y += L.px(LOGO_HEIGHT) + L.px(6);
+        }
+        else
+            y += L.px(8);
+        for (int i = 0; i < NAV_COUNT; ++i)
+        {
+            L.aNav[i] = rect(nPad, y, nInner, nNavH);
+            y += nNavH + L.px(NAV_GAP);
+        }
+        if (!L.bCompact)
+        {
+            y += L.px(5);
+            L.aSeparator = rect(nPad, y, nInner, 1);
+            y += L.px(6);
+            L.aSolutionsTitle = rect(nPad, y, nInner, rIn.nSolutionsTitle);
+            y += rIn.nSolutionsTitle + L.px(4);
+            // a card: its logo (with the external-link mark beside it), the name below, then the tagline
+            const tools::Long nCardW = (nInner - L.px(CARD_GAP)) / 2;
+            const tools::Long nCardH = L.px(SOLUTION_PAD_TOP) + L.px(SOLUTION_LOGO) + L.px(SOLUTION_NAME_GAP)
+                                       + rIn.nCardTitle + L.px(1) + std::max(1, rIn.nSolutionLines) * rIn.nSmall
+                                       + L.px(SOLUTION_PAD_TOP);
+            for (int i = 0; i < SOLUTION_COUNT; ++i)
+            {
+                const int nRow = i / 2;
+                const int nCol = i % 2;
+                L.aSolutions[i] = rect(nPad + nCol * (nCardW + L.px(CARD_GAP)),
+                                       y + nRow * (nCardH + L.px(CARD_GAP)), nCardW, nCardH);
+            }
+            y += 3 * nCardH + 2 * L.px(CARD_GAP) + L.px(4);
+            L.aMore = rect(nPad, y, nInner, rIn.nBody + L.px(6));
+            y += rIn.nBody + L.px(6);
+        }
+        return y + L.px(4);
+    };
+    tools::Long nNavH = std::max(L.px(NAV_HEIGHT), rIn.nNav + L.px(7));
+    tools::Long y = layoutLeft(nNavH);
+    if (y > H)
+    {
+        // tighter menu rows before the column has to scroll (a short window; the fonts of a
+        // platform or a DPI that run taller than the layout pixels)
+        const tools::Long nTight = std::max(L.px(NAV_MIN_HEIGHT), rIn.nNav + L.px(4));
+        const tools::Long nTighter = std::max(nTight, nNavH - (y - H + NAV_COUNT - 1) / NAV_COUNT);
+        if (nTighter < nNavH)
+        {
+            nNavH = nTighter;
+            y = layoutLeft(nNavH);
+        }
+    }
+    L.nLeftContent = y;
+    L.nLeftScroll = std::clamp<tools::Long>(rIn.nLeftScroll, 0, std::max<tools::Long>(0, y - H));
+    const tools::Long nUp = -L.nLeftScroll;
+    L.aLogo = L.aLogo.IsEmpty() ? L.aLogo : moved(L.aLogo, nUp);
+    for (tools::Rectangle& rNav : L.aNav)
+        rNav = moved(rNav, nUp);
+    if (!L.bCompact)
+    {
+        L.aSeparator = moved(L.aSeparator, nUp);
+        L.aSolutionsTitle = moved(L.aSolutionsTitle, nUp);
+        for (tools::Rectangle& rCard : L.aSolutions)
+            rCard = moved(rCard, nUp);
+        L.aMore = moved(L.aMore, nUp);
+    }
+
+    // ---- the centre column
+    const tools::Long nCentreX = nLeftW + L.px(L.bCompact ? 28 : CENTRE_LEFT);
+    const tools::Long nCentreRight
+        = W - (L.bShowRight ? L.px(OUTER + RIGHT_WIDTH + CENTRE_RIGHT) : L.px(CENTRE_RIGHT));
+    const tools::Long nCentreW = std::max<tools::Long>(nCentreRight - nCentreX, L.px(320));
+    L.aCentre = rect(nCentreX, 0, nCentreW, H);
+    y = L.px(30);
+    L.aWelcome = rect(nCentreX, y, nCentreW, rIn.nWelcome);
+    y += rIn.nWelcome + L.px(14);
+    L.aSearch = rect(nCentreX, y, std::min(nCentreW, L.px(SEARCH_MAX_WIDTH)), L.px(SEARCH_HEIGHT));
+    const tools::Long nIcon = L.px(18);
+    L.aSearchIcon = rect(L.aSearch.Left() + L.px(14), L.aSearch.Top() + (L.aSearch.GetHeight() - nIcon) / 2,
+                         nIcon, nIcon);
+    const tools::Long nEditH = std::min(L.aSearch.GetHeight() - L.px(8), rIn.nBody + L.px(10));
+    L.aSearchText = rect(L.aSearchIcon.Right() + L.px(10),
+                         L.aSearch.Top() + (L.aSearch.GetHeight() - nEditH) / 2,
+                         L.aSearch.Right() - L.px(12) - L.aSearchIcon.Right() - L.px(10), nEditH);
+    y += L.px(SEARCH_HEIGHT) + L.px(26);
+    L.aQuickTitle = rect(nCentreX, y, nCentreW, rIn.nTitle);
+    const tools::Long nQuickTop = y;
+    y += rIn.nTitle + L.px(12);
+    const tools::Long nTileW = (nCentreW - 2 * L.px(TILE_GAP)) / 3;
+    const tools::Long nTileH = std::max(L.px(TILE_HEIGHT), rIn.nTitle + L.px(36));
+    for (int i = 0; i < TILE_COUNT; ++i)
+        L.aTiles[i] = rect(nCentreX + i * (nTileW + L.px(TILE_GAP)), y, nTileW, nTileH);
+    y += nTileH + L.px(26);
+    L.aRecentTitle = rect(nCentreX, y, nCentreW, rIn.nTitle);
+    y += rIn.nTitle + L.px(12);
+
+    L.nRowHeight = std::max(L.px(ROW_HEIGHT), rIn.nBody + L.px(24));
+    const tools::Long nHeader = std::max(L.px(HEADER_HEIGHT), rIn.nBody + L.px(20));
+    L.nCentreContent = y + nHeader + 2 * L.nRowHeight + L.px(OUTER);
+    const tools::Long nCardBottom = std::max(H - L.px(OUTER), y + nHeader + 2 * L.nRowHeight);
+    L.aRecentCard = rect(nCentreX, y, nCentreW, nCardBottom - y);
+    L.aRecentHeader = rect(nCentreX, y, nCentreW, nHeader);
+    L.aRecentBody = rect(nCentreX, y + nHeader, nCentreW, nCardBottom - y - nHeader);
+    L.nRecent = std::max(0, rIn.nRecent);
+    L.nRecentFirst = std::clamp(rIn.nRecentFirst, 0, std::max(0, L.nRecent - L.RecentVisibleRows()));
+
+    // columns: icon | name | opened | folder glyph | folder | pin | ⋯
+    const bool bNarrow = nCentreW < L.px(620);
+    const tools::Long nX0 = nCentreX + L.px(18);
+    L.nColEnd = L.aRecentCard.Right() - L.px(10);
+    // the name takes what the other columns leave: they are as narrow as their content needs
+    L.nColMore = L.nColEnd - L.px(30);
+    L.nColPin = L.nColMore - L.px(30);
+    L.nColFolder = L.nColPin - L.px(bNarrow ? 96 : 112);
+    L.nColFolderIcon = L.nColFolder - L.px(24);
+    L.nColOpened = L.nColFolderIcon - L.px(bNarrow ? 112 : 128);
+    L.nColIcon = nX0;
+    L.nColName = nX0 + L.px(38);
+
+    // ---- the Pinned card, from the tiles' title down to the bottom of the Recent table
+    if (L.bShowRight)
+    {
+        const tools::Long nX = W - L.px(OUTER + RIGHT_WIDTH);
+        L.aPinnedCard = rect(nX, nQuickTop, L.px(RIGHT_WIDTH), nCardBottom - nQuickTop);
+        L.aPinnedTitle = rect(nX + L.px(18), nQuickTop + L.px(18), L.px(RIGHT_WIDTH - 36), rIn.nTitle);
+        const tools::Long nBodyTop = L.aPinnedTitle.Bottom() + L.px(12);
+        L.aPinnedBody = rect(nX + L.px(10), nBodyTop, L.px(RIGHT_WIDTH - 20),
+                             nCardBottom - L.px(10) - nBodyTop);
+        L.nPinnedHeight = std::max(L.px(60), rIn.nRow + rIn.nBody + L.px(28));
+        L.nPinned = std::max(0, rIn.nPinned);
+        L.nPinnedFirst
+            = std::clamp(rIn.nPinnedFirst, 0, std::max(0, L.nPinned - L.PinnedVisibleItems()));
+    }
+    return L;
+}
+
+int Layout::RecentVisibleRows() const
+{
+    return nRowHeight > 0 ? std::max<int>(1, aRecentBody.GetHeight() / nRowHeight) : 1;
+}
+
+int Layout::PinnedVisibleItems() const
+{
+    return nPinnedHeight > 0 ? std::max<int>(1, aPinnedBody.GetHeight() / nPinnedHeight) : 1;
+}
+
+tools::Rectangle Layout::RecentRow(int nRow) const
+{
+    return rect(aRecentBody.Left(), aRecentBody.Top() + (nRow - nRecentFirst) * nRowHeight,
+                aRecentBody.GetWidth(), nRowHeight);
+}
+
+tools::Rectangle Layout::RecentPin(int nRow) const
+{
+    const tools::Rectangle aRow = RecentRow(nRow);
+    return tools::Rectangle(Point(nColPin, aRow.Top()), Point(nColMore - 1, aRow.Bottom()));
+}
+
+tools::Rectangle Layout::RecentMore(int nRow) const
+{
+    const tools::Rectangle aRow = RecentRow(nRow);
+    return tools::Rectangle(Point(nColMore, aRow.Top()), Point(nColEnd, aRow.Bottom()));
+}
+
+tools::Rectangle Layout::PinnedItem(int nItem) const
+{
+    return rect(aPinnedBody.Left(), aPinnedBody.Top() + (nItem - nPinnedFirst) * nPinnedHeight,
+                aPinnedBody.GetWidth(), nPinnedHeight);
+}
+
+tools::Rectangle Layout::RecentScrollTrack() const
+{
+    if (nRecent <= RecentVisibleRows())
+        return tools::Rectangle();
+    return rect(aRecentBody.Right() - px(SCROLL_WIDTH + 3), aRecentBody.Top() + px(2), px(SCROLL_WIDTH),
+                aRecentBody.GetHeight() - px(8));
+}
+
+tools::Rectangle Layout::PinnedScrollTrack() const
+{
+    if (!bShowRight || nPinned <= PinnedVisibleItems())
+        return tools::Rectangle();
+    return rect(aPinnedCard.Right() - px(SCROLL_WIDTH + 3), aPinnedBody.Top(), px(SCROLL_WIDTH),
+                aPinnedBody.GetHeight());
+}
+
+tools::Rectangle Layout::LeftScrollTrack() const
+{
+    if (nLeftContent <= aLeft.GetHeight())
+        return tools::Rectangle();
+    return rect(aLeft.Right() - px(SCROLL_WIDTH + 2), px(4), px(SCROLL_WIDTH),
+                aLeft.GetHeight() - px(8));
+}
+
+tools::Rectangle Layout::NavGlyph(int nItem) const
+{
+    const tools::Rectangle& rItem = aNav[nItem];
+    return centred(rItem, px(::hst::design::icon::Nav), bCompact ? -1 : rItem.Left() + px(::hst::design::space::M));
+}
+
+tools::Rectangle Layout::NavText(int nItem) const
+{
+    const tools::Rectangle& rItem = aNav[nItem];
+    const tools::Long nX = NavGlyph(nItem).Right() + px(::hst::design::space::M);
+    return rect(nX, rItem.Top(), rItem.Right() - nX - px(::hst::design::space::S), rItem.GetHeight());
+}
+
+tools::Rectangle Layout::TileIcon(int nTile) const
+{
+    const tools::Rectangle& rTile = aTiles[nTile];
+    const tools::Long nIcon
+        = std::min(px(::hst::design::icon::Tile), rTile.GetHeight() - px(::hst::design::space::L));
+    return centred(rTile, nIcon, rTile.Left() + px(::hst::design::space::L));
+}
+
+tools::Rectangle Layout::TileChevron(int nTile) const
+{
+    const tools::Rectangle& rTile = aTiles[nTile];
+    const tools::Long nChevron = px(::hst::design::icon::Chevron);
+    return centred(rTile, nChevron, rTile.Right() - px(::hst::design::space::L) - nChevron);
+}
+
+tools::Rectangle Layout::TileText(int nTile) const
+{
+    const tools::Rectangle& rTile = aTiles[nTile];
+    const tools::Long nX = TileIcon(nTile).Right() + px(::hst::design::space::M);
+    return rect(nX, rTile.Top(), TileChevron(nTile).Left() - nX - px(::hst::design::space::S), rTile.GetHeight());
+}
+
+Hit Layout::HitTest(const Point& rPos) const
+{
+    if (aLeft.Contains(rPos))
+    {
+        if (LeftScrollTrack().Contains(rPos))
+            return { Part::LeftScroll, 0 };
+        for (int i = 0; i < NAV_COUNT; ++i)
+            if (aNav[i].Contains(rPos))
+                return { Part::Nav, i };
+        if (!bCompact)
+        {
+            for (int i = 0; i < SOLUTION_COUNT; ++i)
+                if (aSolutions[i].Contains(rPos))
+                    return { Part::Solution, i };
+            if (aMore.Contains(rPos))
+                return { Part::MoreSolutions, 0 };
+        }
+        return {};
+    }
+    for (int i = 0; i < TILE_COUNT; ++i)
+        if (aTiles[i].Contains(rPos))
+            return { Part::Tile, i };
+    if (aRecentBody.Contains(rPos))
+    {
+        if (RecentScrollTrack().Contains(rPos))
+            return { Part::RecentScroll, 0 };
+        const int nRow = nRecentFirst + (rPos.Y() - aRecentBody.Top()) / std::max<tools::Long>(1, nRowHeight);
+        if (nRow < nRecent)
+        {
+            if (RecentPin(nRow).Contains(rPos))
+                return { Part::RecentPin, nRow };
+            if (RecentMore(nRow).Contains(rPos))
+                return { Part::RecentMore, nRow };
+            return { Part::Recent, nRow };
+        }
+        return {};
+    }
+    if (bShowRight && aPinnedBody.Contains(rPos))
+    {
+        if (PinnedScrollTrack().Contains(rPos))
+            return { Part::PinnedScroll, 0 };
+        const int nItem
+            = nPinnedFirst + (rPos.Y() - aPinnedBody.Top()) / std::max<tools::Long>(1, nPinnedHeight);
+        if (nItem < nPinned)
+            return { Part::Pinned, nItem };
+    }
+    return {};
+}
+
+tools::Rectangle Layout::ItemRect(const Hit& rHit) const
+{
+    switch (rHit.ePart)
+    {
+        case Part::Nav:
+            return rHit.nIndex >= 0 && rHit.nIndex < NAV_COUNT ? aNav[rHit.nIndex] : tools::Rectangle();
+        case Part::Tile:
+            return rHit.nIndex >= 0 && rHit.nIndex < TILE_COUNT ? aTiles[rHit.nIndex] : tools::Rectangle();
+        case Part::Recent:
+            return RecentRow(rHit.nIndex);
+        case Part::RecentPin:
+            return RecentPin(rHit.nIndex);
+        case Part::RecentMore:
+            return RecentMore(rHit.nIndex);
+        case Part::Pinned:
+            return PinnedItem(rHit.nIndex);
+        case Part::Solution:
+            return rHit.nIndex >= 0 && rHit.nIndex < SOLUTION_COUNT ? aSolutions[rHit.nIndex]
+                                                                    : tools::Rectangle();
+        case Part::MoreSolutions:
+            return aMore;
+        default:
+            return tools::Rectangle();
+    }
+}
+}
+
