+
+#pragma once
+
+#include "hststartcentercanvas.hxx"
+
+class HstStartCenterWindow;
+
+namespace sfx2::hst::startcenter
+{
+/** Turns what happens on the canvas into the Start Center window's actions. */
+class StartCenterActions final : public CanvasListener
+{
+public:
+    explicit StartCenterActions(HstStartCenterWindow& rWindow)
+        : mrWindow(rWindow)
