+AppIcon AppIconForURL(std::u16string_view aURL)
+{
+    // the extension of the last path segment, without a query or fragment
+    std::u16string_view aPath = aURL.substr(0, aURL.find_first_of(u"?#"));
+    const size_t nSlash = aPath.rfind('/');
+    if (nSlash != std::u16string_view::npos)
+        aPath = aPath.substr(nSlash + 1);
+    const size_t nDot = aPath.rfind('.');
+    if (nDot == std::u16string_view::npos)
+        return AppIcon::None;
+    const OUString aExt = OUString(aPath.substr(nDot + 1)).toAsciiLowerCase();
+    static const std::pair<std::u16string_view, AppIcon> aMap[] = {
+        { u"odt", AppIcon::Writer },  { u"ott", AppIcon::Writer },  { u"fodt", AppIcon::Writer },
+        { u"doc", AppIcon::Writer },  { u"docx", AppIcon::Writer }, { u"docm", AppIcon::Writer },
+        { u"dot", AppIcon::Writer },  { u"dotx", AppIcon::Writer }, { u"rtf", AppIcon::Writer },
+        { u"txt", AppIcon::Writer },  { u"wps", AppIcon::Writer },  { u"ods", AppIcon::Sheets },
+        { u"ots", AppIcon::Sheets },  { u"fods", AppIcon::Sheets }, { u"xls", AppIcon::Sheets },
+        { u"xlsx", AppIcon::Sheets }, { u"xlsm", AppIcon::Sheets }, { u"xlt", AppIcon::Sheets },
+        { u"xltx", AppIcon::Sheets }, { u"csv", AppIcon::Sheets },  { u"odp", AppIcon::Slides },
+        { u"otp", AppIcon::Slides },  { u"fodp", AppIcon::Slides }, { u"ppt", AppIcon::Slides },
+        { u"pptx", AppIcon::Slides }, { u"pptm", AppIcon::Slides }, { u"pps", AppIcon::Slides },
+        { u"ppsx", AppIcon::Slides }, { u"pot", AppIcon::Slides },  { u"potx", AppIcon::Slides },
+        { u"odg", AppIcon::Draw },    { u"otg", AppIcon::Draw },    { u"fodg", AppIcon::Draw },
+        { u"vsd", AppIcon::Draw },    { u"vsdx", AppIcon::Draw },   { u"pdf", AppIcon::Pdf },
+    };
+    for (const auto& [rExt, eIcon] : aMap)
+        if (aExt == rExt)
+            return eIcon;
+    return AppIcon::None;
+}
+
+namespace
+{
+std::string_view AppIconName(AppIcon eIcon)
+{
+    switch (eIcon)
+    {
+        case AppIcon::Writer:
+            return "hst-writer";
+        case AppIcon::Sheets:
+            return "hst-sheets";
+        case AppIcon::Slides:
+            return "hst-slides";
+        case AppIcon::Draw:
+            return "hst-draw";
+        case AppIcon::Pdf:
+            return "hst-pdf";
+        case AppIcon::None:
+            break;
+    }
+    return {};
+}
+}
+
+std::string_view AppIconSvg(AppIcon eIcon)
+{
+    switch (eIcon)
+    {
+        case AppIcon::Writer:
+            return SVG_WRITER;
+        case AppIcon::Sheets:
+            return SVG_SHEETS;
+        case AppIcon::Slides:
+            return SVG_SLIDES;
+        case AppIcon::Draw:
+            return SVG_DRAW;
+        case AppIcon::Pdf:
+            return SVG_PDF;
+        case AppIcon::None:
+            break;
+    }
+    return {};
+}
+
+Bitmap RenderAppIcon(AppIcon eIcon, tools::Long nSize)
+{
+    const std::string_view aSvg = AppIconSvg(eIcon);
+    if (aSvg.empty() || nSize <= 0)
+        return Bitmap();
+    // the brand's own rasters first: rendering the SVG (its blurred shadow above all) costs a few
+    // milliseconds per icon at start-up
+    if (Bitmap aRaster = RenderAppIconRaster(AppIconName(eIcon), nSize); !aRaster.IsEmpty())
+        return aRaster;
+    SvMemoryStream aStream(const_cast<char*>(aSvg.data()), aSvg.size(), StreamMode::READ);
+    Graphic aGraphic;
+    if (GraphicFilter::GetGraphicFilter().ImportGraphic(aGraphic, u"", aStream) != ERRCODE_NONE)
+        return Bitmap();
+    // the vector graphic is rendered for the target size itself: no scaling of a raster afterwards
+    return aGraphic.GetBitmap(GraphicConversionParameters(Size(nSize, nSize), false, true));
+}
