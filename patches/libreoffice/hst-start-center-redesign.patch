+OUString fileURL(std::u16string_view aName)
+{
+    INetURLObject aURL(u"file:///hst-start-center-test/Reports");
+    aURL.Append(aName);
+    return aURL.GetMainURL(INetURLObject::DecodeMechanism::NONE);
+}
+
+const std::u16string_view aNames[] = { u"Báo cáo tổng kết quý 3.docx", u"Kế hoạch ngân sách 2027.xlsx",
+                                       u"Bài thuyết trình giới thiệu sản phẩm.pptx" };
