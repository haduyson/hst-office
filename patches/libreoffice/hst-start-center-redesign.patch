+
+void HstStartCenterWindow::PlaceChildren()
+{
+    if (!mxCanvas || !mxSearchHost || !mxBannerHost)
+        return;
+    const Layout& L = mxCanvas->GetLayout();
+    mxSearchHost->SetPosSizePixel(L.aSearchText.TopLeft(), L.aSearchText.GetSize());
+    // the banner: in its slot, hidden when the column is scrolled past it or folded
+    const bool bBanner = !L.bCompact && !L.aBanner.IsEmpty() && L.aBanner.Top() >= L.aLeft.Top()
+                         && L.aBanner.Bottom() <= L.aLeft.Bottom();
+    if (bBanner)
+        mxBannerHost->SetPosSizePixel(L.aBanner.TopLeft(), L.aBanner.GetSize());
+    if (bBanner != mxBannerHost->IsVisible())
+    {
+        mxBannerHost->Show(bBanner);
+        mxCanvas->SetChildWindows(mxSearchHost.get(), mxBannerHost.get());
+    }
+    // the pinned files have their own card again once the window is wide enough
+    if (L.bShowRight && mxCanvas->GetModel().bPinnedOnly)
+    {
+        mxCanvas->GetModel().bPinnedOnly = false;
+        PostAction(u"refill"_ustr, OUString(), -1);
+    }
+}
