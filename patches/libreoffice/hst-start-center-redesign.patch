+CanvasAccessible::CanvasAccessible(HstStartCenterCanvas& rCanvas)
+    : mpCanvas(&rCanvas)
+{
+}
+
+void CanvasAccessible::BuildRegions()
+{
+    if (mbBuilt || !mpCanvas)
+        return;
+    mbBuilt = true;
+    const auto addWindow = [this](vcl::Window* pWindow) {
+        if (!pWindow || !pWindow->IsVisible())
+            return;
+        uno::Reference<XAccessible> xAccessible = pWindow->GetAccessible();
+        if (xAccessible.is())
+            maChildren.push_back(xAccessible);
+    };
+    for (Part eRegion : { Part::Nav, Part::Tile, Part::Recent, Part::Pinned, Part::Solution })
+    {
+        if (eRegion == Part::Tile)
+            addWindow(mpCanvas->GetSearchWindow());
+        if (eRegion == Part::Solution)
+            addWindow(mpCanvas->GetBannerWindow());
+        // a list is announced even when empty (it says so); the Pinned card only when it is shown
+        if (eRegion == Part::Pinned && !mpCanvas->GetLayout().bShowRight)
+            continue;
+        if (eRegion == Part::Solution && mpCanvas->GetLayout().bCompact)
+            continue;
+        maRegions.push_back(new CanvasRegionAccessible(*this, eRegion, maChildren.size()));
+        maChildren.push_back(maRegions.back());
+    }
+}
+
+CanvasRegionAccessible* CanvasAccessible::RegionOf(Part ePart)
+{
+    BuildRegions();
+    const Part eRegion = ePart == Part::MoreSolutions ? Part::Solution : ePart;
+    for (const rtl::Reference<CanvasRegionAccessible>& rRegion : maRegions)
+        if (rRegion->GetRegion() == eRegion)
+            return rRegion.get();
+    return nullptr;
+}
+
+void CanvasAccessible::CanvasDisposed()
+{
+    mpCanvas = nullptr;
+    dispose();
+}
+
+void CanvasAccessible::disposing()
+{
+    for (rtl::Reference<CanvasRegionAccessible>& rRegion : maRegions)
+        rRegion->dispose();
+    maRegions.clear();
+    maChildren.clear();
+    comphelper::OAccessible::disposing();
+}
+
+void CanvasAccessible::ChildrenChanged()
+{
+    if (!isAlive())
+        return;
+    for (rtl::Reference<CanvasRegionAccessible>& rRegion : maRegions)
+        rRegion->dispose();
+    maRegions.clear();
+    maChildren.clear();
+    mbBuilt = false;
+    NotifyAccessibleEvent(AccessibleEventId::INVALIDATE_ALL_CHILDREN, uno::Any(), uno::Any());
+}
+
+void CanvasAccessible::VisibleDataChanged()
+{
+    if (!isAlive())
+        return;
+    NotifyAccessibleEvent(AccessibleEventId::VISIBLE_DATA_CHANGED, uno::Any(), uno::Any());
+    for (const rtl::Reference<CanvasRegionAccessible>& rRegion : maRegions)
+        rRegion->Notify(AccessibleEventId::VISIBLE_DATA_CHANGED, uno::Any(), uno::Any());
+}
+
+void CanvasAccessible::FocusChanged(const Hit& rOld, const Hit& rNew)
+{
+    if (!isAlive())
+        return;
+    if (rOld.ePart != Part::None)
+        if (CanvasRegionAccessible* pRegion = RegionOf(rOld.ePart))
+            if (CanvasItemAccessible* pItem = pRegion->ItemFor(rOld))
+                pItem->Notify(AccessibleEventId::STATE_CHANGED, uno::Any(AccessibleStateType::FOCUSED),
+                              uno::Any());
+    if (rNew.ePart == Part::None)
+        return;
+    CanvasRegionAccessible* pRegion = RegionOf(rNew.ePart);
+    CanvasItemAccessible* pItem = pRegion ? pRegion->ItemFor(rNew) : nullptr;
+    if (!pItem)
+        return;
+    pRegion->Notify(AccessibleEventId::ACTIVE_DESCENDANT_CHANGED, uno::Any(),
+                    uno::Any(uno::Reference<XAccessible>(pItem)));
+    pItem->Notify(AccessibleEventId::STATE_CHANGED, uno::Any(), uno::Any(AccessibleStateType::FOCUSED));
+}
+
+sal_Int64 SAL_CALL CanvasAccessible::getAccessibleChildCount()
+{
+    SolarMutexGuard aGuard;
+    ensureAlive();
+    BuildRegions();
+    return maChildren.size();
+}
+
+uno::Reference<XAccessible> SAL_CALL CanvasAccessible::getAccessibleChild(sal_Int64 nIndex)
+{
+    SolarMutexGuard aGuard;
+    ensureAlive();
+    BuildRegions();
+    if (nIndex < 0 || o3tl::make_unsigned(nIndex) >= maChildren.size())
+        throw lang::IndexOutOfBoundsException();
+    return maChildren[nIndex];
+}
+
+uno::Reference<XAccessible> SAL_CALL CanvasAccessible::getAccessibleParent()
+{
+    SolarMutexGuard aGuard;
+    if (!mpCanvas || !mpCanvas->GetAccessibleParentWindow())
+        return nullptr;
+    return mpCanvas->GetAccessibleParentWindow()->GetAccessible();
+}
+
+sal_Int16 SAL_CALL CanvasAccessible::getAccessibleRole() { return AccessibleRole::PANEL; }
+
+OUString SAL_CALL CanvasAccessible::getAccessibleDescription()
+{
+    SolarMutexGuard aGuard;
+    return mpCanvas ? mpCanvas->GetAccessibleDescription() : OUString();
+}
+
+OUString SAL_CALL CanvasAccessible::getAccessibleName()
+{
+    SolarMutexGuard aGuard;
+    return mpCanvas ? mpCanvas->GetAccessibleName() : OUString();
+}
+
+uno::Reference<XAccessibleRelationSet> SAL_CALL CanvasAccessible::getAccessibleRelationSet()
+{
+    return new utl::AccessibleRelationSetHelper;
+}
+
+sal_Int64 SAL_CALL CanvasAccessible::getAccessibleStateSet()
+{
+    SolarMutexGuard aGuard;
+    if (!isAlive() || !mpCanvas)
+        return AccessibleStateType::DEFUNC;
+    sal_Int64 nStates = AccessibleStateType::ENABLED | AccessibleStateType::SENSITIVE
+                        | AccessibleStateType::FOCUSABLE | AccessibleStateType::VISIBLE;
+    if (mpCanvas->IsReallyVisible())
+        nStates |= AccessibleStateType::SHOWING;
+    if (mpCanvas->HasFocus())
+        nStates |= AccessibleStateType::FOCUSED;
+    return nStates;
+}
+
+uno::Reference<XAccessible> SAL_CALL CanvasAccessible::getAccessibleAtPoint(const awt::Point& rPoint)
+{
+    SolarMutexGuard aGuard;
+    ensureAlive();
+    BuildRegions();
+    const Point aPos(rPoint.X, rPoint.Y);
+    for (vcl::Window* pWindow : { mpCanvas->GetSearchWindow(), mpCanvas->GetBannerWindow() })
+        if (pWindow && pWindow->IsVisible()
+            && tools::Rectangle(pWindow->GetPosPixel(), pWindow->GetSizePixel()).Contains(aPos))
+            return pWindow->GetAccessible();
+    for (const rtl::Reference<CanvasRegionAccessible>& rRegion : maRegions)
+        if (rRegion->Area().Contains(aPos))
+            return rRegion;
+    return nullptr;
+}
+
+void SAL_CALL CanvasAccessible::grabFocus()
+{
+    SolarMutexGuard aGuard;
+    if (mpCanvas)
+        mpCanvas->GrabFocus();
+}
+
+sal_Int32 SAL_CALL CanvasAccessible::getForeground()
+{
+    SolarMutexGuard aGuard;
+    return mpCanvas ? sal_Int32(mpCanvas->GetPalette().aText) : 0;
+}
+
+sal_Int32 SAL_CALL CanvasAccessible::getBackground()
+{
+    SolarMutexGuard aGuard;
+    return mpCanvas ? sal_Int32(mpCanvas->GetPalette().aBackBottom) : 0;
+}
+
+awt::Rectangle CanvasAccessible::implGetBounds()
+{
+    SolarMutexGuard aGuard;
+    if (!mpCanvas)
+        return awt::Rectangle();
+    const Point aPos = mpCanvas->GetPosPixel();
+    const Size aSize = mpCanvas->GetSizePixel();
+    return awt::Rectangle(aPos.X(), aPos.Y(), aSize.Width(), aSize.Height());
+}
+}
+
+/* vim:set shiftwidth=4 softtabstop=4 expandtab: */
diff --git a/sfx2/source/startcenter/hststartcenteraccessible.hxx b/sfx2/source/startcenter/hststartcenteraccessible.hxx
new file mode 100644
index 0000000..78b06ed
--- /dev/null
+++ b/sfx2/source/startcenter/hststartcenteraccessible.hxx
@@ -0,0 +1,82 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * This file is part of HST Office.
+ */
+
+#pragma once
+
+#include "hststartcenterlayout.hxx"
+
+#include <com/sun/star/accessibility/XAccessibleAction.hpp>
+#include <comphelper/OAccessible.hxx>
+#include <cppuhelper/implbase.hxx>
+#include <rtl/ref.hxx>
+
+#include <vector>
+
+/* HST Office Start Center: what assistive technology sees of the drawn canvas. The canvas (a panel)
+   holds one object per region — the menu, the quick-create tiles, the Recent list, the Pinned list,
+   the HASON TECH solutions — and each region one object per item: push buttons for the menu, the
+   tiles and the solutions, list items for the files. Every item has its name, a description (the
+   folder, time and pinning of a file, the tagline of a solution), its states and its actions
+   (press; for a file: open, pin or unpin, show the menu), so the whole Start Center is usable with
+   a screen reader and the keyboard. Focus moves are announced as they happen. */
+namespace sfx2::hst::startcenter
+{
+class HstStartCenterCanvas;
+class CanvasRegionAccessible;
+
+class CanvasAccessible final : public comphelper::OAccessible
+{
+public:
+    explicit CanvasAccessible(HstStartCenterCanvas& rCanvas);
+
+    /** The canvas is going away: every object answers as disposed from now on. */
+    void CanvasDisposed();
+    /** The items changed (files added, removed, filtered, pinned): the regions are rebuilt. */
+    void ChildrenChanged();
+    /** Scrolling or a new size: positions and the showing states changed. */
+    void VisibleDataChanged();
+    void FocusChanged(const Hit& rOld, const Hit& rNew);
+
+    HstStartCenterCanvas* GetCanvas() const { return mpCanvas; }
+    void Notify(sal_Int16 nEventId, const css::uno::Any& rOld, const css::uno::Any& rNew)
+    {
+        NotifyAccessibleEvent(nEventId, rOld, rNew);
+    }
+
+    virtual sal_Int64 SAL_CALL getAccessibleChildCount() override;
+    virtual css::uno::Reference<css::accessibility::XAccessible> SAL_CALL
+    getAccessibleChild(sal_Int64 nIndex) override;
+    virtual css::uno::Reference<css::accessibility::XAccessible> SAL_CALL getAccessibleParent() override;
+    virtual sal_Int16 SAL_CALL getAccessibleRole() override;
+    virtual OUString SAL_CALL getAccessibleDescription() override;
+    virtual OUString SAL_CALL getAccessibleName() override;
+    virtual css::uno::Reference<css::accessibility::XAccessibleRelationSet>
+        SAL_CALL getAccessibleRelationSet() override;
+    virtual sal_Int64 SAL_CALL getAccessibleStateSet() override;
+    virtual css::uno::Reference<css::accessibility::XAccessible>
+        SAL_CALL getAccessibleAtPoint(const css::awt::Point& rPoint) override;
+    virtual void SAL_CALL grabFocus() override;
+    virtual sal_Int32 SAL_CALL getForeground() override;
+    virtual sal_Int32 SAL_CALL getBackground() override;
+
+protected:
+    virtual css::awt::Rectangle implGetBounds() override;
+    virtual void SAL_CALL disposing() override;
+
+private:
+    void BuildRegions();
+    CanvasRegionAccessible* RegionOf(Part ePart);
+
+    HstStartCenterCanvas* mpCanvas;
+    std::vector<rtl::Reference<CanvasRegionAccessible>> maRegions;
+    /// the children in visual order: the regions, and the search entry and banner windows
+    std::vector<css::uno::Reference<css::accessibility::XAccessible>> maChildren;
+    bool mbBuilt = false;
+};
+}
+
+/* vim:set shiftwidth=4 softtabstop=4 expandtab: */
