+CPPUNIT_TEST_FIXTURE(HstStartCenterTest, testMenuItems)
+{
+    openStartCenter();
+    const OUString aMenu[] = { u"Home"_ustr,   u"New Document"_ustr, u"Open File"_ustr,        u"Unsaved Documents"_ustr,
+                               u"Recent"_ustr, u"Pinned"_ustr,       u"Update HST Office"_ustr };
+    uno::Reference<XAccessibleContext> xMenu = region(u"Menu");
+    CPPUNIT_ASSERT_EQUAL(sal_Int64(std::size(aMenu)), xMenu->getAccessibleChildCount());
+    for (size_t i = 0; i < std::size(aMenu); ++i)
+    {
+        uno::Reference<XAccessibleContext> xItem = context(xMenu->getAccessibleChild(i));
+        CPPUNIT_ASSERT_EQUAL(aMenu[i], xItem->getAccessibleName());
+        CPPUNIT_ASSERT_EQUAL(AccessibleRole::PUSH_BUTTON, xItem->getAccessibleRole());
+        CPPUNIT_ASSERT(xItem->getAccessibleStateSet() & AccessibleStateType::SHOWING);
+        CPPUNIT_ASSERT(xItem->getAccessibleStateSet() & AccessibleStateType::FOCUSABLE);
+    }
+    // Home is the selected item
+    CPPUNIT_ASSERT(context(xMenu->getAccessibleChild(0))->getAccessibleStateSet() & AccessibleStateType::SELECTED);
+
+    // HST has no accounts: nothing is shared and there is no account or avatar anywhere
+    uno::Reference<XAccessibleContext> xCanvas = canvasContext();
+    for (sal_Int64 i = 0; i < xCanvas->getAccessibleChildCount(); ++i)
+    {
+        uno::Reference<XAccessibleContext> xRegion = context(xCanvas->getAccessibleChild(i));
+        std::vector<OUString> aNames{ xRegion->getAccessibleName() };
+        for (sal_Int64 j = 0; j < xRegion->getAccessibleChildCount(); ++j)
+            aNames.push_back(context(xRegion->getAccessibleChild(j))->getAccessibleName());
+        for (const OUString& rName : aNames)
+        {
+            const OUString aLower = rName.toAsciiLowerCase();
+            CPPUNIT_ASSERT_MESSAGE(rName.toUtf8().getStr(), aLower.indexOf("share") < 0
+                                                                && aLower.indexOf("account") < 0
+                                                                && aLower.indexOf("avatar") < 0
+                                                                && rName != u"Được chia sẻ");
+        }
+    }
+
+    // "Update HST Office" runs the update check of the bundled extension, "Unsaved Documents" its
+    // dialog of documents closed without saving
+    rtl::Reference<RecordingInterceptor> xInterceptor(new RecordingInterceptor);
+    uno::Reference<frame::XDispatchProviderInterception> xInterception(mxFrame, uno::UNO_QUERY_THROW);
+    xInterception->registerDispatchProviderInterceptor(xInterceptor);
+    press(u"Menu", 6);
+    press(u"Menu", 3);
+    xInterception->releaseDispatchProviderInterceptor(xInterceptor);
+    CPPUNIT_ASSERT_EQUAL(size_t(2), xInterceptor->maDispatched.size());
+    CPPUNIT_ASSERT_EQUAL(u"org.hst.office.update:Check"_ustr, xInterceptor->maDispatched[0]);
+    CPPUNIT_ASSERT_EQUAL(u"org.hst.office.vi:UnsavedDocuments"_ustr, xInterceptor->maDispatched[1]);
+}
