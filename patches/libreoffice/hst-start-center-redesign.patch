@@ -0,0 +1,265 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * This file is part of HST Office.
+ */
+
+#include <startcenter/hststartcentericons.hxx>
+#include <startcenter/hststartcenterlogos.hxx>
+
+#include <o3tl/string_view.hxx>
+#include <tools/stream.hxx>
+#include <vcl/graph.hxx>
+#include <vcl/graphicfilter.hxx>
+
+#include <utility>
+
+namespace sfx2::hst::startcenter
+{
+namespace
+{
+// clang-format off
+// hst-writer.svg
+constexpr std::string_view SVG_WRITER = R"HSTSVG(<?xml version="1.0" encoding="UTF-8"?>
+<svg xmlns="http://www.w3.org/2000/svg" version="1.1" width="1024" height="1024" viewBox="0 0 1024 1024">
+  <title>HST Văn bản</title>
+  <defs>
+    <linearGradient id="body" x1="0" y1="0" x2="0" y2="1">
+      <stop offset="0" stop-color="#466FE3"/>
+      <stop offset="0.5" stop-color="#2F5BD3"/>
+      <stop offset="1" stop-color="#2345B2"/>
+    </linearGradient>
+    <linearGradient id="sheen" x1="0" y1="0" x2="0" y2="1">
+      <stop offset="0" stop-color="#FFFFFF" stop-opacity="0.3"/>
+      <stop offset="1" stop-color="#FFFFFF" stop-opacity="0"/>
