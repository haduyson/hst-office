+<?xml version="1.0" encoding="UTF-8"?>
+<!-- SPDX-License-Identifier: LicenseRef-HST-Proprietary
+     HST Office: the search entry of the Start Center (inside the canvas's rounded field, so it
+     has no frame of its own); the rest is drawn by sfx2/source/startcenter/hststartcentercanvas.cxx.
+     One toplevel object per file:
+     VclBuilder (every toolkit but GTK) builds all toplevels of a file into the window that asks for
+     one of them. No property may be empty (a self-closing property element): VclBuilder then nests
+     the following siblings into the object before them. -->
+<interface domain="sfx">
+  <requires lib="gtk+" version="3.24"/>
+  <object class="GtkBox" id="SearchBox">
+    <property name="visible">True</property>
+    <property name="can-focus">False</property>
+    <property name="orientation">vertical</property>
+    <child>
+      <object class="GtkEntry" id="search">
+        <property name="visible">True</property>
+        <property name="can-focus">True</property>
+        <property name="hexpand">True</property>
+        <property name="vexpand">True</property>
+        <property name="has-frame">False</property>
+        <property name="width-chars">16</property>
+        <property name="placeholder-text" translatable="yes" context="hststartcenter|search">Search recent documents</property>
+        <child internal-child="accessible">
+          <object class="AtkObject" id="search-atkobject">
+            <property name="AtkObject::accessible-name" translatable="yes" context="hststartcenter|search-atkobject">Search recent documents</property>
+          </object>
+        </child>
+      </object>
+      <packing>
+        <property name="expand">True</property>
+        <property name="fill">True</property>
+        <property name="position">0</property>
+      </packing>
+    </child>
+  </object>
+</interface>
