+AppIcon AppIconForURL(std::u16string_view aURL)
+{
+    // the extension of the last path segment, without a query or fragment
+    std::u16string_view aPath = aURL.substr(0, aURL.find_first_of(u"?#"));
+    const size_t nSlash = aPath.rfind('/');
+    if (nSlash != std::u16string_view::npos)
+        aPath = aPath.substr(nSlash + 1);
+    const size_t nDot = aPath.rfind('.');
+    if (nDot == std::u16string_view::npos)
+        return AppIcon::None;
+    const OUString aExt = OUString(aPath.substr(nDot + 1)).toAsciiLowerCase();
+    static const std::pair<std::u16string_view, AppIcon> aMap[] = {
+        { u"odt", AppIcon::Writer },  { u"ott", AppIcon::Writer },  { u"fodt", AppIcon::Writer },
+        { u"doc", AppIcon::Writer },  { u"docx", AppIcon::Writer }, { u"docm", AppIcon::Writer },
+        { u"dot", AppIcon::Writer },  { u"dotx", AppIcon::Writer }, { u"rtf", AppIcon::Writer },
+        { u"txt", AppIcon::Writer },  { u"wps", AppIcon::Writer },  { u"ods", AppIcon::Sheets },
+        { u"ots", AppIcon::Sheets },  { u"fods", AppIcon::Sheets }, { u"xls", AppIcon::Sheets },
+        { u"xlsx", AppIcon::Sheets }, { u"xlsm", AppIcon::Sheets }, { u"xlt", AppIcon::Sheets },
+        { u"xltx", AppIcon::Sheets }, { u"csv", AppIcon::Sheets },  { u"odp", AppIcon::Slides },
+        { u"otp", AppIcon::Slides },  { u"fodp", AppIcon::Slides }, { u"ppt", AppIcon::Slides },
+        { u"pptx", AppIcon::Slides }, { u"pptm", AppIcon::Slides }, { u"pps", AppIcon::Slides },
+        { u"ppsx", AppIcon::Slides }, { u"pot", AppIcon::Slides },  { u"potx", AppIcon::Slides },
+        { u"odg", AppIcon::Draw },    { u"otg", AppIcon::Draw },    { u"fodg", AppIcon::Draw },
+        { u"vsd", AppIcon::Draw },    { u"vsdx", AppIcon::Draw },   { u"pdf", AppIcon::Pdf },
+    };
+    for (const auto& [rExt, eIcon] : aMap)
+        if (aExt == rExt)
+            return eIcon;
+    return AppIcon::None;
+}
+
+std::string_view AppIconSvg(AppIcon eIcon)
+{
+    switch (eIcon)
+    {
+        case AppIcon::Writer:
+            return SVG_WRITER;
+        case AppIcon::Sheets:
+            return SVG_SHEETS;
+        case AppIcon::Slides:
+            return SVG_SLIDES;
+        case AppIcon::Draw:
+            return SVG_DRAW;
+        case AppIcon::Pdf:
+            return SVG_PDF;
+        case AppIcon::None:
+            break;
+    }
+    return {};
+}
+
+Bitmap RenderAppIcon(AppIcon eIcon, tools::Long nSize)
+{
+    const std::string_view aSvg = AppIconSvg(eIcon);
+    if (aSvg.empty() || nSize <= 0)
+        return Bitmap();
+    SvMemoryStream aStream(const_cast<char*>(aSvg.data()), aSvg.size(), StreamMode::READ);
+    Graphic aGraphic;
+    if (GraphicFilter::GetGraphicFilter().ImportGraphic(aGraphic, u"", aStream) != ERRCODE_NONE)
+        return Bitmap();
+    // the vector graphic is rendered for the target size itself: no scaling of a raster afterwards
+    return aGraphic.GetBitmap(GraphicConversionParameters(Size(nSize, nSize), false, true));
+}
+}
+
+/* vim:set shiftwidth=4 softtabstop=4 expandtab: */
diff --git a/sfx2/source/startcenter/hststartcenterlayout.cxx b/sfx2/source/startcenter/hststartcenterlayout.cxx
new file mode 100644
index 0000000..436b070
--- /dev/null
+++ b/sfx2/source/startcenter/hststartcenterlayout.cxx
@@ -0,0 +1,328 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * This file is part of HST Office.
+ */
+
+#include "hststartcenterlayout.hxx"
+
+#include <algorithm>
+
+namespace sfx2::hst::startcenter
+{
+namespace
+{
+// Layout pixels (multiplied by the scale); the proportions follow the owner's mockup, fitted to a
+// 1366 x 768 window at 100 %.
+constexpr double LEFT_COMPACT_WIDTH = 64;
+constexpr double LOGO_HEIGHT = 36;
+constexpr double NAV_HEIGHT = 38;
+constexpr double NAV_GAP = 1;
+constexpr double CARD_GAP = 6;
+constexpr double RIGHT_WIDTH = 288;
+constexpr double OUTER = 24; // window edge to the Pinned card, and below the cards
+constexpr double CENTRE_LEFT = 44;
+constexpr double CENTRE_RIGHT = 28;
+constexpr double SEARCH_HEIGHT = 42;
+constexpr double SEARCH_MAX_WIDTH = 600;
+constexpr double TILE_HEIGHT = 76;
+constexpr double TILE_GAP = 16;
+constexpr double HEADER_HEIGHT = 42;
+constexpr double ROW_HEIGHT = 52;
+constexpr double SCROLL_WIDTH = 6;
+// the window widths (layout pixels) below which the Pinned card folds away / the menu narrows
+constexpr double SHOW_RIGHT_MIN = 1180;
+constexpr double COMPACT_BELOW = 860;
+
+tools::Rectangle rect(tools::Long nX, tools::Long nY, tools::Long nWidth, tools::Long nHeight)
+{
+    return tools::Rectangle(Point(nX, nY), Size(std::max<tools::Long>(nWidth, 0),
+                                                std::max<tools::Long>(nHeight, 0)));
+}
+
+tools::Rectangle moved(tools::Rectangle aRect, tools::Long nDY)
+{
+    aRect.Move(0, nDY);
+    return aRect;
+}
+}
+
+Layout ComputeLayout(const LayoutInput& rIn)
+{
+    Layout L;
+    L.aSize = rIn.aSize;
+    L.fScale = rIn.fScale > 0 ? rIn.fScale : 1.0;
+    const double fLogicalWidth = rIn.aSize.Width() / L.fScale;
+    L.bCompact = fLogicalWidth < COMPACT_BELOW;
+    L.bShowRight = fLogicalWidth >= SHOW_RIGHT_MIN;
+    const tools::Long W = rIn.aSize.Width();
+    const tools::Long H = rIn.aSize.Height();
+
+    // ---- the left panel: logo, menu, then the HASON TECH block; it scrolls as one column
+    const tools::Long nLeftW = L.px(L.bCompact ? LEFT_COMPACT_WIDTH : LEFT_WIDTH);
+    L.aLeft = rect(0, 0, nLeftW, H);
+    const tools::Long nPad = L.px(LEFT_PAD);
+    const tools::Long nInner = nLeftW - 2 * nPad;
+    tools::Long y = L.px(16);
+    if (!L.bCompact)
+    {
+        L.aLogo = rect(nPad + L.px(6), y, nInner - L.px(6), L.px(LOGO_HEIGHT));
+        y += L.px(LOGO_HEIGHT) + L.px(14);
+    }
+    else
+        y += L.px(8);
+    const tools::Long nNavH = std::max(L.px(NAV_HEIGHT), rIn.nNav + L.px(14));
+    for (int i = 0; i < NAV_COUNT; ++i)
+    {
+        L.aNav[i] = rect(nPad, y, nInner, nNavH);
+        y += nNavH + L.px(NAV_GAP);
+    }
+    if (!L.bCompact)
+    {
+        y += L.px(8);
+        L.aSeparator = rect(nPad, y, nInner, 1);
+        y += L.px(12);
+        // the banner's slot has the banner's own aspect ratio at the column width: the image fills it
+        if (rIn.aBannerRatio.Width() > 0 && rIn.aBannerRatio.Height() > 0)
+        {
+            const tools::Long nBannerH
+                = nInner * rIn.aBannerRatio.Height() / rIn.aBannerRatio.Width();
+            L.aBanner = rect(nPad, y, nInner, nBannerH);
+            y += nBannerH + L.px(10);
+        }
+        L.aSolutionsTitle = rect(nPad, y, nInner, rIn.nSolutionsTitle);
+        y += rIn.nSolutionsTitle + L.px(6);
+        const tools::Long nCardW = (nInner - L.px(CARD_GAP)) / 2;
+        const tools::Long nCardH = L.px(8) + rIn.nBody + L.px(1) + rIn.nSmall + L.px(8);
+        for (int i = 0; i < SOLUTION_COUNT; ++i)
+        {
+            const int nRow = i / 2;
+            const int nCol = i % 2;
+            L.aSolutions[i] = rect(nPad + nCol * (nCardW + L.px(CARD_GAP)),
+                                   y + nRow * (nCardH + L.px(CARD_GAP)), nCardW, nCardH);
+        }
+        y += 3 * nCardH + 2 * L.px(CARD_GAP) + L.px(6);
+        L.aMore = rect(nPad, y, nInner, rIn.nBody + L.px(8));
+        y += rIn.nBody + L.px(8);
+    }
+    y += L.px(8);
+    L.nLeftContent = y;
+    L.nLeftScroll = std::clamp<tools::Long>(rIn.nLeftScroll, 0, std::max<tools::Long>(0, y - H));
+    const tools::Long nUp = -L.nLeftScroll;
+    L.aLogo = L.aLogo.IsEmpty() ? L.aLogo : moved(L.aLogo, nUp);
+    for (tools::Rectangle& rNav : L.aNav)
+        rNav = moved(rNav, nUp);
+    if (!L.bCompact)
+    {
+        L.aSeparator = moved(L.aSeparator, nUp);
+        if (!L.aBanner.IsEmpty())
+            L.aBanner = moved(L.aBanner, nUp);
+        L.aSolutionsTitle = moved(L.aSolutionsTitle, nUp);
+        for (tools::Rectangle& rCard : L.aSolutions)
+            rCard = moved(rCard, nUp);
+        L.aMore = moved(L.aMore, nUp);
+    }
+
+    // ---- the centre column
+    const tools::Long nCentreX = nLeftW + L.px(L.bCompact ? 28 : CENTRE_LEFT);
+    const tools::Long nCentreRight
+        = W - (L.bShowRight ? L.px(OUTER + RIGHT_WIDTH + CENTRE_RIGHT) : L.px(CENTRE_RIGHT));
+    const tools::Long nCentreW = std::max<tools::Long>(nCentreRight - nCentreX, L.px(320));
+    L.aCentre = rect(nCentreX, 0, nCentreW, H);
+    y = L.px(30);
+    L.aWelcome = rect(nCentreX, y, nCentreW, rIn.nWelcome);
+    y += rIn.nWelcome + L.px(14);
+    L.aSearch = rect(nCentreX, y, std::min(nCentreW, L.px(SEARCH_MAX_WIDTH)), L.px(SEARCH_HEIGHT));
+    const tools::Long nIcon = L.px(18);
+    L.aSearchIcon = rect(L.aSearch.Left() + L.px(14), L.aSearch.Top() + (L.aSearch.GetHeight() - nIcon) / 2,
+                         nIcon, nIcon);
+    const tools::Long nEditH = std::min(L.aSearch.GetHeight() - L.px(8), rIn.nBody + L.px(10));
+    L.aSearchText = rect(L.aSearchIcon.Right() + L.px(10),
+                         L.aSearch.Top() + (L.aSearch.GetHeight() - nEditH) / 2,
+                         L.aSearch.Right() - L.px(12) - L.aSearchIcon.Right() - L.px(10), nEditH);
+    y += L.px(SEARCH_HEIGHT) + L.px(26);
+    L.aQuickTitle = rect(nCentreX, y, nCentreW, rIn.nTitle);
+    const tools::Long nQuickTop = y;
+    y += rIn.nTitle + L.px(12);
+    const tools::Long nTileW = (nCentreW - 2 * L.px(TILE_GAP)) / 3;
+    const tools::Long nTileH = std::max(L.px(TILE_HEIGHT), rIn.nTitle + L.px(36));
+    for (int i = 0; i < TILE_COUNT; ++i)
+        L.aTiles[i] = rect(nCentreX + i * (nTileW + L.px(TILE_GAP)), y, nTileW, nTileH);
+    y += nTileH + L.px(26);
+    L.aRecentTitle = rect(nCentreX, y, nCentreW, rIn.nTitle);
+    y += rIn.nTitle + L.px(12);
+
+    L.nRowHeight = std::max(L.px(ROW_HEIGHT), rIn.nBody + L.px(24));
+    const tools::Long nHeader = std::max(L.px(HEADER_HEIGHT), rIn.nBody + L.px(20));
+    const tools::Long nCardBottom = std::max(H - L.px(OUTER), y + nHeader + 2 * L.nRowHeight);
+    L.aRecentCard = rect(nCentreX, y, nCentreW, nCardBottom - y);
+    L.aRecentHeader = rect(nCentreX, y, nCentreW, nHeader);
+    L.aRecentBody = rect(nCentreX, y + nHeader, nCentreW, nCardBottom - y - nHeader);
+    L.nRecent = std::max(0, rIn.nRecent);
+    L.nRecentFirst = std::clamp(rIn.nRecentFirst, 0, std::max(0, L.nRecent - L.RecentVisibleRows()));
+
+    // columns: icon | name | opened | folder glyph | folder | pin | ⋯
+    const bool bNarrow = nCentreW < L.px(620);
+    const tools::Long nX0 = nCentreX + L.px(18);
+    L.nColEnd = L.aRecentCard.Right() - L.px(10);
+    L.nColMore = L.nColEnd - L.px(36);
+    L.nColPin = L.nColMore - L.px(36);
+    L.nColFolder = L.nColPin - L.px(bNarrow ? 104 : 136);
+    L.nColFolderIcon = L.nColFolder - L.px(26);
+    L.nColOpened = L.nColFolderIcon - L.px(bNarrow ? 112 : 140);
+    L.nColIcon = nX0;
+    L.nColName = nX0 + L.px(38);
+
+    // ---- the Pinned card, from the tiles' title down to the bottom of the Recent table
+    if (L.bShowRight)
+    {
+        const tools::Long nX = W - L.px(OUTER + RIGHT_WIDTH);
+        L.aPinnedCard = rect(nX, nQuickTop, L.px(RIGHT_WIDTH), nCardBottom - nQuickTop);
+        L.aPinnedTitle = rect(nX + L.px(18), nQuickTop + L.px(18), L.px(RIGHT_WIDTH - 36), rIn.nTitle);
+        const tools::Long nBodyTop = L.aPinnedTitle.Bottom() + L.px(12);
+        L.aPinnedBody = rect(nX + L.px(14), nBodyTop, L.px(RIGHT_WIDTH - 28),
+                             nCardBottom - L.px(10) - nBodyTop);
+        L.nPinnedHeight = std::max(L.px(60), rIn.nBody + rIn.nSmall + L.px(28));
+        L.nPinned = std::max(0, rIn.nPinned);
+        L.nPinnedFirst
+            = std::clamp(rIn.nPinnedFirst, 0, std::max(0, L.nPinned - L.PinnedVisibleItems()));
+    }
+    return L;
+}
+
+int Layout::RecentVisibleRows() const
+{
+    return nRowHeight > 0 ? std::max<int>(1, aRecentBody.GetHeight() / nRowHeight) : 1;
+}
+
+int Layout::PinnedVisibleItems() const
+{
+    return nPinnedHeight > 0 ? std::max<int>(1, aPinnedBody.GetHeight() / nPinnedHeight) : 1;
+}
+
+tools::Rectangle Layout::RecentRow(int nRow) const
+{
+    return rect(aRecentBody.Left(), aRecentBody.Top() + (nRow - nRecentFirst) * nRowHeight,
+                aRecentBody.GetWidth(), nRowHeight);
+}
+
+tools::Rectangle Layout::RecentPin(int nRow) const
+{
+    const tools::Rectangle aRow = RecentRow(nRow);
+    return tools::Rectangle(Point(nColPin, aRow.Top()), Point(nColMore - 1, aRow.Bottom()));
+}
+
+tools::Rectangle Layout::RecentMore(int nRow) const
+{
+    const tools::Rectangle aRow = RecentRow(nRow);
+    return tools::Rectangle(Point(nColMore, aRow.Top()), Point(nColEnd, aRow.Bottom()));
+}
+
+tools::Rectangle Layout::PinnedItem(int nItem) const
+{
+    return rect(aPinnedBody.Left(), aPinnedBody.Top() + (nItem - nPinnedFirst) * nPinnedHeight,
+                aPinnedBody.GetWidth(), nPinnedHeight);
+}
+
+tools::Rectangle Layout::RecentScrollTrack() const
+{
+    if (nRecent <= RecentVisibleRows())
+        return tools::Rectangle();
+    return rect(aRecentBody.Right() - px(SCROLL_WIDTH + 3), aRecentBody.Top() + px(2), px(SCROLL_WIDTH),
+                aRecentBody.GetHeight() - px(8));
+}
+
+tools::Rectangle Layout::PinnedScrollTrack() const
+{
+    if (!bShowRight || nPinned <= PinnedVisibleItems())
+        return tools::Rectangle();
+    return rect(aPinnedCard.Right() - px(SCROLL_WIDTH + 3), aPinnedBody.Top(), px(SCROLL_WIDTH),
+                aPinnedBody.GetHeight());
+}
+
+tools::Rectangle Layout::LeftScrollTrack() const
+{
+    if (nLeftContent <= aLeft.GetHeight())
+        return tools::Rectangle();
+    return rect(aLeft.Right() - px(SCROLL_WIDTH + 2), px(4), px(SCROLL_WIDTH),
+                aLeft.GetHeight() - px(8));
+}
+
+Hit Layout::HitTest(const Point& rPos) const
+{
+    if (aLeft.Contains(rPos))
+    {
+        if (LeftScrollTrack().Contains(rPos))
+            return { Part::LeftScroll, 0 };
+        for (int i = 0; i < NAV_COUNT; ++i)
+            if (aNav[i].Contains(rPos))
+                return { Part::Nav, i };
+        if (!bCompact)
+        {
+            for (int i = 0; i < SOLUTION_COUNT; ++i)
+                if (aSolutions[i].Contains(rPos))
+                    return { Part::Solution, i };
+            if (aMore.Contains(rPos))
+                return { Part::MoreSolutions, 0 };
+        }
+        return {};
+    }
+    for (int i = 0; i < TILE_COUNT; ++i)
+        if (aTiles[i].Contains(rPos))
+            return { Part::Tile, i };
+    if (aRecentBody.Contains(rPos))
+    {
+        if (RecentScrollTrack().Contains(rPos))
+            return { Part::RecentScroll, 0 };
+        const int nRow = nRecentFirst + (rPos.Y() - aRecentBody.Top()) / std::max<tools::Long>(1, nRowHeight);
+        if (nRow < nRecent)
+        {
+            if (RecentPin(nRow).Contains(rPos))
+                return { Part::RecentPin, nRow };
+            if (RecentMore(nRow).Contains(rPos))
+                return { Part::RecentMore, nRow };
+            return { Part::Recent, nRow };
+        }
+        return {};
+    }
+    if (bShowRight && aPinnedBody.Contains(rPos))
+    {
+        if (PinnedScrollTrack().Contains(rPos))
+            return { Part::PinnedScroll, 0 };
+        const int nItem
+            = nPinnedFirst + (rPos.Y() - aPinnedBody.Top()) / std::max<tools::Long>(1, nPinnedHeight);
+        if (nItem < nPinned)
+            return { Part::Pinned, nItem };
+    }
+    return {};
+}
+
+tools::Rectangle Layout::ItemRect(const Hit& rHit) const
+{
+    switch (rHit.ePart)
+    {
+        case Part::Nav:
+            return rHit.nIndex >= 0 && rHit.nIndex < NAV_COUNT ? aNav[rHit.nIndex] : tools::Rectangle();
+        case Part::Tile:
+            return rHit.nIndex >= 0 && rHit.nIndex < TILE_COUNT ? aTiles[rHit.nIndex] : tools::Rectangle();
+        case Part::Recent:
+            return RecentRow(rHit.nIndex);
+        case Part::RecentPin:
+            return RecentPin(rHit.nIndex);
+        case Part::RecentMore:
+            return RecentMore(rHit.nIndex);
+        case Part::Pinned:
+            return PinnedItem(rHit.nIndex);
+        case Part::Solution:
+            return rHit.nIndex >= 0 && rHit.nIndex < SOLUTION_COUNT ? aSolutions[rHit.nIndex]
+                                                                    : tools::Rectangle();
+        case Part::MoreSolutions:
+            return aMore;
+        default:
+            return tools::Rectangle();
+    }
+}
+}
+
+/* vim:set shiftwidth=4 softtabstop=4 expandtab: */
diff --git a/sfx2/source/startcenter/hststartcenterlayout.hxx b/sfx2/source/startcenter/hststartcenterlayout.hxx
new file mode 100644
index 0000000..2e4a0cd
--- /dev/null
+++ b/sfx2/source/startcenter/hststartcenterlayout.hxx
@@ -0,0 +1,137 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * This file is part of HST Office.
+ */
+
+#pragma once
+
+#include <tools/gen.hxx>
+
+#include <array>
+
+/* HST Office Start Center: the geometry of the canvas. ComputeLayout() turns the window size, the
+   DPI scale and the heights of the fonts into the rectangle of every part (the left panel with its
+   menu and the HASON TECH solutions, the centre with the heading, search field, tiles and the Recent
+   table, the Pinned card at the right). The painting, the mouse, the keyboard and the accessibility
+   objects all read the same Layout, so what is drawn is what is hit and what is announced. All
+   rectangles are in the canvas's device pixels; the left column is already moved by its scroll. */
+namespace sfx2::hst::startcenter
+{
+constexpr int NAV_COUNT = 7;
+constexpr int TILE_COUNT = 3;
+constexpr int SOLUTION_COUNT = 6;
+/** The left column's width and padding, in layout pixels: its inner width (260) is the banner's
+    smallest legible width (HstBannerWidget::MinimumSize). */
+constexpr double LEFT_WIDTH = 292;
+constexpr double LEFT_PAD = 16;
+
+/** What a point of the canvas is: an item, a part of a row, or a scroll bar. */
+enum class Part
+{
+    None,
+    Nav,
+    Tile,
+    Recent, ///< a row of the Recent table (opens the file)
+    RecentPin, ///< the pin of a row
+    RecentMore, ///< the "⋯" of a row
+    Pinned, ///< an item of the Pinned card
+    Solution,
+    MoreSolutions,
+    RecentScroll,
+    PinnedScroll,
+    LeftScroll,
+};
+
+struct Hit
+{
+    Part ePart = Part::None;
+    int nIndex = -1;
+    bool operator==(const Hit&) const = default;
+};
+
+struct LayoutInput
+{
+    Size aSize; ///< the canvas
+    double fScale = 1.0; ///< device pixels per layout pixel
+    // heights of the text lines, in device pixels
+    tools::Long nBody = 16; ///< table rows, search text, pinned names
+    tools::Long nNav = 18; ///< the menu items
+    tools::Long nWelcome = 40; ///< "Chào mừng bạn quay lại"
+    tools::Long nTitle = 22; ///< "Tạo nhanh tài liệu mới", "Gần đây", "Được ghim"
+    tools::Long nSmall = 14; ///< folders under pinned names, solution taglines
+    tools::Long nSolutionsTitle = 36; ///< the HASON TECH heading, wrapped to the column
+    Size aBannerRatio = Size(1200, 340); ///< the banner's width : height
+    int nRecent = 0; ///< rows of the Recent table
+    int nPinned = 0; ///< items of the Pinned card
+    tools::Long nLeftScroll = 0; ///< wanted scroll of the left column (clamped)
+    int nRecentFirst = 0; ///< wanted first row of the Recent table (clamped)
+    int nPinnedFirst = 0; ///< wanted first item of the Pinned card (clamped)
+};
+
+struct Layout
+{
+    Size aSize;
+    double fScale = 1.0;
+    bool bCompact = false; ///< a narrow window: the menu shows glyphs only, no HASON TECH block
+    bool bShowRight = true; ///< a wide enough window for the Pinned card
+
+    tools::Rectangle aLeft; ///< the left panel (the visible part)
+    tools::Long nLeftContent = 0; ///< the height of the left column's content
+    tools::Long nLeftScroll = 0;
+    tools::Rectangle aLogo;
+    std::array<tools::Rectangle, NAV_COUNT> aNav;
+    tools::Rectangle aSeparator;
+    tools::Rectangle aBanner; ///< the slot of the banner, at its aspect ratio (empty: no banner)
+    tools::Rectangle aSolutionsTitle;
+    std::array<tools::Rectangle, SOLUTION_COUNT> aSolutions;
+    tools::Rectangle aMore;
+
+    tools::Rectangle aCentre; ///< the column of the heading, search, tiles and Recent table
+    tools::Rectangle aWelcome;
+    tools::Rectangle aSearch; ///< the rounded field
+    tools::Rectangle aSearchIcon;
+    tools::Rectangle aSearchText; ///< where the text entry sits inside the field
+    tools::Rectangle aQuickTitle;
+    std::array<tools::Rectangle, TILE_COUNT> aTiles;
+    tools::Rectangle aRecentTitle;
+    tools::Rectangle aRecentCard;
+    tools::Rectangle aRecentHeader;
+    tools::Rectangle aRecentBody;
+    tools::Long nRowHeight = 0;
+    int nRecent = 0;
+    int nRecentFirst = 0;
+    // the columns of the Recent table: left edges of the parts, in canvas x
+    tools::Long nColIcon = 0, nColName = 0, nColOpened = 0, nColFolderIcon = 0, nColFolder = 0,
+                nColPin = 0, nColMore = 0, nColEnd = 0;
+
+    tools::Rectangle aPinnedCard;
+    tools::Rectangle aPinnedTitle;
+    tools::Rectangle aPinnedBody;
+    tools::Long nPinnedHeight = 0;
+    int nPinned = 0;
+    int nPinnedFirst = 0;
+
+    tools::Rectangle RecentRow(int nRow) const;
+    tools::Rectangle RecentPin(int nRow) const;
+    tools::Rectangle RecentMore(int nRow) const;
+    tools::Rectangle PinnedItem(int nItem) const;
+    int RecentVisibleRows() const;
+    int PinnedVisibleItems() const;
+    /** The scroll bars: the track at the right edge of the area, empty when all of it fits. */
+    tools::Rectangle RecentScrollTrack() const;
+    tools::Rectangle PinnedScrollTrack() const;
+    tools::Rectangle LeftScrollTrack() const;
+
+    Hit HitTest(const Point& rPos) const;
+    /** The rectangle of an item (Nav, Tile, Recent, Pinned, Solution, MoreSolutions). */
+    tools::Rectangle ItemRect(const Hit& rHit) const;
+
+    tools::Long px(double f) const { return static_cast<tools::Long>(f * fScale + 0.5); }
+};
+
+Layout ComputeLayout(const LayoutInput& rIn);
+}
+
+/* vim:set shiftwidth=4 softtabstop=4 expandtab: */
diff --git a/sfx2/source/startcenter/hststartcenterpaint.cxx b/sfx2/source/startcenter/hststartcenterpaint.cxx
new file mode 100644
index 0000000..ca06965
--- /dev/null
+++ b/sfx2/source/startcenter/hststartcenterpaint.cxx
@@ -0,0 +1,162 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * This file is part of HST Office.
+ */
+
+#include "hststartcenterpaint.hxx"
+
+#include <basegfx/point/b2dpoint.hxx>
+#include <basegfx/polygon/b2dpolygon.hxx>
+#include <com/sun/star/drawing/LineCap.hpp>
+#include <vcl/outdev.hxx>
+
+#include <cmath>
+#include <initializer_list>
+
+namespace sfx2::hst::startcenter
+{
+namespace
+{
+/** Maps glyph coordinates (a 20 x 20 design grid) into the box. */
+class Grid
+{
+public:
+    explicit Grid(const tools::Rectangle& rBox)
+        : mfX(rBox.Left())
+        , mfY(rBox.Top())
+        , mfUnit(std::min(rBox.GetWidth(), rBox.GetHeight()) / 20.0)
+    {
+    }
+
+    basegfx::B2DPoint at(double fX, double fY) const
+    {
+        return basegfx::B2DPoint(mfX + fX * mfUnit, mfY + fY * mfUnit);
+    }
+
+    basegfx::B2DPolygon line(std::initializer_list<std::pair<double, double>> aPoints,
+                             bool bClosed = false) const
+    {
+        basegfx::B2DPolygon aPoly;
+        for (const auto& [fX, fY] : aPoints)
+            aPoly.append(at(fX, fY));
+        aPoly.setClosed(bClosed);
+        return aPoly;
+    }
+
+    basegfx::B2DPolygon arc(double fCX, double fCY, double fR, double fFromDeg, double fToDeg) const
+    {
+        basegfx::B2DPolygon aPoly;
+        const int nSteps = 32;
+        for (int i = 0; i <= nSteps; ++i)
+        {
+            const double fAngle = (fFromDeg + (fToDeg - fFromDeg) * i / nSteps) * M_PI / 180.0;
+            aPoly.append(at(fCX + fR * std::cos(fAngle), fCY + fR * std::sin(fAngle)));
+        }
+        return aPoly;
+    }
+
+    double unit() const { return mfUnit; }
+
+private:
+    double mfX;
+    double mfY;
+    double mfUnit;
+};
+
+void stroke(OutputDevice& rDev, const Grid& rGrid, const basegfx::B2DPolygon& rPoly)
+{
+    rDev.DrawPolyLine(rPoly, std::max(1.0, 1.5 * rGrid.unit()), basegfx::B2DLineJoin::Round,
+                      css::drawing::LineCap_ROUND);
+}
+
+void fill(OutputDevice& rDev, const basegfx::B2DPolygon& rPoly, const Color& rColor)
+{
+    rDev.SetLineColor();
+    rDev.SetFillColor(rColor);
+    rDev.DrawPolygon(rPoly);
+}
+
+}
+
+void DrawGlyph(OutputDevice& rDev, const tools::Rectangle& rBox, Glyph eGlyph, const Color& rColor,
+               bool bFilled)
+{
+    const Grid aGrid(rBox);
+    rDev.SetLineColor(rColor);
+    rDev.SetFillColor();
+    switch (eGlyph)
+    {
+        case Glyph::Home:
+            stroke(rDev, aGrid, aGrid.line({ { 2, 10 }, { 10, 3 }, { 18, 10 } }));
+            stroke(rDev, aGrid, aGrid.line({ { 4.5, 8.5 }, { 4.5, 17 }, { 15.5, 17 }, { 15.5, 8.5 } }));
+            stroke(rDev, aGrid, aGrid.line({ { 8.5, 17 }, { 8.5, 12 }, { 11.5, 12 }, { 11.5, 17 } }));
+            break;
+        case Glyph::NewDocument:
+            stroke(rDev, aGrid,
+                   aGrid.line({ { 4.5, 2 }, { 11.5, 2 }, { 15.5, 6 }, { 15.5, 18 }, { 4.5, 18 } }, true));
+            stroke(rDev, aGrid, aGrid.line({ { 11.5, 2 }, { 11.5, 6 }, { 15.5, 6 } }));
+            stroke(rDev, aGrid, aGrid.line({ { 10, 9 }, { 10, 15 } }));
+            stroke(rDev, aGrid, aGrid.line({ { 7, 12 }, { 13, 12 } }));
+            break;
+        case Glyph::Open:
+            stroke(rDev, aGrid,
+                   aGrid.line({ { 2, 4.5 }, { 7.5, 4.5 }, { 9.5, 6.5 }, { 18, 6.5 }, { 18, 16 }, { 2, 16 } },
+                              true));
+            stroke(rDev, aGrid, aGrid.line({ { 2, 9 }, { 18, 9 } }));
+            break;
+        case Glyph::Unsaved:
+            // a page with a small clock: kept documents waiting to be recovered
+            stroke(rDev, aGrid, aGrid.line({ { 10, 18 }, { 3.5, 18 }, { 3.5, 2 }, { 10.5, 2 }, { 14.5, 6 }, { 14.5, 9 } }));
+            stroke(rDev, aGrid, aGrid.line({ { 10.5, 2 }, { 10.5, 6 }, { 14.5, 6 } }));
+            stroke(rDev, aGrid, aGrid.arc(14.5, 14.5, 4.5, 0, 360));
+            stroke(rDev, aGrid, aGrid.line({ { 14.5, 12 }, { 14.5, 14.5 }, { 16.5, 15.5 } }));
+            break;
+        case Glyph::Recent:
+            stroke(rDev, aGrid, aGrid.arc(10, 10, 7.5, 0, 360));
+            stroke(rDev, aGrid, aGrid.line({ { 10, 5.5 }, { 10, 10 }, { 13.5, 12 } }));
+            break;
+        case Glyph::Pinned:
+        {
+            // a push pin leaning to the left: head at the top right, needle to the bottom left
+            const basegfx::B2DPolygon aPin = aGrid.line(
+                { { 12, 2.5 }, { 17.5, 8 }, { 15.5, 9 }, { 12, 12.5 }, { 12.5, 15.5 }, { 4.5, 7.5 },
+                  { 7.5, 8 }, { 11, 4.5 } },
+                true);
+            if (bFilled)
+                fill(rDev, aPin, rColor);
+            rDev.SetLineColor(rColor);
+            stroke(rDev, aGrid, aPin);
+            stroke(rDev, aGrid, aGrid.line({ { 8.5, 11.5 }, { 3, 17 } }));
+            break;
+        }
+        case Glyph::Update:
+        {
+            stroke(rDev, aGrid, aGrid.arc(10, 10, 7, -60, 240));
+            // arrow head at the start of the arc (the upper right)
+            const basegfx::B2DPoint aTip = aGrid.at(10 + 7 * std::cos(-M_PI / 3), 10 + 7 * std::sin(-M_PI / 3));
+            basegfx::B2DPolygon aHead;
+            aHead.append(basegfx::B2DPoint(aTip.getX() - 4 * aGrid.unit(), aTip.getY()));
+            aHead.append(aTip);
+            aHead.append(basegfx::B2DPoint(aTip.getX(), aTip.getY() - 4 * aGrid.unit()));
+            stroke(rDev, aGrid, aHead);
+            break;
+        }
+        case Glyph::More:
+            for (double fX : { 4.0, 10.0, 16.0 })
+                fill(rDev, aGrid.arc(fX, 10, 1.6, 0, 360), rColor);
+            break;
+        case Glyph::Chevron:
+            stroke(rDev, aGrid, aGrid.line({ { 8, 5 }, { 13, 10 }, { 8, 15 } }));
+            break;
+        case Glyph::Search:
+            stroke(rDev, aGrid, aGrid.arc(8.5, 8.5, 5.5, 0, 360));
+            stroke(rDev, aGrid, aGrid.line({ { 12.5, 12.5 }, { 17.5, 17.5 } }));
+            break;
+    }
+}
+
+}
+
