+namespace sfx2::hst::startcenter
+{
+class CanvasAccessible;
+/** The colours of the HST look (the shared design tokens). */
+using Palette = ::hst::design::Palette;
+
+/** The texts the canvas draws and announces (translated by the window). */
+struct CanvasTexts
+{
+    std::array<OUString, NAV_COUNT> aNav;
+    std::array<OUString, TILE_COUNT> aTiles;
+    OUString aWelcome;
+    OUString aQuickTitle;
+    OUString aRecentTitle;
+    OUString aColName;
+    OUString aColOpened;
+    OUString aColLocation;
+    OUString aPinnedTitle;
+    OUString aRecentEmpty; ///< no recent file at all
+    OUString aNoMatch; ///< the search found nothing ("%1": the query)
+    OUString aPinnedEmpty;
+    OUString aPinnedState; ///< "Pinned", in a row's description
+    OUString aRowHint; ///< how a row is used with the keyboard
+    OUString aMenuName; ///< accessible names of the regions
+    OUString aRecentName;
+    OUString aPinnedName;
+    OUString aSolutionsTitle;
+    OUString aMore;
+    std::array<OUString, SOLUTION_COUNT> aSolutionName;
+    std::array<OUString, SOLUTION_COUNT> aSolutionTagline; ///< shown on the card
+    std::array<OUString, SOLUTION_COUNT> aSolutionDescription; ///< in full: tooltip, accessible description
+};
+
+/** What the canvas shows: the recent files and which of them each list displays. */
+struct CanvasModel
+{
+    std::vector<RecentFile> aFiles;
+    std::vector<size_t> aRecent; ///< the rows of the Recent table (indexes into aFiles)
+    std::vector<size_t> aPinned; ///< the items of the Pinned card
+    std::unordered_map<OUString, DateTime> aTimes; ///< when each file was last changed
+    OUString aQuery; ///< the search text, for the "no match" message
+    bool bPinnedOnly = false; ///< the Recent table shows the pinned files (no room for the card)
+    int nSelectedNav = 0; ///< the highlighted menu item
+};
+
+/** What the window does for the canvas: the canvas only draws and reports. */
+class CanvasListener
+{
+public:
+    virtual ~CanvasListener() = default;
+    /** An item was clicked, or Enter / Space pressed on it. For Part::Recent and Part::Pinned with
+        bPin the pin is toggled instead of opening the file. */
+    virtual void Activate(const Hit& rHit, bool bPin) = 0;
+    /** The context menu of a row (rAt: where to show it, in canvas pixels). */
+    virtual void ContextMenu(const Hit& rHit, const tools::Rectangle& rAt) = 0;
+    /** Tab from the menu (forward) or from the tiles (backward): the search field takes the focus. */
+    virtual void FocusSearch() = 0;
+    /** The geometry changed: the search field moves to its slot. */
+    virtual void LayoutChanged() = 0;
+};
+
+/* The Start Center's drawn surface: the background, the left panel with its menu and the HASON TECH
+   cards, the heading, the search field's frame, the tiles, the Recent table and the Pinned card.
+   It does its own hit-testing, hover, press, focus and scrolling, and describes every item to
+   assistive technology (hststartcenteraccessible.hxx). The search entry is a real child window of
+   the Start Center window placed into its slot of the layout. */
+class HstStartCenterCanvas final : public Control
+{
+public:
+    HstStartCenterCanvas(vcl::Window* pParent, CanvasListener& rListener);
+    virtual ~HstStartCenterCanvas() override;
+    virtual void dispose() override;
+
+    void SetTexts(CanvasTexts aTexts);
+    /** The logo's width in pixels; the artwork of the current theme is rendered when it is first painted. */
+    void SetLogoWidth(int nWidth);
+    CanvasModel& GetModel() { return maModel; }
+    const CanvasModel& GetModel() const { return maModel; }
+    /** After the model changed: lays out, repaints and tells assistive technology. */
+    void ModelChanged();
+    /** Only the times changed: repaints the Recent table. */
+    void TimesChanged();
+    void SetSearchFocused(bool bFocused);
+
+    const Layout& GetLayout() const { return maLayout; }
+    /** The share of the design's type sizes the canvas shows (below 1 in a window too small for them). */
+    double GetFontShare() const { return mfFont; }
+    const Palette& GetPalette() const { return maPalette; }
+    const CanvasTexts& GetTexts() const { return maTexts; }
+
+    /** The keyboard focus: an item of the canvas (Part::None: none). */
+    const Hit& GetFocusItem() const { return maFocus; }
+    /** Moves the focus to rHit (scrolling it into view) and grabs the window focus. */
+    void FocusItem(const Hit& rHit, bool bKeyboard = true);
+    /** The first item of a region: Part::Nav, Part::Tile, Part::Recent, Part::Pinned or
+        Part::Solution; false when the region is empty or hidden. */
+    bool FocusRegion(Part eRegion, bool bKeyboard = true);
+    /** Shift+Tab out of a child window: focuses the region before eRegion in the Tab order. */
+    void FocusRegionBefore(Part eRegion);
+    /** The child windows in the canvas's slots, listed by its accessibility in visual order. */
+    void SetSearchWindow(vcl::Window* pSearch);
+    vcl::Window* GetSearchWindow() const { return mxSearchWindow.get(); }
+    bool HasRows(Part eRegion) const;
+    /** An action of an item (accessibility): 0 presses or opens it; for a file 1 pins or unpins it
+        and 2 shows its menu. */
+    void DoAction(const Hit& rHit, int nAction);
+
+    // descriptions of the items, shared by tooltips and accessibility
+    OUString ItemName(const Hit& rHit) const;
+    OUString ItemDescription(const Hit& rHit) const;
+    const RecentFile* ItemFile(const Hit& rHit) const;
+    /** The number of items of a part (rows of the table, items of the card...). */
+    int ItemCount(Part ePart) const;
+    /** Whether rHit is shown and not scrolled out of sight. */
+    bool IsItemShowing(const Hit& rHit) const;
+
+    virtual void Paint(vcl::RenderContext& rRenderContext, const tools::Rectangle& rRect) override;
+    virtual void Resize() override;
+    virtual void MouseMove(const MouseEvent& rMEvt) override;
+    virtual void MouseButtonDown(const MouseEvent& rMEvt) override;
+    virtual void MouseButtonUp(const MouseEvent& rMEvt) override;
+    virtual void KeyInput(const KeyEvent& rKEvt) override;
+    virtual void Command(const CommandEvent& rCEvt) override;
+    virtual void RequestHelp(const HelpEvent& rHEvt) override;
+    virtual void GetFocus() override;
+    virtual void LoseFocus() override;
+    virtual void DataChanged(const DataChangedEvent& rDCEvt) override;
+    virtual rtl::Reference<comphelper::OAccessible> CreateAccessible() override;
+
+private:
+    /** Sets the font of a step of the HST type scale. */
+    void UseFont(vcl::RenderContext& rDev, const ::hst::design::TypeStyle& rType) const;
+    void Relayout();
+    /** The input of the layout at fScale, its type at mfFont of the design's size. */
+    LayoutInput MeasureInput(double fScale);
+    /** The layout at fFit of the design's size (fBaseScale: the window's own scale). */
+    Layout LayoutAt(double fBaseScale, double fFit);
+    /** The share of their size at which the left column's one-line labels fit (1: they do). */
+    double LeftTextRoom(const Layout& rLayout);
+    /** Whether every part of rLayout shows whole in the window. */
+    bool Fits(const Layout& rLayout);
+    void UpdateLogoWidth();
+    void UpdatePalette();
+    const Bitmap& Icon(int nKind, tools::Long nSize);
+    const Bitmap& Logo(bool bDark);
+    /** The logo of solution card nIndex at nSize pixels (cached like the icons). */
+    const Bitmap& SolutionLogo(int nIndex, tools::Long nSize);
+
+    void PaintLeft(vcl::RenderContext& rDev);
+    void PaintCentre(vcl::RenderContext& rDev);
+    void PaintRecent(vcl::RenderContext& rDev);
+    void PaintPinned(vcl::RenderContext& rDev);
+    void PaintFileIcon(vcl::RenderContext& rDev, const RecentFile& rFile, const tools::Rectangle& rBox);
+    void PaintScrollBar(vcl::RenderContext& rDev, const tools::Rectangle& rTrack, int nFirst, int nShown,
+                        int nTotal);
+    bool ShowFocus(const Hit& rHit) const;
+
+    void SetHover(const Hit& rHit);
+    void InvalidateItem(const Hit& rHit);
+    void SetFocusItem(const Hit& rHit);
+    void EnsureVisible(const Hit& rHit);
+    bool MoveFocus(int nDelta, bool bVertical);
+    void Scroll(Part eArea, int nDelta);
+    Hit FirstItem(Part eRegion) const;
+    std::vector<Part> Regions() const;
+
+    CanvasListener& mrListener;
+    CanvasTexts maTexts;
+    CanvasModel maModel;
+    Layout maLayout;
+    Palette maPalette;
+    Bitmap maLogo[2]; ///< light, dark
+    bool mbLogoLoaded[2] = { false, false };
+    int mnLogoWidth = 0; ///< at the design's size
+    int mnLogoShownWidth = 0; ///< at the fitted size (the width the artwork is rendered at)
+    double mfFit = 1.0; ///< the share of the design's measures the layout uses (below 1 in a small window)
+    double mfFont = 1.0; ///< the share of the design's type sizes
+    std::map<std::pair<int, tools::Long>, Bitmap> maIcons; ///< rendered application icons and solution logos
+
+    Hit maHover;
+    Hit maPressed;
+    Hit maFocus;
+    bool mbKeyboardFocus = false; ///< show focus rings (the focus moved by keyboard)
+    bool mbSearchFocused = false;
+    tools::Long mnLeftScroll = 0;
+    int mnRecentFirst = 0;
+    int mnPinnedFirst = 0;
+
+    VclPtr<vcl::Window> mxSearchWindow;
+    rtl::Reference<CanvasAccessible> mxAccessible;
+};
+}
