+/** Records the commands the Start Center dispatches to its frame (the update check is a command of
+    the bundled extension, which the test environment does not have). */
+class RecordingInterceptor final
+    : public cppu::WeakImplHelper<frame::XDispatchProviderInterceptor, frame::XDispatch>
+{
+public:
+    std::vector<OUString> maDispatched;
+
+    uno::Reference<frame::XDispatch> SAL_CALL queryDispatch(const util::URL& rURL, const OUString& rTarget,
+                                                            sal_Int32 nFlags) override
+    {
+        if (rURL.Complete.startsWith("org.hst.office.update:")
+            || rURL.Complete == "org.hst.office.vi:UnsavedDocuments")
+            return this;
+        return mxSlave.is() ? mxSlave->queryDispatch(rURL, rTarget, nFlags) : nullptr;
+    }
+    uno::Sequence<uno::Reference<frame::XDispatch>>
+        SAL_CALL queryDispatches(const uno::Sequence<frame::DispatchDescriptor>& rRequests) override
+    {
+        uno::Sequence<uno::Reference<frame::XDispatch>> aResult(rRequests.getLength());
+        for (sal_Int32 i = 0; i < rRequests.getLength(); ++i)
+            aResult.getArray()[i] = queryDispatch(rRequests[i].FeatureURL, rRequests[i].FrameName,
+                                                  rRequests[i].SearchFlags);
+        return aResult;
+    }
+    uno::Reference<frame::XDispatchProvider> SAL_CALL getSlaveDispatchProvider() override { return mxSlave; }
+    void SAL_CALL setSlaveDispatchProvider(const uno::Reference<frame::XDispatchProvider>& x) override
+    {
+        mxSlave = x;
+    }
+    uno::Reference<frame::XDispatchProvider> SAL_CALL getMasterDispatchProvider() override { return mxMaster; }
+    void SAL_CALL setMasterDispatchProvider(const uno::Reference<frame::XDispatchProvider>& x) override
+    {
+        mxMaster = x;
+    }
+    void SAL_CALL dispatch(const util::URL& rURL, const uno::Sequence<beans::PropertyValue>&) override
+    {
+        maDispatched.push_back(rURL.Complete);
+    }
+    void SAL_CALL addStatusListener(const uno::Reference<frame::XStatusListener>&, const util::URL&) override {}
+    void SAL_CALL removeStatusListener(const uno::Reference<frame::XStatusListener>&, const util::URL&) override {}
+
+private:
+    uno::Reference<frame::XDispatchProvider> mxSlave;
+    uno::Reference<frame::XDispatchProvider> mxMaster;
+};
+
+OUString fileURL(std::u16string_view aName)
+{
+    INetURLObject aURL(u"file:///hst-start-center-test/Reports");
+    aURL.Append(aName);
+    return aURL.GetMainURL(INetURLObject::DecodeMechanism::NONE);
+}
+
+const std::u16string_view aNames[] = { u"Báo cáo tổng kết quý 3.docx", u"Kế hoạch ngân sách 2027.xlsx",
+                                       u"Bài thuyết trình giới thiệu sản phẩm.pptx" };
+
+uno::Reference<XAccessibleContext> context(const uno::Reference<XAccessible>& xAccessible)
+{
+    CPPUNIT_ASSERT(xAccessible.is());
+    uno::Reference<XAccessibleContext> xContext = xAccessible->getAccessibleContext();
+    CPPUNIT_ASSERT(xContext.is());
+    return xContext;
+}
+
+/** The rectangle of an accessible object in the coordinates of its parent. */
+tools::Rectangle bounds(const uno::Reference<XAccessibleContext>& xContext)
+{
+    uno::Reference<XAccessibleComponent> xComponent(xContext, uno::UNO_QUERY_THROW);
+    const awt::Rectangle aRect = xComponent->getBounds();
+    return tools::Rectangle(Point(aRect.X, aRect.Y), Size(aRect.Width, aRect.Height));
+}
+
+bool isBluish(const Color& rColor) { return rColor.GetBlue() >= rColor.GetRed(); }
+
+class HstStartCenterTest : public UnoApiTest
+{
+public:
+    HstStartCenterTest()
+        : UnoApiTest(u"/sfx2/qa/cppunit/data/"_ustr)
+    {
+    }
+
+    void setUp() override
+    {
+        UnoApiTest::setUp();
+        SvtHistoryOptions::Clear(EHistoryType::PickList);
+        for (std::u16string_view aName : aNames)
+            SvtHistoryOptions::AppendItem(EHistoryType::PickList, fileURL(aName), OUString(),
+                                          OUString(aName), std::nullopt, std::nullopt);
+    }
+
+    void tearDown() override
+    {
+        closeFrame();
+        SvtHistoryOptions::Clear(EHistoryType::PickList);
+        UnoApiTest::tearDown();
+    }
+
+protected:
+    /** Shows the Start Center in a new frame, as the office does when no document is open, with the
+        content area of a 1366 x 768 screen under its 27 px menu bar (1366 x 741) unless told another. */
+    void openStartCenter(const Size& rContent = Size(1366, 741))
+    {
+        closeFrame();
+        mxFrame = mxDesktop->findFrame(u"_blank"_ustr, 0);
+        uno::Reference<awt::XWindow> xContainer = mxFrame->getContainerWindow();
+        uno::Reference<frame::XController> xStart
+            = frame::StartModule::createWithParentWindow(m_xContext, xContainer);
+        uno::Reference<awt::XWindow> xComponentWindow(xStart, uno::UNO_QUERY_THROW);
+        mxFrame->setComponent(xComponentWindow, xStart);
+        xStart->attachFrame(mxFrame);
+        xContainer->setPosSize(0, 0, rContent.Width(), rContent.Height(), awt::PosSize::POSSIZE);
+        xContainer->setVisible(true);
+        Scheduler::ProcessEventsToIdle();
+        // whatever the frame keeps for itself (a menu bar), the content area is rContent; the
+        // frame may place its component only after a later event, so measure once it is laid out
+        for (int nTry = 0; nTry < 20; ++nTry)
+        {
+            const Size aContent = window()->GetOutputSizePixel();
+            if (aContent == rContent)
+                break;
+            if (aContent.Width() > 0 && aContent.Height() > 0)
+            {
+                const awt::Rectangle aOuter = xContainer->getPosSize();
+                xContainer->setPosSize(0, 0, aOuter.Width + rContent.Width() - aContent.Width(),
+                                       aOuter.Height + rContent.Height() - aContent.Height(),
+                                       awt::PosSize::SIZE);
+            }
+            else // the frame lays out on a short timer, which "events to idle" does not wait for
+                std::this_thread::sleep_for(std::chrono::milliseconds(100));
+            Scheduler::ProcessEventsToIdle();
+        }
+
+        VclPtr<vcl::Window> pWindow = VCLUnoHelper::GetWindow(mxFrame->getComponentWindow());
+        CPPUNIT_ASSERT(pWindow);
+        mxRoot = pWindow->GetUITestFactory()(pWindow.get());
+        CPPUNIT_ASSERT(mxRoot);
+    }
+
+    void closeFrame()
+    {
+        mxRoot.reset();
+        if (!mxFrame.is())
+            return;
+        uno::Reference<util::XCloseable> xCloseable(mxFrame, uno::UNO_QUERY);
+        if (xCloseable.is())
+            xCloseable->close(true);
+        mxFrame.clear();
+        Scheduler::ProcessEventsToIdle();
+    }
+
+    vcl::Window* window() const { return VCLUnoHelper::GetWindow(mxFrame->getComponentWindow()); }
+
+    /** The drawn surface: the child window announced as the Start Center. */
+    vcl::Window* canvas() const
+    {
+        vcl::Window* pWindow = window();
+        for (sal_uInt16 i = 0; pWindow && i < pWindow->GetChildCount(); ++i)
+            if (pWindow->GetChild(i)->GetAccessibleName() == "Start Center")
+                return pWindow->GetChild(i);
+        CPPUNIT_FAIL("no Start Center canvas");
+        return nullptr;
+    }
+
+    uno::Reference<XAccessibleContext> canvasContext() const
+    {
+        return context(uno::Reference<XAccessible>(canvas()->GetAccessible()));
+    }
+
+    /** A region of the canvas by its accessible name ("Menu", "Recent documents"...). */
+    uno::Reference<XAccessibleContext> region(std::u16string_view aName) const
+    {
+        uno::Reference<XAccessibleContext> xCanvas = canvasContext();
+        for (sal_Int64 i = 0; i < xCanvas->getAccessibleChildCount(); ++i)
+        {
+            uno::Reference<XAccessibleContext> xChild = context(xCanvas->getAccessibleChild(i));
+            if (xChild->getAccessibleName() == aName)
+                return xChild;
+        }
+        CPPUNIT_FAIL(OUString(u"no region " + OUString(aName)).toUtf8().getStr());
+        return nullptr;
+    }
+
+    uno::Reference<XAccessibleContext> item(std::u16string_view aRegion, sal_Int64 nIndex) const
+    {
+        return context(region(aRegion)->getAccessibleChild(nIndex));
+    }
+
+    /** Types a key into the window that has the focus, as the keyboard does. */
+    static void key(sal_uInt16 nCode, bool bShift = false)
+    {
+        vcl::Window* pFocus = Application::GetFocusWindow();
+        CPPUNIT_ASSERT_MESSAGE("a window has the focus", pFocus);
+        const KeyEvent aKey(0, vcl::KeyCode(nCode, bShift, false, false, false));
+        Application::PostKeyEvent(VclEventId::WindowKeyInput, pFocus, &aKey);
+        Application::PostKeyEvent(VclEventId::WindowKeyUp, pFocus, &aKey);
+        Scheduler::ProcessEventsToIdle();
+    }
+
+    /** The region and the name of the drawn item with the keyboard focus ("" when none has it). */
+    std::pair<OUString, OUString> focused() const
+    {
+        uno::Reference<XAccessibleContext> xCanvas = canvasContext();
+        for (sal_Int64 i = 0; i < xCanvas->getAccessibleChildCount(); ++i)
+        {
+            uno::Reference<XAccessibleContext> xRegion = context(xCanvas->getAccessibleChild(i));
+            for (sal_Int64 j = 0; j < xRegion->getAccessibleChildCount(); ++j)
+            {
+                uno::Reference<XAccessibleContext> xItem = context(xRegion->getAccessibleChild(j));
+                if (xItem->getAccessibleStateSet() & AccessibleStateType::FOCUSED)
+                    return { xRegion->getAccessibleName(), xItem->getAccessibleName() };
+            }
+        }
+        return {};
+    }
+
+    void press(std::u16string_view aRegion, sal_Int64 nIndex, sal_Int32 nAction = 0)
+    {
+        uno::Reference<XAccessibleAction> xAction(item(aRegion, nIndex), uno::UNO_QUERY_THROW);
+        CPPUNIT_ASSERT(xAction->doAccessibleAction(nAction));
+        Scheduler::ProcessEventsToIdle();
+    }
+
+    sal_Int64 rows(std::u16string_view aRegion) const { return region(aRegion)->getAccessibleChildCount(); }
+
+    /** Dispatches a command to the Start Center's own dispatcher, as the office's menus do. */
+    void dispatchToStartCenter(const OUString& rCommand)
+    {
+        util::URL aURL;
+        aURL.Complete = rCommand;
+        util::URLTransformer::create(m_xContext)->parseStrict(aURL);
+        uno::Reference<frame::XDispatchProvider> xProvider(mxFrame->getController(),
+                                                           uno::UNO_QUERY_THROW);
+        uno::Reference<frame::XDispatch> xDispatch = xProvider->queryDispatch(aURL, OUString(), 0);
+        CPPUNIT_ASSERT(xDispatch.is());
+        xDispatch->dispatch(aURL, {});
+        Scheduler::ProcessEventsToIdle();
+    }
+
+    std::unique_ptr<UIObject> child(const OUString& rId)
+    {
+        std::unique_ptr<UIObject> xChild = mxRoot->get_child(rId);
+        CPPUNIT_ASSERT_MESSAGE(rId.toUtf8().getStr(), xChild);
+        return xChild;
+    }
+
+    void search(const OUString& rText)
+    {
+        child(u"search"_ustr)->execute(u"SET"_ustr, { { u"TEXT"_ustr, rText } });
+        Scheduler::ProcessEventsToIdle();
+    }
+
+    bool isPinned(std::u16string_view aName) const
+    {
+        for (const SvtHistoryOptions::HistoryItem& rItem : SvtHistoryOptions::GetList(EHistoryType::PickList))
+            if (rItem.sURL == fileURL(aName))
+                return rItem.isPinned;
+        return false;
+    }
+
+    uno::Reference<frame::XFrame> mxFrame;
+    std::unique_ptr<UIObject> mxRoot;
+};
+
