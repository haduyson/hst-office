@@ -0,0 +1,74 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * This file is part of HST Office.
+ */
+
+#include <startcenter/hststartcentersearch.hxx>
+
+#include <rtl/ustrbuf.hxx>
+
+#include <unicode/normalizer2.h>
+#include <unicode/uchar.h>
+#include <unicode/unistr.h>
+
+namespace sfx2::hst::startcenter
+{
+namespace
+{
+bool isSpace(sal_Unicode c) { return c == ' ' || c == '\t' || c == 0x00A0 || c == 0x3000; }
+
+/** Decomposed form (NFD), so that every Vietnamese letter is a base letter followed by its marks.
+    Falls back to the text itself if ICU cannot provide the normalizer. */
+icu::UnicodeString decompose(std::u16string_view aText)
+{
+    const icu::UnicodeString aSource(false, reinterpret_cast<const UChar*>(aText.data()),
+                                     static_cast<int32_t>(aText.size()));
+    UErrorCode nError = U_ZERO_ERROR;
+    const icu::Normalizer2* pNFD = icu::Normalizer2::getNFDInstance(nError);
+    if (U_FAILURE(nError) || !pNFD)
+        return aSource;
+    icu::UnicodeString aResult = pNFD->normalize(aSource, nError);
+    return U_FAILURE(nError) ? aSource : aResult;
+}
+}
+
+OUString FoldForSearch(std::u16string_view aText)
+{
+    const icu::UnicodeString aDecomposed = decompose(aText);
+    OUStringBuffer aFolded(aDecomposed.length());
+    for (int32_t i = 0; i < aDecomposed.length(); i = aDecomposed.moveIndex32(i, 1))
+    {
+        UChar32 c = aDecomposed.char32At(i);
+        const int8_t nType = u_charType(c);
+        if (nType == U_NON_SPACING_MARK || nType == U_ENCLOSING_MARK
+            || nType == U_COMBINING_SPACING_MARK)
+            continue;
+        if (c == 0x0110 || c == 0x0111) // Đ đ have no decomposition
+            c = 'd';
+        aFolded.appendUtf32(u_tolower(c));
+    }
+    return aFolded.makeStringAndClear();
+}
+
+bool MatchesFoldedQuery(std::u16string_view aFoldedName, std::u16string_view aFoldedQuery)
+{
+    size_t nPos = 0;
+    while (nPos < aFoldedQuery.size())
+    {
+        while (nPos < aFoldedQuery.size() && isSpace(aFoldedQuery[nPos]))
+            ++nPos;
+        size_t nEnd = nPos;
+        while (nEnd < aFoldedQuery.size() && !isSpace(aFoldedQuery[nEnd]))
+            ++nEnd;
+        if (nEnd > nPos
+            && aFoldedName.find(aFoldedQuery.substr(nPos, nEnd - nPos)) == std::u16string_view::npos)
+            return false;
+        nPos = nEnd;
+    }
+    return true;
+}
+}
