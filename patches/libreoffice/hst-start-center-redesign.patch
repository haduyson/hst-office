+void StartCenterActions::ContextMenu(const Hit& rHit, const tools::Rectangle& rAt)
+{
+    if (const RecentFile* pFile = mrWindow.mxCanvas->ItemFile(rHit))
+        mrWindow.PostAction(u"menu"_ustr, pFile->aURL, -1, rAt);
+}
