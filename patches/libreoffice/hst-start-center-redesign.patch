+bool HstStartCenterWindow::SearchHasFocus() const { return mxSearch && mxSearch->has_focus(); }
+
+bool HstStartCenterWindow::BannerHasFocus() const
+{
+    return mxBannerHost && mxBannerHost->IsVisible() && mxBannerHost->HasChildPathFocus();
+}
+
+void HstStartCenterWindow::FocusSearch()
+{
+    if (mxSearch)
+        mxSearch->grab_focus();
+}
+
+bool HstStartCenterWindow::FocusBanner()
+{
+    if (!mxBannerHost || !mxBannerHost->IsVisible())
+        return false;
+    mxBannerHost->GrabFocus();
+    return true;
+}
+
+IMPL_LINK(HstStartCenterWindow, SearchFocusHdl, weld::Widget&, rWidget, void)
+{
+    if (mxCanvas)
+        mxCanvas->SetSearchFocused(rWidget.has_focus());
+}
+
+void HstStartCenterWindow::FocusRegion(int nDelta)
+{
+    // F6 regions: the menu, the search field, the recent table, the pinned card, the HASON TECH block
+    enum
+    {
+        MENU,
+        SEARCH,
+        RECENT,
+        PINNED,
+        SOLUTIONS
+    };
+    std::vector<int> aRegions{ MENU, SEARCH };
+    if (mxCanvas->HasRows(Part::Recent))
+        aRegions.push_back(RECENT);
+    if (mxCanvas->HasRows(Part::Pinned))
+        aRegions.push_back(PINNED);
+    if (mxCanvas->HasRows(Part::Solution))
+        aRegions.push_back(SOLUTIONS);
+    int nCurrent = -1;
+    if (SearchHasFocus())
+        nCurrent = SEARCH;
+    else if (BannerHasFocus())
+        nCurrent = SOLUTIONS;
+    else if (mxCanvas->HasFocus())
+    {
+        switch (mxCanvas->GetFocusItem().ePart)
+        {
+            case Part::Recent:
+                nCurrent = RECENT;
+                break;
+            case Part::Pinned:
+                nCurrent = PINNED;
+                break;
+            case Part::Solution:
+            case Part::MoreSolutions:
+                nCurrent = SOLUTIONS;
+                break;
+            default:
+                nCurrent = MENU; // the tiles belong to the menu's region
+                break;
+        }
+    }
+    auto it = std::find(aRegions.begin(), aRegions.end(), nCurrent);
+    const int nCount = aRegions.size();
+    const int nAt = it == aRegions.end() ? -1 : static_cast<int>(it - aRegions.begin());
+    const int nNext = nAt < 0 ? 0 : (nAt + nDelta + nCount) % nCount;
+    switch (aRegions[nNext])
+    {
+        case MENU:
+            mxCanvas->FocusRegion(Part::Nav);
+            break;
+        case SEARCH:
+            FocusSearch();
+            break;
+        case RECENT:
+            mxCanvas->FocusRegion(Part::Recent);
+            break;
+        case PINNED:
+            mxCanvas->FocusRegion(Part::Pinned);
+            break;
+        case SOLUTIONS:
+            if (!FocusBanner())
+                mxCanvas->FocusRegion(Part::Solution);
+            break;
+    }
+}
+
+bool HstStartCenterWindow::PreNotify(NotifyEvent& rNEvt)
+{
+    if (rNEvt.GetType() == NotifyEventType::KEYINPUT && mxCanvas)
+    {
+        const vcl::KeyCode& rKey = rNEvt.GetKeyEvent()->GetKeyCode();
+        if (rKey.GetCode() == KEY_F6 && !rKey.IsMod1() && !rKey.IsMod2())
+        {
+            FocusRegion(rKey.IsShift() ? -1 : 1);
+            return true;
+        }
+        // Tab out of the search field and the banner into the canvas's regions
+        if (rKey.GetCode() == KEY_TAB && !rKey.IsMod1() && !rKey.IsMod2())
+        {
+            if (SearchHasFocus())
+            {
+                if (rKey.IsShift())
+                    mxCanvas->FocusRegionBefore(Part::Tile);
+                else
+                    mxCanvas->FocusRegion(Part::Tile);
+                return true;
+            }
+            if (BannerHasFocus())
+            {
+                if (rKey.IsShift())
+                    mxCanvas->FocusRegionBefore(Part::Solution);
+                else
+                    mxCanvas->FocusRegion(Part::Solution);
+                return true;
+            }
+        }
+        // the office's shortcuts (Ctrl+N, Ctrl+O, Ctrl+Q...), except the editing keys of the search field
+        const bool bTyping = SearchHasFocus()
+                             && (!rKey.IsMod1() || rKey.GetCode() == KEY_A || rKey.GetCode() == KEY_C
+                                 || rKey.GetCode() == KEY_V || rKey.GetCode() == KEY_X
+                                 || rKey.GetCode() == KEY_Z || rKey.GetCode() == KEY_Y);
+        if (!bTyping && mxFrame.is())
+        {
+            if (!mpAccExec)
+            {
+                mpAccExec = svt::AcceleratorExecute::createAcceleratorHelper();
+                mpAccExec->init(comphelper::getProcessComponentContext(), mxFrame);
+            }
+            const OUString aCommand
+                = mpAccExec->findCommand(svt::AcceleratorExecute::st_VCLKey2AWTKey(rKey));
+            if (aCommand != "vnd.sun.star.findbar:FocusToFindbar" && mpAccExec->execute(rKey))
+                return true;
+        }
+    }
+    return vcl::Window::PreNotify(rNEvt);
+}
+
+void HstStartCenterWindow::GetFocus()
+{
+    if (!mxCanvas)
+        return vcl::Window::GetFocus();
+    const GetFocusFlags nFlags = GetParent() ? GetParent()->GetGetFocusFlags() : GetFocusFlags::NONE;
+    // F6 from the menu bar: the first region; backwards: the last list
+    if ((nFlags & GetFocusFlags::F6) && !(nFlags & GetFocusFlags::Forward))
+    {
+        if (!mxCanvas->FocusRegion(Part::Recent))
+            mxCanvas->FocusRegion(Part::Nav);
+        return;
+    }
+    mxCanvas->FocusRegion(Part::Nav);
+}
+
