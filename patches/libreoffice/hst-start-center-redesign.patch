+const RecentFile* findFile(const CanvasModel& rModel, const OUString& rURL)
+{
+    for (const RecentFile& rFile : rModel.aFiles)
+        if (rFile.aURL == rURL)
+            return &rFile;
+    return nullptr;
+}
+
+/** The row of rURL in a list of the model, -1 when the list does not show it. */
+int rowOf(const CanvasModel& rModel, const std::vector<size_t>& rList, std::u16string_view aURL)
+{
+    for (size_t i = 0; i < rList.size(); ++i)
+        if (rModel.aFiles[rList[i]].aURL == aURL)
+            return static_cast<int>(i);
+    return -1;
+}
+
+OUString menuText(TranslateId aId) { return SfxResId(aId).replaceAll("_", "~"); }
+}
+
+void HstStartCenterWindow::ReloadFiles()
+{
+    CanvasModel& rModel = mxCanvas->GetModel();
+    rModel.aFiles = LoadRecentFiles();
+    FillLists();
+
+    // file times not read yet: on a worker thread, the table shows them when they arrive
+    std::vector<OUString> aURLs;
+    for (const RecentFile& rFile : rModel.aFiles)
+        if (rModel.aTimes.find(rFile.aURL) == rModel.aTimes.end())
+            aURLs.push_back(rFile.aURL);
+    if (aURLs.empty())
+        return;
+    mpTimes->Start(aURLs, [this, aURLs](const std::vector<DateTime>& rTimes) {
+        if (!mxCanvas)
+            return;
+        CanvasModel& rTimesModel = mxCanvas->GetModel();
+        for (size_t i = 0; i < aURLs.size() && i < rTimes.size(); ++i)
+            rTimesModel.aTimes.insert_or_assign(aURLs[i], rTimes[i]);
+        mxCanvas->TimesChanged();
+    });
+}
+
+void HstStartCenterWindow::FillLists()
+{
+    if (!mxCanvas)
+        return;
+    CanvasModel& rModel = mxCanvas->GetModel();
+    // the focused file stays focused when it is still listed
+    const Hit aFocus = mxCanvas->GetFocusItem();
+    const RecentFile* pFocus = mxCanvas->ItemFile(aFocus);
+    const OUString aFocusURL = pFocus ? pFocus->aURL : OUString();
+
+    rModel.aQuery = mxSearch ? mxSearch->get_text() : OUString();
+    const OUString aQuery = FoldForSearch(rModel.aQuery);
+    rModel.aRecent.clear();
+    rModel.aPinned.clear();
+    for (size_t i = 0; i < rModel.aFiles.size(); ++i)
+    {
+        const RecentFile& rFile = rModel.aFiles[i];
+        if (rFile.bPinned)
+            rModel.aPinned.push_back(i);
+        if ((!rModel.bPinnedOnly || rFile.bPinned) && MatchesFoldedQuery(rFile.aFolded, aQuery))
+            rModel.aRecent.push_back(i);
+    }
+    mxCanvas->ModelChanged();
+
+    if (aFocusURL.isEmpty() || !mxCanvas->HasFocus())
+        return;
+    const int nRow = rowOf(rModel, aFocus.ePart == Part::Pinned ? rModel.aPinned : rModel.aRecent, aFocusURL);
+    if (nRow >= 0)
+        mxCanvas->FocusItem({ aFocus.ePart, nRow });
+}
+
+IMPL_LINK_NOARG(HstStartCenterWindow, SearchChangedHdl, weld::Entry&, void)
+{
+    mxCanvas->GetModel().nSelectedNav = 0; // searching is the Home view
+    FillLists();
+}
+
+IMPL_LINK_NOARG(HstStartCenterWindow, SearchActivateHdl, weld::Entry&, bool)
+{
+    // Enter in the search field: to the first file found
+    mxCanvas->FocusRegion(Part::Recent);
+    return true;
+}
+
+void HstStartCenterWindow::clearRecentFileList()
+{
+    mxCanvas->GetModel().aTimes.clear();
+    ReloadFiles();
+}
+
+void HstStartCenterWindow::TogglePinned(const OUString& rURL)
+{
+    if (!findFile(mxCanvas->GetModel(), rURL))
+        return;
+    // the history keeps the pin in the profile, so it stays after a restart
+    SvtHistoryOptions::TogglePinItem(EHistoryType::PickList, rURL);
+    ReloadFiles();
+}
+
+void HstStartCenterWindow::RemoveFromList(const OUString& rURL)
+{
+    // removes the entry from the history only; the file itself stays where it is
+    SvtHistoryOptions::DeleteItem(EHistoryType::PickList, rURL, true);
+    mxCanvas->GetModel().aTimes.erase(rURL);
+    ReloadFiles();
+}
+
+void HstStartCenterWindow::OpenFile(const OUString& rURL)
+{
+    const RecentFile* pFile = findFile(mxCanvas->GetModel(), rURL);
+    if (!pFile)
+        return;
+    uno::Sequence<beans::PropertyValue> aArgs{
+        comphelper::makePropertyValue(u"Referer"_ustr, u"private:user"_ustr),
+        comphelper::makePropertyValue(u"AsTemplate"_ustr, false) // a recent file is never a template
+    };
+    if (pFile->bReadOnly)
+    {
+        aArgs.realloc(3);
+        aArgs.getArray()[2] = comphelper::makePropertyValue(u"ReadOnly"_ustr, true);
+    }
+    Dispatch(rURL, u"_default"_ustr, false, aArgs);
+}
+
+void HstStartCenterWindow::OpenFolder(const OUString& rURL)
+{
+    const RecentFile* pFile = findFile(mxCanvas->GetModel(), rURL);
+    if (!pFile || pFile->aFolderURL.isEmpty())
+        return;
+    try
+    {
+        system::SystemShellExecute::create(comphelper::getProcessComponentContext())
+            ->execute(pFile->aFolderURL, OUString(), system::SystemShellExecuteFlags::URIS_ONLY);
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("sfx.startcenter", "opening the folder failed");
+    }
+}
+
+void HstStartCenterWindow::ShowFileMenu(const OUString& rURL, const tools::Rectangle& rAt)
+{
+    const RecentFile* pFile = findFile(mxCanvas->GetModel(), rURL);
+    if (!pFile)
+        return;
+    enum : sal_uInt16
+    {
+        MENU_OPEN = 1,
+        MENU_FOLDER,
+        MENU_PIN,
+        MENU_REMOVE
+    };
+    ScopedVclPtrInstance<PopupMenu> xMenu;
+    xMenu->InsertItem(MENU_OPEN, menuText(STR_HST_SC_MENU_OPEN));
+    xMenu->InsertItem(MENU_FOLDER, menuText(STR_HST_SC_MENU_FOLDER));
+    xMenu->EnableItem(MENU_FOLDER, pFile->aFolderURL.startsWithIgnoreAsciiCase("file:"));
+    xMenu->InsertItem(MENU_PIN, menuText(pFile->bPinned ? STR_HST_SC_MENU_UNPIN : STR_HST_SC_MENU_PIN));
+    xMenu->InsertSeparator();
+    xMenu->InsertItem(MENU_REMOVE, menuText(STR_HST_SC_MENU_REMOVE));
+    switch (xMenu->Execute(mxCanvas.get(), rAt, PopupMenuFlags::ExecuteDown))
+    {
+        case MENU_OPEN:
+            OpenFile(rURL);
+            break;
+        case MENU_FOLDER:
+            OpenFolder(rURL);
+            break;
+        case MENU_PIN:
+            TogglePinned(rURL);
+            break;
+        case MENU_REMOVE:
+            RemoveFromList(rURL);
+            break;
+        default:
+            break;
+    }
+}
