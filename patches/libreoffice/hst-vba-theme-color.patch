+// HST: ThemeColor and TintAndShade, which Excel's macro recorder writes for most colors. The colors
+// are those of the default Office theme; a workbook's own theme is not read here.
+
+#pragma once
+
+#include <sal/types.h>
+#include <algorithm>
+#include <cmath>
+
+namespace ScVbaTheme
+{
+/// RGB of an XlThemeColor (1-12); a value outside that gives -1
+inline sal_Int32 rgbOf(sal_Int32 nTheme)
+{
+    static constexpr sal_Int32 aColors[]
+        = { 0xFFFFFF, 0x000000, 0xE7E6E6, 0x44546A, 0x4472C4, 0xED7D31, 0xA5A5A5, 0xFFC000, 0x5B9BD5, 0x70AD47, 0x0563C1, 0x954F72 };
+    return nTheme >= 1 && nTheme <= 12 ? aColors[nTheme - 1] : -1;
+}
+
+/// Excel's tint: negative darkens, positive lightens, on the luminance
+inline sal_Int32 applyTint(sal_Int32 nRgb, double fTint)
+{
+    double r = ((nRgb >> 16) & 0xFF) / 255.0, g = ((nRgb >> 8) & 0xFF) / 255.0, b = (nRgb & 0xFF) / 255.0;
+    const double fMax = std::max({ r, g, b }), fMin = std::min({ r, g, b });
+    double h = 0, s = 0, l = (fMax + fMin) / 2;
+    if (fMax > fMin)
+    {
+        const double d = fMax - fMin;
+        s = l > 0.5 ? d / (2 - fMax - fMin) : d / (fMax + fMin);
+        h = fMax == r ? (g - b) / d + (g < b ? 6 : 0) : fMax == g ? (b - r) / d + 2 : (r - g) / d + 4;
+        h /= 6;
+    }
+    l = fTint < 0 ? l * (1 + fTint) : l * (1 - fTint) + fTint;
+    const auto channel = [&](double t) {
+        const double q = l < 0.5 ? l * (1 + s) : l + s - l * s, p = 2 * l - q;
+        t = t < 0 ? t + 1 : t > 1 ? t - 1 : t;
+        double v = t < 1.0 / 6 ? p + (q - p) * 6 * t : t < 0.5 ? q : t < 2.0 / 3 ? p + (q - p) * (2.0 / 3 - t) * 6 : p;
+        return static_cast<sal_Int32>(std::lround(std::clamp(v, 0.0, 1.0) * 255));
+    };
+    return (channel(h + 1.0 / 3) << 16) | (channel(h) << 8) | channel(h - 1.0 / 3);
+}
+}
