+uno::Any SAL_CALL ScVbaFont::getThemeColor() { return uno::Any(mnThemeColor); }
+
+void SAL_CALL ScVbaFont::setThemeColor(const uno::Any& rAny)
+{
+    sal_Int32 nTheme = 0;
+    rAny >>= nTheme;
+    const sal_Int32 nRgb = ScVbaTheme::rgbOf(nTheme);
+    if (nRgb < 0)
+        return;
+    mnThemeColor = nTheme;
+    mfTint = 0;
+    setColor(OORGBToXLRGB(uno::Any(nRgb)));
+}
+
+uno::Any SAL_CALL ScVbaFont::getTintAndShade() { return uno::Any(mfTint); }
+
+void SAL_CALL ScVbaFont::setTintAndShade(const uno::Any& rAny)
+{
+    double fTint = 0;
+    if (!(rAny >>= fTint))
+        return;
+    mfTint = fTint;
+    sal_Int32 nBase = ScVbaTheme::rgbOf(mnThemeColor);
+    if (nBase < 0)
+        XLRGBToOORGB(getColor()) >>= nBase;
+    setColor(OORGBToXLRGB(uno::Any(ScVbaTheme::applyTint(nBase, fTint))));
+}
