+# -*- Mode: makefile-gmake; tab-width: 4; indent-tabs-mode: t -*-
+#
+# This file is part of the LibreOffice project.
+#
+# This Source Code Form is subject to the terms of the Mozilla Public
+# License, v. 2.0. If a copy of the MPL was not distributed with this
+# file, You can obtain one at http://mozilla.org/MPL/2.0/.
+#
+
+# HST Office: bundled extension "HST Vietnamese tools" (ND30 wizard, TCVN3/VNI converter,
+# welcome dialog, HASON TECH menu). The .oxt is built from the HST Office repository
+# (scripts/build-extensions.py; the repository root is two levels above the source tree,
+# like the other HST build inputs), unpacked into instdir/share/extensions/ and listed in
+# workdir/ExtensionPackage/hst-vietnamese-tools.filelist for the installer. Extensions
+# under share/extensions are registered for every user on first start (bundled layer).
+
+hst_ext_REPO := $(abspath $(SRCDIR)/../..)
+hst_ext_OXT := $(WORKDIR)/CustomTarget/dictionaries/hst-vietnamese-tools.oxt
+
+$(hst_ext_OXT) : $(shell find $(hst_ext_REPO)/extensions/hst-vietnamese-tools \
+		$(hst_ext_REPO)/data/vietnamese $(hst_ext_REPO)/data/hst -type f 2>/dev/null) \
+		$(hst_ext_REPO)/scripts/build-extensions.py $(hst_ext_REPO)/LICENSE
+	$(call gb_Output_announce,hst-vietnamese-tools.oxt,$(true),OXT,3)
+	mkdir -p $(dir $@) \
+		&& python3 $(hst_ext_REPO)/scripts/build-extensions.py --output $(dir $@) >/dev/null
+
+# Not gb_ExtensionPackage_ExtensionPackage: that macro also declares a recipe for the
+# .oxt (touching a prebuilt file), which would replace the build rule above.
+$(eval $(call gb_ExtensionPackage_ExtensionPackage_internal,hst-vietnamese-tools,$(hst_ext_OXT)))
+$(eval $(call gb_Module_register_target,$(call gb_ExtensionPackage_get_target,hst-vietnamese-tools),$(call gb_ExtensionPackage_get_clean_target,hst-vietnamese-tools)))
+$(eval $(call gb_Helper_make_userfriendly_targets,hst-vietnamese-tools,ExtensionPackage))
+
