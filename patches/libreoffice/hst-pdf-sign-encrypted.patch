+/// Signing an encrypted PDF appends an encrypted update that keeps the earlier signature valid.
+CPPUNIT_TEST_FIXTURE(PDFSigningTest, testEncryptedSignKeepsEncryption)
+{
+    if (!vcl::pdf::PDFiumLibrary::get())
+        return;
+    uno::Reference<xml::crypto::XSEInitializer> xSEInitializer
+        = xml::crypto::SEInitializer::create(m_xContext);
+    uno::Reference<xml::crypto::XXMLSecurityContext> xSecurityContext
+        = xSEInitializer->createSecurityContext(OUString());
+    uno::Reference<security::XCertificate> xCertificate = signingCertificate(xSecurityContext);
+    if (!xCertificate.is())
+        return;
+
+    for (std::u16string_view aKind : { u"aes128-objstm", u"aes256", u"rc4-128", u"rc4-40" })
+    {
+        const OString aCase = OUStringToOString(aKind, RTL_TEXTENCODING_ASCII_US);
+        const std::vector<sal_uInt8> aData = encryptedSample(m_directories, aKind);
+        {
+            std::unique_ptr<vcl::filter::PDFDocument> pDocument = readSample(aData);
+            CPPUNIT_ASSERT_EQUAL_MESSAGE(aCase.getStr(), int(vcl::filter::PDFEncryption::Decrypted),
+                                         int(pDocument->GetEncryption()));
+            // the page tree is in encrypted object streams in the AES samples
+            CPPUNIT_ASSERT_EQUAL_MESSAGE(aCase.getStr(), size_t(1), pDocument->GetPages().size());
+            CPPUNIT_ASSERT(pDocument->IsSigningPermitted(true));
+        }
+
+        std::vector<sal_uInt8> aSigned;
+        CPPUNIT_ASSERT_EQUAL_MESSAGE(aCase.getStr(), int(hstpdf::SignResult::Signed),
+                                     int(hstpdf::signPdf(aData, xCertificate, u"Kiểm thử"_ustr,
+                                                         aPlacement, aSigned)));
+        // an incremental update: the original bytes stay, the new strings are encrypted
+        CPPUNIT_ASSERT(std::equal(aData.begin(), aData.end(), aSigned.begin()));
+        CPPUNIT_ASSERT(!contains(aSigned, "Signature1"));
+        CPPUNIT_ASSERT(!contains(aSigned, "/M (D:"));
+        std::vector<SignatureInformation> aInfos = verifyEncrypted(aSigned);
+        CPPUNIT_ASSERT_EQUAL_MESSAGE(aCase.getStr(), size_t(1), aInfos.size());
+        CPPUNIT_ASSERT_EQUAL_MESSAGE(aCase.getStr(), xml::crypto::SecurityOperationStatus_OPERATION_SUCCEEDED,
+                                     aInfos[0].nStatus);
+        {
+            // the newest trailer keeps /Encrypt, the new field is found through the page
+            std::unique_ptr<vcl::filter::PDFDocument> pDocument = readSample(aSigned);
+            CPPUNIT_ASSERT_EQUAL(int(vcl::filter::PDFEncryption::Decrypted),
+                                 int(pDocument->GetEncryption()));
+            CPPUNIT_ASSERT_EQUAL(size_t(1), pDocument->GetSignatureWidgets().size());
+        }
+
+        // a second signature leaves the first one valid
+        std::vector<sal_uInt8> aTwice;
+        CPPUNIT_ASSERT_EQUAL(int(hstpdf::SignResult::Signed),
+                             int(hstpdf::signPdf(aSigned, xCertificate, OUString(), aPlacement,
+                                                 aTwice)));
+        aInfos = verifyEncrypted(aTwice);
+        CPPUNIT_ASSERT_EQUAL_MESSAGE(aCase.getStr(), size_t(2), aInfos.size());
+        for (const SignatureInformation& rInfo : aInfos)
+            CPPUNIT_ASSERT_EQUAL_MESSAGE(aCase.getStr(),
+                                         xml::crypto::SecurityOperationStatus_OPERATION_SUCCEEDED,
+                                         rInfo.nStatus);
+        CPPUNIT_ASSERT_EQUAL(size_t(2), readSample(aTwice)->GetSignatureWidgets().size());
+    }
+}
+
+/// The permission bits of an encrypted PDF decide between a new field, the empty field, or no.
+CPPUNIT_TEST_FIXTURE(PDFSigningTest, testEncryptedSignPermissions)
+{
+    if (!vcl::pdf::PDFiumLibrary::get())
+        return;
+    uno::Reference<xml::crypto::XSEInitializer> xSEInitializer
+        = xml::crypto::SEInitializer::create(m_xContext);
+    uno::Reference<xml::crypto::XXMLSecurityContext> xSecurityContext
+        = xSEInitializer->createSecurityContext(OUString());
+    uno::Reference<security::XCertificate> xCertificate = signingCertificate(xSecurityContext);
+    if (!xCertificate.is())
+        return;
+
+    struct Case
+    {
+        std::u16string_view aKind;
+        bool bNewField, bFillField;
+    };
+    // bits 4 (modify), 6 (annotations and forms), 9 (fill in forms)
+    for (const Case& rCase : { Case{ u"perm-4-6", true, true }, Case{ u"perm-6", false, true },
+                               Case{ u"perm-9", false, true }, Case{ u"perm-4", false, false },
+                               Case{ u"perm-none", false, false } })
+    {
+        const OString aCase = OUStringToOString(rCase.aKind, RTL_TEXTENCODING_ASCII_US);
+        const std::vector<sal_uInt8> aData = encryptedSample(m_directories, rCase.aKind);
+        {
+            std::unique_ptr<vcl::filter::PDFDocument> pDocument = readSample(aData);
+            CPPUNIT_ASSERT_EQUAL_MESSAGE(aCase.getStr(), rCase.bNewField,
+                                         pDocument->IsSigningPermitted(true));
+            CPPUNIT_ASSERT_EQUAL_MESSAGE(aCase.getStr(), rCase.bFillField,
+                                         pDocument->IsSigningPermitted(false));
+            CPPUNIT_ASSERT_EQUAL(size_t(1), pDocument->GetEmptySignatureFields().size());
+        }
+        std::vector<sal_uInt8> aSigned;
+        const hstpdf::SignResult eResult
+            = hstpdf::signPdf(aData, xCertificate, OUString(), aPlacement, aSigned);
+        if (!rCase.bFillField)
+        {
+            CPPUNIT_ASSERT_EQUAL_MESSAGE(aCase.getStr(), int(hstpdf::SignResult::NotPermitted),
+                                         int(eResult));
+            continue;
+        }
+        CPPUNIT_ASSERT_EQUAL_MESSAGE(aCase.getStr(), int(hstpdf::SignResult::Signed), int(eResult));
+        const std::vector<SignatureInformation> aInfos = verifyEncrypted(aSigned);
+        CPPUNIT_ASSERT_EQUAL_MESSAGE(aCase.getStr(), size_t(1), aInfos.size());
+        CPPUNIT_ASSERT_EQUAL_MESSAGE(aCase.getStr(),
+                                     xml::crypto::SecurityOperationStatus_OPERATION_SUCCEEDED,
+                                     aInfos[0].nStatus);
+        std::unique_ptr<vcl::filter::PDFDocument> pDocument = readSample(aSigned);
+        // a new field beside the empty one, or the empty one signed
+        CPPUNIT_ASSERT_EQUAL_MESSAGE(aCase.getStr(), size_t(rCase.bNewField ? 2 : 1),
+                                     pDocument->GetSignatureWidgets().size());
+        CPPUNIT_ASSERT_EQUAL_MESSAGE(aCase.getStr(), size_t(rCase.bNewField ? 1 : 0),
+                                     pDocument->GetEmptySignatureFields().size());
+    }
+}
