+/// A file with an open password needs it to be signed.
+CPPUNIT_TEST_FIXTURE(PDFSigningTest, testEncryptedSignUserPassword)
+{
+    uno::Reference<xml::crypto::XSEInitializer> xSEInitializer
+        = xml::crypto::SEInitializer::create(m_xContext);
+    uno::Reference<xml::crypto::XXMLSecurityContext> xSecurityContext
+        = xSEInitializer->createSecurityContext(OUString());
+    const std::vector<sal_uInt8> aData = encryptedSample(m_directories, u"user-password");
+    CPPUNIT_ASSERT_EQUAL(int(vcl::filter::PDFEncryption::NeedsPassword),
+                         int(readSample(aData)->GetEncryption()));
+    CPPUNIT_ASSERT(readSample(aData)->GetPages().empty());
+    std::unique_ptr<vcl::filter::PDFDocument> pUser = readSample(aData, "mo"_ostr);
+    CPPUNIT_ASSERT_EQUAL(int(vcl::filter::PDFEncryption::Decrypted), int(pUser->GetEncryption()));
+    CPPUNIT_ASSERT_EQUAL(size_t(1), pUser->GetPages().size());
+
+    uno::Reference<security::XCertificate> xCertificate = signingCertificate(xSecurityContext);
+    if (!xCertificate.is())
+        return;
+    std::vector<sal_uInt8> aSigned;
+    CPPUNIT_ASSERT_EQUAL(int(hstpdf::SignResult::NeedsPassword),
+                         int(hstpdf::signPdf(aData, xCertificate, OUString(), aPlacement, aSigned)));
+    CPPUNIT_ASSERT_EQUAL(int(hstpdf::SignResult::Signed),
+                         int(hstpdf::signPdf(aData, xCertificate, OUString(), aPlacement, aSigned,
+                                             "mo"_ostr)));
+    std::unique_ptr<vcl::filter::PDFDocument> pSigned = readSample(aSigned, "mo"_ostr);
+    CPPUNIT_ASSERT_EQUAL(int(vcl::filter::PDFEncryption::Decrypted), int(pSigned->GetEncryption()));
+    CPPUNIT_ASSERT_EQUAL(size_t(1), pSigned->GetSignatureWidgets().size());
+}
