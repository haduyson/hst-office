+/// An encrypted sample of tests/runtime/pdf_encrypted_samples.py, stored in base64.
+std::vector<sal_uInt8> encryptedSample(test::Directories& rDirectories, std::u16string_view aKind)
+{
+    SvFileStream aStream(rDirectories.getURLFromSrc(DATA_DIRECTORY) + "hst-encrypted-" + aKind
+                             + ".pdf.b64",
+                         StreamMode::READ);
+    OStringBuffer aBase64;
+    OString aLine;
+    while (aStream.ReadLine(aLine))
+        aBase64.append(aLine);
+    uno::Sequence<sal_Int8> aBytes;
+    comphelper::Base64::decode(aBytes, OStringToOUString(aBase64, RTL_TEXTENCODING_ASCII_US));
+    CPPUNIT_ASSERT(aBytes.hasElements());
+    return std::vector<sal_uInt8>(aBytes.begin(), aBytes.end());
+}
+
+/// Reads rData as a document to sign, with an optional password.
+std::unique_ptr<vcl::filter::PDFDocument> readSample(const std::vector<sal_uInt8>& rData,
+                                                     const OString& rPassword = OString())
+{
+    SvMemoryStream aStream(const_cast<sal_uInt8*>(rData.data()), rData.size(), StreamMode::READ);
+    auto pDocument = std::make_unique<vcl::filter::PDFDocument>();
+    pDocument->SetPassword(rPassword);
+    CPPUNIT_ASSERT(pDocument->Read(aStream));
+    return pDocument;
+}
+
+/// The signatures of rData that PDFium (opening it with an empty password) verifies; an empty
+/// signature field is not one.
+std::vector<SignatureInformation> verifyEncrypted(const std::vector<sal_uInt8>& rData)
+{
+    SvMemoryStream aStream(const_cast<sal_uInt8*>(rData.data()), rData.size(), StreamMode::READ);
+    PDFSignatureHelper aHelper;
+    CPPUNIT_ASSERT(aHelper.ReadAndVerifySignatureSvStream(aStream));
+    std::vector<SignatureInformation> aValid;
+    for (const SignatureInformation& rInfo : aHelper.GetSignatureInformations())
+        if (rInfo.nStatus == xml::crypto::SecurityOperationStatus_OPERATION_SUCCEEDED)
+            aValid.push_back(rInfo);
+    return aValid;
+}
+
+bool contains(const std::vector<sal_uInt8>& rData, std::string_view aText)
+{
+    return std::search(rData.begin(), rData.end(), aText.begin(), aText.end()) != rData.end();
+}
+
+const hstpdf::SignaturePlacement aPlacement{ 0, basegfx::B2DRectangle(40, 40, 240, 100),
+                                             basegfx::B2DSize(595, 842) };
+}
+
+/// The certificate of the test profile that can sign, or none.
+static uno::Reference<security::XCertificate>
+signingCertificate(const uno::Reference<xml::crypto::XXMLSecurityContext>& xSecurityContext)
+{
+    uno::Reference<xml::crypto::XSecurityEnvironment> xEnvironment
+        = xSecurityContext->getSecurityEnvironment();
+    for (const auto& xCertificate : xEnvironment->getPersonalCertificates())
+        if (unotest::MacrosTest::IsValid(xCertificate, xEnvironment))
+            return xCertificate;
+    return {};
+}
