+std::vector<sal_uInt8> md5(const std::vector<sal_uInt8>& rData)
+{
+    return comphelper::Hash::calculateHash(rData.data(), rData.size(), comphelper::HashType::MD5);
+}
+
+std::vector<sal_uInt8> sha256(std::string_view aPassword, const sal_uInt8* pSalt,
+                              const std::vector<sal_uInt8>& rUser = {})
+{
+    comphelper::Hash aHash(comphelper::HashType::SHA256);
+    aHash.update(aPassword.data(), aPassword.size());
+    aHash.update(pSalt, 8);
+    aHash.update(rUser.data(), rUser.size());
+    return aHash.finalize();
+}
+
+std::vector<sal_uInt8> rc4(const std::vector<sal_uInt8>& rKey, const sal_uInt8* pData,
+                           size_t nSize)
+{
+    std::vector<sal_uInt8> aOut(nSize);
+    if (!nSize)
+        return aOut;
+    rtlCipher aCipher = rtl_cipher_createARCFOUR(rtl_Cipher_ModeStream);
+    rtl_cipher_initARCFOUR(aCipher, rtl_Cipher_DirectionEncode, rKey.data(), rKey.size(), nullptr,
+                           0);
+    rtl_cipher_encodeARCFOUR(aCipher, pData, nSize, aOut.data(), nSize);
+    rtl_cipher_destroyARCFOUR(aCipher);
+    return aOut;
+}
+
+/// The RC4 rounds of revision 3 and later: the key xor-ed with each round number.
+std::vector<sal_uInt8> rc4Rounds(const std::vector<sal_uInt8>& rKey, std::vector<sal_uInt8> aData,
+                                 bool bDown)
+{
+    for (int i = 0; i < 20; ++i)
+    {
+        const sal_uInt8 nRound = bDown ? 19 - i : i;
+        std::vector<sal_uInt8> aKey(rKey);
+        for (sal_uInt8& c : aKey)
+            c ^= nRound;
+        aData = rc4(aKey, aData.data(), aData.size());
+    }
+    return aData;
+}
+
+comphelper::CryptoType aesType(size_t nKeyLength)
+{
+    return nKeyLength == 32 ? comphelper::CryptoType::AES_256_CBC
+                            : comphelper::CryptoType::AES_128_CBC;
+}
+
+/// AES-CBC without padding; aIV may be all zero.
+std::vector<sal_uInt8> aesNoPad(bool bEncrypt, std::vector<sal_uInt8> aKey,
+                                std::vector<sal_uInt8> aIV, std::vector<sal_uInt8> aInput)
+{
+    std::vector<sal_uInt8> aOut(aInput.size());
+    if (aInput.empty() || aInput.size() % AES_BLOCK)
+        return {};
+    sal_uInt32 nDone;
+    if (bEncrypt)
+    {
+        comphelper::Encrypt aAes(aKey, aIV, aesType(aKey.size()));
+        nDone = aAes.update(aOut, aInput);
+    }
+    else
+    {
+        comphelper::Decrypt aAes(aKey, aIV, aesType(aKey.size()));
+        nDone = aAes.update(aOut, aInput);
+    }
+    if (nDone != aInput.size())
+        return {};
+    return aOut;
+}
+
+std::vector<sal_uInt8> padPassword(std::string_view aPassword)
+{
+    std::vector<sal_uInt8> aPadded(aPassword.begin(),
+                                   aPassword.begin() + std::min<size_t>(aPassword.size(), 32));
+    aPadded.insert(aPadded.end(), aPasswordPadding, aPasswordPadding + 32 - aPadded.size());
+    return aPadded;
+}
+
+std::vector<sal_uInt8> stringBytes(PDFElement* pElement)
+{
+    if (auto pHex = dynamic_cast<PDFHexStringElement*>(pElement))
+        return hexStringBytes(pHex->GetValue());
+    if (auto pLiteral = dynamic_cast<PDFLiteralStringElement*>(pElement))
+        return literalStringBytes(pLiteral->GetValue());
+    return {};
+}
+
+sal_Int32 number(PDFObjectElement& rObject, const OString& rKey, sal_Int32 nDefault)
+{
+    auto pNumber = dynamic_cast<PDFNumberElement*>(rObject.Lookup(rKey));
+    return pNumber ? static_cast<sal_Int32>(pNumber->GetValue()) : nDefault;
+}
+
+/// Cipher of the named crypt filter (/StmF or /StrF) of a version 4 or 5 handler.
+bool cryptFilter(PDFObjectElement& rEncrypt, const OString& rKey,
+                 PDFStandardSecurity::Cipher& rCipher, sal_Int32& rLength)
+{
+    auto pName = dynamic_cast<PDFNameElement*>(rEncrypt.Lookup(rKey));
+    if (!pName || pName->GetValue() == "Identity")
+    {
+        rCipher = PDFStandardSecurity::Cipher::Identity;
+        return true;
+    }
+    auto pFilters = dynamic_cast<PDFDictionaryElement*>(rEncrypt.Lookup("CF"_ostr));
+    auto pFilter = pFilters ? dynamic_cast<PDFDictionaryElement*>(
+                                  pFilters->LookupElement(pName->GetValue()))
+                            : nullptr;
+    auto pMethod
+        = pFilter ? dynamic_cast<PDFNameElement*>(pFilter->LookupElement("CFM"_ostr)) : nullptr;
+    if (!pMethod || pMethod->GetValue() == "None")
+        rCipher = PDFStandardSecurity::Cipher::Identity;
+    else if (pMethod->GetValue() == "V2")
+        rCipher = PDFStandardSecurity::Cipher::RC4;
+    else if (pMethod->GetValue() == "AESV2")
+        rCipher = PDFStandardSecurity::Cipher::AESV2;
+    else if (pMethod->GetValue() == "AESV3")
+        rCipher = PDFStandardSecurity::Cipher::AESV3;
+    else
+        return false;
+    if (auto pLength
+        = pFilter ? dynamic_cast<PDFNumberElement*>(pFilter->LookupElement("Length"_ostr)) : nullptr)
+    {
+        // in bytes by the specification, in bits by some writers
+        const sal_Int32 nLength = pLength->GetValue();
+        rLength = nLength > 32 ? nLength / 8 : nLength;
+    }
+    return true;
+}
+
+bool isWhitespace(char c)
+{
+    return c == ' ' || c == '\n' || c == '\r' || c == '\t' || c == '\f' || c == '\0';
+}
+
+bool isDelimiter(char c)
+{
+    return isWhitespace(c) || c == '(' || c == ')' || c == '<' || c == '>' || c == '[' || c == ']'
+           || c == '{' || c == '}' || c == '/' || c == '%';
+}
+
+void appendHex(OStringBuffer& rBuffer, const std::vector<sal_uInt8>& rBytes)
+{
+    static const char aDigits[] = "0123456789ABCDEF";
+    rBuffer.append('<');
+    for (sal_uInt8 c : rBytes)
+    {
+        rBuffer.append(aDigits[c >> 4]);
+        rBuffer.append(aDigits[c & 0xF]);
+    }
+    rBuffer.append('>');
+}
+
+/// End of the literal string starting at nStart (its '('): the position of the closing ')'.
+size_t literalEnd(std::string_view aText, size_t nStart)
+{
+    int nDepth = 0;
+    for (size_t i = nStart; i < aText.size(); ++i)
+    {
+        if (aText[i] == '\\')
+            ++i;
+        else if (aText[i] == '(')
+            ++nDepth;
+        else if (aText[i] == ')' && --nDepth == 0)
+            return i;
+    }
+    return std::string_view::npos;
+}
+
+/// End of the value of a /Length key starting at nStart: a number, or an "N G R" reference.
+size_t lengthValueEnd(std::string_view aText, size_t nStart)
+{
+    auto tokenEnd = [&aText](size_t nPos) {
+        while (nPos < aText.size() && !isDelimiter(aText[nPos]))
+            ++nPos;
+        return nPos;
+    };
+    auto skipSpace = [&aText](size_t nPos) {
+        while (nPos < aText.size() && isWhitespace(aText[nPos]))
+            ++nPos;
+        return nPos;
+    };
+    const size_t nNumberEnd = tokenEnd(nStart);
+    const size_t nGeneration = skipSpace(nNumberEnd);
+    const size_t nGenerationEnd = tokenEnd(nGeneration);
+    const std::string_view aGeneration = aText.substr(nGeneration, nGenerationEnd - nGeneration);
+    if (aGeneration.empty() || aGeneration.find_first_not_of("0123456789") != std::string_view::npos)
+        return nNumberEnd;
+    const size_t nR = skipSpace(nGenerationEnd);
+    if (aText.substr(nR, tokenEnd(nR) - nR) != "R")
+        return nNumberEnd;
+    return nR + 1;
+}
+}
+
+std::vector<sal_uInt8> literalStringBytes(std::string_view aRaw)
+{
+    std::vector<sal_uInt8> aBytes;
+    for (size_t i = 0; i < aRaw.size(); ++i)
+    {
+        char c = aRaw[i];
+        if (c == '\r')
+        {
+            // an end of line in a string is a line feed
+            if (i + 1 < aRaw.size() && aRaw[i + 1] == '\n')
+                ++i;
+            aBytes.push_back('\n');
+            continue;
+        }
+        if (c != '\\')
+        {
+            aBytes.push_back(c);
+            continue;
+        }
+        if (++i == aRaw.size())
+            break;
+        c = aRaw[i];
+        switch (c)
+        {
+            case 'n':
+                aBytes.push_back('\n');
+                break;
+            case 'r':
+                aBytes.push_back('\r');
+                break;
+            case 't':
+                aBytes.push_back('\t');
+                break;
+            case 'b':
+                aBytes.push_back('\b');
+                break;
+            case 'f':
+                aBytes.push_back('\f');
+                break;
+            case '\r':
+                // a line continuation
+                if (i + 1 < aRaw.size() && aRaw[i + 1] == '\n')
+                    ++i;
+                break;
+            case '\n':
+                break;
+            default:
+                if (c >= '0' && c <= '7')
+                {
+                    int nValue = 0;
+                    for (int nDigit = 0;
+                         nDigit < 3 && i < aRaw.size() && aRaw[i] >= '0' && aRaw[i] <= '7';
+                         ++nDigit, ++i)
+                        nValue = nValue * 8 + (aRaw[i] - '0');
+                    --i;
+                    aBytes.push_back(static_cast<sal_uInt8>(nValue));
+                }
+                else
+                    aBytes.push_back(c); // '(', ')', '\\' and unknown escapes
+        }
+    }
+    return aBytes;
+}
+
+std::vector<sal_uInt8> hexStringBytes(std::string_view aRaw)
+{
+    std::vector<sal_uInt8> aBytes;
+    int nHigh = -1;
+    for (char c : aRaw)
+    {
+        int nValue;
+        if (c >= '0' && c <= '9')
+            nValue = c - '0';
+        else if (c >= 'a' && c <= 'f')
+            nValue = c - 'a' + 10;
+        else if (c >= 'A' && c <= 'F')
+            nValue = c - 'A' + 10;
+        else
+            continue;
+        if (nHigh < 0)
+            nHigh = nValue;
+        else
+        {
+            aBytes.push_back(nHigh * 16 + nValue);
+            nHigh = -1;
+        }
+    }
+    if (nHigh >= 0)
+        aBytes.push_back(nHigh * 16);
+    return aBytes;
+}
+
+bool PDFStandardSecurity::parse(PDFObjectElement& rEncrypt, std::vector<sal_uInt8> aID,
+                                Parameters& rParams)
+{
+    auto pFilter = dynamic_cast<PDFNameElement*>(rEncrypt.Lookup("Filter"_ostr));
+    if (!pFilter || pFilter->GetValue() != "Standard")
+    {
+        SAL_WARN("vcl.filter", "PDFStandardSecurity: not the standard security handler");
+        return false;
+    }
+    const sal_Int32 nVersion = number(rEncrypt, "V"_ostr, 0);
+    rParams.nRevision = number(rEncrypt, "R"_ostr, 0);
+    rParams.nPermissions = number(rEncrypt, "P"_ostr, 0);
+    rParams.aOwner = stringBytes(rEncrypt.Lookup("O"_ostr));
+    rParams.aUser = stringBytes(rEncrypt.Lookup("U"_ostr));
+    rParams.aOwnerKey = stringBytes(rEncrypt.Lookup("OE"_ostr));
+    rParams.aUserKey = stringBytes(rEncrypt.Lookup("UE"_ostr));
+    rParams.aID = std::move(aID);
+    if (auto pMetadata = dynamic_cast<PDFBooleanElement*>(rEncrypt.Lookup("EncryptMetadata"_ostr)))
+    {
+        OStringBuffer aValue;
+        pMetadata->writeString(aValue);
+        rParams.bEncryptMetadata = std::string_view(aValue) != "false";
+    }
+
+    sal_Int32 nLength = number(rEncrypt, "Length"_ostr, 40) / 8;
+    if (nVersion == 1 || nVersion == 2)
+        rParams.eStreams = rParams.eStrings = Cipher::RC4;
+    else if (nVersion == 4 || nVersion == 5)
+    {
+        if (!cryptFilter(rEncrypt, "StmF"_ostr, rParams.eStreams, nLength)
+            || !cryptFilter(rEncrypt, "StrF"_ostr, rParams.eStrings, nLength))
+        {
+            SAL_WARN("vcl.filter", "PDFStandardSecurity: unknown crypt filter");
+            return false;
+        }
+    }
+    else
+    {
+        SAL_WARN("vcl.filter", "PDFStandardSecurity: unsupported version " << nVersion);
+        return false;
+    }
+
+    const bool bAES256 = rParams.nRevision == 5 || rParams.nRevision == 6;
+    if (bAES256)
+    {
+        if (rParams.aOwner.size() < 48 || rParams.aUser.size() < 48
+            || rParams.aOwnerKey.size() < 32 || rParams.aUserKey.size() < 32)
+            return false;
+        for (Cipher eCipher : { rParams.eStreams, rParams.eStrings })
+            if (eCipher != Cipher::AESV3 && eCipher != Cipher::Identity)
+                return false;
+        rParams.nKeyLength = 32;
+        return true;
+    }
+    if (rParams.nRevision < 2 || rParams.nRevision > 4 || rParams.aOwner.size() < 32
+        || rParams.aUser.size() < 32)
+    {
+        SAL_WARN("vcl.filter", "PDFStandardSecurity: unsupported revision " << rParams.nRevision);
+        return false;
+    }
+    for (Cipher eCipher : { rParams.eStreams, rParams.eStrings })
+        if (eCipher == Cipher::AESV3)
+            return false;
+    rParams.nKeyLength = rParams.nRevision == 2 ? 5 : std::clamp<sal_Int32>(nLength, 5, 16);
+    return true;
+}
+
+PDFStandardSecurity::PDFStandardSecurity(Parameters aParams)
+    : m_aParams(std::move(aParams))
+{
+}
+
+bool PDFStandardSecurity::authenticate(std::string_view aPassword)
+{
+    m_aFileKey.clear();
+    m_bOwner = false;
+    if (m_aParams.nRevision >= 5)
+        return authenticateAES256(aPassword);
+    return authenticateR4(aPassword);
+}
+
+std::vector<sal_uInt8>
+PDFStandardSecurity::fileKeyR4(const std::vector<sal_uInt8>& rPaddedPassword) const
+{
+    // Algorithm 2
+    std::vector<sal_uInt8> aInput(rPaddedPassword);
+    aInput.insert(aInput.end(), m_aParams.aOwner.begin(), m_aParams.aOwner.begin() + 32);
+    const sal_uInt32 nPermissions = static_cast<sal_uInt32>(m_aParams.nPermissions);
+    for (int i = 0; i < 4; ++i)
+        aInput.push_back((nPermissions >> (8 * i)) & 0xFF);
+    aInput.insert(aInput.end(), m_aParams.aID.begin(), m_aParams.aID.end());
+    if (m_aParams.nRevision >= 4 && !m_aParams.bEncryptMetadata)
+        aInput.insert(aInput.end(), 4, 0xFF);
+    std::vector<sal_uInt8> aHash = md5(aInput);
+    const size_t nLength = m_aParams.nKeyLength;
+    if (m_aParams.nRevision >= 3)
+        for (int i = 0; i < 50; ++i)
+            aHash = md5(std::vector<sal_uInt8>(aHash.begin(), aHash.begin() + nLength));
+    aHash.resize(nLength);
+    return aHash;
+}
+
+bool PDFStandardSecurity::checkUserKeyR4(const std::vector<sal_uInt8>& rKey) const
+{
+    // Algorithms 4, 5 and 6
+    if (m_aParams.nRevision == 2)
+    {
+        const std::vector<sal_uInt8> aU = rc4(rKey, aPasswordPadding, 32);
+        return std::equal(aU.begin(), aU.end(), m_aParams.aUser.begin());
+    }
+    std::vector<sal_uInt8> aInput(aPasswordPadding, aPasswordPadding + 32);
+    aInput.insert(aInput.end(), m_aParams.aID.begin(), m_aParams.aID.end());
+    const std::vector<sal_uInt8> aU = rc4Rounds(rKey, md5(aInput), false);
+    return std::equal(aU.begin(), aU.begin() + 16, m_aParams.aUser.begin());
+}
+
+bool PDFStandardSecurity::authenticateR4(std::string_view aPassword)
+{
+    std::vector<sal_uInt8> aKey = fileKeyR4(padPassword(aPassword));
+    if (checkUserKeyR4(aKey))
+    {
+        m_aFileKey = std::move(aKey);
+        return true;
+    }
+
+    // Algorithm 7: the owner password decrypts /O into the padded user password.
+    const std::vector<sal_uInt8> aPadded = padPassword(aPassword);
+    std::vector<sal_uInt8> aHash = md5(aPadded);
+    if (m_aParams.nRevision >= 3)
+        for (int i = 0; i < 50; ++i)
+            aHash = md5(aHash);
+    aHash.resize(m_aParams.nKeyLength);
+    std::vector<sal_uInt8> aOwner(m_aParams.aOwner.begin(), m_aParams.aOwner.begin() + 32);
+    const std::vector<sal_uInt8> aUserPassword
+        = m_aParams.nRevision == 2 ? rc4(aHash, aOwner.data(), aOwner.size())
+                                   : rc4Rounds(aHash, aOwner, true);
+    aKey = fileKeyR4(aUserPassword);
+    if (!checkUserKeyR4(aKey))
+        return false;
+    m_aFileKey = std::move(aKey);
+    m_bOwner = true;
+    return true;
+}
+
+bool PDFStandardSecurity::authenticateAES256(std::string_view aPassword)
+{
+    // Algorithms 2.A and 2.B; passwords are cut at 127 bytes
+    aPassword = aPassword.substr(0, std::min<size_t>(aPassword.size(), 127));
+    const sal_uInt8* pPassword = reinterpret_cast<const sal_uInt8*>(aPassword.data());
+    const std::vector<sal_uInt8>& rO = m_aParams.aOwner;
+    const std::vector<sal_uInt8> aU(m_aParams.aUser.begin(), m_aParams.aUser.begin() + 48);
+    auto hash = [&](const sal_uInt8* pSalt, const std::vector<sal_uInt8>& rUser) {
+        if (m_aParams.nRevision == 5)
+            return sha256(aPassword, pSalt, rUser);
+        return vcl::pdf::computeHashR6(pPassword, aPassword.size(),
+                                       std::vector<sal_uInt8>(pSalt, pSalt + 8), rUser);
+    };
+    std::vector<sal_uInt8> aKeyHash;
+    std::vector<sal_uInt8> aEncryptedKey;
+    const std::vector<sal_uInt8> aCheckUser = hash(aU.data() + 32, {});
+    if (std::equal(aCheckUser.begin(), aCheckUser.end(), aU.begin()))
+    {
+        aKeyHash = hash(aU.data() + 40, {});
+        aEncryptedKey.assign(m_aParams.aUserKey.begin(), m_aParams.aUserKey.begin() + 32);
+    }
+    else
+    {
+        const std::vector<sal_uInt8> aCheckOwner = hash(rO.data() + 32, aU);
+        if (!std::equal(aCheckOwner.begin(), aCheckOwner.end(), rO.begin()))
+            return false;
+        aKeyHash = hash(rO.data() + 40, aU);
+        aEncryptedKey.assign(m_aParams.aOwnerKey.begin(), m_aParams.aOwnerKey.begin() + 32);
+        m_bOwner = true;
+    }
+    m_aFileKey = aesNoPad(false, aKeyHash, std::vector<sal_uInt8>(AES_BLOCK, 0), aEncryptedKey);
+    if (m_aFileKey.size() != 32)
+    {
+        m_aFileKey.clear();
+        m_bOwner = false;
+        return false;
+    }
+    return true;
+}
+
+std::vector<sal_uInt8> PDFStandardSecurity::objectKey(Cipher eCipher, sal_Int32 nObject,
+                                                      sal_Int32 nGeneration) const
+{
+    if (eCipher == Cipher::AESV3)
+        return m_aFileKey;
+    // Algorithm 1
+    std::vector<sal_uInt8> aInput(m_aFileKey);
+    for (int i = 0; i < 3; ++i)
+        aInput.push_back((nObject >> (8 * i)) & 0xFF);
+    for (int i = 0; i < 2; ++i)
+        aInput.push_back((nGeneration >> (8 * i)) & 0xFF);
+    if (eCipher == Cipher::AESV2)
+        aInput.insert(aInput.end(), { 's', 'A', 'l', 'T' });
+    std::vector<sal_uInt8> aKey = md5(aInput);
+    aKey.resize(std::min<size_t>(m_aFileKey.size() + 5, 16));
+    return aKey;
+}
+
+std::vector<sal_uInt8> PDFStandardSecurity::decrypt(bool bStream, const sal_uInt8* pData,
+                                                    size_t nSize, sal_Int32 nObject,
+                                                    sal_Int32 nGeneration) const
+{
+    const Cipher eCipher = bStream ? m_aParams.eStreams : m_aParams.eStrings;
+    if (eCipher == Cipher::Identity || m_aFileKey.empty())
+        return std::vector<sal_uInt8>(pData, pData + nSize);
+    const std::vector<sal_uInt8> aKey = objectKey(eCipher, nObject, nGeneration);
+    if (eCipher == Cipher::RC4)
+        return rc4(aKey, pData, nSize);
+
+    // the initialization vector comes first, the padding (1-16 bytes) last
+    if (nSize < 2 * AES_BLOCK)
+        return {};
+    const size_t nBlocks = nSize - nSize % AES_BLOCK;
+    std::vector<sal_uInt8> aPlain
+        = aesNoPad(false, aKey, std::vector<sal_uInt8>(pData, pData + AES_BLOCK),
+                   std::vector<sal_uInt8>(pData + AES_BLOCK, pData + nBlocks));
+    if (aPlain.empty())
+        return {};
+    const sal_uInt8 nPad = aPlain.back();
+    if (nPad >= 1 && nPad <= AES_BLOCK
+        && std::all_of(aPlain.end() - nPad, aPlain.end(), [nPad](sal_uInt8 c) { return c == nPad; }))
+        aPlain.resize(aPlain.size() - nPad);
+    return aPlain;
+}
+
+std::vector<sal_uInt8> PDFStandardSecurity::encrypt(bool bStream, const sal_uInt8* pData,
+                                                    size_t nSize, sal_Int32 nObject,
+                                                    sal_Int32 nGeneration) const
+{
+    const Cipher eCipher = bStream ? m_aParams.eStreams : m_aParams.eStrings;
+    if (eCipher == Cipher::Identity || m_aFileKey.empty())
+        return std::vector<sal_uInt8>(pData, pData + nSize);
+    const std::vector<sal_uInt8> aKey = objectKey(eCipher, nObject, nGeneration);
+    if (eCipher == Cipher::RC4)
+        return rc4(aKey, pData, nSize);
+
+    std::vector<sal_uInt8> aInput(pData, pData + nSize);
+    const sal_uInt8 nPad = AES_BLOCK - nSize % AES_BLOCK;
+    aInput.insert(aInput.end(), nPad, nPad);
+    std::vector<sal_uInt8> aIV(AES_BLOCK);
+    if (rtl_random_getBytes(nullptr, aIV.data(), aIV.size()) != rtl_Random_E_None)
+        return {};
+    std::vector<sal_uInt8> aOut = aesNoPad(true, aKey, aIV, aInput);
+    if (aOut.empty())
+        return {};
+    aIV.insert(aIV.end(), aOut.begin(), aOut.end());
+    return aIV;
+}
+
+OString PDFStandardSecurity::encryptObject(std::string_view aObject, sal_Int32 nObject) const
+{
+    OStringBuffer aOut(aObject.size() + 64);
+    int nDepth = 0;
+    // where the value of the object's /Length key was copied to aOut
+    sal_Int32 nLengthStart = -1;
+    sal_Int32 nLengthEnd = -1;
+    size_t i = 0;
+    while (i < aObject.size())
+    {
+        const char c = aObject[i];
+        if (c == '%')
+        {
+            const size_t nEnd = aObject.find_first_of("\r\n", i);
+            const size_t nStop = nEnd == std::string_view::npos ? aObject.size() : nEnd;
+            aOut.append(aObject.substr(i, nStop - i));
+            i = nStop;
+        }
+        else if (c == '(')
+        {
+            const size_t nEnd = literalEnd(aObject, i);
+            if (nEnd == std::string_view::npos)
+                return {};
+            const std::vector<sal_uInt8> aPlain
+                = literalStringBytes(aObject.substr(i + 1, nEnd - i - 1));
+            appendHex(aOut, encrypt(false, aPlain.data(), aPlain.size(), nObject, 0));
+            i = nEnd + 1;
+        }
+        else if (c == '<' && i + 1 < aObject.size() && aObject[i + 1] == '<')
+        {
+            aOut.append("<<");
+            ++nDepth;
+            i += 2;
+        }
+        else if (c == '>' && i + 1 < aObject.size() && aObject[i + 1] == '>')
+        {
+            aOut.append(">>");
+            --nDepth;
+            i += 2;
+        }
+        else if (c == '<')
+        {
+            const size_t nEnd = aObject.find('>', i);
+            if (nEnd == std::string_view::npos)
+                return {};
+            const std::vector<sal_uInt8> aPlain = hexStringBytes(aObject.substr(i + 1, nEnd - i - 1));
+            appendHex(aOut, encrypt(false, aPlain.data(), aPlain.size(), nObject, 0));
+            i = nEnd + 1;
+        }
+        else if (isDelimiter(c) && c != '/')
+        {
+            aOut.append(c);
+            ++i;
+        }
+        else
+        {
+            // a name or a regular token
+            size_t nEnd = i + 1;
+            while (nEnd < aObject.size() && !isDelimiter(aObject[nEnd]))
+                ++nEnd;
+            const std::string_view aToken = aObject.substr(i, nEnd - i);
+            if (aToken == "stream" && nDepth == 0)
+            {
+                size_t nData = nEnd;
+                if (nData < aObject.size() && aObject[nData] == '\r')
+                    ++nData;
+                if (nData < aObject.size() && aObject[nData] == '\n')
+                    ++nData;
+                const size_t nEndStream = aObject.rfind("endstream");
+                if (nEndStream == std::string_view::npos || nEndStream < nData || nLengthStart < 0)
+                    return {};
+                size_t nDataEnd = nEndStream;
+                if (nDataEnd > nData && aObject[nDataEnd - 1] == '\n')
+                    --nDataEnd;
+                if (nDataEnd > nData && aObject[nDataEnd - 1] == '\r')
+                    --nDataEnd;
+                const std::vector<sal_uInt8> aEncrypted
+                    = encrypt(true, reinterpret_cast<const sal_uInt8*>(aObject.data()) + nData,
+                              nDataEnd - nData, nObject, 0);
+                aOut.remove(nLengthStart, nLengthEnd - nLengthStart);
+                aOut.insert(nLengthStart, OString::number(sal_Int64(aEncrypted.size())));
+                aOut.append("stream\n");
+                aOut.append(reinterpret_cast<const char*>(aEncrypted.data()), aEncrypted.size());
+                aOut.append("\n");
+                aOut.append(aObject.substr(nEndStream));
+                return aOut.makeStringAndClear();
+            }
+            aOut.append(aToken);
+            i = nEnd;
+            if (aToken == "/Length" && nDepth == 1)
+            {
+                // copy the value as is, remember where: a number or an "N G R" reference
+                while (i < aObject.size() && isWhitespace(aObject[i]))
+                    aOut.append(aObject[i++]);
+                nLengthStart = aOut.getLength();
+                const size_t nValueEnd = lengthValueEnd(aObject, i);
+                aOut.append(aObject.substr(i, nValueEnd - i));
+                nLengthEnd = aOut.getLength();
+                i = nValueEnd;
+            }
+        }
+    }
+    return aOut.makeStringAndClear();
+}
+}
