+#pragma once
+
+#include <rtl/string.hxx>
+#include <sal/types.h>
+
+#include <string_view>
+#include <vector>
+
+namespace vcl::filter
+{
+class PDFObjectElement;
+
+/**
+ * The standard security handler of an encrypted PDF (ISO 32000-2, 7.6.4): finds the file key
+ * from a password, decrypts the strings and streams of existing objects and encrypts those of
+ * objects appended in an incremental update, with the keys of the file.
+ *
+ * Revisions 2-4 (RC4 40-128 bit, AES-128) and 5-6 (AES-256) are supported.
+ */
+class PDFStandardSecurity
+{
+public:
+    enum class Cipher
+    {
+        Identity,
+        RC4,
+        AESV2,
+        AESV3
+    };
+
+    struct Parameters
+    {
+        sal_Int32 nRevision = 0;
+        /// File key length in bytes, revisions 2-4.
+        sal_Int32 nKeyLength = 5;
+        sal_Int32 nPermissions = 0;
+        bool bEncryptMetadata = true;
+        Cipher eStreams = Cipher::RC4;
+        Cipher eStrings = Cipher::RC4;
+        std::vector<sal_uInt8> aOwner, aUser, aOwnerKey, aUserKey;
+        /// First element of the trailer /ID.
+        std::vector<sal_uInt8> aID;
+    };
+
+    /// Reads the /Encrypt dictionary; false if it is not a standard handler understood here.
+    static bool parse(PDFObjectElement& rEncrypt, std::vector<sal_uInt8> aID, Parameters& rParams);
+
+    explicit PDFStandardSecurity(Parameters aParams);
+
+    /// Tries rPassword (UTF-8) as the user password, then as the owner password.
+    bool authenticate(std::string_view aPassword);
+    /// The owner password was given: the permissions do not restrict the user.
+    bool isOwner() const { return m_bOwner; }
+    sal_Int32 getPermissions() const { return m_aParams.nPermissions; }
+    sal_Int32 getRevision() const { return m_aParams.nRevision; }
+
+    std::vector<sal_uInt8> decrypt(bool bStream, const sal_uInt8* pData, size_t nSize,
+                                   sal_Int32 nObject, sal_Int32 nGeneration) const;
+    std::vector<sal_uInt8> encrypt(bool bStream, const sal_uInt8* pData, size_t nSize,
+                                   sal_Int32 nObject, sal_Int32 nGeneration) const;
+
+    /**
+     * Takes an object written in plain text ("N G obj ... endobj") and returns it with every
+     * string, and its stream, encrypted for object nObject; a stream gets a direct /Length.
+     * Returns an empty string if the object cannot be processed.
+     */
+    OString encryptObject(std::string_view aObject, sal_Int32 nObject) const;
+
+private:
+    std::vector<sal_uInt8> objectKey(Cipher eCipher, sal_Int32 nObject,
+                                     sal_Int32 nGeneration) const;
+    std::vector<sal_uInt8> fileKeyR4(const std::vector<sal_uInt8>& rPaddedPassword) const;
+    bool checkUserKeyR4(const std::vector<sal_uInt8>& rKey) const;
+    bool authenticateR4(std::string_view aPassword);
+    bool authenticateAES256(std::string_view aPassword);
+
+    Parameters m_aParams;
+    std::vector<sal_uInt8> m_aFileKey;
+    bool m_bOwner = false;
+};
+
+/// The bytes of a literal string as found between its parentheses, with escapes resolved.
+std::vector<sal_uInt8> literalStringBytes(std::string_view aRaw);
+/// The bytes of a hex string as found between its angle brackets.
+std::vector<sal_uInt8> hexStringBytes(std::string_view aRaw);
+}
