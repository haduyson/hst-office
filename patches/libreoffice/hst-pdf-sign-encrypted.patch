+bool PDFDocument::IsSigningPermitted(bool bNewField) const
+{
+    if (m_eEncryption == PDFEncryption::None)
+        return true;
+    if (!m_pSecurity)
+        return false;
+    if (m_pSecurity->isOwner())
+        return true;
+    const sal_Int32 nPermissions = m_pSecurity->getPermissions();
+    const sal_Int32 nModify = 1 << 3, nAnnotations = 1 << 5, nFillForms = 1 << 8;
+    if (bNewField)
+        return (nPermissions & nModify) && (nPermissions & nAnnotations);
+    // bit 9 means something from revision 3 on; revision 2 sets it as a reserved bit
+    return (nPermissions & nAnnotations)
+           || (m_pSecurity->getRevision() >= 3 && (nPermissions & nFillForms));
+}
+
+std::vector<PDFSignatureField> PDFDocument::GetEmptySignatureFields()
+{
+    std::vector<PDFSignatureField> aRet;
+    const std::vector<PDFObjectElement*> aPages = GetPages();
+    for (size_t nPage = 0; nPage < aPages.size(); ++nPage)
+    {
+        for (PDFObjectElement* pWidget : GetSignatureWidgets())
+        {
+            if (pWidget->Lookup("V"_ostr))
+                continue;
+            auto pPageRef = dynamic_cast<PDFReferenceElement*>(pWidget->Lookup("P"_ostr));
+            if (!pPageRef || !aPages[nPage]
+                || pPageRef->GetObjectValue() != aPages[nPage]->GetObjectValue())
+                continue;
+            auto pRect = dynamic_cast<PDFArrayElement*>(pWidget->Lookup("Rect"_ostr));
+            if (!pRect || pRect->GetElements().size() != 4)
+                continue;
+            double aRect[4];
+            bool bNumbers = true;
+            for (size_t i = 0; i < 4; ++i)
+            {
+                auto pNumber = dynamic_cast<PDFNumberElement*>(pRect->GetElements()[i]);
+                bNumbers = bNumbers && pNumber;
+                aRect[i] = pNumber ? pNumber->GetValue() : 0;
+            }
+            if (!bNumbers)
+                continue;
+            aRet.push_back({ pWidget, nPage, std::min(aRect[0], aRect[2]),
+                             std::min(aRect[1], aRect[3]), std::max(aRect[0], aRect[2]),
+                             std::max(aRect[1], aRect[3]) });
+        }
+    }
+    return aRet;
+}
+
+bool PDFDocument::WriteFilledFieldObject(sal_Int32 nSignatureId, sal_Int32 nAppearanceId)
+{
+    PDFObjectElement& rWidget = *m_pSignatureField;
+    PDFDictionaryElement* pDictionary = rWidget.GetDictionary();
+    const sal_uInt32 nWidgetId = rWidget.GetObjectValue();
+    if (!pDictionary || m_aXRef.find(nWidgetId) == m_aXRef.end())
+    {
+        SAL_WARN("vcl.filter", "PDFDocument::Sign: invalid signature field");
+        return false;
+    }
+    // the field keeps its keys (strings as read: encrypted for this object number in a plain
+    // object, plain in an object stream), with the new value and appearance
+    OStringBuffer aLine(OString::number(nWidgetId) + " 0 obj\n<<");
+    for (const auto& rItem : pDictionary->GetItems())
+    {
+        if (rItem.first == "V" || rItem.first == "AP")
+            continue;
+        aLine.append("/" + rItem.first + " ");
+        rItem.second->writeString(aLine);
+        aLine.append("\n");
+    }
+    aLine.append("/V " + OString::number(nSignatureId) + " 0 R\n/AP<</N "
+                 + OString::number(nAppearanceId) + " 0 R>>\n>>\nendobj\n\n");
+    const sal_uInt64 nStart = m_aEditBuffer.Tell();
+    m_aXRef[nWidgetId].SetType(XRefEntryType::NOT_COMPRESSED);
+    m_aXRef[nWidgetId].SetOffset(nStart);
+    m_aXRef[nWidgetId].SetDirty(true);
+    m_aEditBuffer.WriteOString(aLine);
+    return !rWidget.GetStreamBuffer() || EncryptWrittenObject(nStart, nWidgetId);
+}
+
+PDFReferenceElement* PDFDocument::FindRoot()
+{
+    if (m_pXRefStream)
+        return dynamic_cast<PDFReferenceElement*>(m_pXRefStream->Lookup("Root"_ostr));
+    return m_pTrailer ? dynamic_cast<PDFReferenceElement*>(m_pTrailer->Lookup("Root"_ostr))
+                      : nullptr;
+}
+
+std::vector<sal_uInt8> PDFDocument::GetStringBytes(PDFElement* pElement,
+                                                   PDFObjectElement& rOwner) const
+{
+    std::vector<sal_uInt8> aBytes;
+    if (auto pHex = dynamic_cast<PDFHexStringElement*>(pElement))
+        aBytes = hexStringBytes(pHex->GetValue());
+    else if (auto pLiteral = dynamic_cast<PDFLiteralStringElement*>(pElement))
+        aBytes = literalStringBytes(pLiteral->GetValue());
+    else
+        return aBytes;
+    // strings of objects in object streams are encrypted with the stream only
+    if (m_pSecurity && !rOwner.GetStreamBuffer())
+        aBytes = m_pSecurity->decrypt(false, aBytes.data(), aBytes.size(),
+                                      rOwner.GetObjectValue(), 0);
+    return aBytes;
+}
+
+OString PDFDocument::WriteString(const std::vector<sal_uInt8>& rBytes, sal_Int32 nObject) const
+{
+    const std::vector<sal_uInt8> aBytes
+        = m_pSecurity ? m_pSecurity->encrypt(false, rBytes.data(), rBytes.size(), nObject, 0)
+                      : rBytes;
+    OStringBuffer aBuffer("<");
+    for (sal_uInt8 c : aBytes)
+        svl::crypto::Signing::appendHex(c, aBuffer);
+    aBuffer.append(">");
+    return aBuffer.makeStringAndClear();
+}
+
+OString PDFDocument::GetObjectSource(PDFObjectElement& rObject, sal_uInt64 nOffset,
+                                     sal_uInt64 nLength)
+{
+    SvMemoryStream* pBuffer = rObject.GetStreamBuffer();
+    if (!pBuffer)
+        pBuffer = &m_aEditBuffer;
+    if (nOffset > pBuffer->GetSize() || nLength > pBuffer->GetSize() - nOffset)
+        return {};
+    return OString(static_cast<const char*>(pBuffer->GetData()) + nOffset, nLength);
+}
+
+bool PDFDocument::EncryptWrittenObject(sal_uInt64 nStart, sal_Int32 nObject)
+{
+    if (!m_pSecurity)
+        return true;
+    const sal_uInt64 nEnd = m_aEditBuffer.Tell();
+    const OString aEncrypted = m_pSecurity->encryptObject(
+        std::string_view(static_cast<const char*>(m_aEditBuffer.GetData()) + nStart, nEnd - nStart),
+        nObject);
+    if (aEncrypted.isEmpty())
+    {
+        SAL_WARN("vcl.filter", "PDFDocument::EncryptWrittenObject: cannot encrypt obj " << nObject);
+        return false;
+    }
+    m_aEditBuffer.Seek(nStart);
+    m_aEditBuffer.WriteOString(aEncrypted);
+    // a shorter result (RC4 of an escaped string) leaves whitespace between objects
+    while (m_aEditBuffer.Tell() < nEnd)
+        m_aEditBuffer.WriteChar('\n');
+    return m_aEditBuffer.good();
+}
+
+bool PDFDocument::FlushPendingObject()
+{
+    if (m_nPendingObject < 0)
+        return true;
+    const sal_Int32 nObject = m_nPendingObject;
+    m_nPendingObject = -1;
+    return EncryptWrittenObject(m_nPendingStart, nObject);
+}
