Subject: [PATCH] VBA: class events, interfaces, TypeName of classes, Err 9 on missing elements

RaiseEvent reaches handlers of a variable whose module declares them, an
object can be Set to an interface its class implements, TypeName gives the
class name, every missing-element exception raises 9, and a Type may have
members called Name or Parent.
---
--- a/basic/source/classes/sbunoobj.cxx
+++ b/basic/source/classes/sbunoobj.cxx
@@ -360,6 +360,23 @@
     return implGetExceptionMsg( e, cppu::UnoType<decltype(e)>::get().getTypeName() );
 }
 
+// HST: Worksheets("none") and the like: code handles VBA's "Subscript out of range" by its number
+static bool lcl_isMissingElement( const Any& rException )
+{
+    return SbiRuntime::isVBAEnabled()
+           && ( rException.isExtractableTo( cppu::UnoType<NoSuchElementException>::get() )
+                || rException.isExtractableTo( cppu::UnoType<IndexOutOfBoundsException>::get() ) );
+}
+
+template< class EXCEPTION >
+static void lcl_raiseException( const EXCEPTION& e )
+{
+    if( lcl_isMissingElement( Any( e ) ) )
+        StarBASIC::Error( ERRCODE_BASIC_OUT_OF_RANGE );
+    else
+        StarBASIC::Error( ERRCODE_BASIC_EXCEPTION, implGetExceptionMsg( e ) );
+}
+
