+++ b/sw/qa/core/text/text.cxx
@@ -54,6 +54,7 @@
 #include <pagefrm.hxx>
 #include <inftxt.hxx>
 #include <itrtxt.hxx>
+#include <viewopt.hxx>
 
 /// Covers sw/source/core/text/ fixes.
 class SwCoreTextTest : public SwModelTestBase
@@ -1836,6 +1837,36 @@ CPPUNIT_TEST_FIXTURE(SwCoreTextTest, testTdf171555NonBreakingHyphen)
                          getXPath(pXmlDoc, "//txt[1]/SwParaPortion/SwLineLayout", "width"));
 }
 
+CPPUNIT_TEST_FIXTURE(SwCoreTextTest, testHardBlankShadingOnlyWithFormattingMarks)
+{
+    // Rectangles painted for the screen (where field shadings are drawn) of a document holding
+    // only rText, with formatting marks shown or not.
+    auto aRectCount = [this](const OUString& rText, bool bFormattingMarks) {
+        createSwDoc();
+        SwWrtShell* pWrtShell = getSwDocShell()->GetWrtShell();
+        pWrtShell->Insert(rText);
+        SwViewOption aViewOptions(*pWrtShell->GetViewOptions());
+        aViewOptions.SetHardBlank(true);
+        aViewOptions.SetViewMetaChars(bFormattingMarks);
+        pWrtShell->ApplyViewOptions(aViewOptions);
+        std::shared_ptr<GDIMetaFile> xMetaFile = getSwDocShell()->GetPreviewMetaFile(false, true);
+        MetafileXmlDump aDumper;
+        xmlDocUniquePtr pXmlDoc = dumpAndParse(aDumper, *xMetaFile);
+        int nRects = countXPathNodes(pXmlDoc, "//rect");
+        dispose(); // the next count loads its own document
+        return nRects;
+    };
+    // A no-break space and a non-breaking hyphen, and the same text with a space and a hyphen.
+    static constexpr OUString aHard = u"a b‑c"_ustr;
+    static constexpr OUString aPlain = u"a b-c"_ustr;
+
+    // Without the fix in place, this failed: each of the two characters had a gray rectangle
+    // (the field shading) while formatting marks were hidden, which Word never shows.
+    CPPUNIT_ASSERT_EQUAL(aRectCount(aPlain, false), aRectCount(aHard, false));
+    // With formatting marks shown they keep their shading.
+    CPPUNIT_ASSERT_GREATER(aRectCount(aPlain, true), aRectCount(aHard, true));
+}
+
 CPPUNIT_PLUGIN_IMPLEMENT();
 
