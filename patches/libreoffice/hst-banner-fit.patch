+// HST Office: the page stops before the banner's room (HstLayoutBanner), and with gtk and qt only the page paints the
+// ribbon's body (the native tab body, the window colour), so the room beside it showed the tab control's dialog
+// colour: a step after the last group, with the banner on another surface. The room is painted as the body; the
+// other toolkits' tab control paints the whole panel itself already (TabControl::Paint), in the same colour.
+void NotebookbarTabControl::Paint(vcl::RenderContext& rRenderContext, const tools::Rectangle& rRect)
+{
+    NotebookbarTabControlBase::Paint(rRenderContext, rRect);
+    TabPage* pPage = GetTabPage(GetCurPageId());
+    if (!m_pHstBanner || !pPage || !pPage->IsVisible() || pPage->GetSizePixel().Height() <= 0)
+        return;
+    const tools::Rectangle aPage(pPage->GetPosPixel(), pPage->GetSizePixel());
+    const tools::Rectangle aBeside(Point(aPage.Right() + 1, aPage.Top()),
+                                   Point(GetOutputSizePixel().Width() - 1, aPage.Bottom()));
+    if (aBeside.IsEmpty() || aBeside.Left() > aBeside.Right())
+        return;
+    rRenderContext.Push(vcl::PushFlags::LINECOLOR | vcl::PushFlags::FILLCOLOR);
+    rRenderContext.SetLineColor();
+    rRenderContext.SetFillColor(rRenderContext.GetSettings().GetStyleSettings().GetWindowColor());
+    rRenderContext.DrawRect(aBeside);
+    rRenderContext.Pop();
+}
