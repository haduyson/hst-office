+/** Width in px of artwork nArtW x nArtH drawn nHeight px high (0 for an empty artwork). */
+inline long widthForHeight(long nHeight, long nArtW, long nArtH)
+{
+    return nArtW > 0 && nArtH > 0 && nHeight > 0 ? std::lround(double(nHeight) * nArtW / nArtH) : 0;
+}
+
+/** Height in px of artwork nArtW x nArtH drawn nWidth px wide (0 for an empty artwork). */
+inline long heightForWidth(long nWidth, long nArtW, long nArtH)
+{
+    return nArtW > 0 && nArtH > 0 && nWidth > 0 ? std::lround(double(nWidth) * nArtH / nArtW) : 0;
+}
+
+/** HST Office: the banner's own slot inside the room a host gives it: exactly the artwork at the room's full height
+    (or at its full width when the artwork is too wide for it, then centred vertically), at the room's left or right
+    edge. The rest of the room is the host's own background: no letterbox, no filler band. */
+inline Rect snugSlot(const Rect& rRoom, long nArtW, long nArtH, bool bAnchorLeft)
+{
+    if (rRoom.w <= 0 || rRoom.h <= 0 || nArtW <= 0 || nArtH <= 0)
+        return Rect{ rRoom.x, rRoom.y, 0, 0 };
+    long nW = widthForHeight(rRoom.h, nArtW, nArtH);
+    long nH = rRoom.h;
+    if (nW > rRoom.w)
+    {
+        nW = rRoom.w;
+        nH = std::min(rRoom.h, heightForWidth(nW, nArtW, nArtH));
+    }
+    return Rect{ bAnchorLeft ? rRoom.x : rRoom.x + rRoom.w - nW, rRoom.y + (rRoom.h - nH) / 2, nW, nH };
+}
+
+/** Where artwork nArtW x nArtH is painted in an output of nOutW x nOutH px: the whole output, edge to edge, when the
+    output has the artwork's ratio (a slot sized by widthForHeight, heightForWidth or snugSlot, within a pixel of
+    rounding); otherwise aspect-fitted and centred (only until the host sized the slot for a new artwork). */
+inline Rect artRect(long nOutW, long nOutH, long nArtW, long nArtH)
+{
+    const Rect aAll{ 0, 0, nOutW, nOutH };
+    if (nOutW <= 0 || nOutH <= 0 || nArtW <= 0 || nArtH <= 0)
+        return Rect{ 0, 0, 0, 0 };
+    // the output was sized from one side (rounded): the other side is the artwork's within a pixel
+    if (std::abs(heightForWidth(nOutW, nArtW, nArtH) - nOutH) <= 1
+        || std::abs(widthForHeight(nOutH, nArtW, nArtH) - nOutW) <= 1)
+        return aAll;
+    return fit(aAll, nArtW, nArtH);
+}
+
 /** Artwork variant (1, 2 or 3) for an image drawn nDeviceHeight device pixels high: the exact
     variant when the size matches one, else the next larger one so that it is only ever
     downscaled (high quality) and never upscaled. */
