+void HstBannerWidget::RequestHeight()
+{
+    // the drawing area asks for the artwork's height at the width it was given, so the artwork fills it edge to
+    // edge; the width request stays the minimum, the host decides the width
+    weld::DrawingArea* pArea = GetDrawingArea();
+    const tools::Long nWidth = GetOutputSizePixel().Width();
+    if (!pArea || nWidth <= 0)
+        return;
+    const tools::Long nHeight = HeightForWidth(nWidth);
+    if (nHeight > 0 && nHeight != GetOutputSizePixel().Height())
+        pArea->set_size_request(MinimumSize(mpView->BannerDpi()).Width(), nHeight);
