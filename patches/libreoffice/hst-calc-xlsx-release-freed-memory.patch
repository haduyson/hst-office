@@ -416,6 +417,32 @@ CPPUNIT_TEST_FIXTURE(ScExportTest6, testXlsxPackedFormulaCellsWriteTheSameSheet)
     assertXPath(pSheet, "/x:worksheet/x:sheetData/x:row[3]/x:c[@r='F3']", "t", u"e");
 }
 
+CPPUNIT_TEST_FIXTURE(ScExportTest6, testXlsxImportAndExportReleaseFreedMemory)
+{
+    // After an .xlsx import or export the freed temporaries are given back to the system (glibc only); the
+    // environment variable switches it off. The documents are the same either way.
+    osl_setEnvironment(u"HST_SC_XLSX_TRIM_OFF"_ustr.pData, u"1"_ustr.pData);
+    CPPUNIT_ASSERT(!HstReleaseFreedMemory());
+    osl_clearEnvironment(u"HST_SC_XLSX_TRIM_OFF"_ustr.pData);
+#if defined(__GLIBC__)
+    CPPUNIT_ASSERT(HstReleaseFreedMemory());
+#else
+    CPPUNIT_ASSERT(!HstReleaseFreedMemory());
+#endif
+
+    createScDoc();
+    ScDocument* pDoc = getScDoc();
+    for (SCROW nRow = 0; nRow < 200; ++nRow)
+    {
+        pDoc->SetValue(ScAddress(0, nRow, 0), nRow);
+        pDoc->SetString(ScAddress(1, nRow, 0), u"=A"_ustr + OUString::number(nRow + 1) + u"*2"_ustr);
+    }
+    saveAndReload(TestFilter::XLSX);
+    pDoc = getScDoc();
+    CPPUNIT_ASSERT_EQUAL(398.0, pDoc->GetValue(ScAddress(1, 199, 0)));
+    CPPUNIT_ASSERT_EQUAL(u"=A200*2"_ustr, pDoc->GetFormula(1, 199, 0));
+}
+
 CPPUNIT_PLUGIN_IMPLEMENT();
 
