--- /dev/null
+++ b/sc/source/filter/inc/hstreleasefreedmemory.hxx
@@ -0,0 +1,39 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ * Copyright (c) HST Office.
+ */
+
+#pragma once
+
+#include <cstdlib>
+
+#if defined(__GLIBC__)
+#include <malloc.h>
+#endif
+
+/** Gives the memory that an .xlsx import or export freed back to the system (glibc only).
+
+    Importing a workbook allocates and frees many short-lived objects (parsed cell values, shared strings, formula
+    texts and token arrays, styles) between the long-lived cells of the document. glibc keeps the freed space in its
+    heaps for later allocations instead of returning it: after opening a 50 MB workbook of formulas about 250 MB of
+    the process's resident memory was such free space (1.70 GB anonymous memory after the open, 1.45 GB after
+    malloc_trim), and for a 200 MB workbook about four times that, which left too little of 8 GB to save it.
+    malloc_trim(0) returns free pages at the top of the heaps and inside them (madvise), without moving anything.
+    The allocator stays the same; only how much of its free space stays resident changes.
+
+    Not available on other C libraries (Windows returns free pages of its heaps by itself), where this does nothing.
+    The environment variable HST_SC_XLSX_TRIM_OFF disables it. Returns true when the memory was trimmed. */
+inline bool HstReleaseFreedMemory()
+{
+#if defined(__GLIBC__)
+    if (std::getenv("HST_SC_XLSX_TRIM_OFF"))
+        return false;
+    malloc_trim(0);
+    return true;
+#else
+    return false;
+#endif
+}
+
