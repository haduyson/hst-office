+bool ModelData_Impl::ConfirmHstFormat( const OUString& rFilter )
+{
+    // HST: the bundled extension may ask the user before a format that loses part of the document (Sheets cells that
+    // use HST functions, in an Excel file); it may convert those cells for the saved copy. Optional service: when it
+    // is missing or fails, the document is stored as before. API saves, hidden documents and headless runs are skipped.
+    if ( rFilter.isEmpty() || Application::IsHeadlessModeEnabled() || comphelper::LibreOfficeKit::isActive()
+         || GetDocProps().getUnpackedValueOrDefault( u"Hidden"_ustr, false ) )
+        return true;
+    try
+    {
+        uno::Reference< task::XJob > xCheck(
+            comphelper::getProcessServiceFactory()->createInstance( u"org.hst.office.vi.SaveFormatCheck"_ustr ), uno::UNO_QUERY );
+        if ( !xCheck.is() )
+            return true;
+        bool bProceed = true;
+        xCheck->execute( { { u"Model"_ustr, uno::Any( m_xModel ) }, { u"FilterName"_ustr, uno::Any( rFilter ) } } ) >>= bProceed;
+        return bProceed;
+    }
+    catch ( const uno::Exception& )
+    {
+        TOOLS_WARN_EXCEPTION( "sfx.doc", "HST save format check failed; saving anyway" );
+        return true;
+    }
+}
