+/// HST Office: a toolbox of large buttons in a View tab's Zoom group (Zoom, 100%, Zoom to Selection, Fit to
+/// Window): it keeps its large labelled buttons at every width, as Paste does and as in Office (gap list G10)
+bool inZoomGroup(const ToolBox& rToolBox)
+{
+    for (const vcl::Window* pWindow = rToolBox.GetParent(); pWindow; pWindow = pWindow->GetParent())
+        if (pWindow->get_id() == u"gdViewZoom")
+            return true;
+    return false;
+}
+
 /// HST Office: the number of commands (separators aside) of a toolbox; -1 when one of them is drawn as a
 /// control (font name, find box, gallery), whose group never counts as a group of few commands
 int commandCount(const ToolBox& rToolBox)
@@ -71,7 +81,9 @@
         rData.meHstAuthoredType = rToolBox.GetButtonType();
         rData.meHstAuthoredSize = rToolBox.GetToolboxButtonSize();
         rData.meHstAuthoredTextPosition = rData.meHstTextPosition;
-        rData.mbHstKeepLarge = holdsPaste(rToolBox); // Paste stays large, as in Office
+        // Paste, and the Zoom group's large buttons, stay large with their labels, as in Office
+        rData.mbHstKeepLarge = holdsPaste(rToolBox)
+                               || (rData.meHstAuthoredSize == ToolBoxButtonSize::Large && inZoomGroup(rToolBox));
     }
