+void PdfViewerWindow::setToolbarLevel(int nLevel)
+{
+    if (nLevel == m_nToolbarLevel)
+        return;
+    m_nToolbarLevel = nLevel;
+    m_xSearch->set_width_chars(SEARCH_WIDTH_CHARS[nLevel]);
+    const bool bIcons = nLevel >= TOOLBAR_LEVEL_ICONS;
+    for (const auto& [pButton, rLabel] : m_aCompactButtons)
+        pButton->set_label(bIcons ? OUString() : rLabel);
+    m_xPageLabel->set_visible(nLevel < TOOLBAR_LEVEL_NO_PAGE_LABEL);
+}
+
+void PdfViewerWindow::fitToolbar()
+{
+    const tools::Long nAvailable = GetSizePixel().Width();
+    if (nAvailable <= 0 || !m_xToolbar || !m_xMenu) // not built yet, or disposed
+        return;
+    // the widest toolbar that fits; the last level when none does (the window has a minimum)
+    for (int nLevel = 0; nLevel < TOOLBAR_LEVELS; ++nLevel)
+    {
+        setToolbarLevel(nLevel);
+        if (m_xToolbar->get_preferred_size().Width() + TOOLBAR_MARGINS <= nAvailable)
+            return;
+    }
+}
