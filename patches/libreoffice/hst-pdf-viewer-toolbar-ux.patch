+basegfx::B2DSize PdfPageView::viewPageSize(int nPage) const
+{
+    const basegfx::B2DSize aSize = m_pDocument->getPageSize(nPage);
+    return m_nRotation % 2 ? basegfx::B2DSize(aSize.getHeight(), aSize.getWidth()) : aSize;
+}
+
+void PdfPageView::updateMaxViewWidth()
+{
+    m_fMaxViewWidth = 0.0;
+    if (!m_pDocument)
+        return;
+    if (m_nRotation % 2 == 0)
+    {
+        m_fMaxViewWidth = m_pDocument->getMaxPageWidth();
+        return;
+    }
+    for (int i = 0; i < m_pDocument->getPageCount(); ++i)
+        m_fMaxViewWidth = std::max(m_fMaxViewWidth, m_pDocument->getPageSize(i).getHeight());
+}
+
+basegfx::B2DPoint PdfPageView::toViewPoint(int nPage, const basegfx::B2DPoint& rPagePoint) const
+{
+    const basegfx::B2DSize aSize = m_pDocument->getPageSize(nPage);
+    const double fX = rPagePoint.getX(), fY = rPagePoint.getY();
+    switch (m_nRotation)
+    {
+        case 1: return basegfx::B2DPoint(aSize.getHeight() - fY, fX);
+        case 2: return basegfx::B2DPoint(aSize.getWidth() - fX, aSize.getHeight() - fY);
+        case 3: return basegfx::B2DPoint(fY, aSize.getWidth() - fX);
+        default: return rPagePoint;
+    }
+}
+
+basegfx::B2DPoint PdfPageView::fromViewPoint(int nPage, const basegfx::B2DPoint& rViewPoint) const
+{
+    const basegfx::B2DSize aSize = m_pDocument->getPageSize(nPage);
+    const double fX = rViewPoint.getX(), fY = rViewPoint.getY();
+    switch (m_nRotation)
+    {
+        case 1: return basegfx::B2DPoint(fY, aSize.getHeight() - fX);
+        case 2: return basegfx::B2DPoint(aSize.getWidth() - fX, aSize.getHeight() - fY);
+        case 3: return basegfx::B2DPoint(aSize.getWidth() - fY, fX);
+        default: return rViewPoint;
+    }
+}
+
+void PdfPageView::setRotation(int nQuarterTurns)
