+bool PdfViewerWindow::saveCopy(const OUString& rTargetURL)
+{
+    if (!m_xDocument)
+        return false;
+    OUString aTarget = rTargetURL;
+    if (aTarget.isEmpty())
+    {
+        // the dialog proposes the same name in the folder of the original
+        sfx2::FileDialogHelper aDialog(ui::dialogs::TemplateDescription::FILESAVE_AUTOEXTENSION,
+                                       FileDialogFlags::NONE, GetFrameWeld());
+        aDialog.SetTitle(XsResId(STR_HSTPDF_SAVE_COPY_TITLE));
+        aDialog.AddFilter(u"PDF"_ustr, u"*.pdf"_ustr);
+        INetURLObject aURL(m_aURL);
+        const OUString aName = aURL.getBase(INetURLObject::LAST_SEGMENT, true,
+                                            INetURLObject::DecodeMechanism::WithCharset)
+                               + ".pdf";
+        if (aURL.GetProtocol() == INetProtocol::File)
+        {
+            aURL.removeSegment();
+            aDialog.SetDisplayDirectory(aURL.GetMainURL(INetURLObject::DecodeMechanism::NONE));
+        }
+        aDialog.SetFileName(aName);
+        if (aDialog.Execute() != ERRCODE_NONE)
+            return false;
+        aTarget = aDialog.GetPath();
+    }
+    if (aTarget.isEmpty())
+        return false;
+    if (INetURLObject(aTarget) == INetURLObject(m_aURL))
+    {
+        std::unique_ptr<weld::MessageDialog> xBox(Application::CreateMessageDialog(
+            GetFrameWeld(), VclMessageType::Warning, VclButtonsType::Ok,
+            XsResId(STR_HSTPDF_COPY_SAME_FILE)));
+        xBox->run();
+        return false;
+    }
+    // the bytes of the open file as they are: an encrypted or signed PDF stays so in the copy
+    const std::vector<sal_uInt8>& rData = m_xDocument->getData();
+    bool bSaved = false;
+    {
+        weld::WaitObject aWait(GetFrameWeld());
+        std::unique_ptr<SvStream> pStream
+            = utl::UcbStreamHelper::CreateStream(aTarget, StreamMode::WRITE | StreamMode::TRUNC);
+        if (pStream)
+        {
+            bSaved = pStream->WriteBytes(rData.data(), rData.size()) == rData.size();
+            pStream->Flush();
+            bSaved = bSaved && pStream->good();
+        }
+    }
+    if (!bSaved)
+    {
+        const OUString aMessage = XsResId(STR_HSTPDF_COPY_FAILED);
+        setInfo(aMessage);
+        std::unique_ptr<weld::MessageDialog> xBox(Application::CreateMessageDialog(
+            GetFrameWeld(), VclMessageType::Error, VclButtonsType::Ok, aMessage));
+        xBox->run();
+        return false;
+    }
+    m_xStatusFind->set_label(XsResId(STR_HSTPDF_COPY_SAVED).replaceFirst(
+        "%1", INetURLObject(aTarget).GetLastName(INetURLObject::DecodeMechanism::WithCharset)));
+    return true;
+}
+
+void PdfViewerWindow::goToRelativePage(int nDelta)
+{
+    if (!m_xDocument)
+        return;
+    m_xPages->goToPage(m_xPages->getCurrentPage() + nDelta);
+    updatePageWidgets();
+}
+
+void PdfViewerWindow::rotate()
+{
+    if (!m_xDocument)
+        return;
+    const int nRotation = (m_xPages->getRotation() + 1) % 4;
+    m_xPages->setRotation(nRotation);
+    m_xThumbs->setRotation(nRotation);
+    updatePageWidgets();
+}
