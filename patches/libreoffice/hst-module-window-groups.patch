+bool DocumentTabGroup::canOpenOfficeWindow() const
+{
+    // Not while the office quits (a save query runs the event loop) or before the first window
+    // exists (a second start while the office is still starting): then the office comes to front.
+    return isEnabled() && !m_bClosingAll && !m_aGroups.empty();
+}
+
+bool DocumentTabGroup::showOfficeWindow()
+{
+    cleanUp();
+    // the HST Office window used last
+    Group* pOffice = recentGroupOfKind(OFFICE_KIND);
+    if (!pOffice)
+    {
+        // A window that only shows the Start Center is as good as an HST Office window.
+        for (const std::unique_ptr<Group>& pGroup : m_aGroups)
+            if (pGroup->aMembers.size() == 1
+                && lcl_moduleKey(lcl_get(pGroup->aMembers[0].xFrame)) == START_MODULE)
+            {
+                pOffice = pGroup.get();
+                setKind(*pOffice, OFFICE_KIND);
+                break;
+            }
+    }
+    if (!pOffice || pOffice->aMembers.empty())
+        return false;
+    const sal_uInt32 nOffice = pOffice->nId;
+    Member* pActive = activeMember(*pOffice);
+    activate(lcl_get((pActive ? *pActive : pOffice->aMembers.front()).xFrame));
+    pOffice = groupById(nOffice);
+    if (pOffice && (pActive = activeMember(*pOffice)) && pActive->pWindow
+        && !pActive->pWindow->isDisposed() && pActive->pWindow->IsSystemWindow())
+        static_cast<WorkWindow*>(pActive->pWindow.get())->ToTop(ToTopFlags::RestoreWhenMin | ToTopFlags::ForegroundTask);
+    return true;
+}
+
+bool DocumentTabGroup::hasOfficeWindow()
+{
+    cleanUp();
+    if (recentGroupOfKind(OFFICE_KIND))
+        return true;
+    for (const std::unique_ptr<Group>& pGroup : m_aGroups)
+        if (pGroup->aMembers.size() == 1
+            && lcl_moduleKey(lcl_get(pGroup->aMembers[0].xFrame)) == START_MODULE)
+            return true;
+    return false;
+}
