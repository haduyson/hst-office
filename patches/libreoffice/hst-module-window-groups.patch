+Point DocumentTabBar::ImplDragPos(const Point& rEventPos)
+{
+    // Motion outside the window is not delivered everywhere while dragging (GTK without a
+    // window manager): ask the system where the pointer is. Wayland knows the pointer only over
+    // our own surfaces: there the event position is all there is.
+    if (Application::GetPlatform() == Platform::Wayland)
+        return rEventPos;
+    return GetPointerState().maPos;
+}
+
+void DocumentTabBar::Tracking(const TrackingEvent& rTEvt)
+{
+    const Point aPos = ImplDragPos(rTEvt.GetMouseEvent().GetPosPixel());
+    if (rTEvt.IsTrackingEnded())
+    {
+        ImplEndDrag(aPos, rTEvt.IsTrackingCanceled());
+        return;
+    }
+    if (!m_bDragging)
+    {
+        const tools::Long nThreshold = Px(*this, DRAG_THRESHOLD);
+        if (std::abs(aPos.X() - m_aDragStart.X()) < nThreshold
+            && std::abs(aPos.Y() - m_aDragStart.Y()) < nThreshold)
+            return;
+        m_bDragging = true;
+    }
+    // Outside the strip (one strip height of tolerance above and below) the tab is detached.
+    const tools::Long nHeight = GetOutputSizePixel().Height();
+    const bool bInside = tools::Rectangle(Point(0, -nHeight),
+                                          Size(GetOutputSizePixel().Width(), 3 * nHeight))
+                             .Contains(aPos);
+    SetPointer(bInside ? PointerStyle::Arrow : PointerStyle::Move);
+}
+
+void DocumentTabBar::ImplEndDrag(const Point& rPos, bool bCancelled)
+{
+    css::uno::Reference<css::frame::XFrame> xFrame(m_xDragFrame);
+    m_xDragFrame.clear();
+    const bool bDragging = m_bDragging;
+    m_bDragging = false;
+    SetPointer(PointerStyle::Arrow);
+    if (!xFrame.is() || bCancelled)
+        return;
+    DocumentTabGroup& rGroup = DocumentTabGroup::get();
+    if (!bDragging)
+    {
+        if (m_bActivateOnRelease)
+            rGroup.activate(xFrame);
+        return;
+    }
+    const tools::Long nHeight = GetOutputSizePixel().Height();
+    if (tools::Rectangle(Point(0, -nHeight), Size(GetOutputSizePixel().Width(), 3 * nHeight))
+            .Contains(rPos))
+    {
+        // Within the strip: the tab moves to the place it is dropped on.
+        sal_Int32 nIndex = -1;
+        const std::vector<DocumentTabInfo> aTabs = rGroup.getTabs(m_xFrame);
+        for (size_t i = 0; i < m_aTabs.size(); ++i)
+            if (rPos.X() >= m_aTabs[i].aRect.Left() && rPos.X() <= m_aTabs[i].aRect.Right())
+                for (size_t j = 0; j < aTabs.size(); ++j)
+                    if (aTabs[j].xFrame == m_aTabs[i].aInfo.xFrame)
+                        nIndex = j;
+        if (nIndex < 0 && !m_aTabs.empty() && rPos.X() > m_aTabs.back().aRect.Right())
+            nIndex = aTabs.size() - 1;
+        if (nIndex >= 0)
+            rGroup.moveTab(xFrame, nIndex);
+        return;
+    }
+    // Outside: onto the strip of another window that takes it, else into a new window whose
+    // tab lands under the pointer (Wayland: the compositor places the window).
+    const Point aScreen(OutputToAbsoluteScreenPixel(rPos));
+    if (rGroup.mergeAt(xFrame, aScreen))
+        return;
+    // where the tab was grabbed, relative to the top-left corner of the window
+    // (the strip sits in a child of the top-level window: measure from the top-level window)
+    const vcl::Window* pTop = GetSystemWindow();
+    const Point aGrab = Point(OutputToAbsoluteScreenPixel(m_aDragStart))
+                        - (pTop ? Point(pTop->OutputToAbsoluteScreenPixel(Point()))
+                                : Point(OutputToAbsoluteScreenPixel(Point())));
+    rGroup.detach(xFrame, Point(aScreen.X() - aGrab.X(), aScreen.Y() - aGrab.Y()));
+}
+
+void DocumentTabBar::Command(const CommandEvent& rCEvt)
+{
+    if (rCEvt.GetCommand() != CommandEventId::ContextMenu)
+    {
+        vcl::Window::Command(rCEvt);
+        return;
+    }
+    // the tab under the pointer, or the shown tab (context menu key)
+    Point aPos = rCEvt.GetMousePosPixel();
+    sal_Int32 nTab = rCEvt.IsMouseEvent() ? ImplHitTab(aPos, nullptr) : -1;
+    if (!rCEvt.IsMouseEvent())
+        for (size_t i = 0; i < m_aTabs.size(); ++i)
+            if (m_aTabs[i].aInfo.bActive)
+            {
+                nTab = i;
+                aPos = m_aTabs[i].aRect.Center();
+            }
+    if (nTab < 0)
+    {
+        vcl::Window::Command(rCEvt);
+        return;
+    }
+    const css::uno::Reference<css::frame::XFrame> xTarget = m_aTabs[nTab].aInfo.xFrame;
+    VclPtrInstance<PopupMenu> aMenu;
+    aMenu->InsertItem(MENU_DETACH, FwkResId(STR_DOCTAB_DETACH));
+    aMenu->EnableItem(MENU_DETACH, DocumentTabGroup::get().canDetach(xTarget));
+    const sal_uInt16 nId = aMenu->Execute(this, tools::Rectangle(aPos, Size(1, 1)));
+    aMenu.disposeAndClear();
+    if (nId == MENU_DETACH)
+        DocumentTabGroup::get().detach(xTarget);
+}
