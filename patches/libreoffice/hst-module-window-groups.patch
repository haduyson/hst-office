+    const uno::WeakReference<frame::XFrame> xNext = rNext.xFrame;
+    VclPtr<vcl::Window> pNextWindow = rNext.pWindow;
+    rGroup.xActive = xNext;
+    InternalShow aInternal(m_nInternal);
+    pNextWindow->Show(true, ShowFlags::NoActivate);
+    return aMember;
