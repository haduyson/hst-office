+void DocumentTabGroup::moveTab(const uno::Reference<frame::XFrame>& xFrame, sal_Int32 nIndex)
+{
+    cleanUp(); // the index counts the live tabs of getTabs()
+    Group* pGroup = nullptr;
+    Member* pMember = find(xFrame, &pGroup);
+    if (!pMember)
+        return;
+    const sal_Int32 nCount = pGroup->aMembers.size();
+    const sal_Int32 nFrom = pMember - pGroup->aMembers.data();
+    const sal_Int32 nTo = std::clamp<sal_Int32>(nIndex, 0, nCount - 1);
+    if (nFrom == nTo)
+        return;
+    auto aBegin = pGroup->aMembers.begin();
+    if (nFrom < nTo)
+        std::rotate(aBegin + nFrom, aBegin + nFrom + 1, aBegin + nTo + 1);
+    else
+        std::rotate(aBegin + nTo, aBegin + nFrom, aBegin + nFrom + 1);
+    documentEvent();
+}
