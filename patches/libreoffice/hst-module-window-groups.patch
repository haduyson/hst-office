+/// One field of a line of the layout file (tabs and line breaks are separators).
+OString lcl_field(const OUString& rText)
+{
+    return OUStringToOString(rText.replace('\t', ' ').replace('\n', ' ').replace('\r', ' '),
+                             RTL_TEXTENCODING_UTF8);
+}
+
+OUString lcl_documentURL(const uno::Reference<frame::XFrame>& xFrame)
+{
+    try
+    {
+        uno::Reference<frame::XModel> xModel = lcl_model(xFrame);
+        return xModel.is() ? xModel->getURL() : OUString();
