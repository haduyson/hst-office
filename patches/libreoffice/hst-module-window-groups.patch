+bool DocumentTabGroup::mergeAt(const uno::Reference<frame::XFrame>& xFrame, const Point& rScreenPos)
+{
+    try
+    {
+        // Wayland does not tell where a window is: a drop cannot be matched to another window.
+        if (Application::GetPlatform() == Platform::Wayland)
+            return false;
+        Group* pSource = nullptr;
+        Member* pMember = find(xFrame, &pSource);
+        if (!pMember || groupIsFullScreen(*pSource))
+            return false;
+        // A drop over the window the tab comes from is no drop on a window behind it.
+        if (Member* pShown = activeMember(*pSource); pShown && pShown->pWindow
+            && !pShown->pWindow->isDisposed()
+            && tools::Rectangle(Point(pShown->pWindow->OutputToAbsoluteScreenPixel(Point())),
+                                pShown->pWindow->GetOutputSizePixel())
+                   .Contains(rScreenPos))
+            return false;
+        const OUString aModule = lcl_moduleKey(xFrame);
+        for (const std::unique_ptr<Group>& pGroup : m_aGroups)
+        {
+            if (pGroup.get() == pSource)
+                continue;
+            Member* pTarget = activeMember(*pGroup);
+            if (!pTarget || !pTarget->pBar || pTarget->pBar->isDisposed()
+                || !pTarget->pBar->IsReallyVisible())
+                continue;
+            const tools::Rectangle aStrip(Point(pTarget->pBar->OutputToAbsoluteScreenPixel(Point())),
+                                          pTarget->pBar->GetOutputSizePixel());
+            if (!aStrip.Contains(rScreenPos))
+                continue;
+            if (!accepts(*pGroup, aModule) || groupIsFullScreen(*pGroup))
+                return false;
+            // Leave the source window (its neighbour is shown), become the shown tab here.
+            const sal_uInt32 nSource = pSource->nId;
+            Member aMoved = takeOut(*pSource, pMember - pSource->aMembers.data());
+            Group& rTarget = *pGroup;
+            const uno::Reference<frame::XFrame> xPrevious = lcl_get(rTarget.xActive);
+            VclPtr<vcl::Window> pPreviousWindow = pTarget->pWindow;
+            auto it = rTarget.aMembers.begin() + (pTarget - rTarget.aMembers.data()) + 1;
+            aMoved.bParked = false;
+            rTarget.aMembers.insert(it, aMoved);
+            hst_vcl_set_tab_group(aMoved.pWindow, rTarget.nId);
+            copyGeometry(pPreviousWindow, aMoved.pWindow);
+            const sal_uInt32 nTarget = rTarget.nId;
+            rTarget.xActive = xFrame;
+            m_nRecentGroup = nTarget;
+            {
+                InternalShow aInternal(m_nInternal);
+                aMoved.pWindow->Show(true, ShowFlags::ForegroundTask);
+            }
+            if (Member* pOld = find(xPrevious))
+                park(*pOld);
+            focus(xFrame);
+            lcl_updateApplicationID(xFrame);
+            cleanUp(); // the source window may have had this tab only
+            if (Group* pGroup2 = groupById(nSource))
+                update(*pGroup2);
+            if (Group* pGroup2 = groupById(nTarget))
+                update(*pGroup2);
+            return true;
+        }
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("fwk", "DocumentTabGroup: merge");
+    }
+    return false;
+}
