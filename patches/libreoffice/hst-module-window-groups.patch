+
+void DocumentTabGroup::detach(const uno::Reference<frame::XFrame>& xFrame,
+                              const std::optional<Point>& rTopLeft)
+{
+    try
+    {
+        if (!canDetach(xFrame))
+            return;
+        Group* pSource = nullptr;
+        Member* pMember = find(xFrame, &pSource);
+        Member* pShown = activeMember(*pSource);
+        VclPtr<vcl::Window> pSourceWindow = pShown ? pShown->pWindow : pMember->pWindow;
+        // computed before anything moves: the size the window has when not maximized
+        const OUString aState = lcl_detachedState(pSourceWindow, rTopLeft);
+        const sal_uInt32 nSource = pSource->nId;
+        Member aMoved = takeOut(*pSource, pMember - pSource->aMembers.data());
+        // A tab of an HST Office window becomes an HST Office window, a tab of HST Writer a
+        // window of HST Writer.
+        Group& rTarget = newGroup(pSource->aKind);
+        aMoved.bParked = false;
+        rTarget.aMembers.push_back(aMoved);
+        rTarget.xActive = xFrame;
+        hst_vcl_set_tab_group(aMoved.pWindow, rTarget.nId);
+        const sal_uInt32 nTarget = rTarget.nId;
+        {
+            InternalShow aInternal(m_nInternal);
+            auto* pMovedWindow = static_cast<SystemWindow*>(aMoved.pWindow.get());
+            if (!aState.isEmpty())
+                pMovedWindow->SetWindowState(aState);
+            aMoved.pWindow->Show(true, ShowFlags::ForegroundTask);
+            // GTK places a window that was hidden (a parked tab) where it was last shown: set the
+            // position again once it is mapped.
+            if (!aState.isEmpty() && !pMovedWindow->isDisposed())
+                pMovedWindow->SetWindowState(aState);
+        }
+        focus(xFrame);
+        if (Group* pGroup = groupById(nSource))
+            update(*pGroup);
+        if (Group* pGroup = groupById(nTarget))
+            update(*pGroup);
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("fwk", "DocumentTabGroup: detach");
+    }
+}
