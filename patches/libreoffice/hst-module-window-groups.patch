+IMPL_LINK_NOARG(DocumentTabGroup, SaveLayoutHdl, Timer*, void) { saveLayout(); }
+
+void DocumentTabGroup::saveLayout()
+{
+    // Format, one line each (UTF-8, fields separated by tabs):
+    //   HST-DOCUMENT-TABS 1
+    //   window <kind> <index of the shown tab> <vcl window state>
+    //   tab <document URL, empty for a new document> <title>
+    // Only tabs with a document (the ones autorecovery can bring back) are written.
+    try
+    {
+        cleanUp();
+        OStringBuffer aText("HST-DOCUMENT-TABS 1\n");
+        bool bAny = false;
+        for (const std::unique_ptr<Group>& pGroup : m_aGroups)
+        {
+            OStringBuffer aTabs;
+            sal_Int32 nTabs = 0;
+            sal_Int32 nActive = 0;
+            Member* pActive = activeMember(*pGroup);
+            for (const Member& rMember : pGroup->aMembers)
+            {
+                const uno::Reference<frame::XFrame> xFrame = lcl_get(rMember.xFrame);
+                if (!lcl_model(xFrame).is())
+                    continue;
+                if (pActive == &rMember)
+                    nActive = nTabs;
+                aTabs.append("tab\t" + lcl_field(lcl_documentURL(xFrame)) + "\t"
+                             + lcl_field(lcl_title(xFrame)) + "\n");
+                ++nTabs;
+            }
+            if (!nTabs)
+                continue;
+            OUString aState;
+            if (pActive && pActive->pWindow && !pActive->pWindow->isDisposed()
+                && pActive->pWindow->IsSystemWindow())
+                aState = static_cast<SystemWindow*>(pActive->pWindow.get())->GetWindowState();
+            aText.append("window\t" + lcl_field(pGroup->aKind) + "\t" + OString::number(nActive)
+                         + "\t" + lcl_field(aState) + "\n" + aTabs);
+            bAny = true;
+        }
+        const OUString aURL = lcl_layoutURL();
+        if (!bAny)
+        {
+            osl::File::remove(aURL);
+            return;
+        }
+        const OUString aPath = lcl_layoutPath();
+        if (aPath.isEmpty())
+            return;
+        // the backup folder exists only once autorecovery has saved something
+        const osl::FileBase::RC eDir = osl::Directory::createPath(SvtPathOptions().GetBackupPath());
+        if (eDir != osl::FileBase::E_None && eDir != osl::FileBase::E_EXIST)
+            return;
+        SvFileStream aStream(aPath, StreamMode::WRITE | StreamMode::TRUNC);
+        aStream.WriteBytes(aText.getStr(), aText.getLength());
+        aStream.Close();
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("fwk", "DocumentTabGroup: save layout");
+    }
+}
+
+void DocumentTabGroup::beginRestoreLayout()
+{
+    m_aRestore.clear();
+    const OUString aPath = lcl_layoutPath();
+    if (aPath.isEmpty())
+        return;
+    SvFileStream aStream(aPath, StreamMode::READ);
+    if (!aStream.IsOpen())
+        return; // no saved layout (an older crash): documents are routed as usual
+    OStringBuffer aLine;
+    if (!aStream.ReadLine(aLine) || std::string_view(aLine) != "HST-DOCUMENT-TABS 1")
+        return;
+    while (aStream.ReadLine(aLine))
+    {
+        const OUString aText = OStringToOUString(aLine, RTL_TEXTENCODING_UTF8);
+        sal_Int32 nIndex = 0;
+        const std::u16string_view aType = o3tl::getToken(aText, 0, '\t', nIndex);
+        if (aType == u"window")
+        {
+            LayoutWindow aWindow;
+            aWindow.aKind = OUString(o3tl::getToken(aText, 0, '\t', nIndex));
+            aWindow.nActive = o3tl::toInt32(o3tl::getToken(aText, 0, '\t', nIndex));
+            if (nIndex >= 0)
+                aWindow.aState = OUString(o3tl::getToken(aText, 0, '\t', nIndex));
+            if (!aWindow.aKind.isEmpty())
+                m_aRestore.push_back(aWindow);
+        }
+        else if (aType == u"tab" && !m_aRestore.empty())
+        {
+            OUString aURL(o3tl::getToken(aText, 0, '\t', nIndex));
+            OUString aTitle = nIndex >= 0 ? OUString(o3tl::getToken(aText, 0, '\t', nIndex)) : OUString();
+            m_aRestore.back().aTabs.emplace_back(aURL, aTitle);
+            m_aRestore.back().aUsed.push_back(false);
+        }
+    }
+    // Recovery that never shows its documents (cancelled) must not keep the layout forever.
+    m_aFinishRestoreTimer.SetTimeout(120000);
+    m_aFinishRestoreTimer.Start();
+}
+
+DocumentTabGroup::Group*
+DocumentTabGroup::restoreGroupFor(const uno::Reference<frame::XFrame>& xFrame, sal_Int32& rOrder)
+{
+    if (m_aRestore.empty() || !lcl_model(xFrame).is())
+        return nullptr;
+    const OUString aURL = lcl_documentURL(xFrame);
+    const OUString aTitle = lcl_title(xFrame);
+    bool bAllUsed = true;
+    Group* pFound = nullptr;
+    for (LayoutWindow& rWindow : m_aRestore)
+    {
+        for (size_t i = 0; i < rWindow.aTabs.size(); ++i)
+        {
+            if (rWindow.aUsed[i])
+                continue;
+            const auto& [aTabURL, aTabTitle] = rWindow.aTabs[i];
+            if (pFound || !(aTabURL.isEmpty() ? aTabTitle == aTitle : aTabURL == aURL))
+            {
+                bAllUsed = false;
+                continue;
+            }
+            rWindow.aUsed[i] = true;
+            rOrder = i;
+            pFound = groupById(rWindow.nGroup);
+            if (!pFound)
+            {
+                // the first document of a window: the window with its kind and geometry
+                pFound = &newGroup(rWindow.aKind);
+                rWindow.nGroup = pFound->nId;
+                VclPtr<vcl::Window> pWindow = VCLUnoHelper::GetWindow(xFrame->getContainerWindow());
+                if (pWindow && !pWindow->IsVisible() && pWindow->IsSystemWindow()
+                    && !rWindow.aState.isEmpty())
+                    static_cast<SystemWindow*>(pWindow.get())->SetWindowState(rWindow.aState);
+            }
+        }
+    }
+    if (pFound && bAllUsed)
+    {
+        // every saved tab is back: order the tabs and show the saved ones once the events settle
+        m_aFinishRestoreTimer.SetTimeout(500);
+        m_aFinishRestoreTimer.Start();
+    }
+    return pFound;
+}
+
+void DocumentTabGroup::endRestoreLayout()
+{
+    if (m_aRestore.empty())
+        return;
+    // The recovered documents are shown by now (or right after): finish shortly.
+    m_aFinishRestoreTimer.SetTimeout(10000);
+    m_aFinishRestoreTimer.Start();
+}
+
+IMPL_LINK_NOARG(DocumentTabGroup, FinishRestoreHdl, Timer*, void) { finishRestore(); }
+
+void DocumentTabGroup::finishRestore()
+{
+    std::vector<LayoutWindow> aRestore;
+    aRestore.swap(m_aRestore);
+    for (const LayoutWindow& rWindow : aRestore)
+    {
+        Group* pGroup = groupById(rWindow.nGroup);
+        if (!pGroup)
+            continue;
+        // the saved tab order; tabs that joined otherwise stay behind them
+        std::stable_sort(pGroup->aMembers.begin(), pGroup->aMembers.end(),
+                         [](const Member& rA, const Member& rB) {
+                             const sal_Int32 nA = rA.nRestoreOrder < 0 ? SAL_MAX_INT32 : rA.nRestoreOrder;
+                             const sal_Int32 nB = rB.nRestoreOrder < 0 ? SAL_MAX_INT32 : rB.nRestoreOrder;
+                             return nA < nB;
+                         });
+        uno::Reference<frame::XFrame> xShown;
+        for (Member& rMember : pGroup->aMembers)
+        {
+            if (rMember.nRestoreOrder == rWindow.nActive)
+                xShown = lcl_get(rMember.xFrame);
+            rMember.nRestoreOrder = -1;
+        }
+        const sal_uInt32 nGroup = pGroup->nId;
+        if (xShown.is())
+            activate(xShown);
+        if ((pGroup = groupById(nGroup)))
+            update(*pGroup);
+    }
+    scheduleLayoutSave();
+}
