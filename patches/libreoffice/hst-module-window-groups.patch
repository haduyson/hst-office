+/** HST Office: the document tab window of a frame that is about to be shown depends on where
+    its document comes from (see documenttabgroup.hxx). Requests of the command line and of a
+    second office (launchers, file manager, HST PDF) come from DispatchWatcher, which marks them
+    with the Referer private:OpenEvent. Before loading, the frame has no component yet: the
+    module is known from the URL and the type detection. */
+void lcl_prepareDocumentTab(const css::uno::Reference<css::frame::XFrame>& xFrame,
+                            const OUString& rURL, const comphelper::SequenceAsHashMap& rDescriptor)
+{
+    SolarMutexGuard aGuard;
+    if (!DocumentTabGroup::isEnabled())
+        return;
+    DocumentTabGroup::ShowOrigin aOrigin;
+    aOrigin.bExternal = rDescriptor.getUnpackedValueOrDefault(utl::MediaDescriptor::PROP_REFERRER,
+                                                               OUString()) == "private:OpenEvent";
+    const OUString aType
+        = rDescriptor.getUnpackedValueOrDefault(utl::MediaDescriptor::PROP_TYPENAME, OUString());
+    if (aType == "pdf_Portable_Document_Format"
+        && !rDescriptor.contains(utl::MediaDescriptor::PROP_DOCUMENTSERVICE)
+        && !rDescriptor.contains(u"HSTPdfOpenInDraw"_ustr))
+        aOrigin.aModule = u"pdf"_ustr; // HST PDF (it hands over to Draw for hybrid files)
+    else
+    {
+        switch (SvtModuleOptions::ClassifyFactoryByURL(rURL, rDescriptor.getAsConstPropertyValueList()))
+        {
+            case SvtModuleOptions::EFactory::WRITER:
+            case SvtModuleOptions::EFactory::WRITERWEB:
+            case SvtModuleOptions::EFactory::WRITERGLOBAL:
+                aOrigin.aModule = u"writer"_ustr;
+                break;
+            case SvtModuleOptions::EFactory::CALC:
+                aOrigin.aModule = u"calc"_ustr;
+                break;
+            case SvtModuleOptions::EFactory::IMPRESS:
+                aOrigin.aModule = u"impress"_ustr;
+                break;
+            case SvtModuleOptions::EFactory::DRAW:
+                aOrigin.aModule = u"draw"_ustr;
+                break;
+            case SvtModuleOptions::EFactory::STARTMODULE:
+                aOrigin.aModule = u"start"_ustr;
+                break;
+            default:
+                break;
+        }
+    }
+    DocumentTabGroup::get().prepareShow(xFrame, aOrigin);
+}
