+/// Module key of a module identifier: the application a window of that module belongs to.
+OUString lcl_moduleKeyOf(const OUString& rModule)
+{
+    if (rModule.startsWith("com.sun.star.text.") || rModule == "com.sun.star.xforms.XMLFormDocument")
+        return u"writer"_ustr;
+    if (rModule == "com.sun.star.sheet.SpreadsheetDocument")
+        return u"calc"_ustr;
+    if (rModule == "com.sun.star.presentation.PresentationDocument")
+        return u"impress"_ustr;
+    if (rModule == "com.sun.star.drawing.DrawingDocument")
+        return u"draw"_ustr;
+    if (rModule == "com.sun.star.frame.StartModule")
+        return START_MODULE;
+    return rModule;
+}
+
+/// Module key of the component in xFrame: "pdf" for HST PDF, "" while it has none.
+OUString lcl_moduleKey(const uno::Reference<frame::XFrame>& xFrame)
+{
+    try
+    {
+        uno::Reference<frame::XController> xController = xFrame.is() ? xFrame->getController() : nullptr;
+        if (!xController.is())
+            return {};
+        uno::Reference<lang::XServiceInfo> xInfo(xController, uno::UNO_QUERY);
+        if (xInfo.is() && xInfo->supportsService(u"org.hasontech.hstoffice.PdfViewer"_ustr))
+            return u"pdf"_ustr;
+        uno::Reference<frame::XModuleManager2> xManager
+            = frame::ModuleManager::create(comphelper::getProcessComponentContext());
+        return lcl_moduleKeyOf(xManager->identify(xFrame));
+    }
+    catch (const uno::Exception&)
+    {
+    }
+    return {};
+}
+
+/// Window state numbers "X,Y,W,H;STATE;..." of a system window (see vcl::WindowData::toStr).
+std::vector<sal_Int32> lcl_windowState(vcl::Window* pWindow, vcl::WindowDataMask nMask)
+{
+    std::vector<sal_Int32> aValues;
+    if (!pWindow || pWindow->isDisposed() || !pWindow->IsSystemWindow())
+        return aValues;
+    const OUString aState = static_cast<SystemWindow*>(pWindow)->GetWindowState(nMask);
+    sal_Int32 nIndex = 0;
+    for (int i = 0; i < 5 && nIndex >= 0; ++i)
+        aValues.push_back(o3tl::toInt32(o3tl::getToken(aState, 0, i < 3 ? ',' : ';', nIndex)));
+    return aValues;
+}
+
+/// Internal full screen (slide show, View > Full Screen) or the native full screen of macOS.
+bool lcl_isFullScreen(vcl::Window* pWindow)
+{
+    if (!pWindow || pWindow->isDisposed() || !pWindow->IsSystemWindow())
+        return false;
+    if (static_cast<WorkWindow*>(pWindow)->IsFullScreenMode())
+        return true;
+    const std::vector<sal_Int32> aState = lcl_windowState(pWindow, vcl::WindowDataMask::State);
+    return aState.size() == 5
+           && (static_cast<vcl::WindowState>(aState[4]) & vcl::WindowState::FullScreen);
+}
+
+/** Window state of a detached tab: the restored (never maximized) size of pSource, the top-left
+    corner at rTopLeft (absolute screen pixels) or cascaded from pSource. Empty when unknown. */
+OUString lcl_detachedState(vcl::Window* pSource, const std::optional<Point>& rTopLeft)
+{
+    const std::vector<sal_Int32> aState = lcl_windowState(pSource, vcl::WindowDataMask::PosSize);
+    if (aState.size() < 4 || aState[2] <= 0 || aState[3] <= 0)
+        return {};
+    const Point aPos = rTopLeft ? *rTopLeft : Point(aState[0] + 30, aState[1] + 30);
+    return OUString::number(aPos.X()) + "," + OUString::number(aPos.Y()) + ","
+           + OUString::number(aState[2]) + "," + OUString::number(aState[3]) + ";"
+           + OUString::number(static_cast<sal_Int32>(vcl::WindowState::Normal)) + ";";
+}
