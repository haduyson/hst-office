 namespace {
 
+/// HST: the add-in functions written as results, per document being saved by the GUI now (see ConfirmHstFormat)
+std::map< const SfxObjectShell*, std::vector< OUString > >& HstValueFunctions()
+{
+    static std::map< const SfxObjectShell*, std::vector< OUString > > aFunctions;
+    return aFunctions;
+}
+
+/// HST: a list of strings from the save format check (a typed sequence, or a sequence of Any from Python)
+std::vector< OUString > HstStringList( const uno::Any& rValue )
+{
+    std::vector< OUString > aList;
+    uno::Sequence< OUString > aStrings;
+    uno::Sequence< uno::Any > aAnys;
+    if ( rValue >>= aStrings )
+        aList.assign( aStrings.begin(), aStrings.end() );
+    else if ( rValue >>= aAnys )
+    {
+        for ( const uno::Any& rItem : aAnys )
+        {
+            OUString aName;
+            if ( ( rItem >>= aName ) && !aName.isEmpty() )
+                aList.push_back( aName );
+        }
+    }
+    return aList;
+}
+
+}
+
+std::vector< OUString > sfx2::GetHstValueFunctions( const SfxObjectShell& rShell )
+{
+    auto aFound = HstValueFunctions().find( &rShell );
+    return aFound == HstValueFunctions().end() ? std::vector< OUString >() : aFound->second;
+}
