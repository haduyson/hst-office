+
+class SfxObjectShell;
+
+namespace sfx2
+{
+/** The add-in functions (programmatic names, e.g. "org.hst.office.vi.CalcFunctions.docso"; compare ignoring
+    ASCII case) whose cells the save of rShell that is running now writes as their current results instead of
+    formulas. Set by the save format check of the bundled extension for that one save only; the document itself
+    keeps its formulas. Empty for every other save, including API saves. */
+SFX2_DLLPUBLIC std::vector<OUString> GetHstValueFunctions(const SfxObjectShell& rShell);
+}
