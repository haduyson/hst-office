 // Cell Table
 
+namespace {
+
+/** HST: the cell that holds the current result of rCell when its formula calls one of rFunctions (add-in names,
+    sfx2/hstsavevalues.hxx) and the result is no error; null otherwise. Only the saved file changes: the document
+    keeps its formula. An error result keeps the formula, the other application shows an error either way. */
+XclExpCellRef lclCreateHstValueCell( const XclExpRoot& rRoot, const XclAddress& rXclPos,
+        const ScPatternAttr* pPattern, sal_uInt32 nForcedXFId, ScFormulaCell& rCell,
+        const std::vector< OUString >& rFunctions )
+{
+    bool bCalls = false;
+    formula::FormulaTokenArrayPlainIterator aIter( *rCell.GetCode() );
+    for( const formula::FormulaToken* pToken = aIter.First(); pToken && !bCalls; pToken = aIter.Next() )
+        if( pToken->GetOpCode() == ocExternal && pToken->GetType() == formula::svExternal )
+        {
+            const OUString& rCalled = static_cast< const formula::FormulaExternalToken* >( pToken )->GetExternal();
+            bCalls = std::any_of( rFunctions.begin(), rFunctions.end(),
+                                  [&rCalled]( const OUString& rName ) { return rName.equalsIgnoreAsciiCase( rCalled ); } );
+        }
+    if( !bCalls || rCell.GetErrCode() != FormulaError::NONE )
+        return XclExpCellRef();
+    if( rCell.IsValue() )
+    {
+        double fValue = rCell.GetValue();
+        if( rCell.GetFormatType() == SvNumFormatType::LOGICAL && ( fValue == 0.0 || fValue == 1.0 ) )
+            return new XclExpBooleanCell( rRoot, rXclPos, pPattern, nForcedXFId, fValue != 0.0 );
+        return new XclExpNumberCell( rRoot, rXclPos, pPattern, nForcedXFId, fValue );
+    }
+    OUString aText = rCell.GetString().getString();
+    if( aText.isEmpty() )
+        return new XclExpBlankCell( rRoot, rXclPos, rXclPos.mnCol, pPattern, nForcedXFId );
+    return new XclExpLabelCell( rRoot, rXclPos, pPattern, nForcedXFId, aText );
+}
+
