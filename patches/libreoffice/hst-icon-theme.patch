+void IconThemeSelectorTest::HstAutomaticAndExplicitChoices()
+{
+    std::vector<vcl::IconThemeInfo> themes;
+    for (const auto& id : { u"colibre"_ustr, u"hst"_ustr, u"hst_dark"_ustr })
+    {
+        vcl::IconThemeInfo info;
+        info.mThemeId = id;
+        themes.push_back(info);
+    }
+    vcl::IconThemeSelector selector;
+    selector.SetPreferredIconTheme(u"colibre"_ustr, false);
+    CPPUNIT_ASSERT_EQUAL(u"hst"_ustr,
+        selector.SelectIconThemeForDesktopEnvironment(themes, DesktopType::GNOME));
+    selector.SetPreferredIconTheme(u"colibre"_ustr, true);
+    CPPUNIT_ASSERT_EQUAL(u"hst_dark"_ustr,
+        selector.SelectIconThemeForDesktopEnvironment(themes, DesktopType::GNOME));
+    // Only the name of a dark theme, without the dark flag.
+    selector.SetPreferredIconTheme(u"colibre_dark"_ustr, false);
+    CPPUNIT_ASSERT_EQUAL(u"hst_dark"_ustr,
+        selector.SelectIconThemeForDesktopEnvironment(themes, DesktopType::GNOME));
+    CPPUNIT_ASSERT_EQUAL(u"colibre"_ustr, selector.SelectIconTheme(themes, u"colibre"_ustr));
+    CPPUNIT_ASSERT_EQUAL(u"hst"_ustr, selector.SelectIconTheme(themes, u"hst"_ustr));
+    // Reduced builds without HST retain upstream desktop selection.
+    themes.erase(themes.begin() + 1, themes.end());
+    CPPUNIT_ASSERT_EQUAL(u"colibre"_ustr,
+        selector.SelectIconThemeForDesktopEnvironment(themes, DesktopType::GNOME));
+}
+
 // Put the test suite in the registry
 CPPUNIT_TEST_SUITE_REGISTRATION(IconThemeSelectorTest);
 
