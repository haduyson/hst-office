+bool ToolbarLayoutManager::implts_hstTwoRows( bool bBanner, const std::vector< SingleRowColumnWindowData >& rRows,
+                                               sal_Int32 nTopHeight, sal_Int32 nRowWidth )
+{
+    SolarMutexGuard aGuard;
+    // the only docked toolbar of the top docking area, alone in its row, horizontal and with its menu
+    VclPtr<ToolBox> pLone;
+    if ( bBanner && rRows.size() == 1 && rRows[0].aRowColumnWindows.size() == 1 )
+    {
+        VclPtr<vcl::Window> pWindow = VCLUnoHelper::GetWindow( rRows[0].aRowColumnWindows[0] );
+        if ( pWindow && !pWindow->isDisposed() && pWindow->GetType() == WindowType::TOOLBOX )
+            pLone = static_cast< ToolBox* >( pWindow.get() );
+    }
+
+    bool bChanged = false;
+    if ( m_pHstTwoRows && m_pHstTwoRows != pLone )
+    {
+        implts_hstTwoRowsOff();
+        bChanged = true;
+    }
+    if ( !pLone )
+        return bChanged;
+
+    // two rows only when they fit beside the banner in its strip; otherwise one row, as without the banner
+    pLone->HstSetBalancedLines( 2 );
+    const ::Size aTwoRows = pLone->CalcWindowSizePixel( 1, WindowAlign::Top );
+    const bool bFits = aTwoRows.Height() <= nTopHeight && aTwoRows.Width() <= nRowWidth;
+    if ( !bFits )
+    {
+        pLone->HstSetBalancedLines( 0 );
+        m_pHstTwoRows.reset();
+        return true;
+    }
+    m_pHstTwoRows = pLone;
+    return true; // the row data was measured before
+}
+
+void ToolbarLayoutManager::implts_hstTwoRowsOff()
+{
+    SolarMutexGuard aGuard;
+    if ( m_pHstTwoRows && !m_pHstTwoRows->isDisposed() )
+        m_pHstTwoRows->HstSetBalancedLines( 0 );
+    m_pHstTwoRows.reset();
+}
+
+void ToolbarLayoutManager::implts_hstTwoRowsOff( const uno::Reference< uno::XInterface >& xSource )
+{
+    SolarMutexGuard aGuard;
+    uno::Reference< awt::XWindow > xWindow( xSource, uno::UNO_QUERY );
+    if ( m_pHstTwoRows && VCLUnoHelper::GetWindow( xWindow ) == m_pHstTwoRows.get() )
+        implts_hstTwoRowsOff();
+}
