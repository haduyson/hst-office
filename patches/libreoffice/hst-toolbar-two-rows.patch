+#pragma once
+
+// HST Office: where a docked toolbar beside the window banner breaks into its second row
+// (ToolBox::HstSetBalancedLines). Plain arithmetic without LibreOffice types, so that
+// tests/unit/test_toolbar_two_rows.py can compile it from the patch with a test driver.
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdlib>
+#include <map>
+#include <vector>
+
+namespace hst::toolbar
+{
+struct RowItem
+{
+    long nWidth = 0; // px the item takes in its row
+    bool bVisible = false;
+    bool bSeparator = false;
+    bool bPlainButton = false; // an image button (no item window): the unit of "one button"
+};
+
+/** Width of the most common plain button (the tolerance of "even rows"), 0 without one. */
+inline long typicalButtonWidth(const std::vector<RowItem>& rItems)
+{
+    std::map<long, int> aCount;
+    for (const RowItem& r : rItems)
+        if (r.bVisible && r.bPlainButton && r.nWidth > 0)
+            ++aCount[r.nWidth];
+    long nWidth = 0;
+    int nMost = 0;
+    for (const auto& [nW, n] : aCount)
+        if (n > nMost)
+        {
+            nWidth = nW;
+            nMost = n;
+        }
+    return nWidth;
+}
+
+/** Index of the item that starts the second row, 0 when the items cannot be split. After a
+    separator it is the item right after the separator (visible or not), so that VCL, which draws no
+    separator before a break, leaves it out.
+
+    The rows are as even as possible. A break right after a separator (the separator is then not
+    drawn, the groups stay whole) wins whenever its rows differ by no more than one button, or by no
+    more than the evenest break at all. Of two equally even breaks the one with the longer first row
+    wins, so the top row never ends before the bottom one. A row never starts with a separator. */
+inline std::size_t balancedBreak(const std::vector<RowItem>& rItems)
+{
+    long nTotal = 0;
+    for (const RowItem& r : rItems)
+        if (r.bVisible)
+            nTotal += r.nWidth;
+
+    struct Best
+    {
+        std::size_t nIndex = 0;
+        long nDiff = -1;
+        bool bTopShorter = false;
+        void offer(std::size_t i, long nFirst, long nSecond)
+        {
+            const long d = std::labs(nFirst - nSecond);
+            const bool bShorter = nFirst < nSecond;
+            if (nDiff < 0 || d < nDiff || (d == nDiff && bTopShorter && !bShorter))
+            {
+                nIndex = i;
+                nDiff = d;
+                bTopShorter = bShorter;
+            }
+        }
+    } aAny, aGroup;
+
+    long nFirst = 0; // width of the visible items before i
+    bool bAfterSeparator = false; // the last visible item before i is a separator
+    std::size_t nSeparator = 0; // its index
+    bool bSeenButton = false; // the first row would hold something else than separators
+    for (std::size_t i = 0; i < rItems.size(); ++i)
+    {
+        const RowItem& r = rItems[i];
+        if (!r.bVisible)
+            continue;
+        if (!r.bSeparator && bSeenButton)
+        {
+            const std::size_t nBreak = bAfterSeparator ? nSeparator + 1 : i;
+            aAny.offer(nBreak, nFirst, nTotal - nFirst);
+            if (bAfterSeparator)
+                aGroup.offer(nBreak, nFirst, nTotal - nFirst);
+        }
+        nFirst += r.nWidth;
+        bAfterSeparator = r.bSeparator;
+        if (r.bSeparator)
+            nSeparator = i;
+        bSeenButton = bSeenButton || !r.bSeparator;
+    }
+
+    if (aAny.nDiff < 0)
+        return 0;
+    const long nTolerance = std::max(aAny.nDiff, typicalButtonWidth(rItems));
+    if (aGroup.nDiff >= 0 && aGroup.nDiff <= nTolerance)
+        return aGroup.nIndex;
+    return aAny.nIndex;
+}
+}
