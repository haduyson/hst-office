+void ToolBox::HstSetBalancedLines( sal_uInt16 nLines )
+{
+    nLines = nLines >= 2 ? 2 : 0; // one break: two rows
+    if ( mpData->mnHstBalancedLines == nLines )
+        return;
+    mpData->mnHstBalancedLines = nLines;
+    mbFormat = true;
+    if ( IsReallyVisible() && IsUpdateMode() )
+        Invalidate();
+}
+
+bool ToolBox::ImplHstBalanced() const
+{
+    // docked, horizontal and with the menu (the menu keeps the line breaking of the docked case)
+    return mpData->mnHstBalancedLines >= 2 && mbHorz && !ImplIsFloatingMode() && IsMenuEnabled();
+}
