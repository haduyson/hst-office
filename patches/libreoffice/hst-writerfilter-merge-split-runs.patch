+void DomainMapper_Impl::FlushPendingTextPortion()
 {
+    if (m_aPendingText.isEmpty())
+        return;
+    const OUString aText(m_aPendingText.makeStringAndClear());
+    const uno::Reference<text::XTextAppend> xTextAppend(std::move(m_xPendingTextAppend));
+    const uno::Sequence<beans::PropertyValue> aValues(std::move(m_aPendingTextProperties));
+    m_xPendingTextAppend.clear();
+    m_aPendingTextProperties = {};
+    try
+    {
+        xTextAppend->appendTextPortion(aText, aValues);
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("writerfilter", "DomainMapper_Impl::FlushPendingTextPortion");
+    }
+}
