+// HST: Application members macros read and set. The settings marked below are kept for the session and
+// have no other effect here; a macro that saves and restores them goes on working.
+
+#include "vbaapplication.hxx"
+#include <basic/sbx.hxx>
+#include <com/sun/star/ui/dialogs/ExecutableDialogResults.hpp>
+#include <com/sun/star/ui/dialogs/FilePicker.hpp>
+#include <com/sun/star/ui/dialogs/TemplateDescription.hpp>
+#include <com/sun/star/ui/dialogs/XFilePicker3.hpp>
+#include <osl/file.hxx>
+#include <osl/process.h>
+#include <rtl/bootstrap.hxx>
+#include <unotools/useroptions.hxx>
+#include <vbahelper/vbahelper.hxx>
+#include <vbahelper/vbapath.hxx>
+#include <map>
+#include "vbarange.hxx"
+
+using namespace ::ooo::vba;
+using namespace ::com::sun::star;
+
+namespace
+{
+std::map<OUString, uno::Any>& settings()
+{
+    static std::map<OUString, uno::Any> aSettings;
+    return aSettings;
+}
+
+uno::Any setting(const OUString& rName, const uno::Any& rDefault)
+{
+    auto it = settings().find(rName);
+    return it == settings().end() ? rDefault : it->second;
+}
+}
+
+#define HST_SETTING(Name, Default)                                                                 \
+    uno::Any SAL_CALL ScVbaApplication::get##Name() { return setting(u"" #Name ""_ustr, uno::Any(Default)); } \
+    void SAL_CALL ScVbaApplication::set##Name(const uno::Any& rValue) { settings()[u"" #Name ""_ustr] = rValue; }
+
+HST_SETTING(Width, 1024.0)
+HST_SETTING(Height, 768.0)
+HST_SETTING(Top, 0.0)
+HST_SETTING(ReferenceStyle, sal_Int32(1)) // xlA1
+HST_SETTING(MoveAfterReturn, true)
+HST_SETTING(MoveAfterReturnDirection, sal_Int32(-4121)) // xlDown
+HST_SETTING(AskToUpdateLinks, true)
+HST_SETTING(CalculateBeforeSave, true)
+HST_SETTING(DecimalSeparator, u"."_ustr)
+HST_SETTING(ThousandsSeparator, u","_ustr)
+HST_SETTING(UseSystemSeparators, true)
+HST_SETTING(StandardFont, u"Calibri"_ustr)
+HST_SETTING(StandardFontSize, 11.0)
+HST_SETTING(ShowToolTips, true)
+HST_SETTING(MaxIterations, sal_Int32(100))
+HST_SETTING(DisplayCommentIndicator, sal_Int32(-1))
+HST_SETTING(ActivePrinter, OUString())
+#undef HST_SETTING
+
+uno::Any SAL_CALL ScVbaApplication::getUserName()
+{
+    const uno::Any aSet = setting(u"UserName"_ustr, uno::Any());
+    return aSet.hasValue() ? aSet : uno::Any(SvtUserOptions().GetFullName());
+}
+
+void SAL_CALL ScVbaApplication::setUserName(const uno::Any& rValue) { settings()[u"UserName"_ustr] = rValue; }
+
+OUString SAL_CALL ScVbaApplication::getPath()
+{
+    OUString aUrl(u"$BRAND_BASE_DIR/program"_ustr), aPath;
+    rtl::Bootstrap::expandMacros(aUrl);
+    osl::FileBase::getSystemPathFromFileURL(aUrl, aPath);
+    return aPath;
+}
+
+OUString SAL_CALL ScVbaApplication::getBuild() { return u"16000"_ustr; }
+
+void SAL_CALL ScVbaApplication::CalculateFull() { Calculate(); }
+
+// Only cells and toolbars are asked of it in real macros; those have other members here, so nothing runs.
+uno::Any SAL_CALL ScVbaApplication::ExecuteExcel4Macro(const OUString&) { return uno::Any(); }
+
+void SAL_CALL ScVbaApplication::MacroOptions(const uno::Any&, const uno::Any&, const uno::Any&, const uno::Any&, const uno::Any&, const uno::Any&,
+                                             const uno::Any&, const uno::Any&, const uno::Any&, const uno::Any&)
+{
+}
+
+void SAL_CALL ScVbaApplication::SendKeys(const uno::Any&, const uno::Any&) {}
+
+uno::Any SAL_CALL ScVbaApplication::GetSaveAsFilename(const uno::Any& rInitialFilename, const uno::Any&, const uno::Any&, const uno::Any& rTitle, const uno::Any&)
+{
+    uno::Reference<ui::dialogs::XFilePicker3> xPicker = ui::dialogs::FilePicker::createWithMode(mxContext, ui::dialogs::TemplateDescription::FILESAVE_SIMPLE);
+    OUString aText;
+    if (rTitle >>= aText)
+        xPicker->setTitle(aText);
+    if ((rInitialFilename >>= aText) && !aText.isEmpty())
+        xPicker->setDefaultName(aText);
+    if (xPicker->execute() != ui::dialogs::ExecutableDialogResults::OK || !xPicker->getSelectedFiles().hasElements())
+        return uno::Any(false);
+    OUString aPath;
+    osl::FileBase::getSystemPathFromFileURL(xPicker->getSelectedFiles()[0], aPath);
+    return uno::Any(aPath);
+}
+
+uno::Any SAL_CALL ScVbaApplication::InputBox(const OUString& rPrompt, const uno::Any& rTitle, const uno::Any& rDefault, const uno::Any&, const uno::Any&,
+                                             const uno::Any&, const uno::Any&, const uno::Any& rType)
+{
+    SbxArrayRef xArgs = new SbxArray;
+    SbxVariableRef xResult = new SbxVariable(SbxVARIANT);
+    xArgs->Put(xResult.get(), 0);
+    OUString aTitle, aDefault;
+    rTitle >>= aTitle;
+    if (!(rDefault >>= aDefault))
+    {
+        double fDefault = 0;
+        if (rDefault >>= fDefault)
+            aDefault = OUString::number(fDefault);
+    }
+    sal_uInt32 nIndex = 1;
+    for (const OUString& rArg : { rPrompt, aTitle, aDefault })
+    {
+        SbxVariableRef xArg = new SbxVariable(SbxSTRING);
+        xArg->PutString(rArg);
+        xArgs->Put(xArg.get(), nIndex++);
+    }
+    if (!executeRunTimeLibrary(u"InputBox", xArgs.get()))
+        return uno::Any(false);
+    const OUString aText = xResult->GetOUString();
+    if (aText.isEmpty())
+        return uno::Any(false); // Application.InputBox gives False on Cancel
+    sal_Int32 nType = 2;
+    rType >>= nType;
+    if (nType & 8) // a reference
+        return uno::Any(getActiveWorkbook()->getActiveSheet()->Range(uno::Any(aText), uno::Any()));
+    if (nType & 1)
+        return uno::Any(aText.toDouble());
+    if (nType & 4)
+        return uno::Any(aText.equalsIgnoreAsciiCase("true"));
+    return uno::Any(aText);
+}
