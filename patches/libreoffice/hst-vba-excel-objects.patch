+// HST: Worksheet.Sort: fields added one by one, then Apply, as Excel's macro recorder writes it. A worksheet
+// object is made anew at each access, so what was set is kept per document and sheet until Apply.
+
+#include "vbasheetsort.hxx"
+#include "vbarange.hxx"
+#include <cppuhelper/weakref.hxx>
+#include <ooo/vba/excel/XSortField.hpp>
+#include <ooo/vba/excel/XSortFields.hpp>
