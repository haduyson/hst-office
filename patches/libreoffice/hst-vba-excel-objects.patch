+#include <docsh.hxx>
+#include <simpleformulacalc.hxx>
+#include <svl/sharedstring.hxx>
+
+using namespace ::com::sun::star;
+
+uno::Any ScVbaEvaluate::formula(const uno::Reference<frame::XModel>& xModel, sal_Int32 nSheet, const OUString& rFormula)
+{
+    ScDocShell* pDocShell = ooo::vba::excel::getDocShell(xModel);
+    if (!pDocShell)
+        throw uno::RuntimeException();
+    const OUString aFormula = rFormula.startsWith("=") ? rFormula : "=" + rFormula;
+    ScSimpleFormulaCalculator aCalc(pDocShell->GetDocument(), ScAddress(0, 0, static_cast<SCTAB>(nSheet)), aFormula, false,
+                                    formula::FormulaGrammar::GRAM_NATIVE_XL_A1);
+    aCalc.Calculate();
+    if (aCalc.GetErrCode() != FormulaError::NONE)
+        throw uno::RuntimeException(u"Evaluate: the formula gives an error"_ustr);
+    return aCalc.IsValue() ? uno::Any(aCalc.GetValue()) : uno::Any(aCalc.GetString().getString());
+}
