+    uno::Reference<sheet::XSheetConditionalEntries> xEntries(xProps->getPropertyValue(u"ConditionalFormat"_ustr), uno::UNO_QUERY_THROW);
+    uno::Reference<excel::XFormatConditions> xConditions(new ScVbaFormatConditions(uno::Reference<XHelperInterface>(this), mxContext, xEntries, getUnoModel(), xProps));
+    return uno::Any(xConditions);
+}
+
+uno::Any SAL_CALL ScVbaRange::getListObject()
+{
+    uno::Reference<sheet::XCellRangeAddressable> xAddressable(mxRange, uno::UNO_QUERY_THROW);
+    const table::CellRangeAddress aCell = xAddressable->getRangeAddress();
+    uno::Reference<container::XNameAccess> xRanges(ScVbaListTable::databaseRanges(getUnoModel()), uno::UNO_QUERY_THROW);
+    for (const OUString& rName : xRanges->getElementNames())
+    {
+        uno::Reference<sheet::XDatabaseRange> xRange(xRanges->getByName(rName), uno::UNO_QUERY_THROW);
+        const table::CellRangeAddress aArea = xRange->getDataArea();
+        if (!rName.startsWith("__Anonymous_Sheet_DB__") && aArea.Sheet == aCell.Sheet && aArea.StartColumn <= aCell.StartColumn && aCell.StartColumn <= aArea.EndColumn
+            && aArea.StartRow <= aCell.StartRow && aCell.StartRow <= aArea.EndRow)
+            return uno::Any(uno::Reference<excel::XListObject>(new ScVbaListObject(getParent(), mxContext, getUnoModel(), rName)));
+    }
+    return uno::Any(uno::Reference<excel::XListObject>());
+}
+
+void SAL_CALL ScVbaRange::RemoveDuplicates(const uno::Any& rColumns, const uno::Any& rHeader)
+{
+    uno::Reference<sheet::XCellRangeData> xData(mxRange, uno::UNO_QUERY_THROW);
+    const uno::Sequence<uno::Sequence<uno::Any>> aRows = xData->getDataArray();
+    if (!aRows.hasElements())
+        return;
+    std::vector<sal_Int32> aColumns;
+    sal_Int32 nColumn = 0;
+    uno::Sequence<uno::Any> aList;
+    if (rColumns >>= nColumn)
+        aColumns.push_back(nColumn - 1);
+    else if (rColumns >>= aList)
+    {
+        for (const uno::Any& rItem : aList)
+            if (rItem >>= nColumn)
+                aColumns.push_back(nColumn - 1);
+    }
+    if (aColumns.empty())
+        for (sal_Int32 i = 0; i < aRows[0].getLength(); ++i)
+            aColumns.push_back(i);
+    sal_Int32 nHeader = excel::XlYesNoGuess::xlNo;
+    rHeader >>= nHeader;
+    std::vector<uno::Sequence<uno::Any>> aKept;
+    std::set<OUString> aSeen;
+    for (sal_Int32 nRow = 0; nRow < aRows.getLength(); ++nRow)
+    {
+        OUStringBuffer aKey;
+        for (sal_Int32 i : aColumns)
+        {
+            if (i >= 0 && i < aRows[nRow].getLength())
+            {
+                OUString aText;
+                double fValue = 0;
+                if (!(aRows[nRow][i] >>= aText) && (aRows[nRow][i] >>= fValue))
+                    aText = OUString::number(fValue);
+                aKey.append(aText + u"\x0001");
+            }
+        }
+        const bool bIsHeader = nRow == 0 && nHeader == excel::XlYesNoGuess::xlYes;
+        if (bIsHeader || aSeen.insert(aKey.makeStringAndClear()).second)
+            aKept.push_back(aRows[nRow]);
+    }
+    uno::Sequence<uno::Any> aEmpty(aRows[0].getLength());
+    aKept.resize(aRows.getLength(), aEmpty);
+    xData->setDataArray(comphelper::containerToSequence(aKept));
+}
+
+void SAL_CALL ScVbaRange::TextToColumns(const uno::Any& rDestination, const uno::Any&, const uno::Any&, const uno::Any& rConsecutive, const uno::Any& rTab, const uno::Any& rSemicolon,
+                                        const uno::Any& rComma, const uno::Any& rSpace, const uno::Any& rOther, const uno::Any& rOtherChar)
+{
+    OUString aDelimiters;
+    const auto add = [&aDelimiters](const uno::Any& rOn, sal_Unicode c) {
+        bool bOn = false;
+        if ((rOn >>= bOn) && bOn)
+            aDelimiters += OUStringChar(c);
+    };
+    add(rTab, '\t');
+    add(rSemicolon, ';');
+    add(rComma, ',');
+    add(rSpace, ' ');
+    bool bOther = false;
+    OUString aOtherChar;
+    if ((rOther >>= bOther) && bOther && (rOtherChar >>= aOtherChar))
+        aDelimiters += aOtherChar;
+    bool bConsecutive = false;
+    rConsecutive >>= bConsecutive;
+    uno::Reference<excel::XRange> xFirst(this);
+    uno::Reference<excel::XRange> xDestination;
+    rDestination >>= xDestination;
+    if (!xDestination.is())
+        xDestination = xFirst;
+    const sal_Int32 nRows = Rows(uno::Any())->getCount();
+    for (sal_Int32 nRow = 1; nRow <= nRows; ++nRow)
+    {
+        uno::Reference<excel::XRange> xCell(Cells(uno::Any(nRow), uno::Any(sal_Int32(1))), uno::UNO_SET_THROW);
+        OUString aText;
+        xCell->getValue() >>= aText;
+        sal_Int32 nColumn = 1, nStart = 0;
+        for (sal_Int32 i = 0; i <= aText.getLength(); ++i)
+        {
+            if (i < aText.getLength() && aDelimiters.indexOf(aText[i]) < 0)
+                continue;
+            if (i > nStart || !bConsecutive)
+            {
+                const OUString aPart = aText.copy(nStart, i - nStart);
+                const double fValue = aPart.toDouble();
+                uno::Reference<excel::XRange> xTarget(xDestination->Cells(uno::Any(nRow), uno::Any(nColumn)), uno::UNO_SET_THROW);
+                xTarget->setValue(fValue != 0 || aPart == "0" ? uno::Any(fValue) : uno::Any(aPart));
+                ++nColumn;
+            }
+            nStart = i + 1;
+        }
+    }
+}
