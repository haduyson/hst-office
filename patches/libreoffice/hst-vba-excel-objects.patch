+    {
+        rTheme >>= mnTheme;
+        const sal_Int32 nRgb = ScVbaTheme::rgbOf(mnTheme);
+        if (nRgb >= 0)
+            mxSheet->setPropertyValue(u"TabColor"_ustr, uno::Any(nRgb));
+    }
+    uno::Any SAL_CALL getTintAndShade() override { return uno::Any(0.0); }
+    void SAL_CALL setTintAndShade(const uno::Any& rTint) override
+    {
+        double fTint = 0;
+        sal_Int32 nBase = -1;
+        mxSheet->getPropertyValue(u"TabColor"_ustr) >>= nBase;
+        if ((rTint >>= fTint) && nBase >= 0)
+            mxSheet->setPropertyValue(u"TabColor"_ustr, uno::Any(ScVbaTheme::applyTint(nBase, fTint)));
+    }
+    OUString getServiceImplName() override { return u"ScVbaTab"_ustr; }
+    uno::Sequence<OUString> getServiceNames() override { return { u"ooo.vba.excel.Tab"_ustr }; }
+};
+
+ScDBData* sheetFilter(ScDocShell* pDocShell, sal_Int32 nSheet)
+{
+    return pDocShell ? pDocShell->GetDocument().GetAnonymousDBData(static_cast<SCTAB>(nSheet)) : nullptr;
+}
+}
+
+uno::Reference<excel::XTab> ScVbaSheetParts::makeTab(const uno::Reference<XHelperInterface>& xParent, const uno::Reference<uno::XComponentContext>& xContext,
+                                                     const uno::Reference<sheet::XSpreadsheet>& xSheet)
+{
+    return new Tab(xParent, xContext, xSheet);
+}
+
+bool ScVbaSheetParts::filterMode(const uno::Reference<frame::XModel>& xModel, sal_Int32 nSheet)
+{
+    ScDBData* pData = sheetFilter(excel::getDocShell(xModel), nSheet);
+    return pData && pData->HasQueryParam();
+}
+
+void ScVbaSheetParts::showAllData(const uno::Reference<frame::XModel>& xModel, sal_Int32 nSheet)
+{
+    ScDocShell* pDocShell = excel::getDocShell(xModel);
+    ScDBData* pData = sheetFilter(pDocShell, nSheet);
+    if (!pData || !pData->HasQueryParam())
+        return;
+    ScQueryParam aParam;
+    pData->GetQueryParam(aParam);
+    for (SCSIZE i = 0; i < aParam.GetEntryCount(); ++i)
+        aParam.GetEntry(i).bDoQuery = false;
+    ScDBDocFunc aFunc(*pDocShell);
+    aFunc.Query(static_cast<SCTAB>(nSheet), aParam, nullptr, true, false);
+}
