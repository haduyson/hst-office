+    void SAL_CALL setColor(const uno::Any& rColor) override
+    {
+        sal_Int32 nColor = 0;
+        if (rColor >>= nColor)
+            mxSheet->setPropertyValue(u"TabColor"_ustr, XLRGBToOORGB(rColor));
+        else
+            mxSheet->setPropertyValue(u"TabColor"_ustr, uno::Any(sal_Int32(-1))); // Tab.Color = False
+    }
+    uno::Any SAL_CALL getColorIndex() override { return uno::Any(sal_Int32(0)); }
+    void SAL_CALL setColorIndex(const uno::Any& rIndex) override
+    {
+        sal_Int32 nIndex = 0;
+        rIndex >>= nIndex;
+        ScVbaPalette aPalette(excel::getDocShell(ooo::vba::getCurrentExcelDoc(mxContext)));
+        uno::Reference<container::XIndexAccess> xPalette = aPalette.getDefaultPalette();
+        if (nIndex >= 1 && nIndex <= xPalette->getCount())
+            mxSheet->setPropertyValue(u"TabColor"_ustr, xPalette->getByIndex(nIndex - 1));
+        else
+            mxSheet->setPropertyValue(u"TabColor"_ustr, uno::Any(sal_Int32(-1)));
+    }
+    uno::Any SAL_CALL getThemeColor() override { return uno::Any(mnTheme); }
