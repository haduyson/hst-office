+#include <vbahelper/vbahelperinterface.hxx>
+#include <map>
+#include <vector>
+
+using namespace ::ooo::vba;
+using namespace ::com::sun::star;
+
+namespace
+{
+struct Field
+{
+    uno::Reference<excel::XRange> xKey;
+    uno::Any aOrder;
+};
+
+struct State
+{
+    std::vector<Field> aFields;
+    uno::Reference<excel::XRange> xRange;
+    uno::Any aHeader = uno::Any(excel::XlYesNoGuess::xlNo);
+    uno::Any aMatchCase, aOrientation, aSortMethod;
+};
+
+State& stateOf(const uno::Reference<frame::XModel>& xModel, sal_Int32 nSheet)
+{
+    static std::map<std::pair<void*, sal_Int32>, State> aStates;
+    return aStates[{ xModel.get(), nSheet }];
+}
+
+class SortField final : public InheritedHelperInterfaceWeakImpl<excel::XSortField>
+{
+    uno::Reference<excel::XRange> mxKey;
+    uno::Any maOrder;
+
+public:
+    SortField(const uno::Reference<XHelperInterface>& xParent, const uno::Reference<uno::XComponentContext>& xContext, uno::Reference<excel::XRange> xKey, uno::Any aOrder)
+        : InheritedHelperInterfaceWeakImpl(xParent, xContext), mxKey(std::move(xKey)), maOrder(std::move(aOrder)) {}
+    uno::Any SAL_CALL getOrder() override { return maOrder; }
+    void SAL_CALL setOrder(const uno::Any& rOrder) override { maOrder = rOrder; }
+    uno::Reference<excel::XRange> SAL_CALL getKey() override { return mxKey; }
+    OUString getServiceImplName() override { return u"ScVbaSortField"_ustr; }
+    uno::Sequence<OUString> getServiceNames() override { return { u"ooo.vba.excel.SortField"_ustr }; }
+};
+
+class SortFields final : public InheritedHelperInterfaceWeakImpl<excel::XSortFields>
+{
+    State& mrState;
+
+public:
+    SortFields(const uno::Reference<XHelperInterface>& xParent, const uno::Reference<uno::XComponentContext>& xContext, State& rState)
+        : InheritedHelperInterfaceWeakImpl(xParent, xContext), mrState(rState) {}
+    sal_Int32 SAL_CALL getCount() override { return static_cast<sal_Int32>(mrState.aFields.size()); }
+    void SAL_CALL Clear() override { mrState.aFields.clear(); }
+    uno::Reference<excel::XSortField> SAL_CALL Add(const uno::Any& rKey, const uno::Any&, const uno::Any& rOrder, const uno::Any&, const uno::Any&) override
+    {
+        uno::Reference<excel::XRange> xKey;
+        if (!(rKey >>= xKey))
+            throw uno::RuntimeException(u"SortFields.Add needs a Key range"_ustr);
+        mrState.aFields.push_back({ xKey, rOrder });
+        return new SortField(this, mxContext, xKey, rOrder);
+    }
+    OUString getServiceImplName() override { return u"ScVbaSortFields"_ustr; }
+    uno::Sequence<OUString> getServiceNames() override { return { u"ooo.vba.excel.SortFields"_ustr }; }
+};
+
+class Sort final : public InheritedHelperInterfaceWeakImpl<excel::XSort>
+{
+    State& mrState;
+
+public:
+    Sort(const uno::Reference<XHelperInterface>& xParent, const uno::Reference<uno::XComponentContext>& xContext, State& rState)
+        : InheritedHelperInterfaceWeakImpl(xParent, xContext), mrState(rState) {}
+    uno::Reference<excel::XSortFields> SAL_CALL getSortFields() override { return new SortFields(this, mxContext, mrState); }
+    uno::Reference<excel::XRange> SAL_CALL getRng() override { return mrState.xRange; }
+    uno::Any SAL_CALL getHeader() override { return mrState.aHeader; }
+    void SAL_CALL setHeader(const uno::Any& rValue) override { mrState.aHeader = rValue; }
+    uno::Any SAL_CALL getMatchCase() override { return mrState.aMatchCase; }
+    void SAL_CALL setMatchCase(const uno::Any& rValue) override { mrState.aMatchCase = rValue; }
+    uno::Any SAL_CALL getOrientation() override { return mrState.aOrientation; }
+    void SAL_CALL setOrientation(const uno::Any& rValue) override { mrState.aOrientation = rValue; }
+    uno::Any SAL_CALL getSortMethod() override { return mrState.aSortMethod; }
+    void SAL_CALL setSortMethod(const uno::Any& rValue) override { mrState.aSortMethod = rValue; }
+    void SAL_CALL SetRange(const uno::Reference<excel::XRange>& xRange) override { mrState.xRange = xRange; }
+    void SAL_CALL Apply() override
+    {
+        if (!mrState.xRange.is())
+            throw uno::RuntimeException(u"Sort.Apply: SetRange first"_ustr);
+        // the sort is stable: the last field first leaves the first field deciding
+        for (auto it = mrState.aFields.rbegin(); it != mrState.aFields.rend(); ++it)
+        {
+            uno::Any aOrder = it->aOrder.hasValue() ? it->aOrder : uno::Any(excel::XlSortOrder::xlAscending);
+            mrState.xRange->Sort(uno::Any(it->xKey), aOrder, uno::Any(), uno::Any(), uno::Any(), uno::Any(), uno::Any(), mrState.aHeader, uno::Any(),
+                                 mrState.aMatchCase, mrState.aOrientation, mrState.aSortMethod, uno::Any(), uno::Any(), uno::Any());
+        }
+    }
+    OUString getServiceImplName() override { return u"ScVbaSort"_ustr; }
+    uno::Sequence<OUString> getServiceNames() override { return { u"ooo.vba.excel.Sort"_ustr }; }
+};
+}
+
+uno::Reference<excel::XSort> ScVbaSheetParts::makeSort(const uno::Reference<XHelperInterface>& xParent, const uno::Reference<uno::XComponentContext>& xContext,
+                                                       const uno::Reference<frame::XModel>& xModel, sal_Int32 nSheet)
+{
+    return new Sort(xParent, xContext, stateOf(xModel, nSheet));
+}
