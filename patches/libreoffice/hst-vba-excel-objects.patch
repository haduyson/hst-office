+ScVbaRange::FindMemory& ScVbaRange::findMemory()
+{
+    static FindMemory aMemory;
+    return aMemory;
+}
+
+uno::Reference<excel::XRange> ScVbaRange::findAgain(const uno::Any& rAfter, sal_Int32 nDirection)
+{
+    const FindMemory& rMemory = findMemory();
+    if (!rMemory.aWhat.hasValue())
+        return {};
+    uno::Any aAfter = rAfter;
+    if (!aAfter.hasValue())
+    {
+        uno::Reference<excel::XRange> xLast(rMemory.xLast);
+        if (xLast.is())
+            aAfter <<= xLast;
+    }
+    const uno::Any aWhat = rMemory.aWhat, aLookIn = rMemory.aLookIn, aLookAt = rMemory.aLookAt, aOrder = rMemory.aOrder, aCase = rMemory.aMatchCase;
+    return Find(aWhat, aAfter, aLookIn, aLookAt, aOrder, uno::Any(nDirection), aCase, uno::Any(), uno::Any());
+}
+
+uno::Reference<excel::XRange> SAL_CALL ScVbaRange::FindNext(const uno::Any& rAfter) { return findAgain(rAfter, excel::XlSearchDirection::xlNext); }
+
+uno::Reference<excel::XRange> SAL_CALL ScVbaRange::FindPrevious(const uno::Any& rAfter) { return findAgain(rAfter, excel::XlSearchDirection::xlPrevious); }
