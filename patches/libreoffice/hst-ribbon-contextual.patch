+++ b/sfx2/source/notebookbar/HstChartCommands.cxx
@@ -0,0 +1,214 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+// HST Office: the chart tabs of the ribbon. The commands of a chart live in the frame of the chart,
+// which exists only while the chart is activated in place, but the ribbon belongs to the frame of
+// the document. This interceptor sits on that document frame: it reports the chart commands as
+// available, and running one activates the selected chart first and forwards to its frame, so the
+// tabs work from a single click on the chart, as in Office.
+
+#include "HstChartCommands.hxx"
+
+#include <com/sun/star/beans/PropertyValue.hpp>
+#include <com/sun/star/frame/DispatchDescriptor.hpp>
+#include <com/sun/star/frame/FeatureStateEvent.hpp>
+#include <com/sun/star/frame/XDispatch.hpp>
+#include <com/sun/star/frame/XDispatchProviderInterception.hpp>
+#include <com/sun/star/frame/XDispatchProviderInterceptor.hpp>
+#include <com/sun/star/frame/XFrames.hpp>
+#include <com/sun/star/frame/XFramesSupplier.hpp>
+#include <com/sun/star/frame/XStatusListener.hpp>
+#include <com/sun/star/lang/XEventListener.hpp>
+#include <com/sun/star/util/URLTransformer.hpp>
+#include <comphelper/processfactory.hxx>
+#include <comphelper/propertyvalue.hxx>
+#include <cppuhelper/implbase.hxx>
+#include <cppuhelper/weakref.hxx>
+#include <rtl/ref.hxx>
+#include <vcl/svapp.hxx>
+#include <vcl/timer.hxx>
+
+#include <algorithm>
+#include <vector>
+
+using namespace css;
+
+namespace hst::chart
+{
+namespace
+{
+constexpr OUString COMMANDS[]
+    = { u".uno:DiagramType"_ustr,          u".uno:DataRanges"_ustr,       u".uno:DiagramData"_ustr,
+        u".uno:InsertMenuTitles"_ustr,     u".uno:InsertMenuLegend"_ustr, u".uno:InsertMenuAxes"_ustr,
+        u".uno:InsertMenuGrids"_ustr,      u".uno:InsertMenuDataLabels"_ustr,
+        u".uno:InsertMenuTrendlines"_ustr, u".uno:FormatSelection"_ustr,  u".uno:DiagramArea"_ustr,
+        u".uno:DiagramWall"_ustr,          u".uno:Legend"_ustr };
+
+bool isChartCommand(const OUString& rCommand)
+{
+    return std::find(std::begin(COMMANDS), std::end(COMMANDS), rCommand) != std::end(COMMANDS);
+}
+
+class Interceptor final
+    : public cppu::WeakImplHelper<frame::XDispatchProviderInterceptor, frame::XDispatch, lang::XEventListener>
+{
+public:
+    explicit Interceptor(const uno::Reference<frame::XFrame>& rFrame)
+        : m_xFrame(rFrame)
+    {
+    }
+
+    // XDispatchProvider
+    uno::Reference<frame::XDispatch> SAL_CALL queryDispatch(const util::URL& rURL, const OUString& rTarget,
+                                                            sal_Int32 nFlags) override
+    {
+        if (rTarget.isEmpty() && isChartCommand(rURL.Complete))
+            return this;
+        return m_xSlave.is() ? m_xSlave->queryDispatch(rURL, rTarget, nFlags) : nullptr;
+    }
+
+    uno::Sequence<uno::Reference<frame::XDispatch>> SAL_CALL
+    queryDispatches(const uno::Sequence<frame::DispatchDescriptor>& rDescriptors) override
+    {
+        uno::Sequence<uno::Reference<frame::XDispatch>> aResult(rDescriptors.getLength());
+        auto pResult = aResult.getArray();
+        for (sal_Int32 i = 0; i < rDescriptors.getLength(); ++i)
+            pResult[i] = queryDispatch(rDescriptors[i].FeatureURL, rDescriptors[i].FrameName,
+                                       rDescriptors[i].SearchFlags);
+        return aResult;
+    }
+
+    // XDispatchProviderInterceptor
+    uno::Reference<frame::XDispatchProvider> SAL_CALL getSlaveDispatchProvider() override { return m_xSlave; }
+    void SAL_CALL setSlaveDispatchProvider(const uno::Reference<frame::XDispatchProvider>& rSlave) override
+    {
+        m_xSlave = rSlave;
+    }
+    uno::Reference<frame::XDispatchProvider> SAL_CALL getMasterDispatchProvider() override { return m_xMaster; }
+    void SAL_CALL setMasterDispatchProvider(const uno::Reference<frame::XDispatchProvider>& rMaster) override
+    {
+        m_xMaster = rMaster;
+    }
+
+    // XDispatch
+    void SAL_CALL dispatch(const util::URL& rURL, const uno::Sequence<beans::PropertyValue>& rArgs) override
+    {
+        SolarMutexGuard aGuard;
+        if (Forward(rURL, rArgs) || !m_xSlave.is())
+            return;
+        // not activated yet: verb 0 of the selected object is "edit in place". The activation runs
+        // asynchronously, so the command goes on when the frame of the chart can take it.
+        util::URL aActivate;
+        aActivate.Complete = u".uno:ObjectMenue"_ustr;
+        uno::Reference<util::XURLTransformer> xParser(
+            util::URLTransformer::create(comphelper::getProcessComponentContext()));
+        xParser->parseStrict(aActivate);
+        if (auto xDispatch = m_xSlave->queryDispatch(aActivate, OUString(), 0))
+            xDispatch->dispatch(aActivate, { comphelper::makePropertyValue(u"VerbID"_ustr, sal_Int16(0)) });
+        m_aPendingURL = rURL;
+        m_aPendingArgs = rArgs;
+        m_nTries = 0;
+        m_xKeepAlive = this;
+        m_aRetry.SetTimeout(100);
+        m_aRetry.SetInvokeHandler(LINK(this, Interceptor, RetryHdl));
+        m_aRetry.Start();
+    }
+
+    void SAL_CALL addStatusListener(const uno::Reference<frame::XStatusListener>& rListener, const util::URL& rURL) override
+    {
+        if (!rListener.is())
+            return;
+        frame::FeatureStateEvent aEvent;
+        aEvent.Source = getXWeak();
+        aEvent.FeatureURL = rURL;
+        aEvent.IsEnabled = true; // the tabs exist only while a chart is selected
+        rListener->statusChanged(aEvent);
+    }
+    void SAL_CALL removeStatusListener(const uno::Reference<frame::XStatusListener>&, const util::URL&) override {}
+
+    // XEventListener: the frame is going away
+    void SAL_CALL disposing(const lang::EventObject&) override
+    {
+        SolarMutexGuard aGuard;
+        m_aRetry.Stop();
+        m_xSlave.clear();
+        m_xMaster.clear();
+        m_xKeepAlive.clear();
+    }
+
+private:
+    DECL_LINK(RetryHdl, Timer*, void);
+
+    bool Forward(const util::URL& rURL, const uno::Sequence<beans::PropertyValue>& rArgs)
+    {
+        uno::Reference<frame::XDispatchProvider> xProvider(ChartFrame(), uno::UNO_QUERY);
+        auto xDispatch = xProvider.is() ? xProvider->queryDispatch(rURL, OUString(), 0) : nullptr;
+        if (!xDispatch.is() || xDispatch.get() == static_cast<frame::XDispatch*>(this))
+            return false;
+        xDispatch->dispatch(rURL, rArgs);
+        return true;
+    }
+
+    uno::Reference<frame::XFrame> ChartFrame() const
+    {
+        uno::Reference<frame::XFramesSupplier> xSupplier(m_xFrame.get(), uno::UNO_QUERY);
+        if (!xSupplier.is())
+            return nullptr;
+        if (auto xActive = xSupplier->getActiveFrame())
+            return xActive;
+        uno::Reference<frame::XFrames> xFrames = xSupplier->getFrames();
+        if (xFrames.is() && xFrames->getCount() > 0)
+        {
+            uno::Reference<frame::XFrame> xFirst;
+            xFrames->getByIndex(0) >>= xFirst;
+            return xFirst;
+        }
+        return nullptr;
+    }
+
+    uno::WeakReference<frame::XFrame> m_xFrame;
+    uno::Reference<frame::XDispatchProvider> m_xSlave;
+    uno::Reference<frame::XDispatchProvider> m_xMaster;
+    Timer m_aRetry{ "hst::chart::Interceptor retry" };
+    util::URL m_aPendingURL;
+    uno::Sequence<beans::PropertyValue> m_aPendingArgs;
+    int m_nTries = 0;
+    rtl::Reference<Interceptor> m_xKeepAlive; // while a command waits for the activation
+};
+
+IMPL_LINK_NOARG(Interceptor, RetryHdl, Timer*, void)
+{
+    if (Forward(m_aPendingURL, m_aPendingArgs) || ++m_nTries >= 30)
+    {
+        rtl::Reference<Interceptor> xSelf = std::move(m_xKeepAlive);
+        return;
+    }
+    m_aRetry.Start();
+}
+}
+
+void Install(const uno::Reference<frame::XFrame>& rFrame)
+{
+    // once per frame: the ribbon is rebuilt on a mode or theme change
+    static std::vector<uno::WeakReference<frame::XFrame>> s_aDone;
+    s_aDone.erase(std::remove_if(s_aDone.begin(), s_aDone.end(),
+                                 [](const uno::WeakReference<frame::XFrame>& r) { return !r.get().is(); }),
+                  s_aDone.end());
+    for (const uno::WeakReference<frame::XFrame>& rDone : s_aDone)
+        if (uno::Reference<frame::XFrame>(rDone) == rFrame)
+            return;
+    uno::Reference<frame::XDispatchProviderInterception> xInterception(rFrame, uno::UNO_QUERY);
+    if (!xInterception.is())
+        return;
+    rtl::Reference<Interceptor> xInterceptor(new Interceptor(rFrame));
+    xInterception->registerDispatchProviderInterceptor(xInterceptor);
+    rFrame->addEventListener(xInterceptor);
+    s_aDone.emplace_back(rFrame);
+}
+}
