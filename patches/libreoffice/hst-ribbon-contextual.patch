+// HST Office: a selection shows its tabs and leaves the ribbon on the current tab, as in Office.
+// View modes (print preview, master, outline) still open their tab.
+static bool lcl_hstIsSelectionContext(vcl::EnumContext::Context eContext)
+{
+    switch (eContext)
+    {
+        case vcl::EnumContext::Context::Table:
+        case vcl::EnumContext::Context::Graphic:
+        case vcl::EnumContext::Context::Chart:
+        case vcl::EnumContext::Context::OLE:
+        case vcl::EnumContext::Context::Frame:
+        case vcl::EnumContext::Context::Media:
+        case vcl::EnumContext::Context::Draw:
+        case vcl::EnumContext::Context::DrawLine:
+        case vcl::EnumContext::Context::ThreeDObject:
+        case vcl::EnumContext::Context::MultiObject:
+        case vcl::EnumContext::Context::Form:
+            return true;
+        default:
+            return false;
+    }
+}
