 /// Converts a hex-encoded string into a byte array.
 SVL_DLLPUBLIC std::vector<unsigned char> DecodeHexString(std::string_view rHex);
 
+/// HST Office: why the last Signing::Sign on this thread failed, as far as the platform signer can
+/// tell (Windows only; elsewhere eKind stays None). The step and the Windows error code are kept for
+/// the user's message and the HST log; nothing personal (no names, paths, PINs) is recorded.
+enum class SigningFailure
+{
+    None, ///< no failure recorded (success, or not known on this platform)
+    KeyNotFound, ///< no token / reader, or the certificate's private key was not found
+    Cancelled, ///< the user cancelled the PIN prompt
+    WrongPin, ///< wrong PIN, or the PIN is blocked
+    Other ///< any other failure: see aStep and nCode
+};
+
+struct SigningError
+{
+    SigningFailure eKind = SigningFailure::None;
+    OString aStep; ///< e.g. "acquire-key", "sign-hash"
+    sal_uInt32 nCode = 0; ///< Windows error code (GetLastError / HRESULT)
+};
+
+/// HST Office: the failure recorded by the last Signing::Sign on the calling thread.
+SVL_DLLPUBLIC SigningError GetLastSigningError();
+
 /// Helper to cryptographically sign and verify
 /// arbitrary data blocks.
 class SVL_DLLPUBLIC Signing
