 namespace {
 
+// HST Office: whether the CryptoAPI CSP named in a certificate's key provider info is installed.
+bool lcl_isCspInstalled(const wchar_t* pProvName, DWORD nProvType)
+{
+    for (DWORD nIndex = 0;; ++nIndex)
+    {
+        DWORD nType = 0;
+        DWORD cbName = 0;
+        if (!CryptEnumProvidersW(nIndex, nullptr, 0, &nType, nullptr, &cbName))
+            return false; // ERROR_NO_MORE_ITEMS
+        std::vector<wchar_t> aName(cbName / sizeof(wchar_t) + 1);
+        if (CryptEnumProvidersW(nIndex, nullptr, 0, &nType, aName.data(), &cbName)
+            && nType == nProvType && _wcsicmp(aName.data(), pProvName) == 0)
+            return true;
+    }
+}
+
+// HST Office: whether a certificate has a usable private key. CNG keys (KSPs, smart card
+// minidrivers) are checked as upstream does. Many USB token middlewares (e.g. the Vietnamese
+// CA tokens) register only a legacy CryptoAPI CSP: CNG cannot open those keys (NTE_NOT_FOUND),
+// so upstream hid every such certificate. Those are accepted from the certificate's key
+// provider property alone - no key is opened, so listing never touches the token or its PIN.
+bool lcl_hasPrivateKey(PCCERT_CONTEXT pCert, DWORD nCngFlags)
+{
+    NCRYPT_KEY_HANDLE hKey = 0;
+    DWORD nKeySpec = 0;
+    BOOL bFree = FALSE;
+    if (CryptAcquireCertificatePrivateKey(pCert, nCngFlags | CRYPT_ACQUIRE_ONLY_NCRYPT_KEY_FLAG,
+                                          nullptr, &hKey, &nKeySpec, &bFree))
+    {
+        if (hKey && bFree)
+            NCryptFreeObject(hKey);
+        return true;
+    }
+
+    DWORD cbInfo = 0;
+    if (!CertGetCertificateContextProperty(pCert, CERT_KEY_PROV_INFO_PROP_ID, nullptr, &cbInfo)
+        || cbInfo < sizeof(CRYPT_KEY_PROV_INFO))
+        return false;
+    std::vector<BYTE> aInfo(cbInfo);
+    if (!CertGetCertificateContextProperty(pCert, CERT_KEY_PROV_INFO_PROP_ID, aInfo.data(), &cbInfo))
+        return false;
+    const auto* pInfo = reinterpret_cast<const CRYPT_KEY_PROV_INFO*>(aInfo.data());
+    if (pInfo->dwProvType == 0) // a CNG key: the CNG attempt above is authoritative
+        return false;
+    if (!pInfo->pwszProvName || !pInfo->pwszContainerName
+        || (pInfo->dwKeySpec != AT_SIGNATURE && pInfo->dwKeySpec != AT_KEYEXCHANGE))
+        return false;
+    const bool bInstalled = lcl_isCspInstalled(pInfo->pwszProvName, pInfo->dwProvType);
+    SAL_INFO_IF(bInstalled, "xmlsecurity.xmlsec", "certificate key held by CryptoAPI CSP "
+                                                      << OUString(o3tl::toU(pInfo->pwszProvName)));
+    return bInstalled;
+}
