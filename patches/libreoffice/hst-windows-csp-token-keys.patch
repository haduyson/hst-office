++/* HST Office: some smart card / USB token middleware registers only a CryptoAPI CSP (no CNG key
++ * storage provider, no smart card minidriver). CNG cannot open such keys (NTE_NOT_FOUND), so the
++ * certificate's key is acquired through CryptoAPI instead. Only called after the CNG attempt failed. */
++static int
++xmlSecMSCngKeyDataCertGetCapiPrivkey(PCCERT_CONTEXT cert, HCRYPTPROV* prov, DWORD* keySpec, BOOL* needsFree) {
++    HCRYPTPROV_OR_NCRYPT_KEY_HANDLE handle = 0;
++    DWORD spec = 0;
++    BOOL callerFree = FALSE;
++
++    xmlSecAssert2(cert != NULL, -1);
++    xmlSecAssert2(prov != NULL, -1);
++    xmlSecAssert2(keySpec != NULL, -1);
++    xmlSecAssert2(needsFree != NULL, -1);
++
++    /* no NCRYPT flag: CryptoAPI only */
++    if(!CryptAcquireCertificatePrivateKey(cert, CRYPT_ACQUIRE_COMPARE_KEY_FLAG, NULL, &handle, &spec, &callerFree)) {
++        xmlSecMSCngLastError("CryptAcquireCertificatePrivateKey(CryptoAPI)", NULL);
++        return(-1);
++    }
++    if((spec != AT_SIGNATURE) && (spec != AT_KEYEXCHANGE)) {
++        if(callerFree) {
++            CryptReleaseContext((HCRYPTPROV)handle, 0);
++        }
++        xmlSecInvalidIntegerDataError("keySpec", spec, "AT_SIGNATURE or AT_KEYEXCHANGE", NULL);
++        return(-1);
++    }
++    (*prov) = (HCRYPTPROV)handle;
++    (*keySpec) = spec;
++    (*needsFree) = callerFree;
++    return(0);
++}
