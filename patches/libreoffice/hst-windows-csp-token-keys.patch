@@ -68,6 +68,9 @@
 using namespace com::sun::star;
 
 namespace {
+// HST Office: what the last Signing::Sign on this thread recorded (see GetLastSigningError).
+thread_local svl::crypto::SigningError g_aLastSigningError;
+
 #if USE_CRYPTO_NSS
 char *PDFSigningPKCS7PasswordCallback(PK11SlotInfo * /*slot*/, PRBool /*retry*/, void *arg)
 {
@@ -850,6 +853,200 @@
 
     return true;
 }
+
+/// HST Office: records why signing failed (step and Windows error code) for GetLastSigningError,
+/// sorted into the cases the user can act on.
+void lcl_signingFailed(const char* pStep, DWORD nCode)
+{
+    static constexpr DWORD aKeyNotFound[] = {
+        0x80090016, // NTE_BAD_KEYSET
+        0x80090019, // NTE_KEYSET_NOT_DEF
+        0x8009000D, // NTE_NO_KEY
+        0x80090011, // NTE_NOT_FOUND
+        0xC0000225, // STATUS_NOT_FOUND (NCrypt)
+        0x8009200B, // CRYPT_E_NO_KEY_PROPERTY
+        0x8010000C, // SCARD_E_NO_SMARTCARD
+        0x80100069, // SCARD_W_REMOVED_CARD
+        0x8010002E, // SCARD_E_NO_READERS_AVAILABLE
+        0x80100017, // SCARD_E_READER_UNAVAILABLE
+        0x8010001D, // SCARD_E_NO_SERVICE
+    };
+    static constexpr DWORD aCancelled[] = {
+        0x8010006E, // SCARD_W_CANCELLED_BY_USER
+        0x80100002, // SCARD_E_CANCELLED
+        0x800704C7, // HRESULT_FROM_WIN32(ERROR_CANCELLED)
+        1223, // ERROR_CANCELLED
+    };
+    static constexpr DWORD aWrongPin[] = {
+        0x8010006B, // SCARD_W_WRONG_CHV
+        0x8010006C, // SCARD_W_CHV_BLOCKED
+        0x80070056, // HRESULT_FROM_WIN32(ERROR_INVALID_PASSWORD)
+        86, // ERROR_INVALID_PASSWORD
+    };
+    auto contains = [nCode](const auto& rCodes)
+    { return std::find(std::begin(rCodes), std::end(rCodes), nCode) != std::end(rCodes); };
+
+    g_aLastSigningError.eKind = contains(aKeyNotFound) ? svl::crypto::SigningFailure::KeyNotFound
+                                : contains(aCancelled) ? svl::crypto::SigningFailure::Cancelled
+                                : contains(aWrongPin)  ? svl::crypto::SigningFailure::WrongPin
+                                                       : svl::crypto::SigningFailure::Other;
+    g_aLastSigningError.aStep = OString(pStep);
+    g_aLastSigningError.nCode = static_cast<sal_uInt32>(nCode);
+    SAL_WARN("svl.crypto", "signing failed at " << pStep << ": " << comphelper::WindowsErrorString(nCode));
+}
+
+/// Writes one DER element: tag, length, contents.
+void lcl_writeDER(SvStream& rStream, sal_uInt8 nTag, const void* pData, size_t nSize)
+{
+    rStream.WriteUInt8(nTag);
+    WriteDERLength(rStream, nSize);
+    rStream.WriteBytes(pData, nSize);
+}
+
+/// HST Office: CMS SignedData (detached, SHA-256, RSA PKCS#1 v1.5) for a key held by a legacy
+/// CryptoAPI CSP - USB token middleware without a CNG key storage provider or smart card minidriver
+/// (VNPT-CA "Ace PKI Token CSP" and similar). With such a key crypt32's own CMS signer
+/// (CryptMsgOpenToEncode with the CSP handle) failed on the token while the ODF signer worked on the
+/// same key, so this uses the ODF signer's primitive (xmlsec mscng, hst-mscng-capi-token-keys):
+/// the DER of the signed attributes is hashed here and signed with CryptCreateHash(CALG_SHA_256) +
+/// HP_HASHVAL + CryptSignHash. The SignedData without signers is DER-encoded here (crypt32 leaves
+/// digestAlgorithms empty for a message without signers), decoded, and the signer added with
+/// CMSG_CTRL_ADD_CMS_SIGNER_INFO. Returns the decoded message that holds the signer (read it with
+/// CMSG_ENCODED_MESSAGE), or nullptr after lcl_signingFailed.
+HCRYPTMSG lcl_signWithCspKey(HCRYPTPROV hProv, DWORD nKeySpec, PCCERT_CONTEXT pCertContext,
+                             const std::vector<std::pair<const void*, sal_Int32>>& rDataBlocks,
+                             const CRYPT_ATTRIBUTE& rSigningCertificate)
+{
+    // messageDigest: SHA-256 of the signed byte ranges
+    comphelper::Hash aContentHash(comphelper::HashType::SHA256);
+    for (const auto& rBlock : rDataBlocks)
+        aContentHash.update(rBlock.first, rBlock.second);
+    const std::vector<unsigned char> aContentDigest = aContentHash.finalize();
+    std::vector<BYTE> aMessageDigest{ static_cast<BYTE>(nASN1_OCTET_STRING),
+                                      static_cast<BYTE>(aContentDigest.size()) };
+    aMessageDigest.insert(aMessageDigest.end(), aContentDigest.begin(), aContentDigest.end());
+    // contentType: id-data (1.2.840.113549.1.7.1)
+    BYTE aContentType[] = { 0x06, 0x09, 0x2a, 0x86, 0x48, 0x86, 0xf7, 0x0d, 0x01, 0x07, 0x01 };
+
+    CRYPT_INTEGER_BLOB aContentTypeBlob{ sizeof(aContentType), aContentType };
+    CRYPT_INTEGER_BLOB aMessageDigestBlob{ static_cast<DWORD>(aMessageDigest.size()),
+                                           aMessageDigest.data() };
+    CRYPT_ATTRIBUTE aAttributes[3] = {
+        { const_cast<LPSTR>(szOID_RSA_contentType), 1, &aContentTypeBlob },
+        { const_cast<LPSTR>(szOID_RSA_messageDigest), 1, &aMessageDigestBlob },
+        rSigningCertificate,
+    };
+    CRYPT_ATTRIBUTES aSignedAttributes{ static_cast<DWORD>(SAL_N_ELEMENTS(aAttributes)), aAttributes };
+
+    // the signature covers the DER of the signed attributes as a SET OF (RFC 5652, 5.4)
+    DWORD nEncoded = 0;
+    if (!CryptEncodeObject(X509_ASN_ENCODING, PKCS_ATTRIBUTES, &aSignedAttributes, nullptr, &nEncoded))
+    {
+        lcl_signingFailed("encode-attributes", GetLastError());
+        return nullptr;
+    }
+    std::vector<BYTE> aEncoded(nEncoded);
+    if (!CryptEncodeObject(X509_ASN_ENCODING, PKCS_ATTRIBUTES, &aSignedAttributes, aEncoded.data(),
+                           &nEncoded))
+    {
+        lcl_signingFailed("encode-attributes", GetLastError());
+        return nullptr;
+    }
+    aEncoded.resize(nEncoded);
+    std::vector<unsigned char> aAttributesDigest = comphelper::Hash::calculateHash(
+        aEncoded.data(), aEncoded.size(), comphelper::HashType::SHA256);
+
+    HCRYPTHASH hHash = 0;
+    if (!CryptCreateHash(hProv, CALG_SHA_256, 0, 0, &hHash))
+    {
+        lcl_signingFailed("create-hash", GetLastError());
+        return nullptr;
+    }
+    comphelper::ScopeGuard aHashGuard([hHash] { CryptDestroyHash(hHash); });
+    if (!CryptSetHashParam(hHash, HP_HASHVAL, aAttributesDigest.data(), 0))
+    {
+        lcl_signingFailed("set-hash", GetLastError());
+        return nullptr;
+    }
+    // the token's middleware asks for the PIN here when it needs it
+    DWORD nSignature = 0;
+    if (!CryptSignHashW(hHash, nKeySpec, nullptr, 0, nullptr, &nSignature))
+    {
+        lcl_signingFailed("sign-hash", GetLastError());
+        return nullptr;
+    }
+    std::vector<BYTE> aSignature(nSignature);
+    if (!CryptSignHashW(hHash, nKeySpec, nullptr, 0, aSignature.data(), &nSignature))
+    {
+        lcl_signingFailed("sign-hash", GetLastError());
+        return nullptr;
+    }
+    aSignature.resize(nSignature);
+    std::reverse(aSignature.begin(), aSignature.end()); // CryptoAPI signatures are little-endian
+
+    // SignedData without signers: version 1, digestAlgorithms { sha256 }, encapContentInfo id-data
+    // (detached), certificates [0] { the signing certificate }, signerInfos { }
+    static const BYTE aVersionAndDigestAlgorithms[]
+        = { 0x02, 0x01, 0x01, 0x31, 0x0f, 0x30, 0x0d, 0x06, 0x09, 0x60,
+            0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x01, 0x05, 0x00 };
+    static const BYTE aEncapContentInfo[]
+        = { 0x30, 0x0b, 0x06, 0x09, 0x2a, 0x86, 0x48, 0x86, 0xf7, 0x0d, 0x01, 0x07, 0x01 };
+    static const BYTE aNoSigners[] = { 0x31, 0x00 };
+    static const BYTE aSignedDataOid[]
+        = { 0x06, 0x09, 0x2a, 0x86, 0x48, 0x86, 0xf7, 0x0d, 0x01, 0x07, 0x02 };
+    SvMemoryStream aSignedDataBody;
+    aSignedDataBody.WriteBytes(aVersionAndDigestAlgorithms, sizeof(aVersionAndDigestAlgorithms));
+    aSignedDataBody.WriteBytes(aEncapContentInfo, sizeof(aEncapContentInfo));
+    lcl_writeDER(aSignedDataBody, nASN1_TAGGED_CONSTRUCTED, pCertContext->pbCertEncoded,
+                 pCertContext->cbCertEncoded);
+    aSignedDataBody.WriteBytes(aNoSigners, sizeof(aNoSigners));
