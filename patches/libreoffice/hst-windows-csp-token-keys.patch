++/* HST Office: sign the already computed hash with a key held by a legacy CryptoAPI CSP.
++ * RSA PKCS#1 v1.5 only (what CSP-only tokens offer). CryptoAPI returns little-endian signatures. */
++static int
++xmlSecMSCngSignatureSignCapi(xmlSecTransformPtr transform, xmlSecMSCngSignatureCtxPtr ctx,
++                             HCRYPTPROV prov, DWORD keySpec) {
++    HCRYPTHASH hHash = 0;
++    ALG_ID algId;
++    DWORD cbSignature = 0;
++    xmlSecSize outSize;
++    int ret;
++    int res = -1;
++
++    if(ctx->dwInfoFlags != BCRYPT_PAD_PKCS1) {
++        xmlSecNotImplementedError("CryptoAPI keys support RSA PKCS#1 v1.5 signatures only");
++        return(-1);
++    }
++    if(wcscmp(ctx->pszHashAlgId, BCRYPT_SHA1_ALGORITHM) == 0) {
++        algId = CALG_SHA1;
++    } else if(wcscmp(ctx->pszHashAlgId, BCRYPT_SHA256_ALGORITHM) == 0) {
++        algId = CALG_SHA_256;
++    } else if(wcscmp(ctx->pszHashAlgId, BCRYPT_SHA384_ALGORITHM) == 0) {
++        algId = CALG_SHA_384;
++    } else if(wcscmp(ctx->pszHashAlgId, BCRYPT_SHA512_ALGORITHM) == 0) {
++        algId = CALG_SHA_512;
++    } else {
++        xmlSecNotImplementedError("CryptoAPI keys: unsupported hash algorithm");
++        return(-1);
++    }
++
++    if(!CryptCreateHash(prov, algId, 0, 0, &hHash)) {
++        xmlSecMSCngLastError("CryptCreateHash", xmlSecTransformGetName(transform));
++        return(-1);
++    }
++    if(!CryptSetHashParam(hHash, HP_HASHVAL, ctx->pbHash, 0)) {
++        xmlSecMSCngLastError("CryptSetHashParam(HP_HASHVAL)", xmlSecTransformGetName(transform));
++        goto done;
++    }
++    if(!CryptSignHashW(hHash, keySpec, NULL, 0, NULL, &cbSignature)) {
++        xmlSecMSCngLastError("CryptSignHash(size)", xmlSecTransformGetName(transform));
++        goto done;
++    }
++    XMLSEC_SAFE_CAST_ULONG_TO_SIZE(cbSignature, outSize, goto done, xmlSecTransformGetName(transform));
++    ret = xmlSecBufferSetSize(&(transform->outBuf), outSize);
++    if(ret < 0) {
++        xmlSecInternalError2("xmlSecBufferSetSize", xmlSecTransformGetName(transform),
++            "size=" XMLSEC_SIZE_FMT, outSize);
++        goto done;
++    }
++    if(!CryptSignHashW(hHash, keySpec, NULL, 0, (BYTE*)xmlSecBufferGetData(&(transform->outBuf)), &cbSignature)) {
++        xmlSecMSCngLastError("CryptSignHash", xmlSecTransformGetName(transform));
++        goto done;
++    }
++    xmlSecMSCngReverseBytes((BYTE*)xmlSecBufferGetData(&(transform->outBuf)), cbSignature);
++    res = 0;
++
++done:
++    CryptDestroyHash(hHash);
++    return(res);
++}
++
+ static int
+ xmlSecMSCngSignatureSign(
+     xmlSecTransformPtr transform,
+@@ -920,6 +980,11 @@
