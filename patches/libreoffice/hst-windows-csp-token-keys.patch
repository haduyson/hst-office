++        xmlSecMSCngLastError("CryptAcquireCertificatePrivateKey(CryptoAPI)", NULL);
++        return(-1);
++    }
++    if((spec != AT_SIGNATURE) && (spec != AT_KEYEXCHANGE)) {
++        if(callerFree) {
++            CryptReleaseContext((HCRYPTPROV)handle, 0);
++        }
