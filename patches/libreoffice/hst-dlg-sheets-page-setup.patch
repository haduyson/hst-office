+css::uno::Reference<css::sheet::XPrintAreas> lcl_GetActiveSheetPrintAreas()
+{
+    SfxObjectShell* pDocSh = SfxObjectShell::Current();
+    if (!pDocSh)
+        return {};
+    css::uno::Reference<css::frame::XModel> xModel = pDocSh->GetModel();
+    if (!xModel)
+        return {};
+    css::uno::Reference<css::sheet::XSpreadsheetView> xView(xModel->getCurrentController(),
+                                                            css::uno::UNO_QUERY);
+    if (!xView)
+        return {};
+    return css::uno::Reference<css::sheet::XPrintAreas>(xView->getActiveSheet(), css::uno::UNO_QUERY);
+}
+
+/// "A" for column index 0, "AB" for 27: the column letters of an index.
+OUString lcl_ColumnName(sal_Int32 nCol)
+{
+    OUString aName;
+    for (sal_Int32 n = nCol + 1; n > 0; n = (n - 1) / 26)
+        aName = OUStringChar(static_cast<sal_Unicode>('A' + (n - 1) % 26)) + aName;
+    return aName;
+}
+
+/// Reads "$1:$3", "1:3" or "2" (rows), "$A:$B", "a" (columns) to a zero-based range.
+bool lcl_ParseRepeat(std::u16string_view aText, bool bColumns, sal_Int32& rFirst, sal_Int32& rLast)
+{
+    auto parseOne = [bColumns](std::u16string_view aPart, sal_Int32& rValue) {
+        aPart = o3tl::trim(aPart);
+        if (!aPart.empty() && aPart[0] == '$')
+            aPart.remove_prefix(1);
+        if (aPart.empty())
+            return false;
+        sal_Int32 nValue = 0;
+        for (sal_Unicode c : aPart)
+        {
+            if (bColumns && rtl::isAsciiAlpha(c))
+                nValue = nValue * 26 + (rtl::toAsciiUpperCase(c) - 'A' + 1);
+            else if (!bColumns && rtl::isAsciiDigit(c))
+                nValue = nValue * 10 + (c - '0');
+            else
+                return false;
+            if (nValue > 1048576)
+                return false;
+        }
+        rValue = nValue - 1;
+        return rValue >= 0;
+    };
+    const size_t nColon = aText.find(':');
+    if (!parseOne(aText.substr(0, nColon), rFirst))
+        return false;
+    rLast = rFirst;
+    if (nColon != std::u16string_view::npos && !parseOne(aText.substr(nColon + 1), rLast))
+        return false;
+    if (rLast < rFirst)
+        std::swap(rFirst, rLast);
+    return true;
+}
+}
+
+void ScTablePage::ResetPrintTitles()
+{
+    OUString aRows, aCols;
+    if (const auto xAreas = lcl_GetActiveSheetPrintAreas())
+    {
+        if (xAreas->getPrintTitleRows())
+        {
+            const css::table::CellRangeAddress aRange = xAreas->getTitleRows();
+            aRows = "$" + OUString::number(aRange.StartRow + 1) + ":$"
+                    + OUString::number(aRange.EndRow + 1);
+        }
+        if (xAreas->getPrintTitleColumns())
+        {
+            const css::table::CellRangeAddress aRange = xAreas->getTitleColumns();
+            aCols = "$" + lcl_ColumnName(aRange.StartColumn) + ":$"
+                    + lcl_ColumnName(aRange.EndColumn);
+        }
+    }
+    else
+    {
+        m_xEdRepeatRows->set_sensitive(false);
+        m_xEdRepeatCols->set_sensitive(false);
+    }
+    m_xEdRepeatRows->set_text(aRows);
+    m_xEdRepeatCols->set_text(aCols);
+    m_aSavedRepeatRows = aRows;
+    m_aSavedRepeatCols = aCols;
+}
+
+void ScTablePage::ApplyPrintTitles()
+{
+    const OUString aRows = m_xEdRepeatRows->get_text().trim();
+    const OUString aCols = m_xEdRepeatCols->get_text().trim();
+    if (aRows == m_aSavedRepeatRows && aCols == m_aSavedRepeatCols)
+        return;
+    const auto xAreas = lcl_GetActiveSheetPrintAreas();
+    if (!xAreas)
+        return;
+    sal_Int32 nFirst = 0, nLast = 0;
+    if (aRows != m_aSavedRepeatRows)
+    {
+        if (aRows.isEmpty())
+            xAreas->setPrintTitleRows(false);
+        else if (lcl_ParseRepeat(aRows, false, nFirst, nLast))
+        {
+            css::table::CellRangeAddress aRange;
+            aRange.StartRow = nFirst;
+            aRange.EndRow = nLast;
+            xAreas->setTitleRows(aRange);
+            xAreas->setPrintTitleRows(true);
+        }
+    }
+    if (aCols != m_aSavedRepeatCols)
+    {
+        if (aCols.isEmpty())
+            xAreas->setPrintTitleColumns(false);
+        else if (lcl_ParseRepeat(aCols, true, nFirst, nLast))
+        {
+            css::table::CellRangeAddress aRange;
+            aRange.StartColumn = nFirst;
+            aRange.EndColumn = nLast;
+            xAreas->setTitleColumns(aRange);
+            xAreas->setPrintTitleColumns(true);
+        }
+    }
+    m_aSavedRepeatRows = aRows;
+    m_aSavedRepeatCols = aCols;
+}
