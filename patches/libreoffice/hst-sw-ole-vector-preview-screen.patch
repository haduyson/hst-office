+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * Part of HST Office. This file is HST's own work and is not covered by the MPL.
+ */
+
+#pragma once
+
+class Graphic;
+class OutputDevice;
+class Point;
+class Size;
+
+namespace hst::ole
+{
+/** Paints the replacement graphic of an OLE object when it holds vector data.
+
+    Word stores a preview picture with every OLE object; for MathType, Equation 3.0, ChemDraw
+    or ChemWindow objects it is a WMF or EMF. Without the object's server that preview is all
+    the user sees, so it has to look like Word draws it: as vectors, resolved at the real
+    device resolution. The graphic is painted as drawing-layer primitives into the rectangle
+    rPos/rSize (device logic units), the same way Writer paints a WMF picture. That keeps it
+    sharp at every zoom and display scale on screen and keeps text and lines as vectors when
+    printing or exporting.
+
+    Returns false, painting nothing, when the graphic is not vector data (bitmap previews,
+    plain metafiles) or the rectangle is empty; the caller then paints it as before. */
+bool PaintVectorReplacement(OutputDevice& rOut, const Graphic& rGraphic, const Point& rPos,
+                            const Size& rSize);
+}
