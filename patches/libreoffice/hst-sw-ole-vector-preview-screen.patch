+#include <swmodeltestbase.hxx>
+
+#include <vcl/BitmapReadAccess.hxx>
+#include <vcl/graph.hxx>
+
+#include <doc.hxx>
+#include <docsh.hxx>
+#include <ndole.hxx>
+
+namespace
+{
+/// Painting of OLE previews: the WMF/EMF Word keeps for MathType objects.
+class HstOlePreviewPaintTest : public SwModelTestBase
+{
+public:
+    HstOlePreviewPaintTest()
+        : SwModelTestBase(u"/sw/qa/core/data/ooxml/pass/"_ustr)
+    {
+    }
+};
+
+SwOLENode* findFirstOleNode(SwDoc& rDoc)
+{
+    SwNodes& rNodes = rDoc.GetNodes();
+    for (SwNodeOffset n(0); n < rNodes.Count(); ++n)
+        if (SwOLENode* pOle = rNodes[n]->GetOLENode())
+            return pOle;
+    return nullptr;
+}
+
+/// Pixels clearly darker than the white page: glyphs and lines.
+tools::Long countInkPixels(const Bitmap& rBitmap)
+{
+    BitmapScopedReadAccess pAccess(rBitmap);
+    tools::Long nInk = 0;
+    for (tools::Long y = 0; y < pAccess->Height(); ++y)
+        for (tools::Long x = 0; x < pAccess->Width(); ++x)
+            if (pAccess->GetColor(y, x).GetLuminance() < 128)
+                ++nInk;
+    return nInk;
+}
+}
+
+CPPUNIT_TEST_FIXTURE(HstOlePreviewPaintTest, testMathTypePreviewPaintsAsVectorsOnScreen)
+{
+    // The page holds only one MathType (Equation.DSMT4) object; its preview is a WMF, i.e.
+    // vector graphic data.
+    createSwDoc("fdo78906.docx");
+    SwOLENode* pOle = findFirstOleNode(*getSwDoc());
+    CPPUNIT_ASSERT(pOle);
+    const Graphic* pGraphic = pOle->GetGraphic();
+    CPPUNIT_ASSERT(pGraphic);
+    CPPUNIT_ASSERT(pGraphic->getVectorGraphicData());
+    const Size aRasterBefore(pGraphic->GetBitmapRef().GetSizePixel());
+
+    // Render the first page onto a plain VirtualDevice (not a printer, no metafile recording):
+    // the code path of screen painting.
+    const Bitmap aPage(getSwDocShell()->GetPreviewBitmap());
+    CPPUNIT_ASSERT(!aPage.IsEmpty());
+
+    // The formula was painted.
+    CPPUNIT_ASSERT_GREATER(tools::Long(50), countInkPixels(aPage));
+
+    // ... as vectors resolved by the device. Before, Graphic::Draw rendered the WMF into a
+    // bitmap of the painted pixel size, kept it in the graphic and blitted it: soft, blurry glyph
+    // edges, worse at high zoom and on high-DPI displays.
+    const Size aRasterAfter(pGraphic->GetBitmapRef().GetSizePixel());
+    CPPUNIT_ASSERT_EQUAL(aRasterBefore.Width(), aRasterAfter.Width());
+    CPPUNIT_ASSERT_EQUAL(aRasterBefore.Height(), aRasterAfter.Height());
+}
+
