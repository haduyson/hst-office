+#include <hstolereplacementpaint.hxx>
+
+#include <basegfx/matrix/b2dhommatrixtools.hxx>
+#include <vcl/GraphicAttributes.hxx>
+#include <vcl/GraphicObject.hxx>
+#include <vcl/graph.hxx>
+#include <vcl/outdev.hxx>
+
+#include <frmtool.hxx>
+
+namespace hst::ole
+{
+bool PaintVectorReplacement(OutputDevice& rOut, const Graphic& rGraphic, const Point& rPos,
+                            const Size& rSize)
+{
+    // Graphic::Draw renders vector data into a bitmap of the target's pixel size and blits it:
+    // text loses its hinting and edge contrast (blurry formulas), and a cached bitmap of the
+    // wrong size gets scaled. Primitives are resolved by the device itself instead.
+    if (!rGraphic.getVectorGraphicData() || rSize.Width() <= 0 || rSize.Height() <= 0)
+        return false;
+
+    const basegfx::B2DHomMatrix aPlacement(basegfx::utils::createScaleTranslateB2DHomMatrix(
+        rSize.Width(), rSize.Height(), rPos.X(), rPos.Y()));
+    paintGraphicUsingPrimitivesHelper(rOut, GraphicObject(rGraphic), GraphicAttr(), aPlacement,
+                                      OUString(), OUString(), OUString());
+    return true;
+}
+}
