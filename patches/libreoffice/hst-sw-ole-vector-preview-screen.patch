+namespace
+{
+/// Screen painting of OLE previews: the WMF/EMF Word keeps for MathType objects.
+class HstOlePreviewPaintTest : public SwModelTestBase
+{
+public:
+    HstOlePreviewPaintTest()
+        : SwModelTestBase(u"/sw/qa/core/data/ooxml/pass/"_ustr)
+    {
+    }
+};
+
+SwOLENode* findFirstOleNode(SwDoc& rDoc)
+{
+    SwNodes& rNodes = rDoc.GetNodes();
+    for (SwNodeOffset n(0); n < rNodes.Count(); ++n)
+        if (SwOLENode* pOle = rNodes[n]->GetOLENode())
+            return pOle;
+    return nullptr;
+}
+
+/// Pixels clearly darker than the white background: the formula's glyphs and lines.
+tools::Long countInkPixels(const Bitmap& rBitmap)
+{
+    BitmapScopedReadAccess pAccess(rBitmap);
+    tools::Long nInk = 0;
+    for (tools::Long y = 0; y < pAccess->Height(); ++y)
+        for (tools::Long x = 0; x < pAccess->Width(); ++x)
+            if (pAccess->GetColor(y, x).GetLuminance() < 128)
+                ++nInk;
+    return nInk;
+}
+}
+
+CPPUNIT_TEST_FIXTURE(HstOlePreviewPaintTest, testMathTypePreviewPaintsAsVectorsOnScreen)
+{
+    // One MathType (Equation.DSMT4) object; its preview is a WMF, i.e. vector graphic data.
+    createSwDoc("fdo78906.docx");
+    SwOLENode* pOle = findFirstOleNode(*getSwDoc());
+    CPPUNIT_ASSERT(pOle);
+    const Graphic* pGraphic = pOle->GetGraphic();
+    CPPUNIT_ASSERT(pGraphic);
+    CPPUNIT_ASSERT(pGraphic->getVectorGraphicData());
+
+    SwWrtShell* pWrtShell = getSwDocShell()->GetWrtShell();
+    pWrtShell->CalcLayout();
+    const SwFrame* pFrame = pOle->getLayoutFrame(pWrtShell->GetLayout());
+    CPPUNIT_ASSERT(pFrame);
+    const SwRect aArea(pFrame->getFrameArea());
+
+    // A screen-type device (not a printer, no metafile recording) at 300 % zoom, showing just
+    // the object.
+    ScopedVclPtrInstance<VirtualDevice> pDevice(DeviceFormat::WITHOUT_ALPHA);
+    MapMode aMapMode(MapUnit::MapTwip);
+    aMapMode.SetOrigin(Point(-aArea.Left(), -aArea.Top()));
+    aMapMode.SetScaleX(3.0);
+    aMapMode.SetScaleY(3.0);
+    pDevice->SetMapMode(aMapMode);
+    const Size aSizePixel(pDevice->LogicToPixel(aArea.SSize()));
+    pDevice->SetOutputSizePixel(aSizePixel);
+    pDevice->SetBackground(Wallpaper(COL_WHITE));
+    pDevice->Erase();
+    static_cast<SwViewShell*>(pWrtShell)->Paint(*pDevice, aArea.SVRect());
+
+    // The formula was painted.
+    const Bitmap aPainted(pDevice->GetBitmap(Point(), aSizePixel));
+    CPPUNIT_ASSERT_GREATER(tools::Long(50), countInkPixels(aPainted));
+
+    // ... as vectors resolved by the device. Before, Graphic::Draw rendered the WMF into a
+    // bitmap of the painted pixel size (kept in the graphic) and blitted it: soft, blurry
+    // glyph edges, worse at high zoom and on high-DPI displays.
+    const Size aRasterised(pGraphic->GetBitmapRef().GetSizePixel());
+    CPPUNIT_ASSERT_LESS(aSizePixel.Width() / 2, aRasterised.Width());
+}
