+/* SPDX-License-Identifier: LicenseRef-HST-Proprietary */
+/* Copyright (c) HASON TECH. HST Office. */
+
+#pragma once
+
+#include <sal/types.h>
+#include <rtl/ustring.hxx>
+#include <svx/svxdllapi.h>
+
+#include <string_view>
+#include <vector>
+
+namespace hst
+{
+/** Vietnamese names for the symbols that office users look for most (check boxes, ticks, arrows,
+    math signs, currency), so the Special Character dialog's search finds them by "hộp kiểm",
+    "dấu tích", "mũi tên", "đồng"... as well as by their English Unicode names.
+
+    Matching ignores case, Vietnamese tone marks and other diacritics (so "hop kiem" finds the same
+    as "hộp kiểm"), and the search text may be any part of a name. */
+class SVX_DLLPUBLIC VietnameseSymbolSearch
+{
+public:
+    explicit VietnameseSymbolSearch(std::u16string_view rSearchText);
+
+    /// True when one of the Vietnamese names of cChar contains the search text.
+    bool matches(sal_uInt32 cChar) const;
+
+    /// Lower case, without diacritics, đ as d, runs of spaces as one space, trimmed.
+    static OUString fold(std::u16string_view rText);
+
+private:
+    std::vector<sal_uInt32> m_aMatches; // sorted
+};
+}
