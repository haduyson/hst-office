+        CPPUNIT_ASSERT(finds(u"HOP KIEM", 0x2610));
+        CPPUNIT_ASSERT(finds(u"dau tich", 0x2713));
+        CPPUNIT_ASSERT(finds(u"o vuong", 0x2610));
+        CPPUNIT_ASSERT(finds(u"kiem", 0x2610)); // part of a name
+    }
+
+    void testOtherSymbols()
+    {
+        CPPUNIT_ASSERT(finds(u"mũi tên phải", 0x2192));
+        CPPUNIT_ASSERT(finds(u"mũi tên", 0x2190));
+        CPPUNIT_ASSERT(!finds(u"mũi tên phải", 0x2190));
+        CPPUNIT_ASSERT(finds(u"đồng", 0x20AB));
+        CPPUNIT_ASSERT(finds(u"vnd", 0x20AB));
+        CPPUNIT_ASSERT(finds(u"số thứ tự", 0x2116));
+        CPPUNIT_ASSERT(finds(u"độ", 0x00B0));
+        CPPUNIT_ASSERT(finds(u"cộng trừ", 0x00B1));
+        CPPUNIT_ASSERT(finds(u"nhỏ hơn hoặc bằng", 0x2264));
+        CPPUNIT_ASSERT(finds(u"lớn hơn hoặc bằng", 0x2265));
+        CPPUNIT_ASSERT(finds(u"khác", 0x2260));
+        CPPUNIT_ASSERT(finds(u"xấp xỉ", 0x2248));
+        CPPUNIT_ASSERT(finds(u"vô cực", 0x221E));
+        CPPUNIT_ASSERT(finds(u"euro", 0x20AC));
+        CPPUNIT_ASSERT(finds(u"bản quyền", 0x00A9));
+    }
+
+    void testNoMatch()
+    {
+        CPPUNIT_ASSERT(!finds(u"", 0x2610));
+        CPPUNIT_ASSERT(!finds(u"   ", 0x2610));
+        CPPUNIT_ASSERT(!finds(u"không có ký hiệu này", 0x2610));
