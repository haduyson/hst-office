+        CPPUNIT_ASSERT(finds(u"dấu tích", 0x2714));
+        CPPUNIT_ASSERT(finds(u"dấu tích", 0x2611));
+        CPPUNIT_ASSERT(finds(u"dấu x", 0x2717));
+        CPPUNIT_ASSERT(finds(u"dấu x", 0x2612));
+        CPPUNIT_ASSERT(!finds(u"dấu x", 0x2610));
+    }
