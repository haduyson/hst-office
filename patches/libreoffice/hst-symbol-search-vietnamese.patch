+/* SPDX-License-Identifier: LicenseRef-HST-Proprietary */
+/* Copyright (c) HASON TECH. HST Office. */
+
+#include "hstsymbolsearch.hxx"
+
+#include <rtl/ustrbuf.hxx>
+#include <unicode/normalizer2.h>
+#include <unicode/uchar.h>
+#include <unicode/unistr.h>
+
+#include <algorithm>
+
+namespace hst
+{
+namespace
+{
+struct SymbolNames
+{
+    sal_uInt32 cChar;
+    std::u16string_view aNames; // '|' between alternative names
+};
+
+// Names as Vietnamese office users say them; the most used meaning first.
+constexpr SymbolNames aSymbolNames[] = {
+    { 0x00A9, u"bản quyền|ký hiệu bản quyền" },
+    { 0x00AE, u"đã đăng ký|nhãn hiệu đã đăng ký" },
+    { 0x00B0, u"độ|ký hiệu độ|độ c" },
+    { 0x00B1, u"cộng trừ|dấu cộng trừ" },
+    { 0x00D7, u"dấu nhân|nhân" },
+    { 0x00F7, u"dấu chia|chia" },
+    { 0x2022, u"chấm tròn|dấu chấm đầu dòng|gạch đầu dòng" },
+    { 0x2116, u"số|số thứ tự|ký hiệu số" },
+    { 0x20AB, u"đồng|đồng việt nam|vnd|tiền việt nam" },
+    { 0x20AC, u"euro|đồng euro" },
+    { 0x2122, u"nhãn hiệu|thương hiệu" },
+    { 0x2190, u"mũi tên trái|mũi tên sang trái" },
+    { 0x2191, u"mũi tên lên|mũi tên đi lên" },
+    { 0x2192, u"mũi tên phải|mũi tên sang phải" },
+    { 0x2193, u"mũi tên xuống|mũi tên đi xuống" },
+    { 0x2194, u"mũi tên hai chiều|mũi tên trái phải" },
+    { 0x21D0, u"mũi tên kép trái" },
+    { 0x21D2, u"mũi tên kép phải|suy ra|kéo theo" },
+    { 0x21D4, u"mũi tên kép hai chiều|tương đương|khi và chỉ khi" },
+    { 0x221E, u"vô cực|vô hạn|vô cùng" },
+    { 0x2248, u"xấp xỉ|gần bằng" },
+    { 0x2260, u"khác|không bằng|dấu khác" },
+    { 0x2264, u"nhỏ hơn hoặc bằng|bé hơn hoặc bằng" },
+    { 0x2265, u"lớn hơn hoặc bằng" },
+    { 0x25A0, u"ô vuông đen|hình vuông đen|ô vuông đặc" },
+    { 0x25A1, u"ô vuông trắng|hình vuông trắng|ô vuông rỗng" },
+    { 0x25CB, u"hình tròn trắng|vòng tròn" },
+    { 0x25CF, u"hình tròn đen|chấm tròn đặc" },
+    { 0x2610, u"hộp kiểm|ô kiểm|ô vuông|ô trống|ô đánh dấu|hộp đánh dấu|ô chọn|hộp chọn|ô tích" },
+    { 0x2611, u"hộp kiểm đã chọn|ô kiểm có dấu tích|ô vuông có dấu tích|ô đã tích|ô đánh dấu|hộp chọn|ô chọn|ô tích" },
+    { 0x2612, u"hộp kiểm dấu x|ô kiểm có dấu x|ô vuông có dấu x|ô đánh dấu|hộp chọn|ô chọn|ô gạch chéo" },
+    { 0x2713, u"dấu tích|dấu kiểm|dấu check|dấu đúng" },
+    { 0x2714, u"dấu tích đậm|dấu kiểm đậm|dấu đúng đậm" },
+    { 0x2717, u"dấu x|dấu nhân chéo|dấu sai|dấu gạch chéo" },
+    { 0x2718, u"dấu x đậm|dấu sai đậm" },
+};
+
+const icu::Normalizer2* decomposer()
+{
+    UErrorCode nError = U_ZERO_ERROR;
+    const icu::Normalizer2* pNfd = icu::Normalizer2::getNFDInstance(nError);
+    return U_SUCCESS(nError) ? pNfd : nullptr;
+}
+}
+
+OUString VietnameseSymbolSearch::fold(std::u16string_view rText)
+{
+    const icu::UnicodeString aSource(false, reinterpret_cast<const UChar*>(rText.data()),
+                                     static_cast<int32_t>(rText.size()));
+    icu::UnicodeString aDecomposed;
+    if (const icu::Normalizer2* pNfd = decomposer())
+    {
+        UErrorCode nError = U_ZERO_ERROR;
+        pNfd->normalize(aSource, aDecomposed, nError);
+        if (U_FAILURE(nError))
+            aDecomposed = aSource;
+    }
+    else
+        aDecomposed = aSource;
+
+    OUStringBuffer aFolded(aDecomposed.length());
+    bool bPendingSpace = false;
+    for (int32_t i = 0; i < aDecomposed.length(); i = aDecomposed.moveIndex32(i, 1))
+    {
+        UChar32 c = aDecomposed.char32At(i);
+        if (U_GET_GC_MASK(c) & U_GC_M_MASK) // tone marks and other combining marks
+            continue;
+        if (u_isUWhiteSpace(c))
+        {
+            bPendingSpace = !aFolded.isEmpty();
+            continue;
+        }
+        c = u_tolower(c);
+        if (c == 0x0111) // đ has no decomposition
+            c = 'd';
+        if (bPendingSpace)
+        {
+            aFolded.append(u' ');
+            bPendingSpace = false;
+        }
+        aFolded.appendUtf32(static_cast<sal_uInt32>(c));
+    }
+    return aFolded.makeStringAndClear();
+}
+
+VietnameseSymbolSearch::VietnameseSymbolSearch(std::u16string_view rSearchText)
+{
+    const OUString aQuery = fold(rSearchText);
+    if (aQuery.isEmpty())
+        return;
+
+    for (const SymbolNames& rEntry : aSymbolNames)
+    {
+        // The names are matched one by one, so a query never spans two alternatives.
+        const OUString aNames = fold(rEntry.aNames);
+        sal_Int32 nIndex = 0;
+        do
+        {
+            if (aNames.getToken(0, '|', nIndex).indexOf(aQuery) >= 0)
+            {
+                m_aMatches.push_back(rEntry.cChar);
+                break;
+            }
+        } while (nIndex >= 0);
+    }
+    std::sort(m_aMatches.begin(), m_aMatches.end());
+}
+
+bool VietnameseSymbolSearch::matches(sal_uInt32 cChar) const
+{
+    return std::binary_search(m_aMatches.begin(), m_aMatches.end(), cChar);
+}
+}
