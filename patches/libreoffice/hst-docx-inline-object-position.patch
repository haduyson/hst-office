+void DomainMapper_Impl::applyRunPositionToInlineObject(
+    const uno::Reference<beans::XPropertySet>& xObject, sal_Int32 nHeight)
+{
+    const auto& rDeferred = m_StreamStateStack.top().deferredCharacterProperties;
+    auto it = rDeferred.find(NS_ooxml::LN_EG_RPrBase_position);
+    sal_Int32 nPosition = 0; // half-points, positive raises
+    if (!xObject.is() || it == rDeferred.end() || !(it->second >>= nPosition) || !nPosition)
+        return;
+    try
+    {
+        text::TextContentAnchorType eAnchor = text::TextContentAnchorType_AT_PARAGRAPH;
+        xObject->getPropertyValue(getPropertyName(PROP_ANCHOR_TYPE)) >>= eAnchor;
+        if (eAnchor != text::TextContentAnchorType_AS_CHARACTER)
+            return;
+        // VertOrient NONE: VertOrientPosition is the object's top relative to the baseline, downwards.
+        xObject->setPropertyValue(getPropertyName(PROP_VERT_ORIENT),
+                                  uno::Any(text::VertOrientation::NONE));
+        xObject->setPropertyValue(getPropertyName(PROP_VERT_ORIENT_POSITION),
+                                  uno::Any(sal_Int32(-nHeight - nPosition * 2540 / 144)));
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("writerfilter.dmapper", "applyRunPositionToInlineObject");
+    }
+}
