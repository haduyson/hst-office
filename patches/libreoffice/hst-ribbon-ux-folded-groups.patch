--- a/vcl/inc/HstRibbonRegrow.hxx
+++ b/vcl/inc/HstRibbonRegrow.hxx
@@ -20,6 +20,11 @@
 //      (k as small as possible) collapse when the row does not fit with every other group at its
 //      smallest shown state. The collapsed groups at a width are therefore always the least used ones,
 //      and a wider window never collapses a group that a narrower one shows (monotonic);
+//   1b. owner decision (13/11/2026): the room left after step 1 is not left empty. A collapsed group that fits
+//      in it at its smallest shown state opens again, out of the usage order, the one that takes the most
+//      room first, as long as any fits. A smaller, less used group may then be open beside the button of a
+//      larger, more used one, and a wider window may close a group a narrower one showed (no longer
+//      monotonic), but no group is a button beside room enough to show it;
 //   2. the shown groups then grow, most used first, into the largest state that still fits. A ladder may
 //      give another order for this (its growth order, HstRibbonLadders.hxx): Sheets' Font group is the
 //      last to collapse, yet the first to give up its labels, so Styles, Cells and Editing keep theirs.
@@ -111,6 +116,28 @@
         aLayout.fits = false;
         return aLayout;
     }
+    // 1b. the room left opens the collapsed groups that fit in it, the one taking the most room first
+    for (;;)
+    {
+        std::size_t nBest = rGroups.size();
+        long nBestGain = 0;
+        for (std::size_t i = 0; i < rGroups.size(); ++i)
+        {
+            if (aLayout.states[i] != RegrowCollapsedState)
+                continue;
+            const std::size_t nShown = smallestShownState(rGroups[i]);
+            const long nGain = widthOf(rGroups[i], nShown) - widthOf(rGroups[i], RegrowCollapsedState);
+            if (nRow + nGain <= nAvailable && (nBest == rGroups.size() || nGain > nBestGain))
+            {
+                nBest = i;
+                nBestGain = nGain;
+            }
+        }
+        if (nBest == rGroups.size())
+            break;
+        aLayout.states[nBest] = smallestShownState(rGroups[nBest]);
+        nRow += nBestGain;
+    }
     // 2. the shown groups grow back, most used first (or in the ladder's growth order)
     for (std::size_t nGroup : growthOrder(rGroups.size(), rPriority, rGrowth))
