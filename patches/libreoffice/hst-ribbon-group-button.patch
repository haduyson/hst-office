+Size DropdownBox::calculateRequisition() const
+{
+    // HST Office: the block is as high with its content hidden as with it shown, so the ribbon (the
+    // tallest tab page) keeps its height when the block gives way to the groups
+    Size aSize = VclHBox::calculateRequisition();
+    for (vcl::Window* pChild = GetWindow(GetWindowType::FirstChild); pChild;
+         pChild = pChild->GetWindow(GetWindowType::Next))
+        if (pChild != m_pButton && !pChild->IsVisible())
+            aSize.setHeight(std::max(aSize.Height(), getLayoutRequisition(*pChild).Height()));
+    return aSize;
+}
