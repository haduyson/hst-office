+std::vector<vcl::Window*> PriorityMergedHBox::HstGroups() const
+{
+    std::vector<vcl::Window*> aGroups;
+    for (vcl::Window* pChild = GetWindow(GetWindowType::FirstChild); pChild;
+         pChild = pChild->GetWindow(GetWindowType::Next))
+        if (pChild != m_pButton && !HstIsGroupButton(pChild))
+            aGroups.push_back(pChild);
+    return aGroups;
+}
+
+bool PriorityMergedHBox::HstIsGroupButton(const vcl::Window* pWindow) const
+{
+    for (const auto& [pGroup, xButton] : m_aHstGroupButtons)
+        if (xButton.get() == pWindow)
+            return true;
+    return false;
+}
+
+bool PriorityMergedHBox::HstIsCollapsed(const vcl::Window* pGroup) const
+{
+    const auto it = m_aHstStates.find(const_cast<vcl::Window*>(pGroup));
+    if (it == m_aHstStates.end() || it->second != hst::ribbon::GroupCollapsed)
+        return false;
+    const auto itButton = m_aHstGroupButtons.find(const_cast<vcl::Window*>(pGroup));
+    return itButton != m_aHstGroupButtons.end() && itButton->second;
+}
+
+bool PriorityMergedHBox::HstIsFolded(const vcl::Window* pWindow) const
+{
+    if (pWindow->IsVisible() || HstIsGroupButton(pWindow))
+        return false;
+    if (HstIsCollapsed(pWindow))
+        return !m_aHstGroupButtons.find(const_cast<vcl::Window*>(pWindow))->second->IsVisible();
+    return true;
+}
+
+PushButton& PriorityMergedHBox::HstGroupButton(vcl::Window& rGroup)
+{
+    VclPtr<PushButton>& rButton = m_aHstGroupButtons[&rGroup];
+    if (!rButton)
+    {
+        // the caption and an arrow, as tall as the groups, as Office shows a collapsed group
+        rButton = VclPtr<PushButton>::Create(this, WB_FLATBUTTON | WB_CENTER | WB_VCENTER);
+        const OUString aCaption = hst::ribbon::GroupCaption(rGroup);
+        rButton->SetText(aCaption + u" \u25BE"); // ▾, as the gallery buttons
+        rButton->SetAccessibleName(aCaption);
+        rButton->SetQuickHelpText(aCaption);
+        rButton->set_valign(VclAlign::Fill);
+        rButton->set_vexpand(true);
+        rButton->SetClickHdl(LINK(this, PriorityMergedHBox, HstGroupClickHdl));
+        rButton->Hide();
+    }
+    return *rButton;
+}
+
+IMPL_LINK(PriorityMergedHBox, HstGroupClickHdl, Button*, pButton, void)
+{
+    vcl::Window* pGroup = nullptr;
+    for (const auto& [pCandidate, xButton] : m_aHstGroupButtons)
+        if (xButton.get() == pButton)
+            pGroup = pCandidate;
+    if (!pGroup || pGroup->GetParent() != this)
+        return;
+    if (m_pPopup)
+        m_pPopup.disposeAndClear();
+    // the group opens at its full size below its button; closing the popup hands it back and lays
+    // this box out again (NotebookbarPopup::PopupModeEnd), which collapses it again
+    m_pPopup = VclPtr<NotebookbarPopup>::Create(this);
+    hst::ribbon::SetGroupState(*pGroup, hst::ribbon::GroupLarge);
+    pGroup->Show();
+    pGroup->SetParent(m_pPopup->getBox());
+    m_pPopup->hideSeparators(true);
+    const tools::Long x = pButton->GetPosPixel().getX();
+    const tools::Long y = pButton->GetPosPixel().getY() + pButton->GetSizePixel().Height();
+    m_pPopup->StartPopupMode(tools::Rectangle(x, y, x, y),
+                             FloatWinPopupFlags::Down | FloatWinPopupFlags::GrabFocus
+                                 | FloatWinPopupFlags::AllMouseButtonClose);
+}
