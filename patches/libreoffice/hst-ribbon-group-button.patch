+OUString GroupCaption(vcl::Window& rGroup)
+{
+    vcl::Window* pLabel = rGroup.GetAccessibleRelationLabeledBy();
+    std::vector<vcl::Window*> aTodo{ &rGroup };
+    while (!pLabel && !aTodo.empty())
+    {
+        vcl::Window* pWindow = aTodo.back();
+        aTodo.pop_back();
+        for (vcl::Window* pChild = pWindow->GetWindow(GetWindowType::FirstChild); pChild && !pLabel;
+             pChild = pChild->GetWindow(GetWindowType::Next))
+        {
+            if (dynamic_cast<FixedText*>(pChild) && !pChild->GetText().isEmpty())
+                pLabel = pChild;
+            else
+                aTodo.push_back(pChild);
+        }
+    }
+    return pLabel ? pLabel->GetText().replaceAll("~", "") : OUString();
+}
