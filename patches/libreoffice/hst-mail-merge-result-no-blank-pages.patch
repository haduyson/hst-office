+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ * Copyright (C) HASON TECH. HST Office.
+ */
+
+#pragma once
+
+#include <rtl/ustring.hxx>
+
+class SwRootFrame;
+
+namespace hst::layout
+{
+/// User-defined document property set on the documents HST's mail merge produces ("Trộn thư").
+inline constexpr OUString MERGE_RESULT = u"HSTMergeResult"_ustr;
+
+/** Whether a page that restarts the page numbering is a right or left page by that number (Writer: an odd
+    number is a right page, so a blank page is inserted when it would land on a left page).
+
+    False for a mail-merge result (MERGE_RESULT true): there each recipient restarts at page 1, and like Word
+    the page then keeps its place, so no blank page is inserted between recipients. A page style that is
+    left-only or right-only still decides the side, as before. */
+bool SideByPageNumber(const SwRootFrame& rLayout);
+}
