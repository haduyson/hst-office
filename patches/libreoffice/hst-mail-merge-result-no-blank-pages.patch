+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ * Copyright (C) HASON TECH. HST Office.
+ */
+
+#include "hstmergeresultlayout.hxx"
+
+#include <com/sun/star/beans/XPropertySet.hpp>
+#include <com/sun/star/document/XDocumentProperties.hpp>
+
+#include <doc.hxx>
+#include <docsh.hxx>
+#include <frmfmt.hxx>
+#include <rootfrm.hxx>
+
+using namespace css;
+
+namespace hst::layout
+{
+bool SideByPageNumber(const SwRootFrame& rLayout)
+{
+    const SwFrameFormat* pFormat = rLayout.GetFormat();
+    const SwDocShell* pShell = pFormat ? pFormat->GetDoc().GetDocShell() : nullptr;
+    if (!pShell)
+        return true;
+    try
+    {
+        const uno::Reference<document::XDocumentProperties> xProperties = pShell->getDocProperties();
+        const uno::Reference<beans::XPropertySet> xUser(
+            xProperties.is() ? xProperties->getUserDefinedProperties() : nullptr, uno::UNO_QUERY);
+        if (!xUser.is() || !xUser->getPropertySetInfo()->hasPropertyByName(MERGE_RESULT))
+            return true;
+        bool bMergeResult = false;
+        xUser->getPropertyValue(MERGE_RESULT) >>= bMergeResult;
+        return !bMergeResult;
+    }
+    catch (const uno::Exception&)
+    {
+        return true; // properties not readable (document being built or closed): Writer's rule
+    }
+}
+}
