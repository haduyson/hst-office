+namespace
+{
+/// The pages of a merged document of three recipients: each one starts on a new page with the given page
+/// style and restarts the page numbering at 1, as the mail merge writes it (and Word, pgNumType start=1).
+class HstMergeResultPagesTest : public SwModelTestBase
+{
+public:
+    HstMergeResultPagesTest()
+        : SwModelTestBase(u"/sw/qa/extras/hst/data/"_ustr)
+    {
+    }
+
+protected:
+    int mergedPages(bool bMergeResult, const OUString& rPageStyle)
+    {
+        if (mxComponent.is()) // the previous document of the same test
+        {
+            mxComponent->dispose();
+            mxComponent.clear();
+        }
+        createSwDoc();
+        if (bMergeResult) // as the HST mail merge marks the documents it produces
+        {
+            uno::Reference<document::XDocumentPropertiesSupplier> xSupplier(mxComponent, uno::UNO_QUERY_THROW);
+            uno::Reference<beans::XPropertyContainer> xUser
+                = xSupplier->getDocumentProperties()->getUserDefinedProperties();
+            xUser->addProperty(u"HSTMergeResult"_ustr, beans::PropertyAttribute::REMOVABLE, uno::Any(true));
+        }
+        uno::Reference<text::XTextDocument> xDocument(mxComponent, uno::UNO_QUERY_THROW);
+        uno::Reference<text::XText> xText = xDocument->getText();
+        uno::Reference<text::XTextCursor> xCursor = xText->createTextCursor();
+        for (int nRecipient = 1; nRecipient <= 3; ++nRecipient)
+        {
+            if (nRecipient > 1)
+            {
+                xText->insertControlCharacter(xCursor, text::ControlCharacter::PARAGRAPH_BREAK, false);
+                uno::Reference<beans::XPropertySet> xParagraph(xCursor, uno::UNO_QUERY_THROW);
+                xParagraph->setPropertyValue(u"PageDescName"_ustr, uno::Any(rPageStyle));
+                xParagraph->setPropertyValue(u"PageNumberOffset"_ustr, uno::Any(sal_Int16(1)));
+            }
+            xText->insertString(xCursor, "Kính gửi người nhận " + OUString::number(nRecipient), false);
+        }
+        calcLayout();
+        return getPages();
+    }
+};
+
+CPPUNIT_TEST_FIXTURE(HstMergeResultPagesTest, testMergeResultHasNoBlankPages)
+{
+    // like Word: one page per recipient, page numbers 1, 1, 1
+    CPPUNIT_ASSERT_EQUAL(3, mergedPages(true, u"Standard"_ustr));
+}
+
+CPPUNIT_TEST_FIXTURE(HstMergeResultPagesTest, testOtherDocumentsKeepWriterBlankPages)
+{
+    // without the mark: Writer's rule, page 1 is a right page, so a blank page before recipients 2 and 3
+    CPPUNIT_ASSERT_EQUAL(5, mergedPages(false, u"Standard"_ustr));
+}
+
+CPPUNIT_TEST_FIXTURE(HstMergeResultPagesTest, testRightOnlyPageStyleUnchanged)
+{
+    // a right-only page style decides the side in a merge result too: the same pages as without the mark
+    const int nWriter = mergedPages(false, u"Right Page"_ustr);
+    CPPUNIT_ASSERT_EQUAL(nWriter, mergedPages(true, u"Right Page"_ustr));
+    CPPUNIT_ASSERT_EQUAL(5, nWriter);
+}
+}
+
+CPPUNIT_PLUGIN_IMPLEMENT();
