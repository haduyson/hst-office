+namespace hst::autosave
+{
+/// the state of .uno:HstAutoSave changed (a save, a toggle, read only...): the toggle reads its document again
+class ToggleStatus final : public SfxStatusListener
+{
+public:
+    ToggleStatus(const uno::Reference<frame::XDispatchProvider>& xProvider, HstAutoSaveToggle* pToggle)
+        : SfxStatusListener(xProvider, SID_HST_AUTOSAVE, u".uno:HstAutoSave"_ustr)
+        , m_xToggle(pToggle)
+    {
+    }
+
+    void StateChangedAtStatusListener(SfxItemState, const SfxPoolItem*) override
+    {
+        if (m_xToggle && !m_xToggle->isDisposed())
+            m_xToggle->Refresh();
+    }
+
+    void Forget() { m_xToggle.reset(); }
+
+private:
+    VclPtr<HstAutoSaveToggle> m_xToggle;
+};
+}
+
+using hst::autosave::State;
+
+namespace
+{
+std::vector<HstAutoSaveToggle*>& liveToggles()
+{
+    static std::vector<HstAutoSaveToggle*> aToggles;
+    return aToggles;
+}
+
+tools::Long px(const OutputDevice& rDev, double fLogical)
+{
+    return std::max<tools::Long>(1, std::lround(fLogical * rDev.GetDPIScaleFactor()));
+}
+
+// the HST accent (0,114,187) of the switch when it is on; amber when paused
+constexpr Color ACCENT(0x00, 0x72, 0xBB);
+constexpr Color PAUSED(0xC9, 0x7A, 0x00);
+constexpr double HEIGHT = 28, SWITCH_W = 34, SWITCH_H = 16, PAD = 6, GAP = 6;
+
+/** The toggle for assistive technology: a toggle button, checked when AutoSave saves the document, with the
+    tooltip (the reason when dimmed) as its description; its one action switches it as a click does. */
+class ToggleAccessible final
+    : public cppu::ImplInheritanceHelper<VCLXAccessibleComponent, accessibility::XAccessibleAction>
+{
+public:
+    explicit ToggleAccessible(HstAutoSaveToggle* pToggle)
+        : ImplInheritanceHelper(pToggle)
+    {
+    }
+
+    void FillAccessibleStateSet(sal_Int64& rStateSet) override
+    {
+        VCLXAccessibleComponent::FillAccessibleStateSet(rStateSet);
+        auto* pToggle = dynamic_cast<HstAutoSaveToggle*>(GetWindow());
+        if (!pToggle)
+            return;
+        rStateSet |= accessibility::AccessibleStateType::CHECKABLE;
+        if (pToggle->IsChecked())
+            rStateSet |= accessibility::AccessibleStateType::CHECKED;
+        if (!pToggle->IsSwitchable())
+            rStateSet &= ~(accessibility::AccessibleStateType::ENABLED | accessibility::AccessibleStateType::SENSITIVE);
+    }
+
+    sal_Int32 SAL_CALL getAccessibleActionCount() override { return 1; }
+
+    sal_Bool SAL_CALL doAccessibleAction(sal_Int32 nIndex) override
+    {
+        SolarMutexGuard aGuard;
+        if (nIndex != 0)
+            throw lang::IndexOutOfBoundsException();
+        auto* pToggle = dynamic_cast<HstAutoSaveToggle*>(GetWindow());
+        if (!pToggle || pToggle->isDisposed() || !pToggle->IsSwitchable())
+            return false;
+        pToggle->Activate();
+        return true;
+    }
+
+    OUString SAL_CALL getAccessibleActionDescription(sal_Int32 nIndex) override
+    {
+        if (nIndex != 0)
+            throw lang::IndexOutOfBoundsException();
+        return RID_STR_ACC_ACTION_CLICK;
+    }
+
+    uno::Reference<accessibility::XAccessibleKeyBinding> SAL_CALL getAccessibleActionKeyBinding(sal_Int32 nIndex) override
+    {
+        if (nIndex != 0)
+            throw lang::IndexOutOfBoundsException();
+        return {};
+    }
+};
+}
+
+HstAutoSaveToggle::HstAutoSaveToggle(vcl::Window* pParent)
+    : Control(pParent, WB_TABSTOP)
+    , m_eState(State::Unsupported)
+{
+    set_id(u"hst-autosave-toggle"_ustr);
+    SetPaintTransparent(true);
+    SetAccessibleRole(accessibility::AccessibleRole::TOGGLE_BUTTON);
+    SetAccessibleName(SfxResId(STR_HST_AUTOSAVE));
+    liveToggles().push_back(this);
+}
+
+HstAutoSaveToggle::~HstAutoSaveToggle() { disposeOnce(); }
+
+void HstAutoSaveToggle::dispose()
+{
+    std::erase(liveToggles(), this);
+    if (m_xStatus.is())
+    {
+        m_xStatus->Forget();
+        m_xStatus->UnBind();
+        m_xStatus->dispose();
+        m_xStatus.clear();
+    }
+    m_xFrame.clear();
+    Control::dispose();
+}
+
+void HstAutoSaveToggle::SetFrame(const uno::Reference<frame::XFrame>& xFrame)
+{
+    if (xFrame == m_xFrame && m_xStatus.is())
+        return;
+    if (m_xStatus.is())
+    {
+        m_xStatus->Forget();
+        m_xStatus->UnBind();
+        m_xStatus->dispose();
+        m_xStatus.clear();
+    }
+    m_xFrame = xFrame;
+    uno::Reference<frame::XDispatchProvider> xProvider(xFrame, uno::UNO_QUERY);
+    if (xProvider.is())
+    {
+        m_xStatus = new hst::autosave::ToggleStatus(xProvider, this);
+        m_xStatus->ReBind(); // the first state arrives at once
+    }
+    ApplyShown();
+    Refresh();
+}
+
+void HstAutoSaveToggle::Refresh()
+{
+    State eState = State::Unsupported;
+    try
+    {
+        uno::Reference<frame::XController> xController;
+        if (m_xFrame.is())
+            xController = m_xFrame->getController();
+        uno::Reference<frame::XModel> xModel;
+        if (xController.is())
+            xModel = xController->getModel();
+        if (SfxObjectShell* pShell = xModel.is() ? SfxObjectShell::GetShellFromComponent(xModel) : nullptr)
+            eState = hst::autosave::stateOf(*pShell);
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("sfx.notebookbar", "AutoSave toggle state");
+    }
+    if (eState == m_eState && !GetQuickHelpText().isEmpty())
+        return;
+    m_eState = eState;
+    const OUString aTip = hst::autosave::tooltipOf(eState);
+    SetQuickHelpText(aTip);
+    SetAccessibleDescription(aTip);
+    ApplyShown();
+    Invalidate();
+}
+
+bool HstAutoSaveToggle::IsSwitchable() const { return hst::autosave::isSwitchable(m_eState); }
+
+bool HstAutoSaveToggle::IsChecked() const { return hst::autosave::isActive(m_eState); }
+
+void HstAutoSaveToggle::Activate()
+{
+    if (!IsSwitchable() || !m_xFrame.is())
+        return;
+    comphelper::dispatchCommand(u".uno:HstAutoSave"_ustr, m_xFrame, {});
+    Refresh();
+}
+
+bool HstAutoSaveToggle::Shown()
+{
+    try
+    {
+        return officecfg::Office::HSTRibbon::ShowAutoSaveToggle::get();
+    }
+    catch (const uno::Exception&)
+    {
+        return true; // no configuration (unit tests): the shipped default
+    }
+}
+
+void HstAutoSaveToggle::SetShown(bool bShown)
+{
+    try
+    {
+        std::shared_ptr<comphelper::ConfigurationChanges> xChanges(comphelper::ConfigurationChanges::create());
+        officecfg::Office::HSTRibbon::ShowAutoSaveToggle::set(bShown, xChanges);
+        xChanges->commit();
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("sfx.notebookbar", "HSTRibbon/ShowAutoSaveToggle");
+    }
+    for (HstAutoSaveToggle* pToggle : liveToggles())
+        pToggle->ApplyShown();
+}
+
+void HstAutoSaveToggle::ApplyShown()
+{
+    const bool bShow = Shown() && m_eState != State::Unsupported;
+    if (bShow == IsVisible())
+        return;
+    Show(bShow);
+    // the tab row is laid out again without (or with) the cell
+    if (vcl::Window* pRow = GetParent())
+    {
+        pRow->Resize();
+        pRow->Invalidate();
+    }
+}
+
+Size HstAutoSaveToggle::GetOptimalSize() const
+{
+    // measured in the font Paint draws with
+    OutputDevice& rDev = *const_cast<HstAutoSaveToggle*>(this)->GetOutDev();
+    rDev.Push(vcl::PushFlags::FONT);
+    rDev.SetFont(rDev.GetSettings().GetStyleSettings().GetAppFont());
+    tools::Long nValue = 0;
+    for (TranslateId aId : { STR_HST_AUTOSAVE_ON, STR_HST_AUTOSAVE_OFF, STR_HST_AUTOSAVE_PAUSED })
+        nValue = std::max(nValue, rDev.GetTextWidth(SfxResId(aId)));
+    const Size aSize(px(rDev, PAD) + rDev.GetTextWidth(SfxResId(STR_HST_AUTOSAVE)) + px(rDev, GAP)
+                         + px(rDev, SWITCH_W) + px(rDev, GAP) + nValue + px(rDev, PAD),
+                     std::max(px(rDev, HEIGHT), rDev.GetTextHeight() + px(rDev, 4)));
+    rDev.Pop();
+    return aSize;
+}
+
+void HstAutoSaveToggle::Paint(vcl::RenderContext& rDev, const tools::Rectangle&)
+{
+    const StyleSettings& rStyle = rDev.GetSettings().GetStyleSettings();
+    const bool bSystem = !hst::ribbon::ownerDrawAllowed(rStyle); // high contrast: the system colours
+    const hst::ribbon::Palette aPalette = hst::ribbon::paletteFor(rStyle);
+    const Size aOut = GetOutputSizePixel();
+    const bool bEnabled = IsSwitchable();
+    const bool bOn = IsChecked();
+    const bool bPaused = m_eState == State::Paused || m_eState == State::PausedConflict;
+    const bool bCompact = aOut.Width() < GetOptimalSize().Width();
+
+    rDev.Push(vcl::PushFlags::LINECOLOR | vcl::PushFlags::FILLCOLOR | vcl::PushFlags::FONT | vcl::PushFlags::TEXTCOLOR);
+    vcl::Font aFont(rStyle.GetAppFont());
+    rDev.SetFont(aFont);
+
+    // a dimmed toggle keeps about 40 % of its strength, as the mockup
+    Color aText = bSystem ? rStyle.GetButtonTextColor() : rStyle.GetLabelTextColor();
+    if (!bEnabled)
+    {
+        if (bSystem)
+            aText = rStyle.GetDisableColor();
+        else
+            aText.Merge(rStyle.GetDialogColor(), 102);
+    }
+
+    const tools::Long nRadius = px(rDev, 4);
+    const tools::Rectangle aCell(Point(), Size(aOut.Width() - 1, aOut.Height() - 1));
+    if (m_bHover && bEnabled)
+    {
+        if (bSystem) // high contrast: an outline in the text colour
+        {
+            rDev.SetFillColor();
+            rDev.SetLineColor(rStyle.GetButtonTextColor());
+        }
+        else
+        {
+            rDev.SetFillColor(aPalette.aHover);
+            rDev.SetLineColor(aPalette.aHover);
+        }
+        rDev.DrawRect(aCell, nRadius, nRadius);
+    }
+
+    const tools::Long nSwitchW = px(rDev, SWITCH_W), nSwitchH = px(rDev, SWITCH_H);
+    tools::Long nX = px(rDev, PAD);
+    if (bCompact)
+        nX = std::max<tools::Long>(0, (aOut.Width() - nSwitchW) / 2);
+    else
+    {
+        const OUString aLabel = SfxResId(STR_HST_AUTOSAVE);
+        rDev.SetTextColor(aText);
+        rDev.DrawText(Point(nX, (aOut.Height() - rDev.GetTextHeight()) / 2), aLabel);
+        nX += rDev.GetTextWidth(aLabel) + px(rDev, GAP);
+    }
+
+    // the switch: a rounded track and a round knob, right when on, left when off
+    const tools::Rectangle aTrack(Point(nX, (aOut.Height() - nSwitchH) / 2), Size(nSwitchW, nSwitchH));
+    const tools::Long nTrackRadius = nSwitchH / 2;
+    const tools::Long nInset = std::max<tools::Long>(2, px(rDev, 3));
+    const tools::Long nKnob = nSwitchH - 2 * nInset;
+    const bool bKnobRight = bOn || bPaused;
+    Color aFill, aBorder, aKnob;
+    if (bSystem)
+    {
+        aBorder = bEnabled ? rStyle.GetButtonTextColor() : rStyle.GetDisableColor();
+        aFill = bOn || bPaused ? (bEnabled ? rStyle.GetHighlightColor() : rStyle.GetDisableColor()) : COL_TRANSPARENT;
+        aKnob = bOn || bPaused ? rStyle.GetHighlightTextColor() : aBorder;
+    }
+    else
+    {
+        const bool bDark = rStyle.GetDialogColor().IsDark();
+        aBorder = bOn ? ACCENT : bPaused ? PAUSED : (bDark ? Color(0xB0, 0xB8, 0xC4) : Color(0x60, 0x6B, 0x78));
+        aFill = bOn ? ACCENT : bPaused ? PAUSED : COL_TRANSPARENT;
+        aKnob = bOn || bPaused ? COL_WHITE : aBorder;
+        if (!bEnabled)
+        {
+            aBorder.Merge(rStyle.GetDialogColor(), 102);
+            aKnob.Merge(rStyle.GetDialogColor(), 102);
+            if (aFill != COL_TRANSPARENT)
+                aFill.Merge(rStyle.GetDialogColor(), 102);
+        }
+    }
+    rDev.SetLineColor(aBorder);
+    if (aFill == COL_TRANSPARENT)
+        rDev.SetFillColor();
+    else
+        rDev.SetFillColor(aFill);
+    rDev.DrawRect(aTrack, nTrackRadius, nTrackRadius);
+    const tools::Long nKnobX = bKnobRight ? aTrack.Right() - nInset - nKnob + 1 : aTrack.Left() + nInset;
+    rDev.SetLineColor(aKnob);
+    rDev.SetFillColor(aKnob);
+    rDev.DrawEllipse(tools::Rectangle(Point(nKnobX, aTrack.Top() + nInset), Size(nKnob, nKnob)));
+
+    if (!bCompact)
+    {
+        nX += nSwitchW + px(rDev, GAP);
+        rDev.SetTextColor(aText);
+        rDev.DrawText(Point(nX, (aOut.Height() - rDev.GetTextHeight()) / 2), hst::autosave::valueOf(m_eState));
+    }
+
+    if (HasFocus())
+    {
+        rDev.SetFillColor();
+        rDev.SetLineColor(bSystem ? rStyle.GetHighlightColor() : aPalette.aTabAccent);
+        rDev.DrawRect(tools::Rectangle(Point(1, 1), Size(aOut.Width() - 3, aOut.Height() - 3)), nRadius, nRadius);
+    }
+    rDev.Pop();
+}
+
+void HstAutoSaveToggle::MouseMove(const MouseEvent& rEvt)
+{
+    const bool bHover = !rEvt.IsLeaveWindow();
+    if (bHover != m_bHover)
+    {
+        m_bHover = bHover;
+        Invalidate();
+    }
+    Control::MouseMove(rEvt);
+}
+
+void HstAutoSaveToggle::MouseButtonUp(const MouseEvent& rEvt)
+{
+    if (rEvt.IsLeft() && tools::Rectangle(Point(), GetOutputSizePixel()).Contains(rEvt.GetPosPixel()))
+    {
+        Activate();
+        return;
+    }
+    Control::MouseButtonUp(rEvt);
+}
+
+void HstAutoSaveToggle::KeyInput(const KeyEvent& rEvt)
+{
+    const vcl::KeyCode& rKey = rEvt.GetKeyCode();
+    if (!rKey.GetModifier() && (rKey.GetCode() == KEY_RETURN || rKey.GetCode() == KEY_SPACE))
+    {
+        Activate();
+        return;
+    }
+    Control::KeyInput(rEvt);
+}
+
+void HstAutoSaveToggle::GetFocus()
+{
+    Control::GetFocus();
+    Invalidate();
+}
+
+void HstAutoSaveToggle::LoseFocus()
+{
+    Control::LoseFocus();
+    Invalidate();
+}
+
+void HstAutoSaveToggle::DataChanged(const DataChangedEvent& rEvt)
+{
+    Control::DataChanged(rEvt);
+    if (rEvt.GetType() == DataChangedEventType::SETTINGS)
+    {
+        Invalidate(); // light/dark, high contrast and the UI font follow the system
+        if (vcl::Window* pRow = GetParent())
+            pRow->Resize();
+    }
+}
+
+rtl::Reference<comphelper::OAccessible> HstAutoSaveToggle::CreateAccessible()
+{
+    return new ToggleAccessible(this);
+}
