+#include <vcl/ctrl.hxx>
+
+class SfxStatusListener;
+namespace hst::autosave
+{
+enum class State : sal_uInt8;
+class ToggleStatus;
+}
+
+/** HST Office (1.0.3, owner decision 21/11/2026): the "Tự động lưu" toggle, a fixed cell at the start of the ribbon's
+    tab row before the quick access toolbar (child id "hst-autosave-toggle", placed by
+    NotebookbarTabControlBase::ImplPlaceTabs). It shows "Tự động lưu", a sliding switch and "Bật", "Tắt" or
+    "Tạm dừng" for the document of its frame (hstuserautosave.hxx), dimmed with the reason in its tooltip when the
+    document cannot save itself. A click, Space or Enter runs .uno:HstAutoSave. Drawn in the ribbon palette, light
+    and dark, scaled with the DPI; in high contrast mode in the system colours. No icon of any other suite.
+    In a row too short for the labels only the switch is drawn. "Hiện Tự động lưu" of the quick access ▾ menu
+    (HSTRibbon/ShowAutoSaveToggle) hides it in every window. */
+class HstAutoSaveToggle final : public Control
+{
+public:
+    explicit HstAutoSaveToggle(vcl::Window* pParent);
+    virtual ~HstAutoSaveToggle() override;
+    virtual void dispose() override;
+
+    void SetFrame(const css::uno::Reference<css::frame::XFrame>& xFrame);
+    /// read the document's state again (status listener, settings changes)
+    void Refresh();
+    /// what a click does: switch the document's AutoSave when it can be switched
+    void Activate();
+    bool IsSwitchable() const;
+    bool IsChecked() const;
+
+    /// HSTRibbon/ShowAutoSaveToggle; storing it shows or hides the toggle of every window
+    static bool Shown();
+    static void SetShown(bool bShown);
+
+    virtual Size GetOptimalSize() const override;
+    virtual void Paint(vcl::RenderContext& rDev, const tools::Rectangle& rRect) override;
+    virtual void MouseMove(const MouseEvent& rEvt) override;
+    virtual void MouseButtonUp(const MouseEvent& rEvt) override;
+    virtual void KeyInput(const KeyEvent& rEvt) override;
+    virtual void GetFocus() override;
+    virtual void LoseFocus() override;
+    virtual void DataChanged(const DataChangedEvent& rEvt) override;
+    virtual rtl::Reference<comphelper::OAccessible> CreateAccessible() override;
+
