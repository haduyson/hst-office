+/* HST Office: every comment used to parse the whole comments.xml again (only the comment with the
+   wanted id is forwarded), so N comments cost O(N^2): 2000 comments froze the import for over a
+   minute. comments.xml is now read once and cut into its top-level <w:comment> elements; each
+   comment parses a small document made of the original prolog and root start tag, the elements
+   with its id (in their order) and the root end tag. Anything unexpected (UTF-16, a DTD subset,
+   another top-level element, unbalanced markup) keeps the old full parse. */
+struct OOXMLDocument::CommentParts
+{
+    std::vector<sal_Int8> aData; // the whole part
+    sal_Int32 nHeadEnd = 0; // end of the root start tag
+    sal_Int32 nTailStart = 0; // start of the root end tag
+    std::unordered_map<sal_Int32, std::vector<std::pair<sal_Int32, sal_Int32>>> aRanges;
+    bool bValid = false;
+};
+
+namespace
+{
+bool lcl_startsWith(const std::vector<sal_Int8>& r, size_t i, std::string_view s)
+{
+    return i + s.size() <= r.size() && std::equal(s.begin(), s.end(), r.begin() + i);
+}
+
+// index after the markup starting at r[i] == '<': a start/end tag (quotes honoured), a comment,
+// CDATA or a processing instruction; 0 when it is not closed or is a DTD with a subset
+size_t lcl_markupEnd(const std::vector<sal_Int8>& r, size_t i, bool& rSelfClosing)
+{
+    rSelfClosing = false;
+    std::string_view aClose;
+    if (lcl_startsWith(r, i, "<?"))
+        aClose = "?>";
+    else if (lcl_startsWith(r, i, "<!--"))
+        aClose = "-->";
+    else if (lcl_startsWith(r, i, "<![CDATA["))
+        aClose = "]]>";
+    if (!aClose.empty())
+    {
+        auto it = std::search(r.begin() + i + 2, r.end(), aClose.begin(), aClose.end());
+        return it == r.end() ? 0 : (it - r.begin()) + aClose.size();
+    }
+    char cQuote = 0;
+    for (size_t j = i + 1; j < r.size(); ++j)
+    {
+        char c = r[j];
+        if (cQuote)
+            cQuote = c == cQuote ? 0 : cQuote;
+        else if (c == '"' || c == '\'')
+            cQuote = c;
+        else if (c == '[' && r[i + 1] == '!')
+            return 0;
+        else if (c == '>')
+        {
+            rSelfClosing = r[j - 1] == '/';
+            return j + 1;
+        }
+    }
+    return 0;
+}
+
+// local name of the tag starting at r[i] == '<', and the value of its attribute with local name "id"
+std::string lcl_tagInfo(const std::vector<sal_Int8>& r, size_t i, size_t nEnd, std::string& rId)
+{
+    auto isName = [](char c) {
+        return c != ' ' && c != '\t' && c != '\r' && c != '\n' && c != '/' && c != '>' && c != '=';
+    };
+    size_t j = i + 1;
+    std::string aName;
+    while (j < nEnd && isName(r[j]))
+        aName += r[j++];
+    while (j < nEnd)
+    {
+        while (j < nEnd && !isName(r[j]))
+            ++j;
+        std::string aAttr;
+        while (j < nEnd && isName(r[j]))
+            aAttr += r[j++];
+        while (j < nEnd && r[j] != '"' && r[j] != '\'' && r[j] != '>')
+            ++j;
+        if (j >= nEnd || r[j] == '>')
+            break;
+        char cQuote = r[j++];
+        std::string aValue;
+        while (j < nEnd && r[j] != cQuote)
+            aValue += r[j++];
+        ++j;
+        if (aAttr == "id" || aAttr.ends_with(":id"))
+            rId = aValue;
+    }
+    size_t nColon = aName.find(':');
+    return nColon == std::string::npos ? aName : aName.substr(nColon + 1);
+}
+
+}
