+void OOXMLDocument::splitComments(const uno::Reference<io::XInputStream>& xIn, CommentParts& rParts)
+{
+    rParts.bValid = false;
+    if (!xIn.is())
+        return;
+    std::vector<sal_Int8>& r = rParts.aData;
+    uno::Sequence<sal_Int8> aBuf;
+    while (sal_Int32 nRead = xIn->readBytes(aBuf, 1 << 20))
+        r.insert(r.end(), aBuf.begin(), aBuf.begin() + nRead);
+    // UTF-16 or anything with NUL bytes: no byte-wise cutting
+    const auto itProbeEnd = r.begin() + std::min<size_t>(r.size(), 512);
+    if (r.size() < 8 || std::find(r.begin(), itProbeEnd, 0) != itProbeEnd)
+        return;
+    bool bSelf = false;
+    size_t i = 0;
+    while (i < r.size() && r[i] != '<')
+        ++i;
+    while (i < r.size() && (lcl_startsWith(r, i, "<?") || lcl_startsWith(r, i, "<!")))
+    {
+        i = lcl_markupEnd(r, i, bSelf);
+        if (!i)
+            return;
+        while (i < r.size() && r[i] != '<')
+            ++i;
+    }
+    if (i >= r.size())
+        return;
+    size_t nRootEnd = lcl_markupEnd(r, i, bSelf);
+    if (!nRootEnd || bSelf)
+        return;
+    rParts.nHeadEnd = nRootEnd;
+    i = nRootEnd;
+    for (;;)
+    {
+        while (i < r.size() && r[i] != '<')
+            ++i;
+        if (i >= r.size())
+            return; // no root end tag
+        if (lcl_startsWith(r, i, "</"))
+        {
+            rParts.nTailStart = i;
+            rParts.bValid = true;
+            return;
+        }
+        size_t nStart = i;
+        i = lcl_markupEnd(r, i, bSelf);
+        if (!i)
+            return;
+        if (lcl_startsWith(r, nStart, "<?") || lcl_startsWith(r, nStart, "<!"))
+            continue; // comment or processing instruction between the elements
+        std::string aId;
+        if (lcl_tagInfo(r, nStart, i, aId) != "comment" || aId.empty())
+            return;
+        for (sal_Int32 nDepth = bSelf ? 0 : 1; nDepth > 0;)
+        {
+            while (i < r.size() && r[i] != '<')
+                ++i;
+            if (i >= r.size())
+                return;
+            bool bEnd = lcl_startsWith(r, i, "</");
+            bool bOther = lcl_startsWith(r, i, "<?") || lcl_startsWith(r, i, "<!");
+            i = lcl_markupEnd(r, i, bSelf);
+            if (!i)
+                return;
+            if (bEnd)
+                --nDepth;
+            else if (!bOther && !bSelf)
+                ++nDepth;
+        }
+        rParts.aRanges[OString(aId.c_str()).toInt32()].emplace_back(nStart, i);
+    }
+}
