+CPPUNIT_TEST_FIXTURE(Test, testCommentsEachGetOwnText)
+{
+    // Given a document with 22 comments (ids 0..41 with gaps, several with the same text):
+    // When importing it (comments.xml is cut into one small document per comment instead of being
+    // parsed in full for every comment):
+    createSwDoc("../../../extras/ooxmlexport/data/wDateValueFormat.docx");
+
+    // Then every comment exists once with the text of its own <w:comment> element:
+    uno::Reference<text::XTextFieldsSupplier> xSupplier(mxComponent, uno::UNO_QUERY);
+    uno::Reference<container::XEnumeration> xFields
+        = xSupplier->getTextFields()->createEnumeration();
+    std::multiset<OUString> aContents;
+    while (xFields->hasMoreElements())
+    {
+        uno::Reference<lang::XServiceInfo> xField(xFields->nextElement(), uno::UNO_QUERY);
+        if (xField->supportsService(u"com.sun.star.text.textfield.Annotation"_ustr))
+            aContents.insert(getProperty<OUString>(xField, u"Content"_ustr));
+    }
+    CPPUNIT_ASSERT_EQUAL(size_t(22), aContents.size());
+    CPPUNIT_ASSERT_EQUAL(size_t(1), aContents.count(u"Ersetzen durch Übersicht"_ustr));
+    CPPUNIT_ASSERT_EQUAL(size_t(6), aContents.count(u"löschen"_ustr));
+    CPPUNIT_ASSERT_EQUAL(size_t(1), aContents.count(u"Seitenumbruch löschen"_ustr));
