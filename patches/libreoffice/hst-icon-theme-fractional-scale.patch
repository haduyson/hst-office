+void HstIconThemeTest::FractionalScalesUsePixelSnappedVariants()
+{
+    CPPUNIT_ASSERT_EQUAL(u"cmd/lc_bold@150.svg"_ustr, vcl::hst::scaledVariant(u"cmd/lc_bold.svg", 150));
+    CPPUNIT_ASSERT_EQUAL(u"hst/cmd/32/numbertowords@250.svg"_ustr,
+                         vcl::hst::scaledVariant(u"hst/cmd/32/numbertowords.svg", 250));
+    // Whole scales double the 100 % geometry onto whole pixels; PNG themes have no variants.
+    CPPUNIT_ASSERT(vcl::hst::scaledVariant(u"cmd/lc_bold.svg", 100).isEmpty());
+    CPPUNIT_ASSERT(vcl::hst::scaledVariant(u"cmd/lc_bold.svg", 200).isEmpty());
+    CPPUNIT_ASSERT(vcl::hst::scaledVariant(u"cmd/lc_bold.png", 150).isEmpty());
+}
