+void HstIconThemeTest::FractionalScalesUsePixelSnappedVariants()
+{
+    CPPUNIT_ASSERT_EQUAL(u"cmd/lc_bold@150.svg"_ustr, vcl::hst::scaledVariant(u"cmd/lc_bold.svg", 150));
+    CPPUNIT_ASSERT_EQUAL(u"hst/cmd/32/numbertowords@250.svg"_ustr,
+                         vcl::hst::scaledVariant(u"hst/cmd/32/numbertowords.svg", 250));
+    // Whole scales double the 100 % geometry onto whole pixels; PNG themes have no variants.
+    CPPUNIT_ASSERT(vcl::hst::scaledVariant(u"cmd/lc_bold.svg", 100).isEmpty());
+    CPPUNIT_ASSERT(vcl::hst::scaledVariant(u"cmd/lc_bold.svg", 200).isEmpty());
+    CPPUNIT_ASSERT(vcl::hst::scaledVariant(u"cmd/lc_bold.png", 150).isEmpty());
+}
+
+void HstIconThemeTest::SmallIconsAtOneAndAHalfUseTheNativeLargeIcon()
+{
+    // 16 px x 1.5 = the 24 px large icon, drawn natively by Colibre
+    CPPUNIT_ASSERT_EQUAL(u"cmd/lc_cut.svg"_ustr, vcl::hst::largeIconAtFractionalScale(u"cmd/sc_cut.svg", 150));
+    CPPUNIT_ASSERT_EQUAL(u"cmd/vi/lc_bold.svg"_ustr,
+                         vcl::hst::largeIconAtFractionalScale(u"cmd/vi/sc_bold.svg", 150));
+    // other scales, large icons, non-command images, PNG themes and variants are left alone
+    CPPUNIT_ASSERT(vcl::hst::largeIconAtFractionalScale(u"cmd/sc_cut.svg", 100).isEmpty());
+    CPPUNIT_ASSERT(vcl::hst::largeIconAtFractionalScale(u"cmd/sc_cut.svg", 250).isEmpty());
+    CPPUNIT_ASSERT(vcl::hst::largeIconAtFractionalScale(u"cmd/lc_cut.svg", 150).isEmpty());
+    CPPUNIT_ASSERT(vcl::hst::largeIconAtFractionalScale(u"svx/res/sc_x.svg", 150).isEmpty());
+    CPPUNIT_ASSERT(vcl::hst::largeIconAtFractionalScale(u"cmd/sc_cut.png", 150).isEmpty());
+    CPPUNIT_ASSERT(vcl::hst::largeIconAtFractionalScale(u"hst/cmd/sc_cut.svg", 150).isEmpty());
+}
+
 CPPUNIT_TEST_SUITE_REGISTRATION(HstIconThemeTest);
 
