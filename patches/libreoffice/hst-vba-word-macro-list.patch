+/// The procedures the Macros dialog shows: public Subs without parameters, outside Option Private Module
+std::vector<OUString> lclListedMacros(std::u16string_view aSource)
+{
+    std::vector<OUString> aNames;
+    const OUString aText(aSource);
+    sal_Int32 nIndex = 0;
+    do
+    {
+        if (aText.getToken(0, '\n', nIndex).trim().equalsIgnoreAsciiCase(u"option private module"))
+            return {};
+    } while (nIndex >= 0);
+    nIndex = 0;
+    do
+    {
+        const OUString aLine = aText.getToken(0, '\n', nIndex).trim();
+        sal_Int32 nAt = 0;
+        const auto lclSkip = [&aLine, &nAt](std::u16string_view aWord) {
+            if (!aLine.matchIgnoreAsciiCase(aWord, nAt))
+                return false;
+            nAt += aWord.size();
+            return true;
+        };
+        lclSkip(u"public ");
+        lclSkip(u"static ");
+        if (!lclSkip(u"sub "))
+            continue;
+        const sal_Int32 nOpen = aLine.indexOf('(', nAt);
+        const sal_Int32 nClose = aLine.indexOf(')', nAt);
+        if (nOpen < 0 || nClose < nOpen || !aLine.copy(nOpen + 1, nClose - nOpen - 1).trim().isEmpty())
+            continue;
+        const OUString aName = aLine.copy(nAt, nOpen - nAt).trim();
+        if (!aName.isEmpty())
+            aNames.push_back(aName);
+    } while (nIndex >= 0);
+    return aNames;
+}
+
+OString lclVbaDataXml(const OUString& rProject, const uno::Reference<container::XNameAccess>& xLibrary)
+{
+    uno::Reference<script::vba::XVBAModuleInfo> xInfo(xLibrary, uno::UNO_QUERY);
+    OStringBuffer aEntries;
+    for (const OUString& rModule : xLibrary->getElementNames())
+    {
+        if (xInfo.is() && xInfo->hasModuleInfo(rModule)
+            && xInfo->getModuleInfo(rModule).ModuleType != script::ModuleType::NORMAL
+            && xInfo->getModuleInfo(rModule).ModuleType != script::ModuleType::DOCUMENT)
+            continue;
+        OUString aSource;
+        xLibrary->getByName(rModule) >>= aSource;
+        for (const OUString& rMacro : lclListedMacros(aSource))
+        {
+            const OUString aName = rProject + "." + rModule + "." + rMacro;
+            aEntries.append("<wne:mcd wne:macroName=\""
+                            + OUStringToOString(aName.toAsciiUpperCase(), RTL_TEXTENCODING_UTF8)
+                            + "\" wne:name=\"" + OUStringToOString(aName, RTL_TEXTENCODING_UTF8)
+                            + "\" wne:bEncrypt=\"00\" wne:cmg=\"56\"/>");
+        }
+    }
+    if (aEntries.isEmpty())
+        return {};
+    return "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n"
+           "<wne:vbaSuppData xmlns:wne=\"http://schemas.microsoft.com/office/word/2006/wordml\"><wne:mcds>"
+           + aEntries + "</wne:mcds></wne:vbaSuppData>";
+}
