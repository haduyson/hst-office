+
+/// Tints rBox with aColor over what is already painted (the page and its text); fTransparency is
+/// 0 (opaque) to 1 (invisible). The basegfx overload blends on every VCL backend. The
+/// tools::PolyPolygon overload sends a rectangle, on Windows only, to DrawAlphaRect, which with Skia
+/// replaces the pixels with the colour's premultiplied value: dark bars that hide the text.
+void tintRect(vcl::RenderContext& rRenderContext, const tools::Rectangle& rBox, const Color& aColor,
+              double fTransparency)
+{
+    rRenderContext.SetLineColor();
+    rRenderContext.SetFillColor(aColor);
+    const basegfx::B2DRange aRange(rBox.Left(), rBox.Top(), rBox.Right(), rBox.Bottom());
+    rRenderContext.DrawTransparent(basegfx::B2DHomMatrix(),
+                                   basegfx::B2DPolyPolygon(basegfx::utils::createPolygonFromRect(aRange)),
+                                   fTransparency);
+}
 }
 
