+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ * Copyright (c) HASON TECH. HST Office.
+ */
+
+// HST Office: lookups of the Excel export that grew with the number of text cells.
+//
+// HstSstIndex finds the shared-string-table entry of a cell text. The table was a fixed set of 2048
+// buckets of sorted vectors keyed by a 16-bit hash: with a million different texts each bucket held
+// hundreds of entries, every new text moved half a bucket and compared texts a dozen times. The index
+// hashes the whole text and its format runs and compares with XclExpString::IsEqual, so it finds the
+// same entries and gives new texts the same numbers, in the same order.
+//
+// HstCellFontCache remembers the Excel font index of a cell text portion per cell format and script for
+// one export. Building the font of every text cell from its format (font name, size, colour, ...) and
+// looking it up in the font list cost a fifth of saving a workbook with many text cells. A font that is
+// already in the font list is only found there again, without changing anything, so asking once per
+// format and script gives the same indexes. Each format used as a key is kept alive by the cache.
+
+#pragma once
+
+#include <patattr.hxx>
+#include "xestring.hxx"
+
+#include <functional>
+#include <unordered_map>
+#include <utility>
+
+class HstSstIndex
+{
+public:
+    /** The index of a string equal to rString, or nNewIndex after remembering rString under it; the
+        flag is true when rString is new. rString must live as long as the index. */
+    std::pair<sal_uInt32, bool> insert(const XclExpString& rString, sal_uInt32 nNewIndex)
+    {
+        auto aRes = maIndex.try_emplace(&rString, nNewIndex);
+        return { aRes.first->second, aRes.second };
+    }
+
+private:
+    struct Hash
+    {
+        size_t operator()(const XclExpString* p) const
+        {
+            size_t nHash = p->Len();
+            for (sal_uInt16 i = 0, n = p->Len(); i < n; ++i)
+                nHash = nHash * 1000003 ^ p->GetChar(i);
+            for (const XclFormatRun& rRun : p->GetFormats())
+                nHash = nHash * 31 + ((size_t(rRun.mnChar) << 16) | rRun.mnFontIdx);
+            return nHash;
+        }
+    };
+    struct Equal
+    {
+        bool operator()(const XclExpString* a, const XclExpString* b) const { return a->IsEqual(*b); }
+    };
+    std::unordered_map<const XclExpString*, sal_uInt32, Hash, Equal> maIndex;
+};
+
+class HstCellFontCache
+{
+public:
+    /** The font index stored for this cell format and script, or false. */
+    bool find(const ScPatternAttr* pPattern, sal_Int16 nScript, sal_uInt16& rFontIdx) const
+    {
+        auto it = maFonts.find(Key{ pPattern, nScript });
+        if (it == maFonts.end())
+            return false;
+        rFontIdx = it->second.mnFontIdx;
+        return true;
+    }
+
+    void insert(const ScPatternAttr* pPattern, sal_Int16 nScript, sal_uInt16 nFontIdx)
+    {
+        maFonts.try_emplace(Key{ pPattern, nScript }, Entry{ CellAttributeHolder(pPattern), nFontIdx });
+    }
+
+private:
+    struct Key
+    {
+        const ScPatternAttr* mpPattern;
+        sal_Int16 mnScript;
+        bool operator==(const Key& r) const { return mpPattern == r.mpPattern && mnScript == r.mnScript; }
+    };
+    struct KeyHash
+    {
+        size_t operator()(const Key& r) const
+        {
+            return std::hash<const void*>()(r.mpPattern) * 31 + static_cast<size_t>(r.mnScript + 32768);
+        }
+    };
+    struct Entry
+    {
+        CellAttributeHolder maPattern; // keeps the format alive while it is a key
+        sal_uInt16 mnFontIdx;
+    };
+    std::unordered_map<Key, Entry, KeyHash> maFonts;
+};
