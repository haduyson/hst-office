+
+class ScDocument;
+
+namespace sc::hst
+{
+/** Where a document's convention for booleans in text comes from. The leading spreadsheet
+    application turns TRUE/FALSE into the text "TRUE"/"FALSE" where text is needed ("a"&TRUE is
+    "aTRUE", LEN(TRUE) is 4); LibreOffice used the number ("a1", 1). */
+enum class LogicalTextMode : sal_uInt8
+{
+    /// A new document, or an .ods saved by HST Sheets 1.0.3 or later: text when the formula
+    /// syntax is the leading application's (the HST Sheets default).
+    Default,
+    /// An .ods without the HST mark (LibreOffice, HST Sheets 1.0.2 and older): numbers, so the
+    /// results it was made with stay the same.
+    LegacyOds,
+    /// An .xlsx or .xls file: always text.
+    ExcelFile
+};
+
+/// Whether TRUE/FALSE become "TRUE"/"FALSE" (the document's boolean words) in text context.
+bool LogicalAsText(const ScDocument& rDoc);
+}
