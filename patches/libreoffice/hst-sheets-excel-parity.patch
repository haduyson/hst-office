+bool usesExcelSyntax(const ScDocument& rDoc)
+{
+    switch (formula::FormulaGrammar::extractRefConvention(rDoc.GetGrammar()))
+    {
+        case formula::FormulaGrammar::CONV_XL_A1:
+        case formula::FormulaGrammar::CONV_XL_R1C1:
+        case formula::FormulaGrammar::CONV_XL_OOX:
+            return true;
+        default:
+            return false;
+    }
+}
+}
+
+bool LogicalAsText(const ScDocument& rDoc)
+{
+    switch (rDoc.GetHstLogicalTextMode())
+    {
+        case LogicalTextMode::ExcelFile:
+            return true;
+        case LogicalTextMode::LegacyOds:
+            return false;
+        case LogicalTextMode::Default:
+        case LogicalTextMode::OdsMarked:
+            break;
+    }
+    return usesExcelSyntax(rDoc);
+}
+
+bool Excel1900Dates(const ScDocument& rDoc)
+{
+    switch (rDoc.GetHstLogicalTextMode())
+    {
+        case LogicalTextMode::ExcelFile:
+            return true;
+        case LogicalTextMode::Default:
+            return usesExcelSyntax(rDoc);
+        case LogicalTextMode::OdsMarked:
+        case LogicalTextMode::LegacyOds:
+            break;
+    }
+    return false;
+}
+
+}
+
+bool ScInterpreter::HstLogicalText(svl::SharedString& rText)
+{
+    if (sp == 0)
+        return false;
+    // A boolean result (TRUE, FALSE, a comparison, AND, ISNUMBER...) is a number typed logical.
+    const auto* pTop = dynamic_cast<const formula::FormulaDoubleToken*>(pStack[sp - 1]);
+    if (!pTop || static_cast<SvNumFormatType>(pTop->GetDoubleType()) != SvNumFormatType::LOGICAL)
+        return false;
+    if (!sc::hst::LogicalAsText(mrDoc))
+        return false;
+
+    const double fValue = PopDouble();
+    // The document's boolean words, as a boolean cell shows them.
+    const sal_uInt32 nFormat = mrContext.NFGetStandardFormat(SvNumFormatType::LOGICAL, ScGlobal::eLnge);
+    OUString aText;
+    const Color* pColor = nullptr;
+    mrContext.NFGetOutputString(fValue, nFormat, aText, &pColor);
+    rText = mrStrPool.intern(aText);
+    return true;
+}
