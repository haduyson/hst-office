+#include <sal/types.h>
+#include "scdllapi.h"
+
+#include <formula/errorcodes.hxx>
+
+#include <string_view>
+
+class ScDocument;
+
+namespace sc::hst
+{
+/** Where a document's convention for booleans in text comes from. The leading spreadsheet
+    application turns TRUE/FALSE into the text "TRUE"/"FALSE" where text is needed ("a"&TRUE is
+    "aTRUE", LEN(TRUE) is 4); LibreOffice used the number ("a1", 1). */
+enum class LogicalTextMode : sal_uInt8
+{
+    /// A new document: the leading application's conventions when the formula syntax is its
+    /// syntax (the HST Sheets default).
+    Default,
+    /// An .ods saved by HST Sheets 1.0.3 or later: booleans as text like Default; dates keep the
+    /// ODF day count (hstexcel1900 does not apply to .ods files).
+    OdsMarked,
+    /// An .ods without the HST mark (LibreOffice, HST Sheets 1.0.2 and older): numbers, so the
+    /// results it was made with stay the same.
+    LegacyOds,
+    /// An .xlsx or .xls file: always text.
+    ExcelFile
+};
+
+/// Whether TRUE/FALSE become "TRUE"/"FALSE" (the document's boolean words) in text context.
+bool LogicalAsText(const ScDocument& rDoc);
+
+/** Whether the document counts days like the leading spreadsheet application's 1900 date system
+    (serial 60 is 29/02/1900, serials 1-59 one day later than LibreOffice's count): .xlsx/.xls
+    files and new documents with its formula syntax; never .ods files. */
+SC_DLLPUBLIC bool Excel1900Dates(const ScDocument& rDoc);
+
+/// Whether formula results follow the leading application where LibreOffice's differ (the
+/// scope of LogicalAsText; an .ods without the HST mark keeps LibreOffice's results).
+inline bool ExcelResults(const ScDocument& rDoc) { return LogicalAsText(rDoc); }
+
+/// The error of an empty array result (FILTER without a match, SEQUENCE(0), GROUPBY/PIVOTBY
+/// without rows): #CALC! where the document follows the leading application, else eLegacy.
+FormulaError EmptyResultError(const ScDocument& rDoc, FormulaError eLegacy);
+
+/// FILTERXML: whether a node's text is a number (rValue) the leading application returns as a
+/// number ("1", "-2.5", "1E3"; the XML number syntax, not the locale's).
+bool FilterXmlNumber(const ScDocument& rDoc, std::u16string_view rText, double& rValue);
+}
