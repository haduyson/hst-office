+// Booleans in text context: "a"&TRUE, CONCAT, TEXTJOIN, LEFT, LEN, UPPER, SUBSTITUTE, EXACT and
+// TEXT see TRUE/FALSE as the text "TRUE"/"FALSE", as in the leading spreadsheet application.
+
+#include <hstlogicaltext.hxx>
+
+#include <document.hxx>
+#include <global.hxx>
