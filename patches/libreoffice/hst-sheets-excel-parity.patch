+
+// Function results of HST Sheets that follow the leading spreadsheet application where
+// LibreOffice's differ: #CALC! for an empty array result, FILTERXML numbers, a number typed as
+// text as an argument of SUM/AVERAGE/PRODUCT/SUMSQ. Scope: sc::hst::ExcelResults.
+
+#include <hstlogicaltext.hxx>
+
+#include <document.hxx>
+#include <interpre.hxx>
+
+#include <rtl/math.hxx>
+
+namespace sc::hst
+{
+FormulaError EmptyResultError(const ScDocument& rDoc, FormulaError eLegacy)
+{
+    return ExcelResults(rDoc) ? FormulaError::Calculation : eLegacy;
+}
+
+bool FilterXmlNumber(const ScDocument& rDoc, std::u16string_view rText, double& rValue)
+{
+    if (!ExcelResults(rDoc))
+        return false;
+    // Surrounding white space of the node text does not matter; inside, only the characters of
+    // a plain decimal number: digits, one sign, a point and an exponent.
+    size_t nStart = 0, nEnd = rText.size();
+    while (nStart < nEnd && rtl::isAsciiWhiteSpace(rText[nStart]))
+        ++nStart;
+    while (nEnd > nStart && rtl::isAsciiWhiteSpace(rText[nEnd - 1]))
+        --nEnd;
+    if (nStart == nEnd)
+        return false;
+    const std::u16string_view aNumber = rText.substr(nStart, nEnd - nStart);
+    bool bDigit = false;
+    for (const sal_Unicode c : aNumber)
+    {
+        if (rtl::isAsciiDigit(c))
+            bDigit = true;
+        else if (c != '+' && c != '-' && c != '.' && c != 'e' && c != 'E')
+            return false;
+    }
+    if (!bDigit)
+        return false;
+    rtl_math_ConversionStatus eStatus = rtl_math_ConversionStatus_Ok;
+    sal_Int32 nParsed = 0;
+    const double fValue = rtl::math::stringToDouble(aNumber, '.', 0, &eStatus, &nParsed);
+    if (eStatus != rtl_math_ConversionStatus_Ok || nParsed != static_cast<sal_Int32>(aNumber.size()))
+        return false;
+    rValue = fValue;
+    return true;
+}
+}
+
+void ScInterpreter::HstDirectTextNumber(ScIterFunc eFunc)
+{
+    switch (eFunc)
+    {
+        case ifSUM:
+        case ifAVERAGE:
+        case ifPRODUCT:
+        case ifSUMSQ:
+            break;
+        default:
+            return;
+    }
+    if (GetStackType() != formula::svString || !sc::hst::ExcelResults(mrDoc))
+        return;
+
+    const svl::SharedString aText = PopString();
+    const FormulaError eOldError = nGlobalError;
+    nGlobalError = FormulaError::NONE;
+    const double fValue = ConvertStringToValue(aText.getString());
+    const bool bNumber = nGlobalError == FormulaError::NONE;
+    nGlobalError = eOldError;
+    if (bNumber)
+        PushDouble(fValue);
+    else
+        PushString(aText); // no number: the caller reports #VALUE! as before
+}
