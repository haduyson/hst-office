+namespace sax_fastparser
+{
+class FastAttributeList;
+}
+
+/** HST Sheets marks in .ods files, in the HST namespace (prefix "hstcalc"). ODF lets a document
+    carry attributes of a foreign namespace; other ODF consumers ignore them, so the file stays
+    valid and keeps its meaning elsewhere.
+
+    - office:spreadsheet hstcalc:logical-text="text": the document shows TRUE/FALSE as text in
+      text context (hstlogicaltext.hxx). An .ods without it keeps LibreOffice's numbers.
+    - table:table-cell hstcalc:dynamic-array="true" on the anchor of a matrix: the formula is a
+      dynamic array (it spills and resizes with its result), not a Ctrl+Shift+Enter array. */
+namespace sc::hst::ods
+{
+/// Declares the HST namespace on the exported content.
+void RegisterNamespace(SvXMLNamespaceMap& rMap);
+/// Attributes of office:spreadsheet.
+void ExportSpreadsheetMarks(SvXMLExport& rExport, const ScDocument& rDoc);
+/// Attributes of the anchor cell of a matrix.
+void ExportMatrixMarks(SvXMLExport& rExport, const ScFormulaCell* pAnchor);
+/// Reads the attributes of office:spreadsheet into the document (also when there are none).
+void ImportSpreadsheetMarks(ScDocument& rDoc, sax_fastparser::FastAttributeList* pAttribs);
+/// Whether a cell's attributes mark it as the anchor of a dynamic array.
+bool IsDynamicArrayAnchor(sax_fastparser::FastAttributeList* pAttribs);
+}
