+
+#include <optional>
+
+namespace sc::hst::ods
+{
+namespace
+{
+constexpr OUString aNamespaceURI = u"urn:hst-office:names:calc:xmlns:hstcalc:1.0"_ustr;
+constexpr OUString aPrefix = u"hstcalc"_ustr;
+constexpr OUString aLogicalText = u"logical-text"_ustr;
+constexpr OUString aDynamicArray = u"dynamic-array"_ustr;
+
+/// The value of the HST attribute rLocalName, whatever prefix the file bound the namespace to.
+std::optional<OUString> findAttribute(sax_fastparser::FastAttributeList* pAttribs,
+                                      std::u16string_view rLocalName)
+{
+    if (!pAttribs)
+        return std::nullopt;
+    const css::uno::Sequence<css::xml::Attribute> aUnknown
+        = pAttribs->getUnknownAttributes();
+    for (const css::xml::Attribute& rAttribute : aUnknown)
+    {
+        if (rAttribute.NamespaceURL != aNamespaceURI)
+            continue;
+        const sal_Int32 nColon = rAttribute.Name.indexOf(':');
+        if (rAttribute.Name.subView(nColon + 1) == rLocalName)
+            return rAttribute.Value;
+    }
+    return std::nullopt;
+}
+}
+
+void RegisterNamespace(SvXMLNamespaceMap& rMap) { rMap.Add(aPrefix, aNamespaceURI); }
+
+void ExportSpreadsheetMarks(SvXMLExport& rExport, const ScDocument& rDoc)
+{
+    if (rDoc.GetHstLogicalTextMode() != LogicalTextMode::LegacyOds)
+        rExport.AddAttribute(aPrefix + ":" + aLogicalText, u"text"_ustr);
+}
+
+void ExportMatrixMarks(SvXMLExport& rExport, const ScFormulaCell* pAnchor)
+{
+    if (pAnchor && pAnchor->IsDynamicArrayMaster())
+        rExport.AddAttribute(aPrefix + ":" + aDynamicArray, u"true"_ustr);
+}
+
+void ImportSpreadsheetMarks(ScDocument& rDoc, sax_fastparser::FastAttributeList* pAttribs)
+{
+    const std::optional<OUString> oValue = findAttribute(pAttribs, aLogicalText);
+    rDoc.SetHstLogicalTextMode(oValue && *oValue == "text" ? LogicalTextMode::OdsMarked
+                                                           : LogicalTextMode::LegacyOds);
+}
+
+bool IsDynamicArrayAnchor(sax_fastparser::FastAttributeList* pAttribs)
+{
+    const std::optional<OUString> oValue = findAttribute(pAttribs, aDynamicArray);
+    return oValue && *oValue == "true";
+}
+}
