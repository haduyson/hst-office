+// HST Office: results of HST Sheets that follow the leading spreadsheet application, checked
+// against the results documented by its vendor: booleans become the text "TRUE"/"FALSE" where
+// text is needed ("a"&TRUE, CONCAT, TEXTJOIN, LEFT, LEN, UPPER, TEXT, SUBSTITUTE, EXACT) in new
+// documents, .xlsx files and .ods files saved by HST Sheets, while older .ods files keep their
+// results; MROUND of a number and a multiple of different signs is #NUM!.
+
+#include "../helper/qahelper.hxx"
+
+#include <comphelper/propertyvalue.hxx>
+#include <tools/stream.hxx>
+#include <vcl/scheduler.hxx>
+#include <docsh.hxx>
+#include <document.hxx>
+#include <hstlogicaltext.hxx>
+
+namespace
+{
+class ScHstExcelParityTest : public ScModelTestBase
+{
+public:
+    ScHstExcelParityTest()
+        : ScModelTestBase(u"sc/qa/unit/data"_ustr)
+    {
+    }
+
+protected:
+    ScAddress pos(const char* pCell)
+    {
+        ScAddress aPos;
+        aPos.Parse(OUString::createFromAscii(pCell), *getScDoc());
+        return aPos;
+    }
+    OUString str(const char* pCell) { return getScDoc()->GetString(pos(pCell)); }
+    double val(const char* pCell) { return getScDoc()->GetValue(pos(pCell)); }
+    void recalc()
+    {
+        getScDoc()->CalcAll();
+        Scheduler::ProcessEventsToIdle();
+    }
+
+    /// Types the boolean-in-text cases into column A (rows 1-8).
+    void typeBooleanCases()
+    {
+        insertStringToCell(u"A1"_ustr, u"=\"a\"&TRUE");
+        insertStringToCell(u"A2"_ustr, u"=CONCATENATE(\"x\",TRUE)");
+        insertStringToCell(u"A3"_ustr, u"=TEXTJOIN(\",\",TRUE,TRUE,1)");
+        insertStringToCell(u"A4"_ustr, u"=LEN(TRUE)");
+        insertStringToCell(u"A5"_ustr, u"=LEFT(TRUE,2)");
+        insertStringToCell(u"A6"_ustr, u"=UPPER(FALSE)");
+        insertStringToCell(u"A7"_ustr, u"=EXACT(TRUE,\"TRUE\")");
+        insertStringToCell(u"A8"_ustr, u"=\"a\"&(1=1)");
+    }
+    void checkBooleanCasesAsText()
+    {
+        CPPUNIT_ASSERT_EQUAL(u"aTRUE"_ustr, str("A1"));
+        CPPUNIT_ASSERT_EQUAL(u"xTRUE"_ustr, str("A2"));
+        CPPUNIT_ASSERT_EQUAL(u"TRUE,1"_ustr, str("A3"));
+        CPPUNIT_ASSERT_EQUAL(4.0, val("A4"));
+        CPPUNIT_ASSERT_EQUAL(u"TR"_ustr, str("A5"));
+        CPPUNIT_ASSERT_EQUAL(u"FALSE"_ustr, str("A6"));
+        CPPUNIT_ASSERT_EQUAL(u"TRUE"_ustr, str("A7"));
+        CPPUNIT_ASSERT_EQUAL(u"aTRUE"_ustr, str("A8"));
+    }
+
+    /// Writes a flat .ods holding ="a"&TRUE() in A1 (cached "a1"), with or without the HST mark.
+    void writeFlatOds(bool bHstMark)
+    {
+        const OString aMark = bHstMark ? " hstcalc:logical-text=\"text\""_ostr : OString();
+        const OString aXml
+            = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+              "<office:document xmlns:office=\"urn:oasis:names:tc:opendocument:xmlns:office:1.0\""
+              " xmlns:table=\"urn:oasis:names:tc:opendocument:xmlns:table:1.0\""
+              " xmlns:text=\"urn:oasis:names:tc:opendocument:xmlns:text:1.0\""
+              " xmlns:of=\"urn:oasis:names:tc:opendocument:xmlns:of:1.2\""
+              " xmlns:hstcalc=\"urn:hst-office:names:calc:xmlns:hstcalc:1.0\""
+              " office:version=\"1.3\" office:mimetype=\"application/vnd.oasis.opendocument.spreadsheet\">"
+              "<office:body><office:spreadsheet"
+            + aMark
+            + "><table:table table:name=\"Sheet1\"><table:table-row>"
+              "<table:table-cell table:formula=\"of:=&quot;a&quot;&amp;TRUE()\""
+              " office:value-type=\"string\" office:string-value=\"a1\"><text:p>a1</text:p>"
+              "</table:table-cell></table:table-row></table:table></office:spreadsheet></office:body>"
+              "</office:document>";
+        SvFileStream aStream(maTempFile.GetURL(), StreamMode::WRITE | StreamMode::TRUNC);
+        aStream.WriteBytes(aXml.getStr(), aXml.getLength());
+        aStream.Close();
+        CPPUNIT_ASSERT_EQUAL(ERRCODE_NONE, aStream.GetError());
+    }
+    void loadFlatOds()
+    {
+        loadFromURL(maTempFile.GetURL(), { comphelper::makePropertyValue(
+                                               u"FilterName"_ustr,
+                                               u"OpenDocument Spreadsheet Flat XML"_ustr) });
+    }
+};
+}
+
+CPPUNIT_TEST_FIXTURE(ScHstExcelParityTest, testBooleansInTextContext)
+{
+    createScDoc();
+    typeBooleanCases();
+    checkBooleanCasesAsText();
+
+    insertStringToCell(u"B1"_ustr, u"=FALSE&\"b\"");
+    CPPUNIT_ASSERT_EQUAL(u"FALSEb"_ustr, str("B1"));
+    insertStringToCell(u"B2"_ustr, u"=CONCAT(\"x\",FALSE)");
+    CPPUNIT_ASSERT_EQUAL(u"xFALSE"_ustr, str("B2"));
+    insertStringToCell(u"B3"_ustr, u"=SUBSTITUTE(TRUE,\"T\",\"t\")");
+    CPPUNIT_ASSERT_EQUAL(u"tRUE"_ustr, str("B3"));
+    insertStringToCell(u"B4"_ustr, u"=TEXT(TRUE,\"0\")");
+    CPPUNIT_ASSERT_EQUAL(u"TRUE"_ustr, str("B4"));
+    insertStringToCell(u"B5"_ustr, u"=LEN(ISNUMBER(1))");
+    CPPUNIT_ASSERT_EQUAL(4.0, val("B5"));
+    insertStringToCell(u"C1"_ustr, u"TRUE");
+    insertStringToCell(u"B6"_ustr, u"=\"a\"&C1");
+    CPPUNIT_ASSERT_EQUAL(u"aTRUE"_ustr, str("B6"));
+
+    // Numbers and arithmetic stay as they were.
+    insertStringToCell(u"B7"_ustr, u"=\"a\"&1");
+    CPPUNIT_ASSERT_EQUAL(u"a1"_ustr, str("B7"));
+    insertStringToCell(u"B8"_ustr, u"=TRUE+1");
+    CPPUNIT_ASSERT_EQUAL(2.0, val("B8"));
+    insertStringToCell(u"B9"_ustr, u"=LEN(12)");
+    CPPUNIT_ASSERT_EQUAL(2.0, val("B9"));
+}
+
+CPPUNIT_TEST_FIXTURE(ScHstExcelParityTest, testBooleansInTextXlsx)
+{
+    createScDoc();
+    typeBooleanCases();
+    saveAndReload(TestFilter::XLSX);
+    CPPUNIT_ASSERT(getScDoc()->GetHstLogicalTextMode() == sc::hst::LogicalTextMode::ExcelFile);
+    recalc();
+    checkBooleanCasesAsText();
+}
+
+CPPUNIT_TEST_FIXTURE(ScHstExcelParityTest, testBooleansInTextOds)
+{
+    // Saved by HST Sheets: the mark is written and read back.
+    createScDoc();
+    typeBooleanCases();
+    saveAndReload(TestFilter::ODS);
+    xmlDocUniquePtr pContent = parseExport(u"content.xml"_ustr);
+    CPPUNIT_ASSERT(pContent);
+    assertXPath(pContent,
+                "/office:document-content/office:body/office:spreadsheet"
+                "[@*[local-name()='logical-text']='text']");
+    recalc();
+    checkBooleanCasesAsText();
+}
+
+CPPUNIT_TEST_FIXTURE(ScHstExcelParityTest, testOlderOdsKeepsNumbers)
+{
+    // An .ods without the mark (LibreOffice, older HST Sheets) keeps its results, also when
+    // recalculated and after saving it again.
+    writeFlatOds(false);
+    loadFlatOds();
+    CPPUNIT_ASSERT(getScDoc()->GetHstLogicalTextMode() == sc::hst::LogicalTextMode::LegacyOds);
+    recalc();
+    CPPUNIT_ASSERT_EQUAL(u"a1"_ustr, str("A1"));
+    saveAndReload(TestFilter::ODS);
+    recalc();
+    CPPUNIT_ASSERT_EQUAL(u"a1"_ustr, str("A1"));
+
+    // With the mark: text.
+    dispose();
+    writeFlatOds(true);
+    loadFlatOds();
+    recalc();
+    CPPUNIT_ASSERT_EQUAL(u"aTRUE"_ustr, str("A1"));
+}
+
+CPPUNIT_TEST_FIXTURE(ScHstExcelParityTest, testMroundSigns)
+{
+    // The vendor's MROUND examples: MROUND(10,3)=9, MROUND(-10,-3)=-9, MROUND(1.3,0.2)=1.4,
+    // MROUND(5,-2)=#NUM! ("If number and multiple have different signs, MROUND returns #NUM!").
+    createScDoc();
+    insertStringToCell(u"A1"_ustr, u"=MROUND(10,3)");
+    insertStringToCell(u"A2"_ustr, u"=MROUND(-10,-3)");
+    insertStringToCell(u"A3"_ustr, u"=MROUND(1.3,0.2)");
+    insertStringToCell(u"A4"_ustr, u"=MROUND(5,-2)");
+    insertStringToCell(u"A5"_ustr, u"=MROUND(-5,2)");
+    insertStringToCell(u"A6"_ustr, u"=MROUND(0,-2)");
+    CPPUNIT_ASSERT_EQUAL(9.0, val("A1"));
+    CPPUNIT_ASSERT_EQUAL(-9.0, val("A2"));
+    CPPUNIT_ASSERT_DOUBLES_EQUAL(1.4, val("A3"), 1e-12);
+    CPPUNIT_ASSERT_EQUAL(u"#NUM!"_ustr, str("A4"));
+    CPPUNIT_ASSERT_EQUAL(u"#NUM!"_ustr, str("A5"));
+    CPPUNIT_ASSERT_EQUAL(0.0, val("A6"));
+}
+
+CPPUNIT_PLUGIN_IMPLEMENT();
