+// HST Office: what Desktop::FlushConfiguration() does, on a helper thread; false when it did not
+// end within aLimit (the helper is left behind: the process ends right after the crash handler).
+bool lcl_flushConfigurationWithin(std::chrono::seconds aLimit)
+{
+    struct State
+    {
+        std::mutex aMutex;
+        std::condition_variable aDone;
+        bool bDone = false;
+    };
+    auto pState = std::make_shared<State>();
+    try
+    {
+        std::thread([pState] {
+            try
+            {
+                css::uno::Reference<css::util::XFlushable>(
+                    css::configuration::theDefaultProvider::get(comphelper::getProcessComponentContext()),
+                    css::uno::UNO_QUERY_THROW)->flush();
+            }
+            catch (...)
+            {
+            }
+            std::scoped_lock aGuard(pState->aMutex);
+            pState->bDone = true;
+            pState->aDone.notify_all();
+        }).detach();
+    }
+    catch (const std::system_error&)
+    {
+        return false;
+    }
+    std::unique_lock aGuard(pState->aMutex);
+    return pState->aDone.wait_for(aGuard, aLimit, [&pState] { return pState->bDone; });
+}
+}
