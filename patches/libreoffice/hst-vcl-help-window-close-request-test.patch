+
+// A close request (the window manager's WM_DELETE_WINDOW on X11, WM_CLOSE on Windows) can reach
+// the frame of a quick-help tooltip. Handling Close first ends every help window, which disposes
+// that very tooltip; the handler must then stop instead of using the disposed window. The office
+// used to crash in vcl::Window::ImplGetWindow when this happened over a dialog with tooltips
+// (Templates, Fontwork Gallery).
+
+#include <test/bootstrapfixture.hxx>
+
+#include <salframe.hxx>
+#include <vcl/help.hxx>
+#include <vcl/svapp.hxx>
+#include <vcl/wintypes.hxx>
+#include <vcl/wrkwin.hxx>
+
+namespace
+{
+class HstHelpWindowCloseTest : public test::BootstrapFixture
+{
+public:
+    HstHelpWindowCloseTest()
+        : BootstrapFixture(true, false)
+    {
+    }
+};
+
+VclPtr<vcl::Window> findQuickHelpWindow()
+{
+    for (vcl::Window* pWin = Application::GetFirstTopLevelWindow(); pWin;
+         pWin = Application::GetNextTopLevelWindow(pWin))
+    {
+        if (pWin->GetType() == WindowType::HELPTEXTWINDOW)
+            return pWin;
+    }
+    return nullptr;
+}
+}
+
+CPPUNIT_TEST_FIXTURE(HstHelpWindowCloseTest, testCloseRequestOnQuickHelpWindow)
+{
+    SolarMutexGuard aGuard;
+    ScopedVclPtrInstance<WorkWindow> xParent(nullptr, WB_STDWORK);
+    xParent->SetPosSizePixel(Point(0, 0), Size(400, 300));
+    xParent->Show();
+
+    Help::ShowQuickHelp(xParent.get(), tools::Rectangle(Point(20, 20), Size(80, 20)),
+                        u"Tooltip"_ustr, QuickHelpFlags::NoAutoPos);
+    VclPtr<vcl::Window> xTip = findQuickHelpWindow();
+    CPPUNIT_ASSERT_MESSAGE("quick help window was not created", xTip);
+    SalFrame* pFrame = xTip->ImplGetFrame();
+    CPPUNIT_ASSERT(pFrame);
+
+    // what the window system delivers when something asks the tooltip to close
+    pFrame->CallCallback(SalEvent::Close, nullptr);
+
+    CPPUNIT_ASSERT_MESSAGE("the tooltip is ended by the close request", xTip->isDisposed());
+    CPPUNIT_ASSERT_MESSAGE("the window under the tooltip stays", !xParent->isDisposed());
+    CPPUNIT_ASSERT(!findQuickHelpWindow());
+}
+
