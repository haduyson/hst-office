HST Office on Windows: own ProgID for extension packages (.oxt).

The MSI registered HKCR\office.Extension.1 (and office.Extension\CurVer), the ProgID LibreOffice
uses for .oxt files, with HST's open command and icon. The last installer owned it, and
uninstalling either suite deleted it. It is HSTOffice.Extension.1 now (key, CurVer, the .oxt
default and the Capabilities FileAssociations entry).

License: modified upstream files keep their license (MPL-2.0).

--- a/scp2/source/ooo/registryitem_ooo.scp
+++ b/scp2/source/ooo/registryitem_ooo.scp
@@ -509,7 +509,7 @@
     ParentID = PREDEFINED_HKEY_CLASSES_ROOT;
     ModuleID = gid_Module_Root;
     Subkey = ".oxt";
-    Value = "office.Extension.1";
+    Value = "HSTOffice.Extension.1";
     Styles = ();
 End
 
@@ -534,15 +534,15 @@
 RegistryItem gid_Regitem_Office_Extension_Curver
     ParentID = PREDEFINED_HKEY_CLASSES_ROOT;
     ModuleID = gid_Module_Root;
-    Subkey = "office.Extension\CurVer";
-    Value = "office.Extension.1";
+    Subkey = "HSTOffice.Extension\CurVer";
+    Value = "HSTOffice.Extension.1";
     Styles = ();
 End
 
 RegistryItem gid_Regitem_Office_Extension_1
     ParentID = PREDEFINED_HKEY_CLASSES_ROOT;
     ModuleID = gid_Module_Root;
-    Subkey = "office.Extension.1";
+    Subkey = "HSTOffice.Extension.1";
     REG_VALUE_LNG(EXTENSION)
     Styles = ();
 End
@@ -550,7 +550,7 @@
 RegistryItem gid_Regitem_Office_Extension_1_Shell
     ParentID = PREDEFINED_HKEY_CLASSES_ROOT;
     ModuleID = gid_Module_Root;
-    Subkey = "office.Extension.1\shell";
+    Subkey = "HSTOffice.Extension.1\shell";
     Value = "open";
     Styles = ();
 End
@@ -558,7 +558,7 @@
 RegistryItem gid_Regitem_Office_Extension_1_Shell_Open
     ParentID = PREDEFINED_HKEY_CLASSES_ROOT;
     ModuleID = gid_Module_Root;
-    Subkey = "office.Extension.1\shell\open";
+    Subkey = "HSTOffice.Extension.1\shell\open";
     REG_VALUE_LNG(INSTALL)
     Styles = ();
 End
@@ -566,7 +566,7 @@
 RegistryItem gid_Regitem_Office_Extension_1_Shell_Open_Command
     ParentID = PREDEFINED_HKEY_CLASSES_ROOT;
     ModuleID = gid_Module_Root;
-    Subkey = "office.Extension.1\shell\open\command";
+    Subkey = "HSTOffice.Extension.1\shell\open\command";
     Value = "\"<progpath>\program\soffice.exe\" -o \"%1\"";
     Styles = ();
 End
@@ -574,7 +574,7 @@
 RegistryItem gid_Regitem_Office_Extension_1_Defaulticon
     ParentID = PREDEFINED_HKEY_CLASSES_ROOT;
     ModuleID = gid_Module_Root;
-    Subkey = "office.Extension.1\DefaultIcon";
+    Subkey = "HSTOffice.Extension.1\DefaultIcon";
     Value = "<progpath>\program\soffice.bin,13";
     Styles = ();
 End
@@ -616,7 +616,7 @@
     Subkey = "Software\%MANUFACTURER\%PRODUCTNAME%PRODUCTADDON\%PRODUCTVERSION\Capabilities\FileAssociations";
     ModuleID = gid_Module_Root;
     Name = ".oxt";
-    Value = "office.Extension.1";
+    Value = "HSTOffice.Extension.1";
     Styles = ();
 End
 
