+#include "HstQuickAccess.hxx"
+
+#include <comphelper/dispatchcommand.hxx>
+#include <comphelper/propertyvalue.hxx>
+#include <sfx2/sfxresid.hxx>
+#include <sfx2/strings.hrc>
+#include <vcl/commandinfoprovider.hxx>
+#include <vcl/menu.hxx>
+#include <vcl/svapp.hxx>
+#include <vcl/toolbox.hxx>
+
+#include <algorithm>
+
+using namespace css;
+
+namespace
+{
+constexpr OUString QAT_URL = u"private:resource/toolbar/notebookbarshortcuts"_ustr;
+// menu ids below the toolbox's own (TOOLBOX_MENUITEM_START): the checklist, then the two actions
+constexpr sal_uInt16 ID_CHECK = 0x0e00, ID_CUSTOMIZE = 0x0e40, ID_PLACEMENT = 0x0e41;
+
+}
+
+HstQuickAccess::HstQuickAccess(ToolBox& rQat, OUString aApp, const Link<LinkParamNone*, void>& rPlacement)
+    : m_rQat(rQat)
+    , m_aApp(std::move(aApp))
+    , m_aPlacement(rPlacement)
+    , m_bBelow(hst::qat::StoredBelow(m_aApp))
+{
+    // one line that clips what does not fit (WB_SCROLL) into the menu button at its end
+    m_rQat.SetStyle(m_rQat.GetStyle() | WB_SCROLL);
+    m_rQat.SetMenuType(ToolBoxMenuType::Customize | ToolBoxMenuType::ClippedItems);
+    m_rQat.SetMenuButtonHdl(LINK(this, HstQuickAccess, MenuButtonHdl));
+    if (PopupMenu* pMenu = m_rQat.GetMenu())
+        pMenu->SetSelectHdl(LINK(this, HstQuickAccess, MenuSelectHdl));
+}
+
+HstQuickAccess::~HstQuickAccess()
+{
+    if (m_pCustomizeEvent)
+        Application::RemoveUserEvent(m_pCustomizeEvent);
+}
+
+std::vector<OUString> HstQuickAccess::Checklist(std::u16string_view rApp)
+{
+    const OUString aOpen = rApp == u"writer" ? u".uno:OpenFromWriter"_ustr
+                           : rApp == u"calc" ? u".uno:OpenFromCalc"_ustr : u".uno:Open"_ustr;
+    return { u".uno:AddDirect"_ustr, aOpen, u".uno:Save"_ustr, u".uno:Print"_ustr, u".uno:PrintPreview"_ustr,
+             u".uno:SendMail"_ustr, u".uno:Undo"_ustr, u".uno:Redo"_ustr };
+}
+
+bool HstQuickAccess::IsShown(const OUString& rCommand) const
+{
+    for (ToolBox::ImplToolItems::size_type i = 0; i < m_rQat.GetItemCount(); ++i)
+        if (m_rQat.GetItemCommand(m_rQat.GetItemId(i)) == rCommand)
+            return true;
+    return false;
+}
+
+IMPL_LINK(HstQuickAccess, MenuButtonHdl, ToolBox*, pBox, void)
+{
+    PopupMenu* pMenu = pBox ? pBox->GetMenu() : nullptr;
+    if (!pMenu || !m_xFrame.is())
+        return;
+    // the toolbox has put its overflow (») buttons first; the checklist and the actions follow
+    if (pMenu->GetItemCount())
+        pMenu->InsertSeparator();
+    const OUString aModule = vcl::CommandInfoProvider::GetModuleIdentifier(m_xFrame);
+    const std::vector<OUString> aList = Checklist(m_aApp);
+    for (size_t i = 0; i < aList.size(); ++i)
+    {
+        const auto aProps = vcl::CommandInfoProvider::GetCommandProperties(aList[i], aModule);
+        pMenu->InsertItem(ID_CHECK + i, vcl::CommandInfoProvider::GetMenuLabelForCommand(aProps),
+                          MenuItemBits::CHECKABLE);
+        pMenu->SetItemCommand(ID_CHECK + i, aList[i]);
+        pMenu->CheckItem(ID_CHECK + i, IsShown(aList[i]));
+    }
+    pMenu->InsertSeparator();
+    pMenu->InsertItem(ID_CUSTOMIZE, SfxResId(STR_HST_QAT_CUSTOMIZE));
+    pMenu->InsertItem(ID_PLACEMENT, SfxResId(m_bBelow ? STR_HST_QAT_ABOVE : STR_HST_QAT_BELOW));
+}
+
+IMPL_LINK(HstQuickAccess, MenuSelectHdl, Menu*, pMenu, bool)
+{
+    const sal_uInt16 nId = pMenu ? pMenu->GetCurItemId() : 0;
+    const std::vector<OUString> aList = Checklist(m_aApp);
+    if (nId >= ID_CHECK && nId < ID_CHECK + aList.size())
+        hst::qat::SetCommand(m_xFrame, aList[nId - ID_CHECK], !IsShown(aList[nId - ID_CHECK]), false);
+    else if (nId == ID_CUSTOMIZE && !m_pCustomizeEvent)
+        m_pCustomizeEvent = Application::PostUserEvent(LINK(this, HstQuickAccess, CustomizeHdl));
+    else if (nId == ID_PLACEMENT)
+    {
+        m_bBelow = !m_bBelow;
+        hst::qat::StoreBelow(m_aApp, m_bBelow);
+        m_aPlacement.Call(nullptr);
+    }
+    else
+        return false; // an overflow button: the toolbox runs it
+    return true;
+}
+
+IMPL_LINK_NOARG(HstQuickAccess, CustomizeHdl, void*, void)
+{
+    m_pCustomizeEvent = nullptr;
+    // the Customize dialog on its Toolbars page with this toolbar selected
+    comphelper::dispatchCommand(u".uno:ConfigureDialog"_ustr, m_xFrame,
+                                { comphelper::makePropertyValue(u"ResourceURL"_ustr, QAT_URL) });
+}
+
+bool HstQuickAccess::ContextMenu(ToolBox& rBox, const Point& rPos, bool bMouse)
+{
+    const ToolBoxItemId nItem = bMouse ? rBox.GetItemId(rPos) : rBox.GetHighlightItemId();
+    const OUString aCommand = nItem ? rBox.GetItemCommand(nItem) : OUString();
+    if (aCommand.isEmpty() || !m_xFrame.is())
+        return false;
+    const bool bInQat = &rBox == &m_rQat;
+    if (!bInQat && IsShown(aCommand))
+        return false; // already there: nothing to offer
+    ScopedVclPtrInstance<PopupMenu> pMenu;
+    pMenu->InsertItem(1, SfxResId(bInQat ? STR_HST_QAT_REMOVE : STR_HST_QAT_ADD));
+    const tools::Rectangle aAt = bMouse ? tools::Rectangle(rPos, Size(1, 1)) : rBox.GetItemRect(nItem);
+    if (pMenu->Execute(&rBox, aAt, PopupMenuFlags::ExecuteDown) != 1)
+        return true;
+    const std::vector<OUString> aList = Checklist(m_aApp);
+    const bool bListed = std::find(aList.begin(), aList.end(), aCommand) != aList.end();
+    hst::qat::SetCommand(m_xFrame, aCommand, !bInQat, bInQat && !bListed); // a checklist command stays in the list, hidden
+    return true;
+}
