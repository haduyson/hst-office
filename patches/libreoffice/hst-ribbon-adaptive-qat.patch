+// a right-click (or the context menu key) on a ribbon button offers to add its command to the quick access
+// toolbar; on a quick access button, to remove it
+bool NotebookbarTabControl::PreNotify( NotifyEvent& rNEvt )
+{
+    if (m_pHstQat && rNEvt.GetType() == NotifyEventType::COMMAND)
+    {
+        const CommandEvent* pCommand = rNEvt.GetCommandEvent();
+        ToolBox* pBox = dynamic_cast<ToolBox*>(rNEvt.GetWindow());
+        if (pCommand && pBox && pCommand->GetCommand() == CommandEventId::ContextMenu
+            && m_pHstQat->ContextMenu(*pBox, pCommand->GetMousePosPixel(), pCommand->IsMouseEvent()))
+            return true;
+    }
+    return NotebookbarTabControlBase::PreNotify(rNEvt);
+}
