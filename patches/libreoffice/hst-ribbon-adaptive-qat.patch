+/** HST Office (1.0.2 ribbon, owner decision 14/11/2026): the quick access toolbar of Writer, Sheets, Slides and
+    Draw is the notebookbar's shortcuts toolbox at the start of the tab row (or on its own row below the ribbon).
+
+    Its commands are the app's "private:resource/toolbar/notebookbarshortcuts" UI configuration, saved in the
+    user profile per app and independent of where the toolbar stands, so a later title-bar placement reads the
+    same list. The toolbox's ▾ menu (its overflow » items first) offers the common-command checklist,
+    "Tùy chỉnh…" (the Customize dialog on this toolbar) and "Hiện bên dưới/trên ribbon" (HSTRibbon/QatBelowApps);
+    a right-click on a ribbon button adds its command, on a quick access button removes it. */
+class HstQuickAccess
+{
+public:
+    /// rApp: writer, calc, impress or draw; rPlacement runs when the user moves the toolbar above/below
+    HstQuickAccess(ToolBox& rQat, OUString aApp, const Link<LinkParamNone*, void>& rPlacement);
+    ~HstQuickAccess();
+
+    void SetFrame(const css::uno::Reference<css::frame::XFrame>& xFrame) { m_xFrame = xFrame; }
+    bool IsBelow() const { return m_bBelow; }
+
+    /// a context menu requested on rBox at rPos (pixels of rBox; a key request uses the highlighted item):
+    /// "Thêm vào…" for a ribbon command, "Xóa khỏi…" on the quick access toolbar. True when handled.
+    bool ContextMenu(ToolBox& rBox, const Point& rPos, bool bMouse);
+
+    /// the commands of the ▾ checklist for rApp (Mới, Mở, Lưu, In, Xem trước khi in, Gửi thư, Hoàn tác, Làm lại)
+    static std::vector<OUString> Checklist(std::u16string_view rApp);
+
+private:
+    DECL_LINK(MenuButtonHdl, ToolBox*, void);
+    DECL_LINK(MenuSelectHdl, Menu*, bool);
+    DECL_LINK(CustomizeHdl, void*, void);
+
+    bool IsShown(const OUString& rCommand) const;
+
+    ToolBox& m_rQat;
+    OUString m_aApp;
+    Link<LinkParamNone*, void> m_aPlacement;
+    css::uno::Reference<css::frame::XFrame> m_xFrame;
+    bool m_bBelow;
+    ImplSVEvent* m_pCustomizeEvent = nullptr;
+};
