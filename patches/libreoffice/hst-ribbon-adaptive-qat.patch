+// HST Office: where the quick access toolbar's settings live (HstQuickAccess.hxx): its commands in the app's
+// notebookbarshortcuts UI configuration, its placement in HSTRibbon/QatBelowApps.
+
+#include "HstQuickAccess.hxx"
+#include "HstRibbonCompact.hxx"
+
+#include <com/sun/star/container/XIndexContainer.hpp>
+#include <com/sun/star/ui/ItemType.hpp>
+#include <com/sun/star/ui/XUIConfigurationPersistence.hpp>
+#include <com/sun/star/ui/theModuleUIConfigurationManagerSupplier.hpp>
+#include <comphelper/processfactory.hxx>
+#include <comphelper/propertyvalue.hxx>
+#include <comphelper/diagnose_ex.hxx>
+#include <vcl/commandinfoprovider.hxx>
+
+#include <algorithm>
+
+using namespace css;
+
+namespace
+{
+constexpr OUString QAT_URL = u"private:resource/toolbar/notebookbarshortcuts"_ustr;
+
+uno::Reference<ui::XUIConfigurationManager> config(const uno::Reference<frame::XFrame>& xFrame)
+{
+    const OUString aModule = vcl::CommandInfoProvider::GetModuleIdentifier(xFrame);
+    return ui::theModuleUIConfigurationManagerSupplier::get(comphelper::getProcessComponentContext())
+        ->getUIConfigurationManager(aModule);
+}
+
+OUString commandOf(const uno::Any& rItem, bool* pVisible = nullptr)
+{
+    uno::Sequence<beans::PropertyValue> aProps;
+    rItem >>= aProps;
+    OUString aCommand;
+    for (const auto& rProp : aProps)
+        if (rProp.Name == "CommandURL")
+            rProp.Value >>= aCommand;
+        else if (rProp.Name == "IsVisible" && pVisible)
+            rProp.Value >>= *pVisible;
+    return aCommand;
+}
+}
+
+namespace hst::qat
+{
+namespace compact = hst::ribbon::compact;
+
+bool StoredBelow(std::u16string_view rApp) { return compact::AppListed(u"QatBelowApps"_ustr, rApp); }
+
+void StoreBelow(const OUString& rApp, bool bBelow) { compact::SetAppListed(u"QatBelowApps"_ustr, rApp, bBelow); }
+
+void SetCommand(const uno::Reference<frame::XFrame>& xFrame, const OUString& rCommand, bool bShown, bool bRemove)
+{
+    if (!xFrame.is() || rCommand.isEmpty())
+        return;
+    try
+    {
+        const uno::Reference<ui::XUIConfigurationManager> xConfig = config(xFrame);
+        uno::Reference<container::XIndexContainer> xItems(xConfig->getSettings(QAT_URL, true), uno::UNO_QUERY_THROW);
+        sal_Int32 nFound = -1;
+        for (sal_Int32 i = 0; i < xItems->getCount() && nFound < 0; ++i)
+            if (commandOf(xItems->getByIndex(i)) == rCommand)
+                nFound = i;
+        const uno::Sequence<beans::PropertyValue> aItem{
+            comphelper::makePropertyValue(u"CommandURL"_ustr, rCommand),
+            comphelper::makePropertyValue(u"Label"_ustr, OUString()),
+            comphelper::makePropertyValue(u"Type"_ustr, ui::ItemType::DEFAULT),
+            comphelper::makePropertyValue(u"Style"_ustr, sal_Int16(0)),
+            comphelper::makePropertyValue(u"IsVisible"_ustr, bShown) };
+        if (nFound >= 0 && bRemove)
+            xItems->removeByIndex(nFound);
+        else if (nFound >= 0)
+            xItems->replaceByIndex(nFound, uno::Any(aItem));
+        else if (bShown)
+            xItems->insertByIndex(xItems->getCount(), uno::Any(aItem));
+        xConfig->replaceSettings(QAT_URL, xItems); // the tab control refills the toolbar (its listener)
+        uno::Reference<ui::XUIConfigurationPersistence>(xConfig, uno::UNO_QUERY_THROW)->store();
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("sfx.notebookbar", "quick access toolbar not changed");
+    }
+}
