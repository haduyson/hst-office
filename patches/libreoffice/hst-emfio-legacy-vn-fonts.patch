+namespace
+{
+// Minimal WMF writer for the legacy Vietnamese font test: records are (function, 16-bit words)
+void writeWmfRecord(SvMemoryStream& rStream, sal_uInt16 nFunction, const std::vector<sal_uInt16>& rWords)
+{
+    rStream.WriteUInt32(3 + rWords.size()).WriteUInt16(nFunction);
+    for (sal_uInt16 nWord : rWords)
+        rStream.WriteUInt16(nWord);
+}
+
+std::vector<sal_uInt16> wmfBytes(std::string_view aBytes)
+{
+    std::vector<sal_uInt16> aWords;
+    for (size_t i = 0; i < aBytes.size(); i += 2)
+        aWords.push_back(static_cast<unsigned char>(aBytes[i])
+                         | (i + 1 < aBytes.size() ? static_cast<unsigned char>(aBytes[i + 1]) << 8 : 0));
+    return aWords;
+}
+
+void writeWmfFont(SvMemoryStream& rStream, std::string_view aFace)
+{
+    // LOGFONT16: height 240, width/escapement/orientation 0, weight 400, flags, DEFAULT_CHARSET (1)
+    std::vector<sal_uInt16> aWords{ 240, 0, 0, 0, 400, 0, 0x0100, 0, 0 };
+    char aName[32] = {};
+    std::copy(aFace.begin(), aFace.end(), aName);
+    for (sal_uInt16 nWord : wmfBytes(std::string_view(aName, sizeof aName)))
+        aWords.push_back(nWord);
+    writeWmfRecord(rStream, 0x02FB, aWords); // META_CREATEFONTINDIRECT
+    writeWmfRecord(rStream, 0x012D, { 0 }); // META_SELECTOBJECT
+}
+
+void writeWmfExtTextOut(SvMemoryStream& rStream, sal_uInt16 nY, std::string_view aText)
+{
+    std::vector<sal_uInt16> aWords{ nY, 100, sal_uInt16(aText.size()), 0 };
+    for (sal_uInt16 nWord : wmfBytes(aText))
+        aWords.push_back(nWord);
+    for (size_t i = 0; i < aText.size(); ++i)
+        aWords.push_back(100); // dx: 100 per byte
+    writeWmfRecord(rStream, 0x0A32, aWords); // META_EXTTEXTOUT
+}
+}
