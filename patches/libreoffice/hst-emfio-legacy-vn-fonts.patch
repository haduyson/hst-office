+void WmfTest::testLegacyVietnameseFontsWmf()
+{
+    // HST Office: MathType equations in Vietnamese documents often use TCVN3 (".VnTime") or
+    // VNI ("VNI-Times") fonts for their text. Such text is decoded to Unicode and drawn with
+    // the Unicode equivalent of the font, so it does not depend on the legacy font being
+    // installed (and on the system code page).
+    SvMemoryStream aStream;
+    aStream.WriteUInt16(1).WriteUInt16(9).WriteUInt16(0x0300); // memory metafile, header words, version
+    aStream.WriteUInt32(0).WriteUInt16(1).WriteUInt32(0).WriteUInt16(0); // size (patched below), objects
+    writeWmfRecord(aStream, 0x020B, { 0, 0 }); // META_SETWINDOWORG
+    writeWmfRecord(aStream, 0x020C, { 1000, 2000 }); // META_SETWINDOWEXT
+    writeWmfFont(aStream, ".VnTime");
+    writeWmfExtTextOut(aStream, 100, "NaCl (r\xbe" "n) H\xb5m l\xad\xee" "ng"); // "NaCl (rắn) Hàm lượng"
+    writeWmfRecord(aStream, 0x01F0, { 0 }); // META_DELETEOBJECT
+    writeWmfFont(aStream, "VNI-Times");
+    writeWmfExtTextOut(aStream, 400, "Ho\xf8" "a tan"); // VNI: o + 0xF8 = "ò"
+    writeWmfRecord(aStream, 0x01F0, { 0 });
+    writeWmfFont(aStream, ".VnTimeH");
+    writeWmfExtTextOut(aStream, 700, "\xae" "i\xd6" "n"); // uppercase font: "ĐIỆN"
+    writeWmfRecord(aStream, 0x01F0, { 0 });
+    writeWmfFont(aStream, "Times New Roman");
+    writeWmfExtTextOut(aStream, 1000, "x\xb0"); // not a legacy font: Windows code page, unchanged
+    writeWmfRecord(aStream, 0x0000, {}); // EOF
+    aStream.Seek(6);
+    aStream.WriteUInt32(aStream.TellEnd() / 2);
+    aStream.Seek(0);
+
+    GDIMetaFile aGDIMetaFile;
+    ReadWindowMetafile(aStream, aGDIMetaFile);
+    xmlDocUniquePtr pDoc = dumpAndParse(aGDIMetaFile);
+    CPPUNIT_ASSERT(pDoc);
+
+    // Without the fix: "NaCl (r¾n) Hµm l­îng" in the font ".VnTime"
+    assertXPathContent(pDoc, "(//textarray)[1]/text", u"NaCl (rắn) Hàm lượng");
+    assertXPath(pDoc, "//font[@name='.VnTime']", 0);
+    assertXPath(pDoc, "//font[@name='VNI-Times']", 0);
+    assertXPath(pDoc, "(//textarray)[1]/preceding-sibling::font[1]", "name", u"Times New Roman");
+    // Without the fix: "Hoøa tan"; the letter + tone mark bytes give one character with both advances
+    assertXPathContent(pDoc, "(//textarray)[2]/text", u"Hòa tan");
+    assertXPath(pDoc, "(//textarray)[2]", "length", u"7");
+    assertXPathContent(pDoc, "(//textarray)[3]/text", u"ĐIỆN");
+    assertXPathContent(pDoc, "(//textarray)[4]/text", u"x°");
+}
