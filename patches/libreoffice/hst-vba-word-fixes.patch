 SwVbaRange::getText()
 {
-    OUString aText = mxTextCursor->getString();
+    // HST: Word gives a paragraph mark as vbCr, whatever the line end of the system
+    OUString aText = mxTextCursor->getString().replaceAll("\r\n", "\r").replaceAll("\n", "\r");
     sal_Int32 nLen = aText.getLength();
 
     // FIXME: should add a line separator if the range includes the last paragraph
