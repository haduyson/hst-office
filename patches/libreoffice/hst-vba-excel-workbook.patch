+const char* const aBuiltin[] = { "Title", "Subject", "Author", "Keywords", "Comments", "Template", "Last Author", "Application Name" };
+
+uno::Any lcl_read(const uno::Reference<document::XDocumentProperties>& xDoc, std::u16string_view rName)
+{
+    if (rName == u"Title") return uno::Any(xDoc->getTitle());
+    if (rName == u"Subject") return uno::Any(xDoc->getSubject());
+    if (rName == u"Author") return uno::Any(xDoc->getAuthor());
+    if (rName == u"Comments") return uno::Any(xDoc->getDescription());
+    if (rName == u"Template") return uno::Any(xDoc->getTemplateName());
+    if (rName == u"Last Author") return uno::Any(xDoc->getModifiedBy());
+    if (rName == u"Application Name") return uno::Any(xDoc->getGenerator());
+    if (rName == u"Keywords" && xDoc->getKeywords().hasElements())
+        return uno::Any(xDoc->getKeywords()[0]);
+    return uno::Any();
+}
+
+void lcl_write(const uno::Reference<document::XDocumentProperties>& xDoc, std::u16string_view rName, const uno::Any& rValue)
+{
+    OUString aText;
+    rValue >>= aText;
+    if (rName == u"Title") xDoc->setTitle(aText);
+    else if (rName == u"Subject") xDoc->setSubject(aText);
+    else if (rName == u"Author") xDoc->setAuthor(aText);
+    else if (rName == u"Comments") xDoc->setDescription(aText);
+    else if (rName == u"Last Author") xDoc->setModifiedBy(aText);
+    else if (rName == u"Keywords") xDoc->setKeywords({ aText });
+    else throw uno::RuntimeException(u"This document property cannot be set"_ustr);
+}
+
+class Property : public cppu::ImplInheritanceHelper<InheritedHelperInterfaceWeakImpl<XDocumentProperty>>
+{
+    uno::Reference<document::XDocumentProperties> mxDoc;
+    OUString maName;
+    bool mbCustom;
+
+    uno::Reference<beans::XPropertySet> custom() { return uno::Reference<beans::XPropertySet>(mxDoc->getUserDefinedProperties(), uno::UNO_QUERY_THROW); }
+
+public:
+    Property(const uno::Reference<XHelperInterface>& xParent, const uno::Reference<uno::XComponentContext>& xContext,
+             uno::Reference<document::XDocumentProperties> xDoc, OUString aName, bool bCustom)
+        : ImplInheritanceHelper(xParent, xContext)
+        , mxDoc(std::move(xDoc))
+        , maName(std::move(aName))
+        , mbCustom(bCustom)
+    {
+    }
+    OUString SAL_CALL getDefaultPropertyName() override { return u"Value"_ustr; }
+    void SAL_CALL Delete() override
+    {
+        if (!mbCustom)
+            throw uno::RuntimeException(u"A built-in property cannot be deleted"_ustr);
+        uno::Reference<beans::XPropertyContainer>(custom(), uno::UNO_QUERY_THROW)->removeProperty(maName);
+    }
+    OUString SAL_CALL getName() override { return maName; }
+    void SAL_CALL setName(const OUString&) override { throw uno::RuntimeException(u"Not implemented"_ustr); }
+    ::sal_Int8 SAL_CALL getType() override { return 4; } // msoPropertyTypeString
+    void SAL_CALL setType(::sal_Int8) override { throw uno::RuntimeException(u"Not implemented"_ustr); }
+    sal_Bool SAL_CALL getLinkToContent() override { return false; }
+    void SAL_CALL setLinkToContent(sal_Bool) override { throw uno::RuntimeException(u"Not implemented"_ustr); }
+    uno::Any SAL_CALL getValue() override { return mbCustom ? custom()->getPropertyValue(maName) : lcl_read(mxDoc, maName); }
+    void SAL_CALL setValue(const uno::Any& rValue) override
+    {
+        if (mbCustom)
+            custom()->setPropertyValue(maName, rValue);
+        else
+            lcl_write(mxDoc, maName, rValue);
+    }
+    OUString SAL_CALL getLinkSource() override { return OUString(); }
+    void SAL_CALL setLinkSource(const OUString&) override { throw uno::RuntimeException(u"Not implemented"_ustr); }
+    OUString getServiceImplName() override { return u"ScVbaDocumentProperty"_ustr; }
+    uno::Sequence<OUString> getServiceNames() override { return { u"ooo.vba.DocumentProperty"_ustr }; }
+};
+
+class Names : public ::cppu::WeakImplHelper<container::XIndexAccess, container::XNameAccess>
+{
+    std::vector<OUString> maNames;
+
+public:
+    explicit Names(std::vector<OUString>&& rNames)
+        : maNames(std::move(rNames))
+    {
+    }
+    sal_Int32 SAL_CALL getCount() override { return maNames.size(); }
+    uno::Any SAL_CALL getByIndex(sal_Int32 nIndex) override
+    {
+        if (nIndex < 0 || nIndex >= getCount())
+            throw lang::IndexOutOfBoundsException();
+        return uno::Any(maNames[nIndex]);
+    }
+    uno::Any SAL_CALL getByName(const OUString& rName) override
+    {
+        for (const OUString& rOne : maNames)
+            if (rOne.equalsIgnoreAsciiCase(rName))
+                return uno::Any(rOne);
+        throw container::NoSuchElementException();
+    }
+    uno::Sequence<OUString> SAL_CALL getElementNames() override { return uno::Sequence<OUString>(maNames.data(), maNames.size()); }
+    sal_Bool SAL_CALL hasByName(const OUString& rName) override
+    {
+        for (const OUString& rOne : maNames)
+            if (rOne.equalsIgnoreAsciiCase(rName))
+                return true;
+        return false;
+    }
+    uno::Type SAL_CALL getElementType() override { return cppu::UnoType<OUString>::get(); }
+    sal_Bool SAL_CALL hasElements() override { return !maNames.empty(); }
+};
+
+std::vector<OUString> lcl_names(const uno::Reference<document::XDocumentProperties>& xDoc, bool bCustom)
+{
+    std::vector<OUString> aNames;
+    if (bCustom)
+    {
+        uno::Reference<beans::XPropertySet> xSet(xDoc->getUserDefinedProperties(), uno::UNO_QUERY_THROW);
+        const uno::Sequence<beans::Property> aProps = xSet->getPropertySetInfo()->getProperties();
+        for (const beans::Property& rProp : aProps)
+            aNames.push_back(rProp.Name);
+    }
+    else
+        for (const char* pName : aBuiltin)
+            aNames.push_back(OUString::createFromAscii(pName));
+    return aNames;
+}
+
+class Properties : public CollTestImplHelper<XDocumentProperties>
+{
+    uno::Reference<document::XDocumentProperties> mxDoc;
+    bool mbCustom;
+
+public:
+    Properties(const uno::Reference<XHelperInterface>& xParent, const uno::Reference<uno::XComponentContext>& xContext,
+               const uno::Reference<document::XDocumentProperties>& xDoc, bool bCustom)
+        : CollTestImplHelper(xParent, xContext, new Names(lcl_names(xDoc, bCustom)))
+        , mxDoc(xDoc)
+        , mbCustom(bCustom)
+    {
+    }
+    uno::Reference<XDocumentProperty> SAL_CALL Add(const OUString& rName, sal_Bool, ::sal_Int8, const uno::Any& rValue, const uno::Any&) override
+    {
+        if (!mbCustom)
+            throw uno::RuntimeException(u"Add is for custom properties"_ustr);
+        uno::Reference<beans::XPropertyContainer> xSet(mxDoc->getUserDefinedProperties(), uno::UNO_SET_THROW);
+        xSet->addProperty(rName, beans::PropertyAttribute::REMOVABLE, rValue);
+        return new Property(mxParent, mxContext, mxDoc, rName, true);
+    }
+    uno::Type SAL_CALL getElementType() override { return cppu::UnoType<XDocumentProperty>::get(); }
+    uno::Reference<container::XEnumeration> SAL_CALL createEnumeration() override { throw uno::RuntimeException(u"Not implemented"_ustr); }
+    uno::Any createCollectionObject(const uno::Any& aSource) override
+    {
+        OUString aName;
+        aSource >>= aName;
+        return uno::Any(uno::Reference<XDocumentProperty>(new Property(mxParent, mxContext, mxDoc, aName, mbCustom)));
+    }
+    OUString getServiceImplName() override { return u"ScVbaDocumentProperties"_ustr; }
+    uno::Sequence<OUString> getServiceNames() override { return { u"ooo.vba.DocumentProperties"_ustr }; }
+};
+
+uno::Any lcl_collection(ScVbaWorkbook* pBook, const uno::Reference<frame::XModel>& xModel, const uno::Reference<uno::XComponentContext>& xContext, const uno::Any& rIndex, bool bCustom)
+{
+    uno::Reference<document::XDocumentProperties> xDoc = uno::Reference<document::XDocumentPropertiesSupplier>(xModel, uno::UNO_QUERY_THROW)->getDocumentProperties();
+    uno::Reference<XCollection> xCol(new Properties(uno::Reference<XHelperInterface>(pBook), xContext, xDoc, bCustom));
+    return rIndex.hasValue() ? xCol->Item(rIndex, uno::Any()) : uno::Any(xCol);
+}
+}
+
+uno::Any SAL_CALL ScVbaWorkbook::BuiltinDocumentProperties(const uno::Any& rIndex) { return lcl_collection(this, getModel(), mxContext, rIndex, false); }
+uno::Any SAL_CALL ScVbaWorkbook::CustomDocumentProperties(const uno::Any& rIndex) { return lcl_collection(this, getModel(), mxContext, rIndex, true); }
