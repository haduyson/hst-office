+namespace
+{
+class Filter final : public InheritedHelperInterfaceWeakImpl<excel::XFileDialogFilter>
+{
+    std::pair<OUString, OUString> maEntry;
+
+public:
+    Filter(const uno::Reference<XHelperInterface>& xParent, const uno::Reference<uno::XComponentContext>& xContext,
+           std::pair<OUString, OUString> aEntry)
+        : InheritedHelperInterfaceWeakImpl(xParent, xContext)
+        , maEntry(std::move(aEntry))
+    {
+    }
+    OUString SAL_CALL getDescription() override { return maEntry.first; }
+    OUString SAL_CALL getExtensions() override { return maEntry.second; }
+    OUString getServiceImplName() override { return u"ScVbaFileDialogFilter"_ustr; }
+    uno::Sequence<OUString> getServiceNames() override { return { u"ooo.vba.excel.FileDialogFilter"_ustr }; }
+};
+
+class Filters final : public InheritedHelperInterfaceWeakImpl<excel::XFileDialogFilters>
+{
+    std::vector<std::pair<OUString, OUString>>& mrList;
+
+public:
+    Filters(const uno::Reference<XHelperInterface>& xParent, const uno::Reference<uno::XComponentContext>& xContext,
+            std::vector<std::pair<OUString, OUString>>& rList)
+        : InheritedHelperInterfaceWeakImpl(xParent, xContext)
+        , mrList(rList)
+    {
+    }
+    sal_Int32 SAL_CALL getCount() override { return static_cast<sal_Int32>(mrList.size()); }
+    void SAL_CALL Clear() override { mrList.clear(); }
+    OUString SAL_CALL getDefaultMethodName() override { return u"Item"_ustr; }
+    uno::Reference<excel::XFileDialogFilter> SAL_CALL Item(sal_Int32 nIndex) override
+    {
+        if (nIndex < 1 || nIndex > getCount())
+            throw lang::IndexOutOfBoundsException();
+        return new Filter(this, mxContext, mrList[nIndex - 1]);
+    }
+    void SAL_CALL Add(const OUString& rDescription, const OUString& rExtensions, const uno::Any&) override { mrList.emplace_back(rDescription, rExtensions); }
+    OUString getServiceImplName() override { return u"ScVbaFileDialogFilters"_ustr; }
+    uno::Sequence<OUString> getServiceNames() override { return { u"ooo.vba.excel.FileDialogFilters"_ustr }; }
+};
+}
+
+uno::Reference<excel::XFileDialogFilters> SAL_CALL ScVbaFileDialog::getFilters() { return new Filters(this, mxContext, m_aFilters); }
