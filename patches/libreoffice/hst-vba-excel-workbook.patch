+void SAL_CALL ScVbaWorkbook::RefreshAll()
+{
+    // HST: database ranges from their sources, then pivot tables, then the formulas
+    uno::Reference< beans::XPropertySet > xModelProps( getModel(), uno::UNO_QUERY_THROW );
+    uno::Reference< container::XIndexAccess > xRanges( xModelProps->getPropertyValue( u"DatabaseRanges"_ustr ), uno::UNO_QUERY );
+    for( sal_Int32 i = 0, n = xRanges.is() ? xRanges->getCount() : 0; i < n; ++i )
+        if( uno::Reference< util::XRefreshable > xRefresh{ xRanges->getByIndex( i ), uno::UNO_QUERY } )
+            xRefresh->refresh();
+    uno::Reference< sheet::XSpreadsheetDocument > xDoc( getModel(), uno::UNO_QUERY_THROW );
+    uno::Reference< container::XIndexAccess > xSheets( xDoc->getSheets(), uno::UNO_QUERY_THROW );
+    for( sal_Int32 i = 0, n = xSheets->getCount(); i < n; ++i )
+    {
+        uno::Reference< sheet::XDataPilotTablesSupplier > xPivots( xSheets->getByIndex( i ), uno::UNO_QUERY );
+        uno::Reference< container::XIndexAccess > xTables( xPivots.is() ? xPivots->getDataPilotTables() : nullptr, uno::UNO_QUERY );
+        for( sal_Int32 j = 0, m = xTables.is() ? xTables->getCount() : 0; j < m; ++j )
+            if( uno::Reference< sheet::XDataPilotTable > xTable{ xTables->getByIndex( j ), uno::UNO_QUERY } )
+                xTable->refresh();
+    }
+    uno::Reference< sheet::XCalculatable >( getModel(), uno::UNO_QUERY_THROW )->calculateAll();
+}
