+// HST: the links already in a sheet, which is what a file and earlier Add calls leave
+void ScVbaHlinkContainer::fillFromSheet( const uno::Reference< XHelperInterface >& rxSheet, const uno::Reference< uno::XComponentContext >& rxContext )
+{
+    uno::Reference< excel::XWorksheet > xSheet( rxSheet, uno::UNO_QUERY );
+    uno::Reference< frame::XModel > xModel = ooo::vba::getCurrentExcelDoc( rxContext );
+    ScDocShell* pShell = xSheet.is() ? excel::getDocShell( xModel ) : nullptr;
+    if( !pShell )
+        return;
+    ScDocument& rDoc = pShell->GetDocument();
+    const SCTAB nTab = static_cast< SCTAB >( xSheet->getIndex() - 1 );
+    uno::Reference< sheet::XSpreadsheetDocument > xDoc( xModel, uno::UNO_QUERY_THROW );
+    uno::Reference< table::XCellRange > xCells( xDoc->getSheets()->getByName( xSheet->getName() ), uno::UNO_QUERY_THROW );
+    SCCOL nLastCol = 0;
+    SCROW nLastRow = 0;
+    rDoc.GetCellArea( nTab, nLastCol, nLastRow );
+    for( SCCOL nCol = 0; nCol <= nLastCol; ++nCol )
+        for( SCROW nRow = 0; nRow <= nLastRow; ++nRow )
+        {
+            const ScAddress aPos( nCol, nRow, nTab );
+            if( rDoc.GetCellType( aPos ) != CELLTYPE_EDIT )
+                continue;
+            const EditTextObject* pText = rDoc.GetEditText( aPos );
+            if( !pText || !pText->HasField( text::textfield::Type::URL ) )
+                continue;
+            uno::Sequence< uno::Any > aArgs{ uno::Any( rxSheet ), uno::Any( xCells->getCellByPosition( nCol, nRow ) ) };
+            maHlinks.emplace_back( new ScVbaHyperlink( aArgs, rxContext ) );
+        }
 }
 
