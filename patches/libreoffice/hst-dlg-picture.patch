+/// Word's Size tab: shows the size widgets of the position page, which still owns and reads them.
+class SwHstFrameSizePage final : public SfxTabPage
+{
+    SwFramePage* m_pFramePage = nullptr;
+    SfxTabPage* m_pFrameTabPage = nullptr; // the same page: the page calls are public on this base
