+        SetExchangeSupport();
+    }
+    static std::unique_ptr<SfxTabPage> Create(weld::Container* pPage, weld::DialogController* pController, const SfxItemSet* pSet)
+    {
+        return std::make_unique<SwHstFrameSizePage>(pPage, pController, *pSet);
+    }
+    void TakeSizeFrom(SwFramePage& rFramePage)
+    {
+        m_pFramePage = &rFramePage;
+        m_pFrameTabPage = &rFramePage;
+        rFramePage.HstMoveSizeTo(*m_xBuilder->weld_container(u"HstFrameSizePage"_ustr));
+    }
+    virtual bool FillItemSet(SfxItemSet*) override { return false; }
+    virtual void Reset(const SfxItemSet*) override {}
+    virtual void ActivatePage(const SfxItemSet& rSet) override { m_pFrameTabPage->ActivatePage(rSet); }
+    virtual DeactivateRC DeactivatePage(SfxItemSet* pSet) override { return m_pFrameTabPage->DeactivatePage(pSet); }
+};
+}
