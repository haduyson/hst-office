+void SwWrapTabPage::HstEnableSides()
+{
+    const bool bSides = m_nAnchorId != RndStdIds::FLY_AS_CHAR && !m_xNoWrapRB->get_active()
+                        && !m_xWrapThroughRB->get_active();
+    if (m_bHtmlMode)
+        return;
+    m_xWrapParallelRB->set_sensitive(bSides);
+    m_xWrapLeftRB->set_sensitive(bSides);
+    m_xWrapRightRB->set_sensitive(bSides);
+    m_xIdealWrapRB->set_sensitive(bSides);
+    m_xNoWrapRB->set_sensitive(true);
+    m_xWrapThroughRB->set_sensitive(true);
+}
+
+void SwWrapTabPage::HstShowStyle()
+{
+    m_bHstSync = true;
+    weld::RadioButton* pStyle = m_xHstSquareRB.get();
+    if (m_nAnchorId == RndStdIds::FLY_AS_CHAR)
+        pStyle = m_xHstInlineRB.get();
+    else if (m_xNoWrapRB->get_active())
+        pStyle = m_xHstTopBottomRB.get();
+    else if (m_xWrapThroughRB->get_active())
+        pStyle = m_xWrapTransparentCB->get_active() ? m_xHstBehindRB.get() : m_xHstFrontRB.get();
+    else if (m_xWrapOutlineCB->get_active() && m_xWrapOutlineCB->get_visible())
+        pStyle = m_xWrapOutsideCB->get_active() ? m_xHstTightRB.get() : m_xHstThroughRB.get();
+    pStyle->set_active(true);
+    HstEnableSides();
+    m_bHstSync = false;
+}
+
+IMPL_LINK(SwWrapTabPage, HstStyleHdl, weld::Toggleable&, rButton, void)
+{
+    if (m_bHstSync || !rButton.get_active())
+        return;
+    m_bHstSync = true;
+    const RndStdIds eOldAnchor = m_nAnchorId;
+    if (&rButton == m_xHstInlineRB.get())
+        m_nAnchorId = RndStdIds::FLY_AS_CHAR;
+    else if (m_nAnchorId == RndStdIds::FLY_AS_CHAR)
+        m_nAnchorId = RndStdIds::FLY_AT_PARA;
+
+    const bool bSides = &rButton == m_xHstSquareRB.get() || &rButton == m_xHstTightRB.get()
+                        || &rButton == m_xHstThroughRB.get();
+    if (&rButton == m_xHstTopBottomRB.get())
+        m_xNoWrapRB->set_active(true);
+    else if (&rButton == m_xHstBehindRB.get() || &rButton == m_xHstFrontRB.get())
+        m_xWrapThroughRB->set_active(true);
+    else if (bSides
+             && (eOldAnchor == RndStdIds::FLY_AS_CHAR
+                 || (!m_xWrapParallelRB->get_active() && !m_xWrapLeftRB->get_active()
+                     && !m_xWrapRightRB->get_active() && !m_xIdealWrapRB->get_active())))
+    {
+        m_xWrapParallelRB->set_sensitive(true);
+        m_xWrapParallelRB->set_active(true);
+    }
+    WrapTypeHdl(*m_xWrapParallelRB);
+    if (m_xWrapTransparentCB->get_sensitive())
+        m_xWrapTransparentCB->set_active(&rButton == m_xHstBehindRB.get());
+    if (bSides)
+    {
+        m_xWrapOutlineCB->set_active(&rButton != m_xHstSquareRB.get());
+        m_xWrapOutsideCB->set_active(&rButton == m_xHstTightRB.get());
+    }
+    ContourHdl(*m_xWrapOutlineCB);
+    HstEnableSides();
+
+    if (m_nAnchorId != eOldAnchor)
+    {
+        m_bHstAnchorChanged = true;
+        if (auto* pDialog = dynamic_cast<SwFrameDlg*>(GetDialogController()))
+            pDialog->HstSetAnchor(m_nAnchorId);
+    }
+    m_bHstSync = false;
+}
