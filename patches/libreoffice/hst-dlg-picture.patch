+public:
+    SwHstFrameSizePage(weld::Container* pPage, weld::DialogController* pController, const SfxItemSet& rSet)
+        : SfxTabPage(pPage, pController, u"modules/swriter/ui/hstframesizepage.ui"_ustr, u"HstFrameSizePage"_ustr, &rSet)
