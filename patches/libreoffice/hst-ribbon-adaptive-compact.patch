+/** A flat chevron button (˄ or ˅), as the ribbon's own corner buttons in Office. */
+class HstChevron final : public Control
+{
+public:
+    HstChevron(vcl::Window* pParent, bool bUp, const OUString& rTip, const Link<LinkParamNone*, void>& rClick)
+        : Control(pParent, WB_NOPOINTERFOCUS)
+        , m_bUp(bUp)
+        , m_aClick(rClick)
+    {
+        SetQuickHelpText(rTip);
+        SetAccessibleName(rTip);
+        SetAccessibleRole(css::accessibility::AccessibleRole::PUSH_BUTTON);
+        SetPaintTransparent(true);
+    }
+
+    void Paint(vcl::RenderContext& rDev, const tools::Rectangle&) override
+    {
+        const StyleSettings& rStyle = rDev.GetSettings().GetStyleSettings();
+        const Size aSize = GetOutputSizePixel();
+        if (m_bHover)
+        {
+            rDev.SetLineColor();
+            rDev.SetFillColor(hst::ribbon::paletteFor(rStyle).aHover);
+            rDev.DrawRect(tools::Rectangle(Point(), aSize));
+        }
+        const double fDpi = GetDPIScaleFactor();
+        const long nHalf = px(4, fDpi), nRise = px(2, fDpi);
+        const Point aMid(aSize.Width() / 2, aSize.Height() / 2);
+        const long nTip = m_bUp ? -nRise : nRise;
+        tools::Polygon aChevron(3);
+        aChevron.SetPoint(Point(aMid.X() - nHalf, aMid.Y() - nTip), 0);
+        aChevron.SetPoint(Point(aMid.X(), aMid.Y() + nTip), 1);
+        aChevron.SetPoint(Point(aMid.X() + nHalf, aMid.Y() - nTip), 2);
+        rDev.SetLineColor(rStyle.GetButtonTextColor());
+        rDev.DrawPolyLine(aChevron, LineInfo(LineStyle::Solid, std::max<long>(1, px(1, fDpi))));
+    }
+
+    void MouseMove(const MouseEvent& rEvent) override
+    {
+        if (m_bHover != !rEvent.IsLeaveWindow())
+        {
+            m_bHover = !rEvent.IsLeaveWindow();
+            Invalidate();
+        }
+    }
+
+    void MouseButtonUp(const MouseEvent& rEvent) override
+    {
+        if (rEvent.IsLeft() && tools::Rectangle(Point(), GetOutputSizePixel()).Contains(rEvent.GetPosPixel()))
+            m_aClick.Call(nullptr);
+    }
+
+private:
+    bool m_bUp;
+    bool m_bHover = false;
+    Link<LinkParamNone*, void> m_aClick;
+};
+
+/** The quick row: the tab's commands with their own controllers, icon and label, as the ribbon shows them. */
+class HstQuickToolBox final : public sfx2::sidebar::SidebarToolBox
+{
+public:
+    explicit HstQuickToolBox(vcl::Window* pParent)
+        : sfx2::sidebar::SidebarToolBox(pParent)
+    {
+        mbUseDefaultButtonSize = false;
+        mbSideBar = false;
+        SetToolboxButtonSize(ToolBoxButtonSize::Small);
+        SetButtonType(ButtonType::SYMBOLTEXT);
+        hst::ribbon::SetOwnerDraw(*this, true);
+    }
+};
+}
+
+/** The id of the merged group box (PriorityMergedHBox "pmhb...") of a tab page, or empty. */
+OUString boxOf(const vcl::Window& rWindow)
+{
+    for (vcl::Window* pChild = rWindow.GetWindow(GetWindowType::FirstChild); pChild;
+         pChild = pChild->GetWindow(GetWindowType::Next))
+    {
+        if (pChild->get_id().startsWith("pmhb"))
+            return pChild->get_id();
+        if (OUString aBox = boxOf(*pChild); !aBox.isEmpty())
+            return aBox;
+    }
+    return OUString();
+}
+
+/** The label the ribbon gives rCommand on the page (its two lines joined), or empty. */
+OUString ribbonLabel(const vcl::Window& rWindow, const OUString& rCommand)
+{
+    for (vcl::Window* pChild = rWindow.GetWindow(GetWindowType::FirstChild); pChild;
+         pChild = pChild->GetWindow(GetWindowType::Next))
+    {
+        if (const ToolBox* pBox = dynamic_cast<const ToolBox*>(pChild))
+            for (ToolBox::ImplToolItems::size_type i = 0; i < pBox->GetItemCount(); ++i)
+                if (pBox->GetItemCommand(pBox->GetItemId(i)) == rCommand)
+                    return pBox->GetItemText(pBox->GetItemId(i)).replace('\n', ' ');
+        if (OUString aLabel = ribbonLabel(*pChild, rCommand); !aLabel.isEmpty())
+            return aLabel;
+    }
+    return OUString();
+}
+
+VclPtr<Control> CreateChevron(vcl::Window* pParent, bool bUp, const OUString& rTip,
+                              const Link<LinkParamNone*, void>& rClick)
+{
+    return VclPtr<HstChevron>::Create(pParent, bUp, rTip, rClick);
+}
+
+VclPtr<ToolBox> CreateQuickRow(vcl::Window* pParent) { return VclPtr<HstQuickToolBox>::Create(pParent); }
+}
