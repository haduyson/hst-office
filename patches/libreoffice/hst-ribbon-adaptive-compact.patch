+
+// HST Office (1.0.2 ribbon, compact state): a click on a tab of the compact ribbon drops that tab's full
+// page over the document, below the tab row and left of the banner, as Office does with a collapsed ribbon.
+// The page itself moves into the popup (as the folded groups' popup, NotebookbarPopup, moves its content)
+// and returns, hidden, to the tab control when the popup ends: Esc, a click outside, a command run from it,
+// or the control going away.
+
+#include <vcl/event.hxx>
+#include <vcl/settings.hxx>
+#include <vcl/svapp.hxx>
+#include <vcl/tabctrl.hxx>
+#include <vcl/tabpage.hxx>
+#include <vcl/toolkit/floatwin.hxx>
+#include <vcl/vclevent.hxx>
+
+#include <algorithm>
+#include <cmath>
+
+namespace
+{
+class HstRibbonDrop final : public FloatingWindow
+{
+public:
+    HstRibbonDrop(vcl::Window* pTabs, TabPage* pPage)
+        : FloatingWindow(pTabs, WB_BORDER | WB_SYSTEMWINDOW)
+        , m_xTabs(pTabs)
+        , m_xPage(pPage)
+    {
+        // the ribbon's own background (theme or persona of the notebookbar), else the dialog colour
+        vcl::Window* pPainted = pTabs;
+        while (pPainted && !pPainted->IsBackground())
+            pPainted = pPainted->GetParent();
+        SetBackground(pPainted ? pPainted->GetBackground()
+                               : Wallpaper(GetSettings().GetStyleSettings().GetDialogColor()));
+        Application::AddEventListener(LINK(this, HstRibbonDrop, EventHdl));
+    }
+    ~HstRibbonDrop() override { disposeOnce(); }
+
+    void dispose() override
+    {
+        Application::RemoveEventListener(LINK(this, HstRibbonDrop, EventHdl));
+        if (m_pCloseEvent)
+        {
+            Application::RemoveUserEvent(m_pCloseEvent);
+            m_pCloseEvent = nullptr;
+        }
+        GiveBack();
+        m_xTabs.reset();
+        FloatingWindow::dispose();
+    }
+
+    void PopupModeEnd() override
+    {
+        GiveBack();
+        FloatingWindow::PopupModeEnd();
+    }
+
+    bool HasPage() const { return m_xPage && m_xPage->GetParent() == this; }
+
+private:
+    void GiveBack()
+    {
+        if (HasPage())
+        {
+            m_xPage->Hide();
+            m_xPage->SetParent(m_xTabs);
+        }
+        m_xPage.reset();
+    }
+
+    // a command run from the dropped page (a toolbox item's own command, not its menu) closes the popup,
+    // after the command has been dispatched
+    DECL_LINK(EventHdl, VclSimpleEvent&, void);
+    DECL_LINK(CloseHdl, void*, void);
+
+    VclPtr<vcl::Window> m_xTabs;
+    VclPtr<TabPage> m_xPage;
+    ImplSVEvent* m_pCloseEvent = nullptr;
+};
+
+IMPL_LINK(HstRibbonDrop, EventHdl, VclSimpleEvent&, rEvent, void)
+{
+    if (rEvent.GetId() != VclEventId::ToolboxSelect || m_pCloseEvent || !HasPage())
+        return;
+    const vcl::Window* pWindow = static_cast<VclWindowEvent&>(rEvent).GetWindow();
+    if (pWindow && IsWindowOrChild(pWindow, true))
+        m_pCloseEvent = Application::PostUserEvent(LINK(this, HstRibbonDrop, CloseHdl));
+}
+
+IMPL_LINK_NOARG(HstRibbonDrop, CloseHdl, void*, void)
+{
+    m_pCloseEvent = nullptr;
+    if (IsInPopupMode())
+        EndPopupMode();
+}
+}
+
+bool NotebookbarTabControlBase::HstDropPage(tools::Long nWidth)
+{
+    HstCloseDrop();
+    TabPage* pPage = GetTabPage(GetCurPageId());
+    if (!pPage || nWidth <= 0 || !IsReallyVisible())
+        return false;
+    // as high as the pages of the full ribbon (the tallest page's request; the tab row aside)
+    sal_uInt16 nHeader = m_nHeaderHeight;
+    const tools::Long nHeight = std::max<tools::Long>(
+        ImplCalculateRequisition(nHeader).Height() - m_nHeaderHeight, std::lround(60 * GetDPIScaleFactor()));
+    VclPtr<HstRibbonDrop> xDrop = VclPtr<HstRibbonDrop>::Create(this, pPage);
+    m_xHstDrop = xDrop;
+    xDrop->SetOutputSizePixel(Size(nWidth, nHeight));
+    pPage->SetParent(xDrop);
+    pPage->SetPosSizePixel(Point(0, 0), Size(nWidth, nHeight));
+    pPage->Show();
+    // below the tab row, from the control's left edge
+    xDrop->StartPopupMode(tools::Rectangle(Point(0, 0), Size(1, m_nHeaderHeight)),
+                          FloatWinPopupFlags::Down | FloatWinPopupFlags::GrabFocus
+                              | FloatWinPopupFlags::AllMouseButtonClose
+                              | FloatWinPopupFlags::NoHorzPlacement);
+    return true;
+}
+
+void NotebookbarTabControlBase::HstCloseDrop()
+{
+    if (!m_xHstDrop)
+        return;
+    VclPtr<vcl::Window> xDrop = m_xHstDrop;
+    m_xHstDrop.reset();
+    if (auto* pDrop = dynamic_cast<HstRibbonDrop*>(xDrop.get()); pDrop && pDrop->IsInPopupMode())
+        pDrop->EndPopupMode(); // gives the page back
+    xDrop.disposeAndClear();
+}
+
+bool NotebookbarTabControlBase::HstIsDropped() const
+{
+    const auto* pDrop = dynamic_cast<const HstRibbonDrop*>(m_xHstDrop.get());
+    return pDrop && pDrop->IsInPopupMode() && pDrop->HasPage();
+}
