+tools::Long NotebookbarTabControl::HstCompactReserve() const
+{
+    // the banner of the compact ribbon, its 4 px right margin and an 8 px gap before it
+    const double fDpi = GetDPIScaleFactor();
+    return hst::banner::stripSlot(HstRibbonCompact::BandHeight(fDpi), fDpi).w + hst::banner::scaled(12, fDpi);
+}
+
+void NotebookbarTabControl::HstSetCompact( bool bCompact )
+{
+    if (!m_pHstCompact || bCompact == m_pHstCompact->IsCompact())
+        return;
+    HstCloseDrop();
+    m_pHstCompact->SetCompact(bCompact);
+    TabPage* pPage = GetTabPage(GetCurPageId());
+    if (bCompact)
+    {
+        if (pPage)
+            pPage->Hide();
+        m_pHstCompact->Fill(pPage, m_xFrame);
+    }
+    else
+    {
+        HstSetRowReserve(0);
+        if (pPage)
+            pPage->Show();
+    }
+    // the notebookbar takes its new height (its height never drops below its content's request) and the
+    // window gives the document the difference
+    queue_resize();
+    for (vcl::Window* pParent = GetParent(); pParent; pParent = pParent->GetParent())
+    {
+        if (NotebookBar* pBar = dynamic_cast<NotebookBar*>(pParent))
+        {
+            pBar->SetSizePixel(Size(pBar->GetSizePixel().Width(), 0));
+            if (vcl::Window* pFrame = pBar->GetParent())
+                pFrame->Resize();
+            break;
+        }
+    }
+    HstLayoutBanner();
+}
+
+void NotebookbarTabControl::HstDrop()
+{
+    if (m_pHstCompact && m_pHstCompact->IsCompact())
+        HstDropPage(GetOutputSizePixel().Width() - HstCompactReserve());
+}
+
+IMPL_LINK_NOARG(NotebookbarTabControl, HstToggleHdl, LinkParamNone*, void)
+{
+    HstSetCompact(!m_pHstCompact->IsCompact());
+}
+
+IMPL_LINK_NOARG(NotebookbarTabControl, HstStoredStateHdl, void*, void)
+{
+    m_pHstStateEvent = nullptr;
+    HstSetCompact(true);
+}
+
+// Ctrl+F1 anywhere in this document window (its dropped page included) switches the ribbon's state
+IMPL_LINK(NotebookbarTabControl, HstKeyHdl, VclWindowEvent&, rEvent, bool)
+{
+    if (rEvent.GetId() != VclEventId::WindowKeyInput || !m_pHstCompact || !IsReallyVisible())
+        return false;
+    const KeyEvent* pKey = static_cast<const KeyEvent*>(rEvent.GetData());
+    const vcl::Window* pWindow = rEvent.GetWindow();
+    SystemWindow* pOwn = GetSystemWindow();
+    if (!pKey || pKey->GetKeyCode().GetFullCode() != (KEY_F1 | KEY_MOD1) || !pWindow || !pOwn
+        || !pOwn->IsWindowOrChild(pWindow, true))
+        return false;
+    HstSetCompact(!m_pHstCompact->IsCompact());
+    return true;
+}
+
+// a tab chosen in the compact ribbon (click, access key, Ctrl+arrows) drops its page over the document;
+// the File tab opens the File page as always
+IMPL_LINK(NotebookbarTabControl, HstTabEventHdl, VclWindowEvent&, rEvent, void)
+{
+    if (rEvent.GetId() != VclEventId::TabpageActivate || !m_pHstCompact || !m_pHstCompact->IsCompact())
+        return;
+    const sal_uInt16 nPageId = GetCurPageId();
+    m_pHstCompact->Fill(GetTabPage(nPageId), m_xFrame);
+    if (GetPageName(nPageId) != hst::ribbon::FILE_TAB_NAME)
+        HstDrop();
+}
+
+void NotebookbarTabControl::MouseButtonDown( const MouseEvent& rMEvt )
+{
+    const sal_uInt16 nPageId = rMEvt.IsLeft() ? GetPageId(rMEvt.GetPosPixel()) : 0;
+    if (m_pHstCompact && nPageId && GetPageName(nPageId) != hst::ribbon::FILE_TAB_NAME)
+    {
+        if (rMEvt.GetClicks() == 2) // a double-click on a tab switches the state, as in Office
+        {
+            HstSetCompact(!m_pHstCompact->IsCompact());
+            return;
+        }
+        if (m_pHstCompact->IsCompact() && nPageId == GetCurPageId())
+        {
+            HstDrop(); // the current tab: no tab switch, the page drops again
+            return;
+        }
+    }
+    NotebookbarTabControlBase::MouseButtonDown(rMEvt);
+}
