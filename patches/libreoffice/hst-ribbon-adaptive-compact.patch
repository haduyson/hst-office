+/** HST Office (1.0.2 ribbon, owner decision 14/11/2026): the compact ribbon of the Tabbed notebookbar.
+
+    Ctrl+F1, a double-click on a tab or the small chevron buttons switch between the full ribbon and the
+    compact one: the tab row and, below it, a row of the current tab's main commands (data/ribbon/
+    quick-rows.json, generated into HstRibbonQuickRows.hxx), 80 logical px together, the banner standing
+    across both rows. NotebookbarTabControl owns this helper; it keeps the widgets of both states (the
+    quick row with real toolbar controllers, the chevrons) and remembers the state per app in
+    HSTRibbon/CompactApps. */
+class HstRibbonCompact
+{
+public:
+    /// rApp: writer, calc, impress or draw; rToggle runs when a chevron is clicked
+    HstRibbonCompact(vcl::Window& rTabs, OUString aApp, const Link<LinkParamNone*, void>& rToggle);
+    ~HstRibbonCompact();
+    void dispose();
+
+    bool IsCompact() const { return m_bCompact; }
+    /// shows the quick row (compact) or the collapse chevron (full) and remembers the state for the app
+    void SetCompact(bool bCompact);
+    /// whether the app was left compact
+    static bool Stored(std::u16string_view rApp);
+
+    /// height in px of the compact ribbon (tab row and quick row) and of its quick row alone
+    static tools::Long BandHeight(double fDpi);
+    static tools::Long QuickHeight(tools::Long nHeaderHeight, double fDpi);
+
+    /// fills the quick row with the commands of the tab whose page is pPage (no-op for the same tab)
+    void Fill(const TabPage* pPage, const css::uno::Reference<css::frame::XFrame>& xFrame);
+    /// rQuick: the quick row's rectangle (compact); rPage: the page's rectangle beside the banner (full)
+    void Place(const tools::Rectangle& rQuick, const tools::Rectangle& rPage);
+
+private:
+    DECL_LINK(ChevronHdl, LinkParamNone*, void);
+
+    vcl::Window& m_rTabs;
+    OUString m_aApp;
+    Link<LinkParamNone*, void> m_aToggle;
+    bool m_bCompact = false;
+    OUString m_aFilledBox; // the merged group box whose commands the quick row shows
+    VclPtr<ToolBox> m_xQuick;
+    VclPtr<Control> m_xCollapse; // ˄ at the lower right end of the full page
+    VclPtr<Control> m_xExpand; // ˅ at the right end of the quick row
+};
