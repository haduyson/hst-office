+using namespace hst::ribbon::compact;
+
+
+HstRibbonCompact::HstRibbonCompact(vcl::Window& rTabs, OUString aApp, const Link<LinkParamNone*, void>& rToggle)
+    : m_rTabs(rTabs)
+    , m_aApp(std::move(aApp))
+    , m_aToggle(rToggle)
+{
+    m_xQuick = CreateQuickRow(&m_rTabs);
+    m_xCollapse = CreateChevron(&m_rTabs, true, SfxResId(STR_HST_RIBBON_COLLAPSE),
+                                             LINK(this, HstRibbonCompact, ChevronHdl));
+    m_xExpand = CreateChevron(&m_rTabs, false, SfxResId(STR_HST_RIBBON_EXPAND),
+                                           LINK(this, HstRibbonCompact, ChevronHdl));
+}
+
+HstRibbonCompact::~HstRibbonCompact() { dispose(); }
+
+void HstRibbonCompact::dispose()
+{
+    m_xQuick.disposeAndClear();
+    m_xCollapse.disposeAndClear();
+    m_xExpand.disposeAndClear();
+}
+
+IMPL_LINK_NOARG(HstRibbonCompact, ChevronHdl, LinkParamNone*, void) { m_aToggle.Call(nullptr); }
+
+tools::Long HstRibbonCompact::BandHeight(double fDpi) { return px(80, fDpi); }
+
+tools::Long HstRibbonCompact::QuickHeight(tools::Long nHeaderHeight, double fDpi)
+{
+    return std::max(BandHeight(fDpi) - nHeaderHeight, px(32, fDpi));
+}
+
+bool HstRibbonCompact::Stored(std::u16string_view rApp)
+{
+    try
+    {
+        const auto aApps = officecfg::Office::HSTRibbon::CompactApps::get();
+        return std::find(aApps.begin(), aApps.end(), rApp) != aApps.end();
+    }
+    catch (const css::uno::Exception&)
+    {
+        return false; // no configuration (LibreOfficeKit, broken profile): the full ribbon
+    }
+}
+
+void HstRibbonCompact::SetCompact(bool bCompact)
+{
+    m_bCompact = bCompact;
+    if (!bCompact)
+    {
+        m_xQuick->Hide();
+        m_xExpand->Hide();
+    }
+    else
+        m_xCollapse->Hide();
+    if (Stored(m_aApp) == bCompact)
+        return;
+    try
+    {
+        auto aApps = comphelper::sequenceToContainer<std::vector<OUString>>(
+            officecfg::Office::HSTRibbon::CompactApps::get());
+        std::erase(aApps, m_aApp);
+        if (bCompact)
+            aApps.push_back(m_aApp);
+        auto xChanges = comphelper::ConfigurationChanges::create();
+        officecfg::Office::HSTRibbon::CompactApps::set(comphelper::containerToSequence(aApps), xChanges);
+        xChanges->commit();
+    }
+    catch (const css::uno::Exception&)
+    {
+        // read-only configuration: the state holds for this session only
+    }
+}
+
+void HstRibbonCompact::Fill(const TabPage* pPage, const css::uno::Reference<css::frame::XFrame>& xFrame)
+{
+    const OUString aBox = pPage ? boxOf(*pPage) : OUString();
+    if (aBox == m_aFilledBox || !xFrame.is())
+        return;
+    m_aFilledBox = aBox;
+    m_xQuick->Clear();
+    for (const hst::ribbon::quick::Row& rRow : hst::ribbon::quick::all)
+    {
+        if (rRow.app != m_aApp || rRow.box != aBox)
+            continue;
+        for (std::size_t i = 0; i < rRow.count; ++i)
+        {
+            const OUString aCommand(rRow.commands[i]);
+            if (aCommand == "|")
+            {
+                m_xQuick->InsertSeparator();
+                continue;
+            }
+            m_xQuick->InsertItem(aCommand, xFrame, ToolBoxItemBits::NONE, Size());
+            if (OUString aLabel = ribbonLabel(*pPage, aCommand); !aLabel.isEmpty())
+                m_xQuick->SetItemText(m_xQuick->GetItemId(aCommand), aLabel);
+        }
+    }
+}
+
+void HstRibbonCompact::Place(const tools::Rectangle& rQuick, const tools::Rectangle& rPage)
+{
+    const double fDpi = m_rTabs.GetDPIScaleFactor();
+    const Size aChevron(px(18, fDpi), px(16, fDpi));
+    const long nInset = px(4, fDpi);
+    if (m_bCompact && !rQuick.IsEmpty())
+    {
+        const long nRoom = rQuick.GetWidth() - aChevron.Width() - 2 * nInset;
+        const Size aWant = m_xQuick->CalcWindowSizePixel();
+        const long nHeight = std::min<long>(aWant.Height(), rQuick.GetHeight());
+        m_xQuick->SetPosSizePixel(Point(rQuick.Left(), rQuick.Top() + (rQuick.GetHeight() - nHeight) / 2),
+                                  Size(std::max(0L, std::min<long>(aWant.Width(), nRoom)), nHeight));
+        m_xQuick->Show(m_xQuick->GetItemCount() > 0);
+        m_xExpand->SetPosSizePixel(Point(rQuick.Right() - nInset - aChevron.Width(),
+                                         rQuick.Bottom() - nInset - aChevron.Height()), aChevron);
+        m_xExpand->Show();
+        m_xExpand->SetZOrder(nullptr, ZOrderFlags::First);
+    }
+    else if (!m_bCompact && !rPage.IsEmpty())
+    {
+        m_xCollapse->SetPosSizePixel(Point(rPage.Right() - nInset - aChevron.Width(),
+                                           rPage.Bottom() - px(3, fDpi) - aChevron.Height()), aChevron);
+        m_xCollapse->Show();
+        m_xCollapse->SetZOrder(nullptr, ZOrderFlags::First); // over the page's last group
+    }
+    else
+        m_xCollapse->Hide();
+}
