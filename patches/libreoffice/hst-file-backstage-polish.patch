+// the theme's own button hover cannot show: the custom button image covers it
+IMPL_LINK(BackstageWindow::NavHover, MouseHdl, const MouseEvent&, rMEvt, bool)
+{
+    if (rMEvt.IsEnterWindow())
+        m_rWindow.SetNavHover(m_nIndex);
+    else if (rMEvt.IsLeaveWindow())
+        m_rWindow.ClearNavHover(m_nIndex);
+    return false;
+}
+
+void BackstageWindow::SetNavHover(int nIndex)
+{
+    if (nIndex == m_nHoverNav)
+        return;
+    const int nOld = m_nHoverNav;
+    m_nHoverNav = nIndex;
+    if (nOld >= 0)
+        PaintNavItem(nOld);
+    if (nIndex >= 0)
+        PaintNavItem(nIndex);
+}
+
+void BackstageWindow::ClearNavHover(int nIndex)
+{
+    if (nIndex == m_nHoverNav)
+        SetNavHover(-1);
+}
