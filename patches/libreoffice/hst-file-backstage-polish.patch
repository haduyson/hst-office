+/// The template gallery of the New page: like the Start Center's, one click opens a template, but
+/// in the colours of this page and not the Start Center's configured background.
+class BackstageTemplateView final : public TemplateLocalView
+{
+public:
+    BackstageTemplateView(std::unique_ptr<weld::ScrolledWindow> xWindow, std::unique_ptr<weld::Menu> xMenu)
+        : TemplateLocalView(std::move(xWindow), std::move(xMenu))
+    {
+        mbAllowMultiSelection = false;
+        setItemDimensions(GALLERY_ITEM_SIZE, GALLERY_ITEM_SIZE, 30, 5);
+        updateThumbnailDimensions(GALLERY_ITEM_SIZE);
+        mfHighlightTransparence = 0.75;
+        BackstageTemplateView::UpdateColors(Application::GetSettings().GetStyleSettings());
+    }
+
+    void showAllTemplates() override
+    {
+        mnCurRegionId = 0;
+        insertItems(maAllTemplates, false);
+    }
+
+    bool MouseButtonDown(const MouseEvent& rMEvt) override
+    {
+        if (rMEvt.IsLeft() && rMEvt.GetClicks() == 1)
+        {
+            ThumbnailViewItem* pItem = ImplGetItem(ImplGetItem(rMEvt.GetPosPixel()));
+            if (auto* pTemplate = dynamic_cast<TemplateViewItem*>(pItem))
+                maOpenTemplateHdl.Call(pTemplate->getPath());
+            return true;
+        }
+        return TemplateLocalView::MouseButtonDown(rMEvt);
+    }
+
+protected:
+    void UpdateColors(const StyleSettings& rSettings) override
+    {
+        TemplateLocalView::UpdateColors(rSettings);
+        maFillColor = rSettings.GetWindowColor();
+        maTextColor = rSettings.GetWindowTextColor();
+    }
+};
