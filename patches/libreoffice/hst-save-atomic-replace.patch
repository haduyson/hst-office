+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This file is part of the LibreOffice project.
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+// HST Office: crash-safe replacement of an existing file (see hstsavefile.hxx).
+
+#include "hstsavefile.hxx"
+
+#include <comphelper/hstdurablefile.hxx>
+#include <osl/file.hxx>
+#include <osl/thread.h>
+#include <sal/log.hxx>
+
+#include <string>
+#include <vector>
+
+#ifdef UNX
+#include <cerrno>
+#include <climits>
+#include <cstring>
+#include <cstdlib>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#ifdef MACOSX
+#include <copyfile.h>
+#else
+#include <sys/xattr.h>
+#endif
+#endif
+
+namespace sfx2::hst
+{
+namespace
+{
+#ifdef UNX
+/// Extended attributes (macOS: also ACL, resource fork and Finder info) of nFrom onto nTo.
+void copyAttributes(int nFrom, int nTo)
+{
+#ifdef MACOSX
+    if (fcopyfile(nFrom, nTo, nullptr, COPYFILE_XATTR | COPYFILE_ACL) != 0)
+        SAL_INFO("sfx.doc", "hst: fcopyfile failed: " << errno);
+#else
+    const ssize_t nSize = flistxattr(nFrom, nullptr, 0);
+    if (nSize <= 0)
+        return;
+    std::vector<char> aNames(nSize);
+    if (flistxattr(nFrom, aNames.data(), aNames.size()) != nSize)
+        return;
+    for (const char* pName = aNames.data(); pName < aNames.data() + nSize; pName += strlen(pName) + 1)
+    {
+        const ssize_t nValue = fgetxattr(nFrom, pName, nullptr, 0);
+        std::vector<char> aValue(nValue > 0 ? nValue : 0);
+        if (nValue < 0 || fgetxattr(nFrom, pName, aValue.data(), aValue.size()) != nValue
+            || fsetxattr(nTo, pName, aValue.data(), aValue.size(), 0) != 0)
+            SAL_INFO("sfx.doc", "hst: extended attribute not copied: " << pName);
+    }
+#endif
+}
+
+bool copyContent(int nIn, int nOut)
+{
+    std::vector<char> aBuffer(1 << 16);
+    for (;;)
+    {
+        const ssize_t nRead = read(nIn, aBuffer.data(), aBuffer.size());
+        if (nRead == 0)
+            return true;
+        if (nRead < 0 && errno == EINTR)
+            continue;
+        if (nRead < 0)
+            return false;
+        for (ssize_t nDone = 0; nDone < nRead;)
+        {
+            const ssize_t nWritten = write(nOut, aBuffer.data() + nDone, nRead - nDone);
+            if (nWritten < 0 && errno == EINTR)
+                continue;
+            if (nWritten <= 0)
+                return false;
+            nDone += nWritten;
+        }
+    }
+}
+
+std::string sysPath(const OUString& rURL)
+{
+    OUString aPath;
+    if (osl::FileBase::getSystemPathFromFileURL(rURL, aPath) != osl::FileBase::E_None)
+        return {};
+    return std::string(OUStringToOString(aPath, osl_getThreadTextEncoding()));
+}
+#endif
+}
+
+bool replaceThroughTarget(const OUString& rSourceURL, const OUString& rDestURL, bool bSync)
+{
+#ifdef UNX
+    const std::string aSource = sysPath(rSourceURL), aDest = sysPath(rDestURL);
+    struct stat aLink;
+    if (aSource.empty() || aDest.empty() || lstat(aDest.c_str(), &aLink) != 0)
+        return false;
+#ifndef MACOSX
+    if (!S_ISLNK(aLink.st_mode))
+        return false; // plain files already take the rename path (IsFileMovable)
+#endif
+    char aReal[PATH_MAX];
+    struct stat aStat;
+    if (!realpath(aDest.c_str(), aReal) || stat(aReal, &aStat) != 0 || !S_ISREG(aStat.st_mode)
+        || aStat.st_nlink > 1 || access(aReal, W_OK) != 0)
+        return false;
+    const std::string aDir(aReal, std::string_view(aReal).rfind('/') + 1);
+    std::string aTemp = aDir + std::string(OUStringToOString(saveTempPrefix(), RTL_TEXTENCODING_ASCII_US)) + "XXXXXX.tmp";
+    const int nOut = mkstemps(aTemp.data(), 4);
+    if (nOut < 0)
+        return false;
+    const int nIn = open(aSource.c_str(), O_RDONLY | O_CLOEXEC);
+    const int nOld = open(aReal, O_RDONLY | O_CLOEXEC);
+    bool bOk = nIn >= 0 && nOld >= 0 && copyContent(nIn, nOut);
+    if (bOk)
+    {
+        if (fchmod(nOut, aStat.st_mode & 07777) != 0)
+            SAL_INFO("sfx.doc", "hst: fchmod failed: " << errno);
+        if (fchown(nOut, aStat.st_uid, aStat.st_gid) != 0)
+            SAL_INFO("sfx.doc", "hst: fchown not allowed: " << errno); // other owner: keep ours
+        copyAttributes(nOld, nOut);
+        bOk = !bSync || fsync(nOut) == 0;
+    }
+    if (nIn >= 0)
+        close(nIn);
+    if (nOld >= 0)
+        close(nOld);
+    bOk = close(nOut) == 0 && bOk;
+    if (!bOk || rename(aTemp.c_str(), aReal) != 0)
+    {
+        unlink(aTemp.c_str());
+        SAL_WARN("sfx.doc", "hst: replacing " << aReal << " failed, falling back to an in-place write");
+        return false;
+    }
+    if (bSync)
+    {
+        OUString aRealURL;
+        if (osl::FileBase::getFileURLFromSystemPath(
+                OStringToOUString(aReal, osl_getThreadTextEncoding()), aRealURL)
+            == osl::FileBase::E_None)
+            comphelper::hst::syncParentDirectory(aRealURL);
+    }
+    return true;
+#else
+    (void)rSourceURL;
+    (void)rDestURL;
+    (void)bSync;
+    return false;
+#endif
+}
+}
