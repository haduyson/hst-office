+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This file is part of the LibreOffice project.
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+#pragma once
+
+#include <rtl/ustring.hxx>
+
+/** HST Office: saving over an existing file without a window where it is empty or cut short.
+
+    The temporary file a save writes next to the user's file is named ".~hst-save-<pid>-<n>.tmp", so
+    one a crashed office left behind can be recognised and removed by a later save in that folder.
+*/
+namespace sfx2::hst
+{
+/// Leading characters of the temporary file next to the user's file for this process.
+OUString saveTempPrefix();
+
+/// Remove ".~hst-save-<pid>-*.tmp" of other processes in the folder once they are older than
+/// 10 minutes and their process is gone (any of them after 7 days: a folder shared by computers).
+void sweepStaleSaveTemps(const OUString& rDirURL);
+
+/** Replace the file rDestURL refers to with the content of rSourceURL without truncating it first:
+    a symbolic link is resolved and the file it points to is replaced (the link stays); on macOS
+    every save goes this way. The new content is written to a temporary file in that file's folder,
+    gets its permissions, owner (when allowed) and extended attributes (macOS: also the resource
+    fork, Finder info such as "hide extension" and ACLs), is fsync'd and renamed over it; the folder
+    is fsync'd. False (nothing changed) for hard links, read-only files, file systems that refuse it,
+    or non-Unix systems: the caller then keeps the upstream in-place write. */
+bool replaceThroughTarget(const OUString& rSourceURL, const OUString& rDestURL, bool bSync);
+}
