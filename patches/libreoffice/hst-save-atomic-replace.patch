+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This file is part of the LibreOffice project.
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+// HST Office: the temporary files of a save next to the user's file (see hstsavefile.hxx).
+
+#include "hstsavefile.hxx"
+
+#include <o3tl/string_view.hxx>
+#include <osl/file.hxx>
+#include <osl/process.h>
+#include <osl/time.h>
+#include <sal/log.hxx>
+
+#ifdef UNX
+#include <cerrno>
+#include <signal.h>
+#elif defined _WIN32
+#include <prewin.h>
+#include <postwin.h>
+#endif
+
+namespace sfx2::hst
+{
+namespace
+{
+constexpr std::u16string_view PREFIX = u".~hst-save-";
+
+sal_uInt32 currentPid()
+{
+    oslProcessInfo aInfo;
+    aInfo.Size = sizeof(aInfo);
+    return osl_getProcessInfo(nullptr, osl_Process_IDENTIFIER, &aInfo) == osl_Process_E_None
+               ? aInfo.Ident
+               : 0;
+}
+
+bool processAlive(sal_uInt32 nPid)
+{
+#ifdef UNX
+    return kill(static_cast<pid_t>(nPid), 0) == 0 || errno != ESRCH;
+#elif defined _WIN32
+    HANDLE hProcess = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, FALSE, nPid);
+    if (!hProcess)
+        return GetLastError() != ERROR_INVALID_PARAMETER; // no such process
+    DWORD nCode = 0;
+    const bool bAlive = GetExitCodeProcess(hProcess, &nCode) && nCode == STILL_ACTIVE;
+    CloseHandle(hProcess);
+    return bAlive;
+#else
+    (void)nPid;
+    return true;
+#endif
+}
+
+}
+
+OUString saveTempPrefix() { return OUString::Concat(PREFIX) + OUString::number(currentPid()) + "-"; }
+
+void sweepStaleSaveTemps(const OUString& rDirURL)
+{
+    osl::Directory aDir(rDirURL);
+    if (aDir.open() != osl::FileBase::E_None)
+        return;
+    TimeValue aNow;
+    osl_getSystemTime(&aNow);
+    const sal_uInt32 nSelf = currentPid();
+    osl::DirectoryItem aItem;
+    while (aDir.getNextItem(aItem) == osl::FileBase::E_None)
+    {
+        osl::FileStatus aStatus(osl_FileStatus_Mask_FileName | osl_FileStatus_Mask_FileURL
+                                | osl_FileStatus_Mask_ModifyTime | osl_FileStatus_Mask_Type);
+        if (aItem.getFileStatus(aStatus) != osl::FileBase::E_None
+            || aStatus.getFileType() != osl::FileStatus::Regular)
+            continue;
+        const OUString aName = aStatus.getFileName();
+        std::u16string_view aRest;
+        if (!aName.startsWith(PREFIX, &aRest) || !aName.endsWith(".tmp"))
+            continue;
+        const sal_uInt32 nPid = o3tl::toUInt32(aRest.substr(0, aRest.find(u'-')));
+        const sal_Int64 nAge = sal_Int64(aNow.Seconds) - aStatus.getModifyTime().Seconds;
+        const bool bStale = nAge > 7 * 24 * 3600 || (nAge > 600 && nPid != nSelf && !processAlive(nPid));
+        if (nPid && bStale && osl::File::remove(aStatus.getFileURL()) == osl::FileBase::E_None)
+            SAL_INFO("sfx.doc", "hst: removed a crashed save's temporary file " << aName);
+    }
+}
+
+}
