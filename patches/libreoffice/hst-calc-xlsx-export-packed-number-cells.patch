+
+/** A run of number cells of one row, side by side, as the .xlsx export keeps them until it writes the sheet.
+
+    The export created one XclExpRkCell or XclExpNumberCell record per number cell (an RK record only merges with
+    an RK cell right next to it, so in a row of mixed cells nearly every number had its own record, about 100 bytes
+    with its slot in the row) and held all of them until the sheet was written: 1.5 million number cells took about
+    150 MB at the peak of saving a 50 MB workbook, about 600 MB for 200 MB. For .xlsx a finished number cell needs
+    only its value and its cell format identifier: XclExpNumberCell::SaveXml and XclExpRkCell::WriteXmlContents
+    write nothing else. So the cells of a run are kept as 16 bytes each, with the value those records write (for an
+    RK cell the value decoded from its RK form).
+
+    Each number cell is still created as before first, so the cell formats are registered exactly as before and in
+    the same order; only the finished record is replaced. Not used for the binary formats, for Boolean cells or for
+    the base cell of a merged range. The row's finalisation sees these runs as non-blank cells, as it saw the single
+    number cells.
+
+    The environment variable HST_SC_XLSX_PACKED_NUMBERS_OFF keeps one record per number cell (used by a test to
+    compare both paths). */
+class HstXlsxPackedNumbers final : public XclExpCellBase
+{
+public:
+    /** True when the number cells of an .xlsx export are packed into runs. */
+    static bool IsEnabled(const XclExpRoot& rRoot)
+    {
+        return rRoot.GetOutput() != EXC_OUTPUT_BINARY && !std::getenv("HST_SC_XLSX_PACKED_NUMBERS_OFF");
+    }
+
+    /** rCell is the XclExpNumberCell or XclExpRkCell just created for one cell; fValue the value it writes. */
+    HstXlsxPackedNumbers(const XclExpCellBase& rCell, double fValue)
+        : XclExpCellBase(EXC_ID3_NUMBER, 0, rCell.GetXclPos())
+    {
+        maEntries.push_back({ fValue, rCell.GetFirstXFId() });
+    }
+
+    virtual sal_uInt16 GetLastXclCol() const override
+    {
+        return static_cast<sal_uInt16>(GetXclCol() + maEntries.size() - 1);
+    }
+    virtual sal_uInt32 GetFirstXFId() const override { return maEntries.front().mnXFId; }
+    virtual bool IsEmpty() const override { return false; }
+
+    /** Takes over a run that starts right after this one in the same row. */
+    virtual bool TryMerge(const XclExpCellBase& rCell) override
+    {
+        const HstXlsxPackedNumbers* pRun = dynamic_cast<const HstXlsxPackedNumbers*>(&rCell);
+        if (!pRun || pRun->GetXclRow() != GetXclRow() || pRun->GetXclCol() != GetLastXclCol() + 1)
+            return false;
+        maEntries.insert(maEntries.end(), pRun->maEntries.begin(), pRun->maEntries.end());
+        return true;
+    }
+
+    /** Nothing to convert: SaveXml looks the cell format index up from the identifier, as the single cells do. */
+    virtual void ConvertXFIndexes(const XclExpRoot&) override {}
+
+    virtual void Save(XclExpStream&) override
+    {
+        OSL_FAIL("HstXlsxPackedNumbers::Save - number cells are packed for .xlsx only");
+    }
+
+    virtual void SaveXml(XclExpXmlStream& rStrm) override
+    {
+        sax_fastparser::FSHelperPtr& rWorksheet = rStrm.GetCurrentStream();
+        const XclExpXFBuffer& rXFBuffer = rStrm.GetRoot().GetXFBuffer();
+        XclAddress aPos(GetXclPos());
+        for (const Entry& rEntry : maEntries)
+        {
+            const sal_uInt16 nXFIndex = rXFBuffer.GetXFIndex(rEntry.mnXFId);
+            rWorksheet->startElement(::oox::XML_c,
+                ::oox::XML_r, XclXmlUtils::ToOString(rStrm.GetRoot().GetStringBuf(), aPos).getStr(),
+                ::oox::XML_s, OString::number(rXFBuffer.GetXmlCellIndex(nXFIndex)),
+                ::oox::XML_t, "n");
+            rWorksheet->startElement(::oox::XML_v);
+            rWorksheet->write(rEntry.mfValue);
+            rWorksheet->endElement(::oox::XML_v);
+            rWorksheet->endElement(::oox::XML_c);
+            ++aPos.mnCol;
+        }
+    }
+
+private:
+    struct Entry
+    {
+        double mfValue;
+        sal_uInt32 mnXFId;
+    };
+    std::vector<Entry> maEntries;
+};
