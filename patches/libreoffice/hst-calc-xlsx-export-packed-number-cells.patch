+CPPUNIT_TEST_FIXTURE(ScExportTest6, testXlsxPackedNumberCellsWriteTheSameSheet)
+{
+    // The .xlsx export keeps number cells as packed runs of their row. The sheet, the shared strings and the styles
+    // must be the same as with one record per number cell (the environment variable selects that path).
+    createScDoc();
+    ScDocument* pDoc = getScDoc();
+    // RK integers, RK hundredths, plain doubles, negative and large values, next to each other and interrupted by
+    // text, a formula and a blank formatted cell
+    const double aValues[] = { 1, 42, -7, 0.25, 1.1, 3.14159265358979, 1e15, -0.07, 123456.78, 2.5e-9, 0, 536870912 };
+    for (SCCOL nCol = 0; nCol < SCCOL(std::size(aValues)); ++nCol)
+        pDoc->SetValue(ScAddress(nCol, 0, 0), aValues[nCol]);
+    pDoc->SetValue(ScAddress(0, 1, 0), 5);
+    pDoc->SetString(ScAddress(1, 1, 0), u"chữ"_ustr);
+    pDoc->SetValue(ScAddress(2, 1, 0), 6.5);
+    pDoc->SetString(ScAddress(3, 1, 0), u"=A2+C2"_ustr);
+    pDoc->SetValue(ScAddress(4, 1, 0), 7);
+    pDoc->SetValue(ScAddress(6, 1, 0), 8);
+    // formatted numbers (bold, a percent and a date format), a Boolean, a merged base, a hidden row
+    ScPatternAttr aBold(pDoc->getCellAttributeHelper());
+    aBold.ItemSetPut(SvxWeightItem(WEIGHT_BOLD, ATTR_FONT_WEIGHT));
+    pDoc->ApplyPatternAreaTab(0, 2, 2, 3, 0, aBold);
+    SvNumberFormatter* pFormatter = pDoc->GetFormatTable();
+    ScPatternAttr aPercent(pDoc->getCellAttributeHelper());
+    aPercent.ItemSetPut(SfxUInt32Item(ATTR_VALUE_FORMAT,
+                                      pFormatter->GetStandardFormat(SvNumFormatType::PERCENT, LANGUAGE_ENGLISH_US)));
+    pDoc->ApplyPatternAreaTab(1, 3, 1, 3, 0, aPercent);
+    ScPatternAttr aDate(pDoc->getCellAttributeHelper());
+    aDate.ItemSetPut(SfxUInt32Item(ATTR_VALUE_FORMAT,
+                                   pFormatter->GetStandardFormat(SvNumFormatType::DATE, LANGUAGE_ENGLISH_US)));
+    pDoc->ApplyPatternAreaTab(2, 3, 2, 3, 0, aDate);
+    ScPatternAttr aBool(pDoc->getCellAttributeHelper());
+    aBool.ItemSetPut(SfxUInt32Item(ATTR_VALUE_FORMAT,
+                                   pFormatter->GetStandardFormat(SvNumFormatType::LOGICAL, LANGUAGE_ENGLISH_US)));
+    pDoc->ApplyPatternAreaTab(3, 3, 3, 3, 0, aBool);
+    for (SCROW nRow = 2; nRow <= 3; ++nRow)
+        for (SCCOL nCol = 0; nCol < 4; ++nCol)
+            pDoc->SetValue(ScAddress(nCol, nRow, 0), nRow * 10 + nCol + (nCol == 3 ? -nRow * 10 - 2 : 0.5));
+    pDoc->SetValue(ScAddress(0, 5, 0), 99);
+    pDoc->DoMerge(0, 5, 1, 6, 0);
+    pDoc->SetValue(ScAddress(2, 5, 0), 100);
+    pDoc->SetValue(ScAddress(0, 8, 0), 1);
+    pDoc->SetValue(ScAddress(1, 8, 0), 2);
+    pDoc->SetRowHidden(8, 8, 0, true);
+    for (SCCOL nCol = 100; nCol < 140; ++nCol)
+        pDoc->SetValue(ScAddress(nCol, 10, 0), nCol / 3.0);
+
+    static constexpr std::array<OUString, 4> aParts{ u"xl/worksheets/sheet1.xml"_ustr,
+                                                     u"xl/sharedStrings.xml"_ustr, u"xl/styles.xml"_ustr,
+                                                     u"xl/workbook.xml"_ustr };
+    osl_setEnvironment(u"HST_SC_XLSX_PACKED_NUMBERS_OFF"_ustr.pData, u"1"_ustr.pData);
+    save(TestFilter::XLSX);
+    std::vector<OString> aOld;
+    for (const OUString& rPart : aParts)
+        aOld.push_back(dumpExportedPart(parseExport(rPart)));
+    osl_clearEnvironment(u"HST_SC_XLSX_PACKED_NUMBERS_OFF"_ustr.pData);
+
+    save(TestFilter::XLSX);
+    for (size_t i = 0; i < aParts.size(); ++i)
+        CPPUNIT_ASSERT_EQUAL_MESSAGE(aParts[i].toUtf8().getStr(), aOld[i],
+                                     dumpExportedPart(parseExport(aParts[i])));
+
+    // the packed runs are really written: one <c t="n"> per number of row 1, the long row in full
+    xmlDocUniquePtr pSheet = parseExport(u"xl/worksheets/sheet1.xml"_ustr);
+    assertXPath(pSheet, "/x:worksheet/x:sheetData/x:row[1]/x:c[@t='n']", 12);
+    assertXPath(pSheet, "/x:worksheet/x:sheetData/x:row[@r='11']/x:c[@t='n']", 40);
+}
