+namespace
+{
+struct HstSpecialChar
+{
+    sal_UCS4 nChar;
+    TranslateId pName;
+};
+// HST: the list of Word's Special Characters tab
+constexpr HstSpecialChar aHstSpecialChars[] = {
+    { 0x2014, NC_("hstspecialchar", "Em Dash") },
+    { 0x2013, NC_("hstspecialchar", "En Dash") },
+    { 0x2011, NC_("hstspecialchar", "Nonbreaking Hyphen") },
+    { 0x00AD, NC_("hstspecialchar", "Optional Hyphen") },
+    { 0x2003, NC_("hstspecialchar", "Em Space") },
+    { 0x2002, NC_("hstspecialchar", "En Space") },
+    { 0x2005, NC_("hstspecialchar", "1/4 Em Space") },
+    { 0x00A0, NC_("hstspecialchar", "Nonbreaking Space") },
+    { 0x00A9, NC_("hstspecialchar", "Copyright") },
+    { 0x00AE, NC_("hstspecialchar", "Registered") },
+    { 0x2122, NC_("hstspecialchar", "Trademark") },
+    { 0x00A7, NC_("hstspecialchar", "Section") },
+    { 0x00B6, NC_("hstspecialchar", "Paragraph") },
+    { 0x2026, NC_("hstspecialchar", "Ellipsis") },
+    { 0x2018, NC_("hstspecialchar", "Single Opening Quote") },
+    { 0x2019, NC_("hstspecialchar", "Single Closing Quote") },
+    { 0x201C, NC_("hstspecialchar", "Double Opening Quote") },
+    { 0x201D, NC_("hstspecialchar", "Double Closing Quote") },
+};
+}
+
+void SvxCharacterMap::HstFillSpecialList()
+{
+    m_xHstSpecialList->set_size_request(-1, m_xHstSpecialList->get_height_rows(14));
+    for (const HstSpecialChar& rEntry : aHstSpecialChars)
+    {
+        m_xHstSpecialList->append(OUString::number(rEntry.nChar), OUString(&rEntry.nChar, 1));
+        m_xHstSpecialList->set_text(m_xHstSpecialList->n_children() - 1, SvxResId(rEntry.pName), 1);
+    }
+    m_xHstSpecialList->connect_selection_changed(LINK(this, SvxCharacterMap, HstSpecialSelectHdl));
+    m_xHstSpecialList->connect_item_activated(LINK(this, SvxCharacterMap, HstSpecialActivateHdl));
+}
+
+IMPL_LINK_NOARG(SvxCharacterMap, HstSpecialSelectHdl, weld::ItemView&, void)
+{
+    const OUString sId = m_xHstSpecialList->get_selected_id();
+    if (sId.isEmpty())
+        return;
+    const sal_UCS4 cChar = sId.toUInt32();
+    m_aShowChar.SetText(OUString(&cChar, 1));
+    m_aShowChar.Invalidate();
+    m_xHexCodeText->set_text(OUString::number(cChar, 16).toAsciiUpperCase());
+    m_xDecimalCodeText->set_text(OUString::number(cChar));
+    setCharName(cChar);
+    m_xOKBtn->set_sensitive(true);
+}
+
+IMPL_LINK_NOARG(SvxCharacterMap, HstSpecialActivateHdl, const weld::TreeIter&, bool)
+{
+    InsertClickHdl(*m_xOKBtn);
+    return true;
+}
+
 IMPL_LINK_NOARG(SvxCharacterMap, InsertClickHdl, weld::Button&, void)
 {
     OUString sChar = m_aShowChar.GetText();
