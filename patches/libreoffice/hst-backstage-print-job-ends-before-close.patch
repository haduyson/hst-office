+/** Closes the File panel of a frame, which cancels a print job waiting on its Print page, when the frame or its
+    document is asked to close (queryClosing, before anything closes). Unlike the print dialog, the Print page leaves
+    the document usable while its job waits, so the document can be closed under the job: the session end
+    (AutoRecovery closing the documents), XCloseable.close() from a macro or an extension. Writer then ended its view
+    with the job still open and the office aborted. Never vetoes. */
+class PrintPageCloseGuard final : public cppu::WeakImplHelper<util::XCloseListener>
+{
+public:
+    explicit PrintPageCloseGuard(const uno::Reference<frame::XFrame>& rxFrame)
+        : m_xFrame(rxFrame)
+    {
+    }
+
+    void SAL_CALL queryClosing(const lang::EventObject&, sal_Bool) override
+    {
+        SolarMutexGuard aGuard;
+        if (uno::Reference<frame::XFrame> xFrame{ m_xFrame })
+            CloseBackstage(xFrame);
+    }
+
+    void SAL_CALL notifyClosing(const lang::EventObject& rEvent) override { queryClosing(rEvent, false); }
+
+    void SAL_CALL disposing(const lang::EventObject&) override {}
+
+    bool Guards(const uno::Reference<frame::XFrame>& rxFrame, const uno::Reference<uno::XInterface>& rxModel) const
+    {
+        return uno::Reference<frame::XFrame>(m_xFrame) == rxFrame
+               && uno::Reference<uno::XInterface>(m_xModel) == rxModel;
+    }
+
+    void SetModel(const uno::Reference<uno::XInterface>& rxModel) { m_xModel = rxModel; }
+
+    bool IsGone() const { return !uno::Reference<frame::XFrame>(m_xFrame).is(); }
+
+private:
+    uno::WeakReference<frame::XFrame> m_xFrame;
+    uno::WeakReference<uno::XInterface> m_xModel;
+};
+
+/// A close guard on the frame and on the document of a print job the Print page takes, one per frame and document.
+void lcl_guardPrintPage(const uno::Reference<frame::XFrame>& rxFrame, SfxObjectShell* pDocShell)
+{
+    static std::vector<rtl::Reference<PrintPageCloseGuard>> aGuards;
+    std::erase_if(aGuards, [](const rtl::Reference<PrintPageCloseGuard>& rGuard) { return rGuard->IsGone(); });
+    const uno::Reference<util::XCloseBroadcaster> xModel(pDocShell ? pDocShell->GetModel() : nullptr,
+                                                         uno::UNO_QUERY);
+    const uno::Reference<uno::XInterface> xModelId(xModel, uno::UNO_QUERY);
+    for (const rtl::Reference<PrintPageCloseGuard>& rGuard : aGuards)
+        if (rGuard->Guards(rxFrame, xModelId))
+            return;
+    rtl::Reference<PrintPageCloseGuard> xGuard(new PrintPageCloseGuard(rxFrame));
+    xGuard->SetModel(xModelId);
+    try
+    {
+        if (const uno::Reference<util::XCloseBroadcaster> xFrame{ rxFrame, uno::UNO_QUERY })
+            xFrame->addCloseListener(xGuard);
+        if (xModel.is())
+            xModel->addCloseListener(xGuard);
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("sfx.backstage", "Print page: no close guard");
+    }
+    aGuards.push_back(xGuard);
+}
