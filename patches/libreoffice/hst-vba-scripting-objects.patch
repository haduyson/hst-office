+class BasicScriptingObject : public SbxObject
+{
+protected:
+    explicit BasicScriptingObject(const OUString& rClass)
+        : SbxObject(rClass)
+    {
+        SetType(SbxOBJECT);
+        SetFlag(SbxFlagBits::Fixed);
+        ResetFlag(SbxFlagBits::Write);
+    }
+    void addMethods(std::initializer_list<OUString> aNames);
+    void addProperties(std::initializer_list<OUString> aNames);
+    virtual void Notify(SfxBroadcaster& rBC, const SfxHint& rHint) override;
+    /** Handles the member; false lets SbxObject deal with it. rArgs holds the call's parameters from index 1. */
+    virtual bool call(const OUString& rName, SbxVariable& rVar, SbxArray* pArgs, sal_uInt32 nArgs, bool bWrite) = 0;
+    /** A VBA run-time error that On Error and Err.Number see. */
+    static void raise(sal_Int32 nNumber, const OUString& rMessage);
+};
+
+class BasicRegExp final : public BasicScriptingObject
+{
+    OUString maPattern;
