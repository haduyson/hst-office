+// HST: Scripting.FileSystemObject for VBA code, on every platform.
+
+#include <sbxscripting.hxx>
+#include <basic/sberrors.hxx>
+#include <osl/file.hxx>
+#include <comphelper/random.hxx>
+
+constexpr sal_Int32 nErrFileNotFound = 53;
+constexpr sal_Int32 nErrPathNotFound = 76;
+constexpr sal_Int32 nErrFileExists = 58;
+
+using namespace basic::scripting;
+
+BasicFileSystemObject::BasicFileSystemObject()
+    : BasicScriptingObject(u"FileSystemObject"_ustr)
+{
+    addMethods({ u"FileExists"_ustr, u"FolderExists"_ustr, u"GetFile"_ustr, u"GetFolder"_ustr, u"GetFileName"_ustr, u"GetBaseName"_ustr,
+                 u"GetExtensionName"_ustr, u"GetParentFolderName"_ustr, u"GetAbsolutePathName"_ustr, u"BuildPath"_ustr, u"GetTempName"_ustr,
+                 u"CreateFolder"_ustr, u"DeleteFile"_ustr, u"DeleteFolder"_ustr, u"CopyFile"_ustr, u"MoveFile"_ustr, u"CreateTextFile"_ustr,
+                 u"OpenTextFile"_ustr });
+}
+
+bool BasicFileSystemObject::call(const OUString& rName, SbxVariable& rVar, SbxArray* pArgs, sal_uInt32 nArgs, bool)
+{
+    const OUString aArg = nArgs > 1 ? pArgs->Get(1)->GetOUString() : OUString();
+    const OUString aUrl = nArgs > 1 ? pathToUrl(aArg) : OUString();
+    auto putObject = [&rVar](SbxObject* pObj) {
+        SbxFlagBits nFlags = rVar.GetFlags();
+        rVar.ResetFlag(SbxFlagBits::Fixed);
+        rVar.PutObject(pObj);
+        rVar.SetFlags(nFlags);
+    };
+    if (rName == "fileexists") rVar.PutBool(isFile(aUrl));
+    else if (rName == "folderexists") rVar.PutBool(isFolder(aUrl));
+    else if (rName == "getfilename") rVar.PutString(nameOf(aArg));
+    else if (rName == "getbasename" || rName == "getextensionname")
+    {
+        OUString aName = nameOf(aArg);
+        sal_Int32 nDot = aName.lastIndexOf('.');
+        if (rName == "getbasename")
+            rVar.PutString(nDot < 0 ? aName : aName.copy(0, nDot));
+        else
+            rVar.PutString(nDot < 0 ? OUString() : aName.copy(nDot + 1));
+    }
+    else if (rName == "getparentfoldername")
+    {
+        OUString aPath = aArg.replace('\\', '/');
+        sal_Int32 nCut = aPath.lastIndexOf('/');
+        rVar.PutString(nCut <= 0 ? OUString() : aArg.copy(0, nCut));
+    }
+    else if (rName == "getabsolutepathname") rVar.PutString(urlToPath(aUrl));
+    else if (rName == "buildpath" && nArgs > 2)
+    {
+#ifdef _WIN32
+        constexpr sal_Unicode cSep = '\\';
+#else
+        constexpr sal_Unicode cSep = '/';
+#endif
+        const bool bHasSep = aArg.endsWith("/") || aArg.endsWith("\\");
+        rVar.PutString(aArg + (bHasSep || aArg.isEmpty() ? OUString() : OUString(cSep)) + pArgs->Get(2)->GetOUString());
+    }
+    else if (rName == "gettempname") rVar.PutString("rad" + OUString::number(comphelper::rng::uniform_int_distribution(10000, 99999)) + ".tmp");
+    else if (rName == "getfile" || rName == "getfolder")
+    {
+        const bool bFolder = rName == "getfolder";
+        if (bFolder ? !isFolder(aUrl) : !isFile(aUrl))
+            raise(bFolder ? nErrPathNotFound : nErrFileNotFound, bFolder ? u"Path not found"_ustr : u"File not found"_ustr);
+        else
+            putObject(new BasicFileItem(aUrl, bFolder));
+    }
+    else if (rName == "createfolder")
+    {
+        if (osl::Directory::create(aUrl) == osl::FileBase::E_EXIST)
+            raise(nErrFileExists, u"File already exists"_ustr);
+        else
+            putObject(new BasicFileItem(aUrl, true));
+    }
+    else if (rName == "deletefile")
+    {
+        if (osl::File::remove(aUrl) != osl::FileBase::E_None)
+            raise(nErrFileNotFound, u"File not found"_ustr);
+    }
+    else if (rName == "deletefolder")
+    {
+        if (!deleteTree(aUrl))
+            raise(nErrPathNotFound, u"Path not found"_ustr);
+    }
+    else if ((rName == "copyfile" || rName == "movefile") && nArgs > 2)
+    {
+        OUString aDest = pathToUrl(pArgs->Get(2)->GetOUString());
+        if (isFolder(aDest))
+            aDest += (aDest.endsWith("/") ? u""_ustr : u"/"_ustr) + nameOf(aUrl);
+        if (rName == "copyfile" && nArgs > 3 && !pArgs->Get(3)->GetBool() && isFile(aDest))
+            raise(nErrFileExists, u"File already exists"_ustr);
+        else if ((rName == "copyfile" ? osl::File::copy(aUrl, aDest) : osl::File::move(aUrl, aDest)) != osl::FileBase::E_None)
+            raise(nErrFileNotFound, u"File not found"_ustr);
+    }
+    else if (rName == "createtextfile")
+    {
+        if (nArgs > 2 && !pArgs->Get(2)->GetBool() && isFile(aUrl))
+            raise(nErrFileExists, u"File already exists"_ustr);
+        else
+            putObject(new BasicTextStream(aUrl, 2, nArgs > 3 && pArgs->Get(3)->GetBool() ? -1 : 0));
+    }
+    else if (rName == "opentextfile")
+    {
+        const sal_Int32 nMode = nArgs > 2 ? pArgs->Get(2)->GetLong() : 1;
+        const bool bCreate = nArgs > 3 && pArgs->Get(3)->GetBool();
+        if (!isFile(aUrl) && !bCreate)
+            raise(nErrFileNotFound, u"File not found"_ustr);
+        else
+            putObject(new BasicTextStream(aUrl, nMode, nArgs > 4 ? pArgs->Get(4)->GetLong() : 0));
+    }
+    else
+        return false;
+    return true;
+}
+
