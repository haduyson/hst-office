+void BasicScriptingObject::addMethods(std::initializer_list<OUString> aNames)
+{
+    for (const OUString& rName : aNames)
+        Make(rName, SbxClassType::Method, SbxVARIANT)->SetFlag(SbxFlagBits::DontStore);
+}
+
+void BasicScriptingObject::addProperties(std::initializer_list<OUString> aNames)
+{
+    for (const OUString& rName : aNames)
+        Make(rName, SbxClassType::Property, SbxVARIANT)->SetFlag(SbxFlagBits::DontStore);
+}
+
+void BasicScriptingObject::raise(sal_Int32 nNumber, const OUString& rMessage)
+{
+    if (SbiInstance* pInst = GetSbData()->pInst)
+    {
+        if (SbxErrObject* pErr = static_cast<SbxErrObject*>(SbxErrObject::getErrObject().get()))
+            pErr->setNumberAndDescription(nNumber, rMessage);
+        pInst->ErrorVB(nNumber, rMessage);
+    }
+    else
+        StarBASIC::Error(ERRCODE_BASIC_BAD_ARGUMENT);
+}
+
+void BasicScriptingObject::Notify(SfxBroadcaster& rCst, const SfxHint& rHint)
+{
+    const SbxHint* p = dynamic_cast<const SbxHint*>(&rHint);
+    if (!p)
+        return SbxObject::Notify(rCst, rHint);
+    const SfxHintId nId = p->GetId();
+    if (nId != SfxHintId::BasicDataWanted && nId != SfxHintId::BasicDataChanged)
+        return SbxObject::Notify(rCst, rHint);
+    SbxVariable* pVar = p->GetVar();
+    SbxArray* pArgs = pVar->GetParameters();
+    if (!call(pVar->GetName().toAsciiLowerCase(), *pVar, pArgs, pArgs ? pArgs->Count() : 0, nId == SfxHintId::BasicDataChanged))
+        SbxObject::Notify(rCst, rHint);
+}
+
+BasicRegExp::BasicRegExp()
+    : BasicScriptingObject(u"RegExp"_ustr)
+{
+    addMethods({ u"Test"_ustr, u"Execute"_ustr, u"Replace"_ustr });
+    addProperties({ u"Pattern"_ustr, u"Global"_ustr, u"IgnoreCase"_ustr, u"MultiLine"_ustr });
+}
+
+namespace
+{
+std::unique_ptr<icu::RegexMatcher> makeMatcher(const OUString& rPattern, const OUString& rText, bool bIgnoreCase, bool bMultiLine,
+                                               icu::UnicodeString& rHolder)
+{
+    UErrorCode nStatus = U_ZERO_ERROR;
+    uint32_t nFlags = (bIgnoreCase ? UREGEX_CASE_INSENSITIVE : 0) | (bMultiLine ? UREGEX_MULTILINE : 0);
+    rHolder = icu::UnicodeString(reinterpret_cast<const UChar*>(rText.getStr()), rText.getLength());
+    auto xMatcher = std::make_unique<icu::RegexMatcher>(
+        icu::UnicodeString(reinterpret_cast<const UChar*>(rPattern.getStr()), rPattern.getLength()), rHolder, nFlags, nStatus);
+    return U_FAILURE(nStatus) ? nullptr : std::move(xMatcher);
+}
+
+OUString toOUString(const icu::UnicodeString& rText)
+{
+    return OUString(reinterpret_cast<const sal_Unicode*>(rText.getBuffer()), rText.length());
+}
+
+/// "$&" and literal backslashes in a VBScript replacement, in ICU's syntax
+icu::UnicodeString replacementToIcu(const OUString& rWith)
+{
+    return icu::UnicodeString(reinterpret_cast<const UChar*>(rWith.replaceAll("\\", "\\\\").replaceAll("$&", "$0").getStr()));
+}
+
+SbxObject* makeMatch(icu::RegexMatcher& rMatcher)
+{
+    UErrorCode nStatus = U_ZERO_ERROR;
+    SbxObject* pMatch = new SbxObject(u"Match"_ustr);
+    pMatch->SetFlag(SbxFlagBits::Fixed);
+    pMatch->Make(u"Value"_ustr, SbxClassType::Property, SbxSTRING)->PutString(toOUString(rMatcher.group(nStatus)));
+    pMatch->Make(u"FirstIndex"_ustr, SbxClassType::Property, SbxLONG)->PutLong(rMatcher.start(nStatus));
+    pMatch->Make(u"Length"_ustr, SbxClassType::Property, SbxLONG)->PutLong(rMatcher.end(nStatus) - rMatcher.start(nStatus));
+    BasicDictionary* pSubs = new BasicDictionary(u"SubMatches"_ustr);
+    pSubs->SetIterateItems(true);
+    for (int32_t i = 1; i <= rMatcher.groupCount(); ++i)
+    {
+        SbxVariableRef xKey = new SbxVariable(SbxLONG);
+        xKey->PutLong(i - 1);
+        SbxVariable* pItem = pSubs->GetItemForKey(*xKey);
+        pItem->PutString(rMatcher.start(i, nStatus) < 0 ? OUString() : toOUString(rMatcher.group(i, nStatus)));
+    }
+    SbxVariable* pProp = pMatch->Make(u"SubMatches"_ustr, SbxClassType::Property, SbxOBJECT);
+    pProp->PutObject(pSubs);
+    pMatch->SetDfltProperty(u"Value"_ustr);
+    return pMatch;
+}
+}
+
+bool BasicRegExp::implTest(const OUString& rText)
+{
+    icu::UnicodeString aHolder;
+    auto xMatcher = makeMatcher(maPattern, rText, mbIgnoreCase, mbMultiLine, aHolder);
+    if (!xMatcher)
+    {
+        raise(nErrBadPattern, u"Syntax error in regular expression"_ustr);
+        return false;
+    }
+    UErrorCode nStatus = U_ZERO_ERROR;
+    return xMatcher->find(nStatus) && U_SUCCESS(nStatus);
+}
+
+SbxObject* BasicRegExp::implExecute(const OUString& rText)
+{
+    BasicDictionary* pMatches = new BasicDictionary(u"MatchCollection"_ustr);
+    pMatches->SetIterateItems(true);
+    icu::UnicodeString aHolder;
+    auto xMatcher = makeMatcher(maPattern, rText, mbIgnoreCase, mbMultiLine, aHolder);
+    if (!xMatcher)
+    {
+        raise(nErrBadPattern, u"Syntax error in regular expression"_ustr);
+        return pMatches;
+    }
+    UErrorCode nStatus = U_ZERO_ERROR;
+    sal_Int32 nCount = 0;
+    while (xMatcher->find(nStatus) && U_SUCCESS(nStatus))
+    {
+        SbxVariableRef xKey = new SbxVariable(SbxLONG);
+        xKey->PutLong(nCount++);
+        pMatches->GetItemForKey(*xKey)->PutObject(makeMatch(*xMatcher));
+        if (!mbGlobal)
+            break;
+    }
+    return pMatches;
+}
+
+OUString BasicRegExp::implReplace(const OUString& rText, const OUString& rWith)
+{
+    icu::UnicodeString aHolder;
+    auto xMatcher = makeMatcher(maPattern, rText, mbIgnoreCase, mbMultiLine, aHolder);
+    if (!xMatcher)
+    {
+        raise(nErrBadPattern, u"Syntax error in regular expression"_ustr);
+        return rText;
+    }
+    UErrorCode nStatus = U_ZERO_ERROR;
+    icu::UnicodeString aWith = replacementToIcu(rWith);
+    icu::UnicodeString aOut = mbGlobal ? xMatcher->replaceAll(aWith, nStatus) : xMatcher->replaceFirst(aWith, nStatus);
+    return U_SUCCESS(nStatus) ? toOUString(aOut) : rText;
+}
+
+bool BasicRegExp::call(const OUString& rName, SbxVariable& rVar, SbxArray* pArgs, sal_uInt32 nArgs, bool bWrite)
+{
+    if (rName == "pattern")
+        bWrite ? void(maPattern = rVar.GetOUString()) : void(rVar.PutString(maPattern));
+    else if (rName == "global")
+        bWrite ? void(mbGlobal = rVar.GetBool()) : void(rVar.PutBool(mbGlobal));
+    else if (rName == "ignorecase")
+        bWrite ? void(mbIgnoreCase = rVar.GetBool()) : void(rVar.PutBool(mbIgnoreCase));
+    else if (rName == "multiline")
+        bWrite ? void(mbMultiLine = rVar.GetBool()) : void(rVar.PutBool(mbMultiLine));
+    else if (rName == "test" && nArgs == 2)
+        rVar.PutBool(implTest(pArgs->Get(1)->GetOUString()));
+    else if (rName == "execute" && nArgs == 2)
+    {
+        SbxFlagBits nFlags = rVar.GetFlags();
+        rVar.ResetFlag(SbxFlagBits::Fixed);
+        rVar.PutObject(implExecute(pArgs->Get(1)->GetOUString()));
+        rVar.SetFlags(nFlags);
+    }
+    else if (rName == "replace" && nArgs == 3)
+        rVar.PutString(implReplace(pArgs->Get(1)->GetOUString(), pArgs->Get(2)->GetOUString()));
+    else
+        return false;
+    return true;
+}
