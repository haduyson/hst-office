+// HST: Scripting.TextStream for VBA code. Reads the whole file; writes reach the file on Close.
+
+#include <sbxscripting.hxx>
+#include <basic/sberrors.hxx>
+#include <osl/file.hxx>
+#include <osl/thread.h>
+#include <rtl/textcvt.h>
+#include <vector>
+
+constexpr sal_Int32 nErrPastEnd = 62; // Input past end of file
+constexpr sal_Int32 nErrBadMode = 54; // Bad file mode
+
+namespace
+{
+std::vector<char> readFile(const OUString& rUrl)
+{
+    std::vector<char> aData;
+    osl::File aFile(rUrl);
+    if (aFile.open(osl_File_OpenFlag_Read) != osl::FileBase::E_None)
+        return aData;
+    sal_uInt64 nSize = 0;
+    aFile.getSize(nSize);
+    aData.resize(nSize);
+    sal_uInt64 nRead = 0;
+    aFile.read(aData.data(), nSize, nRead);
+    aData.resize(nRead);
+    return aData;
+}
+
+/// ANSI text is the system code page; on a UTF-8 system, a file that is not UTF-8 is Windows-1258
+OUString decode(const std::vector<char>& rData, bool bUnicode)
+{
+    const char* p = rData.data();
+    sal_Int32 n = static_cast<sal_Int32>(rData.size());
+    if (n >= 2 && static_cast<unsigned char>(p[0]) == 0xFF && static_cast<unsigned char>(p[1]) == 0xFE)
+        return OUString(reinterpret_cast<const sal_Unicode*>(p + 2), (n - 2) / 2);
+    if (bUnicode)
+        return OUString(reinterpret_cast<const sal_Unicode*>(p), n / 2);
+    if (n >= 3 && static_cast<unsigned char>(p[0]) == 0xEF && static_cast<unsigned char>(p[1]) == 0xBB && static_cast<unsigned char>(p[2]) == 0xBF)
+        return OUString(p + 3, n - 3, RTL_TEXTENCODING_UTF8);
+    rtl_TextEncoding eEnc = osl_getThreadTextEncoding();
+    OUString aOut;
+    if (eEnc == RTL_TEXTENCODING_UTF8
+        && !rtl_convertStringToUString(&aOut.pData, p, n, eEnc,
+                                       RTL_TEXTTOUNICODE_FLAGS_UNDEFINED_ERROR | RTL_TEXTTOUNICODE_FLAGS_MBUNDEFINED_ERROR
+                                           | RTL_TEXTTOUNICODE_FLAGS_INVALID_ERROR))
+        eEnc = RTL_TEXTENCODING_MS_1258;
+    else if (eEnc == RTL_TEXTENCODING_UTF8)
+        return aOut;
+    return OUString(p, n, eEnc);
+}
+}
+
+BasicTextStream::BasicTextStream(const OUString& rUrl, sal_Int32 nMode, sal_Int32 nFormat)
+    : BasicScriptingObject(u"TextStream"_ustr)
+    , maUrl(rUrl)
+    , mbWrite(nMode != 1)
+    , mbAppend(nMode == 8)
+    , mbUnicode(nFormat == -1)
+{
+    addMethods({ u"ReadLine"_ustr, u"ReadAll"_ustr, u"Read"_ustr, u"Write"_ustr, u"WriteLine"_ustr, u"WriteBlankLines"_ustr,
+                 u"Skip"_ustr, u"SkipLine"_ustr, u"Close"_ustr });
+    addProperties({ u"AtEndOfStream"_ustr, u"AtEndOfLine"_ustr, u"Line"_ustr, u"Column"_ustr });
+    if (!mbWrite)
+        maText = decode(readFile(rUrl), mbUnicode);
+    else if (!mbAppend)
+    {
+        // the file exists from the moment it is created, as with Windows
+        osl::File aFile(rUrl);
+        if (aFile.open(osl_File_OpenFlag_Create | osl_File_OpenFlag_Write) == osl::FileBase::E_EXIST)
+        {
+            osl::File::remove(rUrl);
+            aFile.open(osl_File_OpenFlag_Create | osl_File_OpenFlag_Write);
+        }
+        if (mbUnicode)
+        {
+            sal_uInt64 nDone = 0;
+            aFile.write("\xFF\xFE", 2, nDone);
+        }
+    }
+}
+
+BasicTextStream::~BasicTextStream()
+{
+    if (mbOpen)
+        implFlush();
+}
+
+void BasicTextStream::implFlush()
+{
+    if (!mbWrite || maText.isEmpty())
+        return;
+    osl::File aFile(maUrl);
+    if (aFile.open(osl_File_OpenFlag_Write) != osl::FileBase::E_None
+        && aFile.open(osl_File_OpenFlag_Create | osl_File_OpenFlag_Write) != osl::FileBase::E_None)
+        return;
+    sal_uInt64 nSize = 0;
+    aFile.getSize(nSize);
+    aFile.setPos(osl_Pos_Absolut, nSize);
+    sal_uInt64 nDone = 0;
+    if (mbUnicode)
+        aFile.write(maText.getStr(), maText.getLength() * sizeof(sal_Unicode), nDone);
+    else
+    {
+        OString aBytes = OUStringToOString(maText, osl_getThreadTextEncoding());
+        aFile.write(aBytes.getStr(), aBytes.getLength(), nDone);
+    }
+    maText.clear();
+}
+
+bool BasicTextStream::call(const OUString& rName, SbxVariable& rVar, SbxArray* pArgs, sal_uInt32 nArgs, bool)
+{
+    const sal_Int32 nLen = maText.getLength();
+    if (rName == "close")
+    {
+        implFlush();
+        mbOpen = false;
+    }
+    else if (rName == "write" || rName == "writeline" || rName == "writeblanklines")
+    {
+        if (!mbWrite)
+            raise(nErrBadMode, u"Bad file mode"_ustr);
+        else if (rName == "writeblanklines")
+            for (sal_Int32 i = 0, n = nArgs > 1 ? pArgs->Get(1)->GetLong() : 0; i < n; ++i)
+                maText += "\r\n";
+        else
+            maText += (nArgs > 1 ? pArgs->Get(1)->GetOUString() : OUString()) + (rName == "writeline" ? u"\r\n"_ustr : OUString());
+    }
+    else if (rName == "atendofstream")
+        rVar.PutBool(mnPos >= nLen);
+    else if (rName == "atendofline")
+        rVar.PutBool(mnPos >= nLen || maText[mnPos] == '\r' || maText[mnPos] == '\n');
+    else if (rName == "line")
+        rVar.PutLong(mnLine);
+    else if (rName == "column")
+        rVar.PutLong(mnColumn);
+    else if (mbWrite)
+        raise(nErrBadMode, u"Bad file mode"_ustr);
+    else if (rName == "readall")
+    {
+        rVar.PutString(maText.copy(mnPos));
+        mnPos = nLen;
+    }
+    else if (mnPos >= nLen && (rName == "readline" || rName == "read" || rName == "skipline"))
+        raise(nErrPastEnd, u"Input past end of file"_ustr);
+    else if (rName == "readline" || rName == "skipline")
+    {
+        sal_Int32 nEnd = mnPos;
+        while (nEnd < nLen && maText[nEnd] != '\r' && maText[nEnd] != '\n')
+            ++nEnd;
+        if (rName == "readline")
+            rVar.PutString(maText.copy(mnPos, nEnd - mnPos));
+        if (nEnd < nLen && maText[nEnd] == '\r' && nEnd + 1 < nLen && maText[nEnd + 1] == '\n')
+            ++nEnd;
+        mnPos = nEnd + 1;
+        ++mnLine;
+        mnColumn = 1;
+    }
+    else if ((rName == "read" || rName == "skip") && nArgs > 1)
+    {
+        sal_Int32 nCount = std::min(pArgs->Get(1)->GetLong(), nLen - mnPos);
+        if (rName == "read")
+            rVar.PutString(maText.copy(mnPos, nCount));
+        mnPos += nCount;
+        mnColumn += nCount;
+    }
+    else
+        return false;
+    return true;
+}
