--- a/basic/source/classes/sbxfsitems.cxx
+++ b/basic/source/classes/sbxfsitems.cxx
@@ -0,0 +1,174 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This file is part of the LibreOffice project.
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+// HST: paths and the File and Folder objects of Scripting.FileSystemObject.
+
+#include <sbxscripting.hxx>
+#include <sbunoobj.hxx>
+#include <basic/sberrors.hxx>
+#include <osl/file.hxx>
+#include <osl/process.h>
+
+namespace basic::scripting
+{
+OUString pathToUrl(const OUString& rPath)
+{
+    OUString aPath = rPath;
+#ifndef _WIN32
+    aPath = aPath.replace('\\', '/');
+#endif
+    if (aPath.startsWithIgnoreAsciiCase("file:"))
+        return aPath;
+    OUString aBase, aUrl;
+    osl_getProcessWorkingDir(&aBase.pData);
+    if (osl::FileBase::getFileURLFromSystemPath(aPath, aUrl) != osl::FileBase::E_None)
+        aUrl = aPath;
+    OUString aAbs;
+    return osl::FileBase::getAbsoluteFileURL(aBase, aUrl, aAbs) == osl::FileBase::E_None ? aAbs : aUrl;
+}
+
+OUString urlToPath(const OUString& rUrl)
+{
+    OUString aPath;
+    return osl::FileBase::getSystemPathFromFileURL(rUrl, aPath) == osl::FileBase::E_None ? aPath : rUrl;
+}
+
+int itemKind(const OUString& rUrl) // 0 none, 1 file, 2 folder
+{
+    osl::DirectoryItem aItem;
+    if (osl::DirectoryItem::get(rUrl, aItem) != osl::FileBase::E_None)
+        return 0;
+    osl::FileStatus aStatus(osl_FileStatus_Mask_Type);
+    if (aItem.getFileStatus(aStatus) != osl::FileBase::E_None)
+        return 0;
+    return aStatus.getFileType() == osl::FileStatus::Directory ? 2 : 1;
+}
+
+bool deleteTree(const OUString& rUrl)
+{
+    osl::Directory aDir(rUrl);
+    if (aDir.open() != osl::FileBase::E_None)
+        return false;
+    osl::DirectoryItem aItem;
+    while (aDir.getNextItem(aItem) == osl::FileBase::E_None)
+    {
+        osl::FileStatus aStatus(osl_FileStatus_Mask_Type | osl_FileStatus_Mask_FileURL);
+        if (aItem.getFileStatus(aStatus) != osl::FileBase::E_None)
+            continue;
+        if (aStatus.getFileType() == osl::FileStatus::Directory)
+            deleteTree(aStatus.getFileURL());
+        else
+            osl::File::remove(aStatus.getFileURL());
+    }
+    aDir.close();
+    return osl::Directory::remove(rUrl) == osl::FileBase::E_None;
+}
+
+OUString nameOf(const OUString& rPath)
+{
+    OUString aPath = rPath.replace('\\', '/');
+    while (aPath.endsWith("/") && aPath.getLength() > 1)
+        aPath = aPath.copy(0, aPath.getLength() - 1);
+    return aPath.copy(aPath.lastIndexOf('/') + 1);
+}
+
+double oleDate(const TimeValue& rTime)
+{
+    TimeValue aLocal = rTime;
+    osl_getLocalTimeFromSystemTime(&rTime, &aLocal);
+    return aLocal.Seconds / 86400.0 + 25569.0;
+}
+
+bool isFile(const OUString& rUrl) { return itemKind(rUrl) == 1; }
+bool isFolder(const OUString& rUrl) { return itemKind(rUrl) == 2; }
+}
+
+using namespace basic::scripting;
+
+BasicFileItem::BasicFileItem(const OUString& rUrl, bool bFolder)
+    : BasicScriptingObject(bFolder ? u"Folder"_ustr : u"File"_ustr)
+    , maUrl(rUrl)
+    , mbFolder(bFolder)
+{
+    addProperties({ u"Name"_ustr, u"Path"_ustr, u"Size"_ustr, u"DateLastModified"_ustr, u"ParentFolder"_ustr, u"Type"_ustr });
+    addMethods({ u"Delete"_ustr });
+    if (bFolder)
+        addProperties({ u"Files"_ustr, u"SubFolders"_ustr });
+    SetDfltProperty(u"Path"_ustr);
+}
+
+SbxObject* BasicFileItem::implList(bool bSubFolders) const
+{
+    BasicDictionary* pList = new BasicDictionary(bSubFolders ? u"Folders"_ustr : u"Files"_ustr);
+    pList->SetIterateItems(true);
+    osl::Directory aDir(maUrl);
+    if (aDir.open() != osl::FileBase::E_None)
+        return pList;
+    osl::DirectoryItem aEntry;
+    while (aDir.getNextItem(aEntry) == osl::FileBase::E_None)
+    {
+        osl::FileStatus aStatus(osl_FileStatus_Mask_Type | osl_FileStatus_Mask_FileURL);
+        if (aEntry.getFileStatus(aStatus) != osl::FileBase::E_None
+            || (aStatus.getFileType() == osl::FileStatus::Directory) != bSubFolders)
+            continue;
+        SbxVariableRef xKey = new SbxVariable(SbxSTRING);
+        xKey->PutString(nameOf(aStatus.getFileURL()));
+        pList->GetItemForKey(*xKey)->PutObject(new BasicFileItem(aStatus.getFileURL(), bSubFolders));
+    }
+    return pList;
+}
+
+bool BasicFileItem::call(const OUString& rName, SbxVariable& rVar, SbxArray*, sal_uInt32, bool)
+{
+    auto putObject = [&rVar](SbxObject* pObj) {
+        SbxFlagBits nFlags = rVar.GetFlags();
+        rVar.ResetFlag(SbxFlagBits::Fixed);
+        rVar.PutObject(pObj);
+        rVar.SetFlags(nFlags);
+    };
+    const OUString aPath = urlToPath(maUrl);
+    if (rName == "name")
+        rVar.PutString(nameOf(aPath));
+    else if (rName == "path")
+        rVar.PutString(aPath);
+    else if (rName == "type")
+        rVar.PutString(mbFolder ? u"File folder"_ustr : u"File"_ustr);
+    else if (rName == "size" || rName == "datelastmodified")
+    {
+        osl::DirectoryItem aItem;
+        osl::FileStatus aStatus(osl_FileStatus_Mask_FileSize | osl_FileStatus_Mask_ModifyTime);
+        if (osl::DirectoryItem::get(maUrl, aItem) != osl::FileBase::E_None || aItem.getFileStatus(aStatus) != osl::FileBase::E_None)
+            raise(53, u"File not found"_ustr);
+        else if (rName == "size")
+            rVar.PutDouble(static_cast<double>(aStatus.getFileSize()));
+        else
+            rVar.PutDate(oleDate(aStatus.getModifyTime()));
+    }
+    else if (rName == "parentfolder")
+    {
+        sal_Int32 nCut = maUrl.lastIndexOf('/');
+        putObject(new BasicFileItem(maUrl.copy(0, nCut), true));
+    }
+    else if (rName == "files" && mbFolder)
+        putObject(implList(false));
+    else if (rName == "subfolders" && mbFolder)
+        putObject(implList(true));
+    else if (rName == "delete")
+    {
+        if (mbFolder)
+            deleteTree(maUrl);
+        else
+            osl::File::remove(maUrl);
+    }
+    else
+        return false;
+    return true;
+}
+
