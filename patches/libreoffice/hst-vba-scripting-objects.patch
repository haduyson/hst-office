+    SbxObject* implExecute(const OUString& rText);
+    OUString implReplace(const OUString& rText, const OUString& rWith);
+    bool implTest(const OUString& rText);
+    virtual bool call(const OUString& rName, SbxVariable& rVar, SbxArray* pArgs, sal_uInt32 nArgs, bool bWrite) override;
+
+public:
+    BasicRegExp();
+};
