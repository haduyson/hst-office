+/// HST Office: a chart without fonts of its own takes the default spreadsheet font, Calibri in HST
+/// Office (hst-msoffice-defaults.patch), drawn with the narrower bundled Carlito, so its axis labels
+/// need fewer lines and no rotation. These tests measure the label layout of documents made with
+/// upstream's default, Liberation Sans, so they draw Calibri with it.
+struct HstChartsInLiberationSans
+{
+    HstChartsInLiberationSans()
+    {
+        OutputDevice::BeginFontSubstitution();
+        OutputDevice::AddFontSubstitute(u"Calibri"_ustr, u"Liberation Sans"_ustr,
+                                        AddFontSubstituteFlags::ALWAYS);
+        OutputDevice::EndFontSubstitution();
+    }
+    ~HstChartsInLiberationSans()
+    {
+        // the font caches are cleared only on a change: the dummy entry is one
+        OutputDevice::BeginFontSubstitution();
+        OutputDevice::AddFontSubstitute(OUString(), OUString(), AddFontSubstituteFlags::NONE);
+        OutputDevice::RemoveFontsSubstitute();
+        OutputDevice::EndFontSubstitution();
+    }
+};
+}
