+// HST Office: one row per page, sized from the view width, so no row is ever cut off.
+size_t StylesPreviewWindow_Base::CalcPageSize() const
+{
+    // An item is the preview plus the icon view's item padding on both sides.
+    constexpr tools::Long nItemWidth = 100 + 2 * 3;
+    if (m_nViewWidth <= 0)
+        return 1;
+    return std::max<size_t>(1, m_nViewWidth / nItemWidth);
+}
+
+IMPL_LINK(StylesPreviewWindow_Base, ViewSizeHdl, const Size&, rSize, void)
+{
+    if (rSize.Width() == m_nViewWidth)
+        return;
+    m_nViewWidth = rSize.Width();
+    if (CalcPageSize() != m_nPageSize)
+        ShowPage();
+}
+
+IMPL_LINK(StylesPreviewWindow_Base, PageHdl, weld::Button&, rButton, void)
+{
+    if (!m_nPageSize)
+        return;
+    if (&rButton == m_xNextButton.get())
+    {
+        if (m_nFirstVisible + m_nPageSize < m_aAllStyles.size())
+            m_nFirstVisible += m_nPageSize;
+    }
+    else
+        m_nFirstVisible = m_nFirstVisible > m_nPageSize ? m_nFirstVisible - m_nPageSize : 0;
+    ShowPage();
+}
+
+IMPL_LINK_NOARG(StylesPreviewWindow_Base, MoreHdl, weld::Button&, void)
+{
+    // All styles, with search and filters: the Styles deck of the sidebar.
+    const css::uno::Reference<css::frame::XDispatchProvider> xProvider(m_xFrame,
+                                                                       css::uno::UNO_QUERY);
+    SfxToolBoxControl::Dispatch(xProvider, u".uno:SidebarDeck.StyleListDeck"_ustr, {});
+}
+
+void StylesPreviewWindow_Base::ShowPage()
+{
+    m_nPageSize = CalcPageSize();
+    if (m_nFirstVisible >= m_aAllStyles.size())
+        m_nFirstVisible = 0;
+    // pages start at multiples of the page size, so paging back and forth is stable
+    m_nFirstVisible -= m_nFirstVisible % m_nPageSize;
+    const size_t nEnd = std::min(m_aAllStyles.size(), m_nFirstVisible + m_nPageSize);
+
+    m_xStylesView->freeze();
+    m_xStylesView->clear();
+    int nIndex = 0;
+    for (size_t i = m_nFirstVisible; i < nEnd; ++i)
+    {
+        const StylePreviewDescriptor& rStyle = m_aAllStyles[i];
+        Bitmap aPreview = GetCachedPreview(rStyle);
+        m_xStylesView->insert(nIndex, nullptr, &rStyle.translatedName, &aPreview, nullptr);
+        m_xStylesView->set_item_tooltip_text(nIndex, rStyle.translatedName);
+        m_xStylesView->set_item_accessible_name(nIndex, rStyle.translatedName);
+        nIndex++;
+    }
+    m_xStylesView->thaw();
+
+    m_xPrevButton->set_sensitive(m_nFirstVisible > 0);
+    m_xNextButton->set_sensitive(nEnd < m_aAllStyles.size());
+    UpdateSelection();
+}
