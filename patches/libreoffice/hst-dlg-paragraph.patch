+
+void SvxStdParagraphTabPage::HstSpecialFromFirstLine()
+{
+    // A style can hold a relative (%) or font-relative (em) first line: only the original field
+    // can show those, so it stays visible for them and "Special" is hidden.
+    const bool bPlainLength = !m_aFLineIndent.IsRelative() && m_aFLineIndent.GetCurrentUnit() == FieldUnit::NONE;
+    m_xFLineLabel->set_visible(!bPlainLength);
+    m_aFLineIndent.get_widget().set_visible(!bPlainLength);
+    m_xHstSpecialLabel->set_visible(bPlainLength);
+    m_xHstSpecial->set_visible(bPlainLength);
+    m_xHstSpecialByLabel->set_visible(bPlainLength);
+    m_xHstSpecialBy->set_visible(bPlainLength);
+    if (!bPlainLength)
+        return;
+
+    if (m_aFLineIndent.get_text().isEmpty()) // mixed selection
+    {
+        m_xHstSpecial->set_active(-1);
+        m_xHstSpecialBy->set_text(OUString());
+        return;
+    }
+    const FieldUnit eUnit = m_xHstSpecialBy->get_unit();
+    const sal_Int64 nValue = m_aFLineIndent.get_value(eUnit);
+    m_xHstSpecial->set_active(nValue > 0 ? 1 : nValue < 0 ? 2 : 0);
+    m_xHstSpecialBy->set_value(std::abs(nValue), eUnit);
+    m_xHstSpecialBy->set_sensitive(nValue != 0 && !m_xAutoCB->get_active());
+    m_xHstSpecialByLabel->set_sensitive(nValue != 0 && !m_xAutoCB->get_active());
+}
+
+IMPL_LINK_NOARG(SvxStdParagraphTabPage, HstSpecialHdl_Impl, weld::ComboBox&, void)
+{
+    const int nKind = m_xHstSpecial->get_active();
+    const FieldUnit eUnit = m_xHstSpecialBy->get_unit();
+    sal_Int64 nBy = m_xHstSpecialBy->get_value(eUnit);
+    if (nKind == 0)
+        nBy = 0;
+    else if (nBy == 0) // like Word: choosing a kind offers a usable amount (1.27 cm)
+    {
+        m_xHstSpecialBy->set_value(m_xHstSpecialBy->normalize(720), FieldUnit::TWIP);
+        nBy = m_xHstSpecialBy->get_value(eUnit);
+    }
+    m_aFLineIndent.set_value(nKind == 2 ? -nBy : nBy, eUnit);
+    m_xHstSpecialBy->set_sensitive(nKind > 0);
+    m_xHstSpecialByLabel->set_sensitive(nKind > 0);
+    ELRLoseFocus();
+}
+
+void SvxStdParagraphTabPage::HstApplySpecialBy()
+{
+    // Only when edited: an untouched dialog must not rewrite a value the field rounded for display.
+    if (m_xHstSpecial->get_active() < 0 || !m_xHstSpecial->get_visible()
+        || !(m_xHstSpecial->get_value_changed_from_saved() || m_xHstSpecialBy->get_value_changed_from_saved()))
+        return;
+    const FieldUnit eUnit = m_xHstSpecialBy->get_unit();
+    const sal_Int64 nBy = m_xHstSpecial->get_active() == 0 ? 0 : m_xHstSpecialBy->get_value(eUnit);
+    m_aFLineIndent.set_value(m_xHstSpecial->get_active() == 2 ? -nBy : nBy, eUnit);
+}
+
+IMPL_LINK_NOARG(SvxStdParagraphTabPage, HstSpecialByHdl_Impl, weld::MetricSpinButton&, void)
+{
+    HstApplySpecialBy();
+    ELRLoseFocus();
+}
+
+void SvxStdParagraphTabPage::HstPreviewAlign(SvxAdjust eAdjust)
+{
+    // same convention as ActivatePage: the preview draws right alignment through its RTL mode
+    m_aExampleWin.EnableRTL(eAdjust == SvxAdjust::Right);
+    m_aExampleWin.SetAdjust(eAdjust == SvxAdjust::Right ? SvxAdjust::Left : eAdjust);
+}
+
+void SvxStdParagraphTabPage::HstAlignFromSet(const SfxItemSet& rSet)
+{
+    const sal_uInt16 nWhich = GetWhich(SID_ATTR_PARA_ADJUST);
+    const SfxItemState eState = rSet.GetItemState(nWhich);
+    // Pages without an alignment item in their dialog (no Alignment page) have no such option.
+    const bool bAvailable = eState != SfxItemState::UNKNOWN && eState != SfxItemState::DISABLED;
+    m_xHstGeneralFrame->set_visible(bAvailable);
+    int nActive = -1;
+    if (eState >= SfxItemState::DEFAULT)
+    {
+        SvxAdjust eAdjust = static_cast<const SvxAdjustItem&>(rSet.Get(nWhich)).GetAdjust();
+        // Start/End are logical: show the side they mean in this paragraph direction.
+        const sal_uInt16 nWhichDir = GetWhich(SID_ATTR_FRAMEDIRECTION);
+        const bool bRTL = rSet.GetItemState(nWhichDir) >= SfxItemState::DEFAULT
+            && static_cast<const SvxFrameDirectionItem&>(rSet.Get(nWhichDir)).GetValue() == SvxFrameDirection::Horizontal_RL_TB;
+        if (eAdjust == SvxAdjust::ParaStart)
+            eAdjust = bRTL ? SvxAdjust::Right : SvxAdjust::Left;
+        else if (eAdjust == SvxAdjust::ParaEnd)
+            eAdjust = bRTL ? SvxAdjust::Left : SvxAdjust::Right;
+        for (size_t i = 0; i < std::size(aHstAlignments); ++i)
+            if (aHstAlignments[i] == eAdjust)
+                nActive = static_cast<int>(i);
+    }
+    m_xHstAlign->set_active(nActive);
+    m_xHstAlign->save_value();
+}
+
+IMPL_LINK_NOARG(SvxStdParagraphTabPage, HstAlignHdl_Impl, weld::ComboBox&, void)
+{
+    const int nActive = m_xHstAlign->get_active();
+    if (nActive < 0)
+        return;
+    HstPreviewAlign(aHstAlignments[nActive]);
+    UpdateExample_Impl();
+}
