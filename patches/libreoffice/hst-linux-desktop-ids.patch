 DESKTOPNAME.hst_office := HST
+# Launcher and application icon id prefix: <id>-writer.desktop, icon <id>-writer; also the window
+# class and Wayland app_id (include/hst_desktop_id.h). update-desktop-database lists the handlers of
+# a MIME type sorted by id and, without a configured default, GLib and xdg-mime take the first: an
