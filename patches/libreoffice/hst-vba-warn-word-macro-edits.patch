+++ b/sfx2/source/doc/guisaveas.cxx
@@ -40,6 +40,7 @@
 #include <com/sun/star/script/XLibraryContainer.hpp>
 #include <com/sun/star/script/vba/XVBACompatibility.hpp>
 #include <o3tl/string_view.hxx>
+#include <basic/basmgr.hxx>
 #include <com/sun/star/beans/XPropertySet.hpp>
 #include <com/sun/star/beans/XPropertyContainer.hpp>
 #include <com/sun/star/beans/PropertyAttribute.hpp>
@@ -846,6 +847,22 @@
     const DocumentMacros aMacros = lclGetDocumentMacros( m_xModel );
     if ( !aMacros.bAny || rFilter.isEmpty() || !m_pOwner->GetFilterConfiguration()->hasByName( rFilter ) )
         return true;
+    // Word files keep the VBA project they were read with: edits made here would not reach the file
+    if ( aMacros.bImportedVba && ( rFilter == u"MS Word 2007 XML VBA" || rFilter == u"Office Open XML Text VBA" || rFilter == u"MS Word 97" ) )
+    {
+        SfxObjectShell* pShell = SfxObjectShell::GetShellFromComponent( m_xModel );
+        BasicManager* pBasicManager = pShell ? pShell->GetBasicManager() : nullptr;
+        if ( !pBasicManager || !pBasicManager->IsBasicModified() )
+            return true;
+        std::unique_ptr< weld::MessageDialog > xEdited( Application::CreateMessageDialog(
+            SfxStoringHelper::GetModelWindow( m_xModel ), VclMessageType::Warning, VclButtonsType::NONE,
+            SfxResId( STR_HST_MACRO_EDITS_TEXT ) ) );
+        xEdited->set_title( SfxResId( STR_HST_MACRO_FORMAT_TITLE ) );
+        xEdited->add_button( SfxResId( STR_HST_MACRO_EDITS_LOSE ), RET_YES );
+        xEdited->add_button( SfxResId( STR_HST_MACRO_FORMAT_BACK ), RET_NO );
+        xEdited->set_default_response( RET_NO );
+        return xEdited->run() == RET_YES;
+    }
     uno::Sequence< beans::PropertyValue > aProps;
     m_pOwner->GetFilterConfiguration()->getByName( rFilter ) >>= aProps;
     const ::comphelper::SequenceAsHashMap aPropsHM( aProps );
