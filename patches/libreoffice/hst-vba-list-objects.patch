+// HST: the columns and rows of an Excel table (ListColumns, ListRows).
+
+#include "vbalistobject.hxx"
+#include <ooo/vba/excel/XRange.hpp>
+
+using namespace ::ooo::vba;
+using namespace ::com::sun::star;
+
+namespace
+{
+class ListColumn final : public ScVbaListColumn_BASE, private ScVbaListTable
+{
+    sal_Int32 mnIndex; // 0-based
+
+public:
+    ListColumn(const uno::Reference<XHelperInterface>& xParent, const uno::Reference<uno::XComponentContext>& xContext,
+               const uno::Reference<frame::XModel>& xModel, const OUString& rTable, sal_Int32 nIndex)
+        : ScVbaListColumn_BASE(xParent, xContext), ScVbaListTable(xModel, rTable), mnIndex(nIndex) {}
+    OUString SAL_CALL getName() override
+    {
+        const table::CellRangeAddress a = area();
+        return hasHeaders() ? makeRange(this, mxContext, a.StartColumn + mnIndex, a.StartRow, a.StartColumn + mnIndex, a.StartRow)->getValue().get<OUString>() : "Column" + OUString::number(mnIndex + 1);
+    }
+    void SAL_CALL setName(const OUString& rName) override
+    {
+        const table::CellRangeAddress a = area();
+        makeRange(this, mxContext, a.StartColumn + mnIndex, a.StartRow, a.StartColumn + mnIndex, a.StartRow)->setValue(uno::Any(rName));
+    }
+    sal_Int32 SAL_CALL getIndex() override { return mnIndex + 1; }
+    uno::Reference<excel::XRange> SAL_CALL getRange() override
+    {
+        const table::CellRangeAddress a = area();
+        return makeRange(this, mxContext, a.StartColumn + mnIndex, a.StartRow, a.StartColumn + mnIndex, a.EndRow);
+    }
+    uno::Reference<excel::XRange> SAL_CALL getDataBodyRange() override
+    {
+        const table::CellRangeAddress a = area();
+        return firstDataRow() > lastDataRow() ? uno::Reference<excel::XRange>() : makeRange(this, mxContext, a.StartColumn + mnIndex, firstDataRow(), a.StartColumn + mnIndex, lastDataRow());
+    }
+    void SAL_CALL Delete() override
+    {
+        table::CellRangeAddress a = area();
+        table::CellRangeAddress aCells(a.Sheet, a.StartColumn + mnIndex, a.StartRow, a.StartColumn + mnIndex, a.EndRow);
+        removeCells(aCells, false);
+    }
+    OUString getServiceImplName() override { return u"ListColumn"_ustr; }
+    uno::Sequence<OUString> getServiceNames() override { return { u"ooo.vba.excel.ListColumn"_ustr }; }
+};
+
+class ListRow final : public ScVbaListRow_BASE, private ScVbaListTable
+{
+    sal_Int32 mnIndex; // 0-based among the data rows
+
+public:
+    ListRow(const uno::Reference<XHelperInterface>& xParent, const uno::Reference<uno::XComponentContext>& xContext,
+            const uno::Reference<frame::XModel>& xModel, const OUString& rTable, sal_Int32 nIndex)
+        : ScVbaListRow_BASE(xParent, xContext), ScVbaListTable(xModel, rTable), mnIndex(nIndex) {}
+    sal_Int32 SAL_CALL getIndex() override { return mnIndex + 1; }
+    uno::Reference<excel::XRange> SAL_CALL getRange() override
+    {
+        const table::CellRangeAddress a = area();
+        return makeRange(this, mxContext, a.StartColumn, firstDataRow() + mnIndex, a.EndColumn, firstDataRow() + mnIndex);
+    }
+    void SAL_CALL Delete() override
+    {
+        const table::CellRangeAddress a = area();
+        removeCells(table::CellRangeAddress(a.Sheet, a.StartColumn, firstDataRow() + mnIndex, a.EndColumn, firstDataRow() + mnIndex), true);
+    }
+    OUString getServiceImplName() override { return u"ListRow"_ustr; }
+    uno::Sequence<OUString> getServiceNames() override { return { u"ooo.vba.excel.ListRow"_ustr }; }
+};
+
+class ListColumns final : public ScVbaListColumns_BASE, private ScVbaListTable
+{
+public:
+    ListColumns(const uno::Reference<XHelperInterface>& xParent, const uno::Reference<uno::XComponentContext>& xContext,
+                const uno::Reference<frame::XModel>& xModel, const OUString& rTable, const uno::Reference<container::XIndexAccess>& xItems)
+        : ScVbaListColumns_BASE(xParent, xContext, xItems), ScVbaListTable(xModel, rTable) {}
+    uno::Reference<excel::XListColumn> SAL_CALL Add(const uno::Any& rPosition, const uno::Any&) override
+    {
+        table::CellRangeAddress a = area();
+        sal_Int32 nPosition = a.EndColumn - a.StartColumn + 2;
+        rPosition >>= nPosition;
+        const sal_Int32 nCol = a.StartColumn + nPosition - 1;
+        insertCells(table::CellRangeAddress(a.Sheet, nCol, a.StartRow, nCol, a.EndRow), false);
+        if (nCol > area().EndColumn)
+        {
+            a.EndColumn = nCol;
+            setArea(a);
+        }
+        uno::Reference<excel::XListColumn> xColumn(new ListColumn(mxParent, mxContext, mxModel, name(), nPosition - 1));
+        if (hasHeaders())
+            xColumn->setName("Column" + OUString::number(nPosition));
+        return xColumn;
+    }
+    uno::Type SAL_CALL getElementType() override { return cppu::UnoType<excel::XListColumn>::get(); }
+    uno::Reference<container::XEnumeration> SAL_CALL createEnumeration() override { return new SimpleIndexAccessToEnumeration(m_xIndexAccess); }
+    uno::Any createCollectionObject(const uno::Any& rSource) override { return rSource; }
+    OUString getServiceImplName() override { return u"ListColumns"_ustr; }
+    uno::Sequence<OUString> getServiceNames() override { return { u"ooo.vba.excel.ListColumns"_ustr }; }
+};
+
+class ListRows final : public ScVbaListRows_BASE, private ScVbaListTable
+{
+public:
+    ListRows(const uno::Reference<XHelperInterface>& xParent, const uno::Reference<uno::XComponentContext>& xContext,
+             const uno::Reference<frame::XModel>& xModel, const OUString& rTable, const uno::Reference<container::XIndexAccess>& xItems)
+        : ScVbaListRows_BASE(xParent, xContext, xItems), ScVbaListTable(xModel, rTable) {}
+    uno::Reference<excel::XListRow> SAL_CALL Add(const uno::Any& rPosition, const uno::Any&) override
+    {
+        table::CellRangeAddress a = area();
+        sal_Int32 nPosition = lastDataRow() - firstDataRow() + 2;
+        rPosition >>= nPosition;
+        const sal_Int32 nRow = firstDataRow() + nPosition - 1;
+        const bool bAtEnd = nRow > a.EndRow;
+        insertCells(table::CellRangeAddress(a.Sheet, a.StartColumn, nRow, a.EndColumn, nRow), true);
+        if (bAtEnd)
+        {
+            a.EndRow = nRow;
+            setArea(a);
+        }
+        return new ListRow(mxParent, mxContext, mxModel, name(), nPosition - 1);
+    }
+    uno::Type SAL_CALL getElementType() override { return cppu::UnoType<excel::XListRow>::get(); }
+    uno::Reference<container::XEnumeration> SAL_CALL createEnumeration() override { return new SimpleIndexAccessToEnumeration(m_xIndexAccess); }
+    uno::Any createCollectionObject(const uno::Any& rSource) override { return rSource; }
+    OUString getServiceImplName() override { return u"ListRows"_ustr; }
+    uno::Sequence<OUString> getServiceNames() override { return { u"ooo.vba.excel.ListRows"_ustr }; }
+};
+}
+
+uno::Reference<excel::XListColumns> makeListColumns(const uno::Reference<XHelperInterface>& xParent, const uno::Reference<uno::XComponentContext>& xContext,
+                                                    const uno::Reference<frame::XModel>& xModel, const OUString& rTable)
+{
+    ScVbaListTable aTable(xModel, rTable);
+    std::vector<uno::Any> aItems;
+    std::vector<OUString> aNames;
+    const table::CellRangeAddress a = aTable.area();
+    for (sal_Int32 i = 0; i <= a.EndColumn - a.StartColumn; ++i)
+    {
+        uno::Reference<excel::XListColumn> xColumn(new ListColumn(xParent, xContext, xModel, rTable, i));
+        aNames.push_back(xColumn->getName());
+        aItems.emplace_back(xColumn);
+    }
+    return new ListColumns(xParent, xContext, xModel, rTable, makeListItems(std::move(aItems), std::move(aNames)));
+}
+
+uno::Reference<excel::XListRows> makeListRows(const uno::Reference<XHelperInterface>& xParent, const uno::Reference<uno::XComponentContext>& xContext,
+                                              const uno::Reference<frame::XModel>& xModel, const OUString& rTable)
+{
+    ScVbaListTable aTable(xModel, rTable);
+    std::vector<uno::Any> aItems;
+    for (sal_Int32 i = 0; i <= aTable.lastDataRow() - aTable.firstDataRow(); ++i)
+        aItems.emplace_back(uno::Reference<excel::XListRow>(new ListRow(xParent, xContext, xModel, rTable, i)));
+    return new ListRows(xParent, xContext, xModel, rTable, makeListItems(std::move(aItems), {}));
+}
