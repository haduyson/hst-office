+using namespace ::ooo::vba;
+using namespace ::com::sun::star;
+
+namespace
+{
+bool isTableName(const OUString& rName) { return !rName.startsWith("__Anonymous_Sheet_DB__"); }
+}
+
+ScVbaListObject::ScVbaListObject(const uno::Reference<XHelperInterface>& xParent, const uno::Reference<uno::XComponentContext>& xContext,
+                                 const uno::Reference<frame::XModel>& xModel, const OUString& rName)
+    : ScVbaListObject_BASE(xParent, xContext)
+    , ScVbaListTable(xModel, rName)
+{
+}
+
+uno::Reference<excel::XRange> SAL_CALL ScVbaListObject::getRange()
+{
+    const table::CellRangeAddress a = area();
+    return makeRange(this, mxContext, a.StartColumn, a.StartRow, a.EndColumn, a.EndRow);
+}
+
+uno::Reference<excel::XRange> SAL_CALL ScVbaListObject::getDataBodyRange()
+{
+    const table::CellRangeAddress a = area();
+    if (firstDataRow() > lastDataRow())
+        return {}; // Nothing, as in Excel for a table without rows
+    return makeRange(this, mxContext, a.StartColumn, firstDataRow(), a.EndColumn, lastDataRow());
+}
+
+uno::Reference<excel::XRange> SAL_CALL ScVbaListObject::getHeaderRowRange()
+{
+    const table::CellRangeAddress a = area();
+    return hasHeaders() ? makeRange(this, mxContext, a.StartColumn, a.StartRow, a.EndColumn, a.StartRow) : uno::Reference<excel::XRange>();
+}
+
+uno::Reference<excel::XRange> SAL_CALL ScVbaListObject::getTotalsRowRange()
+{
+    const table::CellRangeAddress a = area();
+    return hasTotals() ? makeRange(this, mxContext, a.StartColumn, a.EndRow, a.EndColumn, a.EndRow) : uno::Reference<excel::XRange>();
+}
+
+uno::Any SAL_CALL ScVbaListObject::ListColumns(const uno::Any& rIndex)
+{
+    uno::Reference<excel::XListColumns> xColumns = makeListColumns(this, mxContext, mxModel, name());
+    return rIndex.hasValue() ? xColumns->Item(rIndex, uno::Any()) : uno::Any(xColumns);
+}
+
+uno::Any SAL_CALL ScVbaListObject::ListRows(const uno::Any& rIndex)
+{
+    uno::Reference<excel::XListRows> xRows = makeListRows(this, mxContext, mxModel, name());
+    return rIndex.hasValue() ? xRows->Item(rIndex, uno::Any()) : uno::Any(xRows);
+}
+
+void SAL_CALL ScVbaListObject::Resize(const uno::Reference<excel::XRange>& xRange)
+{
+    uno::Reference<sheet::XCellRangeAddressable> xAddress(dynamic_cast<ScVbaRange&>(*xRange).getCellRange(), uno::UNO_QUERY_THROW);
+    setArea(xAddress->getRangeAddress());
+}
+
+void SAL_CALL ScVbaListObject::Unlist() { remove(); }
+
+void SAL_CALL ScVbaListObject::Delete()
+{
+    const table::CellRangeAddress a = area();
+    remove();
+    removeCells(a, true);
+}
+
+ScVbaListObjects::ScVbaListObjects(const uno::Reference<XHelperInterface>& xParent, const uno::Reference<uno::XComponentContext>& xContext,
+                                   const uno::Reference<frame::XModel>& xModel, sal_Int32 nSheet)
+    : ScVbaListObjects_BASE(xParent, xContext, [&]() {
+        std::vector<uno::Any> aItems;
+        std::vector<OUString> aNames;
+        uno::Reference<container::XNameAccess> xRanges(ScVbaListTable::databaseRanges(xModel), uno::UNO_QUERY_THROW);
+        for (const OUString& rName : xRanges->getElementNames())
+        {
+            uno::Reference<sheet::XDatabaseRange> xRange(xRanges->getByName(rName), uno::UNO_QUERY_THROW);
+            if (isTableName(rName) && xRange->getDataArea().Sheet == nSheet)
+            {
+                aItems.emplace_back(uno::Reference<excel::XListObject>(new ScVbaListObject(xParent, xContext, xModel, rName)));
+                aNames.push_back(rName);
+            }
+        }
+        return makeListItems(std::move(aItems), std::move(aNames));
+    }())
+    , mxModel(xModel)
+    , mnSheet(nSheet)
+{
+}
+
+uno::Reference<container::XEnumeration> SAL_CALL ScVbaListObjects::createEnumeration()
+{
+    return new SimpleIndexAccessToEnumeration(m_xIndexAccess);
+}
+
+uno::Reference<excel::XListObject> SAL_CALL ScVbaListObjects::Add(const uno::Any&, const uno::Any& rSource, const uno::Any&, const uno::Any& rHasHeaders, const uno::Any&, const uno::Any& rStyle)
+{
+    uno::Reference<excel::XRange> xSource;
+    rSource >>= xSource;
+    if (!xSource.is())
+        throw uno::RuntimeException(u"ListObjects.Add: Source needs a Range"_ustr);
+    uno::Reference<sheet::XCellRangeAddressable> xAddress(dynamic_cast<ScVbaRange&>(*xSource).getCellRange(), uno::UNO_QUERY_THROW);
+    uno::Reference<sheet::XDatabaseRanges> xRanges = ScVbaListTable::databaseRanges(mxModel);
+    OUString aName;
+    for (sal_Int32 n = 1; aName.isEmpty(); ++n)
+        if (!xRanges->hasByName("Table" + OUString::number(n)))
+            aName = "Table" + OUString::number(n);
+    xRanges->addNewByName(aName, xAddress->getRangeAddress());
+    sal_Int32 nHeaders = 1; // xlYes
+    rHasHeaders >>= nHeaders;
+    uno::Reference<beans::XPropertySet> xProps(uno::Reference<container::XNameAccess>(xRanges, uno::UNO_QUERY_THROW)->getByName(aName), uno::UNO_QUERY_THROW);
+    xProps->setPropertyValue(u"ContainsHeader"_ustr, uno::Any(nHeaders != 2)); // xlNo = 2
+    uno::Reference<excel::XListObject> xObject(new ScVbaListObject(mxParent, mxContext, mxModel, aName));
+    if (rStyle.hasValue())
+        xObject->setTableStyle(rStyle);
+    return xObject;
+}
