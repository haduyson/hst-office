+class ListItems final : public cppu::WeakImplHelper<container::XIndexAccess, container::XNameAccess>
+{
+    std::vector<uno::Any> maItems;
+    std::vector<OUString> maNames;
+
+public:
+    ListItems(std::vector<uno::Any>&& rItems, std::vector<OUString>&& rNames)
+        : maItems(std::move(rItems))
+        , maNames(std::move(rNames))
+    {
+    }
+    sal_Int32 SAL_CALL getCount() override { return static_cast<sal_Int32>(maItems.size()); }
+    uno::Any SAL_CALL getByIndex(sal_Int32 nIndex) override
+    {
+        if (nIndex < 0 || o3tl::make_unsigned(nIndex) >= maItems.size())
+            throw lang::IndexOutOfBoundsException();
+        return maItems[nIndex];
+    }
+    uno::Type SAL_CALL getElementType() override { return cppu::UnoType<uno::XInterface>::get(); }
+    sal_Bool SAL_CALL hasElements() override { return !maItems.empty(); }
+    uno::Any SAL_CALL getByName(const OUString& rName) override
+    {
+        for (size_t i = 0; i < maNames.size(); ++i)
+            if (maNames[i].equalsIgnoreAsciiCase(rName))
+                return maItems[i];
+        throw container::NoSuchElementException();
+    }
+    uno::Sequence<OUString> SAL_CALL getElementNames() override { return comphelper::containerToSequence(maNames); }
+    sal_Bool SAL_CALL hasByName(const OUString& rName) override
+    {
+        return std::any_of(maNames.begin(), maNames.end(), [&rName](const OUString& r) { return r.equalsIgnoreAsciiCase(rName); });
+    }
+};
+
+uno::Reference<table::XCellRange> sheetCells(const uno::Reference<frame::XModel>& xModel, sal_Int32 nSheet)
+{
+    uno::Reference<sheet::XSpreadsheetDocument> xDoc(xModel, uno::UNO_QUERY_THROW);
+    uno::Reference<container::XIndexAccess> xSheets(xDoc->getSheets(), uno::UNO_QUERY_THROW);
+    return uno::Reference<table::XCellRange>(xSheets->getByIndex(nSheet), uno::UNO_QUERY_THROW);
+}
+}
+
+uno::Reference<sheet::XDatabaseRanges> ScVbaListTable::databaseRanges(const uno::Reference<frame::XModel>& xModel)
+{
+    uno::Reference<beans::XPropertySet> xProps(xModel, uno::UNO_QUERY_THROW);
+    return uno::Reference<sheet::XDatabaseRanges>(xProps->getPropertyValue(u"DatabaseRanges"_ustr), uno::UNO_QUERY_THROW);
+}
+
+uno::Reference<sheet::XDatabaseRange> ScVbaListTable::dbRange() const
+{
+    uno::Reference<container::XNameAccess> xNames(databaseRanges(mxModel), uno::UNO_QUERY_THROW);
+    return uno::Reference<sheet::XDatabaseRange>(xNames->getByName(maName), uno::UNO_QUERY_THROW);
+}
+
+table::CellRangeAddress ScVbaListTable::area() const { return dbRange()->getDataArea(); }
+
+bool ScVbaListTable::hasHeaders() const
+{
+    uno::Reference<beans::XPropertySet> xProps(dbRange(), uno::UNO_QUERY_THROW);
+    bool bValue = true;
+    xProps->getPropertyValue(u"ContainsHeader"_ustr) >>= bValue;
+    return bValue;
+}
+
+bool ScVbaListTable::hasTotals() const
+{
+    uno::Reference<beans::XPropertySet> xProps(dbRange(), uno::UNO_QUERY_THROW);
+    bool bValue = false;
+    xProps->getPropertyValue(u"TotalsRow"_ustr) >>= bValue;
+    return bValue;
+}
+
+sal_Int32 ScVbaListTable::firstDataRow() const { return area().StartRow + (hasHeaders() ? 1 : 0); }
+sal_Int32 ScVbaListTable::lastDataRow() const { return area().EndRow - (hasTotals() ? 1 : 0); }
+
+uno::Reference<excel::XRange> ScVbaListTable::makeRange(const uno::Reference<XHelperInterface>& xParent, const uno::Reference<uno::XComponentContext>& xContext,
+                                                        sal_Int32 nCol1, sal_Int32 nRow1, sal_Int32 nCol2, sal_Int32 nRow2) const
+{
+    uno::Reference<table::XCellRange> xCells = sheetCells(mxModel, area().Sheet)->getCellRangeByPosition(nCol1, nRow1, nCol2, nRow2);
+    return new ScVbaRange(xParent, xContext, xCells);
+}
+
+void ScVbaListTable::setArea(const table::CellRangeAddress& rArea) { dbRange()->setDataArea(rArea); }
+
+void ScVbaListTable::insertCells(const table::CellRangeAddress& rCells, bool bDown)
+{
+    uno::Reference<sheet::XCellRangeMovement> xMove(sheetCells(mxModel, rCells.Sheet), uno::UNO_QUERY_THROW);
+    xMove->insertCells(rCells, bDown ? sheet::CellInsertMode_DOWN : sheet::CellInsertMode_RIGHT);
+}
+
+void ScVbaListTable::removeCells(const table::CellRangeAddress& rCells, bool bUp)
+{
+    uno::Reference<sheet::XCellRangeMovement> xMove(sheetCells(mxModel, rCells.Sheet), uno::UNO_QUERY_THROW);
+    xMove->removeRange(rCells, bUp ? sheet::CellDeleteMode_UP : sheet::CellDeleteMode_LEFT);
+}
+
+void ScVbaListTable::setName(const OUString& rName)
+{
+    uno::Reference<container::XNamed> xNamed(dbRange(), uno::UNO_QUERY_THROW);
+    xNamed->setName(rName);
+    maName = rName;
+}
+
+void ScVbaListTable::remove() { databaseRanges(mxModel)->removeByName(maName); }
+
+uno::Reference<container::XIndexAccess> makeListItems(std::vector<uno::Any>&& rItems, std::vector<OUString>&& rNames)
+{
+    return new ListItems(std::move(rItems), std::move(rNames));
+}
