+/// What table columns and rows share: the table's cells, by address.
+class ScVbaListTable
+{
+protected:
+    css::uno::Reference<css::frame::XModel> mxModel;
+    OUString maName;
+    css::uno::Reference<css::sheet::XDatabaseRange> dbRange() const;
+
+public:
+    static css::uno::Reference<css::sheet::XDatabaseRanges> databaseRanges(const css::uno::Reference<css::frame::XModel>& xModel);
+    ScVbaListTable(css::uno::Reference<css::frame::XModel> xModel, OUString aName)
+        : mxModel(std::move(xModel))
+        , maName(std::move(aName))
+    {
+    }
+    css::table::CellRangeAddress area() const;
+    bool hasHeaders() const;
+    bool hasTotals() const;
+    /// first and last data row; first > last when the table has no data
+    sal_Int32 firstDataRow() const;
+    sal_Int32 lastDataRow() const;
+    css::uno::Reference<ov::excel::XRange> makeRange(const css::uno::Reference<ov::XHelperInterface>& xParent,
+                                                     const css::uno::Reference<css::uno::XComponentContext>& xContext,
+                                                     sal_Int32 nCol1, sal_Int32 nRow1, sal_Int32 nCol2, sal_Int32 nRow2) const;
+    void setArea(const css::table::CellRangeAddress& rArea);
+    void insertCells(const css::table::CellRangeAddress& rCells, bool bDown);
+    void removeCells(const css::table::CellRangeAddress& rCells, bool bUp);
+    const OUString& name() const { return maName; }
+    void setName(const OUString& rName);
+    void remove();
+};
