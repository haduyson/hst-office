+uno::Any SAL_CALL
+ScVbaWorksheet::ListObjects( const uno::Any& aIndex )
+{
+    uno::Reference< sheet::XCellRangeAddressable > xAddress( getSheet(), uno::UNO_QUERY_THROW );
+    uno::Reference< XCollection > xList( new ScVbaListObjects( this, mxContext, mxModel, xAddress->getRangeAddress().Sheet ) );
