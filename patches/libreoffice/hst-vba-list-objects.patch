+    css::uno::Any SAL_CALL getTableStyle() override { return maStyle; }
+    void SAL_CALL setTableStyle(const css::uno::Any& rStyle) override { maStyle = rStyle; }
+    sal_Bool SAL_CALL getShowHeaders() override { return hasHeaders(); }
+    sal_Bool SAL_CALL getShowTotals() override { return hasTotals(); }
+    css::uno::Reference<ov::excel::XRange> SAL_CALL getRange() override;
+    css::uno::Reference<ov::excel::XRange> SAL_CALL getDataBodyRange() override;
+    css::uno::Reference<ov::excel::XRange> SAL_CALL getHeaderRowRange() override;
+    css::uno::Reference<ov::excel::XRange> SAL_CALL getTotalsRowRange() override;
+    css::uno::Any SAL_CALL ListColumns(const css::uno::Any& rIndex) override;
+    css::uno::Any SAL_CALL ListRows(const css::uno::Any& rIndex) override;
+    void SAL_CALL Resize(const css::uno::Reference<ov::excel::XRange>& xRange) override;
+    void SAL_CALL Unlist() override;
