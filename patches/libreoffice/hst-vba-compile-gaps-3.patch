+void SbiParser::ReDimMember( bool bPreserve )
+{
+    aGen.Gen( SbiOpcode::ARGC_ );
+    // the object: the With block's, or a variable, then each member but the last
+    std::vector<OUString> aNames;
+    if( Peek() == DOT )
+    {
+        if( SbiExprNode* pWith = GetWithVar() )
+            pWith->Gen( aGen );
+        else
+            Error( ERRCODE_BASIC_UNEXPECTED, DOT );
+    }
+    else
+    {
+        Next();
+        SbiSymDef* pBase = pPool->Find( aSym );
+        if( !pBase )
+            pBase = aGlobals.Find( aSym );
+        if( !pBase )
+            pBase = pPool->AddSym( aSym );
+        SbiExpression aBase( this, *pBase );
+        aBase.Gen();
+    }
+    while( Peek() == DOT )
+    {
+        Next();
+        Next();
+        aNames.push_back( aSym );
+    }
+    for( size_t i = 0; i + 1 < aNames.size(); ++i )
+        aGen.Gen( SbiOpcode::ELEM_, aGblStrings.Add( aNames[i] ), SbxVARIANT );
+    aGen.Gen( SbiOpcode::ARGV_ );
+    aGen.Gen( SbiOpcode::SCONST_, aGblStrings.Add( aNames.empty() ? OUString() : aNames.back() ) );
+    aGen.Gen( SbiOpcode::ARGV_ );
+    SbiExpression aPreserve( this, bPreserve ? 1.0 : 0.0, SbxINTEGER );
+    aPreserve.Gen();
+    aGen.Gen( SbiOpcode::ARGV_ );
+    TestToken( LPAREN );
+    for( ;; )
+    {
+        SbiExpression aFirst( this );
+        if( Peek() == TO )
+        {
+            Next();
+            aFirst.Gen();
+            aGen.Gen( SbiOpcode::ARGV_ );
+            SbiExpression aSecond( this );
+            aSecond.Gen();
+        }
+        else
+        {
+            SbiExpression aBaseValue( this, static_cast<double>( nBase ), SbxLONG );
+            aBaseValue.Gen();
+            aGen.Gen( SbiOpcode::ARGV_ );
+            aFirst.Gen();
+        }
+        aGen.Gen( SbiOpcode::ARGV_ );
+        if( Peek() != COMMA )
+            break;
+        Next();
+    }
+    TestToken( RPAREN );
+    aGen.Gen( SbiOpcode::RTL_, aGblStrings.Add( u"HstReDimMember"_ustr ) | 0x8000, SbxVARIANT );
+    aGen.Gen( SbiOpcode::GET_ );
+    TestEoln();
+}
