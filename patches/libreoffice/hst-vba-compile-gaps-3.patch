+// HST: ReDim [Preserve] object.member(bounds): the parser passes the object, the member's name,
+// whether to preserve, and the bounds in pairs
+void SbRtl_HstReDimMember(StarBASIC*, SbxArray& rPar, bool)
+{
+    const sal_uInt32 nCount = rPar.Count();
+    if (nCount < 6 || (nCount & 1))
+        return StarBASIC::Error(ERRCODE_BASIC_BAD_ARGUMENT);
+    SbxObject* pObject = dynamic_cast<SbxObject*>(rPar.Get(1)->GetObject());
+    SbxVariable* pMember = pObject ? pObject->Find(rPar.Get(2)->GetOUString(), SbxClassType::DontCare) : nullptr;
+    if (!pMember)
+        return StarBASIC::Error(ERRCODE_BASIC_NO_METHOD, rPar.Get(2)->GetOUString());
+    SbxArrayRef xOld;
+    if (rPar.Get(3)->GetBool())
+        xOld = dynamic_cast<SbxDimArray*>(pMember->GetObject());
+    const SbxDataType eType = static_cast<SbxDataType>(pMember->GetType() & 0x0FFF);
+    SbxDimArray* pArray = new SbxDimArray(eType == SbxEMPTY ? SbxVARIANT : eType);
+    for (sal_uInt32 i = 4; i + 1 < nCount; i += 2)
+    {
+        const sal_Int32 nLower = rPar.Get(i)->GetLong(), nUpper = rPar.Get(i + 1)->GetLong();
+        if (nUpper < nLower)
+            return StarBASIC::Error(ERRCODE_BASIC_OUT_OF_RANGE);
+        pArray->AddDim(nLower, nUpper);
+    }
+    if (xOld.is())
+        implRestorePreservedArray(pArray, xOld);
+    pMember->SetFlag(SbxFlagBits::Write);
+    pMember->PutObject(pArray);
+}
