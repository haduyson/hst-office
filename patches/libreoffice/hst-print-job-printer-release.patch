@@ -0,0 +1,41 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ * This file is part of HST Office.
+ */
+
+#pragma once
+
+#include <vcl/dllapi.h>
+#include <vcl/print.hxx>
+#include <vcl/vclptr.hxx>
+
+namespace vcl::hst
+{
+/** The printer a print job made for itself, disposed when the job lets it go.
+
+    A print job (vcl::PrinterController) makes its own printer when none was given: Printer::PreparePrintJob for
+    the default printer, the printer box of the print dialog (and of the Print page's panel) for each printer
+    chosen. Nothing else owns that printer, but vcl's list of printers holds every printer until it is disposed,
+    so each one stayed alive with its own font list (the font files mapped again: about 20 MB per job). A printer
+    the job was given by its creator (the document's printer of the old print API) stays the creator's.
+
+    Take() hands the job's new printer over: the one it made before is disposed. Release() (and the destructor)
+    disposes the last one. */
+class VCL_DLLPUBLIC JobPrinter
+{
+public:
+    JobPrinter() = default;
+    JobPrinter(const JobPrinter&) = delete;
+    JobPrinter& operator=(const JobPrinter&) = delete;
+    ~JobPrinter();
+
+    void Take(const VclPtr<Printer>& rPrinter);
+    void Release();
+
+private:
+    VclPtr<Printer> m_xPrinter;
+};
+}
+
+/* vim:set shiftwidth=4 softtabstop=4 expandtab: */
--- /dev/null
+++ b/vcl/source/gdi/hstjobprinter.cxx
@@ -0,0 +1,30 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ * This file is part of HST Office.
+ */
+
+#include <hstjobprinter.hxx>
+
+namespace vcl::hst
+{
+JobPrinter::~JobPrinter() { Release(); }
+
+void JobPrinter::Take(const VclPtr<Printer>& rPrinter)
+{
+    if (rPrinter == m_xPrinter)
+        return;
+    Release();
+    m_xPrinter = rPrinter;
+}
+
+void JobPrinter::Release()
+{
+    // others may still hold it (a font cache, the document's render device): they keep an empty printer
+    if (m_xPrinter && !m_xPrinter->isDisposed())
+        m_xPrinter.disposeAndClear();
+    m_xPrinter.clear();
+}
+}
+
