+/** HST Office: the search box for assistive technology: a push button (role and name from the
+    window) whose one action, "press", opens the feature search, as a click does. The tab control's
+    accessible lists it after the page tabs (vclxaccessibletabcontrol.cxx). */
+class HstTabSearchAccessible final
+    : public cppu::ImplInheritanceHelper<VCLXAccessibleComponent, css::accessibility::XAccessibleAction>
+{
+public:
+    explicit HstTabSearchAccessible(HstTabSearchBox* pBox)
+        : ImplInheritanceHelper(pBox)
+    {
+    }
+
+    // XAccessibleAction
+    sal_Int32 SAL_CALL getAccessibleActionCount() override { return 1; }
+
+    sal_Bool SAL_CALL doAccessibleAction(sal_Int32 nIndex) override
+    {
+        SolarMutexGuard aGuard;
+        if (nIndex != 0)
+            throw css::lang::IndexOutOfBoundsException();
+        HstTabSearchBox* pBox = dynamic_cast<HstTabSearchBox*>(GetWindow());
+        if (!pBox || pBox->isDisposed())
+            return false;
+        pBox->OpenSearch(OUString());
+        return true;
+    }
+
+    OUString SAL_CALL getAccessibleActionDescription(sal_Int32 nIndex) override
+    {
+        if (nIndex != 0)
+            throw css::lang::IndexOutOfBoundsException();
+        return RID_STR_ACC_ACTION_CLICK;
+    }
+
+    css::uno::Reference<css::accessibility::XAccessibleKeyBinding>
+        SAL_CALL getAccessibleActionKeyBinding(sal_Int32 nIndex) override
+    {
+        if (nIndex != 0)
+            throw css::lang::IndexOutOfBoundsException();
+        return {}; // Alt+Q is an accelerator of the frame, not of the box
+    }
+};
+
+rtl::Reference<comphelper::OAccessible> HstTabSearchBox::CreateAccessible()
+{
+    return new HstTabSearchAccessible(this);
+}
 using namespace css::ui;
 using namespace css::frame;
 
