                 mnTransitionSubType = TransitionSubType::FADEOVERCOLOR;
             }
-            SAL_WARN("oox.ppt", "OOX: cut transition fallback." );
+            else
+            {
+                // A plain cut changes the slide instantly, like no effect. The zero duration marks it, so that
+                // the PPTX export writes it back as a cut instead of dropping it.
+                mfTransitionDurationInSeconds = 0.0;
+            }
             break;
         case PPT_TOKEN( fade ):
             mnTransitionType = TransitionType::FADE;
