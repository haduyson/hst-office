+CPPUNIT_TEST_FIXTURE(DocumentTabCoatTest, testAppMarksReachThreeToOne)
+{
+    constexpr Color aExpected[] = { Color(0x46, 0x6F, 0xE3), Color(0x1E, 0x8E, 0x3E),
+                                    Color(0xE8, 0x59, 0x0C), Color(0xA8, 0x6A, 0x00),
+                                    Color(0xE5, 0x48, 0x3F) };
+    for (bool bDark : { false, true })
+    {
+        const auto& rPalette = design::GetPalette(bDark);
+        CPPUNIT_ASSERT_EQUAL(std::size(aExpected), std::size(rPalette.aAppMark));
+        for (std::size_t i = 0; i < std::size(rPalette.aAppMark); ++i)
+        {
+            const Color& rMark = rPalette.aAppMark[i];
+            CPPUNIT_ASSERT_EQUAL(aExpected[i], rMark);
+            CPPUNIT_ASSERT_GREATEREQUAL(3.0, contrastRatio(rMark, rPalette.aFrameSurface));
+            CPPUNIT_ASSERT_GREATEREQUAL(3.0, contrastRatio(rMark, rPalette.aFrameSurfaceRaised));
+        }
+    }
+}
+
+CPPUNIT_TEST_FIXTURE(DocumentTabCoatTest, testAppMarkColorMapping)
+{
+    using design::AppMark;
+    struct Mapping
+    {
+        std::u16string_view aModule;
+        AppMark eMark;
+    };
+    constexpr Mapping aCases[] = {
+        { u"com.sun.star.text.TextDocument", AppMark::Writer },
+        { u"com.sun.star.text.WebDocument", AppMark::Writer },
+        { u"com.sun.star.text.GlobalDocument", AppMark::Writer },
+        { u"com.sun.star.sdb.OfficeDatabaseDocument", AppMark::Writer },
+        { u"com.sun.star.sdb.FormDesign", AppMark::Writer },
+        { u"com.sun.star.xforms.XMLFormDocument", AppMark::Writer },
+        { u"com.sun.star.sheet.SpreadsheetDocument", AppMark::Sheets },
+        { u"com.sun.star.presentation.PresentationDocument", AppMark::Slides },
+        { u"com.sun.star.drawing.DrawingDocument", AppMark::Draw },
+    };
+    for (bool bDark : { false, true })
+    {
+        const auto& rPalette = design::GetPalette(bDark);
+        const Color aPdf = rPalette.aAppMark[static_cast<int>(AppMark::Pdf)];
+        for (const auto& rCase : aCases)
+        {
+            CPPUNIT_ASSERT_EQUAL(rPalette.aAppMark[static_cast<int>(rCase.eMark)],
+                                 tabs::AppMarkColor(rCase.aModule, false, rPalette));
+            CPPUNIT_ASSERT_EQUAL(aPdf, tabs::AppMarkColor(rCase.aModule, true, rPalette));
+        }
+        CPPUNIT_ASSERT_EQUAL(aPdf, tabs::AppMarkColor(u"", true, rPalette));
+        CPPUNIT_ASSERT_EQUAL(rPalette.aMuted,
+                             tabs::AppMarkColor(u"org.example.UnknownDocument", false, rPalette));
+    }
+}
+
+CPPUNIT_TEST_FIXTURE(DocumentTabCoatTest, testStripPixels)
+{
+    for (bool bDark : { false, true })
+        for (double fScale : { 1.0, 1.25 })
+        {
+            const auto& rPalette = design::GetPalette(bDark);
+            const auto aStrip = makeStrip(rPalette, fScale);
+            auto pDevice = renderStrip(aStrip, bDark);
+            const tools::Long nBodyY = aStrip.aSize.Height() / 2;
+            const tools::Long nBottom = aStrip.aSize.Height() - 1;
+            const tools::Long nActiveX = aStrip.aTabs[0].aRect.Center().X();
+            const tools::Long nHoverX = aStrip.aTabs[1].aRect.Center().X();
+            const tools::Long nPlainX = aStrip.aTabs[2].aRect.Center().X();
+            CPPUNIT_ASSERT_EQUAL_MESSAGE("strip beyond the plus button", rPalette.aFrameSurface,
+                                         pDevice->GetPixel(Point(aStrip.aSize.Width() - 10, nBodyY)));
+            CPPUNIT_ASSERT_EQUAL_MESSAGE("active body", rPalette.aFrameSurfaceRaised,
+                                         pDevice->GetPixel(Point(nActiveX, nBodyY)));
+            CPPUNIT_ASSERT_EQUAL_MESSAGE("active identity bar", aStrip.aTabs[0].aMark,
+                                         pDevice->GetPixel(Point(nActiveX, px(4, fScale) + 1)));
+            CPPUNIT_ASSERT_EQUAL_MESSAGE("hovered body", rPalette.aHover,
+                                         pDevice->GetPixel(Point(nHoverX, nBodyY)));
+            CPPUNIT_ASSERT_EQUAL_MESSAGE("plain body", rPalette.aFrameSurface,
+                                         pDevice->GetPixel(Point(nPlainX, nBodyY)));
+            for (const tabs::CoatTab& rTab : aStrip.aTabs)
+            {
+                const tools::Long nDotX = rTab.aRect.Left() + px(10, fScale) + px(8, fScale) / 2;
+                const Point aDot(nDotX, rTab.aCloseRect.Center().Y());
+                CPPUNIT_ASSERT_EQUAL_MESSAGE("app dot", rTab.aMark, pDevice->GetPixel(aDot));
+            }
+            CPPUNIT_ASSERT_EQUAL_MESSAGE("bottom edge under inactive tab", rPalette.aFrameDivider,
+                                         pDevice->GetPixel(Point(nPlainX, nBottom)));
+            CPPUNIT_ASSERT_EQUAL_MESSAGE("bottom edge under active tab", rPalette.aFrameSurfaceRaised,
+                                         pDevice->GetPixel(Point(nActiveX, nBottom)));
+        }
+}
