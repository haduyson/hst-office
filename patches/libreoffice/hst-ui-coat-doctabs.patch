     Color aMenuHover; ///< the highlighted menu item
     Color aMenuShortcut; ///< a menu item's shortcut text, readable (4.5:1) on aMenuSurface and aMenuHover
     Color aSelectedIndicator; ///< the bar or pill marking the selected item of a frame part (aAccent)
+    Color aAppMark[5]; ///< per AppMark; 3:1 on aFrameSurface and aFrameSurfaceRaised
     RibbonColors aRibbon;
