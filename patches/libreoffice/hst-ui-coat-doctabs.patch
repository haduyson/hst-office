+class TestStripHost final : public tabs::DocumentTabStripHost
+{
+public:
+    explicit TestStripHost(vcl::Window& rWindow)
+        : m_rWindow(rWindow)
+    {
+        const tabs::CoatStrip aStrip = makeStrip(design::GetPalette(false), 1.0);
+        for (const tabs::CoatTab& rTab : aStrip.aTabs)
+            aTabs.push_back({ rTab.aTitle, false, false, rTab.aRect, rTab.aCloseRect });
+        aTabs[1].bActive = true;
+        aTabs[2].bModified = true;
+        aPlusRect = aStrip.aPlusRect;
+    }
+
+    std::vector<Tab> GetStripTabs() const override { return aTabs; }
+    tools::Rectangle GetStripPlusRect() const override { return aPlusRect; }
+    vcl::Window* GetStripWindow() override { return &m_rWindow; }
+    void ActivateStripTab(sal_Int32) override {}
+    void CloseStripTab(sal_Int32 nIndex) override { nClosedTab = nIndex; }
+    void ShowStripNewMenu() override {}
+
+    std::vector<Tab> aTabs;
+    sal_Int32 nClosedTab = -1;
+
+private:
+    vcl::Window& m_rWindow;
+    tools::Rectangle aPlusRect;
+};
