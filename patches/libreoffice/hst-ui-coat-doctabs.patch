+        pTight->SetFont(aFont);
+        pWide->SetFont(aFont);
+
+        rTab.aRect = tools::Rectangle(Point(), Size(nTabWidth, nHeight));
+        rTab.aCloseRect = tabs::CoatCloseRect(rTab.aRect, nHeight, fScale);
+        tabs::PaintStrip(*pTight, aStrip, rStyle, tabs::CoatGlyphs{});
+        rTab.aRect = tools::Rectangle(Point(), Size(nTabWidth + 200, nHeight));
+        rTab.aCloseRect = tabs::CoatCloseRect(rTab.aRect, nHeight, fScale);
+        tabs::PaintStrip(*pWide, aStrip, rStyle, tabs::CoatGlyphs{});
+
+        const tools::Long nFirstTextRow = px(4, fScale) + px(3, fScale);
+        bool bFoundText = false;
+        for (tools::Long y = nFirstTextRow; y < nHeight; ++y)
+            for (tools::Long x = nTitleLeft; x < nTitleLeft + nTitleWidth; ++x)
+            {
+                const Point aPoint(x, y);
+                const Color aWidePixel = pWide->GetPixel(aPoint);
