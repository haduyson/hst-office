+
+std::vector<hst::doctabs::DocumentTabStripHost::Tab> DocumentTabBar::GetStripTabs() const
+{
+    std::vector<Tab> aTabs;
+    aTabs.reserve(m_aTabs.size());
+    for (const TabLayout& rTab : m_aTabs)
+        aTabs.push_back({ rTab.aInfo.aTitle, rTab.aInfo.bActive, rTab.aInfo.bModified, rTab.aRect,
+                          rTab.aCloseRect });
+    return aTabs;
+}
