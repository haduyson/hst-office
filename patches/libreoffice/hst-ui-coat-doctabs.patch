+            const auto& rPalette = design::GetPalette(bDark);
+            for (const bool bActive : { true, false })
+            {
+                auto aStrip = makeStrip(rPalette, fScale);
+                aStrip.aTabs[1].bHover = false;
+                auto& rTab = aStrip.aTabs[bActive ? 0 : 1];
+                rTab.bHover = true;
