+class DocumentTabItemAccessible final
+    : public cppu::ImplInheritanceHelper<comphelper::OAccessible, XAccessibleAction>
+{
+    using Part = DocumentTabStripAccessible::Part;
+
+public:
+    DocumentTabItemAccessible(DocumentTabStripAccessible& rRoot,
