+        if (!pWindow)
+            return 0;
+        const auto& rStyle = pWindow->GetSettings().GetStyleSettings();
+        if (CoatActive(rStyle))
+        {
+            const auto& rPalette = ::hst::design::GetPalette(rStyle);
+            return sal_Int32(m_ePart == Part::Tab ? rPalette.aText : rPalette.aIcon);
+        }
