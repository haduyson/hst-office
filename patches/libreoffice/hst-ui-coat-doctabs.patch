+Reference<a11y::XAccessibleContext> getChild(const Reference<a11y::XAccessibleContext>& xParent,
+                                            sal_Int64 nIndex)
+{
+    const Reference<a11y::XAccessible> xChild = xParent->getAccessibleChild(nIndex);
+    CPPUNIT_ASSERT(xChild.is());
+    auto xContext = xChild->getAccessibleContext();
+    CPPUNIT_ASSERT(xContext.is());
+    return xContext;
+}
