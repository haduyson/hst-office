+        aBold.SetWeight(WEIGHT_BOLD);
+        pTight->SetFont(aBold);
+        const tools::Long nTitleWidth = pTight->GetTextWidth(rTab.aTitle);
+        const tools::Long nTitleLeft = px(8, fScale) + px(6, fScale) + px(5, fScale);
+        const tools::Long nChromeWidth = tabs::CoatTabChromeWidth(fScale);
