+CPPUNIT_TEST_FIXTURE(DocumentTabCoatTest, testAccessibleTree)
+{
+    ScopedVclPtrInstance<WorkWindow> pWindow(nullptr, WB_STDWORK);
+    pWindow->SetOutputSizePixel(Size(600, 32));
+    pWindow->Show();
+    CPPUNIT_ASSERT(pWindow->IsInputEnabled());
+    TestStripHost aHost(*pWindow);
+    rtl::Reference<tabs::DocumentTabStripAccessible> xStrip
+        = new tabs::DocumentTabStripAccessible(aHost);
+    comphelper::ScopeGuard aDispose([&xStrip] { xStrip->dispose(); });
+    const auto xContext = xStrip->getAccessibleContext();
+    CPPUNIT_ASSERT(xContext.is());
+    CPPUNIT_ASSERT_EQUAL(a11y::AccessibleRole::PAGE_TAB_LIST, xContext->getAccessibleRole());
+    CPPUNIT_ASSERT_EQUAL(FwkResId(STR_DOCTAB_BAR), xContext->getAccessibleName());
+    CPPUNIT_ASSERT_EQUAL(sal_Int64(4), xContext->getAccessibleChildCount());
+
+    constexpr sal_Int64 nCommonStates = a11y::AccessibleStateType::ENABLED
+                                        | a11y::AccessibleStateType::SENSITIVE
+                                        | a11y::AccessibleStateType::VISIBLE
+                                        | a11y::AccessibleStateType::SHOWING;
+    for (sal_Int32 i = 0; i < 3; ++i)
+    {
+        const auto xTab = getChild(xContext, i);
+        CPPUNIT_ASSERT_EQUAL(a11y::AccessibleRole::PAGE_TAB, xTab->getAccessibleRole());
+        CPPUNIT_ASSERT_EQUAL(aHost.aTabs[i].aTitle, xTab->getAccessibleName());
+        CPPUNIT_ASSERT_EQUAL(i == 2 ? FwkResId(STR_DOCTAB_MODIFIED) : OUString(),
+                             xTab->getAccessibleDescription());
+        const sal_Int64 nTabStates = xTab->getAccessibleStateSet();
+        CPPUNIT_ASSERT_EQUAL(nCommonStates, nTabStates & nCommonStates);
+        CPPUNIT_ASSERT(nTabStates & a11y::AccessibleStateType::SELECTABLE);
+        CPPUNIT_ASSERT_EQUAL(i == 1, bool(nTabStates & a11y::AccessibleStateType::SELECTED));
+        CPPUNIT_ASSERT_EQUAL(sal_Int64(1), xTab->getAccessibleChildCount());
+
+        const auto xClose = getChild(xTab, 0);
+        CPPUNIT_ASSERT_EQUAL(a11y::AccessibleRole::PUSH_BUTTON, xClose->getAccessibleRole());
+        CPPUNIT_ASSERT_EQUAL(FwkResId(STR_DOCTAB_CLOSE), xClose->getAccessibleName());
+        const sal_Int64 nButtonStates = xClose->getAccessibleStateSet();
+        CPPUNIT_ASSERT_EQUAL(nCommonStates, nButtonStates & nCommonStates);
+        CPPUNIT_ASSERT(!(nButtonStates & a11y::AccessibleStateType::FOCUSABLE));
+        const Reference<a11y::XAccessibleAction> xAction(xClose, css::uno::UNO_QUERY);
+        CPPUNIT_ASSERT(xAction.is());
+        CPPUNIT_ASSERT_EQUAL(sal_Int32(1), xAction->getAccessibleActionCount());
+        if (i == 2)
+        {
+            CPPUNIT_ASSERT(xAction->doAccessibleAction(0));
+            CPPUNIT_ASSERT_EQUAL(sal_Int32(-1), aHost.nClosedTab);
+            Scheduler::ProcessEventsToIdle();
+            CPPUNIT_ASSERT_EQUAL(sal_Int32(2), aHost.nClosedTab);
+        }
+    }
+
+    const auto xNew = getChild(xContext, 3);
+    CPPUNIT_ASSERT_EQUAL(a11y::AccessibleRole::PUSH_BUTTON, xNew->getAccessibleRole());
+    CPPUNIT_ASSERT_EQUAL(FwkResId(STR_DOCTAB_NEW), xNew->getAccessibleName());
+    aHost.aTabs.pop_back();
+    xStrip->TabsChanged();
+    CPPUNIT_ASSERT_EQUAL(sal_Int64(3), xContext->getAccessibleChildCount());
+    CPPUNIT_ASSERT_EQUAL(FwkResId(STR_DOCTAB_NEW), getChild(xContext, 2)->getAccessibleName());
+}
