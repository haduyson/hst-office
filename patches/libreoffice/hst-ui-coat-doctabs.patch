+
+DocumentTabStripAccessible::DocumentTabStripAccessible(DocumentTabStripHost& rHost)
+    : m_pHost(&rHost)
+    , m_aTabs(rHost.GetStripTabs())
+    , m_aPlusRect(rHost.GetStripPlusRect())
+{
+}
+
+DocumentTabStripAccessible::~DocumentTabStripAccessible() { ensureDisposed(); }
+
+void DocumentTabStripAccessible::TabsChanged(bool bFramesChanged)
+{
+    SolarMutexGuard aGuard;
+    if (!isAlive())
+        return;
+
+    auto aTabs = m_pHost->GetStripTabs();
+    const auto aPlusRect = m_pHost->GetStripPlusRect();
+    const bool bIdentityChanged = bFramesChanged || m_aTabs.size() != aTabs.size();
+    const bool bSameTabs = std::equal(m_aTabs.begin(), m_aTabs.end(), aTabs.begin(), aTabs.end(),
+                                     [](const auto& rOld, const auto& rNew) {
+                                         return rOld.aTitle == rNew.aTitle
+                                                && rOld.bActive == rNew.bActive
+                                                && rOld.bModified == rNew.bModified
+                                                && rOld.aRect == rNew.aRect
+                                                && rOld.aCloseRect == rNew.aCloseRect;
+                                     });
+    if (!bFramesChanged && bSameTabs && m_aPlusRect == aPlusRect)
+        return;
+
+    m_aTabs = std::move(aTabs);
+    m_aPlusRect = aPlusRect;
+    ++m_nRevision;
+    if (bIdentityChanged)
+        CancelActions();
+    // Queries can build children for the new snapshot before the posted event runs.
+    for (auto& xChild : m_aChildren)
+        if (xChild)
+            m_aRetiredChildren.push_back(std::move(xChild));
+    m_aChildren.clear();
+    m_bChildrenChanged = true;
+    PostChanges();
+}
+
+void DocumentTabStripAccessible::BoundsChanged()
+{
+    SolarMutexGuard aGuard;
+    if (!isAlive())
+        return;
+    m_bBoundsChanged = true;
+    PostChanges();
+}
+
+void DocumentTabStripAccessible::StateChanged(sal_Int64 nState)
+{
+    SolarMutexGuard aGuard;
+    if (!isAlive())
+        return;
+    m_nPendingStates |= nState;
+    PostChanges();
+}
+
+void DocumentTabStripAccessible::PostChanges()
+{
+    if (!m_pPendingChanges)
+        m_pPendingChanges
+            = Application::PostUserEvent(LINK(this, DocumentTabStripAccessible, NotifyChanges));
+}
+
+IMPL_LINK_NOARG(DocumentTabStripAccessible, NotifyChanges, void*, void)
+{
+    SolarMutexGuard aGuard;
+    rtl::Reference<DocumentTabStripAccessible> xKeepAlive(this);
+    m_pPendingChanges = nullptr;
+    const bool bChildrenChanged = std::exchange(m_bChildrenChanged, false);
+    const bool bBoundsChanged = std::exchange(m_bBoundsChanged, false);
+    const sal_Int64 nPendingStates = std::exchange(m_nPendingStates, 0);
+
+    DisposeChildren(m_aRetiredChildren);
+    if (bChildrenChanged && isAlive())
+        NotifyAccessibleEvent(AccessibleEventId::INVALIDATE_ALL_CHILDREN, {}, {});
+    if (bBoundsChanged && isAlive())
+        NotifyAccessibleEvent(AccessibleEventId::BOUNDRECT_CHANGED, {}, {});
+    for (sal_Int64 nState : { AccessibleStateType::SHOWING, AccessibleStateType::ENABLED })
+        if ((nPendingStates & nState) && isAlive())
+        {
+            // VCL updates IsReallyVisible() after its visibility hook returns.
+            const uno::Any aState(nState);
+            if (WindowStates(GetWindow()) & nState)
+                NotifyAccessibleEvent(AccessibleEventId::STATE_CHANGED, {}, aState);
+            else
+                NotifyAccessibleEvent(AccessibleEventId::STATE_CHANGED, aState, {});
+        }
+}
+
+void DocumentTabStripAccessible::disposing()
+{
+    SolarMutexGuard aGuard;
+    m_pHost = nullptr;
+    if (m_pPendingChanges)
+        Application::RemoveUserEvent(std::exchange(m_pPendingChanges, nullptr));
+    CancelActions();
+    DisposeChildren(m_aRetiredChildren);
+    DisposeChildren(m_aChildren);
+    m_aTabs.clear();
+    comphelper::OAccessible::disposing();
+}
+
+vcl::Window* DocumentTabStripAccessible::GetWindow() const
+{
+    auto* pWindow = m_pHost ? m_pHost->GetStripWindow() : nullptr;
+    return pWindow && !pWindow->isDisposed() ? pWindow : nullptr;
+}
+
+bool DocumentTabStripAccessible::PostAction(Part ePart, sal_Int32 nTab)
+{
+    if (!CanRunAction(GetWindow()))
+        return false;
+    auto& rAction = m_aActions.emplace_back(Action{ ePart, nTab });
+    rAction.pEvent = Application::PostUserEvent(LINK(this, DocumentTabStripAccessible, RunAction),
+                                               &rAction);
+    if (rAction.pEvent)
+        return true;
+    m_aActions.pop_back();
+    return false;
+}
+
+void DocumentTabStripAccessible::CancelActions()
+{
+    for (const auto& rAction : m_aActions)
+        Application::RemoveUserEvent(rAction.pEvent);
+    m_aActions.clear();
+}
+
+IMPL_LINK(DocumentTabStripAccessible, RunAction, void*, pData, void)
+{
+    SolarMutexGuard aGuard;
+    const auto it = std::find_if(m_aActions.begin(), m_aActions.end(),
+                                 [pData](const auto& rAction) { return &rAction == pData; });
+    if (it == m_aActions.end())
+        return;
+    const Action aAction = *it;
+    // The host may close the window or enter a nested event loop during the call.
+    m_aActions.erase(it);
+    rtl::Reference<DocumentTabStripAccessible> xKeepAlive(this);
+    VclPtr<vcl::Window> xWindow(GetWindow());
+    if (!CanRunAction(xWindow.get()))
+        return;
+    switch (aAction.ePart)
+    {
+        case Part::Tab:
+            m_pHost->ActivateStripTab(aAction.nTab);
+            break;
+        case Part::Close:
+            m_pHost->CloseStripTab(aAction.nTab);
+            break;
+        case Part::Plus:
+            m_pHost->ShowStripNewMenu();
+            break;
+    }
+}
+
+sal_Int64 SAL_CALL DocumentTabStripAccessible::getAccessibleChildCount()
+{
+    SolarMutexGuard aGuard;
+    ensureAlive();
+    return m_aTabs.size() + 1;
+}
+
+uno::Reference<XAccessible> SAL_CALL DocumentTabStripAccessible::getAccessibleChild(sal_Int64 nIndex)
+{
+    SolarMutexGuard aGuard;
+    ensureAlive();
+    if (nIndex < 0 || static_cast<sal_uInt64>(nIndex) > m_aTabs.size())
+        throw lang::IndexOutOfBoundsException();
+    if (m_aChildren.empty())
+        m_aChildren.resize(m_aTabs.size() + 1);
+    auto& xChild = m_aChildren[nIndex];
+    if (!xChild)
+    {
+        const auto ePart = static_cast<sal_uInt64>(nIndex) < m_aTabs.size() ? Part::Tab : Part::Plus;
+        xChild = new DocumentTabItemAccessible(*this, *this, ePart, nIndex);
+    }
+    return xChild.get();
+}
+
+uno::Reference<XAccessible> SAL_CALL DocumentTabStripAccessible::getAccessibleParent()
+{
+    SolarMutexGuard aGuard;
+    auto* pWindow = GetWindow();
+    return pWindow ? pWindow->GetAccessibleParent().get() : nullptr;
+}
+
+sal_Int16 SAL_CALL DocumentTabStripAccessible::getAccessibleRole()
+{
+    return AccessibleRole::PAGE_TAB_LIST;
+}
+
+OUString SAL_CALL DocumentTabStripAccessible::getAccessibleDescription() { return {}; }
+
+OUString SAL_CALL DocumentTabStripAccessible::getAccessibleName()
+{
+    return FwkResId(STR_DOCTAB_BAR);
+}
+
+uno::Reference<XAccessibleRelationSet> SAL_CALL DocumentTabStripAccessible::getAccessibleRelationSet()
+{
+    return new utl::AccessibleRelationSetHelper;
+}
+
+sal_Int64 SAL_CALL DocumentTabStripAccessible::getAccessibleStateSet()
+{
+    SolarMutexGuard aGuard;
+    return WindowStates(GetWindow());
+}
+
+uno::Reference<XAccessible> SAL_CALL
+DocumentTabStripAccessible::getAccessibleAtPoint(const awt::Point& rPoint)
+{
+    SolarMutexGuard aGuard;
+    ensureAlive();
+    const Point aPoint(rPoint.X, rPoint.Y);
+    for (std::size_t i = 0; i < m_aTabs.size(); ++i)
+        if (m_aTabs[i].aRect.Contains(aPoint))
+            return getAccessibleChild(i);
+    if (m_aPlusRect.Contains(aPoint))
+        return getAccessibleChild(m_aTabs.size());
+    return {};
+}
+
+awt::Point SAL_CALL DocumentTabStripAccessible::getLocationOnScreen()
+{
+    SolarMutexGuard aGuard;
+    ensureAlive();
+    auto* pWindow = GetWindow();
+    if (!pWindow)
+        return {};
+    const auto aBounds = vcl::unohelper::ConvertToAWTRect(pWindow->GetWindowExtentsAbsolute());
+    return awt::Point(aBounds.X, aBounds.Y);
+}
+
+void SAL_CALL DocumentTabStripAccessible::grabFocus() {}
+
+sal_Int32 SAL_CALL DocumentTabStripAccessible::getForeground()
+{
+    SolarMutexGuard aGuard;
+    auto* pWindow = GetWindow();
+    if (!pWindow)
+        return 0;
+    const auto& rStyle = pWindow->GetSettings().GetStyleSettings();
+    return sal_Int32(CoatActive(rStyle) ? ::hst::design::GetPalette(rStyle).aText
+                                       : rStyle.GetButtonTextColor());
+}
+
+sal_Int32 SAL_CALL DocumentTabStripAccessible::getBackground()
+{
+    SolarMutexGuard aGuard;
+    auto* pWindow = GetWindow();
+    return pWindow ? sal_Int32(pWindow->GetBackgroundColor()) : 0;
+}
+
+awt::Rectangle DocumentTabStripAccessible::implGetBounds()
+{
+    SolarMutexGuard aGuard;
+    auto* pWindow = GetWindow();
+    if (!pWindow)
+        return {};
+
+    auto aBounds = vcl::unohelper::ConvertToAWTRect(pWindow->GetWindowExtentsAbsolute());
+    const uno::Reference<XAccessible> xParent = getAccessibleParent();
+    uno::Reference<XAccessibleComponent> xParentComponent;
+    if (xParent)
+        xParentComponent.set(xParent->getAccessibleContext(), uno::UNO_QUERY);
+    if (xParentComponent)
+    {
+        const auto aParentLocation = xParentComponent->getLocationOnScreen();
+        aBounds.X -= aParentLocation.X;
+        aBounds.Y -= aParentLocation.Y;
+    }
+    return aBounds;
+}
+}
