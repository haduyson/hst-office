+CPPUNIT_TEST_FIXTURE(DocumentTabCoatTest, testAppMarksReachThreeToOne)
+{
+    constexpr Color aExpected[] = { Color(0x46, 0x6F, 0xE3), Color(0x1E, 0x8E, 0x3E),
+                                    Color(0xE8, 0x59, 0x0C), Color(0xA8, 0x6A, 0x00),
+                                    Color(0xE5, 0x48, 0x3F) };
+    for (bool bDark : { false, true })
+    {
+        const auto& rPalette = design::GetPalette(bDark);
+        CPPUNIT_ASSERT_EQUAL(std::size(aExpected), std::size(rPalette.aAppMark));
+        for (std::size_t i = 0; i < std::size(rPalette.aAppMark); ++i)
+        {
+            const Color& rMark = rPalette.aAppMark[i];
+            CPPUNIT_ASSERT_EQUAL(aExpected[i], rMark);
+            CPPUNIT_ASSERT_GREATEREQUAL(3.0, contrastRatio(rMark, rPalette.aFrameSurface));
+            CPPUNIT_ASSERT_GREATEREQUAL(3.0, contrastRatio(rMark, rPalette.aFrameSurfaceRaised));
+        }
+    }
+}
