+            throw lang::IndexOutOfBoundsException();
+        if (!m_xClose)
+            m_xClose = new DocumentTabItemAccessible(*pRoot, *this, Part::Close, m_nTab);
+        return m_xClose.get();
+    }
+
+    uno::Reference<XAccessible> SAL_CALL getAccessibleParent() override
+    {
+        SolarMutexGuard aGuard;
+        return Root() ? m_pParent : nullptr;
+    }
+
+    sal_Int64 SAL_CALL getAccessibleIndexInParent() override
+    {
+        SolarMutexGuard aGuard;
+        if (!Root())
+            return -1;
+        return m_ePart == Part::Close ? 0 : m_nTab;
+    }
+
+    sal_Int16 SAL_CALL getAccessibleRole() override
+    {
+        return m_ePart == Part::Tab ? AccessibleRole::PAGE_TAB : AccessibleRole::PUSH_BUTTON;
+    }
+
+    OUString SAL_CALL getAccessibleDescription() override
+    {
+        SolarMutexGuard aGuard;
+        auto* pRoot = Root();
+        if (pRoot && m_ePart == Part::Tab && pRoot->m_aTabs[m_nTab].bModified)
+            return FwkResId(STR_DOCTAB_MODIFIED);
+        return {};
+    }
+
+    OUString SAL_CALL getAccessibleName() override
+    {
+        SolarMutexGuard aGuard;
+        auto* pRoot = Root();
+        if (!pRoot)
+            return {};
+        if (m_ePart == Part::Tab)
+            return pRoot->m_aTabs[m_nTab].aTitle;
+        return m_ePart == Part::Close ? FwkResId(STR_DOCTAB_CLOSE) : FwkResId(STR_DOCTAB_NEW);
+    }
+
+    uno::Reference<XAccessibleRelationSet> SAL_CALL getAccessibleRelationSet() override
+    {
+        return new utl::AccessibleRelationSetHelper;
+    }
+
+    sal_Int64 SAL_CALL getAccessibleStateSet() override
+    {
+        SolarMutexGuard aGuard;
+        auto* pRoot = Root();
+        const auto* pWindow = pRoot ? pRoot->GetWindow() : nullptr;
+        sal_Int64 nStates = WindowStates(pWindow);
+        if (pWindow && m_ePart == Part::Tab)
+        {
+            nStates |= AccessibleStateType::SELECTABLE;
+            if (pRoot->m_aTabs[m_nTab].bActive)
+                nStates |= AccessibleStateType::SELECTED;
+        }
+        return nStates;
+    }
+
+    uno::Reference<XAccessible> SAL_CALL getAccessibleAtPoint(const awt::Point& rPoint) override
+    {
+        SolarMutexGuard aGuard;
+        ensureAlive();
+        auto* pRoot = Root();
+        if (!pRoot || m_ePart != Part::Tab)
+            return {};
+        const auto& rTab = pRoot->m_aTabs[m_nTab];
+        if (rTab.aCloseRect.Contains(Point(rTab.aRect.Left() + rPoint.X,
