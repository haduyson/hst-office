+
+void DocumentTabBar::ActivateStripTab(sal_Int32 nIndex)
+{
+    if (nIndex >= 0 && static_cast<size_t>(nIndex) < m_aTabs.size())
+    {
+        const auto xFrame = m_aTabs[nIndex].aInfo.xFrame;
+        DocumentTabGroup::get().activate(xFrame);
+    }
+}
+
+void DocumentTabBar::CloseStripTab(sal_Int32 nIndex)
+{
+    if (nIndex >= 0 && static_cast<size_t>(nIndex) < m_aTabs.size())
+    {
+        const auto xFrame = m_aTabs[nIndex].aInfo.xFrame;
+        DocumentTabGroup::get().closeTab(xFrame);
+    }
+}
