+awt::Rectangle RelativeBounds(const tools::Rectangle& rRect, const Point& rOrigin)
+{
+    if (rRect.IsEmpty())
+        return {};
+    return awt::Rectangle(rRect.Left() - rOrigin.X(), rRect.Top() - rOrigin.Y(),
+                          rRect.GetWidth(), rRect.GetHeight());
+}
+
+sal_Int64 WindowStates(const vcl::Window* pWindow)
+{
+    if (!pWindow)
+        return AccessibleStateType::DEFUNC;
+
+    sal_Int64 nStates = 0;
+    if (pWindow->IsEnabled())
+        nStates |= AccessibleStateType::ENABLED;
+    if (pWindow->IsEnabled() && pWindow->IsInputEnabled())
+        nStates |= AccessibleStateType::SENSITIVE;
+    if (pWindow->IsVisible())
+        nStates |= AccessibleStateType::VISIBLE;
+    if (pWindow->IsReallyVisible())
+        nStates |= AccessibleStateType::SHOWING;
+    return nStates;
+}
+
+bool CanRunAction(const vcl::Window* pWindow)
+{
+    return pWindow && pWindow->IsReallyVisible() && pWindow->IsEnabled()
+           && pWindow->IsInputEnabled();
+}
+
+void DisposeChildren(std::vector<rtl::Reference<comphelper::OAccessible>>& rChildren)
+{
+    const auto aChildren = std::exchange(rChildren, {});
+    for (const auto& xChild : aChildren)
+        if (xChild)
+            xChild->dispose();
+}
+}
