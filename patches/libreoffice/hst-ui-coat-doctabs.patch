+                const Point aProbe(rClose.Left() + px(2, fScale), rClose.Center().Y());
+                const char* pMessage = bActive ? "active close hover" : "inactive close hover";
+                CPPUNIT_ASSERT_EQUAL_MESSAGE(pMessage, bActive ? rPalette.aHover : rPalette.aPressed,
+                                             pDevice->GetPixel(aProbe));
+            }
