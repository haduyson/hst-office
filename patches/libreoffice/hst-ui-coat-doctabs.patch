+
+double relativeLuminance(const Color& rColor)
+{
+    const auto linear = [](sal_uInt8 nChannel) {
+        const double fChannel = nChannel / 255.0;
+        if (fChannel <= 0.04045)
+            return fChannel / 12.92;
+        return std::pow((fChannel + 0.055) / 1.055, 2.4);
+    };
+    return 0.2126 * linear(rColor.GetRed()) + 0.7152 * linear(rColor.GetGreen())
+           + 0.0722 * linear(rColor.GetBlue());
+}
+
+double contrastRatio(const Color& rMark, const Color& rSurface)
+{
+    const double fMark = relativeLuminance(rMark);
+    const double fSurface = relativeLuminance(rSurface);
+    return (std::max(fMark, fSurface) + 0.05) / (std::min(fMark, fSurface) + 0.05);
+}
+
+tools::Long px(double fLength, double fScale) { return std::lround(fLength * fScale); }
+
+tabs::CoatStrip makeStrip(const design::Palette& rPalette, double fScale)
+{
+    const tools::Long nHeight = px(32, fScale);
+    const tools::Long nWidth = px(140, fScale);
+    tabs::CoatStrip aStrip;
+    aStrip.aSize = Size(600, nHeight);
+    aStrip.fScale = fScale;
+    const OUString aTitles[] = { u"A"_ustr, u"B"_ustr, u"C"_ustr };
+    for (std::size_t i = 0; i < std::size(aTitles); ++i)
+    {
+        tabs::CoatTab aTab;
+        aTab.aRect = tools::Rectangle(Point(static_cast<tools::Long>(i) * nWidth, 0),
+                                      Size(nWidth, nHeight));
+        aTab.aCloseRect = tabs::CoatCloseRect(aTab.aRect, nHeight, fScale);
+        aTab.aTitle = aTitles[i];
+        aTab.aMark = rPalette.aAppMark[i];
+        aTab.bActive = i == 0;
+        aTab.bHover = i == 1;
+        aStrip.aTabs.push_back(aTab);
+    }
+    const tools::Long nPlusHeight = px(24, fScale);
+    aStrip.aPlusRect = tools::Rectangle(Point(3 * nWidth + 2, (nHeight - nPlusHeight) / 2),
+                                       Size(px(30, fScale) - 4, nPlusHeight));
+    return aStrip;
+}
+
+ScopedVclPtr<VirtualDevice> makeStripDevice(const tabs::CoatStrip& rStrip, bool bDark)
+{
+    ScopedVclPtr<VirtualDevice> pDevice = VclPtr<VirtualDevice>::Create();
+    AllSettings aSettings = pDevice->GetSettings();
+    StyleSettings aStyle = aSettings.GetStyleSettings();
+    aStyle.SetWindowColor(bDark ? Color(0x20, 0x20, 0x20) : COL_WHITE);
+    aStyle.SetHighContrastMode(false);
+    aSettings.SetStyleSettings(aStyle);
+    pDevice->SetSettings(aSettings);
+    pDevice->SetDPIScalePercentage(100 * rStrip.fScale);
+    pDevice->EnableMapMode(false);
+    CPPUNIT_ASSERT(pDevice->SetOutputSizePixel(rStrip.aSize));
+    pDevice->SetBackground(Wallpaper(UNPAINTED));
+    pDevice->Erase();
+    return pDevice;
+}
+
+ScopedVclPtr<VirtualDevice> renderStrip(const tabs::CoatStrip& rStrip, bool bDark)
+{
+    auto pDevice = makeStripDevice(rStrip, bDark);
+    tabs::PaintStrip(*pDevice, rStrip, pDevice->GetSettings().GetStyleSettings(), tabs::CoatGlyphs{});
+    return pDevice;
+}
+
+void assertGlyphCenter(const char* pMessage, const VirtualDevice& rDevice,
+                       const tools::Rectangle& rRect, const Color& rIcon, const Color& rBackground)
+{
+    // With even dimensions, the intersection lies between pixels. Allow a small amount of
+    // anti-aliasing at the nearest centre pixels of the thin strokes.
+    constexpr int nTolerance = 8;
+    const Point aCenter = rRect.Center();
+    const tools::Long nLastX = rRect.Left() + rRect.GetWidth() / 2;
+    const tools::Long nLastY = rRect.Top() + rRect.GetHeight() / 2;
+    bool bFoundInk = false;
+    for (tools::Long y = aCenter.Y(); y <= nLastY; ++y)
+        for (tools::Long x = aCenter.X(); x <= nLastX; ++x)
+        {
+            const Color aPixel = rDevice.GetPixel(Point(x, y));
+            const int nDifference = std::max({ std::abs(aPixel.GetRed() - rIcon.GetRed()),
+                                               std::abs(aPixel.GetGreen() - rIcon.GetGreen()),
+                                               std::abs(aPixel.GetBlue() - rIcon.GetBlue()) });
+            bFoundInk |= aPixel != rBackground && nDifference <= nTolerance;
+        }
+    CPPUNIT_ASSERT_MESSAGE(pMessage, bFoundInk);
+}
