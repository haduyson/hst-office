+class DefaultScopeDialog : public weld::GenericDialogController
+{
+    std::unique_ptr<weld::Label> m_xQuestion;
+    std::unique_ptr<weld::RadioButton> m_xNewDocs;
+
+public:
+    DefaultScopeDialog(weld::Widget* pParent, const OUString& rQuestion)
+        : GenericDialogController(pParent, u"sfx/ui/hstdefaultscopedialog.ui"_ustr,
+                                  u"HstDefaultScopeDialog"_ustr)
+        , m_xQuestion(m_xBuilder->weld_label(u"question"_ustr))
+        , m_xNewDocs(m_xBuilder->weld_radio_button(u"newdocs"_ustr))
+    {
+        m_xQuestion->set_label(rQuestion);
+    }
+
+    bool NewDocuments() const { return m_xNewDocs->get_active(); }
+};
+
+bool Exists(const OUString& rURL)
+{
+    osl::DirectoryItem aItem;
+    return !rURL.isEmpty() && osl::DirectoryItem::get(rURL, aItem) == osl::FileBase::E_None;
+}
+
+// Loads rURL into rDoc without a frame; the module's filter matcher picks the import filter.
+bool LoadInto(SfxObjectShell& rDoc, const SfxObjectFactory& rFactory, const OUString& rURL)
+{
+    auto pMedium = std::make_unique<SfxMedium>(rURL, StreamMode::READ);
+    std::shared_ptr<const SfxFilter> pFilter;
+    SfxFilterMatcher(rFactory.GetFactoryName()).DetectFilter(*pMedium, pFilter);
+    if (!pFilter)
+    {
+        SAL_WARN("sfx.doc", "HST default template: no filter for " << rURL);
+        return false;
+    }
+    pMedium->SetFilter(pFilter);
+    return rDoc.DoLoad(pMedium.release());
+}
+}
+
+DefaultScope AskDefaultScope(weld::Widget* pParent, const OUString& rQuestion)
+{
+    DefaultScopeDialog aDialog(pParent, rQuestion);
+    if (aDialog.run() != RET_OK)
+        return DefaultScope::Cancel;
+    return aDialog.NewDocuments() ? DefaultScope::NewDocuments : DefaultScope::ThisDocument;
+}
+
+void CopyDefaultValues(const SfxItemSet& rValues, std::span<const sal_uInt16> aWhichIds,
+                       SfxItemSet& rDest)
+{
+    for (const sal_uInt16 nWhich : aWhichIds)
+    {
+        const SfxPoolItem* pItem = nullptr;
+        const SfxItemState eState = rValues.GetItemState(nWhich, true, &pItem);
+        if (eState == SfxItemState::DEFAULT && SfxItemPool::IsWhich(nWhich))
+            pItem = &rValues.Get(nWhich);
+        else if (eState != SfxItemState::SET)
+            pItem = nullptr;
+        // a copy: rDest may outlive the pool of rValues (the default template is another document)
+        if (pItem)
+            rDest.Put(std::unique_ptr<SfxPoolItem>(pItem->Clone()));
+    }
+}
+
+OUString DefaultTemplateURL(const SfxObjectFactory& rFactory)
+{
+    std::shared_ptr<const SfxFilter> pFilter = rFactory.GetTemplateFilter();
+    OUString aExtension = pFilter ? pFilter->GetDefaultExtension() : OUString();
+    aExtension = aExtension.copy(aExtension.lastIndexOf('.') + 1); // "*.ott" -> "ott"
+    if (aExtension.isEmpty() || aExtension.indexOf(';') >= 0)
+        return OUString();
+    return SvtPathOptions().SubstituteVariable(u"$(user)"_ustr) + "/hst/default-templates/"
+           + rFactory.GetFactoryName() + "." + aExtension;
+}
+
+bool UpdateDefaultTemplate(const SfxObjectFactory& rFactory,
+                           const std::function<bool(SfxObjectShell&)>& rApply)
+{
+    const OUString aService = rFactory.GetDocumentServiceName();
+    std::shared_ptr<const SfxFilter> pTemplateFilter = rFactory.GetTemplateFilter();
+    const OUString aTarget = DefaultTemplateURL(rFactory);
+    if (!pTemplateFilter || aTarget.isEmpty())
+        return false;
+
+    const osl::FileBase::RC eDir = osl::Directory::createPath(aTarget.copy(0, aTarget.lastIndexOf('/')));
+    if (eDir != osl::FileBase::E_None && eDir != osl::FileBase::E_EXIST)
+    {
+        SAL_WARN("sfx.doc", "HST default template: cannot create the folder of " << aTarget);
+        return false;
+    }
+
+    // the template new documents start from today: the user's choice, our earlier one, or none
+    OUString aSource = comphelper::getExpandedUri(comphelper::getProcessComponentContext(),
+                                                  SfxObjectFactory::GetStandardTemplate(aService));
+    if (!Exists(aSource))
+        aSource.clear();
+
+    const OUString aTemp = aTarget + ".tmp";
+    {
+        SfxObjectShellLock xDoc = SfxObjectShell::CreateObject(aService, SfxObjectCreateMode::INTERNAL);
+        if (!xDoc.Is())
+            return false;
+        const bool bReady = aSource.isEmpty() ? xDoc->DoInitNew() : LoadInto(*xDoc, rFactory, aSource);
+        if (!bReady || !rApply(*xDoc))
+        {
+            SAL_WARN("sfx.doc", "HST default template: cannot prepare " << aTarget);
+            xDoc->DoClose();
+            return false;
+        }
+        try
+        {
+            uno::Reference<frame::XStorable> xStorable(xDoc->GetModel(), uno::UNO_QUERY_THROW);
+            xStorable->storeToURL(aTemp, { comphelper::makePropertyValue(
+                                             u"FilterName"_ustr, pTemplateFilter->GetFilterName()) });
+        }
+        catch (const uno::Exception&)
+        {
+            TOOLS_WARN_EXCEPTION("sfx.doc", "HST default template: cannot save " << aTemp);
+            xDoc->DoClose();
+            osl::File::remove(aTemp);
+            return false;
+        }
+        // close before replacing: the source may be the target itself
+        xDoc->DoClose();
+    }
+
+    if (osl::File::replace(aTemp, aTarget) != osl::FileBase::E_None)
+    {
+        SAL_WARN("sfx.doc", "HST default template: cannot replace " << aTarget);
+        osl::File::remove(aTemp);
+        return false;
+    }
+    if (aSource != aTarget)
+        SfxObjectFactory::SetStandardTemplate(aService, aTarget);
+    return true;
+}
