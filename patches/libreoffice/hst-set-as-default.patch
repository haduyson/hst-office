+};
+
+/// Asks whether the dialog's settings become the default of this document or of all new documents.
+SFX2_DLLPUBLIC DefaultScope AskDefaultScope(weld::Widget* pParent, const OUString& rQuestion);
+
+/// Copies the values of the given which ids from a dialog's settings into rDest: set items and, for real
+/// which ids, the pool default shown in the dialog; mixed (invalid) and unknown ids are left out.
+SFX2_DLLPUBLIC void CopyDefaultValues(const SfxItemSet& rValues, std::span<const sal_uInt16> aWhichIds,
+                                      SfxItemSet& rDest);
+
+/// The per-user default template HST Office manages for a module:
+/// <user profile>/hst/default-templates/<factory>.<template extension>. Never inside the installation.
+SFX2_DLLPUBLIC OUString DefaultTemplateURL(const SfxObjectFactory& rFactory);
+
+/** Makes every new document of the module start with a change.
+
+    The current default template of the module (one the user chose, or the one written earlier) is loaded, or
+    a new empty document when there is none; rApply changes it; it is saved as DefaultTemplateURL() through a
+    temporary file and registered as the module's default template. A template the user chose stays untouched.
+    @return false when the document could not be loaded, changed or saved; nothing is registered then.
+*/
+SFX2_DLLPUBLIC bool UpdateDefaultTemplate(const SfxObjectFactory& rFactory,
+                                          const std::function<bool(SfxObjectShell&)>& rApply);
+}
