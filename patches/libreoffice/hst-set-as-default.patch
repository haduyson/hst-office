+void SfxTabDialogController::HstShowSetDefault(bool bShow, const OUString& rLabel)
+{
+    if (!m_xHstDefaultBtn)
+        return;
+    // a dialog whose pages already use the label's access key passes its own label
+    if (!rLabel.isEmpty())
+        m_xHstDefaultBtn->set_label(rLabel);
+    m_xHstDefaultBtn->set_visible(bShow);
+}
