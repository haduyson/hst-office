+/** "Set As Default": changes this document and, with bNewDocuments, the default template of new Writer
+    documents too. A failure to save the template is reported to the user (pParent); this document stays
+    changed then. */
+SW_DLLPUBLIC void SetAsDefault(weld::Widget* pParent, SwDocShell& rDocShell, DefaultKind eKind,
+                               const SfxItemSet& rValues, bool bNewDocuments);
+}
