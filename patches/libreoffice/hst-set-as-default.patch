+// HST Office "Set As Default": the dialog's settings become the default, then the dialog ends like OK
+IMPL_LINK_NOARG(SfxTabDialogController, HstSetDefaultHdl, weld::Button&, void)
+{
+    if (!m_pSet || !PrepareLeaveCurrentPage())
+        return;
+    // what the dialog shows, without Ok(): some dialogs apply things there (Sheets' print titles)
+    SfxItemSet aValues(m_xExampleSet ? *m_xExampleSet : *m_pSet);
+    if (m_pOutSet)
+        aValues.Put(*m_pOutSet);
+    for (auto const& elem : m_pImpl->aData)
+    {
+        SfxTabPage* pTabPage = elem->xTabPage.get();
+        if (!pTabPage || pTabPage->HasExchangeSupport())
+            continue;
+        SfxItemSet aPage(*m_pSet->GetPool(), m_pSet->GetRanges());
+        if (pTabPage->FillItemSet(&aPage))
+            aValues.Put(aPage);
+    }
+    const OUString aQuestion = HstDefaultQuestion(aValues);
+    if (aQuestion.isEmpty())
+        return;
+    const sfx2::hst::DefaultScope eScope = sfx2::hst::AskDefaultScope(m_xDialog.get(), aQuestion);
+    if (eScope == sfx2::hst::DefaultScope::Cancel)
+        return;
+    if (HstApplyDefault(aValues, eScope == sfx2::hst::DefaultScope::NewDocuments))
+        m_xDialog->response(Ok());
+}
