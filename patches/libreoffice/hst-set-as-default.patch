+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+// HST Office: "Set As Default" in Sheets. The Default cell style (Excel's Normal) and the Default page
+// style take the dialog's values; for all new spreadsheets the same change goes into the default template.
+
+#include <hstsetasdefault.hxx>
+
+#include <docsh.hxx>
+#include <globstr.hrc>
+#include <scitems.hxx>
+#include <scresid.hxx>
+#include <stlpool.hxx>
+#include <undostyl.hxx>
+
+#include <sfx2/hstdefaults.hxx>
+#include <sfx2/sfxresid.hxx>
+#include <sfx2/strings.hrc>
+#include <svl/itemset.hxx>
+#include <vcl/svapp.hxx>
+#include <vcl/vclenum.hxx>
+#include <vcl/weld/MessageDialog.hxx>
+
+namespace sc::hst
+{
+namespace
+{
+// Font (with the effects HST shows on it) and Alignment of Format Cells; not number formats (keys of
+// one document's formatter), borders, fill or protection.
+constexpr sal_uInt16 aCellIds[] = {
+    ATTR_FONT,           ATTR_FONT_HEIGHT,     ATTR_FONT_WEIGHT,       ATTR_FONT_POSTURE,
+    ATTR_FONT_UNDERLINE, ATTR_FONT_OVERLINE,   ATTR_FONT_CROSSEDOUT,   ATTR_FONT_CONTOUR,
+    ATTR_FONT_SHADOWED,  ATTR_FONT_COLOR,      ATTR_FONT_LANGUAGE,     ATTR_CJK_FONT,
+    ATTR_CJK_FONT_HEIGHT, ATTR_CJK_FONT_WEIGHT, ATTR_CJK_FONT_POSTURE, ATTR_CJK_FONT_LANGUAGE,
+    ATTR_CTL_FONT,       ATTR_CTL_FONT_HEIGHT, ATTR_CTL_FONT_WEIGHT,   ATTR_CTL_FONT_POSTURE,
+    ATTR_CTL_FONT_LANGUAGE, ATTR_FONT_EMPHASISMARK, ATTR_FONT_WORDLINE, ATTR_FONT_RELIEF,
+    ATTR_HOR_JUSTIFY,    ATTR_HOR_JUSTIFY_METHOD, ATTR_INDENT,         ATTR_VER_JUSTIFY,
+    ATTR_VER_JUSTIFY_METHOD, ATTR_STACKED,     ATTR_ROTATE_VALUE,      ATTR_ROTATE_MODE,
+    ATTR_VERTICAL_ASIAN, ATTR_WRITINGDIR,      ATTR_LINEBREAK,         ATTR_SHRINKTOFIT,
+    ATTR_HYPHENATE
+};
+
+// Page and Sheet tabs of Page Setup without headers, footers, print ranges or page numbers.
+constexpr sal_uInt16 aPageIds[]
+    = { ATTR_PAGE,         ATTR_PAGE_SIZE,         ATTR_LRSPACE,       ATTR_ULSPACE,
+        ATTR_PAGE_HORCENTER, ATTR_PAGE_VERCENTER,  ATTR_PAGE_SCALE,    ATTR_PAGE_SCALETOPAGES,
+        ATTR_PAGE_SCALETO, ATTR_PAGE_TOPDOWN,      ATTR_PAGE_GRID,     ATTR_PAGE_HEADERS };
+}
+
+OUString DefaultQuestion(DefaultKind eKind)
+{
+    return SfxResId(eKind == DefaultKind::Cells ? STR_HST_DEFAULT_CELL : STR_HST_DEFAULT_PAGE);
+}
+
+void ApplyDefaults(ScDocShell& rDocShell, DefaultKind eKind, const SfxItemSet& rValues, bool bUndo)
+{
+    const SfxStyleFamily eFamily = eKind == DefaultKind::Cells ? SfxStyleFamily::Para : SfxStyleFamily::Page;
+    ScStyleSheetPool* pPool = rDocShell.GetDocument().GetStyleSheetPool();
+    SfxStyleSheetBase* pStyle = pPool ? pPool->Find(ScResId(STR_STYLENAME_STANDARD), eFamily) : nullptr;
+    if (!pStyle)
+        return;
+    const std::span<const sal_uInt16> aIds = eKind == DefaultKind::Cells
+                                                 ? std::span<const sal_uInt16>(aCellIds)
+                                                 : std::span<const sal_uInt16>(aPageIds);
+    SfxItemSet& rStyleSet = pStyle->GetItemSet();
+    if (!bUndo)
+    {
+        // a document without views (the default template): the saved style is all that counts
+        sfx2::hst::CopyDefaultValues(rValues, aIds, rStyleSet);
+        return;
+    }
+
+    // the change runs through the undo action, which also updates row heights, page styles in use and
+    // the display
+    ScStyleSaveData aOld;
+    aOld.InitFromStyle(pStyle);
+    sfx2::hst::CopyDefaultValues(rValues, aIds, rStyleSet);
+    ScStyleSaveData aNew;
+    aNew.InitFromStyle(pStyle);
+    if (aOld.GetItems())
+        rStyleSet.Set(*aOld.GetItems(), false);
+    auto pUndo = std::make_unique<ScUndoModifyStyle>(rDocShell, eFamily, aOld, aNew);
+    pUndo->Redo();
+    rDocShell.GetUndoManager()->AddUndoAction(std::move(pUndo));
+}
+
+void SetAsDefault(weld::Widget* pParent, ScDocShell& rDocShell, DefaultKind eKind,
+                  const SfxItemSet& rValues, bool bNewDocuments)
+{
+    ApplyDefaults(rDocShell, eKind, rValues, true);
+    if (!bNewDocuments)
+        return;
+
+    const bool bSaved = sfx2::hst::UpdateDefaultTemplate(
+        ScDocShell::Factory(), [eKind, &rValues](SfxObjectShell& rTemplate) {
+            auto* pTemplate = dynamic_cast<ScDocShell*>(&rTemplate);
+            if (!pTemplate)
+                return false;
+            ApplyDefaults(*pTemplate, eKind, rValues, false);
+            return true;
+        });
+    if (bSaved)
+        return;
+    std::unique_ptr<weld::MessageDialog> xBox(Application::CreateMessageDialog(
+        pParent, VclMessageType::Warning, VclButtonsType::Ok, SfxResId(STR_HST_DEFAULT_FAILED)));
+    xBox->run();
+}
+}
