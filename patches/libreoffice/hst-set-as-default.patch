+// HST Office: "Set As Default" in Writer. The Default Paragraph Style (Word's Normal) and the Default Page
+// Style take the dialog's values; for all new documents the same change goes into the default template.
+
+#include <hstsetasdefault.hxx>
+
+#include <IDocumentStylePoolAccess.hxx>
