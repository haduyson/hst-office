+// HST Office "Set As Default" in Format Cells: the Default cell style takes the font and alignment
+// (undoably), not the fill; all new spreadsheets start with it through the per-user default template
+CPPUNIT_TEST_FIXTURE(ScHstSetAsDefaultTest, testHstSetAsDefaultCells)
+{
+    const OUString aService = u"com.sun.star.sheet.SpreadsheetDocument"_ustr;
+    comphelper::ScopeGuard aReset([&aService] { SfxObjectFactory::SetStandardTemplate(aService, OUString()); });
+    SfxObjectFactory::SetStandardTemplate(aService, OUString());
+
+    createScDoc();
+    ScDocShell* pDocSh = getScDocShell();
+    ScDocument& rDoc = pDocSh->GetDocument();
+    SfxItemSet aValues(SfxItemSet::makeFixedSfxItemSet<ATTR_PATTERN_START, ATTR_PATTERN_END>(*rDoc.GetPool()));
+    aValues.Put(SvxHorJustifyItem(SvxCellHorJustify::Center, ATTR_HOR_JUSTIFY));
+    aValues.Put(SvxFontHeightItem(280, 100, ATTR_FONT_HEIGHT));
+    aValues.Put(SvxBrushItem(COL_YELLOW, ATTR_BACKGROUND));
+
+    sc::hst::ApplyDefaults(*pDocSh, sc::hst::DefaultKind::Cells, aValues, true);
+    CPPUNIT_ASSERT(SvxCellHorJustify::Center == rDoc.GetAttr(0, 0, 0, ATTR_HOR_JUSTIFY).GetValue());
+    CPPUNIT_ASSERT_EQUAL(sal_uInt32(280), rDoc.GetAttr(0, 0, 0, ATTR_FONT_HEIGHT).GetHeight());
+    CPPUNIT_ASSERT(COL_YELLOW != rDoc.GetAttr(0, 0, 0, ATTR_BACKGROUND).GetColor());
+    pDocSh->GetUndoManager()->Undo();
+    CPPUNIT_ASSERT(SvxCellHorJustify::Center != rDoc.GetAttr(0, 0, 0, ATTR_HOR_JUSTIFY).GetValue());
+
+    sc::hst::SetAsDefault(nullptr, *pDocSh, sc::hst::DefaultKind::Cells, aValues, true);
+    CPPUNIT_ASSERT_EQUAL(sfx2::hst::DefaultTemplateURL(ScDocShell::Factory()),
+                         SfxObjectFactory::GetStandardTemplate(aService));
+    // the template file itself, opened for editing (new spreadsheets made from it: tests/runtime)
+    dispose();
+    loadFromURL(sfx2::hst::DefaultTemplateURL(ScDocShell::Factory()),
+                { comphelper::makePropertyValue(u"AsTemplate"_ustr, false) });
+    ScDocument& rNew = *getScDoc();
+    CPPUNIT_ASSERT(SvxCellHorJustify::Center == rNew.GetAttr(0, 0, 0, ATTR_HOR_JUSTIFY).GetValue());
+    CPPUNIT_ASSERT_EQUAL(sal_uInt32(280), rNew.GetAttr(0, 0, 0, ATTR_FONT_HEIGHT).GetHeight());
+    CPPUNIT_ASSERT(COL_YELLOW != rNew.GetAttr(0, 0, 0, ATTR_BACKGROUND).GetColor());
+}
+
+// HST Office "Set As Default" in Page Setup of Sheets: the Default page style
+CPPUNIT_TEST_FIXTURE(ScHstSetAsDefaultTest, testHstSetAsDefaultPage)
+{
+    createScDoc();
+    ScDocShell* pDocSh = getScDocShell();
+    ScDocument& rDoc = pDocSh->GetDocument();
+    SfxItemSet aValues(SfxItemSet::makeFixedSfxItemSet<ATTR_LRSPACE, ATTR_PAGE_SCALETO>(*rDoc.GetPool()));
+    aValues.Put(SfxBoolItem(ATTR_PAGE_HORCENTER, true));
+    sc::hst::ApplyDefaults(*pDocSh, sc::hst::DefaultKind::Page, aValues, true);
+    SfxStyleSheetBase* pStyle
+        = rDoc.GetStyleSheetPool()->Find(ScResId(STR_STYLENAME_STANDARD), SfxStyleFamily::Page);
+    CPPUNIT_ASSERT(pStyle);
+    CPPUNIT_ASSERT(pStyle->GetItemSet().Get(ATTR_PAGE_HORCENTER).GetValue());
+}
+
+CPPUNIT_PLUGIN_IMPLEMENT();
