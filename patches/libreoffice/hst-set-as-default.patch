+namespace sw::hst
+{
+namespace
+{
+// What the Font dialog shows, without highlighting, shading, borders, hidden text and bookkeeping items.
+constexpr sal_uInt16 aCharacterIds[] = {
+    RES_CHRATR_FONT,         RES_CHRATR_FONTSIZE,     RES_CHRATR_WEIGHT,      RES_CHRATR_POSTURE,
+    RES_CHRATR_LANGUAGE,     RES_CHRATR_CJK_FONT,     RES_CHRATR_CJK_FONTSIZE, RES_CHRATR_CJK_WEIGHT,
+    RES_CHRATR_CJK_POSTURE,  RES_CHRATR_CJK_LANGUAGE, RES_CHRATR_CTL_FONT,    RES_CHRATR_CTL_FONTSIZE,
+    RES_CHRATR_CTL_WEIGHT,   RES_CHRATR_CTL_POSTURE,  RES_CHRATR_CTL_LANGUAGE, RES_CHRATR_COLOR,
+    RES_CHRATR_UNDERLINE,    RES_CHRATR_OVERLINE,     RES_CHRATR_CROSSEDOUT,  RES_CHRATR_WORDLINEMODE,
+    RES_CHRATR_CASEMAP,      RES_CHRATR_RELIEF,       RES_CHRATR_CONTOUR,     RES_CHRATR_SHADOWED,
+    RES_CHRATR_EMPHASIS_MARK, RES_CHRATR_ESCAPEMENT,  RES_CHRATR_KERNING,     RES_CHRATR_AUTOKERN,
+    RES_CHRATR_SCALEW,       RES_CHRATR_ROTATE
+};
+
+// Indents and Spacing, Line and Page Breaks (without the breaks themselves) and Tabs.
+constexpr sal_uInt16 aParagraphIds[]
+    = { RES_PARATR_ADJUST,  RES_PARATR_LINESPACING, RES_MARGIN_FIRSTLINE, RES_MARGIN_TEXTLEFT,
+        RES_MARGIN_RIGHT,   RES_UL_SPACE,           RES_PARATR_SPLIT,     RES_PARATR_WIDOWS,
+        RES_PARATR_ORPHANS, RES_KEEP,               RES_PARATR_HYPHENZONE, RES_PARATR_TABSTOP };
+
+// Margins (with the gutter), Paper and orientation (the page item also carries layout and numbering).
+constexpr sal_uInt16 aPageIds[] = { SID_ATTR_PAGE, SID_ATTR_PAGE_SIZE, RES_LR_SPACE, RES_UL_SPACE };
+
+std::span<const sal_uInt16> WhichIds(DefaultKind eKind)
+{
+    switch (eKind)
+    {
+        case DefaultKind::Character:
+            return aCharacterIds;
+        case DefaultKind::Paragraph:
+            return aParagraphIds;
+        case DefaultKind::Page:
+            break;
+    }
+    return aPageIds;
+}
+
+// "Times New Roman, 13 pt"; parts the selection mixes are left out
+OUString FontDescription(const SfxItemSet& rValues)
+{
+    OUString aText;
+    if (const SvxFontItem* pFont = rValues.GetItemIfSet(RES_CHRATR_FONT))
+        aText = pFont->GetFamilyName();
+    if (rValues.GetItemState(RES_CHRATR_FONTSIZE) >= SfxItemState::DEFAULT)
+    {
+        const sal_uInt32 nTwips = rValues.Get(RES_CHRATR_FONTSIZE).GetHeight();
+        const OUString aSize = Application::GetSettings().GetUILocaleDataWrapper().getNum(
+                                   nTwips / 2, 1, false, false) // tenths of a point
+                               + " pt";
+        aText = aText.isEmpty() ? aSize : aText + ", " + aSize;
+    }
+    return aText.isEmpty() ? u"…"_ustr : aText;
+}
+}
+
+OUString DefaultQuestion(DefaultKind eKind, const SfxItemSet& rValues)
+{
+    switch (eKind)
+    {
+        case DefaultKind::Character:
+            return SfxResId(STR_HST_DEFAULT_FONT).replaceFirst("%FONT", FontDescription(rValues));
+        case DefaultKind::Paragraph:
+            return SfxResId(STR_HST_DEFAULT_PARAGRAPH);
+        case DefaultKind::Page:
+            break;
+    }
+    return SfxResId(STR_HST_DEFAULT_PAGE);
+}
+
+void ApplyDefaults(SwDoc& rDoc, DefaultKind eKind, const SfxItemSet& rValues)
+{
+    // the items are copied into this document's pool: rValues may come from another document
+    SfxAllItemSet aDefaults(rDoc.GetAttrPool());
+    sfx2::hst::CopyDefaultValues(rValues, WhichIds(eKind), aDefaults);
+    if (!aDefaults.Count())
+        return;
+
+    IDocumentStylePoolAccess& rPool = rDoc.getIDocumentStylePoolAccess();
+    if (eKind != DefaultKind::Page)
+    {
+        // Word's Normal: every other paragraph style inherits from it unless it sets the value itself
+        if (SwTextFormatColl* pStandard = rPool.GetTextCollFromPool(SwPoolFormatId::COLL_STANDARD))
+            rDoc.ChgFormat(*pStandard, aDefaults);
+        return;
+    }
+
+    const SwPageDesc* pStandard = rPool.GetPageDescFromPool(SwPoolFormatId::PAGE_STANDARD);
+    size_t nPos = 0;
+    if (!pStandard || !rDoc.FindPageDesc(pStandard->GetName(), &nPos))
+        return;
+    SwPageDesc aDesc(*pStandard);
+    ItemSetToPageDesc(aDefaults, aDesc);
+    rDoc.ChgPageDesc(nPos, aDesc);
+}
+
+void SetAsDefault(weld::Widget* pParent, SwDocShell& rDocShell, DefaultKind eKind,
+                  const SfxItemSet& rValues, bool bNewDocuments)
+{
+    if (SwDoc* pDoc = rDocShell.GetDoc())
+        ApplyDefaults(*pDoc, eKind, rValues);
+    if (!bNewDocuments)
+        return;
+
+    const bool bSaved = sfx2::hst::UpdateDefaultTemplate(
+        SwDocShell::Factory(), [eKind, &rValues](SfxObjectShell& rTemplate) {
+            auto* pTemplate = dynamic_cast<SwDocShell*>(&rTemplate);
+            if (!pTemplate || !pTemplate->GetDoc())
+                return false;
+            ApplyDefaults(*pTemplate->GetDoc(), eKind, rValues);
+            return true;
+        });
+    if (bSaved)
+        return;
+    std::unique_ptr<weld::MessageDialog> xBox(Application::CreateMessageDialog(
+        pParent, VclMessageType::Warning, VclButtonsType::Ok, SfxResId(STR_HST_DEFAULT_FAILED)));
+    xBox->run();
+}
+}
