+// HST Office: Enter (and a double click, the same signal) applies the focused style, as Office's
+// gallery does; it used to open the Modify Style dialog, which the context menu still offers ("edit").
+IMPL_LINK_NOARG(StylesPreviewWindow_Base, DoubleClick, const weld::TreeIter&, bool)
+{
+    ApplyStyle(m_xStylesView->get_selected_id());
+    return true;
+}
 
+// HST Office: the view holds one page of previews, so the arrow keys stopped at its edge (with one
+// preview, at once): Right on the last preview of a page goes on to the next style, Left on the first
+// back to the previous one, paging as needed, and applies it as an arrow key inside the page does.
+IMPL_LINK(StylesPreviewWindow_Base, HstKeyPressHdl, const KeyEvent&, rEvent, bool)
+{
+    const vcl::KeyCode& rKey = rEvent.GetKeyCode();
+    const sal_uInt16 nCode = rKey.GetCode();
+    if (rKey.GetModifier() || (nCode != KEY_RIGHT && nCode != KEY_LEFT) || !m_nPageSize)
+        return false;
+    const OUString sId = m_xStylesView->get_selected_id();
+    const auto it = std::find_if(m_aAllStyles.begin(), m_aAllStyles.end(),
+                                 [&sId](const StylePreviewDescriptor& rStyle) { return rStyle.translatedName == sId; });
+    if (it == m_aAllStyles.end())
+        return false;
+    const size_t nCurrent = it - m_aAllStyles.begin();
+    const size_t nEnd = std::min(m_aAllStyles.size(), m_nFirstVisible + m_nPageSize);
+    size_t nTarget;
+    if (nCode == KEY_RIGHT)
+    {
+        if (nCurrent + 1 < nEnd || nCurrent + 1 >= m_aAllStyles.size())
+            return false; // inside the page the view moves itself; at the very end nothing follows
+        nTarget = nCurrent + 1;
+    }
+    else
+    {
+        if (nCurrent > m_nFirstVisible || nCurrent == 0)
+            return false;
+        nTarget = nCurrent - 1;
+    }
+    m_nFirstVisible = nTarget; // ShowPage starts the page at a multiple of the page size
+    m_sSelectedStyle = m_aAllStyles[nTarget].translatedName;
+    ShowPage();
+    ApplyStyle(m_aAllStyles[nTarget].translatedName);
     return true;
 }
 
