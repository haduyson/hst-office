+
+void DropdownBox::HstSetBare(bool bBare)
+{
+    if (m_aHstCaption.isEmpty() || bBare == m_bHstBare)
+        return;
+    m_bHstBare = bBare;
+    m_pButton->SetText(bBare ? u"\u25BE"_ustr : OUString(m_aHstCaption + u" \u25BE"));
+    if (!m_bInFullView)
+        SetOutputSizePixel(Size(HstButtonWidth(bBare), GetSizePixel().Height()));
+}
