+bool PriorityMergedHBox::HstBlockShouldBeBare(tools::Long nRoom, tools::Long nGain) const
+{
+    if (nGain <= 0 || m_nHstBareBefore >= m_aHstPlanGroups.size())
+        return false;
+    // the ladder's plan for a width, without changing anything: does the named group stay?
+    const auto kept = [this](tools::Long nAvailable) {
+        hst::ribbon::Layout aLayout = hst::ribbon::select(m_aHstPlanGroups, m_aHstPlanSteps, nAvailable, 0);
+        if (!aLayout.overflow.empty())
+            return false;
+        lcl_HstUncollapse(m_aHstPlanGroups, m_aHstPlanSteps, nAvailable, aLayout);
+        return aLayout.states[m_nHstBareBefore] != static_cast<size_t>(hst::ribbon::GroupCollapsed);
+    };
+    return !kept(nRoom) && kept(nRoom + nGain);
+}
