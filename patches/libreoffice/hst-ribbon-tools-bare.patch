+/// HST Office: a group collapsed by an earlier step comes back (in the largest state that fits) when a
+/// later step has made room for it: a big group's button (Paragraph) can leave room for the gallery, and
+/// the row should not keep both collapsed beside free space; the latest collapse is tried first
+void lcl_HstUncollapse(const std::vector<hst::ribbon::Group>& rGroups, const std::vector<hst::ribbon::Step>& rSteps,
+                       long nWidth, hst::ribbon::Layout& rLayout)
+{
+    long nRow = hst::ribbon::rowWidth(rGroups, rLayout.states);
+    for (auto it = rSteps.rbegin(); it != rSteps.rend(); ++it)
+    {
+        if (it->state != static_cast<size_t>(hst::ribbon::GroupCollapsed) || it->group >= rGroups.size()
+            || rLayout.states[it->group] != static_cast<size_t>(hst::ribbon::GroupCollapsed))
+            continue;
+        const hst::ribbon::Group& rGroup = rGroups[it->group];
+        for (size_t nState = 0; nState < static_cast<size_t>(hst::ribbon::GroupStateCount); ++nState)
+        {
+            const long nNext = nRow - hst::ribbon::widthOf(rGroup, it->state) + hst::ribbon::widthOf(rGroup, nState);
+            if (nNext <= nWidth)
+            {
+                rLayout.states[it->group] = nState;
+                nRow = nNext;
+                break;
+            }
+        }
+    }
+}
