-/// HST Office: a toolbox that holds one command (separators aside)
-bool holdsOneCommand(const ToolBox& rToolBox)
+/// HST Office: the number of commands (separators aside) of a toolbox; -1 when one of them is drawn as a
+/// control (font name, find box, gallery), whose group never counts as a group of few commands
+int commandCount(const ToolBox& rToolBox)
 {
     int nCommands = 0;
     for (ToolBox::ImplToolItems::size_type i = 0; i < rToolBox.GetItemCount(); ++i)
-        if (rToolBox.GetItemType(i) == ToolBoxItemType::BUTTON)
-            ++nCommands;
-    return nCommands == 1;
+    {
+        if (rToolBox.GetItemType(i) != ToolBoxItemType::BUTTON)
+            continue;
+        if (rToolBox.GetItemWindow(rToolBox.GetItemId(i)))
+            return -1;
+        ++nCommands;
+    }
+    return nCommands;
 }
 
