+namespace
+{
+// HST Office: previews kept in the row at the large, medium and small group (one preview with the icon view's
+// padding is 106 px, stylespreview.ui), as Office's Styles gallery narrows from 6 to 4 to 3 before it folds
+constexpr int HST_PREVIEWS[] = { 6, 4, 3 };
+constexpr tools::Long HST_PREVIEW_WIDTH = 106;
+}
+
+void StylesPreviewWindow_Impl::HstApplyPreviews()
+{
+    if (m_xHstScroll)
+        m_xHstScroll->set_size_request(HST_PREVIEWS[m_nHstState] * HST_PREVIEW_WIDTH * GetDPIScaleFactor(), -1);
+}
+
+bool StylesPreviewWindow_Impl::set_property(const OUString& rKey, const OUString& rValue)
+{
+    if (rKey != "hst-gallery-state")
+        return InterimItemWindow::set_property(rKey, rValue);
+    const int nState = std::clamp<int>(rValue.toInt32(), 0, std::size(HST_PREVIEWS) - 1);
+    if (nState == m_nHstState)
+        return false; // nothing changed: the ladder need not lay the toolbox out again
+    m_nHstState = nState;
+    HstApplyPreviews();
+    SetOptimalSize();
+    return true;
+}
+
 StylesPreviewWindow_Impl::~StylesPreviewWindow_Impl() { disposeOnce(); }
 
 void StylesPreviewWindow_Impl::dispose()
 {
