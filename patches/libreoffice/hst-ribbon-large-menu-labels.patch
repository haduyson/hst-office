 IMPL_STATIC_LINK(MenuButtonLabels, ButtonEventHdl, VclWindowEvent&, rEvent, void)
 {
     if (rEvent.GetId() == VclEventId::ObjectDying)
-        MenuButtonLabels::hidden().erase(rEvent.GetWindow());
+        MenuButtonLabels::labels().erase(rEvent.GetWindow());
+}
+
+/// "Label ▾" of a large menu button: two lines split at the space that makes the longer one shortest, ▾ ending
+/// the second line; a label of one word (or of seven characters at most) on the first line and ▾ alone below.
+OUString largeMenuLabel(const OUString& rLabel)
+{
+    static constexpr OUString aArrow(u"\u25BE"_ustr); // ▾, as the "Caption ▾" buttons
+    if (rLabel.indexOf(' ') < 0 || rLabel.replaceAll("~", "").getLength() <= 7)
+        return rLabel + "\n" + aArrow;
+    sal_Int32 nBest = -1, nBestLength = SAL_MAX_INT32;
+    for (sal_Int32 i = rLabel.indexOf(' '); i >= 0; i = rLabel.indexOf(' ', i + 1))
+    {
+        const sal_Int32 nLonger = std::max(i, rLabel.getLength() - i - 1);
+        if (nLonger < nBestLength)
+        {
+            nBest = i;
+            nBestLength = nLonger;
+        }
+    }
+    return OUString::Concat(rLabel.subView(0, nBest)) + "\n" + rLabel.subView(nBest + 1) + " " + aArrow;
 }
 
