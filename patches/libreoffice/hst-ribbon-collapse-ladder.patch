+
+#pragma once
+
+// HST Office: size states of a ribbon group for the Office-style collapse ladder.
+// Large is the authored layout; Medium turns large buttons into small icons with the label on
+// the right; Small drops the labels. A toolbox holding Paste always keeps its authored layout.
+// The ladder itself (which group goes to which state) is HstRibbonScaling.hxx.
+
+#include <sal/types.h>
+
+namespace vcl
+{
+class Window;
+}
+
+namespace hst::ribbon
+{
+enum GroupState
+{
+    GroupLarge = 0,
+    GroupMedium = 1,
+    GroupSmall = 2,
+    GroupStateCount = 3
+};
+
+/** The CollapseLadder switch (org.openoffice.Office.HSTRibbon), read once per process; false in
+    LibreOfficeKit. Off: whole groups fold as before. */
+bool collapseLadderEnabled();
+
+/** Apply nState to every toolbox inside rGroup (authored styles are remembered on first use). */
+void SetGroupState(vcl::Window& rGroup, int nState);
+
+/** Changes when the group's content changes (contextual items shown or hidden), for width caches. */
+sal_Int32 GroupContentKey(vcl::Window& rGroup);
+}
