+void PriorityMergedHBox::HstApplyLadder(tools::Long nWidth)
+{
+    if (m_bHstLadder)
+        return;
+    m_bHstLadder = true;
+    const tools::Long nSpacing = get_spacing();
+    std::vector<vcl::Window*> aWindows;
+    std::vector<hst::ribbon::Group> aGroups;
+    for (vcl::Window* pChild = GetWindow(GetWindowType::FirstChild); pChild;
+         pChild = pChild->GetWindow(GetWindowType::Next))
+    {
+        if (pChild == m_pButton)
+            continue;
+        const sal_Int32 nKey = hst::ribbon::GroupContentKey(*pChild);
+        auto& rEntry = m_aHstWidths[pChild];
+        if (rEntry.second.empty() || rEntry.first != nKey)
+        {
+            // measure every state once, then go back to the current one
+            rEntry.first = nKey;
+            rEntry.second.clear();
+            for (int nState = 0; nState < hst::ribbon::GroupStateCount; ++nState)
+            {
+                hst::ribbon::SetGroupState(*pChild, nState);
+                rEntry.second.push_back(getLayoutRequisition(*pChild).Width() + pChild->get_padding() * 2);
+            }
+            hst::ribbon::SetGroupState(*pChild, m_aHstStates[pChild]);
+        }
+        hst::ribbon::Group aGroup;
+        for (tools::Long nGroupWidth : rEntry.second)
+            aGroup.widths.push_back(nGroupWidth + (aGroups.empty() ? 0 : nSpacing));
+        aGroups.push_back(std::move(aGroup));
+        aWindows.push_back(pChild);
+    }
+    const tools::Long nChevron
+        = getLayoutRequisition(*m_pButton).Width() + m_pButton->get_padding() * 2 + nSpacing;
+    // default ladder: from the right, one state at a time; core groups on the left go last
+    const hst::ribbon::Layout aLayout = hst::ribbon::select(aGroups, {}, nWidth, nChevron);
+    for (size_t i = 0; i < aWindows.size(); ++i)
+    {
+        const int nState = static_cast<int>(aLayout.states[i]);
+        if (m_aHstStates[aWindows[i]] != nState)
+        {
+            hst::ribbon::SetGroupState(*aWindows[i], nState);
+            m_aHstStates[aWindows[i]] = nState;
+        }
+    }
+    m_bHstLadder = false;
+}
+
+void PriorityMergedHBox::DataChanged(const DataChangedEvent& rEvent)
+{
+    PriorityHBox::DataChanged(rEvent);
+    // fonts, scale or theme change the widths: measure again
+    if (rEvent.GetType() == DataChangedEventType::SETTINGS || rEvent.GetType() == DataChangedEventType::FONTS
+        || rEvent.GetType() == DataChangedEventType::DISPLAY)
+        m_aHstWidths.clear();
+}
+
