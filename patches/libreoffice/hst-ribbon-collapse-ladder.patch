+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This file is part of the LibreOffice project.
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+#include <HstRibbonLadder.hxx>
+
+#include <comphelper/lok.hxx>
+#include <officecfg/Office/HSTRibbon.hxx>
+#include <vcl/image.hxx>
+#include <vcl/toolbox.hxx>
+
+#include <toolbox.h>
+
+namespace hst::ribbon
+{
+namespace
+{
+bool holdsPaste(const ToolBox& rToolBox)
+{
+    for (ToolBox::ImplToolItems::size_type i = 0; i < rToolBox.GetItemCount(); ++i)
+        if (rToolBox.GetItemCommand(rToolBox.GetItemId(i)) == ".uno:Paste")
+            return true;
+    return false;
+}
+
+void applyToToolBox(ToolBox& rToolBox, int nState)
+{
+    ImplToolBoxPrivateData& rData = *rToolBox.ImplGetToolBoxPrivateData();
+    if (!rData.mbHstAuthored)
+    {
+        rData.mbHstAuthored = true;
+        rData.meHstAuthoredType = rToolBox.GetButtonType();
+        rData.meHstAuthoredSize = rToolBox.GetToolboxButtonSize();
+        rData.meHstAuthoredTextPosition = rData.meHstTextPosition;
+        rData.mbHstKeepLarge = holdsPaste(rToolBox); // Paste stays large, as in Office
+    }
+    const bool bKeep = rData.mbHstKeepLarge || nState == GroupLarge;
+    const ButtonType eType
+        = bKeep || nState < GroupSmall ? rData.meHstAuthoredType : ButtonType::SYMBOLONLY;
+    const ToolBoxButtonSize eSize
+        = bKeep || rData.meHstAuthoredSize != ToolBoxButtonSize::Large ? rData.meHstAuthoredSize
+                                                                       : ToolBoxButtonSize::Small;
+    const ToolBoxTextPosition ePosition
+        = bKeep ? rData.meHstAuthoredTextPosition : ToolBoxTextPosition::Right;
+    // only real changes: each one invalidates the toolbox and queues a layout
+    if (rToolBox.GetButtonType() != eType)
+        rToolBox.SetButtonType(eType);
+    if (rToolBox.GetToolboxButtonSize() != eSize)
+        rToolBox.SetToolboxButtonSize(eSize);
+    if (rData.meHstTextPosition != ePosition)
+        rToolBox.SetToolBoxTextPosition(ePosition);
+}
+
+template <typename F> void forToolBoxes(vcl::Window& rWindow, const F& rFunction)
+{
+    for (vcl::Window* pChild = rWindow.GetWindow(GetWindowType::FirstChild); pChild;
+         pChild = pChild->GetWindow(GetWindowType::Next))
+    {
+        if (ToolBox* pToolBox = dynamic_cast<ToolBox*>(pChild))
+            rFunction(*pToolBox);
+        else
+            forToolBoxes(*pChild, rFunction);
+    }
+}
+}
+
+bool collapseLadderEnabled()
+{
+    static const bool bEnabled = [] {
+        if (comphelper::LibreOfficeKit::isActive())
+            return false;
+        try
+        {
+            return officecfg::Office::HSTRibbon::CollapseLadder::get();
+        }
+        catch (...)
+        {
+            return true; // no configuration (unit tests): the shipped default
+        }
+    }();
+    return bEnabled;
+}
+
+void SetGroupState(vcl::Window& rGroup, int nState)
+{
+    forToolBoxes(rGroup, [nState](ToolBox& rToolBox) { applyToToolBox(rToolBox, nState); });
+}
+
+sal_Int32 GroupContentKey(vcl::Window& rGroup)
+{
+    sal_Int32 nKey = 0;
+    forToolBoxes(rGroup, [&nKey](ToolBox& rToolBox) {
+        nKey = nKey * 31 + (rToolBox.IsVisible() ? 1 : 0);
+        for (ToolBox::ImplToolItems::size_type i = 0; i < rToolBox.GetItemCount(); ++i)
+            nKey = nKey * 31 + (rToolBox.IsItemVisible(rToolBox.GetItemId(i)) ? 1 : 0);
+    });
+    return nKey;
+}
+}
