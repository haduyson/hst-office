+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ * Copyright (C) HASON TECH. HST Office.
+ */
+
+#include <cppunit/TestAssert.h>
+#include <cppunit/TestFixture.h>
+#include <cppunit/extensions/HelperMacros.h>
+#include <cppunit/plugin/TestPlugIn.h>
+
+#include <hst/altgrsamechar.hxx>
+
+namespace
+{
+using vcl::hst::KeepsCtrlAltShortcut;
+
+/// Which Ctrl+Alt presses stay shortcuts on a Windows layout that gives a character on the AltGr level. The
+/// characters are the ones the Vietnamese (0000042A), German (00000407) and Polish layouts give.
+class HstAltGrSameCharTest : public CppUnit::TestFixture
+{
+public:
+    void testVietnameseLetterRepeatsPlainCharacter()
+    {
+        // Vietnamese: Ctrl+Alt+Q gives "q" like Q alone, Ctrl+Alt+Shift+Q gives "Q" like Shift+Q
+        CPPUNIT_ASSERT(KeepsCtrlAltShortcut(0x51, u'q', u'q'));
+        CPPUNIT_ASSERT(KeepsCtrlAltShortcut(0x51, u'Q', u'Q'));
+        CPPUNIT_ASSERT(KeepsCtrlAltShortcut(0x41, u'a', u'a'));
+        CPPUNIT_ASSERT(KeepsCtrlAltShortcut(0x5A, u'z', u'z'));
+    }
+
+    void testCommaAndPeriod()
+    {
+        // the document tab keys Ctrl+Alt+, and Ctrl+Alt+.
+        CPPUNIT_ASSERT(KeepsCtrlAltShortcut(0xBC, u',', u','));
+        CPPUNIT_ASSERT(KeepsCtrlAltShortcut(0xBE, u'.', u'.'));
+    }
+
+    void testDigitsKeepTheirAltGrCharacter()
+    {
+        // Vietnamese: 1 alone gives "ă", Ctrl+Alt+1 gives "1", the way that layout types digits
+        CPPUNIT_ASSERT(!KeepsCtrlAltShortcut(0x31, u'1', u'ă'));
+        // a digit is never covered, even if both characters were the same
+        CPPUNIT_ASSERT(!KeepsCtrlAltShortcut(0x31, u'1', u'1'));
+    }
+
+    void testRealAltGrCharacterStaysTyped()
+    {
+        // German: AltGr+Q gives "@", Q alone "q"; AltGr+E gives "€"
+        CPPUNIT_ASSERT(!KeepsCtrlAltShortcut(0x51, u'@', u'q'));
+        CPPUNIT_ASSERT(!KeepsCtrlAltShortcut(0x45, u'€', u'e'));
+        // Polish programmer's layout: AltGr+A gives "ą"
+        CPPUNIT_ASSERT(!KeepsCtrlAltShortcut(0x41, u'ą', u'a'));
+    }
+
+    void testOtherKeysAndNoCharacter()
+    {
+        // Vietnamese "=" key: the AltGr level gives "=" where the key alone gives "₫"; brackets are not covered
+        CPPUNIT_ASSERT(!KeepsCtrlAltShortcut(0xBB, u'=', u'₫'));
+        CPPUNIT_ASSERT(!KeepsCtrlAltShortcut(0xDB, u'[', u'['));
+        // no character at all (US layout): nothing to decide, the shortcut already arrives
+        CPPUNIT_ASSERT(!KeepsCtrlAltShortcut(0x51, 0, 0));
+    }
+
+    CPPUNIT_TEST_SUITE(HstAltGrSameCharTest);
+    CPPUNIT_TEST(testVietnameseLetterRepeatsPlainCharacter);
+    CPPUNIT_TEST(testCommaAndPeriod);
+    CPPUNIT_TEST(testDigitsKeepTheirAltGrCharacter);
+    CPPUNIT_TEST(testRealAltGrCharacterStaysTyped);
+    CPPUNIT_TEST(testOtherKeysAndNoCharacter);
+    CPPUNIT_TEST_SUITE_END();
+};
+
+CPPUNIT_TEST_SUITE_REGISTRATION(HstAltGrSameCharTest);
+}
+
+CPPUNIT_PLUGIN_IMPLEMENT();
