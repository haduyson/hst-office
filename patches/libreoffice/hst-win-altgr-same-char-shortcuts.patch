+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ * Copyright (C) HASON TECH. HST Office.
+ */
+
+#pragma once
+
+#include <sal/types.h>
+
+// Ctrl+Alt is AltGr on Windows. Some layouts (the built-in Vietnamese one) give a character on the AltGr level
+// of every letter that is just the key's own character again, so Ctrl+Alt+letter typed that letter instead of
+// running the shortcut. When the AltGr character repeats the plain one, nothing can be typed with Ctrl+Alt that
+// the key alone does not give: the press stays Ctrl+Alt+key, as on a layout without AltGr. Digits are excluded
+// (there the AltGr level is how such a layout types digits), as are real AltGr characters such as "@".
+namespace vcl::hst
+{
+/// Windows virtual-key codes of the keys the rule covers: the letters, comma and period.
+constexpr sal_uInt32 VirtualKeyA = 0x41;
+constexpr sal_uInt32 VirtualKeyZ = 0x5A;
+constexpr sal_uInt32 VirtualKeyComma = 0xBC; // VK_OEM_COMMA
+constexpr sal_uInt32 VirtualKeyPeriod = 0xBE; // VK_OEM_PERIOD
+
+/// True if a Ctrl+Alt press of nVirtualKey stays a shortcut although the layout gives cWithCtrlAlt for it:
+/// the key is a letter, comma or period, and cWithCtrlAlt is the character cPlain the key gives in the same
+/// layout without Ctrl and Alt (same Shift and Caps Lock state).
+constexpr bool KeepsCtrlAltShortcut(sal_uInt32 nVirtualKey, sal_Unicode cWithCtrlAlt, sal_Unicode cPlain)
+{
+    const bool bCoveredKey = (nVirtualKey >= VirtualKeyA && nVirtualKey <= VirtualKeyZ)
+                             || nVirtualKey == VirtualKeyComma || nVirtualKey == VirtualKeyPeriod;
+    return bCoveredKey && cWithCtrlAlt != 0 && cWithCtrlAlt == cPlain;
+}
+
+#ifdef _WIN32
+/// For a key press with Ctrl and Alt down whose WM_CHAR gave cWithCtrlAlt: KeepsCtrlAltShortcut with the
+/// character the active keyboard layout gives for the same key without Ctrl and Alt (vcl/win/hst).
+bool WinKeepsCtrlAltShortcut(sal_uInt32 nVirtualKey, sal_Unicode cWithCtrlAlt);
+#endif
+}
