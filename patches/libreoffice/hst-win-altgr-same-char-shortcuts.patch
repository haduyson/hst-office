+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ * Copyright (C) HASON TECH. HST Office.
+ */
+
+#include <sal/config.h>
+
+#include <hst/altgrsamechar.hxx>
+
+#include <sal/macros.h>
+#include <win/svsys.h>
+
+namespace vcl::hst
+{
+bool WinKeepsCtrlAltShortcut(sal_uInt32 nVirtualKey, sal_Unicode cWithCtrlAlt)
+{
+    // cheap test first: a key the rule does not cover, or no character at all
+    if (!KeepsCtrlAltShortcut(nVirtualKey, cWithCtrlAlt, cWithCtrlAlt))
+        return false;
+
+    // the character of the same key in the active layout, with only Shift and Caps Lock as they are now
+    const HKL hLayout = GetKeyboardLayout(0);
+    BYTE aState[256] = {};
+    if (GetKeyState(VK_SHIFT) & 0x8000)
+        aState[VK_SHIFT] = 0x80;
+    if (GetKeyState(VK_CAPITAL) & 0x0001)
+        aState[VK_CAPITAL] = 0x01;
+    const UINT nScanCode = MapVirtualKeyExW(nVirtualKey, MAPVK_VK_TO_VSC, hLayout);
+    WCHAR aChars[4] = {};
+    // flag 0x4: leave the keyboard's dead-key state alone (Windows 10 1607 and later)
+    const int nChars
+        = ToUnicodeEx(nVirtualKey, nScanCode, aState, aChars, SAL_N_ELEMENTS(aChars), 0x4, hLayout);
+    return nChars == 1
+           && KeepsCtrlAltShortcut(nVirtualKey, cWithCtrlAlt, static_cast<sal_Unicode>(aChars[0]));
+}
+}
