+#pragma once
+
+#include <rtl/ustring.hxx>
+#include <sfx2/request.hxx>
+#include <svl/itemset.hxx>
+#include <svl/stritem.hxx>
+
+/// HST Office: the ribbon's group launchers (↘) send ".uno:Command?Page:string=<tab id>" so that a
+/// tab dialog opens on the tab of its group instead of the tab used last. When that string is the
+/// request's only argument, it is taken out of the request and returned: the handler then sees a
+/// plain "open the dialog" request (handlers treat any argument as "apply without a dialog") and
+/// selects the returned tab. Any other set of arguments keeps its old meaning; returns "" then.
+inline OUString hstTakeDialogPage(SfxRequest& rReq, sal_uInt16 nSlotId)
+{
+    const SfxItemSet* pArgs = rReq.GetArgs();
+    const SfxStringItem* pPage = rReq.GetArg<SfxStringItem>(nSlotId);
+    if (!pArgs || !pPage || pArgs->Count() != 1)
+        return OUString();
+    const OUString aPage = pPage->GetValue();
+    rReq.RemoveItem(pPage->Which());
+    return aPage;
+}
