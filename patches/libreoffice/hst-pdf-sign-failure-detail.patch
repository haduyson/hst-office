+/// Why signing failed, for the message box: the text, and the step and error code below it.
+struct SignFailure
+{
+    OUString aText;
+    OUString aDetails; ///< empty when the platform signer recorded nothing
+};
+
+/**
+ * After signPdf() returned SignResult::Failed: explains the failure recorded by the signer
+ * (svl::crypto::GetLastSigningError, Windows) - token or key not found, PIN cancelled, wrong or
+ * blocked PIN, or another failure with its step and error code - and adds an entry with the step
+ * and code to the HST log (<profile>/user/hst-office/hst-office.log). Nothing personal is logged.
+ */
+XMLSECURITY_DLLPUBLIC SignFailure describeSignFailure();
