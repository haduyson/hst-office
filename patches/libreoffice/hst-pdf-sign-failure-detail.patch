+/// Appends one entry to the HST log, the file HST's Python components write, in their format
+/// ("<UTC time> <LEVEL> <component>: <message>"). Never throws; a failure only loses the entry.
+void appendHstLog(const char* pLevel, const OString& rMessage)
+{
+    try
+    {
+        const uno::Reference<util::XStringSubstitution> xSubstitution
+            = util::PathSubstitution::create(comphelper::getProcessComponentContext());
+        const OUString aDir = xSubstitution->substituteVariables(u"$(user)"_ustr, true)
+                              + "/hst-office";
+        osl::Directory::createPath(aDir); // E_EXIST when the folder is there already
+        osl::File aLog(aDir + "/hst-office.log");
+        osl::FileBase::RC eRC = aLog.open(osl_File_OpenFlag_Write | osl_File_OpenFlag_Create);
+        if (eRC == osl::FileBase::E_EXIST)
+        {
+            eRC = aLog.open(osl_File_OpenFlag_Write);
+            if (eRC == osl::FileBase::E_None)
+                eRC = aLog.setPos(osl_Pos_End, 0);
+        }
+        if (eRC != osl::FileBase::E_None)
+            return;
+        TimeValue aNow;
+        oslDateTime aTime;
+        char aStamp[32] = "";
+        if (osl_getSystemTime(&aNow) && osl_getDateTimeFromTimeValue(&aNow, &aTime))
+            std::snprintf(aStamp, sizeof(aStamp), "%04d-%02d-%02dT%02d:%02d:%02dZ",
+                          static_cast<int>(aTime.Year), static_cast<int>(aTime.Month),
+                          static_cast<int>(aTime.Day), static_cast<int>(aTime.Hours),
+                          static_cast<int>(aTime.Minutes), static_cast<int>(aTime.Seconds));
+        const OString aLine = OString(aStamp) + " " + pLevel + " pdf-sign: " + rMessage + "\n";
+        sal_uInt64 nWritten = 0;
+        aLog.write(aLine.getStr(), aLine.getLength(), nWritten);
+        aLog.close();
+    }
+    catch (const uno::Exception&)
+    {
+    }
+}
+}
+
+SignFailure describeSignFailure()
+{
+    const svl::crypto::SigningError aError = svl::crypto::GetLastSigningError();
+    TranslateId aText = STR_HSTPDF_SIGN_FAILED;
+    const char* pKind = "other";
+    switch (aError.eKind)
+    {
+        case svl::crypto::SigningFailure::KeyNotFound:
+            aText = STR_HSTPDF_SIGN_NO_KEY;
+            pKind = "token-or-key-not-found";
+            break;
+        case svl::crypto::SigningFailure::Cancelled:
+            aText = STR_HSTPDF_SIGN_CANCELLED;
+            pKind = "pin-cancelled";
+            break;
+        case svl::crypto::SigningFailure::WrongPin:
+            aText = STR_HSTPDF_SIGN_WRONG_PIN;
+            pKind = "wrong-or-blocked-pin";
+            break;
+        case svl::crypto::SigningFailure::None:
+            pKind = "not-recorded";
+            break;
+        case svl::crypto::SigningFailure::Other:
+            break;
+    }
+    SignFailure aFailure{ XsResId(aText), OUString() };
+    char aCode[16];
+    std::snprintf(aCode, sizeof(aCode), "0x%08X", static_cast<unsigned>(aError.nCode));
+    const OString aDetails = aError.aStep + " " + OString(aCode);
+    if (aError.eKind != svl::crypto::SigningFailure::None)
+        aFailure.aDetails = XsResId(STR_HSTPDF_SIGN_DETAILS)
+                                .replaceFirst("%1", OStringToOUString(aDetails, RTL_TEXTENCODING_ASCII_US));
+    const OString aWhere = aError.eKind != svl::crypto::SigningFailure::None
+                               ? OString(" at " + aDetails)
+                               : OString();
+    appendHstLog(aError.eKind == svl::crypto::SigningFailure::Cancelled ? "WARNING" : "ERROR",
+                 OString::Concat("signing failed: ") + pKind + aWhere);
+    return aFailure;
+}
 }
 
