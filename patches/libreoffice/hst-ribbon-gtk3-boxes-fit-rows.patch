+
+namespace vcl
+{
+class Window;
+}
+
+namespace hst::ribbon
+{
+/** The style class the gtk3 backend gives the native widgets of a ribbon item (a box in a ribbon toolbox): its
+    combo boxes, entries and spin buttons drop their vertical padding and minimum height, so that they fit the
+    ribbon's 24 px rows (GTK draws a native box at its own height and the row clipped its bottom). */
+inline constexpr char RowStyleClass[] = "hst-ribbon-row";
+
+/** Whether pWindow is a part of the ribbon: it, or a window above it, is the frame's NotebookBar. */
+VCL_DLLPUBLIC bool IsInRibbon(const vcl::Window* pWindow);
+}
