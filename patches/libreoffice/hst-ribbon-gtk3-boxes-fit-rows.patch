--- /dev/null
+++ b/vcl/source/control/HstRibbonRow.cxx
@@ -0,0 +1,21 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ */
+
+#include <vcl/HstRibbonRow.hxx>
+#include <vcl/notebookbar/notebookbar.hxx>
+#include <vcl/window.hxx>
+
+namespace hst::ribbon
+{
+bool IsInRibbon(const vcl::Window* pWindow)
+{
+    for (; pWindow; pWindow = pWindow->GetParent())
+        if (dynamic_cast<const NotebookBar*>(pWindow))
+            return true;
+    return false;
+}
+}
