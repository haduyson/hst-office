+// RaiseEvent: the handlers are <variable>_<event> in the objects whose WithEvents variable holds this one
+void SbRtl_HstRaiseEvent(StarBASIC*, SbxArray& rPar, bool)
+{
+    const sal_uInt32 nCount = rPar.Count();
+    SbiInstance* pInst = GetSbData()->pInst;
+    SbiRuntime* pRun = pInst ? pInst->pRun : nullptr;
+    if (nCount < 2 || !pRun)
+        return;
+    SbxObject* pSource = dynamic_cast<SbxObject*>(pRun->GetModule());
+    const OUString aEvent = rPar.Get(nCount - 1)->GetOUString();
+    const auto aLinks = GetSbData()->aClassEventLinks; // a handler may change them
+    for (const auto& [xSource, xOwner, aVariable] : aLinks)
+    {
+        if (xSource.get() != pSource || !xOwner.is())
+            continue;
+        SbMethod* pHandler = dynamic_cast<SbMethod*>(xOwner->Find(aVariable + "_" + aEvent, SbxClassType::Method));
+        if (!pHandler)
+            continue;
+        SbxArrayRef xArgs = new SbxArray;
+        xArgs->Put(pHandler, 0);
+        for (sal_uInt32 i = 1; i + 1 < nCount; ++i)
+            xArgs->Put(rPar.Get(i), i);
+        pHandler->SetParameters(xArgs.get());
+        SbxVariableRef xReturn = new SbxVariable;
+        pHandler->Call(xReturn.get());
+        pHandler->SetParameters(nullptr);
+    }
+}
