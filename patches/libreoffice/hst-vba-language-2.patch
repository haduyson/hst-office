+// HST: RaiseEvent Name(a, b) calls the runtime function with the arguments and then the name
+
+void SbiParser::RaiseEvent()
+{
+    Next(); // RaiseEvent
+    aGen.Statement();
+    if( !TestSymbol() )
+        return;
+    const OUString aEvent = aSym;
+    SbiExprListPtr pPar;
+    if( Peek() == LPAREN )
+        pPar = SbiExprList::ParseParameters( this );
+    if( pPar && pPar->GetSize() > 0 )
+        pPar->Gen( aGen );
+    else
+        aGen.Gen( SbiOpcode::ARGC_ );
+    aGen.Gen( SbiOpcode::SCONST_, aGblStrings.Add( aEvent ) );
+    aGen.Gen( SbiOpcode::ARGV_ );
+    aGen.Gen( SbiOpcode::RTL_, aGblStrings.Add( u"HstRaiseEvent"_ustr ), SbxVARIANT );
+    aGen.Gen( SbiOpcode::GET_ );
