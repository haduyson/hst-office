+/// The parsed part of the last export, serialized again: equal strings mean equal XML content.
+OString dumpExportedPart(xmlDocUniquePtr const& pDoc)
+{
+    CPPUNIT_ASSERT(pDoc);
+    xmlChar* pBuf = nullptr;
+    int nSize = 0;
+    xmlDocDumpMemory(pDoc.get(), &pBuf, &nSize);
+    OString aDump(reinterpret_cast<const char*>(pBuf), nSize);
+    xmlFree(pBuf);
+    return aDump;
+}
+}
