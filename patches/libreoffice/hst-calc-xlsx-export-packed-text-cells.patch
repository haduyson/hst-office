+CPPUNIT_TEST_FIXTURE(ScExportTest6, testXlsxPackedTextCellsWriteTheSameSheet)
+{
+    // The .xlsx export keeps plain text cells as packed runs of their row. The sheet, the shared strings and the
+    // styles must be the same as with one record per text cell (the environment variable selects that path).
+    createScDoc();
+    ScDocument* pDoc = getScDoc();
+    // runs of text, interrupted by a number, a formula, a blank formatted cell and an edit cell
+    for (SCCOL nCol = 0; nCol < 5; ++nCol)
+        pDoc->SetString(ScAddress(nCol, 0, 0), u"Hàng "_ustr + OUString::number(nCol % 3));
+    pDoc->SetValue(ScAddress(5, 0, 0), 1.25);
+    pDoc->SetString(ScAddress(6, 0, 0), u"sau số"_ustr);
+    pDoc->SetString(ScAddress(7, 0, 0), u"=\"công\"&\"thức\""_ustr);
+    pDoc->SetString(ScAddress(8, 0, 0), u"Hàng 0"_ustr);
+    // formatted text cells next to each other and a formatted blank cell between two runs
+    ScPatternAttr aBold(pDoc->getCellAttributeHelper());
+    aBold.GetItemSet().Put(SvxWeightItem(WEIGHT_BOLD, ATTR_FONT_WEIGHT));
+    pDoc->ApplyPatternAreaTab(1, 1, 2, 3, 0, aBold);
+    for (SCROW nRow = 1; nRow <= 3; ++nRow)
+        for (SCCOL nCol = 0; nCol < 4; ++nCol)
+            if (!(nRow == 2 && nCol == 2))
+                pDoc->SetString(ScAddress(nCol, nRow, 0), u"Ô "_ustr + OUString::number(nRow * 10 + nCol));
+    // multi-line text, a merged range whose base holds text, a hidden row with text
+    pDoc->SetString(ScAddress(0, 5, 0), u"dòng 1\ndòng 2"_ustr);
+    pDoc->SetString(ScAddress(1, 5, 0), u"cạnh"_ustr);
+    pDoc->SetString(ScAddress(2, 6, 0), u"gộp"_ustr);
+    pDoc->DoMerge(2, 6, 3, 7, 0);
+    pDoc->SetString(ScAddress(4, 6, 0), u"sau ô gộp"_ustr);
+    pDoc->SetString(ScAddress(0, 9, 0), u"ẩn"_ustr);
+    pDoc->SetString(ScAddress(1, 9, 0), u"ẩn 2"_ustr);
+    pDoc->SetRowHidden(9, 9, 0, true);
+    // a formatted edit cell inside a run
+    pDoc->SetString(ScAddress(0, 11, 0), u"trước"_ustr);
+    ScFieldEditEngine& rEE = pDoc->GetEditEngine();
+    rEE.SetTextCurrentDefaults(u"đậm nhạt"_ustr);
+    SfxItemSet aSet(rEE.GetEmptyItemSet());
+    aSet.Put(SvxWeightItem(WEIGHT_BOLD, EE_CHAR_WEIGHT));
+    rEE.QuickSetAttribs(aSet, ESelection(0, 0, 0, 3));
+    pDoc->SetEditText(ScAddress(1, 11, 0), rEE.CreateTextObject());
+    pDoc->SetString(ScAddress(2, 11, 0), u"sau"_ustr);
+    // a long row of text far to the right
+    for (SCCOL nCol = 100; nCol < 140; ++nCol)
+        pDoc->SetString(ScAddress(nCol, 12, 0), u"x"_ustr + OUString::number(nCol));
+
+    static constexpr std::array<OUString, 4> aParts{ u"xl/worksheets/sheet1.xml"_ustr,
+                                                     u"xl/sharedStrings.xml"_ustr, u"xl/styles.xml"_ustr,
+                                                     u"xl/workbook.xml"_ustr };
+    osl_setEnvironment(u"HST_SC_XLSX_PACKED_LABELS_OFF"_ustr.pData, u"1"_ustr.pData);
+    save(TestFilter::XLSX);
+    std::vector<OString> aOld;
+    for (const OUString& rPart : aParts)
+        aOld.push_back(dumpExportedPart(parseExport(rPart)));
+    osl_clearEnvironment(u"HST_SC_XLSX_PACKED_LABELS_OFF"_ustr.pData);
+
+    save(TestFilter::XLSX);
+    for (size_t i = 0; i < aParts.size(); ++i)
+        CPPUNIT_ASSERT_EQUAL_MESSAGE(aParts[i].toUtf8().getStr(), aOld[i],
+                                     dumpExportedPart(parseExport(aParts[i])));
+
+    // the packed runs are really written: one <c t="s"> per text cell, with its shared string index
+    xmlDocUniquePtr pSheet = parseExport(u"xl/worksheets/sheet1.xml"_ustr);
+    assertXPath(pSheet, "/x:worksheet/x:sheetData/x:row[1]/x:c[@t='s']", 7);
+    assertXPath(pSheet, "/x:worksheet/x:sheetData/x:row[@r='13']/x:c[@t='s']", 40);
+}
