+/** A run of text cells of one row, side by side, as the .xlsx export keeps them until it writes the sheet.
+
+    The export created one XclExpLabelCell record per text cell (about 90 bytes on the heap with its slot in the
+    row) and held all of them until the sheet was written: 5.3 million text cells took about 480 MB at the peak of
+    saving a 50 MB workbook. For .xlsx such a finished cell needs only its shared string index and its cell format
+    identifier (XclExpLabelCell::SaveXml writes nothing else), so the cells of a run are kept as 8 bytes each.
+
+    Each text cell is still created as an XclExpLabelCell first, so the string table, the fonts and the cell formats
+    are registered exactly as before and in the same order; only the finished record is replaced. SaveXml writes
+    the same elements and attributes as XclExpLabelCell::SaveXml, cell by cell. Not used for the binary formats,
+    for the base cell of a merged range (the row reads IsMultiLineText for it) or for formatted (edit) text. The
+    row's finalisation sees these runs as non-blank cells, as it saw the single text cells, so the default row
+    format, the blank cells and the dimensions are computed as before.
+
+    The environment variable HST_SC_XLSX_PACKED_LABELS_OFF keeps one record per text cell (used by a test to
+    compare both paths). */
+class HstXlsxPackedLabels final : public XclExpCellBase
+{
+public:
+    /** True when the text cells of an .xlsx export are packed into runs. */
+    static bool IsEnabled(const XclExpRoot& rRoot)
+    {
+        return rRoot.GetOutput() != EXC_OUTPUT_BINARY && !std::getenv("HST_SC_XLSX_PACKED_LABELS_OFF");
+    }
+
+    explicit HstXlsxPackedLabels(const XclExpLabelCell& rCell)
+        : XclExpCellBase(EXC_ID_LABELSST, 0, rCell.GetXclPos())
+    {
+        maEntries.push_back({ rCell.GetFirstXFId(), rCell.GetSstIndex() });
+    }
+
+    virtual sal_uInt16 GetLastXclCol() const override
+    {
+        return static_cast<sal_uInt16>(GetXclCol() + maEntries.size() - 1);
+    }
+    virtual sal_uInt32 GetFirstXFId() const override { return maEntries.front().mnXFId; }
+    virtual bool IsEmpty() const override { return false; }
+
+    /** Takes over a run that starts right after this one in the same row. */
+    virtual bool TryMerge(const XclExpCellBase& rCell) override
+    {
+        const HstXlsxPackedLabels* pRun = dynamic_cast<const HstXlsxPackedLabels*>(&rCell);
+        if (!pRun || pRun->GetXclRow() != GetXclRow() || pRun->GetXclCol() != GetLastXclCol() + 1)
+            return false;
+        maEntries.insert(maEntries.end(), pRun->maEntries.begin(), pRun->maEntries.end());
+        return true;
+    }
+
+    /** Nothing to convert: SaveXml looks the cell format index up from the identifier, as the single cells do. */
+    virtual void ConvertXFIndexes(const XclExpRoot&) override {}
+
+    virtual void Save(XclExpStream&) override
+    {
+        OSL_FAIL("HstXlsxPackedLabels::Save - text cells are packed for .xlsx only");
+    }
+
+    virtual void SaveXml(XclExpXmlStream& rStrm) override
+    {
+        sax_fastparser::FSHelperPtr& rWorksheet = rStrm.GetCurrentStream();
+        const XclExpXFBuffer& rXFBuffer = rStrm.GetRoot().GetXFBuffer();
+        XclAddress aPos(GetXclPos());
+        for (const Entry& rEntry : maEntries)
+        {
+            const sal_uInt16 nXFIndex = rXFBuffer.GetXFIndex(rEntry.mnXFId);
+            rWorksheet->startElement(::oox::XML_c,
+                ::oox::XML_r, XclXmlUtils::ToOString(rStrm.GetRoot().GetStringBuf(), aPos).getStr(),
+                ::oox::XML_s, OString::number(rXFBuffer.GetXmlCellIndex(nXFIndex)),
+                ::oox::XML_t, "s");
+            rWorksheet->startElement(::oox::XML_v);
+            rWorksheet->write(static_cast<sal_Int32>(rEntry.mnSstIndex));
+            rWorksheet->endElement(::oox::XML_v);
+            rWorksheet->endElement(::oox::XML_c);
+            ++aPos.mnCol;
+        }
+    }
+
+private:
+    struct Entry
+    {
+        sal_uInt32 mnXFId;
+        sal_uInt32 mnSstIndex;
+    };
+    std::vector<Entry> maEntries;
+};
