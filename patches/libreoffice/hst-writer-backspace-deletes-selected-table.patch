+namespace
+{
+/// Backspace on a whole selected table deletes the table (as Word does); Delete only clears the
+/// cells, and any other selection keeps the usual Backspace behaviour.
+class HstSelectedTableDeleteTest : public SwModelTestBase
+{
+public:
+    HstSelectedTableDeleteTest()
+        : SwModelTestBase(u"/sw/qa/uibase/hst/data/"_ustr)
+    {
+    }
+
+protected:
+    sal_Int32 tableCount()
+    {
+        uno::Reference<text::XTextTablesSupplier> xSupplier(mxComponent, uno::UNO_QUERY_THROW);
+        uno::Reference<container::XIndexAccess> xTables(xSupplier->getTextTables(),
+                                                        uno::UNO_QUERY_THROW);
+        return xTables->getCount();
+    }
+
+    uno::Reference<text::XTextTable> table(const OUString& rName)
+    {
+        uno::Reference<text::XTextTablesSupplier> xSupplier(mxComponent, uno::UNO_QUERY_THROW);
+        return uno::Reference<text::XTextTable>(xSupplier->getTextTables()->getByName(rName),
+                                                uno::UNO_QUERY_THROW);
+    }
+
+    uno::Reference<text::XText> cell(const OUString& rTable, const OUString& rCell)
+    {
+        return uno::Reference<text::XText>(table(rTable)->getCellByName(rCell),
+                                           uno::UNO_QUERY_THROW);
+    }
+
+    OUString cellText(const OUString& rTable, const OUString& rCell)
+    {
+        return cell(rTable, rCell)->getString();
+    }
+
+    /// Puts the view cursor at the start of a cell.
+    void gotoCell(const OUString& rTable, const OUString& rCell)
+    {
+        uno::Reference<frame::XModel> xModel(mxComponent, uno::UNO_QUERY_THROW);
+        uno::Reference<text::XTextViewCursorSupplier> xSupplier(xModel->getCurrentController(),
+                                                                uno::UNO_QUERY_THROW);
+        uno::Reference<text::XText> xCell = cell(rTable, rCell);
+        xSupplier->getViewCursor()->gotoRange(xCell->getStart(), false);
+        Scheduler::ProcessEventsToIdle();
+    }
+
+    /// Ctrl+A twice in a cell: the first selects the cell text, the second the whole table.
+    void selectWholeTableFrom(const OUString& rTable, const OUString& rCell)
+    {
+        gotoCell(rTable, rCell);
+        dispatchCommand(mxComponent, u".uno:SelectAll"_ustr, {});
+        dispatchCommand(mxComponent, u".uno:SelectAll"_ustr, {});
+        CPPUNIT_ASSERT(getSwDocShell()->GetWrtShell()->IsTableMode());
+    }
+
+    void pressKey(sal_uInt16 nKey)
+    {
+        SwXTextDocument* pTextDoc = getSwTextDoc();
+        pTextDoc->postKeyEvent(LOK_KEYEVENT_KEYINPUT, 0, nKey);
+        pTextDoc->postKeyEvent(LOK_KEYEVENT_KEYUP, 0, nKey);
+        Scheduler::ProcessEventsToIdle();
+    }
+
+    OUString cursorParagraphText()
+    {
+        SwWrtShell* pWrtShell = getSwDocShell()->GetWrtShell();
+        const SwTextNode* pNode = pWrtShell->GetCursor()->GetPointNode().GetTextNode();
+        CPPUNIT_ASSERT(pNode);
+        CPPUNIT_ASSERT(!pNode->FindTableNode());
+        return pNode->GetText();
+    }
+
+    size_t undoCount() { return getSwDoc()->GetUndoManager().GetUndoActionCount(); }
+
+    void assertTableIntact(const OUString& rTable)
+    {
+        CPPUNIT_ASSERT_EQUAL(u"A1"_ustr, cellText(rTable, u"A1"_ustr));
+        CPPUNIT_ASSERT_EQUAL(u"B1"_ustr, cellText(rTable, u"B1"_ustr));
+        CPPUNIT_ASSERT_EQUAL(u"A2"_ustr, cellText(rTable, u"A2"_ustr));
+        CPPUNIT_ASSERT_EQUAL(u"B2"_ustr, cellText(rTable, u"B2"_ustr));
+    }
+};
+
+CPPUNIT_TEST_FIXTURE(HstSelectedTableDeleteTest, testBackspaceDeletesWholeTable)
+{
+    createSwDoc("hst-table-between-paragraphs.fodt");
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(1), tableCount());
+    selectWholeTableFrom(u"Table1"_ustr, u"B2"_ustr);
+    const size_t nUndo = undoCount();
+
+    pressKey(KEY_BACKSPACE);
+
+    // The table is gone (before: only the cell texts were cleared) and the cursor is in the
+    // paragraph that followed it.
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(0), tableCount());
+    CPPUNIT_ASSERT_EQUAL(u"after"_ustr, cursorParagraphText());
+    CPPUNIT_ASSERT_EQUAL(nUndo + 1, undoCount());
+
+    // One undo step brings the whole table back with its content.
+    dispatchCommand(mxComponent, u".uno:Undo"_ustr, {});
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(1), tableCount());
+    assertTableIntact(u"Table1"_ustr);
+    CPPUNIT_ASSERT_EQUAL(nUndo, undoCount());
+}
+
+CPPUNIT_TEST_FIXTURE(HstSelectedTableDeleteTest, testDeleteKeyOnlyClearsWholeTable)
+{
+    createSwDoc("hst-table-between-paragraphs.fodt");
+    selectWholeTableFrom(u"Table1"_ustr, u"A1"_ustr);
+
+    pressKey(KEY_DELETE);
+
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(1), tableCount());
+    CPPUNIT_ASSERT_EQUAL(OUString(), cellText(u"Table1"_ustr, u"A1"_ustr));
+    CPPUNIT_ASSERT_EQUAL(OUString(), cellText(u"Table1"_ustr, u"B1"_ustr));
+    CPPUNIT_ASSERT_EQUAL(OUString(), cellText(u"Table1"_ustr, u"A2"_ustr));
+    CPPUNIT_ASSERT_EQUAL(OUString(), cellText(u"Table1"_ustr, u"B2"_ustr));
+}
+
+CPPUNIT_TEST_FIXTURE(HstSelectedTableDeleteTest, testBackspaceOnSomeCellsKeepsTable)
+{
+    createSwDoc("hst-table-between-paragraphs.fodt");
+    // Shift+Right from the start of A1 into B1: a cell selection of the first row only.
+    gotoCell(u"Table1"_ustr, u"A1"_ustr);
+    for (int i = 0; i < 3; ++i)
+        pressKey(KEY_SHIFT | KEY_RIGHT);
+    CPPUNIT_ASSERT(getSwDocShell()->GetWrtShell()->IsTableMode());
+
+    pressKey(KEY_BACKSPACE);
+
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(1), tableCount());
+    CPPUNIT_ASSERT_EQUAL(OUString(), cellText(u"Table1"_ustr, u"A1"_ustr));
+    CPPUNIT_ASSERT_EQUAL(OUString(), cellText(u"Table1"_ustr, u"B1"_ustr));
+    CPPUNIT_ASSERT_EQUAL(u"A2"_ustr, cellText(u"Table1"_ustr, u"A2"_ustr));
+    CPPUNIT_ASSERT_EQUAL(u"B2"_ustr, cellText(u"Table1"_ustr, u"B2"_ustr));
+}
+
+CPPUNIT_TEST_FIXTURE(HstSelectedTableDeleteTest, testBackspaceOnCellTextKeepsTable)
+{
+    createSwDoc("hst-table-between-paragraphs.fodt");
+    // Select all the text of one cell (the first Ctrl+A).
+    gotoCell(u"Table1"_ustr, u"B2"_ustr);
+    dispatchCommand(mxComponent, u".uno:SelectAll"_ustr, {});
+
+    pressKey(KEY_BACKSPACE);
+
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(1), tableCount());
+    CPPUNIT_ASSERT_EQUAL(OUString(), cellText(u"Table1"_ustr, u"B2"_ustr));
+    CPPUNIT_ASSERT_EQUAL(u"A2"_ustr, cellText(u"Table1"_ustr, u"A2"_ustr));
+}
+
+CPPUNIT_TEST_FIXTURE(HstSelectedTableDeleteTest, testBackspaceDeletesInnerNestedTable)
+{
+    createSwDoc("hst-nested-tables.fodt");
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(2), tableCount());
+    selectWholeTableFrom(u"Inner"_ustr, u"B2"_ustr);
+
+    pressKey(KEY_BACKSPACE);
+
+    // Only the inner table goes; the outer table and its own text stay.
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(1), tableCount());
+    CPPUNIT_ASSERT_EQUAL(u"A1"_ustr, cellText(u"Outer"_ustr, u"A1"_ustr));
+    CPPUNIT_ASSERT_EQUAL(u"B2"_ustr, cellText(u"Outer"_ustr, u"B2"_ustr));
+
+    dispatchCommand(mxComponent, u".uno:Undo"_ustr, {});
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(2), tableCount());
+    CPPUNIT_ASSERT_EQUAL(u"iB2"_ustr, cellText(u"Inner"_ustr, u"B2"_ustr));
+}
+
+CPPUNIT_TEST_FIXTURE(HstSelectedTableDeleteTest, testBackspaceDeletesOuterTableWithNestedTable)
+{
+    createSwDoc("hst-nested-tables.fodt");
+    // The outer table's first cell starts with the inner table, so the table cursor of the
+    // whole outer table starts inside the inner table.
+    selectWholeTableFrom(u"Outer"_ustr, u"B2"_ustr);
+
+    pressKey(KEY_BACKSPACE);
+
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(0), tableCount());
+    CPPUNIT_ASSERT_EQUAL(u"after"_ustr, cursorParagraphText());
+
+    dispatchCommand(mxComponent, u".uno:Undo"_ustr, {});
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(2), tableCount());
+}
+
+CPPUNIT_TEST_FIXTURE(HstSelectedTableDeleteTest, testBackspaceDeletesTableAtDocumentStart)
+{
+    createSwDoc("hst-table-at-start.fodt");
+    selectWholeTableFrom(u"Table1"_ustr, u"A1"_ustr);
+
+    pressKey(KEY_BACKSPACE);
+
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(0), tableCount());
+    CPPUNIT_ASSERT_EQUAL(u"after"_ustr, cursorParagraphText());
+
+    dispatchCommand(mxComponent, u".uno:Undo"_ustr, {});
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(1), tableCount());
+    assertTableIntact(u"Table1"_ustr);
+}
+
+CPPUNIT_TEST_FIXTURE(HstSelectedTableDeleteTest, testBackspaceDeletesTableAtDocumentEnd)
+{
+    createSwDoc("hst-table-at-end.fodt");
+    selectWholeTableFrom(u"Table1"_ustr, u"A1"_ustr);
+
+    pressKey(KEY_BACKSPACE);
+
+    // No paragraph after the table: the cursor goes to the one before it.
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(0), tableCount());
+    CPPUNIT_ASSERT_EQUAL(u"before"_ustr, cursorParagraphText());
+
+    dispatchCommand(mxComponent, u".uno:Undo"_ustr, {});
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(1), tableCount());
+    assertTableIntact(u"Table1"_ustr);
+}
+
+CPPUNIT_TEST_FIXTURE(HstSelectedTableDeleteTest, testBackspaceDeletesOnlyTableInDocument)
+{
+    createSwDoc("hst-table-only.fodt");
+    selectWholeTableFrom(u"Table1"_ustr, u"A1"_ustr);
+
+    pressKey(KEY_BACKSPACE);
+
+    // The document keeps one empty paragraph for the cursor.
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(0), tableCount());
+    CPPUNIT_ASSERT_EQUAL(OUString(), cursorParagraphText());
+
+    dispatchCommand(mxComponent, u".uno:Undo"_ustr, {});
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(1), tableCount());
+    assertTableIntact(u"Table1"_ustr);
+}
+
+CPPUNIT_TEST_FIXTURE(HstSelectedTableDeleteTest, testBackspaceDeletesTableWithTrackChanges)
+{
+    createSwDoc("hst-table-between-paragraphs.fodt");
+    dispatchCommand(mxComponent, u".uno:TrackChanges"_ustr, {});
+    selectWholeTableFrom(u"Table1"_ustr, u"A1"_ustr);
+
+    pressKey(KEY_BACKSPACE);
+
+    // As with Table > Delete > Table under change tracking (Show Changes on): the table stays
+    // visible, every row is recorded as a tracked row deletion. Clearing the cells (the old
+    // Backspace) would only track text deletions and keep HasTextChangesOnly = true.
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(1), tableCount());
+    uno::Reference<container::XIndexAccess> xRows(table(u"Table1"_ustr)->getRows(),
+                                                  uno::UNO_QUERY_THROW);
+    for (sal_Int32 nRow = 0; nRow < xRows->getCount(); ++nRow)
+    {
+        uno::Reference<beans::XPropertySet> xRow(xRows->getByIndex(nRow), uno::UNO_QUERY_THROW);
+        CPPUNIT_ASSERT(!getProperty<bool>(xRow, u"HasTextChangesOnly"_ustr));
+    }
+    CPPUNIT_ASSERT(!getSwDoc()->getIDocumentRedlineAccess().GetRedlineTable().empty());
+
+    // Rejecting all changes brings the table back unchanged.
+    dispatchCommand(mxComponent, u".uno:RejectAllTrackedChanges"_ustr, {});
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(1), tableCount());
+    assertTableIntact(u"Table1"_ustr);
+}
+}
