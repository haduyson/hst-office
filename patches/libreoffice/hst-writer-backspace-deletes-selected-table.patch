+
+class SwWrtShell;
+
+namespace hst
+{
+/// Backspace on a selection that covers every cell of one table removes the whole table, the
+/// way Word does. The table goes in one undo step through the same core call as
+/// Table > Delete > Table, so change tracking behaves as it does for that command.
+///
+/// Returns false and changes nothing when the selection is not a whole table (a text selection,
+/// some of the cells, a table already deleted in tracked changes, a DDE table, read-only or
+/// protected cells): the caller then keeps its usual Backspace behaviour.
+bool DeleteWholeSelectedTable(SwWrtShell& rShell);
+}
