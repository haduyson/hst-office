+/// The table whose cells are all in the current table selection, or nullptr. With nested
+/// tables this is the table the selected cells belong to, i.e. the innermost fully selected one.
+const SwTableNode* FullySelectedTable(const SwWrtShell& rShell)
+{
+    if (!rShell.IsTableMode())
+        return nullptr;
+
+    SwSelBoxes aBoxes;
+    ::GetTableSelCrs(rShell, aBoxes);
+    if (aBoxes.empty() || ::HasProtectedCells(aBoxes))
+        return nullptr;
+
+    const SwStartNode* pFirstBox = aBoxes[0]->GetSttNd();
+    const SwTableNode* pTableNode = pFirstBox ? pFirstBox->FindTableNode() : nullptr;
+    if (!pTableNode)
+        return nullptr;
+
+    const SwTable& rTable = pTableNode->GetTable();
+    if (aBoxes.size() != rTable.GetTabSortBoxes().size())
+        return nullptr;
+    for (const SwTableBox* pBox : aBoxes)
+    {
+        const SwStartNode* pStart = pBox->GetSttNd();
+        if (!pStart || pStart->FindTableNode() != pTableNode)
+            return nullptr;
+    }
+    return pTableNode;
+}
+
+/// First visible paragraph that belongs directly to rTable (not to a table nested in it).
+SwContentNode* FirstOwnContent(const SwWrtShell& rShell, const SwTableNode& rTable)
+{
+    const SwNodes& rNodes = rTable.GetNodes();
+    const SwNodeOffset nEnd = rTable.EndOfSectionIndex();
+    for (SwNodeOffset n = rTable.GetIndex() + 1; n < nEnd; ++n)
+    {
+        SwNode* pNode = rNodes[n];
+        if (pNode->IsTableNode())
+        {
+            n = pNode->EndOfSectionIndex(); // skip the nested table
+            continue;
+        }
+        SwContentNode* pContent = pNode->GetContentNode();
+        if (pContent && pContent->getLayoutFrame(rShell.GetLayout()))
+            return pContent;
+    }
+    return nullptr;
+}
+}
+
+namespace hst
+{
+bool DeleteWholeSelectedTable(SwWrtShell& rShell)
+{
+    if (rShell.HasReadonlySel())
+        return false;
+
+    const SwTableNode* pTableNode = FullySelectedTable(rShell);
+    if (!pTableNode)
+        return false;
+
+    const SwTable& rTable = pTableNode->GetTable();
+    if (dynamic_cast<const SwDDETable*>(&rTable))
+        return false; // the core refuses with a message box; keep the old Backspace instead
+    // A table already deleted in tracked changes, seen in Show Changes mode, cannot be deleted
+    // again (the Delete Table command is disabled there as well).
+    if (rTable.IsDeleted() && !rShell.GetLayout()->IsHideRedlines())
+        return false;
+
+    SwContentNode* pAnchor = FirstOwnContent(rShell, *pTableNode);
+    if (!pAnchor)
+        return false;
+
+    rShell.StartAction();
+    rShell.StartUndo(SwUndoId::UI_TABLE_DELETE);
+
+    // Put the cursor inside the selected table itself (with nested tables the table cursor may
+    // sit in an inner table), select that table and delete it as the Delete Table command does.
+    rShell.EnterStdMode();
+    SwPaM* pCursor = rShell.GetCursor();
+    pCursor->DeleteMark();
+    pCursor->GetPoint()->Assign(*pAnchor, 0);
+    rShell.MoveTable(GotoCurrTable, fnTableStart);
+    rShell.SttSelect();
+    rShell.MoveTable(GotoCurrTable, fnTableEnd);
+    rShell.EndSelect();
+    rShell.DeleteTable();
+
+    rShell.EndUndo(SwUndoId::UI_TABLE_DELETE);
+    rShell.EndAction();
+    return true;
+}
+}
