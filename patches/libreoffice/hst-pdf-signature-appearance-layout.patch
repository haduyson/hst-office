+/// "dd/mm/yyyy hh:mm:ss +07:00": the signing time with seconds and its UTC offset, as signed
+/// administrative documents and the CA signing tools show it
+OUString formatSigningTime(const DateTime& rNow)
+{
+    const util::DateTime aNow = rNow.GetUNODateTime();
+    const tools::Time aOffset = tools::Time::GetUTCOffset();
+    // an OUString, not the concatenation of the lambda's temporaries it would deduce
+    const auto twoDigits = [](sal_Int32 n) -> OUString {
+        return (n < 10 ? u"0"_ustr : OUString()) + OUString::number(n);
+    };
+    return formatDate(aNow, true) + ":" + twoDigits(aNow.Seconds) + " "
+           + (aOffset.GetTime() < 0 ? u"-" : u"+") + twoDigits(aOffset.GetHour()) + ":"
+           + twoDigits(aOffset.GetMin());
+}
+
+/// The organisation (O) of a distinguished name when it is not already the common name.
+OUString organisation(const OUString& rDistinguishedName, const OUString& rCommonName)
+{
+    for (const auto& [rType, rValue] : comphelper::xmlsec::parseDN(rDistinguishedName))
+    {
+        if (rType == "O")
+        {
+            const OUString aValue = rValue.trim();
+            return aValue.equalsIgnoreAsciiCase(rCommonName) ? OUString() : aValue;
+        }
+    }
+    return OUString();
+}
+
+/// The serif family of the signature box. Liberation Serif comes with the suite on every platform,
+/// has the metrics of Times New Roman (the font of administrative documents), covers Vietnamese and
+/// allows embedding. A family is taken only when it is installed and has every glyph of the text:
+/// the PDF writer then embeds it instead of silently substituting another font.
+OUString serifFamily(const OutputDevice& rDevice, const OUString& rText)
+{
+    const OUString aText = rText.replaceAll("\n", " ");
+    for (const OUString& rFamily : { u"Liberation Serif"_ustr, u"Noto Serif"_ustr,
+                                     u"Times New Roman"_ustr, u"DejaVu Serif"_ustr })
+    {
+        if (rDevice.IsFontAvailable(rFamily)
+            && rDevice.HasGlyphs(vcl::Font(rFamily, Size(0, 200)), aText) == -1)
+            return rFamily;
+    }
+    SAL_WARN("xmlsecurity.hstpdf", "no serif font has every glyph of the signature text");
+    return u"Liberation Serif"_ustr;
+}
