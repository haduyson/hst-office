HST Office: Word layouts keep a wide inline object beside a wrapping float, over the right margin (Writer).

In a document laid out like Word before 2013 (.doc, and .docx/.rtf in an older compatibility mode, where Writer
sets TabOverMargin), Word keeps an inline object that is the first content beside a square-wrapped float in that
line and lets it run over the right margin when it is wider than the room left. Writer moved the whole line
below the float. A worksheet with geometry figures beside MathType formulas (s036.doc) was 24 pages instead of
Word's 22: the formula line next to a figure jumped 194 pt down, and so on for each such figure.
SwFlyCntPortion::Format now keeps such an object in the line (hst::sw::KeepWideObjectBesideFly): only with
TabOverMargin, only when nothing but the float's room precedes it in the line and no other float follows.
Native documents and Word 2013+ layouts are unchanged.

Test: CppunitTest_sw_core_text testWideInlineObjectStaysBesideFloatInWordLayout and
testWideInlineObjectMovesBelowFloatOtherwise (minimal .docx in compatibility mode 14 and 15, stored in base64).

License: the new files sw/source/core/text/hstwideobjectbesidefly.{hxx,cxx} are LicenseRef-HST-Proprietary; the
upstream files remain under their original license (MPL-2.0).
---
--- a/sw/qa/core/text/txtfly.cxx
+++ b/sw/qa/core/text/txtfly.cxx
@@ -11,6 +11,10 @@
 
 #include <memory>
 
+#include <comphelper/base64.hxx>
+#include <tools/stream.hxx>
+#include <unotools/tempfile.hxx>
+
 #include <IDocumentLayoutAccess.hxx>
 #include <doc.hxx>
 #include <frame.hxx>
@@ -27,6 +31,24 @@
         : SwModelTestBase(u"/sw/qa/core/text/data/"_ustr)
     {
     }
+
+    /// Loads a .docx stored in base64 (patch files carry no binary data).
+    void loadBase64Docx(std::u16string_view rFileName)
+    {
+        SvFileStream aBase64File(createFileURL(rFileName), StreamMode::READ);
+        OStringBuffer aBase64;
+        OString aLine;
+        while (aBase64File.ReadLine(aLine))
+            aBase64.append(aLine);
+        css::uno::Sequence<sal_Int8> aBytes;
+        comphelper::Base64::decode(aBytes, OStringToOUString(aBase64, RTL_TEXTENCODING_ASCII_US));
+        CPPUNIT_ASSERT(aBytes.hasElements());
+        utl::TempFileNamed aDocx(u"hst-txtfly", true, u".docx");
+        aDocx.EnableKillingFile();
+        aDocx.GetStream(StreamMode::WRITE)->WriteBytes(aBytes.getConstArray(), aBytes.getLength());
+        aDocx.CloseStream();
+        loadFromURL(aDocx.GetURL());
+    }
 };
 
 CPPUNIT_TEST_FIXTURE(Test, testClearingBreakWrapThrough)
@@ -47,6 +69,38 @@
     // page.
     CPPUNIT_ASSERT(!pPage->GetNext());
 }
+
+CPPUNIT_TEST_FIXTURE(Test, testWideInlineObjectStaysBesideFloatInWordLayout)
+{
+    // Given a Word 2010 document: a square-wrapped 2 inch picture at the left, then a paragraph that only holds a
+    // 4.6 inch wide inline picture (wider than the room beside the float, narrower than the 6.5 inch column):
+    loadBase64Docx(u"hst-wide-object-beside-float.docx.b64");
+
+    // When laying out that document:
+    calcLayout();
+
+    // Then the inline picture stays beside the float and runs over the right margin, as in Word:
+    xmlDocUniquePtr pXmlDoc = parseLayoutDump();
+    sal_Int32 nFloatBottom = getXPath(pXmlDoc, "//txt[1]/anchored/fly/infos/bounds", "bottom").toInt32();
+    sal_Int32 nInlineTop = getXPath(pXmlDoc, "//txt[2]/anchored/fly/infos/bounds", "top").toInt32();
+    // Without the accompanying fix in place, the inline picture was moved below the float.
+    CPPUNIT_ASSERT_LESS(nFloatBottom, nInlineTop);
+}
+
+CPPUNIT_TEST_FIXTURE(Test, testWideInlineObjectMovesBelowFloatOtherwise)
+{
+    // Given the same content saved by Word 2013 or later (no content over the right margin):
+    loadBase64Docx(u"hst-wide-object-beside-float-word2013.docx.b64");
+
+    // When laying out that document:
+    calcLayout();
+
+    // Then the inline picture is still moved below the float:
+    xmlDocUniquePtr pXmlDoc = parseLayoutDump();
+    sal_Int32 nFloatBottom = getXPath(pXmlDoc, "//txt[1]/anchored/fly/infos/bounds", "bottom").toInt32();
+    sal_Int32 nInlineTop = getXPath(pXmlDoc, "//txt[2]/anchored/fly/infos/bounds", "top").toInt32();
+    CPPUNIT_ASSERT_GREATEREQUAL(nFloatBottom, nInlineTop);
+}
 }
 
