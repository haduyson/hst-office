+void AquaSalFrame::SetTabGroupMember( bool bMember )
+{
+    OSX_SALDATA_RUNINMAIN( SetTabGroupMember( bMember ) )
+
+    if( mbTabGroupMember == bMember )
+        return;
+    mbTabGroupMember = bMember;
+    auto it = std::find( s_aTabGroupFrames.begin(), s_aTabGroupFrames.end(), this );
+    if( bMember )
+    {
+        if( it == s_aTabGroupFrames.end() )
+            s_aTabGroupFrames.push_back( this );
+    }
+    else if( it != s_aTabGroupFrames.end() )
+        s_aTabGroupFrames.erase( it );
+    if( !mpNSWindow || mbHeadlessMode )
+        return;
+    // Switching tabs must look like a browser: no window animation (zoom, fade) on show and hide.
+    [mpNSWindow setAnimationBehavior: bMember ? NSWindowAnimationBehaviorNone
+                                              : NSWindowAnimationBehaviorDefault];
+    if( bMember )
+        [mpNSWindow setTabbingIdentifier: @"org.hasontech.hstoffice.document"];
+    else if( [mpNSWindow tabbedWindows] != nil )
+        [[mpNSWindow tabGroup] removeWindow: mpNSWindow];
+}
+
+void AquaSalFrame::joinNativeFullScreenTabs()
+{
+    if( !mpNSWindow || mbHeadlessMode || [mpNSWindow tabbedWindows] != nil )
+        return;
+    // Every native full screen window owns a Space, so showing a second window while the first
+    // one is full screen plays the Space swipe. As tabs of one NSWindow group they share the
+    // Space and the full screen state; selecting a tab (the show below) is instant. The native
+    // tab bar stays hidden: the document tab strip of HST Office is the one the user sees.
+    for( AquaSalFrame* pOther : s_aTabGroupFrames )
+    {
+        if( pOther == this || !pOther->mpNSWindow )
+            continue;
+        NSWindow* pWindow = pOther->mpNSWindow;
+        if( !([pWindow styleMask] & NSWindowStyleMaskFullScreen) )
+            continue;
+        [pWindow addTabbedWindow: mpNSWindow ordered: NSWindowAbove];
+        NSWindowTabGroup* pGroup = [pWindow tabGroup];
+        if( pGroup && [pGroup isTabBarVisible] )
+            [pWindow toggleTabBar: nil];
+        break;
+    }
+}
