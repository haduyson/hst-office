+// HST Office: called from vcl/source/window/syswin.cxx. A document tab window is shown and hidden
+// when the user switches tabs: turn off the DWM show/hide transition (fade and zoom) so the switch
+// is instant like a browser tab.
+void hst_win_set_tab_group_member( SalFrame* pFrame, bool bMember )
+{
+    WinSalFrame* pWinFrame = static_cast<WinSalFrame*>( pFrame );
+    if ( !pWinFrame || !pWinFrame->mhWnd )
+        return;
+    const BOOL bDisable = bMember ? TRUE : FALSE;
+    DwmSetWindowAttribute( pWinFrame->mhWnd, DWMWA_TRANSITIONS_FORCEDISABLED, &bDisable, sizeof(bDisable) );
+}
