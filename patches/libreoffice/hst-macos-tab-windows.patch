+// HST Office: the document tab group (framework) tells the frame of a tab window that it is a
+// group member. Only the macOS and Windows backends use it (no window animation; on macOS tabs
+// also share the native full screen Space); declared here and in the framework instead of a public header on purpose.
+#if defined MACOSX
+void hst_osx_set_tab_group_member(SalFrame* pFrame, bool bMember);
+#elif defined _WIN32
+void hst_win_set_tab_group_member(SalFrame* pFrame, bool bMember);
+#endif
+
+SAL_DLLPUBLIC_EXPORT void hst_vcl_set_tab_group_member(vcl::Window* pWindow, bool bMember)
+{
+#if defined MACOSX || defined _WIN32
+    if (!pWindow)
+        return;
+    SalFrame* pFrame = pWindow->ImplGetFrame();
+#if defined MACOSX
+    hst_osx_set_tab_group_member(pFrame, bMember);
+#else
+    hst_win_set_tab_group_member(pFrame, bMember);
+#endif
+#else
+    (void)pWindow;
+    (void)bMember;
+#endif
+}
