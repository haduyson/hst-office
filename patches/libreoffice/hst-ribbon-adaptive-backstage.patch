+/// The ribbon's tab control and the banner beside its groups, found below rRibbon.
+void lcl_findRibbonParts(const vcl::Window& rRibbon, const TabControl*& rpTabs, const vcl::Window*& rpBanner)
+{
+    for (const vcl::Window* pChild = rRibbon.GetWindow(GetWindowType::FirstChild); pChild && !(rpTabs && rpBanner);
+         pChild = pChild->GetWindow(GetWindowType::Next))
+    {
+        if (!rpTabs)
+            if (const TabControl* pTabs = dynamic_cast<const TabControl*>(pChild))
+                rpTabs = pTabs;
+        if (!rpBanner && dynamic_cast<const HstRibbonBanner*>(pChild))
+            rpBanner = pChild;
+        lcl_findRibbonParts(*pChild, rpTabs, rpBanner);
+    }
+}
