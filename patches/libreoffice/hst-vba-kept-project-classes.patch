+// A copy through StorageBase has names and bytes only, and a Frame's storage needs its class. Office
+// files have the class of a storage in its CompObj as well (MS-OLEDS 2.3.8), so it is read from there.
+void lclRestoreStorageClasses( SotStorage& rStorage )
+{
+    SvStorageInfoList aElements;
+    rStorage.FillInfoList( &aElements );
+    for( const SvStorageInfo& rElement : aElements )
+    {
+        if( !rElement.IsStorage() )
+            continue;
+        rtl::Reference< SotStorage > xChild = rStorage.OpenSotStorage( rElement.GetName(), StreamMode::STD_READWRITE );
+        if( !xChild.is() || xChild->GetError() != ERRCODE_NONE )
+            continue;
+        static constexpr OUString aCompObj = u"\001CompObj"_ustr;
+        if( xChild->IsStream( aCompObj ) )
+        {
+            std::vector< sal_uInt8 > aBytes;
+            {
+                rtl::Reference< SotStorageStream > xStream = xChild->OpenSotStream( aCompObj, StreamMode::STD_READ );
+                aBytes.resize( xStream->TellEnd() );
+                xStream->Seek( 0 );
+                aBytes.resize( xStream->ReadBytes( aBytes.data(), aBytes.size() ) );
+            }
+            SvGUID aId;
+            if( aBytes.size() >= 28 )
+            {
+                SvMemoryStream aRead( aBytes.data() + 12, 16, StreamMode::READ );
+                aRead.SetEndian( SvStreamEndian::LITTLE );
+                aRead.ReadUInt32( aId.Data1 ).ReadUInt16( aId.Data2 ).ReadUInt16( aId.Data3 );
+                aRead.ReadBytes( aId.Data4, 8 );
+                const SvGlobalName aName( aId );
+                if( aName != SvGlobalName() )
+                {
+                    // SetClass writes its own CompObj: the file's is put back as it was
+                    xChild->SetClass( aName, SotClipboardFormatId::NONE, OUString() );
+                    rtl::Reference< SotStorageStream > xStream = xChild->OpenSotStream( aCompObj, StreamMode::STD_READWRITE | StreamMode::TRUNC );
+                    xStream->Seek( 0 );
+                    xStream->WriteBytes( aBytes.data(), aBytes.size() );
+                    xStream->SetStreamSize( aBytes.size() );
+                    xStream->Commit();
+                }
+            }
+        }
+        lclRestoreStorageClasses( *xChild );
+        xChild->Commit();
+    }
+}
