+</body>
+</html>
--- a/sw/qa/extras/hst/hsthtmlpaste.cxx
+++ b/sw/qa/extras/hst/hsthtmlpaste.cxx
@@ -347,6 +347,27 @@
     openFixture("hst-web-paste-colors-on-white.html");
     CPPUNIT_ASSERT_EQUAL(Color(0xE2E5E9), runWith(u"gần trắng").aColor);
 }
+
+CPPUNIT_TEST_FIXTURE(HstHtmlPasteTest, testAbsolutePostFlowsInline)
+{
+    // Given a "text on coloured background" post: a block with "position: absolute" and peach
+    // text that was painted on a background image, when pasting it:
+    pasteFixture(u"hst-web-paste-absolute-post.html", SotClipboardFormatId::HTML_SIMPLE);
+
+    // Then there is no frame: the text is in the body text, still bold, and its colour reads on
+    // white. Before, a page-anchored frame held the text in rgb(255, 200, 145) without its image.
+    CPPUNIT_ASSERT_EQUAL(0, getShapes());
+    const Run aText = runWith(u"nhà ở xã hội được bán lại");
+    CPPUNIT_ASSERT_EQUAL(float(awt::FontWeight::BOLD), aText.fWeight);
+    CPPUNIT_ASSERT(readsOnWhite(aText.aColor, 4.5));
+}
+
+CPPUNIT_TEST_FIXTURE(HstHtmlPasteTest, testAbsolutePostOpenAsDocumentUnchanged)
+{
+    // Opening the same HTML as a document still positions the block in a frame.
+    openFixture("hst-web-paste-absolute-post.html");
+    CPPUNIT_ASSERT_EQUAL(1, getShapes());
+}
 }
 
 CPPUNIT_PLUGIN_IMPLEMENT();
