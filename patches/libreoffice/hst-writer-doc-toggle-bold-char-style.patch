+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ * This file is part of HST Office.
+ */
+
+#pragma once
+
+#include <sal/types.h>
+
+class SwWW8StyInf;
+
+namespace hst::sw::ww8
+{
+/** Whether the style value that a toggle property of a run (bold, italic, ...: sprm value 0x80 "as the style",
+    0x81 "opposite of the style") refers to is on.
+
+    Word combines the toggle properties of the paragraph style and of the run's character style: a character style
+    that turns bold on over a bold paragraph style gives regular text, one that leaves bold alone keeps the
+    paragraph style's bold. The style value is the paragraph style's value XOR the character style's. The import
+    looked at the character style alone when the run had one, so text in a character style that does not set bold
+    over a bold Normal style ("opposite of the style": regular in Word) came out bold.
+
+    nMask: the bit of the property in SwWW8StyInf::m_n81Flags. pCharStyle: null when the run has no character
+    style. */
+bool ToggleStyleValue(const SwWW8StyInf* pParaStyle, const SwWW8StyInf* pCharStyle, sal_uInt16 nMask);
+}
+
+/* vim:set shiftwidth=4 softtabstop=4 expandtab: */
--- /dev/null
+++ b/sw/source/filter/ww8/hstwwtogglestyle.cxx
@@ -0,0 +1,21 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ * This file is part of HST Office.
+ */
+
+#include "hstwwtogglestyle.hxx"
+
+#include "ww8par.hxx"
+
+namespace hst::sw::ww8
+{
+bool ToggleStyleValue(const SwWW8StyInf* pParaStyle, const SwWW8StyInf* pCharStyle, sal_uInt16 nMask)
+{
+    const bool bPara = pParaStyle && (pParaStyle->m_n81Flags & nMask);
+    const bool bChar = pCharStyle && (pCharStyle->m_n81Flags & nMask);
+    return bPara != bChar;
+}
+}
