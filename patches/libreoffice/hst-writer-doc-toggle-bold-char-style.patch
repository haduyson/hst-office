+    /// Loads a .doc kept as base64 text (patches carry no binary files).
+    void loadBase64Doc(std::u16string_view rFileName)
+    {
+        SvFileStream aBase64File(createFileURL(rFileName), StreamMode::READ);
+        OStringBuffer aBase64;
+        OString aLine;
+        while (aBase64File.ReadLine(aLine))
+            aBase64.append(aLine);
+        uno::Sequence<sal_Int8> aBytes;
+        comphelper::Base64::decode(aBytes, OStringToOUString(aBase64, RTL_TEXTENCODING_ASCII_US));
+        CPPUNIT_ASSERT(aBytes.hasElements());
+        utl::TempFileNamed aDoc(u"hst-ww8import", true, u".doc");
+        aDoc.EnableKillingFile();
+        aDoc.GetStream(StreamMode::WRITE)->WriteBytes(aBytes.getConstArray(), aBytes.getLength());
+        aDoc.CloseStream();
+        loadFromURL(aDoc.GetURL());
+    }
 };
 
+CPPUNIT_TEST_FIXTURE(Test, testToggleBoldOverCharacterStyle)
+{
+    // Given a Word document whose Normal style is bold, with a run in a character style that leaves bold alone
+    // and bold turned off on the run ("opposite of the style"):
+    loadBase64Doc(u"hst-toggle-bold-char-style.doc.b64");
+
+    uno::Reference<text::XTextRange> xParagraph = getParagraph(1);
+    // The text in the paragraph style alone stays bold:
+    CPPUNIT_ASSERT_EQUAL(awt::FontWeight::BOLD,
+                         getProperty<float>(getRun(xParagraph, 1, u"Bold paragraph text. "_ustr), u"CharWeight"_ustr));
+    // Then the run is regular, as in Word: the style value of a toggle property is the paragraph style's combined
+    // with the character style's. Without the accompanying fix in place, the run was bold (only the character
+    // style was looked at).
+    uno::Reference<text::XTextRange> xRun = getRun(xParagraph, 2, u"Regular text in a character style."_ustr);
+    CPPUNIT_ASSERT_EQUAL(awt::FontWeight::NORMAL, getProperty<float>(xRun, u"CharWeight"_ustr));
+}
