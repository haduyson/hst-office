+namespace formula
+{
+namespace
+{
+bool IsSpace(const FormulaToken* p)
+{
+    const OpCode e = p->GetOpCode();
+    return e == ocSpaces || e == ocWhitespace;
+}
+
+/// Operators that combine references into a larger reference; they bind the @ operand.
+bool IsReferenceOperator(OpCode e) { return e == ocRange || e == ocIntersect || e == ocUnion; }
+
+/// Prefix operators that may stand in front of an operand.
+bool IsPrefixOperator(OpCode e)
+{
+    return e == ocAdd || e == ocSub || e == ocNegSub || e == ocSingleValue;
+}
+
+/// Tokens that open or close a nested level whose content belongs to the current operand.
+int NestingStep(OpCode e)
+{
+    switch (e)
+    {
+        case ocOpen:
+        case ocArrayOpen:
+        case ocTableRefOpen:
+            return 1;
+        case ocClose:
+        case ocArrayClose:
+        case ocTableRefClose:
+            return -1;
+        default:
+            return 0;
+    }
+}
+
+/// A token that is a complete operand on its own (reference, constant, name).
+bool IsPlainOperand(const FormulaToken* p)
+{
+    switch (p->GetType())
+    {
+        case svSingleRef:
+        case svDoubleRef:
+        case svExternalSingleRef:
+        case svExternalDoubleRef:
+        case svExternalName:
+        case svDouble:
+        case svString:
+        case svIndex:
+        case svError:
+            return true;
+        default:
+            return false;
+    }
+}
+}
+
+HstFormulaStringWriter::HstFormulaStringWriter(FormulaCompiler& rCompiler)
+    : mrCompiler(rCompiler)
+{
+}
+
+bool HstFormulaStringWriter::IsUiLanguage() const
+{
+    if (!mrCompiler.mxSymbols)
+        return false;
+    // Files written in the Excel A1 notation of OOXML never get the UI forms.
+    if (FormulaGrammar::extractRefConvention(mrCompiler.meGrammar) == FormulaGrammar::CONV_XL_OOX)
+        return false;
+    switch (FormulaGrammar::extractFormulaLanguage(mrCompiler.mxSymbols->getGrammar()))
+    {
+        case css::sheet::FormulaLanguage::NATIVE:
+        case css::sheet::FormulaLanguage::ENGLISH:
+        case css::sheet::FormulaLanguage::XL_ENGLISH:
+            return true;
+        default:
+            return false;
+    }
+}
+
+void HstFormulaStringWriter::CloseBefore(OUStringBuffer& rBuffer, const FormulaToken* t)
+{
+    while (!maSingleValueEnds.empty() && t && maSingleValueEnds.back() == t)
+    {
+        rBuffer.append(')');
+        maSingleValueEnds.pop_back();
+    }
+}
+
+bool HstFormulaStringWriter::Write(OUStringBuffer& rBuffer, const FormulaToken*& t)
+{
+    if (!t || !mrCompiler.mpArr || !mrCompiler.mxSymbols)
+        return false;
+
+    // Work on the code array positions: t must be the token just delivered by the iterator.
+    const sal_uInt16 nNext = mrCompiler.maArrIterator.GetIndex();
+    if (nNext == 0 || nNext > mrCompiler.mpArr->GetLen()
+        || mrCompiler.mpArr->GetArray()[nNext - 1] != t)
+        return false;
+
+    switch (t->GetOpCode())
+    {
+        case ocAnchorArray:
+            return WriteSpillRange(rBuffer, t);
+        case ocSingleValue:
+            return WriteSingleValue(rBuffer, t);
+        default:
+            return false;
+    }
+}
+
+void HstFormulaStringWriter::Finish(OUStringBuffer& rBuffer, const FormulaToken* t)
+{
+    if (t)
+        return; // Writing stopped early, the text is incomplete anyway.
+    for (size_t n = maSingleValueEnds.size(); n > 0; --n)
+        rBuffer.append(')');
+    maSingleValueEnds.clear();
+}
+
+bool HstFormulaStringWriter::WriteSpillRange(OUStringBuffer& rBuffer, const FormulaToken*& t)
+{
+    if (!IsUiLanguage())
+        return false;
+
+    // Exactly ANCHORARRAY ( single-cell reference ), without spaces: written as A1#.
+    FormulaToken* const* pCode = mrCompiler.mpArr->GetArray();
+    const sal_uInt16 nLen = mrCompiler.mpArr->GetLen();
+    const sal_uInt16 nOpen = mrCompiler.maArrIterator.GetIndex();
+    if (nOpen + 2 >= nLen)
+        return false;
+    if (pCode[nOpen]->GetOpCode() != ocOpen || pCode[nOpen + 1]->GetType() != svSingleRef
+        || pCode[nOpen + 2]->GetOpCode() != ocClose)
+        return false;
+
+    mrCompiler.CreateStringFromToken(rBuffer, pCode[nOpen + 1], false);
+    rBuffer.append('#');
+
+    mrCompiler.maArrIterator.Jump(nOpen + 3);
+    t = mrCompiler.maArrIterator.Next();
+    return true;
+}
+
+bool HstFormulaStringWriter::WriteSingleValue(OUStringBuffer& rBuffer, const FormulaToken*& t)
+{
+    FormulaToken* const* pCode = mrCompiler.mpArr->GetArray();
+    const sal_uInt16 nLen = mrCompiler.mpArr->GetLen();
+    const sal_uInt16 nFirst = mrCompiler.maArrIterator.GetIndex(); // the token after @
+
+    sal_uInt16 nOperand = nFirst; // first non-space token after @
+    while (nOperand < nLen && IsSpace(pCode[nOperand]))
+        ++nOperand;
+    const bool bParenthesised = nOperand < nLen && pCode[nOperand]->GetOpCode() == ocOpen;
+
+    const OUString& rSymbol = mrCompiler.mxSymbols->getSymbol(ocSingleValue);
+    const bool bOperatorForm = rSymbol == "@";
+
+    if (bOperatorForm)
+    {
+        // UI: @(A1:A9) as read from a file shows as @A1:A9 when the parentheses hold one
+        // operand that can stand without them (references joined by the range operator).
+        if (!IsUiLanguage() || !bParenthesised || nOperand != nFirst)
+            return false;
+        sal_uInt16 nClose = nOperand + 1;
+        bool bExpectOperand = true;
+        while (nClose < nLen)
+        {
+            const FormulaToken* p = pCode[nClose];
+            if (bExpectOperand && IsPlainOperand(p))
+                bExpectOperand = false;
+            else if (!bExpectOperand && p->GetOpCode() == ocRange)
+                bExpectOperand = true;
+            else
+                break;
+            ++nClose;
+        }
+        if (nClose >= nLen || bExpectOperand || pCode[nClose]->GetOpCode() != ocClose)
+            return false;
+
+        rBuffer.append(rSymbol);
+        for (sal_uInt16 n = nOperand + 1; n < nClose; ++n)
+            mrCompiler.CreateStringFromToken(rBuffer, pCode[n], false);
+        mrCompiler.maArrIterator.Jump(nClose + 1);
+        t = mrCompiler.maArrIterator.Next();
+        return true;
+    }
+
+    // Function form (OOXML _xlfn.SINGLE): the operand must be in parentheses.
+    if (bParenthesised)
+        return false; // written as is: _xlfn.SINGLE(...)
+
+    // Find the token the operand ends before; nullptr is the formula end.
+    const FormulaToken* pEnd = nullptr;
+    sal_uInt16 nSpaceRun = 0; // start of the spaces just before the current position, 0 if none
+    int nDepth = 0;
+    bool bExpectOperand = true;
+    for (sal_uInt16 n = nFirst; n < nLen; ++n)
+    {
+        const FormulaToken* p = pCode[n];
+        const OpCode e = p->GetOpCode();
+        if (IsSpace(p))
+        {
+            if (nDepth == 0 && !bExpectOperand && nSpaceRun == 0)
+                nSpaceRun = n;
+            continue;
+        }
+        const int nStep = NestingStep(e);
+        if (nDepth > 0)
+        {
+            nDepth += nStep;
+            if (nDepth == 0)
+                bExpectOperand = false;
+            continue;
+        }
+        if (nStep > 0)
+        {
+            // A parenthesised operand, a function's argument list or an inline array.
+            nDepth = 1;
+            nSpaceRun = 0;
+            continue;
+        }
+        if (bExpectOperand)
+        {
+            if (!IsPrefixOperator(e))
+                bExpectOperand = false; // the operand itself, or a function name before '('
+            nSpaceRun = 0;
+            continue;
+        }
+        // A reference operator, or an operand right after spaces (the space intersection).
+        if (IsReferenceOperator(e) || (nSpaceRun && IsPlainOperand(p)))
+        {
+            bExpectOperand = IsReferenceOperator(e);
+            nSpaceRun = 0;
+            continue;
+        }
+        // A separator, a closing parenthesis of an enclosing level, the percent sign or a
+        // binary operator ends the operand.
+        pEnd = pCode[nSpaceRun ? nSpaceRun : n];
+        break;
+    }
+
+    rBuffer.append(rSymbol);
+    rBuffer.append('(');
+    maSingleValueEnds.push_back(pEnd);
+    t = mrCompiler.maArrIterator.Next();
+    return true;
+}
+}
