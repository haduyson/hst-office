+// Any array result spills; Enter moves on below the anchor; undo removes the whole spill range.
+CPPUNIT_TEST_FIXTURE(ScHstDynamicArraysTest, testGenericSpill)
+{
+    createScDoc();
+    type("B1", u"10");
+    type("B2", u"20");
+    type("B3", u"30");
+    type("B4", u"40");
+    type("D1", u"=B1:B4*2");
+
+    CPPUNIT_ASSERT_EQUAL(20.0, value("D1"));
+    CPPUNIT_ASSERT_EQUAL(40.0, value("D2"));
+    CPPUNIT_ASSERT_EQUAL(60.0, value("D3"));
+    CPPUNIT_ASSERT_EQUAL(80.0, value("D4"));
+    CPPUNIT_ASSERT(isEmpty("D5"));
+    CPPUNIT_ASSERT(formulaCell("D1")->IsDynamicArrayMaster());
+    CPPUNIT_ASSERT(ScMatrixMode::Reference == formulaCell("D2")->GetMatrixFlag());
+
+    // The cursor moved on from the anchor and the spill range is not selected.
+    ScViewData& rView = getViewShell()->GetViewData();
+    CPPUNIT_ASSERT_EQUAL(SCCOL(3), rView.GetCurX());
+    CPPUNIT_ASSERT_EQUAL(SCROW(1), rView.GetCurY());
+    CPPUNIT_ASSERT(!rView.GetMarkData().IsMarked());
+
+    // A dynamic anchor (its input line text has no braces; checked by hand, no test accessor).
+    ScAddress aOrigin;
+    CPPUNIT_ASSERT(formulaCell("D3")->GetMatrixOrigin(doc(), aOrigin));
+    CPPUNIT_ASSERT_EQUAL(address("D1"), aOrigin);
+
+    dispatchCommand(mxComponent, u".uno:Undo"_ustr, {});
+    for (const char* pCell : { "D1", "D2", "D3", "D4" })
+        CPPUNIT_ASSERT_MESSAGE(pCell, isEmpty(pCell));
+
+    // Other array results spill too.
+    type("F1", u"=IF(B1:B3>15,\"y\",\"n\")");
+    CPPUNIT_ASSERT_EQUAL(u"n"_ustr, text("F1"));
+    CPPUNIT_ASSERT_EQUAL(u"y"_ustr, text("F3"));
+    type("G1", u"=OFFSET(B1,0,0,3)");
+    CPPUNIT_ASSERT_EQUAL(30.0, value("G3"));
+}
