+
+// The spill range operator of dynamic arrays: A1# is compiled to ANCHORARRAY(A1).
+
+#include <compiler.hxx>
+
+#include <rtl/character.hxx>
+
+namespace
+{
+/** Whether a '#' followed by c is the spill range operator. An error constant (#REF!, #N/A)
+    continues with a letter; '#', digits and non-ASCII characters are not the operator either. */
+bool IsSpillOperatorFollower(sal_Unicode c)
+{
+    return !(rtl::isAsciiAlphanumeric(c) || c == '#' || c >= 0x80);
+}
+}
+
+bool ScCompiler::ParseSpillRangeOperator()
+{
+    if (maRawToken.GetType() != formula::svSingleRef || maRawToken.GetOpCode() == ocColRowName)
+        return false;
+    const sal_Int32 nLen = aFormula.getLength();
+    if (nSrcPos >= nLen || aFormula[nSrcPos] != '#')
+        return false;
+    if (nSrcPos + 1 < nLen && !IsSpillOperatorFollower(aFormula[nSrcPos + 1]))
+        return false;
+
+    ++nSrcPos; // consume the operator
+    if (mbAutoCorrect)
+        maCorrectedSymbol += "#";
+    StartSpillRange();
+    return true;
+}
+
+bool ScCompiler::ParseSpillRangeSymbol(const OUString& rSymbol)
+{
+    // 'My Sheet'!A1# : the '#' was scanned as part of the symbol.
+    const sal_Int32 nLen = rSymbol.getLength();
+    if (nLen < 3 || rSymbol[nLen - 1] != '#')
+        return false;
+    // A single cell reference ends with its row number (A1, R1C1) or a bracket (R[1]C[1], [.A1]).
+    const sal_Unicode cLast = rSymbol[nLen - 2];
+    if (!rtl::isAsciiDigit(cLast) && cLast != ']')
+        return false;
+
+    if (!ParseSingleReference(rSymbol.copy(0, nLen - 1)))
+        return false;
+    if (maRawToken.GetType() != formula::svSingleRef)
+        return false;
+    StartSpillRange();
+    return true;
+}
+
+void ScCompiler::StartSpillRange()
+{
+    // A single reference is stored as both ends of the raw token's complex reference.
+    maPendingSpillRef = maRawToken.aRef.Ref1;
+    maRawToken.SetOpCode(ocAnchorArray);
+    mnPendingSpillRefStep = 1;
+}
+
+bool ScCompiler::NextSpillRangeToken()
+{
+    // The source text was already taken by the A1# token; these tokens add nothing to it.
+    if (mbAutoCorrect)
+        maCorrectedSymbol.clear();
+
+    switch (mnPendingSpillRefStep)
+    {
+        case 1:
+            maRawToken.SetOpCode(ocOpen);
+            mnPendingSpillRefStep = 2;
+            break;
+        case 2:
+            maRawToken.SetSingleReference(maPendingSpillRef);
+            mnPendingSpillRefStep = 3;
+            break;
+        default:
+            maRawToken.SetOpCode(ocClose);
+            mnPendingSpillRefStep = 0;
+            break;
+    }
+    return true;
+}
+
