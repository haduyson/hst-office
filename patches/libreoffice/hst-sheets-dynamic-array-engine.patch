+class ScHstDynamicArraysTest : public ScModelTestBase
+{
+public:
+    ScHstDynamicArraysTest()
+        : ScModelTestBase(u"sc/qa/unit/data"_ustr)
+    {
+    }
+
+protected:
+    ScDocument& doc() { return *getScDoc(); }
+
+    double value(const char* pCell)
+    {
+        return doc().GetValue(address(pCell));
+    }
+
+    OUString text(const char* pCell) { return doc().GetString(address(pCell)); }
+
+    OUString formula(const char* pCell)
+    {
+        const ScAddress aPos = address(pCell);
+        return doc().GetFormula(aPos.Col(), aPos.Row(), aPos.Tab());
+    }
+
+    bool isEmpty(const char* pCell) { return doc().GetCellType(address(pCell)) == CELLTYPE_NONE; }
+
+    ScFormulaCell* formulaCell(const char* pCell) { return doc().GetFormulaCell(address(pCell)); }
+
+    void type(const char* pCell, std::u16string_view aText)
+    {
+        insertStringToCell(OUString::createFromAscii(pCell), aText);
+    }
+
+    ScAddress address(const char* pCell)
+    {
+        ScAddress aPos;
+        aPos.Parse(OUString::createFromAscii(pCell), doc(),
+                   ScAddress::Details(formula::FormulaGrammar::CONV_OOO, 0, 0));
+        return aPos;
+    }
+
+    /// Text of a formula compiled with one grammar and written with another.
+    OUString convert(const OUString& rFormula, formula::FormulaGrammar::Grammar eRead,
+                     formula::FormulaGrammar::Grammar eWrite)
+    {
+        const ScAddress aPos(0, 19, 0);
+        ScCompiler aReader(doc(), aPos, eRead);
+        std::unique_ptr<ScTokenArray> pCode = aReader.CompileString(rFormula);
+        CPPUNIT_ASSERT(pCode);
+        ScCompiler aWriter(doc(), aPos, *pCode, eWrite);
+        OUStringBuffer aBuf;
+        aWriter.CreateStringFromTokenArray(aBuf);
+        return aBuf.makeStringAndClear();
+    }
+
+    /// Loads an xlsx package built from its parts, stored without compression.
+    void loadParts(const std::vector<std::pair<OString, OString>>& rParts);
+};
+
+void appendLE(std::string& rOut, sal_uInt32 nValue, int nBytes)
+{
+    for (int i = 0; i < nBytes; ++i)
+        rOut.push_back(static_cast<char>((nValue >> (8 * i)) & 0xff));
+}
+
+void ScHstDynamicArraysTest::loadParts(const std::vector<std::pair<OString, OString>>& rParts)
+{
+    std::string aZip, aDirectory;
+    for (const auto& [rName, rData] : rParts)
+    {
+        const sal_uInt32 nCrc = rtl_crc32(0, rData.getStr(), rData.getLength());
+        const sal_uInt32 nOffset = aZip.size();
+        appendLE(aZip, 0x04034b50, 4);
+        appendLE(aZip, 20, 2); // version needed
+        appendLE(aZip, 0, 2); // flags
+        appendLE(aZip, 0, 2); // stored
+        appendLE(aZip, 0, 2); // time
+        appendLE(aZip, 0x21, 2); // date 1980-01-01
+        appendLE(aZip, nCrc, 4);
+        appendLE(aZip, rData.getLength(), 4);
+        appendLE(aZip, rData.getLength(), 4);
+        appendLE(aZip, rName.getLength(), 2);
+        appendLE(aZip, 0, 2);
+        aZip.append(rName.getStr(), rName.getLength());
+        aZip.append(rData.getStr(), rData.getLength());
+
+        appendLE(aDirectory, 0x02014b50, 4);
+        appendLE(aDirectory, 20, 2); // version made by
+        appendLE(aDirectory, 20, 2); // version needed
+        appendLE(aDirectory, 0, 2);
+        appendLE(aDirectory, 0, 2);
+        appendLE(aDirectory, 0, 2);
+        appendLE(aDirectory, 0x21, 2);
+        appendLE(aDirectory, nCrc, 4);
+        appendLE(aDirectory, rData.getLength(), 4);
+        appendLE(aDirectory, rData.getLength(), 4);
+        appendLE(aDirectory, rName.getLength(), 2);
+        appendLE(aDirectory, 0, 2); // extra
+        appendLE(aDirectory, 0, 2); // comment
+        appendLE(aDirectory, 0, 2); // disk
+        appendLE(aDirectory, 0, 2); // internal attributes
+        appendLE(aDirectory, 0, 4); // external attributes
+        appendLE(aDirectory, nOffset, 4);
+        aDirectory.append(rName.getStr(), rName.getLength());
+    }
+    const sal_uInt32 nDirectoryOffset = aZip.size();
+    aZip += aDirectory;
+    appendLE(aZip, 0x06054b50, 4);
+    appendLE(aZip, 0, 2);
+    appendLE(aZip, 0, 2);
+    appendLE(aZip, rParts.size(), 2);
+    appendLE(aZip, rParts.size(), 2);
+    appendLE(aZip, aDirectory.size(), 4);
+    appendLE(aZip, nDirectoryOffset, 4);
+    appendLE(aZip, 0, 2);
+
+    utl::TempFileNamed aFile(u"hstdynamicarrays", true, u".xlsx");
+    aFile.EnableKillingFile(false);
+    osl::File aOut(aFile.GetURL());
+    CPPUNIT_ASSERT_EQUAL(osl::FileBase::E_None, aOut.open(osl_File_OpenFlag_Write));
+    sal_uInt64 nWritten = 0;
+    CPPUNIT_ASSERT_EQUAL(osl::FileBase::E_None, aOut.write(aZip.data(), aZip.size(), nWritten));
+    CPPUNIT_ASSERT_EQUAL(sal_uInt64(aZip.size()), nWritten);
+    aOut.close();
+    loadFromURL(aFile.GetURL());
+    osl::File::remove(aFile.GetURL());
+}
