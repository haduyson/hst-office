+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ * Copyright (c) HASON TECH. HST Office.
+ */
+
+#include <hstdynamicarrayinput.hxx>
+
+#include <compiler.hxx>
+#include <document.hxx>
+#include <editable.hxx>
+#include <formulacell.hxx>
+#include <markdata.hxx>
+#include <scmatrix.hxx>
+#include <tokenarray.hxx>
+
+#include <formula/FormulaCompiler.hxx>
+#include <formula/tokenarray.hxx>
+
+namespace sc::hst
+{
+namespace
+{
+/// Whether the selection is more than the cursor cell.
+bool HasRangeSelection(const ScMarkData& rMark)
+{
+    if (rMark.IsMultiMarked())
+        return true;
+    if (!rMark.IsMarked())
+        return false;
+    const ScRange& rArea = rMark.GetMarkArea();
+    return rArea.aStart.Col() != rArea.aEnd.Col() || rArea.aStart.Row() != rArea.aEnd.Row();
+}
+
+/// Calls code outside the document (macros, add-ins, links): never calculated twice.
+bool IsExternalCall(OpCode eOp)
+{
+    switch (eOp)
+    {
+        case ocMacro:
+        case ocExternal:
+        case ocCall:
+        case ocDde:
+        case ocWebservice:
+        case ocTableOp:
+            return true;
+        default:
+            return false;
+    }
+}
+
+/// Functions that can give an array from single values.
+bool MakesArrayFromValues(OpCode eOp)
+{
+    switch (eOp)
+    {
+        case ocAnchorArray:
+        case ocOffset:
+        case ocIndirect:
+        case ocMatSequence:
+        case ocRandArray:
+        case ocMakeArray:
+        case ocMatrixUnit:
+        case ocExpand:
+        case ocHStack:
+        case ocVStack:
+        case ocTextSplit:
+        case ocRegexExtract:
+        case ocLet:
+        case ocLambda:
+            return true;
+        default:
+            return formula::FormulaCompiler::IsMatrixFunction(eOp);
+    }
+}
+
+/** Array functions: a formula whose outermost function is one of them is a dynamic array even
+    when its result is one cell, so that it spills when the result grows. */
+bool IsArrayFunction(OpCode eOp)
+{
+    switch (eOp)
+    {
+        case ocMatSequence:
+        case ocRandArray:
+        case ocFilter:
+        case ocUnique:
+        case ocSort:
+        case ocSortBy:
+        case ocMatTrans:
+        case ocMakeArray:
+        case ocMap:
+        case ocScan:
+        case ocByRow:
+        case ocByCol:
+        case ocHStack:
+        case ocVStack:
+        case ocToCol:
+        case ocToRow:
+        case ocWrapRows:
+        case ocWrapCols:
+        case ocTake:
+        case ocDrop:
+        case ocChooseRows:
+        case ocChooseCols:
+        case ocExpand:
+        case ocMatrixUnit:
+        case ocGroupBy:
+        case ocPivotBy:
+            return true;
+        default:
+            return false;
+    }
+}
+
+/// Whether a token may bring an array into the formula.
+bool MayGiveArray(const formula::FormulaToken& rToken)
+{
+    switch (rToken.GetType())
+    {
+        case formula::svDoubleRef:
+        case formula::svExternalDoubleRef:
+        case formula::svExternalName:
+        case formula::svRefList:
+        case formula::svMatrix:
+        case formula::svIndex: // names, database ranges, table references
+            return true;
+        default:
+            break;
+    }
+    switch (rToken.GetOpCode())
+    {
+        case ocName:
+        case ocDBArea:
+        case ocTableRef:
+        case ocColRowName:
+        case ocArrayOpen:
+            return true;
+        default:
+            return MakesArrayFromValues(rToken.GetOpCode());
+    }
+}
+}
+
+bool FormulaSpills(ScDocument& rDoc, const ScAddress& rPos, const ScMarkData& rMark,
+                   const ScTokenArray& rCode, const OUString& rFormula,
+                   formula::FormulaGrammar::Grammar eGrammar)
+{
+    if (HasRangeSelection(rMark) || rFormula.isEmpty())
+        return false;
+    if (rCode.GetCodeError() != FormulaError::NONE || rCode.GetLen() == 0)
+        return false;
+
+    // The outermost function is an array function: a dynamic array whatever its result size.
+    const formula::FormulaToken* pLast = rCode.LastRPNToken();
+    if (pLast && IsArrayFunction(pLast->GetOpCode()))
+        return true;
+
+    bool bMayGiveArray = false;
+    formula::FormulaTokenArrayPlainIterator aIter(rCode);
+    for (const formula::FormulaToken* p = aIter.First(); p; p = aIter.Next())
+    {
+        if (IsExternalCall(p->GetOpCode()))
+            return false;
+        if (MayGiveArray(*p))
+            bMayGiveArray = true;
+    }
+    // A formula starting with @ never spills.
+    if (!bMayGiveArray || (pLast && pLast->GetOpCode() == ocSingleValue))
+        return false;
+
+    // Calculate once exactly as a Ctrl+Shift+Enter array formula at the cursor cell would be,
+    // outside the sheet. The code is compiled afresh from the text in array mode: the code typed
+    // for a single cell has its range operands already reduced to the formula's row or column.
+    std::u16string_view aText(rFormula);
+    if (aText.starts_with(u'='))
+        aText.remove_prefix(1);
+    ScCompiler aCompiler(rDoc, rPos, eGrammar, /*bComputeII*/ false, /*bMatrixFlag*/ true);
+    std::unique_ptr<ScTokenArray> pArrayCode = aCompiler.CompileString(OUString(aText));
+    if (!pArrayCode || pArrayCode->GetCodeError() != FormulaError::NONE)
+        return false;
+    {
+        ScCompiler aRpnCompiler(rDoc, rPos, *pArrayCode, eGrammar, /*bComputeII*/ false,
+                                /*bMatrixFlag*/ true);
+        aRpnCompiler.CompileTokenArray();
+    }
+    if (pArrayCode->GetCodeError() != FormulaError::NONE || pArrayCode->GetCodeLen() == 0)
+        return false;
+    ScFormulaCell aProbe(rDoc, rPos, std::move(pArrayCode), eGrammar, ScMatrixMode::Formula);
+    aProbe.SetFreeFlying(true);
+    aProbe.Interpret();
+    const ScMatrix* pMat = aProbe.GetMatrix();
+    if (!pMat)
+        return false;
+    SCSIZE nCols = 0, nRows = 0;
+    pMat->GetDimensions(nCols, nRows);
+    return nCols > 0 && nRows > 0 && (nCols > 1 || nRows > 1);
+}
+
+ScRange SpillEntryRange(const ScDocument& rDoc, const ScMarkData& rMark, const ScRange& rResult,
+                        const ScAddress& rCursor)
+{
+    const ScEditableTester aResultTest = ScEditableTester::CreateAndTestSelectedBlock(
+        rDoc, rResult.aStart.Col(), rResult.aStart.Row(), rResult.aEnd.Col(), rResult.aEnd.Row(),
+        rMark);
+    if (aResultTest.IsEditable())
+        return rResult;
+
+    const ScEditableTester aCursorTest = ScEditableTester::CreateAndTestSelectedBlock(
+        rDoc, rCursor.Col(), rCursor.Row(), rCursor.Col(), rCursor.Row(), rMark);
+    if (aCursorTest.IsEditable())
+        return ScRange(rCursor);
+
+    return rResult; // the normal error path reports why the input is refused
+}
+
+void StripDynamicArrayBraces(const ScDocument& rDoc, const ScFormulaCell& rCell, OUString& rText)
+{
+    const ScFormulaCell* pMaster = nullptr;
+    switch (rCell.GetMatrixFlag())
+    {
+        case ScMatrixMode::Formula:
+            pMaster = &rCell;
+            break;
+        case ScMatrixMode::Reference:
+        {
+            ScAddress aOrigin;
+            if (rCell.GetMatrixOrigin(rDoc, aOrigin))
+                pMaster = rDoc.GetFormulaCell(aOrigin);
+            break;
+        }
+        default:
+            break;
+    }
+    if (!pMaster || pMaster->GetMatrixFlag() != ScMatrixMode::Formula
+        || !pMaster->IsDynamicArrayMaster())
+        return;
+
+    const sal_Int32 nLen = rText.getLength();
+    if (nLen >= 2 && rText[0] == '{' && rText[nLen - 1] == '}')
+        rText = rText.copy(1, nLen - 2);
+}
+}
