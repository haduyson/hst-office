+// Dynamic array operators of the interpreter: @ (implicit intersection) and A1# (spill range).
+
+#include <interpre.hxx>
+
+#include <document.hxx>
+#include <formulacell.hxx>
+#include <scmatrix.hxx>
+
+#include <algorithm>
+
+namespace
+{
+/** The single cell of rRange that lies in the row and/or column of rPos: a column range gives
+    the cell in rPos' row, a row range the cell in rPos' column, a block the cell in both.
+    False when there is no such cell or the range spans several sheets. */
+bool IntersectWithPosition(const ScRange& rRange, const ScAddress& rPos, ScAddress& rCell)
+{
+    if (rRange.aStart.Tab() != rRange.aEnd.Tab())
+        return false;
+
+    SCCOL nCol = rRange.aStart.Col();
+    if (rRange.aStart.Col() != rRange.aEnd.Col())
+    {
+        if (rPos.Col() < rRange.aStart.Col() || rPos.Col() > rRange.aEnd.Col())
+            return false;
+        nCol = rPos.Col();
+    }
+    SCROW nRow = rRange.aStart.Row();
+    if (rRange.aStart.Row() != rRange.aEnd.Row())
+    {
+        if (rPos.Row() < rRange.aStart.Row() || rPos.Row() > rRange.aEnd.Row())
+            return false;
+        nRow = rPos.Row();
+    }
+    rCell = ScAddress(nCol, nRow, rRange.aStart.Tab());
+    return true;
+}
+}
+
+void ScInterpreter::ScHstSingleValue()
+{
+    switch (GetStackType())
+    {
+        case formula::svDoubleRef:
+        {
+            ScRange aRange;
+            PopDoubleRef(aRange);
+            if (nGlobalError != FormulaError::NONE)
+            {
+                PushError(nGlobalError);
+                return;
+            }
+            ScAddress aCell;
+            if (!IntersectWithPosition(aRange, aPos, aCell))
+            {
+                PushNoValue();
+                return;
+            }
+            PushSingleRef(aCell.Col(), aCell.Row(), aCell.Tab());
+            return;
+        }
+        case formula::svExternalDoubleRef:
+        {
+            sal_uInt16 nFileId = 0;
+            OUString aTabName;
+            ScComplexRefData aRef;
+            PopExternalDoubleRef(nFileId, aTabName, aRef);
+            if (nGlobalError != FormulaError::NONE)
+            {
+                PushError(nGlobalError);
+                return;
+            }
+            const ScRange aRange = aRef.toAbs(mrDoc, aPos);
+            ScAddress aCell;
+            if (!IntersectWithPosition(aRange, aPos, aCell))
+            {
+                PushNoValue();
+                return;
+            }
+            PushExternalSingleRef(nFileId, aTabName, aCell.Col(), aCell.Row(), aCell.Tab());
+            return;
+        }
+        case formula::svRefList:
+            // A union of ranges has no single cell to take.
+            Pop();
+            PushNoValue();
+            return;
+        case formula::svMatrix:
+        {
+            // An array: its upper-left element.
+            ScMatrixRef pMat = PopMatrix();
+            if (!pMat)
+            {
+                PushNoValue();
+                return;
+            }
+            SCSIZE nCols = 0, nRows = 0;
+            pMat->GetDimensions(nCols, nRows);
+            if (nCols == 0 || nRows == 0)
+            {
+                PushNoValue();
+                return;
+            }
+            if (pMat->IsValue(0, 0))
+            {
+                const FormulaError nErr = pMat->GetError(0, 0);
+                if (nErr != FormulaError::NONE)
+                {
+                    PushError(nErr);
+                    return;
+                }
+                if (pMat->IsBoolean(0, 0))
+                    nFuncFmtType = SvNumFormatType::LOGICAL;
+                PushDouble(pMat->GetDouble(0, 0));
+            }
+            else if (pMat->IsEmpty(0, 0) || pMat->IsEmptyPath(0, 0))
+                PushDouble(0.0);
+            else
+                PushString(pMat->GetString(0, 0));
+            return;
+        }
+        default:
+            // A single value or single cell stays as it is.
+            PushTokenRef(PopToken());
+            return;
+    }
+}
+
+void ScInterpreter::ScAnchorArray()
+{
+    ScAddress aAnchor;
+    switch (GetStackType())
+    {
+        case formula::svSingleRef:
+            PopSingleRef(aAnchor);
+            break;
+        case formula::svDoubleRef:
+        {
+            ScRange aRange;
+            PopDoubleRef(aRange);
+            if (aRange.aStart != aRange.aEnd)
+            {
+                PushError(FormulaError::NoRef);
+                return;
+            }
+            aAnchor = aRange.aStart;
+            break;
+        }
+        default:
+            Pop();
+            PushError(FormulaError::NoRef);
+            return;
+    }
+    if (nGlobalError != FormulaError::NONE)
+    {
+        PushError(FormulaError::NoRef);
+        return;
+    }
+
+    // Only a dynamic array's anchor has a spill range; a legacy array formula has none.
+    ScFormulaCell* pAnchor = mrDoc.GetFormulaCell(aAnchor);
+    if (!pAnchor || pAnchor->GetMatrixFlag() != ScMatrixMode::Formula
+        || !pAnchor->IsDynamicArrayMaster())
+    {
+        PushError(FormulaError::NoRef);
+        return;
+    }
+    if (pAnchor == pMyFormulaCell)
+    {
+        PushError(FormulaError::CircularReference);
+        return;
+    }
+
+    // The anchor's latest result decides the size, also while its cell range still waits to
+    // follow a new result size.
+    pAnchor->MaybeInterpret();
+    if (pAnchor->GetRawError() == FormulaError::Spill)
+    {
+        PushError(FormulaError::NoRef);
+        return;
+    }
+    SCSIZE nCols = 1, nRows = 1; // a one-cell result: the spill range is the anchor alone
+    if (const ScMatrix* pMat = pAnchor->GetMatrix())
+    {
+        pMat->GetDimensions(nCols, nRows);
+        const bool bErrorCell = nCols == 1 && nRows == 1 && pMat->IsValue(0, 0)
+                                && pMat->GetError(0, 0) != FormulaError::NONE;
+        if (nCols == 0 || nRows == 0 || bErrorCell)
+        {
+            PushError(FormulaError::NoRef);
+            return;
+        }
+    }
+    else if (pAnchor->GetRawError() != FormulaError::NONE)
+    {
+        PushError(FormulaError::NoRef); // an anchor whose result is an error has no spill range
+        return;
+    }
+    const SCCOL nEndCol = static_cast<SCCOL>(
+        std::min<SCSIZE>(aAnchor.Col() + nCols - 1, static_cast<SCSIZE>(mrDoc.MaxCol())));
+    const SCROW nEndRow = static_cast<SCROW>(
+        std::min<SCSIZE>(aAnchor.Row() + nRows - 1, static_cast<SCSIZE>(mrDoc.MaxRow())));
+    PushDoubleRef(aAnchor.Col(), aAnchor.Row(), aAnchor.Tab(), nEndCol, nEndRow, aAnchor.Tab());
+}
