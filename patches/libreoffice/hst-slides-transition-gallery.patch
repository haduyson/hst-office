+/// The selected slides of the slide pane or sorter, else the current slide of the main view.
+std::vector<SdPage*> SelectedPages(ViewShellBase& rBase)
+{
+    std::vector<SdPage*> aPages;
+    if (slidesorter::SlideSorterViewShell* pSorter
+        = slidesorter::SlideSorterViewShell::GetSlideSorter(rBase))
+    {
+        if (const std::shared_ptr<slidesorter::SlideSorterViewShell::PageSelection> pSelection
+            = pSorter->GetPageSelection())
+            aPages.assign(pSelection->begin(), pSelection->end());
+    }
+    if (aPages.empty())
+    {
+        const std::shared_ptr<ViewShell> pMain = rBase.GetMainViewShell();
+        if (SdPage* pPage = pMain ? pMain->GetActualPage() : nullptr)
+            aPages.push_back(pPage);
+    }
+    // only slides take transitions (not notes, handouts or masters in their views)
+    aPages.erase(std::remove_if(aPages.begin(), aPages.end(),
+                                [](const SdPage* pPage) {
+                                    return !pPage || pPage->GetPageKind() != PageKind::Standard
+                                           || pPage->IsMasterPage();
+                                }),
+                 aPages.end());
+    return aPages;
+}
+
+/// The first preset of the set (its first variant), or null for an unknown set.
+TransitionPresetPtr FirstOfSet(std::u16string_view rSetId)
+{
+    for (const TransitionPresetPtr& pPreset : TransitionPreset::getTransitionPresetList())
+        if (pPreset && pPreset->getSetId() == rSetId)
+            return pPreset;
+    return {};
+}
+
+OUString SetOf(const SdPage& rPage)
+{
+    if (rPage.getTransitionType() == 0)
+        return TransitionNone;
+    for (const TransitionPresetPtr& pPreset : TransitionPreset::getTransitionPresetList())
+        if (pPreset && pPreset->getTransition() == rPage.getTransitionType()
+            && pPreset->getSubtype() == rPage.getTransitionSubtype()
+            && pPreset->getDirection() == rPage.getTransitionDirection()
+            && pPreset->getFadeColor() == rPage.getTransitionFadeColor())
+            return pPreset->getSetId();
+    return OUString(); // a transition that is not in the gallery (from another program)
+}
+}
+
+OUString CurrentTransition(ViewShellBase& rBase)
+{
+    const std::vector<SdPage*> aPages = SelectedPages(rBase);
+    if (aPages.empty())
+        return OUString();
+    const OUString aFirst = SetOf(*aPages.front());
+    for (const SdPage* pPage : aPages)
+        if (SetOf(*pPage) != aFirst)
+            return OUString();
+    return aFirst;
+}
+
+bool ApplyTransition(ViewShellBase& rBase, std::u16string_view rSetId)
+{
+    const bool bNone = rSetId == TransitionNone;
+    const TransitionPresetPtr pPreset = bNone ? TransitionPresetPtr() : FirstOfSet(rSetId);
+    if (!bNone && !pPreset)
+        return false;
+    DrawDocShell* pDocSh = rBase.GetDocShell();
+    SdDrawDocument* pDoc = pDocSh ? pDocSh->GetDoc() : nullptr;
+    if (!pDoc || pDocSh->IsReadOnly())
+        return false;
+    const std::vector<SdPage*> aPages = SelectedPages(rBase);
+    if (aPages.empty())
+        return false;
+
+    // one undo action for all the slides, as the Slide Transition deck records it
+    if (SfxUndoManager* pManager = pDocSh->GetUndoManager())
+    {
+        const OUString aComment(SdResId(STR_UNDO_SLIDE_PARAMS));
+        pManager->EnterListAction(aComment, aComment, 0, rBase.GetViewShellId());
+        auto pGroup = std::make_unique<SdUndoGroup>(*pDoc);
+        pGroup->SetComment(aComment);
+        for (SdPage* pPage : aPages)
+            pGroup->AddAction(new UndoTransition(*pDoc, pPage));
+        pManager->AddUndoAction(std::move(pGroup));
+        pManager->LeaveListAction();
+    }
+
+    // the effect only: duration, timing and sound stay as they are, as with the deck's icons
+    for (SdPage* pPage : aPages)
+    {
+        pPage->setTransitionType(bNone ? 0 : pPreset->getTransition());
+        pPage->setTransitionSubtype(bNone ? 0 : pPreset->getSubtype());
+        pPage->setTransitionDirection(bNone || pPreset->getDirection());
+        pPage->setTransitionFadeColor(bNone ? 0 : pPreset->getFadeColor());
+    }
+    pDocSh->SetModified();
+    return true;
+}
+
+void ExecuteApplyTransition(ViewShellBase& rBase, SfxRequest& rRequest)
+{
+    const SfxItemSet* pArgs = rRequest.GetArgs();
+    const SfxStringItem* pSet = pArgs ? pArgs->GetItem<SfxStringItem>(SID_HST_APPLY_TRANSITION) : nullptr;
+    if (!pSet || !ApplyTransition(rBase, pSet->GetValue()))
+    {
+        rRequest.Ignore();
+        return;
+    }
+    // the gallery shows the new transition as selected
+    rBase.GetViewFrame().GetBindings().Invalidate(SID_HST_APPLY_TRANSITION);
+    rRequest.Done();
+}
+
+void GetApplyTransitionState(ViewShellBase& rBase, SfxItemSet& rSet)
+{
+    DrawDocShell* pDocSh = rBase.GetDocShell();
+    if (!pDocSh || pDocSh->IsReadOnly() || SelectedPages(rBase).empty())
+    {
+        rSet.DisableItem(SID_HST_APPLY_TRANSITION);
+        return;
+    }
+    rSet.Put(SfxStringItem(SID_HST_APPLY_TRANSITION, CurrentTransition(rBase)));
+}
+}
