+/** HST Office: the slide transition presets of the ribbon's transitions gallery (Slides, tab
+    "Chuyển tiếp"), applied with .uno:HstApplyTransition?Transition:string=<set id>.
+
+    A transition is named by the set id of TransitionPreset (transitions.xml, e.g. "wipe", "fade"),
+    the same entries the Slide Transition deck shows; "None" removes the transition. The first
+    variant of the set is applied, as a click on the deck's icon does. */
+namespace sd::hst
+{
+inline constexpr OUString TransitionNone = u"None"_ustr;
+
+/// The set id of the transition of the selected slides: "None" without one, empty when they differ
+/// or there is no slide.
+OUString CurrentTransition(ViewShellBase& rBase);
+
+/// Applies the set rSetId (or "None") to the selected slides (the current slide without a slide
+/// sorter) as one undo action. False when the set is unknown or no slide is selected.
+bool ApplyTransition(ViewShellBase& rBase, std::u16string_view rSetId);
+
+/// SID_HST_APPLY_TRANSITION for the view shells' FuTemporary: the Transition argument is required.
+void ExecuteApplyTransition(ViewShellBase& rBase, SfxRequest& rRequest);
+
+/// SID_HST_APPLY_TRANSITION for the view shells' GetMenuState: the current set id, or disabled.
+void GetApplyTransitionState(ViewShellBase& rBase, SfxItemSet& rSet);
+}
