+namespace
+{
+constexpr OUString COMMAND = u".uno:HstApplyTransition"_ustr;
+// an item is the icon view's item width plus its padding on both sides (hsttransitiongallery.ui)
+constexpr tools::Long ITEM_WIDTH = 60 + 2 * 2;
+constexpr int MIN_ITEMS = 3; // the narrowest gallery still shows three transitions
+
+bool GalleryEnabled()
+{
+    if (comphelper::LibreOfficeKit::isActive())
+        return false;
+    try
+    {
+        return officecfg::Office::HSTRibbon::SlidesEffectGalleries::get();
+    }
+    catch (const uno::Exception&)
+    {
+        return true; // the schema ships with the switch on
+    }
+}
+
+struct Entry
+{
+    OUString aSetId; // TransitionPreset set id, or sd::hst::TransitionNone
+    OUString aLabel;
+    OUString aIcon;
+};
+
+/// "None" first, then one entry per transition set, in the order of the Slide Transition deck.
+std::vector<Entry> Entries()
+{
+    std::vector<Entry> aEntries{ { sd::hst::TransitionNone, SdResId(STR_SLIDETRANSITION_NONE),
+                                   u"sd/cmd/transition-none.png"_ustr } };
+    for (const sd::TransitionPresetPtr& pPreset : sd::TransitionPreset::getTransitionPresetList())
+    {
+        if (!pPreset || pPreset->getSetLabel().isEmpty())
+            continue;
+        const OUString& rSet = pPreset->getSetId();
+        if (std::any_of(aEntries.begin(), aEntries.end(),
+                        [&rSet](const Entry& rEntry) { return rEntry.aSetId == rSet; }))
+            continue;
+        aEntries.push_back({ rSet, pPreset->getSetLabel(), u"sd/cmd/transition-"_ustr + rSet + u".png"_ustr });
+    }
+    return aEntries;
+}
+
+class HstTransitionGalleryWindow final : public InterimItemWindow
+{
+public:
+    HstTransitionGalleryWindow(vcl::Window* pParent, uno::Reference<frame::XFrame> xFrame)
+        : InterimItemWindow(pParent, u"modules/simpress/ui/hsttransitiongallery.ui"_ustr,
+                            u"TransitionGalleryBox"_ustr, true)
+        , m_xFrame(std::move(xFrame))
+        , m_xView(m_xBuilder->weld_icon_view(u"transitions"_ustr))
+        , m_xPrev(m_xBuilder->weld_button(u"prev"_ustr))
+        , m_xNext(m_xBuilder->weld_button(u"next"_ustr))
+        , m_xMore(m_xBuilder->weld_button(u"more"_ustr))
+        , m_aEntries(Entries())
+        , m_aRefill("sd HstTransitionGallery refill")
+    {
+        InitControlBase(m_xView.get());
+        m_xView->set_size_request(ITEM_WIDTH * MIN_ITEMS, -1);
+        m_xView->connect_item_activated(LINK(this, HstTransitionGalleryWindow, ActivatedHdl));
+        m_xView->connect_size_allocate(LINK(this, HstTransitionGalleryWindow, SizeHdl));
+        m_xPrev->connect_clicked(LINK(this, HstTransitionGalleryWindow, PageHdl));
+        m_xNext->connect_clicked(LINK(this, HstTransitionGalleryWindow, PageHdl));
+        m_xMore->connect_clicked(LINK(this, HstTransitionGalleryWindow, MoreHdl));
+        m_aRefill.SetInvokeHandler(LINK(this, HstTransitionGalleryWindow, RefillHdl));
+        ShowPage();
+        SetSizePixel(get_preferred_size());
+    }
+
+    ~HstTransitionGalleryWindow() override { disposeOnce(); }
+
+    void dispose() override
+    {
+        m_aRefill.Stop();
+        m_xView.reset();
+        m_xPrev.reset();
+        m_xNext.reset();
+        m_xMore.reset();
+        InterimItemWindow::dispose();
+    }
+
+    /// The transition of the selected slides (empty: several, or one the gallery does not have).
+    void SetCurrent(const OUString& rSetId)
+    {
+        if (m_aCurrent == rSetId)
+            return;
+        m_aCurrent = rSetId;
+        // bring the page with the current transition into view, as Office's gallery does
+        const auto it = std::find_if(m_aEntries.begin(), m_aEntries.end(),
+                                     [&rSetId](const Entry& rEntry) { return rEntry.aSetId == rSetId; });
+        if (it != m_aEntries.end() && m_nPageSize)
+        {
+            const size_t nIndex = it - m_aEntries.begin();
+            if (nIndex < m_nFirst || nIndex >= m_nFirst + m_nPageSize)
+                m_nFirst = nIndex - nIndex % m_nPageSize;
+        }
+        ShowPage();
+    }
+
+private:
+    size_t PageSize() const
+    {
+        return m_nViewWidth > 0 ? std::max<size_t>(1, m_nViewWidth / ITEM_WIDTH) : MIN_ITEMS;
+    }
+
+    void ShowPage()
+    {
+        if (!m_xView)
+            return;
+        m_nPageSize = PageSize();
+        if (m_nFirst >= m_aEntries.size())
+            m_nFirst = 0;
+        m_nFirst -= m_nFirst % m_nPageSize; // pages start at multiples of the page size
+        const size_t nEnd = std::min(m_aEntries.size(), m_nFirst + m_nPageSize);
+
+        m_xView->freeze();
+        m_xView->clear();
+        int nSelect = -1;
+        for (size_t i = m_nFirst; i < nEnd; ++i)
+        {
+            const Entry& rEntry = m_aEntries[i];
+            const int nPos = static_cast<int>(i - m_nFirst);
+            m_xView->insert(nPos, &rEntry.aLabel, &rEntry.aSetId, &rEntry.aIcon, nullptr);
+            m_xView->set_item_tooltip_text(nPos, rEntry.aLabel);
+            m_xView->set_item_accessible_name(nPos, rEntry.aLabel);
+            if (rEntry.aSetId == m_aCurrent)
+                nSelect = nPos;
+        }
+        m_xView->thaw();
+        if (nSelect >= 0)
+            m_xView->select(nSelect);
+        else
+            m_xView->unselect_all();
+        m_xPrev->set_sensitive(m_nFirst > 0);
+        m_xNext->set_sensitive(nEnd < m_aEntries.size());
+    }
+
+    DECL_LINK(ActivatedHdl, const weld::TreeIter&, bool);
+    DECL_LINK(SizeHdl, const Size&, void);
+    DECL_LINK(PageHdl, weld::Button&, void);
+    DECL_LINK(MoreHdl, weld::Button&, void);
+    DECL_LINK(RefillHdl, Timer*, void);
+
+    uno::Reference<frame::XFrame> m_xFrame;
+    std::unique_ptr<weld::IconView> m_xView;
+    std::unique_ptr<weld::Button> m_xPrev;
+    std::unique_ptr<weld::Button> m_xNext;
+    std::unique_ptr<weld::Button> m_xMore;
+    std::vector<Entry> m_aEntries;
+    Idle m_aRefill;
+    OUString m_aCurrent;
+    size_t m_nFirst = 0;
+    size_t m_nPageSize = 0;
+    tools::Long m_nViewWidth = 0;
+};
+
+IMPL_LINK(HstTransitionGalleryWindow, ActivatedHdl, const weld::TreeIter&, rIter, bool)
+{
+    const OUString aSetId = m_xView->get_id(rIter);
+    if (aSetId.isEmpty() || !m_xFrame.is())
+        return true;
+    comphelper::dispatchCommand(COMMAND, m_xFrame,
+                                { comphelper::makePropertyValue(u"Transition"_ustr, aSetId) });
+    return true;
+}
+
+IMPL_LINK(HstTransitionGalleryWindow, SizeHdl, const Size&, rSize, void)
+{
+    if (rSize.Width() == m_nViewWidth)
+        return;
+    m_nViewWidth = rSize.Width();
+    // refill after this size allocation, not while the view is being allocated
+    if (PageSize() != m_nPageSize)
+        m_aRefill.Start();
+}
+
+IMPL_LINK_NOARG(HstTransitionGalleryWindow, RefillHdl, Timer*, void) { ShowPage(); }
+
+IMPL_LINK(HstTransitionGalleryWindow, PageHdl, weld::Button&, rButton, void)
+{
+    if (!m_nPageSize)
+        return;
+    if (&rButton == m_xNext.get())
+    {
+        if (m_nFirst + m_nPageSize < m_aEntries.size())
+            m_nFirst += m_nPageSize;
+    }
+    else
+        m_nFirst = m_nFirst > m_nPageSize ? m_nFirst - m_nPageSize : 0;
+    ShowPage();
+}
+
+IMPL_LINK_NOARG(HstTransitionGalleryWindow, MoreHdl, weld::Button&, void)
+{
+    // every transition with its variants, duration, sound and advance: the Slide Transition deck
+    if (m_xFrame.is())
+        comphelper::dispatchCommand(u".uno:SidebarDeck.SdSlideTransitionDeck"_ustr, m_xFrame, {});
+}
+
+using HstTransitionGalleryControl_Base
+    = cppu::ImplInheritanceHelper<svt::ToolboxController, lang::XServiceInfo>;
+
+class HstTransitionGalleryControl final : public HstTransitionGalleryControl_Base
+{
+public:
+    HstTransitionGalleryControl() = default;
+
+    // XInitialization
+    void SAL_CALL initialize(const uno::Sequence<uno::Any>& rArguments) override
+    {
+        svt::ToolboxController::initialize(rArguments);
+        if (GalleryEnabled())
+            return;
+        // switched off: the gallery's place stays empty (the Slide Transition deck has everything)
+        SolarMutexGuard aGuard;
+        ToolBox* pToolBox = nullptr;
+        ToolBoxItemId nId;
+        if (getToolboxId(nId, &pToolBox))
+            pToolBox->HideItem(nId);
+    }
+
+    // XUpdatable
+    void SAL_CALL update() override {}
+
+    // XStatusListener
+    void SAL_CALL statusChanged(const frame::FeatureStateEvent& rEvent) override
+    {
+        SolarMutexGuard aGuard;
+        if (!m_xWindow)
+            return;
+        m_xWindow->Enable(rEvent.IsEnabled);
+        OUString aSetId;
+        rEvent.State >>= aSetId;
+        m_xWindow->SetCurrent(rEvent.IsEnabled ? aSetId : OUString());
+    }
+
+    // XToolbarController
+    uno::Reference<awt::XWindow> SAL_CALL createItemWindow(const uno::Reference<awt::XWindow>& rParent) override
+    {
+        if (!GalleryEnabled())
+            return {};
+        SolarMutexGuard aGuard;
+        VclPtr<vcl::Window> pParent = VCLUnoHelper::GetWindow(rParent);
+        if (!pParent)
+            return {};
+        m_xWindow = VclPtr<HstTransitionGalleryWindow>::Create(pParent, m_xFrame);
+        return VCLUnoHelper::GetInterface(m_xWindow);
+    }
+
+    // XServiceInfo
+    OUString SAL_CALL getImplementationName() override
+    {
+        return u"com.sun.star.comp.sd.HstTransitionGalleryControl"_ustr;
+    }
+    sal_Bool SAL_CALL supportsService(const OUString& rServiceName) override
+    {
+        return cppu::supportsService(this, rServiceName);
+    }
+    uno::Sequence<OUString> SAL_CALL getSupportedServiceNames() override
+    {
+        return { u"com.sun.star.frame.ToolbarController"_ustr };
+    }
+
+    // WeakComponentImplHelperBase
+    using HstTransitionGalleryControl_Base::disposing;
+    void disposing(std::unique_lock<std::mutex>& rGuard) override
+    {
+        svt::ToolboxController::disposing(rGuard);
+        comphelper::unique_unlock aUnlock(rGuard);
+        SolarMutexGuard aSolarGuard;
+        m_xWindow.disposeAndClear();
+    }
+
+private:
+
+    VclPtr<HstTransitionGalleryWindow> m_xWindow;
+};
+}
+
+extern "C" SAL_DLLPUBLIC_EXPORT uno::XInterface*
+com_sun_star_comp_sd_HstTransitionGalleryControl_get_implementation(uno::XComponentContext*,
+                                                                    uno::Sequence<uno::Any> const&)
+{
+    return cppu::acquire(new HstTransitionGalleryControl);
+}
