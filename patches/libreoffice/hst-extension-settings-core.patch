HST Office: the per-user settings of the bundled HST extension become core configuration schemas.

The components org.hasontech.hstoffice.* (Welcome, DefaultApps, ErrorReport, FeatureSearch, SaveFormatCheck,
NumberWords, Citations, Nd30, Banners, PreviousVersions, UpdateCheck) were defined by .xcs files inside the bundled
extension. configmgr learns a bundled extension's schemas at start only from the profile's registration cache
(user/extensions/bundled/.../configmgr.ini); when that cache is missing, or was left without the HST schemas by a
start ended while the extensions were registered again after an update, it skips the user's values of these
components in registrymodifications.xcu as unknown items and drops them at the next settings write: the welcome
dialog, the default-apps and crash questions and the feature search hint came back, and the other HST settings
returned to their defaults.

The schemas are now part of main.xcd (officecfg/registry/schema/org/hasontech/hstoffice/*.xcs), with the same
paths, types and defaults, so they are known before the user layer is read; the extension no longer ships them
(its data .xcu files, e.g. FeatureSearch.xcu, still fill them). A finalized value in a share/registry .xcd or the
Windows policy key can now lock these settings too.

License: MPL-2.0, like the configuration schemas of the office.
Test: tests/unit/test_extension_settings_core.py; tests/runtime/check-startup-choices-survive.py.
---
--- a/officecfg/Configuration_officecfg.mk
+++ b/officecfg/Configuration_officecfg.mk
@@ -22,6 +22,27 @@
 
 $(eval $(call gb_Configuration_add_schemas,registry,officecfg/registry/schema,\
 	$(addprefix org/openoffice/,$(addsuffix .xcs,$(officecfg_XCSFILES))) \
+))
+
+# HST Office: the per-user settings of the bundled HST extension, components org.hasontech.hstoffice.*
+# (hst-extension-settings-core.patch). Defined here, they are known whenever the office reads the user's
+# registrymodifications.xcu; as extension schemas they were not while the profile's extension
+# registration was missing or being renewed, and the user's values were dropped.
+officecfg_HST_XCSFILES := \
+	Banners \
+	Citations \
+	DefaultApps \
+	ErrorReport \
+	FeatureSearch \
+	Nd30 \
+	NumberWords \
+	PreviousVersions \
+	SaveFormatCheck \
+	UpdateCheck \
+	Welcome \
+
+$(eval $(call gb_Configuration_add_schemas,registry,officecfg/registry/schema,\
+	$(addprefix org/hasontech/hstoffice/,$(addsuffix .xcs,$(officecfg_HST_XCSFILES))) \
 ))
 
 $(eval $(call gb_Configuration_add_datas,registry,officecfg/registry/data,\
--- a/postprocess/CustomTarget_registry.mk
+++ b/postprocess/CustomTarget_registry.mk
@@ -278,6 +278,20 @@
 	$(postprocess_MOD)/org/openoffice/TypeDetection/UISort-math.xcu \
 	$(postprocess_MOD)/org/openoffice/TypeDetection/UISort-writer.xcu
 
+# HST Office: the settings of the bundled HST extension (hst-extension-settings-core.patch)
+postprocess_FILES_main += $(addprefix $(call gb_XcsTarget_get_target,org/hasontech/hstoffice)/,\
+	Banners.xcs \
+	Citations.xcs \
+	DefaultApps.xcs \
+	ErrorReport.xcs \
+	FeatureSearch.xcs \
+	Nd30.xcs \
+	NumberWords.xcs \
+	PreviousVersions.xcs \
+	SaveFormatCheck.xcs \
+	UpdateCheck.xcs \
+	Welcome.xcs)
+
 ifeq (MACOSX,$(OS))
 postprocess_FILES_main += \
 	$(postprocess_MOD)/org/openoffice/Inet-macosx.xcu \
