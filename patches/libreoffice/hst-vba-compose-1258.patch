+OUString VbaHelper::composeSourceText( const OUString& rText, rtl_TextEncoding eTextEnc )
+{
+    if( eTextEnc != RTL_TEXTENCODING_MS_1258 )
+        return rText;
+    UErrorCode nError = U_ZERO_ERROR;
+    const icu::Normalizer2* pNormalizer = icu::Normalizer2::getNFCInstance( nError );
+    if( U_FAILURE( nError ) || !pNormalizer )
+        return rText;
+    const icu::UnicodeString aSource( reinterpret_cast< const UChar* >( rText.getStr() ), rText.getLength() );
+    const icu::UnicodeString aResult = pNormalizer->normalize( aSource, nError );
+    if( U_FAILURE( nError ) )
+        return rText;
+    return OUString( reinterpret_cast< const sal_Unicode* >( aResult.getBuffer() ), aResult.length() );
+}
