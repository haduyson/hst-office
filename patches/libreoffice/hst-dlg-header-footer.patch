+
+void SvxHFPage::HstSyncDifferent()
+{
+    m_xHstDifferentLR->set_active(!m_xCntSharedBox->get_active());
+    m_xHstDifferentLR->set_visible(m_xCntSharedBox->get_visible());
+    m_xHstDifferentLR->set_sensitive(m_xCntSharedBox->get_sensitive());
+    m_xHstDifferentFirst->set_active(!m_xCntSharedFirstBox->get_active());
+    m_xHstDifferentFirst->set_visible(m_xCntSharedFirstBox->get_visible());
+    m_xHstDifferentFirst->set_sensitive(m_xCntSharedFirstBox->get_sensitive());
+}
+
+IMPL_LINK_NOARG(SvxHFPage, HstDifferentHdl, weld::Toggleable&, void)
+{
+    m_xCntSharedBox->set_active(!m_xHstDifferentLR->get_active());
+    m_xCntSharedFirstBox->set_active(!m_xHstDifferentFirst->get_active());
 }
 
 void SvxHFPage::InitHandler()
 {
+    m_xHstDifferentLR->connect_toggled(LINK(this, SvxHFPage, HstDifferentHdl));
+    m_xHstDifferentFirst->connect_toggled(LINK(this, SvxHFPage, HstDifferentHdl));
     m_xTurnOnBox->connect_toggled(LINK(this, SvxHFPage, TurnOnHdl));
     m_xDistEdit->connect_value_changed(LINK(this, SvxHFPage, ValueChangeHdl));
     m_xHeightEdit->connect_value_changed(LINK(this,SvxHFPage,ValueChangeHdl));
