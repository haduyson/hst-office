+// HST Office: svl::SharedStringPool on its open-addressing table. Many strings (the table grows
+// many times), strings with the same 32-bit hash (one long probe run), and purges that remove
+// part of the entries, after which every remaining string must still be found and every removed
+// string must come back as a new entry; the counts follow the pool's documented purge rules,
+// checked against a model on a fixed pseudo-random sequence.
+
+#include <cppunit/TestAssert.h>
+#include <cppunit/TestFixture.h>
+#include <cppunit/extensions/HelperMacros.h>
+#include <cppunit/plugin/TestPlugIn.h>
