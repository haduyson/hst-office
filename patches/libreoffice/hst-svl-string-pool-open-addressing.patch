+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ * Copyright (c) HASON TECH. HST Office.
+ */
+/*
+ * HST Office: open-addressing table of svl::SharedStringPool (see hststringpooltable.hxx).
+ */
+
+#include <hststringpooltable.hxx>
+
+#include <cassert>
+
+namespace svl
+{
+namespace
+{
+sal_Int32 refCount(const rtl_uString* p) { return p->refCount & 0x3FFFFFFF; }
+
+// Keep the load at or under 4/5: with the 32-bit hashes in their own array a probe reads 16
+// hashes per cache line, and the string is compared only when the hash matches.
+bool overLoaded(size_t nSize, size_t nCapacity) { return nSize * 5 > nCapacity * 4; }
+
+constexpr size_t MIN_CAPACITY = 16;
+}
+
+HstStringPoolTable::~HstStringPoolTable()
+{
+    for (size_t i = 0; i < mnCapacity; ++i)
+    {
+        if (mpEntries[i].pStr)
+        {
+            rtl_uString_release(mpEntries[i].pStr);
+            rtl_uString_release(mpEntries[i].pUpper);
+        }
+    }
+}
+
+HstStringPoolTable::Entry HstStringPoolTable::find(const OUString& rStr, sal_uInt32 nHash) const
+{
+    if (mnSize == 0)
+        return { nullptr, nullptr };
+    for (size_t i = home(nHash);; i = next(i))
+    {
+        const Entry& rEntry = mpEntries[i];
+        if (!rEntry.pStr)
+            return { nullptr, nullptr };
+        if (mpHashes[i] == nHash
+            && (rEntry.pStr == rStr.pData || OUString::unacquired(&rEntry.pStr) == rStr))
+            return rEntry;
+    }
+}
+
+void HstStringPoolTable::place(const Entry& rEntry, sal_uInt32 nHash)
+{
+    size_t i = home(nHash);
+    while (mpEntries[i].pStr)
+        i = next(i);
+    mpEntries[i] = rEntry;
+    mpHashes[i] = nHash;
+}
+
+void HstStringPoolTable::reserveOneMore()
+{
+    if (mnCapacity != 0 && !overLoaded(mnSize + 1, mnCapacity))
+        return;
+    size_t nNewCapacity = mnCapacity < MIN_CAPACITY ? MIN_CAPACITY : mnCapacity + mnCapacity / 2;
+    while (overLoaded(mnSize + 1, nNewCapacity))
+        nNewCapacity += nNewCapacity / 2;
+
+    std::unique_ptr<Entry[]> pOldEntries = std::move(mpEntries);
+    std::unique_ptr<sal_uInt32[]> pOldHashes = std::move(mpHashes);
+    const size_t nOldCapacity = mnCapacity;
+    mpEntries.reset(new Entry[nNewCapacity]()); // value-initialized: every slot free
+    mpHashes.reset(new sal_uInt32[nNewCapacity]);
+    mnCapacity = nNewCapacity;
+    for (size_t i = 0; i < nOldCapacity; ++i)
+        if (pOldEntries[i].pStr)
+            place(pOldEntries[i], pOldHashes[i]);
+}
+
+void HstStringPoolTable::insert(const OUString& rStr, sal_uInt32 nHash, rtl_uString* pUpper)
+{
+    assert(pUpper);
+    assert(!find(rStr, nHash).pStr);
+    reserveOneMore();
+    rtl_uString_acquire(rStr.pData);
+    rtl_uString_acquire(pUpper);
+    place({ rStr.pData, pUpper }, nHash);
+    ++mnSize;
+}
+
+void HstStringPoolTable::purgeUnused()
+{
+    if (mnSize == 0)
+        return;
+
+    // A slot that is free before anything is removed: no probe sequence runs across it, so the
+    // repair below can walk the table once starting there.
+    size_t nFree = 0;
+    while (mpEntries[nFree].pStr)
+        ++nFree; // the load stays under 4/5, so a free slot exists
+
+    bool bRemoved = false;
+    auto remove = [&](Entry& rEntry) {
+        rtl_uString_release(rEntry.pStr);
+        rtl_uString_release(rEntry.pUpper);
+        rEntry = { nullptr, nullptr };
+        --mnSize;
+        bRemoved = true;
+    };
+
+    // First the strings that differ from their upper case: the table holds the only reference
+    // to the string. Removing them releases their references on the upper-case strings.
+    for (size_t i = 0; i < mnCapacity; ++i)
+    {
+        Entry& rEntry = mpEntries[i];
+        if (rEntry.pStr && rEntry.pStr != rEntry.pUpper && refCount(rEntry.pStr) == 1)
+            remove(rEntry);
+    }
+    // Then the upper-case strings mapped to themselves that only their own entry references
+    // (one reference as the string, one as the upper case).
+    for (size_t i = 0; i < mnCapacity; ++i)
+    {
+        Entry& rEntry = mpEntries[i];
+        if (rEntry.pStr && rEntry.pStr == rEntry.pUpper && refCount(rEntry.pStr) == 2)
+            remove(rEntry);
+    }
+
+    if (bRemoved)
+        repairChains(nFree);
+}
+
+void HstStringPoolTable::repairChains(size_t nFreeBefore)
+{
+    // Removals leave holes inside probe sequences, and a lookup stops at the first free slot.
+    // Walk the table once, starting after a slot that was free before the removals, and move
+    // every entry to the first free slot from its home. That slot lies between the home and the
+    // entry's current slot, everything before it in the walk is settled, and slots only fill
+    // up behind the walk, so each entry is again reachable from its home without a free slot.
+    size_t i = nFreeBefore;
+    for (size_t nStep = 0; nStep < mnCapacity; ++nStep)
+    {
+        i = next(i);
+        if (!mpEntries[i].pStr)
+            continue;
+        const sal_uInt32 nHash = mpHashes[i];
+        size_t j = home(nHash);
+        while (j != i && mpEntries[j].pStr)
+            j = next(j);
+        if (j != i)
+        {
+            mpEntries[j] = mpEntries[i];
+            mpHashes[j] = nHash;
+            mpEntries[i] = { nullptr, nullptr };
+        }
+    }
+}
+}
