+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ * Copyright (c) HASON TECH. HST Office.
+ */
+/*
+ * HST Office: the table behind svl::SharedStringPool.
+ *
+ * An open-addressing hash table with linear probing, kept in two flat arrays: the string and its
+ * upper-case partner (two pointers, 16 bytes) and the 32-bit hash of the string (4 bytes). The
+ * std::unordered_map it replaces used a separately allocated 48-byte node per string plus an
+ * 8-byte bucket pointer; for the 1.9 million strings of a large spreadsheet that is about
+ * 100 MB against about 60 MB here. The pool's rules do not change: every entry holds one
+ * reference on its string and one on its upper-case string (the same string twice when it is
+ * its own upper case), and purge removes exactly the entries the old map removed.
+ */
+
+#pragma once
+
+#include <rtl/ustring.hxx>
+#include <sal/types.h>
+
+#include <cstddef>
+#include <memory>
+
+namespace svl
+{
+class HstStringPoolTable
+{
+public:
+    /// A pooled string and its pooled upper-case string; both null when the string is not pooled.
+    struct Entry
+    {
+        rtl_uString* pStr;
+        rtl_uString* pUpper;
+    };
+
+    HstStringPoolTable() = default;
+    ~HstStringPoolTable();
+    HstStringPoolTable(const HstStringPoolTable&) = delete;
+    HstStringPoolTable& operator=(const HstStringPoolTable&) = delete;
+
+    /// The hash the table uses for a string (OUString::hashCode).
+    static sal_uInt32 hashOf(const OUString& rStr)
+    {
+        return static_cast<sal_uInt32>(rStr.hashCode());
+    }
+
+    /// The entry of a string equal to rStr, nHash being hashOf(rStr).
+    Entry find(const OUString& rStr, sal_uInt32 nHash) const;
+
+    /// Adds rStr (not in the table yet; nHash = hashOf(rStr)) with its upper-case string pUpper,
+    /// which is either rStr's own data or the string of another entry. Takes a reference on both.
+    void insert(const OUString& rStr, sal_uInt32 nHash, rtl_uString* pUpper);
+
+    /// Removes the entries nobody else references, as svl::SharedStringPool::purge documents:
+    /// first strings that differ from their upper case and are referenced by the table only,
+    /// then upper-case strings referenced only by their own entry.
+    void purgeUnused();
+
+    size_t size() const { return mnSize; }
+    size_t capacity() const { return mnCapacity; }
+
+    /// Calls rFunc(const Entry&) for every entry.
+    template <typename Func> void forEach(Func rFunc) const
+    {
+        for (size_t i = 0; i < mnCapacity; ++i)
+            if (mpEntries[i].pStr)
+                rFunc(mpEntries[i]);
+    }
+
+private:
+    /// Slot where the probe for nHash starts.
+    size_t home(sal_uInt32 nHash) const
+    {
+        // Fibonacci mixing of the string hash, then a multiply-shift onto [0, capacity): any
+        // capacity works, so the table grows by half instead of doubling.
+        const sal_uInt32 nMixed
+            = static_cast<sal_uInt32>((sal_uInt64(nHash) * 0x9E3779B97F4A7C15ULL) >> 32);
+        return static_cast<size_t>((sal_uInt64(nMixed) * mnCapacity) >> 32);
+    }
+    size_t next(size_t nSlot) const { return nSlot + 1 == mnCapacity ? 0 : nSlot + 1; }
+
+    /// Puts an entry into the first free slot of its probe sequence (no growth, no references).
+    void place(const Entry& rEntry, sal_uInt32 nHash);
+    /// Makes room for one more entry, keeping the load at or under 4/5.
+    void reserveOneMore();
+    /// Moves every entry back to the first free slot of its probe sequence after removals.
+    void repairChains(size_t nFreeBefore);
+
+    std::unique_ptr<Entry[]> mpEntries;
+    std::unique_ptr<sal_uInt32[]> mpHashes;
+    size_t mnCapacity = 0;
+    size_t mnSize = 0;
+};
+}
