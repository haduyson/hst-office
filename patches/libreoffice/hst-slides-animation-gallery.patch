+namespace
+{
+struct Selection
+{
+    SdPage* pPage = nullptr;
+    std::vector<uno::Reference<drawing::XShape>> aShapes;
+};
+
+Selection SelectedShapes(ViewShellBase& rBase)
+{
+    Selection aSelection;
+    const auto pMain = rBase.GetMainViewShell();
+    auto* pDraw = dynamic_cast<DrawViewShell*>(pMain.get());
+    if (!pDraw || !pDraw->GetView())
+        return aSelection;
+    SdPage* pPage = pDraw->GetActualPage();
+    if (!pPage || pPage->GetPageKind() != PageKind::Standard || pPage->IsMasterPage())
+        return aSelection;
+    const SdrMarkList& rMarks = pDraw->GetView()->GetMarkedObjectList();
+    for (size_t i = 0; i < rMarks.GetMarkCount(); ++i)
+    {
+        SdrObject* pObject = rMarks.GetMark(i)->GetMarkedSdrObj();
+        if (pObject)
+        {
+            uno::Reference<drawing::XShape> xShape = pObject->getUnoShape();
+            if (xShape.is())
+                aSelection.aShapes.push_back(std::move(xShape));
+        }
+    }
+    aSelection.pPage = pPage;
+    return aSelection;
+}
+
+OUString FirstEffect(const MainSequencePtr& pSequence,
+                     const uno::Reference<drawing::XShape>& xShape)
+{
+    for (const auto& pEffect : pSequence->getSequence())
+        if (pEffect && pEffect->getTargetShape() == xShape)
+            return pEffect->getPresetId();
+    return AnimationNone;
+}
+
+OUString Current(const Selection& rSelection)
+{
+    if (!rSelection.pPage || rSelection.aShapes.empty())
+        return OUString();
+    const MainSequencePtr pSequence = rSelection.pPage->getMainSequence();
+    const OUString aFirst = FirstEffect(pSequence, rSelection.aShapes.front());
+    for (const auto& xShape : rSelection.aShapes)
+        if (FirstEffect(pSequence, xShape) != aFirst)
+            return OUString();
+    return aFirst;
+}
+
+// CustomAnimationPane::onAdd(): a lone text shape with no fill or outline animates by paragraph.
+bool AnimateByParagraph(const Selection& rSelection)
+{
+    if (rSelection.aShapes.size() != 1)
+        return false;
+    const auto& xShape = rSelection.aShapes.front();
+    uno::Reference<text::XText> xText(xShape, uno::UNO_QUERY);
+    if (!xText.is() || xText->getString().isEmpty())
+        return false;
+    const OUString aType = xShape->getShapeType();
+    if (aType != "com.sun.star.presentation.TitleTextShape"
+        && aType != "com.sun.star.presentation.OutlinerShape"
+        && aType != "com.sun.star.presentation.SubtitleShape"
+        && aType != "com.sun.star.drawing.TextShape")
+        return false;
+    uno::Reference<beans::XPropertySet> xProperties(xShape, uno::UNO_QUERY_THROW);
+    drawing::FillStyle eFill = drawing::FillStyle_SOLID;
+    drawing::LineStyle eLine = drawing::LineStyle_SOLID;
+    xProperties->getPropertyValue(u"FillStyle"_ustr) >>= eFill;
+    xProperties->getPropertyValue(u"LineStyle"_ustr) >>= eLine;
+    return eFill == drawing::FillStyle_NONE && eLine == drawing::LineStyle_NONE;
+}
+}
+
+OUString CurrentAnimation(ViewShellBase& rBase)
+{
+    try
+    {
+        return Current(SelectedShapes(rBase));
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("sd", "Reading the ribbon animation state");
+        return OUString();
+    }
+}
+
+bool ApplyAnimation(ViewShellBase& rBase, std::u16string_view rPresetId)
+{
+    try
+    {
+        DrawDocShell* pDocSh = rBase.GetDocShell();
+        if (!pDocSh || !pDocSh->GetDoc() || pDocSh->IsReadOnly())
+            return false;
+        const Selection aSelection = SelectedShapes(rBase);
+        if (!aSelection.pPage || aSelection.aShapes.empty())
+            return false;
+        const bool bNone = rPresetId == AnimationNone;
+        const CustomAnimationPresetPtr pDescriptor
+            = bNone ? CustomAnimationPresetPtr()
+                    : CustomAnimationPresets::getCustomAnimationPresets().getEffectDescriptor(
+                          OUString(rPresetId));
+        if (!bNone && !pDescriptor)
+            return false;
+        const bool bParagraphs = !bNone && AnimateByParagraph(aSelection);
+        const MainSequencePtr pSequence = aSelection.pPage->getMainSequence();
+        // Copy before removing: remove() invalidates the sequence's iterators. getTargetShape()
+        // also matches ParagraphTarget, so every paragraph effect of a selected shape is removed.
+        EffectSequence aRemove;
+        for (const auto& pEffect : pSequence->getSequence())
+            if (pEffect && std::find(aSelection.aShapes.begin(), aSelection.aShapes.end(),
+                                     pEffect->getTargetShape()) != aSelection.aShapes.end())
+                aRemove.push_back(pEffect);
+
+        if (bNone && aRemove.empty())
+            return true; // nothing to remove: no empty undo step
+
+        // Flush a previous pending edit before UndoAnimation clones the page's UNO tree.
+        pSequence->getRootNode();
+        // The entire replacement (or None) is one action, captured before any mutation.
+        if (SfxUndoManager* pManager = pDocSh->GetUndoManager())
+            pManager->AddUndoAction(std::make_unique<UndoAnimation>(pDocSh->GetDoc(), aSelection.pPage));
+        bool bChanged = false;
+        comphelper::ScopeGuard aModified([&]() {
+            if (bChanged)
+            {
+                // Runs after the rebuild guard releases, including on exceptional exits.
+                // Immediate undo/redo and consecutive dispatches must see the new UNO tree.
+                try
+                {
+                    pSequence->getRootNode();
+                }
+                catch (const uno::Exception&)
+                {
+                    TOOLS_WARN_EXCEPTION("sd", "Flushing a ribbon animation");
+                }
+                pDocSh->SetModified();
+            }
+        });
+        MainSequenceRebuildGuard aRebuild(pSequence);
+        for (const auto& pEffect : aRemove)
+        {
+            bChanged = true;
+            pSequence->remove(pEffect);
+        }
+        if (bNone)
+            return true;
+        bool bFirst = true;
+        for (const auto& xShape : aSelection.aShapes)
+        {
+            uno::Reference<document::XActionLockable> xLockable(xShape, uno::UNO_QUERY);
+            if (xLockable.is())
+                xLockable->addActionLock();
+            comphelper::ScopeGuard aUnlock([&xLockable]() {
+                try
+                {
+                    if (xLockable.is())
+                        xLockable->removeActionLock();
+                }
+                catch (const uno::Exception&)
+                {
+                    TOOLS_WARN_EXCEPTION("sd", "Unlocking an animated shape");
+                }
+            });
+            bChanged = true;
+            const uno::Any aTarget(xShape);
+            const CustomAnimationEffectPtr pCreated
+                = pSequence->append(pDescriptor, aTarget, pDescriptor->getDuration());
+            if (!pCreated)
+                return false;
+            if (bParagraphs)
+                pSequence->createTextGroup(pCreated, 1, -1.0, false, false);
+            if (!bFirst)
+                pCreated->setNodeType(presentation::EffectNodeType::WITH_PREVIOUS);
+            bFirst = false;
+        }
+        return true;
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("sd", "Applying a ribbon animation");
+        return false;
+    }
+}
+
+void ExecuteApplyAnimation(ViewShellBase& rBase, SfxRequest& rRequest)
+{
+    const SfxItemSet* pArgs = rRequest.GetArgs();
+    const SfxStringItem* pEffect = pArgs ? pArgs->GetItem<SfxStringItem>(SID_HST_APPLY_ANIMATION) : nullptr;
+    if (!pEffect || !ApplyAnimation(rBase, pEffect->GetValue()))
+    {
+        rRequest.Ignore();
+        return;
+    }
+    rBase.GetViewFrame().GetBindings().Invalidate(SID_HST_APPLY_ANIMATION);
+    rRequest.Done();
+}
+
+void GetApplyAnimationState(ViewShellBase& rBase, SfxItemSet& rSet)
+{
+    try
+    {
+        DrawDocShell* pDocSh = rBase.GetDocShell();
+        const Selection aSelection = SelectedShapes(rBase);
+        if (!pDocSh || pDocSh->IsReadOnly() || aSelection.aShapes.empty())
+        {
+            rSet.DisableItem(SID_HST_APPLY_ANIMATION);
+            return;
+        }
+        rSet.Put(SfxStringItem(SID_HST_APPLY_ANIMATION, Current(aSelection)));
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("sd", "Reading the ribbon animation selection");
+        rSet.DisableItem(SID_HST_APPLY_ANIMATION);
+    }
+}
+}
