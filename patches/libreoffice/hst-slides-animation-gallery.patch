+
+using namespace css;
+
+namespace
+{
+constexpr OUString COMMAND = u".uno:HstApplyAnimation"_ustr;
+// the room one item takes in the icon view: its item width (hstanimationgallery.ui) with padding,
+// margins and the label; a page holds only as many as fit, so no item wraps into a hidden row
+constexpr tools::Long ITEM_WIDTH = 130;
+constexpr int MIN_ITEMS = 3; // the narrowest gallery still shows three animations
+
+bool GalleryEnabled()
+{
+    if (comphelper::LibreOfficeKit::isActive())
+        return false;
+    try
+    {
+        return officecfg::Office::HSTRibbon::SlidesEffectGalleries::get();
+    }
+    catch (const uno::Exception&)
+    {
+        return true; // the schema ships with the switch on
+    }
+}
+
+struct Entry
+{
+    OUString aPresetId;
+    OUString aLabel;
+    OUString aIcon;
+    OUString aAccessibleName;
+};
+
+struct PresetSpec
+{
+    OUString aId;
+    OUString aFallback;
+    TranslateId aClass;
+};
+
+// Fixed Office gallery order. Only the explicitly listed alternatives are used if a preset is absent.
+const PresetSpec PRESETS[] = {
+    { u"ooo-entrance-appear"_ustr, OUString(), STR_HST_ANIM_ENTRANCE },
+    { u"ooo-entrance-fade-in"_ustr, OUString(), STR_HST_ANIM_ENTRANCE },
+    { u"ooo-entrance-fly-in"_ustr, OUString(), STR_HST_ANIM_ENTRANCE },
+    { u"ooo-entrance-float"_ustr, u"ooo-entrance-ascend"_ustr, STR_HST_ANIM_ENTRANCE },
+    { u"ooo-entrance-split"_ustr, OUString(), STR_HST_ANIM_ENTRANCE },
+    { u"ooo-entrance-wipe"_ustr, OUString(), STR_HST_ANIM_ENTRANCE },
+    { u"ooo-entrance-wheel"_ustr, u"ooo-entrance-spoke-wheel"_ustr, STR_HST_ANIM_ENTRANCE },
+    { u"ooo-entrance-random-bars"_ustr, OUString(), STR_HST_ANIM_ENTRANCE },
+    { u"ooo-entrance-zoom"_ustr, u"ooo-entrance-grow-and-turn"_ustr, STR_HST_ANIM_ENTRANCE },
+    { u"ooo-entrance-bounce"_ustr, u"ooo-entrance-boomerang"_ustr, STR_HST_ANIM_ENTRANCE },
+    { u"ooo-emphasis-spin"_ustr, OUString(), STR_HST_ANIM_EMPHASIS },
+    { u"ooo-emphasis-grow-and-shrink"_ustr, OUString(), STR_HST_ANIM_EMPHASIS },
+    { u"ooo-emphasis-transparency"_ustr, OUString(), STR_HST_ANIM_EMPHASIS },
+    { u"ooo-emphasis-blink"_ustr, OUString(), STR_HST_ANIM_EMPHASIS },
+    { u"ooo-exit-disappear"_ustr, OUString(), STR_HST_ANIM_EXIT },
+    { u"ooo-exit-fade-out"_ustr, OUString(), STR_HST_ANIM_EXIT },
+    { u"ooo-exit-fly-out"_ustr, OUString(), STR_HST_ANIM_EXIT },
+    { u"ooo-exit-split"_ustr, OUString(), STR_HST_ANIM_EXIT },
+    { u"ooo-exit-zoom"_ustr, OUString(), STR_HST_ANIM_EXIT },
+};
+
+std::vector<Entry> Entries()
+{
+    const OUString aNone = SdResId(STR_SLIDETRANSITION_NONE);
+    std::vector<Entry> aEntries{ { sd::hst::AnimationNone, aNone,
+                                   u"sd/cmd/transition-none.png"_ustr, aNone } };
+    try
+    {
+        const auto& rPresets = sd::CustomAnimationPresets::getCustomAnimationPresets();
+        for (const auto& rSpec : PRESETS)
+        {
+            auto pPreset = rPresets.getEffectDescriptor(rSpec.aId);
+            if (!pPreset && !rSpec.aFallback.isEmpty())
+                pPreset = rPresets.getEffectDescriptor(rSpec.aFallback);
+            if (!pPreset)
+                continue;
+            const OUString aLabel = pPreset->getLabel();
+            const OUString aAccessibleName = aLabel + u" ("_ustr + SdResId(rSpec.aClass) + u")"_ustr;
+            // Colibre has no individual effect icons; the animation command icon serves each class.
+            aEntries.push_back({ pPreset->getPresetId(), aLabel,
+                                 u"cmd/lc_animationeffects.png"_ustr, aAccessibleName });
+        }
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("sd", "Loading ribbon animation presets");
+    }
+    return aEntries;
+}
+
+class HstAnimationGalleryWindow final : public InterimItemWindow
+{
+public:
+    HstAnimationGalleryWindow(vcl::Window* pParent, uno::Reference<frame::XFrame> xFrame)
+        : InterimItemWindow(pParent, u"modules/simpress/ui/hstanimationgallery.ui"_ustr,
+                            u"AnimationGalleryBox"_ustr, true)
+        , m_xFrame(std::move(xFrame))
+        , m_xView(m_xBuilder->weld_icon_view(u"animations"_ustr))
+        , m_xPrev(m_xBuilder->weld_button(u"prev"_ustr))
+        , m_xNext(m_xBuilder->weld_button(u"next"_ustr))
+        , m_xMore(m_xBuilder->weld_button(u"more"_ustr))
+        , m_aEntries(Entries())
+        , m_aRefill("sd HstAnimationGallery refill")
+    {
+        InitControlBase(m_xView.get());
+        m_xView->set_item_width(96);
+        m_xView->set_size_request(ITEM_WIDTH * MIN_ITEMS, -1);
+        // a click selects (as in the Styles gallery); Enter or a double click activates
+        m_xView->connect_selection_changed(LINK(this, HstAnimationGalleryWindow, SelectedHdl));
+        m_xView->connect_item_activated(LINK(this, HstAnimationGalleryWindow, ActivatedHdl));
+        m_xPrev->connect_clicked(LINK(this, HstAnimationGalleryWindow, PageHdl));
+        m_xNext->connect_clicked(LINK(this, HstAnimationGalleryWindow, PageHdl));
+        m_xMore->connect_clicked(LINK(this, HstAnimationGalleryWindow, MoreHdl));
+        m_aRefill.SetInvokeHandler(LINK(this, HstAnimationGalleryWindow, RefillHdl));
+        ShowPage();
+        SetSizePixel(get_preferred_size());
+    }
+
+    ~HstAnimationGalleryWindow() override { disposeOnce(); }
+
+    void dispose() override
+    {
+        m_aRefill.Stop();
+        m_xView.reset();
+        m_xPrev.reset();
+        m_xNext.reset();
+        m_xMore.reset();
+        InterimItemWindow::dispose();
+    }
+
+    // the page size follows the width the toolbox gives the gallery (it expands into the room
+    // the ribbon has left); the icon view's own allocation follows its items and would only shrink
+    void Resize() override
+    {
+        InterimItemWindow::Resize();
+        if (!m_xMore)
+            return;
+        const tools::Long nWidth
+            = GetSizePixel().Width() - m_xMore->get_preferred_size().Width() - 4;
+        if (nWidth == m_nViewWidth)
+            return;
+        m_nViewWidth = nWidth;
+        if (PageSize() != m_nPageSize)
+            m_aRefill.Start(); // not while the window is being laid out
+    }
+
+    /// The animation of the selected shapes (empty: several, or one the gallery does not have).
+    void SetCurrent(const OUString& rPresetId)
+    {
+        if (m_aCurrent == rPresetId)
+            return;
+        m_aCurrent = rPresetId;
+        // bring the page with the current effect into view, as Office's gallery does
+        const auto it = std::find_if(m_aEntries.begin(), m_aEntries.end(),
+                                     [&rPresetId](const Entry& rEntry) { return rEntry.aPresetId == rPresetId; });
+        if (it != m_aEntries.end() && m_nPageSize)
+        {
+            const size_t nIndex = it - m_aEntries.begin();
+            if (nIndex < m_nFirst || nIndex >= m_nFirst + m_nPageSize)
+                m_nFirst = nIndex - nIndex % m_nPageSize;
+        }
+        ShowPage();
+    }
+
+private:
+    size_t PageSize() const
+    {
+        return m_nViewWidth > 0 ? std::max<size_t>(1, m_nViewWidth / ITEM_WIDTH) : MIN_ITEMS;
+    }
+
+    void ShowPage()
+    {
+        if (!m_xView)
+            return;
+        m_nPageSize = PageSize();
+        if (m_nFirst >= m_aEntries.size())
+            m_nFirst = 0;
+        m_nFirst -= m_nFirst % m_nPageSize; // pages start at multiples of the page size
+        const size_t nEnd = std::min(m_aEntries.size(), m_nFirst + m_nPageSize);
+
+        m_bFilling = true; // our own selection below is not a choice of the user
+        m_xView->freeze();
+        m_xView->clear();
+        int nSelect = -1;
+        for (size_t i = m_nFirst; i < nEnd; ++i)
+        {
+            const Entry& rEntry = m_aEntries[i];
+            const int nPos = static_cast<int>(i - m_nFirst);
+            m_xView->insert(nPos, &rEntry.aLabel, &rEntry.aPresetId, &rEntry.aIcon, nullptr);
+            m_xView->set_item_tooltip_text(nPos, rEntry.aAccessibleName);
+            m_xView->set_item_accessible_name(nPos, rEntry.aAccessibleName);
+            if (rEntry.aPresetId == m_aCurrent)
+                nSelect = nPos;
+        }
+        m_xView->thaw();
+        if (nSelect >= 0)
+            m_xView->select(nSelect);
+        else
+            m_xView->unselect_all();
+        m_bFilling = false;
+        m_xPrev->set_sensitive(m_nFirst > 0);
+        m_xNext->set_sensitive(nEnd < m_aEntries.size());
+    }
+
+    void Apply(const OUString& rPresetId);
+    DECL_LINK(ActivatedHdl, const weld::TreeIter&, bool);
+    DECL_LINK(SelectedHdl, weld::ItemView&, void);
+    DECL_LINK(PageHdl, weld::Button&, void);
+    DECL_LINK(MoreHdl, weld::Button&, void);
+    DECL_LINK(RefillHdl, Timer*, void);
+
+    uno::Reference<frame::XFrame> m_xFrame;
+    std::unique_ptr<weld::IconView> m_xView;
+    std::unique_ptr<weld::Button> m_xPrev;
+    std::unique_ptr<weld::Button> m_xNext;
+    std::unique_ptr<weld::Button> m_xMore;
+    std::vector<Entry> m_aEntries;
+    Idle m_aRefill;
+    OUString m_aCurrent;
+    size_t m_nFirst = 0;
+    size_t m_nPageSize = 0;
+    tools::Long m_nViewWidth = 0;
+    bool m_bFilling = false;
+};
+
+void HstAnimationGalleryWindow::Apply(const OUString& rPresetId)
+{
+    if (rPresetId.isEmpty() || !m_xFrame.is())
+        return;
+    try
+    {
+        comphelper::dispatchCommand(COMMAND, m_xFrame,
+                                    { comphelper::makePropertyValue(u"Effect"_ustr, rPresetId) });
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("sd", "Dispatching a ribbon animation");
+    }
+}
+
+IMPL_LINK(HstAnimationGalleryWindow, ActivatedHdl, const weld::TreeIter&, rIter, bool)
+{
+    Apply(m_xView->get_id(rIter));
+    return true;
+}
+
+IMPL_LINK_NOARG(HstAnimationGalleryWindow, SelectedHdl, weld::ItemView&, void)
+{
+    if (!m_bFilling)
+        Apply(m_xView->get_selected_id());
+}
+
+IMPL_LINK_NOARG(HstAnimationGalleryWindow, RefillHdl, Timer*, void) { ShowPage(); }
+
+IMPL_LINK(HstAnimationGalleryWindow, PageHdl, weld::Button&, rButton, void)
+{
+    if (!m_nPageSize)
+        return;
+    if (&rButton == m_xNext.get())
+    {
+        if (m_nFirst + m_nPageSize < m_aEntries.size())
+            m_nFirst += m_nPageSize;
+    }
+    else
+        m_nFirst = m_nFirst > m_nPageSize ? m_nFirst - m_nPageSize : 0;
+    ShowPage();
+}
+
+IMPL_LINK_NOARG(HstAnimationGalleryWindow, MoreHdl, weld::Button&, void)
+{
+    try
+    {
+        if (m_xFrame.is())
+            comphelper::dispatchCommand(u".uno:SidebarDeck.SdCustomAnimationDeck"_ustr, m_xFrame, {});
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("sd", "Opening the Custom Animation deck");
+    }
+}
+
+using HstAnimationGalleryControl_Base
+    = cppu::ImplInheritanceHelper<svt::ToolboxController, lang::XServiceInfo>;
+
+class HstAnimationGalleryControl final : public HstAnimationGalleryControl_Base
+{
+public:
+    HstAnimationGalleryControl() = default;
+
+    // XInitialization
+    void SAL_CALL initialize(const uno::Sequence<uno::Any>& rArguments) override
+    {
+        try
+        {
+            svt::ToolboxController::initialize(rArguments);
+        }
+        catch (const uno::Exception&)
+        {
+            TOOLS_WARN_EXCEPTION("sd", "Initializing the ribbon animation gallery");
+            return;
+        }
+        if (GalleryEnabled())
+            return;
+        // switched off: the gallery's place stays empty (the Custom Animation deck has everything)
+        SolarMutexGuard aGuard;
+        ToolBox* pToolBox = nullptr;
+        ToolBoxItemId nId;
+        if (getToolboxId(nId, &pToolBox))
+            pToolBox->HideItem(nId);
+    }
+
+    // XUpdatable
+    void SAL_CALL update() override {}
+
+    // XStatusListener
+    void SAL_CALL statusChanged(const frame::FeatureStateEvent& rEvent) override
+    {
+        SolarMutexGuard aGuard;
+        if (!m_xWindow || m_xWindow->isDisposed()) // the toolbox can dispose its item window first
+            return;
+        m_xWindow->Enable(rEvent.IsEnabled);
+        OUString aPresetId;
+        rEvent.State >>= aPresetId;
+        m_xWindow->SetCurrent(rEvent.IsEnabled ? aPresetId : OUString());
+    }
+
+    // XToolbarController
+    uno::Reference<awt::XWindow> SAL_CALL createItemWindow(const uno::Reference<awt::XWindow>& rParent) override
+    {
+        if (!GalleryEnabled())
+            return {};
+        SolarMutexGuard aGuard;
+        try
+        {
+            VclPtr<vcl::Window> pParent = VCLUnoHelper::GetWindow(rParent);
+            if (!pParent)
+                return {};
+            m_xWindow = VclPtr<HstAnimationGalleryWindow>::Create(pParent, m_xFrame);
+            return VCLUnoHelper::GetInterface(m_xWindow);
+        }
+        catch (const uno::Exception&)
+        {
+            TOOLS_WARN_EXCEPTION("sd", "Creating the ribbon animation gallery");
+            return {};
+        }
+    }
+
+    // XServiceInfo
+    OUString SAL_CALL getImplementationName() override
+    {
+        return u"com.sun.star.comp.sd.HstAnimationGalleryControl"_ustr;
+    }
+    sal_Bool SAL_CALL supportsService(const OUString& rServiceName) override
+    {
+        return cppu::supportsService(this, rServiceName);
+    }
+    uno::Sequence<OUString> SAL_CALL getSupportedServiceNames() override
+    {
+        return { u"com.sun.star.frame.ToolbarController"_ustr };
+    }
+
+    // WeakComponentImplHelperBase
+    using HstAnimationGalleryControl_Base::disposing;
+    void disposing(std::unique_lock<std::mutex>& rGuard) override
+    {
+        svt::ToolboxController::disposing(rGuard);
+        comphelper::unique_unlock aUnlock(rGuard);
+        SolarMutexGuard aSolarGuard;
+        m_xWindow.disposeAndClear();
+    }
+
+private:
+
+    VclPtr<HstAnimationGalleryWindow> m_xWindow;
+};
+}
+
+extern "C" SAL_DLLPUBLIC_EXPORT uno::XInterface*
+com_sun_star_comp_sd_HstAnimationGalleryControl_get_implementation(uno::XComponentContext*,
+                                                                    uno::Sequence<uno::Any> const&)
+{
+    return cppu::acquire(new HstAnimationGalleryControl);
+}
