+// HST Office: one row of shape animations; click or Enter replaces the selected shapes'
+// effects with one undo action. Paging and layout mirror the transitions gallery;
+// the final button opens the Custom Animation deck. SlidesEffectGalleries hides the item.
+
+#include <HstAnimationApply.hxx>
+#include <CustomAnimationPreset.hxx>
+#include <sdresid.hxx>
