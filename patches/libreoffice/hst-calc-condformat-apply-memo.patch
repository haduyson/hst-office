+
+// HST Office: the result of one change applied to the cell formats of a column range, per format.
+//
+// Adding a conditional format to a range copies the cell format of every run of cells in the range, adds
+// the conditional format to the copy and registers it. Registering finds an equal format that is already
+// registered and uses that one, so equal inputs always end in the same registered format. Workbooks that
+// give neighbouring cells different formats have one run per cell: a 300 000-row column made 300 000 copies
+// and registrations of a few thousand distinct formats, a third of loading such a workbook. The memo keeps,
+// for one such change, the registered result of each input format; the input and the result are both held,
+// so neither can be freed and replaced by another format at the same address while the memo lives.
+
+#pragma once
+
+#include "patattr.hxx"
+
+#include <unordered_map>
+#include <utility>
+
+class HstPatternMemo
+{
+public:
+    /** The result stored for pInput, or nullptr. */
+    const CellAttributeHolder* find(const ScPatternAttr* pInput) const
+    {
+        auto it = maResults.find(pInput);
+        return it == maResults.end() ? nullptr : &it->second.second;
+    }
+
+    /** Stores the registered result for a registered input. */
+    void insert(const ScPatternAttr* pInput, const CellAttributeHolder& rResult)
+    {
+        if (pInput && pInput->isRegistered() && rResult.getScPatternAttr())
+            maResults.try_emplace(pInput, CellAttributeHolder(pInput), rResult);
+    }
+
+private:
+    std::unordered_map<const ScPatternAttr*, std::pair<CellAttributeHolder, CellAttributeHolder>> maResults;
+};
+
