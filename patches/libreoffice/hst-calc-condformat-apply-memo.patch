@@ -1708,6 +1708,48 @@ CPPUNIT_TEST_FIXTURE(TestCondformat, testOptimalRowHeightsOnePassEqualsRowByRow)
     m_pDoc->DeleteTab(0);
 }
 
+CPPUNIT_TEST_FIXTURE(TestCondformat, testAddCondFormatKeepsEachCellFormat)
+{
+    // Adding a conditional format to a range of many cell formats: every cell keeps its own format with the
+    // conditional format added, and equal formats end in the same registered format.
+    m_pDoc->InsertTab(0, u"Test"_ustr);
+    CellAttributeHelper& rHelper = m_pDoc->getCellAttributeHelper();
+    constexpr SCROW nRows = 600;
+    for (SCROW nRow = 0; nRow < nRows; ++nRow)
+    {
+        ScPatternAttr aPattern(rHelper);
+        aPattern.ItemSetPut(SvxFontHeightItem(200 + 20 * (nRow % 7), 100, ATTR_FONT_HEIGHT));
+        m_pDoc->ApplyPattern(0, nRow, 0, aPattern);
+    }
+    ScPatternAttr aOther(rHelper);
+    aOther.ItemSetPut(ScCondFormatItem(99));
+    m_pDoc->ApplyPattern(0, 5, 0, aOther); // one cell already has another conditional format
+
+    auto pFormat = std::make_unique<ScConditionalFormat>(1, *m_pDoc);
+    pFormat->SetRange(ScRange(0, 0, 0, 0, nRows - 1, 0));
+    auto pFormatTmp = pFormat.get();
+    sal_uInt32 nKey = m_pDoc->AddCondFormat(std::move(pFormat), 0);
+    pFormatTmp->AddEntry(new ScCondFormatEntry(ScConditionMode::Greater, u"6"_ustr, u""_ustr, *m_pDoc,
+                                               ScAddress(0, 0, 0), ScResId(STR_STYLENAME_RESULT)));
+    m_pDoc->AddCondFormatData(pFormatTmp->GetRange(), 0, nKey);
+
+    for (SCROW nRow = 0; nRow < nRows; ++nRow)
+    {
+        const ScPatternAttr* pPattern = m_pDoc->GetPattern(0, nRow, 0);
+        const ScCondFormatIndexes& rIndexes = pPattern->GetItem(ATTR_CONDITIONAL).GetCondFormatData();
+        CPPUNIT_ASSERT(rIndexes.find(nKey) != rIndexes.end());
+        CPPUNIT_ASSERT_EQUAL(size_t(nRow == 5 ? 2 : 1), rIndexes.size());
+        if (nRow != 5)
+        {
+            CPPUNIT_ASSERT_EQUAL(sal_uInt32(200 + 20 * (nRow % 7)),
+                                 pPattern->GetItem(ATTR_FONT_HEIGHT).GetHeight());
+            if (nRow >= 7 && nRow - 7 != 5)
+                CPPUNIT_ASSERT_EQUAL(m_pDoc->GetPattern(0, nRow - 7, 0), pPattern);
+        }
+    }
+    m_pDoc->DeleteTab(0);
+}
