+    copy, and belongs to its document: it is dropped when the document closes and pasting into another
+    document does nothing. */
+namespace sd::hst
+{
+void ExecuteFormatCopyPaste(DrawViewShell& rShell, SfxRequest& rRequest);
+void GetFormatCopyPasteState(DrawViewShell& rShell, SfxItemSet& rSet);
+}
