+/** What .uno:HstCopyFormat took: the formats in the item pool of their document, so the copy is
+    dropped when that document goes (SdDrawDocument broadcasts ModelCleared while its pool lives). */
+class FormatCopy final : public SfxListener
+{
+public:
+    void Set(SdDrawDocument& rDoc, std::shared_ptr<SfxItemSet> xSet, sal_Int16 nDepth)
+    {
+        Clear();
+        mpDoc = &rDoc;
+        StartListening(rDoc);
+        mxSet = std::move(xSet);
+        mnDepth = nDepth;
+    }
+
+    void Clear()
+    {
+        if (mpDoc)
+            EndListening(*mpDoc);
+        mpDoc = nullptr;
+        mxSet.reset();
+        mnDepth = -1;
+    }
+
+    // The copy for rDoc, or null: formats of another document's pool are not pasted.
+    SfxItemSet* For(const SdDrawDocument* pDoc) const
+    {
+        return (pDoc && pDoc == mpDoc) ? mxSet.get() : nullptr;
+    }
+
+    sal_Int16 Depth() const { return mnDepth; }
+
+    void Notify(SfxBroadcaster&, const SfxHint& rHint) override
+    {
+        if (rHint.GetId() == SfxHintId::Dying
+            || (rHint.GetId() == SfxHintId::ThisIsAnSdrHint
+                && static_cast<const SdrHint&>(rHint).GetKind() == SdrHintKind::ModelCleared))
+            Clear();
+    }
+
+private:
+    SdDrawDocument* mpDoc = nullptr;
+    std::shared_ptr<SfxItemSet> mxSet;
+    sal_Int16 mnDepth = -1;
+};
+
+FormatCopy& theFormatCopy()
+{
+    static FormatCopy aCopy;
+    return aCopy;
+}
+
+// As the Clone Formatting brush: paragraph formats only when whole paragraphs are selected.
+bool PasteParagraphFormats(const OutlinerView* pOLV)
+{
+    if (!pOLV || !pOLV->GetEditView().HasSelection())
+        return true;
+    if (!pOLV->GetEditView().IsSelectionWithinSinglePara())
+        return false;
+    return pOLV->GetEditView().IsSelectionFullPara();
+}
+
+void Paste(sd::DrawViewShell& rShell, sd::View& rView, SdDrawDocument& rDoc, SfxItemSet& rSet)
+{
+    const sal_Int16 nDepth = theFormatCopy().Depth();
+    OutlinerView* pOLV = rView.GetTextEditOutlinerView();
+    if (pOLV)
+    {
+        // Editing text: the outliner records the undo action, as for the brush.
+        rView.ApplyFormatPaintBrush(rSet, nDepth, false, !PasteParagraphFormats(pOLV));
+        return;
+    }
+
+    // Shapes: every selected shape, one at a time (the brush applies to the first marked shape).
+    std::vector<std::pair<SdrObject*, SdrPageView*>> aShapes;
+    const SdrMarkList& rMarkList = rView.GetMarkedObjectList();
+    for (size_t i = 0; i < rMarkList.GetMarkCount(); ++i)
+    {
+        const SdrMark* pMark = rMarkList.GetMark(i);
+        aShapes.emplace_back(pMark->GetMarkedSdrObj(), pMark->GetPageView());
+    }
+    if (aShapes.empty())
+        return;
+
+    const bool bUndo = rDoc.IsUndoEnabled();
+    if (bUndo)
+    {
+        rDoc.BegUndo(rShell.GetViewShellBase().RetrieveLabelFromCommand(u".uno:HstPasteFormat"_ustr));
+        for (const auto& [pObj, pPV] : aShapes)
+        {
+            if (dynamic_cast<sdr::table::SdrTableObj*>(pObj) == nullptr)
+                rDoc.AddUndo(rDoc.GetSdrUndoFactory().CreateUndoAttrObject(*pObj, false, true));
+        }
+    }
+    if (aShapes.size() == 1)
+        rView.ApplyFormatPaintBrush(rSet, nDepth, false, false);
+    else
+    {
+        for (const auto& [pObj, pPV] : aShapes)
+        {
+            rView.UnmarkAllObj();
+            rView.MarkObj(pObj, pPV);
+            rView.ApplyFormatPaintBrush(rSet, nDepth, false, false);
+        }
+        rView.UnmarkAllObj();
+        for (const auto& [pObj, pPV] : aShapes)
+            rView.MarkObj(pObj, pPV);
+    }
+    if (bUndo)
+        rDoc.EndUndo();
+}
+}
+
+namespace sd::hst
+{
+void ExecuteFormatCopyPaste(DrawViewShell& rShell, SfxRequest& rRequest)
+{
+    View* pView = rShell.GetView();
+    SdDrawDocument* pDoc = rShell.GetDoc();
+    if (!pView || !pDoc || pView->GetMarkedObjectList().GetMarkCount() == 0)
+        return;
+
+    if (rRequest.GetSlot() == SID_HST_COPY_FORMAT)
+    {
+        std::shared_ptr<SfxItemSet> xSet;
+        const sal_Int32 nDepth = pView->TakeFormatPaintBrush(xSet);
+        if (xSet)
+            theFormatCopy().Set(*pDoc, std::move(xSet), static_cast<sal_Int16>(nDepth));
+        rRequest.Done();
+        return;
+    }
+
+    SfxItemSet* pSet = theFormatCopy().For(pDoc);
+    if (!pSet || rShell.GetDocSh()->IsReadOnly())
+        return;
+    Paste(rShell, *pView, *pDoc, *pSet);
+    rRequest.Done();
+}
+
+void GetFormatCopyPasteState(DrawViewShell& rShell, SfxItemSet& rSet)
+{
+    const View* pView = rShell.GetView();
+    const bool bMarked = pView && pView->GetMarkedObjectList().GetMarkCount() != 0;
+    if (SfxItemState::DEFAULT == rSet.GetItemState(SID_HST_COPY_FORMAT) && !bMarked)
+        rSet.DisableItem(SID_HST_COPY_FORMAT);
+    if (SfxItemState::DEFAULT == rSet.GetItemState(SID_HST_PASTE_FORMAT)
+        && (!bMarked || !theFormatCopy().For(rShell.GetDoc()) || rShell.GetDocSh()->IsReadOnly()))
+        rSet.DisableItem(SID_HST_PASTE_FORMAT);
+}
+}
