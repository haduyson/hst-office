+            uno::Reference< text::XTextRangeCompare > xCompare( xScope->getText(), uno::UNO_QUERY_THROW );
+            rtl::Reference< SwXTextTables > xTables = xDocument->getSwTextTables();
+            for( sal_Int32 i = 0, nCount = xTables->getCount(); i < nCount; ++i )
+            {
+                rtl::Reference< SwXTextTable > xTable = xTables->getTextTableByIndex( i );
+                if( xTable->getAnchor()->getText() != xScope->getText() )
+                    continue;
+                const uno::Reference< text::XTextRange > xAnchor = xTable->getAnchor();
+                if( xCompare->compareRegionStarts( xScope->getStart(), xAnchor ) >= 0 && xCompare->compareRegionEnds( xAnchor, xScope->getEnd() ) >= 0 )
+                    mxTables.push_back( xTable );
+            }
+        }
+        m_cachePos = mxTables.begin();
