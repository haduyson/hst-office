+    std::vector< uno::Reference< text::XTextContent > > maBookmarks;
+public:
+    BookmarksInRange( const uno::Reference< container::XIndexAccess >& xAll, const uno::Reference< text::XTextRange >& xScope )
+    {
+        uno::Reference< text::XTextRangeCompare > xCompare( xScope->getText(), uno::UNO_QUERY_THROW );
+        for( sal_Int32 i = 0, nCount = xAll->getCount(); i < nCount; ++i )
+        {
+            uno::Reference< text::XTextContent > xMark( xAll->getByIndex( i ), uno::UNO_QUERY_THROW );
+            uno::Reference< text::XTextRange > xAnchor = xMark->getAnchor();
+            if( xAnchor->getText() == xScope->getText()
+                && xCompare->compareRegionStarts( xScope->getStart(), xAnchor ) >= 0
+                && xCompare->compareRegionEnds( xAnchor, xScope->getEnd() ) >= 0 )
+                maBookmarks.push_back( xMark );
+        }
+    }
+    virtual sal_Int32 SAL_CALL getCount() override { return maBookmarks.size(); }
+    virtual uno::Any SAL_CALL getByIndex( sal_Int32 nIndex ) override
+    {
+        if( nIndex < 0 || nIndex >= getCount() )
+            throw lang::IndexOutOfBoundsException();
+        return uno::Any( maBookmarks[ nIndex ] );
+    }
+    virtual uno::Type SAL_CALL getElementType() override { return cppu::UnoType< text::XTextContent >::get(); }
+    virtual sal_Bool SAL_CALL hasElements() override { return !maBookmarks.empty(); }
+    virtual uno::Any SAL_CALL getByName( const OUString& rName ) override
+    {
+        for( const auto& xMark : maBookmarks )
+            if( uno::Reference< container::XNamed >( xMark, uno::UNO_QUERY_THROW )->getName() == rName )
+                return uno::Any( xMark );
+        throw container::NoSuchElementException();
+    }
+    virtual uno::Sequence< OUString > SAL_CALL getElementNames() override
+    {
+        uno::Sequence< OUString > aNames( maBookmarks.size() );
+        OUString* pName = aNames.getArray();
+        for( const auto& xMark : maBookmarks )
+            *pName++ = uno::Reference< container::XNamed >( xMark, uno::UNO_QUERY_THROW )->getName();
+        return aNames;
+    }
+    virtual sal_Bool SAL_CALL hasByName( const OUString& rName ) override { return comphelper::findValue( getElementNames(), rName ) != -1; }
+};
+
+}
