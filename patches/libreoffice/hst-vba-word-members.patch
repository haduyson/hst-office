+/// Puts the selection back when the range borrowed it
+struct KeepSelection
+{
+    uno::Reference<text::XTextViewCursor> mxCursor;
+    uno::Reference<text::XTextRange> mxStart, mxEnd;
+    explicit KeepSelection(const rtl::Reference<SwXTextDocument>& xDoc)
+        : mxCursor(word::getXTextViewCursor(xDoc))
+        , mxStart(mxCursor->getStart())
+        , mxEnd(mxCursor->getEnd())
+    {
+    }
+    ~KeepSelection()
+    {
+        try
+        {
+            mxCursor->gotoRange(mxStart, false);
+            mxCursor->gotoRange(mxEnd, true);
+        }
+        catch (const uno::Exception&)
+        {
+            // what was selected went away with the operation
+        }
+    }
+};
+
+}
+
+void SAL_CALL SwVbaRange::Copy()
+{
+    KeepSelection aKeep(mxTextDocument);
+    Select();
+    dispatchRequests(static_cast<SfxBaseModel*>(mxTextDocument.get()), u".uno:Copy"_ustr);
+}
+
+void SAL_CALL SwVbaRange::Cut()
+{
+    KeepSelection aKeep(mxTextDocument);
+    Select();
+    dispatchRequests(static_cast<SfxBaseModel*>(mxTextDocument.get()), u".uno:Cut"_ustr);
+}
+
+void SwVbaRange::pasteHere(bool bPlain)
+{
+    Select();
+    dispatchRequests(static_cast<SfxBaseModel*>(mxTextDocument.get()), bPlain ? u".uno:PasteUnformatted"_ustr : u".uno:Paste"_ustr);
+    // Word leaves a range collapsed after what was pasted, and so the selection
+    uno::Reference<text::XTextViewCursor> xCursor = word::getXTextViewCursor(mxTextDocument);
+    mxTextCursor->gotoRange(xCursor->getEnd(), false);
+}
+
+void SAL_CALL SwVbaRange::Paste() { pasteHere(false); }
+
+void SAL_CALL SwVbaRange::PasteAndFormat(const uno::Any& rType)
+{
+    sal_Int32 nType = 0;
+    rType >>= nType;
+    pasteHere(nType == word::WdRecoveryType::wdFormatPlainText);
+}
+
+void SAL_CALL SwVbaRange::PasteSpecial(const uno::Any&, const uno::Any&, const uno::Any&, const uno::Any&, const uno::Any& rDataType,
+                                       const uno::Any&, const uno::Any&)
+{
+    sal_Int32 nType = 0;
+    rDataType >>= nType;
+    pasteHere(nType == word::WdPasteDataType::wdPasteText);
+}
