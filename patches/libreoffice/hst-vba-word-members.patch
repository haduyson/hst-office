+    TableCollectionHelper( const rtl::Reference< SwXTextDocument >& xDocument, const uno::Reference< text::XTextRange >& xScope )
+    {
+        uno::Reference< beans::XPropertySet > xProps( xScope, uno::UNO_QUERY_THROW );
+        uno::Reference< text::XTextTable > xAround;
