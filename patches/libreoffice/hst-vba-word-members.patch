+// HST: Word's Range moves by units: Move, Expand, EndOf, StartOf, Next, Previous, Delete
+
+#include <com/sun/star/text/XParagraphCursor.hpp>
+#include <com/sun/star/text/XSentenceCursor.hpp>
+#include <com/sun/star/text/XTextRangeCompare.hpp>
+#include <com/sun/star/text/XWordCursor.hpp>
+#include <ooo/vba/word/WdCollapseDirection.hpp>
+#include <ooo/vba/word/WdMovementType.hpp>
+#include <ooo/vba/word/WdUnits.hpp>
+
+#include <unotxdoc.hxx>
+
+#include "vbarange.hxx"
+
+using namespace ::ooo::vba;
+using namespace css;
+
+namespace
+{
+sal_Int32 lcl_length(const uno::Reference<text::XText>& xText, const uno::Reference<text::XTextRange>& xStart,
+                     const uno::Reference<text::XTextRange>& xEnd)
+{
+    uno::Reference<text::XTextCursor> xCursor = xText->createTextCursorByRange(xStart);
+    xCursor->gotoRange(xEnd, true);
+    return xCursor->getString().getLength();
+}
+
+/// Word counts the blanks after a word or sentence as part of it
+void lcl_takeBlanks(const uno::Reference<text::XTextCursor>& xEnd)
+{
+    uno::Reference<text::XTextCursor> xNext = xEnd->getText()->createTextCursorByRange(xEnd->getEnd());
+    while (xNext->goRight(1, true) && xNext->getString() == " ")
+    {
+        xEnd->gotoRange(xNext->getEnd(), false);
+        xNext->collapseToEnd();
+    }
+}
+
+bool lcl_step(const uno::Reference<text::XTextCursor>& xCursor, sal_Int32 nUnit, bool bForward)
+{
+    uno::Reference<text::XWordCursor> xWord(xCursor, uno::UNO_QUERY_THROW);
+    uno::Reference<text::XSentenceCursor> xSentence(xCursor, uno::UNO_QUERY_THROW);
+    uno::Reference<text::XParagraphCursor> xParagraph(xCursor, uno::UNO_QUERY_THROW);
+    switch (nUnit)
+    {
+        case word::WdUnits::wdWord:
+            return bForward ? xWord->gotoNextWord(false) : xWord->gotoPreviousWord(false);
+        case word::WdUnits::wdSentence:
+            return bForward ? xSentence->gotoNextSentence(false) : xSentence->gotoPreviousSentence(false);
+        case word::WdUnits::wdParagraph:
+            return bForward ? xParagraph->gotoNextParagraph(false) : xParagraph->gotoPreviousParagraph(false);
+        default:
+            return bForward ? xCursor->goRight(1, false) : xCursor->goLeft(1, false);
+    }
+}
+}
+
+void SwVbaRange::unitBounds(sal_Int32 nUnit, bool bWithBlanks, const uno::Reference<text::XTextRange>& xPlaceStart,
+                            const uno::Reference<text::XTextRange>& xPlaceEnd, uno::Reference<text::XTextCursor>& rStart,
+                            uno::Reference<text::XTextCursor>& rEnd)
+{
+    rStart = mxText->createTextCursorByRange(xPlaceStart);
+    rEnd = mxText->createTextCursorByRange(xPlaceEnd);
+    uno::Reference<text::XWordCursor> xWordStart(rStart, uno::UNO_QUERY_THROW), xWordEnd(rEnd, uno::UNO_QUERY_THROW);
+    uno::Reference<text::XSentenceCursor> xSentStart(rStart, uno::UNO_QUERY_THROW), xSentEnd(rEnd, uno::UNO_QUERY_THROW);
+    uno::Reference<text::XParagraphCursor> xParaStart(rStart, uno::UNO_QUERY_THROW), xParaEnd(rEnd, uno::UNO_QUERY_THROW);
+    switch (nUnit)
+    {
+        case word::WdUnits::wdCharacter:
+            if (rStart->getString().isEmpty() && lcl_length(mxText, xPlaceStart, xPlaceEnd) == 0)
+                rEnd->goRight(1, false);
+            break;
+        case word::WdUnits::wdWord:
+            if (!xWordStart->isStartOfWord())
+                xWordStart->gotoStartOfWord(false);
+            if (!xWordEnd->isEndOfWord())
+                xWordEnd->gotoEndOfWord(false);
+            if (bWithBlanks)
+                lcl_takeBlanks(rEnd);
+            break;
+        case word::WdUnits::wdSentence:
+            xSentStart->gotoStartOfSentence(false);
+            xSentEnd->gotoEndOfSentence(false);
+            if (bWithBlanks)
+                lcl_takeBlanks(rEnd);
+            break;
+        case word::WdUnits::wdLine: // no layout here: the paragraph is the nearest unit a Range has
+        case word::WdUnits::wdParagraph:
+            xParaStart->gotoStartOfParagraph(false);
+            xParaEnd->gotoEndOfParagraph(false);
+            if (bWithBlanks)
+                rEnd->goRight(1, false); // the paragraph mark
+            break;
+        case word::WdUnits::wdStory:
+            rStart->gotoStart(false);
+            rEnd->gotoEnd(false);
+            break;
+        default:
+            throw uno::RuntimeException(u"Not implemented for this unit"_ustr);
+    }
+}
+
+sal_Int32 SwVbaRange::setBounds(const uno::Reference<text::XTextRange>& xStart, const uno::Reference<text::XTextRange>& xEnd)
+{
+    const sal_Int32 nOld = mxTextCursor->getString().getLength();
+    mxTextCursor->gotoRange(xStart, false);
+    mxTextCursor->gotoRange(xEnd, true);
+    return mxTextCursor->getString().getLength() - nOld;
+}
+
+sal_Int32 SAL_CALL SwVbaRange::Move(const uno::Any& rUnit, const uno::Any& rCount)
+{
+    sal_Int32 nCount = 1;
+    rCount >>= nCount;
+    if (nCount == 0)
+        return 0;
+    const bool bForward = nCount > 0;
+    uno::Reference<text::XTextRange> xPlace = bForward ? mxTextCursor->getEnd() : mxTextCursor->getStart();
+    mxTextCursor->gotoRange(xPlace, false);
+    const sal_Int32 nMoved = moveBound(bForward, rUnit, rCount);
+    xPlace = bForward ? mxTextCursor->getEnd() : mxTextCursor->getStart();
+    mxTextCursor->gotoRange(xPlace, false);
+    return bForward ? nMoved : -nMoved;
+}
+
+sal_Int32 SAL_CALL SwVbaRange::Expand(const uno::Any& rUnit)
+{
+    sal_Int32 nUnit = word::WdUnits::wdWord;
+    rUnit >>= nUnit;
+    uno::Reference<text::XTextCursor> xStart, xEnd;
+    unitBounds(nUnit, true, mxTextCursor->getStart(), mxTextCursor->getEnd(), xStart, xEnd);
+    return setBounds(xStart->getStart(), xEnd->getEnd());
+}
+
+sal_Int32 SAL_CALL SwVbaRange::EndOf(const uno::Any& rUnit, const uno::Any& rExtend)
+{
+    sal_Int32 nUnit = word::WdUnits::wdWord, nExtend = word::WdMovementType::wdMove;
+    rUnit >>= nUnit;
+    rExtend >>= nExtend;
+    uno::Reference<text::XTextRange> xPlace = mxTextCursor->getEnd();
+    uno::Reference<text::XTextCursor> xStart, xEnd;
+    unitBounds(nUnit, true, xPlace, xPlace, xStart, xEnd);
+    const sal_Int32 nMoved = lcl_length(mxText, xPlace, xEnd->getEnd());
+    setBounds(nExtend == word::WdMovementType::wdExtend ? mxTextCursor->getStart() : xEnd->getEnd(), xEnd->getEnd());
+    return nMoved;
+}
+
+sal_Int32 SAL_CALL SwVbaRange::StartOf(const uno::Any& rUnit, const uno::Any& rExtend)
+{
+    sal_Int32 nUnit = word::WdUnits::wdWord, nExtend = word::WdMovementType::wdMove;
+    rUnit >>= nUnit;
+    rExtend >>= nExtend;
+    uno::Reference<text::XTextRange> xPlace = mxTextCursor->getStart();
+    uno::Reference<text::XTextCursor> xStart, xEnd;
+    unitBounds(nUnit, true, xPlace, xPlace, xStart, xEnd);
+    const sal_Int32 nMoved = lcl_length(mxText, xStart->getStart(), xPlace);
+    setBounds(xStart->getStart(), nExtend == word::WdMovementType::wdExtend ? mxTextCursor->getEnd() : xStart->getStart());
+    return -nMoved;
+}
+
+uno::Reference<word::XRange> SAL_CALL SwVbaRange::Next(const uno::Any& rUnit, const uno::Any& rCount)
+{
+    sal_Int32 nUnit = word::WdUnits::wdCharacter, nCount = 1;
+    rUnit >>= nUnit;
+    rCount >>= nCount;
+    uno::Reference<text::XTextCursor> xCursor = mxText->createTextCursorByRange(mxTextCursor->getEnd());
+    for (sal_Int32 i = 1; i < nCount; ++i)
+        if (!lcl_step(xCursor, nUnit, true))
+            return {};
+    uno::Reference<text::XTextCursor> xStart, xEnd;
+    unitBounds(nUnit, true, xCursor->getStart(), xCursor->getStart(), xStart, xEnd);
+    if (lcl_length(mxText, xStart->getStart(), xEnd->getEnd()) == 0)
+        return {}; // past the last unit, Nothing as in Word
+    return new SwVbaRange(mxParent, mxContext, mxTextDocument, xStart->getStart(), xEnd->getEnd(), mxText);
+}
+
+uno::Reference<word::XRange> SAL_CALL SwVbaRange::Previous(const uno::Any& rUnit, const uno::Any& rCount)
+{
+    sal_Int32 nUnit = word::WdUnits::wdCharacter, nCount = 1;
+    rUnit >>= nUnit;
+    rCount >>= nCount;
+    uno::Reference<text::XTextCursor> xCursor = mxText->createTextCursorByRange(mxTextCursor->getStart());
+    for (sal_Int32 i = 0; i < nCount; ++i)
+        if (!lcl_step(xCursor, nUnit, false))
+            return {};
+    uno::Reference<text::XTextCursor> xStart, xEnd;
+    unitBounds(nUnit, true, xCursor->getStart(), xCursor->getStart(), xStart, xEnd);
+    return new SwVbaRange(mxParent, mxContext, mxTextDocument, xStart->getStart(), xEnd->getEnd(), mxText);
+}
