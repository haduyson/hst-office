+uno::Any lcl_item(const uno::Reference<XCollection>& xCol, const uno::Any& rIndex)
+{
+    return rIndex.hasValue() ? xCol->Item(rIndex, uno::Any()) : uno::Any(xCol);
+}
+
+OUString lcl_cellName(const uno::Reference<text::XTextRange>& xPlace)
+{
+    uno::Reference<beans::XPropertySet> xProps(xPlace, uno::UNO_QUERY_THROW);
+    uno::Reference<table::XCell> xCell;
+    xProps->getPropertyValue(u"Cell"_ustr) >>= xCell;
+    OUString aName;
+    if (uno::Reference<beans::XPropertySet> xCellProps{ xCell, uno::UNO_QUERY })
+        xCellProps->getPropertyValue(u"CellName"_ustr) >>= aName;
+    return aName;
+}
+
+/// The table the range is in, with the first and last cell of the range; an error as in Word outside a table
+rtl::Reference<SwXTextTable> lcl_tableOf(const uno::Reference<text::XTextCursor>& xCursor, OUString& rFirst, OUString& rLast)
+{
+    uno::Reference<beans::XPropertySet> xProps(xCursor, uno::UNO_QUERY_THROW);
+    uno::Reference<text::XTextTable> xTable;
+    xProps->getPropertyValue(u"TextTable"_ustr) >>= xTable;
+    auto pTable = dynamic_cast<SwXTextTable*>(xTable.get());
+    if (!pTable)
+        throw lang::IndexOutOfBoundsException(u"The range is not in a table"_ustr);
+    rFirst = lcl_cellName(xCursor->getStart());
+    rLast = lcl_cellName(xCursor->getEnd());
+    if (rLast.isEmpty())
+        rLast = rFirst;
+    return pTable;
+}
