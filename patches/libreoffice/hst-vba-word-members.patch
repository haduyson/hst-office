+uno::Any SwVbaSelection::tableInformation(sal_Int32 nType)
+{
+    if (nType == word::WdInformation::wdFirstCharacterColumnNumber)
+    {
+        // characters from the start of the line, by moving a copy of the position
+        uno::Reference<view::XLineCursor> xLine(mxTextViewCursor, uno::UNO_QUERY_THROW);
+        uno::Reference<text::XTextRange> xStart = mxTextViewCursor->getStart(), xEnd = mxTextViewCursor->getEnd();
+        mxTextViewCursor->gotoRange(xStart, false);
+        xLine->gotoStartOfLine(true);
+        const sal_Int32 nColumn = mxTextViewCursor->getString().getLength() + 1;
+        mxTextViewCursor->gotoRange(xStart, false);
+        mxTextViewCursor->gotoRange(xEnd, true);
+        return uno::Any(nColumn);
+    }
+    rtl::Reference<SwXTextTable> xTable = GetXTextTable();
+    switch (nType)
+    {
+        case word::WdInformation::wdStartOfRangeRowNumber:
+        case word::WdInformation::wdEndOfRangeRowNumber:
+        case word::WdInformation::wdStartOfRangeColumnNumber:
+        case word::WdInformation::wdEndOfRangeColumnNumber:
+        case word::WdInformation::wdMaximumNumberOfRows:
+        case word::WdInformation::wdMaximumNumberOfColumns:
+            break;
+        default:
+            throw uno::RuntimeException(u"Not implemented"_ustr);
+    }
+    if (!xTable.is())
+        return uno::Any(sal_Int32(-1)); // as Word outside a table
+    if (nType == word::WdInformation::wdMaximumNumberOfRows)
+        return uno::Any(xTable->getRows()->getCount());
+    if (nType == word::WdInformation::wdMaximumNumberOfColumns)
+        return uno::Any(xTable->getColumns()->getCount());
+    OUString aFirst, aLast;
+    GetSelectedCellRange(aFirst, aLast);
+    if (aLast.isEmpty())
+        aLast = aFirst;
+    SwVbaTableHelper aHelper(xTable);
+    switch (nType)
+    {
+        case word::WdInformation::wdStartOfRangeRowNumber:
+            return uno::Any(aHelper.getTabRowIndex(aFirst) + 1);
+        case word::WdInformation::wdEndOfRangeRowNumber:
+            return uno::Any(aHelper.getTabRowIndex(aLast) + 1);
+        case word::WdInformation::wdStartOfRangeColumnNumber:
+            return uno::Any(aHelper.getTabColIndex(aFirst) + 1);
+        default:
+            return uno::Any(aHelper.getTabColIndex(aLast) + 1);
+    }
+}
