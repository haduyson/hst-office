+sal_Int32 SAL_CALL SwVbaRange::Delete(const uno::Any& rUnit, const uno::Any& rCount)
+{
+    if (mxTextCursor->isCollapsed())
+    {
+        sal_Int32 nCount = 1;
+        rCount >>= nCount;
+        if (nCount < 0)
+            moveBound(false, rUnit, rCount);
+        else
+            moveBound(true, rUnit, uno::Any(nCount));
+    }
+    const sal_Int32 nGone = mxTextCursor->getString().getLength();
+    mxTextCursor->setString(OUString());
+    return nGone;
+}
+
+uno::Any SAL_CALL SwVbaRange::Characters(const uno::Any& rIndex)
+{
+    uno::Reference<XCollection> xCol(new SwVbaTextUnits(this, mxContext, mxTextDocument, SwVbaTextUnits::Unit::Character, getXTextRange()));
+    return rIndex.hasValue() ? xCol->Item(rIndex, uno::Any()) : uno::Any(xCol);
+}
+
+sal_Int32 SAL_CALL SwVbaRange::ComputeStatistics(sal_Int32 nStatistic, const uno::Any&)
+{
+    const OUString aText = mxTextCursor->getString();
+    sal_Int32 nWords = 0, nParagraphs = 1, nBlanks = 0;
+    bool bInWord = false;
+    for (sal_Int32 i = 0; i < aText.getLength(); ++i)
+    {
+        const sal_Unicode c = aText[i];
+        const bool bBlank = c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == 0xA0;
+        nWords += !bInWord && !bBlank;
+        bInWord = !bBlank;
+        nBlanks += bBlank;
+        nParagraphs += c == '\n';
+    }
+    switch (nStatistic)
+    {
+        case word::WdStatistic::wdStatisticWords:
+            return nWords;
+        case word::WdStatistic::wdStatisticCharacters:
+            return aText.getLength() - nBlanks;
+        case word::WdStatistic::wdStatisticCharactersWithSpaces:
+            return aText.getLength();
+        case word::WdStatistic::wdStatisticParagraphs:
+        case word::WdStatistic::wdStatisticLines: // no layout for a range: its paragraphs
+            return nParagraphs;
+        default:
+            throw uno::RuntimeException(u"Not implemented for this statistic"_ustr);
+    }
+}
+
+uno::Any SAL_CALL SwVbaRange::getUnderline() { return uno::Reference<XFontBase>(getFont(), uno::UNO_QUERY_THROW)->getUnderline(); }
+void SAL_CALL SwVbaRange::setUnderline(const uno::Any& rValue) { uno::Reference<XFontBase>(getFont(), uno::UNO_QUERY_THROW)->setUnderline(rValue); }
+
+sal_Int32 SAL_CALL SwVbaRange::getStoryLength() { return mxText->getString().getLength() + 1; }
+
+sal_Int32 SAL_CALL SwVbaRange::getStoryType()
+{
+    uno::Reference<lang::XServiceInfo> xInfo(mxText, uno::UNO_QUERY);
+    if (xInfo.is() && xInfo->supportsService(u"com.sun.star.text.Endnote"_ustr))
+        return word::WdStoryType::wdEndnotesStory;
+    if (xInfo.is() && xInfo->supportsService(u"com.sun.star.text.Footnote"_ustr))
+        return word::WdStoryType::wdFootnotesStory;
+    if (xInfo.is() && xInfo->getImplementationName() == "SwXHeadFootText")
+        return word::WdStoryType::wdPrimaryHeaderStory;
+    if (xInfo.is() && xInfo->supportsService(u"com.sun.star.text.TextFrame"_ustr))
+        return word::WdStoryType::wdTextFrameStory;
+    return word::WdStoryType::wdMainTextStory;
+}
+
+uno::Any SAL_CALL SwVbaRange::getHighlightColorIndex()
+{
+    uno::Reference<beans::XPropertySet> xProps(mxTextCursor, uno::UNO_QUERY_THROW);
+    sal_Int32 nColor = -1;
+    xProps->getPropertyValue(u"CharHighlight"_ustr) >>= nColor;
+    if (nColor == -1)
+        return uno::Any(sal_Int32(0)); // wdNoHighlight
+    VbaPalette aPalette;
+    const uno::Reference<container::XIndexAccess>& xPalette = aPalette.getPalette();
+    for (sal_Int32 i = 0; i < xPalette->getCount(); ++i)
+    {
+        sal_Int32 nEntry = 0;
+        if ((xPalette->getByIndex(i) >>= nEntry) && nEntry == nColor)
+            return uno::Any(i);
+    }
+    return uno::Any(sal_Int32(9999999)); // wdUndefined
+}
+
+void SAL_CALL SwVbaRange::setHighlightColorIndex(const uno::Any& rValue)
+{
+    sal_Int32 nIndex = 0;
+    rValue >>= nIndex;
+    uno::Reference<beans::XPropertySet> xProps(mxTextCursor, uno::UNO_QUERY_THROW);
+    sal_Int32 nColor = -1;
+    if (nIndex > 0)
+    {
+        VbaPalette aPalette;
+        aPalette.getPalette()->getByIndex(nIndex) >>= nColor;
+    }
+    xProps->setPropertyValue(u"CharHighlight"_ustr, uno::Any(nColor));
+}
