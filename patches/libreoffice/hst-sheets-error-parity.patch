+/// HST: the Analysis add-in reports #N/A (CONVERT with an unknown unit) as a RuntimeException
+/// with the message "#N/A"; the add-in interface has no other way to return an error value.
+bool lcl_IsNotAvailable( const uno::Any& rException )
+{
+    uno::RuntimeException aRuntime;
+    return ( rException >>= aRuntime ) && aRuntime.Message == "#N/A";
+}
+
+}
