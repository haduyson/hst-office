+/** HST Office: "Apply to All" changes the other applications' mode by configuration only, but the
+    visibility of their toolbars is stored per application (WindowState): a switch to a ribbon mode
+    stored them as invisible, so new windows and document tabs of those applications got neither a
+    ribbon nor toolbars. Store the toolbars of the new mode as visible and the toolbars that only
+    other modes use as invisible, as .uno:ToolbarMode does for the current application. */
+void lcl_storeModeToolbars(const OUString& rApp, const OUString& rModuleId, const OUString& rMode)
+{
+    try
+    {
+        const auto& xContext = comphelper::getProcessComponentContext();
+        const utl::OConfigurationTreeRoot aModesNode(
+            xContext, "org.openoffice.Office.UI.ToolbarMode/Applications/" + rApp + "/Modes", false);
+        if (!aModesNode.isValid())
+            return;
+        std::vector<OUString> aShow, aHide;
+        for (const OUString& rName : aModesNode.getNodeNames())
+        {
+            const utl::OConfigurationNode aModeNode(aModesNode.openNode(rName));
+            const bool bNew
+                = comphelper::getString(aModeNode.getNodeValue(u"CommandArg"_ustr)) == rMode;
+            for (const char* pList : { "Toolbars", "UserToolbars" })
+                for (const OUString& rToolbar :
+                     aModeNode.getNodeValue(OUString::createFromAscii(pList)).get<css::uno::Sequence<OUString>>())
+                    (bNew ? aShow : aHide).push_back(rToolbar);
+        }
+        css::uno::Reference<css::container::XNameContainer> xStates;
+        css::ui::theWindowStateConfiguration::get(xContext)->getByName(rModuleId) >>= xStates;
+        if (!xStates.is())
+            return;
+        auto lcl_store = [&xStates](const OUString& rToolbar, bool bVisible) {
+            css::uno::Sequence<css::beans::PropertyValue> aProps;
+            if (xStates->hasByName(rToolbar))
+                xStates->getByName(rToolbar) >>= aProps;
+            std::vector<css::beans::PropertyValue> aNew;
+            for (const auto& rProp : aProps)
+                if (rProp.Name != "Visible")
+                    aNew.push_back(rProp);
+            aNew.push_back(comphelper::makePropertyValue(u"Visible"_ustr, bVisible));
+            const css::uno::Any aValue(comphelper::containerToSequence(aNew));
+            if (xStates->hasByName(rToolbar))
+                xStates->replaceByName(rToolbar, aValue);
+            else
+                xStates->insertByName(rToolbar, aValue);
+        };
+        for (const OUString& rToolbar : aHide)
+            if (std::find(aShow.begin(), aShow.end(), rToolbar) == aShow.end())
+                lcl_store(rToolbar, false);
+        for (const OUString& rToolbar : aShow)
+            lcl_store(rToolbar, true);
+    }
+    catch (const css::uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("cui.dialogs", "UIPickerDialog: store the toolbars of " << rApp);
+    }
+}
+}
