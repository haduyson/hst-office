+/// HST Office: the toolbar lists ("Toolbars", "UserToolbars") of the active mode of xFrame's module.
+static std::vector<OUString> lcl_getModeToolbars(const Reference<css::frame::XFrame>& xFrame)
+{
+    std::vector<OUString> aResult;
+    const Reference<css::uno::XComponentContext>& xContext = comphelper::getProcessComponentContext();
+    const OUString aApp = lcl_getAppName(vcl::EnumContext::GetApplicationEnum(
+        frame::ModuleManager::create(xContext)->identify(xFrame)));
+    if (aApp.isEmpty())
+        return aResult;
+    const utl::OConfigurationTreeRoot aAppNode(
+        xContext, "org.openoffice.Office.UI.ToolbarMode/Applications/" + aApp, false);
+    if (!aAppNode.isValid())
+        return aResult;
+    const OUString aActive = comphelper::getString(aAppNode.getNodeValue(u"Active"_ustr));
+    const utl::OConfigurationNode aModesNode = aAppNode.openNode(u"Modes"_ustr);
+    for (const OUString& rName : aModesNode.getNodeNames())
+    {
+        const utl::OConfigurationNode aModeNode(aModesNode.openNode(rName));
+        if (!aModeNode.isValid()
+            || comphelper::getString(aModeNode.getNodeValue(u"CommandArg"_ustr)) != aActive)
+            continue;
+        for (const char* pList : { "Toolbars", "UserToolbars" })
+            for (const OUString& rToolbar :
+                 aModeNode.getNodeValue(OUString::createFromAscii(pList)).get<Sequence<OUString>>())
+                aResult.push_back(rToolbar);
+        break;
+    }
+    return aResult;
+}
+
+/** HST Office: create and show the toolbars of the active mode of xFrame's module, as
+    .uno:ToolbarMode does for the module it runs in. A switch to a ribbon mode stores the toolbars
+    as invisible; when the module comes back to a toolbar mode by configuration only ("Apply to All"
+    from another module), nothing else would show them again on its open windows and tabs. */
+static void lcl_showModeToolbars(const Reference<css::frame::XFrame>& xFrame)
+{
+    const Reference<frame::XLayoutManager> xLayoutManager = lcl_getLayoutManager(xFrame);
+    if (!xLayoutManager.is())
+        return;
+    try
+    {
+        const std::vector<OUString> aToolbars = lcl_getModeToolbars(xFrame);
+        for (const OUString& rToolbar : aToolbars)
+        {
+            xLayoutManager->createElement(rToolbar);
+            xLayoutManager->showElement(rToolbar);
+        }
+    }
+    catch (const css::uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("sfx.appl", "SfxNotebookBar: show the toolbars of the mode");
+    }
+}
