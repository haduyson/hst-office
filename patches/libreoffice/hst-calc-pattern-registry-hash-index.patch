+void CellAttributeHelper::addToHashIndex(const ScPatternAttr* pPattern) const
+{
+    pPattern->mnIndexedHashCode = pPattern->GetHashCode();
+    maRegisteredByHash.emplace(pPattern->mnIndexedHashCode, pPattern);
+}
+
+void CellAttributeHelper::removeFromHashIndex(const ScPatternAttr* pPattern) const
+{
+    const auto aRange = maRegisteredByHash.equal_range(pPattern->mnIndexedHashCode);
+    for (auto it = aRange.first; it != aRange.second; ++it)
+    {
+        if (it->second == pPattern)
+        {
+            maRegisteredByHash.erase(it);
+            return;
+        }
+    }
+    assert(false && "registered CellAttribute missing from the hash index (!)");
+}
+
+void CellAttributeHelper::rebuildHashIndex() const
+{
+    maRegisteredByHash.clear();
+    for (const auto & rPair : maRegisteredCellAttributes)
+        for (const ScPatternAttr* p : rPair.second)
+            addToHashIndex(p);
+}
