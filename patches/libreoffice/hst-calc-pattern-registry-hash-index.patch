+CPPUNIT_TEST_FIXTURE(Test, testCellAttributeRegistryManyFormats)
+{
+    // Thousands of distinct cell formats of one cell style: every distinct content is registered
+    // once and found again (through the hash index), also after the style was renamed.
+    m_pDoc->InsertTab(0, u"Test"_ustr);
+    CellAttributeHelper& rHelper = m_pDoc->getCellAttributeHelper();
+    ScStyleSheetPool* pStylePool = m_pDoc->GetStyleSheetPool();
+    ScStyleSheet& rStyle = static_cast<ScStyleSheet&>(
+        pStylePool->Make(u"HashIndexStyle"_ustr, SfxStyleFamily::Para, SfxStyleSearchBits::UserDefined));
+
+    constexpr sal_uInt32 nFormats = 4000;
+    auto makePattern = [&](sal_uInt32 i) {
+        ScPatternAttr aPattern(rHelper);
+        aPattern.SetStyleSheet(&rStyle);
+        aPattern.ItemSetPut(SvxBrushItem(Color(ColorTransparency, 0x10000 + i), ATTR_BACKGROUND));
+        return aPattern;
+    };
+    std::vector<CellAttributeHolder> aRegistered;
+    for (sal_uInt32 i = 0; i < nFormats; ++i)
+    {
+        ScPatternAttr aPattern(makePattern(i));
+        aRegistered.emplace_back(&aPattern);
+        CPPUNIT_ASSERT(aRegistered.back().getScPatternAttr() != &aPattern);
+    }
+    // all distinct
+    for (sal_uInt32 i = 1; i < nFormats; ++i)
+        CPPUNIT_ASSERT(aRegistered[i].getScPatternAttr() != aRegistered[i - 1].getScPatternAttr());
+    // equal contents give the registered entries, in reverse order to avoid the last-hit cache
+    for (sal_uInt32 i = nFormats; i-- > 0;)
+    {
+        ScPatternAttr aPattern(makePattern(i));
+        CellAttributeHolder aAgain(&aPattern);
+        CPPUNIT_ASSERT_EQUAL(aRegistered[i].getScPatternAttr(), aAgain.getScPatternAttr());
+    }
+
+    // Renaming the style changes the hash code of the entries that use it.
+    pStylePool->Rename(rStyle, u"HashIndexStyleRenamed"_ustr, SfxStyleFamily::Para);
+    for (sal_uInt32 i = 0; i < nFormats; i += 97)
+    {
+        ScPatternAttr aPattern(makePattern(i));
+        CellAttributeHolder aAgain(&aPattern);
+        CPPUNIT_ASSERT_EQUAL(aRegistered[i].getScPatternAttr(), aAgain.getScPatternAttr());
+    }
+
+    // Dropping the entries unregisters them (and takes them out of the index); registering again
+    // gives one shared entry.
+    aRegistered.clear();
+    ScPatternAttr aPattern(makePattern(0));
+    CellAttributeHolder aNew(&aPattern);
+    CellAttributeHolder aNewAgain(&aPattern);
+    CPPUNIT_ASSERT(aNew.getScPatternAttr() != &aPattern);
+    CPPUNIT_ASSERT(ScPatternAttr::areSame(aNew.getScPatternAttr(), &aPattern));
+    CPPUNIT_ASSERT_EQUAL(aNew.getScPatternAttr(), aNewAgain.getScPatternAttr());
+
+    m_pDoc->DeleteTab(0);
+}
+
 CPPUNIT_PLUGIN_IMPLEMENT();
 
