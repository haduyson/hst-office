 {
     // todo: negative spacing (from ww8par6.cxx)
+    // No <w:paperSrc> (both trays 0, Word's default tray): keep the page style's tray "from printer
+    // settings". Setting PrinterPaperTray creates the document printer, i.e. it opens the system
+    // default printer while the document loads; on Windows an unreachable network default printer
+    // then stops the import with the spooler's "Waiting for printer connection..." dialog.
+    if (m_nPaperSourceFirst == 0 && m_nPaperSourceOther == 0)
+        return;
     if (!m_sPageStyleName.isEmpty())
     {
         rtl::Reference<SwXPageStyle> xFirst = GetPageStyle(rDM_Impl);
