+using namespace css;
+
+namespace writerfilter::hst
+{
+bool WantsMathType5Data(std::u16string_view rProgId)
+{
+    return rProgId == u"Equation.DSMT4"
+           && officecfg::Office::Common::Filter::Microsoft::Import::MathType5ToMath::get();
+}
+
+uno::Reference<embed::XEmbeddedObject>
+ConvertMathType5Ole(std::u16string_view rProgId, const std::vector<sal_Int8>& rData,
+                    const OUString& rBaseURL, sal_Int32 nShownHeight)
+{
+    if (rData.empty() || !WantsMathType5Data(rProgId))
+        return {};
+    uno::Reference<embed::XEmbeddedObject> xObj;
+    try
+    {
+        // The container must not own its storage: an owning container disposes the storage when it goes
+        // out of scope, and the object, which stays in that storage until Writer moves it into the
+        // document, would then crash the document's EmbeddedObjectContainer::InsertEmbeddedObject.
+        comphelper::EmbeddedObjectContainer aContainer(
+            comphelper::OStorageHelper::GetTemporaryStorage());
+        OUString aName;
+        xObj = aContainer.CreateEmbeddedObject(
+            comphelper::MimeConfigurationHelper::GetSequenceClassID(SO3_SM_CLASSID), aName,
+            rBaseURL);
+        if (!xObj.is())
+            return {};
+        uno::Reference<uno::XComponentContext> xContext = comphelper::getProcessComponentContext();
+        uno::Reference<document::XImporter> xImporter(
+            xContext->getServiceManager()->createInstanceWithContext(
+                u"com.sun.star.comp.Math.MathTypeFilter"_ustr, xContext),
+            uno::UNO_QUERY_THROW);
+        xImporter->setTargetDocument(
+            uno::Reference<lang::XComponent>(xObj->getComponent(), uno::UNO_QUERY_THROW));
+        uno::Reference<io::XInputStream> xStream(new comphelper::SequenceInputStream(
+            uno::Sequence<sal_Int8>(rData.data(), rData.size())));
+        uno::Reference<document::XFilter> xFilter(xImporter, uno::UNO_QUERY_THROW);
+        if (xFilter->filter({ comphelper::makePropertyValue(u"InputStream"_ustr, xStream) }))
+        {
+            sw::hst::KeepFormulaShownHeight(xObj, nShownHeight);
+            return xObj;
+        }
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("writerfilter", "MathType 5 equation not converted");
+    }
+    if (xObj.is())
+    {
+        try
+        {
+            xObj->close(true);
+        }
+        catch (const uno::Exception&)
+        {
+        }
+    }
+    return {};
+}
+}
