diff --git a/sw/source/core/hst/formulashownsize.cxx b/sw/source/core/hst/formulashownsize.cxx
new file mode 100644
index 0000000..db6e85c
--- /dev/null
+++ b/sw/source/core/hst/formulashownsize.cxx
@@ -0,0 +1,110 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * Part of HST Office. This file is HST's own work and is not covered by the MPL.
+ */
+
+#include <hstformulashownsize.hxx>
+
+#include <com/sun/star/beans/XPropertySet.hpp>
+#include <com/sun/star/embed/EmbedStates.hpp>
+#include <com/sun/star/embed/XEmbeddedObject.hpp>
+#include <comphelper/diagnose_ex.hxx>
+#include <rtl/character.hxx>
+#include <rtl/math.hxx>
+#include <rtl/ustrbuf.hxx>
+#include <sot/exchange.hxx>
+#include <tools/globname.hxx>
+#include <vcl/graph.hxx>
+#include <vcl/outdev.hxx>
+
+#include <algorithm>
+#include <cmath>
+
+using namespace css;
+
+namespace sw::hst
+{
+namespace
+{
+constexpr double TOLERANCE = 0.05; // Word's own rounding of a size at 100 %
+
+OUString NumberText(double fValue)
+{
+    return rtl::math::doubleToUString(fValue, rtl_math_StringFormat_Automatic,
+                                      rtl_math_DecimalPlaces_Max, '.', true);
+}
+}
+
+double WordScale(tools::Long nShownHeight, MapUnit eUnit, const Graphic& rPreview)
+{
+    const MapMode aPreviewMap = rPreview.GetPrefMapMode();
+    if (nShownHeight <= 0 || rPreview.GetType() == GraphicType::NONE
+        || aPreviewMap.GetMapUnit() == MapUnit::MapPixel)
+        return 0;
+    const tools::Long nPreview
+        = OutputDevice::LogicToLogic(rPreview.GetPrefSize(), aPreviewMap, MapMode(eUnit)).Height();
+    return nPreview > 0 ? double(nShownHeight) / nPreview : 0;
+}
+
+void KeepWordScale(const uno::Reference<embed::XEmbeddedObject>& xFormula, double fScale)
+{
+    if (!xFormula.is() || fScale <= 0 || std::abs(fScale - 1.0) <= TOLERANCE)
+        return;
+    try
+    {
+        if (!SotExchange::IsMath(SvGlobalName(xFormula->getClassID())))
+            return;
+        if (xFormula->getCurrentState() == embed::EmbedStates::LOADED)
+            xFormula->changeState(embed::EmbedStates::RUNNING);
+        uno::Reference<beans::XPropertySet> xProps(xFormula->getComponent(), uno::UNO_QUERY_THROW);
+        OUString aText;
+        xProps->getPropertyValue(u"Formula"_ustr) >>= aText;
+        xProps->setPropertyValue(u"Formula"_ustr, uno::Any(ScaleFormulaSizes(aText, fScale)));
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("sw", "HST: formula keeps MathType's size");
+    }
+}
+
+OUString ScaleFormulaSizes(std::u16string_view aFormula, double fRatio)
+{
+    OUStringBuffer aBuf("size *" + NumberText(std::round(fRatio * 1000) / 1000) + " {");
+    bool bQuoted = false;
+    for (size_t i = 0; i < aFormula.size();)
+    {
+        const sal_Unicode c = aFormula[i];
+        if (c == '"')
+            bQuoted = !bQuoted;
+        else if (!bQuoted && aFormula.substr(i).starts_with(u"size")
+                 && (i == 0 || !rtl::isAsciiAlphanumeric(aFormula[i - 1])))
+        {
+            size_t nNumber = i + 4;
+            while (nNumber < aFormula.size()
+                   && (aFormula[nNumber] == ' ' || aFormula[nNumber] == '\t'))
+                ++nNumber;
+            size_t nEnd = nNumber;
+            while (nEnd < aFormula.size()
+                   && (rtl::isAsciiDigit(aFormula[nEnd]) || aFormula[nEnd] == '.'))
+                ++nEnd;
+            if (nNumber > i + 4 && nEnd > nNumber)
+            {
+                const double fSize = rtl::math::stringToDouble(
+                    OUString(aFormula.substr(nNumber, nEnd - nNumber)), '.', 0);
+                aBuf.append("size "
+                            + NumberText(std::max(1.0, std::round(fSize * fRatio * 10) / 10)));
+                i = nEnd;
+                continue;
+            }
+        }
+        aBuf.append(c);
+        ++i;
+    }
+    aBuf.append("}");
+    return aBuf.makeStringAndClear();
+}
+}
+
