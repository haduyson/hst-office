+
+#pragma once
+
+#include <com/sun/star/embed/XEmbeddedObject.hpp>
+#include <com/sun/star/graphic/XGraphic.hpp>
+#include <com/sun/star/uno/Reference.hxx>
+#include <rtl/ustring.hxx>
+#include <sal/types.h>
+
+#include <string_view>
+#include <vector>
+
+// MathType 4-7 equations ("Equation.DSMT4") in DOCX and RTF: converted to Math objects on open
+// when the user turned that on; otherwise, or if conversion fails, they stay OLE objects.
+namespace writerfilter::hst
+{
+/// True if the OLE data of an object with this ProgId should be kept for conversion
+bool WantsMathType5Data(std::u16string_view rProgId);
+
+/// True if an RTF object with this ProgId keeps its OLE data in a table cell too: MathType and
+/// Equation Editor equations. LibreOffice reads only the picture of objects in tables
+/// (fdo#53594); an equation saved again would lose its data.
+bool KeepsOleInTable(std::u16string_view rProgId);
+
+/// A new Math object made from the OLE compound file data, or empty (keep the OLE object).
+/// nShownHeight (mm100, 0 if unknown) and xPreview give the scale Word shows the equation at.
+css::uno::Reference<css::embed::XEmbeddedObject>
+ConvertMathType5Ole(std::u16string_view rProgId, const std::vector<sal_Int8>& rData,
+                    const OUString& rBaseURL, sal_Int32 nShownHeight,
+                    const css::uno::Reference<css::graphic::XGraphic>& xPreview);
+}
