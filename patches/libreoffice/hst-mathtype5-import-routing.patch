+    if (RTFValue::Pointer_t pShape = pObject->getAttributes().find(NS_ooxml::LN_shape))
+        pShape->getAny() >>= xShape;
+    if (xShape.is())
+    {
+        Mapper().startShape(xShape);
+        Mapper().props(pProperties);
+        Mapper().endShape();
+    }
+}
+
+bool RTFDocumentImpl::HstKeepsOleInTable()
+{
+    RTFValue::Pointer_t pProgId = m_aOLEAttributes.find(NS_ooxml::LN_CT_OLEObject_ProgID);
+    return pProgId && writerfilter::hst::KeepsOleInTable(pProgId->getString());
+}
