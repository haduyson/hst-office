+namespace com::sun::star::embed
+{
+class XEmbeddedObject;
+}
+
+// A MathType equation converted to a formula when a .docx, .rtf or .doc file is opened keeps the
+// scale Word shows it at. An equation resized in Word keeps MathType's point sizes in its data;
+// the resize lives only in its shown size (.docx shape style, .rtf \objh/\pichgoal, .doc PICF),
+// while its preview picture keeps MathType's size at 100 %. The shown height is not compared with
+// the formula's height: MathType's box is taller than Math's for the same point size.
+namespace sw::hst
+{
+/// Word's scale of an equation: its shown height (in eUnit) over the height of its preview
+/// picture. 0 if unknown.
+SW_DLLPUBLIC double WordScale(tools::Long nShownHeight, MapUnit eUnit, const Graphic& rPreview);
+
+/// Draws a formula converted from an equation Word shows at fScale (0 if unknown) at that scale,
+/// unless it is within 5 % of 100 %. Only Math objects are touched; never throws.
+SW_DLLPUBLIC void KeepWordScale(const css::uno::Reference<css::embed::XEmbeddedObject>& xFormula,
+                                double fScale);
+
+/// The formula text drawn fRatio times as large: each absolute "size N" outside quoted text is
+/// multiplied, and the text is wrapped in "size *fRatio" for the parts without a size.
+SW_DLLPUBLIC OUString ScaleFormulaSizes(std::u16string_view aFormula, double fRatio);
+}
