index 0000000..2d1a573
--- /dev/null
+++ b/sw/inc/hstformulashownsize.hxx
@@ -0,0 +1,39 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * Part of HST Office. This file is HST's own work and is not covered by the MPL.
+ */
+
+#pragma once
+
+#include <com/sun/star/uno/Reference.hxx>
+#include <rtl/ustring.hxx>
+#include <sal/types.h>
+
+#include "swdllapi.h"
+
+#include <string_view>
+
+namespace com::sun::star::embed
+{
+class XEmbeddedObject;
+}
+
+// A MathType equation converted to a formula when a .docx, .rtf or .doc file is opened keeps the
+// size Word shows it at. An equation resized in Word keeps MathType's point sizes in its data;
+// the resize lives only in the object's shown size (.docx shape style, .rtf \picscalex, .doc PICF
+// scale), and the MathType import writes those point sizes into the formula ("size 12{em}").
+namespace sw::hst
+{
+/// Scales the formula of the Math object xFormula to nShownHeight (mm100, 0 if unknown) when its
+/// own height is more than 10 % off. Never throws: the formula stays as it is.
+SW_DLLPUBLIC void KeepFormulaShownHeight(
+    const css::uno::Reference<css::embed::XEmbeddedObject>& xFormula, sal_Int32 nShownHeight);
+
+/// The formula text drawn fRatio times as large: each absolute "size N" outside quoted text is
+/// multiplied, and the text is wrapped in "size *fRatio" for the parts without a size.
+SW_DLLPUBLIC OUString ScaleFormulaSizes(std::u16string_view aFormula, double fRatio);
+}
+
+/* vim:set shiftwidth=4 softtabstop=4 expandtab: */
diff --git a/sw/source/core/hst/formulashownsize.cxx b/sw/source/core/hst/formulashownsize.cxx
new file mode 100644
index 0000000..856218f
--- /dev/null
+++ b/sw/source/core/hst/formulashownsize.cxx
@@ -0,0 +1,119 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * Part of HST Office. This file is HST's own work and is not covered by the MPL.
+ */
+
+#include <hstformulashownsize.hxx>
+
+#include <com/sun/star/beans/XPropertySet.hpp>
+#include <com/sun/star/embed/Aspects.hpp>
+#include <com/sun/star/embed/EmbedMapUnits.hpp>
+#include <com/sun/star/embed/EmbedStates.hpp>
+#include <com/sun/star/embed/XEmbeddedObject.hpp>
+#include <comphelper/diagnose_ex.hxx>
+#include <o3tl/unit_conversion.hxx>
+#include <rtl/character.hxx>
+#include <rtl/math.hxx>
+#include <rtl/ustrbuf.hxx>
+
+#include <algorithm>
+#include <cmath>
+
+using namespace css;
+
+namespace sw::hst
+{
+namespace
+{
+constexpr double TOLERANCE = 0.1; // within 10 % of the shown height: MathType's own size
+
+OUString NumberText(double fValue)
+{
+    return rtl::math::doubleToUString(fValue, rtl_math_StringFormat_Automatic,
+                                      rtl_math_DecimalPlaces_Max, '.', true);
+}
+
+/// The height of the formula at the sizes MathType gave it, in mm100 (0 if unknown)
+double NaturalHeight(const uno::Reference<embed::XEmbeddedObject>& xObj)
+{
+    const sal_Int64 nAspect = embed::Aspects::MSOLE_CONTENT;
+    const double fHeight = xObj->getVisualAreaSize(nAspect).Height;
+    switch (xObj->getMapUnit(nAspect))
+    {
+        case embed::EmbedMapUnits::TWIP:
+            return o3tl::convert(fHeight, o3tl::Length::twip, o3tl::Length::mm100);
+        case embed::EmbedMapUnits::ONE_100TH_MM:
+            return fHeight;
+        default:
+            return 0;
+    }
+}
+}
+
+void KeepFormulaShownHeight(const uno::Reference<embed::XEmbeddedObject>& xFormula,
+                            sal_Int32 nShownHeight)
+{
+    if (!xFormula.is() || nShownHeight <= 0)
+        return;
+    try
+    {
+        if (xFormula->getCurrentState() == embed::EmbedStates::LOADED)
+            xFormula->changeState(embed::EmbedStates::RUNNING);
+        const double fNatural = NaturalHeight(xFormula);
+        if (fNatural <= 0)
+            return;
+        const double fRatio = nShownHeight / fNatural;
+        if (std::abs(fRatio - 1.0) <= TOLERANCE)
+            return;
+        uno::Reference<beans::XPropertySet> xProps(xFormula->getComponent(), uno::UNO_QUERY_THROW);
+        OUString aText;
+        xProps->getPropertyValue(u"Formula"_ustr) >>= aText;
+        xProps->setPropertyValue(u"Formula"_ustr, uno::Any(ScaleFormulaSizes(aText, fRatio)));
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("sw", "HST: formula keeps MathType's size");
+    }
+}
+
+OUString ScaleFormulaSizes(std::u16string_view aFormula, double fRatio)
+{
+    OUStringBuffer aBuf("size *" + NumberText(std::round(fRatio * 1000) / 1000) + " {");
+    bool bQuoted = false;
+    for (size_t i = 0; i < aFormula.size();)
+    {
+        const sal_Unicode c = aFormula[i];
+        if (c == '"')
+            bQuoted = !bQuoted;
+        else if (!bQuoted && aFormula.substr(i).starts_with(u"size")
+                 && (i == 0 || !rtl::isAsciiAlphanumeric(aFormula[i - 1])))
+        {
+            size_t nNumber = i + 4;
+            while (nNumber < aFormula.size()
+                   && (aFormula[nNumber] == ' ' || aFormula[nNumber] == '\t'))
+                ++nNumber;
+            size_t nEnd = nNumber;
+            while (nEnd < aFormula.size()
+                   && (rtl::isAsciiDigit(aFormula[nEnd]) || aFormula[nEnd] == '.'))
+                ++nEnd;
+            if (nNumber > i + 4 && nEnd > nNumber)
+            {
+                const double fSize = rtl::math::stringToDouble(
+                    OUString(aFormula.substr(nNumber, nEnd - nNumber)), '.', 0);
+                aBuf.append("size "
+                            + NumberText(std::max(1.0, std::round(fSize * fRatio * 10) / 10)));
+                i = nEnd;
+                continue;
+            }
+        }
+        aBuf.append(c);
+        ++i;
+    }
+    aBuf.append("}");
+    return aBuf.makeStringAndClear();
+}
+}
+
