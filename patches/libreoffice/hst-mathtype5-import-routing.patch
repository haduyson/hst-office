diff --git a/sw/source/core/hst/mathtypeoledata.cxx b/sw/source/core/hst/mathtypeoledata.cxx
new file mode 100644
index 0000000..50cde04
--- /dev/null
+++ b/sw/source/core/hst/mathtypeoledata.cxx
@@ -0,0 +1,120 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * Part of HST Office. This file is HST's own work and is not covered by the MPL.
+ */
+
+#include <hstmathtypeole.hxx>
+
+#include <com/sun/star/embed/ElementModes.hpp>
+#include <com/sun/star/embed/XEmbeddedObject.hpp>
+#include <com/sun/star/embed/XEmbedPersist.hpp>
+#include <com/sun/star/embed/XStorage.hpp>
+#include <com/sun/star/io/XInputStream.hpp>
+#include <com/sun/star/io/XStream.hpp>
+#include <comphelper/diagnose_ex.hxx>
+#include <comphelper/storagehelper.hxx>
+#include <rtl/ref.hxx>
+#include <sot/storage.hxx>
+#include <tools/stream.hxx>
+
+#include <string_view>
+
+using namespace css;
+
+namespace sw::hst
+{
+namespace
+{
+constexpr std::string_view EQUATION_PREFIX = "Equation."; // Equation.DSMT4..6, Equation.3
+constexpr sal_uInt32 OLE_VERSION = 0x0501;
+constexpr sal_uInt32 EMBEDDED = 2; // ObjectHeader.FormatID of an embedded object (MS-OLEDS 2.2.4)
+constexpr sal_uInt32 NO_PRESENTATION = 0; // the picture is RTF's \result
+
+void Append32(std::vector<sal_uInt8>& rOut, sal_uInt32 n)
+{
+    for (int i = 0; i < 4; ++i)
+        rOut.push_back(static_cast<sal_uInt8>(n >> (8 * i)));
+}
+
+/// The compound file the object stores, byte for byte
+std::vector<sal_uInt8> StoredData(const uno::Reference<embed::XEmbeddedObject>& xObj)
+{
+    uno::Reference<embed::XEmbedPersist> xPersist(xObj, uno::UNO_QUERY);
+    if (!xPersist.is())
+        return {};
+    uno::Reference<embed::XStorage> xStorage = comphelper::OStorageHelper::GetTemporaryStorage();
+    const OUString aName(u"ole"_ustr);
+    xPersist->storeToEntry(xStorage, aName, {}, {});
+    uno::Reference<io::XInputStream> xIn
+        = xStorage->openStreamElement(aName, embed::ElementModes::READ)->getInputStream();
+    std::vector<sal_uInt8> aData;
+    uno::Sequence<sal_Int8> aChunk;
+    while (xIn->readBytes(aChunk, 65536) > 0)
+        aData.insert(aData.end(), aChunk.begin(), aChunk.end());
+    return aData;
+}
+
+/// The ProgID a compound file's \1CompObj names, if it is a MathType or Equation Editor one
+OString MathTypeProgId(const std::vector<sal_uInt8>& rCompObj)
+{
+    // \1CompObj: header, then length-prefixed AnsiUserType, clipboard format, ProgID
+    const std::string_view aText(reinterpret_cast<const char*>(rCompObj.data()), rCompObj.size());
+    for (size_t nPos = aText.find(EQUATION_PREFIX); nPos != std::string_view::npos;
+         nPos = aText.find(EQUATION_PREFIX, nPos + 1))
+    {
+        const size_t nEnd = aText.find('\0', nPos);
+        if (nEnd != std::string_view::npos && nPos >= 4
+            && static_cast<size_t>(static_cast<sal_uInt8>(aText[nPos - 4])) == nEnd - nPos + 1)
+            return OString(aText.substr(nPos, nEnd - nPos));
+    }
+    return {};
+}
+}
+
+std::vector<sal_uInt8> MathTypeOle1Data(const uno::Reference<embed::XEmbeddedObject>& xObj,
+                                        OString& rProgId)
+{
+    try
+    {
+        std::vector<sal_uInt8> aNative = StoredData(xObj);
+        if (aNative.empty())
+            return {};
+        SvMemoryStream aStream(aNative.data(), aNative.size(), StreamMode::READ);
+        rtl::Reference<SotStorage> xStorage = new SotStorage(aStream);
+        if (xStorage->GetError() || !xStorage->IsStream(u"Equation Native"_ustr))
+            return {};
+        rtl::Reference<SotStorageStream> xCompObj = xStorage->OpenSotStream(
+            u"\001CompObj"_ustr, StreamMode::READ | StreamMode::NOCREATE);
+        if (!xCompObj.is() || xCompObj->GetError())
+            return {};
+        std::vector<sal_uInt8> aCompObj(xCompObj->TellEnd());
+        xCompObj->Seek(0);
+        xCompObj->ReadBytes(aCompObj.data(), aCompObj.size());
+        rProgId = MathTypeProgId(aCompObj);
+        if (rProgId.isEmpty())
+            return {};
+
+        std::vector<sal_uInt8> aOut;
+        Append32(aOut, OLE_VERSION);
+        Append32(aOut, EMBEDDED);
+        Append32(aOut, static_cast<sal_uInt32>(rProgId.getLength() + 1)); // ClassName, its null
+        aOut.insert(aOut.end(), rProgId.getStr(), rProgId.getStr() + rProgId.getLength() + 1);
+        Append32(aOut, 0); // TopicName
+        Append32(aOut, 0); // ItemName
+        Append32(aOut, static_cast<sal_uInt32>(aNative.size()));
+        aOut.insert(aOut.end(), aNative.begin(), aNative.end());
+        Append32(aOut, OLE_VERSION);
+        Append32(aOut, NO_PRESENTATION);
+        return aOut;
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("sw", "HST: MathType object written as a picture only");
+        return {};
+    }
+}
+}
+
+/* vim:set shiftwidth=4 softtabstop=4 expandtab: */
