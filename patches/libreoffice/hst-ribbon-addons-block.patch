---
--- a/vcl/source/control/PriorityHBox.cxx
+++ b/vcl/source/control/PriorityHBox.cxx
@@ -249,11 +249,48 @@
     VclHBox::Paint(rRenderContext, rRect);
 }
 
+namespace
+{
+/// HST Office: the add-on box of the Extension tab (a merged group box inside the tab's merged box, where
+/// the toolbars of extensions go) is there and holds nothing but its own chevron: no extension adds buttons
+bool lcl_HstEmptyAddonBox(const vcl::Window& rBox)
+{
+    for (const vcl::Window* pChild = rBox.GetWindow(GetWindowType::FirstChild); pChild;
+         pChild = pChild->GetWindow(GetWindowType::Next))
+    {
+        if (!dynamic_cast<const PriorityMergedHBox*>(pChild))
+            continue;
+        for (const vcl::Window* pInner = pChild->GetWindow(GetWindowType::FirstChild); pInner;
+             pInner = pInner->GetWindow(GetWindowType::Next))
+        {
+            if (!dynamic_cast<const PriorityMergedHBox*>(pInner))
+                continue;
+            bool bEmpty = true;
+            for (const vcl::Window* pItem = pInner->GetWindow(GetWindowType::FirstChild); pItem && bEmpty;
+                 pItem = pItem->GetWindow(GetWindowType::Next))
+                bEmpty = pItem->GetType() == WindowType::PUSHBUTTON;
+            if (bEmpty)
+                return true;
+        }
+    }
+    return false;
+}
+}
