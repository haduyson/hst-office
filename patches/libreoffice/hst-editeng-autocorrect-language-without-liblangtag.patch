+#pragma once
+
+#include <editeng/editengdllapi.h>
+
+#include <string_view>
+
+/// Whether rTag is a plain ISO 639 language code: two or three lowercase ASCII letters outside the
+/// private-use range qaa-qtz. Such a tag is a valid BCP 47 tag without private use, which can be
+/// answered without liblangtag, whose language subtag registry takes about 40 MB once loaded.
+EDITENG_DLLPUBLIC bool HstIsPlainLanguageCode(std::u16string_view rTag);
+
+/* vim:set shiftwidth=4 softtabstop=4 expandtab: */
--- /dev/null
+++ b/editeng/source/misc/hstlanguagecode.cxx
@@ -0,0 +1,18 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/* SPDX-License-Identifier: LicenseRef-HST-Proprietary */
+
+#include <hstlanguagecode.hxx>
+
+#include <algorithm>
+
+bool HstIsPlainLanguageCode(std::u16string_view rTag)
+{
+    if (rTag.size() < 2 || rTag.size() > 3)
+        return false;
+    if (!std::all_of(rTag.begin(), rTag.end(), [](char16_t c) { return c >= 'a' && c <= 'z'; }))
+        return false;
+    // qaa-qtz is reserved for private use
+    return !(rTag.size() == 3 && rTag[0] == 'q' && rTag[1] <= 't');
+}
+
