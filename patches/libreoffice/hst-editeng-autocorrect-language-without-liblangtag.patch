+
+/// The AutoCorrect configuration accepts plain language codes without liblangtag, with the same
+/// answer as LanguageTag::isValidBcp47 without private use.
+class HstLanguageCodeTest : public CppUnit::TestFixture
+{
+public:
+    void testHstPlainLanguageCode()
+    {
+        for (const char* pTag : { "de", "es", "fr", "it", "dsb", "hsb", "vi" })
+        {
+            const OUString aTag = OUString::createFromAscii(pTag);
+            CPPUNIT_ASSERT_MESSAGE(pTag, HstIsPlainLanguageCode(aTag));
+            CPPUNIT_ASSERT_MESSAGE(pTag, LanguageTag::isValidBcp47(aTag, nullptr,
+                                                                  LanguageTag::PrivateUse::DISALLOW));
+        }
+        for (const char* pTag : { "", "x", "qaa", "qtz", "DE", "abcd", "de-DE", "sr-Latn", "x-hst" })
+            CPPUNIT_ASSERT_MESSAGE(pTag, !HstIsPlainLanguageCode(OUString::createFromAscii(pTag)));
+        CPPUNIT_ASSERT(HstIsPlainLanguageCode(u"qua")); // just past the private-use range
+    }
+
+    CPPUNIT_TEST_SUITE(HstLanguageCodeTest);
+    CPPUNIT_TEST(testHstPlainLanguageCode);
+    CPPUNIT_TEST_SUITE_END();
+};
+
+CPPUNIT_TEST_SUITE_REGISTRATION(HstLanguageCodeTest);
 }
 
