+++ b/sc/source/core/inc/interpre.hxx
@@ -282,6 +282,10 @@ private:
     void PushParameterExpected();
     void PushIllegalParameter();
     void PushIllegalArgument();
+    /** #NUM!: a numeric argument outside the function's domain (SQRT(-1), LN(0), NORM.DIST with
+        sd <= 0, a probability outside [0,1], ...), like the leading spreadsheet application.
+        Text or a value of the wrong type stays #VALUE! (PushIllegalArgument(), PushNoValue()). */
+    void PushNumError();
     void PushNoValue();
     void PushNA();
 
