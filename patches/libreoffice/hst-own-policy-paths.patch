+// HST Office reads policies only from its own key, never from LibreOffice's. Releases up to
+// 1.0.0-beta.4 read LibreOffice's key, and the update-check lock templates of their user guide wrote
+// there. That one HST-only subtree is still read from the old key, unless HST Office's own key of the
+// same hive has it (an empty subtree there also hides the old one).
+constexpr wchar_t HST_POLICY_KEY[] = L"SOFTWARE\\Policies\\HASON TECH\\HST Office";
+constexpr wchar_t LEGACY_POLICY_KEY[] = L"SOFTWARE\\Policies\\LibreOffice";
+constexpr OUString LEGACY_SUBTREE = u"org.openoffice.Office.HSTUpdate"_ustr;
+
+// Closes an opened registry key on every return path.
+struct RegKey
+{
+    HKEY h = nullptr;
+    RegKey() = default;
+    RegKey(RegKey const &) = delete;
+    RegKey& operator=(RegKey const &) = delete;
+    ~RegKey() { if (h != nullptr) RegCloseKey(h); }
+};
+
+bool openKey(HKEY hParent, wchar_t const * pName, RegKey & rKey)
+{
+    HKEY h;
+    if (RegOpenKeyExW(hParent, pName, 0, KEY_READ, &h) != ERROR_SUCCESS)
+        return false;
+    rKey.h = h;
+    return true;
+}
+
+bool hasSubKey(HKEY hKey, OUString const & rName)
+{
+    RegKey aSub;
+    return openKey(hKey, o3tl::toW(rName.getStr()), aSub);
+}
+
 char const* winRegTypeName(WinRegType type) {
     return type == LOCAL_MACHINE ? "HKEY_LOCAL_MACHINE" : "HKEY_CURRENT_USER";
 }
