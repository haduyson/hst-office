 {
-    HKEY hKey;
     HKEY hDomain = eType == LOCAL_MACHINE ? HKEY_LOCAL_MACHINE : HKEY_CURRENT_USER;
-    if(RegOpenKeyExW(hDomain, L"SOFTWARE\\Policies\\LibreOffice", 0, KEY_READ, &hKey) != ERROR_SUCCESS)
+    RegKey aKey;
+    bool bHst = openKey(hDomain, HST_POLICY_KEY, aKey);
+    RegKey aLegacyKey;
+    bool bLegacy = (!bHst || !hasSubKey(aKey.h, LEGACY_SUBTREE))
+        && openKey(hDomain, LEGACY_POLICY_KEY, aLegacyKey) && hasSubKey(aLegacyKey.h, LEGACY_SUBTREE);
+    if (!bHst && !bLegacy)
     {
         SAL_INFO(
             "configmgr",
             "Windows registry settings do not exist in " << winRegTypeName(eType)
-            << " HKLM\\SOFTWARE\\Policies\\LibreOffice");
+            << "\\SOFTWARE\\Policies\\HASON TECH\\HST Office");
         return false;
     }
 
