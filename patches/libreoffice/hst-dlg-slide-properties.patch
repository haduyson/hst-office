+// HST: a slide has a size and an orientation, as in PowerPoint's Slide Size: margins and the paper
+// tray are print settings. The widgets stay, with their values, and only leave the view.
+void SvxPageDescPage::HstHideSlidePrintFields()
+{
+    for (const auto& rId : { u"box3"_ustr, u"box2"_ustr, u"labelTopMargin"_ustr, u"labelBottomMargin"_ustr,
+                             u"spinMargLeft"_ustr, u"spinMargRight"_ustr, u"spinMargTop"_ustr,
+                             u"spinMargBot"_ustr, u"labelPaperTray"_ustr, u"comboPaperTray"_ustr })
+        m_xBuilder->weld_widget(rId)->hide();
+    const OUString aTitle = CuiResId(NC_("hstpageformat", "Orientation"));
+    m_xBuilder->weld_label(u"labelMargins"_ustr)->set_label(aTitle);
+    std::unique_ptr<weld::Notebook> xTabs = m_xBuilder->weld_notebook(u"hstPageTabs"_ustr);
+    xTabs->set_tab_label_text(xTabs->get_page_ident(0), aTitle);
+}
+
 void SvxPageDescPage::PageCreated(const SfxAllItemSet& aSet)
 {
     const SfxUInt16Item* pModeItem = aSet.GetItem(SID_ENUM_PAGE_MODE, false);
@@ -1680,6 +1696,9 @@
         mbEnableDrawingLayerFillStyles = bNew;
     }
 
+    if (pIsImpressDoc && pIsImpressDoc->GetValue())
+        HstHideSlidePrintFields();
+
     if (pIsImpressDoc)
         m_xNumberFormatText->set_label(SvxResId(STR_SLIDE_NUMBERS));
 }
