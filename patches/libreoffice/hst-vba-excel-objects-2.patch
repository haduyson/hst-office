Subject: [PATCH] VBA: FormatConditions.Add, RemoveDuplicates clears the rest, FileDialog.Filters items

A format condition can be created from a Range, RemoveDuplicates empties the
rows it frees, and Filters(i) gives Description and Extensions.
---
--- a/oovbaapi/ooo/vba/excel/XFileDialogFilter.idl
+++ b/oovbaapi/ooo/vba/excel/XFileDialogFilter.idl
@@ -0,0 +1,21 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This file is part of the LibreOffice project.
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+
+module ooo { module vba { module excel {
+
+/** One entry of FileDialog.Filters. */
+interface XFileDialogFilter
+{
+    interface ::ooo::vba::XHelperInterface;
+    [attribute, readonly] string Description;
+    [attribute, readonly] string Extensions;
+};
+
+}; }; };
--- a/oovbaapi/ooo/vba/excel/XFileDialogFilters.idl
+++ b/oovbaapi/ooo/vba/excel/XFileDialogFilters.idl
@@ -7,13 +7,19 @@
  * file, You can obtain one at http://mozilla.org/MPL/2.0/.
  */
 
+#include <com/sun/star/script/XDefaultMethod.idl>
+
 module ooo { module vba { module excel {
 
 /** HST: the file types of a FileDialog. */
+interface XFileDialogFilter;
+
 interface XFileDialogFilters
 {
     interface ::ooo::vba::XHelperInterface;
+    interface ::com::sun::star::script::XDefaultMethod;
     [attribute, readonly] long Count;
+    XFileDialogFilter Item( [in] long Index );
     void Clear();
     void Add( [in] string Description, [in] string Extensions, [in] any Position );
 };
