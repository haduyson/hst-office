+#include <rtl/ustring.hxx>
+#include <tools/long.hxx>
+#include <vcl/notebookbar/notebookbar.hxx>
+#include <vcl/window.hxx>
+
+#include <algorithm>
+#include <cmath>
+#include <string_view>
+
+// HST Office: the font name and font size boxes of the ribbon (Tabbed notebookbar) are as wide as in
+// Office's Home tab: 128 and 46 px at 100 %. Toolbars and the sidebar keep their own widths.
+namespace hst::ribbon
+{
+constexpr tools::Long FONT_NAME_BOX_WIDTH = 128;
+constexpr tools::Long FONT_SIZE_BOX_WIDTH = 46;
+
+/// True when rWindow is (inside) a notebookbar (the ribbon); its parents are set when the box is made
+inline bool InNotebookbar(const vcl::Window& rWindow)
+{
+    for (const vcl::Window* pParent = &rWindow; pParent; pParent = pParent->GetParent())
+    {
+        if (dynamic_cast<const NotebookBar*>(pParent))
+            return true;
+    }
+    return false;
+}
+
+/// The .ui of a box made in pParent: in the ribbon its variant "<name>ribbon.ui", whose ▾ button has no
+/// padding (gtk3 "small-button"), so the box gets as narrow as Office's
+inline OUString BoxUIFile(const vcl::Window* pParent, std::u16string_view aName)
+{
+    return OUString::Concat(u"svx/ui/") + aName
+           + (pParent && InNotebookbar(*pParent) ? std::u16string_view(u"ribbon.ui") : std::u16string_view(u".ui"));
+}
+
+/// nLogical px at the window's scale
+inline int RibbonPixels(const vcl::Window& rWindow, tools::Long nLogical)
+{
+    return static_cast<int>(std::lround(nLogical * rWindow.GetDPIScaleFactor()));
+}
+
+/// Make the box of the item window rWindow nLogical px wide. On gtk3 the request sizes the entry and the
+/// ▾ button comes on top of it, so the part over the target is taken off the request; elsewhere the request
+/// is the whole box. A theme whose entry and button need more keeps its minimum.
+template <class Box> void FitRibbonWidth(const vcl::Window& rWindow, Box& rBox, tools::Long nLogical)
+{
+    const int nTarget = RibbonPixels(rWindow, nLogical);
+    rBox.set_size_request(nTarget, -1);
+    const tools::Long nOver = rWindow.get_preferred_size().Width() - nTarget;
+    if (nOver > 0)
+        rBox.set_size_request(std::max<int>(1, nTarget - nOver), -1);
+}
+}
+
