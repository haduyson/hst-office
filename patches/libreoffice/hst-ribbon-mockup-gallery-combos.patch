--- a/vcl/unx/gtk3/gtkinst.cxx
+++ b/vcl/unx/gtk3/gtkinst.cxx
@@ -21740,6 +21740,24 @@
             gtk_style_context_add_class(gtk_widget_get_style_context(GTK_WIDGET(getContainer())), "small-button");
         if (gtk_style_context_has_class(gtk_widget_get_style_context(GTK_WIDGET(m_pComboBox)), "novertpad"))
             gtk_style_context_add_class(gtk_widget_get_style_context(GTK_WIDGET(getContainer())), "novertpad");
+        // HST Office: the ribbon's font name and size boxes ("hst-ribbon-combo": svx fontnameboxribbon.ui and
+        // fontsizeboxribbon.ui) are as narrow as in Office's Home tab, 128 and 46 px: less side padding in the
+        // entry and the ▾ button, their frames kept. Toolbars, the sidebar and dialogs keep the theme's padding.
+        if (gtk_style_context_has_class(gtk_widget_get_style_context(GTK_WIDGET(m_pComboBox)), "hst-ribbon-combo"))
+        {
+            static const gchar aEntryCss[] = "entry { padding-left: 4px; padding-right: 2px; min-width: 0; }";
+            static const gchar aButtonCss[] = "button { padding-left: 2px; padding-right: 2px; min-width: 0; }";
+            const std::pair<GtkWidget*, const gchar*> aNarrow[] = { { m_pEntry, aEntryCss },
+                                                                    { m_pToggleButton, aButtonCss } };
+            for (const auto& [pWidget, pCss] : aNarrow)
+            {
+                GtkCssProvider* pProvider = gtk_css_provider_new();
+                css_provider_load_from_data(pProvider, pCss, -1);
+                gtk_style_context_add_provider(gtk_widget_get_style_context(pWidget), GTK_STYLE_PROVIDER(pProvider),
+                                               GTK_STYLE_PROVIDER_PRIORITY_APPLICATION);
+                g_object_unref(pProvider); // the style context keeps it
+            }
+        }
 
