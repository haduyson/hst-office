+// HST Office: the short names the gallery shows for the common Writer styles, in the order of the gallery
+// (Office's Normal, Body Text, Heading 1, Heading 2, Title, Quote); keyed by the programmatic name.
+struct HstShortName
+{
+    std::u16string_view aStyle;
+    TranslateId aLabel;
+};
+constexpr HstShortName HST_SHORT_NAMES[] = {
+    { u"Standard", RID_HST_STYLE_SHORT_STANDARD },     { u"Text body", RID_HST_STYLE_SHORT_TEXT_BODY },
+    { u"Heading 1", RID_HST_STYLE_SHORT_HEADING_1 },   { u"Heading 2", RID_HST_STYLE_SHORT_HEADING_2 },
