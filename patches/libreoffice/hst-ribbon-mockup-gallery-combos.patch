+};
+
+size_t lcl_HstShortRank(const StylePreviewDescriptor& rStyle)
+{
+    const auto it = std::find_if(std::begin(HST_SHORT_NAMES), std::end(HST_SHORT_NAMES),
+                                 [&rStyle](const HstShortName& r) { return r.aStyle == rStyle.commonName; });
+    return it - std::begin(HST_SHORT_NAMES);
+}
