+// HST Office: the font name and font size boxes of the ribbon (Tabbed notebookbar) are as wide as in
+// Office's Home tab: 128 and 46 px at 100 %. Toolbars and the sidebar keep their own widths.
+namespace hst::ribbon
+{
+constexpr tools::Long FONT_NAME_BOX_WIDTH = 128;
+constexpr tools::Long FONT_SIZE_BOX_WIDTH = 46;
+
+/// True when rWindow is (inside) a notebookbar (the ribbon); its parents are set when the box is made
+inline bool InNotebookbar(const vcl::Window& rWindow)
+{
+    for (const vcl::Window* pParent = &rWindow; pParent; pParent = pParent->GetParent())
+    {
+        if (dynamic_cast<const NotebookBar*>(pParent))
+            return true;
+    }
+    return false;
+}
+
+/// The .ui of a box made in pParent: in the ribbon "<name>ribbon.ui", whose combo box has the class
+/// "hst-ribbon-combo" (vcl gtk3 narrows its entry and button padding); elsewhere "<name>.ui"
+inline OUString BoxUIFile(const vcl::Window* pParent, std::u16string_view aName)
+{
+    const bool bRibbon = pParent && InNotebookbar(*pParent);
+    return OUString::Concat(u"svx/ui/") + aName + (bRibbon ? std::u16string_view(u"ribbon.ui") : std::u16string_view(u".ui"));
+}
+
+/// nLogical px at the window's scale
+inline int RibbonPixels(const vcl::Window& rWindow, tools::Long nLogical)
+{
+    return static_cast<int>(std::lround(nLogical * rWindow.GetDPIScaleFactor()));
+}
+
+/// Make the box of the item window rWindow nLogical px wide: the part of its preferred width over the target
+/// (gtk3's ▾ button once the box is shown) is taken off the request. A theme whose entry and button need
+/// more keeps its minimum.
+/// (The item window's preferred size is the cached requisition of its content, so it is invalidated first.)
+template <class Box> void FitRibbonWidth(InterimItemWindow& rWindow, Box& rBox, tools::Long nLogical)
+{
+    const int nTarget = RibbonPixels(rWindow, nLogical);
+    rBox.set_size_request(nTarget, -1);
+    rWindow.InvalidateChildSizeCache();
+    const tools::Long nOver = rWindow.get_preferred_size().Width() - nTarget;
+    if (nOver > 0)
+    {
+        rBox.set_size_request(std::max<int>(1, nTarget - nOver), -1);
+        rWindow.InvalidateChildSizeCache();
+    }
+}
+
+/// Its toolbox lays the item window rWindow out again at the window's new size
+inline void RelayoutItem(vcl::Window& rWindow)
+{
+    ToolBox* pBox = dynamic_cast<ToolBox*>(rWindow.GetParent());
+    if (!pBox)
+        return;
+    for (ToolBox::ImplToolItems::size_type i = 0; i < pBox->GetItemCount(); ++i)
+    {
+        const ToolBoxItemId nId = pBox->GetItemId(i);
+        if (pBox->GetItemWindow(nId) == &rWindow)
+        {
+            pBox->SetItemWindow(nId, &rWindow); // the item takes the window's new size
+            break;
+        }
+    }
+    pBox->queue_resize();
+}
+
+/// Fits a ribbon box once more after it is first shown: on gtk3 the box measured when it is made does not
+/// yet count the width its ▾ button takes on screen (128 px became 165)
+class RibbonRefit final : public Idle
+{
+    std::function<void()> m_aRefit;
+
+public:
+    explicit RibbonRefit(std::function<void()> aRefit)
+        : Idle("svx ribbon box refit")
+        , m_aRefit(std::move(aRefit))
+    {
+    }
+    void Invoke() override { m_aRefit(); }
+};
+}
