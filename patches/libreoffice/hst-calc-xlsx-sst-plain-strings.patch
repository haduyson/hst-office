+CPPUNIT_TEST_FIXTURE(ScFiltersTest5, testXlsxPlainSharedStringsPooledWhenRead)
+{
+    // The import pools the text of a plain shared string table entry as it reads the table and gives that pooled
+    // string to every cell of the entry, without keeping a RichString for it. The cells must be exactly those of the
+    // RichString path (the environment variable selects it): plain texts with spaces and escaped characters, an
+    // empty text, rich text and multi-line text (edit cells), a single run without a font (plain), the same text in
+    // two entries, an index past the end of the table, and plain entries in cells with a superscript font (column
+    // E from row 11: a cell font that needs rich text makes an edit cell).
+    static constexpr OString aStrings
+        = "<si><t>H\xC3\xA0 N\xE1\xBB\x99i</t></si>"
+          "<si><t xml:space=\"preserve\">  a &lt; b &amp; &quot;c&quot;  </t></si>"
+          "<si><t/></si>"
+          "<si><r><rPr><b/></rPr><t>\xC4\x90\xE1\xBA\xADm</t></r><r><t xml:space=\"preserve\"> th\xC6\xB0\xE1\xBB\x9Dng</t></r></si>"
+          "<si><t>d\xC3\xB2ng 1\nd\xC3\xB2ng 2</t></si>"
+          "<si><t>H\xC3\xA0 N\xE1\xBB\x99i</t></si>"
+          "<si><r><t>m\xE1\xBB\x99t ph\xE1\xBA\xA7n</t></r></si>"_ostr;
+    OStringBuffer aRows;
+    for (int nRow = 1; nRow <= 30; ++nRow)
+    {
+        const OString r = OString::number(nRow);
+        aRows.append("<row r=\"" + r + "\">");
+        for (char cCol = 'A'; cCol <= 'E'; ++cCol)
+            aRows.append("<c r=\"" + OStringChar(cCol) + r + "\" t=\"s\""
+                         + OString(cCol == 'E' && nRow > 10 ? " s=\"1\"" : "") + "><v>"
+                         + OString::number((nRow * 3 + (cCol - 'A')) % 7) + "</v></c>");
+        if (nRow == 30)
+            aRows.append("<c r=\"F30\" t=\"s\"><v>99</v></c>");
+        aRows.append("</row>");
+    }
+    writeXlsxWithSharedStrings(maTempFile.GetURL(), aRows.makeStringAndClear(), aStrings);
+
+    const auto loadAndDump = [this]() {
+        loadFromURL(maTempFile.GetURL(),
+                    { comphelper::makePropertyValue(u"FilterName"_ustr, u"Calc Office Open XML"_ustr) });
+        ScDocument* pDoc = getScDoc();
+        // cell type, text, and for a text cell the first cell holding the same pooled string
+        std::map<const rtl_uString*, OUString> aFirst;
+        OUStringBuffer aDump;
+        for (SCROW nRow = 0; nRow < 30; ++nRow)
+            for (SCCOL nCol = 0; nCol < 6; ++nCol)
+            {
+                const ScAddress aPos(nCol, nRow, 0);
+                const ScRefCellValue aCell(*pDoc, aPos);
+                aDump.append(aPos.Format(ScRefFlags::VALID) + " "
+                             + OUString::number(static_cast<int>(aCell.getType())) + " ["
+                             + pDoc->GetString(aPos) + "]");
+                if (aCell.getType() == CELLTYPE_STRING)
+                    aDump.append(" same as "
+                                 + aFirst.emplace(aCell.getSharedString()->getData(),
+                                                  aPos.Format(ScRefFlags::VALID)).first->second);
+                aDump.append("\n");
+            }
+        return aDump.makeStringAndClear();
+    };
+
+    osl_setEnvironment(u"HST_SC_XLSX_SST_PLAIN_OFF"_ustr.pData, u"1"_ustr.pData);
+    const OUString aRichPath = loadAndDump();
+    osl_clearEnvironment(u"HST_SC_XLSX_SST_PLAIN_OFF"_ustr.pData);
+    dispose();
+
+    const OUString aPooled = loadAndDump();
+    CPPUNIT_ASSERT_EQUAL(aRichPath, aPooled);
+    // A1 is entry 3 (rich text: an edit cell), B1 entry 4 (two lines: an edit cell), E1 entry 0 and A2 entry 6,
+    // C1 entry 5 holds the same text as entry 0 and the same pooled string
+    CPPUNIT_ASSERT(aPooled.indexOf(OUString(u"A1 " + OUString::number(int(CELLTYPE_EDIT)))) >= 0);
+    CPPUNIT_ASSERT(aPooled.indexOf(OUString(u"C1 " + OUString::number(int(CELLTYPE_STRING))
+                                         + u" [H\u00E0 N\u1ED9i] same as C1")) >= 0);
+    CPPUNIT_ASSERT(aPooled.indexOf(OUString(u"E1 " + OUString::number(int(CELLTYPE_STRING))
+                                         + u" [H\u00E0 N\u1ED9i] same as C1")) >= 0);
+    CPPUNIT_ASSERT(aPooled.indexOf(OUString(u"A2 " + OUString::number(int(CELLTYPE_STRING))
+                                         + u" [m\u1ED9t ph\u1EA7n] same as")) >= 0);
+    CPPUNIT_ASSERT(aPooled.indexOf(OUString(u"F30 " + OUString::number(int(CELLTYPE_NONE)) + u" []")) >= 0);
+    // E12 is entry 5 in a superscript cell: an edit cell with the same text
+    CPPUNIT_ASSERT(aPooled.indexOf(OUString(u"E12 " + OUString::number(int(CELLTYPE_EDIT))
+                                                  + u" [H\u00E0 N\u1ED9i]\n")) >= 0);
+}
