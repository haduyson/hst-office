+namespace oox::xls
+{
+/** The plain entries of an .xlsx shared string table, kept as strings of the document's string pool.
+
+    The import read every entry of the shared string table into a RichString object with a vector of portions, also
+    the plain ones (one run of text without a font), and kept them all until the sheets were read. A table of
+    1.2 million entries held about 160 MB in these objects, allocated between the entries' texts; once freed, the
+    allocator could not give the pages back, and the open document kept about 175 MB more than the same sheet
+    written with inline strings. Every cell of the entry also put the same text into the string pool on its own.
+
+    Now an entry that is plain whatever the cell's font (one portion without a font, no phonetic text, not empty,
+    no line break) gives its text to the pool as soon as it is read, and its RichString is dropped before the next
+    entry is read, so the temporary objects reuse the same memory. The cells of the entry take the pooled string;
+    a cell whose font needs rich text (superscript or subscript) gets a RichString made from the text, as the import
+    made it before. The environment variable HST_SC_XLSX_SST_PLAIN_OFF keeps every entry as a RichString (used by
+    a test to compare both paths). */
+class HstSstPlainStrings
+{
+public:
+    HstSstPlainStrings()
+        : mbEnabled(!std::getenv("HST_SC_XLSX_SST_PLAIN_OFF"))
+    {
+    }
+
+    /** Pools entry nIndex (the last one read) if it is plain, and drops rxString then. */
+    void compact(sal_Int32 nIndex, RichStringRef& rxString, svl::SharedStringPool& rPool)
+    {
+        OUString aText;
+        if (!mbEnabled || !rxString || nIndex < 0 || !rxString->extractPlainString(aText, nullptr)
+            || aText.isEmpty() || rxString->getPortion(0).getFontId() >= 0)
+            return;
+        if (maStrings.size() <= static_cast<size_t>(nIndex))
+            maStrings.resize(nIndex + 1);
+        maStrings[nIndex] = rPool.intern(aText);
+        rxString.reset();
+    }
+
+    /** The pooled string of a plain entry, or null. */
+    const svl::SharedString* get(sal_Int32 nIndex) const
+    {
+        if (nIndex < 0 || static_cast<size_t>(nIndex) >= maStrings.size() || !maStrings[nIndex].getData())
+            return nullptr;
+        return &maStrings[nIndex];
+    }
+
+    /** A RichString of one portion holding the text of a plain entry, as the import read it. */
+    RichStringRef makeRichString(sal_Int32 nIndex) const
+    {
+        const svl::SharedString* pString = get(nIndex);
+        if (!pString)
+            return RichStringRef();
+        RichStringRef xString = std::make_shared<RichString>();
+        xString->getPortion(xString->importRun()).setText(pString->getString());
+        return xString;
+    }
+
+    void clear() { std::vector<svl::SharedString>().swap(maStrings); }
+
+private:
+    bool mbEnabled;
+    std::vector<svl::SharedString> maStrings;
+};
+}
