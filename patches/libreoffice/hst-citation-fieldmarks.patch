+/// HST: Undo / Redo of a change to a text form field's parameters (its field code), which the
+/// field update commands make outside the content operations that Undo records.
+class SwUndoTextFieldmarkParameters final : public SwUndo
+{
+private:
+    const SwNodeOffset m_nStartNode;
+    const sal_Int32 m_nStartContent;
+    const ::sw::mark::Fieldmark::parameter_map_t m_aOldParameters;
+    const ::sw::mark::Fieldmark::parameter_map_t m_aNewParameters;
+
+    void SetParameters(SwDoc& rDoc, const ::sw::mark::Fieldmark::parameter_map_t& rParameters) const;
+
+public:
+    SwUndoTextFieldmarkParameters(const ::sw::mark::Fieldmark& rFieldmark,
+                                  ::sw::mark::Fieldmark::parameter_map_t aOldParameters);
+
+    virtual void UndoImpl(::sw::UndoRedoContext&) override;
+    virtual void RedoImpl(::sw::UndoRedoContext&) override;
+};
