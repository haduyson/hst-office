+/// HST: is the range in the text being imported? Comparing the XText objects is not enough: in a
+/// footnote, endnote or text frame the range's getText() can be a second UNO object for the same
+/// text, and a field there was thrown away on reload. Creating a cursor checks the position.
+static bool lcl_IsInHelperText(XMLTextImportHelper & rHelper,
+        uno::Reference<text::XTextRange> const& xRange)
+{
+    if (rHelper.GetText() == xRange->getText())
+        return true;
+    try
+    {
+        return rHelper.GetText()->createTextCursorByRange(xRange).is();
+    }
+    catch (uno::RuntimeException const&)
+    {
+        return false;
+    }
+}
