+/// HST: select a whole fieldmark, its start and end characters included; the point stays on the
+/// side the cursor was on, so a further Shift+arrow extends the selection naturally.
+void lcl_SelectWholeFieldmark(SwWrtShell& rSh, const sw::mark::Fieldmark& rFieldmark,
+                              bool bPointAtStart)
+{
+    SwPaM aPam(rFieldmark.GetMarkStart(), rFieldmark.GetMarkEnd()); // mark = start, point = end
+    if (bPointAtStart)
+        aPam.Exchange();
+    rSh.SetSelection(aPam);
+}
