+SwUndoTextFieldmarkParameters::SwUndoTextFieldmarkParameters(
+    const ::sw::mark::Fieldmark& rFieldmark, ::sw::mark::Fieldmark::parameter_map_t aOldParameters)
+    : SwUndo(SwUndoId::UPDATE_FORM_FIELD, rFieldmark.GetMarkPos().GetDoc())
+    , m_nStartNode(rFieldmark.GetMarkStart().GetNodeIndex())
+    , m_nStartContent(rFieldmark.GetMarkStart().GetContentIndex())
+    , m_aOldParameters(std::move(aOldParameters))
+    , m_aNewParameters(*rFieldmark.GetParameters())
+{
+}
+
+void SwUndoTextFieldmarkParameters::SetParameters(
+    SwDoc& rDoc, const ::sw::mark::Fieldmark::parameter_map_t& rParameters) const
+{
+    // Undo restores the document exactly as it was when this action was recorded, so the
+    // field still starts at the recorded position.
+    SwContentNode *const pNode = rDoc.GetNodes()[m_nStartNode]->GetContentNode();
+    if (!pNode)
+        return;
+    SwPosition const aPos(*pNode, m_nStartContent);
+    ::sw::mark::Fieldmark *const pFieldmark = rDoc.getIDocumentMarkAccess()->getFieldmarkAt(aPos);
+    if (pFieldmark && pFieldmark->GetMarkStart() == aPos)
+        *pFieldmark->GetParameters() = rParameters;
+}
+
+void SwUndoTextFieldmarkParameters::UndoImpl(::sw::UndoRedoContext & rContext)
+{
+    SetParameters(rContext.GetDoc(), m_aOldParameters);
+}
+
+void SwUndoTextFieldmarkParameters::RedoImpl(::sw::UndoRedoContext & rContext)
+{
+    SetParameters(rContext.GetDoc(), m_aNewParameters);
+}
