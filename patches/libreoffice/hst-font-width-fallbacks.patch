+static OUString findFallback(const vcl::font::PhysicalFontCollection& rCollection, const OUString& rName)
+{
+    vcl::Font aFont(rName, Size(0, 12));
+    vcl::font::FontSelectPattern aPattern(aFont, rName, Size(0, 12), 12, false);
+    vcl::font::PhysicalFontFamily* pFamily = rCollection.FindFontFamily(aPattern);
+    return pFamily ? pFamily->GetSearchName() : OUString();
+}
+
+void VclPhysicalFontCollectionTest::testWidthMatchedFallbacks()
+{
+    // Without Segoe UI, Aptos and Calibri (e.g. on Linux): the bundled width-matched fonts.
+    vcl::font::PhysicalFontCollection aBundled;
+    aBundled.FindOrCreateFontFamily(GetEnglishSearchFontName(u"Liberation Sans"));
+    aBundled.FindOrCreateFontFamily(GetEnglishSearchFontName(u"Carlito"));
+    CPPUNIT_ASSERT_EQUAL(u"liberationsans"_ustr, findFallback(aBundled, u"Segoe UI"_ustr));
+    CPPUNIT_ASSERT_EQUAL(u"carlito"_ustr, findFallback(aBundled, u"Aptos"_ustr));
+    CPPUNIT_ASSERT_EQUAL(u"carlito"_ustr, findFallback(aBundled, u"Aptos Display"_ustr));
+    CPPUNIT_ASSERT_EQUAL(u"carlito"_ustr, findFallback(aBundled, u"Aptos Narrow"_ustr));
+
+    // Calibri is preferred for Aptos where it is installed (e.g. on Windows).
+    vcl::font::PhysicalFontCollection aWithCalibri;
+    aWithCalibri.FindOrCreateFontFamily(GetEnglishSearchFontName(u"Carlito"));
+    aWithCalibri.FindOrCreateFontFamily(GetEnglishSearchFontName(u"Calibri"));
+    CPPUNIT_ASSERT_EQUAL(u"calibri"_ustr, findFallback(aWithCalibri, u"Aptos"_ustr));
+
+    // An installed Aptos is used as is.
+    aWithCalibri.FindOrCreateFontFamily(GetEnglishSearchFontName(u"Aptos"));
+    CPPUNIT_ASSERT_EQUAL(u"aptos"_ustr, findFallback(aWithCalibri, u"Aptos"_ustr));
+}
+
 CPPUNIT_TEST_SUITE_REGISTRATION(VclPhysicalFontCollectionTest);
 
