+{
+struct Check
+{
+    const char* pFormula;
+    const char* pResult;
+};
+
+// Data: H1:H5 = apple, pear, apple, plum, pear; I1:I5 = 3, 5, 2, 7, 1;
+// J2 = TRUE; K1 = "a ""b"""; rows 20-22 of columns L:N are blank except M21.
+const Check aChecks[] = {
+    { "=ARRAYTOTEXT(I1:I3)", "3, 5, 2" },
+    { "=ARRAYTOTEXT(H1:I2;1)", "{\"apple\",3;\"pear\",5}" },
+    { "=ARRAYTOTEXT(I1:I3;2)", "#VALUE!" },
+    { "=VALUETOTEXT(I1)", "3" },
+    { "=VALUETOTEXT(H1;1)", "\"apple\"" },
+    { "=VALUETOTEXT(K1;1)", "\"a \"\"b\"\"\"" },
+    { "=VALUETOTEXT(TRUE())", "TRUE" },
+    { "=VALUETOTEXT(J2)", "TRUE" },
+    { "=VALUETOTEXT(1/0)", "#DIV/0!" },
+    { "=VALUETOTEXT(1;5)", "#VALUE!" },
+    { "=DBCS(\"AB1\")", "\xEF\xBC\xA1\xEF\xBC\xA2\xEF\xBC\x91" },
+    { "=PHONETIC(H1)", "apple" },
+    { "=PHONETIC(H2:H3)", "pear" },
+    { "=PHONETIC(I1)", "" },
+    { "=PERCENTOF(I1:I2;I1:I5)", "0.444444444444444" },
+    { "=PERCENTOF(I1;L20:L22)", "#DIV/0!" },
+    { "=REGEXTEST(\"Apple\";\"^a\")", "FALSE" },
+    { "=REGEXTEST(\"Apple\";\"^a\";1)", "TRUE" },
+    { "=REGEXTEST(\"x\";\"(\")", "#VALUE!" },
+    { "=REGEXTEST(\"x\";\"x\";2)", "#VALUE!" },
+    { "=REGEXEXTRACT(\"tel 123-456\";\"[0-9]+\")", "123" },
+    { "=REGEXEXTRACT(\"abc\";\"[0-9]+\")", "#N/A" },
+    { "=COLUMNS(REGEXEXTRACT(\"1a22b333\";\"[0-9]+\";1))", "3" },
+    { "=INDEX(REGEXEXTRACT(\"1a22b333\";\"[0-9]+\";1);1;3)", "333" },
+    { "=INDEX(REGEXEXTRACT(\"Nguyen Van An\";\"(\\w+) (\\w+) (\\w+)\";2);1;2)", "Van" },
+    { "=REGEXEXTRACT(\"x\";\"x\";3)", "#VALUE!" },
+    { "=REGEXREPLACE(\"a1b2c3\";\"[0-9]\";\"#\")", "a#b#c#" },
+    { "=REGEXREPLACE(\"a1b2c3\";\"[0-9]\";\"#\";2)", "a1b#c3" },
+    { "=REGEXREPLACE(\"a1b2c3\";\"[0-9]\";\"#\";-1)", "a1b2c#" },
+    { "=REGEXREPLACE(\"a1b2c3\";\"[0-9]\";\"#\";9)", "a1b2c3" },
+    { "=REGEXREPLACE(\"Le Thi\";\"(\\w+) (\\w+)\";\"$2 $1\")", "Thi Le" },
+    { "=ROWS(TRIMRANGE(H1:H30))", "5" },
+    { "=ROWS(TRIMRANGE(L19:N23))", "1" },
+    { "=COLUMNS(TRIMRANGE(L19:N23))", "1" },
+    { "=ROWS(TRIMRANGE(L19:N23;0))", "5" },
+    { "=ROWS(TRIMRANGE(L19:N23;2))", "3" },
+    { "=SUM(TRIMRANGE(I1:I40))", "18" },
+    { "=TRIMRANGE(L20:L22)", "#REF!" },
+    { "=TRIMRANGE(L20:L22;4)", "#VALUE!" },
+    { "=BINOM.DIST.RANGE(10;0.5;2;4)", "0.3662109375" },
+    { "=B(10;0.5;2;4)", "0.3662109375" },
+    { "=BINOM.DIST.RANGE(10;0.5;5;4)", "#NUM!" },
+    { "=CODE(\"\xC3\xA9\")", "233" },
+    { "=CHAR(233)", "\xC3\xA9" },
+    { "=CODE(\"\xC4\x90\")", "63" },
+    { "=INFO(\"system\")", "pcdos" },
+};
+
+void fillData(ScDocument& rDoc)
+{
+    const char* aFruit[] = { "apple", "pear", "apple", "plum", "pear" };
+    const double aQty[] = { 3, 5, 2, 7, 1 };
+    for (SCROW i = 0; i < 5; ++i)
+    {
+        rDoc.SetString(ScAddress(7, i, 0), OUString::createFromAscii(aFruit[i]));
+        rDoc.SetValue(ScAddress(8, i, 0), aQty[i]);
+    }
+    rDoc.SetString(ScAddress(9, 1, 0), u"=TRUE()"_ustr);
+    rDoc.SetString(ScAddress(10, 0, 0), u"a \"b\""_ustr);
+    rDoc.SetValue(ScAddress(12, 20, 0), 1.0);
+}
+}
+
+class ExcelCompatFunctionsTest : public ScModelTestBase
+{
+public:
+    ExcelCompatFunctionsTest()
+        : ScModelTestBase(u"sc/qa/unit/data"_ustr)
+    {
+    }
+
+    void checkResults(const char* pStage)
+    {
+        ScDocument* pDoc = getScDoc();
+        pDoc->CalcAll();
+        for (size_t i = 0; i < SAL_N_ELEMENTS(aChecks); ++i)
+        {
+            OString aMsg = OString::Concat(pStage) + ": " + aChecks[i].pFormula;
+            CPPUNIT_ASSERT_EQUAL_MESSAGE(aMsg.getStr(), OUString::fromUtf8(aChecks[i].pResult),
+                                         pDoc->GetString(ScAddress(0, i, 0)));
+        }
+    }
+
+    void setUpDocument()
+    {
+        createScDoc();
+        ScDocument* pDoc = getScDoc();
+        fillData(*pDoc);
+        for (size_t i = 0; i < SAL_N_ELEMENTS(aChecks); ++i)
+            pDoc->SetString(ScAddress(0, i, 0), OUString::fromUtf8(aChecks[i].pFormula));
+    }
+};
+
+CPPUNIT_TEST_FIXTURE(ExcelCompatFunctionsTest, testResultsAndXlsxRoundTrip)
+{
+    setUpDocument();
+    checkResults("new document");
+
+    saveAndReload(TestFilter::XLSX);
+    checkResults("after XLSX round trip");
+
+    xmlDocUniquePtr pSheet = parseExport(u"xl/worksheets/sheet1.xml"_ustr);
+    assertXPathContent(pSheet, "/x:worksheet/x:sheetData/x:row[@r='1']/x:c[@r='A1']/x:f",
+                       u"_xlfn.ARRAYTOTEXT(I1:I3)");
+    assertXPathContent(pSheet, "/x:worksheet/x:sheetData/x:row[@r='4']/x:c[@r='A4']/x:f",
+                       u"_xlfn.VALUETOTEXT(I1)");
+    assertXPathContent(pSheet, "/x:worksheet/x:sheetData/x:row[@r='11']/x:c[@r='A11']/x:f",
+                       u"_xlfn.DBCS(\"AB1\")");
+    assertXPathContent(pSheet, "/x:worksheet/x:sheetData/x:row[@r='12']/x:c[@r='A12']/x:f",
+                       u"PHONETIC(H1)");
+    assertXPathContent(pSheet, "/x:worksheet/x:sheetData/x:row[@r='15']/x:c[@r='A15']/x:f",
+                       u"_xlfn.PERCENTOF(I1:I2,I1:I5)");
+    assertXPathContent(pSheet, "/x:worksheet/x:sheetData/x:row[@r='17']/x:c[@r='A17']/x:f",
+                       u"_xlfn.REGEXTEST(\"Apple\",\"^a\")");
+    assertXPathContent(pSheet, "/x:worksheet/x:sheetData/x:row[@r='21']/x:c[@r='A21']/x:f",
+                       u"_xlfn.REGEXEXTRACT(\"tel 123-456\",\"[0-9]+\")");
+    assertXPathContent(pSheet, "/x:worksheet/x:sheetData/x:row[@r='27']/x:c[@r='A27']/x:f",
+                       u"_xlfn.REGEXREPLACE(\"a1b2c3\",\"[0-9]\",\"#\")");
+    assertXPathContent(pSheet, "/x:worksheet/x:sheetData/x:row[@r='32']/x:c[@r='A32']/x:f",
+                       u"ROWS(_xlfn.TRIMRANGE(H1:H30))");
+    assertXPathContent(pSheet, "/x:worksheet/x:sheetData/x:row[@r='40']/x:c[@r='A40']/x:f",
+                       u"_xlfn.BINOM.DIST.RANGE(10,0.5,2,4)");
+    // B() typed by a user of the old name is saved under the reference name too.
+    assertXPathContent(pSheet, "/x:worksheet/x:sheetData/x:row[@r='41']/x:c[@r='A41']/x:f",
+                       u"_xlfn.BINOM.DIST.RANGE(10,0.5,2,4)");
+}
+
+CPPUNIT_TEST_FIXTURE(ExcelCompatFunctionsTest, testOdsRoundTrip)
+{
+    setUpDocument();
+    saveAndReload(TestFilter::ODS);
+    checkResults("after ODS round trip");
+
+    xmlDocUniquePtr pContent = parseExport(u"content.xml"_ustr);
+    assertXPath(pContent, "(//table:table-cell[contains(@table:formula, 'REGEXTEST')])[1]",
+                "formula", u"of:=COM.MICROSOFT.REGEXTEST(\"Apple\";\"^a\")");
+    assertXPath(pContent, "(//table:table-cell[contains(@table:formula, 'TRIMRANGE')])[1]",
+                "formula", u"of:=ROWS(COM.MICROSOFT.TRIMRANGE([.H1:.H30]))");
+    // OpenDocument keeps its own name of the binomial range function.
+    assertXPath(pContent, "(//table:table-cell[contains(@table:formula, 'BINOM')])[1]",
+                "formula", u"of:=BINOM.DIST.RANGE(10;0.5;2;4)");
+}
+
+CPPUNIT_TEST_FIXTURE(ExcelCompatFunctionsTest, testCellFilename)
+{
+    createScDoc();
+    ScDocument* pDoc = getScDoc();
+    pDoc->SetString(ScAddress(0, 0, 0), u"=CELL(\"filename\";B1)"_ustr);
+    pDoc->CalcAll();
+    // Never saved: empty, as in the leading application.
+    CPPUNIT_ASSERT_EQUAL(OUString(), pDoc->GetString(ScAddress(0, 0, 0)));
+
+    OUString aTab;
+    saveAndReload(TestFilter::XLSX);
+    pDoc = getScDoc();
+    pDoc->GetName(0, aTab);
+    pDoc->CalcAll();
+    const INetURLObject& rURL = getScDocShell()->GetMedium()->GetURLObject();
+    OUString aDir;
+    CPPUNIT_ASSERT_EQUAL(osl::FileBase::E_None,
+                         osl::FileBase::getSystemPathFromFileURL(rURL.GetPartBeforeLastName(), aDir));
+    CPPUNIT_ASSERT_EQUAL(
+        OUString(aDir + "[" + rURL.GetLastName(INetURLObject::DecodeMechanism::Unambiguous) + "]" + aTab),
+        pDoc->GetString(ScAddress(0, 0, 0)));
+
+    // An OpenDocument file keeps the form its own formulas parse.
+    saveAndReload(TestFilter::ODS);
+    pDoc = getScDoc();
+    pDoc->CalcAll();
+    const INetURLObject& rOdsURL = getScDocShell()->GetMedium()->GetURLObject();
+    CPPUNIT_ASSERT_EQUAL(
+        OUString("'" + rOdsURL.GetMainURL(INetURLObject::DecodeMechanism::Unambiguous) + "'#$" + aTab),
+        pDoc->GetString(ScAddress(0, 0, 0)));
+}
+
+CPPUNIT_PLUGIN_IMPLEMENT();
