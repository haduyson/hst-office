+void ScInterpreter::ScValueToText()
+{
+    sal_uInt8 nParamCount = GetByte();
+    if (!MustHaveParamCount(nParamCount, 1, 2))
+        return;
+    sal_Int32 nFormat = 0;
+    if (nParamCount == 2)
+        nFormat = GetInt32WithDefault(0);
+    if (nGlobalError != FormulaError::NONE)
+    {
+        PushError(nGlobalError);
+        return;
+    }
+    if (nFormat < 0 || nFormat > 1)
+    {
+        PushError(FormulaError::NoValue);
+        return;
+    }
+    const bool bStrict = (nFormat == 1);
+
+    switch (GetStackType())
+    {
+        case svError:
+        {
+            // An error value is converted to its text, not propagated.
+            PopError();
+            FormulaError nErr = nGlobalError;
+            nGlobalError = FormulaError::NONE;
+            PushString(ScGlobal::GetErrorString(nErr));
+            return;
+        }
+        case svDouble:
+        {
+            const auto* pDouble = dynamic_cast<const FormulaDoubleToken*>(pStack[sp - 1]);
+            const bool bLogical = pDouble && pDouble->GetDoubleType()
+                                  == static_cast<sal_Int16>(SvNumFormatType::LOGICAL);
+            double fVal = GetDouble();
+            PushString(bLogical ? ExcelLogicalText(fVal) : GetStringFromDouble(fVal).getString());
+            return;
+        }
+        case svSingleRef:
+        {
+            ScAddress aAdr;
+            PopSingleRef(aAdr);
+            if (nGlobalError != FormulaError::NONE)
+            {
+                PushError(nGlobalError);
+                return;
+            }
+            PushString(ExcelCellText(aAdr, bStrict));
+            return;
+        }
+        case svDoubleRef:
+        {
+            // A range gives an array of the same shape, one text per cell.
+            ScRange aRange;
+            PopDoubleRef(aRange);
+            if (nGlobalError != FormulaError::NONE || aRange.aStart.Tab() != aRange.aEnd.Tab())
+            {
+                PushError(nGlobalError != FormulaError::NONE ? nGlobalError : FormulaError::NoValue);
+                return;
+            }
+            SCSIZE nC = aRange.aEnd.Col() - aRange.aStart.Col() + 1;
+            SCSIZE nR = aRange.aEnd.Row() - aRange.aStart.Row() + 1;
+            ScMatrixRef pRes = GetNewMat(nC, nR, /*bEmpty*/ true);
+            if (!pRes)
+            {
+                PushError(FormulaError::MatrixSize);
+                return;
+            }
+            for (SCSIZE c = 0; c < nC; ++c)
+                for (SCSIZE r = 0; r < nR; ++r)
+                    pRes->PutString(mrStrPool.intern(ExcelCellText(
+                        ScAddress(aRange.aStart.Col() + c, aRange.aStart.Row() + r, aRange.aStart.Tab()),
+                        bStrict)), c, r);
+            PushMatrix(pRes);
+            return;
+        }
+        case svString:
+        {
+            OUString aStr = GetString().getString();
+            PushString(bStrict ? lcl_QuoteText(aStr) : aStr);
+            return;
+        }
+        case svMatrix:
+        case svExternalSingleRef:
+        case svExternalDoubleRef:
+        {
+            ScMatrixRef pMat = GetMatrix();
+            if (!pMat || nGlobalError != FormulaError::NONE)
+            {
+                PushError(nGlobalError != FormulaError::NONE ? nGlobalError : FormulaError::NoValue);
+                return;
+            }
+            SCSIZE nC, nR;
+            pMat->GetDimensions(nC, nR);
+            ScMatrixRef pRes = GetNewMat(nC, nR, /*bEmpty*/ true);
+            if (!pRes)
+            {
+                PushError(FormulaError::MatrixSize);
+                return;
+            }
+            for (SCSIZE c = 0; c < nC; ++c)
+                for (SCSIZE r = 0; r < nR; ++r)
+                {
+                    const ScMatrixValue aVal = pMat->Get(c, r);
+                    OUString aText;
+                    if (aVal.nType == ScMatValType::String)
+                        aText = bStrict ? lcl_QuoteText(aVal.aStr.getString()) : aVal.aStr.getString();
+                    else if (aVal.nType == ScMatValType::Boolean)
+                        aText = ExcelLogicalText(aVal.fVal);
+                    else if (aVal.nType == ScMatValType::Value)
+                        aText = aVal.GetError() != FormulaError::NONE
+                                    ? ScGlobal::GetErrorString(aVal.GetError())
+                                    : GetStringFromDouble(aVal.fVal).getString();
+                    pRes->PutString(mrStrPool.intern(aText), c, r);
+                }
+            PushMatrix(pRes);
+            return;
+        }
+        default:
+        {
+            // Empty cell or missing argument.
+            Pop();
+            PushString(OUString());
+            return;
+        }
+    }
+}
