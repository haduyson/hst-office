+msgstr "Mẫu"
+
+#: sc/inc/scfuncs.hrc
+msgctxt "ocREGEXEXTRACT"
+msgid "The regular expression that describes the text to extract."
+msgstr "Biểu thức chính quy mô tả văn bản cần trích xuất."
+
+#: sc/inc/scfuncs.hrc
+msgctxt "ocREGEXEXTRACT"
+msgid "Return mode"
+msgstr "Chế độ trả về"
+
+#: sc/inc/scfuncs.hrc
+msgctxt "ocREGEXEXTRACT"
+msgid "0 or omitted - the first match. 1 - all matches as an array. 2 - the capturing groups of the first match as an array."
+msgstr "0 hoặc bỏ trống - kết quả khớp đầu tiên. 1 - tất cả kết quả khớp dưới dạng mảng. 2 - các nhóm bắt của kết quả khớp đầu tiên dưới dạng mảng."
+
+#: sc/inc/scfuncs.hrc
+msgctxt "ocREGEXEXTRACT"
+msgid "Case sensitivity"
+msgstr "Phân biệt chữ hoa"
+
+#: sc/inc/scfuncs.hrc
+msgctxt "ocREGEXEXTRACT"
+msgid "0 or omitted - case-sensitive. 1 - case-insensitive."
+msgstr "0 hoặc bỏ trống - phân biệt chữ hoa, chữ thường. 1 - không phân biệt."
+
+#: sc/inc/scfuncs.hrc
+msgctxt "ocREGEXREPLACE"
+msgid "Replaces the parts of a text that match a regular expression."
+msgstr "Thay thế các phần của văn bản khớp với biểu thức chính quy."
+
+#: sc/inc/scfuncs.hrc
+msgctxt "ocREGEXREPLACE"
+msgid "Text"
+msgstr "Văn bản"
+
+#: sc/inc/scfuncs.hrc
+msgctxt "ocREGEXREPLACE"
+msgid "The text or a reference to a cell that contains the text to change."
+msgstr "Văn bản hoặc tham chiếu tới ô chứa văn bản cần thay đổi."
+
+#: sc/inc/scfuncs.hrc
+msgctxt "ocREGEXREPLACE"
+msgid "Pattern"
+msgstr "Mẫu"
+
+#: sc/inc/scfuncs.hrc
+msgctxt "ocREGEXREPLACE"
+msgid "The regular expression that describes the text to replace."
+msgstr "Biểu thức chính quy mô tả văn bản cần thay thế."
+
+#: sc/inc/scfuncs.hrc
+msgctxt "ocREGEXREPLACE"
+msgid "Replacement"
+msgstr "Thay bằng"
+
+#: sc/inc/scfuncs.hrc
+msgctxt "ocREGEXREPLACE"
+msgid "The replacement text. $1, $2... insert the capturing groups."
+msgstr "Văn bản thay thế. $1, $2... chèn các nhóm bắt."
+
+#: sc/inc/scfuncs.hrc
+msgctxt "ocREGEXREPLACE"
+msgid "Occurrence"
+msgstr "Lần xuất hiện"
+
+#: sc/inc/scfuncs.hrc
+msgctxt "ocREGEXREPLACE"
+msgid "0 or omitted - replace every match. A positive number replaces that match, a negative number counts from the end."
+msgstr "0 hoặc bỏ trống - thay mọi kết quả khớp. Số dương thay kết quả khớp thứ đó, số âm đếm từ cuối."
+
+#: sc/inc/scfuncs.hrc
+msgctxt "ocREGEXREPLACE"
+msgid "Case sensitivity"
+msgstr "Phân biệt chữ hoa"
+
+#: sc/inc/scfuncs.hrc
+msgctxt "ocREGEXREPLACE"
+msgid "0 or omitted - case-sensitive. 1 - case-insensitive."
+msgstr "0 hoặc bỏ trống - phân biệt chữ hoa, chữ thường. 1 - không phân biệt."
+
+#: sc/inc/scfuncs.hrc
+msgctxt "ocTRIMRANGE"
+msgid "Removes the blank rows and columns at the edges of a range or array."
+msgstr "Loại bỏ các hàng và cột trống ở mép của một vùng hoặc mảng."
+
+#: sc/inc/scfuncs.hrc
+msgctxt "ocTRIMRANGE"
+msgid "Range"
+msgstr "Vùng"
+
+#: sc/inc/scfuncs.hrc
+msgctxt "ocTRIMRANGE"
+msgid "The range or array to trim."
+msgstr "Vùng hoặc mảng cần cắt bớt."
+
+#: sc/inc/scfuncs.hrc
+msgctxt "ocTRIMRANGE"
+msgid "Trim rows"
+msgstr "Cắt hàng"
+
+#: sc/inc/scfuncs.hrc
+msgctxt "ocTRIMRANGE"
+msgid "0 - none. 1 - leading blank rows. 2 - trailing blank rows. 3 or omitted - both."
+msgstr "0 - không cắt. 1 - các hàng trống ở đầu. 2 - các hàng trống ở cuối. 3 hoặc bỏ trống - cả hai."
+
+#: sc/inc/scfuncs.hrc
+msgctxt "ocTRIMRANGE"
+msgid "Trim columns"
+msgstr "Cắt cột"
+
+#: sc/inc/scfuncs.hrc
+msgctxt "ocTRIMRANGE"
+msgid "0 - none. 1 - leading blank columns. 2 - trailing blank columns. 3 or omitted - both."
+msgstr "0 - không cắt. 1 - các cột trống ở đầu. 2 - các cột trống ở cuối. 3 hoặc bỏ trống - cả hai."
+
 #. pDDme
 #: sc/inc/scstyles.hrc:29
