+// CODE and CHAR use the system ANSI code page, as the leading spreadsheet
+// application does. On Windows that is the thread text encoding (GetACP():
+// 1258 with the Vietnamese system locale, 1252 with English). Linux and macOS
+// have no ANSI code page and run UTF-8, so there the Windows code page of the
+// locale setting is used (vi-VN 1258, en-US 1252); the first byte of a UTF-8
+// sequence used before meant nothing to anyone.
+static rtl_TextEncoding lcl_GetAnsiCodePageEncoding()
+{
+#ifdef _WIN32
+    return osl_getThreadTextEncoding();
+#else
+    return utl_getWinTextEncodingFromLangStr(ScGlobal::getLocaleData().getLanguageTag().getBcp47());
+#endif
+}
