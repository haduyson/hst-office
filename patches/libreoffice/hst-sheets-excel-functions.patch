+// REGEXTEST, REGEXEXTRACT and REGEXREPLACE of the leading spreadsheet
+// application, on the ICU regular expression engine that REGEX() uses.
+// case_sensitivity: 0 (default) case-sensitive, 1 case-insensitive.
+// An invalid pattern or option gives #VALUE!, no match in REGEXEXTRACT #N/A.
+
+#include <interpre.hxx>
+#include <scmatrix.hxx>
+
+#include <unicode/regex.h>
+
+#include <memory>
+#include <vector>
+
+using namespace formula;
+
+namespace
+{
+icu::UnicodeString lcl_Icu(const OUString& rStr)
+{
+    return icu::UnicodeString(false, reinterpret_cast<const UChar*>(rStr.getStr()), rStr.getLength());
+}
+
+OUString lcl_Ou(const icu::UnicodeString& rStr)
+{
+    return OUString(reinterpret_cast<const sal_Unicode*>(rStr.getBuffer()), rStr.length());
+}
+
+std::unique_ptr<icu::RegexMatcher> lcl_Matcher(const OUString& rPattern, bool bIgnoreCase,
+                                               const icu::UnicodeString& rText)
+{
+    UErrorCode status = U_ZERO_ERROR;
+    auto pMatcher = std::make_unique<icu::RegexMatcher>(
+        lcl_Icu(rPattern), bIgnoreCase ? UREGEX_CASE_INSENSITIVE : 0, status);
+    if (U_FAILURE(status))
+        return nullptr;
+    // Same guard against pathological patterns as REGEX().
+    pMatcher->setTimeLimit(23 * 1000, status);
+    pMatcher->reset(rText);
+    return U_SUCCESS(status) ? std::move(pMatcher) : nullptr;
+}
+}
+
+bool ScInterpreter::GetRegexCaseOption(sal_uInt8 nParamCount, sal_uInt8 nPos, bool& rIgnoreCase)
+{
+    rIgnoreCase = false;
+    if (nParamCount < nPos)
+        return true;
+    sal_Int32 n = GetInt32WithDefault(0);
+    if (nGlobalError != FormulaError::NONE)
+        return false;
+    if (n < 0 || n > 1)
+    {
+        SetError(FormulaError::NoValue);
+        return false;
+    }
+    rIgnoreCase = (n == 1);
+    return true;
+}
+
+void ScInterpreter::ScRegexTest()
+{
+    sal_uInt8 nParamCount = GetByte();
+    if (!MustHaveParamCount(nParamCount, 2, 3))
+        return;
+    bool bIgnoreCase;
+    if (!GetRegexCaseOption(nParamCount, 3, bIgnoreCase))
+    {
+        PushError(nGlobalError);
+        return;
+    }
+    OUString aPattern = GetString().getString();
+    OUString aText = GetString().getString();
+    if (nGlobalError != FormulaError::NONE)
+    {
+        PushError(nGlobalError);
+        return;
+    }
+    icu::UnicodeString aIcuText(lcl_Icu(aText));
+    auto pMatcher = lcl_Matcher(aPattern, bIgnoreCase, aIcuText);
+    if (!pMatcher)
+    {
+        PushError(FormulaError::NoValue);
+        return;
+    }
+    UErrorCode status = U_ZERO_ERROR;
+    bool bFound = pMatcher->find(status);
+    if (U_FAILURE(status))
+    {
+        PushError(FormulaError::NoValue);
+        return;
+    }
+    nFuncFmtType = SvNumFormatType::LOGICAL;
+    PushInt(bFound ? 1 : 0);
+}
+
+void ScInterpreter::ScRegexExtract()
+{
+    sal_uInt8 nParamCount = GetByte();
+    if (!MustHaveParamCount(nParamCount, 2, 4))
+        return;
+    bool bIgnoreCase;
+    if (!GetRegexCaseOption(nParamCount, 4, bIgnoreCase))
+    {
+        PushError(nGlobalError);
+        return;
+    }
+    // 0 first match (default), 1 all matches, 2 capture groups of the first match.
+    sal_Int32 nMode = (nParamCount >= 3) ? GetInt32WithDefault(0) : 0;
+    OUString aPattern = GetString().getString();
+    OUString aText = GetString().getString();
+    if (nGlobalError != FormulaError::NONE)
+    {
+        PushError(nGlobalError);
+        return;
+    }
+    if (nMode < 0 || nMode > 2)
+    {
+        PushError(FormulaError::NoValue);
+        return;
+    }
+    icu::UnicodeString aIcuText(lcl_Icu(aText));
+    auto pMatcher = lcl_Matcher(aPattern, bIgnoreCase, aIcuText);
+    if (!pMatcher)
+    {
+        PushError(FormulaError::NoValue);
+        return;
+    }
+    UErrorCode status = U_ZERO_ERROR;
+    std::vector<OUString> aParts;
+    while (pMatcher->find(status) && U_SUCCESS(status))
+    {
+        if (nMode == 2)
+        {
+            // Groups that took no part in the match give empty text; a
+            // pattern without groups gives the whole match.
+            sal_Int32 nGroups = pMatcher->groupCount();
+            if (nGroups == 0)
+                aParts.push_back(lcl_Ou(pMatcher->group(status)));
+            for (sal_Int32 i = 1; i <= nGroups && U_SUCCESS(status); ++i)
+                aParts.push_back(pMatcher->start(i, status) < 0 ? OUString()
+                                                                 : lcl_Ou(pMatcher->group(i, status)));
+            break;
+        }
+        aParts.push_back(lcl_Ou(pMatcher->group(status)));
+        if (nMode == 0)
+            break;
+        // An empty match must not loop forever; find() moves on by itself.
+    }
+    if (U_FAILURE(status))
+    {
+        PushError(FormulaError::NoValue);
+        return;
+    }
+    if (aParts.empty())
+    {
+        PushError(FormulaError::NotAvailable);
+        return;
+    }
+    if (nMode == 0)
+    {
+        PushString(aParts[0]);
+        return;
+    }
+    // All matches and capture groups are returned as one row.
+    ScMatrixRef pRes = GetNewMat(aParts.size(), 1, /*bEmpty*/ true);
+    if (!pRes)
+    {
+        PushError(FormulaError::MatrixSize);
+        return;
+    }
+    for (size_t i = 0; i < aParts.size(); ++i)
+        pRes->PutString(mrStrPool.intern(aParts[i]), i, 0);
+    PushMatrix(pRes);
+}
+
+void ScInterpreter::ScRegexReplace()
+{
+    sal_uInt8 nParamCount = GetByte();
+    if (!MustHaveParamCount(nParamCount, 3, 5))
+        return;
+    bool bIgnoreCase;
+    if (!GetRegexCaseOption(nParamCount, 5, bIgnoreCase))
+    {
+        PushError(nGlobalError);
+        return;
+    }
+    // 0 replaces every match (default), n the n-th, -n the n-th from the end.
+    double fOccurrence = (nParamCount >= 4) ? GetDoubleWithDefault(0.0) : 0.0;
+    OUString aReplacement = GetString().getString();
+    OUString aPattern = GetString().getString();
+    OUString aText = GetString().getString();
+    if (nGlobalError != FormulaError::NONE)
+    {
+        PushError(nGlobalError);
+        return;
+    }
+    if (fOccurrence > SAL_MAX_INT32 || fOccurrence < SAL_MIN_INT32 + 1)
+    {
+        PushError(FormulaError::NoValue);
+        return;
+    }
+    sal_Int32 nOccurrence = static_cast<sal_Int32>(fOccurrence);
+    icu::UnicodeString aIcuText(lcl_Icu(aText));
+    auto pMatcher = lcl_Matcher(aPattern, bIgnoreCase, aIcuText);
+    if (!pMatcher)
+    {
+        PushError(FormulaError::NoValue);
+        return;
+    }
+    UErrorCode status = U_ZERO_ERROR;
+    icu::UnicodeString aIcuReplacement(lcl_Icu(aReplacement));
+    icu::UnicodeString aResult;
+    if (nOccurrence == 0)
+        aResult = pMatcher->replaceAll(aIcuReplacement, status);
+    else
+    {
+        if (nOccurrence < 0)
+        {
+            sal_Int32 nCount = 0;
+            while (pMatcher->find(status) && U_SUCCESS(status))
+                ++nCount;
+            nOccurrence = nCount + nOccurrence + 1;
+            pMatcher->reset();
+        }
+        sal_Int32 nCount = 0;
+        bool bReplaced = false;
+        while (nOccurrence > 0 && pMatcher->find(status) && U_SUCCESS(status))
+        {
+            if (++nCount == nOccurrence)
+            {
+                pMatcher->appendReplacement(aResult, aIcuReplacement, status);
+                bReplaced = true;
+                break;
+            }
+        }
+        if (bReplaced)
+            pMatcher->appendTail(aResult);
+        else
+            aResult = aIcuText;  // no such occurrence: text unchanged
+    }
+    if (U_FAILURE(status))
+    {
+        PushError(FormulaError::NoValue);
+        return;
+    }
+    PushString(lcl_Ou(aResult));
+}
