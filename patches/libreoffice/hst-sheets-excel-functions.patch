+void ScInterpreter::ScPhonetic()
+{
+    if (!MustHaveParamCount(GetByte(), 1))
+        return;
+    // No phonetic guide text is stored, so the result is the text of the
+    // reference's first cell, as the leading application returns when a
+    // cell has no furigana. A number gives an empty string.
+    ScAddress aAdr;
+    switch (GetStackType())
+    {
+        case svSingleRef:
+            PopSingleRef(aAdr);
+        break;
+        case svDoubleRef:
+        {
+            ScRange aRange;
+            PopDoubleRef(aRange);
+            aAdr = aRange.aStart;
+        }
+        break;
+        default:
+            Pop();
+            PushError(FormulaError::NotAvailable);
+            return;
+    }
+    if (nGlobalError != FormulaError::NONE)
+    {
+        PushError(nGlobalError);
+        return;
+    }
+    ScRefCellValue aCell(mrDoc, aAdr);
+    if (aCell.hasError())
+    {
+        PushError(aCell.getFormula()->GetErrCode());
+        return;
+    }
+    svl::SharedString aStr;
+    if (aCell.hasString())
+        GetCellString(aStr, aCell);
+    PushString(aStr.getString());
+}
