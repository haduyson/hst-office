+
+OUString ScInterpreter::ExcelLogicalText(double fValue)
+{
+    const sal_uInt32 nKey = mrContext.NFGetStandardFormat(SvNumFormatType::LOGICAL, ScGlobal::eLnge);
+    OUString aString;
+    const Color* pColor = nullptr;
+    mrContext.NFGetOutputString(fValue, nKey, aString, &pColor);
+    return aString;
+}
+
+OUString ScInterpreter::ExcelCellText(const ScAddress& rPos, bool bStrict)
+{
+    ScRefCellValue aCell(mrDoc, rPos);
+    if (aCell.isEmpty())
+        return OUString();
+    if (aCell.hasError())
+        return ScGlobal::GetErrorString(aCell.getFormula()->GetErrCode());
+    if (aCell.hasNumeric())
+    {
+        SvNumFormatType eType = (aCell.getType() == CELLTYPE_FORMULA)
+            ? aCell.getFormula()->GetFormatType()
+            : mrContext.NFGetType(mrDoc.GetNumberFormat(mrContext, rPos));
+        if (eType == SvNumFormatType::LOGICAL)
+            return ExcelLogicalText(aCell.getValue());
+        return GetStringFromDouble(aCell.getValue()).getString();
+    }
+    svl::SharedString aStr;
+    GetCellString(aStr, aCell);
+    return bStrict ? lcl_QuoteText(aStr.getString()) : aStr.getString();
+}
