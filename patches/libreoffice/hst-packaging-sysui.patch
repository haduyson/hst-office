-  for i in `cd "${ICON_SOURCE_DIR}"; find ${ICON_THEMES:-hicolor/???x??? hicolor/??x??} -name "*.png"; find hicolor/scalable/apps -name "*.svg"`
+  if test -n "${HST_ICON_DIR}"; then
+    icon_list=`cd "${ICON_SOURCE_DIR}"; find ${ICON_THEMES:-hicolor/???x??? hicolor/??x??} -name "*.png" | grep -v '/apps/'`
+  else
+    icon_list=`cd "${ICON_SOURCE_DIR}"; find ${ICON_THEMES:-hicolor/???x??? hicolor/??x??} -name "*.png"; find hicolor/scalable/apps -name "*.svg"`
+  fi
+  for i in ${icon_list}
   do
     targetdir=${DESTDIR}/${KDEMAINDIR}/share/icons/`dirname ${i}`
     mkdir -p "${targetdir}"
@@ -29,6 +36,26 @@
   done
   unset targetdir destfile
 
+  if test -n "${HST_ICON_DIR}"; then
+    for map in writer:writer calc:sheets impress:slides draw:draw base:base math:math startcenter:office main:office chart:office; do
+      app=${map%%:*}; brand=${map##*:}
+      for size in 16 24 32 48 64 128 256 512; do
+        src="${HST_ICON_DIR}/hst-${brand}-${size}.png"
