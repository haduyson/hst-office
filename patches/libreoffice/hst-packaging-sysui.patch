+      targetdir=${DESTDIR}/${KDEMAINDIR}/share/icons/hicolor/scalable/apps
+      mkdir -p "${targetdir}"
+      cp "${src}" "${targetdir}/${ICON_PREFIX:-}${ICON_PREFIX:+-}${app}.svg"
+      chmod 0644 "${targetdir}/${ICON_PREFIX:-}${ICON_PREFIX:+-}${app}.svg"
+    done
+    unset map app brand size src targetdir
+  fi
 fi
 
