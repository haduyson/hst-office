+/** HST Office: an action lock on the viewer's frame for as long as a print job (its dialog
+    included) runs. The job is asynchronous and reads the viewer's document and parent window; a
+    close() of the frame meanwhile (from another thread: UNO automation) disposed both under the
+    running print dialog, and the print code then wrote through a destroyed window (Windows r1-auto
+    W12, run 42963658080: main thread PrintJobAsync -> Printer::ImplPrintJob, access violation
+    after the dialog). A locked frame refuses close() with a CloseVetoException; with ownership
+    delivered it closes itself once the last lock is gone. The lock is released from a user event,
+    after the print code has unwound, so that close does not run inside it. */
+class FramePrintLock
+{
+public:
+    explicit FramePrintLock(const uno::Reference<frame::XFrame>& xFrame)
+        : m_xLock(xFrame, uno::UNO_QUERY)
+    {
+        if (m_xLock.is())
+            m_xLock->addActionLock();
+    }
+
+    ~FramePrintLock()
+    {
+        if (m_xLock.is())
+            Application::PostUserEvent(LINK(nullptr, FramePrintLock, Release),
+                                       new uno::Reference<document::XActionLockable>(m_xLock));
+    }
+
+private:
+    DECL_STATIC_LINK(FramePrintLock, Release, void*, void);
+
+    uno::Reference<document::XActionLockable> m_xLock;
+};
+
+IMPL_STATIC_LINK(FramePrintLock, Release, void*, pLock, void)
+{
+    std::unique_ptr<uno::Reference<document::XActionLockable>> xLock(
+        static_cast<uno::Reference<document::XActionLockable>*>(pLock));
+    try
+    {
+        (*xLock)->removeActionLock(); // a close() refused meanwhile happens now
+    }
+    catch (const uno::Exception&)
+    {
+    }
+}
