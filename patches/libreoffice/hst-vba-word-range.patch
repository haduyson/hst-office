+// HST: all the paragraphs the range touches
+uno::Any SAL_CALL
+SwVbaRange::Paragraphs( const uno::Any& rIndex )
+{
+    uno::Reference< XCollection > xCol( new SwVbaParagraphs( this, mxContext, mxTextDocument, getXTextRange() ) );
+    return rIndex.hasValue() ? xCol->Item( rIndex, uno::Any() ) : uno::Any( xCol );
+}
+
+void SAL_CALL
+SwVbaRange::Collapse( const uno::Any& rDirection )
+{
+    sal_Int32 nDirection = word::WdCollapseDirection::wdCollapseStart;
+    rDirection >>= nDirection;
+    if( nDirection == word::WdCollapseDirection::wdCollapseEnd )
+        mxTextCursor->collapseToEnd();
+    else
+        mxTextCursor->collapseToStart();
+}
+
+uno::Reference< word::XRange > SAL_CALL
+SwVbaRange::getDuplicate()
+{
+    return new SwVbaRange( mxParent, mxContext, mxTextDocument, mxTextCursor->getStart(), mxTextCursor->getEnd(), mxText );
+}
+
+void SAL_CALL
+SwVbaRange::SetRange( ::sal_Int32 nStart, ::sal_Int32 nEnd )
+{
+    setStart( nStart );
+    setEnd( nEnd );
+}
+
+sal_Int32 SwVbaRange::moveBound( bool bEnd, const uno::Any& rUnit, const uno::Any& rCount )
+{
+    sal_Int32 nUnit = word::WdUnits::wdCharacter, nCount = 1, nMoved = 0;
+    rUnit >>= nUnit;
+    rCount >>= nCount;
+    uno::Reference< text::XTextCursor > xCursor = mxText->createTextCursorByRange( bEnd ? mxTextCursor->getEnd() : mxTextCursor->getStart() );
+    uno::Reference< text::XWordCursor > xWord( xCursor, uno::UNO_QUERY_THROW );
+    uno::Reference< text::XSentenceCursor > xSentence( xCursor, uno::UNO_QUERY_THROW );
+    uno::Reference< text::XParagraphCursor > xParagraph( xCursor, uno::UNO_QUERY_THROW );
+    const bool bForward = nCount > 0;
+    for( sal_Int32 i = 0, n = bForward ? nCount : -nCount; i < n; ++i )
+    {
+        bool bDone = false;
+        switch( nUnit )
+        {
+            case word::WdUnits::wdWord:
+                bDone = bForward ? xWord->gotoNextWord( false ) : xWord->gotoPreviousWord( false );
+                break;
+            case word::WdUnits::wdSentence:
+                bDone = bForward ? xSentence->gotoNextSentence( false ) : xSentence->gotoPreviousSentence( false );
+                break;
+            case word::WdUnits::wdParagraph:
+                bDone = bForward ? xParagraph->gotoNextParagraph( false ) : xParagraph->gotoPreviousParagraph( false );
+                break;
+            case word::WdUnits::wdStory:
+                if( bForward )
+                    xCursor->gotoEnd( false );
+                else
+                    xCursor->gotoStart( false );
+                break;
+            default:
+                bDone = bForward ? xCursor->goRight( 1, false ) : xCursor->goLeft( 1, false );
+        }
+        if( !bDone )
+            break;
+        ++nMoved;
+    }
+    uno::Reference< text::XTextRange > xStart = bEnd ? mxTextCursor->getStart() : xCursor->getStart();
+    uno::Reference< text::XTextRange > xEnd = bEnd ? xCursor->getStart() : mxTextCursor->getEnd();
+    // the ends may not cross: the other end follows
+    uno::Reference< text::XTextRangeCompare > xCompare( mxText, uno::UNO_QUERY_THROW );
+    if( xCompare->compareRegionStarts( xStart, xEnd ) < 0 )
+    {
+        if( bEnd )
+            xStart = xEnd;
+        else
+            xEnd = xStart;
+    }
+    mxTextCursor->gotoRange( xStart, false );
+    mxTextCursor->gotoRange( xEnd, true );
+    return bForward ? nMoved : -nMoved;
+}
+
+::sal_Int32 SAL_CALL
+SwVbaRange::MoveStart( const uno::Any& rUnit, const uno::Any& rCount )
+{
+    return moveBound( false, rUnit, rCount );
+}
+
+::sal_Int32 SAL_CALL
+SwVbaRange::MoveEnd( const uno::Any& rUnit, const uno::Any& rCount )
+{
+    return moveBound( true, rUnit, rCount );
+}
