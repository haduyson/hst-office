+namespace oox::xls
+{
+/** Groups the shared formula cells of one .xlsx sheet while they are created, so that each cell drops its own copy
+    of the token array at once instead of at the end of the import.
+
+    The import creates every shared formula cell with a copy of the token array and only groups the cells in
+    ScColumn::RegroupFormulaCells after the whole workbook is read, so a sheet of filled-down formulas held one
+    token array per cell at the peak of loading (about 400 MB per 3.5 million formula cells). This is the same idea
+    the import already applies to plain formulas (applyCellFormulas puts a cell into the group of the equal cell
+    right above it).
+
+    The final groups and their codes are the ones RegroupFormulaCells builds from ungrouped cells. A cell is joined
+    to the cell right above it only when RegroupFormulaCells would join them (CompareByTokenArray) and both are
+    equal in every other respect it ignores: the recalc mode of the code and the dirty state. Regrouping keeps the
+    groups made here and merges equal neighbours; such a merge always keeps the upper group's code, as the
+    one-by-one path does. The only step that would keep a lower code is "a single cell followed by a group", so a
+    group is never started below a cell that could end up as that single cell: below an equal formula cell that the
+    cell did not join, or below a position that a plain or array formula of the sheet fills later. When a cell is
+    not joined it stays on the old path.
+
+    Cells are created in row order, so the cell above is always created first and is the last cell of its group. */
+class HstSharedFormulaJoiner
+{
+public:
+    HstSharedFormulaJoiner(ScDocument& rDoc,
+                           const std::vector<FormulaBuffer::TokenAddressItem>* pCellFormulas,
+                           const std::vector<FormulaBuffer::TokenRangeAddressItem>* pArrayFormulas)
+        : mrDoc(rDoc)
+        // Array formulas fill whole ranges later; keep such sheets on the old path entirely. The environment
+        // variable keeps every sheet on the old path, so a test can compare both paths on the same file.
+        , mbEnabled((!pArrayFormulas || pArrayFormulas->empty())
+                    && !std::getenv("HST_SC_XLSX_SHARED_FORMULA_GROUP_AT_END"))
+    {
+        if (!mbEnabled || !pCellFormulas)
+            return;
+        maLaterCells.reserve(pCellFormulas->size());
+        for (const FormulaBuffer::TokenAddressItem& rItem : *pCellFormulas)
+            maLaterCells.push_back(key(rItem.maAddress));
+        std::sort(maLaterCells.begin(), maLaterCells.end());
+    }
+
+    HstSharedFormulaJoiner(const HstSharedFormulaJoiner&) = delete;
+    HstSharedFormulaJoiner& operator=(const HstSharedFormulaJoiner&) = delete;
+
+    /** Joins rCell (fully set up: cached result, dirty state, recalc mode) to the formula cell above when allowed. */
+    void join(ScFormulaCell& rCell)
+    {
+        const ScAddress& rPos = rCell.aPos;
+        if (!mbEnabled || rPos.Row() == 0 || rCell.GetCellGroup())
+            return;
+        ScFormulaCell* pAbove = mrDoc.GetFormulaCell(ScAddress(rPos.Col(), rPos.Row() - 1, rPos.Tab()));
+        if (!pAbove || !sameState(*pAbove, rCell))
+            return;
+        const ScFormulaCell::CompareState eState = pAbove->CompareByTokenArray(rCell);
+        if (eState == ScFormulaCell::NotEqual)
+            return;
+        if (ScFormulaCellGroupRef xGroup = pAbove->GetCellGroup())
+        {
+            rCell.SetCellGroup(xGroup);
+            ++xGroup->mnLength;
+            return;
+        }
+        // pAbove would become the top of a new group: only when nothing above it can join it later.
+        if (rPos.Row() >= 2)
+        {
+            const ScAddress aTopAbove(rPos.Col(), rPos.Row() - 2, rPos.Tab());
+            if (std::binary_search(maLaterCells.begin(), maLaterCells.end(), key(aTopAbove)))
+                return;
+            const ScFormulaCell* pTopAbove = mrDoc.GetFormulaCell(aTopAbove);
+            if (pTopAbove && pTopAbove->CompareByTokenArray(*pAbove) != ScFormulaCell::NotEqual)
+                return;
+        }
+        if (ScFormulaCellGroupRef xNew = pAbove->CreateCellGroup(2, eState == ScFormulaCell::EqualInvariant))
+            rCell.SetCellGroup(xNew);
+    }
+
+    /** Calls join() when the loop body that sets the cell up is left, on every path. */
+    class Guard
+    {
+    public:
+        Guard(HstSharedFormulaJoiner* pJoiner, ScFormulaCell& rCell)
+            : mpJoiner(pJoiner)
+            , mrCell(rCell)
+        {
+        }
+        Guard(const Guard&) = delete;
+        Guard& operator=(const Guard&) = delete;
+        ~Guard()
+        {
+            if (mpJoiner)
+                mpJoiner->join(mrCell);
+        }
+
+    private:
+        HstSharedFormulaJoiner* mpJoiner;
+        ScFormulaCell& mrCell;
+    };
+
+private:
+    static sal_uInt64 key(const ScAddress& rPos)
+    {
+        return (static_cast<sal_uInt64>(static_cast<sal_uInt16>(rPos.Tab())) << 48)
+               | (static_cast<sal_uInt64>(static_cast<sal_uInt16>(rPos.Col())) << 32)
+               | static_cast<sal_uInt32>(rPos.Row());
+    }
+
+    static bool sameState(const ScFormulaCell& rA, const ScFormulaCell& rB)
+    {
+        return rA.GetCode()->GetRecalcMode() == rB.GetCode()->GetRecalcMode()
+               && rA.GetDirty() == rB.GetDirty();
+    }
+
+    ScDocument& mrDoc;
+    bool mbEnabled;
+    std::vector<sal_uInt64> maLaterCells;
+};
+}
