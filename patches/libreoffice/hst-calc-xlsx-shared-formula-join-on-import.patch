+CPPUNIT_TEST_FIXTURE(ScFiltersTest5, testXlsxSharedFormulaGroupsAsTheyAreCreated)
+{
+    // The import groups shared formula cells while it creates them. The groups, their codes (recall mode), the
+    // dirty states and the results must be exactly those of grouping all cells at the end of the import (the
+    // environment variable selects that path). Cached results differ from the calculated ones (100 * row), so a
+    // cell recalculated on one path only shows up. Column A holds 1..10.
+    //  B: a plain formula with the same tokens right above a shared run, with a cached result
+    //  C: the same without a cached result on the plain formula
+    //  D: two shared runs with the same tokens meeting (si 2 and 3), then a run with other tokens (si 4)
+    //  E: a shared run interrupted by a value cell
+    //  F: a shared run whose top and a middle cell have no cached result (recalculated on load)
+    //  G: a plain formula with the same tokens right below a shared run
+    //  H: a shared run along a row (H1:I1 is not in the checked columns; H2:H4 filled down)
+    OStringBuffer aRows;
+    for (int nRow = 1; nRow <= 10; ++nRow)
+    {
+        const OString r = OString::number(nRow);
+        const OString v = "<v>" + OString::number(100 * nRow) + "</v>";
+        aRows.append("<row r=\"" + r + "\"><c r=\"A" + r + "\"><v>" + r + "</v></c>");
+        // B
+        if (nRow == 1)
+            aRows.append("<c r=\"B1\"><f>A1*2</f>" + v + "</c>");
+        else if (nRow <= 6)
+            aRows.append("<c r=\"B" + r + "\"><f t=\"shared\" si=\"0\""
+                         + (nRow == 2 ? OString(" ref=\"B2:B6\">A2*2</f>") : OString("/>")) + v + "</c>");
+        // C
+        if (nRow == 1)
+            aRows.append("<c r=\"C1\"><f>A1*2</f></c>");
+        else if (nRow <= 6)
+            aRows.append("<c r=\"C" + r + "\"><f t=\"shared\" si=\"1\""
+                         + (nRow == 2 ? OString(" ref=\"C2:C6\">A2*2</f>") : OString("/>")) + v + "</c>");
+        // D
+        if (nRow <= 3)
+            aRows.append("<c r=\"D" + r + "\"><f t=\"shared\" si=\"2\""
+                         + (nRow == 1 ? OString(" ref=\"D1:D3\">A1*2</f>") : OString("/>")) + v + "</c>");
+        else if (nRow <= 6)
+            aRows.append("<c r=\"D" + r + "\"><f t=\"shared\" si=\"3\""
+                         + (nRow == 4 ? OString(" ref=\"D4:D6\">A4*2</f>") : OString("/>")) + v + "</c>");
+        else if (nRow <= 8)
+            aRows.append("<c r=\"D" + r + "\"><f t=\"shared\" si=\"4\""
+                         + (nRow == 7 ? OString(" ref=\"D7:D8\">A7*3</f>") : OString("/>")) + v + "</c>");
+        // E
+        if (nRow == 4)
+            aRows.append("<c r=\"E4\"><v>99</v></c>");
+        else if (nRow <= 7)
+            aRows.append("<c r=\"E" + r + "\"><f t=\"shared\" si=\"5\""
+                         + (nRow == 1 ? OString(" ref=\"E1:E7\">A1*2</f>") : OString("/>")) + v + "</c>");
+        // F
+        if (nRow <= 6)
+            aRows.append("<c r=\"F" + r + "\"><f t=\"shared\" si=\"6\""
+                         + (nRow == 1 ? OString(" ref=\"F1:F6\">A1*2</f>") : OString("/>"))
+                         + ((nRow == 1 || nRow == 4) ? OString() : v) + "</c>");
+        // G
+        if (nRow <= 3)
+            aRows.append("<c r=\"G" + r + "\"><f t=\"shared\" si=\"7\""
+                         + (nRow == 1 ? OString(" ref=\"G1:G3\">A1*2</f>") : OString("/>")) + v + "</c>");
+        else if (nRow == 4)
+            aRows.append("<c r=\"G4\"><f>A4*2</f>" + v + "</c>");
+        // H, I: a shared formula along row 1 (H1:I1), then H2:H4 filled down from H2
+        if (nRow == 1)
+            aRows.append("<c r=\"H1\"><f t=\"shared\" si=\"8\" ref=\"H1:I1\">A1*2</f>" + v
+                         + "</c><c r=\"I1\"><f t=\"shared\" si=\"8\"/>" + v + "</c>");
+        else if (nRow <= 4)
+            aRows.append("<c r=\"H" + r + "\"><f t=\"shared\" si=\"9\""
+                         + (nRow == 2 ? OString(" ref=\"H2:H4\">A2*2</f>") : OString("/>")) + v + "</c>");
+        aRows.append("</row>");
+    }
+    writeOneSheetXlsx(maTempFile.GetURL(), aRows.makeStringAndClear());
+
+    const auto load = [this]() {
+        loadFromURL(maTempFile.GetURL(),
+                    { comphelper::makePropertyValue(u"FilterName"_ustr, u"Calc Office Open XML"_ustr) });
+        return getScDoc();
+    };
+
+    // Grouping at the end of the import only (the path before this change).
+    osl_setEnvironment(u"HST_SC_XLSX_SHARED_FORMULA_GROUP_AT_END"_ustr.pData, u"1"_ustr.pData);
+    ScDocument* pDoc = load();
+    const OUString aOldLoaded = formulaGroupState(*pDoc, false);
+    const OUString aOldRecalc = formulaGroupState(*pDoc, true);
+    osl_clearEnvironment(u"HST_SC_XLSX_SHARED_FORMULA_GROUP_AT_END"_ustr.pData);
+    dispose();
+
+    pDoc = load();
+    CPPUNIT_ASSERT_EQUAL(aOldLoaded, formulaGroupState(*pDoc, false));
+    CPPUNIT_ASSERT_EQUAL(aOldRecalc, formulaGroupState(*pDoc, true));
+
+    // A clean filled-down run is one group, and the two runs of D with the same tokens are merged.
+    const ScFormulaCell* pD5 = pDoc->GetFormulaCell(ScAddress(3, 4, 0));
+    CPPUNIT_ASSERT(pD5);
+    CPPUNIT_ASSERT_EQUAL(SCROW(0), pD5->GetSharedTopRow());
+    CPPUNIT_ASSERT_EQUAL(SCROW(6), pD5->GetSharedLength());
+    // Cached results are kept where they exist.
+    CPPUNIT_ASSERT_EQUAL(500.0, pDoc->GetValue(ScAddress(3, 4, 0)));
+}
