+#pragma once
+
+#include <document.hxx>
+#include <formulacell.hxx>
+
+namespace oox::xls
+{
+/** Joins a shared formula cell of an .xlsx, once it is fully set up, to the formula cell right above it, exactly as
+    ScColumn::RegroupFormulaCells joins them at the end of the import (GroupFormulaCells in column3.cxx): same token
+    array comparison, same group (the upper cell's group, or a new group of two whose code is the upper cell's).
+
+    The import creates every shared formula cell with its own copy of the token array and only groups them at the
+    end, so a sheet of filled-down formulas held one token array per cell at the peak of loading (about 400 MB per
+    3.5 million formula cells). Joining while the cells are created in row order frees each copy at once. The final
+    groups are the same: RegroupFormulaCells keeps existing groups and merges equal neighbours as before.
+
+    Used as a scope guard so it runs after the cell's cached result, dirty state and recalc mode are set, on every
+    path through the loop body. */
+class HstJoinFormulaCellAbove
+{
+public:
+    HstJoinFormulaCellAbove(ScDocument& rDoc, ScFormulaCell& rCell)
+        : mrDoc(rDoc)
+        , mrCell(rCell)
+    {
+    }
+
+    HstJoinFormulaCellAbove(const HstJoinFormulaCellAbove&) = delete;
+    HstJoinFormulaCellAbove& operator=(const HstJoinFormulaCellAbove&) = delete;
+
+    ~HstJoinFormulaCellAbove()
+    {
+        const ScAddress& rPos = mrCell.aPos;
+        if (rPos.Row() == 0 || mrCell.GetCellGroup())
+            return;
+        ScFormulaCell* pAbove = mrDoc.GetFormulaCell(ScAddress(rPos.Col(), rPos.Row() - 1, rPos.Tab()));
+        if (!pAbove)
+            return;
+        const ScFormulaCell::CompareState eState = pAbove->CompareByTokenArray(mrCell);
+        if (eState == ScFormulaCell::NotEqual)
+            return;
+        if (ScFormulaCellGroupRef xGroup = pAbove->GetCellGroup())
+        {
+            // The cell above is the last one of its group (cells are created top to bottom): append this one.
+            mrCell.SetCellGroup(xGroup);
+            ++xGroup->mnLength;
+        }
+        else
+        {
+            ScFormulaCellGroupRef xNew
+                = pAbove->CreateCellGroup(2, eState == ScFormulaCell::EqualInvariant);
+            if (xNew)
+                mrCell.SetCellGroup(xNew);
+        }
+    }
+
+private:
+    ScDocument& mrDoc;
+    ScFormulaCell& mrCell;
+};
+}
