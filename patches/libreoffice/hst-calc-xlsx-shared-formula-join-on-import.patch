+/// Everything about the formula cells of B1:H10 that grouping can change, as text, one cell per line.
+OUString formulaGroupState(ScDocument& rDoc, bool bAfterHardRecalc)
+{
+    if (bAfterHardRecalc)
+        rDoc.CalcAll();
+    OUStringBuffer aBuf;
+    for (SCCOL nCol = 1; nCol <= 7; ++nCol)
+        for (SCROW nRow = 0; nRow < 10; ++nRow)
+        {
+            const ScAddress aPos(nCol, nRow, 0);
+            const ScFormulaCell* pCell = rDoc.GetFormulaCell(aPos);
+            if (!pCell)
+                continue;
+            const ScFormulaCell* pTop
+                = pCell->GetSharedLength() > 0 ? rDoc.GetFormulaCell(ScAddress(nCol, pCell->GetSharedTopRow(), 0)) : pCell;
+            aBuf.append(aPos.Format(ScRefFlags::VALID) + " top=" + OUString::number(pCell->GetSharedTopRow())
+                        + " len=" + OUString::number(pCell->GetSharedLength()) + " mode="
+                        + OUString::number(static_cast<int>(pCell->GetCode()->GetRecalcMode()))
+                        + " dirty=" + OUString::number(int(pCell->GetDirty()))
+                        + " sharedcode=" + OUString::number(int(pTop && pTop->GetCode() == pCell->GetCode()))
+                        + " formula=" + rDoc.GetFormula(nCol, nRow, 0)
+                        + " value=" + OUString::number(rDoc.GetValue(aPos)) + "\n");
+        }
+    return aBuf.makeStringAndClear();
+}
+}
