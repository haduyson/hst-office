+constexpr sal_Int32 MAX_IMAGE_BYTES = 300 * 1024; // data-layer limit per image
+constexpr sal_Int32 MAX_MANIFEST_BYTES = 512 * 1024;
+constexpr int FADE_STEPS = 10;
+constexpr OUString EXTENSION_DIR
+    = u"$BRAND_BASE_DIR/" LIBO_SHARE_FOLDER "/extensions/hst-vietnamese-tools/"_ustr;
+}
+
+/** One rotation slot as delivered to the main thread. */
+struct Data
+{
+    OUString aId, aName, aTagline, aUrl;
+    std::vector<sal_uInt8> aImage;
+    sal_Int32 nRotateSeconds = 10;
+    sal_Int32 nSlot = 0;
+    int nScale = 1;
+    bool bOk = false;
+    bool bLast = true; // the worker posts nothing after this result
+};
+
+namespace
+{
+OUString fromUtf8(const std::string& rText)
+{
+    return OStringToOUString(rText, RTL_TEXTENCODING_UTF8);
+}
+
+bool readFile(const OUString& rUrl, std::string& rOut, sal_Int32 nLimit)
+{
+    osl::File aFile(rUrl);
+    if (aFile.open(osl_File_OpenFlag_Read) != osl::FileBase::E_None)
+        return false;
+    sal_uInt64 nSize = 0;
+    if (aFile.getSize(nSize) != osl::FileBase::E_None || nSize == 0
+        || nSize > static_cast<sal_uInt64>(nLimit))
+        return false;
+    rOut.resize(nSize);
+    sal_uInt64 nRead = 0;
+    return aFile.read(rOut.data(), nSize, nRead) == osl::FileBase::E_None && nRead == nSize;
+}
+
+/** The selected slot from the JSON of org.hst.office.BannerFeed (docs/BANNERS.md). */
+bool parseService(const OUString& rJson, Data& rData)
+{
+    std::stringstream aStream(std::string(OUStringToOString(rJson, RTL_TEXTENCODING_UTF8)));
+    boost::property_tree::ptree aTree;
+    boost::property_tree::read_json(aStream, aTree);
+    rData.nRotateSeconds = aTree.get<sal_Int32>("rotateSeconds", 10);
+    rData.nSlot = aTree.get<sal_Int32>("slot", 0);
+    const auto& rItems = aTree.get_child("items");
+    if (rItems.empty())
+        return false;
+    const auto& rItem = rItems.front().second;
+    rData.aId = fromUtf8(rItem.get<std::string>("id"));
+    rData.aName = fromUtf8(rItem.get<std::string>("name"));
+    rData.aTagline = fromUtf8(rItem.get<std::string>("tagline"));
+    rData.aUrl = fromUtf8(rItem.get<std::string>("click_url_with_utm"));
+    uno::Sequence<sal_Int8> aBytes;
+    comphelper::Base64::decode(aBytes, fromUtf8(rItem.get<std::string>("image_base64")));
+    if (aBytes.getLength() == 0 || aBytes.getLength() > MAX_IMAGE_BYTES)
+        return false;
+    rData.aImage.assign(aBytes.begin(), aBytes.end());
+    return rData.aUrl.startsWith("https://");
+}
+
+bool fromService(sal_Int32 nSlot, int nScale, Data& rData)
+{
+    try
+    {
+        const uno::Reference<uno::XComponentContext>& xContext
+            = comphelper::getProcessComponentContext();
+        uno::Reference<task::XJob> xFeed(xContext->getServiceManager()->createInstanceWithContext(
+                                             u"org.hst.office.BannerFeed"_ustr, xContext),
+                                         uno::UNO_QUERY);
+        if (!xFeed.is())
+            return false;
+        uno::Sequence<beans::NamedValue> aArgs{
+            { u"Scale"_ustr, uno::Any(static_cast<double>(nScale)) },
+            { u"Slot"_ustr, uno::Any(nSlot) } };
+        OUString aJson;
+        if (!(xFeed->execute(aArgs) >>= aJson) || aJson.isEmpty())
+            return false;
+        return parseService(aJson, rData);
+    }
+    catch (...)
+    {
+        return false; // service missing or failing: installed defaults
+    }
+}
+
+/** Click URL as the data layer builds it: the query is replaced by the shared UTM block. */
+OUString clickUrl(std::u16string_view aUrl, const OUString& rSource, const OUString& rCampaign)
+{
+    const size_t nCut = aUrl.find_first_of(u"?#");
+    return OUString::Concat(aUrl.substr(0, nCut)) + "?utm_source=" + rSource
+           + "&utm_medium=banner&utm_campaign=" + rCampaign;
+}
+
+/** Installed defaults straight from the bundled extension (service unavailable). */
+bool fromBundled(sal_Int32 nSlot, int nScale, Data& rData)
+{
+    try
+    {
+        OUString aDir(EXTENSION_DIR);
+        rtl::Bootstrap::expandMacros(aDir);
+        std::string aManifest, aSolutions;
+        if (!readFile(aDir + "data/banners.json", aManifest, MAX_MANIFEST_BYTES)
+            || !readFile(aDir + "data/solutions.json", aSolutions, MAX_MANIFEST_BYTES))
+            return false;
+        boost::property_tree::ptree aTree, aUtm;
+        std::stringstream aManifestStream(aManifest), aSolutionsStream(aSolutions);
+        boost::property_tree::read_json(aManifestStream, aTree);
+        boost::property_tree::read_json(aSolutionsStream, aUtm);
+        std::vector<const boost::property_tree::ptree*> aItems;
+        for (const auto& rChild : aTree.get_child("items"))
+            aItems.push_back(&rChild.second);
+        if (aItems.empty())
+            return false;
+        std::stable_sort(aItems.begin(), aItems.end(), [](const auto* a, const auto* b) {
+            const int nA = a->template get<int>("order", 0), nB = b->template get<int>("order", 0);
+            return nA != nB ? nA < nB
+                            : a->template get<std::string>("id") < b->template get<std::string>("id");
+        });
+        rData.nSlot = nSlot >= 0 ? nSlot % static_cast<sal_Int32>(aItems.size()) : 0;
+        const auto& rItem = *aItems[rData.nSlot];
+        const std::string aPath
+            = rItem.get<std::string>("image." + std::to_string(nScale) + "x.url");
+        if (aPath.rfind("banners/", 0) != 0 || aPath.find("..") != std::string::npos)
+            return false;
+        std::string aImage;
+        if (!readFile(aDir + fromUtf8(aPath), aImage, MAX_IMAGE_BYTES))
+            return false;
+        rData.aImage.assign(aImage.begin(), aImage.end());
+        rData.nRotateSeconds = aTree.get<sal_Int32>("rotateSeconds", 10);
+        rData.aId = fromUtf8(rItem.get<std::string>("id"));
+        rData.aName = fromUtf8(rItem.get<std::string>("name"));
+        rData.aTagline = fromUtf8(rItem.get<std::string>("tagline"));
+        rData.aUrl = clickUrl(fromUtf8(rItem.get<std::string>("url")),
+                              fromUtf8(aUtm.get<std::string>("utm.source")),
+                              fromUtf8(aUtm.get<std::string>("utm.campaign")));
+        return true;
+    }
+    catch (...)
+    {
+        return false;
+    }
+}
+
+/** Backing scale of the surface (gtk HiDPI, macOS Retina), on top of the VCL DPI factor. */
+double surfaceScale(const OutputDevice& rDevice)
+{
+#if defined(MACOSX)
+    (void)rDevice;
+    return 2.0; // Retina is the norm; Quartz downsamples the @2x art on other displays
+#elif USE_HEADLESS_CODE && !defined(_WIN32)
+    using GetScale = void (*)(void*, double*, double*);
+    static GetScale pGetScale
+        = reinterpret_cast<GetScale>(dlsym(RTLD_DEFAULT, "cairo_surface_get_device_scale"));
+    const SystemGraphicsData aData = rDevice.GetSystemGfxData();
+    double fX = 1.0, fY = 1.0;
+    if (pGetScale && aData.pSurface)
+        pGetScale(aData.pSurface, &fX, &fY);
+    return std::clamp(fY, 1.0, 3.0);
+#else
+    (void)rDevice;
+    return 1.0; // Windows: VCL pixels are device pixels (GetDPIScaleFactor)
+#endif
+}
+}
+
+class FetchThread final : public salhelper::Thread
+{
+public:
+    FetchThread(HstRibbonBanner* pBanner, sal_Int32 nSlot, int nScale, bool bBundledFirst)
+        : salhelper::Thread("HstRibbonBanner")
+        , mpBanner(pBanner)
+        , mnSlot(nSlot)
+        , mnScale(nScale)
+        , mbBundledFirst(bBundledFirst)
+    {
+    }
+
+private:
+    void execute() override
+    {
+        if (mbBundledFirst)
+        {
+            // first paint: installed defaults at once, then whatever the feed selects
+            auto pFirst = std::make_unique<Data>();
+            pFirst->nScale = mnScale;
+            pFirst->bLast = false;
+            pFirst->bOk = fromBundled(mnSlot, mnScale, *pFirst);
+            if (pFirst->bOk)
+                post(std::move(pFirst));
+        }
+        auto pData = std::make_unique<Data>();
+        pData->nScale = mnScale;
+        pData->bOk = fromService(mnSlot, mnScale, *pData);
+        if (!pData->bOk && !mbBundledFirst)
+        {
+            pData = std::make_unique<Data>();
+            pData->nScale = mnScale;
+            pData->bOk = fromBundled(mnSlot, mnScale, *pData);
+        }
+        post(std::move(pData));
+        SolarMutexGuard aGuard;
+        mpBanner.reset();
+    }
+
+    void post(std::unique_ptr<Data> pData)
+    {
+        SolarMutexGuard aGuard; // the banner cannot be disposed meanwhile
+        if (mpBanner && !mpBanner->isDisposed())
+            mpBanner->Deliver(std::move(pData));
+    }
+
+    VclPtr<HstRibbonBanner> mpBanner;
+    sal_Int32 mnSlot;
+    int mnScale;
+    bool mbBundledFirst;
+};
+
+/** Where a click goes: the service probes the click counter off the UI thread (at most 1.5 s) and
+    answers with the home page when it is down. Without the service the URL is opened as it is. */
+class ClickThread final : public salhelper::Thread
+{
+public:
+    ClickThread(HstRibbonBanner* pBanner, OUString aUrl)
+        : salhelper::Thread("HstRibbonBannerClick")
+        , mpBanner(pBanner)
+        , maUrl(std::move(aUrl))
+    {
+    }
+
+private:
+    void execute() override
+    {
+        OUString aTarget;
+        try
+        {
+            const uno::Reference<uno::XComponentContext>& xContext
+                = comphelper::getProcessComponentContext();
+            uno::Reference<task::XJob> xFeed(
+                xContext->getServiceManager()->createInstanceWithContext(
+                    u"org.hst.office.BannerFeed"_ustr, xContext),
+                uno::UNO_QUERY);
+            if (xFeed.is())
+                xFeed->execute({ { u"ClickUrl"_ustr, uno::Any(maUrl) } }) >>= aTarget;
+        }
+        catch (...)
+        {
+        }
+        if (!aTarget.startsWith("https://"))
+            aTarget = maUrl;
+        SolarMutexGuard aGuard;
+        if (!mpBanner->isDisposed())
+            mpBanner->DeliverClick(aTarget);
+        mpBanner.reset();
+    }
+
+    VclPtr<HstRibbonBanner> mpBanner;
+    OUString maUrl;
+};
+}
+
+using namespace hst::banner;
+
+HstRibbonBanner::HstRibbonBanner(vcl::Window* pParent)
+    : Control(pParent, WB_TABSTOP)
+    , maRotateTimer("sfx2 HstRibbonBanner rotate")
+    , maFadeTimer("sfx2 HstRibbonBanner fade")
+{
+    SetPaintTransparent(true);
+    SetAccessibleRole(accessibility::AccessibleRole::HYPER_LINK);
+    SetPointer(PointerStyle::RefHand);
+    maRotateTimer.SetInvokeHandler(LINK(this, HstRibbonBanner, RotateHdl));
+    maRotateTimer.SetTimeout(mnRotateSeconds * 1000);
+    maFadeTimer.SetInvokeHandler(LINK(this, HstRibbonBanner, FadeHdl));
+    maFadeTimer.SetTimeout(30);
+}
+
+HstRibbonBanner::~HstRibbonBanner() { disposeOnce(); }
+
+void HstRibbonBanner::dispose()
+{
+    maRotateTimer.Stop();
+    maFadeTimer.Stop();
+    if (mxThread.is())
+    {
+        SolarMutexReleaser aReleaser; // the worker takes the SolarMutex to post its result
+        mxThread->join();
+    }
+    if (mxClickThread.is())
+    {
+        SolarMutexReleaser aReleaser;
+        mxClickThread->join();
+    }
+    mxThread.clear();
+    mxClickThread.clear();
+    Control::dispose();
+}
+
+double HstRibbonBanner::DeviceScale() { return GetDPIScaleFactor() * surfaceScale(*GetOutDev()); }
+
+void HstRibbonBanner::Request(sal_Int32 nSlot)
+{
+    if (mbRequested || isDisposed())
+        return;
+    // the variant that matches the fitted image height in device pixels
+    const Size aSize = GetOutputSizePixel();
+    const Rect aImage
+        = fit(Rect{ 0, 0, aSize.Width(), aSize.Height() }, ART_WIDTH, ART_HEIGHT);
+    const int nScale = sourceScale(std::lround(aImage.h * surfaceScale(*GetOutDev())));
+    mbRequested = true; // the previous worker has posted its last result
+    try
+    {
+        mxThread = new FetchThread(this, nSlot, nScale, maId.isEmpty());
+        mxThread->launch();
+    }
+    catch (const std::exception&)
+    {
+        // no thread available: never disturb editing, try again at the next interval
+        mxThread.clear();
+        mbRequested = false;
+        maRotateTimer.Start();
+    }
+}
+
+void HstRibbonBanner::Deliver(std::unique_ptr<Data> pData)
+{
+    // may run on the worker thread (SolarMutex held): hand over to the main loop
+    Application::PostUserEvent(LINK(this, HstRibbonBanner, DeliverHdl), pData.release(), true);
+}
+
+IMPL_LINK(HstRibbonBanner, DeliverHdl, void*, p, void)
+{
+    std::unique_ptr<Data> pData(static_cast<Data*>(p));
+    if (isDisposed())
+        return;
+    if (pData->bLast)
+        mbRequested = false;
+    if (!pData->bOk)
+    {
+        // nothing new (service and installed defaults unavailable): keep the current item
+        if (pData->bLast)
+            maRotateTimer.Start();
+        return;
+    }
+    Bitmap aBitmap;
+    {
+        // PNG, JPEG or WebP as verified by the data layer; decoder errors leave the banner as is
+        SvMemoryStream aStream(pData->aImage.data(), pData->aImage.size(), StreamMode::READ);
+        Graphic aGraphic;
+        if (GraphicFilter::GetGraphicFilter().ImportGraphic(aGraphic, u"", aStream) == ERRCODE_NONE)
+            aBitmap = aGraphic.GetBitmap();
+    }
+    if (aBitmap.IsEmpty())
+    {
+        // decoder error: try the next entry, without disturbing editing
+        if (pData->bLast && ++mnFailures < 3)
+            Request(pData->nSlot + 1); // try the next entry
+        else if (pData->bLast)
+            maRotateTimer.Start();
+        return;
+    }
+    mnFailures = 0;
+    mnSlot = pData->nSlot;
+    mnRotateSeconds = std::clamp<sal_Int32>(pData->nRotateSeconds, 5, 60);
+    if (pData->aId != maId && !maImage.IsEmpty() && MiscSettings::IsAnimatedOthersAllowed())
+    {
+        maOld = maImage;
+        maOldScaled = maImageScaled;
+        mnFadeStep = 1;
+        maFadeTimer.Start();
+    }
+    maImage = aBitmap;
+    maImageScaled = Bitmap();
+    mnSourceScale = pData->nScale;
+    maId = pData->aId;
+    maUrl = pData->aUrl;
+    const OUString aName = pData->aName + u" — " + pData->aTagline;
+    SetAccessibleName(aName);
+    SetQuickHelpText(aName);
+    Invalidate();
+    if (pData->bLast)
+    {
+        maRotateTimer.SetTimeout(mnRotateSeconds * 1000);
+        maRotateTimer.Start();
+    }
+}
+
+IMPL_LINK_NOARG(HstRibbonBanner, RotateHdl, Timer*, void)
+{
+    if (!IsReallyVisible() || Paused())
+    {
+        maRotateTimer.Start(); // try again after a full interval
+        return;
+    }
+    Request(mnSlot + 1);
+}
+
+IMPL_LINK_NOARG(HstRibbonBanner, FadeHdl, Timer*, void)
+{
+    if (++mnFadeStep >= FADE_STEPS)
+    {
+        mnFadeStep = 0;
+        maOld = Bitmap();
+        maOldScaled = Bitmap();
+    }
+    else
+        maFadeTimer.Start();
+    Invalidate();
+}
+
+void HstRibbonBanner::Place(const tools::Rectangle& rSlot)
+{
+    if (rSlot.IsEmpty())
+    {
+        if (IsVisible())
+            Hide();
+        maRotateTimer.Stop();
+        return;
+    }
+    const bool bResized = GetSizePixel() != rSlot.GetSize();
+    if (GetPosPixel() != rSlot.TopLeft() || bResized)
+        SetPosSizePixel(rSlot.TopLeft(), rSlot.GetSize());
+    if (!IsVisible())
+        Show();
+    const Size aSize = rSlot.GetSize();
+    const Rect aImage = fit(Rect{ 0, 0, aSize.Width(), aSize.Height() }, ART_WIDTH, ART_HEIGHT);
+    const int nScale = sourceScale(std::lround(aImage.h * surfaceScale(*GetOutDev())));
+    if (maId.isEmpty() || (bResized && nScale != mnSourceScale))
+        Request(mnSlot); // first content, or the same slot again for the new scale
+    else if (!maRotateTimer.IsActive() && !mbRequested)
+        maRotateTimer.Start();
+}
+
+const Bitmap& HstRibbonBanner::Prepared(const Bitmap& rSource, Bitmap& rCache, const Size& rDevice)
+{
+    if (rCache.IsEmpty() || rCache.GetSizePixel() != rDevice)
+    {
+        rCache = rSource;
+        if (rCache.GetSizePixel() != rDevice)
+            rCache.Scale(rDevice, BmpScaleFlag::BestQuality);
+    }
+    return rCache;
+}
+
+void HstRibbonBanner::DrawArt(vcl::RenderContext& rRenderContext, const Bitmap& rSource,
+                              Bitmap& rCache, double fAlpha)
+{
+    const Size aOut = GetOutputSizePixel();
+    const long nInset = scaled(3, GetDPIScaleFactor());
+    const Size aSourceSize = rSource.GetSizePixel();
+    // the image's own pixel size never changes the slot: aspect-fit, centred
+    const Rect aBox{ nInset, nInset, aOut.Width() - 2 * nInset, aOut.Height() - 2 * nInset };
+    const Rect aFit = fit(aBox, aSourceSize.Width(), aSourceSize.Height());
+    if (aFit.w <= 0 || aFit.h <= 0)
+        return;
+    const double fScale = surfaceScale(rRenderContext);
+    const Size aDevice(std::lround(aFit.w * fScale), std::lround(aFit.h * fScale));
+    const Bitmap& rDraw = Prepared(rSource, rCache, aDevice);
+    if (fAlpha >= 1.0)
+        rRenderContext.DrawBitmap(Point(aFit.x, aFit.y), Size(aFit.w, aFit.h), rDraw);
+    else
+        rRenderContext.DrawTransformedBitmapEx(
+            basegfx::utils::createScaleTranslateB2DHomMatrix(aFit.w, aFit.h, aFit.x, aFit.y),
+            rDraw, fAlpha);
+}
+
+void HstRibbonBanner::Paint(vcl::RenderContext& rRenderContext, const tools::Rectangle&)
+{
+    const StyleSettings& rStyle = rRenderContext.GetSettings().GetStyleSettings();
+    const tools::Rectangle aAll(Point(), GetOutputSizePixel());
+    const long nRadius = scaled(8, GetDPIScaleFactor());
+    rRenderContext.Push(vcl::PushFlags::LINECOLOR | vcl::PushFlags::FILLCOLOR);
+    if (rStyle.GetWindowColor().IsDark() || rStyle.GetDialogColor().IsDark())
+    {
+        // the artwork is designed for light backgrounds: a light rounded card in dark mode
+        rRenderContext.SetLineColor();
+        rRenderContext.SetFillColor(Color(0xF4, 0xF6, 0xF9));
+        rRenderContext.DrawRect(aAll, nRadius, nRadius);
+    }
+    if (!maOld.IsEmpty() && mnFadeStep > 0)
+    {
+        DrawArt(rRenderContext, maOld, maOldScaled, 1.0);
+        if (!maImage.IsEmpty())
+            DrawArt(rRenderContext, maImage, maImageScaled,
+                    static_cast<double>(mnFadeStep) / FADE_STEPS);
+    }
+    else if (!maImage.IsEmpty())
+        DrawArt(rRenderContext, maImage, maImageScaled, 1.0);
+    if (HasFocus())
+    {
+        rRenderContext.SetFillColor();
+        rRenderContext.SetLineColor(rStyle.GetHighlightColor());
+        tools::Rectangle aRing(aAll);
+        aRing.AdjustRight(-1);
+        aRing.AdjustBottom(-1);
+        rRenderContext.DrawRect(aRing, nRadius, nRadius);
+        aRing.AdjustLeft(1);
+        aRing.AdjustTop(1);
+        aRing.AdjustRight(-1);
+        aRing.AdjustBottom(-1);
+        rRenderContext.DrawRect(aRing, nRadius, nRadius);
+    }
+    rRenderContext.Pop();
+}
+
+void HstRibbonBanner::Activate()
+{
+    using namespace std::chrono_literals;
+    if (maUrl.isEmpty() || mbClickPending || std::chrono::steady_clock::now() - maLastOpen < 1s)
+        return;
+    mbClickPending = true;
+    try
+    {
+        mxClickThread = new ClickThread(this, maUrl);
+        mxClickThread->launch();
+    }
+    catch (const std::exception&)
+    {
+        mxClickThread.clear();
+        DeliverClick(maUrl);
+    }
+}
+
+void HstRibbonBanner::DeliverClick(const OUString& rUrl)
+{
+    Application::PostUserEvent(LINK(this, HstRibbonBanner, OpenHdl), new OUString(rUrl), true);
+}
+
+IMPL_LINK(HstRibbonBanner, OpenHdl, void*, p, void)
+{
+    std::unique_ptr<OUString> pUrl(static_cast<OUString*>(p));
+    mbClickPending = false;
+    maLastOpen = std::chrono::steady_clock::now();
+    if (isDisposed())
+        return;
+    try
+    {
+        system::SystemShellExecute::create(comphelper::getProcessComponentContext())
+            ->execute(*pUrl, OUString(), system::SystemShellExecuteFlags::URIS_ONLY);
+    }
+    catch (const uno::Exception&)
+    {
+        // no dialog: a banner must never interrupt editing
+    }
+}
+
+void HstRibbonBanner::MouseMove(const MouseEvent& rMEvt)
+{
+    mbHover = !rMEvt.IsLeaveWindow(); // hover pauses the rotation
+    Control::MouseMove(rMEvt);
+}
+
+void HstRibbonBanner::MouseButtonDown(const MouseEvent& rMEvt)
+{
+    if (rMEvt.IsLeft())
+    {
+        mbPressed = true;
+        GrabFocus();
+        return;
+    }
+    Control::MouseButtonDown(rMEvt);
+}
+
+void HstRibbonBanner::MouseButtonUp(const MouseEvent& rMEvt)
+{
+    if (rMEvt.IsLeft() && mbPressed)
+    {
+        mbPressed = false;
+        if (tools::Rectangle(Point(), GetOutputSizePixel()).Contains(rMEvt.GetPosPixel()))
+            Activate();
+        return;
+    }
+    Control::MouseButtonUp(rMEvt);
+}
+
+void HstRibbonBanner::KeyInput(const KeyEvent& rKEvt)
+{
+    const vcl::KeyCode& rKey = rKEvt.GetKeyCode();
+    if (!rKey.GetModifier()
+        && (rKey.GetCode() == KEY_RETURN || rKey.GetCode() == KEY_SPACE))
+    {
+        Activate();
+        return;
+    }
+    Control::KeyInput(rKEvt);
+}
+
+void HstRibbonBanner::GetFocus()
+{
+    Control::GetFocus();
+    Invalidate(); // focus ring; focus pauses the rotation
+}
+
+void HstRibbonBanner::LoseFocus()
+{
+    Control::LoseFocus();
+    Invalidate();
+}
+
+void HstRibbonBanner::DataChanged(const DataChangedEvent& rDCEvt)
+{
+    Control::DataChanged(rDCEvt);
+    if (rDCEvt.GetType() == DataChangedEventType::SETTINGS)
+    {
+        maImageScaled = Bitmap();
+        maOldScaled = Bitmap();
+        Invalidate(); // light/dark card follows the theme
+    }
+}
