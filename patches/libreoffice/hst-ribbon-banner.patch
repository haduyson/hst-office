+    void Place(const tools::Rectangle& rSlot);
+
+    virtual void Paint(vcl::RenderContext& rRenderContext, const tools::Rectangle& rRect) override;
+    virtual void MouseMove(const MouseEvent& rMEvt) override;
+    virtual void MouseButtonDown(const MouseEvent& rMEvt) override;
+    virtual void MouseButtonUp(const MouseEvent& rMEvt) override;
+    virtual void KeyInput(const KeyEvent& rKEvt) override;
+    virtual void GetFocus() override;
+    virtual void LoseFocus() override;
+    virtual void DataChanged(const DataChangedEvent& rDCEvt) override;
+
+    /** Called on the main thread with a result of the worker (takes ownership). */
+    void Deliver(std::unique_ptr<hst::banner::Data> pData);
+    /** Called with the SolarMutex held by the click worker: open the resolved destination. */
+    void DeliverClick(const OUString& rUrl);
+
+private:
+    void Request(sal_Int32 nSlot);
+    void Activate();
+    double DeviceScale();
+    const Bitmap& Prepared(const Bitmap& rSource, Bitmap& rCache, const Size& rDevice);
+    void DrawArt(vcl::RenderContext& rRenderContext, const Bitmap& rSource, Bitmap& rCache,
+                 double fAlpha);
+    bool Paused() const { return mbHover || HasFocus(); }
+
+    DECL_LINK(RotateHdl, Timer*, void);
+    DECL_LINK(FadeHdl, Timer*, void);
+    DECL_LINK(DeliverHdl, void*, void);
+    DECL_LINK(OpenHdl, void*, void);
+
+    rtl::Reference<hst::banner::FetchThread> mxThread;
+    rtl::Reference<hst::banner::ClickThread> mxClickThread;
+    std::chrono::steady_clock::time_point maLastOpen; // double clicks open one browser tab
