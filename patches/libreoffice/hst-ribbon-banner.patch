+// HST Office: the banner belongs to the Tabbed notebookbar (notebookbar.ui) of Writer, Calc and
+// Impress only; Draw, the compact and the other variants keep the upstream layout.
+void NotebookbarTabControl::HstCreateBanner()
+{
+    if (m_pHstBanner)
+        return;
+    for (vcl::Window* pParent = GetParent(); pParent; pParent = pParent->GetParent())
+    {
+        if (NotebookBar* pBar = dynamic_cast<NotebookBar*>(pParent))
+        {
+            const OUString& rFile = pBar->GetUIFilePath();
+            if (!rFile.endsWith("/notebookbar.ui")
+                || (rFile.indexOf("/swriter/") < 0 && rFile.indexOf("/scalc/") < 0
+                    && rFile.indexOf("/simpress/") < 0))
+                return;
+            m_pHstBanner = VclPtr<HstRibbonBanner>::Create(this);
+            AddChildEventListener(LINK(this, NotebookbarTabControl, HstChildEventHdl));
+            HstLayoutBanner();
+            return;
+        }
+    }
+}
+
+// The banner takes the right end of the current page; the page (the 2-row groups) keeps its
+// height and gets the remaining width, so groups fold into their overflow menu as usual. The
+// ribbon height never depends on the banner. Narrow windows give the groups the whole width.
+void NotebookbarTabControl::HstLayoutBanner()
+{
+    if (!m_pHstBanner || m_bHstLayout)
+        return;
+    m_bHstLayout = true;
+    TabPage* pPage = GetTabPage(GetCurPageId());
+    if (pPage && pPage->IsVisible())
+    {
+        const double fDpi = GetDPIScaleFactor();
+        const Point aPos = pPage->GetPosPixel();
+        const hst::banner::Rect aPage{ aPos.X(), aPos.Y(),
+                                       GetOutputSizePixel().Width() - 2 * aPos.X(),
+                                       pPage->GetSizePixel().Height() };
+        const vcl::Window* pTop = GetSystemWindow();
+        const tools::Long nWindowWidth = pTop ? pTop->GetSizePixel().Width() : GetSizePixel().Width();
+        tools::Long nPageWidth = aPage.w;
+        if (hst::banner::visibleFor(nWindowWidth, aPage.h, fDpi))
+        {
+            const hst::banner::Rect aSlot = hst::banner::slotFor(aPage, fDpi);
+            nPageWidth = hst::banner::pageWidthBeside(aPage, aSlot, fDpi);
+            m_pHstBanner->Place(tools::Rectangle(Point(aSlot.x, aSlot.y), Size(aSlot.w, aSlot.h)));
+        }
+        else
+            m_pHstBanner->Place(tools::Rectangle());
+        if (nPageWidth > 0 && pPage->GetSizePixel().Width() != nPageWidth)
+            pPage->SetPosSizePixel(aPos, Size(nPageWidth, aPage.h));
+    }
+    else
+        m_pHstBanner->Place(tools::Rectangle());
+    m_bHstLayout = false;
+}
+
+IMPL_LINK(NotebookbarTabControl, HstChildEventHdl, VclWindowEvent&, rEvent, void)
+{
+    // The tab control re-allocates the current page at full width on resizes and tab switches.
+    // This event fires inside that allocation, which then continues with the full width: narrow
+    // the page only after it has finished.
+    const VclEventId nId = rEvent.GetId();
+    vcl::Window* pWindow = rEvent.GetWindow();
+    if ((nId == VclEventId::WindowResize || nId == VclEventId::WindowShow) && pWindow
+        && pWindow->GetParent() == this && dynamic_cast<TabPage*>(pWindow) && !m_pHstLayoutEvent)
+        m_pHstLayoutEvent = Application::PostUserEvent(LINK(this, NotebookbarTabControl, HstDeferredLayoutHdl));
+}
+
+IMPL_LINK_NOARG(NotebookbarTabControl, HstDeferredLayoutHdl, void*, void)
+{
+    m_pHstLayoutEvent = nullptr;
+    HstLayoutBanner();
+}
+
+void NotebookbarTabControl::Resize()
+{
+    NotebookbarTabControlBase::Resize();
+    HstLayoutBanner();
