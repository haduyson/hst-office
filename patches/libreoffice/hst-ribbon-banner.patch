+
+#pragma once
+
+// HST Office: geometry of the HASON TECH solution banner in the Tabbed notebookbar.
+// Plain integer arithmetic without LibreOffice types, so it can be unit tested on its own
+// (tests/unit/test_ribbon_banner_geometry.py compiles it from the patch with a test driver).
+//
+// The slot adapts to the ribbon, never the other way round: its height is the height of the
+// tab page that already holds the 2-row groups, its width keeps the 360:104 artwork ratio and
+// is capped at 360 logical px. Images of any pixel size are aspect-fitted into the slot.
+
+#include <algorithm>
+#include <cmath>
+
+namespace hst::banner
+{
+struct Rect
+{
+    long x = 0;
+    long y = 0;
+    long w = 0;
+    long h = 0;
+};
+
+constexpr long ART_WIDTH = 360; // logical px of the @1x artwork
+constexpr long ART_HEIGHT = 104;
+constexpr long MIN_WINDOW_WIDTH = 1280; // narrower windows keep the whole width for the groups
+constexpr long MIN_PAGE_HEIGHT = 60; // compact ribbons (one row) never show the banner
+
+inline long scaled(long nLogical, double fDpi) { return std::lround(nLogical * fDpi); }
+
+/** Whether the banner is shown for a top-level window of nWindowWidth pixels at fDpi. */
+inline bool visibleFor(long nWindowWidth, long nPageHeight, double fDpi)
+{
+    return nWindowWidth >= scaled(MIN_WINDOW_WIDTH, fDpi)
+           && nPageHeight >= scaled(MIN_PAGE_HEIGHT, fDpi);
+}
+
+/** Banner slot at the right end of the full tab page rectangle rPage (pixels). */
+inline Rect slotFor(const Rect& rPage, double fDpi)
+{
+    const long nVMargin = scaled(2, fDpi);
+    const long nRightMargin = scaled(4, fDpi);
+    Rect aSlot;
+    aSlot.h = std::max(0L, rPage.h - 2 * nVMargin);
+    aSlot.w = std::min(scaled(ART_WIDTH, fDpi), aSlot.h * ART_WIDTH / ART_HEIGHT);
+    aSlot.x = rPage.x + rPage.w - nRightMargin - aSlot.w;
+    aSlot.y = rPage.y + nVMargin;
+    return aSlot;
+}
+
+/** Width left to the groups of the page when the banner occupies rSlot. */
+inline long pageWidthBeside(const Rect& rPage, const Rect& rSlot, double fDpi)
+{
+    return std::max(0L, rSlot.x - scaled(8, fDpi) - rPage.x);
+}
+
+/** Aspect-fit an image of nImageW x nImageH into rBox, centred; never larger than rBox. */
+inline Rect fit(const Rect& rBox, long nImageW, long nImageH)
+{
+    Rect aResult = rBox;
+    if (nImageW <= 0 || nImageH <= 0 || rBox.w <= 0 || rBox.h <= 0)
+        return Rect{ rBox.x, rBox.y, 0, 0 };
+    // compare rBox.w / rBox.h with nImageW / nImageH without rounding
+    if (rBox.w * nImageH > nImageW * rBox.h)
+        aResult.w = std::max(1L, rBox.h * nImageW / nImageH); // box wider: full height
+    else
+        aResult.h = std::max(1L, rBox.w * nImageH / nImageW); // box taller: full width
+    aResult.x = rBox.x + (rBox.w - aResult.w) / 2;
+    aResult.y = rBox.y + (rBox.h - aResult.h) / 2;
+    return aResult;
+}
+
+/** Artwork variant (1, 2 or 3) for an image drawn nDeviceHeight device pixels high: the exact
+    variant when the size matches one, else the next larger one so that it is only ever
+    downscaled (high quality) and never upscaled. */
+inline int sourceScale(long nDeviceHeight)
+{
+    long nLevel = (nDeviceHeight + ART_HEIGHT - 1) / ART_HEIGHT;
+    if (nDeviceHeight % ART_HEIGHT != 0)
+        ++nLevel;
+    return static_cast<int>(std::clamp(nLevel, 1L, 3L));
+}
+}
