+class SwDoc;
+class SwView;
+
+/// The hint bar a Writer document with MathType equations (Equation.DSMT*, kept as OLE objects
+/// with their preview picture) shows when it opens: it offers HST's formula converter. It never
+/// converts by itself.
+namespace hst::mathtype
+{
+/// The number of MathType OLE objects in rDoc: the class ID of each object's stored compound file,
+/// read without loading the object.
+sal_Int32 CountMathTypeObjects(const SwDoc& rDoc);
+
+/// After the document has opened: shows the hint bar in rView's frame when the document is
+/// editable, has MathType objects and has not shown the bar in this session.
+void ScheduleHintBar(const SwView& rView);
+}
