+constexpr OUString HINT_BAR_ID = u"hst-mathtype"_ustr;
+// HST Công thức (the hst-vietnamese-tools extension): converts the document's MathType equations
+// to Math formulas, one Undo step
+constexpr OUString CONVERT_COMMAND = u"org.hst.office.vi:ConvertFormulas"_ustr;
+
+/// MathType 3-7, "Equation.DSMT*": the class ID of the equation's compound file
+const SvGlobalName& MathTypeClassId()
+{
+    static const SvGlobalName aId(0x0002ce03, 0x0000, 0x0000, 0xc0, 0x00, 0x00, 0x00, 0x00, 0x00,
+                                  0x00, 0x46);
+    return aId;
+}
+
+#ifdef _WIN32
+/// The program of a registry command line: quoted, or up to ".exe"/".dll", else all of it.
+OUString ProgramOf(OUString aCommand)
+{
+    aCommand = aCommand.trim();
+    if (aCommand.startsWith("\""))
+    {
+        const sal_Int32 nEnd = aCommand.indexOf('"', 1);
+        return nEnd > 0 ? aCommand.copy(1, nEnd - 1) : aCommand.copy(1);
+    }
+    const OUString aLower = aCommand.toAsciiLowerCase();
+    for (const char* pExt : { ".exe", ".dll" })
+        if (const sal_Int32 nAt = aLower.indexOf(OUString::createFromAscii(pExt)); nAt > 0)
+            return aCommand.copy(0, nAt + 4);
+    return aCommand;
+}
+
+/// The default value of HKEY_CLASSES_ROOT\pKey (a REG_EXPAND_SZ comes expanded), in the 64-bit
+/// or else the 32-bit view: a 32-bit OLE server (MathType in "Program Files (x86)") registers its
+/// class in the 32-bit view only, and COM starts it for the 64-bit office all the same.
+OUString ReadClassesRoot(const wchar_t* pKey)
+{
+    for (REGSAM nView : { KEY_WOW64_64KEY, KEY_WOW64_32KEY })
+    {
+        wchar_t aValue[MAX_PATH * 2];
+        DWORD nSize = sizeof(aValue);
+        if (RegGetValueW(HKEY_CLASSES_ROOT, pKey, nullptr, RRF_RT_REG_SZ | nView,
+                         nullptr, aValue, &nSize)
+            == ERROR_SUCCESS)
+            return OUString(o3tl::toU(aValue));
+    }
+    return OUString();
+}
+#endif
+
+/// MathType is installed: its OLE server (LocalServer32 or InprocServer32 of the MathType class) is
+/// registered and its program exists. MathType then opens its equations on a double-click, as in
+/// HST Office 1.0.2, so the bar has nothing to offer. Never true outside Windows.
+bool MathTypeInstalled()
+{
+#ifdef _WIN32
+    for (const wchar_t* pKey : { L"CLSID\\{0002CE03-0000-0000-C000-000000000046}\\LocalServer32",
+                                 L"CLSID\\{0002CE03-0000-0000-C000-000000000046}\\InprocServer32" })
+    {
+        const OUString aProgram = ProgramOf(ReadClassesRoot(pKey));
+        if (aProgram.isEmpty())
+            continue;
+        if (GetFileAttributesW(o3tl::toW(aProgram.getStr())) != INVALID_FILE_ATTRIBUTES)
+            return true;
+    }
+#endif
+    return false;
+}
+
+bool Vietnamese()
+{
+    return Application::GetSettings().GetUILanguageTag().getLanguage() == "vi";
+}
+
+/// Documents that showed the bar in this session (kept alive on purpose: no destruction at exit)
+std::vector<uno::WeakReferenceHelper>& Shown()
+{
+    static auto* pShown = new std::vector<uno::WeakReferenceHelper>;
+    return *pShown;
+}
+
+/// true the first time it is asked for xModel in this session
+bool FirstTime(const uno::Reference<uno::XInterface>& xModel)
+{
+    auto& rShown = Shown();
+    std::erase_if(rShown, [](const uno::WeakReferenceHelper& r) { return !r.get().is(); });
+    for (const auto& r : rShown)
+        if (r.get() == xModel)
+            return false;
+    rShown.emplace_back(xModel);
+    return true;
+}
+
+bool IsMathType(const uno::Reference<embed::XStorage>& xStorage, const OUString& rName)
+{
+    try
+    {
+        if (rName.isEmpty() || !xStorage->hasByName(rName) || xStorage->isStorageElement(rName))
+            return false; // an own (ODF) object, not an OLE compound file
+        // a copy: the OLE object keeps its own stream open, so it cannot be opened again
+        uno::Reference<io::XStream> xStream = xStorage->cloneStreamElement(rName);
+        std::unique_ptr<SvStream> pStream = utl::UcbStreamHelper::CreateStream(xStream);
+        if (!pStream || !SotStorage::IsStorageFile(pStream.get()))
+            return false;
+        rtl::Reference<SotStorage> xOle = new SotStorage(*pStream);
+        return !xOle->GetError() && xOle->GetClassName() == MathTypeClassId();
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("sw.ui", "hst::mathtype: cannot read an OLE object");
+        return false;
+    }
+}
+
+bool FrameAlive(const SfxViewFrame* pFrame)
+{
+    for (SfxViewFrame* p = SfxViewFrame::GetFirst(nullptr, false); p;
+         p = SfxViewFrame::GetNext(*p, nullptr, false))
+        if (p == pFrame)
+            return true;
+    return false;
+}
+
+void CloseLater(void* pFrame, void*)
+{
+    if (FrameAlive(static_cast<SfxViewFrame*>(pFrame)))
+        static_cast<SfxViewFrame*>(pFrame)->RemoveInfoBar(HINT_BAR_ID);
+}
+
+void ConvertLater(void* pFrame, void*)
+{
+    auto* pViewFrame = static_cast<SfxViewFrame*>(pFrame);
+    if (!FrameAlive(pViewFrame))
+        return;
+    pViewFrame->RemoveInfoBar(HINT_BAR_ID);
+    comphelper::dispatchCommand(CONVERT_COMMAND, pViewFrame->GetFrame().GetFrameInterface(), {});
+}
+
+// Buttons act after their click handler has returned: the bar (and the button) goes away.
+void CloseClicked(void* pFrame, weld::Button&)
+{
+    Application::PostUserEvent(LINK_NONMEMBER(pFrame, CloseLater));
+}
+
+void ConvertClicked(void* pFrame, weld::Button&)
+{
+    Application::PostUserEvent(LINK_NONMEMBER(pFrame, ConvertLater));
+}
+
+void AppendBar(SwView& rView, sal_Int32 nCount)
+{
+    SfxViewFrame& rFrame = rView.GetViewFrame();
+    const sal_uInt16 nId = SfxInfoBarContainerChild::GetChildWindowId();
+    if (!rFrame.HasChildWindow(nId))
+        rFrame.ToggleChildWindow(nId);
+    const bool bVi = Vietnamese();
+    const OUString aMessage
+        = (bVi ? u"Tài liệu có %N công thức MathType. Chuyển sang công thức HST để sửa được?"_ustr
+               : u"This document has %N MathType equations. Convert them to HST formulas so they "
+                 "can be edited?"_ustr)
+              .replaceFirst("%N", OUString::number(nCount));
+    VclPtr<SfxInfoBarWindow> pBar
+        = rFrame.AppendInfoBar(HINT_BAR_ID, OUString(), aMessage, InfobarType::INFO, false);
+    if (!pBar)
+        return;
+    weld::Button& rConvert = pBar->addButton();
+    rConvert.set_label(bVi ? u"Chuyển công thức"_ustr : u"Convert Equations"_ustr);
+    rConvert.connect_clicked(LINK_NONMEMBER(static_cast<void*>(&rFrame), ConvertClicked));
+    weld::Button& rClose = pBar->addButton();
+    rClose.set_label(bVi ? u"Đóng"_ustr : u"Close"_ustr);
+    rClose.connect_clicked(LINK_NONMEMBER(static_cast<void*>(&rFrame), CloseClicked));
+}
+
+SwDocShell* DocShellOf(const uno::Reference<uno::XInterface>& xModel)
+{
+    return xModel.is()
+               ? dynamic_cast<SwDocShell*>(SfxObjectShell::GetShellFromComponent(xModel))
+               : nullptr;
+}
+
+/// Counts the MathType objects a few at a time on an idle, so that a document with a thousand
+/// equations does not hold the user up after it has opened (each object's stream is copied to read
+/// its class ID), then shows the bar. Deletes itself when done or when the document is gone.
+class Counter
+{
+public:
+    Counter(const uno::Reference<uno::XInterface>& xModel, std::vector<OUString>&& rNames)
+        : m_aModel(xModel)
+        , m_aNames(std::move(rNames))
+        , m_aIdle("hst::mathtype::Counter")
+    {
+        m_aIdle.SetPriority(TaskPriority::LOWEST);
+        m_aIdle.SetInvokeHandler(LINK(this, Counter, Step));
+        m_aIdle.Start();
+    }
+
+private:
+    DECL_LINK(Step, Timer*, void);
+
+    static constexpr size_t STEP = 32; // objects per idle call, about 15 ms on s037.docx
+
+    uno::WeakReferenceHelper m_aModel;
+    std::vector<OUString> m_aNames;
+    size_t m_nNext = 0;
+    sal_Int32 m_nCount = 0;
+    Idle m_aIdle;
+};
+
+IMPL_LINK_NOARG(Counter, Step, Timer*, void)
+{
+    SwDocShell* pDocShell = DocShellOf(m_aModel.get());
+    const uno::Reference<embed::XStorage> xStorage
+        = pDocShell ? pDocShell->getStorage() : uno::Reference<embed::XStorage>();
+    if (!xStorage.is())
+    {
+        delete this;
+        return;
+    }
+    for (const size_t nEnd = std::min(m_aNames.size(), m_nNext + STEP); m_nNext < nEnd; ++m_nNext)
+        if (IsMathType(xStorage, m_aNames[m_nNext]))
+            ++m_nCount;
+    if (m_nNext < m_aNames.size())
+    {
+        m_aIdle.Start();
+        return;
+    }
+    if (m_nCount > 0 && pDocShell->GetView())
+        AppendBar(*pDocShell->GetView(), m_nCount);
+    delete this;
+}
+
+std::vector<OUString> OleNames(const SwDoc& rDoc)
+{
+    std::vector<OUString> aNames;
+    const SwNodes& rNodes = rDoc.GetNodes();
+    for (SwNodeOffset n(0); n < rNodes.Count(); ++n)
+        if (const SwOLENode* pOle = rNodes[n]->GetOLENode())
+            aNames.push_back(pOle->GetOLEObj().GetCurrentPersistName());
+    return aNames;
+}
+
+void Show(SwView& rView)
+{
+    SwDocShell* pDocShell = rView.GetDocShell();
+    if (!pDocShell || pDocShell->IsReadOnly() || pDocShell->IsPreview()
+        || pDocShell->GetCreateMode() != SfxObjectCreateMode::STANDARD)
+        return;
+    // No bar without a user to see it. Background loads open hidden: soffice --convert-to and
+    // --print-to (also read-only), mail merge working documents, scripts and API conversions.
+    // Previews and thumbnails render the document without a view.
+    const SfxMedium* pMedium = pDocShell->GetMedium();
+    const SfxBoolItem* pHidden
+        = pMedium ? pMedium->GetItemSet().GetItemIfSet(SID_HIDDEN, false) : nullptr;
+    if (pHidden && pHidden->GetValue())
+        return;
+    const uno::Reference<uno::XInterface> xModel(pDocShell->GetModel(), uno::UNO_QUERY);
+    if (!xModel.is())
+        return;
+    // Where MathType is installed it edits its equations itself, so the bar stays away. The
+    // converter stays in the ribbon and the menu (Chuyển công thức) for whoever wants it.
+    if (MathTypeInstalled())
+        return;
+    std::vector<OUString> aNames = OleNames(*pDocShell->GetDoc());
+    if (aNames.empty() || !FirstTime(xModel))
+        return;
+    new Counter(xModel, std::move(aNames));
+}
+
+void ShowLater(void* pModel, void*)
+{
+    std::unique_ptr<uno::WeakReferenceHelper> pWeak(
+        static_cast<uno::WeakReferenceHelper*>(pModel));
+    SwDocShell* pDocShell = DocShellOf(pWeak->get());
+    if (pDocShell && pDocShell->GetView())
+        Show(*pDocShell->GetView());
+}
+}
+
+sal_Int32 CountMathTypeObjects(const SwDoc& rDoc)
+{
+    const SwDocShell* pDocShell = rDoc.GetDocShell();
+    if (!pDocShell)
+        return 0;
+    const uno::Reference<embed::XStorage> xStorage = pDocShell->getStorage();
+    if (!xStorage.is())
+        return 0;
+    sal_Int32 nCount = 0;
+    const SwNodes& rNodes = rDoc.GetNodes();
+    for (SwNodeOffset n(0); n < rNodes.Count(); ++n)
+        if (const SwOLENode* pOle = rNodes[n]->GetOLENode())
+            if (IsMathType(xStorage, pOle->GetOLEObj().GetCurrentPersistName()))
+                ++nCount;
+    return nCount;
+}
+
+void ScheduleHintBar(const SwView& rView)
+{
+    if (comphelper::LibreOfficeKit::isActive())
+        return;
+    const SwDocShell* pDocShell = rView.GetDocShell();
+    if (!pDocShell || !pDocShell->GetModel().is())
+        return;
+    // the view is built while the document opens; the frame shows infobars once it has opened
+    Application::PostUserEvent(LINK_NONMEMBER(
+        static_cast<void*>(new uno::WeakReferenceHelper(
+            uno::Reference<uno::XInterface>(pDocShell->GetModel(), uno::UNO_QUERY))),
+        ShowLater));
+}
+}
