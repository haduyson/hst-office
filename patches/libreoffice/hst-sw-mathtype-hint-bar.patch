+
+using namespace css;
+
+namespace hst::mathtype
+{
+namespace
+{
+constexpr OUString HINT_BAR_ID = u"hst-mathtype"_ustr;
+// HST Công thức (the hst-vietnamese-tools extension): converts the document's MathType equations
+// to Math formulas, one Undo step
+constexpr OUString CONVERT_COMMAND = u"org.hst.office.vi:ConvertFormulas"_ustr;
+
+/// MathType 3-7, "Equation.DSMT*": the class ID of the equation's compound file
+const SvGlobalName& MathTypeClassId()
+{
+    static const SvGlobalName aId(0x0002ce03, 0x0000, 0x0000, 0xc0, 0x00, 0x00, 0x00, 0x00, 0x00,
+                                  0x00, 0x46);
+    return aId;
+}
+
+bool Vietnamese()
+{
+    return Application::GetSettings().GetUILanguageTag().getLanguage() == "vi";
+}
+
+/// Documents that showed the bar in this session (kept alive on purpose: no destruction at exit)
+std::vector<uno::WeakReferenceHelper>& Shown()
+{
+    static auto* pShown = new std::vector<uno::WeakReferenceHelper>;
+    return *pShown;
+}
+
+/// true the first time it is asked for xModel in this session
+bool FirstTime(const uno::Reference<uno::XInterface>& xModel)
+{
+    auto& rShown = Shown();
+    std::erase_if(rShown, [](const uno::WeakReferenceHelper& r) { return !r.get().is(); });
+    for (const auto& r : rShown)
+        if (r.get() == xModel)
+            return false;
+    rShown.emplace_back(xModel);
+    return true;
+}
+
+bool IsMathType(const uno::Reference<embed::XStorage>& xStorage, const OUString& rName)
+{
+    try
+    {
+        if (rName.isEmpty() || !xStorage->hasByName(rName) || xStorage->isStorageElement(rName))
+            return false; // an own (ODF) object, not an OLE compound file
+        uno::Reference<io::XStream> xStream
+            = xStorage->openStreamElement(rName, embed::ElementModes::READ);
+        std::unique_ptr<SvStream> pStream = utl::UcbStreamHelper::CreateStream(xStream);
+        if (!pStream || !SotStorage::IsStorageFile(pStream.get()))
+            return false;
+        rtl::Reference<SotStorage> xOle = new SotStorage(*pStream);
+        return !xOle->GetError() && xOle->GetClassName() == MathTypeClassId();
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("sw.ui", "hst::mathtype: cannot read an OLE object");
+        return false;
+    }
+}
+
+bool FrameAlive(const SfxViewFrame* pFrame)
+{
+    for (SfxViewFrame* p = SfxViewFrame::GetFirst(nullptr, false); p;
+         p = SfxViewFrame::GetNext(*p, nullptr, false))
+        if (p == pFrame)
+            return true;
+    return false;
+}
+
+void CloseLater(void* pFrame, void*)
+{
+    if (FrameAlive(static_cast<SfxViewFrame*>(pFrame)))
+        static_cast<SfxViewFrame*>(pFrame)->RemoveInfoBar(HINT_BAR_ID);
+}
+
+void ConvertLater(void* pFrame, void*)
+{
+    auto* pViewFrame = static_cast<SfxViewFrame*>(pFrame);
+    if (!FrameAlive(pViewFrame))
+        return;
+    pViewFrame->RemoveInfoBar(HINT_BAR_ID);
+    comphelper::dispatchCommand(CONVERT_COMMAND, pViewFrame->GetFrame().GetFrameInterface(), {});
+}
+
+// Buttons act after their click handler has returned: the bar (and the button) goes away.
+void CloseClicked(void* pFrame, weld::Button&)
+{
+    Application::PostUserEvent(LINK_NONMEMBER(pFrame, CloseLater));
+}
+
+void ConvertClicked(void* pFrame, weld::Button&)
+{
+    Application::PostUserEvent(LINK_NONMEMBER(pFrame, ConvertLater));
+}
+
+void Show(SwView& rView)
+{
+    SwDocShell* pDocShell = rView.GetDocShell();
+    if (!pDocShell || pDocShell->IsReadOnly()
+        || pDocShell->GetCreateMode() == SfxObjectCreateMode::EMBEDDED)
+        return;
+    const uno::Reference<uno::XInterface> xModel(pDocShell->GetModel(), uno::UNO_QUERY);
+    if (!xModel.is())
+        return;
+    const sal_Int32 nCount = CountMathTypeObjects(*pDocShell->GetDoc());
+    if (nCount <= 0 || !FirstTime(xModel))
+        return;
+
+    SfxViewFrame& rFrame = rView.GetViewFrame();
+    const sal_uInt16 nId = SfxInfoBarContainerChild::GetChildWindowId();
+    if (!rFrame.HasChildWindow(nId))
+        rFrame.ToggleChildWindow(nId);
+    const bool bVi = Vietnamese();
+    const OUString aMessage
+        = (bVi ? u"Tài liệu có %N công thức MathType. Chuyển sang công thức HST để sửa được?"_ustr
+               : u"This document has %N MathType equations. Convert them to HST formulas so they "
+                 "can be edited?"_ustr)
+              .replaceFirst("%N", OUString::number(nCount));
+    VclPtr<SfxInfoBarWindow> pBar
+        = rFrame.AppendInfoBar(HINT_BAR_ID, OUString(), aMessage, InfobarType::INFO, false);
+    if (!pBar)
+        return;
+    weld::Button& rConvert = pBar->addButton();
+    rConvert.set_label(bVi ? u"Chuyển công thức"_ustr : u"Convert Equations"_ustr);
+    rConvert.connect_clicked(LINK_NONMEMBER(static_cast<void*>(&rFrame), ConvertClicked));
+    weld::Button& rClose = pBar->addButton();
+    rClose.set_label(bVi ? u"Đóng"_ustr : u"Close"_ustr);
+    rClose.connect_clicked(LINK_NONMEMBER(static_cast<void*>(&rFrame), CloseClicked));
+}
+
+void ShowLater(void* pModel, void*)
+{
+    std::unique_ptr<uno::WeakReferenceHelper> pWeak(
+        static_cast<uno::WeakReferenceHelper*>(pModel));
+    const uno::Reference<uno::XInterface> xModel = pWeak->get();
+    if (!xModel.is())
+        return;
+    auto* pDocShell = dynamic_cast<SwDocShell*>(SfxObjectShell::GetShellFromComponent(xModel));
+    if (pDocShell && pDocShell->GetView())
+        Show(*pDocShell->GetView());
+}
+}
+
+sal_Int32 CountMathTypeObjects(const SwDoc& rDoc)
+{
+    const SwDocShell* pDocShell = rDoc.GetDocShell();
+    if (!pDocShell)
+        return 0;
+    const uno::Reference<embed::XStorage> xStorage = pDocShell->getStorage();
+    if (!xStorage.is())
+        return 0;
+    sal_Int32 nCount = 0;
+    const SwNodes& rNodes = rDoc.GetNodes();
+    for (SwNodeOffset n(0); n < rNodes.Count(); ++n)
+        if (const SwOLENode* pOle = rNodes[n]->GetOLENode())
+            if (IsMathType(xStorage, pOle->GetOLEObj().GetCurrentPersistName()))
+                ++nCount;
+    return nCount;
+}
+
+void ScheduleHintBar(const SwView& rView)
+{
+    if (comphelper::LibreOfficeKit::isActive())
+        return;
+    const SwDocShell* pDocShell = rView.GetDocShell();
+    if (!pDocShell || !pDocShell->GetModel().is())
+        return;
+    // the view is built while the document opens; the frame shows infobars once it has opened
+    Application::PostUserEvent(LINK_NONMEMBER(
+        static_cast<void*>(new uno::WeakReferenceHelper(
+            uno::Reference<uno::XInterface>(pDocShell->GetModel(), uno::UNO_QUERY))),
+        ShowLater));
+}
+}
