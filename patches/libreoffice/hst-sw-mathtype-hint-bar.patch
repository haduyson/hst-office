+#include <swmodeltestbase.hxx>
+
+#include <comphelper/propertyvalue.hxx>
+#include <sfx2/viewfrm.hxx>
+#include <vcl/scheduler.hxx>
+
+#include <docsh.hxx>
+#include <view.hxx>
+
+namespace
+{
+/// The hint bar offering to convert MathType equations when a Writer document opens.
+class HstMathTypeHintBarTest : public SwModelTestBase
+{
+public:
+    HstMathTypeHintBarTest()
+        : SwModelTestBase(u"/sw/qa/core/data/ooxml/pass/"_ustr)
+    {
+    }
+
+    bool hasHintBar()
+    {
+        Scheduler::ProcessEventsToIdle(); // the bar comes once the document has opened
+        SwView* pView = getSwDocShell()->GetView();
+        CPPUNIT_ASSERT(pView);
+        return pView->GetViewFrame().HasInfoBarWithID(u"hst-mathtype");
+    }
+};
+}
+
+CPPUNIT_TEST_FIXTURE(HstMathTypeHintBarTest, testShownForMathType)
+{
+    // One MathType (Equation.DSMT4) OLE object with its WMF preview.
+    createSwDoc("fdo78906.docx");
+    CPPUNIT_ASSERT(hasHintBar());
+}
+
+CPPUNIT_TEST_FIXTURE(HstMathTypeHintBarTest, testNotShownWithoutMathType)
+{
+    // No embedded objects at all.
+    createSwDoc("fdo64256.docx");
+    CPPUNIT_ASSERT(!hasHintBar());
+}
+
+CPPUNIT_TEST_FIXTURE(HstMathTypeHintBarTest, testNotShownReadOnly)
+{
+    // The converter edits the document: nothing to offer when it cannot be edited.
+    loadFromFile(u"fdo78906.docx", { comphelper::makePropertyValue(u"ReadOnly"_ustr, true) });
+    CPPUNIT_ASSERT(getSwDocShell()->IsReadOnly());
+    CPPUNIT_ASSERT(!hasHintBar());
+}
+
