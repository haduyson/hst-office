+/// MathType 3-7 (Equation.DSMT4), as the CLSID property of a Writer embedded object names it
+constexpr std::u16string_view MATHTYPE_CLSID = u"0002CE03-0000-0000-C000-000000000046";
+
+/// A document's MathType equations stay MathType OLE objects through open and save: Word and
+/// MathType must still open and edit them. Converting them to HST formulas is a separate command;
+/// nothing else may turn them into pictures or formulas.
+class HstMathTypeKeptOleTest : public SwModelTestBase
+{
+public:
+    HstMathTypeKeptOleTest()
+        : SwModelTestBase(u"/sw/qa/uibase/hst/data/"_ustr)
+    {
+    }
+
+    /// The number of embedded objects of the current document, and how many of them are MathType.
+    std::pair<sal_Int32, sal_Int32> countObjects()
+    {
+        uno::Reference<text::XTextEmbeddedObjectsSupplier> xSupplier(mxComponent,
+                                                                     uno::UNO_QUERY_THROW);
+        uno::Reference<container::XNameAccess> xObjects = xSupplier->getEmbeddedObjects();
+        const uno::Sequence<OUString> aNames = xObjects->getElementNames();
+        sal_Int32 nMathType = 0;
+        for (const OUString& rName : aNames)
+        {
+            uno::Reference<beans::XPropertySet> xObject(xObjects->getByName(rName),
+                                                        uno::UNO_QUERY_THROW);
+            if (getProperty<OUString>(xObject, u"CLSID"_ustr).equalsIgnoreAsciiCase(MATHTYPE_CLSID))
+                ++nMathType;
+        }
+        return { aNames.getLength(), nMathType };
+    }
+
+    /// The saved .docx holds nEquations MathType OLE objects (w:object, o:OLEObject ProgID
+    /// Equation.DSMT4 with its embedded compound file) and no picture in their place.
+    void checkSavedDocx(sal_Int32 nEquations)
+    {
+        xmlDocUniquePtr pXmlDoc = parseExport(u"word/document.xml"_ustr);
+        CPPUNIT_ASSERT(pXmlDoc);
+        assertXPath(pXmlDoc, "//w:object", nEquations);
+        assertXPath(pXmlDoc, "//w:object/o:OLEObject[@ProgID='Equation.DSMT4']", nEquations);
+        assertXPath(pXmlDoc, "//w:drawing", 0);
+        assertXPath(pXmlDoc, "//m:oMath", 0);
+        xmlDocUniquePtr pRels = parseExport(u"word/_rels/document.xml.rels"_ustr);
+        assertXPath(pRels,
+                    "/rels:Relationships/rels:Relationship[@Type='http://schemas."
+                    "openxmlformats.org/officeDocument/2006/relationships/oleObject']",
+                    nEquations);
+    }
+};
+}
+
+CPPUNIT_TEST_FIXTURE(HstMathTypeKeptOleTest, testOpenSaveDocxKeepsMathTypeObjects)
+{
+    // Two MathType objects with their WMF result picture (payload of the LibreOffice fixture
+    // fdo78906.docx), written by HST for this test.
+    createSwDoc("hst-mathtype-ole-kept.rtf");
+    CPPUNIT_ASSERT_EQUAL((std::pair<sal_Int32, sal_Int32>(2, 2)), countObjects());
+
+    // Saved as .docx: still OLE objects, not pictures
+    saveAndReload(TestFilter::DOCX);
+    checkSavedDocx(2);
+    CPPUNIT_ASSERT_EQUAL((std::pair<sal_Int32, sal_Int32>(2, 2)), countObjects());
+
+    // .docx opened and saved again: unchanged
+    saveAndReload(TestFilter::DOCX);
+    checkSavedDocx(2);
+    CPPUNIT_ASSERT_EQUAL((std::pair<sal_Int32, sal_Int32>(2, 2)), countObjects());
+}
+
+CPPUNIT_TEST_FIXTURE(HstMathTypeKeptOleTest, testClosedInfoBarKeepsMathTypeObjects)
+{
+    // Opened as a user does (visible, editable): the MathType info bar counts the objects by their
+    // stored streams. Closing it ("Đóng", i.e. not converting) must leave the objects as they were.
+    createSwDoc("hst-mathtype-ole-kept.rtf");
+    saveAndReload(TestFilter::DOCX);
+    {
+        // Pictures and objects as placeholders: painting a MathType preview needs its fonts
+        // (System, MT Extra), which the test environment does not provide.
+        SwWrtShell* pWrtShell = getSwDocShell()->GetWrtShell();
+        SwViewOption aOptions(*pWrtShell->GetViewOptions());
+        aOptions.SetGraphic(false);
+        pWrtShell->ApplyViewOptions(aOptions);
+    }
+    Scheduler::ProcessEventsToIdle();
+    SfxViewFrame& rFrame = getSwDocShell()->GetView()->GetViewFrame();
+#ifndef _WIN32 // on Windows the bar is not shown where MathType is installed
+    CPPUNIT_ASSERT(rFrame.HasInfoBarWithID(u"hst-mathtype"));
+#endif
+    rFrame.RemoveInfoBar(u"hst-mathtype");
+    Scheduler::ProcessEventsToIdle();
+    CPPUNIT_ASSERT_EQUAL((std::pair<sal_Int32, sal_Int32>(2, 2)), countObjects());
+
+    saveAndReload(TestFilter::DOCX);
+    checkSavedDocx(2);
+    CPPUNIT_ASSERT_EQUAL((std::pair<sal_Int32, sal_Int32>(2, 2)), countObjects());
+}
