HST Office: a Writer document with MathType equations (Equation.DSMT*) kept as OLE objects
shows them as their preview picture, and nothing tells the user that HST can turn them into
editable formulas. When such a document opens editable, an info bar names the number of
MathType equations and offers [Convert Equations], which runs HST's formula converter
Test only: the info bar tests without the info bar.

--- a/sw/CppunitTest_sw_uibase_uiview.mk
+++ b/sw/CppunitTest_sw_uibase_uiview.mk
@@ -15,6 +15,7 @@
 
 $(eval $(call gb_CppunitTest_add_exception_objects,sw_uibase_uiview, \
     sw/qa/uibase/uiview/uiview \
+    sw/qa/uibase/hst/mathtypehintbar \
 ))
 
 $(eval $(call gb_CppunitTest_use_libraries,sw_uibase_uiview, \
--- a/sw/qa/uibase/hst/mathtypehintbar.cxx
+++ b/sw/qa/uibase/hst/mathtypehintbar.cxx
@@ -0,0 +1,60 @@
