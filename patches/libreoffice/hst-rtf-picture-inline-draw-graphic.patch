@@ -1408,6 +1409,39 @@ CPPUNIT_TEST_FIXTURE(Test, testHstPictureShownSizeKept)
     CPPUNIT_ASSERT_LESSEQUAL(sal_Int32(2), std::abs(aSize.Height - aShown.Height));
 }
 
+// HST Office
+CPPUNIT_TEST_FIXTURE(Test, testHstInlineDrawPictureStaysInline)
+{
+    // The .docx import makes an inline picture a draw object anchored as character. The RTF export wrote it as a
+    // floating \shp, which came back anchored at the character with wrap through: it took no room and lay over the
+    // text. It is now an inline \pict.
+    createSwDoc();
+    Graphic aGraphic(Bitmap(Size(80, 60), vcl::PixelFormat::N24_BPP));
+    uno::Reference<lang::XMultiServiceFactory> xFactory(mxComponent, uno::UNO_QUERY);
+    uno::Reference<drawing::XShape> xShape(
+        xFactory->createInstance(u"com.sun.star.drawing.GraphicObjectShape"_ustr), uno::UNO_QUERY);
+    uno::Reference<beans::XPropertySet> xShapeProps(xShape, uno::UNO_QUERY);
+    xShapeProps->setPropertyValue(u"AnchorType"_ustr,
+                                  uno::Any(text::TextContentAnchorType_AS_CHARACTER));
+    uno::Reference<text::XTextDocument> xDocument(mxComponent, uno::UNO_QUERY);
+    uno::Reference<text::XText> xText = xDocument->getText();
+    xText->insertString(xText->getEnd(), u"before "_ustr, false);
+    xText->insertTextContent(xText->getEnd(),
+                             uno::Reference<text::XTextContent>(xShape, uno::UNO_QUERY), false);
+    xShapeProps->setPropertyValue(u"Graphic"_ustr, uno::Any(aGraphic.GetXGraphic()));
+    const awt::Size aShown(4000, 3000);
+    xShape->setSize(aShown);
+
+    saveAndReload(TestFilter::RTF);
+    CPPUNIT_ASSERT_EQUAL(1, getShapes());
+    uno::Reference<drawing::XShape> xBack = getShape(1);
+    CPPUNIT_ASSERT_EQUAL(text::TextContentAnchorType_AS_CHARACTER,
+                         getProperty<text::TextContentAnchorType>(xBack, u"AnchorType"_ustr));
+    // within 1 twip (1.76 mm100)
+    CPPUNIT_ASSERT_LESSEQUAL(sal_Int32(2), std::abs(xBack->getSize().Width - aShown.Width));
+    CPPUNIT_ASSERT_LESSEQUAL(sal_Int32(2), std::abs(xBack->getSize().Height - aShown.Height));
+}
+
 } // end of anonymous namespace
 CPPUNIT_PLUGIN_IMPLEMENT();
 
