@@ -0,0 +1,83 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * Part of HST Office. This file is HST's own work and is not covered by the MPL.
+ */
+
+#include "rtfinlinedrawgraphic.hxx"
+
+#include <svtools/rtfkeywd.hxx>
+#include <svx/sdgcpitm.hxx>
+#include <svx/svddef.hxx>
+#include <svx/svdograf.hxx>
+#include <tools/stream.hxx>
+#include <vcl/cvtgrf.hxx>
+#include <vcl/gfxlink.hxx>
+#include <vcl/graph.hxx>
+
+namespace sw::hst
+{
+namespace
+{
+/// The blip keyword of picture data RTF takes as it is, or nullptr.
+const char* NativeBlip(const GfxLink& rLink)
+{
+    switch (rLink.GetType())
+    {
+        case GfxLinkType::NativeJpg:
+            return OOO_STRING_SVTOOLS_RTF_JPEGBLIP;
+        case GfxLinkType::NativePng:
+            return OOO_STRING_SVTOOLS_RTF_PNGBLIP;
+        case GfxLinkType::NativeWmf:
+            return rLink.IsEMF() ? OOO_STRING_SVTOOLS_RTF_EMFBLIP : OOO_STRING_SVTOOLS_RTF_WMETAFILE;
+        default:
+            return nullptr;
+    }
+}
+
+bool IsCropped(const SdrGrafObj& rObj)
+{
+    const SdrGrafCropItem& rCrop = rObj.GetMergedItem(SDRATTR_GRAFCROP);
+    return rCrop.GetLeft() || rCrop.GetRight() || rCrop.GetTop() || rCrop.GetBottom();
+}
+}
+
+const char* RtfInlineDrawGraphic(const SdrObject& rObj, SvMemoryStream& rStream, Size& rShown, Size& rMapped)
+{
+    auto pGraf = dynamic_cast<const SdrGrafObj*>(&rObj);
+    if (!pGraf || pGraf->GetRotateAngle().get() || pGraf->GetShearAngle().get())
+        return nullptr;
+    // a cropped or mirrored picture is written as it is shown
+    const bool bAsShown = IsCropped(*pGraf) || pGraf->IsMirrored();
+    const Graphic aGraphic
+        = bAsShown ? pGraf->GetTransformedGraphic(SdrGrafObjTransformsAttrs::MIRROR) : pGraf->GetGraphic();
+    const GraphicType eType = aGraphic.GetType();
+    if (eType != GraphicType::Bitmap && eType != GraphicType::GdiMetafile)
+        return nullptr;
+
+    const char* pBlip = nullptr;
+    if (!bAsShown && aGraphic.IsGfxLink())
+    {
+        const GfxLink aLink = aGraphic.GetGfxLink();
+        pBlip = NativeBlip(aLink);
+        if (pBlip)
+            rStream.WriteBytes(aLink.GetData(), aLink.GetDataSize());
+    }
+    if (!pBlip)
+    {
+        const bool bBitmap = eType == GraphicType::Bitmap;
+        if (GraphicConverter::Export(rStream, aGraphic, bBitmap ? ConvertDataFormat::PNG : ConvertDataFormat::WMF)
+            != ERRCODE_NONE)
+            return nullptr;
+        pBlip = bBitmap ? OOO_STRING_SVTOOLS_RTF_PNGBLIP : OOO_STRING_SVTOOLS_RTF_WMETAFILE;
+    }
+    if (!rStream.TellEnd())
+        return nullptr;
+    rShown = pGraf->GetLogicRect().GetSize(); // twips: Writer's drawing layer
+    rMapped = eType == GraphicType::Bitmap ? aGraphic.GetSizePixel() : aGraphic.GetPrefSize();
+    return pBlip;
+}
+}
+
