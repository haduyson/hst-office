         case ww8::Frame::eDrawing:
         {
             const SdrObject* pSdrObj = rFrame.GetFrameFormat().FindRealSdrObject();
+            // HST Office: a .docx inline picture stays inline, not a floating shape over the text
+            if (pSdrObj && rFrame.IsInline() && FlyFrameDrawGraphic(*pSdrObj))
+                break;
             if (pSdrObj)
             {
                 m_aRunText->append("{" OOO_STRING_SVTOOLS_RTF_FIELD "{");
@@ -4927,6 +4931,20 @@ void RtfAttributeOutput::FlyFrameOLE(const SwFlyFrameFormat* pFlyFrameFormat, Sw
     FlyFrameOLEReplacement(pFlyFrameFormat, rOLENode, rSize);
 }
 
+bool RtfAttributeOutput::FlyFrameDrawGraphic(const SdrObject& rObj)
+{
+    SvMemoryStream aStream;
+    Size aShown;
+    Size aMapped;
+    const char* pBLIPType = sw::hst::RtfInlineDrawGraphic(rObj, aStream, aShown, aMapped);
+    if (!pBLIPType)
+        return false;
+    const sal_uInt8* pGraphicAry = static_cast<const sal_uInt8*>(aStream.GetData());
+    m_aRunText->append(ExportPICT(nullptr, aShown, aShown, aMapped, SwCropGrf(), pBLIPType, pGraphicAry,
+                                  aStream.TellEnd(), m_rExport));
+    return true;
+}
+
 void RtfAttributeOutput::FlyFrameGraphic(const SwFlyFrameFormat* pFlyFrameFormat,
                                          const SwGrfNode* pGrfNode)
 {
