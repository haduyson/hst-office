@@ -0,0 +1,29 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * Part of HST Office. This file is HST's own work and is not covered by the MPL.
+ */
+
+#pragma once
+
+#include <tools/gen.hxx>
+
+class SdrObject;
+class SvMemoryStream;
+
+namespace sw::hst
+{
+/** The picture RTF writes inline (\pict) for an as-character draw object that holds a graphic: the .docx import makes
+    a w:drawing inline picture such an object, and the RTF export wrote it as a floating \shp, which came back
+    anchored at the character with wrap through: it took no room and lay over the text.
+
+    Writes the picture data to rStream: the graphic's own JPEG, PNG, EMF or WMF data when it is not cropped or
+    mirrored, else (or for other formats) PNG for a bitmap and WMF for a vector graphic. rShown is the object's size and
+    rMapped the picture's pixel (bitmap) or preferred (vector) size, both as \picw / \pich need them.
+    Returns the blip keyword, or nullptr when an inline picture would not show the object (not a graphic, rotated,
+    sheared, or no picture data); the caller then writes the shape as before. */
+const char* RtfInlineDrawGraphic(const SdrObject& rObj, SvMemoryStream& rStream, Size& rShown, Size& rMapped);
+}
+
