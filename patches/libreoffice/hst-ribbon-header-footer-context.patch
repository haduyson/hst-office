+// HST Office: the page belongs to the sub-context held beside the shell's context
+static bool lcl_hstHasSubContext(const TabPage* pPage, vcl::EnumContext::Context eSub)
+{
+    return pPage && eSub != vcl::EnumContext::Context::Unknown && pPage->HasContext(eSub);
+}
