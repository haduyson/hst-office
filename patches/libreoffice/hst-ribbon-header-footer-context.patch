+void NotebookbarTabControlBase::HstSetSubContext( vcl::EnumContext::Context eSub )
+{
+    if (m_eHstSubContext == eSub)
+        return;
+    m_eHstSubContext = eSub;
+
+    sal_uInt16 nFirst = 0;
+    sal_uInt16 nDefault = 0;
+    for (int nChild = 0; nChild < GetPageCount(); ++nChild)
+    {
+        const sal_uInt16 nPageId = TabControl::GetPageId(nChild);
+        TabPage* pPage = GetTabPage(nPageId);
+        if (!pPage)
+            continue;
+        const bool bSub = lcl_hstHasSubContext(pPage, eSub);
+        SetPageVisible(nPageId, pPage->HasContext(eLastContext)
+                                    || pPage->HasContext(vcl::EnumContext::Context::Any) || bSub);
+        if (bSub && !nFirst)
+            nFirst = nPageId;
+        if (!nDefault && pPage->HasContext(vcl::EnumContext::Context::Default))
+            nDefault = nPageId;
+    }
+
+    // as in Office, entering a header or footer opens its tab; leaving it goes back to the default
+    // tab when the current one belonged to it
+    TabPage* pCurrent = GetTabPage(mnCurPageId);
+    if (nFirst)
+        SetCurPageId(nFirst);
+    else if (pCurrent && nDefault && !pCurrent->HasContext(eLastContext)
+             && !pCurrent->HasContext(vcl::EnumContext::Context::Any))
+        SetCurPageId(nDefault);
+
+    Resize();
+}
+
+namespace hst::ribbon
+{
+static NotebookbarTabControlBase* lcl_findTabControl(vcl::Window* pWindow)
+{
+    for (vcl::Window* pChild = pWindow->GetWindow(GetWindowType::FirstChild); pChild;
+         pChild = pChild->GetWindow(GetWindowType::Next))
+    {
+        if (auto* pTabs = dynamic_cast<NotebookbarTabControlBase*>(pChild))
+            return pTabs;
+        if (NotebookbarTabControlBase* pTabs = lcl_findTabControl(pChild))
+            return pTabs;
+    }
+    return nullptr;
+}
+
+void SetRibbonSubContext(const vcl::Window& rWindow, vcl::EnumContext::Context eSub)
+{
+    SystemWindow* pSystemWindow = rWindow.GetSystemWindow();
+    if (!pSystemWindow || !pSystemWindow->GetNotebookBar())
+        return; // no Tabbed notebookbar on this frame (other UI modes, LibreOfficeKit)
+    if (NotebookbarTabControlBase* pTabs = lcl_findTabControl(pSystemWindow->GetNotebookBar().get()))
+        pTabs->HstSetSubContext(eSub);
+}
+}
