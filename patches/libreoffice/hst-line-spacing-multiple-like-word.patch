@@ -0,0 +1,135 @@
+/* SPDX-License-Identifier: LicenseRef-HST-Proprietary */
+/* Copyright (c) HASON TECH. HST Office. */
+
+#include <sal/config.h>
+
+#include <svx/hstlinespacing.hxx>
+
+#include <rtl/ustrbuf.hxx>
+#include <tools/link.hxx>
+#include <unotools/localedatawrapper.hxx>
+#include <vcl/settings.hxx>
+#include <vcl/svapp.hxx>
+#include <vcl/weld/SpinButton.hxx>
+
+#include <algorithm>
+
+namespace svx::hstlinespacing
+{
+namespace
+{
+// More integer digits than this cannot be a line spacing; keep the arithmetic far from overflow.
+constexpr size_t MAX_INTEGER_DIGITS = 9;
+
+bool IsSpace(sal_Unicode c)
+{
+    // the no-break spaces some locales put between a number and "%"
+    return c == ' ' || c == '\t' || c == 0x00A0 || c == 0x202F;
+}
+
+std::u16string_view Trim(std::u16string_view aText)
+{
+    while (!aText.empty() && IsSpace(aText.front()))
+        aText.remove_prefix(1);
+    while (!aText.empty() && IsSpace(aText.back()))
+        aText.remove_suffix(1);
+    return aText;
+}
+
+bool IsDecimalSep(sal_Unicode c, std::u16string_view rDecimalSep)
+{
+    return c == ',' || c == '.' || (rDecimalSep.size() == 1 && c == rDecimalSep.front());
+}
+
+const OUString& LocaleDecimalSep()
+{
+    return Application::GetSettings().GetLocaleDataWrapper().getNumDecimalSep();
+}
+
+OUString FormatHdl(void*, sal_Int64 nValue) { return FormatMultiple(nValue, LocaleDecimalSep()); }
+
+std::optional<int> ParseHdl(void*, const OUString& rText)
+{
+    std::optional<sal_Int64> oPercent = ParseMultiple(rText, LocaleDecimalSep());
+    if (!oPercent)
+        return {};
+    return static_cast<int>(ClampMultiple(*oPercent));
+}
+}
+
+std::optional<sal_Int64> ParseMultiple(std::u16string_view rText, std::u16string_view rDecimalSep)
+{
+    std::u16string_view aText = Trim(rText);
+    const bool bPercent = !aText.empty() && (aText.back() == '%' || aText.back() == 0xFF05);
+    if (bPercent)
+        aText = Trim(aText.substr(0, aText.size() - 1));
+
+    // digits with at most one decimal separator, at least one digit
+    std::u16string_view aInteger = aText;
+    std::u16string_view aFraction;
+    for (size_t i = 0; i < aText.size(); ++i)
+    {
+        const sal_Unicode c = aText[i];
+        if (c >= '0' && c <= '9')
+            continue;
+        if (!IsDecimalSep(c, rDecimalSep) || aInteger.size() != aText.size())
+            return {};
+        aInteger = aText.substr(0, i);
+        aFraction = aText.substr(i + 1);
+    }
+    if (aInteger.empty() && aFraction.empty())
+        return {};
+
+    while (aInteger.size() > 1 && aInteger.front() == '0')
+        aInteger.remove_prefix(1);
+    sal_Int64 nInteger = 0;
+    if (aInteger.size() > MAX_INTEGER_DIGITS)
+        nInteger = MAX_PERCENT * 100; // far beyond the range: clamped by the caller
+    else
+        for (sal_Unicode c : aInteger)
+            nInteger = nInteger * 10 + (c - '0');
+
+    auto nFractionDigit = [&aFraction](size_t n) -> sal_Int64 {
+        return n < aFraction.size() ? aFraction[n] - '0' : 0;
+    };
+
+    if (bPercent) // whole percent, rounded half up
+        return nInteger + (nFractionDigit(0) >= 5 ? 1 : 0);
+
+    // lines -> percent: two decimals of lines are one percent, the third one rounds half up
+    return nInteger * 100 + nFractionDigit(0) * 10 + nFractionDigit(1)
+           + (nFractionDigit(2) >= 5 ? 1 : 0);
+}
+
+sal_Int64 ClampMultiple(sal_Int64 nPercent) { return std::clamp(nPercent, MIN_PERCENT, MAX_PERCENT); }
+
+OUString FormatMultiple(sal_Int64 nPercent, std::u16string_view rDecimalSep)
+{
+    const bool bNegative = nPercent < 0;
+    const sal_Int64 nAbs = bNegative ? -nPercent : nPercent;
+    const sal_Int64 nCents = nAbs % 100;
+    OUStringBuffer aBuf;
+    if (bNegative)
+        aBuf.append('-');
+    aBuf.append(nAbs / 100);
+    aBuf.append(rDecimalSep);
+    if (nCents < 10)
+        aBuf.append('0');
+    aBuf.append(nCents);
+    return aBuf.makeStringAndClear();
+}
+
+void SetupMultipleField(weld::SpinButton& rField)
+{
+    // digits first: the range and the steps below are values in hundredths of a line
+    rField.set_digits(2);
+    rField.set_range(MIN_PERCENT, MAX_PERCENT);
+    rField.set_increments(50, 100);
+    rField.set_value_formatter(LINK_NONMEMBER(nullptr, FormatHdl));
+    rField.set_text_parser(LINK_NONMEMBER(nullptr, ParseHdl));
+    rField.set_width_chars(6);
+    rField.set_text(FormatMultiple(rField.get_value(), LocaleDecimalSep()));
+}
+}
