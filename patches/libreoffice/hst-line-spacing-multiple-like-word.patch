+/* SPDX-License-Identifier: LicenseRef-HST-Proprietary */
+/* Copyright (c) HASON TECH. HST Office. */
+
+#include <sal/config.h>
+
+#include <cppunit/TestAssert.h>
+#include <cppunit/TestFixture.h>
+#include <cppunit/extensions/HelperMacros.h>
+#include <cppunit/plugin/TestPlugIn.h>
+
+#include <svx/hstlinespacing.hxx>
+
+using namespace svx::hstlinespacing;
+
+namespace
+{
+// ParseMultiple, empty optional as -1 for readable asserts
+sal_Int64 parse(std::u16string_view rText, std::u16string_view rSep = u",")
+{
+    return ParseMultiple(rText, rSep).value_or(-1);
+}
+
+class HstLineSpacingTest : public CppUnit::TestFixture
+{
+public:
+    // "1,3" and "1.3" (Word style, any locale) and "130%" are all 130 %
+    void testWordStyleInput()
+    {
+        CPPUNIT_ASSERT_EQUAL(sal_Int64(130), parse(u"1,3"));
+        CPPUNIT_ASSERT_EQUAL(sal_Int64(130), parse(u"1.3"));
+        CPPUNIT_ASSERT_EQUAL(sal_Int64(130), parse(u"130%"));
+        CPPUNIT_ASSERT_EQUAL(sal_Int64(130), parse(u"130 %"));
+        CPPUNIT_ASSERT_EQUAL(sal_Int64(130), parse(u"1,30"));
+        CPPUNIT_ASSERT_EQUAL(sal_Int64(130), parse(u" 1,3 "));
+        CPPUNIT_ASSERT_EQUAL(sal_Int64(130), parse(u"1.3", u"."));
+        CPPUNIT_ASSERT_EQUAL(sal_Int64(115), parse(u"1,15"));
+        CPPUNIT_ASSERT_EQUAL(sal_Int64(100), parse(u"1"));
+        CPPUNIT_ASSERT_EQUAL(sal_Int64(250), parse(u"2,5"));
+        CPPUNIT_ASSERT_EQUAL(sal_Int64(50), parse(u",5"));
+        CPPUNIT_ASSERT_EQUAL(sal_Int64(100), parse(u"1."));
+        // a plain number is lines, as in Word: "130" is 130 lines (beyond the range)
+        CPPUNIT_ASSERT_EQUAL(sal_Int64(13000), parse(u"130"));
+        // the locale's own separator when it is neither "," nor "."
+        CPPUNIT_ASSERT_EQUAL(sal_Int64(130), parse(u"1٫3", u"٫"));
+    }
+
+    // whole percent: half up on the third decimal of lines or the first decimal of a percentage
+    void testRounding()
+    {
+        CPPUNIT_ASSERT_EQUAL(sal_Int64(113), parse(u"1,125"));
+        CPPUNIT_ASSERT_EQUAL(sal_Int64(112), parse(u"1,1249"));
+        CPPUNIT_ASSERT_EQUAL(sal_Int64(133), parse(u"1,3333"));
+        CPPUNIT_ASSERT_EQUAL(sal_Int64(131), parse(u"130,5%"));
+        CPPUNIT_ASSERT_EQUAL(sal_Int64(130), parse(u"130,4%"));
+    }
+
+    void testInvalidInput()
+    {
+        CPPUNIT_ASSERT_EQUAL(sal_Int64(-1), parse(u""));
+        CPPUNIT_ASSERT_EQUAL(sal_Int64(-1), parse(u"%"));
+        CPPUNIT_ASSERT_EQUAL(sal_Int64(-1), parse(u","));
+        CPPUNIT_ASSERT_EQUAL(sal_Int64(-1), parse(u"1,2,3"));
+        CPPUNIT_ASSERT_EQUAL(sal_Int64(-1), parse(u"1.000,5"));
+        CPPUNIT_ASSERT_EQUAL(sal_Int64(-1), parse(u"-1"));
+        CPPUNIT_ASSERT_EQUAL(sal_Int64(-1), parse(u"abc"));
+        CPPUNIT_ASSERT_EQUAL(sal_Int64(-1), parse(u"1,3 dòng"));
+    }
+
+    // Word's range, 0.06 to 132 lines
+    void testRange()
+    {
+        CPPUNIT_ASSERT_EQUAL(sal_Int64(6), MIN_PERCENT);
+        CPPUNIT_ASSERT_EQUAL(sal_Int64(13200), MAX_PERCENT);
+        CPPUNIT_ASSERT_EQUAL(sal_Int64(6), ClampMultiple(*ParseMultiple(u"0,01")));
+        CPPUNIT_ASSERT_EQUAL(sal_Int64(6), ClampMultiple(*ParseMultiple(u"0,06")));
+        CPPUNIT_ASSERT_EQUAL(sal_Int64(13200), ClampMultiple(*ParseMultiple(u"132")));
+        CPPUNIT_ASSERT_EQUAL(sal_Int64(13200), ClampMultiple(*ParseMultiple(u"133")));
+        CPPUNIT_ASSERT_EQUAL(sal_Int64(13200), ClampMultiple(*ParseMultiple(u"99999999999999")));
+        CPPUNIT_ASSERT_EQUAL(sal_Int64(6), ClampMultiple(*ParseMultiple(u"1%")));
+        CPPUNIT_ASSERT_EQUAL(sal_Int64(130), ClampMultiple(130));
+    }
+
+    // the value is shown as lines with two decimals in the locale's separator
+    void testFormat()
+    {
+        CPPUNIT_ASSERT_EQUAL(u"1,30"_ustr, FormatMultiple(130, u","));
+        CPPUNIT_ASSERT_EQUAL(u"1.30"_ustr, FormatMultiple(130, u"."));
+        CPPUNIT_ASSERT_EQUAL(u"1,15"_ustr, FormatMultiple(115, u","));
+        CPPUNIT_ASSERT_EQUAL(u"1,00"_ustr, FormatMultiple(100, u","));
+        CPPUNIT_ASSERT_EQUAL(u"0,06"_ustr, FormatMultiple(6, u","));
+        CPPUNIT_ASSERT_EQUAL(u"132,00"_ustr, FormatMultiple(13200, u","));
+        // what is shown reads back as the same value
+        for (sal_Int64 n : { 6, 100, 115, 125, 130, 250, 300, 13200 })
+            CPPUNIT_ASSERT_EQUAL(n, parse(FormatMultiple(n, u",")));
+    }
+
+    CPPUNIT_TEST_SUITE(HstLineSpacingTest);
+    CPPUNIT_TEST(testWordStyleInput);
+    CPPUNIT_TEST(testRounding);
+    CPPUNIT_TEST(testInvalidInput);
+    CPPUNIT_TEST(testRange);
+    CPPUNIT_TEST(testFormat);
+    CPPUNIT_TEST_SUITE_END();
+};
+
+CPPUNIT_TEST_SUITE_REGISTRATION(HstLineSpacingTest);
+}
+
+CPPUNIT_PLUGIN_IMPLEMENT();
