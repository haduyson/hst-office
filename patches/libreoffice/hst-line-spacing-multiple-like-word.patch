+/* SPDX-License-Identifier: LicenseRef-HST-Proprietary */
+/* Copyright (c) HASON TECH. HST Office. */
+
+#pragma once
+
+#include <rtl/ustring.hxx>
+#include <sal/types.h>
+#include <svx/svxdllapi.h>
+
+#include <optional>
+#include <string_view>
+
