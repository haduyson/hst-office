+/** "Multiple" (proportional) line spacing shown and typed in lines, as in Word.
+
+    The paragraph attribute keeps the spacing in percent (SvxLineSpacingItem::GetPropLineSpace,
+    DOCX w:line/240); the fields of the Paragraph dialog and of the Line Spacing popup show it as a
+    number of lines with two decimals ("1,30" for 130 %) and read what the user types:
+
+    - a plain number is a number of lines: "1,3", "1.3" and "1,30" are 130 %;
+    - a number followed by "%" is a percentage: "130%" and "130 %" are 130 %;
+    - either "," or "." is the decimal separator, whatever the locale (a Word user types "1.3"
+      in a Vietnamese UI); the locale's own separator is accepted too.
+
+    The range is Word's: 0.06 to 132 lines (6 % to 13200 %).
+ */
+namespace svx::hstlinespacing
+{
+/// Smallest "Multiple" line spacing in percent (0.06 lines).
+constexpr sal_Int64 MIN_PERCENT = 6;
+/// Largest "Multiple" line spacing in percent (132 lines).
+constexpr sal_Int64 MAX_PERCENT = 13200;
+
+/** Percent value of the text typed in a "Multiple" field, not yet limited to the range.
+    Rounds half up to a whole percent (to 0.01 lines). Empty when the text is not a number. */
+SVX_DLLPUBLIC std::optional<sal_Int64> ParseMultiple(std::u16string_view rText,
+                                                     std::u16string_view rDecimalSep = u",");
+
+/// nPercent limited to MIN_PERCENT..MAX_PERCENT.
+SVX_DLLPUBLIC sal_Int64 ClampMultiple(sal_Int64 nPercent);
+
+/// The lines shown for nPercent, with two decimals: 130 -> "1,30" for the separator ",".
+SVX_DLLPUBLIC OUString FormatMultiple(sal_Int64 nPercent, std::u16string_view rDecimalSep);
+
+/** Make rField the "Multiple" field: its value is the percentage (two digits, so the value 130
+    is shown as 1.30 lines), formatted and parsed as above with the decimal separator of the
+    locale settings, range 0.06 to 132 lines, steps of 0.5 lines like Word. */
+SVX_DLLPUBLIC void SetupMultipleField(weld::SpinButton& rField);
+}
