+namespace sc::hsttable
+{
+bool GetDataRows(const ScDBData& rData, SCROW& rFirstRow, SCROW& rLastRow)
+{
+    ScRange aArea;
+    rData.GetArea(aArea);
+    rFirstRow = aArea.aStart.Row() + (rData.HasHeader() ? 1 : 0);
+    rLastRow = aArea.aEnd.Row() - (rData.HasTotals() ? 1 : 0);
+    return rFirstRow <= rLastRow;
+}
+
+bool IsSameColumnFormula(const ScFormulaCell& rCell, const ScFormulaCell& rOther)
+{
+    if (rCell.GetMatrixFlag() != ScMatrixMode::NONE || rOther.GetMatrixFlag() != ScMatrixMode::NONE)
+        return false;
+    const ScFormulaCellGroupRef& xGroup = rCell.GetCellGroup();
+    if (xGroup && xGroup.get() == rOther.GetCellGroup().get())
+        return true;
+    if (rCell.CompareByTokenArray(rOther) != ScFormulaCell::NotEqual)
+        return true;
+    // Formulas that cannot be shared (structured references to the same row, for example) are
+    // compared by their R1C1 text, which is the same for a formula filled down a column.
+    constexpr formula::FormulaGrammar::Grammar eGrammar
+        = formula::FormulaGrammar::GRAM_ENGLISH_XL_R1C1;
+    return rCell.GetFormula(eGrammar) == rOther.GetFormula(eGrammar);
+}
+
+const ScFormulaCell* GetCalculatedColumnCell(const ScDocument& rDoc, const ScDBData& rData,
+                                             SCCOL nCol, SCROW nIgnoreRow)
+{
+    ScRange aArea;
+    rData.GetArea(aArea);
+    SCROW nFirstRow = 0;
+    SCROW nLastRow = 0;
+    if (nCol < aArea.aStart.Col() || nCol > aArea.aEnd.Col()
+        || !GetDataRows(rData, nFirstRow, nLastRow))
+        return nullptr;
+
+    const SCTAB nTab = aArea.aStart.Tab();
+    const ScFormulaCell* pColumnCell = nullptr;
+    for (SCROW nRow = nFirstRow; nRow <= nLastRow; ++nRow)
+    {
+        if (nRow == nIgnoreRow)
+            continue;
+        const ScFormulaCell* pCell = rDoc.GetFormulaCell(ScAddress(nCol, nRow, nTab));
+        if (!pCell || pCell->GetMatrixFlag() != ScMatrixMode::NONE)
+            return nullptr;
+        if (!pColumnCell)
+            pColumnCell = pCell;
+        else if (!IsSameColumnFormula(*pColumnCell, *pCell))
+            return nullptr;
+        // The rest of a formula group holds the same formula: skip it.
+        if (pCell->IsShared())
+            nRow = std::max(nRow, std::min(nLastRow, pCell->GetSharedTopRow()
+                                                         + pCell->GetSharedLength() - 1));
+    }
+    return pColumnCell;
+}
+}
