+namespace
+{
+class ScHstTableInputTest : public ScModelTestBase
+{
+public:
+    ScHstTableInputTest()
+        : ScModelTestBase(u"sc/qa/unit/uicalc/data"_ustr)
+    {
+    }
+
+protected:
+    /** A1:C3 as the table "Table1": Item / Price / Total, rows a 10 and b 20. With
+        bCalculated, C2:C3 hold =B2*2 and =B3*2. */
+    ScDBData* createTable(bool bCalculated);
+    ScRange tableArea();
+};
+
+ScDBData* ScHstTableInputTest::createTable(bool bCalculated)
+{
+    createScDoc();
+    ScDocument* pDoc = getScDoc();
+    pDoc->InitDrawLayer(getScDocShell()); // the default table styles
+    pDoc->SetString(0, 0, 0, u"Item"_ustr);
+    pDoc->SetString(1, 0, 0, u"Price"_ustr);
+    pDoc->SetString(2, 0, 0, u"Total"_ustr);
+    pDoc->SetString(0, 1, 0, u"a"_ustr);
+    pDoc->SetValue(1, 1, 0, 10.0);
+    pDoc->SetString(0, 2, 0, u"b"_ustr);
+    pDoc->SetValue(1, 2, 0, 20.0);
+    if (bCalculated)
+    {
+        pDoc->SetString(2, 1, 0, u"=B2*2"_ustr);
+        pDoc->SetString(2, 2, 0, u"=B3*2"_ustr);
+    }
+
+    auto pNew = std::make_unique<ScDBData>(u"Table1"_ustr, 0, 0, 0, 2, 2, true, true, false,
+                                           u""_ustr, u"TableStyleMedium2"_ustr);
+    pNew->SetAutoFilter(true);
+    pDoc->ApplyFlagsTab(0, 0, 2, 0, 0, ScMF::Auto);
+    CPPUNIT_ASSERT(pDoc->GetDBCollection()->getNamedDBs().insert(std::move(pNew)));
+    ScDBData* pData = pDoc->GetDBCollection()->getNamedDBs().findByUpperName(u"TABLE1"_ustr);
+    CPPUNIT_ASSERT(pData);
+    pData->RefreshTableColumnNames(pDoc);
+    return pData;
+}
+
+ScRange ScHstTableInputTest::tableArea()
+{
+    ScDBData* pData
+        = getScDoc()->GetDBCollection()->getNamedDBs().findByUpperName(u"TABLE1"_ustr);
+    CPPUNIT_ASSERT(pData);
+    ScRange aArea;
+    pData->GetArea(aArea);
+    return aArea;
+}
+}
+
+// A formula typed into an empty table column fills every data row; Ctrl+Z undoes only the fill.
+CPPUNIT_TEST_FIXTURE(ScHstTableInputTest, testCalculatedColumnFill)
+{
+    createTable(false);
+    ScDocument* pDoc = getScDoc();
+
+    insertStringToCell(u"C2"_ustr, u"=B2*2");
+    CPPUNIT_ASSERT_EQUAL(u"=B3*2"_ustr, pDoc->GetFormula(2, 2, 0));
+    CPPUNIT_ASSERT_EQUAL(40.0, pDoc->GetValue(2, 2, 0));
+    CPPUNIT_ASSERT(sc::hsttable::GetCalculatedColumnCell(
+        *pDoc, *pDoc->GetDBCollection()->getNamedDBs().findByUpperName(u"TABLE1"_ustr), 2));
+    // the table itself does not grow
+    CPPUNIT_ASSERT_EQUAL(ScRange(0, 0, 0, 2, 2, 0), tableArea());
+
+    dispatchCommand(mxComponent, u".uno:Undo"_ustr, {});
+    CPPUNIT_ASSERT_EQUAL(CELLTYPE_NONE, pDoc->GetCellType(ScAddress(2, 2, 0)));
+    CPPUNIT_ASSERT_EQUAL(u"=B2*2"_ustr, pDoc->GetFormula(2, 1, 0));
+
+    // A new formula typed into a calculated column replaces the formula of the whole column.
+    dispatchCommand(mxComponent, u".uno:Redo"_ustr, {});
+    CPPUNIT_ASSERT_EQUAL(u"=B3*2"_ustr, pDoc->GetFormula(2, 2, 0));
+    insertStringToCell(u"C3"_ustr, u"=B3*3");
+    CPPUNIT_ASSERT_EQUAL(u"=B2*3"_ustr, pDoc->GetFormula(2, 1, 0));
+    CPPUNIT_ASSERT_EQUAL(30.0, pDoc->GetValue(2, 1, 0));
+}
+
+// A column with other content keeps it: no fill.
+CPPUNIT_TEST_FIXTURE(ScHstTableInputTest, testCalculatedColumnKeepsData)
+{
+    createTable(false);
+    ScDocument* pDoc = getScDoc();
+    pDoc->SetValue(2, 2, 0, 5.0);
+
+    insertStringToCell(u"C2"_ustr, u"=B2*2");
+    CPPUNIT_ASSERT_EQUAL(5.0, pDoc->GetValue(2, 2, 0));
+    CPPUNIT_ASSERT_EQUAL(CELLTYPE_VALUE, pDoc->GetCellType(ScAddress(2, 2, 0)));
+}
+
+// Typing below the table adds a row: it takes the column formulas and the formatting of the row
+// above, the autofilter range and the structured references follow.
+CPPUNIT_TEST_FIXTURE(ScHstTableInputTest, testAutoExpandRow)
+{
+    createTable(true);
+    ScDocument* pDoc = getScDoc();
+    pDoc->ApplyAttr(1, 2, 0, SvxBrushItem(COL_YELLOW, ATTR_BACKGROUND));
+    pDoc->SetString(5, 0, 0, u"=SUM(Table1[Price])"_ustr);
+    CPPUNIT_ASSERT_EQUAL(30.0, pDoc->GetValue(5, 0, 0));
+
+    insertStringToCell(u"A4"_ustr, u"c");
+    CPPUNIT_ASSERT_EQUAL(ScRange(0, 0, 0, 2, 3, 0), tableArea());
+    CPPUNIT_ASSERT_EQUAL(u"c"_ustr, pDoc->GetString(0, 3, 0));
+    CPPUNIT_ASSERT_EQUAL(u"=B4*2"_ustr, pDoc->GetFormula(2, 3, 0));
+    CPPUNIT_ASSERT_EQUAL(COL_YELLOW, pDoc->GetAttr(1, 3, 0, ATTR_BACKGROUND).GetColor());
+
+    ScQueryParam aQuery;
+    pDoc->GetDBCollection()->getNamedDBs().findByUpperName(u"TABLE1"_ustr)->GetQueryParam(aQuery);
+    CPPUNIT_ASSERT_EQUAL(SCROW(3), aQuery.nRow2);
+
+    // the new row is a table row now: no further growth, the column formula follows the input
+    insertStringToCell(u"B4"_ustr, u"30");
+    CPPUNIT_ASSERT_EQUAL(ScRange(0, 0, 0, 2, 3, 0), tableArea());
+    CPPUNIT_ASSERT_EQUAL(60.0, pDoc->GetValue(2, 3, 0));
+    CPPUNIT_ASSERT_EQUAL(60.0, pDoc->GetValue(5, 0, 0));
+}
+
+// Ctrl+Z right after the growth undoes only the growth and keeps the typed content.
+CPPUNIT_TEST_FIXTURE(ScHstTableInputTest, testAutoExpandUndo)
+{
+    createTable(true);
+    ScDocument* pDoc = getScDoc();
+
+    insertStringToCell(u"A4"_ustr, u"c");
+    CPPUNIT_ASSERT_EQUAL(ScRange(0, 0, 0, 2, 3, 0), tableArea());
+    CPPUNIT_ASSERT(sc::hsttable::IsAutoExpansionUndoable(*getScDocShell()));
+
+    dispatchCommand(mxComponent, u".uno:Undo"_ustr, {});
+    CPPUNIT_ASSERT_EQUAL(ScRange(0, 0, 0, 2, 2, 0), tableArea());
+    CPPUNIT_ASSERT_EQUAL(u"c"_ustr, pDoc->GetString(0, 3, 0));
+    CPPUNIT_ASSERT_EQUAL(CELLTYPE_NONE, pDoc->GetCellType(ScAddress(2, 3, 0)));
+    CPPUNIT_ASSERT(!sc::hsttable::IsAutoExpansionUndoable(*getScDocShell()));
+
+    dispatchCommand(mxComponent, u".uno:Undo"_ustr, {});
+    CPPUNIT_ASSERT_EQUAL(CELLTYPE_NONE, pDoc->GetCellType(ScAddress(0, 3, 0)));
+
+    dispatchCommand(mxComponent, u".uno:Redo"_ustr, {});
+    dispatchCommand(mxComponent, u".uno:Redo"_ustr, {});
+    CPPUNIT_ASSERT_EQUAL(ScRange(0, 0, 0, 2, 3, 0), tableArea());
+    CPPUNIT_ASSERT_EQUAL(u"=B4*2"_ustr, pDoc->GetFormula(2, 3, 0));
+
+    // the dedicated command undoes the growth only while it is the last step
+    dispatchCommand(mxComponent, u".uno:HstTableUndoAutoExpand"_ustr, {});
+    CPPUNIT_ASSERT_EQUAL(ScRange(0, 0, 0, 2, 2, 0), tableArea());
+    dispatchCommand(mxComponent, u".uno:HstTableUndoAutoExpand"_ustr, {});
+    CPPUNIT_ASSERT_EQUAL(u"c"_ustr, pDoc->GetString(0, 3, 0));
+}
+
+// Typing right of the table adds a column with a generated header and an autofilter button;
+// typing into the header row right of it names the new column.
+CPPUNIT_TEST_FIXTURE(ScHstTableInputTest, testAutoExpandColumn)
+{
+    createTable(false);
+    ScDocument* pDoc = getScDoc();
+
+    insertStringToCell(u"D2"_ustr, u"x");
+    CPPUNIT_ASSERT_EQUAL(ScRange(0, 0, 0, 3, 2, 0), tableArea());
+    CPPUNIT_ASSERT_EQUAL(u"Column4"_ustr, pDoc->GetString(3, 0, 0));
+    CPPUNIT_ASSERT(pDoc->GetAttr(3, 0, 0, ATTR_MERGE_FLAG).HasAutoFilter());
+
+    insertStringToCell(u"E1"_ustr, u"Qty");
+    CPPUNIT_ASSERT_EQUAL(ScRange(0, 0, 0, 4, 2, 0), tableArea());
+    CPPUNIT_ASSERT_EQUAL(u"Qty"_ustr, pDoc->GetString(4, 0, 0));
+
+    dispatchCommand(mxComponent, u".uno:Undo"_ustr, {});
+    CPPUNIT_ASSERT_EQUAL(ScRange(0, 0, 0, 3, 2, 0), tableArea());
+    CPPUNIT_ASSERT_EQUAL(u"Qty"_ustr, pDoc->GetString(4, 0, 0));
+    CPPUNIT_ASSERT(!pDoc->GetAttr(4, 0, 0, ATTR_MERGE_FLAG).HasAutoFilter());
+}
+
+// .uno:HstTableAutoExpand switches the growth off (and on again).
+CPPUNIT_TEST_FIXTURE(ScHstTableInputTest, testAutoExpandSwitch)
+{
+    createTable(true);
+    ScDocument* pDoc = getScDoc();
+    comphelper::ScopeGuard aReset([] { sc::hsttable::SetAutoExpandEnabled(true); });
+
+    CPPUNIT_ASSERT(sc::hsttable::IsAutoExpandEnabled());
+    dispatchCommand(mxComponent, u".uno:HstTableAutoExpand"_ustr, {});
+    CPPUNIT_ASSERT(!sc::hsttable::IsAutoExpandEnabled());
+
+    insertStringToCell(u"A4"_ustr, u"c");
+    CPPUNIT_ASSERT_EQUAL(ScRange(0, 0, 0, 2, 2, 0), tableArea());
+    CPPUNIT_ASSERT_EQUAL(CELLTYPE_NONE, pDoc->GetCellType(ScAddress(2, 3, 0)));
+
+    dispatchCommand(mxComponent, u".uno:HstTableAutoExpand"_ustr, {});
+    CPPUNIT_ASSERT(sc::hsttable::IsAutoExpandEnabled());
+    insertStringToCell(u"A5"_ustr, u"d");
+    CPPUNIT_ASSERT_EQUAL(ScRange(0, 0, 0, 2, 2, 0), tableArea()); // A5 is not next to the table
+}
+
+// .xlsx: the calculated column is written as <calculatedColumnFormula> and still grows with the
+// table after reload.
+CPPUNIT_TEST_FIXTURE(ScHstTableInputTest, testCalculatedColumnXlsx)
+{
+    createTable(true);
+    CPPUNIT_ASSERT(getScDoc()->GetTableStyles()->GetTableStyle(u"TableStyleMedium2"_ustr));
+
+    saveAndReload(TestFilter::XLSX);
+    xmlDocUniquePtr pTable = parseExport(u"xl/tables/table1.xml"_ustr);
+    CPPUNIT_ASSERT(pTable);
+    assertXPath(pTable, "/x:table/x:tableColumns/x:tableColumn[2]/x:calculatedColumnFormula", 0);
+    assertXPathContent(pTable, "/x:table/x:tableColumns/x:tableColumn[3]/x:calculatedColumnFormula",
