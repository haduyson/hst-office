+#pragma once
+
+#include "scdllapi.h"
+#include "types.hxx"
+
+class ScDBData;
+class ScDocument;
+class ScFormulaCell;
+
+/** HST Office: calculated columns of Sheets tables (database ranges with a table style).
+
+    A table column is a calculated column when every data row of it (the rows between the
+    header row and the total row) holds the same formula in relative form, as the familiar
+    office suite fills one formula into the whole column. The state is derived from the cells,
+    so it needs no storage: it survives copy, undo, .ods and .xlsx unchanged, and .xlsx export
+    writes it as <calculatedColumnFormula>. */
+namespace sc::hsttable
+{
+/** First and last data row of the table (without the header and the total row).
+    @return false when the table has no data row. */
+SC_DLLPUBLIC bool GetDataRows(const ScDBData& rData, SCROW& rFirstRow, SCROW& rLastRow);
+
+/** Whether the two formula cells hold the same formula in relative form (the same formula
+    filled down a column). */
+SC_DLLPUBLIC bool IsSameColumnFormula(const ScFormulaCell& rCell, const ScFormulaCell& rOther);
+
+/** The formula cell that defines the calculated column nCol of the table: every data row of the
+    column, except nIgnoreRow, holds a formula equal to it in relative form (no array formula).
+    @return the first such cell, or nullptr when the column is not a calculated column. */
+SC_DLLPUBLIC const ScFormulaCell* GetCalculatedColumnCell(const ScDocument& rDoc,
+                                                          const ScDBData& rData, SCCOL nCol,
+                                                          SCROW nIgnoreRow = -1);
+}
