+    goToCell(u"A2:B3"_ustr);
+    dispatchCommand(mxComponent, u".uno:Copy"_ustr, {});
+    goToCell(u"A4"_ustr);
+    dispatchCommand(mxComponent, u".uno:Paste"_ustr, {});
+    CPPUNIT_ASSERT_EQUAL(u"b"_ustr, pDoc->GetString(0, 4, 0));
+    CPPUNIT_ASSERT_EQUAL(ScRange(0, 0, 0, 2, 4, 0), tableArea());
+    CPPUNIT_ASSERT_EQUAL(u"=B4*2"_ustr, pDoc->GetFormula(2, 3, 0));
+    CPPUNIT_ASSERT_EQUAL(u"=B5*2"_ustr, pDoc->GetFormula(2, 4, 0));
