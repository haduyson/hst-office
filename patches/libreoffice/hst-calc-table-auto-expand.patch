+
+// A paste into the rows below a table grows it by every pasted row; new rows take the
+// calculated column; Ctrl+Z right after undoes only the growth and keeps the pasted cells.
+CPPUNIT_TEST_FIXTURE(ScHstTableInputTest, testAutoExpandPasteRows)
+{
