+/** HST Office: undo of the cells a Sheets table changed by itself after an input (the formula of
+    a calculated column filled into its rows, or the new row or column of an auto-expanded
+    table: header name, column formulas and formatting). Restores the range from the documents
+    taken before and after the change. */
+class ScUndoHstTableCells final : public ScSimpleUndo
+{
+public:
+    ScUndoHstTableCells(ScDocShell& rDocSh, const ScRange& rRange, InsertDeleteFlags nFlags,
+                        ScDocumentUniquePtr pUndoDoc, ScDocumentUniquePtr pRedoDoc,
+                        TranslateId pComment);
+
+    virtual void Undo() override;
+    virtual void Redo() override;
+    virtual void Repeat(SfxRepeatTarget& rTarget) override;
+    virtual bool CanRepeat(SfxRepeatTarget& rTarget) const override;
+    virtual OUString GetComment() const override;
+    virtual std::optional<ScRange> getAffectedRange() const override { return maRange; }
+
+private:
+    void DoChange(ScDocument& rSource);
+
+    ScRange maRange;
+    InsertDeleteFlags mnFlags;
+    ScDocumentUniquePtr mpUndoDoc;
+    ScDocumentUniquePtr mpRedoDoc;
+    TranslateId mpComment;
+};
