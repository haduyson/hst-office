+namespace
+{
+void StoreSetting(bool bAutoExpand, bool bEnable)
+{
+    try
+    {
+        std::shared_ptr<comphelper::ConfigurationChanges> xBatch(
+            comphelper::ConfigurationChanges::create());
+        if (bAutoExpand)
+            officecfg::Office::Calc::Input::HstTableAutoExpand::set(bEnable, xBatch);
+        else
+            officecfg::Office::Calc::Input::HstTableCalculatedColumns::set(bEnable, xBatch);
+        xBatch->commit();
+    }
+    catch (const css::uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("sc.ui", "cannot store the table input setting");
+    }
+}
+}
+
+namespace sc::hsttable
+{
+bool IsAutoExpandEnabled() { return officecfg::Office::Calc::Input::HstTableAutoExpand::get(); }
+
+void SetAutoExpandEnabled(bool bEnable) { StoreSetting(true, bEnable); }
+
+bool IsCalculatedColumnsEnabled()
+{
+    return officecfg::Office::Calc::Input::HstTableCalculatedColumns::get();
+}
+
+void SetCalculatedColumnsEnabled(bool bEnable) { StoreSetting(false, bEnable); }
+
+bool IsAutoExpansionUndoable(ScDocShell& rDocSh)
+{
+    const SfxUndoManager* pUndoMgr = rDocSh.GetUndoManager();
+    if (!pUndoMgr || pUndoMgr->GetUndoActionCount() == 0)
+        return false;
+    const auto* pList = dynamic_cast<const SfxListUndoAction*>(pUndoMgr->GetUndoAction());
+    return pList && pList->GetId() == HST_TABLE_AUTOEXPAND_UNDO_ID;
+}
+}
+
+void ScTabViewShell::ExecuteHstTable(SfxRequest& rReq)
+{
+    const sal_uInt16 nSlot = rReq.GetSlot();
+    switch (nSlot)
+    {
+        case SID_HST_TABLE_AUTOEXPAND:
+        case SID_HST_TABLE_CALCULATED_COLUMNS:
+        {
+            const bool bAutoExpand = nSlot == SID_HST_TABLE_AUTOEXPAND;
+            bool bEnable = !(bAutoExpand ? sc::hsttable::IsAutoExpandEnabled()
+                                         : sc::hsttable::IsCalculatedColumnsEnabled());
+            const SfxItemSet* pArgs = rReq.GetArgs();
+            const SfxPoolItem* pItem = nullptr;
+            if (pArgs && pArgs->GetItemState(nSlot, true, &pItem) == SfxItemState::SET)
+                bEnable = static_cast<const SfxBoolItem*>(pItem)->GetValue();
+            if (bAutoExpand)
+                sc::hsttable::SetAutoExpandEnabled(bEnable);
+            else
+                sc::hsttable::SetCalculatedColumnsEnabled(bEnable);
+            GetViewFrame().GetBindings().Invalidate(nSlot);
+            rReq.AppendItem(SfxBoolItem(nSlot, bEnable));
+            rReq.Done();
+            break;
+        }
+        case SID_HST_TABLE_UNDO_AUTOEXPAND:
+        {
+            ScDocShell* pDocSh = GetViewData().GetDocShell();
+            if (pDocSh && sc::hsttable::IsAutoExpansionUndoable(*pDocSh))
+            {
+                SfxRequest aUndo(GetViewFrame(), SID_UNDO);
+                ExecuteUndo(aUndo);
+            }
+            rReq.Done();
+            break;
+        }
+        default:
+            break;
+    }
+}
+
+void ScTabViewShell::GetHstTableState(SfxItemSet& rSet)
+{
+    SfxWhichIter aIter(rSet);
+    for (sal_uInt16 nWhich = aIter.FirstWhich(); nWhich; nWhich = aIter.NextWhich())
+    {
+        switch (nWhich)
+        {
+            case SID_HST_TABLE_AUTOEXPAND:
+                rSet.Put(SfxBoolItem(nWhich, sc::hsttable::IsAutoExpandEnabled()));
+                break;
+            case SID_HST_TABLE_CALCULATED_COLUMNS:
+                rSet.Put(SfxBoolItem(nWhich, sc::hsttable::IsCalculatedColumnsEnabled()));
+                break;
+            case SID_HST_TABLE_UNDO_AUTOEXPAND:
+            {
+                ScDocShell* pDocSh = GetViewData().GetDocShell();
+                if (!pDocSh || !sc::hsttable::IsAutoExpansionUndoable(*pDocSh))
+                    rSet.DisableItem(nWhich);
+                break;
+            }
+            default:
+                break;
+        }
+    }
+}
