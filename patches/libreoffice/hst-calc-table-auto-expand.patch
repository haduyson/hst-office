+
+namespace
+{
+/// The cell contents a table changes by itself (values, text, formulas), without notes.
+const InsertDeleteFlags HST_TABLE_CONTENT_FLAGS
+    = InsertDeleteFlags::VALUE | InsertDeleteFlags::DATETIME | InsertDeleteFlags::STRING
+      | InsertDeleteFlags::FORMULA | InsertDeleteFlags::EDITATTR;
+
+ScDocumentUniquePtr CopyRange(ScDocument& rDoc, const ScRange& rRange, InsertDeleteFlags nFlags)
+{
+    ScDocumentUniquePtr pCopy(new ScDocument(SCDOCMODE_UNDO));
+    pCopy->InitUndo(rDoc, rRange.aStart.Tab(), rRange.aEnd.Tab());
+    rDoc.CopyToDocument(rRange, nFlags, false, *pCopy);
+    return pCopy;
+}
+
+bool IsChangeable(const ScDocument& rDoc, const ScRange& rRange)
+{
+    return rDoc.IsBlockEditable(rRange.aStart.Tab(), rRange.aStart.Col(), rRange.aStart.Row(),
+                                rRange.aEnd.Col(), rRange.aEnd.Row())
+           && !rDoc.HasAttrib(rRange, HasAttrFlags::Merged | HasAttrFlags::Overlapped);
+}
+
+/** Gives the cells of rRange (one row or one column) the formatting of the cells nDx/nDy away,
+    run by run of equal formatting. Merging, autofilter buttons and conditional formats stay
+    with their own ranges. Input cells (typed, pasted or filled) take it only when the input left
+    them unformatted. */
+void CopyFormats(ScDocument& rDoc, const ScRange& rRange, SCCOL nDx, SCROW nDy,
+                 const ScRange& rInput)
+{
+    const SCTAB nTab = rRange.aStart.Tab();
+    const bool bRow = rRange.aStart.Row() == rRange.aEnd.Row();
+    const SCCOLROW nCount = bRow ? rRange.aEnd.Col() - rRange.aStart.Col() + 1
+                                 : rRange.aEnd.Row() - rRange.aStart.Row() + 1;
+    auto aCellAt = [&](SCCOLROW n) {
+        return bRow ? ScAddress(static_cast<SCCOL>(rRange.aStart.Col() + n), rRange.aStart.Row(),
+                                nTab)
+                    : ScAddress(rRange.aStart.Col(), rRange.aStart.Row() + n, nTab);
+    };
+    auto aApply = [&](const ScPatternAttr* pSource, const ScAddress& rFirst,
+                      const ScAddress& rLast) {
+        if (!pSource || pSource->isDefault())
+            return;
+        if (const ScStyleSheet* pStyle = pSource->GetStyleSheet())
+            rDoc.ApplyStyleAreaTab(rFirst.Col(), rFirst.Row(), rLast.Col(), rLast.Row(), nTab,
+                                   *pStyle);
+        ScPatternAttr aPattern(*pSource);
+        aPattern.ItemSetClearItem(ATTR_MERGE);
+        aPattern.ItemSetClearItem(ATTR_MERGE_FLAG);
+        aPattern.ItemSetClearItem(ATTR_CONDITIONAL);
+        rDoc.ApplyPatternAreaTab(rFirst.Col(), rFirst.Row(), rLast.Col(), rLast.Row(), nTab,
+                                 aPattern);
+    };
+
+    const ScPatternAttr* pRunSource = nullptr;
+    ScAddress aRunFirst;
+    ScAddress aRunLast;
+    for (SCCOLROW n = 0; n < nCount; ++n)
+    {
+        const ScAddress aPos = aCellAt(n);
+        const ScPatternAttr* pSource
+            = rDoc.GetPattern(static_cast<SCCOL>(aPos.Col() + nDx), aPos.Row() + nDy, nTab);
+        if (rInput.Contains(aPos))
+        {
+            aApply(pRunSource, aRunFirst, aRunLast);
+            pRunSource = nullptr;
+            const ScPatternAttr* pInputPattern = rDoc.GetPattern(aPos);
+            if (pInputPattern && pInputPattern->isDefault())
+                aApply(pSource, aPos, aPos);
+            continue;
+        }
+        if (pRunSource && pSource == pRunSource)
+        {
+            aRunLast = aPos;
+            continue;
+        }
+        aApply(pRunSource, aRunFirst, aRunLast);
+        pRunSource = pSource;
+        aRunFirst = aPos;
+        aRunLast = aPos;
+    }
+    aApply(pRunSource, aRunFirst, aRunLast);
+}
+
+/// "ColumnN" for the table column at nIndex, unique among the other column names.
+OUString MakeColumnName(ScDocument& rDoc, ScDBData& rData, SCCOL nIndex)
+{
+    rData.RefreshTableColumnNames(&rDoc);
+    const std::vector<OUString>& rNames = rData.GetTableColumnNames();
+    const OUString aBase(ScResId(STR_COLUMN));
+    for (sal_Int32 n = nIndex + 1;; ++n)
+    {
+        const OUString aName = aBase + OUString::number(n);
+        if (std::none_of(rNames.begin(), rNames.end(), [&aName](const OUString& rName) {
+                return ScGlobal::GetTransliteration().isEqual(rName, aName);
+            }))
+            return aName;
+    }
+}
+
+/** The table whose next row (without a total row) or next column the input reaches. The input
+    may start inside the table (a fill down or right from its last row or column); its other
+    extent must stay within the table's columns (new rows) or rows (new columns). */
+ScDBData* FindTableToExpand(ScDocument& rDoc, const ScRange& rInput, bool& rbNewRow)
+{
+    for (const auto& rxData : rDoc.GetDBCollection()->getNamedDBs())
+    {
+        if (!rxData->GetTableStyleInfo() || rxData->GetTab() != rInput.aStart.Tab())
+            continue;
+        ScRange aArea;
+        rxData->GetArea(aArea);
+        const SCROW nNextRow = aArea.aEnd.Row() + 1;
+        const SCCOL nNextCol = aArea.aEnd.Col() + 1;
+        if (!rxData->HasTotals() && rInput.aStart.Row() <= nNextRow
+            && rInput.aEnd.Row() >= nNextRow && rInput.aStart.Row() >= aArea.aStart.Row()
+            && rInput.aStart.Col() >= aArea.aStart.Col() && rInput.aEnd.Col() <= aArea.aEnd.Col())
+        {
+            rbNewRow = true;
+            return rxData.get();
+        }
+        if (rInput.aStart.Col() <= nNextCol && rInput.aEnd.Col() >= nNextCol
+            && rInput.aStart.Col() >= aArea.aStart.Col()
+            && rInput.aStart.Row() >= aArea.aStart.Row() && rInput.aEnd.Row() <= aArea.aEnd.Row())
+        {
+            rbNewRow = false;
+            return rxData.get();
+        }
+    }
+    return nullptr;
+}
+
+void ExpandTable(ScDocShell& rDocSh, const ScRange& rInput, ViewShellId nViewShellId)
+{
+    ScDocument& rDoc = rDocSh.GetDocument();
+    bool bNewRow = false;
+    ScDBData* pData = FindTableToExpand(rDoc, rInput, bNewRow);
+    if (!pData)
+        return;
+
+    const SCTAB nTab = rInput.aStart.Tab();
+    ScRange aArea;
+    pData->GetArea(aArea);
+    const ScRange aStrip
+        = bNewRow ? ScRange(aArea.aStart.Col(), aArea.aEnd.Row() + 1, nTab, aArea.aEnd.Col(),
+                            rInput.aEnd.Row(), nTab)
+                  : ScRange(aArea.aEnd.Col() + 1, aArea.aStart.Row(), nTab, rInput.aEnd.Col(),
+                            aArea.aEnd.Row(), nTab);
+    // An input cell outside the table that belongs to a database range already never grows
+    // another one.
+    const ScAddress aFirstNew = bNewRow ? ScAddress(rInput.aStart.Col(), aStrip.aStart.Row(), nTab)
+                                        : ScAddress(aStrip.aStart.Col(), rInput.aStart.Row(), nTab);
+    if (rDoc.GetDBAtCursor(aFirstNew.Col(), aFirstNew.Row(), nTab, ScDBDataPortion::AREA))
+        return;
+    if (!IsChangeable(rDoc, aStrip))
+        return;
+    // The new cells must not belong to another database range.
+    for (const ScDBData* pOther :
+         rDoc.GetAllNamedDBsInArea(aStrip.aStart.Col(), aStrip.aStart.Row(), aStrip.aEnd.Col(),
+                                   aStrip.aEnd.Row(), nTab))
+    {
+        if (pOther != pData)
+            return;
+    }
+    if (const ScDBData* pSheetData = rDoc.GetAnonymousDBData(nTab))
+    {
+        ScRange aSheetArea;
+        pSheetData->GetArea(aSheetArea);
+        if (aSheetArea.Intersects(aStrip))
+            return;
+    }
+
+    ScDocShellModificator aModificator(rDocSh);
+    const InsertDeleteFlags nFlags = HST_TABLE_CONTENT_FLAGS | InsertDeleteFlags::ATTRIB;
+    const bool bRecord = rDoc.IsUndoEnabled();
+    ScDocumentUniquePtr pUndoDoc;
+    if (bRecord)
+        pUndoDoc = CopyRange(rDoc, aStrip, nFlags);
+
+    if (bNewRow)
+    {
+        SCROW nFirstRow = 0;
+        SCROW nLastRow = 0;
+        // Formatting and column formulas come from the last data row (not from the header).
+        if (sc::hsttable::GetDataRows(*pData, nFirstRow, nLastRow))
+        {
+            for (SCROW nRow = aStrip.aStart.Row(); nRow <= aStrip.aEnd.Row(); ++nRow)
+            {
+                const ScRange aRowStrip(aStrip.aStart.Col(), nRow, nTab, aStrip.aEnd.Col(), nRow,
+                                        nTab);
+                CopyFormats(rDoc, aRowStrip, 0, nLastRow - nRow, rInput);
+                for (SCCOL nCol = aArea.aStart.Col(); nCol <= aArea.aEnd.Col(); ++nCol)
+                {
+                    const ScAddress aCell(nCol, nRow, nTab);
+                    if (rInput.Contains(aCell) || rDoc.GetCellType(aCell) != CELLTYPE_NONE)
+                        continue;
+                    if (const ScFormulaCell* pColumnCell
+                        = sc::hsttable::GetCalculatedColumnCell(rDoc, *pData, nCol))
+                        rDoc.SetFormulaCell(aCell, new ScFormulaCell(*pColumnCell, rDoc, aCell));
+                }
+            }
+        }
+    }
+    else
+    {
+        for (SCCOL nCol = aStrip.aStart.Col(); nCol <= aStrip.aEnd.Col(); ++nCol)
+        {
+            const ScRange aColStrip(nCol, aStrip.aStart.Row(), nTab, nCol, aStrip.aEnd.Row(),
+                                    nTab);
+            CopyFormats(rDoc, aColStrip, aArea.aEnd.Col() - nCol, 0, rInput);
+            const ScAddress aHeader(nCol, aArea.aStart.Row(), nTab);
+            if (pData->HasHeader() && !rInput.Contains(aHeader)
+                && rDoc.GetCellType(aHeader) == CELLTYPE_NONE)
+            {
+                ScSetStringParam aParam;
+                aParam.setTextInput();
+                rDoc.SetString(aHeader,
+                               MakeColumnName(rDoc, *pData,
+                                              static_cast<SCCOL>(nCol - aArea.aStart.Col())),
+                               &aParam);
+            }
+        }
+    }
+    rDocSh.PostPaint(aStrip, PaintPartFlags::Grid);
+
+    SfxUndoManager* pUndoMgr = bRecord ? rDocSh.GetUndoManager() : nullptr;
+    if (pUndoMgr)
+    {
+        const OUString aComment(ScResId(STR_HST_UNDO_TABLE_AUTOEXPAND));
+        pUndoMgr->EnterListAction(aComment, aComment, sc::hsttable::HST_TABLE_AUTOEXPAND_UNDO_ID,
+                                  nViewShellId);
+        pUndoMgr->AddUndoAction(std::make_unique<ScUndoHstTableCells>(
+            rDocSh, aStrip, nFlags, std::move(pUndoDoc), CopyRange(rDoc, aStrip, nFlags),
+            STR_HST_UNDO_TABLE_AUTOEXPAND));
+    }
+
+    // The new range moves the autofilter buttons and recompiles the structured references
+    // (its own undo action inside the list action).
+    ScRange aNewArea(aArea);
+    aNewArea.ExtendTo(aStrip);
+    ScDBData aNewData(*pData);
+    aNewData.SetArea(nTab, aNewArea.aStart.Col(), aNewArea.aStart.Row(), aNewArea.aEnd.Col(),
+                     aNewArea.aEnd.Row());
+    ScDBDocFunc(rDocSh).ModifyDBData(aNewData);
+
+    if (pUndoMgr)
+        pUndoMgr->LeaveListAction();
+    aModificator.SetDocumentModified();
+}
+
+void FillCalculatedColumn(ScDocShell& rDocSh, const ScDBData& rData, const ScAddress& rPos)
+{
+    ScDocument& rDoc = rDocSh.GetDocument();
+    const ScFormulaCell* pInput = rDoc.GetFormulaCell(rPos);
+    if (!pInput || pInput->GetMatrixFlag() != ScMatrixMode::NONE)
+        return;
+    SCROW nFirstRow = 0;
+    SCROW nLastRow = 0;
+    if (!sc::hsttable::GetDataRows(rData, nFirstRow, nLastRow) || nFirstRow == nLastRow
+        || rPos.Row() < nFirstRow || rPos.Row() > nLastRow)
+        return;
+
+    const SCCOL nCol = rPos.Col();
+    const SCTAB nTab = rPos.Tab();
+    const bool bOthersEmpty
+        = (rPos.Row() == nFirstRow || rDoc.IsBlockEmpty(nCol, nFirstRow, nCol, rPos.Row() - 1, nTab))
+          && (rPos.Row() == nLastRow
+              || rDoc.IsBlockEmpty(nCol, rPos.Row() + 1, nCol, nLastRow, nTab));
+    if (!bOthersEmpty)
+    {
+        // A column of other content stays as it is; a calculated column takes the new formula.
+        const ScFormulaCell* pColumnCell
+            = sc::hsttable::GetCalculatedColumnCell(rDoc, rData, nCol, rPos.Row());
+        if (!pColumnCell || sc::hsttable::IsSameColumnFormula(*pColumnCell, *pInput))
+            return;
+    }
+
+    const ScRange aRange(nCol, nFirstRow, nTab, nCol, nLastRow, nTab);
+    if (!IsChangeable(rDoc, aRange))
+        return;
+
+    ScDocShellModificator aModificator(rDocSh);
+    const bool bRecord = rDoc.IsUndoEnabled();
+    ScDocumentUniquePtr pUndoDoc;
+    if (bRecord)
+        pUndoDoc = CopyRange(rDoc, aRange, HST_TABLE_CONTENT_FLAGS);
+
+    // Clone from a copy: setting the other cells regroups the formula cells of the column.
+    ScFormulaCell aTemplate(*pInput, rDoc, rPos);
+    for (SCROW nRow = nFirstRow; nRow <= nLastRow; ++nRow)
+    {
+        if (nRow == rPos.Row())
+            continue;
+        const ScAddress aCell(nCol, nRow, nTab);
+        rDoc.SetFormulaCell(aCell, new ScFormulaCell(aTemplate, rDoc, aCell));
+    }
+    rDocSh.PostPaint(aRange, PaintPartFlags::Grid);
+
+    if (bRecord)
+    {
+        rDocSh.GetUndoManager()->AddUndoAction(std::make_unique<ScUndoHstTableCells>(
+            rDocSh, aRange, HST_TABLE_CONTENT_FLAGS, std::move(pUndoDoc),
+            CopyRange(rDoc, aRange, HST_TABLE_CONTENT_FLAGS), STR_HST_UNDO_TABLE_CALCCOLUMN));
+    }
+    aModificator.SetDocumentModified();
+}
+}
+
+namespace sc::hsttable
+{
+void AfterRangeInput(ScViewData& rViewData, const ScRangeList& rRanges)
+{
+    ScDocShell* pDocSh = rViewData.GetDocShell();
+    if (!pDocSh || !IsAutoExpandEnabled())
+        return;
+    ScDocument& rDoc = pDocSh->GetDocument();
+    if (!rDoc.GetDBCollection() || rDoc.GetDBCollection()->getNamedDBs().empty()
+        || rDoc.GetChangeTrack())
+        return;
+    const ScTabViewShell* pViewShell = rViewData.GetViewShell();
+    const ViewShellId nViewShellId = pViewShell ? pViewShell->GetViewShellId() : ViewShellId(-1);
+    const SCTAB nTab = rViewData.CurrentTabForData();
+    for (size_t i = 0; i < rRanges.size(); ++i)
+    {
+        ScRange aRange(rRanges[i]);
+        aRange.aStart.SetTab(nTab);
+        aRange.aEnd.SetTab(nTab);
+        if (rDoc.IsTabProtected(nTab)
+            || rDoc.IsBlockEmpty(aRange.aStart.Col(), aRange.aStart.Row(), aRange.aEnd.Col(),
+                                 aRange.aEnd.Row(), nTab))
+            continue;
+        ExpandTable(*pDocSh, aRange, nViewShellId);
+    }
+}
+
+void AfterCellInput(ScViewData& rViewData, const ScAddress& rPos)
+{
+    ScDocShell* pDocSh = rViewData.GetDocShell();
+    if (!pDocSh)
+        return;
+    ScDocument& rDoc = pDocSh->GetDocument();
+    // Change tracking records user edits only; a protected sheet keeps its tables as they are.
+    if (!rDoc.GetDBCollection() || rDoc.GetDBCollection()->getNamedDBs().empty()
+        || rDoc.GetChangeTrack() || rDoc.IsTabProtected(rPos.Tab())
+        || rDoc.GetCellType(rPos) == CELLTYPE_NONE)
+        return;
+
+    if (IsAutoExpandEnabled())
+    {
+        const ScTabViewShell* pViewShell = rViewData.GetViewShell();
+        ExpandTable(*pDocSh, ScRange(rPos),
+                    pViewShell ? pViewShell->GetViewShellId() : ViewShellId(-1));
+    }
+    if (IsCalculatedColumnsEnabled())
+    {
+        if (const ScDBData* pData = rDoc.GetTableDBAtCursor(rPos.Col(), rPos.Row(), rPos.Tab(),
+                                                            ScDBDataPortion::AREA))
+            FillCalculatedColumn(*pDocSh, *pData, rPos);
+    }
+}
+}
