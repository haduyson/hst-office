+
+#pragma once
+
+#include <scdllapi.h>
+
+class ScAddress;
+class ScDocShell;
+class ScRangeList;
+class ScViewData;
+
+/** HST Office: Sheets tables (database ranges with a table style) behave like the tables of the
+    familiar office suite when the user types into cells:
+    - auto-expansion: typing into the row directly below a table (without a total row) or the
+      column directly right of it grows the table by that row or column; the new cells take the
+      formatting of the row above or the column to the left, the formulas of the calculated
+      columns and, for a new column, a "ColumnN" header; the autofilter range and the
+      structured references follow the table range;
+    - the same growth after a paste or a fill (down or right) that reaches the row below or the
+      column right of a table, by as many rows or columns as the pasted or filled cells reach;
+    - calculated columns: a formula typed into a data cell of a table column whose other data
+      cells are empty or hold one common formula is filled into every data row of the column.
+    Each of them is a separate undo step after the input itself, so Ctrl+Z right after it undoes
+    only the expansion or the fill and keeps the typed content. Both can be switched off
+    (.uno:HstTableAutoExpand, .uno:HstTableCalculatedColumns; officecfg
+    Office.Calc/Input/HstTableAutoExpand and HstTableCalculatedColumns). */
+namespace sc::hsttable
+{
+/// Id of the undo list action of a table auto-expansion (its new cells and its new range).
+inline constexpr sal_uInt16 HST_TABLE_AUTOEXPAND_UNDO_ID = 0x4854;
+
+/** Called after the user entered content into rPos (the input is already its own undo step). */
+void AfterCellInput(ScViewData& rViewData, const ScAddress& rPos);
+
+/** Called after a paste or a fill wrote rRanges (already its own undo step): grows a table whose
+    next row or column they reach. */
+void AfterRangeInput(ScViewData& rViewData, const ScRangeList& rRanges);
+
+SC_DLLPUBLIC bool IsAutoExpandEnabled();
+SC_DLLPUBLIC void SetAutoExpandEnabled(bool bEnable);
+SC_DLLPUBLIC bool IsCalculatedColumnsEnabled();
+SC_DLLPUBLIC void SetCalculatedColumnsEnabled(bool bEnable);
+
+/** Whether the next undo step of the document is a table auto-expansion. */
+SC_DLLPUBLIC bool IsAutoExpansionUndoable(ScDocShell& rDocSh);
+}
