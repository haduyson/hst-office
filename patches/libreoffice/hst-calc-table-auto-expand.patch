+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+#include <undohsttable.hxx>
+
+#include <docsh.hxx>
+#include <document.hxx>
+#include <scresid.hxx>
+
+#include <utility>
+
+ScUndoHstTableCells::ScUndoHstTableCells(ScDocShell& rDocSh, const ScRange& rRange,
+                                         InsertDeleteFlags nFlags, ScDocumentUniquePtr pUndoDoc,
+                                         ScDocumentUniquePtr pRedoDoc, TranslateId pComment)
+    : ScSimpleUndo(rDocSh)
+    , maRange(rRange)
+    , mnFlags(nFlags)
+    , mpUndoDoc(std::move(pUndoDoc))
+    , mpRedoDoc(std::move(pRedoDoc))
+    , mpComment(pComment)
+{
+}
+
+OUString ScUndoHstTableCells::GetComment() const { return ScResId(mpComment); }
+
+void ScUndoHstTableCells::DoChange(ScDocument& rSource)
+{
+    ScDocument& rDoc = rDocShell.GetDocument();
+    rDoc.DeleteAreaTab(maRange, mnFlags);
+    rSource.UndoToDocument(maRange, mnFlags, false, rDoc);
+    BroadcastChanges(maRange);
+    rDocShell.PostPaint(maRange, PaintPartFlags::Grid);
+    rDocShell.PostDataChanged();
+    ShowTable(maRange);
+}
+
+void ScUndoHstTableCells::Undo()
+{
+    BeginUndo();
+    if (mpUndoDoc)
+        DoChange(*mpUndoDoc);
+    EndUndo();
+}
+
+void ScUndoHstTableCells::Redo()
+{
+    BeginRedo();
+    if (mpRedoDoc)
+        DoChange(*mpRedoDoc);
+    EndRedo();
+}
+
+void ScUndoHstTableCells::Repeat(SfxRepeatTarget& /*rTarget*/) {}
+
+bool ScUndoHstTableCells::CanRepeat(SfxRepeatTarget& /*rTarget*/) const { return false; }
