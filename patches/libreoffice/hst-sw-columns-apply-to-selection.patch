 // Here all changes to the tab bar will be shot again into the model.
+// Column layouts sent by the Columns popup (SID_ATTR_PAGE_COLUMN):
+// 1 - one column, 2 - two equal columns, 3 - three equal columns,
+// 4 - two columns, the left one twice as wide as the right one,
+// 5 - two columns, the right one twice as wide as the left one.
+constexpr sal_uInt16 PAGE_COLUMN_TYPE_ONE = 1;
+constexpr sal_uInt16 PAGE_COLUMN_TYPE_LAST = 5;
+
+// Spacing Word uses between new columns: 0.5 inch = 1.27 cm, in twips.
+constexpr sal_uInt16 DEFAULT_COLUMN_GUTTER = 720;
+
+// Builds the columns for a popup column type over an area nWidth twips wide.
+// Line settings come from rOld; its spacing is kept when it already has columns
+// with a non-zero spacing, otherwise the Word default spacing is used.
+static SwFormatCol lcl_MakeColumnsOfType(const SwFormatCol& rOld, sal_uInt16 nColumnType,
+                                         tools::Long nWidth)
+{
+    sal_uInt16 nCount = 2;
+    if (nColumnType == PAGE_COLUMN_TYPE_ONE)
+        nCount = 0;
+    else if (nColumnType == 3)
+        nCount = 3;
+
+    const sal_uInt16 nAct = static_cast<sal_uInt16>(std::clamp<tools::Long>(nWidth, 1, USHRT_MAX));
+    sal_uInt16 nGutterWidth = 0;
+    if (nCount)
+    {
+        if (rOld.GetNumCols() > 1)
+        {
+            nGutterWidth = rOld.GetGutterWidth(true);
+        }
+        if (!nGutterWidth)
+            nGutterWidth = DEFAULT_COLUMN_GUTTER;
+        // Spacing never takes more than half of a narrow area (table cell, small frame).
+        nGutterWidth = std::min<sal_uInt16>(nGutterWidth, nAct / (2 * (nCount - 1)));
+    }
+
+    SwFormatCol aCols(rOld);
+    aCols.Init(nCount, nGutterWidth, nAct);
+    aCols.SetWishWidth(nAct);
+    aCols.SetGutterWidth(nGutterWidth, nAct);
+    aCols.SetOrtho(false, nGutterWidth, nAct);
+
+    if (nColumnType == 4 || nColumnType == 5)
+    {
+        // The text of the wide column is twice the text of the narrow one; each column
+        // carries half of the spacing, as Init() laid it out.
+        const sal_uInt16 nHalfGutter = nGutterWidth / 2;
+        const sal_uInt16 nNarrow = (nAct - nGutterWidth) / 3 + nHalfGutter;
+        const sal_uInt16 nWide = nAct - nNarrow;
+        aCols.GetColumns()[0].SetWishWidth(nColumnType == 4 ? nWide : nNarrow);
+        aCols.GetColumns()[1].SetWishWidth(nColumnType == 4 ? nNarrow : nWide);
+    }
+    return aCols;
+}
+
+// The section around the cursor whose columns the Columns popup changes: the innermost
+// enclosing section with more than one column, not counting index sections. With a
+// selection both ends have to be in the same section (or the selection is exactly one
+// section), as in the Format Columns dialog.
+static const SwSection* lcl_GetColumnSection(SwWrtShell& rSh)
+{
+    const SwSection* pSect = rSh.GetCurrSection();
+    if (!pSect)
+        return nullptr;
+    if (rSh.HasSelection() && rSh.GetFullSelectedSectionCount() != 1)
+    {
+        const SwPaM* pCursor = rSh.GetCursor();
+        if (pCursor->GetNext() != pCursor || !pCursor->HasMark()
+            || SwDoc::GetCurrSection(*pCursor->GetMark()) != pSect)
+            return nullptr;
+    }
+    for (; pSect; pSect = pSect->GetParent())
+    {
+        const SectionType eType = pSect->GetType();
+        const SwSectionFormat* pFormat = pSect->GetFormat();
+        if (eType != SectionType::ToxHeader && eType != SectionType::ToxContent && pFormat
+            && pFormat->GetCol().GetNumCols() > 1)
+            return pSect;
+    }
+    return nullptr;
+}
+
+// A new section with columns can be put around the selection: same conditions as the
+// "Selection" entry of the Format Columns dialog.
+static bool lcl_CanInsertColumnSection(SwWrtShell& rSh)
+{
+    if (!rSh.HasSelection() || !rSh.IsInsRegionAvailable())
+        return false;
+    const SwSection* pSect = rSh.GetCurrSection();
+    if (!pSect)
+        return true;
+    const SwPaM* pCursor = rSh.GetCursor();
+    return rSh.GetFullSelectedSectionCount() != 1 && pCursor->HasMark()
+           && SwDoc::GetCurrSection(*pCursor->GetMark()) == pSect;
+}
+
+// True when the section does nothing but lay out columns: plain content, not protected,
+// hidden, conditional or linked, and no format attribute besides the column ones.
+// Removing such a section on "one column" keeps its text and nothing else is lost.
+static bool lcl_IsColumnsOnlySection(const SwSection& rSect)
+{
+    if (rSect.GetType() != SectionType::Content || rSect.IsProtectFlag() || rSect.IsHidden()
+        || !rSect.GetCondition().isEmpty())
+        return false;
+    const SwSectionFormat* pFormat = rSect.GetFormat();
+    if (!pFormat)
+        return false;
+    for (SfxItemIter aIter(pFormat->GetAttrSet()); !aIter.IsAtEnd(); aIter.NextItem())
+    {
+        const SfxPoolItem* pItem = aIter.GetCurItem();
+        switch (pItem->Which())
+        {
+            case RES_CNTNT: // the link to the section's own nodes
+            case RES_COL:
+            case RES_COLUMNBALANCE:
+            case RES_FRM_SIZE:
+                break;
+            case RES_FRAMEDIR:
+                if (static_cast<const SvxFrameDirectionItem*>(pItem)->GetValue()
+                    != SvxFrameDirection::Environment)
+                    return false;
+                break;
+            case RES_PROTECT:
+                if (static_cast<const SvxProtectItem*>(pItem)->IsContentProtected())
+                    return false;
+                break;
+            case RES_EDIT_IN_READONLY:
+                if (static_cast<const SwFormatEditInReadonly*>(pItem)->GetValue())
+                    return false;
+                break;
+            default:
+                return false;
+        }
+    }
+    return true;
+}
+
+// Columns popup inside a section with columns: "one column" removes a section that only
+// lays out columns and otherwise drops its columns; the other types change its columns.
+static void lcl_ApplyColumnsToSection(SwWrtShell& rSh, const SwSection& rSect,
+                                      sal_uInt16 nColumnType, tools::Long nFallbackWidth)
+{
+    const SwSectionFormat* pFormat = rSect.GetFormat();
+    const size_t nPos = rSh.GetSectionFormatPos(*pFormat);
+    if (nColumnType == PAGE_COLUMN_TYPE_ONE && lcl_IsColumnsOnlySection(rSect))
+    {
+        rSh.StartUndo(SwUndoId::DELSECTION);
+        rSh.DelSectionFormat(nPos);
+        rSh.EndUndo(SwUndoId::DELSECTION);
+        return;
+    }
+
+    tools::Long nWidth = rSh.GetSectionWidth(*pFormat);
+    if (nWidth <= 0)
+        nWidth = nFallbackWidth;
+    SfxItemSet aSet(SfxItemSet::makeFixedSfxItemSet<RES_COL, RES_COL>(rSh.GetAttrPool()));
+    aSet.Put(lcl_MakeColumnsOfType(pFormat->GetCol(), nColumnType, nWidth));
+    SwSectionData aData(rSect);
+    rSh.StartUndo(SwUndoId::CHGSECTION);
+    rSh.UpdateSection(nPos, aData, &aSet);
+    rSh.EndUndo(SwUndoId::CHGSECTION);
+}
+
+// Columns popup with a selection: put a new section with the columns around it, like
+// Format Columns with "Apply to: Selection". Saved to DOCX as continuous section breaks.
+static void lcl_InsertColumnSection(SwWrtShell& rSh, sal_uInt16 nColumnType,
+                                    tools::Long nFallbackWidth)
+{
+    SwRect aRect;
+    rSh.CalcBoundRect(aRect, RndStdIds::FLY_AS_CHAR);
+    tools::Long nWidth = aRect.Width();
+    if (nWidth <= 0)
+        nWidth = nFallbackWidth;
+
+    SfxItemSet aSet(SfxItemSet::makeFixedSfxItemSet<RES_COL, RES_COL>(rSh.GetAttrPool()));
+    aSet.Put(lcl_MakeColumnsOfType(SwFormatCol(), nColumnType, nWidth));
+    SwSectionData aSection(SectionType::Content, UIName(rSh.GetUniqueSectionName()));
+    rSh.StartUndo(SwUndoId::INSSECTION);
+    rSh.InsertSection(aSection, &aSet);
+    rSh.EndUndo(SwUndoId::INSSECTION);
+}
+
