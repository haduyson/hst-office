+namespace
+{
+/// What Excel's Value column shows: the result of a name, {...} for a block of cells.
+OUString lcl_GetNameValue(ScDocument& rDoc, const ScRangeData& rData, const ScAddress& rPos)
+{
+    ScRange aRange;
+    if (rData.IsReference(aRange) && aRange.aStart != aRange.aEnd)
+        return u"{...}"_ustr;
+
+    ScSimpleFormulaCalculator aCalculator(rDoc, rPos, rData.GetSymbol(rPos),
+                                          /*bMatrixFormula*/ false);
+    if (aCalculator.GetErrCode() != FormulaError::NONE)
+        return ScGlobal::GetErrorString(aCalculator.GetErrCode());
+    if (aCalculator.IsValue())
+    {
+        OUString aText;
+        const Color* pColor = nullptr;
+        rDoc.GetFormatTable()->GetOutputString(aCalculator.GetValue(), 0, aText, &pColor);
+        return aText;
+    }
+    return aCalculator.GetString().getString();
+}
+}
 
