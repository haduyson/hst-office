+/// Fills the Writer document with nPages pages, the text of page N being "PN".
+void Test::insertNumberedPages(int nPages)
+{
+    uno::Reference<text::XTextDocument> xTextDocument(mxComponent, uno::UNO_QUERY_THROW);
+    uno::Reference<text::XText> xText = xTextDocument->getText();
+    uno::Reference<text::XTextCursor> xCursor = xText->createTextCursor();
+    for (int nPage = 1; nPage <= nPages; ++nPage)
+    {
+        if (nPage > 1)
+        {
+            xText->insertControlCharacter(xCursor, text::ControlCharacter::PARAGRAPH_BREAK, false);
+            uno::Reference<beans::XPropertySet> xParagraph(xCursor, uno::UNO_QUERY_THROW);
+            xParagraph->setPropertyValue(u"BreakType"_ustr, uno::Any(style::BreakType_PAGE_BEFORE));
+        }
+        xText->insertString(xCursor, OUString("P" + OUString::number(nPage)), false);
+    }
+}
+
+/// Exports the document as a booklet PDF and returns the text on the first (left) and second
+/// (right) half of every sheet side.
+std::vector<std::pair<OUString, OUString>> Test::exportBookletSides(vcl::pdf::PDFium& rPDFium)
+{
+    uno::Reference<css::lang::XMultiServiceFactory> xFactory = getMultiServiceFactory();
+    uno::Reference<document::XFilter> xFilter(
+        xFactory->createInstance(u"com.sun.star.document.PDFFilter"_ustr), uno::UNO_QUERY);
+    uno::Reference<document::XExporter> xExporter(xFilter, uno::UNO_QUERY);
+    xExporter->setSourceDocument(mxComponent);
+    SvMemoryStream aStream;
+    uno::Reference<io::XOutputStream> xOutputStream(new utl::OStreamWrapper(aStream));
+    uno::Sequence<beans::PropertyValue> aFilterData{
+        comphelper::makePropertyValue(u"Booklet"_ustr, true),
+    };
+    uno::Sequence<beans::PropertyValue> aDescriptor{
+        comphelper::makePropertyValue(u"FilterName"_ustr, u"writer_pdf_Export"_ustr),
+        comphelper::makePropertyValue(u"FilterData"_ustr, aFilterData),
+        comphelper::makePropertyValue(u"OutputStream"_ustr, xOutputStream),
+    };
+    xFilter->filter(aDescriptor);
+
+    // The size of the document pages, in mm100.
+    uno::Reference<style::XStyleFamiliesSupplier> xStyleFamiliesSupplier(mxComponent,
+                                                                         uno::UNO_QUERY_THROW);
+    uno::Reference<container::XNameAccess> xPageStyles(
+        xStyleFamiliesSupplier->getStyleFamilies()->getByName(u"PageStyles"_ustr),
+        uno::UNO_QUERY_THROW);
+    uno::Reference<beans::XPropertySet> xPageStyle(xPageStyles->getByName(u"Standard"_ustr),
+                                                   uno::UNO_QUERY_THROW);
+    sal_Int32 nPageWidth = 0;
+    sal_Int32 nPageHeight = 0;
+    xPageStyle->getPropertyValue(u"Width"_ustr) >>= nPageWidth;
+    xPageStyle->getPropertyValue(u"Height"_ustr) >>= nPageHeight;
+    CPPUNIT_ASSERT_LESS(nPageHeight, nPageWidth);
+
+    std::unique_ptr<vcl::pdf::PDFiumDocument> pPdfDocument
+        = rPDFium.openDocument(aStream.GetData(), aStream.GetSize(), OString());
+    CPPUNIT_ASSERT(pPdfDocument);
+    std::vector<std::pair<OUString, OUString>> aSides;
+    for (int nSheetSide = 0; nSheetSide < pPdfDocument->getPageCount(); ++nSheetSide)
+    {
+        // Each sheet is the document page turned to landscape: same paper, two pages on it.
+        const basegfx::B2DSize aSheetSize = pPdfDocument->getPageSize(nSheetSide);
+        CPPUNIT_ASSERT_DOUBLES_EQUAL(
+            o3tl::convert(double(nPageHeight), o3tl::Length::mm100, o3tl::Length::pt),
+            aSheetSize.getWidth(), 1.0);
+        CPPUNIT_ASSERT_DOUBLES_EQUAL(
+            o3tl::convert(double(nPageWidth), o3tl::Length::mm100, o3tl::Length::pt),
+            aSheetSize.getHeight(), 1.0);
+
+        std::unique_ptr<vcl::pdf::PDFiumPage> pPdfPage = pPdfDocument->openPage(nSheetSide);
+        CPPUNIT_ASSERT(pPdfPage);
+        std::unique_ptr<vcl::pdf::PDFiumTextPage> pTextPage = pPdfPage->getTextPage();
+        std::pair<OUString, OUString> aSide;
+        for (int i = 0; i < pPdfPage->getObjectCount(); ++i)
+        {
+            std::unique_ptr<vcl::pdf::PDFiumPageObject> pObject = pPdfPage->getObject(i);
+            if (pObject->getType() != vcl::pdf::PDFPageObjectType::Text)
+                continue;
+            const OUString aText = pObject->getText(pTextPage).trim();
+            if (aText.isEmpty())
+                continue;
+            if (pObject->getBounds().getCenterX() < aSheetSize.getWidth() / 2)
+                aSide.first += aText;
+            else
+                aSide.second += aText;
+        }
+        aSides.push_back(aSide);
+    }
+    return aSides;
+}
+
+void Test::checkBookletSides(const std::vector<std::pair<OUString, OUString>>& rExpected,
+                             const std::vector<std::pair<OUString, OUString>>& rActual)
+{
+    CPPUNIT_ASSERT_EQUAL(rExpected.size(), rActual.size());
+    for (size_t i = 0; i < rExpected.size(); ++i)
+    {
+        const OString aMessage = "sheet side " + OString::number(i);
+        CPPUNIT_ASSERT_EQUAL_MESSAGE(aMessage.getStr(), rExpected[i].first, rActual[i].first);
+        CPPUNIT_ASSERT_EQUAL_MESSAGE(aMessage.getStr(), rExpected[i].second, rActual[i].second);
+    }
+}
