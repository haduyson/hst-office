+CPPUNIT_TEST_FIXTURE(Test, testBookletEightPages)
+{
+    std::shared_ptr<vcl::pdf::PDFium> pPDFium = vcl::pdf::PDFiumLibrary::get();
+    if (!pPDFium)
+        return;
+
+    // Given a Writer document with 8 pages:
+    loadFromURL(u"private:factory/swriter"_ustr);
+    insertNumberedPages(8);
+
+    // When exporting it as a booklet PDF:
+    std::vector<std::pair<OUString, OUString>> aSides = exportBookletSides(*pPDFium);
+
+    // Then the 8 pages are on 2 sheets (4 sheet sides) in saddle-stitch order, printed duplex
+    // with a flip on the short edge: 8|1 and 2|7 on the outer sheet, 6|3 and 4|5 inside.
+    checkBookletSides({ { u"P8"_ustr, u"P1"_ustr },
+                        { u"P2"_ustr, u"P7"_ustr },
+                        { u"P6"_ustr, u"P3"_ustr },
+                        { u"P4"_ustr, u"P5"_ustr } },
+                      aSides);
+}
+
+CPPUNIT_TEST_FIXTURE(Test, testBookletFivePages)
+{
+    std::shared_ptr<vcl::pdf::PDFium> pPDFium = vcl::pdf::PDFiumLibrary::get();
+    if (!pPDFium)
+        return;
+
+    // Given a Writer document with 5 pages:
+    loadFromURL(u"private:factory/swriter"_ustr);
+    insertNumberedPages(5);
+
+    // When exporting it as a booklet PDF:
+    std::vector<std::pair<OUString, OUString>> aSides = exportBookletSides(*pPDFium);
+
+    // Then the page count is padded to 8 with blank pages at the end, so the halves of pages
+    // 6-8 are empty and the order stays that of an 8-page booklet.
+    checkBookletSides({ { u""_ustr, u"P1"_ustr },
+                        { u"P2"_ustr, u""_ustr },
+                        { u""_ustr, u"P3"_ustr },
+                        { u"P4"_ustr, u"P5"_ustr } },
+                      aSides);
+}
