+/// Saddle-stitch page order. For every sheet side, in output order, the indices of the pages on
+/// its first half (left, or top when the sheet is portrait) and second half (right, or bottom).
+/// The page count is padded to a multiple of four; an index >= nPages is a blank half.
+/// Sides alternate front/back of a sheet for duplex printing flipped on the short edge:
+/// with 8 pages the sides are 8|1, 2|7, 6|3, 4|5.
+std::vector<std::pair<sal_Int32, sal_Int32>> lcl_getBookletSides(sal_Int32 nPages)
+{
+    const sal_Int32 nPadded = (nPages + 3) / 4 * 4;
+    std::vector<std::pair<sal_Int32, sal_Int32>> aSides;
+    aSides.reserve(nPadded / 2);
+    for (sal_Int32 nSide = 0; nSide < nPadded / 2; ++nSide)
+    {
+        if (nSide % 2 == 0) // front of a sheet: the outer page of the pair on the first half
+            aSides.emplace_back(nPadded - 1 - nSide, nSide);
+        else // back of the same sheet
+            aSides.emplace_back(nSide, nPadded - 1 - nSide);
+    }
+    return aSides;
+}
+
+/// Scales rPage (pref map mode 1/100 mm) to fit the cell, centres it there and appends it to
+/// rSheet clipped to its own area. Same technique as the N-up print path in vcl (print3.cxx).
+void lcl_appendBookletPage(GDIMetaFile& rSheet, const GDIMetaFile& rPage, const Point& rCellPos,
+                           const Size& rCellSize, sal_Int32 nDPIX, sal_Int32 nDPIY)
+{
+    const Size aPageSize(rPage.GetPrefSize());
+    if (aPageSize.Width() <= 0 || aPageSize.Height() <= 0)
+        return;
+
+    const double fScale = std::min(double(rCellSize.Width()) / aPageSize.Width(),
+                                   double(rCellSize.Height()) / aPageSize.Height());
+    const Size aScaledSize(static_cast<tools::Long>(std::round(aPageSize.Width() * fScale)),
+                           static_cast<tools::Long>(std::round(aPageSize.Height() * fScale)));
+    const Point aPos(rCellPos.X() + (rCellSize.Width() - aScaledSize.Width()) / 2,
+                     rCellPos.Y() + (rCellSize.Height() - aScaledSize.Height()) / 2);
+    const tools::Rectangle aClipRect(aPos, aScaledSize);
+
+    GDIMetaFile aPage(rPage);
+    aPage.WindStart();
+    aPage.Scale(fScale, fScale);
+    aPage.WindStart();
+    aPage.Move(aPos.X(), aPos.Y(), nDPIX, nDPIY);
+    // the page's own clip regions must not reach into the other half of the sheet
+    aPage.WindStart();
+    aPage.Clip(aClipRect);
+
+    rSheet.AddAction(new MetaPushAction(vcl::PushFlags::ALL));
+    rSheet.AddAction(new MetaISectRectClipRegionAction(aClipRect));
+    aPage.WindStart();
+    aPage.Play(rSheet);
+    rSheet.AddAction(new MetaPopAction());
+}
+}
+
+void PDFExport::ImplExportBooklet( vcl::pdf::PDFWriter& rWriter, vcl::PDFExtOutDevData& rPDFExtOutDevData )
+{
+    if (maBookletPages.empty())
+        return;
+
+    // The sheet is the first page turned by 90 degrees (an A4 document gives A4 landscape
+    // sheets with two A5-sized pages), or with BookletKeepPageSize twice the page at 100%.
+    // Portrait pages sit side by side (fold on the vertical centre line); landscape pages are
+    // stacked (fold on the horizontal centre line). Either way the PDF is printed duplex,
+    // flipped on the short edge, and the stack is folded in the middle.
+    const Size aFirstPage(maBookletPages.front().GetPrefSize());
+    const bool bStacked = aFirstPage.Width() > aFirstPage.Height();
+    Size aSheetSize;
+    if (mbBookletKeepPageSize)
+        aSheetSize = bStacked ? Size(aFirstPage.Width(), 2 * aFirstPage.Height())
+                              : Size(2 * aFirstPage.Width(), aFirstPage.Height());
+    else
+        aSheetSize = Size(aFirstPage.Height(), aFirstPage.Width());
+
+    const Size aCellSize = bStacked ? Size(aSheetSize.Width(), aSheetSize.Height() / 2)
+                                    : Size(aSheetSize.Width() / 2, aSheetSize.Height());
+    const Point aSecondCellPos = bStacked ? Point(0, aCellSize.Height())
+                                          : Point(aCellSize.Width(), 0);
+
+    const OutputDevice* pRefDev = rWriter.GetReferenceDevice();
+    const sal_Int32 nDPIX = pRefDev ? pRefDev->GetDPIX() : 96;
+    const sal_Int32 nDPIY = pRefDev ? pRefDev->GetDPIY() : 96;
+
+    const sal_Int32 nPages = static_cast<sal_Int32>(maBookletPages.size());
+    for (const auto& [nFirst, nSecond] : lcl_getBookletSides(nPages))
+    {
+        GDIMetaFile aSheet;
+        aSheet.SetPrefMapMode(MapMode(MapUnit::Map100thMM));
+        aSheet.SetPrefSize(aSheetSize);
+        if (nFirst < nPages)
+            lcl_appendBookletPage(aSheet, maBookletPages[nFirst], Point(), aCellSize, nDPIX, nDPIY);
+        if (nSecond < nPages)
+            lcl_appendBookletPage(aSheet, maBookletPages[nSecond], aSecondCellPos, aCellSize,
+                                  nDPIX, nDPIY);
+        aSheet.WindStart();
+        ImplExportPage(rWriter, rPDFExtOutDevData, aSheet);
+    }
+    maBookletPages.clear();
+}
