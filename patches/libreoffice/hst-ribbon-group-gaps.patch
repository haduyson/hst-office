+/// HST Office: a tab without a ladder of its own shrinks with the default ladder, one state at a time,
+/// and its last step can free far more than was missing (a large group turned into its button): the
+/// groups an earlier step shrank grow back, latest first, into the largest state that still fits, so no
+/// group stays shrunk beside free room at the end of the row
+void lcl_HstRegrow(const std::vector<hst::ribbon::Group>& rGroups, const std::vector<hst::ribbon::Step>& rSteps,
+                   long nWidth, hst::ribbon::Layout& rLayout)
+{
+    long nRow = hst::ribbon::rowWidth(rGroups, rLayout.states);
+    for (auto it = rSteps.rbegin(); it != rSteps.rend(); ++it)
+    {
+        if (it->group >= rGroups.size())
+            continue;
+        const size_t nCurrent = rLayout.states[it->group];
+        if (nCurrent == 0 || nCurrent >= static_cast<size_t>(hst::ribbon::GroupStateCount))
+            continue;
+        const hst::ribbon::Group& rGroup = rGroups[it->group];
+        for (size_t nState = 0; nState < nCurrent; ++nState)
+        {
+            const long nNext = nRow - hst::ribbon::widthOf(rGroup, nCurrent) + hst::ribbon::widthOf(rGroup, nState);
+            if (nNext <= nWidth)
+            {
+                rLayout.states[it->group] = nState;
+                nRow = nNext;
+                break;
+            }
+        }
+    }
+}
 }
 
 
