+/// HST Office: the room a group leaves empty beside its controls because its caption is wider
+/// (VclGrid::get_hst_caption_room), 0 for other groups
+tools::Long lcl_HstCaptionRoom(vcl::Window& rGroup)
+{
+    const VclGrid* pGrid = dynamic_cast<const VclGrid*>(&rGroup);
