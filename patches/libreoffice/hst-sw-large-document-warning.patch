 ))
 
 $(eval $(call gb_CppunitTest_use_libraries,sw_uibase_docvw, \
--- a/sw/qa/uibase/hst/largedocwarning.cxx
+++ b/sw/qa/uibase/hst/largedocwarning.cxx
@@ -0,0 +1,88 @@
