+ * Part of HST Office. This file is HST's own work and is not covered by the MPL.
+ */
+
+#include <hstlargedocwarning.hxx>
+
+#include <com/sun/star/frame/XModel3.hpp>
+#include <comphelper/lok.hxx>
+#include <cppuhelper/weakref.hxx>
+#include <i18nlangtag/languagetag.hxx>
+#include <osl/file.hxx>
+#include <osl/process.h>
+#include <sfx2/docfile.hxx>
+#include <sfx2/infobar.hxx>
+#include <sfx2/sfxsids.hrc>
+#include <sfx2/viewfrm.hxx>
+#include <svl/eitem.hxx>
+#include <tools/urlobj.hxx>
+#include <vcl/settings.hxx>
+#include <vcl/svapp.hxx>
+#include <vcl/weld/Button.hxx>
+
+#include <docsh.hxx>
+#include <view.hxx>
+
+#include <memory>
+#include <vector>
+
+using namespace css;
+
+namespace hst::largedoc
+{
+namespace
+{
+constexpr OUString WARNING_BAR_ID = u"hst-large-document"_ustr;
+constexpr sal_uInt64 LIMIT_BYTES = sal_uInt64(100) * 1024 * 1024;
+
+sal_uInt64 Limit()
+{
+    // the tests open small files: they lower the limit instead of storing 100 MB
+    OUString aValue;
+    if (osl_getEnvironment(u"HST_LARGE_DOCUMENT_BYTES"_ustr.pData, &aValue.pData)
+            == osl_Process_E_None
+        && !aValue.isEmpty())
+        return aValue.toUInt64();
+    return LIMIT_BYTES;
+}
+
+/// Documents that showed the bar in this session (kept alive on purpose: no destruction at exit)
+bool FirstTime(const uno::Reference<uno::XInterface>& xModel)
+{
+    static auto* pShown = new std::vector<uno::WeakReferenceHelper>;
+    std::erase_if(*pShown, [](const uno::WeakReferenceHelper& r) { return !r.get().is(); });
+    for (const auto& r : *pShown)
+        if (r.get() == xModel)
+            return false;
+    pShown->emplace_back(xModel);
+    return true;
+}
+
+/// Size of the opened file in bytes, 0 when it is not a local .docx, .doc or .odt file
+sal_uInt64 FileSize(const SfxMedium& rMedium)
+{
+    const INetURLObject aURL(rMedium.GetName());
+    if (aURL.GetProtocol() != INetProtocol::File)
+        return 0;
+    const OUString aExtension = aURL.getExtension().toAsciiLowerCase();
+    if (aExtension != "docx" && aExtension != "doc" && aExtension != "odt")
+        return 0;
+    osl::DirectoryItem aItem;
+    osl::FileStatus aStatus(osl_FileStatus_Mask_FileSize);
+    if (osl::DirectoryItem::get(rMedium.GetName(), aItem) != osl::FileBase::E_None
+        || aItem.getFileStatus(aStatus) != osl::FileBase::E_None)
+        return 0;
+    return aStatus.getFileSize();
+}
+
+bool FrameAlive(const SfxViewFrame* pFrame)
+{
+    for (SfxViewFrame* p = SfxViewFrame::GetFirst(nullptr, false); p;
+         p = SfxViewFrame::GetNext(*p, nullptr, false))
+        if (p == pFrame)
+            return true;
+    return false;
+}
+
+void CloseLater(void* pFrame, void*)
+{
+    if (FrameAlive(static_cast<SfxViewFrame*>(pFrame)))
+        static_cast<SfxViewFrame*>(pFrame)->RemoveInfoBar(WARNING_BAR_ID);
+}
+
+// acts after the click handler has returned: the bar (and the button) goes away
+void CloseClicked(void* pFrame, weld::Button&)
+{
+    Application::PostUserEvent(LINK_NONMEMBER(pFrame, CloseLater));
+}
+
+void Show(SwView& rView)
+{
+    SwDocShell* pDocShell = rView.GetDocShell();
+    if (!pDocShell || pDocShell->IsReadOnly() || pDocShell->IsPreview()
+        || pDocShell->GetCreateMode() != SfxObjectCreateMode::STANDARD)
+        return;
+    // No bar without a user to see it. Background loads open hidden: soffice --convert-to and
+    // --print-to (also read-only), mail merge working documents, scripts and API conversions.
+    const SfxMedium* pMedium = pDocShell->GetMedium();
+    if (!pMedium)
+        return;
+    const SfxBoolItem* pHidden = pMedium->GetItemSet().GetItemIfSet(SID_HIDDEN, false);
+    if (pHidden && pHidden->GetValue())
+        return;
+    const sal_uInt64 nBytes = FileSize(*pMedium);
+    if (nBytes == 0 || nBytes <= Limit())
+        return;
+    const uno::Reference<uno::XInterface> xModel(pDocShell->GetModel(), uno::UNO_QUERY);
+    if (!xModel.is() || !FirstTime(xModel))
+        return;
+
+    SfxViewFrame& rFrame = rView.GetViewFrame();
+    const sal_uInt16 nId = SfxInfoBarContainerChild::GetChildWindowId();
+    if (!rFrame.HasChildWindow(nId))
+        rFrame.ToggleChildWindow(nId);
+    const bool bVi = Application::GetSettings().GetUILanguageTag().getLanguage() == "vi";
+    const OUString aMegabytes = OUString::number((nBytes + 512 * 1024) / (1024 * 1024));
+    const OUString aMessage
+        = (bVi ? u"Tệp rất lớn (%N MB). HST Office có thể mở chậm và dùng nhiều bộ nhớ; tệp chữ "
+                 "thuần trên 200 MB có thể không mở được với 16 GB RAM."_ustr
+               : u"This file is very large (%N MB). HST Office may open it slowly and use a lot of "
+                 "memory; text-only files over 200 MB may not open with 16 GB of RAM."_ustr)
+              .replaceFirst("%N", aMegabytes);
+    VclPtr<SfxInfoBarWindow> pBar
+        = rFrame.AppendInfoBar(WARNING_BAR_ID, OUString(), aMessage, InfobarType::WARNING, false);
+    if (!pBar)
+        return;
+    weld::Button& rClose = pBar->addButton();
+    rClose.set_label(bVi ? u"Đóng"_ustr : u"Close"_ustr);
+    rClose.connect_clicked(LINK_NONMEMBER(static_cast<void*>(&rFrame), CloseClicked));
+}
+
+void ShowLater(void* pModel, void*)
+{
+    std::unique_ptr<uno::WeakReferenceHelper> pWeak(
+        static_cast<uno::WeakReferenceHelper*>(pModel));
+    const uno::Reference<uno::XInterface> xModel = pWeak->get();
+    auto* pDocShell = xModel.is()
+                          ? dynamic_cast<SwDocShell*>(SfxObjectShell::GetShellFromComponent(xModel))
+                          : nullptr;
+    if (pDocShell && pDocShell->GetView())
+        Show(*pDocShell->GetView());
+}
+}
+
+void ScheduleWarning(const SwView& rView)
+{
+    if (comphelper::LibreOfficeKit::isActive())
+        return;
+    const SwDocShell* pDocShell = rView.GetDocShell();
+    if (!pDocShell || !pDocShell->GetModel().is())
+        return;
+    // the view is built while the document opens; the frame shows infobars once it has opened
+    Application::PostUserEvent(LINK_NONMEMBER(
+        static_cast<void*>(new uno::WeakReferenceHelper(
+            uno::Reference<uno::XInterface>(pDocShell->GetModel(), uno::UNO_QUERY))),
+        ShowLater));
+}
+}
