+#pragma once
+
+class SwView;
+
+/// The warning bar a very large Writer file (.docx, .doc, .odt over 100 MB) shows when it opens:
+/// it may open slowly and use much memory; text-only files over 200 MB may not open with 16 GB.
+namespace hst::largedoc
+{
+/// After the document has opened: shows the bar in rView's frame when the opened file is larger
+/// than the limit, the document is editable and visible, and it has not shown the bar in this
+/// session. The environment variable HST_LARGE_DOCUMENT_BYTES overrides the limit (tests).
+void ScheduleWarning(const SwView& rView);
+}
