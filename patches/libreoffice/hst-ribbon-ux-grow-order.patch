+/// The order in which the shown groups grow back: rGrowth (group indexes, first grown first), then the
+/// groups it leaves out in rPriority's order; rPriority alone when rGrowth is empty.
+inline std::vector<std::size_t> growthOrder(std::size_t nGroups, const std::vector<std::size_t>& rPriority,
+                                            const std::vector<std::size_t>& rGrowth)
+{
+    std::vector<std::size_t> aOrder;
+    std::vector<bool> aSeen(nGroups, false);
+    for (const std::vector<std::size_t>* pList : { &rGrowth, &rPriority })
+        for (std::size_t nGroup : *pList)
+            if (nGroup < nGroups && !aSeen[nGroup])
+            {
+                aSeen[nGroup] = true;
+                aOrder.push_back(nGroup);
+            }
+    return aOrder;
+}
