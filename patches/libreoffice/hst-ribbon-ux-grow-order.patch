+/// HST Office: the menu buttons of a group (Sheets' Cells and Editing: Insert, Delete, Format, Fill, Clear,
+/// Sort and Filter, Find and Select) drop their labels at the small state, as the toolboxes do; the label
+/// stays their accessible name and becomes their tooltip. Before, a group of menu buttons kept its full
+/// width at the small state, so the ladder collapsed it while a group of toolboxes beside it kept its
+/// labels. A button without an image keeps its label.
+struct MenuButtonLabels
+{
+    /// label (and whether the tooltip was set from it) of each button shown without its label
+    static std::map<const vcl::Window*, std::pair<OUString, bool>>& hidden()
+    {
+        static std::map<const vcl::Window*, std::pair<OUString, bool>> aHidden;
+        return aHidden;
+    }
+    DECL_STATIC_LINK(MenuButtonLabels, ButtonEventHdl, VclWindowEvent&, void);
+};
+
+IMPL_STATIC_LINK(MenuButtonLabels, ButtonEventHdl, VclWindowEvent&, rEvent, void)
+{
+    if (rEvent.GetId() == VclEventId::ObjectDying)
+        MenuButtonLabels::hidden().erase(rEvent.GetWindow());
+}
+
+void applyToMenuButton(MenuButton& rButton, int nState)
+{
+    auto& rHidden = MenuButtonLabels::hidden();
+    const auto it = rHidden.find(&rButton);
+    const bool bHide = nState == GroupSmall && !!rButton.GetModeImage();
+    if (bHide && it == rHidden.end() && !rButton.GetText().isEmpty())
+    {
+        const OUString aLabel = rButton.GetText();
+        rButton.SetAccessibleName(rButton.GetAccessibleName()); // the name of the label, kept
+        const bool bTip = rButton.GetQuickHelpText().isEmpty();
+        if (bTip)
+            rButton.SetQuickHelpText(aLabel.replaceAll("~", "").replace('\n', ' '));
+        rHidden.emplace(&rButton, std::make_pair(aLabel, bTip));
+        rButton.AddEventListener(LINK(nullptr, MenuButtonLabels, ButtonEventHdl));
+        rButton.SetText(OUString());
+        rButton.queue_resize();
+    }
+    else if (!bHide && it != rHidden.end())
+    {
+        rButton.RemoveEventListener(LINK(nullptr, MenuButtonLabels, ButtonEventHdl));
+        rButton.SetText(it->second.first);
+        if (it->second.second)
+            rButton.SetQuickHelpText(OUString());
+        rHidden.erase(it);
+        rButton.queue_resize();
+    }
+}
+
+template <typename F> void forMenuButtons(vcl::Window& rWindow, const F& rFunction)
+{
+    for (vcl::Window* pChild = rWindow.GetWindow(GetWindowType::FirstChild); pChild;
+         pChild = pChild->GetWindow(GetWindowType::Next))
+    {
+        if (dynamic_cast<PriorityMergedHBox*>(pChild))
+            continue; // a nested merged box runs its own ladder
+        if (MenuButton* pButton = dynamic_cast<MenuButton*>(pChild))
+            rFunction(*pButton);
+        else
+            forMenuButtons(*pChild, rFunction);
+    }
+}
+
