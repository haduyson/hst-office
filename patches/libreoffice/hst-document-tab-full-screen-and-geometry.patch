 // HST Office: the document tab group (framework) tells the frame of a tab window that it is a
 // group member (macOS and Windows: no window animation; macOS: tabs share the native full screen
 // Space). Declared here and in the framework instead of a public header on purpose.
+// HST Office: SystemWindow::SetWindowState without the #96568 displacement. The document tab group
+// (framework) gives a tab window the geometry of the tab it replaces while that tab is still shown at
+// the same place; the displacement moved every new or switched-to tab by the title bar height (28 px on
+// macOS), and back to the top once it left the screen, so the window jumped on each tab switch.
+static bool s_bHstWindowStateInPlace = false;
+
+SAL_DLLPUBLIC_EXPORT void hst_vcl_set_window_state_in_place(vcl::Window* pWindow, std::u16string_view rState)
+{
+    if (!pWindow || pWindow->isDisposed() || !pWindow->IsSystemWindow())
+        return;
+    s_bHstWindowStateInPlace = true;
+    static_cast<SystemWindow*>(pWindow)->SetWindowState(rState);
+    s_bHstWindowStateInPlace = false;
+}
