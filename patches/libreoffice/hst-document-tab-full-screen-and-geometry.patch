+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * This file is part of HST Office.
+ */
+
+#include <test/bootstrapfixture.hxx>
+
+#include <vcl/scheduler.hxx>
+#include <vcl/svapp.hxx>
+#include <vcl/windowstate.hxx>
+#include <vcl/wrkwin.hxx>
+
+#include <string_view>
+
+// vcl (syswin.cxx): SystemWindow::SetWindowState without the #96568 displacement
+void hst_vcl_set_window_state_in_place(vcl::Window* pWindow, std::u16string_view rState);
+
+namespace
+{
+constexpr std::u16string_view STATE = u"120,140,400,300;1;";
+
+/// Top left corner of a frame window from its window state.
+Point topLeft(WorkWindow& rWindow)
+{
+    const vcl::WindowData aData(rWindow.GetWindowState(vcl::WindowDataMask::Pos));
+    return Point(aData.x(), aData.y());
+}
+
+class WindowStateInPlaceTest : public test::BootstrapFixture
+{
+public:
+    WindowStateInPlaceTest()
+        : test::BootstrapFixture(true, false)
+    {
+    }
+};
+
+// A document tab takes over the geometry of the tab it replaces while that tab is still shown at the same
+// place: the in-place variant keeps the position, where SetWindowState moves the window off the shown frame.
+CPPUNIT_TEST_FIXTURE(WindowStateInPlaceTest, testTabTakesOverGeometryInPlace)
+{
+    SolarMutexGuard aGuard;
+    ScopedVclPtrInstance<WorkWindow> pShown(nullptr, WB_STDWORK);
+    pShown->SetWindowState(STATE);
+    pShown->Show();
+    Scheduler::ProcessEventsToIdle();
+    const Point aShownPos = topLeft(*pShown);
+
+    // upstream behaviour (#96568): a new frame over a shown one is displaced
+    ScopedVclPtrInstance<WorkWindow> pPlain(nullptr, WB_STDWORK);
+    pPlain->SetWindowState(pShown->GetWindowState(vcl::WindowDataMask::All));
+    CPPUNIT_ASSERT(topLeft(*pPlain) != aShownPos);
+
+    // the document tab: exactly where the shown tab is
+    ScopedVclPtrInstance<WorkWindow> pTab(nullptr, WB_STDWORK);
+    hst_vcl_set_window_state_in_place(pTab.get(), pShown->GetWindowState(vcl::WindowDataMask::All));
+    CPPUNIT_ASSERT_EQUAL(aShownPos, topLeft(*pTab));
+
+    // and the displacement is back for everything else afterwards
+    ScopedVclPtrInstance<WorkWindow> pLater(nullptr, WB_STDWORK);
+    pLater->SetWindowState(pShown->GetWindowState(vcl::WindowDataMask::All));
+    CPPUNIT_ASSERT(topLeft(*pLater) != aShownPos);
+}
+}
