--- a/vcl/source/control/HstRibbonPaint.cxx
+++ b/vcl/source/control/HstRibbonPaint.cxx
@@ -126,6 +126,46 @@
     }
     rDev.Pop();
 }
+
+FileTabColors fileTabColorsFor(const StyleSettings& rStyle, bool bPressed, bool bHover)
+{
+    if (rStyle.GetHighContrastMode())
+        return FileTabColors{ rStyle.GetHighlightColor(), rStyle.GetHighlightTextColor() };
+    // white text reads at 4.5:1 or more on every fill; the dark theme starts one step lighter so
+    // that the button stands out from the dark tab row
+    constexpr Color aBrand(0x00, 0x72, 0xBB);
+    constexpr Color aDarker(0x00, 0x61, 0x9F);
+    if (rStyle.GetDialogColor().IsDark())
+        return FileTabColors{ bPressed ? aDarker : bHover ? aBrand : Color(0x0A, 0x7A, 0xC6),
+                              COL_WHITE };
+    return FileTabColors{ bPressed ? Color(0x00, 0x4F, 0x82) : bHover ? aDarker : aBrand,
+                          COL_WHITE };
+}
+
+tools::Long FileTabExtraWidth(const OutputDevice& rDev) { return scaled(rDev, 14); }
+
+Color DrawFileTab(vcl::RenderContext& rDev, const tools::Rectangle& rItem, bool bPressed,
+                  bool bHover)
+{
+    const StyleSettings& rStyle = rDev.GetSettings().GetStyleSettings();
+    const FileTabColors aColors = fileTabColorsFor(rStyle, bPressed, bHover);
+    const tools::Long nInset = scaled(rDev, 2);
+    tools::Rectangle aFill(rItem);
+    aFill.AdjustLeft(nInset);
+    aFill.AdjustTop(nInset);
+    aFill.AdjustRight(-nInset);
+    aFill.AdjustBottom(-nInset);
+    rDev.Push(vcl::PushFlags::LINECOLOR | vcl::PushFlags::FILLCOLOR);
+    // high contrast has one fill colour only: the state shows as an outline
+    if (rStyle.GetHighContrastMode() && (bPressed || bHover))
+        rDev.SetLineColor(aColors.aText);
+    else
+        rDev.SetLineColor();
+    rDev.SetFillColor(aColors.aFill);
+    rDev.DrawRect(aFill, scaled(rDev, 4), scaled(rDev, 4));
+    rDev.Pop();
+    return aColors.aText;
+}
 }
 
