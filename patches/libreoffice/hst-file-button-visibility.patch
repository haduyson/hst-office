+
+/** The name of the File tab ("Tệp tin") in the notebookbar .ui files. It opens the File panel and
+    never shows ribbon content of its own, so it is drawn as a button, not as a tab. */
+inline constexpr OUString FILE_TAB_NAME = u"FileLabel"_ustr;
+
+/** The fill and text colours of the File button: the HST brand blue with white text; darker when
+    hovered, darkest while it is pressed. In high contrast: the system selection colours. */
+struct FileTabColors
+{
+    Color aFill;
+    Color aText;
+};
+VCL_DLLPUBLIC FileTabColors fileTabColorsFor(const StyleSettings& rStyle, bool bPressed, bool bHover);
+
+/** The extra width of the File button over a plain tab: room for its bold label and the padding
+    inside the filled shape. */
+SAL_DLLPRIVATE tools::Long FileTabExtraWidth(const OutputDevice& rDev);
+
+/** The filled, rounded File button inside rItem (the full height of the tab row, like the tabs);
+    in high contrast with an outline in the text colour while hovered or pressed. Returns the
+    colour for its label. */
+SAL_DLLPRIVATE Color DrawFileTab(vcl::RenderContext& rDev, const tools::Rectangle& rItem,
+                                 bool bPressed, bool bHover);
 }
 
