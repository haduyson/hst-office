HST Office: document tab colours of HST's own. Writer (and Base/XForms) uses the HASON TECH logo blue #0072BB, Sheets
#3A6B12 and Slides #C25E00 instead of the Word, Excel and PowerPoint brand colours; Draw (#7B3F9E) and the grey
fallback stay.

License: these upstream files remain under their original license (MPL-2.0).

--- a/framework/source/services/documenttabgroup.cxx
+++ b/framework/source/services/documenttabgroup.cxx
@@ -177,11 +177,11 @@
         const OUString aModule = xManager->identify(xFrame);
         if (aModule.startsWith("com.sun.star.text.") || aModule.startsWith("com.sun.star.sdb.")
             || aModule == "com.sun.star.xforms.XMLFormDocument")
-            return Color(0x2B, 0x57, 0x9A);
+            return Color(0x00, 0x72, 0xBB); // HASON TECH logo blue
         if (aModule == "com.sun.star.sheet.SpreadsheetDocument")
-            return Color(0x21, 0x73, 0x46);
+            return Color(0x3A, 0x6B, 0x12);
         if (aModule == "com.sun.star.presentation.PresentationDocument")
-            return Color(0xC4, 0x3E, 0x1C);
+            return Color(0xC2, 0x5E, 0x00);
         if (aModule == "com.sun.star.drawing.DrawingDocument")
             return Color(0x7B, 0x3F, 0x9E);
     }
