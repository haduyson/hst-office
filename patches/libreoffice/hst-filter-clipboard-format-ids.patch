+CPPUNIT_TEST_FIXTURE(MiscTest, testOdfStorageTypeDetection)
+{
+    // An embedded object (a spreadsheet in a text document) is stored into a storage whose
+    // MediaType is the only hint about its format: the clipboard format names of the filter types
+    // must stay the ones sot knows ("Calc 8", "Impress 8"), or the object is not stored, its
+    // container stays unset and the .docx export crashed on it.
+    const std::pair<OUString, OUString> aTypes[] = {
+        { u"application/vnd.oasis.opendocument.text"_ustr, u"writer8"_ustr },
+        { u"application/vnd.oasis.opendocument.spreadsheet"_ustr, u"calc8"_ustr },
+        { u"application/vnd.oasis.opendocument.spreadsheet-template"_ustr, u"calc8_template"_ustr },
+        { u"application/vnd.oasis.opendocument.presentation"_ustr, u"impress8"_ustr },
+        { u"application/vnd.oasis.opendocument.presentation-template"_ustr, u"impress8_template"_ustr },
+        { u"application/vnd.oasis.opendocument.graphics"_ustr, u"draw8"_ustr },
+        { u"application/vnd.oasis.opendocument.formula"_ustr, u"math8"_ustr },
+    };
+    for (const auto& [rMediaType, rType] : aTypes)
+    {
+        uno::Reference<embed::XStorage> xStorage = comphelper::OStorageHelper::GetTemporaryStorage();
+        uno::Reference<beans::XPropertySet> xProps(xStorage, uno::UNO_QUERY_THROW);
+        xProps->setPropertyValue(u"MediaType"_ustr, uno::Any(rMediaType));
+        CPPUNIT_ASSERT_EQUAL_MESSAGE(rMediaType.toUtf8().getStr(), rType,
+                                     SfxFilter::GetTypeFromStorage(xStorage));
+    }
+}
 }
 
