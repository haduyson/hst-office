+/// The document tab strip of the window (framework DocumentTabBar, id "hst-document-tabs") when it shows.
+const vcl::Window* lcl_findDocumentTabs(const vcl::Window& rParent)
+{
+    for (const vcl::Window* pChild = rParent.GetWindow(GetWindowType::FirstChild); pChild;
+         pChild = pChild->GetWindow(GetWindowType::Next))
+    {
+        if (pChild->get_id() == u"hst-document-tabs")
+            return pChild->IsReallyVisible() ? pChild : nullptr;
+        if (const vcl::Window* pFound = lcl_findDocumentTabs(*pChild))
+            return pFound;
+    }
+    return nullptr;
+}
