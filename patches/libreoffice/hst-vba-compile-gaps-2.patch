+// HST: #1/2/2020 5:07 AM#: only such characters up to the closing #, which no file number statement has
+static bool lcl_isDateWithBlanks( std::u16string_view rLine, sal_Int32 nHash )
+{
+    size_t n = nHash + 1;
+    if( n >= rLine.size() || !rtl::isAsciiDigit( rLine[n] ) )
+        return false;
+    for( ; n < rLine.size() && rLine[n] != '#'; ++n )
+    {
+        const sal_Unicode c = rLine[n];
+        if( !rtl::isAsciiDigit( c ) && c != '/' && c != '-' && c != ':' && c != '.' && c != ' '
+            && c != 'A' && c != 'a' && c != 'P' && c != 'p' && c != 'M' && c != 'm' )
+            return false;
+    }
+    return n < rLine.size();
+}
