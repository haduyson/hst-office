+#pragma once
+
+#include <com/sun/star/uno/Any.hxx>
+#include <com/sun/star/uno/Reference.hxx>
+#include <com/sun/star/view/XSelectionSupplier.hpp>
+#include <vcl/svapp.hxx>
+#include <vcl/threadex.hxx>
+
+namespace sd::hst
+{
+/** Runs a selection request made on a thread other than the main thread (a remote UNO client's
+    bridge thread) on the main thread instead.
+
+    Changing the selection rebuilds the view shell stack while holding the ViewShellManager's own
+    mutex, and the new sidebar context can create panel windows. On Windows a native window
+    created on another thread is created on the main thread through SendMessage, with the
+    SolarMutex released meanwhile; the main thread can then take the SolarMutex and need the
+    ViewShellManager mutex, while the calling thread waits for the SolarMutex: a deadlock (Draw
+    and Impress hang after a table edit followed by an API selection change).
+
+    @return false when called on the main thread (the caller selects as usual); otherwise true,
+    with the forwarded select() result in rSelected. */
+inline bool selectOnMainThread(css::view::XSelectionSupplier& rController,
+                               const css::uno::Any& rSelection, bool& rSelected)
+{
+    if (Application::IsMainThread())
+        return false;
+    const css::uno::Reference<css::view::XSelectionSupplier> xController(&rController);
+    // syncExecute releases the SolarMutex while it waits, so the calling thread must own it
+    const SolarMutexGuard aGuard;
+    rSelected = vcl::solarthread::syncExecute(
+        [xController, rSelection]() -> bool { return xController->select(rSelection); });
+    return true;
+}
+}
