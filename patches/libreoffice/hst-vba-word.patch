+namespace
+{
+/// HST: true when every module of the library can be stored in eEncoding without loss: the
+/// export's conversion (which composes Vietnamese letters for Windows-1258) adds no '?'.
+bool lcl_canEncodeModules(const css::uno::Reference<css::container::XNameContainer>& xLibrary,
+                          rtl_TextEncoding eEncoding)
+{
+    if (!xLibrary.is())
+        return true;
+    for (const OUString& rName : xLibrary->getElementNames())
+    {
+        OUString aCode;
+        xLibrary->getByName(rName) >>= aCode;
+        const OString aEncoded = OUStringToOString(aCode, eEncoding);
+        sal_Int32 nBefore = 0, nAfter = 0;
+        for (sal_Int32 i = 0; i < aCode.getLength(); ++i)
+            nBefore += aCode[i] == '?';
+        for (sal_Int32 i = 0; i < aEncoded.getLength(); ++i)
+            nAfter += aEncoded[i] == '?';
+        if (nAfter != nBefore)
+            return false;
+    }
+    return true;
+}
+}
