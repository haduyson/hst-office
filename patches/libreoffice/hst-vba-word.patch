+// HST: Word's ListFormat.ApplyBulletDefault: the paragraphs of the range get the default bullet
+// list style ("List 1"); when they already have it, the bullets are removed (Word toggles too).
+void SAL_CALL SwVbaListFormat::ApplyBulletDefault( const css::uno::Any& /*DefaultListBehavior*/ )
+{
+    static constexpr OUString aBulletStyle = u"List 1"_ustr;
+    uno::Reference< container::XEnumerationAccess > xEnumAccess( mxTextRange, uno::UNO_QUERY_THROW );
+    std::vector< uno::Reference< beans::XPropertySet > > aParagraphs;
+    uno::Reference< container::XEnumeration > xEnum = xEnumAccess->createEnumeration();
+    while( xEnum->hasMoreElements() )
+    {
+        uno::Reference< lang::XServiceInfo > xInfo( xEnum->nextElement(), uno::UNO_QUERY );
+        if( xInfo.is() && xInfo->supportsService( u"com.sun.star.text.Paragraph"_ustr ) )
+            aParagraphs.emplace_back( xInfo, uno::UNO_QUERY_THROW );
+    }
+    if( aParagraphs.empty() )
+        return;
+    OUString aCurrent;
+    aParagraphs.front()->getPropertyValue( u"NumberingStyleName"_ustr ) >>= aCurrent;
+    const OUString aNew = aCurrent == aBulletStyle ? OUString() : aBulletStyle;
+    for( const auto& xProps : aParagraphs )
+        xProps->setPropertyValue( u"NumberingStyleName"_ustr, uno::Any( aNew ) );
+}
