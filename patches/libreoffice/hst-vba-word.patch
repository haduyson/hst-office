+SwVbaTextUnits::SwVbaTextUnits(const uno::Reference<XHelperInterface>& xParent,
+                               const uno::Reference<uno::XComponentContext>& xContext,
+                               const rtl::Reference<SwXTextDocument>& xTextDocument, Unit eUnit)
+    : SwVbaTextUnits_BASE(xParent, xContext,
+                          new TextUnitsIndexAccess(lcl_split(xTextDocument, eUnit)))
+    , mxTextDocument(xTextDocument)
+    , meUnit(eUnit)
+{
+}
+
+uno::Type SwVbaTextUnits::getElementType() { return cppu::UnoType<word::XRange>::get(); }
+
+uno::Reference<container::XEnumeration> SwVbaTextUnits::createEnumeration()
+{
+    return new TextUnitsEnumWrapper(this);
+}
+
+uno::Any SwVbaTextUnits::createCollectionObject(const uno::Any& aSource)
+{
+    uno::Reference<text::XTextRange> xRange(aSource, uno::UNO_QUERY_THROW);
+    return uno::Any(uno::Reference<word::XRange>(new SwVbaRange(
+        mxParent, mxContext, mxTextDocument, xRange->getStart(), xRange->getEnd(), xRange->getText())));
+}
+
+OUString SwVbaTextUnits::getServiceImplName()
+{
+    return meUnit == Unit::Word ? u"SwVbaWords"_ustr : u"SwVbaSentences"_ustr;
+}
+
+uno::Sequence<OUString> SwVbaTextUnits::getServiceNames()
+{
+    static uno::Sequence<OUString> const aWords{ u"ooo.vba.word.Words"_ustr };
+    static uno::Sequence<OUString> const aSentences{ u"ooo.vba.word.Sentences"_ustr };
+    return meUnit == Unit::Word ? aWords : aSentences;
+}
