+/// Splits the body text into words or sentences once, when the collection is created.
+std::vector<uno::Reference<text::XTextRange>> lcl_split(const rtl::Reference<SwXTextDocument>& xDoc,
+                                                        SwVbaTextUnits::Unit eUnit)
+{
+    std::vector<uno::Reference<text::XTextRange>> aUnits;
+    uno::Reference<text::XText> xText = xDoc->getText();
+    uno::Reference<text::XTextCursor> xCursor = xText->createTextCursor();
+    uno::Reference<text::XWordCursor> xWord(xCursor, uno::UNO_QUERY_THROW);
+    uno::Reference<text::XSentenceCursor> xSentence(xCursor, uno::UNO_QUERY_THROW);
+    xCursor->gotoStart(false);
+    for (;;)
+    {
+        uno::Reference<text::XTextRange> xStart = xCursor->getStart();
+        bool bMore = eUnit == SwVbaTextUnits::Unit::Word ? xWord->gotoNextWord(true)
+                                                         : xSentence->gotoNextSentence(true);
+        if (!bMore)
+            xCursor->gotoEnd(true);
+        if (xCursor->isCollapsed())
+            break; // end of text (or no progress)
+        uno::Reference<text::XTextCursor> xUnit = xText->createTextCursorByRange(xStart);
+        xUnit->gotoRange(xCursor->getEnd(), true);
+        aUnits.push_back(xUnit);
+        if (!bMore)
+            break;
+        xCursor->collapseToEnd();
+    }
+    return aUnits;
+}
+
+class TextUnitsEnumWrapper : public EnumerationHelper_BASE
+{
+    uno::Reference<XCollection> mxCollection;
+    sal_Int32 mnIndex;
+
+public:
+    explicit TextUnitsEnumWrapper(uno::Reference<XCollection> xCollection)
+        : mxCollection(std::move(xCollection))
+        , mnIndex(0)
+    {
+    }
+
+    sal_Bool SAL_CALL hasMoreElements() override { return mnIndex < mxCollection->getCount(); }
+
+    uno::Any SAL_CALL nextElement() override
+    {
+        if (mnIndex < mxCollection->getCount())
+            return mxCollection->Item(uno::Any(++mnIndex), uno::Any());
+        throw container::NoSuchElementException();
+    }
+};
+
+class TextUnitsIndexAccess : public ::cppu::WeakImplHelper<container::XIndexAccess>
+{
+    std::vector<uno::Reference<text::XTextRange>> maUnits;
+
+public:
+    explicit TextUnitsIndexAccess(std::vector<uno::Reference<text::XTextRange>>&& rUnits)
+        : maUnits(std::move(rUnits))
+    {
+    }
+
+    sal_Int32 SAL_CALL getCount() override { return static_cast<sal_Int32>(maUnits.size()); }
+
+    uno::Any SAL_CALL getByIndex(sal_Int32 nIndex) override
+    {
+        if (nIndex < 0 || nIndex >= getCount())
+            throw lang::IndexOutOfBoundsException();
+        return uno::Any(maUnits[nIndex]);
+    }
+
+    uno::Type SAL_CALL getElementType() override { return cppu::UnoType<text::XTextRange>::get(); }
+
+    sal_Bool SAL_CALL hasElements() override { return !maUnits.empty(); }
+};
+}
