HST Office: the Slides transition and animation galleries are no taller than the other ribbon groups.

The galleries' paging buttons were ordinary buttons, three of them stacked, so the Transitions and
Animations pages were 134 px high where every other page is 120: the Slides ribbon grew to 226 px, the
tallest page sets the ribbon's height on every tab. They are now small buttons, as the Styles gallery's,
and the Slides ribbon has the height of its groups again.

- sd hsttransitiongallery.ui, hstanimationgallery.ui: small-button class, 18x20 buttons, centred column.

License: these upstream files remain under their original license (MPL-2.0).
---
--- a/sd/uiconfig/simpress/ui/hstanimationgallery.ui
+++ b/sd/uiconfig/simpress/ui/hstanimationgallery.ui
@@ -64,6 +64,7 @@
         <property name="can-focus">False</property>
         <property name="orientation">vertical</property>
         <property name="homogeneous">True</property>
+        <property name="valign">center</property>
         <child>
           <object class="GtkButton" id="prev">
             <property name="visible">True</property>
@@ -72,6 +73,11 @@
             <property name="tooltip-text" translatable="yes" context="hstanimationgallery|prev">Previous animations</property>
             <property name="label">◂</property>
             <property name="relief">none</property>
+            <property name="height-request">20</property>
+            <property name="width-request">18</property>
+            <style>
+              <class name="small-button"/>
+            </style>
             <child internal-child="accessible">
               <object class="AtkObject" id="prev-atkobject">
                 <property name="AtkObject::accessible-name" translatable="yes" context="hstanimationgallery|prev-atkobject">Previous animations</property>
@@ -92,6 +98,11 @@
             <property name="tooltip-text" translatable="yes" context="hstanimationgallery|next">Next animations</property>
             <property name="label">▸</property>
             <property name="relief">none</property>
+            <property name="height-request">20</property>
+            <property name="width-request">18</property>
+            <style>
+              <class name="small-button"/>
+            </style>
             <child internal-child="accessible">
               <object class="AtkObject" id="next-atkobject">
                 <property name="AtkObject::accessible-name" translatable="yes" context="hstanimationgallery|next-atkobject">Next animations</property>
@@ -112,6 +123,11 @@
             <property name="tooltip-text" translatable="yes" context="hstanimationgallery|more">All animations and their options</property>
             <property name="label">▾</property>
             <property name="relief">none</property>
+            <property name="height-request">20</property>
+            <property name="width-request">18</property>
+            <style>
+              <class name="small-button"/>
+            </style>
             <child internal-child="accessible">
               <object class="AtkObject" id="more-atkobject">
                 <property name="AtkObject::accessible-name" translatable="yes" context="hstanimationgallery|more-atkobject">All animations</property>
