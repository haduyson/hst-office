--- /dev/null
+++ b/xmlsecurity/source/hst/signaturestatus.hxx
@@ -0,0 +1,35 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ * This file is part of HST Office.
+ */
+
+#pragma once
+
+#include <rtl/ustring.hxx>
+#include <xmlsecuritydllapi.h>
+
+namespace weld
+{
+class Image;
+class Label;
+}
+
+namespace hst::xmlsec
+{
+/* HST Office: how the signature dialogs tell a signature that is not verified apart from a valid one.
+
+   The signatures list shows only the signer's name next to a small icon; a signature that does not verify
+   (wrong hash, incomplete copy, untrusted or unchecked certificate) gets "(not verified)" after the name.
+   The certificate viewer opened from such a signature says that the signature itself is not valid instead
+   of judging the certificate alone ("This certificate is validated." would read as a valid signature), and
+   does not check the certificate (which may fetch issuer and revocation data online). */
+
+/// rSigner as the list shows it: unchanged when verified, else with "(not verified)".
+XMLSECURITY_DLLPUBLIC OUString SignerWithStatus(const OUString& rSigner, bool bVerified);
+
+/// The certificate viewer's status line for a certificate shown from a signature that is not valid.
+XMLSECURITY_DLLPUBLIC void ShowSignatureNotValid(weld::Image& rIcon, weld::Label& rHint);
+}
+
+/* vim:set shiftwidth=4 softtabstop=4 expandtab: */
--- /dev/null
+++ b/xmlsecurity/source/hst/signaturestatus.cxx
@@ -0,0 +1,32 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ * This file is part of HST Office.
+ */
+
+#include "signaturestatus.hxx"
+
+#include <bitmaps.hlst>
+#include <resourcemanager.hxx>
+#include <strings.hrc>
+
+#include <vcl/weld/Image.hxx>
+#include <vcl/weld/Label.hxx>
+
+namespace hst::xmlsec
+{
+OUString SignerWithStatus(const OUString& rSigner, bool bVerified)
+{
+    if (bVerified)
+        return rSigner;
+    return XsResId(STR_HST_SIGNER_NOT_VERIFIED).replaceFirst("%1", rSigner);
+}
+
+void ShowSignatureNotValid(weld::Image& rIcon, weld::Label& rHint)
+{
+    rIcon.set_from_icon_name(BMP_STATE_NOT_VALIDATED);
+    rHint.set_label(XsResId(STR_HST_SIGNATURE_NOT_VALID_CERTIFICATE));
+}
+}
