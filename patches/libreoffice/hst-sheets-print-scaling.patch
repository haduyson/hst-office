+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+#include <printscale.hxx>
+
+#include <attrib.hxx>
+#include <docsh.hxx>
+#include <document.hxx>
+#include <globstr.hrc>
+#include <sc.hrc>
+#include <scitems.hxx>
+#include <scresid.hxx>
+#include <stlpool.hxx>
+#include <strings.hrc>
+#include <tabvwsh.hxx>
+#include <undostyl.hxx>
+
+#include <sfx2/bindings.hxx>
+#include <svl/eitem.hxx>
+#include <svl/intitem.hxx>
+#include <svl/itemset.hxx>
+#include <svl/style.hxx>
+#include <svl/undo.hxx>
+
+#include <map>
+#include <memory>
+
+namespace sc::printscale
+{
+namespace
+{
+constexpr sal_uInt16 aScaleSlots[] = { SID_PRINTSCALE_NONE, SID_PRINTSCALE_FIT_SHEET, SID_PRINTSCALE_FIT_COLUMNS,
+                                       SID_PRINTSCALE_FIT_ROWS, SID_PRINTSCALE_OPTIONS, SID_PRINTSCALE_MENU,
+                                       SID_PREVIEW_SCALINGFACTOR, FID_RESET_PRINTZOOM, 0 };
+
+SfxStyleSheetBase* FindPageStyle(ScDocument& rDoc, const OUString& rName)
+{
+    return rDoc.GetStyleSheetPool()->Find(rName, SfxStyleFamily::Page);
+}
+
+/// Writes the settings into the page style (and records the change for undo).
+void ModifyStyle(ScDocShell& rDocShell, const OUString& rName, const PrintScaleSettings& rSettings,
+                 SfxUndoManager* pUndoMgr)
+{
+    ScDocument& rDoc = rDocShell.GetDocument();
+    SfxStyleSheetBase* pStyle = FindPageStyle(rDoc, rName);
+    if (!pStyle)
+        return;
+
+    ScStyleSaveData aOldData;
+    if (pUndoMgr)
+        aOldData.InitFromStyle(pStyle);
+
+    SfxItemSet& rStyleSet = pStyle->GetItemSet();
+    SfxItemSet aChanges(SfxItemSet::makeFixedSfxItemSet<ATTR_PAGE_SCALE, ATTR_PAGE_SCALETOPAGES, ATTR_PAGE_SCALETO,
+                                                        ATTR_PAGE_SCALETO>(*rStyleSet.GetPool()));
+    aChanges.Put(SfxUInt16Item(ATTR_PAGE_SCALE, rSettings.nPercent));
+    aChanges.Put(SfxUInt16Item(ATTR_PAGE_SCALETOPAGES, rSettings.nPages));
+    aChanges.Put(ScPageScaleToItem(rSettings.nWidth, rSettings.nHeight));
+    rDoc.ModifyStyleSheet(*pStyle, aChanges);
+
+    if (pUndoMgr)
+    {
+        ScStyleSaveData aNewData;
+        aNewData.InitFromStyle(pStyle);
+        pUndoMgr->AddUndoAction(
+            std::make_unique<ScUndoModifyStyle>(rDocShell, SfxStyleFamily::Page, aOldData, aNewData));
+    }
+    rDocShell.PageStyleModified(rName, true);
+}
+
+/// Gives the sheet its own copy of its page style and returns the name of the copy.
+OUString SplitStyle(ScDocShell& rDocShell, SCTAB nTab, SfxUndoManager* pUndoMgr)
+{
+    ScDocument& rDoc = rDocShell.GetDocument();
+    const OUString aOldName = rDoc.GetPageStyle(nTab);
+    SfxStyleSheetBase* pSource = FindPageStyle(rDoc, aOldName);
+    if (!pSource)
+        return aOldName;
+
+    OUString aTabName;
+    rDoc.GetName(nTab, aTabName);
+    const OUString aBase = "PageStyle_" + aTabName;
+    OUString aNewName = aBase;
+    for (sal_Int32 n = 2; FindPageStyle(rDoc, aNewName); ++n)
+        aNewName = aBase + "_" + OUString::number(n);
+
+    SfxStyleSheetBase& rCopy
+        = rDoc.GetStyleSheetPool()->Make(aNewName, SfxStyleFamily::Page, SfxStyleSearchBits::UserDefined);
+    if (!pSource->GetParent().isEmpty())
+        rCopy.SetParent(pSource->GetParent());
+    rCopy.GetItemSet().Put(pSource->GetItemSet());
+    if (pUndoMgr)
+    {
+        ScStyleSaveData aNoStyle, aNewData; // an empty old name: undo deletes the style, redo creates it
+        aNewData.InitFromStyle(&rCopy);
+        pUndoMgr->AddUndoAction(
+            std::make_unique<ScUndoModifyStyle>(rDocShell, SfxStyleFamily::Page, aNoStyle, aNewData));
+    }
+
+    rDoc.SetPageStyle(nTab, aNewName);
+    if (pUndoMgr)
+    {
+        auto pApply = std::make_unique<ScUndoApplyPageStyle>(rDocShell, aNewName);
+        pApply->AddSheetAction(nTab, aOldName);
+        pUndoMgr->AddUndoAction(std::move(pApply));
+    }
+    return aNewName;
+}
+}
+
+PrintScaleSettings GetSettings(const SfxItemSet& rStyleSet)
+{
+    PrintScaleSettings aSettings;
+    aSettings.nPercent = rStyleSet.Get(ATTR_PAGE_SCALE).GetValue();
+    aSettings.nPages = rStyleSet.Get(ATTR_PAGE_SCALETOPAGES).GetValue();
+    const ScPageScaleToItem& rScaleTo = rStyleSet.Get(ATTR_PAGE_SCALETO);
+    aSettings.nWidth = rScaleTo.GetWidth();
+    aSettings.nHeight = rScaleTo.GetHeight();
+    return aSettings;
+}
+
+PrintScaleSettings GetSettings(const ScDocument& rDoc, SCTAB nTab)
+{
+    SfxStyleSheetBase* pStyle
+        = rDoc.GetStyleSheetPool()->Find(rDoc.GetPageStyle(nTab), SfxStyleFamily::Page);
+    return pStyle ? GetSettings(pStyle->GetItemSet()) : PrintScaleSettings();
+}
+
+PrintScaleMode GetMode(const PrintScaleSettings& rSettings)
+{
+    if (rSettings.nPages)
+        return rSettings.nPages == 1 ? PrintScaleMode::FitSheet : PrintScaleMode::Custom;
+    if (rSettings.nWidth || rSettings.nHeight)
+    {
+        if (rSettings.nWidth == 1 && rSettings.nHeight == 1)
+            return PrintScaleMode::FitSheet;
+        if (rSettings.nWidth == 1 && rSettings.nHeight == 0)
+            return PrintScaleMode::FitColumns;
+        if (rSettings.nWidth == 0 && rSettings.nHeight == 1)
+            return PrintScaleMode::FitRows;
+        return PrintScaleMode::Custom;
+    }
+    // ScPrintFunc prints a zoom of 0 at 100 %
+    return (rSettings.nPercent == 100 || rSettings.nPercent == 0) ? PrintScaleMode::None
+                                                                    : PrintScaleMode::Custom;
+}
+
+PrintScaleSettings GetSettings(PrintScaleMode eMode)
+{
+    switch (eMode)
+    {
+        case PrintScaleMode::FitSheet:
+            return { 0, 0, 1, 1 };
+        case PrintScaleMode::FitColumns:
+            return { 0, 0, 1, 0 };
+        case PrintScaleMode::FitRows:
+            return { 0, 0, 0, 1 };
+        case PrintScaleMode::None:
+        case PrintScaleMode::Custom:
+            break;
+    }
+    return { 100, 0, 0, 0 };
+}
+
+OUString GetCustomLabel(const PrintScaleSettings& rSettings)
+{
+    if (rSettings.nPages)
+        return ScResId(STR_PRINTSCALE_CUSTOM_PAGES).replaceFirst("%1", OUString::number(rSettings.nPages));
+    if (rSettings.nWidth || rSettings.nHeight)
+    {
+        const OUString aAutomatic = ScResId(STR_PRINTSCALE_AUTOMATIC);
+        return ScResId(STR_PRINTSCALE_CUSTOM_SIZE)
+            .replaceFirst("%1", rSettings.nWidth ? OUString::number(rSettings.nWidth) : aAutomatic)
+            .replaceFirst("%2", rSettings.nHeight ? OUString::number(rSettings.nHeight) : aAutomatic);
+    }
+    return ScResId(STR_PRINTSCALE_CUSTOM_PERCENT).replaceFirst("%1", OUString::number(rSettings.nPercent));
+}
+
+bool Apply(ScDocShell& rDocShell, const std::vector<std::pair<SCTAB, PrintScaleSettings>>& rTargets)
+{
+    if (rDocShell.IsReadOnly())
+        return false;
+
+    ScDocument& rDoc = rDocShell.GetDocument();
+    const SCTAB nTabCount = rDoc.GetTableCount();
+    std::map<SCTAB, PrintScaleSettings> aChanges;
+    for (const auto& [nTab, rSettings] : rTargets)
+        if (nTab >= 0 && nTab < nTabCount && GetSettings(rDoc, nTab) != rSettings)
+            aChanges[nTab] = rSettings;
+    if (aChanges.empty())
+        return false;
+
+    SfxUndoManager* pUndoMgr = rDoc.IsUndoEnabled() ? rDocShell.GetUndoManager() : nullptr;
+    if (pUndoMgr)
+    {
+        const OUString aComment = ScResId(STR_UNDO_PRINTSCALE);
+        ViewShellId nViewShellId(-1);
+        if (ScTabViewShell* pViewSh = ScTabViewShell::GetActiveViewShell())
+            nViewShellId = pViewSh->GetViewShellId();
+        pUndoMgr->EnterListAction(aComment, aComment, 0, nViewShellId);
+    }
+
+    std::map<OUString, std::vector<SCTAB>> aTabsByStyle;
+    for (const auto& rChange : aChanges)
+        aTabsByStyle[rDoc.GetPageStyle(rChange.first)].push_back(rChange.first);
+
+    for (const auto& [rStyleName, rTabs] : aTabsByStyle)
+    {
+        // The style itself changes only when every sheet that uses it gets the same settings.
+        const PrintScaleSettings& rFirst = aChanges[rTabs.front()];
+        bool bWholeStyle = true;
+        for (SCTAB nTab = 0; nTab < nTabCount && bWholeStyle; ++nTab)
+        {
+            if (rDoc.GetPageStyle(nTab) != rStyleName)
+                continue;
+            auto it = aChanges.find(nTab);
+            bWholeStyle = it != aChanges.end() && it->second == rFirst;
+        }
+
+        if (bWholeStyle)
+            ModifyStyle(rDocShell, rStyleName, rFirst, pUndoMgr);
+        else
+            for (SCTAB nTab : rTabs)
+                ModifyStyle(rDocShell, SplitStyle(rDocShell, nTab, pUndoMgr), aChanges[nTab], pUndoMgr);
+    }
+
+    if (pUndoMgr)
+        pUndoMgr->LeaveListAction();
+
+    rDocShell.PostPaint(0, 0, 0, rDoc.MaxCol(), rDoc.MaxRow(), MAXTAB,
+                        PaintPartFlags::Grid | PaintPartFlags::Left);
+    if (SfxBindings* pBindings = rDocShell.GetViewBindings())
+    {
+        pBindings->Invalidate(aScaleSlots);
+        pBindings->Invalidate(SID_STATUS_PAGESTYLE);
+    }
+    return true;
+}
+
+bool Apply(ScDocShell& rDocShell, const std::vector<SCTAB>& rTabs, PrintScaleMode eMode)
+{
+    const PrintScaleSettings aSettings = GetSettings(eMode);
+    std::vector<std::pair<SCTAB, PrintScaleSettings>> aTargets;
+    aTargets.reserve(rTabs.size());
+    for (SCTAB nTab : rTabs)
+        aTargets.emplace_back(nTab, aSettings);
+    return Apply(rDocShell, aTargets);
+}
+
+std::optional<PrintScaleMode> ModeForSlot(sal_uInt16 nSlot)
+{
+    switch (nSlot)
+    {
+        case SID_PRINTSCALE_NONE:
+            return PrintScaleMode::None;
+        case SID_PRINTSCALE_FIT_SHEET:
+            return PrintScaleMode::FitSheet;
+        case SID_PRINTSCALE_FIT_COLUMNS:
+            return PrintScaleMode::FitColumns;
+        case SID_PRINTSCALE_FIT_ROWS:
+            return PrintScaleMode::FitRows;
+        default:
+            return std::nullopt;
+    }
+}
+
+bool ExecuteSlot(ScDocShell& rDocShell, const std::vector<SCTAB>& rTabs, sal_uInt16 nSlot)
+{
+    const std::optional<PrintScaleMode> eMode = ModeForSlot(nSlot);
+    if (!eMode)
+        return false;
+    Apply(rDocShell, rTabs, *eMode);
+    return true;
+}
+
+void GetSlotState(const ScDocShell& rDocShell, SCTAB nTab, SfxItemSet& rSet, sal_uInt16 nWhich)
+{
+    // as the page style dialog: page styles cannot change in a read-only or shared document
+    if (rDocShell.IsReadOnly() || rDocShell.IsDocShared())
+    {
+        rSet.DisableItem(nWhich);
+        return;
+    }
+    if (const std::optional<PrintScaleMode> eMode = ModeForSlot(nWhich))
+        rSet.Put(SfxBoolItem(nWhich, GetMode(GetSettings(rDocShell.GetDocument(), nTab)) == *eMode));
+}
+}
