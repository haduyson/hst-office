+void ScPrintUIOptions::SetScaling(const ScDocShell& rDocShell, SCTAB nCurTab)
+{
+    mnInitialScaling = -1;
+    mbScalingChosen = false;
+    maScaleSnapshot.clear();
+
+    if (rDocShell.IsReadOnly() || rDocShell.IsDocShared())
+    {
+        if (mnScalingIndex)
+        {
+            m_aUIProperties.erase(m_aUIProperties.begin() + *mnScalingIndex);
+            mnScalingIndex.reset();
+        }
+        return;
+    }
+
+    const ScDocument& rDoc = rDocShell.GetDocument();
+    for (SCTAB nTab = 0; nTab < rDoc.GetTableCount(); ++nTab)
+        maScaleSnapshot.push_back(sc::printscale::GetSettings(rDoc, nTab));
+    const sc::PrintScaleSettings aCurrent = (nCurTab >= 0 && o3tl::make_unsigned(nCurTab) < maScaleSnapshot.size())
+                                                ? maScaleSnapshot[nCurTab]
+                                                : sc::PrintScaleSettings();
+    const sc::PrintScaleMode eCurrent = sc::printscale::GetMode(aCurrent);
+
+    // the entries in the order of sc::PrintScaleMode; the custom entry only when the sheet has custom scaling
+    std::vector<OUString> aChoices{ ScResId(STR_PRINTSCALE_NONE), ScResId(STR_PRINTSCALE_FIT_SHEET),
+                                    ScResId(STR_PRINTSCALE_FIT_COLUMNS), ScResId(STR_PRINTSCALE_FIT_ROWS) };
+    if (eCurrent == sc::PrintScaleMode::Custom)
+        aChoices.push_back(sc::printscale::GetCustomLabel(aCurrent));
+    mnInitialScaling = static_cast<sal_Int32>(eCurrent);
+
+    beans::PropertyValue aControl;
+    aControl.Value = setChoiceListControlOpt(u"scalingbox"_ustr, OUString(), uno::Sequence<OUString>(),
+                                             u"PrintScaling"_ustr, comphelper::containerToSequence(aChoices),
+                                             mnInitialScaling);
+    if (mnScalingIndex)
+        m_aUIProperties[*mnScalingIndex] = std::move(aControl);
+    else
+    {
+        m_aUIProperties.push_back(std::move(aControl));
+        mnScalingIndex = m_aUIProperties.size() - 1;
+    }
+}
+
+bool ScPrintUIOptions::ApplyScaling(ScDocShell& rDocShell, const uno::Sequence<beans::PropertyValue>& rOptions,
+                                    const ScMarkData& rMark)
+{
+    if (mnInitialScaling < 0)
+        return false;
+
+    sal_Int32 nChoice = -1;
+    for (const auto& rOption : rOptions)
+        if (rOption.Name == "PrintScaling")
+            rOption.Value >>= nChoice;
+    if (nChoice < 0 || nChoice > static_cast<sal_Int32>(sc::PrintScaleMode::Custom))
+        return false;
+
+    // Opening the dialog changes nothing; the sheets follow the list once the user has picked an entry.
+    if (nChoice != mnInitialScaling)
+        mbScalingChosen = true;
+    if (!mbScalingChosen)
+        return false;
+
+    const auto eChoice = static_cast<sc::PrintScaleMode>(nChoice);
+    std::vector<std::pair<SCTAB, sc::PrintScaleSettings>> aTargets;
+    for (SCTAB nTab : rMark)
+    {
+        if (eChoice != sc::PrintScaleMode::Custom)
+            aTargets.emplace_back(nTab, sc::printscale::GetSettings(eChoice));
+        else if (o3tl::make_unsigned(nTab) < maScaleSnapshot.size())
+            aTargets.emplace_back(nTab, maScaleSnapshot[nTab]); // what the sheet had when the dialog opened
+    }
+    return sc::printscale::Apply(rDocShell, aTargets);
+}
+
+/// The sheet the print dialog was opened on: the current sheet of the view passed as "View".
+static SCTAB lcl_GetPrintDialogTab(const uno::Sequence<beans::PropertyValue>& rOptions)
+{
+    for (const auto& rOption : rOptions)
+    {
+        if (rOption.Name != "View")
+            continue;
+        uno::Reference<frame::XController> xView;
+        rOption.Value >>= xView;
+        if (ScTabViewObj* pViewObj = dynamic_cast<ScTabViewObj*>(xView.get()))
+            if (ScTabViewShell* pViewSh = pViewObj->GetViewShell())
+                return pViewSh->GetViewData().CurrentTabForData();
+    }
+    return ScDocShell::GetCurTab();
+}
+
+/// Appends the print dialog options of Calc to rSequence (and refreshes them when the dialog asks for them).
+static void lcl_AppendPrintUIOptions(std::unique_ptr<ScPrintUIOptions>& rpPrinterOptions, const ScDocShell& rDocShell,
+                                     const uno::Sequence<beans::PropertyValue>& rOptions,
+                                     uno::Sequence<beans::PropertyValue>& rSequence)
+{
+    if( ! rpPrinterOptions )
+        rpPrinterOptions.reset(new ScPrintUIOptions);
+    else
+        rpPrinterOptions->SetDefaults();
+
+    // the print dialog asks for its options with an "ExtraPrintUIOptions" entry (SfxPrinterController)
+    if (std::any_of(rOptions.begin(), rOptions.end(),
+                    [](const beans::PropertyValue& rOption) { return rOption.Name == "ExtraPrintUIOptions"; }))
+        rpPrinterOptions->SetScaling(rDocShell, lcl_GetPrintDialogTab(rOptions));
+
+    rpPrinterOptions->appendPrintUIOptions( rSequence );
 }
 
