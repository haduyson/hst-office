+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+#pragma once
+
+#include <rtl/ustring.hxx>
+#include <types.hxx>
+
+#include <optional>
+#include <utility>
+#include <vector>
+
+class ScDocShell;
+class ScDocument;
+class SfxItemSet;
+
+namespace sc
+{
+/** The print scaling of a sheet as its page style stores it: zoom percent (ATTR_PAGE_SCALE), number of pages
+    (ATTR_PAGE_SCALETOPAGES) and pages wide by tall (ATTR_PAGE_SCALETO). The value of an unused mode is 0. */
+struct PrintScaleSettings
+{
+    sal_uInt16 nPercent = 100;
+    sal_uInt16 nPages = 0;
+    sal_uInt16 nWidth = 0;
+    sal_uInt16 nHeight = 0;
+
+    bool operator==(const PrintScaleSettings&) const = default;
+};
+
+/** The scaling choices of the print dialog, the ribbon, the menu and the print preview, in list order. */
+enum class PrintScaleMode : sal_Int32
+{
+    None = 0, ///< actual size (100 %)
+    FitSheet, ///< the whole sheet on one page (1 page wide, 1 page tall)
+    FitColumns, ///< every column on one page width, as many pages tall as needed
+    FitRows, ///< every row on one page height, as many pages wide as needed
+    Custom ///< anything else (another zoom, another number of pages)
+};
+
+namespace printscale
+{
+/** The settings of the page style of the sheet. */
+PrintScaleSettings GetSettings(const ScDocument& rDoc, SCTAB nTab);
+
+/** The settings stored in a page style item set. */
+PrintScaleSettings GetSettings(const SfxItemSet& rStyleSet);
+
+/** Which choice the settings are, in the order ScPrintFunc reads them (pages, then pages wide by tall, then zoom). */
+PrintScaleMode GetMode(const PrintScaleSettings& rSettings);
+
+/** The settings of one of the four fixed choices (eMode must not be Custom). */
+PrintScaleSettings GetSettings(PrintScaleMode eMode);
+
+/** A label for custom settings, e.g. "Custom scaling: 75%". */
+OUString GetCustomLabel(const PrintScaleSettings& rSettings);
+
+/** Gives every listed sheet its settings, as one undo step ("Change Scale").
+
+    Scaling belongs to a sheet: when a sheet shares its page style with a sheet that does not get the same
+    settings, the sheet first gets its own copy of the style ("PageStyle_<sheet name>", the name the spreadsheet
+    import uses), so the other sheets keep their printout. Sheets that already have the settings are left alone.
+    Does nothing on a read-only document. Returns whether anything changed. */
+bool Apply(ScDocShell& rDocShell, const std::vector<std::pair<SCTAB, PrintScaleSettings>>& rTargets);
+
+/** Apply() with the settings of one of the four fixed choices for every listed sheet. */
+bool Apply(ScDocShell& rDocShell, const std::vector<SCTAB>& rTabs, PrintScaleMode eMode);
+
+/** The fixed choice of a scaling command (.uno:PrintScaleNone, …FitSheet, …FitColumns, …FitRows), if it is one. */
+std::optional<PrintScaleMode> ModeForSlot(sal_uInt16 nSlot);
+
+/** Runs a scaling command on the sheets; false when nSlot is not one of the four. */
+bool ExecuteSlot(ScDocShell& rDocShell, const std::vector<SCTAB>& rTabs, sal_uInt16 nSlot);
+
+/** The state of a scaling command (including the menu and the options command) for the sheet: checked when the
+    sheet has that choice, disabled while the document cannot be changed. */
+void GetSlotState(const ScDocShell& rDocShell, SCTAB nTab, SfxItemSet& rSet, sal_uInt16 nWhich);
+}
+}
