+void SkiaTest::testDrawAlphaRectBlends()
+{
+    if (!SkiaHelper::isVCLSkiaEnabled())
+        return;
+    // A translucent rectangle (the Windows path of DrawTransparent for rectangles) blends over
+    // the white background instead of storing a premultiplied, dark colour.
+    ScopedVclPtr<VirtualDevice> device = VclPtr<VirtualDevice>::Create(DeviceFormat::WITHOUT_ALPHA);
+    device->SetOutputSizePixel(Size(20, 20));
+    device->SetBackground(Wallpaper(COL_WHITE));
+    device->Erase();
+    SalGraphics* pGraphics = device->GetGraphics();
+    CPPUNIT_ASSERT(pGraphics);
+    SkiaSalGraphicsImpl* pImpl = dynamic_cast<SkiaSalGraphicsImpl*>(pGraphics->GetImpl());
+    CPPUNIT_ASSERT(pImpl);
+    pImpl->SetLineColor();
+    pImpl->SetFillColor(Color(0x00, 0x00, 0xFF));
+    CPPUNIT_ASSERT(pImpl->drawAlphaRect(2, 2, 16, 16, 50));
+    const Color aFilled = device->GetPixel(Point(10, 10));
+    // half blue over white is about (127, 127, 255); premultiplied it was about (0, 0, 127)
+    CPPUNIT_ASSERT_GREATER(sal_uInt8(100), aFilled.GetRed());
+    CPPUNIT_ASSERT_GREATER(sal_uInt8(200), aFilled.GetBlue());
+    CPPUNIT_ASSERT_EQUAL(COL_WHITE, device->GetPixel(Point(0, 0)));
+    // a translucent outline blends too
+    pImpl->SetFillColor();
+    pImpl->SetLineColor(Color(0x00, 0x00, 0xFF));
+    CPPUNIT_ASSERT(pImpl->drawAlphaRect(0, 0, 20, 20, 50));
+    CPPUNIT_ASSERT_GREATER(sal_uInt8(100), device->GetPixel(Point(0, 10)).GetRed());
+}
+
 } // namespace
 
