+            assertPixel("one pixel high", *pDev, 2, 18, MARKER, 0);
+            assertPixel("one pixel high", *pDev, 2, 20, MARKER, 0);
+        }
+    }
+}
+
+/* The sidebar's tab look: the open deck's tab on the pill with the indicator bar, TabIndicator wide,
