+    // high contrast: the page's own background, captions as before
+    applyStyle(*pPage, false, true);
+    hst::ribbon::CoatPages(*pPage);
+    CPPUNIT_ASSERT(!pPage->IsControlBackground());
+    CPPUNIT_ASSERT(!hst::ribbon::CoatColor(*pCaption, style(false, true)));
+    CPPUNIT_ASSERT_EQUAL(COL_LIGHTRED, pOwn->GetControlForeground());
