+/* Buttons: hover, pressed and checked in the frame tokens, rounded (a corner pixel stays unpainted),
+   checked = the pill with a 1 px indicator border; light and dark. */
+CPPUNIT_TEST_FIXTURE(RibbonCoatTest, testButtonStatesUseFrameTokens)
+{
+    for (bool bDark : { false, true })
+    {
+        const auto& p = palette(bDark);
+        const tools::Rectangle aRect(Point(), Size(40, 24));
+        {
+            ScopedVclPtr<VirtualDevice> pDev = makeDevice(aRect.GetSize(), bDark);
+            CPPUNIT_ASSERT(hst::ribbon::DrawToolButton(*pDev, aRect, 2, false, true));
+            assertPixel("hover", *pDev, 20, 12, p.aHover);
+            assertPixel("hover: rounded corner", *pDev, 0, 0, MARKER);
+        }
+        {
+            ScopedVclPtr<VirtualDevice> pDev = makeDevice(aRect.GetSize(), bDark);
+            hst::ribbon::DrawToolButton(*pDev, aRect, 1, false, true);
+            assertPixel("pressed", *pDev, 20, 12, p.aPressed);
+        }
+        {
+            ScopedVclPtr<VirtualDevice> pDev = makeDevice(aRect.GetSize(), bDark);
+            hst::ribbon::DrawToolButton(*pDev, aRect, 0, true, true);
+            assertPixel("checked: the pill", *pDev, 20, 12, p.aPill);
+            assertPixel("checked: its border", *pDev, 0, 12, p.aSelectedIndicator);
+            assertPixel("checked: one pixel of border", *pDev, 1, 12, p.aPill);
+            assertPixel("checked: rounded corner", *pDev, 0, 0, MARKER);
+        }
+        {
+            ScopedVclPtr<VirtualDevice> pDev = makeDevice(aRect.GetSize(), bDark);
+            hst::ribbon::DrawToolButton(*pDev, aRect, 2, true, true);
+            assertPixel("checked and hovered", *pDev, 20, 12, p.aPressed);
+            assertPixel("checked and hovered: border", *pDev, 39, 12, p.aSelectedIndicator);
+        }
+        {
+            ScopedVclPtr<VirtualDevice> pDev = makeDevice(aRect.GetSize(), bDark);
+            CPPUNIT_ASSERT(hst::ribbon::DrawToolButton(*pDev, aRect, 0, false, true));
+            assertPixel("at rest: nothing", *pDev, 20, 12, MARKER);
