+#include <algorithm>
+#include <cmath>
+#include <cstdlib>
+#include <optional>
+
+namespace
+{
+// a colour the ribbon never paints: what is left of it was not painted
+constexpr Color MARKER(0xFF, 0x00, 0xFF);
+
+double luminance(const Color& rColor)
+{
+    auto channel = [](sal_uInt8 n) {
+        const double f = n / 255.0;
+        return f <= 0.04045 ? f / 12.92 : std::pow((f + 0.055) / 1.055, 2.4);
+    };
+    return 0.2126 * channel(rColor.GetRed()) + 0.7152 * channel(rColor.GetGreen())
+           + 0.0722 * channel(rColor.GetBlue());
+}
+
+double contrast(const Color& rA, const Color& rB)
+{
+    const double fA = luminance(rA), fB = luminance(rB);
+    return (std::max(fA, fB) + 0.05) / (std::min(fA, fB) + 0.05);
+}
+
+class RibbonCoatTest : public test::BootstrapFixture
+{
+public:
+    RibbonCoatTest()
+        : test::BootstrapFixture(true, false)
+    {
+    }
+
+    void setUp() override
+    {
+        test::BootstrapFixture::setUp();
+        // the environment's coat switch would override the settings these tests set
+        OUString aName(u"HST_UI_COAT"_ustr);
+        osl_clearEnvironment(aName.pData);
+        setSwitches(true, true, true);
+    }
+
+    void tearDown() override
+    {
+        setSwitches(true, true, true); // a test that switched one off may have stopped at an assertion
+        test::BootstrapFixture::tearDown();
+    }
+
+protected:
+    static void setSwitches(bool bCoat, bool bRibbon, bool bSidebar)
+    {
+        auto xChanges = comphelper::ConfigurationChanges::create();
+        officecfg::Office::HSTAppearance::UiCoat::Enabled::set(bCoat, xChanges);
+        officecfg::Office::HSTAppearance::FrameCoat::Ribbon::set(bRibbon, xChanges);
+        officecfg::Office::HSTAppearance::FrameCoat::Sidebar::set(bSidebar, xChanges);
+        xChanges->commit();
+        hst::coat::ResetSwitchForTesting();
+        hst::coat::ResetFrameCoatForTesting();
+    }
+
+    static StyleSettings style(bool bDark, bool bHighContrast)
+    {
+        StyleSettings aStyle = Application::GetSettings().GetStyleSettings();
+        aStyle.SetHighContrastMode(bHighContrast);
+        aStyle.SetWindowColor(bDark ? Color(0x20, 0x20, 0x20) : COL_WHITE);
+        aStyle.SetFieldColor(bDark ? Color(0x2A, 0x2A, 0x2A) : COL_WHITE);
+        aStyle.SetDialogColor(bDark ? Color(0x28, 0x28, 0x28) : Color(0xF0, 0xF0, 0xF0));
+        return aStyle;
+    }
+
+    static ScopedVclPtr<VirtualDevice> makeDevice(const Size& rSize, bool bDark = false,
+                                                  bool bHighContrast = false)
+    {
+        ScopedVclPtr<VirtualDevice> pDev = VclPtr<VirtualDevice>::Create();
+        AllSettings aSettings = pDev->GetSettings();
+        aSettings.SetStyleSettings(style(bDark, bHighContrast));
+        pDev->SetSettings(aSettings);
+        pDev->SetOutputSizePixel(rSize);
+        pDev->SetBackground(Wallpaper(MARKER));
+        pDev->Erase();
+        return pDev;
+    }
+
+    static void applyStyle(vcl::Window& rWindow, bool bDark, bool bHighContrast)
+    {
+        AllSettings aSettings = rWindow.GetSettings();
+        aSettings.SetStyleSettings(style(bDark, bHighContrast));
+        rWindow.SetSettings(aSettings, true);
+    }
+
+    static const hst::design::Palette& palette(bool bDark) { return hst::design::GetPalette(bDark); }
+
+    /** rExpected at (nX, nY), give or take the rounding of the anti-aliasing backend. */
+    static void assertPixel(const char* pWhat, const VirtualDevice& rDev, tools::Long nX, tools::Long nY,
+                            const Color& rExpected, int nTolerance = 2)
+    {
+        const Color aActual = rDev.GetPixel(Point(nX, nY));
+        const bool bClose = std::abs(aActual.GetRed() - rExpected.GetRed()) <= nTolerance
+                            && std::abs(aActual.GetGreen() - rExpected.GetGreen()) <= nTolerance
+                            && std::abs(aActual.GetBlue() - rExpected.GetBlue()) <= nTolerance;
+        CPPUNIT_ASSERT_MESSAGE(OString(OString::Concat(pWhat) + ": expected "
+                                       + rExpected.AsRGBHexString().toUtf8() + " at " + OString::number(nX)
+                                       + "," + OString::number(nY) + ", got "
+                                       + aActual.AsRGBHexString().toUtf8())
+                                   .getStr(),
+                               bClose);
+    }
+};
