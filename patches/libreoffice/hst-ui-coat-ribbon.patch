+}
+
+/* FrameCoat/Ribbon off (or the coat off): the ribbon's own palette, as before the frame coat. */
+CPPUNIT_TEST_FIXTURE(RibbonCoatTest, testSwitchedOffKeepsTheRibbonPalette)
+{
+    for (bool bCoat : { true, false })
+    {
