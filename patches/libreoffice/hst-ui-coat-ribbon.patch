+/* The ribbon in the frame coat (vcl/HstRibbonPaint.hxx): its surface, dividers, captions, buttons and
+   tabs take the frame colours of the design tokens, the shapes are those of the shared helper, the
+   switches (FrameCoat/Ribbon, high contrast) give the ribbon its own look back, and the sidebar's tab
+   look draws the open deck's pill without changing a size. Drawn on VirtualDevices of the headless
+   backend and probed pixel by pixel. */
+
+#include <test/bootstrapfixture.hxx>
+
+#include <comphelper/configuration.hxx>
+#include <officecfg/Office/HSTAppearance.hxx>
+#include <vcl/HstRibbonPaint.hxx>
+#include <vcl/hst/designtokens.hxx>
+#include <vcl/settings.hxx>
+#include <vcl/svapp.hxx>
