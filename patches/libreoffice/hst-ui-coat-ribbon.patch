+    CPPUNIT_ASSERT_EQUAL(p.aFrameSurface, pPage->GetControlBackground());
+    std::optional<Color> oCaption = hst::ribbon::CoatColor(*pCaption, style(false, false));
+    CPPUNIT_ASSERT(oCaption);
+    CPPUNIT_ASSERT_EQUAL(hst::ribbon::captionColor(style(false, false)), *oCaption);
+    CPPUNIT_ASSERT(!hst::ribbon::CoatColor(*pOwn, style(false, false)));
+    CPPUNIT_ASSERT_EQUAL(COL_LIGHTRED, pOwn->GetControlForeground());
+    CPPUNIT_ASSERT(!hst::ribbon::CoatColor(*pPage, style(false, false))); // the page paints no text or line
+
+    // dark: the dark tokens, chosen when painting
+    applyStyle(*pPage, true, false);
+    hst::ribbon::CoatPages(*pPage);
+    CPPUNIT_ASSERT_EQUAL(palette(true).aFrameSurface, pPage->GetControlBackground());
+    CPPUNIT_ASSERT_EQUAL(hst::ribbon::captionColor(style(true, false)),
+                         *hst::ribbon::CoatColor(*pCaption, style(true, false)));
