+        const hst::ribbon::Palette aRibbon = hst::ribbon::paletteFor(pDev->GetSettings().GetStyleSettings());
+        hst::ribbon::DrawToolButton(*pDev, tools::Rectangle(Point(), Size(40, 24)), 2, false, true);
+        assertPixel("hover, ribbon palette", *pDev, 20, 12, aRibbon.aHover);
+    }
+}
