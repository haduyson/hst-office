+
+/* The ribbon (the Tabbed notebookbar) in the frame coat of the HST look: its surface, its group
+   dividers and captions, its buttons and tabs in the frame colours of the design tokens, and the
+   paint-only button looks other toolboxes may take (<vcl/HstRibbonPaint.hxx>). Flat: no gradient
+   anywhere in the ribbon. Nothing here changes a size. */
+
+#include <vcl/HstRibbonPaint.hxx>
+
+#include <vcl/hst/designtokens.hxx>
+#include <vcl/hst/drawhelpers.hxx>
+#include <vcl/hst/framecoat.hxx>
+#include <vcl/settings.hxx>
+#include <vcl/toolbox.hxx>
+#include <vcl/toolkit/fixed.hxx>
+#include <vcl/vclevent.hxx>
+#include <vcl/weld/Toolbar.hxx>
+
+#include <HstRibbonCoat.hxx>
+#include <salvtables.hxx>
+#include <toolbox.h>
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <unordered_map>
+
+namespace hst::ribbon
+{
+namespace
+{
+namespace d = hst::design;
+
+/// a length of the tokens in device pixels, whole and at least one
+tools::Long px(const OutputDevice& rDev, double fLogical)
+{
+    return std::max<tools::Long>(1, std::lround(fLogical * rDev.GetDPIScaleFactor()));
+}
+
+/** A rounded shape with the shared helper, which lays it on pixel edges for every backend; a
+    mirrored (RTL) device takes the plain rounded rectangle, as the helper wants unmirrored pixels. */
+void roundRect(vcl::RenderContext& rDev, const tools::Rectangle& rRect, double fRadius, const Color& rFill,
+               const Color& rBorder)
+{
+    if (rDev.HasMirroredGraphics() && rDev.IsRTLEnabled())
+    {
+        auto aPop = rDev.ScopedPush(vcl::PushFlags::LINECOLOR | vcl::PushFlags::FILLCOLOR);
+        rDev.SetFillColor(rFill);
+        if (rBorder == COL_TRANSPARENT)
+            rDev.SetLineColor();
+        else
+            rDev.SetLineColor(rBorder);
+        const tools::Long nRadius = std::lround(fRadius);
+        rDev.DrawRect(rRect, nRadius, nRadius);
+        return;
+    }
+    d::DrawRoundRect(rDev, rRect, fRadius, rFill, rBorder, d::stroke::Border);
+}
+
+/// the radius of a control, at most half the shorter side (DrawRoundRect clamps it the same way)
+double controlRadius(const OutputDevice& rDev) { return d::radius::Control * rDev.GetDPIScaleFactor(); }
+
+/// WCAG relative luminance
+double luminance(const Color& rColor)
+{
+    auto channel = [](sal_uInt8 n) {
+        const double f = n / 255.0;
+        return f <= 0.04045 ? f / 12.92 : std::pow((f + 0.055) / 1.055, 2.4);
+    };
+    return 0.2126 * channel(rColor.GetRed()) + 0.7152 * channel(rColor.GetGreen())
+           + 0.0722 * channel(rColor.GetBlue());
+}
+
+double contrast(const Color& rA, const Color& rB)
+{
+    const double fA = luminance(rA), fB = luminance(rB);
+    return (std::max(fA, fB) + 0.05) / (std::min(fA, fB) + 0.05);
+}
+
+Color captionColorOf(const d::Palette& rPalette)
+{
+    // once per palette: the palettes are constant
+    static const std::array<Color, 2> aCaption = [] {
+        std::array<Color, 2> a;
+        for (bool bDark : { false, true })
+        {
+            const d::Palette& r = d::GetPalette(bDark);
+            a[bDark] = contrast(r.aMuted, r.aFrameSurface) >= 4.5 ? r.aMuted : r.aRibbon.aCaption;
+        }
+        return a;
+    }();
+    return aCaption[rPalette.bDark];
+}
+
+/// the parts CoatPages took in; forgotten when their window dies
+enum class Part
+{
+    Page,
+    Divider,
+    Caption,
+};
+
+std::unordered_map<const vcl::Window*, Part>& parts()
+{
+    static std::unordered_map<const vcl::Window*, Part> aParts;
+    return aParts;
+}
+
+struct Forgetter
+{
+    DECL_STATIC_LINK(Forgetter, DyingHdl, VclWindowEvent&, void);
+};
+
+IMPL_STATIC_LINK(Forgetter, DyingHdl, VclWindowEvent&, rEvent, void)
+{
+    if (rEvent.GetId() == VclEventId::ObjectDying)
+        parts().erase(rEvent.GetWindow());
+}
+
+void remember(vcl::Window& rWindow, Part ePart)
+{
+    if (parts().emplace(&rWindow, ePart).second)
+        rWindow.AddEventListener(LINK(nullptr, Forgetter, DyingHdl));
+}
+
+/// the dividers and captions under rWindow (a caption with a colour of its own keeps it)
+void takeIn(vcl::Window& rWindow)
+{
+    for (vcl::Window* pChild = rWindow.GetWindow(GetWindowType::FirstChild); pChild;
+         pChild = pChild->GetWindow(GetWindowType::Next))
+    {
+        if (FixedLine* pLine = dynamic_cast<FixedLine*>(pChild))
+        {
+            if ((pLine->GetStyle() & WB_VERT) && pLine->GetText().isEmpty())
+                remember(*pLine, Part::Divider);
+        }
+        else if (FixedText* pText = dynamic_cast<FixedText*>(pChild))
+        {
+            if (!pText->IsControlForeground())
+                remember(*pText, Part::Caption);
+        }
+        takeIn(*pChild);
+    }
+}
+}
+
+bool coatActive(const StyleSettings& rStyle)
+{
+    return ownerDrawEnabled() && hst::coat::FrameCoatActive(hst::coat::FrameComponent::Ribbon, rStyle);
+}
+
+Color captionColor(const StyleSettings& rStyle) { return captionColorOf(d::GetPalette(rStyle)); }
+
+void DrawSurface(vcl::RenderContext& rDev, const tools::Rectangle& rArea)
+{
+    if (rArea.IsEmpty())
+        return;
+    const d::Palette& rPalette = d::GetPalette(rDev.GetSettings().GetStyleSettings());
+    auto aPop = rDev.ScopedPush(vcl::PushFlags::LINECOLOR | vcl::PushFlags::FILLCOLOR);
+    rDev.SetLineColor();
+    rDev.SetFillColor(rPalette.aFrameSurface);
+    rDev.DrawRect(rArea);
+    // the divider between the ribbon and the document: whole pixel rows, axis-parallel, so crisp
+    // (one device pixel at every scale, as the groups' dividers)
+    rDev.SetFillColor(rPalette.aFrameDivider);
+    rDev.DrawRect(tools::Rectangle(Point(rArea.Left(), rArea.Bottom()), Size(rArea.GetWidth(), 1)));
+}
+
+void CoatPages(vcl::Window& rPage)
+{
+    auto it = parts().find(&rPage);
+    if (it == parts().end())
+    {
+        if (rPage.IsControlBackground())
+            return; // a page with a background of its own keeps its look
+        remember(rPage, Part::Page);
+        takeIn(rPage);
+    }
+    else if (it->second != Part::Page)
+        return;
+    const StyleSettings& rStyle = rPage.GetSettings().GetStyleSettings();
+    if (coatActive(rStyle))
+    {
+        const Color aSurface = d::GetPalette(rStyle).aFrameSurface;
+        if (!rPage.IsControlBackground() || rPage.GetControlBackground() != aSurface)
+            rPage.SetControlBackground(aSurface);
+    }
+    else if (rPage.IsControlBackground())
+        rPage.SetControlBackground();
+}
+
+std::optional<Color> CoatColor(const vcl::Window& rWindow, const StyleSettings& rStyle)
+{
+    if (parts().empty())
+        return {};
+    const auto it = parts().find(&rWindow);
+    if (it == parts().end() || it->second == Part::Page || !coatActive(rStyle))
+        return {};
+    const d::Palette& rPalette = d::GetPalette(rStyle);
+    return it->second == Part::Divider ? rPalette.aFrameDivider : captionColorOf(rPalette);
+}
+
+void DrawDivider(vcl::RenderContext& rDev, const Size& rSize, bool bVertical, const Color& rColor)
+{
+    auto aPop = rDev.ScopedPush(vcl::PushFlags::LINECOLOR | vcl::PushFlags::FILLCOLOR);
+    rDev.SetLineColor();
+    rDev.SetFillColor(rColor);
+    if (bVertical)
+        rDev.DrawRect(tools::Rectangle(Point((rSize.Width() - 1) / 2, 0), Size(1, rSize.Height())));
+    else
+        rDev.DrawRect(tools::Rectangle(Point(0, (rSize.Height() - 1) / 2), Size(rSize.Width(), 1)));
+}
+
+void SetButtonLook(ToolBox& rToolBox, ButtonLook eLook)
+{
+    int& rLook = rToolBox.ImplGetToolBoxPrivateData()->mnHstButtonLook;
+    if (rLook == int(eLook))
+        return;
+    rLook = int(eLook);
+    rToolBox.Invalidate();
+}
+
+void SetButtonLook(weld::Toolbar& rToolbar, ButtonLook eLook)
+{
+    if (SalInstanceWidget* pWidget = dynamic_cast<SalInstanceWidget*>(&rToolbar))
+        if (ToolBox* pToolBox = dynamic_cast<ToolBox*>(pWidget->getWidget()))
+            SetButtonLook(*pToolBox, eLook);
+}
+
+bool keepsSurface(const ToolBox& rToolBox, const StyleSettings& rStyle)
+{
+    const ImplToolBoxPrivateData& rData = *rToolBox.ImplGetToolBoxPrivateData();
+    return (rData.mbHstOwnerDraw && coatActive(rStyle))
+           || (ButtonLook(rData.mnHstButtonLook) == ButtonLook::SidebarTab
+               && hst::coat::FrameCoatActive(hst::coat::FrameComponent::Sidebar, rStyle));
+}
+
+ButtonLook GetButtonLook(const ToolBox& rToolBox)
+{
+    return ButtonLook(rToolBox.ImplGetToolBoxPrivateData()->mnHstButtonLook);
+}
+
+bool DrawLookButton(vcl::RenderContext& rDev, const tools::Rectangle& rRect, ButtonLook eLook,
+                    sal_uInt16 nHighlight, bool bChecked, bool bEnabled)
+{
+    const StyleSettings& rStyle = rDev.GetSettings().GetStyleSettings();
+    if (eLook != ButtonLook::SidebarTab
+        || !hst::coat::FrameCoatActive(hst::coat::FrameComponent::Sidebar, rStyle) || rRect.IsEmpty())
+        return false;
+    const d::Palette& rPalette = d::GetPalette(rStyle);
+    const bool bPressed = bEnabled && nHighlight == 1;
+    const bool bHover = bEnabled && nHighlight == 2;
+    if (!bPressed && !bHover && !bChecked)
+        return true; // flat: the tab bar's surface shows through
+    const double fRadius = controlRadius(rDev);
+    roundRect(rDev, rRect,
+              fRadius, bPressed ? rPalette.aPressed : bChecked ? rPalette.aPill : rPalette.aHover,
+              COL_TRANSPARENT);
+    if (bChecked)
+    {
+        // the accent bar on the pill's leading edge (a mirrored device puts it on the right), over the
+        // straight part of that edge
+        const tools::Long nBar = px(rDev, d::size::TabIndicator);
+        const tools::Long nInset
+            = std::min<tools::Long>(std::lround(std::min(fRadius, rRect.GetHeight() / 2.0)), rRect.GetHeight() / 4);
+        auto aPop = rDev.ScopedPush(vcl::PushFlags::LINECOLOR | vcl::PushFlags::FILLCOLOR);
+        rDev.SetLineColor();
+        rDev.SetFillColor(rPalette.aSelectedIndicator);
+        rDev.DrawRect(tools::Rectangle(Point(rRect.Left(), rRect.Top() + nInset),
+                                       Size(nBar, std::max<tools::Long>(1, rRect.GetHeight() - 2 * nInset))));
+    }
+    return true;
+}
+
+namespace coat
+{
+void DrawButton(vcl::RenderContext& rDev, const tools::Rectangle& rRect, sal_uInt16 nHighlight, bool bChecked,
+                bool bEnabled)
+{
+    const d::Palette& rPalette = d::GetPalette(rDev.GetSettings().GetStyleSettings());
+    // pressed is stronger than checked; checked keeps its border while hovered or pressed
+    const bool bPressed = bEnabled && nHighlight == 1;
+    const bool bHover = bEnabled && nHighlight == 2;
+    if (!bPressed && !bHover && !bChecked)
+        return; // the ribbon's surface shows through
+    const Color aFill = bPressed || (bChecked && bHover) ? rPalette.aPressed
+                        : bChecked                        ? rPalette.aPill
+                                                          : rPalette.aHover;
+    roundRect(rDev, rRect, controlRadius(rDev), aFill,
+              bChecked ? rPalette.aSelectedIndicator : COL_TRANSPARENT);
+}
+
+void DrawTab(vcl::RenderContext& rDev, const tools::Rectangle& rItem, tools::Long nLabelWidth, bool bSelected,
+             bool bHover)
+{
+    const d::Palette& rPalette = d::GetPalette(rDev.GetSettings().GetStyleSettings());
+    if (bHover && !bSelected)
+    {
+        // the light hover pill, inside the tab (D6: the selected tab has its underline only)
+        tools::Rectangle aFill(rItem);
+        const tools::Long nInset = px(rDev, d::space::XXS);
+        aFill.AdjustLeft(nInset);
+        aFill.AdjustTop(nInset);
+        aFill.AdjustRight(-nInset);
+        aFill.AdjustBottom(-nInset);
+        roundRect(rDev, aFill, controlRadius(rDev), rPalette.aHover, COL_TRANSPARENT);
+    }
+    if (bSelected)
+    {
+        // the underline under the label: TabIndicator thick, as wide as the label (at least 16 px)
+        const tools::Long nBar = px(rDev, d::size::TabIndicator);
+        const tools::Long nPad = px(rDev, 6);
+        const tools::Long nMax = std::max<tools::Long>(1, rItem.GetWidth() - 2 * nPad);
+        const tools::Long nWidth = std::clamp<tools::Long>(nLabelWidth, std::min(px(rDev, 16), nMax), nMax);
+        const tools::Long nX = rItem.Left() + (rItem.GetWidth() - nWidth) / 2;
+        const tools::Long nY = rItem.Bottom() - nBar - px(rDev, 1);
+        // a plain rectangle of whole pixels: crisp, and the same on a mirrored device
+        auto aPop = rDev.ScopedPush(vcl::PushFlags::LINECOLOR | vcl::PushFlags::FILLCOLOR);
+        rDev.SetLineColor();
+        rDev.SetFillColor(rPalette.aSelectedIndicator);
+        rDev.DrawRect(tools::Rectangle(Point(nX, nY), Size(nWidth, nBar)));
+    }
+}
+}
