+/* A page in the coat: its background the frame surface, its captions in the caption colour when they paint,
+   its divider drawn as one whole device pixel; a caption with a colour of its own keeps it; with the coat not
+   active (high contrast) everything is as before. (FixedLine is not exported in merged builds: its line is
+   probed through DrawDivider, which FixedLine::ImplDraw calls.) */
+CPPUNIT_TEST_FIXTURE(RibbonCoatTest, testCoatPagesSurfaceCaptionsAndDivider)
+{
+    ScopedVclPtrInstance<WorkWindow> pPage(nullptr, WB_STDWORK);
+    applyStyle(*pPage, false, false);
+    VclPtr<FixedText> pCaption = VclPtr<FixedText>::Create(pPage.get());
+    VclPtr<FixedText> pOwn = VclPtr<FixedText>::Create(pPage.get());
+    pOwn->SetControlForeground(COL_LIGHTRED);
