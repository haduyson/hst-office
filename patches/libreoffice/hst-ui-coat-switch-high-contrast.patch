+    backend reads them, can still say "no high contrast" when LibreOffice turns it on. nullptr: none. */
+VCL_PLUGIN_PUBLIC void SetGlobalStyleListener(GlobalStyleListener pListener);
+
+/** vcl (Window::ImplUpdateGlobalSettings): pass the final global style settings to the listener. */
+VCL_DLLPUBLIC void NotifyGlobalStyle(const StyleSettings& rStyle);
+
 /** Whether the coat applies with these style settings: switched on and not in high-contrast mode. */
 VCL_PLUGIN_PUBLIC bool IsActive(const StyleSettings& rStyle);
 
@@ -125,6 +139,10 @@ VCL_DLLPUBLIC std::pair<double, double> ListRepaintTimingForTesting(vcl::Window*
