+void recordingListener(const StyleSettings& rStyle)
+{
+    ++g_nNotified;
+    g_oHighContrast = rStyle.GetHighContrastMode();
+}
+
+void setHighContrastSetting(sal_Int32 nMode) // 0 automatic, 1 off, 2 on
+{
+    auto xChanges = comphelper::ConfigurationChanges::create();
+    officecfg::Office::Common::Accessibility::HighContrast::set(nMode, xChanges);
+    xChanges->commit();
+}
+
+/* The coat's switch and the final global style settings, which backends with their own native
+   widget styling (the gtk3 CSS) follow. */
+class CoatSwitchTest : public test::BootstrapFixture
+{
+public:
+    CoatSwitchTest()
+        : test::BootstrapFixture(true, false)
+    {
+    }
+
+    void tearDown() override
+    {
+        hst::coat::SetSwitchReaderForTesting(nullptr);
+        hst::coat::SetGlobalStyleListener(nullptr);
+        setHighContrastSetting(0);
+        test::BootstrapFixture::tearDown();
+    }
+};
+
+/* Very early in start-up the setting cannot be read: the shipped default (on) applies but is not
+   remembered, so the real setting wins once it can be read; a read value is remembered. */
+CPPUNIT_TEST_FIXTURE(CoatSwitchTest, testUnreadableSwitchIsNotRemembered)
+{
+    g_nReads = 0;
+    g_nReadResult = 0;
+    hst::coat::SetSwitchReaderForTesting(&countingReader);
+    CPPUNIT_ASSERT(hst::coat::IsSwitchedOn());
+    CPPUNIT_ASSERT(hst::coat::IsSwitchedOn());
+    CPPUNIT_ASSERT_EQUAL(2, g_nReads);
+
+    g_nReadResult = 1; // the setting is readable now and says off
+    CPPUNIT_ASSERT(!hst::coat::IsSwitchedOn());
+    CPPUNIT_ASSERT(!hst::coat::IsSwitchedOn());
+    CPPUNIT_ASSERT_EQUAL(3, g_nReads);
+}
+
+/* LibreOffice's own high-contrast setting is applied after the backend read its platform's settings:
+   the listener hears the final mode, on and off. */
+CPPUNIT_TEST_FIXTURE(CoatSwitchTest, testListenerHearsLibreOfficesHighContrast)
+{
+    hst::coat::SetGlobalStyleListener(&recordingListener);
+
+    g_nNotified = 0;
+    g_oHighContrast.reset();
+    setHighContrastSetting(2);
+    AllSettings aSettings(Application::GetSettings());
+    Application::MergeSystemSettings(aSettings);
+    CPPUNIT_ASSERT(g_nNotified > 0);
+    CPPUNIT_ASSERT(g_oHighContrast.has_value());
+    CPPUNIT_ASSERT(*g_oHighContrast);
+    CPPUNIT_ASSERT(aSettings.GetStyleSettings().GetHighContrastMode());
+    CPPUNIT_ASSERT(!hst::coat::IsActive(aSettings.GetStyleSettings()));
+
+    g_nNotified = 0;
+    setHighContrastSetting(1);
+    AllSettings aOff(Application::GetSettings());
+    Application::MergeSystemSettings(aOff);
+    CPPUNIT_ASSERT(g_nNotified > 0);
+    CPPUNIT_ASSERT(!*g_oHighContrast);
+}
+
+/* Without a listener nothing is called (the backends without their own CSS). */
+CPPUNIT_TEST_FIXTURE(CoatSwitchTest, testNoListener)
+{
+    g_nNotified = 0;
+    hst::coat::SetGlobalStyleListener(nullptr);
+    AllSettings aSettings(Application::GetSettings());
+    Application::MergeSystemSettings(aSettings);
+    CPPUNIT_ASSERT_EQUAL(0, g_nNotified);
+}
+}
