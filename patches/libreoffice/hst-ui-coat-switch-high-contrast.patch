+/** Receives the final global style settings. */
+using GlobalStyleListener = void (*)(const StyleSettings& rStyle);
+
+/** A backend that styles its own native widgets (gtk3: the coat's screen CSS) registers here to hear the
+    final global style settings: the platform's, with LibreOffice's own high-contrast setting
