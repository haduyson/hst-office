+// HST: Word lists punctuation as words of its own ("giới. " is "giới" and ". "); the trailing spaces stay
+// with the last part. A unit whose text does not map one character per cursor step (a field) is kept whole.
+bool lcl_isPunctuation(sal_Unicode c)
+{
+    static constexpr std::u16string_view aMarks = u".,;:!?()[]{}\"'\u00AB\u00BB\u201C\u201D\u2018\u2019\u2026\u2013\u2014";
+    return aMarks.find(c) != std::u16string_view::npos;
+}
+
+/// true when the character at nPos counts as punctuation; an apostrophe between letters ("don't") does not
+bool lcl_isPunctuationAt(std::u16string_view aText, sal_Int32 nPos)
+{
+    const sal_Unicode c = aText[nPos];
+    if (!lcl_isPunctuation(c))
+        return false;
+    if ((c == '\'' || c == 0x2019) && nPos > 0 && nPos + 1 < static_cast<sal_Int32>(aText.size()))
+        return lcl_isPunctuation(aText[nPos - 1]) || lcl_isPunctuation(aText[nPos + 1])
+               || aText[nPos - 1] == ' ' || aText[nPos + 1] == ' ';
+    return true;
+}
+
+/// lengths of the parts of one word unit (pure), e.g. "giới. " -> {4, 2}
+std::vector<sal_Int32> lcl_wordParts(std::u16string_view aText)
+{
+    const sal_Int32 nLength = static_cast<sal_Int32>(aText.size());
+    sal_Int32 nCore = nLength;
+    while (nCore > 0 && (aText[nCore - 1] == ' ' || aText[nCore - 1] == '\t' || aText[nCore - 1] == 0xA0))
+        --nCore;
+    std::vector<sal_Int32> aParts;
+    sal_Int32 nStart = 0;
+    for (sal_Int32 i = 1; i <= nCore; ++i)
+    {
+        if (i == nCore || lcl_isPunctuationAt(aText, i) != lcl_isPunctuationAt(aText, i - 1))
+        {
+            aParts.push_back(i - nStart);
+            nStart = i;
+        }
+    }
+    if (aParts.empty())
+        aParts.push_back(0);
+    aParts.back() += nLength - nCore;
+    return aParts;
+}
+
+void lcl_pushWord(std::vector<uno::Reference<text::XTextRange>>& rUnits,
+                  const uno::Reference<text::XText>& xText,
+                  const uno::Reference<text::XTextCursor>& xUnit)
+{
+    const OUString aText = xUnit->getString();
+    const std::vector<sal_Int32> aParts = lcl_wordParts(aText);
+    if (aParts.size() > 1)
+    {
+        std::vector<uno::Reference<text::XTextRange>> aPieces;
+        uno::Reference<text::XTextCursor> xWalk = xText->createTextCursorByRange(xUnit->getStart());
+        for (sal_Int32 nLength : aParts)
+        {
+            uno::Reference<text::XTextCursor> xPiece = xText->createTextCursorByRange(xWalk->getStart());
+            if (!xPiece->goRight(nLength, true))
+                break;
+            aPieces.push_back(xPiece);
+            xWalk->gotoRange(xPiece->getEnd(), false);
+        }
+        uno::Reference<text::XTextRangeCompare> xCompare(xText, uno::UNO_QUERY);
+        if (aPieces.size() == aParts.size() && xCompare.is()
+            && xCompare->compareRegionEnds(aPieces.back(), xUnit) == 0)
+        {
+            rUnits.insert(rUnits.end(), aPieces.begin(), aPieces.end());
+            return;
+        }
+    }
+    rUnits.push_back(xUnit);
+}
