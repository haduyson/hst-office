+// HST: Paragraphs(n).Range ends after its mark (as in Word), i.e. at the start of paragraph n+1 in Writer.
+// Paragraph-wide changes through that range must stay in paragraph n, as they do in Word.
+uno::Reference< text::XTextCursor >
+SwVbaRange::getParagraphScope()
+{
+    uno::Reference< text::XTextCursor > xScope = mxText->createTextCursorByRange( mxTextCursor );
+    if( xScope->isCollapsed() )
+        return xScope;
+    uno::Reference< text::XTextCursor > xEnd = mxText->createTextCursorByRange( mxTextCursor->getEnd() );
+    uno::Reference< text::XParagraphCursor > xEndPara( xEnd, uno::UNO_QUERY );
+    uno::Reference< text::XTextRangeCompare > xCompare( mxText, uno::UNO_QUERY );
+    if( !xEndPara.is() || !xCompare.is() || !xEndPara->isStartOfParagraph() )
+        return xScope;
+    xEnd->goLeft( 1, false );
+    // never move the end before the start: a range of just a paragraph mark keeps its own paragraph
+    if( xCompare->compareRegionStarts( xScope->getStart(), xEnd->getStart() ) >= 0 )
+    {
+        xScope->gotoRange( xScope->getStart(), false );
+        xScope->gotoRange( xEnd->getStart(), true );
+    }
+    return xScope;
+}
