+// HST Office
+CPPUNIT_TEST_FIXTURE(Test, testHstPictureShownSizeKept)
+{
+    // A picture shown at 65.9 % of its size was written as \picscalex65 (a whole percent), so it came back 1 %
+    // smaller after every save; the shown size is now the goal, at 100 %.
+    createSwDoc();
+    Graphic aGraphic(Bitmap(Size(100, 75), vcl::PixelFormat::N24_BPP));
+    aGraphic.SetPrefMapMode(MapMode(MapUnit::Map100thMM));
+    aGraphic.SetPrefSize(Size(5000, 3750));
+    uno::Reference<lang::XMultiServiceFactory> xFactory(mxComponent, uno::UNO_QUERY);
+    uno::Reference<beans::XPropertySet> xPicture(
+        xFactory->createInstance(u"com.sun.star.text.TextGraphicObject"_ustr), uno::UNO_QUERY);
+    xPicture->setPropertyValue(u"Graphic"_ustr, uno::Any(aGraphic.GetXGraphic()));
+    xPicture->setPropertyValue(u"AnchorType"_ustr,
+                               uno::Any(text::TextContentAnchorType_AS_CHARACTER));
+    uno::Reference<text::XTextDocument> xDocument(mxComponent, uno::UNO_QUERY);
+    uno::Reference<text::XText> xText = xDocument->getText();
+    xText->insertTextContent(xText->getEnd(),
+                             uno::Reference<text::XTextContent>(xPicture, uno::UNO_QUERY), false);
+    const awt::Size aShown(3295, 2471); // 65.9 %
+    xPicture->setPropertyValue(u"Size"_ustr, uno::Any(aShown));
+
+    saveAndReload(TestFilter::RTF);
+    // within 1 twip (1.76 mm100); 3250 x 2437 before
+    const awt::Size aSize = getShape(1)->getSize();
+    CPPUNIT_ASSERT_LESSEQUAL(sal_Int32(2), std::abs(aSize.Width - aShown.Width));
+    CPPUNIT_ASSERT_LESSEQUAL(sal_Int32(2), std::abs(aSize.Height - aShown.Height));
+}
