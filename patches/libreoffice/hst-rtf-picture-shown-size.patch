@@ -0,0 +1,31 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * Part of HST Office. This file is HST's own work and is not covered by the MPL.
+ */
+
+#pragma once
+
+#include <tools/gen.hxx>
+
+namespace sw::hst
+{
+/// The size fields RTF writes for a picture: \picwgoal, \pichgoal in twips, \picscalex, \picscaley in percent.
+struct RtfPictureGoal
+{
+    tools::Long nWidth = 0;
+    tools::Long nHeight = 0;
+    tools::Long nScaleX = 100;
+    tools::Long nScaleY = 100;
+};
+
+/** The goal and scale of a picture of size rOrig (twips) shown at rRendered. Word and the RTF reader keep the scale as
+    a whole percent, so a picture shown at 65.9 % came back at 65 %, 1-2 % smaller on every save: an uncropped picture
+    gets its shown size as the goal, at 100 %. A cropped one keeps its size as the goal (the crops are in its units, and
+    the reader crops the picture data by them) and the scale of its cropped size, as before. */
+RtfPictureGoal RtfShownPictureGoal(const Size& rOrig, const Size& rRendered, tools::Long nCropLeft,
+                                   tools::Long nCropRight, tools::Long nCropTop, tools::Long nCropBottom);
+}
+
