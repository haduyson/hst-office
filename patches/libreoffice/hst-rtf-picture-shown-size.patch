@@ -0,0 +1,40 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * Part of HST Office. This file is HST's own work and is not covered by the MPL.
+ */
+
+#include "rtfpicturescale.hxx"
+
+namespace sw::hst
+{
+namespace
+{
+/// Percent of the cropped size that is shown (100 for a picture of no size, which once crashed the export).
+tools::Long CroppedScale(tools::Long nShown, tools::Long nCropped)
+{
+    return nCropped ? 100 * nShown / nCropped : 100;
+}
+}
+
+RtfPictureGoal RtfShownPictureGoal(const Size& rOrig, const Size& rRendered, tools::Long nCropLeft,
+                                   tools::Long nCropRight, tools::Long nCropTop, tools::Long nCropBottom)
+{
+    RtfPictureGoal aGoal;
+    const bool bCropped = nCropLeft || nCropRight || nCropTop || nCropBottom;
+    if (!bCropped && rRendered.Width() > 0 && rRendered.Height() > 0)
+    {
+        aGoal.nWidth = rRendered.Width();
+        aGoal.nHeight = rRendered.Height();
+        return aGoal;
+    }
+    aGoal.nWidth = rOrig.Width();
+    aGoal.nHeight = rOrig.Height();
+    aGoal.nScaleX = CroppedScale(rRendered.Width(), rOrig.Width() - nCropLeft - nCropRight);
+    aGoal.nScaleY = CroppedScale(rRendered.Height(), rOrig.Height() - nCropTop - nCropBottom);
+    return aGoal;
+}
+}
+
