+bool HstLargeDocxPaginationAllowed(const SwDoc& rDoc)
+{
+    const SwDocShell* pShell = rDoc.GetDocShell();
+    const SfxMedium* pMedium = pShell ? pShell->GetMedium() : nullptr;
+    const std::shared_ptr<const SfxFilter>& pFilter = pMedium ? pMedium->GetFilter() : nullptr;
+    if (!pFilter || pFilter->GetUserData() != FILTER_DOCX)
+        return false;
+    // Footnotes take body height and anchored objects push text aside: the estimate knows neither.
+    return rDoc.GetFootnoteIdxs().empty() && rDoc.GetSpzFrameFormats()->empty();
+}
+
+tools::Long HstMaxCharHeight(const SwTextNode& rNode, tools::Long nParaHeight)
+{
+    tools::Long nMax = nParaHeight;
+    const SwpHints* pHints = rNode.GetpSwpHints();
+    for (size_t i = 0; pHints && i < pHints->Count(); ++i)
+    {
+        const SwTextAttr* pHint = pHints->Get(i);
+        if (pHint->Which() != RES_TXTATR_AUTOFMT && pHint->Which() != RES_TXTATR_CHARFMT)
+            continue;
+        if (const SvxFontHeightItem* pSize = CharFormat::GetItem(*pHint, RES_CHRATR_FONTSIZE))
+            nMax = std::max<tools::Long>(nMax, pSize->GetHeight());
+    }
+    return nMax;
+}
+
+tools::Long
+HstEstimateTableHeight(const SwTable& rTable, tools::Long nWidth,
+                       const std::function<tools::Long(const SwTextNode&, tools::Long)>& rEstimatePara)
+{
+    if (rTable.GetRowsToRepeat() > 0 || nWidth <= 0)
+        return 0;
+    const SwNodes& rNodes = rTable.GetTableNode()->GetNodes();
+    tools::Long nTable = 0;
+    for (const SwTableLine* pLine : rTable.GetTabLines())
+    {
+        const SwTableBoxes& rBoxes = pLine->GetTabBoxes();
+        tools::Long nLineWidth = 0;
+        for (const SwTableBox* pBox : rBoxes)
+            nLineWidth += std::max<tools::Long>(0, pBox->GetFrameFormat()->GetFrameSize().GetWidth());
+        tools::Long nRow = 0;
+        for (const SwTableBox* pBox : rBoxes)
+        {
+            const SwStartNode* pStart = pBox->GetSttNd();
+            if (!pStart || !pBox->GetTabLines().empty())
+                return 0; // split cell
+            if (pBox->getRowSpan() < 1)
+                continue; // covered by a cell above, which counts the text
+            const SvxBoxItem& rBorder = pBox->GetFrameFormat()->GetBox();
+            const tools::Long nBoxWidth
+                = nLineWidth > 0
+                      ? nWidth * std::max<tools::Long>(0, pBox->GetFrameFormat()->GetFrameSize().GetWidth())
+                            / nLineWidth
+                      : nWidth / tools::Long(rBoxes.size());
+            const tools::Long nTextWidth
+                = std::max<tools::Long>(1, nBoxWidth - rBorder.CalcLineSpace(SvxBoxItemLine::LEFT, true)
+                                               - rBorder.CalcLineSpace(SvxBoxItemLine::RIGHT, true));
+            tools::Long nCell = rBorder.CalcLineSpace(SvxBoxItemLine::TOP, true)
+                                + rBorder.CalcLineSpace(SvxBoxItemLine::BOTTOM, true);
+            for (SwNodeOffset n = pStart->GetIndex() + 1; n < pStart->EndOfSectionIndex(); ++n)
+            {
+                const SwNode& rNode = *rNodes[n];
+                if (rNode.IsTableNode() || rNode.IsSectionNode())
+                    return 0; // nested table or section
+                if (const SwTextNode* pText = rNode.GetTextNode())
+                    nCell += rEstimatePara(*pText, nTextWidth);
+            }
+            nRow = std::max(nRow, nCell);
+        }
+        const SwFormatFrameSize& rRowSize = pLine->GetFrameFormat()->GetFrameSize();
+        if (rRowSize.GetHeightSizeType() != SwFrameSize::Variable)
+            nRow = std::max<tools::Long>(nRow, rRowSize.GetHeight());
+        nTable += nRow;
+    }
+    return nTable;
+}
+
+SwFrame* HstFirstSiblingToFormat(SwFrame& rFrame)
+{
+    SwFrame* pFirst = rFrame.GetUpper()->Lower();
+    if (!rFrame.IsPageFrame() || !rFrame.getRootFrame()->IsLargeTextPagination())
+        return pFirst;
+    // Formatted pages before the last formatted one need no formatting; unformatted ones before it
+    // are formatted by the layout in page order, as all pages are.
+    SwFrame* pStart = rFrame.GetPrev();
+    while (pStart && !pStart->isFrameAreaDefinitionValid())
+        pStart = pStart->GetPrev();
+    return pStart ? pStart->GetNext() : pFirst;
+}
