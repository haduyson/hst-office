+/// Paragraph count from which a plain text without layout cache is put on pages while the frames are
+/// created: below it the start-to-end layout is cheap enough.
+constexpr SwNodeOffset TEXT_PAGINATION_MIN_NODES(3000);
+
+bool IsPlainTextImport(const SwDoc& rDoc)
+{
+    const SwDocShell* pShell = rDoc.GetDocShell();
+    const SfxMedium* pMedium = pShell ? pShell->GetMedium() : nullptr;
+    const std::shared_ptr<const SfxFilter>& pFilter = pMedium ? pMedium->GetFilter() : nullptr;
+    return pFilter && (pFilter->GetUserData() == FILTER_TEXT || pFilter->GetUserData() == FILTER_TEXT_DLG);
