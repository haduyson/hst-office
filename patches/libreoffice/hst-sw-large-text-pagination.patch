+/** A plain text without layout cache has all its paragraphs created on the first page. Every page
+ *  break then moves all the following paragraphs to the next page (MoveFwd: GetNextLeaf walks them,
+ *  PasteTree reparents them), which costs O(paragraphs * pages) - about 20 min for 50 MB.
+ *  Instead, insert a page when the paragraphs on the current page are estimated to fill most of the
+ *  body. The estimate is generous (each paragraph is guessed taller than it is), so the pages start
+ *  underfilled and the layout pulls the following paragraphs back (MoveBwd), each move bounded by one
+ *  page; the result is the same pagination as the start-to-end layout.
+ */
+void SwLayHelper::InitTextPagination(SwNodeOffset nNodeIndex)
+{
+    const char* pEnv = std::getenv("HST_SW_TEXT_PAGINATION");
+    if (pEnv && pEnv[0] == '0')
+        return;
+    const SwNodes& rNodes = mrDoc.GetNodes();
+    if (nNodeIndex != rNodes.GetEndOfContent().StartOfSectionNode()->GetIndex() + 1
+        || rNodes.GetEndOfContent().GetIndex() - nNodeIndex < TEXT_PAGINATION_MIN_NODES
+        || !mrpPage || !mrpLay || !mrpLay->IsPageBodyFrame() || mrpActualSection
+        || !IsPlainTextImport(mrDoc))
+        return;
+    const SwViewShell* pSh = mrpPage->getRootFrame()->GetCurrShell();
+    if (pSh && pSh->GetViewOptions()->getBrowseMode())
+        return;
+    const SwFrameFormat& rFormat = mrpPage->GetPageDesc()->GetMaster();
+    if (rFormat.GetHeader().IsActive() || rFormat.GetFooter().IsActive()
+        || rFormat.GetCol().GetNumCols() > 1)
+        return;
+    const Size aSize = rFormat.GetFrameSize().GetSize();
+    const SvxLRSpaceItem& rLR = rFormat.GetLRSpace();
+    const SvxULSpaceItem& rUL = rFormat.GetULSpace();
+    const tools::Long nWidth = aSize.Width() - rLR.ResolveLeft() - rLR.ResolveRight({});
+    const tools::Long nHeight = aSize.Height() - rUL.GetUpper() - rUL.GetLower();
+    if (nWidth <= 0 || nHeight <= 0)
+        return;
+    mnTextBodyWidth = nWidth;
+    mnTextPageBudget = nHeight;
+    // Every inserted page would compute the positions of all pages: do it once at the end.
+    mpTextRoot = mrpPage->getRootFrame();
+    mpTextRoot->SetLargeTextPagination();
+    mpTextRoot->LockViewLayout();
+}
