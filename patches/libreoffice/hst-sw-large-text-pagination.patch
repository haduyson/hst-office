+
+/// Deterministic mix of short, empty, long, tabbed, Vietnamese, CJK and longer-than-a-page lines.
+void writeText(SvStream& rStream, sal_Int32 nParagraphs)
+{
+    static const char* const aWords[] = { "Báo", "cáo", "thanh", "toán", "hợp", "đồng",
+                                          "kế",  "khách", "hàng", "Lorem", "ipsum", "漢字" };
+    sal_uInt32 nSeed = 12345;
+    auto next = [&nSeed](sal_uInt32 n) {
+        nSeed = nSeed * 1103515245 + 12345;
+        return (nSeed >> 16) % n;
+    };
+    for (sal_Int32 i = 0; i < nParagraphs; ++i)
+    {
+        const sal_uInt32 nKind = next(100);
+        sal_uInt32 nWords = nKind < 50 ? 2 + next(6) : nKind < 75 ? 15 + next(40) : nKind < 85 ? 0
+                            : nKind < 95 ? 100 + next(250) : nKind < 99 ? 8 : 1200 + next(600);
+        OUStringBuffer aLine;
+        for (sal_uInt32 j = 0; j < nWords; ++j)
+        {
+            if (j)
+                aLine.append(nKind >= 95 && nKind < 99 ? '\t' : ' ');
+            aLine.append(OUString::fromUtf8(aWords[next(SAL_N_ELEMENTS(aWords))]));
+        }
+        rStream.WriteOString(OUStringToOString(aLine, RTL_TEXTENCODING_UTF8));
+        rStream.WriteOString("\n");
+    }
+}
+
+OUString createText(utl::TempFileNamed& rFile, sal_Int32 nParagraphs)
+{
+    rFile.EnableKillingFile();
+    SvStream* pStream = rFile.GetStream(StreamMode::WRITE | StreamMode::TRUNC);
+    writeText(*pStream, nParagraphs);
+    rFile.CloseStream();
+    return rFile.GetURL();
+}
+
+CPPUNIT_TEST_FIXTURE(Test, testLargeTextPaginationUnchanged)
+{
+    // Above the size threshold: pages are inserted while the frames are created, and the final
+    // pagination is the same as the one of the start-to-end layout.
+    utl::TempFileNamed aFile(u"large-text", true, u".txt");
+    const OUString aURL = createText(aFile, 8000);
+    size_t nOffPages = 0, nOnPages = 0;
+    sal_Int64 nOffMs = 0, nOnMs = 0;
+    const auto aOff = layoutText(aURL, false, nOffPages, nOffMs);
+    const auto aOn = layoutText(aURL, true, nOnPages, nOnMs);
+    std::cerr << "large text: " << aOff.size() << " pages; start-to-end " << nOffMs
+              << " ms, paginated " << nOnMs << " ms; pages after load " << nOffPages << " / "
+              << nOnPages << "\n";
+    CPPUNIT_ASSERT_GREATER(size_t(100), aOff.size());
+    // The estimate is generous: right after loading there are more pages than in the end.
+    CPPUNIT_ASSERT_GREATER(aOn.size(), nOnPages);
+    CPPUNIT_ASSERT_EQUAL(aOff.size(), aOn.size());
+    for (size_t i = 0; i < aOff.size(); ++i)
+    {
+        const OString aPage("page " + OString::number(i + 1));
+        CPPUNIT_ASSERT_EQUAL_MESSAGE(aPage.getStr(), aOff[i].first, aOn[i].first);
+        CPPUNIT_ASSERT_EQUAL_MESSAGE(aPage.getStr(), aOff[i].second, aOn[i].second);
+    }
+}
+
+CPPUNIT_TEST_FIXTURE(Test, testOtherFormatsNotPaginated)
+{
+    // The same large content saved as .odt and .docx loads through the old path: the estimate and the
+    // deferred page positions stay off for every format but plain text.
+    utl::TempFileNamed aFile(u"large-text", true, u".txt");
+    const OUString aURL = createText(aFile, 8000);
+    size_t nLoadPages = 0;
+    sal_Int64 nMs = 0;
+    layoutText(aURL, true, nLoadPages, nMs);
+    CPPUNIT_ASSERT(getSwDoc()->getIDocumentLayoutAccess().GetCurrentLayout()->IsLargeTextPagination());
+    for (TestFilter eFilter : { TestFilter::ODT, TestFilter::DOCX })
+    {
+        saveAndReload(eFilter);
+        calcLayout();
+        const SwRootFrame* pLayout = getSwDoc()->getIDocumentLayoutAccess().GetCurrentLayout();
+        CPPUNIT_ASSERT(!pLayout->IsLargeTextPagination());
+        CPPUNIT_ASSERT_GREATER(sal_uInt16(100), pLayout->GetPageNum());
+    }
+}
+
+CPPUNIT_TEST_FIXTURE(Test, testSmallTextNotPaginated)
+{
+    // Below the size threshold the frames all start on the first page, as before.
+    utl::TempFileNamed aFile(u"small-text", true, u".txt");
+    const OUString aURL = createText(aFile, 1500);
+    size_t nLoadPages = 0;
+    sal_Int64 nMs = 0;
+    const auto aPages = layoutText(aURL, true, nLoadPages, nMs);
+    CPPUNIT_ASSERT_GREATER(size_t(10), aPages.size());
+    CPPUNIT_ASSERT_LESS(aPages.size(), nLoadPages);
+}
