+    /// Pages of the current layout: (paragraph number, offset) of the first body text on each page.
+    std::vector<std::pair<sal_Int32, sal_Int32>> getPagination()
+    {
+        SwDoc* pDoc = getSwDoc();
+        const SwNodeOffset nStart
+            = pDoc->GetNodes().GetEndOfContent().StartOfSectionNode()->GetIndex();
+        std::vector<std::pair<sal_Int32, sal_Int32>> aPages;
+        const SwRootFrame* pLayout = pDoc->getIDocumentLayoutAccess().GetCurrentLayout();
+        for (const SwFrame* pPage = pLayout->Lower(); pPage; pPage = pPage->GetNext())
+        {
+            const SwContentFrame* pContent
+                = static_cast<const SwPageFrame*>(pPage)->FindFirstBodyContent();
+            if (!pContent || !pContent->IsTextFrame())
+            {
+                aPages.emplace_back(-1, -1);
+                continue;
+            }
+            auto pText = static_cast<const SwTextFrame*>(pContent);
+            aPages.emplace_back(sal_Int32(pText->GetTextNodeFirst()->GetIndex() - nStart),
+                                sal_Int32(pText->GetOffset()));
+        }
+        return aPages;
+    }
