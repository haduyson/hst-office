+/** Height estimate of the paragraph mrpFrame, which is about to be inserted (0: estimate off).
+ *  Measured with the paragraph font on the reference device and then increased by a tenth, so that
+ *  the estimated pages hold a bit less than the real ones (the layout pulls the rest back, bounded
+ *  by one page); a page holding less than half would leave empty pages behind, a page holding more
+ *  would push a growing rest from page to page.
+ */
+tools::Long SwLayHelper::EstimateTextHeight()
+{
+    OutputDevice* pOut = mrDoc.getIDocumentDeviceAccess().getReferenceDevice(true);
+    if (!pOut || !mrpFrame->IsTextFrame() || mrpActualSection || !mrpLay->IsPageBodyFrame())
+    {
+        mnTextPageBudget = 0; // not a plain paragraph sequence: leave the layout to itself
+        return 0;
     }
+    const SwTextFrame& rFrame = *static_cast<SwTextFrame*>(mrpFrame);
+    const SwAttrSet& rSet = rFrame.GetTextNodeForParaProps()->GetSwAttrSet();
+    if (!mpTextMetrics)
+        mpTextMetrics.reset(new SwTextPaginationMetrics);
+    SwTextPaginationMetrics& rM = *mpTextMetrics;
+    const SvxFontItem& rFontItem = rSet.GetFont();
+    const tools::Long nHeight = rSet.GetSize().GetHeight();
+    const FontWeight eWeight = rSet.GetWeight().GetWeight();
+    const FontItalic eItalic = rSet.GetPosture().GetPosture();
+    auto pushFont = [&]() {
+        vcl::Font aFont(rFontItem.GetFamilyName(), rFontItem.GetStyleName(), Size(0, nHeight));
+        aFont.SetFamily(rFontItem.GetFamily());
+        aFont.SetPitch(rFontItem.GetPitch());
+        aFont.SetCharSet(rFontItem.GetCharSet());
+        aFont.SetWeight(eWeight);
+        aFont.SetItalic(eItalic);
+        pOut->Push(vcl::PushFlags::FONT | vcl::PushFlags::MAPMODE);
+        pOut->SetMapMode(MapMode(MapUnit::MapTwip));
+        pOut->SetFont(aFont);
+    };
+    if (rM.maName != rFontItem.GetFamilyName() || rM.mnHeight != nHeight || rM.meWeight != eWeight
+        || rM.meItalic != eItalic)
+    {
+        rM.maName = rFontItem.GetFamilyName();
+        rM.mnHeight = nHeight;
+        rM.meWeight = eWeight;
+        rM.meItalic = eItalic;
+        rM.maAdvances.clear();
+        pushFont();
+        rM.mnLine = pOut->GetTextHeight() + pOut->GetFontMetric().GetExternalLeading();
+        pOut->Pop();
+    }
+    const OUString& rText = rFrame.GetText();
+    tools::Long nWidth = 0;
+    bool bPushed = false;
+    for (sal_Int32 i = 0; i < rText.getLength(); ++i)
+    {
+        const sal_Unicode c = rText[i];
+        auto it = rM.maAdvances.find(c);
+        if (it == rM.maAdvances.end())
+        {
+            if (!bPushed)
+            {
+                pushFont();
+                bPushed = true;
+            }
+            tools::Long nAdvance = nHeight; // tabs, surrogates, controls: one em
+            if (c != '\t' && !rtl::isSurrogate(c) && c >= 0x20)
+                nAdvance = std::max<tools::Long>(0, pOut->GetTextWidth(OUString(c)));
+            else if (c == '\t')
+                nAdvance = 3 * nHeight;
+            it = rM.maAdvances.emplace(c, nAdvance).first;
+        }
+        nWidth += it->second;
+    }
+    if (bPushed)
+        pOut->Pop();
+    // A line breaks at a word, so it is shorter than the body width: count lines of 90 %.
+    const tools::Long nLineWidth = std::max<tools::Long>(1, mnTextBodyWidth * 9 / 10);
+    const sal_Int64 nLines = std::max<sal_Int64>(1, (sal_Int64(nWidth) + nLineWidth - 1) / nLineWidth);
+    const SvxLineSpacingItem& rSpacing = rSet.GetLineSpacing();
+    tools::Long nLine = std::max<tools::Long>(rM.mnLine, nHeight);
+    if (rSpacing.GetInterLineSpaceRule() == SvxInterLineSpaceRule::Prop)
+        nLine = nLine * std::max<tools::Long>(100, rSpacing.GetPropLineSpace()) / 100;
+    else if (rSpacing.GetInterLineSpaceRule() == SvxInterLineSpaceRule::Fix)
+        nLine += std::max<tools::Long>(0, rSpacing.GetInterLineSpace());
+    if (rSpacing.GetLineSpaceRule() != SvxLineSpaceRule::Auto)
+        nLine = std::max<tools::Long>(nLine, rSpacing.GetLineHeight());
+    const SvxULSpaceItem& rUL = rSet.GetULSpace();
+    const tools::Long nPara = nLines * nLine + rUL.GetUpper() + rUL.GetLower();
+    return nPara + nPara / 10;
 }
 
