+/// The labelled state a group takes while there is room (the narrower of large and medium), or rGroup's
+/// smallest shown state when that one costs no more (the group then never loses labels to save room).
+inline std::size_t labelledState(const Group& rGroup)
+{
+    if (rGroup.widths.size() <= RegrowSmallState)
+        return smallestShownState(rGroup);
+    const std::size_t nState = widthOf(rGroup, RegrowMediumState) <= widthOf(rGroup, 0) ? RegrowMediumState : 0;
+    return widthOf(rGroup, RegrowSmallState) < widthOf(rGroup, nState) ? nState : smallestShownState(rGroup);
+}
+
+/// The fixed order (independent of the width) in which groups give up their labels: the least room saved
+/// first, the least used first on a tie; a group whose labels cost under a tenth of its width keeps them last.
+inline std::vector<std::size_t> labelDropOrder(const std::vector<Group>& rGroups, const std::vector<std::size_t>& rPriority)
+{
+    std::vector<std::size_t> aRank(rGroups.size(), rGroups.size()); // usage rank, 0 most used
+    for (std::size_t n = 0; n < rPriority.size(); ++n)
+        if (rPriority[n] < rGroups.size())
+            aRank[rPriority[n]] = n;
+    std::vector<std::size_t> aOrder;
+    for (std::size_t i = 0; i < rGroups.size(); ++i)
+        if (labelledState(rGroups[i]) != smallestShownState(rGroups[i]))
+            aOrder.push_back(i);
+    auto saving = [&](std::size_t i) {
+        return widthOf(rGroups[i], labelledState(rGroups[i])) - widthOf(rGroups[i], RegrowSmallState);
+    };
+    auto cheap = [&](std::size_t i) { return saving(i) * 10 < widthOf(rGroups[i], labelledState(rGroups[i])); };
+    std::stable_sort(aOrder.begin(), aOrder.end(), [&](std::size_t x, std::size_t y) {
+        if (cheap(x) != cheap(y))
+            return cheap(y);
+        if (saving(x) != saving(y))
+            return saving(x) < saving(y);
+        return aRank[x] > aRank[y];
+    });
+    return aOrder;
+}
