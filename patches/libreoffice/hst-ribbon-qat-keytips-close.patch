HST Office: the quick access KeyTips close before their command runs.

A tip of the tab level opens the next level only for a tab; the tips of a quick access command run from there
stayed on, so the next Alt closed them instead of showing them: Alt, 2 (Undo) then Alt, 3 typed the 3 (Linux and
Windows, train 1.0.2-020). The commands now close the tips first, as the search box's Q does and as in the
reference suite.

--- a/sfx2/source/notebookbar/HstRibbonKeyTips.cxx
+++ b/sfx2/source/notebookbar/HstRibbonKeyTips.cxx
@@ -250,7 +250,16 @@
             for (ToolBox::ImplToolItems::size_type i = 0; i < m_xQuick->GetItemCount() && nDigit < 10; ++i)
                 if (AddToolBoxItem(*m_xQuick, m_xQuick->GetItemId(i), aTargets, aPreferred, std::to_string(nDigit),
                                    true))
+                {
+                    // the tips close before the command runs, as in Office: a tip of this level opens the next
+                    // level only for a tab, so the tips of a command run from here stayed on, and the next Alt
+                    // closed them instead of showing them (Alt, 2 then Alt, 3 typed the 3)
+                    aTargets.back().aRun = [this, aRun = aTargets.back().aRun] {
+                        Close();
+                        aRun();
+                    };
                     ++nDigit;
+                }
         }
         // the feature search box of the tab row: Q, as Office's Search box
         for (vcl::Window* pChild = m_xTabs->GetWindow(GetWindowType::FirstChild); pChild;
