+void IconThemeSelectorTest::HstModernIsTheDefaultStyle()
+{
+    std::vector<vcl::IconThemeInfo> themes;
+    for (const auto& id : { u"colibre"_ustr, u"hst"_ustr, u"hst_dark"_ustr, u"hst_modern"_ustr,
+                            u"hst_modern_dark"_ustr })
+    {
+        vcl::IconThemeInfo info;
+        info.mThemeId = id;
+        themes.push_back(info);
+    }
+    vcl::IconThemeSelector selector;
+    // Automatic ("auto") picks the colourful style, light or dark.
+    selector.SetPreferredIconTheme(u"colibre"_ustr, false);
+    CPPUNIT_ASSERT_EQUAL(u"hst_modern"_ustr,
+        selector.SelectIconThemeForDesktopEnvironment(themes, DesktopType::GNOME));
+    CPPUNIT_ASSERT_EQUAL(u"hst"_ustr, selector.SelectIconTheme(themes, u"hst"_ustr));
+    selector.SetPreferredIconTheme(u"colibre"_ustr, true);
+    CPPUNIT_ASSERT_EQUAL(u"hst_modern_dark"_ustr,
+        selector.SelectIconThemeForDesktopEnvironment(themes, DesktopType::GNOME));
+    // The two values of the options page follow the dark UI.
+    CPPUNIT_ASSERT_EQUAL(u"hst_dark"_ustr, selector.SelectIconTheme(themes, u"hst"_ustr));
+    CPPUNIT_ASSERT_EQUAL(u"hst_modern_dark"_ustr, selector.SelectIconTheme(themes, u"hst_modern"_ustr));
+    CPPUNIT_ASSERT_EQUAL(u"colibre"_ustr, selector.SelectIconTheme(themes, u"colibre"_ustr));
+}
+
 // Put the test suite in the registry
 CPPUNIT_TEST_SUITE_REGISTRATION(IconThemeSelectorTest);
 
