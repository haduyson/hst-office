 #include <vcl/tabs.hrc>
 
+namespace
+{
+constexpr TranslateId STR_HST_HL_INTERNET = NC_("hsthyperlinkdlg|internet", "~Existing File or Web Page");
+constexpr TranslateId STR_HST_HL_DOCUMENT = NC_("hsthyperlinkdlg|document", "~Place in This Document");
+constexpr TranslateId STR_HST_HL_NEWDOC = NC_("hsthyperlinkdlg|newdoc", "Create ~New Document");
+constexpr TranslateId STR_HST_HL_MAIL = NC_("hsthyperlinkdlg|mail", "E-~mail Address");
+}
+
 HyperlinkDialog::HyperlinkDialog(weld::Window* pParent, SfxChildWindow* /*pChildWindow*/)
     : SfxTabDialogController(pParent, u"cui/ui/hyperlinkdlg.ui"_ustr, u"HyperlinkDialog"_ustr)
 {
-    AddTabPage("Internet", TabResId(RID_TAB_HLINTERNET.aLabel), HyperlinkInternetTP::Create,
+    // HST: Word's "Link to" order and names; the page ids stay.
+    AddTabPage("Internet", CuiResId(STR_HST_HL_INTERNET), HyperlinkInternetTP::Create,
                RID_TAB_HLINTERNET.sIconName);
 
-    AddTabPage("Mail", TabResId(RID_TAB_HLMAIL.aLabel), HyperlinkMailTabPage::Create,
-               RID_TAB_HLMAIL.sIconName);
-
-    AddTabPage("Document", TabResId(RID_TAB_HLDOC.aLabel), HyperlinkDocTabPage::Create,
+    AddTabPage("Document", CuiResId(STR_HST_HL_DOCUMENT), HyperlinkDocTabPage::Create,
                RID_TAB_HLDOC.sIconName);
 
-    AddTabPage("New Document", TabResId(RID_TAB_HLDOCN.aLabel), HyperlinkDocNewTabPage::Create,
+    AddTabPage("New Document", CuiResId(STR_HST_HL_NEWDOC), HyperlinkDocNewTabPage::Create,
                RID_TAB_HLDOCN.sIconName);
 
+    AddTabPage("Mail", CuiResId(STR_HST_HL_MAIL), HyperlinkMailTabPage::Create,
+               RID_TAB_HLMAIL.sIconName);
+
     SetApplyHandler(LINK(this, HyperlinkDialog, ClickApplyHdl));
 }
 
