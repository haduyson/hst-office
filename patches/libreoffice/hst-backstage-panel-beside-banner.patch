+#pragma once
+
+#include <algorithm>
+
+namespace sfx2::backstage
+{
+/** The right edge of the File panel, in the pixels of the window it opens in. The panel spans the window up to
+    nInset from its right edge. It stops nInset left of the HASON TECH banner only where it would cover the banner:
+    when the banner reaches below the panel's top (no document tab strip: the panel starts at the tab row and
+    covers the ribbon's body, where the banner is). Below the document tab strip the banner is above the panel
+    and takes none of its width; stopping at the banner there left a 1042 px window at 125 % about 550 px of
+    panel, and the Print page lost its right part ("Quay lại", the printer's status). bBanner false: no banner.
+    Long: the pixel type (tools::Long). */
+template <typename Long>
+Long panelRight(Long nFrameWidth, Long nInset, Long nPanelTop, bool bBanner, Long nBannerLeft, Long nBannerBottom)
+{
+    const Long nRight = nFrameWidth - nInset;
+    if (!bBanner || nBannerBottom <= nPanelTop)
+        return nRight;
+    return std::min(nRight, nBannerLeft - nInset);
+}
+}
+
