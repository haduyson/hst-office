+/// HST Office (1.0.2 mockup, HSTRibbon/FixedChain): a tab with a ladder of its own shows exactly the states of its
+/// chain, as the approved mockup does: every group starts large, the steps apply in order, a step that does not
+/// move a group down or saves no width is passed over, and the first fit stops (hst::ribbon::select). No regrow by
+/// usage (fitByPriority), and a gallery gets no reserved previews. Off: the batch5 behaviour.
+bool lcl_HstFixedChainEnabled()
+{
+    static const bool bEnabled = [] {
+        if (comphelper::LibreOfficeKit::isActive())
+            return false;
+        try
+        {
+            return officecfg::Office::HSTRibbon::FixedChain::get();
+        }
+        catch (...)
+        {
+            return true; // no configuration (unit tests): the shipped default
+        }
+    }();
+    return bEnabled;
+}
+}
