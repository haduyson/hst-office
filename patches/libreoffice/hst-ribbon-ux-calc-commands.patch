+/// HST Office: the ribbon's chart buttons (ChartType=Column, Line or Pie) give the new chart that type before
+/// the wizard opens, so the wizard starts on it; any other value keeps the default.
+void lcl_HstSetChartType(const uno::Reference<chart2::XChartDocument>& xChartDoc, const OUString& rType)
+{
+    if (!xChartDoc.is() || (rType != "Column" && rType != "Line" && rType != "Pie"))
+        return;
+    try
+    {
+        uno::Reference<lang::XMultiServiceFactory> xManager(xChartDoc->getChartTypeManager(), uno::UNO_QUERY);
+        uno::Reference<chart2::XDiagram> xDiagram(xChartDoc->getFirstDiagram());
+        if (!xManager.is() || !xDiagram.is())
+            return;
+        uno::Reference<chart2::XChartTypeTemplate> xTemplate(
+            xManager->createInstance("com.sun.star.chart2.template." + rType), uno::UNO_QUERY);
+        if (xTemplate.is())
+            xTemplate->changeDiagram(xDiagram);
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("sc.ui", "HST: cannot preset the chart type " << rType);
+    }
+}
