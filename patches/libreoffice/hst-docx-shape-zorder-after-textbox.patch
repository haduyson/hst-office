+namespace
+{
+// The draw page position of an already imported object, which is what setPropertyValue("ZOrder")
+// takes. The "ZOrder" that SwXShape reports is SwTextBoxHelper::getOrdNum() instead: it leaves out
+// the text frames of shapes with text boxes, so below any such shape it is lower than the
+// position. Using it here put a shape under the shapes it should cover. The extra place that
+// findZOrder() adds over a shape with a text box (for its text frame) also counts positions.
+std::optional<sal_Int32> lcl_getDrawPagePosition(uno::Reference<beans::XPropertySet> const& xItem)
+{
+    if (SdrObject* pObject = SdrObject::getSdrObjectFromXShape(xItem))
+        if (pObject->getParentSdrObjListFromSdrObject())
+            return static_cast<sal_Int32>(pObject->GetOrdNum());
+    // Text frames and pictures (SwXFrame) report the position itself.
+    sal_Int32 nZOrder(0);
+    if (xItem->getPropertyValue(getPropertyName(PROP_Z_ORDER)) >>= nZOrder)
+        return nZOrder;
+    return std::nullopt;
+}
+}
 
