+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This file is part of the LibreOffice project.
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+#pragma once
+
+// HST Office: Office-style drawing of the ribbon (Tabbed notebookbar) buttons and tabs, the same on
+// every platform. Scoped to the notebookbar: dialogs, the sidebar and classic toolbars keep the
+// native theme. High contrast always uses the native theme, and the OwnerDraw switch
+// (org.openoffice.Office.HSTRibbon) turns it off without a new build.
+
+#include <tools/color.hxx>
+#include <tools/gen.hxx>
+#include <vcl/dllapi.h>
+#include <vcl/outdev.hxx>
+
+class StyleSettings;
+class ToolBox;
+
+namespace hst::ribbon
+{
+/** Colour tokens of the ribbon look (docs/design/ribbon-look/PROPOSAL.md), light or dark. */
+struct Palette
+{
+    Color aHover;
+    Color aPressed;
+    Color aChecked;
+    Color aCheckedBorder;
+    Color aSeparator;
+    Color aCaption;
+    Color aTabAccent;
+    Color aTabHover;
+};
+
+/** The palette for the theme of rStyle: dark when the dialog colour is dark. */
+VCL_DLLPUBLIC Palette paletteFor(const StyleSettings& rStyle);
+
+/** False in high contrast mode: the native theme and the system colours draw. */
+VCL_DLLPUBLIC bool ownerDrawAllowed(const StyleSettings& rStyle);
+
+/** The OwnerDraw switch, read once per process; false in LibreOfficeKit. */
+VCL_DLLPUBLIC bool ownerDrawEnabled();
+
+/** Draw the item backgrounds of rToolBox with the ribbon palette (notebookbar toolboxes only). */
+VCL_DLLPUBLIC void SetOwnerDraw(ToolBox& rToolBox, bool bOn);
+
+/** Background of one toolbar button: rounded hover, pressed and checked (with a 1 px border)
+    states. nHighlight: 1 pressed, 2 hover. Returns false when the native theme must draw. */
+SAL_DLLPRIVATE bool DrawToolButton(vcl::RenderContext& rDev, const tools::Rectangle& rRect,
+                                   sal_uInt16 nHighlight, bool bChecked, bool bEnabled);
+
+/** One notebookbar tab without a box: a light rounded fill on hover, and for the selected tab a
+    short accent bar under its label (nLabelWidth pixels wide). */
+SAL_DLLPRIVATE void DrawTabItem(vcl::RenderContext& rDev, const tools::Rectangle& rItem,
+                                tools::Long nLabelWidth, bool bSelected, bool bHover);
+}
+
+/* vim:set shiftwidth=4 softtabstop=4 expandtab: */
--- /dev/null
+++ b/vcl/source/control/HstRibbonPaint.cxx
@@ -0,0 +1,131 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This file is part of the LibreOffice project.
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+#include <vcl/HstRibbonPaint.hxx>
+
+#include <comphelper/lok.hxx>
+#include <officecfg/Office/HSTRibbon.hxx>
+#include <vcl/image.hxx>
+#include <vcl/settings.hxx>
+#include <vcl/toolbox.hxx>
+
+#include <toolbox.h>
+
+#include <algorithm>
+#include <cmath>
+
+namespace hst::ribbon
+{
+namespace
+{
+tools::Long scaled(const OutputDevice& rDev, double fLogical)
+{
+    return std::max<tools::Long>(1, std::lround(fLogical * rDev.GetDPIScaleFactor()));
+}
+}
+
+Palette paletteFor(const StyleSettings& rStyle)
+{
+    if (rStyle.GetDialogColor().IsDark())
+        return Palette{ Color(0x26, 0x3B, 0x50), Color(0x2D, 0x58, 0x78), Color(0x23, 0x47, 0x62),
+                        Color(0x78, 0xC5, 0xF4), Color(0x35, 0x48, 0x5C), Color(0xAF, 0xBD, 0xCE),
+                        Color(0x78, 0xC5, 0xF4), Color(0x26, 0x3B, 0x50) };
+    return Palette{ Color(0xE8, 0xF1, 0xFA), Color(0xC7, 0xE0, 0xF4), Color(0xE5, 0xF2, 0xFB),
+                    Color(0x00, 0x72, 0xBB), Color(0xDC, 0xE6, 0xF0), Color(0x53, 0x63, 0x79),
+                    Color(0x00, 0x72, 0xBB), Color(0xE8, 0xF1, 0xFA) };
+}
+
+bool ownerDrawAllowed(const StyleSettings& rStyle) { return !rStyle.GetHighContrastMode(); }
+
+bool ownerDrawEnabled()
+{
+    static const bool bEnabled = [] {
+        if (comphelper::LibreOfficeKit::isActive())
+            return false;
+        try
+        {
+            return officecfg::Office::HSTRibbon::OwnerDraw::get();
+        }
+        catch (...)
+        {
+            return true; // no configuration (unit tests): the shipped default
+        }
+    }();
+    return bEnabled;
+}
+
+void SetOwnerDraw(ToolBox& rToolBox, bool bOn)
+{
+    rToolBox.ImplGetToolBoxPrivateData()->mbHstOwnerDraw = bOn;
+    rToolBox.Invalidate();
+}
+
+bool DrawToolButton(vcl::RenderContext& rDev, const tools::Rectangle& rRect, sal_uInt16 nHighlight,
+                    bool bChecked, bool bEnabled)
+{
+    const StyleSettings& rStyle = rDev.GetSettings().GetStyleSettings();
+    if (!ownerDrawAllowed(rStyle))
+        return false;
+    const Palette aPalette = paletteFor(rStyle);
+    // pressed is stronger than checked; checked keeps its border while hovered
+    const bool bPressed = bEnabled && nHighlight == 1;
+    const bool bHover = bEnabled && nHighlight == 2;
+    if (!bPressed && !bHover && !bChecked)
+        return true; // the plain ribbon background shows through
+    const tools::Long nRadius = scaled(rDev, 3);
+    rDev.Push(vcl::PushFlags::LINECOLOR | vcl::PushFlags::FILLCOLOR);
+    rDev.SetFillColor(bPressed || (bChecked && bHover) ? aPalette.aPressed
+                      : bChecked                        ? aPalette.aChecked
+                                                        : aPalette.aHover);
+    if (bChecked)
+        rDev.SetLineColor(aPalette.aCheckedBorder); // an even 1 px border on all four sides
+    else
+        rDev.SetLineColor();
+    tools::Rectangle aRect(rRect);
+    aRect.AdjustRight(-1);
+    aRect.AdjustBottom(-1);
+    rDev.DrawRect(aRect, nRadius, nRadius);
+    rDev.Pop();
+    return true;
+}
+
+void DrawTabItem(vcl::RenderContext& rDev, const tools::Rectangle& rItem, tools::Long nLabelWidth,
+                 bool bSelected, bool bHover)
+{
+    const Palette aPalette = paletteFor(rDev.GetSettings().GetStyleSettings());
+    rDev.Push(vcl::PushFlags::LINECOLOR | vcl::PushFlags::FILLCOLOR);
+    rDev.SetLineColor();
+    if (bHover && !bSelected)
+    {
+        const tools::Long nInset = scaled(rDev, 2);
+        tools::Rectangle aFill(rItem);
+        aFill.AdjustLeft(nInset);
+        aFill.AdjustTop(nInset);
+        aFill.AdjustRight(-nInset);
+        aFill.AdjustBottom(-nInset);
+        rDev.SetFillColor(aPalette.aTabHover);
+        rDev.DrawRect(aFill, scaled(rDev, 3), scaled(rDev, 3));
+    }
+    if (bSelected)
+    {
+        // the selection marker of the tab, under its label; the tab itself has no box or border
+        const tools::Long nBar = scaled(rDev, 2);
+        const tools::Long nPad = scaled(rDev, 6);
+        const tools::Long nMax = std::max<tools::Long>(1, rItem.GetWidth() - 2 * nPad);
+        const tools::Long nWidth = std::clamp<tools::Long>(nLabelWidth, std::min(scaled(rDev, 16), nMax), nMax);
+        const tools::Long nX = rItem.Left() + (rItem.GetWidth() - nWidth) / 2;
+        const tools::Long nY = rItem.Bottom() - nBar - scaled(rDev, 1);
+        rDev.SetFillColor(aPalette.aTabAccent);
+        rDev.DrawRect(tools::Rectangle(Point(nX, nY), Size(nWidth, nBar)), nBar / 2, nBar / 2);
+    }
+    rDev.Pop();
+}
+}
+
