+// HST Office: size of a local file in bytes; 0 for remote, empty or missing URLs.
+// Only file: URLs are inspected so the timer never waits for a network share.
+sal_Int64 hst_localFileSize(const OUString& rURL)
+{
+    if (!rURL.startsWithIgnoreAsciiCase("file:"))
+        return 0;
+    osl::DirectoryItem aItem;
+    osl::FileStatus aStatus(osl_FileStatus_Mask_FileSize);
+    if (osl::DirectoryItem::get(rURL, aItem) != osl::FileBase::E_None
+        || aItem.getFileStatus(aStatus) != osl::FileBase::E_None)
+        return 0;
+    return static_cast<sal_Int64>(aStatus.getFileSize());
+}
+
+// HST Office: remember the larger of the document file and its newest recovery backup;
+// a never-saved document has no file, so only its backup counts (none yet: small).
+void hst_refreshKnownSize(AutoRecovery::TDocumentInfo& rInfo)
+{
+    rInfo.KnownSize = std::max(hst_localFileSize(rInfo.OrgURL), hst_localFileSize(rInfo.OldTempURL));
+}
+
+// HST Office: AutoRecovery interval [ms] of one document. Documents larger than
+// AutoSave/HstLargeDocumentSize [MB] (0 = off) wait AutoSave/HstLargeDocumentTimeIntervall
+// minutes, never less than the user's own interval; all other documents keep nNormalMs.
+sal_Int64 hst_docAutoSaveInterval(const AutoRecovery::TDocumentInfo& rInfo, sal_Int64 nNormalMs)
+{
+    const sal_Int64 nLargeMB = officecfg::Office::Recovery::AutoSave::HstLargeDocumentSize::get();
+    if (nLargeMB <= 0 || rInfo.KnownSize <= nLargeMB * sal_Int64(1024 * 1024))
+        return nNormalMs;
+    const sal_Int64 nLargeMs
+        = officecfg::Office::Recovery::AutoSave::HstLargeDocumentTimeIntervall::get()
+          * sal_Int64(60000); // min -> ms
+    return std::max(nNormalMs, nLargeMs);
+}
