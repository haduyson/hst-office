Test: CppunitTest_sw_uibase_docvw testCloseWhileCommentHasFocus.
---
--- a/sw/qa/uibase/docvw/docvw.cxx
+++ b/sw/qa/uibase/docvw/docvw.cxx
@@ -20,6 +20,9 @@
 #include <vcl/event.hxx>
 #include <vcl/scheduler.hxx>
 
+#include <AnnotationWin.hxx>
+#include <PostItMgr.hxx>
+#include <postithelper.hxx>
 #include <docsh.hxx>
 #include <edtwin.hxx>
 #include <flyfrm.hxx>
@@ -283,6 +286,27 @@
     pWrtShell->GetSfxViewShell()->setLibreOfficeKitViewCallback(nullptr);
 }
 
+CPPUNIT_TEST_FIXTURE(Test, testCloseWhileCommentHasFocus)
+{
+    // Given a document with a comment whose window has the keyboard focus (the comment is being
+    // edited):
+    createSwDoc();
+    dispatchCommand(mxComponent, u".uno:InsertAnnotation"_ustr, {});
+    Scheduler::ProcessEventsToIdle();
+    SwPostItMgr* pPostItMgr = getSwDocShell()->GetView()->GetPostItMgr();
+    CPPUNIT_ASSERT_EQUAL(size_t(1), pPostItMgr->GetPostItFields().size());
+    sw::annotation::SwAnnotationWin* pComment = pPostItMgr->GetPostItFields()[0]->mpPostIt;
+    CPPUNIT_ASSERT(pComment);
+    pPostItMgr->SetActiveSidebarWin(pComment);
+    pComment->GrabFocus();
+    CPPUNIT_ASSERT(pComment->HasChildPathFocus());
+
+    // When closing the document, then make sure the office does not crash: the view drops its
+    // comment manager first, and disposing the focused comment window gives the focus back to the
+    // document window, which looked at the comment manager that was already gone.
+    dispose();
+}
+
 CPPUNIT_PLUGIN_IMPLEMENT();
 
