+CPPUNIT_TEST_FIXTURE(HstObjectBoundaryPaintTest, testMathTypeExamHasNoObjectBoundaries)
+{
+    // A Vietnamese exam question: small MathType (Equation.DSMT4) objects in running text, a figure
+    // and a text frame holding a picture.
+    createSwDoc("hst-mathtype-object-boundary.rtf");
+
+    // The figure gets a border of its own, as one set in Word; one formula is anchored to its
+    // paragraph instead of sitting in the line.
+    uno::Reference<text::XTextGraphicObjectsSupplier> xGraphicsSupplier(mxComponent,
+                                                                        uno::UNO_QUERY_THROW);
+    uno::Reference<container::XIndexAccess> xGraphics(xGraphicsSupplier->getGraphicObjects(),
+                                                      uno::UNO_QUERY_THROW);
+    uno::Reference<beans::XPropertySet> xFigure;
+    OUString aBordered;
+    sal_Int32 nWidest = 0;
+    for (sal_Int32 i = 0; i < xGraphics->getCount(); ++i)
+    {
+        uno::Reference<beans::XPropertySet> xGraphic(xGraphics->getByIndex(i), uno::UNO_QUERY_THROW);
+        const sal_Int32 nWidth = xGraphic->getPropertyValue(u"Width"_ustr).get<sal_Int32>();
+        if (nWidth > nWidest)
+        {
+            nWidest = nWidth;
+            xFigure = xGraphic;
+            aBordered = uno::Reference<container::XNamed>(xGraphic, uno::UNO_QUERY_THROW)->getName();
+        }
+    }
+    CPPUNIT_ASSERT(xFigure.is());
+    table::BorderLine2 aLine;
+    aLine.Color = 0x000000;
+    aLine.OuterLineWidth = 35; // 1 pt
+    for (const OUString& rSide :
+         { u"LeftBorder"_ustr, u"RightBorder"_ustr, u"TopBorder"_ustr, u"BottomBorder"_ustr })
+        xFigure->setPropertyValue(rSide, uno::Any(aLine));
+
+    uno::Reference<text::XTextEmbeddedObjectsSupplier> xObjectsSupplier(mxComponent,
+                                                                       uno::UNO_QUERY_THROW);
+    uno::Reference<container::XNameAccess> xObjects = xObjectsSupplier->getEmbeddedObjects();
+    CPPUNIT_ASSERT(xObjects.is());
+    OUString aAnchored;
+    for (const OUString& rName : xObjects->getElementNames())
+    {
+        uno::Reference<text::XTextContent> xObject(xObjects->getByName(rName),
+                                                   uno::UNO_QUERY_THROW);
+        uno::Reference<text::XTextRange> xAnchor = xObject->getAnchor();
+        uno::Reference<text::XParagraphCursor> xParagraph(
+            xAnchor->getText()->createTextCursorByRange(xAnchor), uno::UNO_QUERY_THROW);
+        xParagraph->gotoStartOfParagraph(false);
+        xParagraph->gotoEndOfParagraph(true);
+        if (xParagraph->getString().indexOf(u"neo") >= 0)
+        {
+            aAnchored = rName;
+            uno::Reference<beans::XPropertySet> xProps(xObject, uno::UNO_QUERY_THROW);
+            xProps->setPropertyValue(u"AnchorType"_ustr,
+                                     uno::Any(text::TextContentAnchorType_AT_PARAGRAPH));
+            xProps->setPropertyValue(u"HoriOrient"_ustr, uno::Any(text::HoriOrientation::NONE));
+            xProps->setPropertyValue(u"HoriOrientPosition"_ustr, uno::Any(sal_Int32(10000)));
+            break;
+        }
+    }
+    CPPUNIT_ASSERT(!aAnchored.isEmpty());
+    calcLayout();
+
+    const std::vector<PaintedFly> aFlys = paintFlys(*getSwDocShell(), *getSwTextDoc());
+
+    // Text frames keep their boundary: this also proves the boundaries were painted at all.
+    int nTextFrames = 0;
+    for (const PaintedFly& rFly : aFlys)
+        if (rFly.eKind == FlyKind::Text)
+        {
+            ++nTextFrames;
+            CPPUNIT_ASSERT_MESSAGE(OString("text frame boundary of " + rFly.aName.toUtf8()
+                                           + ", share " + OString::number(rFly.fBoundary))
+                                       .getStr(),
+                                   rFly.fBoundary > 0.5);
+        }
+    CPPUNIT_ASSERT_EQUAL(1, nTextFrames);
+
+    // Formulas (inline and anchored), the figure and the picture inside the text frame: none.
+    assertNoBoundaryOnObjects(aFlys, 5);
+    CPPUNIT_ASSERT(findFly(aFlys, aAnchored).eKind == FlyKind::Formula);
+
+    // The figure's own border is still painted.
+    const PaintedFly& rFigure = findFly(aFlys, aBordered);
+    CPPUNIT_ASSERT_MESSAGE(
+        OString("figure border, share " + OString::number(rFigure.fDarkOutline)).getStr(),
+        rFigure.fDarkOutline > 0.8);
+}
