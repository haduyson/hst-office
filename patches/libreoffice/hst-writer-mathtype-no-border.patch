+bool sw::hst::IsPictureOrObjectFly(const SwLayoutFrame& rFrame)
+{
+    if (!rFrame.IsFlyFrame())
+        return false;
+    // A picture or object fly holds exactly one content frame without text: the graphic or OLE
+    // node's frame. A text frame holds text (or layout) frames.
+    const SwFrame* pContent = rFrame.Lower();
+    return pContent && pContent->IsNoTextFrame();
+}
