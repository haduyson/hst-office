+/// The on-screen boundary lines ("Text Boundaries") Writer draws around fly frames.
+class HstObjectBoundaryPaintTest : public SwModelTestBase
+{
+public:
+    HstObjectBoundaryPaintTest()
+        : SwModelTestBase(u"/sw/qa/core/hst/data/"_ustr)
+    {
+    }
+};
+
+/// Twips per pixel when a tile is painted at 100 % (96 DPI).
+constexpr double TWIPS_PER_PIXEL = 15.0;
+
+enum class FlyKind
+{
+    Formula, // OLE object: MathType, Equation 3.0, HST formula
+    Picture,
+    Text,
+};
+
+struct PaintedFly
+{
+    FlyKind eKind;
+    OUString aName;
+    /// Fraction (0..1) of the print area outline drawn in the boundary colour.
+    double fBoundary;
+    /// Fraction (0..1) of the frame area outline drawn dark (a real border).
+    double fDarkOutline;
+};
+
+bool isBoundaryColour(const Color& rPixel, const Color& rBoundary)
+{
+    return std::abs(rPixel.GetRed() - rBoundary.GetRed()) <= 6
+           && std::abs(rPixel.GetGreen() - rBoundary.GetGreen()) <= 6
+           && std::abs(rPixel.GetBlue() - rBoundary.GetBlue()) <= 6;
+}
+
+bool isDark(const Color& rPixel) { return rPixel.GetLuminance() < 100; }
+
+/// Share of the sample points along the outline of rRect (pixels) where a pixel within 1 pixel
+/// across the outline satisfies rMatch.
+template <typename Match>
+double outlineShare(BitmapScopedReadAccess& rAccess, const tools::Rectangle& rRect, Match rMatch)
+{
+    const tools::Long nW = rAccess->Width(), nH = rAccess->Height();
+    auto hit = [&](tools::Long x, tools::Long y, bool bHorizontalEdge) {
+        for (tools::Long d = -1; d <= 1; ++d)
+        {
+            const tools::Long px = bHorizontalEdge ? x : x + d;
+            const tools::Long py = bHorizontalEdge ? y + d : y;
+            if (px >= 0 && py >= 0 && px < nW && py < nH && rMatch(rAccess->GetColor(py, px)))
+                return true;
+        }
+        return false;
+    };
+    int nSamples = 0, nHits = 0;
+    for (tools::Long x = rRect.Left() + 3; x <= rRect.Right() - 3; ++x)
+    {
+        nSamples += 2;
+        nHits += hit(x, rRect.Top(), true) + hit(x, rRect.Bottom(), true);
+    }
+    for (tools::Long y = rRect.Top() + 3; y <= rRect.Bottom() - 3; ++y)
+    {
+        nSamples += 2;
+        nHits += hit(rRect.Left(), y, false) + hit(rRect.Right(), y, false);
+    }
+    return nSamples ? double(nHits) / nSamples : 0.0;
+}
+
+/// Paints into the given device only while the shell treats the output as a tile: otherwise the
+/// draw view redirects the paint into the (hidden) edit window's buffer.
+struct TilePaintScope
+{
+    TilePaintScope() { comphelper::LibreOfficeKit::setActive(true); }
+    ~TilePaintScope() { comphelper::LibreOfficeKit::setActive(false); }
+};
+
+/// Every fly frame on the page: those the page holds (anchored to page or paragraph) and those
+/// anchored in frames below it, such as formulas sitting in a line of text (as-character) and
+/// pictures inside text frames.
+void collectFlys(const SwSortedObjs* pObjs, std::vector<const SwFlyFrame*>& rFlys);
+
+void collectFlysBelow(const SwFrame* pFrame, std::vector<const SwFlyFrame*>& rFlys)
+{
+    for (; pFrame; pFrame = pFrame->GetNext())
+    {
+        collectFlys(pFrame->GetDrawObjs(), rFlys);
+        if (pFrame->IsLayoutFrame())
+            collectFlysBelow(static_cast<const SwLayoutFrame*>(pFrame)->Lower(), rFlys);
+    }
+}
+
+void collectFlys(const SwSortedObjs* pObjs, std::vector<const SwFlyFrame*>& rFlys)
+{
+    if (!pObjs)
+        return;
+    for (const SwAnchoredObject* pObject : *pObjs)
+    {
+        const SwFlyFrame* pFly = pObject->DynCastFlyFrame();
+        if (!pFly || std::find(rFlys.begin(), rFlys.end(), pFly) != rFlys.end())
+            continue;
+        rFlys.push_back(pFly);
+        collectFlysBelow(pFly->Lower(), rFlys);
+    }
+}
+
+tools::Rectangle toPixels(const SwRect& rTwips, const SwRect& rPage)
+{
+    return tools::Rectangle(
+        tools::Long((rTwips.Left() - rPage.Left()) / TWIPS_PER_PIXEL + 0.5),
+        tools::Long((rTwips.Top() - rPage.Top()) / TWIPS_PER_PIXEL + 0.5),
+        tools::Long((rTwips.Right() - rPage.Left()) / TWIPS_PER_PIXEL + 0.5),
+        tools::Long((rTwips.Bottom() - rPage.Top()) / TWIPS_PER_PIXEL + 0.5));
+}
+
+/// Paints every page as the edit window does (boundaries on) and measures each fly frame's outline.
+std::vector<PaintedFly> paintFlys(SwDocShell& rDocShell, SwXTextDocument& rTextDoc)
+{
+    SwWrtShell* pWrtShell = rDocShell.GetWrtShell();
+    CPPUNIT_ASSERT(pWrtShell);
+    SwViewOption aOptions(*pWrtShell->GetViewOptions());
+    aOptions.SetShowBoundaries(true);
+    aOptions.SetSectionBoundaries(true);
+    aOptions.SetTextBoundaries(true);
+    pWrtShell->ApplyViewOptions(aOptions);
+    // The document frame of the test is hidden; the shell paints only for a shown edit window.
+    pWrtShell->GetWin()->Show();
+    // The colour Writer paints section and fly boundaries with.
+    Color aBoundary(
+        svtools::ColorConfig().GetColorValue(svtools::WRITERSECTIONBOUNDARIES).nColor);
+    if (aBoundary == COL_AUTO)
+        aBoundary = COL_LIGHTGRAY;
+
+    std::vector<PaintedFly> aFlys;
+    for (const SwFrame* pFrame = pWrtShell->GetLayout()->Lower(); pFrame; pFrame = pFrame->GetNext())
+    {
+        const auto* pPage = static_cast<const SwPageFrame*>(pFrame);
+        std::vector<const SwFlyFrame*> aPageFlys;
+        collectFlys(pPage->GetSortedObjs(), aPageFlys);
+        collectFlysBelow(pPage->Lower(), aPageFlys);
+        if (aPageFlys.empty())
+            continue;
+        const SwRect aPage(pPage->getFrameArea());
+        const int nWidth = int(aPage.Width() / TWIPS_PER_PIXEL);
+        const int nHeight = int(aPage.Height() / TWIPS_PER_PIXEL);
+        ScopedVclPtrInstance<VirtualDevice> pDevice(DeviceFormat::WITHOUT_ALPHA);
+        pDevice->SetBackground(Wallpaper(COL_WHITE));
+        pDevice->SetOutputSizePixel(Size(nWidth, nHeight));
+        pDevice->Erase();
+        {
+            TilePaintScope aScope;
+            rTextDoc.paintTile(*pDevice, nWidth, nHeight, aPage.Left(), aPage.Top(), aPage.Width(),
+                               aPage.Height());
+        }
+        pDevice->SetMapMode(MapMode(MapUnit::MapPixel));
+        const Bitmap aBitmap(pDevice->GetBitmap(Point(), Size(nWidth, nHeight)));
+        BitmapScopedReadAccess pAccess(aBitmap);
+        // The page was really painted: its text is there.
+        tools::Long nInk = 0;
+        for (tools::Long y = 0; y < pAccess->Height(); ++y)
+            for (tools::Long x = 0; x < pAccess->Width(); ++x)
+                nInk += isDark(pAccess->GetColor(y, x));
+        CPPUNIT_ASSERT_MESSAGE("page not painted", nInk > 100);
+
+        for (const SwFlyFrame* pFly : aPageFlys)
+        {
+            if (!pFly->Lower())
+                continue;
+            FlyKind eKind = FlyKind::Text;
+            if (pFly->Lower()->IsNoTextFrame())
+            {
+                const SwContentNode* pNode
+                    = static_cast<const SwNoTextFrame*>(pFly->Lower())->GetNode();
+                eKind = pNode && pNode->GetOLENode() ? FlyKind::Formula : FlyKind::Picture;
+            }
+            SwRect aPrintArea(pFly->getFramePrintArea());
+            aPrintArea.Pos(aPrintArea.Pos() + pFly->getFrameArea().Pos());
+            aFlys.push_back(
+                { eKind, pFly->GetFormat()->GetName().toString(),
+                  outlineShare(pAccess, toPixels(aPrintArea, aPage),
+                               [&](const Color& c) { return isBoundaryColour(c, aBoundary); }),
+                  outlineShare(pAccess, toPixels(pFly->getFrameArea(), aPage), isDark) });
+        }
+    }
+    return aFlys;
+}
+
+void assertNoBoundaryOnObjects(const std::vector<PaintedFly>& rFlys, int nMinFormulas)
+{
+    int nFormulas = 0;
+    for (const PaintedFly& rFly : rFlys)
+    {
+        if (rFly.eKind == FlyKind::Text)
+            continue;
+        nFormulas += rFly.eKind == FlyKind::Formula;
+        // Before, Writer outlined every formula and picture with a grey 1-pixel line on screen
+        // (not in print or PDF); Word shows none, and MathType formulas in running text looked
+        // boxed.
+        CPPUNIT_ASSERT_MESSAGE(OString("boundary line around " + rFly.aName.toUtf8() + ", share "
+                                       + OString::number(rFly.fBoundary))
+                                   .getStr(),
+                               rFly.fBoundary < 0.3);
+    }
+    CPPUNIT_ASSERT_GREATEREQUAL(nMinFormulas, nFormulas);
+}
+
+const PaintedFly& findFly(const std::vector<PaintedFly>& rFlys, const OUString& rName)
+{
+    for (const PaintedFly& rFly : rFlys)
+        if (rFly.aName == rName)
+            return rFly;
+    CPPUNIT_FAIL(OString("no fly frame " + rName.toUtf8()).getStr());
+    return rFlys.front();
+}
+}
