+/// Whether a sibling of rWindow (a child of the same group) has the .ui id aId
+bool hasSibling(const vcl::Window& rWindow, std::u16string_view aId)
+{
+    const vcl::Window* pParent = rWindow.GetParent();
+    for (const vcl::Window* pChild = pParent ? pParent->GetWindow(GetWindowType::FirstChild) : nullptr; pChild;
+         pChild = pChild->GetWindow(GetWindowType::Next))
+        if (hasId(*pChild, aId))
+            return true;
+    return false;
+}
