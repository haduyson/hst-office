+        { u"bxHstUXInsertText12", u"" }, { u"bxHstUXInsertText16", u"" }, { u"bxHstUXInsertText13", u"" },
+    };
+    return std::any_of(std::begin(aNamed), std::end(aNamed), [&rWindow](const Named& rNamed) {
