+/// Whether rWindow has the .ui id aId; a menu button's id ("btnX:Menu Y") is compared without its menu
+bool hasId(const vcl::Window& rWindow, std::u16string_view aId)
+{
+    auto strip = [](std::u16string_view a) { return a.substr(0, std::min(a.size(), a.find(u':'))); };
+    const OUString& rOwn = rWindow.get_id();
+    return strip(std::u16string_view(rOwn)) == strip(aId);
+}
