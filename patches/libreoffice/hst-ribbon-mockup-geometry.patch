+/// The caption of a folded group on one line, or on two split at the space that makes the wider one the
+/// narrowest when one line is wider than FOLDED_LABEL_MAX
+std::pair<OUString, OUString> foldedLines(const OutputDevice& rDev, const OUString& rCaption)
+{
+    const tools::Long nMax = geometry::px(geometry::FOLDED_LABEL_MAX, rDev.GetDPIScaleFactor());
+    if (rDev.GetTextWidth(rCaption) <= nMax)
+        return { rCaption, OUString() };
+    sal_Int32 nBest = -1;
+    tools::Long nBestWidth = 0;
+    for (sal_Int32 i = rCaption.indexOf(' '); i > 0; i = rCaption.indexOf(' ', i + 1))
+    {
+        const tools::Long nWidth
+            = std::max(rDev.GetTextWidth(rCaption.copy(0, i)), rDev.GetTextWidth(rCaption.copy(i + 1)));
+        if (nBest < 0 || nWidth < nBestWidth)
+        {
+            nBest = i;
+            nBestWidth = nWidth;
+        }
+    }
+    if (nBest < 0)
+        return { rCaption, OUString() };
+    return { rCaption.copy(0, nBest), rCaption.copy(nBest + 1) };
+}
+
+geometry::FoldedButton foldedGeometry(const OutputDevice& rDev, const std::pair<OUString, OUString>& rLines,
+                                      const Image& rImage)
+{
+    const tools::Long nFirst = rDev.GetTextWidth(rLines.first);
+    const tools::Long nSecond = rLines.second.isEmpty() ? 0 : rDev.GetTextWidth(rLines.second);
+    return geometry::foldedButton(rImage.GetSizePixel().Width(), std::max(nFirst, nSecond),
+                                  rLines.second.isEmpty() ? nFirst : nSecond, rLines.second.isEmpty() ? 1 : 2,
+                                  rDev.GetTextHeight(), rDev.GetDPIScaleFactor());
+}
+}
+
+Size FoldedButtonSize(const OutputDevice& rDev, const OUString& rCaption, const Image& rImage)
+{
+    const geometry::FoldedButton aButton = foldedGeometry(rDev, foldedLines(rDev, rCaption), rImage);
+    return Size(aButton.width, aButton.height);
+}
+
+void DrawFoldedButton(vcl::RenderContext& rDev, const tools::Rectangle& rRect, const OUString& rCaption,
+                      const Image& rImage, sal_uInt16 nHighlight, bool bEnabled)
+{
+    const StyleSettings& rStyle = rDev.GetSettings().GetStyleSettings();
+    const std::pair<OUString, OUString> aLines = foldedLines(rDev, rCaption);
+    const geometry::FoldedButton aButton = foldedGeometry(rDev, aLines, rImage);
+    if (!DrawToolButton(rDev, rRect, nHighlight, false, bEnabled) && nHighlight != 0 && bEnabled)
+    {
+        // high contrast: the hovered or pressed button outlined in the text colour
+        rDev.Push(vcl::PushFlags::LINECOLOR | vcl::PushFlags::FILLCOLOR);
+        rDev.SetLineColor(rStyle.GetButtonTextColor());
+        rDev.SetFillColor();
+        rDev.DrawRect(rRect);
+        rDev.Pop();
+    }
+    // the parts from the bottom up, so that a taller button keeps its name on the caption line
+    const tools::Long nTop = rRect.Bottom() + 1 - aButton.height;
+    if (rImage.GetSizePixel().Width() > 0)
+    {
+        const Point aImage(rRect.Left() + (rRect.GetWidth() - rImage.GetSizePixel().Width()) / 2,
+                           std::max(rRect.Top(), nTop) + aButton.iconY);
+        rDev.DrawImage(aImage, rImage, bEnabled ? DrawImageFlags::NONE : DrawImageFlags::Disable);
+    }
+    rDev.Push(vcl::PushFlags::TEXTCOLOR | vcl::PushFlags::LINECOLOR | vcl::PushFlags::FILLCOLOR);
+    const Color aText = bEnabled ? rStyle.GetButtonTextColor() : rStyle.GetDisableColor();
+    rDev.SetTextColor(aText);
+    const OUString aText2[2] = { aLines.first, aLines.second };
+    const int nLines = aLines.second.isEmpty() ? 1 : 2;
+    for (int nLine = 0; nLine < nLines; ++nLine)
+    {
+        const bool bLast = nLine == nLines - 1;
+        const tools::Long nWidth = rDev.GetTextWidth(aText2[nLine]);
+        const tools::Long nBlock = nWidth + (bLast ? aButton.arrowWidth : 0);
+        const tools::Long nX = rRect.Left() + (rRect.GetWidth() - nBlock) / 2;
+        const tools::Long nY = nTop + aButton.textY + nLine * aButton.linePitch;
+        rDev.DrawText(Point(nX, nY), aText2[nLine]);
+        if (!bLast)
+            continue;
+        // ▾: ARROW_WIDTH wide, ARROW_HEIGHT high, centred on the line
+        const double fScale = rDev.GetDPIScaleFactor();
+        const tools::Long nArrowW = geometry::px(geometry::ARROW_WIDTH, fScale);
+        const tools::Long nArrowH = geometry::px(geometry::ARROW_HEIGHT, fScale);
+        const tools::Long nAX = nX + nBlock - nArrowW;
+        const tools::Long nAY = nY + (aButton.linePitch - nArrowH) / 2;
+        tools::Polygon aArrow(3);
+        aArrow.SetPoint(Point(nAX, nAY), 0);
+        aArrow.SetPoint(Point(nAX + nArrowW, nAY), 1);
+        aArrow.SetPoint(Point(nAX + nArrowW / 2, nAY + nArrowH), 2);
+        rDev.SetLineColor();
+        rDev.SetFillColor(aText);
+        rDev.DrawPolygon(aArrow);
+    }
+    rDev.Pop();
+}
 
