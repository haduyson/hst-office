+{
+constexpr long CONTENT = 76; // a group's content: one large button, or three rows of 24 with 2 between them
+constexpr long GROUP_PADDING = 4; // around a group's content, left, right, top and bottom
+constexpr long CAPTION_ROW = 18; // the group's caption band, under the content
+constexpr long CAPTION_GAP = 4; // between the content and the caption band
+constexpr long COLUMN_GAP = 2; // between the columns of a group
+constexpr long SEPARATOR = 1; // the line between two groups
+constexpr long SEPARATOR_INSET = 6; // between the separator and the top or bottom of the ribbon body
+constexpr long LAUNCHER = 15; // the dialog launcher, at the right end of the caption band
+constexpr long LAUNCHER_ROOM = 18; // the caption keeps this much room for the launcher on its right
+
+constexpr long LARGE_ICON = 24; // a large button's icon (lc_), centred in a 32 px slot
+constexpr long LARGE_ICON_SLOT = 32; // a larger icon (Paste's 32 px) fills the slot
+constexpr long LARGE_SLOT_TOP = 6; // the slot's top: 1 px border and 5 px padding
+constexpr long LARGE_MIN_WIDTH = 42;
+constexpr long LARGE_LABEL_PAD = 4; // left and right of the label: 1 px border and 3 px padding
+constexpr long LARGE_BOTTOM_PAD = 4; // under the label's last line (the frame VCL's PushButton keeps inside)
+constexpr long LABEL_MAX = 72; // a one-line label wider than this wraps even when it is short
+constexpr int SHORT_LABEL = 7; // characters: a label this short stays on one line (the mockup's twoLines)
+
+constexpr long ARROW_GAP = 3; // between a label and its ▾
+constexpr long ARROW_WIDTH = 7;
+constexpr long ARROW_HEIGHT = 4;
+
+constexpr long SMALL_ROW = 24; // a medium or small button's height, one row of the 3-row grid
+constexpr long SMALL_ROW_GAP = 2;
+constexpr long SMALL_PAD = 4; // left and right of a medium button's icon and label
+constexpr long SMALL_ICON_GAP = 5; // between a medium button's icon and its label
+constexpr long SMALL_ICON_ONLY = 24; // a small button: its icon only, at the same (4, 4) as a medium button's
+constexpr long SMALL_SPLIT = 12; // the ▾ part of a medium or small split button
+
+constexpr long FOLDED_HEIGHT = 98; // a folded group's button: the content, the gap and the caption band
+constexpr long FOLDED_MIN_WIDTH = 48;
+constexpr long FOLDED_PAD = 6; // above the icon, left and right of the label
+constexpr long FOLDED_LABEL_MAX = 84; // the folded group's name wraps over this width
+constexpr long FOLDED_LABEL_BOTTOM = 4; // under the name's last line: the name sits on the caption line
+constexpr long FOLDED_ARROW_GAP = 4;
+
+/** nLogical logical px in device px at fScale (GetDPIScaleFactor()), rounded once. */
+inline long px(long nLogical, double fScale) { return std::lround(nLogical * fScale); }
+
+/** The words of a large button's label that stay on its first line, as the mockup's twoLines(): all of them
+    for one word or a label of SHORT_LABEL characters at most (unless that one line is wider than LABEL_MAX:
+    bTooWide); else the split that makes the longer line, counted in characters, the shortest (the first such
+    split). rWordLengths: the characters of each word, the words split at single spaces. */
+inline std::size_t firstLineWords(const std::vector<int>& rWordLengths, bool bTooWide = false)
+{
+    const std::size_t nWords = rWordLengths.size();
+    if (nWords < 2)
+        return nWords;
+    int nTotal = static_cast<int>(nWords) - 1; // the spaces
+    for (int nLength : rWordLengths)
+        nTotal += nLength;
+    if (nTotal <= SHORT_LABEL && !bTooWide)
+        return nWords;
+    std::size_t nBest = 1;
+    int nBestLonger = nTotal + 1;
+    int nFirst = -1; // characters of the first line, its spaces included
+    for (std::size_t i = 1; i < nWords; ++i)
+    {
+        nFirst += rWordLengths[i - 1] + 1;
+        const int nLonger = std::max(nFirst, nTotal - nFirst - 1);
+        if (nLonger < nBestLonger)
+        {
+            nBest = i;
+            nBestLonger = nLonger;
+        }
+    }
+    return nBest;
+}
+
+/** Where a large button (L) draws its parts, from its top left corner, in device px. */
+struct LargeButton
+{
+    long width = 0;
+    long height = 0;
+    long iconY = 0; // the icon is centred horizontally
+    long textY = 0; // top of the label's first line; the lines are centred horizontally
+    long linePitch = 0; // from one line of the label to the next
+    long arrowWidth = 0; // ▾ after the second line (alone on it after a one-line label), 0 without a menu
+};
+
+/** The gap between a button's image and its label: the one VCL's PushButton leaves (button.cxx, nImageSep), so
+    that the large tool buttons and the large menu buttons (Select ▾) put their labels on the same line. */
+inline long imageTextGap(long nTextHeight) { return std::max(1L, 1 + (nTextHeight - 10) / 2); }
+
+/** A large button: nIcon px icon, label lines nLine1 and nLine2 px wide (nLine2 0 for a one-line label) in a
+    font nTextHeight px high; bMenu: ▾ ends the second line. It is CONTENT high, so every large button of the
+    ribbon puts its icon and its label's first line at the same height whatever its label. The icon moves up
+    from its slot when a font taller than the mockup's would push a second line under LARGE_BOTTOM_PAD. */
+inline LargeButton largeButton(long nIcon, long nLine1, long nLine2, bool bMenu, long nTextHeight, double fScale)
+{
+    LargeButton aButton;
+    aButton.arrowWidth = bMenu ? px(ARROW_WIDTH, fScale) + (nLine2 > 0 ? px(ARROW_GAP, fScale) : 0) : 0;
+    const long nLabel = std::max(nLine1, nLine2 + aButton.arrowWidth);
+    aButton.width = std::max({ px(LARGE_MIN_WIDTH, fScale), nLabel + 2 * px(LARGE_LABEL_PAD, fScale),
+                               nIcon + 2 * px(LARGE_LABEL_PAD, fScale) });
+    aButton.height = px(CONTENT, fScale);
+    // the label's line comes from a LARGE_ICON icon whatever the icon's size (the mockup's label starts under the
+    // slot), so Paste's 32 px icon does not push its label under the others; a larger icon shares the centre
+    const long nNominal = px(LARGE_ICON, fScale);
+    const long nRoom = aButton.height - px(LARGE_BOTTOM_PAD, fScale) - 2 * nTextHeight - imageTextGap(nTextHeight) - nNominal;
+    const long nNominalY = std::max(
+        0L, std::min(px(LARGE_SLOT_TOP, fScale) + std::max(0L, px(LARGE_ICON_SLOT, fScale) - nNominal) / 2, nRoom));
+    aButton.iconY = std::max(0L, nNominalY - (nIcon - nNominal) / 2);
+    aButton.textY = nNominalY + nNominal + imageTextGap(nTextHeight);
+    aButton.linePitch = nTextHeight;
+    return aButton;
+}
+
+/** A medium button (icon and label, nText > 0) or a small one (icon only, nText 0), one row of the grid high;
+    bSplit: its ▾ part follows. The icon is SMALL_PAD from the left in both, so the icons of a column and of a row
+    line up whether a button has a label, ▾ or neither. */
+inline long smallButtonWidth(long nIcon, long nText, bool bSplit, double fScale)
+{
+    const long nMain = nText > 0
+                           ? 2 * px(SMALL_PAD, fScale) + nIcon + px(SMALL_ICON_GAP, fScale) + nText
+                           : std::max(px(SMALL_ICON_ONLY, fScale), nIcon + 2 * px(SMALL_PAD, fScale));
+    return nMain + (bSplit ? px(SMALL_SPLIT, fScale) : 0);
+}
+
+/** The rows of a group of two rows of small buttons (the mockup's rows2, Font and Paragraph): spread evenly over
+    the content, (CONTENT - 2 rows) / 3 above, between and under them. Returns the gap above the first row; the
+    second row's gap over the row spacing is the same minus SMALL_ROW_GAP. */
+inline long twoRowGap(double fScale)
+{
+    return std::lround((CONTENT - 2 * SMALL_ROW) * fScale / 3.0);
+}
+
+/** Where a folded group's button (C, "Caption ▾") draws its parts, from its top left corner, in device px. */
+struct FoldedButton
+{
+    long width = 0;
+    long height = 0;
+    long iconY = 0; // the icon is centred horizontally
+    long textY = 0; // top of the name's first line; the lines are centred, ▾ after the last one
+    long linePitch = 0;
+    long arrowWidth = 0; // ▾ and the gap before it
+};
+
+/** A folded group's button: nIcon px icon, the group's name on nLines lines (one or two, each at most
+    FOLDED_LABEL_MAX wide; nWidest px the widest of them, nLast px the last one) in a font nTextHeight px high.
+    The name's last line ends FOLDED_LABEL_BOTTOM px over the button's bottom: on the groups' caption line. */
+inline FoldedButton foldedButton(long nIcon, long nWidest, long nLast, int nLines, long nTextHeight, double fScale)
+{
+    FoldedButton aButton;
+    aButton.arrowWidth = px(FOLDED_ARROW_GAP, fScale) + px(ARROW_WIDTH, fScale);
+    const long nLabel = std::max(nWidest, nLast + aButton.arrowWidth);
+    aButton.width = std::max({ px(FOLDED_MIN_WIDTH, fScale), nLabel + 2 * px(FOLDED_PAD, fScale),
+                               nIcon + 2 * px(FOLDED_PAD, fScale) });
+    aButton.height = px(FOLDED_HEIGHT, fScale);
+    aButton.iconY = px(FOLDED_PAD, fScale);
+    aButton.linePitch = nTextHeight;
+    aButton.textY = aButton.height - px(FOLDED_LABEL_BOTTOM, fScale) - std::max(1, nLines) * nTextHeight;
+    return aButton;
+}
+}
