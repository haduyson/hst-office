+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/* SPDX-License-Identifier: LicenseRef-HST-Proprietary */
+
+#include <hstpagecount.hxx>
+
+#include <pagefrm.hxx>
+#include <rootfrm.hxx>
+
+sal_uInt32 HstPageCount(const SwRootFrame& rRoot)
+{
+    sal_uInt32 nCount = 0;
+    for (const SwFrame* pPage = rRoot.Lower(); pPage; pPage = pPage->GetNext())
+        ++nCount;
+    return nCount;
+}
+
+sal_uInt32 HstPhyPageNum(const SwPageFrame& rPage)
+{
+    sal_uInt32 nNum = 1;
+    for (const SwFrame* pPage = rPage.GetPrev(); pPage; pPage = pPage->GetPrev())
+        ++nNum;
+    return nNum;
+}
+
+sal_uInt32 HstVirtPageNum(const SwPageFrame& rPage)
+{
+    // The stored virtual and physical numbers wrap alike, so their 16-bit difference is the
+    // numbering offset as long as it is smaller than 32768 pages.
+    const sal_Int16 nOffset = static_cast<sal_Int16>(
+        static_cast<sal_uInt16>(rPage.GetVirtPageNum() - rPage.GetPhyPageNum()));
+    const sal_Int64 nVirt = sal_Int64(HstPhyPageNum(rPage)) + nOffset;
+    return nVirt > 0 ? sal_uInt32(nVirt) : 1;
+}
