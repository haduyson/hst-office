+CPPUNIT_TEST_FIXTURE(Test, testPageCountAbove65535Pages)
+{
+    // The layout keeps page numbers in 16 bits. A document with more pages must still show its
+    // real page count and page numbers.
+    createSwDoc();
+    SwDoc* pDoc = getSwDoc();
+    SwRootFrame* pLayout = pDoc->getIDocumentLayoutAccess().GetCurrentLayout();
+    SwPageFrame* pFirst = static_cast<SwPageFrame*>(pLayout->Lower());
+    const sal_uInt32 nPages = 0x10000 + 11;
+    // page positions are not needed here (the lock is never released: no 65,000-page view layout)
+    pLayout->LockViewLayout();
+    pLayout->SetHstEstimatedPageInsert(true); // append behind the last page
+    pLayout->SetLargeTextPagination(); // a new page formats itself from the last formatted page
+    for (sal_uInt32 i = 1; i < nPages; ++i)
+    {
+        SwPageFrame* pPage
+            = new SwPageFrame(&pFirst->GetPageDesc()->GetMaster(), pLayout, pFirst->GetPageDesc());
+        pPage->Paste(pLayout, nullptr);
+    }
+    pLayout->SetHstEstimatedPageInsert(false);
+
+    const SwPageFrame* pLast = pLayout->GetLastPage();
+    // the stored values have wrapped
+    CPPUNIT_ASSERT_EQUAL(sal_uInt16(11), pLayout->GetPageNum());
+    CPPUNIT_ASSERT_EQUAL(sal_uInt16(11), pLast->GetPhyPageNum());
+    CPPUNIT_ASSERT_EQUAL(nPages, HstPageCount(*pLayout));
+    CPPUNIT_ASSERT_EQUAL(nPages, HstPhyPageNum(*pLast));
+    CPPUNIT_ASSERT_EQUAL(nPages, HstVirtPageNum(*pLast));
+
+    // statistics: Tools - Word Count, File - Properties and the PageCount field
+    pDoc->getIDocumentStatistics().DocInfoChgd(false);
+    CPPUNIT_ASSERT_EQUAL(nPages, pDoc->getIDocumentStatistics().GetUpdatedDocStat(false, false).nPage);
+}
