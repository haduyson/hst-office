+CPPUNIT_TEST_FIXTURE(SwCoreTxtnodeTest, testHstNoFillParagraphsShareFillAttributes)
+{
+    // Two paragraphs without fill and a third with a solid fill.
+    createSwDoc();
+    SwWrtShell* pWrtShell = getSwDocShell()->GetWrtShell();
+    pWrtShell->Insert(u"a"_ustr);
+    pWrtShell->SplitNode();
+    pWrtShell->Insert(u"b"_ustr);
+    pWrtShell->SplitNode();
+    pWrtShell->Insert(u"c"_ustr);
+    uno::Reference<beans::XPropertySet> xThird(getParagraph(3), uno::UNO_QUERY);
+    xThird->setPropertyValue(u"FillStyle"_ustr, uno::Any(drawing::FillStyle_SOLID));
+    xThird->setPropertyValue(u"FillColor"_ustr, uno::Any(Color(0xFF0000)));
+
+    SwNodeOffset nFirst = pWrtShell->GetCursor()->GetPoint()->GetNodeIndex() - SwNodeOffset(2);
+    SwNodes& rNodes = getSwDoc()->GetNodes();
+    auto pA = rNodes[nFirst]->GetTextNode()->getSdrAllFillAttributesHelper();
+    auto pB = rNodes[nFirst + SwNodeOffset(1)]->GetTextNode()->getSdrAllFillAttributesHelper();
+    auto pC = rNodes[nFirst + SwNodeOffset(2)]->GetTextNode()->getSdrAllFillAttributesHelper();
+    CPPUNIT_ASSERT(pA && pB && pC);
+    // Without the accompanying change, every paragraph had a helper of its own.
+    CPPUNIT_ASSERT_EQUAL(pA.get(), pB.get());
+    CPPUNIT_ASSERT(!pA->isUsed());
+    CPPUNIT_ASSERT(pC.get() != pA.get());
+    CPPUNIT_ASSERT(pC->isUsed());
+
+    // Giving the second paragraph a fill gives it a helper of its own, the first keeps no fill.
+    uno::Reference<beans::XPropertySet> xSecond(getParagraph(2), uno::UNO_QUERY);
+    xSecond->setPropertyValue(u"FillStyle"_ustr, uno::Any(drawing::FillStyle_SOLID));
+    xSecond->setPropertyValue(u"FillColor"_ustr, uno::Any(Color(0x00FF00)));
+    pB = rNodes[nFirst + SwNodeOffset(1)]->GetTextNode()->getSdrAllFillAttributesHelper();
+    CPPUNIT_ASSERT(pB->isUsed());
+    CPPUNIT_ASSERT(!rNodes[nFirst]->GetTextNode()->getSdrAllFillAttributesHelper()->isUsed());
+}
+
 CPPUNIT_PLUGIN_IMPLEMENT();
 
