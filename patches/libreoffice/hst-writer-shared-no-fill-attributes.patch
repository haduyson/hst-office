+++ b/sw/source/core/txtnode/hstnofillattributes.cxx
@@ -0,0 +1,30 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/* SPDX-License-Identifier: LicenseRef-HST-Proprietary */
+
+#include <hstnofillattributes.hxx>
+
+#include <com/sun/star/drawing/FillStyle.hpp>
+#include <svl/itemset.hxx>
+#include <svx/xdef.hxx>
+#include <svx/xfillit0.hxx>
+#include <svx/xfilluseslidebackgrounditem.hxx>
+#include <svx/xflftrit.hxx>
+
+#include <memory>
+
+drawinglayer::attribute::SdrAllFillAttributesHelperPtr HstSharedNoFillAttributes(const SfxItemSet& rSet)
+{
+    // The helper built from rSet depends only on these items: with no fill style, no slide background
+    // and no enabled float transparency it holds the default fill and the default gradient.
+    if (rSet.Get(XATTR_FILLSTYLE).GetValue() != css::drawing::FillStyle_NONE
+        || rSet.Get(XATTR_FILLUSESLIDEBACKGROUND).GetValue())
+        return {};
+    if (const XFillFloatTransparenceItem* pItem = rSet.GetItemIfSet(XATTR_FILLFLOATTRANSPARENCE);
+        pItem && pItem->IsEnabled())
+        return {};
+    static const drawinglayer::attribute::SdrAllFillAttributesHelperPtr s_pNoFill
+        = std::make_shared<drawinglayer::attribute::SdrAllFillAttributesHelper>(rSet);
+    return s_pNoFill;
+}
