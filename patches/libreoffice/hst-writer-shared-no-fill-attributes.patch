+class SfxItemSet;
+
+/// HST: the fill attributes of a paragraph without fill (no fill style, no slide background, no
+/// float transparency) are the same for every such paragraph: one shared helper instead of one per
+/// paragraph (about 0.4 KB each, created for every paragraph the layout formats). nullptr when
+/// rSet has a fill.
+drawinglayer::attribute::SdrAllFillAttributesHelperPtr HstSharedNoFillAttributes(const SfxItemSet& rSet);
+
