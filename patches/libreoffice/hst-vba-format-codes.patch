Subject: [PATCH] VBA: Format reads n/nn as minutes, q as the quarter, @ as a character placeholder

Found by running the same macros in the reference office suite and in HST Office on a Windows test PC
(Option VBASupport 1 only):
* Format(d, "yyyy-mm-dd hh:nn:ss") gave "2024-03-05 09:Tue:03": the number formatter reads N as the day of the
  week. n/nn are VBA's minute codes; they are passed on as M, which the formatter takes as minutes next to an
  hour or second code. Quoted text, [...] and \-escaped characters are kept.
* Format(d, "q") gave "Q1"; VBA gives the quarter number.
* Format("ab", "@@@@") gave "abababab"; VBA fills the placeholders from the right: "  ab" ("ab  " with "!").
* Format(Null) gave "null"; VBA gives an empty string.
---
--- a/basic/source/sbx/sbxscan.cxx
+++ b/basic/source/sbx/sbxscan.cxx
@@ -19,6 +19,7 @@
 
 #include <sal/config.h>
 
+#include <algorithm>
 #include <cstdlib>
 #include <optional>
 #include <string_view>
@@ -47,6 +48,7 @@
 
 #include <rtl/character.hxx>
 #include <rtl/math.hxx>
+#include <rtl/ustrbuf.hxx>
 #include <svl/numformat.hxx>
 #include <svl/zforlist.hxx>
 #include <o3tl/temporary.hxx>
@@ -498,9 +500,55 @@
     }
 }
 
+// HST: VBA's string placeholders: each @ is one character, filled from the right and padded with spaces (from the
+// left after a leading !); & is a character without padding. The number formatter repeated the text for each @.
+bool vbaPlaceholders(const OUString& rStr, OUString& rRes, std::u16string_view aFmt)
+{
+    const bool bLeft = !aFmt.empty() && aFmt[0] == '!';
+    if (bLeft)
+        aFmt = aFmt.substr(1);
+    if (aFmt.empty() || aFmt.find_first_not_of(u"@&") != std::u16string_view::npos)
+        return false;
+    const sal_Int32 nPad = std::count(aFmt.begin(), aFmt.end(), u'@') - rStr.getLength();
+    const OUString aSpaces = nPad > 0 ? OUString(OUString::Concat(RepeatedUChar(' ', nPad))) : OUString();
+    rRes = bLeft ? rStr + aSpaces : aSpaces + rStr;
+    return true;
+}
+
+// HST: n and nn are VBA's minute codes; the number formatter reads N as the day of the week ("09:Tue:03" for
+// "hh:nn:ss"). Outside quoted text, [...] and \-escaped characters they become M, which the formatter takes as
+// minutes next to an hour or a second code.
+OUString vbaMinuteCodes(const OUString& rFmt)
+{
+    OUStringBuffer aBuf(rFmt.getLength());
+    bool bQuoted = false;
+    sal_Int32 nBracket = 0;
+    for (sal_Int32 i = 0; i < rFmt.getLength(); ++i)
+    {
+        sal_Unicode c = rFmt[i];
+        if (c == '"')
+            bQuoted = !bQuoted;
+        else if (!bQuoted && c == '\\' && i + 1 < rFmt.getLength())
+        {
+            aBuf.append(OUStringChar(c) + OUStringChar(rFmt[++i]));
+            continue;
+        }
+        else if (!bQuoted && c == '[')
+            ++nBracket;
+        else if (!bQuoted && c == ']' && nBracket)
+            --nBracket;
+        else if (!bQuoted && !nBracket && (c == 'n' || c == 'N'))
+            c = 'M';
+        aBuf.append(c);
+    }
+    return aBuf.makeStringAndClear();
+}
+
 void printfmtstr(const OUString& rStr, OUString& rRes, const OUString& rFmt)
 {
     rRes = rStr;
+    if (SbiRuntime::isVBAEnabled() && vbaPlaceholders(rStr, rRes, rFmt))
+        return;
 
     switch (rFmt.isEmpty() ? '&' : rFmt[0])
     {
@@ -552,7 +600,11 @@
     const SbxDataType eType = GetType();
     if (eType == SbxNULL)
     {
-        rRes = SbxBasicFormater::BasicFormatNull(pFmt ? *pFmt : std::u16string_view{});
+        // HST: VBA's Format(Null) is an empty string; Basic wrote "null"
+        if (SbiRuntime::isVBAEnabled() && (!pFmt || pFmt->indexOf(';') < 0))
+            rRes.clear();
+        else
+            rRes = SbxBasicFormater::BasicFormatNull(pFmt ? *pFmt : std::u16string_view{});
         return;
     }
 
@@ -647,6 +699,10 @@
             rRes = OUString::number(nMin);
         }
     }
+    else if (aFmtStr.equalsIgnoreAsciiCase("q") && SbiRuntime::isVBAEnabled()) // HST: VBA quarter number, not "Q1"
+    {
+        rRes = OUString::number((implGetDateMonth(*number) - 1) / 3 + 1);
+    }
     else if (aFmtStr.equalsIgnoreAsciiCase("w")) // VBA weekday number
     {
         rRes = OUString::number(implGetWeekDay(*number));
@@ -661,6 +717,8 @@
     }
     else
     {
+        if (SbiRuntime::isVBAEnabled())
+            aFmtStr = vbaMinuteCodes(aFmtStr);
         pFormatter->PutandConvertEntry( aFmtStr, nCheckPos, nType, nIndex, LANGUAGE_ENGLISH_US, eLangType, true);
         if (nType == SvNumFormatType::TEXT && IsString())
             pFormatter->GetOutputString(GetOUString(), nIndex, rRes, &pCol);
