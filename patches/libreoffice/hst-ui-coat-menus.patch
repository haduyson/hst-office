+
+void CoatMenuWindowFrame(vcl::Window& rMenuWindow)
+{
+    vcl::Window* pBorder = rMenuWindow.GetWindow(GetWindowType::Border);
+    if (!pBorder || pBorder == &rMenuWindow || !MenuFrameCoated(*rMenuWindow.GetOutDev()))
+        return;
+    const Color aSurface = menuPalette(rMenuWindow.GetSettings().GetStyleSettings()).aMenuSurface;
+    AllSettings aSettings(pBorder->GetSettings());
+    StyleSettings aStyle(aSettings.GetStyleSettings());
+    // the colours VCL draws a menu's ring in (DecorationView, DrawFrameStyle::DoubleOut with the
+    // menu flag): the outer ring, and the inner one, drawn only without flat menus
+    if (aStyle.GetMenuBorderColor() == aSurface && aStyle.GetDarkShadowColor() == aSurface
+        && aStyle.GetLightColor() == aSurface && aStyle.GetShadowColor() == aSurface
+        && !aStyle.GetUseFlatMenus())
+        return; // nothing to change: no settings event
+    aStyle.SetMenuBorderColor(aSurface);
+    aStyle.SetDarkShadowColor(aSurface);
+    aStyle.SetLightColor(aSurface);
+    aStyle.SetShadowColor(aSurface);
+    aStyle.SetUseFlatMenus(false);
+    aSettings.SetStyleSettings(aStyle);
+    // No invalidation: this runs from the menu's ApplySettings, which VCL calls before every paint of
+    // the menu and which hands the theme's settings to the border window first; the border window
+    // paints with what is set here, and invalidating it would repaint the menu again and again.
+    pBorder->SetSettings(aSettings);
