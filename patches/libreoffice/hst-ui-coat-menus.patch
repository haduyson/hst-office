             return false;
     }
 }
+bool MenuFrameCoated(const OutputDevice&) { return false; }
+
+std::optional<Color> MenuShortcutColour(const OutputDevice&, bool, bool) { return std::nullopt; }
+
+void CoatMenuWindowFrame(vcl::Window&) {}
 }
 
