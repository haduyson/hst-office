+#include <vcl/dllapi.h>
+
+#include <optional>
+
+class OutputDevice;
+namespace vcl
+{
+class Window;
+}
+
+/* The frame's coat of popup and context menus that VCL draws itself (Windows; the GTK menus get it
+   from css/menus.cxx). Under the frame's switch FrameCoat/Menus, and only where the coat already
+   draws the menu's items (hst::coat::DrawNativeControl): never in high contrast, never with the
+   coat off. Nothing here changes a size: item heights, the menu's border widths and the text and
+   shortcut positions stay VCL's. */
+namespace hst::coat
+{
+/** Whether the frame's menu coat draws the popup menu shown on rDev. */
+VCL_DLLPUBLIC bool MenuFrameCoated(const OutputDevice& rDev);
+
+/** The colour of a menu item's shortcut text on rDev (right-aligned by VCL), or nothing to keep
+    the item text's colour: a disabled item keeps VCL's disabled colour, and on the highlighted
+    item the shortcut colour is used only where it stays readable (4.5:1) on the highlight. */
+VCL_DLLPUBLIC std::optional<Color> MenuShortcutColour(const OutputDevice& rDev, bool bHighlighted,
+                                                      bool bEnabled);
+
+/** The border window around a popup menu's window (rMenuWindow is the client): its ring, whose
+    width VCL keeps, takes the menu's surface colour, so the menu's outline is the rounded one the
+    coat draws at the edge of the content. A no-op where the menu is not coated. */
+VCL_DLLPUBLIC void CoatMenuWindowFrame(vcl::Window& rMenuWindow);
+}
