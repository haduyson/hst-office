+// HST Office: the "re-open" pass of the ribbon collapse ladder (HstRibbonScaling.hxx).
+// Plain integer arithmetic, unit tested on its own (tests/unit/test_ribbon_regrow.py).
+//
+// select() walks the ladder and stops at the first step that makes the row fit; that step can free far
+// more than was missing (a large group turned into its "Caption ▾" button), so groups stayed buttons
+// beside free room, even in a 1920 px window. fitByPriority() lays the row out again from the groups'
+// priority (most used first):
+//   1. as few groups as possible become their button, least used first: the k least used groups
+//      (k as small as possible) collapse when the row does not fit with every other group at its
+//      smallest shown state. The collapsed groups at a width are therefore always the least used ones,
+//      and a wider window never collapses a group that a narrower one shows (monotonic);
+//   2. the shown groups then grow, most used first, into the largest state that still fits.
+// A row that does not fit even with every collapsible group collapsed is left to select() and its
+// overflow popup.
+
+#include "HstRibbonScaling.hxx"
+
+#include <cstddef>
+#include <vector>
+
+namespace hst::ribbon
+{
+/// The state of a group shown as its "Caption ▾" button (GroupCollapsed in HstRibbonLadder.hxx).
+constexpr std::size_t RegrowCollapsedState = 3;
+
+/// Priority order of a ladder: the reverse of its fold order (rFold lists the least used group
+/// first); groups missing from rFold come after, left to right.
+inline std::vector<std::size_t> priorityFromFold(std::size_t nGroups, const std::vector<std::size_t>& rFold)
+{
+    std::vector<std::size_t> aOrder;
+    std::vector<bool> aSeen(nGroups, false);
+    for (auto it = rFold.rbegin(); it != rFold.rend(); ++it)
+        if (*it < nGroups && !aSeen[*it])
+        {
+            aSeen[*it] = true;
+            aOrder.push_back(*it);
+        }
+    for (std::size_t i = 0; i < nGroups; ++i)
+        if (!aSeen[i])
+            aOrder.push_back(i);
+    return aOrder;
+}
+
+/// The shown state (not the button) in which rGroup is narrowest; the larger state on a tie.
+inline std::size_t smallestShownState(const Group& rGroup)
+{
+    std::size_t nBest = 0;
+    const std::size_t nShown = rGroup.widths.size() < RegrowCollapsedState ? rGroup.widths.size() : RegrowCollapsedState;
+    for (std::size_t nState = 1; nState < nShown; ++nState)
+        if (widthOf(rGroup, nState) < widthOf(rGroup, nBest))
+            nBest = nState;
+    return nBest;
+}
+
+/// The layout for nAvailable from the groups' priority (rPriority: group indexes, most used first);
+/// fits is false when the row does not fit even with every collapsible group collapsed.
+inline Layout fitByPriority(const std::vector<Group>& rGroups, const std::vector<std::size_t>& rPriority,
+                            long nAvailable)
+{
+    Layout aLayout;
+    aLayout.states.assign(rGroups.size(), 0);
+    for (std::size_t i = 0; i < rGroups.size(); ++i)
+        aLayout.states[i] = smallestShownState(rGroups[i]);
+    long nRow = rowWidth(rGroups, aLayout.states);
+    // 1. the least used groups become their buttons until the row fits at its smallest
+    for (auto it = rPriority.rbegin(); it != rPriority.rend() && nRow > nAvailable; ++it)
+    {
+        if (*it >= rGroups.size() || rGroups[*it].widths.size() <= RegrowCollapsedState)
+            continue; // a group without a button state stays shown
+        const Group& rGroup = rGroups[*it];
+        if (widthOf(rGroup, RegrowCollapsedState) >= widthOf(rGroup, aLayout.states[*it]))
+            continue; // its button would save nothing
+        nRow += widthOf(rGroup, RegrowCollapsedState) - widthOf(rGroup, aLayout.states[*it]);
+        aLayout.states[*it] = RegrowCollapsedState;
+    }
+    if (nRow > nAvailable)
+    {
+        aLayout.width = nRow;
+        aLayout.fits = false;
+        return aLayout;
+    }
+    // 2. the shown groups grow back, most used first
+    for (std::size_t nGroup : rPriority)
+    {
+        if (nGroup >= rGroups.size() || aLayout.states[nGroup] == RegrowCollapsedState)
+            continue;
+        const Group& rGroup = rGroups[nGroup];
+        const std::size_t nCurrent = aLayout.states[nGroup];
+        for (std::size_t nState = 0; nState < nCurrent; ++nState)
+        {
+            const long nNext = nRow - widthOf(rGroup, nCurrent) + widthOf(rGroup, nState);
+            if (nNext <= nAvailable)
+            {
+                aLayout.states[nGroup] = nState;
+                nRow = nNext;
+                break;
+            }
+        }
+    }
+    aLayout.width = nRow;
+    aLayout.fits = true;
+    return aLayout;
+}
+}
