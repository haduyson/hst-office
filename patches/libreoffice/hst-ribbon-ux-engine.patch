+void NoteObjectCommand(std::u16string_view aCommandPath)
+{
+    // the commands that create an object and select it, and the shape tools, whose shape the mouse
+    // then draws
+    static constexpr std::u16string_view aObjectCommands[]
+        = { u"InsertGraphic", u"InsertTable", u"InsertObjectChart", u"InsertObject", u"InsertObjectStarMath",
+            u"InsertMath", u"InsertAVMedia", u"InsertFrame", u"InsertFrameInteract", u"InsertQrCode",
+            u"InsertSignatureLine", u"FontworkGalleryFloater", u"DataPilotExec", u"InsertPivotTable" };
+    static constexpr std::u16string_view aShapeTools[]
+        = { u"BasicShapes", u"ArrowShapes", u"FlowChartShapes", u"StarShapes", u"SymbolShapes",
+            u"CalloutShapes", u"Line", u"Rect", u"Ellipse" };
+    const std::u16string_view aName = aCommandPath.substr(0, aCommandPath.find(u'?'));
+    bool bObject = false;
+    for (std::u16string_view aCommand : aObjectCommands)
+        bObject = bObject || aName == aCommand;
+    for (std::u16string_view aTool : aShapeTools) // "BasicShapes" and "BasicShapes.rectangle"
+        bObject = bObject || aName == aTool
+                  || (aName.size() > aTool.size() && aName.starts_with(aTool) && aName[aTool.size()] == u'.');
+    if (!bObject)
+        return;
+    g_bHstInsertPending = true;
+    g_aHstInsertTime = std::chrono::steady_clock::now();
+}
