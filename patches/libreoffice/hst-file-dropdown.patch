+
+BackstageWindow* lcl_findBackstage(const uno::Reference<frame::XFrame>& rxFrame)
+{
+    for (const std::unique_ptr<BackstageWindow>& rPanel : lcl_panels())
+        if (rPanel->GetFrame() == rxFrame)
+            return rPanel.get();
     return nullptr;
 }
 
+void lcl_removeBackstage(const uno::Reference<frame::XFrame>& rxFrame)
+{
+    std::vector<std::unique_ptr<BackstageWindow>>& rPanels = lcl_panels();
+    auto it = std::find_if(rPanels.begin(), rPanels.end(),
+                           [&rxFrame](const std::unique_ptr<BackstageWindow>& rPanel)
+                           { return rPanel->GetFrame() == rxFrame; });
+    if (it == rPanels.end())
+        return;
+    // out of the list first: closing the panel may call back into this file
+    std::unique_ptr<BackstageWindow> xPanel(std::move(*it));
+    rPanels.erase(it);
+    xPanel.reset();
+}
+
+/// Removes the panel of a frame when the frame goes away, while its windows are still intact.
+class FrameDisposeListener final : public cppu::WeakImplHelper<lang::XEventListener>
+{
+public:
+    void SAL_CALL disposing(const lang::EventObject& rEvent) override
+    {
+        SolarMutexGuard aGuard;
+        lcl_removeBackstage(uno::Reference<frame::XFrame>(rEvent.Source, uno::UNO_QUERY));
+    }
+};
