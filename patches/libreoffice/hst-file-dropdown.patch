+/// A house outline in a square of nSize pixels, the icon of the Home item.
+void lcl_drawHouse(OutputDevice& rDev, const Point& rTopLeft, tools::Long nSize, const Color& rColor)
+{
+    const tools::Long x = rTopLeft.X(), y = rTopLeft.Y();
+    auto at = [&](double fX, double fY) {
+        return Point(x + static_cast<tools::Long>(fX * nSize), y + static_cast<tools::Long>(fY * nSize));
+    };
+    rDev.SetLineColor(rColor);
+    rDev.SetFillColor();
+    const Point aOutline[] = { at(0.06, 0.5), at(0.5, 0.1), at(0.94, 0.5) };
+    rDev.DrawPolyLine(tools::Polygon(3, aOutline));
+    const Point aBody[] = { at(0.2, 0.38), at(0.2, 0.92), at(0.8, 0.92), at(0.8, 0.38) };
+    rDev.DrawPolyLine(tools::Polygon(4, aBody));
+    rDev.DrawRect(tools::Rectangle(at(0.42, 0.62), at(0.58, 0.92)));
+}
