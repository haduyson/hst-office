+std::vector<BackstageTemplate> GetTemplateList(BackstageApp eApp)
+{
+    const FILTER_APPLICATION eFilter = eApp == BackstageApp::Writer    ? FILTER_APPLICATION::WRITER
+                                       : eApp == BackstageApp::Calc    ? FILTER_APPLICATION::CALC
+                                       : eApp == BackstageApp::Impress ? FILTER_APPLICATION::IMPRESS
+                                                                       : FILTER_APPLICATION::DRAW;
+    const ViewFilter_Application aFilter(eFilter);
+    std::vector<BackstageTemplate> aTemplates;
+    // the same source and folder order as the Templates dialog
+    SfxDocumentTemplates aDocTemplates;
+    for (sal_uInt16 nRegion = 0; nRegion < aDocTemplates.GetRegionCount(); ++nRegion)
+    {
+        const OUString aGroup = aDocTemplates.GetFullRegionName(nRegion);
+        for (sal_uInt16 nEntry = 0; nEntry < aDocTemplates.GetCount(nRegion); ++nEntry)
+        {
+            OUString aPath = aDocTemplates.GetPath(nRegion, nEntry);
+            if (!aFilter.isValid(aPath))
+                continue;
+            BackstageTemplate aTemplate{ aDocTemplates.GetName(nRegion, nEntry), std::move(aPath),
+                                         BackstageTemplate::Kind::Template };
+            aTemplate.aGroup = aGroup;
+            aTemplates.push_back(std::move(aTemplate));
+        }
+    }
+    return aTemplates;
+}
