+{
+    if (rId == u"navnew")
+        return u".uno:AddDirect"_ustr;
+    if (rId == u"navopen")
+        return u".uno:Open"_ustr;
+    if (rId == u"navinfo")
+        return u".uno:SetDocumentProperties"_ustr;
+    if (rId == u"navsave")
+        return u".uno:Save"_ustr;
+    if (rId == u"navsaveas")
+        return u".uno:SaveAs"_ustr;
+    if (rId == u"navprint")
+        return u".uno:Print"_ustr;
+    if (rId == u"navpdf")
+        return u".uno:ExportDirectToPDF"_ustr;
+    if (rId == u"navsign")
+        return u".uno:Signature"_ustr;
+    if (rId == u"navclose")
+        return u".uno:CloseDoc"_ustr;
+    if (rId == u"navabout")
+        return u".uno:About"_ustr;
+    if (rId == u"navoptions")
+        return u".uno:OptionsTreeDialog"_ustr;
+    return OUString();
