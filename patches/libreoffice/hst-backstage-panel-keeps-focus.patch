+/// The window of the frame's view (the document under the panel), none while the frame has no view.
+vcl::Window* lcl_viewWindow(const uno::Reference<frame::XFrame>& rxFrame)
+{
+    for (SfxViewFrame* pFrame = SfxViewFrame::GetFirst(); pFrame; pFrame = SfxViewFrame::GetNext(*pFrame))
+        if (pFrame->GetFrame().GetFrameInterface() == rxFrame)
+            return pFrame->GetViewShell() ? pFrame->GetViewShell()->GetWindow() : nullptr;
+    return nullptr;
+}
+}
+
 /* A press of a mouse button in the panel's window (the document, the ribbon and its tabs) but
    outside the panel and the File title band closes the panel, as the click outside a drop-down did. The window's title bar and frame are not
    VCL windows: moving, snapping and resizing the window keep the panel open. */
 IMPL_LINK(BackstageWindow, AppEventHdl, VclSimpleEvent&, rEvent, void)
 {
-    if (!m_bOpen || rEvent.GetId() != VclEventId::WindowMouseButtonDown)
+    if (!m_bOpen)
+        return;
+    if (rEvent.GetId() == VclEventId::WindowGetFocus)
+    {
+        // the document's view took the focus while the panel covers it: Writer does when its window is activated
+        // again (Alt+Tab back, the task bar), and Esc, Ctrl+W, Ctrl+P then went to the hidden view and did nothing.
+        // The focus goes back to the panel's page once the activation is done.
+        vcl::Window* pFocus = static_cast<VclWindowEvent&>(rEvent).GetWindow();
+        vcl::Window* pView = lcl_viewWindow(m_xFrame);
+        if (pFocus && pView && pView->IsWindowOrChild(pFocus) && !m_pPendingRefocus)
+            m_pPendingRefocus = Application::PostUserEvent(LINK(this, BackstageWindow, RefocusHdl));
+        return;
+    }
+    if (rEvent.GetId() != VclEventId::WindowMouseButtonDown)
         return;
