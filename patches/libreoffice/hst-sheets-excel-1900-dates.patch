+#include <com/sun/star/lang/XMultiServiceFactory.hpp>
+#include <com/sun/star/uno/XComponentContext.hpp>
+#include <i18nlangtag/lang.h>
+#include <svl/hstexcel1900.hxx>
+#include <svl/nfengine.hxx>
+#include <svl/numformat.hxx>
+#include <svl/zforlist.hxx>
+
+using namespace css;
+
+namespace
+{
+class HstExcel1900Test : public CppUnit::TestFixture
+{
+public:
+    HstExcel1900Test()
+        : m_xContext(cppu::defaultBootstrap_InitialComponentContext())
+    {
+        uno::Reference<lang::XMultiServiceFactory> xSM(m_xContext->getServiceManager(),
+                                                       uno::UNO_QUERY_THROW);
+        comphelper::setProcessServiceFactory(xSM);
+    }
+    ~HstExcel1900Test() override
+    {
+        uno::Reference<lang::XComponent>(m_xContext, uno::UNO_QUERY_THROW)->dispose();
+    }
+
+    void testDayRules();
+    void testDefaultOff();
+    void testOutput();
+    void testInput();
+    void testOtherNullDate();
+
+    CPPUNIT_TEST_SUITE(HstExcel1900Test);
+    CPPUNIT_TEST(testDayRules);
+    CPPUNIT_TEST(testDefaultOff);
+    CPPUNIT_TEST(testOutput);
+    CPPUNIT_TEST(testInput);
+    CPPUNIT_TEST(testOtherNullDate);
+    CPPUNIT_TEST_SUITE_END();
+
+private:
+    static OUString output(SvNumberFormatter& rFormatter, const OUString& rCode, double fValue,
+                           LanguageType eLang = LANGUAGE_ENGLISH_US)
+    {
+        OUString aCode = rCode;
+        sal_Int32 nCheckPos = 0;
+        SvNumFormatType nType = SvNumFormatType::DEFINED;
+        sal_uInt32 nKey = 0;
+        rFormatter.PutEntry(aCode, nCheckPos, nType, nKey, eLang);
+        CPPUNIT_ASSERT_EQUAL(sal_Int32(0), nCheckPos);
+        OUString aOut;
+        const Color* pColor = nullptr;
+        rFormatter.GetOutputString(fValue, nKey, aOut, &pColor);
+        return aOut;
+    }
+    /// The serial of a typed date, or -1000 when the input is not a date.
+    static double input(SvNumberFormatter& rFormatter, const OUString& rInput,
+                        LanguageType eLang = LANGUAGE_ENGLISH_US)
+    {
+        sal_uInt32 nIndex = rFormatter.GetStandardIndex(eLang);
+        double fValue = 0.0;
+        if (!rFormatter.IsNumberFormat(rInput, nIndex, fValue))
+            return -1000.0;
+        if (!(rFormatter.GetType(nIndex) & SvNumFormatType::DATE))
+            return -1000.0;
+        return fValue;
+    }
+
+    uno::Reference<uno::XComponentContext> m_xContext;
+};
+
+void HstExcel1900Test::testDayRules()
+{
+    using namespace svl::hst;
+    CPPUNIT_ASSERT_EQUAL(1.0, Excel1900SerialToNullDateDays(0));
+    CPPUNIT_ASSERT_EQUAL(2.0, Excel1900SerialToNullDateDays(1));
+    CPPUNIT_ASSERT_EQUAL(2.5, Excel1900SerialToNullDateDays(1.5));
+    CPPUNIT_ASSERT_EQUAL(60.0, Excel1900SerialToNullDateDays(59));
+    CPPUNIT_ASSERT_EQUAL(60.0, Excel1900SerialToNullDateDays(60));
+    CPPUNIT_ASSERT_EQUAL(61.0, Excel1900SerialToNullDateDays(61));
+    CPPUNIT_ASSERT_EQUAL(0.0, Excel1900SerialToNullDateDays(-1));
+
+    CPPUNIT_ASSERT_EQUAL(0.0, NullDateDaysToExcel1900Serial(1));
+    CPPUNIT_ASSERT_EQUAL(1.0, NullDateDaysToExcel1900Serial(2));
+    CPPUNIT_ASSERT_EQUAL(59.0, NullDateDaysToExcel1900Serial(60));
+    CPPUNIT_ASSERT_EQUAL(61.0, NullDateDaysToExcel1900Serial(61));
+    CPPUNIT_ASSERT_EQUAL(45292.0, NullDateDaysToExcel1900Serial(45292));
+
+    CPPUNIT_ASSERT(IsExcel1900LeapDay(60));
+    CPPUNIT_ASSERT(IsExcel1900LeapDay(60.75));
+    CPPUNIT_ASSERT(!IsExcel1900LeapDay(59.75));
+    CPPUNIT_ASSERT(!IsExcel1900LeapDay(61));
+}
+
+void HstExcel1900Test::testDefaultOff()
+{
+    // Without the switch the count from 30/12/1899 stays: serial 1 is 31/12/1899.
+    SvNumberFormatter aFormatter(m_xContext, LANGUAGE_ENGLISH_US);
+    CPPUNIT_ASSERT(!aFormatter.IsHstExcel1900Dates());
+    CPPUNIT_ASSERT_EQUAL(u"31/12/1899"_ustr, output(aFormatter, u"DD/MM/YYYY"_ustr, 1));
+    CPPUNIT_ASSERT_EQUAL(u"28/02/1900"_ustr, output(aFormatter, u"DD/MM/YYYY"_ustr, 60));
+    CPPUNIT_ASSERT_EQUAL(u"01/03/1900"_ustr, output(aFormatter, u"DD/MM/YYYY"_ustr, 61));
+    CPPUNIT_ASSERT_EQUAL(u"Sunday"_ustr, output(aFormatter, u"DDDD"_ustr, 1));
+    CPPUNIT_ASSERT_EQUAL(2.0, input(aFormatter, u"1900-01-01"_ustr));
+    CPPUNIT_ASSERT_EQUAL(-1000.0, input(aFormatter, u"2/29/1900"_ustr));
+}
+
+void HstExcel1900Test::testOutput()
+{
+    SvNumberFormatter aFormatter(m_xContext, LANGUAGE_ENGLISH_US);
+    aFormatter.SetHstExcel1900Dates(true);
+    CPPUNIT_ASSERT(aFormatter.IsHstExcel1900Dates());
+
+    const OUString aDmy(u"DD/MM/YYYY"_ustr);
+    CPPUNIT_ASSERT_EQUAL(u"31/12/1899"_ustr, output(aFormatter, aDmy, 0));
+    CPPUNIT_ASSERT_EQUAL(u"01/01/1900"_ustr, output(aFormatter, aDmy, 1));
+    CPPUNIT_ASSERT_EQUAL(u"28/02/1900"_ustr, output(aFormatter, aDmy, 59));
+    CPPUNIT_ASSERT_EQUAL(u"29/02/1900"_ustr, output(aFormatter, aDmy, 60));
+    CPPUNIT_ASSERT_EQUAL(u"01/03/1900"_ustr, output(aFormatter, aDmy, 61));
+    CPPUNIT_ASSERT_EQUAL(u"09/04/1900"_ustr, output(aFormatter, aDmy, 100));
+    CPPUNIT_ASSERT_EQUAL(u"01/01/2024"_ustr, output(aFormatter, aDmy, 45292));
+
+    const OUString aMdy(u"M/D/YYYY"_ustr);
+    CPPUNIT_ASSERT_EQUAL(u"1/1/1900"_ustr, output(aFormatter, aMdy, 1));
+    CPPUNIT_ASSERT_EQUAL(u"2/29/1900"_ustr, output(aFormatter, aMdy, 60));
+    CPPUNIT_ASSERT_EQUAL(u"3/1/1900"_ustr, output(aFormatter, aMdy, 61));
+
+    // Weekdays follow the serials: 1 is a Sunday, 59 a Tuesday, 60 a Wednesday, 61 a Thursday.
+    const OUString aLong(u"DDDD, MMMM D, YYYY"_ustr);
+    CPPUNIT_ASSERT_EQUAL(u"Sunday, January 1, 1900"_ustr, output(aFormatter, aLong, 1));
+    CPPUNIT_ASSERT_EQUAL(u"Tuesday, February 28, 1900"_ustr, output(aFormatter, aLong, 59));
+    CPPUNIT_ASSERT_EQUAL(u"Wednesday, February 29, 1900"_ustr, output(aFormatter, aLong, 60));
+    CPPUNIT_ASSERT_EQUAL(u"Thursday, March 1, 1900"_ustr, output(aFormatter, aLong, 61));
+    CPPUNIT_ASSERT_EQUAL(u"Sun"_ustr, output(aFormatter, u"DDD"_ustr, 1));
+    CPPUNIT_ASSERT_EQUAL(u"Wed"_ustr, output(aFormatter, u"NN"_ustr, 60));
+
+    // Date and time.
+    const OUString aDateTime(u"DD/MM/YYYY HH:MM"_ustr);
+    CPPUNIT_ASSERT_EQUAL(u"01/01/1900 06:00"_ustr, output(aFormatter, aDateTime, 1.25));
+    CPPUNIT_ASSERT_EQUAL(u"29/02/1900 12:00"_ustr, output(aFormatter, aDateTime, 60.5));
+    CPPUNIT_ASSERT_EQUAL(u"01/03/1900 18:00"_ustr, output(aFormatter, aDateTime, 61.75));
+
+    // The Vietnamese default date order.
+    CPPUNIT_ASSERT_EQUAL(u"29/02/1900"_ustr,
+                         output(aFormatter, u"DD/MM/YYYY"_ustr, 60, LANGUAGE_VIETNAMESE));
+
+    // The language data a calculation thread copies keeps the switch.
+    const SvNFLanguageData aCopy(aFormatter.GetROLanguageData());
+    CPPUNIT_ASSERT(aCopy.IsHstExcel1900Dates());
+
+    aFormatter.SetHstExcel1900Dates(false);
+    CPPUNIT_ASSERT_EQUAL(u"31/12/1899"_ustr, output(aFormatter, aDmy, 1));
+}
+
+void HstExcel1900Test::testInput()
+{
+    SvNumberFormatter aUs(m_xContext, LANGUAGE_ENGLISH_US);
+    aUs.SetHstExcel1900Dates(true);
+    CPPUNIT_ASSERT_EQUAL(1.0, input(aUs, u"1/1/1900"_ustr));
+    CPPUNIT_ASSERT_EQUAL(59.0, input(aUs, u"2/28/1900"_ustr));
+    CPPUNIT_ASSERT_EQUAL(60.0, input(aUs, u"2/29/1900"_ustr));
+    CPPUNIT_ASSERT_EQUAL(61.0, input(aUs, u"3/1/1900"_ustr));
+    CPPUNIT_ASSERT_EQUAL(100.0, input(aUs, u"4/9/1900"_ustr));
+    CPPUNIT_ASSERT_EQUAL(1.0, input(aUs, u"1900-01-01"_ustr));
+    CPPUNIT_ASSERT_EQUAL(60.0, input(aUs, u"1900-02-29"_ustr));
+    CPPUNIT_ASSERT_EQUAL(61.0, input(aUs, u"1900-03-01"_ustr));
+    CPPUNIT_ASSERT_EQUAL(0.0, input(aUs, u"12/31/1899"_ustr));
+    CPPUNIT_ASSERT_EQUAL(45292.0, input(aUs, u"1/1/2024"_ustr));
+    // Other days that do not exist stay text.
+    CPPUNIT_ASSERT_EQUAL(-1000.0, input(aUs, u"2/30/1900"_ustr));
+    CPPUNIT_ASSERT_EQUAL(-1000.0, input(aUs, u"2/29/1901"_ustr));
+
+    // Day first, as in Vietnamese and British English.
+    SvNumberFormatter aVi(m_xContext, LANGUAGE_VIETNAMESE);
+    aVi.SetHstExcel1900Dates(true);
+    CPPUNIT_ASSERT_EQUAL(60.0, input(aVi, u"29/02/1900"_ustr, LANGUAGE_VIETNAMESE));
+    CPPUNIT_ASSERT_EQUAL(1.0, input(aVi, u"01/01/1900"_ustr, LANGUAGE_VIETNAMESE));
+    SvNumberFormatter aGb(m_xContext, LANGUAGE_ENGLISH_UK);
+    aGb.SetHstExcel1900Dates(true);
+    CPPUNIT_ASSERT_EQUAL(60.0, input(aGb, u"29/02/1900"_ustr, LANGUAGE_ENGLISH_UK));
+    CPPUNIT_ASSERT_EQUAL(1.0, input(aGb, u"01/01/1900"_ustr, LANGUAGE_ENGLISH_UK));
+    CPPUNIT_ASSERT_EQUAL(61.0, input(aGb, u"01/03/1900"_ustr, LANGUAGE_ENGLISH_UK));
+}
+
+void HstExcel1900Test::testOtherNullDate()
+{
+    // The 1904 date system and other null dates are never changed.
+    SvNumberFormatter aFormatter(m_xContext, LANGUAGE_ENGLISH_US);
+    aFormatter.SetHstExcel1900Dates(true);
+    aFormatter.ChangeNullDate(1, 1, 1904);
+    CPPUNIT_ASSERT(!aFormatter.IsHstExcel1900Dates());
+    CPPUNIT_ASSERT_EQUAL(u"02/01/1904"_ustr, output(aFormatter, u"DD/MM/YYYY"_ustr, 1));
+    CPPUNIT_ASSERT_EQUAL(1.0, input(aFormatter, u"1904-01-02"_ustr));
+}
+}
+
+CPPUNIT_TEST_SUITE_REGISTRATION(HstExcel1900Test);
+
+CPPUNIT_PLUGIN_IMPLEMENT();
