+
+#pragma once
+
+// The 1900 date system in the number formatter's date output and date input; the rules are in
+// <svl/hstexcel1900.hxx>.
+
+#include <sal/types.h>
+
+class CalendarWrapper;
+class Date;
+class SvNFLanguageData;
+
+namespace svl::hst
+{
+/// Whether a formatter with this language data and null date counts days like the 1900 date
+/// system.
+bool Excel1900Dates(const SvNFLanguageData& rLanguage, const Date& rNullDate);
+
+/** The output of one date or date+time value through a format. */
+class Excel1900DateOutput
+{
+public:
+    /** rfCalendarValue is the value the output is about to give the calendar with
+        CalendarWrapper::setLocalDateTime (days since the calendar's epoch); it is moved to the
+        day the serial shows in the 1900 date system. */
+    Excel1900DateOutput(const SvNFLanguageData& rLanguage, const CalendarWrapper& rCal,
+                        double& rfCalendarValue);
+
+    /** While one keyword of the format is output, points a Gregorian calendar at a day whose
+        field that keyword shows: the weekday of the serial itself (serial 1 is a Sunday, as in
+        the 1900 date system), and day number 29 for 29/02/1900. */
+    class KeywordScope
+    {
+    public:
+        KeywordScope(const Excel1900DateOutput& rOutput, CalendarWrapper& rCal, short nKeyword);
+        ~KeywordScope();
+        KeywordScope(const KeywordScope&) = delete;
+        KeywordScope& operator=(const KeywordScope&) = delete;
