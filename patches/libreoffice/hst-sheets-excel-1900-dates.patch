+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ * Copyright (c) HASON TECH. HST Office.
+ */
+
+#pragma once
+
+// The 1900 date system of the leading spreadsheet application in documents of its convention
+// (sc::hst::Excel1900Dates): serial 1 is 01/01/1900 and serial 60 is 29/02/1900. The day rules
+// are in <svl/hstexcel1900.hxx>; the document's number formatter carries the switch, so cell
+// display, typed dates, TEXT, DATEVALUE and the date functions all count alike.
+
+#include <sal/types.h>
+#include "scdllapi.h"
+
+class ScDocument;
+struct ScInterpreterContext;
+
+namespace sc::hst
+{
+/** Switches the document's number formatter to the 1900 date system when the document is of
+    the leading application's convention, and back when not. Called once the convention is
+    known: for a new document and when a load or import ends. Later changes of the formula
+    syntax do not change the date system of a document. */
+SC_DLLPUBLIC void SyncExcel1900Dates(ScDocument& rDoc);
+
+/** The day count from the null date of the date YEAR and MONTH see in a serial: one day later
+    before serial 60 in the 1900 date system; 28/02/1900 for serial 60. Unchanged otherwise. */
+sal_Int32 Excel1900NullDateDays(const ScInterpreterContext& rContext, sal_Int32 nSerial);
+
+/// Whether DAY of the serial is 29 of the 1900 date system's 29/02/1900.
+bool IsExcel1900LeapDay(const ScInterpreterContext& rContext, sal_Int32 nSerial);
+
+/** DATE: the serial of the day fDays (counted from the null date) that DATE reached from the
+    first day of nYear/nMonth. The 1900 date system gives February 1900 29 days, so the days
+    are counted from that first day's serial. */
+double Excel1900DateSerial(const ScInterpreterContext& rContext, sal_Int16 nYear,
+                           sal_Int16 nMonth, double fDays);
+
+/** The value the OpenDocument export writes for a cell value in format nFormat. A date of the
+    1900 date system is written as the day it shows (serial 1 as 1900-01-01), since an .ods
+    file reopens with the count from 30/12/1899; serial 60, which has no ISO date, is written
+    as 1900-02-28, the day it follows. Other values are unchanged. */
+double OdsExportValue(const ScDocument& rDoc, sal_uInt32 nFormat, double fValue);
+}
