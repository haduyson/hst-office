+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ * Copyright (c) HASON TECH. HST Office.
+ */
+
+#pragma once
+
+// The 1900 date system of the leading spreadsheet application in documents of its convention
+// (sc::hst::Excel1900Dates): serial 1 is 01/01/1900 and serial 60 is 29/02/1900. The day rules
+// are in <svl/hstexcel1900.hxx>; the document's number formatter carries the switch, so cell
+// display, typed dates, TEXT, DATEVALUE and the date functions all count alike.
+
+#include <sal/types.h>
+#include <tools/date.hxx>
+#include "scdllapi.h"
+
+#include <string_view>
+
+class ScDocument;
+class SvNumberFormatter;
+struct ScInterpreterContext;
+
+namespace sc::hst
+{
+/** Switches the document's number formatter to the 1900 date system when the document is of
+    the leading application's convention, and back when not. Called once the convention is
+    known: for a new document and when a load or import ends. Later changes of the formula
+    syntax do not change the date system of a document. */
+SC_DLLPUBLIC void SyncExcel1900Dates(ScDocument& rDoc);
+
+/** The day count from the null date of the date YEAR and MONTH see in a serial: one day later
+    before serial 60 in the 1900 date system; 28/02/1900 for serial 60. Unchanged otherwise. */
+sal_Int32 Excel1900NullDateDays(const ScInterpreterContext& rContext, sal_Int32 nSerial);
+
+/// Whether DAY of the serial is 29 of the 1900 date system's 29/02/1900.
+bool IsExcel1900LeapDay(const ScInterpreterContext& rContext, sal_Int32 nSerial);
+
+/** DATE: the serial of the day fDays (counted from the null date) that DATE reached from the
+    first day of nYear/nMonth. The 1900 date system gives February 1900 29 days, so the days
+    are counted from that first day's serial. */
+double Excel1900DateSerial(const ScInterpreterContext& rContext, sal_Int16 nYear,
+                           sal_Int16 nMonth, double fDays);
+
+/** WEEKNUM, ISOWEEKNUM and WEEKNUM_OOO of nSerial in the 1900 date system, which counts
+    01/01/1900 (serial 1) as a Sunday and gives February 1900 a 29th day: returns true with
+    rnWeek set for the serials up to the first days of 1901, whose weeks depend on it; false
+    otherwise, and for documents not in the 1900 date system. nFirstDayOfWeek is a DayOfWeek
+    (MONDAY is 0); weeks with fewer than nMinimumDays days of the year count to the year
+    before (4 for ISO 8601 weeks, 1 for the week holding 01/01 as week 1). */
+bool Excel1900WeekOfYear(const ScInterpreterContext& rContext, sal_Int32 nSerial,
+                         sal_Int16 nFirstDayOfWeek, sal_Int16 nMinimumDays, sal_Int32& rnWeek);
+
+/** DAYS360 of two serials when one of them falls before 01/03/1900 in the 1900 date system;
+    returns false otherwise. */
+bool Excel1900Days360(const ScInterpreterContext& rContext, sal_Int32 nStart, sal_Int32 nEnd,
+                      bool bEuropean, double& rfResult);
+
+/** DATEDIF of two serials (nStart <= nEnd) in units "m", "y", "md", "ym" or "yd" when one of
+    them falls before 01/03/1900 in the 1900 date system; returns false otherwise, and for
+    other units. */
+bool Excel1900DateDif(const ScInterpreterContext& rContext, sal_Int32 nStart, sal_Int32 nEnd,
+                      std::u16string_view aUnit, double& rfResult);
+
+/** The date a serial shows (its year, month and day); 29/02/1900 in the 1900 date system
+    holds day 29 of month 2 of 1900 unnormalized, for the date grouping of the autofilter and
+    the pivot table. */
+SC_DLLPUBLIC Date Excel1900ShownDate(const SvNumberFormatter& rFormatter, double fSerial);
+
+/// The same, with the formatter's IsHstExcel1900Dates() and null date given.
+SC_DLLPUBLIC Date Excel1900ShownDate(bool bExcel1900, const Date& rNullDate, double fSerial);
+
+/** A day count from the null date turned into the serial that shows that day. */
+SC_DLLPUBLIC double Excel1900SerialOfDays(const SvNumberFormatter& rFormatter, double fDays);
+
+/** The value of a pivot table date group part (YEARS, QUARTERS, MONTHS or DAYS, the day of a
+    leap year) of a serial before 01/03/1900 in the 1900 date system; false otherwise. */
+SC_DLLPUBLIC bool Excel1900DatePart(const SvNumberFormatter& rFormatter, double fSerial, sal_Int32 nDatePart,
+                       sal_Int32& rnResult);
+
+/** The value the OpenDocument export writes for a cell value in format nFormat. A date of the
+    1900 date system is written as the day it shows (serial 1 as 1900-01-01), since an .ods
+    file reopens with the count from 30/12/1899; serial 60, which has no ISO date, is written
+    as 1900-02-28, the day it follows. Other values are unchanged. */
+double OdsExportValue(const ScDocument& rDoc, sal_uInt32 nFormat, double fValue);
+}
