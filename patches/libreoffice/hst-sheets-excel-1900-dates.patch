+
+// HST Office: the 1900 date system of the leading spreadsheet application in documents of its
+// convention, checked against its documented behaviour: serial 1 is 01/01/1900, serial 60 is
+// 29/02/1900 (a day that does not exist, kept for Lotus 1-2-3 compatibility), from serial 61
+// (01/03/1900) on the count is the usual one, and WEEKDAY(1) is 1 (Sunday). .ods files keep
+// the count from 30/12/1899 (serial 1 is 31/12/1899).
+
+#include "../helper/qahelper.hxx"
+
+#include <comphelper/propertyvalue.hxx>
+#include <i18nlangtag/lang.h>
+#include <svl/numformat.hxx>
+#include <tools/stream.hxx>
+#include <vcl/scheduler.hxx>
+#include <docsh.hxx>
+#include <document.hxx>
+#include <hstlogicaltext.hxx>
+
+namespace
+{
+class ScHstExcel1900DatesTest : public ScModelTestBase
+{
+public:
+    ScHstExcel1900DatesTest()
+        : ScModelTestBase(u"sc/qa/unit/data"_ustr)
+    {
+    }
+
+protected:
+    ScAddress pos(const char* pCell)
+    {
+        ScAddress aPos;
+        aPos.Parse(OUString::createFromAscii(pCell), *getScDoc());
+        return aPos;
+    }
+    OUString str(const char* pCell) { return getScDoc()->GetString(pos(pCell)); }
+    double val(const char* pCell) { return getScDoc()->GetValue(pos(pCell)); }
+    void recalc()
+    {
+        getScDoc()->CalcAll();
+        Scheduler::ProcessEventsToIdle();
+    }
+    bool excel1900() { return getScDoc()->GetFormatTable()->IsHstExcel1900Dates(); }
+
+    sal_uInt32 dateFormat(const OUString& rCode)
+    {
+        OUString aCode = rCode;
+        sal_Int32 nCheckPos = 0;
+        SvNumFormatType nType = SvNumFormatType::DEFINED;
+        sal_uInt32 nFormat = 0;
+        getScDoc()->GetFormatTable()->PutEntry(aCode, nCheckPos, nType, nFormat,
+                                               LANGUAGE_ENGLISH_US);
+        CPPUNIT_ASSERT_EQUAL(sal_Int32(0), nCheckPos);
+        return nFormat;
+    }
+    /// A1:A6 hold the serials 0, 1, 59, 60, 61 and 100 shown as DD/MM/YYYY.
+    void putSerials()
+    {
+        const sal_uInt32 nFormat = dateFormat(u"DD/MM/YYYY"_ustr);
+        const double aSerials[] = { 0, 1, 59, 60, 61, 100 };
+        for (SCROW nRow = 0; nRow < SCROW(std::size(aSerials)); ++nRow)
+        {
+            getScDoc()->SetValue(ScAddress(0, nRow, 0), aSerials[nRow]);
+            getScDoc()->SetNumberFormat(ScAddress(0, nRow, 0), nFormat);
+        }
+    }
+    void checkSerials()
+    {
+        CPPUNIT_ASSERT_EQUAL(1.0, val("A2"));
+        CPPUNIT_ASSERT_EQUAL(60.0, val("A4"));
+        CPPUNIT_ASSERT_EQUAL(u"31/12/1899"_ustr, str("A1"));
+        CPPUNIT_ASSERT_EQUAL(u"01/01/1900"_ustr, str("A2"));
+        CPPUNIT_ASSERT_EQUAL(u"28/02/1900"_ustr, str("A3"));
+        CPPUNIT_ASSERT_EQUAL(u"29/02/1900"_ustr, str("A4"));
+        CPPUNIT_ASSERT_EQUAL(u"01/03/1900"_ustr, str("A5"));
+        CPPUNIT_ASSERT_EQUAL(u"09/04/1900"_ustr, str("A6"));
+    }
+
+    /// Writes a flat .ods (LibreOffice, no HST mark) with the date 1900-01-01 in A1 and
+    /// =DATE(1900;1;1) in B1.
+    void writeFlatOds()
+    {
+        const OString aXml
+            = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+              "<office:document xmlns:office=\"urn:oasis:names:tc:opendocument:xmlns:office:1.0\""
+              " xmlns:table=\"urn:oasis:names:tc:opendocument:xmlns:table:1.0\""
+              " xmlns:text=\"urn:oasis:names:tc:opendocument:xmlns:text:1.0\""
+              " xmlns:of=\"urn:oasis:names:tc:opendocument:xmlns:of:1.2\""
+              " office:version=\"1.3\" office:mimetype=\"application/vnd.oasis.opendocument.spreadsheet\">"
+              "<office:body><office:spreadsheet><table:table table:name=\"Sheet1\"><table:table-row>"
+              "<table:table-cell office:value-type=\"date\" office:date-value=\"1900-01-01\">"
+              "<text:p>01/01/1900</text:p></table:table-cell>"
+              "<table:table-cell table:formula=\"of:=DATE(1900;1;1)\" office:value-type=\"date\""
+              " office:date-value=\"1900-01-01\"><text:p>01/01/1900</text:p></table:table-cell>"
+              "</table:table-row></table:table></office:spreadsheet></office:body>"
+              "</office:document>";
+        SvFileStream aStream(maTempFile.GetURL(), StreamMode::WRITE | StreamMode::TRUNC);
+        aStream.WriteBytes(aXml.getStr(), aXml.getLength());
+        aStream.Close();
+        CPPUNIT_ASSERT_EQUAL(ERRCODE_NONE, aStream.GetError());
+    }
+};
+}
+
+CPPUNIT_TEST_FIXTURE(ScHstExcel1900DatesTest, testCellDisplay)
+{
+    // A new document uses the leading application's formula syntax: the 1900 date system.
+    createScDoc();
+    CPPUNIT_ASSERT(excel1900());
+    putSerials();
+    checkSerials();
+
+    const sal_uInt32 nUs = dateFormat(u"M/D/YYYY"_ustr);
+    getScDoc()->SetNumberFormat(pos("A2"), nUs);
+    getScDoc()->SetNumberFormat(pos("A4"), nUs);
+    getScDoc()->SetNumberFormat(pos("A5"), nUs);
+    CPPUNIT_ASSERT_EQUAL(u"1/1/1900"_ustr, str("A2"));
+    CPPUNIT_ASSERT_EQUAL(u"2/29/1900"_ustr, str("A4"));
+    CPPUNIT_ASSERT_EQUAL(u"3/1/1900"_ustr, str("A5"));
+
+    // Date and time, and a weekday that follows the serials: serial 1 is a Sunday.
+    getScDoc()->SetValue(pos("B1"), 60.5);
+    getScDoc()->SetNumberFormat(pos("B1"), dateFormat(u"DD/MM/YYYY HH:MM"_ustr));
+    CPPUNIT_ASSERT_EQUAL(u"29/02/1900 12:00"_ustr, str("B1"));
+    getScDoc()->SetValue(pos("B2"), 1);
+    getScDoc()->SetNumberFormat(pos("B2"), dateFormat(u"DDDD, MMMM D, YYYY"_ustr));
+    CPPUNIT_ASSERT_EQUAL(u"Sunday, January 1, 1900"_ustr, str("B2"));
+    getScDoc()->SetValue(pos("B3"), 60);
+    getScDoc()->SetNumberFormat(pos("B3"), dateFormat(u"DDDD, MMMM D, YYYY"_ustr));
+    CPPUNIT_ASSERT_EQUAL(u"Wednesday, February 29, 1900"_ustr, str("B3"));
+}
+
+CPPUNIT_TEST_FIXTURE(ScHstExcel1900DatesTest, testText)
+{
+    createScDoc();
+    insertStringToCell(u"A1"_ustr, u"=TEXT(1,\"dd/mm/yyyy\")");
+    insertStringToCell(u"A2"_ustr, u"=TEXT(59,\"dd/mm/yyyy\")");
+    insertStringToCell(u"A3"_ustr, u"=TEXT(60,\"dd/mm/yyyy\")");
+    insertStringToCell(u"A4"_ustr, u"=TEXT(61,\"dd/mm/yyyy\")");
+    insertStringToCell(u"A5"_ustr, u"=TEXT(100,\"dd/mm/yyyy\")");
+    insertStringToCell(u"A6"_ustr, u"=TEXT(60,\"m/d/yyyy\")");
+    insertStringToCell(u"A7"_ustr, u"=TEXT(1,\"dddd\")");
+    insertStringToCell(u"A8"_ustr, u"=TEXT(45292,\"dd/mm/yyyy\")");
+    CPPUNIT_ASSERT_EQUAL(u"01/01/1900"_ustr, str("A1"));
+    CPPUNIT_ASSERT_EQUAL(u"28/02/1900"_ustr, str("A2"));
+    CPPUNIT_ASSERT_EQUAL(u"29/02/1900"_ustr, str("A3"));
+    CPPUNIT_ASSERT_EQUAL(u"01/03/1900"_ustr, str("A4"));
+    CPPUNIT_ASSERT_EQUAL(u"09/04/1900"_ustr, str("A5"));
+    CPPUNIT_ASSERT_EQUAL(u"2/29/1900"_ustr, str("A6"));
+    CPPUNIT_ASSERT_EQUAL(u"Sunday"_ustr, str("A7"));
+    CPPUNIT_ASSERT_EQUAL(u"01/01/2024"_ustr, str("A8"));
+}
