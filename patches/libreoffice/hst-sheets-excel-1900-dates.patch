+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ * Copyright (c) HASON TECH. HST Office.
+ */
+
+// The 1900 date system of the leading spreadsheet application in the number formatter: which
+// day a serial shows in date formats, and which serial a typed date gets.
+
+#include "hstexcel1900.hxx"
+
+#include <svl/hstexcel1900.hxx>
+#include <svl/nfengine.hxx>
+#include <svl/nfkeytab.hxx>
+#include <svl/numformat.hxx>
+
+#include <com/sun/star/i18n/CalendarFieldIndex.hpp>
+#include <tools/date.hxx>
+#include <tools/datetime.hxx>
+#include <unotools/calendarwrapper.hxx>
+
+#include <cmath>
+
+namespace svl::hst
+{
+namespace
+{
+/// The first serial on which the 1900 date system and the count from 30/12/1899 agree.
+constexpr double fFirstCommonDay = 61.0;
+
+bool isGregorian(const CalendarWrapper& rCal) { return rCal.getUniqueID() == u"gregorian"; }
+
+bool isWeekdayKeyword(short nKeyword)
+{
+    switch (nKeyword)
+    {
+        case NF_KEY_DDD:
+        case NF_KEY_DDDD:
+        case NF_KEY_NN:
+        case NF_KEY_NNN:
+        case NF_KEY_NNNN:
+        case NF_KEY_AAA:
+        case NF_KEY_AAAA:
+            return true;
+        default:
+            return false;
+    }
+}
+
+bool isDayOfMonthKeyword(short nKeyword) { return nKeyword == NF_KEY_D || nKeyword == NF_KEY_DD; }
+}
+
+double Excel1900SerialToNullDateDays(double fSerial)
+{
+    return std::floor(fSerial) < nExcel1900LeapDaySerial ? fSerial + 1.0 : fSerial;
+}
+
+double NullDateDaysToExcel1900Serial(double fDays)
+{
+    return std::floor(fDays) < fFirstCommonDay ? fDays - 1.0 : fDays;
+}
+
+bool IsExcel1900LeapDay(double fSerial) { return std::floor(fSerial) == nExcel1900LeapDaySerial; }
+
+bool Excel1900Dates(const SvNFLanguageData& rLanguage, const Date& rNullDate)
+{
+    return rLanguage.IsHstExcel1900Dates() && rNullDate == Date(30, 12, 1899);
+}
+
+Excel1900DateOutput::Excel1900DateOutput(const SvNFLanguageData& rLanguage,
+                                         const CalendarWrapper& rCal, double& rfCalendarValue)
+{
+    const Date& rNullDate = rLanguage.GetNullDate();
+    if (!Excel1900Dates(rLanguage, rNullDate))
+        return;
+    // The serial is the calendar value counted from the null date instead of the epoch.
+    const double fSerial
+        = rfCalendarValue - DateTime::Sub(DateTime(rNullDate), rCal.getEpochStart());
+    if (!std::isfinite(fSerial))
+        return;
+    mbLeapDay = IsExcel1900LeapDay(fSerial);
+    if (std::floor(fSerial) < nExcel1900LeapDaySerial)
+    {
+        mnShownDayOffset = 1;
+        rfCalendarValue += mnShownDayOffset;
+    }
+}
+
+sal_Int32 Excel1900DateOutput::KeywordDays(short nKeyword) const
+{
+    // The weekdays of the 1900 date system follow its serials: serial 1 is a Sunday, the
+    // weekday of the serial's own day in the count from 30/12/1899 (31/12/1899).
+    if (isWeekdayKeyword(nKeyword))
+        return -mnShownDayOffset;
+    // 29/02/1900 is shown on 28/02/1900 with the day number of any 29th: 29/01/1900. Month
+    // and year keywords keep 28/02/1900.
+    if (mbLeapDay && isDayOfMonthKeyword(nKeyword))
+        return -30;
+    return 0;
+}
+
+Excel1900DateOutput::KeywordScope::KeywordScope(const Excel1900DateOutput& rOutput,
+                                                CalendarWrapper& rCal, short nKeyword)
+{
+    const sal_Int32 nDays = rOutput.KeywordDays(nKeyword);
+    // Other calendars than the Gregorian one show the dates of the count from 30/12/1899 and
+    // their own weekdays; the 1900 date system only knows Gregorian dates.
+    if (nDays == 0 || !isGregorian(rCal))
+        return;
+    mpCal = &rCal;
+    mfSavedValue = rCal.getLocalDateTime();
+    rCal.setLocalDateTime(mfSavedValue + nDays);
+}
+
+Excel1900DateOutput::KeywordScope::~KeywordScope()
+{
+    if (mpCal)
+        mpCal->setLocalDateTime(mfSavedValue);
+}
+
+void Excel1900InputDate(const SvNFLanguageData& rLanguage, const Date& rNullDate, double& rfDays)
+{
+    if (Excel1900Dates(rLanguage, rNullDate))
+        rfDays = NullDateDaysToExcel1900Serial(rfDays);
+}
+
+bool Excel1900InputLeapDay(const SvNFLanguageData& rLanguage, const Date& rNullDate,
+                           const CalendarWrapper& rCal, double& rfDays)
+{
+    if (!Excel1900Dates(rLanguage, rNullDate) || !isGregorian(rCal))
+        return false;
+    // The calendar rejected the date and moved the overflowing day into the next month.
+    // 29/02/1900 becomes 01/03/1900, which no other rejected input becomes: the scanner sets a
+    // day of 1-31 (0 for larger numbers) and a month of 1-12 (13 for larger numbers).
+    using namespace css::i18n;
+    if (rCal.getValue(CalendarFieldIndex::DAY_OF_MONTH) != 1
+        || rCal.getValue(CalendarFieldIndex::MONTH) != 2 // March, zero based
+        || rCal.getValue(CalendarFieldIndex::YEAR) != 1900
+        || rCal.getValue(CalendarFieldIndex::ERA) != 1) // CE
+        return false;
+    rfDays = nExcel1900LeapDaySerial;
+    return true;
+}
+}
+
+void SvNumberFormatter::SetHstExcel1900Dates(bool bSet)
+{
+    ::osl::MutexGuard aGuard(GetInstanceMutex());
+    m_aCurrentLanguage.mbHstExcel1900Dates = bSet;
+}
+
+bool SvNumberFormatter::IsHstExcel1900Dates() const
+{
+    // Read without the instance mutex like the read-only formatter data threads use; the flag
+    // is set while the document loads, before any calculation reads it.
+    return svl::hst::Excel1900Dates(m_aCurrentLanguage, m_aCurrentLanguage.GetNullDate());
+}
