+
+// HST Office: the number formatter's 1900 date system, checked against the leading spreadsheet
+// application's documented behaviour (serial 1 is 01/01/1900, serial 60 is 29/02/1900, from
+// serial 61 on the usual count, serial 1 is a Sunday), and its default: off.
+
+#include <cppunit/TestAssert.h>
+#include <cppunit/TestFixture.h>
+#include <cppunit/extensions/HelperMacros.h>
+#include <cppunit/plugin/TestPlugIn.h>
+
