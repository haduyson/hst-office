+#pragma once
+
+#include <sal/types.h>
+#include <svl/svldllapi.h>
+
+/* The 1900 date system of the leading spreadsheet application.
+
+   Its serial 1 is 01/01/1900 and it counts a 29/02/1900 (serial 60) that never existed, kept
+   for compatibility with Lotus 1-2-3. From serial 61 (01/03/1900) on it counts like the day
+   count from the null date 30/12/1899. Before that, a serial shows the date one day later than
+   the day count from 30/12/1899 does:
+
+       serial   1900 date system   day count from 30/12/1899
+            0   (00/01/1900)       30/12/1899
+            1   01/01/1900         31/12/1899
+           59   28/02/1900         27/02/1900
+           60   29/02/1900         28/02/1900
+           61   01/03/1900         01/03/1900
+
+   HST Sheets shows the serials below 60 as the 1900 date system does, and extends that rule to
+   0 and the negative serials the 1900 date system does not show (it shows 0 as the day
+   "00/01/1900" and negative serials as an error): 0 is 31/12/1899, -1 is 30/12/1899 and so on,
+   so that every date typed before 01/03/1900 reads back as the same date.
+
+   A number formatter counts days this way when its document sets it (see
+   SvNumberFormatter::SetHstExcel1900Dates) and its null date is 30/12/1899. */
+
+namespace svl::hst
+{
+/// The serial of the day that does not exist, 29/02/1900.
+constexpr sal_Int32 nExcel1900LeapDaySerial = 60;
+
+/** The day count from 30/12/1899 of the date a serial of the 1900 date system shows, with the
+    same time of day. Serial 60, 29/02/1900, gives 28/02/1900, the day it follows. */
+SVL_DLLPUBLIC double Excel1900SerialToNullDateDays(double fSerial);
+
+/** The serial of the 1900 date system for a date given as its day count from 30/12/1899, with
+    the same time of day. */
+SVL_DLLPUBLIC double NullDateDaysToExcel1900Serial(double fDays);
+
+/// Whether a serial of the 1900 date system falls on 29/02/1900.
+SVL_DLLPUBLIC bool IsExcel1900LeapDay(double fSerial);
+}
