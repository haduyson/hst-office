+{
+bool usesExcel1900(const ScInterpreterContext& rContext)
+{
+    const SvNumberFormatter* pFormatter = rContext.GetFormatTable();
+    return pFormatter && pFormatter->IsHstExcel1900Dates();
+}
+}
+
+void SyncExcel1900Dates(ScDocument& rDoc)
+{
+    SvNumberFormatter* pFormatter = rDoc.GetFormatTable();
+    if (!pFormatter)
+        return;
+    const bool bExcel1900 = Excel1900Dates(rDoc);
+    if (pFormatter->GetROLanguageData().IsHstExcel1900Dates() == bExcel1900)
+        return;
+    pFormatter->SetHstExcel1900Dates(bExcel1900);
+    // Interpreter contexts of threaded calculation keep a copy of the formatter's settings.
+    rDoc.ClearLookupCaches();
+}
+
+sal_Int32 Excel1900NullDateDays(const ScInterpreterContext& rContext, sal_Int32 nSerial)
+{
+    if (!usesExcel1900(rContext))
+        return nSerial;
+    return static_cast<sal_Int32>(svl::hst::Excel1900SerialToNullDateDays(nSerial));
+}
+
+bool IsExcel1900LeapDay(const ScInterpreterContext& rContext, sal_Int32 nSerial)
+{
+    return usesExcel1900(rContext) && svl::hst::IsExcel1900LeapDay(nSerial);
+}
+
+double Excel1900DateSerial(const ScInterpreterContext& rContext, sal_Int16 nYear,
+                           sal_Int16 nMonth, double fDays)
+{
+    if (!usesExcel1900(rContext))
+        return fDays;
+    // The first day of a month is a real date, its serial follows from its day count; the
+    // days DATE added after it are days of the 1900 date system.
+    const Date aFirstDay(1, nMonth, nYear);
+    const double fFirstDay = aFirstDay - rContext.NFGetNullDate();
+    return svl::hst::NullDateDaysToExcel1900Serial(fFirstDay) + (fDays - fFirstDay);
+}
+
+double OdsExportValue(const ScDocument& rDoc, sal_uInt32 nFormat, double fValue)
+{
+    const SvNumberFormatter* pFormatter = rDoc.GetFormatTable();
+    if (!pFormatter || !pFormatter->IsHstExcel1900Dates()
+        || !(pFormatter->GetType(nFormat) & SvNumFormatType::DATE))
+        return fValue;
+    return svl::hst::Excel1900SerialToNullDateDays(fValue);
+}
+}
