+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ * Copyright (c) HASON TECH. HST Office.
+ */
+
+// The date functions that work on year, month and day (WEEKNUM, ISOWEEKNUM, DAYS360, DATEDIF,
+// EDATE, EOMONTH) and the date grouping of the autofilter and the pivot table, in the 1900 date
+// system of the leading spreadsheet application: serial 1 is 01/01/1900, a Sunday, and serial
+// 60 is 29/02/1900, a day February 1900 has there. From serial 61 (01/03/1900) on its dates
+// are the dates of the day count from 30/12/1899, so only computations that touch January or
+// February 1900 (or the weeks of 1900) are made here; the others stay with the usual code.
+//
+// NETWORKDAYS, WORKDAY and WEEKDAY need nothing: a weekday follows from the serial alone and
+// the 1900 date system's weekdays (serial 1 a Sunday) are those of the day count (day 1,
+// 31/12/1899, a Sunday).
+
+#include <hstexcel1900dates.hxx>
+
+#include <interpre.hxx>
+#include <interpretercontext.hxx>
+
+#include <com/sun/star/sheet/DataPilotFieldGroupBy.hpp>
+#include <rtl/math.hxx>
+#include <svl/hstexcel1900.hxx>
+#include <svl/numformat.hxx>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdlib>
+
+namespace sc::hst
+{
+namespace
+{
+/// The first serial whose date is the same in both day counts, 01/03/1900.
+constexpr sal_Int32 nFirstCommonSerial = 61;
+/// The last serial whose ISO 8601 week can depend on the weeks of 1900, 03/01/1901 + 7.
+constexpr sal_Int32 nLastWeekSerial = 372;
+
+struct ShownDay
+{
+    sal_Int32 nYear;
+    sal_Int32 nMonth;
+    sal_Int32 nDay;
+};
+
+bool usesExcel1900(const ScInterpreterContext& rContext)
+{
+    const SvNumberFormatter* pFormatter = rContext.GetFormatTable();
+    return pFormatter && pFormatter->IsHstExcel1900Dates();
+}
+
+/// The 1900 date system needs the null date 30/12/1899 (the formatter checks it).
+const Date& nullDate()
+{
+    static const Date aNullDate(30, 12, 1899);
+    return aNullDate;
+}
+
+/// Year, month and day a serial shows.
+ShownDay shownDay(sal_Int32 nSerial)
+{
+    if (nSerial == svl::hst::nExcel1900LeapDaySerial)
+        return { 1900, 2, 29 };
+    Date aDate(nullDate());
+    aDate.AddDays(static_cast<sal_Int32>(svl::hst::Excel1900SerialToNullDateDays(nSerial)));
+    return { aDate.GetYear(), aDate.GetMonth(), aDate.GetDay() };
+}
+
+/// Days of a month, 29 for February 1900.
+sal_Int32 daysInMonth(sal_Int32 nYear, sal_Int32 nMonth)
+{
+    if (nYear == 1900 && nMonth == 2)
+        return 29;
+    return Date::GetDaysInMonth(static_cast<sal_uInt16>(nMonth), static_cast<sal_Int16>(nYear));
+}
+
+/// Serial of the first day of a month; the month may lie outside 1..12.
+sal_Int32 firstOfMonthSerial(sal_Int32 nYear, sal_Int32 nMonth)
+{
+    const sal_Int32 nMonths = nYear * 12 + nMonth - 1;
+    nYear = nMonths >= 0 ? nMonths / 12 : -((-nMonths + 11) / 12);
+    nMonth = nMonths - nYear * 12 + 1;
+    if (nYear == 1900 && nMonth <= 2)
+        return nMonth == 1 ? 1 : 32;
+    const double fDays = Date(1, static_cast<sal_uInt16>(nMonth), static_cast<sal_Int16>(nYear))
+                         - nullDate();
+    return static_cast<sal_Int32>(svl::hst::NullDateDaysToExcel1900Serial(fDays));
+}
+
+/// Serial of a day of a month; days past the end of the month run on into the next one.
+sal_Int32 daySerial(sal_Int32 nYear, sal_Int32 nMonth, sal_Int32 nDay)
+{
+    return firstOfMonthSerial(nYear, nMonth) + nDay - 1;
+}
+
+/// Weekday of a serial, Monday 0 to Sunday 6; serial 1 is a Sunday.
+sal_Int32 weekday(sal_Int32 nSerial) { return ((nSerial + 5) % 7 + 7) % 7; }
+
+/// Serial of the first day of week 1 of a year.
+sal_Int32 firstWeekStart(sal_Int32 nYear, sal_Int32 nFirstDayOfWeek, sal_Int32 nMinimumDays)
+{
+    const sal_Int32 nJan1 = firstOfMonthSerial(nYear, 1);
+    const sal_Int32 nDaysBefore = (weekday(nJan1) - nFirstDayOfWeek + 7) % 7;
+    const sal_Int32 nStart = nJan1 - nDaysBefore;
+    return 7 - nDaysBefore >= nMinimumDays ? nStart : nStart + 7;
+}
+
+/** Serial some months later, with the day kept or cut to the end of the month. EDATE and
+    EOMONTH of the 1900 date system give February 1900 28 days (EDATE(31,1) and EOMONTH(1,1)
+    are 59, 28/02/1900), unlike DATE and DAYS360. */
+sal_Int32 monthsLater(sal_Int32 nSerial, sal_Int32 nMonths, bool bEndOfMonth)
+{
+    const ShownDay aDay = shownDay(nSerial);
+    const sal_Int32 nTotal = aDay.nYear * 12 + aDay.nMonth - 1 + nMonths;
+    const sal_Int32 nYear = nTotal >= 0 ? nTotal / 12 : -((-nTotal + 11) / 12);
+    const sal_Int32 nMonth = nTotal - nYear * 12 + 1;
+    const sal_Int32 nLast
+        = Date::GetDaysInMonth(static_cast<sal_uInt16>(nMonth), static_cast<sal_Int16>(nYear));
+    return daySerial(nYear, nMonth, bEndOfMonth ? nLast : std::min(aDay.nDay, nLast));
+}
+
+bool isAddIn(std::u16string_view aFuncName, std::u16string_view aMethod)
+{
+    constexpr std::u16string_view aPrefix = u"COM.SUN.STAR.SHEET.ADDIN.ANALYSIS.";
+    return aFuncName.size() == aPrefix.size() + aMethod.size()
+           && aFuncName.substr(0, aPrefix.size()) == aPrefix
+           && aFuncName.substr(aPrefix.size()) == aMethod;
+}
+
+/// Week start and minimum days of a WEEKNUM return type; false for an unknown type.
+bool weekType(sal_Int32 nType, sal_Int16& rnFirstDayOfWeek, sal_Int16& rnMinimumDays)
+{
+    rnMinimumDays = 1;
+    if (nType == 1)
+        rnFirstDayOfWeek = 6; // Sunday
+    else if (nType == 2)
+        rnFirstDayOfWeek = 0; // Monday
+    else if (nType >= 11 && nType <= 17)
+        rnFirstDayOfWeek = static_cast<sal_Int16>(nType - 11);
+    else if (nType == 21)
+    {
+        rnFirstDayOfWeek = 0;
+        rnMinimumDays = 4;
+    }
+    else
+        return false;
+    return true;
+}
+
+sal_Int32 weekOfYear(sal_Int32 nSerial, sal_Int16 nFirstDayOfWeek, sal_Int16 nMinimumDays)
+{
+    sal_Int32 nYear = shownDay(nSerial).nYear;
+    sal_Int32 nStart = firstWeekStart(nYear, nFirstDayOfWeek, nMinimumDays);
+    if (nSerial < nStart)
+    {
+        // Only with nMinimumDays > 1: a day of the last week of the year before.
+        --nYear;
+        nStart = firstWeekStart(nYear, nFirstDayOfWeek, nMinimumDays);
+    }
+    else if (nMinimumDays > 1 && nSerial >= firstWeekStart(nYear + 1, nFirstDayOfWeek, nMinimumDays))
+        return 1;
+    return (nSerial - nStart) / 7 + 1;
+}
+}
+
+bool Excel1900WeekOfYear(const ScInterpreterContext& rContext, sal_Int32 nSerial,
+                         sal_Int16 nFirstDayOfWeek, sal_Int16 nMinimumDays, sal_Int32& rnWeek)
+{
+    if (nSerial > nLastWeekSerial || !usesExcel1900(rContext))
+        return false;
+    rnWeek = weekOfYear(nSerial, nFirstDayOfWeek, nMinimumDays);
+    return true;
+}
+
+bool Excel1900Days360(const ScInterpreterContext& rContext, sal_Int32 nStart, sal_Int32 nEnd,
+                      bool bEuropean, double& rfResult)
+{
+    if ((nStart >= nFirstCommonSerial && nEnd >= nFirstCommonSerial) || !usesExcel1900(rContext))
+        return false;
+    const ShownDay aStart = shownDay(nStart);
+    const ShownDay aEnd = shownDay(nEnd);
+    sal_Int32 nStartDay = aStart.nDay;
+    sal_Int32 nEndDay = aEnd.nDay;
+    if (bEuropean)
+    {
+        // Day 31 of either date counts as day 30.
+        nStartDay = std::min<sal_Int32>(nStartDay, 30);
+        nEndDay = std::min<sal_Int32>(nEndDay, 30);
+    }
+    else
+    {
+        // US (NASD): a start on the last day of its month counts as day 30; an end on day 31
+        // counts as day 30 when the start does.
+        if (nStartDay == daysInMonth(aStart.nYear, aStart.nMonth))
+            nStartDay = 30;
+        nStartDay = std::min<sal_Int32>(nStartDay, 30);
+        if (nEndDay == 31 && nStartDay == 30)
+            nEndDay = 30;
+    }
+    rfResult = static_cast<double>((aEnd.nYear - aStart.nYear) * 360
+                                   + (aEnd.nMonth - aStart.nMonth) * 30 + nEndDay - nStartDay);
+    return true;
+}
+
+bool Excel1900DateDif(const ScInterpreterContext& rContext, sal_Int32 nStart, sal_Int32 nEnd,
+                      std::u16string_view aUnit, double& rfResult)
+{
+    if ((nStart >= nFirstCommonSerial && nEnd >= nFirstCommonSerial) || !usesExcel1900(rContext))
+        return false;
+    const ShownDay aStart = shownDay(nStart);
+    const ShownDay aEnd = shownDay(nEnd);
+    // Whole months from the start to the end: the end's day of month reached the start's.
+    sal_Int32 nMonths = (aEnd.nYear - aStart.nYear) * 12 + aEnd.nMonth - aStart.nMonth;
+    if (aEnd.nDay < aStart.nDay)
+        --nMonths;
+    const bool bAnniversaryReached
+        = aEnd.nMonth > aStart.nMonth || (aEnd.nMonth == aStart.nMonth && aEnd.nDay >= aStart.nDay);
+
+    auto equals = [&aUnit](std::u16string_view aName) {
+        if (aUnit.size() != aName.size())
+            return false;
+        for (size_t i = 0; i < aName.size(); ++i)
+            if (rtl::toAsciiUpperCase(aUnit[i]) != aName[i])
+                return false;
+        return true;
+    };
+
+    if (equals(u"M"))
+        rfResult = nMonths;
+    else if (equals(u"Y"))
+        rfResult = nMonths / 12;
+    else if (equals(u"YM"))
+        rfResult = nMonths % 12;
+    else if (equals(u"MD"))
+    {
+        // Days after the start's day of month in the month before the end's; a day the month
+        // does not have runs on into the end's month.
+        rfResult = aEnd.nDay >= aStart.nDay
+                       ? aEnd.nDay - aStart.nDay
+                       : nEnd - daySerial(aEnd.nYear, aEnd.nMonth - 1, aStart.nDay);
+    }
+    else if (equals(u"YD"))
+    {
+        // Days since the last anniversary of the start.
+        const sal_Int32 nYear = bAnniversaryReached ? aEnd.nYear : aEnd.nYear - 1;
+        rfResult = nEnd - daySerial(nYear, aStart.nMonth, aStart.nDay);
+    }
+    else
+        return false;
+    return true;
+}
+
+Date Excel1900ShownDate(const SvNumberFormatter& rFormatter, double fSerial)
+{
+    return Excel1900ShownDate(rFormatter.IsHstExcel1900Dates(), rFormatter.GetNullDate(), fSerial);
+}
+
+Date Excel1900ShownDate(bool bExcel1900, const Date& rNullDate, double fSerial)
+{
+    const double fDay = rtl::math::approxFloor(fSerial);
+    if (!bExcel1900 || fDay >= nFirstCommonSerial)
+    {
+        Date aDate(rNullDate);
+        aDate.AddDays(static_cast<sal_Int32>(fDay));
+        return aDate;
+    }
+    const ShownDay aDay = shownDay(static_cast<sal_Int32>(fDay));
+    // Not normalized: 29/02/1900 keeps day 29 of February.
+    return Date(static_cast<sal_uInt16>(aDay.nDay), static_cast<sal_uInt16>(aDay.nMonth),
+                static_cast<sal_Int16>(aDay.nYear));
+}
+
+double Excel1900SerialOfDays(const SvNumberFormatter& rFormatter, double fDays)
+{
+    return rFormatter.IsHstExcel1900Dates() ? svl::hst::NullDateDaysToExcel1900Serial(fDays)
+                                            : fDays;
+}
+
+bool Excel1900DatePart(const SvNumberFormatter& rFormatter, double fSerial, sal_Int32 nDatePart,
+                       sal_Int32& rnResult)
+{
+    const double fDay = rtl::math::approxFloor(fSerial);
+    if (fDay >= nFirstCommonSerial || !rFormatter.IsHstExcel1900Dates())
+        return false;
+    const ShownDay aDay = shownDay(static_cast<sal_Int32>(fDay));
+    switch (nDatePart)
+    {
+        case css::sheet::DataPilotFieldGroupBy::YEARS:
+            rnResult = aDay.nYear;
+            return true;
+        case css::sheet::DataPilotFieldGroupBy::QUARTERS:
+            rnResult = 1 + (aDay.nMonth - 1) / 3;
+            return true;
+        case css::sheet::DataPilotFieldGroupBy::MONTHS:
+            rnResult = aDay.nMonth;
+            return true;
+        case css::sheet::DataPilotFieldGroupBy::DAYS:
+        {
+            // Day of a leap year, as the groups count days: 29/02 is day 60.
+            const sal_Int32 nBefore[] = { 0, 31, 60, 91, 121, 152, 182, 213, 244, 274, 305, 335 };
+            rnResult = nBefore[aDay.nMonth - 1] + aDay.nDay;
+            return true;
+        }
+        default:
+            return false;
+    }
+}
+}
+
+bool ScInterpreter::HstExcel1900AddIn(std::u16string_view aFuncName, sal_uInt8 nParamCount)
+{
+    const bool bEdate = sc::hst::isAddIn(aFuncName, u"GETEDATE");
+    const bool bEomonth = !bEdate && sc::hst::isAddIn(aFuncName, u"GETEOMONTH");
+    const bool bWeeknum = !bEdate && !bEomonth && sc::hst::isAddIn(aFuncName, u"GETWEEKNUM");
+    if (!(bEdate || bEomonth || bWeeknum) || !sc::hst::usesExcel1900(mrContext))
+        return false;
+    if (nParamCount < (bWeeknum ? 1 : 2) || nParamCount > 2 || sp < nParamCount)
+        return false;
+    // Ranges and arrays stay with the add-in call, which iterates them.
+    for (sal_uInt8 i = 1; i <= nParamCount; ++i)
+    {
+        switch (GetStackType(i))
+        {
+            case formula::svDouble:
+            case formula::svSingleRef:
+            case formula::svString:
+            case formula::svEmptyCell:
+            case formula::svMissing:
+                break;
+            default:
+                return false;
+        }
+    }
+
+    // Parameters as the add-in receives them: whole numbers.
+    double fSecond = 1.0;
+    if (nParamCount == 2)
+        fSecond = rtl::math::approxFloor(GetDouble());
+    const double fFirst = rtl::math::approxFloor(GetDouble());
+    if (nGlobalError != FormulaError::NONE)
+    {
+        PushError(nGlobalError);
+        return true;
+    }
+    const auto putBack = [&]() {
+        // Not a 1900 matter: the add-in computes it as usual.
+        PushDouble(fFirst);
+        if (nParamCount == 2)
+            PushDouble(fSecond);
+        return false;
+    };
+    if (fFirst < 1.0 || std::abs(fSecond) > 120000.0 || fFirst > 2958465.0)
+        return putBack();
+    const sal_Int32 nSerial = static_cast<sal_Int32>(fFirst);
+
+    if (bWeeknum)
+    {
+        sal_Int16 nFirstDayOfWeek;
+        sal_Int16 nMinimumDays;
+        sal_Int32 nWeek;
+        if (!sc::hst::weekType(static_cast<sal_Int32>(fSecond), nFirstDayOfWeek, nMinimumDays)
+            || !sc::hst::Excel1900WeekOfYear(mrContext, nSerial, nFirstDayOfWeek, nMinimumDays,
+                                             nWeek))
+            return putBack();
+        PushInt(nWeek);
+        return true;
+    }
+
+    // EDATE and EOMONTH: months are whole months, cut toward zero.
+    const sal_Int32 nMonths = static_cast<sal_Int32>(fSecond);
+    const sal_Int32 nResult = sc::hst::monthsLater(nSerial, nMonths, bEomonth);
+    if (nSerial >= sc::hst::nFirstCommonSerial && nResult >= sc::hst::nFirstCommonSerial)
+        return putBack();
+    if (nResult < 1)
+    {
+        // Before 01/01/1900.
+        PushNumError();
+        return true;
+    }
+    PushInt(nResult);
+    return true;
+}
