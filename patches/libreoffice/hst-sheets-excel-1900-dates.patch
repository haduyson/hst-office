+    CPPUNIT_ASSERT_EQUAL(0.0, val("A8"));
+
+    insertStringToCell(u"B1"_ustr, u"=YEAR(60)");
+    insertStringToCell(u"B2"_ustr, u"=MONTH(60)");
+    insertStringToCell(u"B3"_ustr, u"=DAY(60)");
+    insertStringToCell(u"B4"_ustr, u"=DAY(1)");
+    insertStringToCell(u"B5"_ustr, u"=MONTH(1)");
+    insertStringToCell(u"B6"_ustr, u"=YEAR(1)");
+    insertStringToCell(u"B7"_ustr, u"=DAY(59)");
+    insertStringToCell(u"B8"_ustr, u"=DAY(61)");
+    insertStringToCell(u"B9"_ustr, u"=MONTH(61)");
+    insertStringToCell(u"B10"_ustr, u"=DAY(45292)");
+    CPPUNIT_ASSERT_EQUAL(1900.0, val("B1"));
+    CPPUNIT_ASSERT_EQUAL(2.0, val("B2"));
+    CPPUNIT_ASSERT_EQUAL(29.0, val("B3"));
+    CPPUNIT_ASSERT_EQUAL(1.0, val("B4"));
+    CPPUNIT_ASSERT_EQUAL(1.0, val("B5"));
+    CPPUNIT_ASSERT_EQUAL(1900.0, val("B6"));
+    CPPUNIT_ASSERT_EQUAL(28.0, val("B7"));
+    CPPUNIT_ASSERT_EQUAL(1.0, val("B8"));
+    CPPUNIT_ASSERT_EQUAL(3.0, val("B9"));
+    CPPUNIT_ASSERT_EQUAL(1.0, val("B10"));
+
+    // WEEKDAY follows the serials: serial 1 is a Sunday, 60 a Wednesday, 61 a Thursday.
+    insertStringToCell(u"C1"_ustr, u"=WEEKDAY(1)");
+    insertStringToCell(u"C2"_ustr, u"=WEEKDAY(60)");
+    insertStringToCell(u"C3"_ustr, u"=WEEKDAY(61)");
+    insertStringToCell(u"C4"_ustr, u"=WEEKDAY(1,2)");
+    CPPUNIT_ASSERT_EQUAL(1.0, val("C1"));
+    CPPUNIT_ASSERT_EQUAL(4.0, val("C2"));
+    CPPUNIT_ASSERT_EQUAL(5.0, val("C3"));
+    CPPUNIT_ASSERT_EQUAL(7.0, val("C4"));
+
+    insertStringToCell(u"D1"_ustr, u"=DATEVALUE(\"1900-03-01\")");
+    insertStringToCell(u"D2"_ustr, u"=DATEVALUE(\"1900-01-01\")");
+    insertStringToCell(u"D3"_ustr, u"=DATEVALUE(\"1900-02-29\")");
+    insertStringToCell(u"D4"_ustr, u"=DATEVALUE(\"2/29/1900\")");
+    insertStringToCell(u"D5"_ustr, u"=DATEVALUE(\"2024-01-01\")");
+    CPPUNIT_ASSERT_EQUAL(61.0, val("D1"));
+    CPPUNIT_ASSERT_EQUAL(1.0, val("D2"));
+    CPPUNIT_ASSERT_EQUAL(60.0, val("D3"));
+    CPPUNIT_ASSERT_EQUAL(60.0, val("D4"));
+    CPPUNIT_ASSERT_EQUAL(45292.0, val("D5"));
+}
