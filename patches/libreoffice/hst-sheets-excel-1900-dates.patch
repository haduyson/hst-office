+        { "=ISOWEEKNUM(60)", 9 },      { "=ISOWEEKNUM(366)", 1 },
+        { "=ISOWEEKNUM(45292)", 1 },   { "=WEEKNUM(60,21)", 9 },
+        { "=DAYS360(1,61)", 60 },      { "=DAYS360(59,61)", 3 },
+        { "=DAYS360(60,61)", 1 },      { "=DAYS360(1,31)", 30 },
+        { "=DAYS360(60,91,TRUE)", 31 }, { "=DAYS360(45292,45351)", 58 },
+        { "=DAYS360(59,91)", 33 },     { "=DAYS360(31,60)", 29 },
+        { "=WEEKNUM(366,2)", 54 },     { "=WEEKNUM(100,21)", 15 },
+        { "=DATEDIF(31,61,\"md\")", -1 }, { "=DATEDIF(60,425,\"ym\")", 11 },
+        { "=DATEDIF(60,426,\"yd\")", 0 },  { "=NETWORKDAYS(1,100)", 71 },
+        { "=WORKDAY(55,5)", 62 },
+        { "=DATEDIF(1,61,\"m\")", 2 },  { "=DATEDIF(31,60,\"md\")", 29 },
+        { "=DATEDIF(1,60,\"yd\")", 59 }, { "=DATEDIF(1,367,\"y\")", 1 },
+        { "=DATEDIF(1,60,\"d\")", 59 },  { "=DATEDIF(45292,45351,\"md\")", 28 },
+        { "=EDATE(31,1)", 59 },        { "=EDATE(91,-1)", 59 },        { "=EDATE(60,12)", 425 },
+        { "=EDATE(61,-1)", 32 },       { "=EDATE(45292,1)", 45323 },
+        { "=EOMONTH(1,1)", 59 },       { "=EOMONTH(1,0)", 31 },
+        { "=EOMONTH(61,-1)", 59 },     { "=EOMONTH(45292,1)", 45351 },
