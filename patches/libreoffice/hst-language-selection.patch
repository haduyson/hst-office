+bool AutoRecovery::implts_sessionRestartBackupsComplete()
+{
+    // Snapshot of the cache; the documents themselves are queried without our mutex.
+    std::vector< std::tuple< css::uno::Reference< css::frame::XModel >, OUString, DocState > > lEntries;
+    {
+        CacheLockGuard aCacheLock(this, cppu::WeakComponentImplHelperBase::rBHelper.rMutex, m_nDocCacheLock, LOCK_FOR_CACHE_USE);
+        osl::MutexGuard g(cppu::WeakComponentImplHelperBase::rBHelper.rMutex);
+        for (auto const & info : m_lDocCache)
+            if (info.Document.is())
+                lEntries.emplace_back(info.Document, info.OldTempURL, info.DocumentState);
+    }
+
+    auto isModified = [](css::uno::Reference< css::uno::XInterface > const & xDocument)
+    {
+        css::uno::Reference< css::util::XModifiable > xModify(xDocument, css::uno::UNO_QUERY);
+        return xModify.is() && xModify->isModified();
+    };
+    for (auto const & [xDocument, sBackupURL, eState] : lEntries)
+    {
+        if (!isModified(xDocument))
+            continue; // reopened from its file
+        // a complete, non-empty recovery file holding the current state (Succeeded was cleared
+        // for documents changed since their last one; wasModifiedSinceLastSave() cannot be
+        // checked afterwards: storing may mark a Writer document dirty again)
+        osl::DirectoryItem aItem;
+        osl::FileStatus aStatus(osl_FileStatus_Mask_FileSize);
+        bool bBackup = !sBackupURL.isEmpty() && (eState & DocState::Succeeded)
+            && !(eState & DocState::Incomplete) && !(eState & DocState::Damaged)
+            && osl::DirectoryItem::get(sBackupURL, aItem) == osl::FileBase::E_None
+            && aItem.getFileStatus(aStatus) == osl::FileBase::E_None && aStatus.getFileSize() > 0;
+        // a password-protected document would ask for its password while being reopened
+        // (cancelling that discards the recovery file): keep such sessions on the prompting restart
+        comphelper::SequenceAsHashMap lArgs(xDocument->getArgs());
+        if (lArgs.find(utl::MediaDescriptor::PROP_ENCRYPTIONDATA) != lArgs.end()
+            || lArgs.find(utl::MediaDescriptor::PROP_PASSWORD) != lArgs.end())
+            bBackup = false;
+        if (!bBackup)
+        {
+            SAL_WARN("fwk.autorecovery", "session restart: no usable recovery file for " << xDocument->getURL());
+            return false;
+        }
+    }
+
+    // Documents AutoRecovery does not track (NoAutoSave, no XDocumentRecovery, ...) must
+    // not hold unsaved changes either.
+    css::uno::Reference< css::container::XEnumeration > xComponents(
+        css::frame::Desktop::create(m_xContext)->getComponents()->createEnumeration());
+    while (xComponents->hasMoreElements())
+    {
+        css::uno::Reference< css::frame::XModel > xModel(xComponents->nextElement(), css::uno::UNO_QUERY);
+        if (!xModel.is() || !isModified(xModel))
+            continue;
+        if (std::none_of(lEntries.begin(), lEntries.end(),
+                         [&xModel](auto const & rEntry) { return std::get<0>(rEntry) == xModel; }))
+        {
+            SAL_WARN("fwk.autorecovery", "session restart: untracked modified document " << xModel->getURL());
+            return false;
+        }
+    }
+    return true;
+}
+
+bool AutoRecovery::implts_doSessionRestart(const DispatchParams& aParams)
+{
+    SAL_INFO("fwk.autorecovery", "AutoRecovery::implts_doSessionRestart()");
+
+    // Unlike doSessionQuietQuit, no modified flag is ever reset: every document is stored to
+    // its recovery file first and only when all changed ones are safely on disk are they
+    // closed (closing a model asks nothing). The recovery entries keep the modified state, so
+    // the reopened documents are still marked as modified and can still be saved or discarded.
+    // Store as a session save (no idle wait; the entries survive the closing of their
+    // documents), but never store the original files ("always save the original" option).
+    bool bUserAutoSave;
+    {
+        osl::MutexGuard g(cppu::WeakComponentImplHelperBase::rBHelper.rMutex);
+        bUserAutoSave = bool(m_eJob & Job::UserAutoSave);
+        m_eJob &= ~Job::UserAutoSave;
+        m_eJob |= Job::SessionSave;
+    }
+    bool bAllSaved = false;
+    try
+    {
+        implts_verifyCacheAgainstDesktopDocumentList();
+        {
+            // The result flags of earlier AutoSave runs count only for documents unchanged since
+            // their last recovery file; all others must be stored successfully now.
+            std::vector< css::uno::Reference< css::frame::XModel > > lChanged;
+            {
+                CacheLockGuard aCacheLock(this, cppu::WeakComponentImplHelperBase::rBHelper.rMutex, m_nDocCacheLock, LOCK_FOR_CACHE_USE);
+                osl::MutexGuard g(cppu::WeakComponentImplHelperBase::rBHelper.rMutex);
+                for (auto const & info : m_lDocCache)
+                    if (info.Document.is())
+                        lChanged.push_back(info.Document);
+            }
+            std::erase_if(lChanged, [](css::uno::Reference< css::frame::XModel > const & xDocument)
+            {
+                css::uno::Reference< css::document::XDocumentRecovery > xRecovery(xDocument, css::uno::UNO_QUERY);
+                return xRecovery.is() && !xRecovery->wasModifiedSinceLastSave();
+            });
+            CacheLockGuard aCacheLock(this, cppu::WeakComponentImplHelperBase::rBHelper.rMutex, m_nDocCacheLock, LOCK_FOR_CACHE_USE);
+            osl::MutexGuard g(cppu::WeakComponentImplHelperBase::rBHelper.rMutex);
+            for (auto & info : m_lDocCache)
+            {
+                if (std::find(lChanged.begin(), lChanged.end(), info.Document) == lChanged.end())
+                    continue;
+                info.DocumentState &= ~DocState::Succeeded;
+                info.DocumentState &= ~DocState::Incomplete;
+            }
+        }
+        implts_doSessionSave(aParams);
+        bAllSaved = implts_sessionRestartBackupsComplete();
+    }
+    catch (const css::uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("fwk.autorecovery", "session restart: backup failed");
+    }
+    {
+        osl::MutexGuard g(cppu::WeakComponentImplHelperBase::rBHelper.rMutex);
+        m_eJob &= ~Job::SessionSave;
+        if (bUserAutoSave)
+            m_eJob |= Job::UserAutoSave;
+    }
+    {
+        CacheLockGuard aCacheLock(this, cppu::WeakComponentImplHelperBase::rBHelper.rMutex, m_nDocCacheLock, LOCK_FOR_CACHE_USE);
+        osl::MutexGuard g(cppu::WeakComponentImplHelperBase::rBHelper.rMutex);
+        // nothing is closed on failure: the documents stay open and are tracked normally;
+        // otherwise closing them below must not remove their recovery entries
+        for (auto & info : m_lDocCache)
+            info.IgnoreClosing = bAllSaved;
+    }
+    if (!bAllSaved)
+        return false;
+
+    // From here on the next start restores the session, even if closing fails half way or
+    // the termination is vetoed later (then the closed documents come back on the next start).
+    {
+        std::shared_ptr< comphelper::ConfigurationChanges > batch(comphelper::ConfigurationChanges::create());
+        officecfg::Office::Recovery::RecoveryInfo::SessionData::set(true, batch);
+        batch->commit();
+    }
+    impl_flushALLConfigChanges();
+
+    std::vector< css::uno::Reference< css::frame::XModel > > lDocuments;
+    {
+        // no mutex while calling into the documents (as in implts_prepareSessionShutdown)
+        CacheLockGuard aCacheLock(this, cppu::WeakComponentImplHelperBase::rBHelper.rMutex, m_nDocCacheLock, LOCK_FOR_CACHE_USE);
+        for (auto & info : m_lDocCache)
+        {
+            implts_stopModifyListeningOnDoc(info);
+            if (info.Document.is())
+                lDocuments.push_back(info.Document);
+        }
+    }
+    std::vector< css::uno::Reference< css::frame::XModel > > lStillOpen;
+    for (auto const & xDocument : lDocuments)
+    {
+        css::uno::Reference< css::util::XCloseable > xClose(xDocument, css::uno::UNO_QUERY);
+        try
+        {
+            if (xClose.is())
+                xClose->close(false);
+        }
+        catch (const css::uno::Exception&)
+        {
+            // A document that refuses to close stays open with its modified state intact and is
+            // tracked normally again; the termination then asks about it as usual.
+            TOOLS_WARN_EXCEPTION("fwk.autorecovery", "session restart: document not closed");
+            lStillOpen.push_back(xDocument);
+        }
+    }
+    {
+        CacheLockGuard aCacheLock(this, cppu::WeakComponentImplHelperBase::rBHelper.rMutex, m_nDocCacheLock, LOCK_FOR_CACHE_USE);
+        for (auto & info : m_lDocCache)
+        {
+            if (std::find(lStillOpen.begin(), lStillOpen.end(), info.Document) != lStillOpen.end())
+            {
+                info.IgnoreClosing = false;
+                implts_startModifyListeningOnDoc(info);
+            }
+            else
+                info.Document.clear();
+        }
+    }
+    return true;
+}
