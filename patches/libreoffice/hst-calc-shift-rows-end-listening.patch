             ScBroadcastAreaSlot** pp = ppSlots + nOff;
             ScBroadcastArea* pArea = nullptr;
+            // HST Office: an area always goes into the slot of its range start first, and
+            // StartListeningArea() looks for an existing area only there. If that slot does not
+            // have it, no slot has; if it still has listeners, the other slots have nothing to do.
+            auto bOtherSlotsIdle = [&pArea]() { return !pArea || pArea->GetBroadcaster().HasListeners(); };
             if (nOff == 0 && nEnd == mnBcaSlots-1)
             {
                 // Slightly optimized for 0,0,MAXCOL,MAXROW calls as they
@@ -845,6 +849,8 @@
                 {
                     if ( *pp )
                         (*pp)->EndListeningArea( rRange, bGroupListening, pListener, pArea);
+                    if (pp == ppSlots && bOtherSlotsIdle())
+                        break;
                 } while (++pp < pStop);
             }
             else
@@ -853,6 +859,8 @@
                 {
                     if ( *pp )
