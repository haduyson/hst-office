+CPPUNIT_TEST_FIXTURE(TestSharedFormula, testSharedFormulaWholeColumnShiftEndListening)
+{
+    // Formula groups made by an import listen to their range references as a group. Inserting or
+    // deleting rows above such a group ends the listening cell by cell, and each cell also tries
+    // to end an individual listening it never started. For a whole-column reference that miss was
+    // looked up in every broadcast slot the column spans (about 900), so one inserted or deleted
+    // row in a workbook with 20 000 whole-column VLOOKUPs took seconds. The same lookups into a
+    // bounded range give the reference time.
+    sc::AutoCalcSwitch aACSwitch(*m_pDoc, true);
+    m_pDoc->InsertTab(0, u"Whole"_ustr);
+    m_pDoc->InsertTab(1, u"Bounded"_ustr);
+    m_pDoc->InsertTab(2, u"Cat"_ustr);
+
+    constexpr SCROW nCat = 50;
+    constexpr SCROW nRows = 20000;
+    for (SCROW i = 0; i < nCat; ++i)
+    {
+        m_pDoc->SetValue(ScAddress(0, i, 2), i);
+        m_pDoc->SetValue(ScAddress(1, i, 2), i * 10.0);
+    }
+    {
+        ScDocumentImport aImport(*m_pDoc);
+        for (SCROW i = 0; i < nRows; ++i)
+        {
+            const OUString aRow = OUString::number(i + 1);
+            for (SCTAB nTab : { 0, 1 })
+            {
+                aImport.setNumericCell(ScAddress(0, i, nTab), i % nCat);
+                aImport.setFormulaCell(ScAddress(1, i, nTab),
+                                       nTab == 0 ? "=VLOOKUP(A" + aRow + ";$Cat.$A:$B;2;0)"
+                                                 : "=VLOOKUP(A" + aRow + ";$Cat.$A$1:$B$50;2;0)",
+                                       formula::FormulaGrammar::GRAM_NATIVE);
+            }
+        }
+        aImport.finalize();
+    }
+    m_pDoc->CalcAll();
+
+    for (SCTAB nTab : { 0, 1 })
+    {
+        const ScFormulaCell* pFC = m_pDoc->GetFormulaCell(ScAddress(1, 100, nTab));
+        CPPUNIT_ASSERT(pFC);
+        CPPUNIT_ASSERT_MESSAGE("the lookups must form one group", pFC->IsShared());
+        CPPUNIT_ASSERT_EQUAL(nRows, pFC->GetSharedLength());
+        CPPUNIT_ASSERT_EQUAL(50.0, m_pDoc->GetValue(ScAddress(1, 105, nTab))); // key 5
+    }
+
+    ScDocFunc& rFunc = m_xDocShell->GetDocFunc();
+    auto shiftRows = [&](SCTAB nTab) {
+        ScMarkData aMark(m_pDoc->GetSheetLimits());
+        aMark.SelectOneTable(nTab);
+        const ScRange aRow(0, 10, nTab, m_pDoc->MaxCol(), 10, nTab);
+        const auto aStart = std::chrono::steady_clock::now();
+        for (int k = 0; k < 2; ++k)
+        {
+            rFunc.InsertCells(aRow, &aMark, INS_INSROWS_BEFORE, true, true);
+            rFunc.DeleteCells(aRow, &aMark, DelCellCmd::Rows, true);
+        }
+        return std::chrono::duration<double>(std::chrono::steady_clock::now() - aStart).count();
+    };
+    // the fastest of two runs each, so that a busy machine does not decide the result
+    double fBounded = shiftRows(1);
+    double fWhole = shiftRows(0);
+    fBounded = std::min(fBounded, shiftRows(1));
+    fWhole = std::min(fWhole, shiftRows(0));
+    std::cerr << "insert+delete rows above 20000 grouped lookups: whole columns " << fWhole
+              << " s, bounded range " << fBounded << " s" << std::endl;
+    CPPUNIT_ASSERT_LESS(3.0 * fBounded + 0.2, fWhole);
+
+    // the groups still listen to the catalogue after the shifts
+    m_pDoc->SetValue(ScAddress(1, 5, 2), 777.0);
+    for (SCTAB nTab : { 0, 1 })
+    {
+        CPPUNIT_ASSERT_EQUAL(777.0, m_pDoc->GetValue(ScAddress(1, 5, nTab)));
+        CPPUNIT_ASSERT_EQUAL(777.0, m_pDoc->GetValue(ScAddress(1, 105, nTab)));
+        CPPUNIT_ASSERT_EQUAL(777.0, m_pDoc->GetValue(ScAddress(1, nRows - 45, nTab))); // key 5
+    }
+    // a single cell listening individually to the same whole columns still stops listening
+    m_pDoc->SetString(ScAddress(3, 0, 0), u"=SUM($Cat.$B:$B)"_ustr);
+    CPPUNIT_ASSERT_EQUAL(12250.0 - 50.0 + 777.0, m_pDoc->GetValue(ScAddress(3, 0, 0)));
+    m_pDoc->DeleteRow(0, 0, m_pDoc->MaxCol(), 0, 0, 1);
+    m_pDoc->SetValue(ScAddress(1, 6, 2), 1.0);
+    CPPUNIT_ASSERT_EQUAL(1.0, m_pDoc->GetValue(ScAddress(1, 5, 0))); // former row 7 (key 6)
+
+    m_pDoc->DeleteTab(2);
+    m_pDoc->DeleteTab(1);
+    m_pDoc->DeleteTab(0);
+}
+
 CPPUNIT_PLUGIN_IMPLEMENT();
 
