+/// HST: a GUID that stays the same from save to save (name-based, in the layout of RFC 4122 version
+/// 3), so that saving an unchanged form gives the same module bytes.
+OUString lcl_stableGuid(std::u16string_view rName)
+{
+    const OString aName = OUStringToOString(rName, RTL_TEXTENCODING_UTF8);
+    sal_uInt8 a[RTL_DIGEST_LENGTH_MD5];
+    rtl_digest_MD5(aName.getStr(), aName.getLength(), a, RTL_DIGEST_LENGTH_MD5);
+    a[6] = (a[6] & 0x0F) | 0x30;
+    a[8] = (a[8] & 0x3F) | 0x80;
+    char aText[37];
+    snprintf(aText, sizeof aText, "%02X%02X%02X%02X-%02X%02X-%02X%02X-%02X%02X-%02X%02X%02X%02X%02X%02X",
+             a[0], a[1], a[2], a[3], a[4], a[5], a[6], a[7], a[8], a[9], a[10], a[11], a[12], a[13], a[14], a[15]);
+    return OUString::createFromAscii(aText);
+}
