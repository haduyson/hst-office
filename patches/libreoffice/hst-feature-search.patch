+void MenuContentHandler::gatherAddonMenuContent(uno::Reference<container::XNameAccess> const& xItems,
+                                                MenuContent& rMenuContent)
+{
+    if (!xItems.is())
+        return;
+    std::u16string_view aMenuLabelSeparator = AllSettings::GetLayoutRTL() ? u" ◂ " : u" ▸ ";
+    // configmgr returns the set elements in the order the menu shows them
+    for (OUString const& rName : xItems->getElementNames())
+    {
+        uno::Reference<container::XNameAccess> xNode(xItems->getByName(rName), uno::UNO_QUERY);
+        if (!xNode.is())
+            continue;
+        if (!isAddonForModule(getAddonProperty<OUString>(xNode, u"Context"_ustr),
+                              m_sModuleLongName))
+            continue;
+
+        MenuContent aNewContent;
+        aNewContent.m_aCommandURL = getAddonProperty<OUString>(xNode, u"URL"_ustr);
+        aNewContent.m_aMenuLabel
+            = getAddonProperty<OUString>(xNode, u"Title"_ustr).replaceAll("~", "");
+        if (aNewContent.m_aMenuLabel.isEmpty())
+            continue;
+        if (!rMenuContent.m_aFullLabelWithPath.isEmpty())
+            aNewContent.m_aFullLabelWithPath
+                = rMenuContent.m_aFullLabelWithPath + aMenuLabelSeparator;
+        aNewContent.m_aFullLabelWithPath += aNewContent.m_aMenuLabel;
+        if (aNewContent.m_aCommandURL.startsWith(".uno:"))
+        {
+            auto aCommandProperties = vcl::CommandInfoProvider::GetCommandProperties(
+                aNewContent.m_aCommandURL, m_sModuleLongName);
+            aNewContent.m_aTooltip = vcl::CommandInfoProvider::GetTooltipForCommand(
+                aNewContent.m_aCommandURL, aCommandProperties, m_xFrame);
+        }
+        setSearchKeys(aNewContent);
+
+        gatherAddonMenuContent(
+            getAddonProperty<uno::Reference<container::XNameAccess>>(xNode, u"Submenu"_ustr),
+            aNewContent);
+        rMenuContent.m_aSubMenuContent.push_back(std::move(aNewContent));
+    }
 }
 
