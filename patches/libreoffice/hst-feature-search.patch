 using namespace css;
 
+OUString foldForSearch(OUString const& rText)
+{
+    icu::UnicodeString aText(reinterpret_cast<const UChar*>(rText.getStr()), rText.getLength());
+    UErrorCode eStatus = U_ZERO_ERROR;
+    const icu::Normalizer2* pNFD = icu::Normalizer2::getNFDInstance(eStatus);
+    if (U_SUCCESS(eStatus))
+    {
+        icu::UnicodeString aDecomposed = pNFD->normalize(aText, eStatus);
+        if (U_SUCCESS(eStatus))
+            aText = aDecomposed;
+    }
+    aText.foldCase();
+
+    OUStringBuffer aKey(aText.length());
+    bool bSpace = true; // collapse runs of white space, drop leading white space
+    for (int32_t i = 0; i < aText.length(); i = aText.moveIndex32(i, 1))
+    {
+        UChar32 c = aText.char32At(i);
+        if (u_charType(c) == U_NON_SPACING_MARK || c == '~')
+            continue;
+        if (c == 0x0111) // đ (Đ is case-folded to đ); it has no decomposition
+            c = 'd';
+        if (u_isUWhiteSpace(c))
+        {
+            if (!bSpace)
+                aKey.append(' ');
+            bSpace = true;
+            continue;
+        }
+        bSpace = false;
+        aKey.appendUtf32(c);
+    }
+    return comphelper::string::stripEnd(aKey.makeStringAndClear(), ' ');
+}
+
+namespace
+{
+// rNeedle occurs in rHaystack at the start of a word
+bool containsAtWordStart(OUString const& rHaystack, OUString const& rNeedle)
+{
+    for (sal_Int32 nPos = rHaystack.indexOf(rNeedle); nPos >= 0;
+         nPos = rHaystack.indexOf(rNeedle, nPos + 1))
+    {
+        if (nPos == 0 || !u_isalnum(rHaystack[nPos - 1]))
+            return true;
+    }
+    return false;
+}
+
+// every white-space separated word of rQuery occurs in one of the texts
+bool containsAllWords(OUString const& rQuery, OUString const& rText1, OUString const& rText2)
+{
+    sal_Int32 nIndex = 0;
+    do
+    {
+        const OUString aWord(o3tl::getToken(rQuery, 0, ' ', nIndex));
+        if (!aWord.isEmpty() && rText1.indexOf(aWord) < 0 && rText2.indexOf(aWord) < 0)
+            return false;
+    } while (nIndex >= 0);
+    return true;
+}
+
+// Addons.xcu "Context": empty = every module, else a comma-separated list of module identifiers
+bool isAddonForModule(OUString const& rContext, std::u16string_view rModule)
+{
+    if (rContext.isEmpty())
+        return true;
+    sal_Int32 nIndex = 0;
+    do
+    {
+        if (o3tl::trim(o3tl::getToken(rContext, 0, ',', nIndex)) == rModule)
+            return true;
+    } while (nIndex >= 0);
+    return false;
+}
+
+template <typename T>
+T getAddonProperty(uno::Reference<container::XNameAccess> const& xNode, OUString const& rName)
+{
+    T aValue{};
+    if (xNode->hasByName(rName))
+        xNode->getByName(rName) >>= aValue;
+    return aValue;
+}
+}
