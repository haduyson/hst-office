+void MenuContentHandler::setSearchKeys(MenuContent& rContent)
+{
+    rContent.m_aSearchableMenuLabel = foldForSearch(rContent.m_aFullLabelWithPath);
+    rContent.m_aSearchableLabel = foldForSearch(rContent.m_aMenuLabel);
