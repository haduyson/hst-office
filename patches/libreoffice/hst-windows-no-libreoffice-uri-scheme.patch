--- a/scp2/source/ooo/registryitem_ooo.scp
+++ b/scp2/source/ooo/registryitem_ooo.scp
@@ -647,6 +647,35 @@
 	Styles = ();
 End
 
-// registering vnd.libreoffice.command URI scheme handler
-REGISTER_URI_HANDLER( vnd.libreoffice.command, vnd_libreoffice_command, gid_Module_Root )
-REGISTRY_ENTRY_CAPABILITIES_URL(vnd.libreoffice.command, vnd_libreoffice_command, gid_Module_Root, vnd.libreoffice.command)
+// HST Office does not register LibreOffice's vnd.libreoffice.command URI scheme with Windows (the
+// office still understands it on its command line). HSTOffice.OfficeURI is the ProgID behind the
+// Capabilities URLAssociations of the Office URI schemes (ms-word, ms-excel, ...); it is not a URI
+// scheme itself (no "URL Protocol" value).
+RegistryItem gid_Regitem_HSTOffice_OfficeURI
+    ParentID = PREDEFINED_HKEY_CLASSES_ROOT;
+    ModuleID = gid_Module_Root;
+    Subkey = "HSTOffice.OfficeURI";
+    Value = "%PRODUCTNAME URI";
+End
+
+RegistryItem gid_Regitem_HSTOffice_OfficeURI_UseOriginalUrlEncoding
+    ParentID = PREDEFINED_HKEY_CLASSES_ROOT;
+    ModuleID = gid_Module_Root;
+    Subkey = "HSTOffice.OfficeURI";
+    Name = "UseOriginalUrlEncoding";
+    Value = "#1";
+End
+
+RegistryItem gid_Regitem_HSTOffice_OfficeURI_DefaultIcon
+    ParentID = PREDEFINED_HKEY_CLASSES_ROOT;
+    ModuleID = gid_Module_Root;
+    Subkey = "HSTOffice.OfficeURI\DefaultIcon";
+    Value = "<progpath>\program\soffice.bin,0";
+End
+
+RegistryItem gid_Regitem_HSTOffice_OfficeURI_shell_open_command
+    ParentID = PREDEFINED_HKEY_CLASSES_ROOT;
+    ModuleID = gid_Module_Root;
+    Subkey = "HSTOffice.OfficeURI\shell\open\command";
+    Value = "\"<progpath>\program\soffice.exe\" \"%1\"";
+End
