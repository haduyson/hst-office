+class HstRibbonBanner::ViewImpl final : public hst::banner::View
+{
+public:
+    explicit ViewImpl(HstRibbonBanner& rBanner)
+        : mrBanner(rBanner)
+    {
+    }
+
+    Size BannerSize() const override { return mrBanner.GetOutputSizePixel(); }
+    double BannerDpi() const override { return mrBanner.GetDPIScaleFactor(); }
+    double BannerSurfaceScale() const override
+    {
+        return hst::banner::Core::SurfaceScale(*mrBanner.GetOutDev());
+    }
+    bool BannerInView() const override
+    {
+        if (!mrBanner.IsReallyVisible() || mrBanner.GetOutputSizePixel().IsEmpty())
+            return false;
+        const WorkWindow* pWork = dynamic_cast<const WorkWindow*>(mrBanner.GetSystemWindow());
+        return !pWork || !pWork->IsMinimized();
+    }
+    bool BannerPaused() const override { return mrBanner.mbHover || mrBanner.HasFocus(); }
+    void BannerInvalidate() override { mrBanner.Invalidate(); }
+    void BannerSetName(const OUString& rName) override
+    {
+        mrBanner.SetAccessibleName(rName);
+        mrBanner.SetQuickHelpText(rName);
+    }
+
+private:
+    HstRibbonBanner& mrBanner;
+};
+
+HstRibbonBanner::HstRibbonBanner(vcl::Window* pParent)
+    : Control(pParent, WB_TABSTOP)
+    , mpView(std::make_unique<ViewImpl>(*this))
+    , mxCore(new hst::banner::Core(*mpView))
+{
+    SetPaintTransparent(true);
+    SetAccessibleRole(accessibility::AccessibleRole::HYPER_LINK);
+    SetPointer(PointerStyle::RefHand);
+}
+
+HstRibbonBanner::~HstRibbonBanner() { disposeOnce(); }
+
+void HstRibbonBanner::dispose()
+{
+    if (mxCore.is())
+    {
+        mxCore->Detach();
+        mxCore.clear();
+    }
+    Control::dispose();
+}
+
+void HstRibbonBanner::Place(const tools::Rectangle& rSlot)
+{
+    if (rSlot.IsEmpty())
+    {
+        if (IsVisible())
+            Hide(); // StateChanged tells the core
+        else if (mxCore.is())
+            mxCore->Hidden();
+        return;
+    }
+    if (GetPosPixel() != rSlot.TopLeft() || GetSizePixel() != rSlot.GetSize())
+        SetPosSizePixel(rSlot.TopLeft(), rSlot.GetSize()); // Resize tells the core
+    if (!IsVisible())
+        Show();
+    else if (mxCore.is())
+        mxCore->Shown(false);
+}
+
+void HstRibbonBanner::Resize()
+{
+    Control::Resize();
+    // the frame's slot is sized by the window's border directly, not through Place
+    if (mxCore.is() && IsVisible() && !GetOutputSizePixel().IsEmpty())
+        mxCore->Shown(true);
+}
+
+void HstRibbonBanner::StateChanged(StateChangedType nType)
+{
+    Control::StateChanged(nType);
+    if (nType != StateChangedType::Visible || !mxCore.is())
+        return;
+    if (IsVisible() && !GetOutputSizePixel().IsEmpty())
+        mxCore->Shown(false);
+    else
+        mxCore->Hidden();
+}
+
+void HstRibbonBanner::Paint(vcl::RenderContext& rRenderContext, const tools::Rectangle&)
+{
+    if (mxCore.is())
+        mxCore->Paint(rRenderContext, rRenderContext.GetSettings().GetStyleSettings(), HasFocus());
+}
+
+void HstRibbonBanner::MouseMove(const MouseEvent& rMEvt)
+{
+    mbHover = !rMEvt.IsLeaveWindow(); // hover pauses the rotation
+    Control::MouseMove(rMEvt);
+}
+
+void HstRibbonBanner::MouseButtonDown(const MouseEvent& rMEvt)
+{
+    if (rMEvt.IsLeft())
+    {
+        mbPressed = true;
+        GrabFocus();
+        return;
+    }
+    Control::MouseButtonDown(rMEvt);
+}
+
+void HstRibbonBanner::MouseButtonUp(const MouseEvent& rMEvt)
+{
+    if (rMEvt.IsLeft() && mbPressed)
+    {
+        mbPressed = false;
+        if (mxCore.is() && tools::Rectangle(Point(), GetOutputSizePixel()).Contains(rMEvt.GetPosPixel()))
+            mxCore->Activate();
+        return;
+    }
+    Control::MouseButtonUp(rMEvt);
+}
+
+void HstRibbonBanner::KeyInput(const KeyEvent& rKEvt)
+{
+    const vcl::KeyCode& rKey = rKEvt.GetKeyCode();
+    if (mxCore.is() && !rKey.GetModifier()
+        && (rKey.GetCode() == KEY_RETURN || rKey.GetCode() == KEY_SPACE))
+    {
+        mxCore->Activate();
+        return;
+    }
+    Control::KeyInput(rKEvt);
+}
+
+void HstRibbonBanner::GetFocus()
+{
+    Control::GetFocus();
+    Invalidate(); // focus ring; focus pauses the rotation
+}
+
+void HstRibbonBanner::LoseFocus()
+{
+    Control::LoseFocus();
+    Invalidate();
+}
+
+void HstRibbonBanner::DataChanged(const DataChangedEvent& rDCEvt)
+{
+    Control::DataChanged(rDCEvt);
+    if (rDCEvt.GetType() == DataChangedEventType::SETTINGS && mxCore.is())
+        mxCore->SettingsChanged();
+}
