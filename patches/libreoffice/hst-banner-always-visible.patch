+#pragma once
+
+// HST Office: the rotating HASON TECH solution banner (docs/BANNERS.md). Every document window shows
+// it, in every user interface, and HST PDF shows it in its toolbar row; there is no option to hide or
+// disable it. Two views share one engine (content from org.hst.office.BannerFeed, rotation, display
+// counting, click, painting):
+//   HstRibbonBanner  a VCL control: the Tabbed ribbon (placed by sfx2's NotebookbarTabControl), the
+//                    other notebookbars (placed beside them by the window border) and the toolbar
+//                    user interfaces (placed in the top docking area by framework's toolbar layout);
+//   HstBannerWidget  a weld drawing area (HST PDF's toolbar row).
+// It lives in vcl so that sfx2, framework and xmlsecurity can all host it.
+
+#include <rtl/ref.hxx>
+#include <vcl/ctrl.hxx>
+#include <vcl/dllapi.h>
+#include <vcl/weld/customweld.hxx>
+
+#include <memory>
+
+namespace hst::banner
+{
+class Core;
+class View;
+}
+
+class VCL_DLLPUBLIC HstRibbonBanner final : public Control
+{
+public:
+    explicit HstRibbonBanner(vcl::Window* pParent);
+    virtual ~HstRibbonBanner() override;
+    virtual void dispose() override;
+
+    /** Place the banner in the device-pixel rectangle rSlot of the parent (empty: hide). */
+    void Place(const tools::Rectangle& rSlot);
+    /** The width (px) the ribbon's wide slot had at the last layout, 0 before; it is kept while the
+        room changes by less than the hysteresis (hst::banner::wideSlotWidth). */
+    tools::Long WideSlotWidth() const { return mnWideSlotWidth; }
+    void SetWideSlotWidth(tools::Long nWidth) { mnWideSlotWidth = nWidth; }
+
+    virtual void Paint(vcl::RenderContext& rRenderContext, const tools::Rectangle& rRect) override;
+    virtual void Resize() override;
+    virtual void StateChanged(StateChangedType nType) override;
+    virtual void MouseMove(const MouseEvent& rMEvt) override;
+    virtual void MouseButtonDown(const MouseEvent& rMEvt) override;
+    virtual void MouseButtonUp(const MouseEvent& rMEvt) override;
+    virtual void KeyInput(const KeyEvent& rKEvt) override;
+    virtual void GetFocus() override;
+    virtual void LoseFocus() override;
+    virtual void DataChanged(const DataChangedEvent& rDCEvt) override;
+
+private:
+    class ViewImpl;
+    friend class ViewImpl;
+
+    std::unique_ptr<ViewImpl> mpView;
+    rtl::Reference<hst::banner::Core> mxCore;
+    bool mbHover = false;
+    bool mbPressed = false;
+    tools::Long mnWideSlotWidth = 0;
+};
+
+class VCL_DLLPUBLIC HstBannerWidget final : public weld::CustomWidgetController
+{
+public:
+    /** pHost: the VCL window that holds the welded content (when its top-level window is minimized the
+        banner is not in view). */
+    explicit HstBannerWidget(vcl::Window* pHost);
+    virtual ~HstBannerWidget() override;
+
+    /** Smallest slot: 260 x 75 logical px, the size at which every artwork stays legible. */
+    static Size MinimumSize(double fDpi);
+
+    virtual void SetDrawingArea(weld::DrawingArea* pDrawingArea) override;
+    virtual void Paint(vcl::RenderContext& rRenderContext, const tools::Rectangle& rRect) override;
+    virtual void Resize() override;
+    virtual bool MouseButtonDown(const MouseEvent& rMEvt) override;
+    virtual bool MouseMove(const MouseEvent& rMEvt) override;
+    virtual bool MouseButtonUp(const MouseEvent& rMEvt) override;
+    virtual bool KeyInput(const KeyEvent& rKEvt) override;
+    virtual void GetFocus() override;
+    virtual void LoseFocus() override;
+    virtual void StyleUpdated() override;
+
+private:
+    class ViewImpl;
+    friend class ViewImpl;
+
+    VclPtr<vcl::Window> mpHost;
+    std::unique_ptr<ViewImpl> mpView;
+    rtl::Reference<hst::banner::Core> mxCore;
+    bool mbHover = false;
+    bool mbPressed = false;
+};
