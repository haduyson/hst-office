-#pragma once
-
-// HST Office: geometry of the HASON TECH solution banner in the Tabbed notebookbar.
-// Plain integer arithmetic without LibreOffice types, so it can be unit tested on its own
-// (tests/unit/test_ribbon_banner_geometry.py compiles it from the patch with a test driver).
-//
-// The slot adapts to the ribbon, never the other way round: it fits inside the tab page that
-// already holds the 2-row groups, keeps the exact ratio of the artwork (360:104 wide, 160:104
-// compact) and is capped at the artwork's logical size. Images of any pixel size are
-// aspect-fitted into the slot. Windows narrower than 1280 logical px show the compact artwork,
-// so the banner always keeps a slot while the groups get most of the width.
-
-#include <algorithm>
-#include <cmath>
-#include <cstdlib>
-
-namespace hst::banner
-{
-struct Rect
-{
-    long x = 0;
-    long y = 0;
-    long w = 0;
-    long h = 0;
-};
-
-constexpr long ART_WIDTH = 360; // logical px of the @1x artwork
-constexpr long COMPACT_ART_WIDTH = 160; // logical px of the @1x compact artwork (same height)
-constexpr long ART_HEIGHT = 104;
-// The slot is centred vertically on the tab page (the per-app position the hstsystem admin preview
-// uses); false anchors it at the top of every page. Owner question pending: one line to switch.
-constexpr bool SLOT_CENTRED = true;
-constexpr long MIN_WINDOW_WIDTH = 1280; // narrower windows keep the whole width for the groups
-// The wide slot narrows down to this many logical px (keeping the artwork's ratio) when the current tab's
-// groups do not fit beside the full 360 px: the bundled artwork's text stays readable at 1x down to here.
-constexpr long MIN_WIDE_ART_WIDTH = 260;
-// A new width of the narrowed wide slot replaces the last one only when it differs by this many logical
-// px, so small changes of the room do not move the banner.
-constexpr long WIDE_HYSTERESIS = 12;
-constexpr long MIN_PAGE_HEIGHT = 60; // compact ribbons (one row) never show the banner
-
-inline long scaled(long nLogical, double fDpi) { return std::lround(nLogical * fDpi); }
-
-/** Whether the banner is shown for a top-level window of nWindowWidth pixels at fDpi. */
-inline bool visibleFor(long nWindowWidth, long nPageHeight, double fDpi)
-{
-    return nWindowWidth >= scaled(MIN_WINDOW_WIDTH, fDpi)
-           && nPageHeight >= scaled(MIN_PAGE_HEIGHT, fDpi);
-}
-
-enum class Mode
-{
-    Hidden, // one-row (compact) ribbons
-    Wide, // windows of at least MIN_WINDOW_WIDTH: the 360x104 artwork
-    Compact // narrower windows: the 160x104 artwork
-};
-
-/** Which banner a top-level window of nWindowWidth pixels with a page nPageHeight high shows. */
-inline Mode modeFor(long nWindowWidth, long nPageHeight, double fDpi)
-{
-    if (nPageHeight < scaled(MIN_PAGE_HEIGHT, fDpi))
-        return Mode::Hidden;
-    return visibleFor(nWindowWidth, nPageHeight, fDpi) ? Mode::Wide : Mode::Compact;
-}
-
-/** Logical width of the @1x artwork for a mode (0 when hidden). */
-inline long artWidth(Mode eMode)
-{
-    return eMode == Mode::Wide ? ART_WIDTH : eMode == Mode::Compact ? COMPACT_ART_WIDTH : 0;
-}
-
-/** Banner slot at the right end of the full tab page rectangle rPage (pixels), for artwork
-    nArtWidth logical px wide: the largest rectangle with the artwork's ratio that fits the page
-    height (minus margins) and the artwork's logical size, centred vertically on the page. */
-inline Rect slotFor(const Rect& rPage, double fDpi, long nArtWidth = ART_WIDTH, long nMaxWidth = 0)
-{
-    const long nVMargin = scaled(2, fDpi);
-    const long nRightMargin = scaled(4, fDpi);
-    const long nRoom = std::max(0L, rPage.h - 2 * nVMargin);
-    Rect aSlot;
-    if (nArtWidth <= 0)
-        return Rect{ rPage.x + rPage.w - nRightMargin, rPage.y + nVMargin, 0, 0 };
-    aSlot.w = std::min(scaled(nArtWidth, fDpi), nRoom * nArtWidth / ART_HEIGHT);
-    if (nMaxWidth > 0)
-        aSlot.w = std::min(aSlot.w, nMaxWidth); // a narrowed wide slot (wideSlotWidth)
-    aSlot.h = std::min(nRoom, aSlot.w * ART_HEIGHT / nArtWidth);
-    aSlot.x = rPage.x + rPage.w - nRightMargin - aSlot.w;
-    aSlot.y = rPage.y + nVMargin + (SLOT_CENTRED ? (nRoom - aSlot.h) / 2 : 0);
-    return aSlot;
-}
-
-/** Width left to the groups of the page when the banner occupies rSlot. */
-inline long pageWidthBeside(const Rect& rPage, const Rect& rSlot, double fDpi)
-{
-    return std::max(0L, rSlot.x - scaled(8, fDpi) - rPage.x);
-}
-
-/** HST Office: the width in px of the wide slot (windows of at least MIN_WINDOW_WIDTH) on the tab page
-    rPage whose groups need nFullWidth px at their largest: the full artwork width when they fit beside it,
-    else the room they leave (the 8 px gap and the 4 px right margin aside), down to MIN_WIDE_ART_WIDTH.
-    nFullWidth < 0 (not measured yet): the full width. nPrevious (the last width, 0 for none) stays while
-    the new width is within WIDE_HYSTERESIS of it. The slot keeps the artwork's ratio (slotFor), so the
-    drawn artwork and the click target narrow together and stay centred vertically on the page. */
-inline long wideSlotWidth(const Rect& rPage, long nFullWidth, long nPrevious, double fDpi)
-{
-    const long nMax = scaled(ART_WIDTH, fDpi);
-    const long nMin = scaled(MIN_WIDE_ART_WIDTH, fDpi);
-    const long nWant = nFullWidth < 0
-                           ? nMax
-                           : std::clamp(rPage.w - nFullWidth - scaled(8, fDpi) - scaled(4, fDpi), nMin, nMax);
-    if (nPrevious >= nMin && nPrevious <= nMax && nWant != nMax && nWant != nMin
-        && std::abs(nWant - nPrevious) < scaled(WIDE_HYSTERESIS, fDpi))
-        return nPrevious;
-    return nWant;
-}
-
-/** Aspect-fit an image of nImageW x nImageH into rBox, centred; never larger than rBox. */
-inline Rect fit(const Rect& rBox, long nImageW, long nImageH)
-{
-    Rect aResult = rBox;
-    if (nImageW <= 0 || nImageH <= 0 || rBox.w <= 0 || rBox.h <= 0)
-        return Rect{ rBox.x, rBox.y, 0, 0 };
-    // compare rBox.w / rBox.h with nImageW / nImageH without rounding
-    if (rBox.w * nImageH > nImageW * rBox.h)
-        aResult.w = std::max(1L, rBox.h * nImageW / nImageH); // box wider: full height
-    else
-        aResult.h = std::max(1L, rBox.w * nImageH / nImageW); // box taller: full width
-    aResult.x = rBox.x + (rBox.w - aResult.w) / 2;
-    aResult.y = rBox.y + (rBox.h - aResult.h) / 2;
-    return aResult;
-}
-
-/** Artwork variant (1, 2 or 3) for an image drawn nDeviceHeight device pixels high: the exact
-    variant when the size matches one, else the next larger one so that it is only ever
-    downscaled (high quality) and never upscaled. */
-inline int sourceScale(long nDeviceHeight)
-{
-    long nLevel = (nDeviceHeight + ART_HEIGHT - 1) / ART_HEIGHT;
-    if (nDeviceHeight % ART_HEIGHT != 0)
-        ++nLevel;
-    return static_cast<int>(std::clamp(nLevel, 1L, 3L));
-}
-}
