+#include <vcl/window.hxx>
+#include <vcl/wrkwin.hxx>
+
+class HstBannerWidget::ViewImpl final : public hst::banner::View
+{
+public:
+    explicit ViewImpl(HstBannerWidget& rWidget)
+        : mrWidget(rWidget)
+    {
+    }
+
+    Size BannerSize() const override { return mrWidget.GetOutputSizePixel(); }
+
+    double BannerDpi() const override
+    {
+        return mrWidget.mpHost ? mrWidget.mpHost->GetDPIScaleFactor()
+                               : Application::GetDefaultDevice()->GetDPIScaleFactor();
+    }
+
+    double BannerSurfaceScale() const override
+    {
+        weld::DrawingArea* pArea = mrWidget.GetDrawingArea();
+        return pArea ? hst::banner::Core::SurfaceScale(pArea->get_ref_device()) : 1.0;
+    }
+
+    bool BannerInView() const override
+    {
+        if (!mrWidget.GetDrawingArea() || !mrWidget.IsReallyVisible()
+            || mrWidget.GetOutputSizePixel().IsEmpty())
+            return false;
+        if (!mrWidget.mpHost || mrWidget.mpHost->isDisposed() || !mrWidget.mpHost->IsReallyVisible())
+            return false;
+        const WorkWindow* pWork = dynamic_cast<const WorkWindow*>(mrWidget.mpHost->GetSystemWindow());
+        return !pWork || !pWork->IsMinimized();
+    }
+
+    bool BannerPaused() const override
+    {
+        return mrWidget.mbHover || (mrWidget.GetDrawingArea() && mrWidget.HasFocus());
+    }
+
+    void BannerInvalidate() override { mrWidget.Invalidate(); }
+
+    void BannerSetName(const OUString& rName) override
+    {
+        if (weld::DrawingArea* pArea = mrWidget.GetDrawingArea())
+        {
+            pArea->set_accessible_name(rName);
+            pArea->set_tooltip_text(rName);
+        }
+    }
+
+private:
+    HstBannerWidget& mrWidget;
+};
+
+HstBannerWidget::HstBannerWidget(vcl::Window* pHost)
+    : mpHost(pHost)
+    , mpView(std::make_unique<ViewImpl>(*this))
+    , mxCore(new hst::banner::Core(*mpView))
+{
+}
+
+HstBannerWidget::~HstBannerWidget()
+{
+    mxCore->Detach();
+    mxCore.clear();
+}
+
+Size HstBannerWidget::MinimumSize(double fDpi)
+{
+    const hst::banner::StripSlot aSlot = hst::banner::stripSlot(hst::banner::minStripHeight(fDpi), fDpi);
+    return Size(aSlot.w, aSlot.h);
+}
+
+void HstBannerWidget::SetDrawingArea(weld::DrawingArea* pDrawingArea)
+{
+    weld::CustomWidgetController::SetDrawingArea(pDrawingArea);
+    const Size aMin = MinimumSize(mpView->BannerDpi());
+    pDrawingArea->set_size_request(aMin.Width(), aMin.Height());
+    pDrawingArea->set_can_focus(true);
+    SetPointer(PointerStyle::RefHand);
+}
+
+void HstBannerWidget::Paint(vcl::RenderContext& rRenderContext, const tools::Rectangle&)
+{
+    mxCore->Paint(rRenderContext, rRenderContext.GetSettings().GetStyleSettings(), HasFocus());
+}
+
+void HstBannerWidget::Resize()
+{
+    weld::CustomWidgetController::Resize();
+    if (!GetOutputSizePixel().IsEmpty())
+        mxCore->Shown(true);
+}
+
+bool HstBannerWidget::MouseMove(const MouseEvent& rMEvt)
+{
+    mbHover = !rMEvt.IsLeaveWindow(); // hover pauses the rotation
+    return false;
+}
+
+bool HstBannerWidget::MouseButtonDown(const MouseEvent& rMEvt)
+{
+    if (!rMEvt.IsLeft())
+        return false;
+    mbPressed = true;
+    GrabFocus();
+    return true;
+}
+
+bool HstBannerWidget::MouseButtonUp(const MouseEvent& rMEvt)
+{
+    if (!rMEvt.IsLeft() || !mbPressed)
+        return false;
+    mbPressed = false;
+    if (tools::Rectangle(Point(), GetOutputSizePixel()).Contains(rMEvt.GetPosPixel()))
+        mxCore->Activate();
+    return true;
+}
+
+bool HstBannerWidget::KeyInput(const KeyEvent& rKEvt)
+{
+    const vcl::KeyCode& rKey = rKEvt.GetKeyCode();
+    if (rKey.GetModifier() || (rKey.GetCode() != KEY_RETURN && rKey.GetCode() != KEY_SPACE))
+        return false;
+    mxCore->Activate();
+    return true;
+}
+
+void HstBannerWidget::GetFocus() { Invalidate(); } // focus ring; focus pauses the rotation
+
+void HstBannerWidget::LoseFocus() { Invalidate(); }
+
+void HstBannerWidget::StyleUpdated()
+{
+    mxCore->SettingsChanged();
+    weld::CustomWidgetController::StyleUpdated();
+}
