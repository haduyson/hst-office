+
+using namespace css;
+
+namespace hst::banner
+{
+namespace
+{
+constexpr sal_Int32 MAX_IMAGE_BYTES = 300 * 1024; // data-layer limit per image
+constexpr sal_Int32 MAX_MANIFEST_BYTES = 512 * 1024;
+constexpr int FADE_STEPS = 10;
+constexpr sal_uInt64 SHOWN_MS = 1000; // a card counts once it stood this long in view
+constexpr OUString EXTENSION_DIR
+    = u"$BRAND_BASE_DIR/" LIBO_SHARE_FOLDER "/extensions/hst-vietnamese-tools/"_ustr;
+}
+
+/** One rotation slot as delivered to the main thread. */
+struct Data
+{
+    OUString aId, aName, aTagline, aUrl;
+    std::vector<sal_uInt8> aImage;
+    sal_Int32 nRotateSeconds = 10;
+    sal_Int32 nSlot = 0;
+    int nScale = 1;
+    bool bOk = false;
+    bool bLast = true; // the worker posts nothing after this result
+};
+
+namespace
+{
+OUString fromUtf8(const std::string& rText) { return OStringToOUString(rText, RTL_TEXTENCODING_UTF8); }
+
+bool readFile(const OUString& rUrl, std::string& rOut, sal_Int32 nLimit)
+{
+    osl::File aFile(rUrl);
+    if (aFile.open(osl_File_OpenFlag_Read) != osl::FileBase::E_None)
+        return false;
+    sal_uInt64 nSize = 0;
+    if (aFile.getSize(nSize) != osl::FileBase::E_None || nSize == 0
+        || nSize > static_cast<sal_uInt64>(nLimit))
+        return false;
+    rOut.resize(nSize);
+    sal_uInt64 nRead = 0;
+    return aFile.read(rOut.data(), nSize, nRead) == osl::FileBase::E_None && nRead == nSize;
+}
+
+/** Click targets the data layer may deliver: HTTPS, or the local test server, which the data layer
+    only accepts in test-stamped packages (release packages are HTTPS-only before this point). */
+bool allowedClick(const OUString& rUrl)
+{
+    return rUrl.startsWith("https://") || rUrl.startsWith("http://127.0.0.1:")
+           || rUrl.startsWith("http://127.0.0.1/");
+}
+
+/** The selected slot from the JSON of org.hst.office.BannerFeed (docs/BANNERS.md). */
+bool parseService(const OUString& rJson, Data& rData)
+{
+    std::stringstream aStream(std::string(OUStringToOString(rJson, RTL_TEXTENCODING_UTF8)));
+    boost::property_tree::ptree aTree;
+    boost::property_tree::read_json(aStream, aTree);
+    rData.nRotateSeconds = aTree.get<sal_Int32>("rotateSeconds", 10);
+    rData.nSlot = aTree.get<sal_Int32>("slot", 0);
+    const auto& rItems = aTree.get_child("items");
+    if (rItems.empty())
+        return false;
+    const auto& rItem = rItems.front().second;
+    rData.aId = fromUtf8(rItem.get<std::string>("id"));
+    rData.aName = fromUtf8(rItem.get<std::string>("name"));
+    rData.aTagline = fromUtf8(rItem.get<std::string>("tagline"));
+    rData.aUrl = fromUtf8(rItem.get<std::string>("click_url_with_utm"));
+    uno::Sequence<sal_Int8> aBytes;
+    comphelper::Base64::decode(aBytes, fromUtf8(rItem.get<std::string>("image_base64")));
+    if (aBytes.getLength() == 0 || aBytes.getLength() > MAX_IMAGE_BYTES)
+        return false;
+    rData.aImage.assign(aBytes.begin(), aBytes.end());
+    return allowedClick(rData.aUrl);
+}
+
+uno::Reference<task::XJob> feed()
+{
+    const uno::Reference<uno::XComponentContext>& xContext = comphelper::getProcessComponentContext();
+    return uno::Reference<task::XJob>(
+        xContext->getServiceManager()->createInstanceWithContext(u"org.hst.office.BannerFeed"_ustr, xContext),
+        uno::UNO_QUERY);
+}
+
+bool fromService(sal_Int32 nSlot, int nScale, Data& rData)
+{
+    try
+    {
+        uno::Reference<task::XJob> xFeed(feed());
+        if (!xFeed.is())
+            return false;
+        OUString aJson;
+        if (!(xFeed->execute({ { u"Scale"_ustr, uno::Any(static_cast<double>(nScale)) },
+                               { u"Slot"_ustr, uno::Any(nSlot) } })
+              >>= aJson)
+            || aJson.isEmpty())
+            return false;
+        return parseService(aJson, rData);
+    }
+    catch (...)
+    {
+        return false; // service missing or failing: installed defaults
+    }
+}
+
+/** Click URL as the data layer builds it: the query is replaced by the shared UTM block. */
+OUString clickUrl(std::u16string_view aUrl, const OUString& rSource, const OUString& rCampaign)
+{
+    const size_t nCut = aUrl.find_first_of(u"?#");
+    return OUString::Concat(aUrl.substr(0, nCut)) + "?utm_source=" + rSource
+           + "&utm_medium=banner&utm_campaign=" + rCampaign;
+}
+
+/** Installed defaults straight from the bundled extension (service unavailable). */
+bool fromBundled(sal_Int32 nSlot, int nScale, Data& rData)
+{
+    try
+    {
+        OUString aDir(EXTENSION_DIR);
+        rtl::Bootstrap::expandMacros(aDir);
+        std::string aManifest, aSolutions;
+        if (!readFile(aDir + "data/banners.json", aManifest, MAX_MANIFEST_BYTES)
+            || !readFile(aDir + "data/solutions.json", aSolutions, MAX_MANIFEST_BYTES))
+            return false;
+        boost::property_tree::ptree aTree, aUtm;
+        std::stringstream aManifestStream(aManifest), aSolutionsStream(aSolutions);
+        boost::property_tree::read_json(aManifestStream, aTree);
+        boost::property_tree::read_json(aSolutionsStream, aUtm);
+        std::vector<const boost::property_tree::ptree*> aItems;
+        for (const auto& rChild : aTree.get_child("items"))
+            if (rChild.second.get_child_optional("image"))
+                aItems.push_back(&rChild.second);
+        if (aItems.empty())
+            return false;
+        std::stable_sort(aItems.begin(), aItems.end(), [](const auto* a, const auto* b) {
+            const int nA = a->template get<int>("order", 0), nB = b->template get<int>("order", 0);
+            return nA != nB ? nA < nB
+                            : a->template get<std::string>("id") < b->template get<std::string>("id");
+        });
+        rData.nSlot = nSlot >= 0 ? nSlot % static_cast<sal_Int32>(aItems.size()) : 0;
+        const auto& rItem = *aItems[rData.nSlot];
+        const std::string aPath = rItem.get<std::string>("image." + std::to_string(nScale) + "x.url");
+        if (aPath.rfind("banners/", 0) != 0 || aPath.find("..") != std::string::npos)
+            return false;
+        std::string aImage;
+        if (!readFile(aDir + fromUtf8(aPath), aImage, MAX_IMAGE_BYTES))
+            return false;
+        rData.aImage.assign(aImage.begin(), aImage.end());
+        rData.nRotateSeconds = aTree.get<sal_Int32>("rotateSeconds", 10);
+        rData.aId = fromUtf8(rItem.get<std::string>("id"));
+        rData.aName = fromUtf8(rItem.get<std::string>("name"));
+        rData.aTagline = fromUtf8(rItem.get<std::string>("tagline"));
+        rData.aUrl = clickUrl(fromUtf8(rItem.get<std::string>("url")),
+                              fromUtf8(aUtm.get<std::string>("utm.source")),
+                              fromUtf8(aUtm.get<std::string>("utm.campaign")));
+        return true;
+    }
+    catch (...)
+    {
+        return false;
+    }
+}
+}
+
+class FetchThread final : public salhelper::Thread
+{
+public:
+    FetchThread(Core* pCore, sal_Int32 nSlot, int nScale, bool bBundledFirst)
+        : salhelper::Thread("HstBanner")
+        , mxCore(pCore)
+        , mnSlot(nSlot)
+        , mnScale(nScale)
+        , mbBundledFirst(bBundledFirst)
+    {
+    }
+
+private:
+    void execute() override
+    {
+        if (mbBundledFirst)
+        {
+            // first paint: installed defaults at once, then whatever the feed selects
+            auto pFirst = std::make_unique<Data>();
+            pFirst->nScale = mnScale;
+            pFirst->bLast = false;
+            pFirst->bOk = fromBundled(mnSlot, mnScale, *pFirst);
+            if (pFirst->bOk)
+                post(std::move(pFirst));
+        }
+        auto pData = std::make_unique<Data>();
+        pData->nScale = mnScale;
+        pData->bOk = fromService(mnSlot, mnScale, *pData);
+        if (!pData->bOk && !mbBundledFirst)
+        {
+            // service unavailable: the installed defaults decide
+            pData = std::make_unique<Data>();
+            pData->nScale = mnScale;
+            pData->bOk = fromBundled(mnSlot, mnScale, *pData);
+        }
+        post(std::move(pData));
+        SolarMutexGuard aGuard;
+        mxCore.clear();
+    }
+
+    void post(std::unique_ptr<Data> pData)
+    {
+        SolarMutexGuard aGuard; // the view cannot go away meanwhile
+        if (!mxCore->Detached())
+            mxCore->Deliver(std::move(pData));
+    }
+
+    rtl::Reference<Core> mxCore;
+    sal_Int32 mnSlot;
+    int mnScale;
+    bool mbBundledFirst;
+};
+
+/** Where a click goes: the service probes the click counter off the UI thread (at most 1.5 s) and
+    answers with the home page when it is down. Without the service the URL is opened as it is. */
+class ClickThread final : public salhelper::Thread
+{
+public:
+    ClickThread(Core* pCore, OUString aUrl)
+        : salhelper::Thread("HstBannerClick")
+        , mxCore(pCore)
+        , maUrl(std::move(aUrl))
+    {
+    }
+
+private:
+    void execute() override
+    {
+        OUString aTarget;
+        try
+        {
+            uno::Reference<task::XJob> xFeed(feed());
+            if (xFeed.is())
+                xFeed->execute({ { u"ClickUrl"_ustr, uno::Any(maUrl) } }) >>= aTarget;
+        }
+        catch (...)
+        {
+        }
+        if (!allowedClick(aTarget))
+            aTarget = maUrl;
+        SolarMutexGuard aGuard;
+        if (!mxCore->Detached())
+            mxCore->DeliverClick(aTarget);
+        mxCore.clear();
+    }
+
+    rtl::Reference<Core> mxCore;
+    OUString maUrl;
+};
+
+/** Tells the data layer that a card was displayed (it counts per day and id, and sends the counts at
+    most once a day). The UI thread never calls Python; nothing is posted back. */
+class ShownThread final : public salhelper::Thread
+{
+public:
+    explicit ShownThread(OUString aId)
+        : salhelper::Thread("HstBannerShown")
+        , maId(std::move(aId))
+    {
+    }
+
+private:
+    void execute() override
+    {
+        try
+        {
+            uno::Reference<task::XJob> xFeed(feed());
+            if (xFeed.is()) // older data layers ignore the argument and answer with a slot
+                xFeed->execute({ { u"Shown"_ustr, uno::Any(maId) } });
+        }
+        catch (...)
+        {
+            // service missing or failing: the display is not counted
+        }
+    }
+
+    OUString maId;
+};
+
+Core::Core(View& rView)
+    : mpView(&rView)
+    , maRotateTimer("sfx2 HstBanner rotate")
+    , maFadeTimer("sfx2 HstBanner fade")
+    , maShownTimer("sfx2 HstBanner shown")
+{
+    maRotateTimer.SetInvokeHandler(LINK(this, Core, RotateHdl));
+    maRotateTimer.SetTimeout(mnRotateSeconds * 1000);
+    maFadeTimer.SetInvokeHandler(LINK(this, Core, FadeHdl));
+    maFadeTimer.SetTimeout(30);
+    maShownTimer.SetInvokeHandler(LINK(this, Core, ShownHdl));
+    maShownTimer.SetTimeout(SHOWN_MS);
+}
+
+Core::~Core() { assert(!mpView); }
+
+void Core::Detach()
+{
+    maRotateTimer.Stop();
+    maFadeTimer.Stop();
+    maShownTimer.Stop();
+    mpView = nullptr;
+    // the workers take the SolarMutex to post their results: let them finish
+    for (salhelper::Thread* pThread : { static_cast<salhelper::Thread*>(mxThread.get()),
+                                        static_cast<salhelper::Thread*>(mxClickThread.get()),
+                                        static_cast<salhelper::Thread*>(mxShownThread.get()) })
+        if (pThread)
+        {
+            SolarMutexReleaser aReleaser;
+            pThread->join();
+        }
+    mxThread.clear();
+    mxClickThread.clear();
+    mxShownThread.clear();
+}
+
+int Core::ScaleForSize() const
+{
+    // the variant that matches the fitted image height in device pixels
+    const Size aSize = mpView->BannerSize();
+    // Size is tools::Long (64-bit on Windows), Rect holds long: MSVC rejects the implicit narrowing.
+    const Rect aImage = fit(Rect{ 0, 0, static_cast<long>(aSize.Width()), static_cast<long>(aSize.Height()) },
+                            ART_WIDTH, ART_HEIGHT);
+    return sourceScale(std::lround(aImage.h * mpView->BannerSurfaceScale()));
+}
+
+void Core::Request(sal_Int32 nSlot)
+{
+    if (mbRequested || !mpView)
+        return;
+    mbRequested = true; // the previous worker has posted its last result
+    try
+    {
+        mxThread = new FetchThread(this, nSlot, ScaleForSize(), maId.isEmpty());
+        mxThread->launch();
+    }
+    catch (const std::exception&)
+    {
+        // no thread available: never disturb editing, try again at the next interval
+        mxThread.clear();
+        mbRequested = false;
+        maRotateTimer.Start();
+    }
+}
+
+void Core::Deliver(std::unique_ptr<Data> pData)
+{
+    // may run on the worker thread (SolarMutex held): hand over to the main loop, keeping the core alive
+    acquire();
+    Application::PostUserEvent(LINK(this, Core, DeliverHdl), pData.release(), false);
+}
+
+IMPL_LINK(Core, DeliverHdl, void*, p, void)
+{
+    std::unique_ptr<Data> pData(static_cast<Data*>(p));
+    rtl::Reference<Core> xThis(this); // drops the reference taken in Deliver at the end
+    release();
+    if (!mpView)
+        return;
+    if (pData->bLast)
+        mbRequested = false;
+    if (!pData->bOk)
+    {
+        // nothing new (service and installed defaults unavailable): keep the current item
+        if (pData->bLast)
+            maRotateTimer.Start();
+        return;
+    }
+    Bitmap aBitmap;
+    {
+        // PNG, JPEG or WebP as verified by the data layer; decoder errors leave the banner as is
+        SvMemoryStream aStream(pData->aImage.data(), pData->aImage.size(), StreamMode::READ);
+        Graphic aGraphic;
+        if (GraphicFilter::GetGraphicFilter().ImportGraphic(aGraphic, u"", aStream) == ERRCODE_NONE)
+            aBitmap = aGraphic.GetBitmap();
+    }
+    if (aBitmap.IsEmpty())
+    {
+        // decoder error: try the next entry, without disturbing editing
+        if (pData->bLast && ++mnFailures < 3)
+            Request(pData->nSlot + 1);
+        else if (pData->bLast)
+            maRotateTimer.Start();
+        return;
+    }
+    mnFailures = 0;
+    mnSlot = pData->nSlot;
+    mnRotateSeconds = std::clamp<sal_Int32>(pData->nRotateSeconds, 5, 60);
+    if (pData->aId != maId && !maImage.IsEmpty() && MiscSettings::IsAnimatedOthersAllowed())
+    {
+        maOld = maImage;
+        maOldScaled = maImageScaled;
+        mnFadeStep = 1;
+        maFadeTimer.Start();
+    }
+    maImage = aBitmap;
+    maImageScaled = Bitmap();
+    mnSourceScale = pData->nScale;
+    maId = pData->aId;
+    maUrl = pData->aUrl;
+    if (maId != maShownId)
+        StartShown();
+    mpView->BannerSetName(pData->aName + u" — " + pData->aTagline);
+    mpView->BannerInvalidate();
+    if (pData->bLast)
+    {
+        maRotateTimer.SetTimeout(mnRotateSeconds * 1000);
+        maRotateTimer.Start();
+    }
+}
+
+IMPL_LINK_NOARG(Core, RotateHdl, Timer*, void)
+{
+    if (!mpView || !mpView->BannerInView() || mpView->BannerPaused())
+    {
+        maRotateTimer.Start(); // try again after a full interval
+        return;
+    }
+    Request(mnSlot + 1);
+}
+
+double Core::SurfaceScale(const OutputDevice& rDevice)
+{
+#if defined(MACOSX)
+    (void)rDevice;
+    return 2.0; // Retina is the norm; Quartz downsamples the @2x art on other displays
+#elif USE_HEADLESS_CODE && !defined(_WIN32)
+    using GetScale = void (*)(void*, double*, double*);
+    static GetScale pGetScale
+        = reinterpret_cast<GetScale>(dlsym(RTLD_DEFAULT, "cairo_surface_get_device_scale"));
+    const SystemGraphicsData aData = rDevice.GetSystemGfxData();
+    double fX = 1.0, fY = 1.0;
+    if (pGetScale && aData.pSurface)
+        pGetScale(aData.pSurface, &fX, &fY);
+    return std::clamp(fY, 1.0, 3.0);
+#else
+    (void)rDevice;
+    return 1.0; // Windows: VCL pixels are device pixels (GetDPIScaleFactor)
+#endif
+}
+
+bool Core::InView() const { return mpView && !maImage.IsEmpty() && mpView->BannerInView(); }
+
+void Core::StartShown()
+{
+    // a new card (another id than the last one): the previous one, if it stood less than a second, is not counted
+    maShownId = maId;
+    mbShownPending = true;
+    mbShownInView = InView();
+    maShownTimer.Start();
+}
+
+IMPL_LINK_NOARG(Core, ShownHdl, Timer*, void)
+{
+    if (!mbShownPending || !mpView)
+        return;
+    const bool bInView = InView();
+    if (!bInView || !mbShownInView)
+    {
+        // not in view for the whole second (hidden slot, minimized window): check again
+        mbShownInView = bInView;
+        maShownTimer.Start();
+        return;
+    }
+    mbShownPending = false;
+    ReportShown();
+}
+
+void Core::ReportShown()
+{
+    // one count per card change; the previous report (one call into Python) finished long ago,
+    // because a card stands at least five seconds
+    try
+    {
+        mxShownThread = new ShownThread(maShownId);
+        mxShownThread->launch();
+    }
+    catch (const std::exception&)
+    {
+        mxShownThread.clear(); // no thread available: this display is not counted
+    }
+}
+
+IMPL_LINK_NOARG(Core, FadeHdl, Timer*, void)
+{
+    if (++mnFadeStep >= FADE_STEPS)
+    {
+        mnFadeStep = 0;
+        maOld = Bitmap();
+        maOldScaled = Bitmap();
+    }
+    else
+        maFadeTimer.Start();
+    if (mpView)
+        mpView->BannerInvalidate();
+}
+
+void Core::Shown(bool bResized)
+{
+    if (!mpView)
+        return;
+    if (mbShownPending && !maShownTimer.IsActive())
+    {
+        mbShownInView = false; // the full second starts at the next check
+        maShownTimer.Start();
+    }
+    if (maId.isEmpty() || (bResized && ScaleForSize() != mnSourceScale))
+        Request(mnSlot); // first content, or the same slot again for the new scale
+    else if (!maRotateTimer.IsActive() && !mbRequested)
+        maRotateTimer.Start();
+}
+
+void Core::Hidden()
+{
+    maRotateTimer.Stop();
+    maShownTimer.Stop(); // a hidden slot shows nothing: start the second again when it is back
+}
+
+const Bitmap& Core::Prepared(const Bitmap& rSource, Bitmap& rCache, const Size& rDevice)
+{
+    if (rCache.IsEmpty() || rCache.GetSizePixel() != rDevice)
+    {
+        rCache = rSource;
+        if (rCache.GetSizePixel() != rDevice)
+            rCache.Scale(rDevice, BmpScaleFlag::BestQuality);
+    }
+    return rCache;
+}
+
+void Core::DrawArt(vcl::RenderContext& rRenderContext, const Bitmap& rSource, Bitmap& rCache, double fAlpha)
+{
+    const Size aOut = mpView->BannerSize();
+    const long nInset = scaled(3, mpView->BannerDpi());
+    const Size aSourceSize = rSource.GetSizePixel();
+    // the image's own pixel size never changes the slot: aspect-fit, centred
+    const Rect aBox{ nInset, nInset, static_cast<long>(aOut.Width()) - 2 * nInset,
+                     static_cast<long>(aOut.Height()) - 2 * nInset };
+    const Rect aFit = fit(aBox, aSourceSize.Width(), aSourceSize.Height());
+    if (aFit.w <= 0 || aFit.h <= 0)
+        return;
+    const double fScale = SurfaceScale(rRenderContext);
+    const Size aDevice(std::lround(aFit.w * fScale), std::lround(aFit.h * fScale));
+    const Bitmap& rDraw = Prepared(rSource, rCache, aDevice);
+    if (fAlpha >= 1.0)
+        rRenderContext.DrawBitmap(Point(aFit.x, aFit.y), Size(aFit.w, aFit.h), rDraw);
+    else
+        rRenderContext.DrawTransformedBitmapEx(
+            basegfx::utils::createScaleTranslateB2DHomMatrix(aFit.w, aFit.h, aFit.x, aFit.y), rDraw, fAlpha);
+}
+
+void Core::Paint(vcl::RenderContext& rRenderContext, const StyleSettings& rStyle, bool bFocused)
+{
+    if (!mpView)
+        return;
+    const tools::Rectangle aAll(Point(), mpView->BannerSize());
+    const long nRadius = scaled(8, mpView->BannerDpi());
+    rRenderContext.Push(vcl::PushFlags::LINECOLOR | vcl::PushFlags::FILLCOLOR);
+    if (rStyle.GetWindowColor().IsDark() || rStyle.GetDialogColor().IsDark())
+    {
+        // the artwork is designed for light backgrounds: a light rounded card in dark mode
+        rRenderContext.SetLineColor();
+        rRenderContext.SetFillColor(Color(0xF4, 0xF6, 0xF9));
+        rRenderContext.DrawRect(aAll, nRadius, nRadius);
+    }
+    if (!maOld.IsEmpty() && mnFadeStep > 0)
+    {
+        DrawArt(rRenderContext, maOld, maOldScaled, 1.0);
+        if (!maImage.IsEmpty())
+            DrawArt(rRenderContext, maImage, maImageScaled, static_cast<double>(mnFadeStep) / FADE_STEPS);
+    }
+    else if (!maImage.IsEmpty())
+        DrawArt(rRenderContext, maImage, maImageScaled, 1.0);
+    if (bFocused)
+    {
+        rRenderContext.SetFillColor();
+        rRenderContext.SetLineColor(rStyle.GetHighlightColor());
+        tools::Rectangle aRing(aAll);
+        aRing.AdjustRight(-1);
+        aRing.AdjustBottom(-1);
+        rRenderContext.DrawRect(aRing, nRadius, nRadius);
+        aRing.AdjustLeft(1);
+        aRing.AdjustTop(1);
+        aRing.AdjustRight(-1);
+        aRing.AdjustBottom(-1);
+        rRenderContext.DrawRect(aRing, nRadius, nRadius);
+    }
+    rRenderContext.Pop();
+}
+
+void Core::SettingsChanged()
+{
+    maImageScaled = Bitmap();
+    maOldScaled = Bitmap();
+    if (mpView)
+        mpView->BannerInvalidate(); // light/dark card follows the theme
+}
+
+void Core::Activate()
+{
+    using namespace std::chrono_literals;
+    if (!mpView || maUrl.isEmpty() || mbClickPending || std::chrono::steady_clock::now() - maLastOpen < 1s)
+        return;
+    mbClickPending = true;
+    try
+    {
+        mxClickThread = new ClickThread(this, maUrl);
+        mxClickThread->launch();
+    }
+    catch (const std::exception&)
+    {
+        mxClickThread.clear();
+        DeliverClick(maUrl);
+    }
+}
+
+void Core::DeliverClick(const OUString& rUrl)
+{
+    acquire();
+    Application::PostUserEvent(LINK(this, Core, OpenHdl), new OUString(rUrl), false);
+}
+
+IMPL_LINK(Core, OpenHdl, void*, p, void)
+{
+    std::unique_ptr<OUString> pUrl(static_cast<OUString*>(p));
+    rtl::Reference<Core> xThis(this);
+    release();
+    mbClickPending = false;
+    maLastOpen = std::chrono::steady_clock::now();
+    if (!mpView)
+        return;
+    try
+    {
+        system::SystemShellExecute::create(comphelper::getProcessComponentContext())
+            ->execute(*pUrl, OUString(), system::SystemShellExecuteFlags::URIS_ONLY);
+    }
+    catch (const uno::Exception&)
+    {
+        // no dialog: a banner must never interrupt editing
+    }
+}
+}
