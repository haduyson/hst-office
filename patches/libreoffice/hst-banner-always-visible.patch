-void HstRibbonBanner::dispose()
-{
-    maRotateTimer.Stop();
-    maFadeTimer.Stop();
-    maShownTimer.Stop();
-    if (mxThread.is())
-    {
-        SolarMutexReleaser aReleaser; // the worker takes the SolarMutex to post its result
-        mxThread->join();
-    }
-    if (mxClickThread.is())
-    {
-        SolarMutexReleaser aReleaser;
-        mxClickThread->join();
-    }
-    if (mxShownThread.is())
-    {
-        SolarMutexReleaser aReleaser;
-        mxShownThread->join();
