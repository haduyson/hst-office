+#pragma once
+
+// HST Office: what every HASON TECH banner does, whatever window shows it (docs/BANNERS.md): content from
+// org.hst.office.BannerFeed on worker threads (installed defaults when it is unavailable), rotation, the
+// one-second display count, the click and the painting of the artwork. Two views show it (vcl/HstBanner.hxx):
+// HstRibbonBanner, a VCL control, and HstBannerWidget, a weld drawing area. A view lives on the main
+// thread and tells the core what it needs through View.
+
+#include <rtl/ref.hxx>
+#include <rtl/ustring.hxx>
+#include <salhelper/simplereferenceobject.hxx>
+#include <tools/gen.hxx>
+#include <tools/link.hxx>
+#include <vcl/bitmap.hxx>
+#include <vcl/timer.hxx>
+
+#include <chrono>
+#include <memory>
+
+class OutputDevice;
+namespace vcl
+{
+typedef OutputDevice RenderContext;
+}
+class StyleSettings;
+
+namespace hst::banner
+{
+class ClickThread;
+class FetchThread;
+class ShownThread;
+struct Data;
+
+/** The window that shows a banner core. */
+class View
+{
+public:
+    virtual ~View() = default;
+    /** Output size of the slot in device-independent VCL pixels. */
+    virtual Size BannerSize() const = 0;
+    /** VCL DPI factor of the view. */
+    virtual double BannerDpi() const = 0;
+    /** Backing scale of the view's surface (gtk HiDPI, Retina), on top of the DPI factor. */
+    virtual double BannerSurfaceScale() const = 0;
+    /** The slot is drawn in a visible, not minimized window. */
+    virtual bool BannerInView() const = 0;
+    /** Hovered or focused: the rotation waits. */
+    virtual bool BannerPaused() const = 0;
+    virtual void BannerInvalidate() = 0;
+    /** Accessible name and tooltip: "<name> — <tagline>". */
+    virtual void BannerSetName(const OUString& rName) = 0;
+};
+
+class Core final : public salhelper::SimpleReferenceObject
+{
+public:
+    explicit Core(View& rView);
+    virtual ~Core() override;
+
+    /** The view goes away: stop the timers and wait for the workers (they need the SolarMutex). */
+    void Detach();
+    bool Detached() const { return mpView == nullptr; }
+
+    /** The slot was shown, resized or moved; bResized: its size changed. */
+    void Shown(bool bResized);
+    /** The slot was hidden: nothing rotates and the display second starts again when it is back. */
+    void Hidden();
+    /** Click, Enter or Space: open the item's destination (counted by the data layer). */
+    void Activate();
+    void Paint(vcl::RenderContext& rRenderContext, const StyleSettings& rStyle, bool bFocused);
+    /** Theme or scale changed: drop the cached downscales. */
+    void SettingsChanged();
+
+    /** Backing scale of rDevice's surface (gtk HiDPI, macOS Retina), on top of the VCL DPI factor. */
+    static double SurfaceScale(const OutputDevice& rDevice);
+
+    /** Worker results (any thread, SolarMutex held); handed over to the main loop. */
+    void Deliver(std::unique_ptr<Data> pData);
+    void DeliverClick(const OUString& rUrl);
+
+private:
+    void Request(sal_Int32 nSlot);
+    int ScaleForSize() const;
+    const Bitmap& Prepared(const Bitmap& rSource, Bitmap& rCache, const Size& rDevice);
+    void DrawArt(vcl::RenderContext& rRenderContext, const Bitmap& rSource, Bitmap& rCache, double fAlpha);
+    bool InView() const;
+    void StartShown();
+    void ReportShown();
+
+    DECL_LINK(RotateHdl, Timer*, void);
+    DECL_LINK(FadeHdl, Timer*, void);
+    DECL_LINK(DeliverHdl, void*, void);
+    DECL_LINK(OpenHdl, void*, void);
+    DECL_LINK(ShownHdl, Timer*, void);
+
+    View* mpView;
+    rtl::Reference<FetchThread> mxThread;
+    rtl::Reference<ClickThread> mxClickThread;
+    rtl::Reference<ShownThread> mxShownThread;
+    std::chrono::steady_clock::time_point maLastOpen; // double clicks open one browser tab
+    bool mbClickPending = false;
+    Timer maRotateTimer;
+    Timer maFadeTimer;
+    Timer maShownTimer; // one-second check of a new card
+    OUString maShownId; // last card change; the same card is not counted again
+    bool mbShownPending = false; // maShownId is not counted yet
+    bool mbShownInView = false; // it was in view at the previous check
+    OUString maId;
+    OUString maUrl;
+    Bitmap maImage; // decoded source variant of the current item
+    Bitmap maOld; // previous item while fading
+    Bitmap maImageScaled; // high-quality downscale of maImage for the current device size
+    Bitmap maOldScaled;
+    sal_Int32 mnSlot = 0;
+    sal_Int32 mnRotateSeconds = 10;
+    sal_Int32 mnFailures = 0;
+    int mnSourceScale = 0;
+    int mnFadeStep = 0;
+    bool mbRequested = false;
+};
+}
