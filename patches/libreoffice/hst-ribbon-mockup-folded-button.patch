 PriorityMergedHBox::PriorityMergedHBox(vcl::Window* pParent)
     : PriorityHBox(pParent)
 {
+    // HST Office (1.0.2 mockup): the ribbon panel pads its groups by 4 px and every group by 4 px; the group's
+    // frame gives 3, so the box starts 5 px in (the first group's content 8 px from the window edge). Its right
+    // end does not move: the margin comes off the left of what the box is given. A box inside another one (the
