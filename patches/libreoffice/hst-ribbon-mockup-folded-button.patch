+namespace
+{
+/// HST Office (1.0.2 mockup): the button of a collapsed group, "Caption ▾" as tall as the groups: icon on top,
+/// the caption on at most two balanced lines with ▾ after the last, its last line on the groups' caption line
+/// (hst::ribbon::FoldedButtonSize and DrawFoldedButton, HstRibbonPaint.hxx). Its text stays the plain caption
+/// (accessible name, tooltip).
+class HstFoldedButton final : public PushButton
+{
+    Image maImage;
+
+public:
+    HstFoldedButton(vcl::Window* pParent, const Image& rImage)
+        : PushButton(pParent, WB_FLATBUTTON | WB_CENTER | WB_VCENTER)
+        , maImage(rImage)
+    {
+    }
+    Size GetOptimalSize() const override
+    {
+        return hst::ribbon::FoldedButtonSize(*GetOutDev(), GetText(), maImage);
+    }
+    void Paint(vcl::RenderContext& rRenderContext, const tools::Rectangle&) override
+    {
+        const sal_uInt16 nHighlight = (GetButtonState() & DrawButtonFlags::Pressed) || IsPressed() ? 1
+                                      : IsMouseOver() ? 2 : 0;
+        hst::ribbon::DrawFoldedButton(rRenderContext, tools::Rectangle(Point(), GetOutputSizePixel()), GetText(),
+                                      maImage, nHighlight, IsEnabled());
+    }
+};
+}
