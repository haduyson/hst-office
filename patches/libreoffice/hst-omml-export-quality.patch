+#pragma once
+
+#include <rtl/ustring.hxx>
+#include <sax/fshelper.hxx>
+#include <token.hxx>
+
+#include <functional>
+#include <string_view>
+#include <vector>
+
+class SmMatrixNode;
+class SmNode;
+
+namespace oox::formulaimport
+{
+class XmlStream;
+}
+
+// How a formula looks in Word (OMML, ECMA-376 Part 1, 22.1): the layout properties that StarMath
+// expresses through fonts and alignment, written to and read back from the OMML elements that
+// carry them.
+namespace starmath::hst
+{
+/// Function names (sin, log, lim, "func det") are set upright. An OMML run is italic unless its
+/// m:rPr has m:sty m:val="p" (22.1.2.112), so a function name gets that run property.
+bool IsOmmlUprightName(const SmNode& rNode);
+
+/// Writes <m:rPr><m:sty m:val="p"/></m:rPr> for a function name, nothing for other text.
+void WriteOmmlUprightName(const sax_fastparser::FSHelperPtr& pSerializer, const SmNode& rNode);
+
+/// The same property in RTF math, whose control words are the OMML names: "\msty0 " (ST_Style
+/// "p", the first value) for a function name, empty for other text.
+const char* RtfMathUprightName(const SmNode& rNode);
+
+/// Word sets a function name and its argument apart only inside m:func, but the argument of a
+/// StarMath function is not a node of its own ("sin x + 1" is three neighbours). After a function
+/// name (with its scripts, as in cos^2), a thin space (U+2009) run marked m:sty "p" gives the same
+/// gap; the import drops exactly that run, so the formula text does not change on a round trip.
+/// pScriptedName is the name whose scripts are being written: the space follows them instead.
+/// lim is left out, as it is written as m:func.
+void WriteOmmlFunctionSpace(const sax_fastparser::FSHelperPtr& pSerializer, const SmNode& rNode,
+                            const SmNode* pScriptedName);
+
+/// Writes the thin space for a function name with scripts (rScripted's body), after the scripts
+void WriteOmmlFunctionSpaceAfterScripts(const sax_fastparser::FSHelperPtr& pSerializer,
+                                        const SmNode& rScripted);
+
+/// Whether a run read from OMML is that thin space: m:sty "p" and the text U+2009 alone
+bool IsOmmlFunctionSpace(std::u16string_view aStyle, std::u16string_view aText);
+
+/// m:vertJc of the m:groupChr written for a brace or an arrow with text (22.1.2.117): which part
+/// of the group sits on the baseline. A brace leaves the expression on the baseline; an arrow
+/// with text stays on the baseline like a relation, with its text above it ("bot": the bottom
+/// part, the arrow under its text, is on the baseline).
+const char* OmmlGroupCharVerticalJustification(SmTokenType eType);
+
+/// m:mcJc (22.1.2.67) of each matrix column, "left", "center" or "right", from the alignment the
+/// formula's layout gives its cells (alignl, alignr, quoted text). A column whose cells disagree
+/// is centred, as m:mcJc is one value per column. Empty when every column is centred, the OMML
+/// default, so such a matrix keeps its m:m without m:mPr.
+std::vector<const char*> OmmlMatrixColumnJustification(const SmMatrixNode& rMatrix);
+
+/// Writes m:mPr with one m:mc per column (m:count 1, m:mcJc) when a column is not centred.
+void WriteOmmlMatrixColumns(const sax_fastparser::FSHelperPtr& pSerializer,
+                            const SmMatrixNode& rMatrix);
+
+/// "stack {alignl a # alignl b}": Word centres the rows of m:eqArr whatever they hold (alignment
+/// points, m:aln, line up rows with each other, not with the left edge), so a stack whose rows are
+/// all aligned left (or all right) is written as a one-column m:m with that m:mcJc, which Word
+/// lays out as a left-aligned column. rWriteRow writes the content of one row. Returns false,
+/// writing nothing, for other stacks (and other tables), which stay m:eqArr.
+bool WriteOmmlAlignedStack(const sax_fastparser::FSHelperPtr& pSerializer, const SmNode& rTable,
+                           const std::function<void(const SmNode*)>& rWriteRow);
+
+/// Reads the optional m:mPr at the start of an m:m: the m:mcJc value of each column, repeated
+/// m:count times; empty without m:mPr. The stream is left at the first m:mr.
+std::vector<OUString> ReadOmmlMatrixColumnJustification(oox::formulaimport::XmlStream& rStream);
+
+/// A matrix cell read from OMML in the alignment of its column: "alignl {cell}" for "left",
+/// "alignr {cell}" for "right"; other columns and empty cells stay as they are.
+OUString OmmlAlignedMatrixCell(const std::vector<OUString>& rColumnJustification, size_t nColumn,
+                               const OUString& rCell);
+
+/// The formula text of an m:m read from OMML: "matrix {a # b ## c # d}" with its cells aligned as
+/// their columns; a single column aligned left or right is the stack it was written from,
+/// "stack {alignl {a} # alignl {b}}".
+OUString OmmlMatrixFormula(const std::vector<std::vector<OUString>>& rRows,
+                           const std::vector<OUString>& rColumnJustification);
+}
+
