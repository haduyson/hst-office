+++ b/starmath/source/hst/ommllayout.cxx
@@ -0,0 +1,281 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * Part of HST Office. This file is HST's own work and is not covered by the MPL.
+ */
+
+#include "ommllayout.hxx"
+#include "textarrow.hxx"
+
+#include <format.hxx>
+#include <node.hxx>
+#include <rect.hxx>
+
+#include <oox/mathml/importutils.hxx>
+#include <rtl/ustrbuf.hxx>
+#include <oox/token/namespaces.hxx>
+#include <oox/token/tokens.hxx>
+#include <tools/fontenum.hxx>
+
+#include <algorithm>
+#include <optional>
+
+using oox::formulaimport::XmlStream;
+
+namespace starmath::hst
+{
+namespace
+{
+/// A column count from a file is not trusted further than any matrix StarMath can hold
+constexpr size_t MAX_COLUMNS = 1024;
+
+/// The alignment shared by nCount subnodes of rParent (from nFirst, every nStep): each one's own
+/// alignment as the matrix and stack layout reads it; empty when they disagree or there are none
+std::optional<RectHorAlign> SharedAlignment(const SmNode& rParent, size_t nFirst, size_t nStep,
+                                            size_t nCount)
+{
+    std::optional<RectHorAlign> oShared;
+    for (size_t i = 0; i < nCount; ++i)
+    {
+        const size_t nIndex = nFirst + i * nStep;
+        const SmNode* pCell = nIndex < rParent.GetNumSubNodes() ? rParent.GetSubNode(nIndex)
+                                                                : nullptr;
+        const SmNode* pLeftMost = pCell ? pCell->GetLeftMost() : nullptr;
+        const RectHorAlign eCell = pLeftMost ? pLeftMost->GetRectHorAlign() : RectHorAlign::Center;
+        if (oShared && *oShared != eCell)
+            return std::nullopt;
+        oShared = eCell;
+    }
+    return oShared;
+}
+
+/// The function names that get the thin space: lim is written as m:func, which Word spaces
+bool TakesFunctionSpace(const SmNode& rNode)
+{
+    return IsOmmlUprightName(rNode) && rNode.GetToken().eType != TLIM;
+}
+
+void WriteThinSpace(const sax_fastparser::FSHelperPtr& pSerializer)
+{
+    using namespace oox;
+    pSerializer->startElementNS(XML_m, XML_r);
+    pSerializer->startElementNS(XML_m, XML_rPr);
+    pSerializer->singleElementNS(XML_m, XML_sty, FSNS(XML_m, XML_val), "p");
+    pSerializer->endElementNS(XML_m, XML_rPr);
+    pSerializer->startElementNS(XML_m, XML_t, FSNS(XML_xml, XML_space), "preserve");
+    pSerializer->write(u"\u2009");
+    pSerializer->endElementNS(XML_m, XML_t);
+    pSerializer->endElementNS(XML_m, XML_r);
+}
+
+void WriteColumns(const sax_fastparser::FSHelperPtr& pSerializer,
+                  const std::vector<const char*>& rColumns)
+{
+    using namespace oox;
+    pSerializer->startElementNS(XML_m, XML_mPr);
+    pSerializer->startElementNS(XML_m, XML_mcs);
+    for (const char* pJustification : rColumns)
+    {
+        pSerializer->startElementNS(XML_m, XML_mc);
+        pSerializer->startElementNS(XML_m, XML_mcPr);
+        pSerializer->singleElementNS(XML_m, XML_count, FSNS(XML_m, XML_val), "1");
+        pSerializer->singleElementNS(XML_m, XML_mcJc, FSNS(XML_m, XML_val), pJustification);
+        pSerializer->endElementNS(XML_m, XML_mcPr);
+        pSerializer->endElementNS(XML_m, XML_mc);
+    }
+    pSerializer->endElementNS(XML_m, XML_mcs);
+    pSerializer->endElementNS(XML_m, XML_mPr);
+}
+
+const char* ColumnJustification(RectHorAlign eAlign)
+{
+    switch (eAlign)
+    {
+        case RectHorAlign::Left:
+            return "left";
+        case RectHorAlign::Right:
+            return "right";
+        default:
+            return "center";
+    }
+}
+}
+
+bool IsOmmlUprightName(const SmNode& rNode)
+{
+    if (rNode.GetType() != SmNodeType::Text)
+        return false;
+    const auto& rText = static_cast<const SmTextNode&>(rNode);
+    return rText.GetFontDesc() == FNT_FUNCTION && rText.GetFont().GetItalic() == ITALIC_NONE;
+}
+
+void WriteOmmlUprightName(const sax_fastparser::FSHelperPtr& pSerializer, const SmNode& rNode)
+{
+    if (!IsOmmlUprightName(rNode))
+        return;
+    using namespace oox;
+    pSerializer->startElementNS(XML_m, XML_rPr);
+    pSerializer->singleElementNS(XML_m, XML_sty, FSNS(XML_m, XML_val), "p");
+    pSerializer->endElementNS(XML_m, XML_rPr);
+}
+
+const char* RtfMathUprightName(const SmNode& rNode)
+{
+    return IsOmmlUprightName(rNode) ? "\\msty0 " : "";
+}
+
+void WriteOmmlFunctionSpace(const sax_fastparser::FSHelperPtr& pSerializer, const SmNode& rNode,
+                            const SmNode* pScriptedName)
+{
+    if (&rNode != pScriptedName && TakesFunctionSpace(rNode))
+        WriteThinSpace(pSerializer);
+}
+
+void WriteOmmlFunctionSpaceAfterScripts(const sax_fastparser::FSHelperPtr& pSerializer,
+                                        const SmNode& rScripted)
+{
+    const SmNode* pBody = rScripted.GetNumSubNodes() > 0 ? rScripted.GetSubNode(0) : nullptr;
+    if (pBody && TakesFunctionSpace(*pBody))
+        WriteThinSpace(pSerializer);
+}
+
+bool IsOmmlFunctionSpace(std::u16string_view aStyle, std::u16string_view aText)
+{
+    return aStyle == u"p" && aText == u"\u2009";
+}
+
+const char* OmmlGroupCharVerticalJustification(SmTokenType eType)
+{
+    return eType == TOVERBRACE || IsTextArrow(eType) ? "bot" : "top";
+}
+
+std::vector<const char*> OmmlMatrixColumnJustification(const SmMatrixNode& rMatrix)
+{
+    const size_t nRows = rMatrix.GetNumRows();
+    const size_t nColumns = rMatrix.GetNumCols();
+    std::vector<const char*> aColumns(nColumns, "center");
+    bool bAllCentred = true;
+    for (size_t nColumn = 0; nColumn < nColumns; ++nColumn)
+    {
+        const std::optional<RectHorAlign> oColumn
+            = SharedAlignment(rMatrix, nColumn, nColumns, nRows);
+        if (!oColumn || *oColumn == RectHorAlign::Center)
+            continue;
+        aColumns[nColumn] = ColumnJustification(*oColumn);
+        bAllCentred = false;
+    }
+    if (bAllCentred)
+        aColumns.clear();
+    return aColumns;
+}
+
+void WriteOmmlMatrixColumns(const sax_fastparser::FSHelperPtr& pSerializer,
+                            const SmMatrixNode& rMatrix)
+{
+    const std::vector<const char*> aColumns = OmmlMatrixColumnJustification(rMatrix);
+    if (!aColumns.empty())
+        WriteColumns(pSerializer, aColumns);
+}
+
+bool WriteOmmlAlignedStack(const sax_fastparser::FSHelperPtr& pSerializer, const SmNode& rTable,
+                           const std::function<void(const SmNode*)>& rWriteRow)
+{
+    const size_t nRows = rTable.GetNumSubNodes();
+    if (rTable.GetType() != SmNodeType::Table || rTable.GetToken().eType != TSTACK || nRows == 0)
+        return false;
+    const std::optional<RectHorAlign> oRows = SharedAlignment(rTable, 0, 1, nRows);
+    if (!oRows || *oRows == RectHorAlign::Center)
+        return false;
+    using namespace oox;
+    pSerializer->startElementNS(XML_m, XML_m);
+    WriteColumns(pSerializer, { ColumnJustification(*oRows) });
+    for (size_t nRow = 0; nRow < nRows; ++nRow)
+    {
+        pSerializer->startElementNS(XML_m, XML_mr);
+        pSerializer->startElementNS(XML_m, XML_e);
+        if (const SmNode* pRow = rTable.GetSubNode(nRow))
+            rWriteRow(pRow);
+        pSerializer->endElementNS(XML_m, XML_e);
+        pSerializer->endElementNS(XML_m, XML_mr);
+    }
+    pSerializer->endElementNS(XML_m, XML_m);
+    return true;
+}
+
+std::vector<OUString> ReadOmmlMatrixColumnJustification(XmlStream& rStream)
+{
+    std::vector<OUString> aColumns;
+    if (!rStream.checkOpeningTag(M_TOKEN(mPr)))
+        return aColumns;
+    if (rStream.checkOpeningTag(M_TOKEN(mcs)))
+    {
+        while (rStream.checkOpeningTag(M_TOKEN(mc)))
+        {
+            sal_Int32 nCount = 1;
+            OUString aJustification(u"center"_ustr);
+            if (rStream.checkOpeningTag(M_TOKEN(mcPr)))
+            {
+                if (XmlStream::Tag aCount = rStream.checkOpeningTag(M_TOKEN(count)))
+                {
+                    nCount = aCount.attribute(M_TOKEN(val), u"1"_ustr).toInt32();
+                    rStream.ensureClosingTag(M_TOKEN(count));
+                }
+                if (XmlStream::Tag aJc = rStream.checkOpeningTag(M_TOKEN(mcJc)))
+                {
+                    aJustification = aJc.attribute(M_TOKEN(val), aJustification);
+                    rStream.ensureClosingTag(M_TOKEN(mcJc));
+                }
+                rStream.ensureClosingTag(M_TOKEN(mcPr));
+            }
+            rStream.ensureClosingTag(M_TOKEN(mc));
+            // m:count is at least 1 (ST_Integer255); a bad value counts as one column
+            const size_t nRepeat = static_cast<size_t>(std::clamp<sal_Int32>(nCount, 1, 255));
+            for (size_t i = 0; i < nRepeat && aColumns.size() < MAX_COLUMNS; ++i)
+                aColumns.push_back(aJustification);
+        }
+        rStream.ensureClosingTag(M_TOKEN(mcs));
+    }
+    rStream.ensureClosingTag(M_TOKEN(mPr));
+    return aColumns;
+}
+
+OUString OmmlAlignedMatrixCell(const std::vector<OUString>& rColumnJustification, size_t nColumn,
+                               const OUString& rCell)
+{
+    if (nColumn >= rColumnJustification.size() || rCell.trim().isEmpty())
+        return rCell;
+    const OUString& rJustification = rColumnJustification[nColumn];
+    if (rJustification == "left")
+        return "alignl {" + rCell + "}";
+    if (rJustification == "right")
+        return "alignr {" + rCell + "}";
+    return rCell;
+}
+
+OUString OmmlMatrixFormula(const std::vector<std::vector<OUString>>& rRows,
+                           const std::vector<OUString>& rColumnJustification)
+{
+    const bool bOneColumn
+        = !rRows.empty()
+          && std::all_of(rRows.begin(), rRows.end(), [](const auto& r) { return r.size() == 1; });
+    const bool bStack = bOneColumn && !rColumnJustification.empty()
+                        && (rColumnJustification[0] == "left" || rColumnJustification[0] == "right");
+    OUStringBuffer aText(bStack ? u"stack {"_ustr : u"matrix {"_ustr);
+    for (size_t nRow = 0; nRow < rRows.size(); ++nRow)
+    {
+        if (nRow > 0)
+            aText.append(bStack ? u" # "_ustr : u" ## "_ustr);
+        for (size_t nColumn = 0; nColumn < rRows[nRow].size(); ++nColumn)
+        {
+            if (nColumn > 0)
+                aText.append(" # ");
+            aText.append(OmmlAlignedMatrixCell(rColumnJustification, nColumn, rRows[nRow][nColumn]));
+        }
+    }
+    aText.append("}");
+    return aText.makeStringAndClear();
+}
+}
+
