+namespace
+{
+constexpr std::string_view MATH_NAMESPACE
+    = "http://schemas.openxmlformats.org/officeDocument/2006/math";
+constexpr std::string_view XML_NAMESPACE = "http://www.w3.org/XML/1998/namespace";
+
+/// The token writerfilter gives an OMML element or attribute: namespace | local name
+sal_Int32 OmmlToken(const xmlNs* pNs, const xmlChar* pName)
+{
+    const sal_Int32 nLocal
+        = oox::TokenMap::getTokenFromUtf8(reinterpret_cast<const char*>(pName));
+    if (!pNs || !pNs->href)
+        return nLocal;
+    const std::string_view aHref(reinterpret_cast<const char*>(pNs->href));
+    if (aHref == MATH_NAMESPACE)
+        return oox::NMSP_officeMath | nLocal;
+    if (aHref == XML_NAMESPACE)
+        return oox::NMSP_xml | nLocal;
+    return nLocal;
+}
+
+/// Replays a parsed OMML element as the token stream that the formula import reads
+void AppendElement(XmlStreamBuilder& rStream, const xmlNode* pNode)
+{
+    const sal_Int32 nToken = OmmlToken(pNode->ns, pNode->name);
+    XmlStream::AttributeList aAttributes;
+    for (const xmlAttr* pAttr = pNode->properties; pAttr; pAttr = pAttr->next)
+    {
+        xmlChar* pValue = xmlNodeListGetString(pNode->doc, pAttr->children, 1);
+        aAttributes[OmmlToken(pAttr->ns, pAttr->name)]
+            = OUString::fromUtf8(pValue ? reinterpret_cast<const char*>(pValue) : "");
+        xmlFree(pValue);
+    }
+    rStream.appendOpeningTag(nToken, aAttributes);
+    for (const xmlNode* pChild = pNode->children; pChild; pChild = pChild->next)
+    {
+        if (pChild->type == XML_ELEMENT_NODE)
+            AppendElement(rStream, pChild);
+        else if (pChild->type == XML_TEXT_NODE && pChild->content)
+            rStream.appendCharacters(
+                OUString::fromUtf8(reinterpret_cast<const char*>(pChild->content)));
+    }
+    rStream.appendClosingTag(nToken);
+}
+
+const SmNode* FindNode(const SmNode* pNode, SmNodeType eType)
+{
+    if (!pNode)
+        return nullptr;
+    if (pNode->GetType() == eType)
+        return pNode;
+    for (size_t i = 0; i < pNode->GetNumSubNodes(); ++i)
+        if (const SmNode* pFound = FindNode(pNode->GetSubNode(i), eType))
+            return pFound;
+    return nullptr;
+}
+
+OUString WithoutSpaces(const OUString& rText) { return rText.replaceAll(" ", ""); }
+
+class HstOmmlLayoutTest : public test::BootstrapFixture, public XmlTestTools
+{
+    rtl::Reference<SmDocShell> mxDocShell;
+
+    static rtl::Reference<SmDocShell> NewDocShell()
+    {
+        return new SmDocShell(SfxModelFlags::EMBEDDED_OBJECT
+                              | SfxModelFlags::DISABLE_EMBEDDED_SCRIPTS
+                              | SfxModelFlags::DISABLE_DOCUMENT_RECOVERY);
+    }
+
+    /// The formula as Word reads it from a .docx (inline m:oMath)
+    xmlDocUniquePtr ExportOmml(const OUString& rFormula)
+    {
+        mxDocShell->SetText(rFormula);
+        SvMemoryStream aStream;
+        {
+            uno::Reference<io::XOutputStream> xOut(new utl::OOutputStreamWrapper(aStream));
+            auto pSerializer = std::make_shared<sax_fastparser::FastSerializerHelper>(xOut, true);
+            mxDocShell->writeFormulaOoxml(pSerializer, oox::core::ISOIEC_29500_2008,
+                                          oox::drawingml::DOCUMENT_DOCX,
+                                          oox::FormulaImExportBase::eFormulaAlign::INLINE);
+            pSerializer->endDocument();
+        }
+        aStream.Seek(STREAM_SEEK_TO_BEGIN);
+        xmlDocUniquePtr pXmlDoc = parseXmlStream(&aStream);
+        CPPUNIT_ASSERT(pXmlDoc);
+        return pXmlDoc;
+    }
+
+    /// Reads OMML back into a new formula, as opening the .docx does; returns its formula text
+    OUString ImportOmml(const xmlDocUniquePtr& pXmlDoc)
+    {
+        XmlStreamBuilder aStream;
+        AppendElement(aStream, xmlDocGetRootElement(pXmlDoc.get()));
+        mxDocShell->DoClose();
+        mxDocShell = NewDocShell();
+        mxDocShell->readFormulaOoxml(aStream);
+        return mxDocShell->GetText();
+    }
+
+    /// The m:mcJc values of the first matrix in the current formula, as its layout aligns it,
+    /// separated by commas
+    OUString MatrixColumns()
+    {
+        mxDocShell->GetSize(); // prepares and arranges the formula
+        const SmNode* pMatrix = FindNode(mxDocShell->GetFormulaTree(), SmNodeType::Matrix);
+        CPPUNIT_ASSERT(pMatrix);
+        OUString aColumns;
+        for (const char* pJc : starmath::hst::OmmlMatrixColumnJustification(
+                 *static_cast<const SmMatrixNode*>(pMatrix)))
+            aColumns += (aColumns.isEmpty() ? u""_ustr : u","_ustr) + OUString::createFromAscii(pJc);
+        return aColumns;
+    }
+
+public:
+    void setUp() override
+    {
+        BootstrapFixture::setUp();
+        SmGlobals::ensure();
+        mxDocShell = NewDocShell();
+    }
+
+    void tearDown() override
+    {
+        if (mxDocShell)
+            mxDocShell->DoClose();
+        mxDocShell.clear();
+        BootstrapFixture::tearDown();
+    }
+
+    void registerNamespaces(xmlXPathContextPtr& pXmlXpathCtx) override
+    {
+        XmlTestTools::registerOOXMLNamespaces(pXmlXpathCtx);
+    }
+
+    void testFunctionNamesUpright()
+    {
+        xmlDocUniquePtr pXmlDoc = ExportOmml(u"sin x + cos^2 x + log_2 8 + func det A + "
+                                             "lim from {x toward 0} x + \"khi \" y"_ustr);
+        // every function name is a run with m:sty "p": Word showed them italic
+        for (const char* pName : { "sin", "cos", "log", "det", "lim" })
+        {
+            const OString aRun = OString::Concat("//m:r[m:t='") + pName + "']";
+            assertXPath(pXmlDoc, aRun, 1);
+            assertXPath(pXmlDoc, aRun + "/m:rPr/m:sty", "val", u"p");
+        }
+        // variables keep Word's italic, quoted text stays normal text
+        assertXPath(pXmlDoc, "//m:r[m:t='x']/m:rPr", 0);
+        assertXPath(pXmlDoc, "//m:r[m:t='A']/m:rPr", 0);
+        assertXPath(pXmlDoc, "//m:r[m:t='khi ']/m:rPr/m:nor", 1);
+        assertXPath(pXmlDoc, "//m:r[m:t='khi ']/m:rPr/m:sty", 0);
+        // a function name in italic is left to Word's italic
+        xmlDocUniquePtr pItalic = ExportOmml(u"ital sin x"_ustr);
+        assertXPath(pItalic, "//m:r[m:t='sin']/m:rPr", 0);
+
+        // m:sty does not change what is read back
+        pXmlDoc = ExportOmml(u"sin x + func det A"_ustr);
+        CPPUNIT_ASSERT_EQUAL(u"sinx+detA"_ustr, WithoutSpaces(ImportOmml(pXmlDoc)));
+    }
+
+    void testTextArrowOnBaseline()
+    {
+        xmlDocUniquePtr pXmlDoc = ExportOmml(u"CaCO_3 {t} xrightarrow {x} CaO"_ustr);
+        // the text is the group's base and the arrow is drawn under it; the arrow, the bottom
+        // part, is on the baseline (vertJc "top" put the text there and hung the arrow below)
+        assertXPath(pXmlDoc, "//m:limLow/m:e/m:groupChr/m:groupChrPr/m:chr", "val", u"→");
+        assertXPath(pXmlDoc, "//m:groupChr/m:groupChrPr/m:pos", "val", u"bot");
+        assertXPath(pXmlDoc, "//m:groupChr/m:groupChrPr/m:vertJc", "val", u"bot");
+        assertXPathContent(pXmlDoc, "//m:groupChr/m:e/m:r/m:t", u"t");
+        assertXPathContent(pXmlDoc, "//m:limLow/m:lim/m:r/m:t", u"x");
+        CPPUNIT_ASSERT(WithoutSpaces(ImportOmml(pXmlDoc)).indexOf(u"{t}xrightarrow{x}") >= 0);
+
+        // braces keep the expression on the baseline
+        pXmlDoc = ExportOmml(u"{a} overbrace {b}"_ustr);
+        assertXPath(pXmlDoc, "//m:groupChr/m:groupChrPr/m:pos", "val", u"top");
+        assertXPath(pXmlDoc, "//m:groupChr/m:groupChrPr/m:vertJc", "val", u"bot");
+        pXmlDoc = ExportOmml(u"{a} underbrace {b}"_ustr);
+        assertXPath(pXmlDoc, "//m:groupChr/m:groupChrPr/m:pos", "val", u"bot");
+        assertXPath(pXmlDoc, "//m:groupChr/m:groupChrPr/m:vertJc", "val", u"top");
+    }
+
+    void testMatrixColumnAlignment()
+    {
+        // \begin{aligned} P &= (a+b)^2 \\ &= a^2 + 2ab + b^2 \end{aligned}
+        const OUString aAligned(u"matrix{alignr {P} # alignl {{} = (a + b)^2} ## "
+                                "alignr \"\" # alignl {{} = a^2 + 2 ab + b^2}}"_ustr);
+        xmlDocUniquePtr pXmlDoc = ExportOmml(aAligned);
+        assertXPath(pXmlDoc, "//m:m/m:mPr/m:mcs/m:mc", 2);
+        assertXPath(pXmlDoc, "//m:m/m:mPr/m:mcs/m:mc[1]/m:mcPr/m:count", "val", u"1");
+        assertXPath(pXmlDoc, "//m:m/m:mPr/m:mcs/m:mc[1]/m:mcPr/m:mcJc", "val", u"right");
+        assertXPath(pXmlDoc, "//m:m/m:mPr/m:mcs/m:mc[2]/m:mcPr/m:mcJc", "val", u"left");
+        assertXPath(pXmlDoc, "//m:m/m:mr", 2);
+        // the columns come back aligned as they were
+        ImportOmml(pXmlDoc);
+        CPPUNIT_ASSERT_EQUAL(u"right,left"_ustr, MatrixColumns());
+
+        // cases: both columns on the left; quoted text alone also sits on the left in StarMath
+        pXmlDoc = ExportOmml(u"left lbrace matrix{alignl {x^2} # alignl {\"khi \" x >= 0} ## "
+                             "alignl {-x} # alignl {\"khi \" x < 0}} right none"_ustr);
+        assertXPath(pXmlDoc, "//m:d/m:e/m:m/m:mPr/m:mcs/m:mc[1]/m:mcPr/m:mcJc", "val", u"left");
+        assertXPath(pXmlDoc, "//m:d/m:e/m:m/m:mPr/m:mcs/m:mc[2]/m:mcPr/m:mcJc", "val", u"left");
+        ImportOmml(pXmlDoc);
+        CPPUNIT_ASSERT_EQUAL(u"left,left"_ustr, MatrixColumns());
+
+        // centred columns, and a column whose cells disagree, write no m:mPr (Word's default)
+        pXmlDoc = ExportOmml(u"matrix{1 # 2 ## 3 # 4}"_ustr);
+        assertXPath(pXmlDoc, "//m:m/m:mPr", 0);
+        CPPUNIT_ASSERT_EQUAL(u"matrix{1#2##3#4}"_ustr, WithoutSpaces(ImportOmml(pXmlDoc)));
+        pXmlDoc = ExportOmml(u"matrix{alignl a # b ## alignr c # d}"_ustr);
+        assertXPath(pXmlDoc, "//m:m/m:mPr", 0);
+    }
+
+    void testMatrixColumnsFromWord()
+    {
+        // one m:mc for two columns (m:count), with other matrix properties before m:mcs, and an
+        // m:count that is out of range
+        static constexpr char aOmml[]
+            = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>"
+              "<m:oMath xmlns:m=\"http://schemas.openxmlformats.org/officeDocument/2006/math\">"
+              "<m:m><m:mPr><m:baseJc m:val=\"center\"/><m:mcs>"
+              "<m:mc><m:mcPr><m:count m:val=\"2\"/><m:mcJc m:val=\"left\"/></m:mcPr></m:mc>"
+              "<m:mc><m:mcPr><m:count m:val=\"0\"/><m:mcJc m:val=\"right\"/></m:mcPr></m:mc>"
+              "</m:mcs></m:mPr>"
+              "<m:mr><m:e><m:r><m:t>a</m:t></m:r></m:e><m:e><m:r><m:t>b</m:t></m:r></m:e>"
+              "<m:e><m:r><m:t>c</m:t></m:r></m:e><m:e/></m:mr>"
+              "</m:m></m:oMath>";
+        SvMemoryStream aStream(const_cast<char*>(aOmml), sizeof(aOmml) - 1, StreamMode::READ);
+        xmlDocUniquePtr pXmlDoc = parseXmlStream(&aStream);
+        CPPUNIT_ASSERT(pXmlDoc);
+        const OUString aText = WithoutSpaces(ImportOmml(pXmlDoc));
+        static constexpr std::u16string_view aAligned = u"matrix{alignl{a}#alignl{b}#alignr{c}#";
+        CPPUNIT_ASSERT_MESSAGE(aText.toUtf8().getStr(), aText.startsWith(aAligned));
+        // the fourth column has no m:mc and stays centred; an empty cell is not wrapped
+        CPPUNIT_ASSERT_EQUAL(sal_Int32(-1),
+                             aText.indexOf(u"align", static_cast<sal_Int32>(aAligned.size())));
+    }
+
+    CPPUNIT_TEST_SUITE(HstOmmlLayoutTest);
+    CPPUNIT_TEST(testFunctionNamesUpright);
+    CPPUNIT_TEST(testTextArrowOnBaseline);
+    CPPUNIT_TEST(testMatrixColumnAlignment);
+    CPPUNIT_TEST(testMatrixColumnsFromWord);
+    CPPUNIT_TEST_SUITE_END();
+};
+
+CPPUNIT_TEST_SUITE_REGISTRATION(HstOmmlLayoutTest);
+}
