HST Office: Word Count shows Pages and Paragraphs in Word's order (the numbers come from SwDocStat).

License: these upstream files remain under their original license (MPL-2.0).
Test: tests/runtime/check-dialogs-writer.py word-count
---
--- a/sw/source/ui/dialog/wordcountdialog.cxx
+++ b/sw/source/ui/dialog/wordcountdialog.cxx
@@ -66,6 +66,11 @@
     setValue(*m_xDocCharacterExcludingSpacesFT, rDoc.nCharExcludingSpaces, rLocaleData);
     setValue(*m_xDocCjkcharsFT, rDoc.nAsianWord, rLocaleData);
     setValue(*m_xDocComments, rCurrent.nComments, rLocaleData);
+    // HST: pages and paragraphs, as in Word. SwDocStat starts nPara at 1 and only the document
+    // statistics reset it, so a selection's own count is one less.
+    setValue(*m_xHstDocPagesFT, rDoc.nPage, rLocaleData);
+    setValue(*m_xHstCurrentParasFT, rCurrent.nPara > 0 ? rCurrent.nPara - 1 : 0, rLocaleData);
+    setValue(*m_xHstDocParasFT, rDoc.nPara, rLocaleData);
 
     const sal_Int64 nCharsPerStandardizedPage = m_xStandardizedPagesLabelFT->get_visible() ?
         officecfg::Office::Writer::WordCount::StandardizedPageSize::get() : 0;
@@ -119,6 +124,9 @@
     , m_xStandardizedPagesLabelFT(m_xBuilder->weld_label(u"standardizedpages"_ustr))
     , m_xDocComments(m_xBuilder->weld_label(u"docComments"_ustr))
     , m_xWordsCursorFT(m_xBuilder->weld_label(u"wordscursor"_ustr))
+    , m_xHstDocPagesFT(m_xBuilder->weld_label(u"hstdocpages"_ustr))
+    , m_xHstCurrentParasFT(m_xBuilder->weld_label(u"hstselectparas"_ustr))
+    , m_xHstDocParasFT(m_xBuilder->weld_label(u"hstdocparas"_ustr))
 {
     showCJK(SvtCJKOptions::IsAnyEnabled());
     showStandardizedPages(officecfg::Office::Writer::WordCount::ShowStandardizedPageCount::get());
