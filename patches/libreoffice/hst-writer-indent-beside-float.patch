HST Office: in Word layouts the text beside a float starts at the float, not again after the paragraph indent (Writer).

In a document laid out like Word before 2013 (.doc, and .docx/.rtf in an older compatibility mode, where Writer
sets TabOverMargin), Word starts the lines next to a float at the float's wrap edge: the paragraph's left indent,
measured from the margin, is already covered by the float. Writer added the indent once more after the float
(SwTextFormatter::CalcFlyWidth), so each line beside a picture in an indented paragraph was narrower by the indent;
in s036.doc the formulas next to a figure broke onto an extra line each (+18 pt per paragraph on page 8). Writer
already leaves the indent out for split (floating table) frames; hst::sw::IgnoreIndentBesideFly now does the same
for other floats in these layouts (left-to-right paragraphs only). Native documents and Word 2013+ layouts are
unchanged.

Test: CppunitTest_sw_core_text testIndentNotAddedBesideFloatInWordLayout and testIndentAddedBesideFloatOtherwise
(minimal .docx in compatibility mode 14 and 15, stored in base64).

License: the new files sw/source/core/text/hstindentbesidefly.{hxx,cxx} are LicenseRef-HST-Proprietary; the
upstream files remain under their original license (MPL-2.0).
---
--- a/sw/qa/core/text/txtfly.cxx
+++ b/sw/qa/core/text/txtfly.cxx
@@ -49,6 +49,15 @@
         aDocx.CloseStream();
         loadFromURL(aDocx.GetURL());
     }
+
+    /// Width of the float's room at the start of the first line of the first paragraph.
+    sal_Int32 getFirstLineFlyPortionWidth(const xmlDocUniquePtr& pXmlDoc)
+    {
+        return getXPath(pXmlDoc,
+                        "//txt[1]/SwParaPortion/SwLineLayout[1]/child::*[@type='PortionType::Fly']",
+                        "width")
+            .toInt32();
+    }
 };
 
 CPPUNIT_TEST_FIXTURE(Test, testClearingBreakWrapThrough)
@@ -101,6 +110,35 @@
     sal_Int32 nInlineTop = getXPath(pXmlDoc, "//txt[2]/anchored/fly/infos/bounds", "top").toInt32();
     CPPUNIT_ASSERT_GREATEREQUAL(nFloatBottom, nInlineTop);
 }
+
+CPPUNIT_TEST_FIXTURE(Test, testIndentNotAddedBesideFloatInWordLayout)
+{
+    // Given a Word 2010 document: a paragraph with a 0.5 inch left indent that holds a square-wrapped 2 inch
+    // picture at the left of the column (1 inch margin, 1/8 inch wrap distance), then text beside it:
+    loadBase64Docx(u"hst-indent-beside-float.docx.b64");
+
+    // When laying out that document:
+    calcLayout();
+
+    // Then the text starts at the float's wrap edge (1440 + 2880 + 180 twips), as in Word: the float's room
+    // reaches from the indented text start (1440 + 720) to there.
+    xmlDocUniquePtr pXmlDoc = parseLayoutDump();
+    // Without the accompanying fix in place, the indent was added again after the float: 3060.
+    CPPUNIT_ASSERT_DOUBLES_EQUAL(2340.0, double(getFirstLineFlyPortionWidth(pXmlDoc)), 30.0);
+}
+
+CPPUNIT_TEST_FIXTURE(Test, testIndentAddedBesideFloatOtherwise)
+{
+    // Given the same content saved by Word 2013 or later:
+    loadBase64Docx(u"hst-indent-beside-float-word2013.docx.b64");
+
+    // When laying out that document:
+    calcLayout();
+
+    // Then the indent still follows the float:
+    xmlDocUniquePtr pXmlDoc = parseLayoutDump();
+    CPPUNIT_ASSERT_DOUBLES_EQUAL(3060.0, double(getFirstLineFlyPortionWidth(pXmlDoc)), 30.0);
+}
 }
 
