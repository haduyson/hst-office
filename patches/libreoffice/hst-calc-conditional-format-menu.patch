+bool ConditionalFormatEasyDialog::EnsurePresetStyle(const OUString& rName)
+{
+    ScStyleSheetPool* pPool = mrDocument.GetStyleSheetPool();
+    const PresetStyle* pPreset = FindPresetStyle(rName);
+    if (!pPreset || pPool->Find(rName, SfxStyleFamily::Para))
+        return false;
+
+    SfxStyleSheetBase& rStyle
+        = pPool->Make(rName, SfxStyleFamily::Para, SfxStyleSearchBits::UserDefined);
+    rStyle.SetParent(ScResId(STR_STYLENAME_STANDARD));
+    mrDocument.getCellAttributeHelper().CellStyleCreated(mrDocument, rName);
+    SfxItemSet& rSet = rStyle.GetItemSet();
+    rSet.Put(SvxBrushItem(pPreset->aFill, ATTR_BACKGROUND));
+    rSet.Put(SvxColorItem(pPreset->aText, ATTR_FONT_COLOR));
 
-    mxStyles->set_active(1);
+    if (mrDocument.IsUndoEnabled())
+    {
+        ScDocShell* pDocShell = mrViewData.GetDocShell();
+        ScStyleSaveData aNewData;
+        aNewData.InitFromStyle(&rStyle);
+        pDocShell->GetUndoManager()->AddUndoAction(std::make_unique<ScUndoModifyStyle>(
+            *pDocShell, SfxStyleFamily::Para, ScStyleSaveData(), aNewData));
+    }
+    return true;
 }
 
