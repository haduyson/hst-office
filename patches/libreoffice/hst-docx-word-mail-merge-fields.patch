+#pragma once
+
+#include <rtl/ustring.hxx>
+
+#include <string_view>
+#include <vector>
+
+/** Word mail-merge fields Writer cannot evaluate itself: a MERGEFIELD with a number, date, case or text-before/after
+    switch, and an IF that compares or shows merge fields. The DOCX import makes them database fields whose column
+    name is the Word instruction, nested fields written as { ... }; the HST mail merge computes that column for each
+    recipient with Word's rules, and the Word export writes the column back as the instruction
+    (sw/source/filter/ww8/hst/hstwordmergeexport.hxx). */
+namespace hst::wordmerge
+{
+/// The instruction of a field nested in another one, as the outer field keeps it (U+0013 code U+0015).
+OUString NestedCode(std::u16string_view aInnerCode);
+
+/// An IF whose instruction (with its nested fields) holds a MERGEFIELD.
+bool IsMergeIf(std::u16string_view aCode);
+
+/// The column of an imported MERGEFIELD: its name, or its whole instruction when a switch changes the result
+/// (anything but \* MERGEFORMAT / CHARFORMAT, \m and \v).
+OUString MergeFieldColumn(std::u16string_view aCode, const OUString& rName,
+                          const std::vector<OUString>& rSwitches);
+
+/// The column of an IF that IsMergeIf(): the instruction with { ... } for its nested fields.
+OUString CodeColumn(std::u16string_view aCode);
+}
