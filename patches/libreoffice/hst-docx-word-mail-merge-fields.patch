+    // result for each recipient. The engine merges such columns like any other.
+    utl::TempFileNamed aTempDir(nullptr, true);
+    aTempDir.EnableKillingFile();
+    const OUString aWorkDir = aTempDir.GetURL();
+    const OUString aSourceUrl = aWorkDir + "/danh-sach.ods";
+    {
+        uno::Reference<frame::XDesktop2> xDesktop = frame::Desktop::create(m_xContext);
+        uno::Reference<lang::XComponent> xCalc = xDesktop->loadComponentFromURL(
+            u"private:factory/scalc"_ustr, u"_blank"_ustr, 0,
+            { comphelper::makePropertyValue(u"Hidden"_ustr, true) });
+        uno::Reference<sheet::XSpreadsheetDocument> xSpreadsheets(xCalc, uno::UNO_QUERY_THROW);
+        uno::Reference<container::XIndexAccess> xSheets(xSpreadsheets->getSheets(), uno::UNO_QUERY_THROW);
+        uno::Reference<sheet::XSpreadsheet> xSheet(xSheets->getByIndex(0), uno::UNO_QUERY_THROW);
+        uno::Reference<container::XNamed>(xSheet, uno::UNO_QUERY_THROW)->setName(u"DanhSach"_ustr);
+        uno::Reference<sheet::XCellRangeData> xData(xSheet->getCellRangeByPosition(0, 0, 2, 2),
+                                                    uno::UNO_QUERY_THROW);
+        xData->setDataArray(
+            { { uno::Any(u"Họ_và_tên"_ustr), uno::Any(IF_COLUMN), uno::Any(SALARY_COLUMN) },
+              { uno::Any(u"Nguyễn Văn An"_ustr), uno::Any(u"Ông"_ustr), uno::Any(u"15,000,000"_ustr) },
+              { uno::Any(u"Trần Thị Bích Ngọc"_ustr), uno::Any(u"Bà"_ustr), uno::Any(u"8,250,001"_ustr) } });
+        uno::Reference<frame::XStorable>(xCalc, uno::UNO_QUERY_THROW)
+            ->storeToURL(aSourceUrl, { comphelper::makePropertyValue(u"FilterName"_ustr, u"calc8"_ustr) });
+        xCalc->dispose();
+    }
+    const OUString aDBName = SwDBManager::LoadAndRegisterDataSource(aSourceUrl, &aWorkDir);
+    CPPUNIT_ASSERT(!aDBName.isEmpty());
+
+    createSwDoc();
+    uno::Reference<lang::XMultiServiceFactory> xFactory(mxComponent, uno::UNO_QUERY_THROW);
+    uno::Reference<text::XTextDocument> xTextDoc(mxComponent, uno::UNO_QUERY_THROW);
+    uno::Reference<text::XText> xText = xTextDoc->getText();
+    for (const OUString& rColumn : { IF_COLUMN, u"Họ_và_tên"_ustr, SALARY_COLUMN })
+    {
+        uno::Reference<beans::XPropertySet> xMaster(
+            xFactory->createInstance(u"com.sun.star.text.FieldMaster.Database"_ustr), uno::UNO_QUERY_THROW);
+        xMaster->setPropertyValue(u"DataBaseName"_ustr, uno::Any(aDBName));
+        xMaster->setPropertyValue(u"DataTableName"_ustr, uno::Any(u"DanhSach"_ustr));
+        xMaster->setPropertyValue(u"DataCommandType"_ustr, uno::Any(sdb::CommandType::TABLE));
+        xMaster->setPropertyValue(u"DataColumnName"_ustr, uno::Any(rColumn));
+        uno::Reference<text::XDependentTextField> xField(
+            xFactory->createInstance(u"com.sun.star.text.TextField.Database"_ustr), uno::UNO_QUERY_THROW);
+        xField->attachTextFieldMaster(xMaster);
+        xText->insertTextContent(xText->getEnd(), xField, false);
+        xText->insertString(xText->getEnd(), u" "_ustr, false);
+    }
+    const OUString aTemplateUrl = aWorkDir + "/thu.odt";
+    uno::Reference<frame::XStorable>(mxComponent, uno::UNO_QUERY_THROW)
+        ->storeToURL(aTemplateUrl, { comphelper::makePropertyValue(u"FilterName"_ustr, u"writer8"_ustr) });
+
+    uno::Reference<task::XJob> xJob(
+        getMultiServiceFactory()->createInstance(u"com.sun.star.text.MailMerge"_ustr), uno::UNO_QUERY_THROW);
+    uno::Any aResult = xJob->execute(
+        { beans::NamedValue(u"OutputType"_ustr, uno::Any(text::MailMergeType::SHELL)),
+          beans::NamedValue(u"DocumentURL"_ustr, uno::Any(aTemplateUrl)),
+          beans::NamedValue(u"DataSourceName"_ustr, uno::Any(aDBName)),
+          beans::NamedValue(u"Command"_ustr, uno::Any(u"DanhSach"_ustr)),
+          beans::NamedValue(u"CommandType"_ustr, uno::Any(sdb::CommandType::TABLE)) });
+    uno::Reference<text::XTextDocument> xMerged(aResult, uno::UNO_QUERY_THROW);
+    const OUString aMerged = xMerged->getText()->getString();
+    uno::Reference<lang::XComponent>(xMerged, uno::UNO_QUERY_THROW)->dispose();
+    SwDBManager::RevokeDataSource(aDBName);
+
+    CPPUNIT_ASSERT_MESSAGE(aMerged.toUtf8().getStr(), aMerged.indexOf(u"Ông Nguyễn Văn An 15,000,000") >= 0);
+    CPPUNIT_ASSERT_MESSAGE(aMerged.toUtf8().getStr(), aMerged.indexOf(u"Bà Trần Thị Bích Ngọc 8,250,001") >= 0);
+}
