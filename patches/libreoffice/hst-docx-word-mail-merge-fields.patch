+    void loadWordLetter()
+    {
+        uno::Sequence<sal_Int8> aBytes;
+        comphelper::Base64::decode(aBytes, OUString::createFromAscii(WORD_LETTER));
+        SvStream* pStream = maTempFile.GetStream(StreamMode::WRITE | StreamMode::TRUNC);
+        pStream->WriteBytes(aBytes.getConstArray(), aBytes.getLength());
+        maTempFile.CloseStream();
+        loadFromURL(maTempFile.GetURL(), { comphelper::makePropertyValue(
+                                              u"FilterName"_ustr, u"Office Open XML Text"_ustr) });
+    }
+
+    /// Column name -> shown text of every database field.
+    std::map<OUString, OUString> databaseFields()
+    {
+        std::map<OUString, OUString> aFields;
+        uno::Reference<text::XTextFieldsSupplier> xSupplier(mxComponent, uno::UNO_QUERY_THROW);
+        uno::Reference<container::XEnumeration> xEnum
+            = xSupplier->getTextFields()->createEnumeration();
+        while (xEnum->hasMoreElements())
+        {
+            uno::Reference<text::XDependentTextField> xField(xEnum->nextElement(), uno::UNO_QUERY);
+            uno::Reference<lang::XServiceInfo> xInfo(xField, uno::UNO_QUERY);
+            if (!xInfo || !xInfo->supportsService(u"com.sun.star.text.TextField.Database"_ustr))
+                continue;
+            aFields[getProperty<OUString>(xField->getTextFieldMaster(), u"DataColumnName"_ustr)]
+                = getProperty<OUString>(xField, u"Content"_ustr);
+        }
+        return aFields;
+    }
+};
