+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ * Copyright (C) HASON TECH. HST Office.
+ */
+
+#include "hstwordmergeexport.hxx"
+
+#include <com/sun/star/beans/PropertyValue.hpp>
+#include <o3tl/string_view.hxx>
+#include <oox/core/xmlfilterbase.hxx>
+#include <oox/token/namespaces.hxx>
+#include <oox/token/tokens.hxx>
+#include <rtl/ustrbuf.hxx>
+
+using namespace css;
+using namespace oox;
+
+namespace hst::wordmerge
+{
+namespace
+{
+constexpr sal_Unicode NESTED_START = 0x13;
+constexpr sal_Unicode NESTED_END = 0x15;
+}
+
+CodeKind CodeOfColumn(std::u16string_view aColumn, OUString& rCode, ww::eField& rField)
+{
+    std::u16string_view aTrimmed = o3tl::trim(aColumn);
+    if (o3tl::matchIgnoreAsciiCase(aTrimmed, u"MERGEFIELD "))
+        rField = ww::eMERGEFIELD;
+    else if (o3tl::matchIgnoreAsciiCase(aTrimmed, u"IF "))
+        rField = ww::eIF;
+    else
+        return CodeKind::None;
+
+    OUStringBuffer aCode(" ");
+    sal_Int32 nDepth = 0;
+    bool bNested = false;
+    for (sal_Unicode c : aTrimmed)
+    {
+        if (c == '{')
+        {
+            ++nDepth;
+            bNested = true;
+            aCode.append(NESTED_START);
+        }
+        else if (c == '}')
+        {
+            if (--nDepth < 0)
+                return CodeKind::None;
+            aCode.append(NESTED_END);
+        }
+        else
+            aCode.append(c);
+    }
+    if (nDepth != 0)
+        return CodeKind::None;
+    rCode = aCode.append(" ").makeStringAndClear();
+    return bNested ? CodeKind::Nested : CodeKind::Flat;
+}
+
+bool SplitNestedCommand(std::u16string_view aCommand, const std::function<void(std::u16string_view)>& rText,
+                        const std::function<void(bool bBegin)>& rFieldChar)
+{
+    if (aCommand.find(NESTED_START) == std::u16string_view::npos)
+        return false;
+    size_t nStart = 0;
+    for (size_t i = 0; i < aCommand.size(); ++i)
+    {
+        if (aCommand[i] != NESTED_START && aCommand[i] != NESTED_END)
+            continue;
+        if (i > nStart)
+            rText(aCommand.substr(nStart, i - nStart));
+        rFieldChar(aCommand[i] == NESTED_START);
+        nStart = i + 1;
+    }
+    if (nStart < aCommand.size())
+        rText(aCommand.substr(nStart));
+    return true;
+}
+
+bool WriteMailMergeSource(oox::core::XmlFilterBase& rFilter, const sax_fastparser::FSHelperPtr& pFS,
+                          const comphelper::SequenceAsHashMap& rGrabBag)
+{
+    uno::Sequence<beans::PropertyValue> aSource;
+    if (!(rGrabBag.getValue(u"HSTMailMergeSource"_ustr) >>= aSource))
+        return false;
+    const comphelper::SequenceAsHashMap aMap(aSource);
+    OUString sPath, sSheet;
+    aMap.getValue(u"Path"_ustr) >>= sPath;
+    aMap.getValue(u"Sheet"_ustr) >>= sSheet;
+    if (sPath.isEmpty())
+        return false;
+
+    // Word: "file:///C:\folder\list.xlsx"; a POSIX path keeps its single leading slash
+    const bool bTextFile = sPath.endsWithIgnoreAsciiCase(".csv") || sPath.endsWithIgnoreAsciiCase(".txt");
+    const OUString sTarget = "file:///" + (sPath.startsWith("/") ? sPath.copy(1) : sPath);
+    const OUString sType = u"http://schemas.openxmlformats.org/officeDocument/2006/relationships/mailMergeSource"_ustr;
+    const OUString sSourceId = rFilter.addRelation(pFS->getOutputStream(), sType, sTarget, true);
+    const OUString sOdsoId = rFilter.addRelation(pFS->getOutputStream(), sType, sTarget, true);
+    const OUString sConnect = "Provider=Microsoft.ACE.OLEDB.12.0;User ID=Admin;Data Source=" + sPath
+                              + ";Mode=Read;Extended Properties=\"HDR=YES;IMEX=1;\";Jet OLEDB:Engine Type=37;";
+    const OUString sQuery = bTextFile ? OUString("SELECT * FROM " + sPath)
+                                      : OUString("SELECT * FROM `" + sSheet + "$` ");
+
+    pFS->startElementNS(XML_w, XML_mailMerge, FSNS(XML_xmlns, XML_r),
+                        rFilter.getNamespaceURL(OOX_NS(officeRel)));
+    pFS->singleElementNS(XML_w, XML_mainDocumentType, FSNS(XML_w, XML_val), "formLetters");
+    pFS->singleElementNS(XML_w, XML_linkToQuery);
+    pFS->singleElementNS(XML_w, XML_dataType, FSNS(XML_w, XML_val), bTextFile ? "textFile" : "native");
+    if (!bTextFile)
+        pFS->singleElementNS(XML_w, XML_connectString, FSNS(XML_w, XML_val), sConnect);
+    pFS->singleElementNS(XML_w, XML_query, FSNS(XML_w, XML_val), sQuery);
+    pFS->singleElementNS(XML_w, XML_dataSource, FSNS(XML_r, XML_id), sSourceId);
+    pFS->startElementNS(XML_w, XML_odso);
+    if (!bTextFile)
+    {
+        pFS->singleElementNS(XML_w, XML_udl, FSNS(XML_w, XML_val), sConnect);
+        pFS->singleElementNS(XML_w, XML_table, FSNS(XML_w, XML_val), OUString(sSheet + "$"));
+    }
+    pFS->singleElementNS(XML_w, XML_src, FSNS(XML_r, XML_id), sOdsoId);
+    pFS->singleElementNS(XML_w, XML_colDelim, FSNS(XML_w, XML_val), bTextFile ? "44" : "9");
+    pFS->singleElementNS(XML_w, XML_fHdr);
+    pFS->endElementNS(XML_w, XML_odso);
+    pFS->endElementNS(XML_w, XML_mailMerge);
+    return true;
+}
+}
