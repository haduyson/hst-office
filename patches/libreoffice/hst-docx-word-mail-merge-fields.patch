+
+namespace oox::core
+{
+class XmlFilterBase;
+}
+
+/** Word export of the Word mail-merge fields the DOCX import keeps as database fields named by their instruction
+    (sw/source/writerfilter/hst/hstwordmergeimport.hxx), and of the recipient list the HST mail merge links. */
+namespace hst::wordmerge
+{
+enum class CodeKind
+{
+    None, ///< an ordinary column: MERGEFIELD <column>
+    Flat, ///< an instruction without nested fields
+    Nested ///< an instruction with nested fields (only DOCX can write them)
+};
+
+/// The instruction to write for a database field reading `aColumn` (rCode: " <instruction> ", nested fields
+/// marked U+0013 ... U+0015) and its field type.
+CodeKind CodeOfColumn(std::u16string_view aColumn, OUString& rCode, ww::eField& rField);
+
+/// Walks a DOCX field command: rText for instruction text, rFieldChar(true/false) for a nested field's begin/end.
+/// Returns false (calling nothing) when the command has no nested field.
+bool SplitNestedCommand(std::u16string_view aCommand, const std::function<void(std::u16string_view)>& rText,
+                        const std::function<void(bool bBegin)>& rFieldChar);
+
+/// Writes w:mailMerge linking the recipient list the way Word links it, when the document's InteropGrabBag has
+/// "HSTMailMergeSource" (Path, Sheet); returns false (writing nothing) otherwise.
+bool WriteMailMergeSource(oox::core::XmlFilterBase& rFilter, const sax_fastparser::FSHelperPtr& pFS,
+                          const comphelper::SequenceAsHashMap& rGrabBag);
+}
