+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ * Copyright (C) HASON TECH. HST Office.
+ */
+
+#include <hst/hstwordmergeimport.hxx>
+
+#include <o3tl/string_view.hxx>
+
+namespace hst::wordmerge
+{
+namespace
+{
+constexpr sal_Unicode NESTED_START = 0x13;
+constexpr sal_Unicode NESTED_END = 0x15;
+}
+
+OUString NestedCode(std::u16string_view aInnerCode)
+{
+    return OUStringChar(NESTED_START) + aInnerCode + OUStringChar(NESTED_END);
+}
+
+bool IsMergeIf(std::u16string_view aCode)
+{
+    std::u16string_view aTrimmed = o3tl::trim(aCode);
+    if (!o3tl::matchIgnoreAsciiCase(aTrimmed, u"IF") || aTrimmed.size() < 3
+        || (aTrimmed[2] != ' ' && aTrimmed[2] != NESTED_START && aTrimmed[2] != '"'))
+        return false;
+    for (size_t i = 0; i < aTrimmed.size(); ++i)
+    {
+        if (aTrimmed[i] == NESTED_START
+            && o3tl::matchIgnoreAsciiCase(o3tl::trim(aTrimmed.substr(i + 1)), u"MERGEFIELD"))
+            return true;
+    }
+    return false;
+}
+
+OUString CodeColumn(std::u16string_view aCode)
+{
+    return OUString(o3tl::trim(aCode)).replace(NESTED_START, '{').replace(NESTED_END, '}');
+}
+
+OUString MergeFieldColumn(std::u16string_view aCode, const OUString& rName,
+                          const std::vector<OUString>& rSwitches)
+{
+    for (size_t i = 0; i < rSwitches.size(); ++i)
+    {
+        const OUString& rSwitch = rSwitches[i];
+        if (!rSwitch.startsWith("\\") || rSwitch.equalsIgnoreAsciiCase("\\m")
+            || rSwitch.equalsIgnoreAsciiCase("\\v"))
+            continue;
+        if (rSwitch == "\\*" && i + 1 < rSwitches.size()
+            && (rSwitches[i + 1].equalsIgnoreAsciiCase("MERGEFORMAT")
+                || rSwitches[i + 1].equalsIgnoreAsciiCase("CHARFORMAT")))
+            continue;
+        return CodeColumn(aCode);
+    }
+    return rName;
+}
+}
