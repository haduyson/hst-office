+// HST: Scripting.Dictionary for VBA code (implemented in sbxdictionary.cxx)
+class BasicDictionary final : public SbxObject
+{
+    std::vector<SbxVariableRef> maKeys;
+    std::vector<SbxVariableRef> maItems;
+    std::unordered_map<OUString, sal_Int32> maIndex; // normalized key -> position
+    sal_Int32 mnCompareMode; // 0 = vbBinaryCompare, 1 = vbTextCompare
+    static SbxInfoRef xAddInfo;
+    static SbxInfoRef xKeyInfo;
+
+    void Initialize();
+    virtual ~BasicDictionary() override;
+    virtual void Notify( SfxBroadcaster& rBC, const SfxHint& rHint ) override;
+    OUString implKeyOf( SbxVariable& rKey ) const;
+    sal_Int32 implFind( SbxVariable& rKey ) const;
+    sal_Int32 implAdd( SbxVariable& rKey, const SbxVariable* pItem );
+    static SbxDimArray* implArray( const std::vector<SbxVariableRef>& rValues );
+    static void implReturnArray( SbxVariable* pVar, SbxDimArray* pArray );
+
+public:
+    BasicDictionary( const OUString& rClassname );
+    virtual void Clear() override;
+    /// d(key) and d.Item(key): the stored item (added when missing, as VBA does)
+    SbxVariable* GetItemForKey( SbxVariable& rKey );
+    /// For Each k In d: the keys
+    SbxDimArray* GetKeysArray();
+};
