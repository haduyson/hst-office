+// HST: Scripting.Dictionary for VBA code (CreateObject("Scripting.Dictionary"), New Dictionary),
+// on every platform: no Windows scripting runtime needed.
+
+#include <basic/sbx.hxx>
+#include <basic/sberrors.hxx>
+#include <runtime.hxx>
+#include <sbintern.hxx>
+#include <sbunoobj.hxx>
+#include <errobject.hxx>
+
+namespace
+{
+constexpr OUString aCountStr = u"Count"_ustr;
+constexpr OUString aAddStr = u"Add"_ustr;
+constexpr OUString aItemStr = u"Item"_ustr;
+constexpr OUString aExistsStr = u"Exists"_ustr;
+constexpr OUString aRemoveStr = u"Remove"_ustr;
+constexpr OUString aRemoveAllStr = u"RemoveAll"_ustr;
+constexpr OUString aKeysStr = u"Keys"_ustr;
+constexpr OUString aItemsStr = u"Items"_ustr;
+constexpr OUString aCompareModeStr = u"CompareMode"_ustr;
+
+// VBA run-time errors of the Scripting runtime
+constexpr sal_Int32 nErrKeyExists = 457; // This key is already associated with an element of this collection
+constexpr sal_Int32 nErrNotFound = 32811; // Element not found
+
+void lcl_vbaError(sal_Int32 nNumber, const OUString& rMessage)
+{
+    if (SbiInstance* pInst = GetSbData()->pInst)
+    {
+        // like Err.Raise: the Err object gets the VBA number, then the runtime error is raised
+        if (SbxErrObject* pErr = static_cast<SbxErrObject*>(SbxErrObject::getErrObject().get()))
+            pErr->setNumberAndDescription(nNumber, rMessage);
+        pInst->ErrorVB(nNumber, rMessage);
+    }
+    else
+        StarBASIC::Error(ERRCODE_BASIC_BAD_ARGUMENT);
+}
+
+SbxDataType lcl_baseType(const SbxVariable& rVar)
+{
+    SbxDataType eType = rVar.GetType();
+    return static_cast<SbxDataType>(eType & ~SbxBYREF);
+}
+}
+
+SbxInfoRef BasicDictionary::xAddInfo;
+SbxInfoRef BasicDictionary::xKeyInfo;
+
+BasicDictionary::BasicDictionary(const OUString& rClass)
+    : SbxObject(rClass)
+    , mnCompareMode(0)
+{
+    Initialize();
+}
+
+BasicDictionary::~BasicDictionary() {}
+
+void BasicDictionary::Clear()
+{
+    SbxObject::Clear();
+    Initialize();
+}
+
+void BasicDictionary::Initialize()
+{
+    maKeys.clear();
+    maItems.clear();
+    maIndex.clear();
+    SetType(SbxOBJECT);
+    SetFlag(SbxFlagBits::Fixed);
+    ResetFlag(SbxFlagBits::Write);
+    SbxVariable* p = Make(aCountStr, SbxClassType::Property, SbxLONG);
+    p->ResetFlag(SbxFlagBits::Write);
+    p->SetFlag(SbxFlagBits::DontStore);
+    for (const OUString& rName : { aAddStr, aExistsStr, aRemoveStr, aRemoveAllStr, aKeysStr, aItemsStr })
+        Make(rName, SbxClassType::Method, SbxVARIANT)->SetFlag(SbxFlagBits::DontStore);
+    p = Make(aItemStr, SbxClassType::Property, SbxVARIANT);
+    p->SetFlag(SbxFlagBits::DontStore);
+    p = Make(aCompareModeStr, SbxClassType::Property, SbxLONG);
+    p->SetFlag(SbxFlagBits::DontStore);
+    if (!xAddInfo.is())
+    {
+        xAddInfo = new SbxInfo;
+        xAddInfo->AddParam(u"Key"_ustr, SbxVARIANT);
+        xAddInfo->AddParam(u"Item"_ustr, SbxVARIANT);
+    }
+    if (!xKeyInfo.is())
+    {
+        xKeyInfo = new SbxInfo;
+        xKeyInfo->AddParam(u"Key"_ustr, SbxVARIANT);
+    }
+}
+
+OUString BasicDictionary::implKeyOf(SbxVariable& rKey) const
+{
+    switch (lcl_baseType(rKey))
+    {
+        case SbxSTRING:
+        case SbxLPSTR:
+        case SbxLPWSTR:
+        {
+            OUString aKey = rKey.GetOUString();
+            // TextCompare: case-insensitive, also for Vietnamese letters ("Hà Nội" = "hà nội")
+            return "s" + (mnCompareMode == 1 ? SbxVariable::NameToCaseInsensitiveName(aKey) : aKey);
+        }
+        case SbxOBJECT:
+        case SbxDATAOBJECT:
+            return "o" + OUString::number(reinterpret_cast<sal_IntPtr>(rKey.GetObject()));
+        case SbxEMPTY:
+            return u"e"_ustr;
+        default:
+            return "n" + OUString::number(rKey.GetDouble());
+    }
+}
+
+sal_Int32 BasicDictionary::implFind(SbxVariable& rKey) const
+{
+    auto it = maIndex.find(implKeyOf(rKey));
+    return it == maIndex.end() ? -1 : it->second;
+}
+
+sal_Int32 BasicDictionary::implAdd(SbxVariable& rKey, const SbxVariable* pItem)
+{
+    auto xKey = tools::make_ref<SbxVariable>(rKey);
+    xKey->SetFlag(SbxFlagBits::ReadWrite);
+    xKey->SetParameters(nullptr);
+    auto xItem = pItem ? tools::make_ref<SbxVariable>(*pItem) : tools::make_ref<SbxVariable>(SbxVARIANT);
+    xItem->SetFlag(SbxFlagBits::ReadWrite);
+    xItem->ResetFlag(SbxFlagBits::Fixed);
+    xItem->SetParameters(nullptr);
+    maIndex.emplace(implKeyOf(rKey), static_cast<sal_Int32>(maKeys.size()));
+    maKeys.push_back(xKey);
+    maItems.push_back(xItem);
+    return static_cast<sal_Int32>(maKeys.size()) - 1;
+}
+
+SbxVariable* BasicDictionary::GetItemForKey(SbxVariable& rKey)
+{
+    // VBA adds a missing key on read and on assignment (d(k) = v)
+    sal_Int32 nIndex = implFind(rKey);
+    if (nIndex < 0)
+        nIndex = implAdd(rKey, nullptr);
+    return maItems[nIndex].get();
+}
+
+SbxDimArray* BasicDictionary::implArray(const std::vector<SbxVariableRef>& rValues)
+{
+    SbxDimArray* pArray = new SbxDimArray(SbxVARIANT);
+    sal_Int32 nCount = static_cast<sal_Int32>(rValues.size());
+    pArray->unoAddDim(0, nCount - 1);
+    for (sal_Int32 i = 0; i < nCount; ++i)
+    {
+        SbxVariableRef xVar = new SbxVariable(*rValues[i]);
+        xVar->ResetFlag(SbxFlagBits::Fixed);
+        pArray->Put(xVar.get(), &i);
+    }
+    return pArray;
+}
+
+SbxDimArray* BasicDictionary::GetKeysArray() { return implArray(maKeys); }
+
+void BasicDictionary::implReturnArray(SbxVariable* pVar, SbxDimArray* pArray)
+{
+    SbxFlagBits nFlags = pVar->GetFlags();
+    pVar->ResetFlag(SbxFlagBits::Fixed);
+    pVar->PutObject(pArray);
+    pVar->SetFlags(nFlags);
+}
+
+void BasicDictionary::Notify(SfxBroadcaster& rCst, const SfxHint& rHint)
+{
+    const SbxHint* p = dynamic_cast<const SbxHint*>(&rHint);
+    if (!p)
+        return SbxObject::Notify(rCst, rHint);
+    const SfxHintId nId = p->GetId();
+    const bool bRead = nId == SfxHintId::BasicDataWanted;
+    const bool bWrite = nId == SfxHintId::BasicDataChanged;
+    SbxVariable* pVar = p->GetVar();
+    SbxArray* pArg = pVar->GetParameters();
+    const OUString aName = pVar->GetName();
+    const sal_uInt32 nArgs = pArg ? pArg->Count() : 0;
+
+    if (nId == SfxHintId::BasicInfoWanted)
+    {
+        if (aName.equalsIgnoreAsciiCase(aAddStr))
+            pVar->SetInfo(xAddInfo.get());
+        else if (aName.equalsIgnoreAsciiCase(aItemStr) || aName.equalsIgnoreAsciiCase(aExistsStr)
+                 || aName.equalsIgnoreAsciiCase(aRemoveStr))
+            pVar->SetInfo(xKeyInfo.get());
+        return SbxObject::Notify(rCst, rHint);
+    }
+    if (!bRead && !bWrite)
+        return SbxObject::Notify(rCst, rHint);
+
+    if (aName.equalsIgnoreAsciiCase(aCountStr))
+        pVar->PutLong(static_cast<sal_Int32>(maKeys.size()));
+    else if (aName.equalsIgnoreAsciiCase(aCompareModeStr))
+    {
+        if (bWrite)
+            mnCompareMode = pVar->GetLong() == 0 ? 0 : 1; // vbBinaryCompare / vbTextCompare
+        else
+            pVar->PutLong(mnCompareMode);
+    }
+    else if (aName.equalsIgnoreAsciiCase(aAddStr))
+    {
+        if (nArgs != 3)
+            return SetError(ERRCODE_BASIC_WRONG_ARGS);
+        if (implFind(*pArg->Get(1)) >= 0)
+            return lcl_vbaError(nErrKeyExists, u"This key is already associated with an element of this collection"_ustr);
+        implAdd(*pArg->Get(1), pArg->Get(2));
+    }
+    else if (aName.equalsIgnoreAsciiCase(aItemStr))
+    {
+        if (nArgs != 2)
+            return SetError(ERRCODE_BASIC_WRONG_ARGS);
+        SbxVariable* pItem = GetItemForKey(*pArg->Get(1));
+        if (bWrite)
+        {
+            SbxVariableRef xValue = new SbxVariable(*pVar);
+            xValue->SetParameters(nullptr);
+            *pItem = *xValue;
+        }
+        else
+            *(pArg->Get(0)) = *pItem;
+    }
+    else if (aName.equalsIgnoreAsciiCase(aExistsStr))
+    {
+        if (nArgs != 2)
+            return SetError(ERRCODE_BASIC_WRONG_ARGS);
+        pVar->PutBool(implFind(*pArg->Get(1)) >= 0);
+    }
+    else if (aName.equalsIgnoreAsciiCase(aRemoveStr))
+    {
+        if (nArgs != 2)
+            return SetError(ERRCODE_BASIC_WRONG_ARGS);
+        sal_Int32 nIndex = implFind(*pArg->Get(1));
+        if (nIndex < 0)
+            return lcl_vbaError(nErrNotFound, u"Element not found"_ustr);
+        maKeys.erase(maKeys.begin() + nIndex);
+        maItems.erase(maItems.begin() + nIndex);
+        maIndex.clear();
+        for (sal_Int32 i = 0; i < static_cast<sal_Int32>(maKeys.size()); ++i)
+            maIndex.emplace(implKeyOf(*maKeys[i]), i);
+    }
+    else if (aName.equalsIgnoreAsciiCase(aRemoveAllStr))
+    {
+        maKeys.clear();
+        maItems.clear();
+        maIndex.clear();
+    }
+    else if (aName.equalsIgnoreAsciiCase(aKeysStr))
+        implReturnArray(pVar, implArray(maKeys));
+    else if (aName.equalsIgnoreAsciiCase(aItemsStr))
+        implReturnArray(pVar, implArray(maItems));
+    else
+        return SbxObject::Notify(rCst, rHint);
+}
+
