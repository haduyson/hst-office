+// HST: the bundled default theme is named "HST Office" now; a document saved earlier, whose theme is
+// named "LibreOffice", opens with its own theme name and colours, which are never renamed or replaced.
+CPPUNIT_TEST_FIXTURE(SwCoreThemeTest, testThemeNamedLibreOfficeKeepsNameAndColors)
+{
+    createSwDoc("theme_named_libreoffice.fodt");
+    auto pModel = getSwDoc()->getIDocumentDrawModelAccess().GetDrawModel();
+    CPPUNIT_ASSERT(pModel);
+    auto pTheme = pModel->getTheme().get();
+    CPPUNIT_ASSERT(pTheme);
+    CPPUNIT_ASSERT_EQUAL(u"LibreOffice"_ustr, pTheme->GetName());
+    CPPUNIT_ASSERT_EQUAL(u"LibreOffice"_ustr, pTheme->getColorSet()->getName());
+    CPPUNIT_ASSERT_EQUAL(Color(0x123456), pTheme->GetColor(model::ThemeColorType::Accent1));
+    CPPUNIT_ASSERT_EQUAL(Color(0x000080), pTheme->GetColor(model::ThemeColorType::Dark1));
+
+    // the default for new documents is the bundled "HST Office" theme
+    auto const* pDefault = svx::ColorSets::get().getColorSet(u"HST Office");
+    CPPUNIT_ASSERT(pDefault);
+    CPPUNIT_ASSERT_EQUAL(u"HST Office"_ustr, svx::ColorSets::getDefault()->getName());
+}
