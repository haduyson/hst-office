--- a/sfx2/source/toolbox/tbxitem.cxx
+++ b/sfx2/source/toolbox/tbxitem.cxx
@@ -281,6 +281,14 @@
     Reference < XController > xController;
 
     SolarMutexGuard aGuard;
+    // HST: the state can arrive after this control and its toolbox were disposed. A dispatch delivers the
+    // first state from addStatusListener (ToolboxController::bindListener), and computing it may run a
+    // nested main loop with the SolarMutex released (the paste control's clipboard formats ask the
+    // system clipboard). Another thread (a UNO client switching the user interface mode) or a pending
+    // event can destroy the toolbar meanwhile: ToolBarManager::dispose disposes its controllers, then
+    // the ToolBox, whose ImplFormat then reads its released data (crash in ToolBox::GetItemRect).
+    if ( m_bDisposed || !pImpl->pBox || pImpl->pBox->isDisposed() )
+        return;
     if ( getFrameInterface().is() )
         xController = getFrameInterface()->getController();
 
