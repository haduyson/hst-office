     , m_xInfoSign(m_xBuilder->weld_button(u"infosign"_ustr))
     , m_xInfoUsbToken(m_xBuilder->weld_button(u"infousbtoken"_ustr))
     , m_xInfoVersions(m_xBuilder->weld_button(u"infoversions"_ustr))
+    , m_xInfoUnsaved(m_xBuilder->weld_button(u"infounsaved"_ustr))
     , m_xSaveAsFolder(m_xBuilder->weld_label(u"saveasfolder"_ustr))
     , m_xFormatList(m_xBuilder->weld_tree_view(u"formatlist"_ustr))
     , m_xSaveAsBrowse(m_xBuilder->weld_button(u"saveasbrowse"_ustr))
@@ -350,7 +351,7 @@ BackstageWindow::BackstageWindow(vcl::Window* pContainer, uno::Reference<frame::
     for (weld::Button* pButton :
          { m_xNewBlank.get(), m_xNewNd30.get(), m_xNewManage.get(), m_xOpenBrowse.get(),
            m_xInfoProperties.get(), m_xInfoSign.get(), m_xInfoUsbToken.get(), m_xInfoVersions.get(),
-           m_xSaveAsBrowse.get() })
+           m_xInfoUnsaved.get(), m_xSaveAsBrowse.get() })
         pButton->connect_clicked(LINK(this, BackstageWindow, ButtonClickHdl));
 
     m_xNewBlank->set_label(SfxResId(m_eApp == BackstageApp::Calc      ? STR_HST_BS_BLANK_CALC
@@ -1018,6 +1019,8 @@ IMPL_LINK(BackstageWindow, ButtonClickHdl, weld::Button&, rButton, void)
         CloseAndDispatch(u"org.hst.office.vi:SetupUsbToken"_ustr);
     else if (&rButton == m_xInfoVersions.get()) // "Phiên bản trước" of the bundled HST extension
         CloseAndDispatch(u"org.hst.office.vi:PreviousVersions"_ustr);
+    else if (&rButton == m_xInfoUnsaved.get()) // documents closed without saving, kept 7 days
+        CloseAndDispatch(u"org.hst.office.vi:UnsavedDocuments"_ustr);
     else if (&rButton == m_xSaveAsBrowse.get())
         CloseAndDispatch(u".uno:SaveAs"_ustr);
 }
