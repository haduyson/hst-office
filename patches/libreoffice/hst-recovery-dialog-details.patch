+IMPL_LINK(RecoveryDialog, HstTooltipHdl, const weld::TreeIter&, rIter, OUString)
+{
+    const TURLInfo* pInfo = weld::fromId<TURLInfo*>(m_xFileListLB->get_id(rIter));
+    if (!pInfo)
+        return OUString();
+    OUString aPath;
+    if (pInfo->OrgURL.isEmpty())
+        return SvxResId(RID_SVXSTR_HST_RECOV_NEVERSAVED);
+    if (osl::FileBase::getSystemPathFromFileURL(pInfo->OrgURL, aPath) != osl::FileBase::E_None)
+        aPath = INetURLObject(pInfo->OrgURL).GetMainURL(INetURLObject::DecodeMechanism::WithCharset);
+    return aPath;
 }
 
