+/// HST Office: local time and date the recovery copy was written, empty when there is none.
+OUString hst_copyTime(const OUString& rTempURL)
+{
+    osl::DirectoryItem aItem;
+    osl::FileStatus aStatus(osl_FileStatus_Mask_ModifyTime);
+    TimeValue aLocal;
+    oslDateTime aDT;
+    if (rTempURL.isEmpty() || osl::DirectoryItem::get(rTempURL, aItem) != osl::FileBase::E_None
+        || aItem.getFileStatus(aStatus) != osl::FileBase::E_None)
+        return OUString();
+    const TimeValue aUTC = aStatus.getModifyTime();
+    if (!osl_getLocalTimeFromSystemTime(&aUTC, &aLocal) || !osl_getDateTimeFromTimeValue(&aLocal, &aDT))
+        return OUString();
+    const LocaleDataWrapper& rLocale = Application::GetSettings().GetUILocaleDataWrapper();
+    return rLocale.getTime(tools::Time(aDT.Hours, aDT.Minutes, aDT.Seconds), false) + " "
+           + rLocale.getDate(Date(aDT.Day, aDT.Month, aDT.Year));
+}
