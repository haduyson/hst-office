+void IconThemeSelectorTest::HstClassicIsColibreAndKeepsEarlierProfiles()
+{
+    std::vector<vcl::IconThemeInfo> themes;
+    for (const auto& id : { u"colibre"_ustr, u"colibre_svg"_ustr, u"hst"_ustr, u"hst_dark"_ustr,
+                            u"hst_modern"_ustr, u"hst_modern_dark"_ustr, u"hst_classic"_ustr,
+                            u"hst_classic_dark"_ustr })
+    {
+        vcl::IconThemeInfo info;
+        info.mThemeId = id;
+        themes.push_back(info);
+    }
+    vcl::IconThemeSelector selector;
+    selector.SetPreferredIconTheme(u"colibre"_ustr, false);
+    // Automatic stays on the colourful style.
+    CPPUNIT_ASSERT_EQUAL(u"hst_modern"_ustr,
+        selector.SelectIconThemeForDesktopEnvironment(themes, DesktopType::GNOME));
+    // The options page value of the classic style, and the values of earlier profiles.
+    CPPUNIT_ASSERT_EQUAL(u"hst_classic"_ustr, selector.SelectIconTheme(themes, u"hst_classic"_ustr));
+    CPPUNIT_ASSERT_EQUAL(u"hst_classic"_ustr, selector.SelectIconTheme(themes, u"hst"_ustr));
+    CPPUNIT_ASSERT_EQUAL(u"hst_classic_dark"_ustr, selector.SelectIconTheme(themes, u"hst_dark"_ustr));
+    selector.SetPreferredIconTheme(u"colibre"_ustr, true);
+    CPPUNIT_ASSERT_EQUAL(u"hst_classic_dark"_ustr, selector.SelectIconTheme(themes, u"hst_classic"_ustr));
+    CPPUNIT_ASSERT_EQUAL(u"hst_classic_dark"_ustr, selector.SelectIconTheme(themes, u"hst"_ustr));
+    // An explicit upstream choice is untouched.
+    CPPUNIT_ASSERT_EQUAL(u"colibre_svg"_ustr, selector.SelectIconTheme(themes, u"colibre_svg"_ustr));
+}
+
 // Put the test suite in the registry
 CPPUNIT_TEST_SUITE_REGISTRATION(IconThemeSelectorTest);
 
