@@ -503,16 +503,18 @@
     rDop.cParas = rDStat.nPara;
     rDop.cLines = rDStat.nPara;
 
-    SwSectionFormats& rSections = rWrt.m_rDoc.GetSections();
-    if (!rSections.empty())
+    // HST Office: skip sections without nodes, like the one the layout creates for continuous
+    // endnotes; it does not ask for endnotes at the end of the section (see the DOCX export).
+    for (const SwSectionFormat* pFormat : rWrt.m_rDoc.GetSections())
