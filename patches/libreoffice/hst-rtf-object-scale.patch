HST Office: an RTF OLE object (MathType) takes Word's \picscalex / \picscaley, as a picture does.

Word keeps an OLE object's goal size (\objw / \objh, and \picwgoal / \pichgoal of its \result picture) when the
user resizes it, and writes the new size as a percentage: \objscalex / \objscaley on the object and the same
\picscalex / \picscaley on the \result picture. The RTF reader applied that percentage to plain pictures but not
to an object, which kept its unscaled goal size. A MathType formula shrunk in Word to fit the text came in larger
than the text around it, raised every line that holds one and added pages (synthetic exam sheet, 70 lines of 4
formulas shrunk to 75 %: 4 pages instead of the 3 pages of the same sheet at the scaled size). The object now
gets goal size x scale, the size Word shows; the .doc (PICF mx / my) and .docx (v:shape style) readers already
use the shown size.

Test: CppunitTest_sw_rtfimport testObjectScaleSetsObjectSize (an object at 60 % and one at 130 % x 75 %).

License: these upstream files remain under their original license (MPL-2.0).
---
diff --git a/sw/source/writerfilter/rtftok/rtfdocumentimpl.cxx b/sw/source/writerfilter/rtftok/rtfdocumentimpl.cxx
index 3598244..c56c074 100644
--- a/sw/source/writerfilter/rtftok/rtfdocumentimpl.cxx
+++ b/sw/source/writerfilter/rtftok/rtfdocumentimpl.cxx
@@ -1160,6 +1160,14 @@ void RTFDocumentImpl::resolvePict(bool const bInline, uno::Reference<drawing::XS
         aSize.Height
             = (m_aStates.top().getPicture().nGoalHeight ? m_aStates.top().getPicture().nGoalHeight
                                                         : m_aStates.top().getPicture().nHeight);
+        // Word shows the object at its goal size times \picscalex / \picscaley (an equation resized
+        // in Word keeps its goal size and only changes the scale), as for a plain picture below.
+        if (m_aStates.top().getPicture().nScaleX > 0)
+            aSize.Width = static_cast<sal_Int32>(
+                sal_Int64(aSize.Width) * m_aStates.top().getPicture().nScaleX / 100);
+        if (m_aStates.top().getPicture().nScaleY > 0)
+            aSize.Height = static_cast<sal_Int32>(
+                sal_Int64(aSize.Height) * m_aStates.top().getPicture().nScaleY / 100);
         xShape->setSize(aSize);
 
         // Replacement graphic is inline by default, see oox::vml::SimpleShape::implConvertAndInsert().
diff --git a/sw/qa/extras/rtfimport/rtfimport.cxx b/sw/qa/extras/rtfimport/rtfimport.cxx
index 04e0997..0d18f8a 100644
--- a/sw/qa/extras/rtfimport/rtfimport.cxx
+++ b/sw/qa/extras/rtfimport/rtfimport.cxx
@@ -1024,6 +1024,21 @@ CPPUNIT_TEST_FIXTURE(Test, testRunPositionMovesInlineObjects)
     CPPUNIT_ASSERT_EQUAL(3, nMoved);
 }
 
+CPPUNIT_TEST_FIXTURE(Test, testObjectScaleSetsObjectSize)
+{
+    // An equation resized in Word keeps its goal size (\picwgoal797 \pichgoal299, 1406 x 527 mm100)
+    // and gets \picscalex / \picscaley (with the same \objscalex / \objscaley): Word shows it at the
+    // scaled size. Without the fix both objects kept the 1406 x 527 goal size.
+    createSwDoc("hst-object-scale.rtf");
+    CPPUNIT_ASSERT_EQUAL(2, getShapes());
+    awt::Size aSize = getShape(1)->getSize();
+    CPPUNIT_ASSERT_DOUBLES_EQUAL(843.0, double(aSize.Width), 2.0); // 1406 * 60%
+    CPPUNIT_ASSERT_DOUBLES_EQUAL(316.0, double(aSize.Height), 2.0); // 527 * 60%
+    aSize = getShape(2)->getSize();
+    CPPUNIT_ASSERT_DOUBLES_EQUAL(1827.0, double(aSize.Width), 2.0); // 1406 * 130%
+    CPPUNIT_ASSERT_DOUBLES_EQUAL(395.0, double(aSize.Height), 2.0); // 527 * 75%
+}
+
 // tests should only be added to rtfIMPORT *if* they fail round-tripping in rtfEXPORT
 } // end of anonymous namespace
 CPPUNIT_PLUGIN_IMPLEMENT();
