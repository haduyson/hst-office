@@ -67,6 +71,18 @@
 
 IMPL_LINK_NOARG(SwPageNumberDlg, OkHdl, weld::Button&, void) { m_xDialog->response(RET_OK); }
 
+IMPL_LINK_NOARG(SwPageNumberDlg, HstStartAtHdl, weld::Toggleable&, void)
+{
+    m_xHstStartAtValue->set_sensitive(m_xHstStartAt->get_active());
+}
+
+std::optional<sal_uInt16> SwPageNumberDlg::GetPageNumberStartAt() const
+{
+    if (!m_xHstStartAt->get_active())
+        return std::nullopt;
+    return static_cast<sal_uInt16>(m_xHstStartAtValue->get_value());
+}
+
 IMPL_LINK_NOARG(SwPageNumberDlg, PositionSelectHdl, weld::ComboBox&, void)
 {
     m_aPageNumberPosition = m_xPageNumberPosition->get_active();
