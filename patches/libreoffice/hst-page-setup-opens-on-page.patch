                           sPageId = static_cast<const SfxStringItem*>(pItem)->GetValue();
+                        // HST: Page Setup (ribbon, its launcher, the Format menu) opens on the page tab
+                        // as in Word, not on the tab the dialog was last closed on (e.g. the organizer).
+                        if (sPageId.isEmpty())
+                            sPageId = "page";
                         break;
                 }
                 rTempView.GetDocShell()->FormatPage(rReq.GetFrameWeld(), rPageDesc.GetName(), sPageId, rSh, &rReq);
