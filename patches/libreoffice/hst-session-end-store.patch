+using namespace css;
+
+// systemd ends a desktop session (log out, shut down) with SIGTERM to every process of the session,
+// SIGKILL follows after its stop timeout (90 s by default); desktops without the GNOME session
+// protocol (KDE, ...) end the office only this way. sal's handler used to _exit(255) at once: the
+// changes since the last recovery copy were lost and the next start offered the recovery dialog.
+// Now the signal handler only writes to a pipe; a watcher thread posts the session end to the main
+// thread: AutoRecovery's session end (the session restart without the restart) stores, checks and
+// closes every document, then the office terminates normally and the next start reopens the
+// documents silently. When a document cannot be stored, the office ends at once as before (the
+// next start offers the last recovery copy); without a clean end within the deadline (a hung
+// main thread) too. Further SIGTERMs meanwhile (systemd signals every process of the session and
+// oosplash forwards its own) change nothing: the deadline still holds.
+namespace
+{
+constexpr auto DEADLINE = std::chrono::seconds(20);
+int g_aPipe[2] = { -1, -1 };
+std::atomic<bool> g_bPending(false);
+
+// as sal's handler did, with the note the bundled extension reads at the next start
+[[noreturn]] void endNow()
+{
+    static const char aNote[] = "\n\nTerminated: Signal 15\n";
+    ssize_t nIgnored = write(STDERR_FILENO, aNote, sizeof aNote - 1);
+    (void)nIgnored;
+    _exit(255);
+}
+
+oslSignalAction onSignal(void*, oslSignalInfo* pInfo)
+{
+    if (pInfo->Signal != osl_Signal_Terminate || pInfo->UserSignal != SIGTERM)
+        return osl_Signal_ActCallNextHdl;
+    if (g_bPending.exchange(true)) // async-signal-safe: std::atomic<bool> is lock-free
+        return osl_Signal_ActIgnore; // already ending, within the deadline
+    const char c = 1;
+    if (write(g_aPipe[1], &c, 1) != 1)
+        return osl_Signal_ActCallNextHdl;
+    return osl_Signal_ActIgnore;
+}
+
+bool anyDocumentModified(const uno::Reference<uno::XComponentContext>& xContext)
+{
+    uno::Reference<container::XEnumeration> xComponents
+        = frame::Desktop::create(xContext)->getComponents()->createEnumeration();
+    while (xComponents->hasMoreElements())
+    {
+        uno::Reference<util::XModifiable> xModifiable(xComponents->nextElement(), uno::UNO_QUERY);
+        if (xModifiable.is() && xModifiable->isModified())
+            return true;
+    }
+    return false;
+}
+
+struct SessionEnd
+{
+    DECL_STATIC_LINK(SessionEnd, OnMainThread, void*, void);
+};
+
+IMPL_STATIC_LINK_NOARG(SessionEnd, OnMainThread, void*, void)
+{
+    try
+    {
+        const uno::Reference<uno::XComponentContext>& xContext
+            = comphelper::getProcessComponentContext();
+        util::URL aURL;
+        aURL.Complete = u"vnd.sun.star.autorecovery:/doSessionEnd"_ustr;
+        util::URLTransformer::create(xContext)->parseStrict(aURL);
+        frame::theAutoRecovery::get(xContext)->dispatch(
+            aURL, { comphelper::makePropertyValue(u"DispatchAsynchron"_ustr, false) });
+        if (anyDocumentModified(xContext))
+        {
+            SAL_WARN("desktop.app", "session end: not every document could be stored");
+            endNow();
+        }
+        uno::Reference<frame::XDesktop2> xDesktop = frame::Desktop::create(xContext);
+        uno::Reference<beans::XPropertySet>(xDesktop, uno::UNO_QUERY_THROW)
+            ->setPropertyValue(u"SuspendQuickstartVeto"_ustr, uno::Any(true));
+        if (!xDesktop->terminate())
+            endNow(); // vetoed: the documents are stored, end as the system asked
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("desktop.app", "session end failed");
+        endNow();
+    }
+}
+
+void watch()
+{
+    char c;
+    ssize_t n;
+    while ((n = read(g_aPipe[0], &c, 1)) < 0 && errno == EINTR)
+    {
+    }
+    if (n != 1)
+        return;
+    Application::PostUserEvent(LINK(nullptr, SessionEnd, OnMainThread));
+    std::this_thread::sleep_for(DEADLINE);
+    endNow();
+}
+}
+
+void desktop::hst::installSessionEndOnTerminate()
+{
+    static bool bInstalled = false;
+    if (bInstalled)
+        return;
+    bInstalled = true;
+    if (pipe2(g_aPipe, O_CLOEXEC) != 0)
+    {
+        SAL_WARN("desktop.app", "session end: no pipe, SIGTERM ends the office at once");
+        return;
+    }
+    try
+    {
+        std::thread(watch).detach();
+    }
+    catch (const std::system_error&)
+    {
+        SAL_WARN("desktop.app", "session end: no watcher thread, SIGTERM ends the office at once");
+        return;
+    }
+    osl_addSignalHandler(onSignal, nullptr);
+}
+
+#else
+
+void desktop::hst::installSessionEndOnTerminate() {}
+
+#endif
