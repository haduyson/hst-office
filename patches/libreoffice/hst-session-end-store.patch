+// HST Office: store every open document for the next start: AutoRecovery's session end (the session
+// restart without the restart) stores each one to its recovery file, checks them and closes them
+// keeping their modified state; the next start reopens them silently. Nothing is closed when a
+// document cannot be taken. Windows shows the reason while this holds the shut down.
+static void ImplHstStoreSession( HWND hWnd )
+{
+    ShutdownBlockReasonCreate( hWnd, o3tl::toW( VclResId( STR_UNSAVED_DOCUMENTS ).getStr() ) );
+    try
+    {
+        const css::uno::Reference<css::uno::XComponentContext>& xContext
+            = comphelper::getProcessComponentContext();
+        css::util::URL aURL;
+        aURL.Complete = u"vnd.sun.star.autorecovery:/doSessionEnd"_ustr;
+        css::util::URLTransformer::create( xContext )->parseStrict( aURL );
+        css::frame::theAutoRecovery::get( xContext )->dispatch(
+            aURL, { comphelper::makePropertyValue( u"DispatchAsynchron"_ustr, false ) } );
+    }
+    catch ( const css::uno::Exception& )
+    {
+        TOOLS_WARN_EXCEPTION( "vcl", "session end: the documents could not be stored" );
+    }
+    ShutdownBlockReasonDestroy( hWnd );
+}
