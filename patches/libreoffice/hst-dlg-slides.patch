@@ -34,6 +34,9 @@
 
 #include <vcl/tabs.hrc>
 
+// HST: PowerPoint calls the slide background "Format Background"; RID_TAB_BACKGROUND is shared.
+#define STR_HST_TAB_FORMAT_BACKGROUND NC_("drawpagedialog|formatbackground", "Format Background")
