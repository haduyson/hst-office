+/**
+ * Why a PDF signature does not verify. It only explains the verdict of SignatureInformation::nStatus
+ * and never changes it.
+ */
+enum class PDFSignatureProblem
+{
+    /// The signature verifies.
+    None,
+    /// The file was written again after signing: the bytes between the signed ranges are no
+    /// longer the signature's hex string, or the file ends before them.
+    Rewritten,
+    /// The signature is still in place, but the file ends before the signed data does: an
+    /// incomplete copy, e.g. a download that did not finish.
+    Incomplete,
+    /// The signed bytes are intact, but a later update changes the document in a way the signature
+    /// does not allow.
+    ModifiedAfterSigning,
+    /// The file still has the signed structure, but its bytes no longer match the signature.
+    ContentChanged,
+    /// The signature data cannot be read: no or unreadable CMS, an unsupported sub-filter, or
+    /// malformed or too many byte ranges.
