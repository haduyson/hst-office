+/// Verifies a PDF held in memory; the file must have exactly one signature.
+std::pair<SignatureInformation, PDFSignatureProblem> verifyOneSignature(std::vector<char>& rData)
+{
+    SvMemoryStream aStream(rData.data(), rData.size(), StreamMode::READ);
+    PDFSignatureHelper aHelper;
+    CPPUNIT_ASSERT(aHelper.ReadAndVerifySignatureSvStream(aStream));
+    CPPUNIT_ASSERT_EQUAL(size_t(1), aHelper.GetSignatureInformations().size());
+    CPPUNIT_ASSERT_EQUAL(size_t(1), aHelper.GetSignatureProblems().size());
+    return { aHelper.GetSignatureInformations()[0], aHelper.GetSignatureProblems()[0] };
