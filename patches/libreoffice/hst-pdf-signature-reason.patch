+/// A signature normally has exactly 2 ranges; more than this many are rejected unread.
+constexpr size_t MAX_BYTE_RANGES = 16;
+
+/**
+ * Few ranges whose lengths add up to at most the file size. Signing::Verify allocates the sum of
+ * the lengths, so only bounded ranges are ever hashed.
+ */
+bool AreByteRangesBounded(const std::vector<std::pair<size_t, size_t>>& rByteRanges,
+                          sal_uInt64 nFileEnd)
+{
+    if (rByteRanges.size() > MAX_BYTE_RANGES)
+        return false;
+    sal_uInt64 nTotal = 0;
+    for (const auto& rRange : rByteRanges)
+    {
+        if (rRange.second > nFileEnd)
+            return false;
+        nTotal += rRange.second;
+        if (nTotal > nFileEnd)
+            return false;
+    }
+    return true;
+}
+
+/**
