+bool IsSignatureInsideFile(const std::vector<std::pair<size_t, size_t>>& rByteRanges,
+                           sal_uInt64 nFileEnd)
+{
+    if (rByteRanges.size() < 2 || rByteRanges.size() > MAX_BYTE_RANGES)
+        return false;
+    for (const auto& rRange : rByteRanges)
+        if (rRange.first > o3tl::make_unsigned(SAL_MAX_INT32)
+            || rRange.second > o3tl::make_unsigned(SAL_MAX_INT32))
+            return false;
+    const size_t nGapStart = rByteRanges[0].first + rByteRanges[0].second;
+    const size_t nGapEnd = rByteRanges[1].first;
