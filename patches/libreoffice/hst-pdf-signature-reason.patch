+/// Needs well-formed ranges (bByteRangesValid): two of them, the gap between them.
+SignedGap ExamineSignedGap(SvStream& rStream, const Signature& rSignature)
+{
+    const std::vector<std::pair<size_t, size_t>>& rRanges = rSignature.m_aByteRanges;
+    const size_t nGapStart = rRanges[0].first + rRanges[0].second;
+    const size_t nGapEnd = rRanges[1].first;
+    if (nGapEnd < nGapStart + 2 || nGapEnd > rStream.TellEnd())
+        return SignedGap::PastEnd;
