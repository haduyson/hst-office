+/// What the checks of one signature found, to explain an invalid one.
+struct SignatureFindings
+{
+    /// The byte ranges have the expected form: two ranges, from 0, around the signature.
+    bool bByteRangesValid = false;
+    /// The CMS could be parsed and names its signing certificate.
+    bool bCmsRead = false;
+    /// The CMS verifies over the bytes at /ByteRange.
+    bool bCmsVerified = false;
+};
+
+/// Byte ranges limited to the file, so that reading them never allocates past its end.
+std::vector<std::pair<size_t, size_t>>
+ClampedByteRanges(const std::vector<std::pair<size_t, size_t>>& rByteRanges, sal_uInt64 nFileEnd)
+{
+    std::vector<std::pair<size_t, size_t>> aRet;
+    for (const auto& rRange : rByteRanges)
+    {
+        if (rRange.first >= nFileEnd)
+            continue;
+        aRet.emplace_back(rRange.first,
+                          static_cast<size_t>(std::min<sal_uInt64>(rRange.second, nFileEnd - rRange.first)));
+    }
+    return aRet;
+}
+
+/**
+ * Reads the signer, the signing time and the digest algorithm from the CMS when the signature is
+ * already known to be invalid, so that the user still sees who signed and when. The status of
+ * rInformation is not touched.
+ */
+void ReadSignerFromCms(SvStream& rStream, const Signature& rSignature, bool bNonDetached,
+                       const std::vector<unsigned char>& rContents,
+                       SignatureInformation& rInformation, SignatureFindings& rFindings)
+{
+    SignatureInformation aCms(rInformation.nSecurityId);
+    aCms.stDateTime = rInformation.stDateTime;
+    const std::vector<std::pair<size_t, size_t>> aByteRanges
+        = ClampedByteRanges(rSignature.m_aByteRanges, rStream.TellEnd());
+    if (!svl::crypto::Signing::Verify(rStream, aByteRanges, bNonDetached, rContents, aCms)
+        || aCms.X509Datas.empty())
+        return;
+    rFindings.bCmsRead = true;
+    rFindings.bCmsVerified
+        = aCms.nStatus == xml::crypto::SecurityOperationStatus_OPERATION_SUCCEEDED;
+    rInformation.X509Datas = aCms.X509Datas;
+    rInformation.stDateTime = aCms.stDateTime;
+    rInformation.ouDateTime = aCms.ouDateTime;
+    rInformation.nDigestID = aCms.nDigestID;
+    rInformation.bHasSigningCertificate = aCms.bHasSigningCertificate;
+}
+
+bool IsPdfWhitespace(unsigned char c)
+{
+    return c == ' ' || c == '\n' || c == '\r' || c == '\t' || c == '\f' || c == '\0';
+}
+
+bool IsHexDigit(unsigned char c)
+{
+    return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');
+}
+
+/**
+ * Detects a file that was rewritten as a whole after signing, for example by a document system
+ * that adds a per-download watermark and saves the file again: the /ByteRange values are copied
+ * unchanged, but they no longer describe the file. Either a range ends past the end of the file,
+ * or the gap between the two ranges no longer holds the signature's hex string.
+ */
+bool IsRewrittenAfterSigning(SvStream& rStream, const Signature& rSignature)
+{
+    const std::vector<std::pair<size_t, size_t>>& rRanges = rSignature.m_aByteRanges;
+    if (rRanges.size() < 2)
+        return false;
+    // negative values in the dictionary become huge here: malformed, not rewritten
+    for (const auto& rRange : rRanges)
+        if (rRange.first > o3tl::make_unsigned(SAL_MAX_INT32)
+            || rRange.second > o3tl::make_unsigned(SAL_MAX_INT32))
+            return false;
+
+    const sal_uInt64 nFileEnd = rStream.TellEnd();
+    for (const auto& rRange : rRanges)
+        if (rRange.first + rRange.second > nFileEnd)
+            return true;
+
+    const size_t nGapStart = rRanges[0].first + rRanges[0].second;
+    const size_t nGapEnd = rRanges[1].first;
+    if (nGapEnd < nGapStart + 2)
+        return false;
+
+    const sal_uInt64 nPos = rStream.Tell();
+    rStream.Seek(nGapStart);
+    bool bHexString = true;
+    std::vector<unsigned char> aChunk(4096);
+    for (size_t nOffset = nGapStart; bHexString && nOffset < nGapEnd;)
+    {
+        const size_t nWanted = std::min(aChunk.size(), nGapEnd - nOffset);
+        if (rStream.ReadBytes(aChunk.data(), nWanted) != nWanted)
+        {
+            bHexString = false;
+            break;
+        }
+        for (size_t i = 0; i < nWanted; ++i, ++nOffset)
+        {
+            const unsigned char c = aChunk[i];
+            if (nOffset == nGapStart)
+                bHexString = c == '<';
+            else if (nOffset == nGapEnd - 1)
+                bHexString = c == '>';
+            else
+                bHexString = IsHexDigit(c) || IsPdfWhitespace(c);
+            if (!bHexString)
+                break;
+        }
+    }
+    rStream.Seek(nPos);
+    return !bHexString;
+}
+
+PDFSignatureProblem GetSignatureProblem(SvStream& rStream, const Signature& rSignature,
+                                        const SignatureInformation& rInformation,
+                                        const SignatureFindings& rFindings)
+{
+    if (rInformation.nStatus == xml::crypto::SecurityOperationStatus_OPERATION_SUCCEEDED)
+        return PDFSignatureProblem::None;
+    if (IsRewrittenAfterSigning(rStream, rSignature))
+        return PDFSignatureProblem::Rewritten;
+    if (!rFindings.bByteRangesValid || !rFindings.bCmsRead)
+        return PDFSignatureProblem::Broken;
+    if (rFindings.bCmsVerified)
+        return PDFSignatureProblem::ModifiedAfterSigning;
+    return PDFSignatureProblem::ContentChanged;
+}
