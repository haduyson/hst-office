+/// Verifies a PDF held in memory; the file must have exactly one signature.
+std::pair<SignatureInformation, PDFSignatureProblem> verifyOneSignature(std::vector<char>& rData)
+{
+    SvMemoryStream aStream(rData.data(), rData.size(), StreamMode::READ);
+    PDFSignatureHelper aHelper;
+    CPPUNIT_ASSERT(aHelper.ReadAndVerifySignatureSvStream(aStream));
+    CPPUNIT_ASSERT_EQUAL(size_t(1), aHelper.GetSignatureInformations().size());
+    CPPUNIT_ASSERT_EQUAL(size_t(1), aHelper.GetSignatureProblems().size());
+    return { aHelper.GetSignatureInformations()[0], aHelper.GetSignatureProblems()[0] };
+}
+
+/// The four numbers of the first /ByteRange in rData.
+std::vector<size_t> readByteRange(const std::vector<char>& rData)
+{
+    const std::string_view aData(rData.data(), rData.size());
+    size_t nPos = aData.find("/ByteRange");
+    CPPUNIT_ASSERT(nPos != std::string_view::npos);
+    nPos = aData.find('[', nPos);
+    CPPUNIT_ASSERT(nPos != std::string_view::npos);
+    std::vector<size_t> aRet;
+    while (aRet.size() < 4 && ++nPos < aData.size())
+    {
+        if (aData[nPos] < '0' || aData[nPos] > '9')
+            continue;
+        size_t nValue = 0;
+        for (; nPos < aData.size() && aData[nPos] >= '0' && aData[nPos] <= '9'; ++nPos)
+            nValue = nValue * 10 + (aData[nPos] - '0');
+        aRet.push_back(nValue);
+    }
+    CPPUNIT_ASSERT_EQUAL(size_t(4), aRet.size());
+    return aRet;
+}
+
+void assertProblem(PDFSignatureProblem eExpected, PDFSignatureProblem eActual, const char* pCase)
+{
+    CPPUNIT_ASSERT_EQUAL_MESSAGE(pCase, static_cast<int>(eExpected), static_cast<int>(eActual));
+}
+
+/// A minimal one-page PDF with one signature field: its /Contents hex string and /ByteRange.
+std::vector<char> makeSignatureFieldPdf(const OString& rContentsHex, const OString& rByteRange)
+{
+    const OString aObjects[] = {
+        "<< /Type /Catalog /Pages 2 0 R /AcroForm << /Fields [4 0 R] /SigFlags 3 >> >>"_ostr,
+        "<< /Type /Pages /Kids [3 0 R] /Count 1 >>"_ostr,
+        "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 200 200] /Annots [4 0 R] >>"_ostr,
+        "<< /Type /Annot /Subtype /Widget /FT /Sig /T (Sig1) /Rect [0 0 0 0] /P 3 0 R /V 5 0 R >>"_ostr,
+        "<< /Type /Sig /Filter /Adobe.PPKLite /SubFilter /adbe.pkcs7.detached /Contents <"_ostr
+            + rContentsHex + "> /ByteRange [ " + rByteRange + " ] >>",
+    };
+    OStringBuffer aPdf("%PDF-1.7\n");
+    std::vector<sal_Int32> aOffsets;
+    for (size_t i = 0; i < std::size(aObjects); ++i)
+    {
+        aOffsets.push_back(aPdf.getLength());
+        aPdf.append(OString::number(i + 1) + " 0 obj\n" + aObjects[i] + "\nendobj\n");
+    }
+    const sal_Int32 nXref = aPdf.getLength();
+    aPdf.append("xref\n0 " + OString::number(std::size(aObjects) + 1) + "\n0000000000 65535 f \n");
+    for (sal_Int32 nOffset : aOffsets)
+    {
+        OString aOffset = OString::number(nOffset);
+        aPdf.append(OString::Concat(std::string_view("0000000000", 10 - aOffset.getLength())) + aOffset
+                    + " 00000 n \n");
+    }
+    aPdf.append("trailer\n<< /Size " + OString::number(std::size(aObjects) + 1)
+                + " /Root 1 0 R >>\nstartxref\n" + OString::number(nXref) + "\n%%EOF\n");
+    return std::vector<char>(aPdf.getStr(), aPdf.getStr() + aPdf.getLength());
+}
