+/// What the checks of one signature found, to explain an invalid one.
+struct SignatureFindings
+{
+    /// The byte ranges have the expected form: from 0, around the signature, at most
+    /// MAX_BYTE_RANGES of them.
+    bool bByteRangesValid = false;
