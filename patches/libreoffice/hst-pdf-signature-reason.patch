+/// An invalid signature gets a reason, keeps its signer, and its verdict does not change.
+CPPUNIT_TEST_FIXTURE(PDFSigningTest, testSignatureProblems)
+{
+    std::shared_ptr<vcl::pdf::PDFium> pPDFium = vcl::pdf::PDFiumLibrary::get();
+    if (!pPDFium)
+    {
+        return;
+    }
+    uno::Reference<xml::crypto::XSEInitializer> xSEInitializer
+        = xml::crypto::SEInitializer::create(m_xContext);
+    uno::Reference<xml::crypto::XXMLSecurityContext> xSecurityContext
+        = xSEInitializer->createSecurityContext(OUString());
+
+    std::vector<char> aOriginal;
+    {
+        SvFileStream aFile(m_directories.getURLFromSrc(DATA_DIRECTORY) + "good-pades.pdf",
+                           StreamMode::READ);
+        aOriginal.resize(aFile.TellEnd());
+        CPPUNIT_ASSERT_EQUAL(aOriginal.size(), aFile.ReadBytes(aOriginal.data(), aOriginal.size()));
+    }
+    const std::vector<size_t> aRange = readByteRange(aOriginal);
+    const size_t nGapStart = aRange[0] + aRange[1];
+    CPPUNIT_ASSERT_EQUAL('<', aOriginal[nGapStart]);
+    // the signature covers the file up to its end
+    CPPUNIT_ASSERT_EQUAL(aOriginal.size(), aRange[2] + aRange[3]);
+
+    {
+        std::vector<char> aData(aOriginal);
+        auto [aInfo, eProblem] = verifyOneSignature(aData);
+        CPPUNIT_ASSERT_EQUAL(xml::crypto::SecurityOperationStatus_OPERATION_SUCCEEDED,
+                             aInfo.nStatus);
+        assertProblem(PDFSignatureProblem::None, eProblem, "unchanged");
+    }
+    {
+        // one signed byte differs (the version digit of the header), the structure is intact
+        std::vector<char> aData(aOriginal);
+        CPPUNIT_ASSERT_EQUAL(std::string_view("%PDF-1."), std::string_view(aData.data(), 7));
+        aData[7] = aData[7] == '7' ? '6' : '7';
+        auto [aInfo, eProblem] = verifyOneSignature(aData);
+        CPPUNIT_ASSERT(aInfo.nStatus != xml::crypto::SecurityOperationStatus_OPERATION_SUCCEEDED);
+        assertProblem(PDFSignatureProblem::ContentChanged, eProblem, "content changed");
+        CPPUNIT_ASSERT(!aInfo.X509Datas.empty());
+    }
+    {
+        // the file is one byte shorter than the signed range, the signature is in place: an
+        // incomplete copy
+        std::vector<char> aData(aOriginal.begin(), aOriginal.end() - 1);
+        auto [aInfo, eProblem] = verifyOneSignature(aData);
+        CPPUNIT_ASSERT(aInfo.nStatus != xml::crypto::SecurityOperationStatus_OPERATION_SUCCEEDED);
+        assertProblem(PDFSignatureProblem::Incomplete, eProblem, "range past the end of the file");
+        CPPUNIT_ASSERT(!aInfo.X509Datas.empty());
+    }
+    {
+        // the bytes between the ranges are no longer the signature's hex string
+        std::vector<char> aData(aOriginal);
+        aData[nGapStart + 1] = '\x01';
+        auto [aInfo, eProblem] = verifyOneSignature(aData);
+        CPPUNIT_ASSERT(aInfo.nStatus != xml::crypto::SecurityOperationStatus_OPERATION_SUCCEEDED);
+        assertProblem(PDFSignatureProblem::Rewritten, eProblem, "no hex string between the ranges");
+    }
+    {
+        // malformed /ByteRange values, written over the original ones with the same length:
+        // invalid, broken, never classified from the gap
+        const std::pair<std::string_view, std::string_view> aMalformed[] = {
+            { "[ 0 6887 56889 1119 ]", "[ 1 6886 56889 1119 ]" }, // first range does not start at 0
+            { "[ 0 6887 56889 1119 ]", "[ 0 6887 56888 1119 ]" }, // gap is not the signature
+            { "[ 0 6887 56889 1119 ]", "[ 0 6887            ]" }, // fewer than 2 ranges
+        };
+        for (const auto& [rFrom, rTo] : aMalformed)
+        {
+            std::vector<char> aData(aOriginal);
+            const std::string_view aView(aData.data(), aData.size());
+            const size_t nPos = aView.find(rFrom);
+            CPPUNIT_ASSERT(nPos != std::string_view::npos);
+            std::copy(rTo.begin(), rTo.end(), aData.begin() + nPos);
+            auto [aInfo, eProblem] = verifyOneSignature(aData);
+            CPPUNIT_ASSERT_EQUAL(xml::crypto::SecurityOperationStatus_UNKNOWN, aInfo.nStatus);
+            assertProblem(PDFSignatureProblem::Broken, eProblem, rTo.data());
+        }
+    }
+    {
+        // the CMS itself is damaged: its DER header is gone
+        std::vector<char> aData(aOriginal);
+        for (size_t i = 1; i <= 8; ++i)
+            aData[nGapStart + i] = '0';
+        auto [aInfo, eProblem] = verifyOneSignature(aData);
+        CPPUNIT_ASSERT(aInfo.nStatus != xml::crypto::SecurityOperationStatus_OPERATION_SUCCEEDED);
+        assertProblem(PDFSignatureProblem::Broken, eProblem, "damaged CMS");
+    }
