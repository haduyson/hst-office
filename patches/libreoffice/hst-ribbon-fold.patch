             setPrimaryDimension(aChildSize, 0);
 
         accumulateMaxes(aChildSize, aSize);
@@ -106,6 +112,15 @@
 
     tools::Long nWidth = GetSizePixel().Width();
     tools::Long nCurrentWidth = VclHBox::calculateRequisition().getWidth();
+
+    // HST Office: groups already folded by a merged child still count, or the block with a
+    // priority would come back as soon as they are hidden, and would never give way to them.
+    for (vcl::Window* pChild = GetWindow(GetWindowType::FirstChild); pChild;
+         pChild = pChild->GetWindow(GetWindowType::Next))
+    {
+        if (const PriorityMergedHBox* pMerged = dynamic_cast<const PriorityMergedHBox*>(pChild))
+            nCurrentWidth += pMerged->GetHiddenWidth();
+    }
 
     // Hide lower priority controls
     for (vcl::IPrioritable* pPrioritable : m_aSortedChildren)
