HST Office: the right-hand block of a ribbon tab folds before its groups.

The block with the tab menu and Find folds into its button as soon as the groups would not fit, so Paragraph and the
other groups stay visible longer. The merged box reports the width of its hidden groups for that test.

License: these upstream files remain under their original license (MPL-2.0).
---
--- a/vcl/inc/PriorityMergedHBox.hxx
+++ b/vcl/inc/PriorityMergedHBox.hxx
@@ -40,6 +40,9 @@
 
     bool HasHiddenChildren() const;
 
+    /// HST Office: the width its hidden children would need, added to the requisition
+    tools::Long GetHiddenWidth() const;
+
     Size calculateRequisition() const override;
 
     void GetChildrenWithPriorities() override{};
--- a/vcl/source/control/PriorityMergedHBox.cxx
+++ b/vcl/source/control/PriorityMergedHBox.cxx
@@ -132,6 +132,18 @@
     return false;
 }
 
+tools::Long PriorityMergedHBox::GetHiddenWidth() const
+{
+    tools::Long nWidth = 0;
+    for (int i = 0; i < GetChildCount(); i++)
+    {
+        vcl::Window* pWindow = GetChild(i);
+        if (pWindow && pWindow != m_pButton && pWindow->GetParent() == this && !pWindow->IsVisible())
+            nWidth += getLayoutRequisition(*pWindow).Width() + get_spacing();
+    }
+    return nWidth;
+}
+
 Size PriorityMergedHBox::calculateRequisition() const
 {
     if (!m_bInitialized)
