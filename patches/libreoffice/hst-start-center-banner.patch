+IMPL_LINK(BackingWindow, OnSolutionClick, weld::Button&, rButton, void)
+{
+    OUString sURL;
+    if (mxMoreSolutions.get() == &rButton)
+        sURL = u"https://hasontech.vn"_ustr;
+    for (int i = 0; sURL.isEmpty() && i < HST_SOLUTION_COUNT; ++i)
+        if (mxSolutionButtons[i].get() == &rButton)
+            sURL = aHstSolutions[i].aURL;
+    if (sURL.isEmpty())
+        return;
+    try
+    {
+        css::system::SystemShellExecute::create(::comphelper::getProcessComponentContext())
+            ->execute(sURL + "?" + sHstSolutionUtm, OUString(),
+                      css::system::SystemShellExecuteFlags::URIS_ONLY);
+    }
+    catch (const Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("fwk", "opening the HASON TECH page failed");
+    }
 }
 
