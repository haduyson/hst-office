HST Office: the split buttons of the Writer ribbon (generated with hst-ribbon-ux-writer.patch).

"Dán ▾" lists Chỉ dán văn bản and Dán đặc biệt; "Chèn trích dẫn ▾" lists Thêm nguồn mới, Nhập từ tệp and Chèn
lại trích dẫn. Writer-only GenericPopupToolbarController nodes in Controller.xcu and two popup menu files, as the
Sheets "Định dạng ngày tháng" button. A click on either button still runs its own command.

License: these upstream files remain under their original license (MPL-2.0).
---
--- a/officecfg/registry/data/org/openoffice/Office/UI/Controller.xcu
+++ b/officecfg/registry/data/org/openoffice/Office/UI/Controller.xcu
@@ -2150,6 +2150,37 @@
           <value>private:resource/popupmenu/hstformatdate</value>
         </prop>
       </node>
+      <!-- HST Office: "Dán" of the Writer ribbon: the arrow offers plain text and Paste Special instead of the clipboard formats. -->
+      <node oor:name="HstWriterPasteSplitButton" oor:op="replace">
+        <prop oor:name="Command">
+          <value>.uno:Paste</value>
+        </prop>
+        <prop oor:name="Module">
+          <value>com.sun.star.text.TextDocument</value>
+        </prop>
+        <prop oor:name="Controller">
+          <value>com.sun.star.comp.framework.GenericPopupToolbarController</value>
+        </prop>
+        <prop oor:name="Value">
+          <value>private:resource/popupmenu/hstpaste</value>
+        </prop>
+      </node>
+      <!-- HST Office: "Chèn trích dẫn" of the Writer ribbon (Tham khảo ▸ Trích dẫn): the arrow adds or imports a source in the
+           source manager, or inserts the last citation again. -->
+      <node oor:name="HstWriterCitationInsertSplitButton" oor:op="replace">
+        <prop oor:name="Command">
+          <value>org.hst.office.vi:CitationInsert</value>
+        </prop>
+        <prop oor:name="Module">
+          <value>com.sun.star.text.TextDocument</value>
+        </prop>
+        <prop oor:name="Controller">
+          <value>com.sun.star.comp.framework.GenericPopupToolbarController</value>
+        </prop>
+        <prop oor:name="Value">
+          <value>private:resource/popupmenu/hstcitationinsert</value>
+        </prop>
+      </node>
     </node>
     <node oor:name="StatusBar">
       <node oor:name="c5" oor:op="replace">
