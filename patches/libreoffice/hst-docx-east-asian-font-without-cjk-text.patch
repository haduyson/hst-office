         FSNS( XML_w, XML_hAnsi ), sFontName );
+
+    // HST Office: without Han, Kana or Hangul text the East Asian font is the Latin one (see
+    // DocxExport::HasEastAsianText()); CharFontCJK() writes nothing then.
+    if (!GetExport().HasEastAsianText() && !m_pFontsAttrList->hasAttribute(FSNS(XML_w, XML_eastAsia)))
+        AddToAttrList(m_pFontsAttrList, FSNS(XML_w, XML_eastAsia), sFontName);
