--- a/sw/source/filter/ww8/docxexport.cxx
+++ b/sw/source/filter/ww8/docxexport.cxx
@@ -2430,6 +2430,48 @@
 
 //Keep this function in-sync with the one in writerfilter/.../SettingsTable.cxx
 //Since this is not import code, "-1" needs to be handled as the mode that LO will save as.
+namespace
+{
+bool lcl_IsEastAsianCodePoint(sal_uInt32 c)
+{
+    return (c >= 0x1100 && c <= 0x11FF) // Hangul Jamo
+           || (c >= 0x2E80 && c <= 0x2FDF) // CJK and Kangxi radicals
+           || (c >= 0x3040 && c <= 0x31FF) // Kana, Bopomofo, Hangul compatibility Jamo, strokes
+           || (c >= 0x3400 && c <= 0x4DBF) // CJK extension A
+           || (c >= 0x4E00 && c <= 0x9FFF) // CJK unified ideographs
+           || (c >= 0xA960 && c <= 0xA97F) // Hangul Jamo extended A
+           || (c >= 0xAC00 && c <= 0xD7FF) // Hangul syllables, Jamo extended B
+           || (c >= 0xF900 && c <= 0xFAFF) // CJK compatibility ideographs
+           || (c >= 0xFF65 && c <= 0xFFDC) // half-width Kana and Hangul
+           || (c >= 0x20000 && c <= 0x3134F); // CJK extensions B-G
+}
+}
+
+bool DocxExport::HasEastAsianText()
+{
+    if (!m_oHasEastAsianText)
+    {
+        m_oHasEastAsianText = false;
+        const SwNodes& rNodes = m_rDoc.GetNodes();
+        for (SwNodeOffset n(0); n < rNodes.Count() && !*m_oHasEastAsianText; ++n)
+        {
+            const SwTextNode* pTextNode = rNodes[n]->GetTextNode();
+            if (!pTextNode)
+                continue;
+            const OUString& rText = pTextNode->GetText();
+            for (sal_Int32 i = 0; i < rText.getLength();)
+            {
+                if (lcl_IsEastAsianCodePoint(rText.iterateCodePoints(&i)))
+                {
+                    m_oHasEastAsianText = true;
+                    break;
+                }
+            }
+        }
+    }
+    return *m_oHasEastAsianText;
+}
