 //Keep this function in-sync with the one in writerfilter/.../SettingsTable.cxx
 //Since this is not import code, "-1" needs to be handled as the mode that LO will save as.
+namespace
+{
+bool lcl_IsEastAsianCodePoint(sal_uInt32 c)
+{
+    return (c >= 0x1100 && c <= 0x11FF) // Hangul Jamo
+           || (c >= 0x2E80 && c <= 0x2FDF) // CJK and Kangxi radicals
+           || (c >= 0x3040 && c <= 0x31FF) // Kana, Bopomofo, Hangul compatibility Jamo, strokes
+           || (c >= 0x3400 && c <= 0x4DBF) // CJK extension A
+           || (c >= 0x4E00 && c <= 0x9FFF) // CJK unified ideographs
+           || (c >= 0xA960 && c <= 0xA97F) // Hangul Jamo extended A
+           || (c >= 0xAC00 && c <= 0xD7FF) // Hangul syllables, Jamo extended B
+           || (c >= 0xF900 && c <= 0xFAFF) // CJK compatibility ideographs
+           || (c >= 0xFF65 && c <= 0xFFDC) // half-width Kana and Hangul
+           || (c >= 0x20000 && c <= 0x3134F); // CJK extensions B-G
+}
+
+
+bool lcl_HasEastAsianText(const OUString& rText)
+{
+    for (sal_Int32 i = 0; i < rText.getLength();)
+    {
+        if (lcl_IsEastAsianCodePoint(rText.iterateCodePoints(&i)))
+            return true;
+    }
+    return false;
+}
+
+bool lcl_HasEastAsianText(const OutlinerParaObject* pText)
+{
+    if (!pText)
+        return false;
+    const EditTextObject& rText = pText->GetTextObject();
+    for (sal_Int32 i = 0; i < rText.GetParagraphCount(); ++i)
+    {
+        if (lcl_HasEastAsianText(rText.GetText(i)))
+            return true;
+    }
+    return false;
+}
+
+/// Text of drawing shapes and text boxes that are not Writer frames, also inside groups.
+bool lcl_HasEastAsianText(const SdrObjList* pList)
+{
+    if (!pList)
+        return false;
+    for (const rtl::Reference<SdrObject>& pObject : *pList)
+    {
+        if (lcl_HasEastAsianText(pObject->getChildrenOfSdrObject()))
+            return true;
+        if (const SdrTextObj* pTextObject = DynCastSdrTextObj(pObject.get()))
+        {
+            if (lcl_HasEastAsianText(pTextObject->GetOutlinerParaObject()))
+                return true;
+        }
+    }
+    return false;
+}
+}
+
+bool DocxExport::HasEastAsianText()
+{
+    if (!m_oHasEastAsianText)
+        m_oHasEastAsianText = ScanEastAsianText();
+    return *m_oHasEastAsianText;
+}
+
+bool DocxExport::ScanEastAsianText() const
+{
+    // Text nodes: body, headers and footers, footnotes and endnotes, frames.
+    const SwNodes& rNodes = m_rDoc.GetNodes();
+    for (SwNodeOffset n(0); n < rNodes.Count(); ++n)
+    {
+        const SwTextNode* pTextNode = rNodes[n]->GetTextNode();
+        if (pTextNode && lcl_HasEastAsianText(pTextNode->GetText()))
+            return true;
+    }
+    // Comments.
+    std::vector<SwFormatField*> aComments;
+    m_rDoc.getIDocumentFieldsAccess().GetSysFieldType(SwFieldIds::Postit)->GatherFields(aComments);
+    for (const SwFormatField* pFormatField : aComments)
+    {
+        const auto* pComment = static_cast<const SwPostItField*>(pFormatField->GetField());
+        if (lcl_HasEastAsianText(pComment->GetText()) || lcl_HasEastAsianText(pComment->GetTextObject()))
+            return true;
+    }
+    // Drawing shapes and their text.
+    if (const SwDrawModel* pModel = m_rDoc.getIDocumentDrawModelAccess().GetDrawModel())
+    {
+        for (sal_uInt16 i = 0; i < pModel->GetPageCount(); ++i)
+        {
+            if (lcl_HasEastAsianText(pModel->GetPage(i)))
+                return true;
+        }
+    }
+    return false;
+}
