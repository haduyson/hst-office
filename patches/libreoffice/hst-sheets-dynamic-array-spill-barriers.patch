--- /dev/null
+++ b/sc/source/core/hst/hstspillbarrier.cxx
@@ -0,0 +1,36 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ * Copyright (c) HASON TECH. HST Office.
+ */
+
+#include <hstspillbarrier.hxx>
+
+#include <attrib.hxx>
+#include <dbdata.hxx>
+#include <document.hxx>
+
+namespace sc::hst
+{
+bool IsSpillBarred(const ScDocument& rDoc, const ScRange& rRange)
+{
+    if (rDoc.HasAttrib(rRange, HasAttrFlags::Merged | HasAttrFlags::Overlapped))
+        return true;
+
+    const ScDBCollection* pDBs = rDoc.GetDBCollection();
+    if (!pDBs)
+        return false;
+    for (const auto& rxData : pDBs->getNamedDBs())
+    {
+        if (!rxData->GetTableStyleInfo())
+            continue;
+        ScRange aArea;
+        rxData->GetArea(aArea);
+        if (aArea.Intersects(rRange))
+            return true;
+    }
+    return false;
+}
+}
