+++ b/sc/source/core/inc/hstspillbarrier.hxx
@@ -0,0 +1,21 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ * Copyright (c) HASON TECH. HST Office.
+ */
+
+#pragma once
+
+class ScDocument;
+class ScRange;
+
+namespace sc::hst
+{
+/** Whether a dynamic array may not spill into rRange although its cells are empty, as in the
+    leading spreadsheet application: the range holds merged cells, or it overlaps a Sheets table
+    (a database range with a table style: an .xlsx table or one made with Insert > Table; the
+    same criterion as the tables' calculated columns). The anchor then shows #SPILL!. */
+bool IsSpillBarred(const ScDocument& rDoc, const ScRange& rRange);
+}
