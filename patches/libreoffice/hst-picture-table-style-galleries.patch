+
+// HST Office: the toolbox controller of the ribbon's picture and table style galleries. Its commands,
+// .uno:HstPictureStyles and .uno:HstTableStyles, only name the gallery (label, keytip, accessibility);
+// nothing dispatches them, so their state is ignored and the gallery follows the document's
+// read-only state through the vnd.hst.styles: handler instead.
+
+#include "HstStyleGalleryWindow.hxx"
+
+#include <com/sun/star/frame/XDispatchProvider.hpp>
+#include <com/sun/star/lang/XServiceInfo.hpp>
+#include <com/sun/star/util/URL.hpp>
+#include <comphelper/diagnose_ex.hxx>
+#include <comphelper/lok.hxx>
+#include <comphelper/unique_unlock.hxx>
+#include <cppuhelper/implbase.hxx>
+#include <cppuhelper/supportsservice.hxx>
+#include <svtools/toolboxcontroller.hxx>
+#include <toolkit/helper/vclunohelper.hxx>
+#include <vcl/svapp.hxx>
+
+using namespace css;
+
+namespace
+{
+using svx::hststyles::GalleryKind;
+using svx::hststyles::StyleGalleryWindow;
+
+using HstStyleGalleryControl_Base
+    = cppu::ImplInheritanceHelper<svt::ToolboxController, lang::XServiceInfo>;
+
+class HstStyleGalleryControl final : public HstStyleGalleryControl_Base
+{
+public:
+    // XUpdatable
+    void SAL_CALL update() override {}
+
+    // XStatusListener: the gallery's own command is never dispatchable (see above)
+    void SAL_CALL statusChanged(const frame::FeatureStateEvent&) override
+    {
+        SolarMutexGuard aGuard;
+        if (!m_xWindow || m_xWindow->isDisposed())
+            return;
+        m_xWindow->Enable(Editable());
+    }
+
+    // XToolbarController
+    uno::Reference<awt::XWindow> SAL_CALL createItemWindow(const uno::Reference<awt::XWindow>& rParent) override
+    {
+        if (comphelper::LibreOfficeKit::isActive())
+            return {};
+        SolarMutexGuard aGuard;
+        try
+        {
+            VclPtr<vcl::Window> pParent = VCLUnoHelper::GetWindow(rParent);
+            if (!pParent)
+                return {};
+            const GalleryKind eKind = m_aCommandURL == ".uno:HstTableStyles" ? GalleryKind::Table
+                                                                             : GalleryKind::Picture;
+            m_xWindow = VclPtr<StyleGalleryWindow>::Create(pParent, m_xFrame, eKind);
+            m_xWindow->Enable(Editable());
+            return VCLUnoHelper::GetInterface(m_xWindow);
+        }
+        catch (const uno::Exception&)
+        {
+            TOOLS_WARN_EXCEPTION("svx", "Creating a ribbon style gallery");
+            return {};
+        }
+    }
+
+    // XServiceInfo
+    OUString SAL_CALL getImplementationName() override
+    {
+        return u"com.sun.star.comp.svx.HstStyleGalleryControl"_ustr;
+    }
+    sal_Bool SAL_CALL supportsService(const OUString& rServiceName) override
+    {
+        return cppu::supportsService(this, rServiceName);
+    }
+    uno::Sequence<OUString> SAL_CALL getSupportedServiceNames() override
+    {
+        return { u"com.sun.star.frame.ToolbarController"_ustr };
+    }
+
+    // WeakComponentImplHelperBase
+    using HstStyleGalleryControl_Base::disposing;
+    void disposing(std::unique_lock<std::mutex>& rGuard) override
+    {
+        svt::ToolboxController::disposing(rGuard);
+        comphelper::unique_unlock aUnlock(rGuard);
+        SolarMutexGuard aSolarGuard;
+        m_xWindow.disposeAndClear();
+    }
+
+private:
+    /// Whether the handler would apply a style now (false in read-only documents).
+    bool Editable() const
+    {
+        uno::Reference<frame::XDispatchProvider> xProvider(m_xFrame, uno::UNO_QUERY);
+        if (!xProvider.is())
+            return false;
+        util::URL aURL;
+        aURL.Complete = m_aCommandURL == ".uno:HstTableStyles" ? u"vnd.hst.styles:Table"_ustr
+                                                               : u"vnd.hst.styles:Picture"_ustr;
+        aURL.Protocol = u"vnd.hst.styles:"_ustr;
+        aURL.Path = aURL.Complete.copy(aURL.Protocol.getLength());
+        try
+        {
+            struct Listener final : public cppu::WeakImplHelper<frame::XStatusListener>
+            {
+                bool bEnabled = false;
+                void SAL_CALL statusChanged(const frame::FeatureStateEvent& rEvent) override
+                {
+                    bEnabled = rEvent.IsEnabled;
+                }
+                void SAL_CALL disposing(const lang::EventObject&) override {}
+            };
+            uno::Reference<frame::XDispatch> xDispatch = xProvider->queryDispatch(aURL, OUString(), 0);
+            if (!xDispatch.is())
+                return false;
+            rtl::Reference<Listener> xListener(new Listener);
+            xDispatch->addStatusListener(xListener, aURL);
+            xDispatch->removeStatusListener(xListener, aURL);
+            return xListener->bEnabled;
+        }
+        catch (const uno::Exception&)
+        {
+            return false;
+        }
+    }
+
+    VclPtr<StyleGalleryWindow> m_xWindow;
+};
+}
+
+extern "C" SAL_DLLPUBLIC_EXPORT uno::XInterface*
+com_sun_star_comp_svx_HstStyleGalleryControl_get_implementation(uno::XComponentContext*,
+                                                                uno::Sequence<uno::Any> const&)
+{
+    return cppu::acquire(new HstStyleGalleryControl);
+}
