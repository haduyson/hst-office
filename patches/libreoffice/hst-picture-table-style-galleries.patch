+#pragma once
+
+// HST Office: the picture and table styles of the ribbon galleries ("Định dạng ảnh", "Thiết kế bảng").
+// One table of styles serves Writer, Sheets and Slides; each application maps a style onto its native
+// properties (frame borders and shadow, shape line and shadow, table styles), so documents keep the look
+// when saved as .docx/.xlsx/.pptx.
+
+#include <svx/svxdllapi.h>
+#include <tools/color.hxx>
+#include <unotools/resmgr.hxx>
+
+#include <span>
+#include <string_view>
+
+namespace svx::hststyles
+{
+/// A picture style. Lengths in 1/100 mm; a zero line width removes the line, a zero shadow distance the shadow.
+struct PictureStyle
+{
+    std::u16string_view aId;
+    TranslateId aName;
+    Color aLineColor;
+    sal_Int32 nLineWidth;
+    sal_Int32 nShadowDistance; // towards the bottom right
+    sal_Int32 nShadowBlur; // Sheets and Slides; Writer frames have a hard shadow
+    sal_Int16 nShadowTransparence; // percent
+};
+
+/// A table style. aId is also the name of the style in the document (stable across UI languages).
+struct TableStyle
+{
+    std::u16string_view aId;
+    TranslateId aName;
+    Color aHeaderFill; // COL_TRANSPARENT: no header fill (the header has a strong bottom line instead)
+    Color aHeaderText;
+    Color aBandFill; // COL_TRANSPARENT: no banded rows
+    Color aLineColor;
+    bool bVerticalLines;
+};
+
+/// Shadow colour of every picture style.
+constexpr Color PICTURE_SHADOW_COLOR(0x00, 0x00, 0x00);
+/// Thin table line and the header's bottom line, 1/100 mm (0.75 pt, 1.5 pt).
+constexpr sal_Int32 TABLE_THIN_LINE = 26;
+constexpr sal_Int32 TABLE_HEADER_LINE = 53;
+
+SVXCORE_DLLPUBLIC std::span<const PictureStyle> PictureStyles();
+SVXCORE_DLLPUBLIC std::span<const TableStyle> TableStyles();
+SVXCORE_DLLPUBLIC const PictureStyle* FindPictureStyle(std::u16string_view rId);
+SVXCORE_DLLPUBLIC const TableStyle* FindTableStyle(std::u16string_view rId);
+/// The translated name of a style, for tooltips, accessible names and the applications' style lists.
+SVXCORE_DLLPUBLIC OUString StyleUIName(const TranslateId& rName);
+/// The colour of the header's bottom line: the header fill, or the line colour of an unfilled header.
+SVXCORE_DLLPUBLIC Color HeaderLineColor(const TableStyle& rStyle);
+}
