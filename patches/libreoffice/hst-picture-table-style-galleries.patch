+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+#include "HstStyleGalleryPreview.hxx"
+
+#include <tools/gen.hxx>
+#include <tools/poly.hxx>
+#include <vcl/settings.hxx>
+#include <vcl/svapp.hxx>
+#include <vcl/virdev.hxx>
+
+#include <algorithm>
+#include <cmath>
+
+namespace svx::hststyles
+{
+namespace
+{
+tools::Long Px(double fValue, float fScale) { return std::lround(fValue * fScale); }
+
+/// Line widths in the tile: 1/100 mm mapped onto 1, 2 or 4 pixels so the styles stay distinguishable.
+tools::Long LinePx(sal_Int32 nWidth, float fScale)
+{
+    if (nWidth <= 0)
+        return 0;
+    return Px(nWidth < 50 ? 1 : nWidth < 150 ? 2 : 4, fScale);
+}
+
+ScopedVclPtr<VirtualDevice> MakeDevice(float fScale, Color& rField)
+{
+    ScopedVclPtr<VirtualDevice> xDevice(VclPtr<VirtualDevice>::Create());
+    xDevice->SetOutputSizePixel(Size(Px(TILE_WIDTH, fScale), Px(TILE_HEIGHT, fScale)));
+    rField = Application::GetSettings().GetStyleSettings().GetFieldColor();
+    xDevice->SetBackground(Wallpaper(rField));
+    xDevice->Erase();
+    return xDevice;
+}
+
+Bitmap Finish(const VirtualDevice& rDevice)
+{
+    return rDevice.GetBitmap(Point(0, 0), rDevice.GetOutputSizePixel());
+}
+
+void FillRect(VirtualDevice& rDevice, const tools::Rectangle& rRect, Color aColor)
+{
+    rDevice.SetLineColor();
+    rDevice.SetFillColor(aColor);
+    rDevice.DrawRect(rRect);
+}
+}
+
+Bitmap RenderPicturePreview(const PictureStyle& rStyle, float fScale)
+{
+    Color aField;
+    ScopedVclPtr<VirtualDevice> xDevice = MakeDevice(fScale, aField);
+    const tools::Long nLine = LinePx(rStyle.nLineWidth, fScale);
+    const tools::Long nInset = Px(7, fScale);
+    tools::Rectangle aPhoto(Point(nInset, Px(6, fScale)),
+                            Size(Px(TILE_WIDTH, fScale) - 2 * nInset - Px(3, fScale),
+                                 Px(TILE_HEIGHT, fScale) - Px(15, fScale)));
+    tools::Rectangle aOuter(aPhoto);
+    aOuter.expand(nLine);
+
+    if (rStyle.nShadowDistance > 0)
+    {
+        // a soft shadow fades over a few rings, a hard one is a single offset rectangle
+        const tools::Long nOffset = Px(rStyle.nShadowDistance > 120 ? 3 : 2, fScale);
+        const int nRings = rStyle.nShadowBlur > 0 ? 3 : 1;
+        const double fStrength = (100 - rStyle.nShadowTransparence) / 100.0;
+        for (int i = nRings; i >= 1; --i)
+        {
+            tools::Rectangle aShadow(aOuter);
+            aShadow.Move(nOffset, nOffset);
+            aShadow.expand(Px(i - 1, fScale));
+            Color aShade(aField);
+            aShade.Merge(PICTURE_SHADOW_COLOR,
+                         sal_uInt8(255 - 255 * fStrength / (nRings == 1 ? 1.4 : 1.2 + i)));
+            FillRect(*xDevice, aShadow, aShade);
+        }
+    }
+    if (nLine > 0)
+        FillRect(*xDevice, aOuter, rStyle.aLineColor);
+
+    // the picture: sky, sun and two hills
+    FillRect(*xDevice, aPhoto, Color(0xCF, 0xE5, 0xF5));
+    xDevice->SetFillColor(Color(0xF6, 0xC3, 0x44));
+    xDevice->DrawEllipse(tools::Rectangle(
+        Point(aPhoto.Right() - Px(13, fScale), aPhoto.Top() + Px(4, fScale)), Size(Px(7, fScale), Px(7, fScale))));
+    const Point aBL = aPhoto.BottomLeft(), aBR = aPhoto.BottomRight();
+    const tools::Long nW = aPhoto.GetWidth(), nH = aPhoto.GetHeight();
+    xDevice->SetFillColor(Color(0x7C, 0xBF, 0x86));
+    const Point aFar[] = { aBL, Point(aBL.X(), aBL.Y() - nH / 3), Point(aBL.X() + nW * 2 / 5, aBL.Y() - nH * 3 / 5),
+                           Point(aBL.X() + nW * 3 / 4, aBL.Y() - nH / 4), aBR };
+    xDevice->DrawPolygon(tools::Polygon(std::size(aFar), aFar));
+    xDevice->SetFillColor(Color(0x3E, 0x8E, 0x55));
+    const Point aNear[] = { Point(aBL.X() + nW / 3, aBL.Y()), Point(aBL.X() + nW * 2 / 3, aBL.Y() - nH * 2 / 5),
+                            Point(aBR.X(), aBL.Y() - nH / 5), aBR };
+    xDevice->DrawPolygon(tools::Polygon(std::size(aNear), aNear));
+    return Finish(*xDevice);
+}
+
+Bitmap RenderTablePreview(const TableStyle& rStyle, float fScale)
+{
+    Color aField;
+    ScopedVclPtr<VirtualDevice> xDevice = MakeDevice(fScale, aField);
+    constexpr int ROWS = 5, COLS = 4;
+    const tools::Long nCellW = Px(12, fScale), nCellH = Px(6, fScale);
+    const Point aOrigin(Px(6, fScale), Px(5, fScale));
+    const tools::Rectangle aTable(aOrigin, Size(nCellW * COLS, nCellH * ROWS));
+
+    FillRect(*xDevice, aTable, COL_WHITE); // the page or the slide cell under the table
+    for (int nRow = 0; nRow < ROWS; ++nRow)
+    {
+        const tools::Rectangle aRowRect(Point(aOrigin.X(), aOrigin.Y() + nRow * nCellH),
+                                        Size(nCellW * COLS, nCellH));
+        if (nRow == 0 && rStyle.aHeaderFill != COL_TRANSPARENT)
+            FillRect(*xDevice, aRowRect, rStyle.aHeaderFill);
+        else if (nRow % 2 == 1 && rStyle.aBandFill != COL_TRANSPARENT)
+            FillRect(*xDevice, aRowRect, rStyle.aBandFill);
+        // a text stroke in each cell: header text colour, body text dark grey
+        for (int nCol = 0; nCol < COLS; ++nCol)
+        {
+            const tools::Long nX = aRowRect.Left() + nCol * nCellW + Px(2, fScale);
+            FillRect(*xDevice,
+                     tools::Rectangle(Point(nX, aRowRect.Top() + nCellH / 2 - Px(1, fScale) / 2),
+                                      Size(nCellW - Px(5, fScale), std::max<tools::Long>(1, Px(1.2, fScale)))),
+                     nRow == 0 ? rStyle.aHeaderText : Color(0x8A, 0x93, 0x9D));
+        }
+    }
+    xDevice->SetFillColor();
+    xDevice->SetLineColor(rStyle.aLineColor);
+    for (int nRow = 0; nRow <= ROWS; ++nRow)
+    {
+        const tools::Long nY = aOrigin.Y() + nRow * nCellH;
+        xDevice->DrawLine(Point(aTable.Left(), nY), Point(aTable.Right(), nY));
+    }
+    if (rStyle.bVerticalLines)
+        for (int nCol = 0; nCol <= COLS; ++nCol)
+        {
+            const tools::Long nX = aOrigin.X() + nCol * nCellW;
+            xDevice->DrawLine(Point(nX, aTable.Top()), Point(nX, aTable.Bottom()));
+        }
+    // the header's strong bottom line
+    FillRect(*xDevice,
+             tools::Rectangle(Point(aTable.Left(), aOrigin.Y() + nCellH - Px(1, fScale) / 2),
+                              Size(aTable.GetWidth(), std::max<tools::Long>(1, Px(1.5, fScale)))),
+             HeaderLineColor(rStyle));
+    return Finish(*xDevice);
+}
+}
