+
+// HST Office: the cell formats of an HST table style, shared by the Writer table styles and the Slides
+// table designs (HstTableStyleApply.cxx).
+
+#include "HstStyleApply.hxx"
+
+#include <com/sun/star/awt/FontWeight.hpp>
+#include <com/sun/star/drawing/FillStyle.hpp>
+#include <com/sun/star/frame/XModel.hpp>
+#include <com/sun/star/style/XStyleFamiliesSupplier.hpp>
+#include <com/sun/star/table/BorderLine.hpp>
+
+using namespace css;
+
+namespace svx::hststyles::detail
+{
+namespace
+{
+constexpr Color BODY_TEXT(0x1F, 0x29, 0x33);
+
+table::BorderLine Line(Color aColor, sal_Int32 nWidth)
+{
+    table::BorderLine aLine;
+    aLine.Color = sal_Int32(aColor);
+    aLine.OuterLineWidth = static_cast<sal_Int16>(nWidth);
+    return aLine;
+}
+}
+
+/// The cell properties of one part. Every part carries all four borders (a part's border item replaces
+/// the body's as a whole). bComplete: every part also has a fill and a text colour (Slides uses exactly
+/// one cell style per cell); otherwise the band and header fills add to the body (Writer).
+void SetCellProps(const uno::Reference<beans::XPropertySet>& rxCell, const TableStyle& rStyle, Part ePart,
+                  bool bComplete)
+{
+    const bool bHeader = ePart == Part::Header;
+    {
+        const table::BorderLine aThin = Line(rStyle.aLineColor, TABLE_THIN_LINE);
+        const table::BorderLine aSide = rStyle.bVerticalLines ? aThin : table::BorderLine();
+        rxCell->setPropertyValue(u"TopBorder"_ustr, uno::Any(aThin));
+        rxCell->setPropertyValue(u"BottomBorder"_ustr, uno::Any(aThin));
+        rxCell->setPropertyValue(u"LeftBorder"_ustr, uno::Any(aSide));
+        rxCell->setPropertyValue(u"RightBorder"_ustr, uno::Any(aSide));
+    }
+    if (bHeader)
+        rxCell->setPropertyValue(u"BottomBorder"_ustr,
+                                 uno::Any(Line(HeaderLineColor(rStyle), TABLE_HEADER_LINE)));
+
+    Color aFill = COL_TRANSPARENT;
+    if (bHeader)
+        aFill = rStyle.aHeaderFill;
+    else if (ePart == Part::Band)
+        aFill = rStyle.aBandFill;
+    if (bComplete && aFill == COL_TRANSPARENT)
+        aFill = COL_WHITE; // slide tables need an opaque cell on any slide background
+    if (aFill != COL_TRANSPARENT)
+    {
+        if (bComplete)
+        {
+            rxCell->setPropertyValue(u"FillStyle"_ustr, uno::Any(drawing::FillStyle_SOLID));
+            rxCell->setPropertyValue(u"FillColor"_ustr, uno::Any(sal_Int32(aFill)));
+        }
+        else
+            rxCell->setPropertyValue(u"BackColor"_ustr, uno::Any(sal_Int32(aFill)));
+    }
+    if (bHeader || bComplete)
+        rxCell->setPropertyValue(u"CharColor"_ustr,
+                                 uno::Any(sal_Int32(bHeader ? rStyle.aHeaderText : BODY_TEXT)));
+    if (bHeader)
+        rxCell->setPropertyValue(u"CharWeight"_ustr, uno::Any(awt::FontWeight::BOLD));
+}
+
+uno::Reference<container::XNameContainer> Family(const uno::Reference<frame::XModel>& rxModel,
+                                                 const OUString& rName)
+{
+    uno::Reference<style::XStyleFamiliesSupplier> xSupplier(rxModel, uno::UNO_QUERY);
+    if (!xSupplier.is() || !xSupplier->getStyleFamilies()->hasByName(rName))
+        return {};
+    return { xSupplier->getStyleFamilies()->getByName(rName), uno::UNO_QUERY };
+}
+
+}
