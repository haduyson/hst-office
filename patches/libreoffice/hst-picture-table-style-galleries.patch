+#include <vcl/weld/Button.hxx>
+#include <vcl/weld/IconView.hxx>
+#include <vcl/weld/ScrolledWindow.hxx>
+
+#include <algorithm>
+
+using namespace css;
+
+namespace svx::hststyles
+{
+namespace
+{
+constexpr int COLUMNS[] = { 6, 4, 3 }; // tiles in a row at the ribbon's large, medium and small states
+constexpr int ITEM_STEP = TILE_WIDTH + 10; // a tile with the icon view's padding
+constexpr int FRAME_WIDTH = 8;
+constexpr int VIEW_HEIGHT = TILE_HEIGHT + 12; // one row, never taller (Windows asks for every row)
+
+bool IsModel(const uno::Reference<frame::XFrame>& rxFrame, const OUString& rService)
+{
+    if (!rxFrame.is() || !rxFrame->getController().is())
+        return false;
+    uno::Reference<lang::XServiceInfo> xInfo(rxFrame->getController()->getModel(), uno::UNO_QUERY);
+    return xInfo.is() && xInfo->supportsService(rService);
+}
+}
+
+StyleGalleryWindow::StyleGalleryWindow(vcl::Window* pParent, uno::Reference<frame::XFrame> xFrame,
+                                       GalleryKind eKind)
+    : InterimItemWindow(pParent, u"svx/ui/hststylegallery.ui"_ustr, u"StyleGalleryBox"_ustr, true)
+    , m_xFrame(std::move(xFrame))
+    , m_eKind(eKind)
+    , m_xScroll(m_xBuilder->weld_scrolled_window(u"stylesscroll"_ustr))
+    , m_xView(m_xBuilder->weld_icon_view(u"styles"_ustr))
+    , m_xPrev(m_xBuilder->weld_button(u"prev"_ustr))
+    , m_xNext(m_xBuilder->weld_button(u"next"_ustr))
+    , m_xMore(m_xBuilder->weld_button(u"more"_ustr))
+{
+    InitControlBase(m_xView.get());
+    const float fScale = GetDPIScaleFactor();
+    const bool bPicture = eKind == GalleryKind::Picture;
+    if (bPicture)
+        for (const PictureStyle& rStyle : PictureStyles())
+            m_aEntries.push_back({ OUString(rStyle.aId), StyleUIName(rStyle.aName),
+                                   RenderPicturePreview(rStyle, fScale) });
+    else
+        for (const TableStyle& rStyle : TableStyles())
+            m_aEntries.push_back({ OUString(rStyle.aId), StyleUIName(rStyle.aName),
+                                   RenderTablePreview(rStyle, fScale) });
+
+    m_xView->set_accessible_name(SvxResId(bPicture ? RID_HST_STYLEGALLERY_PICTURES : RID_HST_STYLEGALLERY_TABLES));
+    const OUString aMore = SvxResId(bPicture ? RID_HST_STYLEGALLERY_MORE_PICTURES : RID_HST_STYLEGALLERY_MORE_TABLES);
+    m_xMore->set_tooltip_text(aMore);
+    m_xMore->set_accessible_name(aMore);
+    m_xView->set_item_width(TILE_WIDTH * fScale);
+    // a click applies (as in the Styles gallery); Enter or a double click applies the focused tile
+    m_xView->connect_selection_changed(LINK(this, StyleGalleryWindow, SelectedHdl));
+    m_xView->connect_item_activated(LINK(this, StyleGalleryWindow, ActivatedHdl));
+    m_xPrev->connect_clicked(LINK(this, StyleGalleryWindow, PageHdl));
+    m_xNext->connect_clicked(LINK(this, StyleGalleryWindow, PageHdl));
+    m_xMore->connect_clicked(LINK(this, StyleGalleryWindow, MoreHdl));
+    ApplyColumns();
+}
+
+StyleGalleryWindow::~StyleGalleryWindow() { disposeOnce(); }
+
+void StyleGalleryWindow::dispose()
+{
+    m_xView.reset();
+    m_xScroll.reset();
+    m_xPrev.reset();
+    m_xNext.reset();
+    m_xMore.reset();
+    InterimItemWindow::dispose();
+}
+
+bool StyleGalleryWindow::set_property(const OUString& rKey, const OUString& rValue)
+{
+    if (rKey != "hst-gallery-state")
+        return InterimItemWindow::set_property(rKey, rValue);
+    const int nState = std::clamp<int>(rValue.toInt32(), 0, std::size(COLUMNS) - 1);
+    if (nState == m_nState)
+        return false; // nothing changed: the ladder need not lay the toolbox out again
+    m_nState = nState;
+    ApplyColumns();
+    return true;
+}
+
+void StyleGalleryWindow::ApplyColumns()
+{
+    const float fScale = GetDPIScaleFactor();
+    m_xScroll->set_size_request((COLUMNS[m_nState] * ITEM_STEP + FRAME_WIDTH) * fScale, VIEW_HEIGHT * fScale);
+    ShowPage();
+    Size aSize = get_preferred_size();
+    aSize.setHeight(std::min<tools::Long>(aSize.Height(), (VIEW_HEIGHT + 6) * fScale));
+    SetSizePixel(aSize);
+}
+
+void StyleGalleryWindow::ShowPage()
+{
+    if (!m_xView)
+        return;
+    const size_t nPage = COLUMNS[m_nState];
+    if (m_nFirst >= m_aEntries.size())
+        m_nFirst = 0;
+    m_nFirst -= m_nFirst % nPage; // pages start at multiples of the page size
+    const size_t nEnd = std::min(m_aEntries.size(), m_nFirst + nPage);
+    m_bFilling = true; // our own changes are not a choice of the user
+    m_xView->freeze();
+    m_xView->clear();
+    for (size_t i = m_nFirst; i < nEnd; ++i)
+    {
+        const Entry& rEntry = m_aEntries[i];
+        const int nPos = static_cast<int>(i - m_nFirst);
+        m_xView->insert(nPos, nullptr, &rEntry.aId, &rEntry.aTile, nullptr);
+        m_xView->set_item_tooltip_text(nPos, rEntry.aName);
+        m_xView->set_item_accessible_name(nPos, rEntry.aName);
+    }
+    m_xView->thaw();
+    m_xView->unselect_all();
+    m_bFilling = false;
+    m_xPrev->set_sensitive(m_nFirst > 0);
+    m_xNext->set_sensitive(nEnd < m_aEntries.size());
+}
+
+void StyleGalleryWindow::Apply(const OUString& rId)
+{
+    if (rId.isEmpty() || !m_xFrame.is())
+        return;
+    try
+    {
+        comphelper::dispatchCommand(m_eKind == GalleryKind::Picture ? u"vnd.hst.styles:Picture"_ustr
+                                                                    : u"vnd.hst.styles:Table"_ustr,
+                                    m_xFrame, { comphelper::makePropertyValue(u"Style"_ustr, rId) });
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("svx", "Applying a ribbon gallery style");
+    }
+}
+
+IMPL_LINK_NOARG(StyleGalleryWindow, SelectedHdl, weld::ItemView&, void)
+{
+    if (m_bFilling)
+        return;
+    Apply(m_xView->get_selected_id());
+    // no tile stays chosen: a style is not a state of the picture, and a second click applies again
+    m_bFilling = true;
+    m_xView->unselect_all();
+    m_bFilling = false;
+}
+
+IMPL_LINK(StyleGalleryWindow, ActivatedHdl, const weld::TreeIter&, rIter, bool)
+{
+    Apply(m_xView->get_id(rIter));
+    return true;
+}
+
+IMPL_LINK(StyleGalleryWindow, PageHdl, weld::Button&, rButton, void)
+{
+    const size_t nPage = COLUMNS[m_nState];
+    if (&rButton == m_xNext.get())
+    {
+        if (m_nFirst + nPage < m_aEntries.size())
+            m_nFirst += nPage;
+    }
+    else
+        m_nFirst = m_nFirst > nPage ? m_nFirst - nPage : 0;
+    ShowPage();
+}
+
+IMPL_LINK_NOARG(StyleGalleryWindow, MoreHdl, weld::Button&, void)
+{
+    const bool bWriter = IsModel(m_xFrame, u"com.sun.star.text.TextDocument"_ustr);
+    OUString aCommand;
+    if (m_eKind == GalleryKind::Picture)
+        aCommand = bWriter ? u".uno:GraphicDialog"_ustr : u".uno:FormatLine"_ustr;
+    else if (bWriter)
+        aCommand = u".uno:AutoFormat"_ustr;
+    else if (IsModel(m_xFrame, u"com.sun.star.sheet.SpreadsheetDocument"_ustr))
+        aCommand = u".uno:SidebarDeck.PropertyDeck"_ustr; // the table's style list and options
+    else
+        aCommand = u".uno:TableDesign"_ustr;
+    try
+    {
+        comphelper::dispatchCommand(aCommand, m_xFrame, {});
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("svx", "Opening the full style options");
+    }
+}
+}
