+// 1 pt = 35.28 hundredths of a millimetre
+constexpr sal_Int32 PT_075 = 26;
+constexpr sal_Int32 PT_225 = 79;
+constexpr sal_Int32 PT_3 = 106;
+constexpr sal_Int32 PT_4 = 141;
