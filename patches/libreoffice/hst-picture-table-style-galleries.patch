@@ -0,0 +1,182 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This file is part of the LibreOffice project.
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+// HST Office: the protocol handler behind the picture and table style galleries.
+//   vnd.hst.styles:Picture  Style=<id of a picture style>   the selected pictures
+//   vnd.hst.styles:Table    Style=<id of a table style>     the table at the cursor or the selected table
+// One handler for Writer, Sheets and Slides; the changes form one undo action. Unknown ids, read-only
+// documents and selections without a picture or table change nothing.
+
+#include "HstStyleApply.hxx"
+#include <hststylegallery.hrc>
+
+#include <com/sun/star/beans/PropertyValue.hpp>
+#include <com/sun/star/document/XUndoManagerSupplier.hpp>
+#include <com/sun/star/frame/XDispatch.hpp>
+#include <com/sun/star/frame/XDispatchProvider.hpp>
+#include <com/sun/star/frame/XFrame.hpp>
+#include <com/sun/star/frame/XModel.hpp>
+#include <com/sun/star/frame/XStorable.hpp>
+#include <com/sun/star/lang/XInitialization.hpp>
+#include <com/sun/star/lang/XServiceInfo.hpp>
+#include <comphelper/diagnose_ex.hxx>
+#include <cppuhelper/implbase.hxx>
+#include <cppuhelper/supportsservice.hxx>
+#include <svx/dialmgr.hxx>
+#include <vcl/svapp.hxx>
+
+using namespace css;
+
+namespace
+{
+constexpr std::u16string_view PROTOCOL = u"vnd.hst.styles:";
+
+enum class Target { None, Picture, Table };
+
+Target TargetOf(const util::URL& rURL)
+{
+    std::u16string_view aPath(rURL.Complete);
+    if (!aPath.starts_with(PROTOCOL))
+        return Target::None;
+    aPath.remove_prefix(PROTOCOL.size());
+    aPath = aPath.substr(0, aPath.find(u'?'));
+    if (aPath == u"Picture")
+        return Target::Picture;
+    if (aPath == u"Table")
+        return Target::Table;
+    return Target::None;
+}
+
+class HstStyleDispatcher final
+    : public cppu::WeakImplHelper<frame::XDispatchProvider, frame::XDispatch, lang::XInitialization,
+                                  lang::XServiceInfo>
+{
+public:
+    // XInitialization: the frame comes first, as for every protocol handler
+    void SAL_CALL initialize(const uno::Sequence<uno::Any>& rArguments) override
+    {
+        if (rArguments.hasElements())
+            rArguments[0] >>= m_xFrame;
+    }
+
+    // XDispatchProvider
+    uno::Reference<frame::XDispatch> SAL_CALL queryDispatch(const util::URL& rURL, const OUString&,
+                                                            sal_Int32) override
+    {
+        return TargetOf(rURL) == Target::None ? nullptr : this;
+    }
+    uno::Sequence<uno::Reference<frame::XDispatch>> SAL_CALL
+    queryDispatches(const uno::Sequence<frame::DispatchDescriptor>& rRequests) override
+    {
+        uno::Sequence<uno::Reference<frame::XDispatch>> aResult(rRequests.getLength());
+        auto pResult = aResult.getArray();
+        for (sal_Int32 i = 0; i < rRequests.getLength(); ++i)
+            pResult[i] = queryDispatch(rRequests[i].FeatureURL, rRequests[i].FrameName,
+                                       rRequests[i].SearchFlags);
+        return aResult;
+    }
+
+    // XDispatch
+    void SAL_CALL dispatch(const util::URL& rURL, const uno::Sequence<beans::PropertyValue>& rArgs) override;
+    void SAL_CALL addStatusListener(const uno::Reference<frame::XStatusListener>& rxListener,
+                                    const util::URL& rURL) override
+    {
+        if (!rxListener.is())
+            return;
+        frame::FeatureStateEvent aEvent;
+        aEvent.FeatureURL = rURL;
+        aEvent.IsEnabled = TargetOf(rURL) != Target::None && Editable().is();
+        aEvent.Source = getXWeak();
+        rxListener->statusChanged(aEvent);
+    }
+    void SAL_CALL removeStatusListener(const uno::Reference<frame::XStatusListener>&,
+                                       const util::URL&) override
+    {
+    }
+
+    // XServiceInfo
+    OUString SAL_CALL getImplementationName() override
+    {
+        return u"com.sun.star.comp.svx.HstStyleDispatcher"_ustr;
+    }
+    sal_Bool SAL_CALL supportsService(const OUString& rServiceName) override
+    {
+        return cppu::supportsService(this, rServiceName);
+    }
+    uno::Sequence<OUString> SAL_CALL getSupportedServiceNames() override
+    {
+        return { u"com.sun.star.frame.ProtocolHandler"_ustr,
+                 u"com.sun.star.comp.svx.HstStyleDispatcher"_ustr };
+    }
+
+private:
+    /// The frame's controller, when its document can be changed.
+    uno::Reference<frame::XController> Editable() const
+    {
+        if (!m_xFrame.is())
+            return {};
+        uno::Reference<frame::XController> xController = m_xFrame->getController();
+        if (!xController.is())
+            return {};
+        uno::Reference<frame::XStorable> xStorable(xController->getModel(), uno::UNO_QUERY);
+        if (!xStorable.is() || xStorable->isReadonly())
+            return {};
+        return xController;
+    }
+
+    uno::Reference<frame::XFrame> m_xFrame;
+};
+
+void HstStyleDispatcher::dispatch(const util::URL& rURL, const uno::Sequence<beans::PropertyValue>& rArgs)
+{
+    const Target eTarget = TargetOf(rURL);
+    OUString aId;
+    for (const beans::PropertyValue& rArg : rArgs)
+        if (rArg.Name == "Style")
+            rArg.Value >>= aId;
+
+    SolarMutexGuard aGuard;
+    const auto* pPicture
+        = eTarget == Target::Picture ? svx::hststyles::FindPictureStyle(aId) : nullptr;
+    const auto* pTable = eTarget == Target::Table ? svx::hststyles::FindTableStyle(aId) : nullptr;
+    const uno::Reference<frame::XController> xController = Editable();
+    if ((!pPicture && !pTable) || !xController.is())
+        return;
+
+    uno::Reference<document::XUndoManagerSupplier> xUndoSupplier(xController->getModel(),
+                                                                 uno::UNO_QUERY);
+    uno::Reference<document::XUndoManager> xUndo
+        = xUndoSupplier.is() ? xUndoSupplier->getUndoManager() : nullptr;
+    if (xUndo.is())
+        xUndo->enterUndoContext(SvxResId(pPicture ? RID_HST_STYLEGALLERY_UNDO_PICTURE
+                                                  : RID_HST_STYLEGALLERY_UNDO_TABLE));
+    try
+    {
+        if (pPicture)
+            svx::hststyles::ApplyPictureStyle(xController, *pPicture);
+        else
+            svx::hststyles::ApplyTableStyle(xController, *pTable);
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("svx", "Applying an HST gallery style");
+    }
+    if (xUndo.is())
+        xUndo->leaveUndoContext(); // an empty context leaves no undo action
+}
+}
+
+extern "C" SAL_DLLPUBLIC_EXPORT uno::XInterface*
+com_sun_star_comp_svx_HstStyleDispatcher_get_implementation(uno::XComponentContext*,
+                                                            uno::Sequence<uno::Any> const&)
+{
+    return cppu::acquire(new HstStyleDispatcher);
+}
