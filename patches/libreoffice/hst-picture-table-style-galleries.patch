+/// style (bComplete true: each cell uses exactly one style, so every part has its own fill and text colour).
+void SetCellProps(const css::uno::Reference<css::beans::XPropertySet>& rxCell, const TableStyle& rStyle,
+                  Part ePart, bool bComplete);
