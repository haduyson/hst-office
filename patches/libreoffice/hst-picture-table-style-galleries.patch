+using namespace css;
+
+namespace svx::hststyles
+{
+void AddPictureUndo(const uno::Reference<uno::XInterface>& rxShape)
+{
+    SdrObject* pObj = SdrObject::getSdrObjectFromXShape(rxShape);
+    if (!pObj || !dynamic_cast<SdrGrafObj*>(pObj))
+        return;
+    SdrModel& rModel = pObj->getSdrModelFromSdrObject();
+    if (rModel.IsUndoEnabled())
+        rModel.AddUndo(rModel.GetSdrUndoFactory().CreateUndoAttrObject(*pObj));
+}
+
+bool SetSlidesTableDesign(const uno::Reference<uno::XInterface>& rxShape,
+                          const uno::Reference<container::XIndexAccess>& rxDesign)
+{
+    auto* pTableObj = dynamic_cast<sdr::table::SdrTableObj*>(SdrObject::getSdrObjectFromXShape(rxShape));
+    if (!pTableObj || !rxDesign.is())
+        return false;
+    SdrModel& rModel = pTableObj->getSdrModelFromSdrObject();
+    const bool bUndo = rModel.IsUndoEnabled();
+    if (bUndo)
+    {
+        rModel.BegUndo(SvxResId(STR_TABLE_STYLE));
+        rModel.AddUndo(std::make_unique<sdr::table::TableStyleUndo>(*pTableObj));
+    }
+    pTableObj->setTableStyle(rxDesign);
+
+    // as SvxTableController::SetTableStyle: direct cell attributes the design also sets would hide it
+    const rtl::Reference<sdr::table::TableModel>& xTable = pTableObj->getUnoTable();
+    for (sal_Int32 nRow = 0; xTable.is() && nRow < xTable->getRowCount(); ++nRow)
+        for (sal_Int32 nCol = 0; nCol < xTable->getColumnCount(); ++nCol)
+        {
+            sdr::table::CellRef xCell(xTable->getCell(nCol, nRow));
+            SfxStyleSheet* pStyleSheet = xCell.is() ? xCell->GetStyleSheet() : nullptr;
+            if (!pStyleSheet)
+                continue;
+            SfxItemSet aSet(xCell->GetItemSet());
+            const SfxItemSet& rStyleSet = pStyleSheet->GetItemSet();
+            bool bChanges = false;
+            for (sal_uInt16 nWhich = SDRATTR_START; nWhich <= SDRATTR_TABLE_LAST; ++nWhich)
+                if (rStyleSet.GetItemState(nWhich) == SfxItemState::SET
+                    && aSet.GetItemState(nWhich) == SfxItemState::SET)
+                {
+                    aSet.ClearItem(nWhich);
+                    bChanges = true;
+                }
+            if (!bChanges)
+                continue;
+            if (bUndo)
+                xCell->AddUndo();
+            xCell->SetMergedItemSetAndBroadcast(aSet, true);
+        }
+    if (bUndo)
+        rModel.EndUndo();
+    return true;
+}
+}
