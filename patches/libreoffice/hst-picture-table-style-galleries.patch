+
+// HST Office: a picture style on the selected pictures. Writer pictures are frames: the style sets the four
+// frame borders and the frame shadow, which the .docx export writes as the picture outline (a:ln) and its
+// outer shadow. Sheets and Slides pictures are shapes: the style sets the shape line and the shape shadow,
+// written as a:ln and a:outerShdw in .xlsx and .pptx.
+
+#include "HstStyleApply.hxx"
+#include <HstSlidesTableStyle.hxx>
+
+#include <com/sun/star/beans/XPropertySet.hpp>
+#include <com/sun/star/container/XIndexAccess.hpp>
+#include <com/sun/star/drawing/LineStyle.hpp>
+#include <com/sun/star/lang/XServiceInfo.hpp>
+#include <com/sun/star/table/BorderLine2.hpp>
+#include <com/sun/star/table/BorderLineStyle.hpp>
+#include <com/sun/star/table/ShadowFormat.hpp>
+#include <com/sun/star/view/XSelectionSupplier.hpp>
+#include <docmodel/color/ComplexColor.hxx>
+#include <docmodel/uno/UnoComplexColor.hxx>
+
+#include <vector>
+
+using namespace css;
+
+namespace svx::hststyles
+{
+namespace
+{
+bool Supports(const uno::Reference<uno::XInterface>& rxObject, const OUString& rService)
+{
+    uno::Reference<lang::XServiceInfo> xInfo(rxObject, uno::UNO_QUERY);
+    return xInfo.is() && xInfo->supportsService(rService);
+}
+
+void ApplyToWriterFrame(const uno::Reference<beans::XPropertySet>& rxFrame, const PictureStyle& rStyle)
+{
+    table::BorderLine2 aLine;
+    if (rStyle.nLineWidth > 0)
+    {
+        aLine.Color = sal_Int32(rStyle.aLineColor);
+        aLine.LineStyle = table::BorderLineStyle::SOLID;
+        aLine.LineWidth = rStyle.nLineWidth;
+        aLine.OuterLineWidth = static_cast<sal_Int16>(rStyle.nLineWidth);
+    }
+    else
+        aLine.LineStyle = table::BorderLineStyle::NONE;
+    for (const OUString& rName : { u"LeftBorder"_ustr, u"RightBorder"_ustr, u"TopBorder"_ustr,
+                                   u"BottomBorder"_ustr })
+        rxFrame->setPropertyValue(rName, uno::Any(aLine));
+
+    table::ShadowFormat aShadow;
+    aShadow.Location = rStyle.nShadowDistance > 0 ? table::ShadowLocation_BOTTOM_RIGHT
+                                                  : table::ShadowLocation_NONE;
+    aShadow.ShadowWidth = static_cast<sal_Int16>(rStyle.nShadowDistance);
+    aShadow.IsTransparent = false;
+    aShadow.Color = sal_Int32(PICTURE_SHADOW_COLOR);
+    rxFrame->setPropertyValue(u"ShadowFormat"_ustr, uno::Any(aShadow));
+    if (rStyle.nShadowDistance > 0)
+        rxFrame->setPropertyValue(u"ShadowTransparence"_ustr, uno::Any(rStyle.nShadowTransparence));
+}
+
+void ApplyToShape(const uno::Reference<beans::XPropertySet>& rxShape, const PictureStyle& rStyle)
+{
+    const bool bLine = rStyle.nLineWidth > 0;
+    rxShape->setPropertyValue(u"LineStyle"_ustr,
+                              uno::Any(bLine ? drawing::LineStyle_SOLID : drawing::LineStyle_NONE));
+    if (bLine)
+    {
+        rxShape->setPropertyValue(u"LineColor"_ustr, uno::Any(sal_Int32(rStyle.aLineColor)));
+        // a plain colour: the default line of Slides is a theme colour, which .pptx would write instead
+        rxShape->setPropertyValue(
+            u"LineComplexColor"_ustr,
+            uno::Any(model::color::createXComplexColor(model::ComplexColor::createRGB(rStyle.aLineColor))));
+        rxShape->setPropertyValue(u"LineWidth"_ustr, uno::Any(rStyle.nLineWidth));
+    }
+    const bool bShadow = rStyle.nShadowDistance > 0;
+    rxShape->setPropertyValue(u"Shadow"_ustr, uno::Any(bShadow));
+    if (!bShadow)
+        return;
+    rxShape->setPropertyValue(u"ShadowColor"_ustr, uno::Any(sal_Int32(PICTURE_SHADOW_COLOR)));
+    rxShape->setPropertyValue(u"ShadowXDistance"_ustr, uno::Any(rStyle.nShadowDistance));
+    rxShape->setPropertyValue(u"ShadowYDistance"_ustr, uno::Any(rStyle.nShadowDistance));
+    rxShape->setPropertyValue(u"ShadowBlur"_ustr, uno::Any(rStyle.nShadowBlur));
+    rxShape->setPropertyValue(u"ShadowTransparence"_ustr, uno::Any(rStyle.nShadowTransparence));
+}
+}
+
+bool ApplyPictureStyle(const uno::Reference<frame::XController>& rxController, const PictureStyle& rStyle)
+{
+    uno::Reference<view::XSelectionSupplier> xSupplier(rxController, uno::UNO_QUERY);
+    if (!xSupplier.is())
+        return false;
+    uno::Reference<uno::XInterface> xSelection(xSupplier->getSelection(), uno::UNO_QUERY);
+    if (!xSelection.is())
+        return false;
+
+    // Writer answers a selected picture with its frame; shapes come as a collection
+    std::vector<uno::Reference<uno::XInterface>> aObjects;
+    if (Supports(xSelection, u"com.sun.star.text.TextGraphicObject"_ustr))
+        aObjects.push_back(xSelection);
+    else if (uno::Reference<container::XIndexAccess> xShapes{ xSelection, uno::UNO_QUERY })
+    {
+        for (sal_Int32 i = 0; i < xShapes->getCount(); ++i)
+            aObjects.emplace_back(xShapes->getByIndex(i), uno::UNO_QUERY);
+    }
+
+    bool bApplied = false;
+    for (const auto& rxObject : aObjects)
+    {
+        uno::Reference<beans::XPropertySet> xProps(rxObject, uno::UNO_QUERY);
+        if (!xProps.is())
+            continue;
+        if (Supports(rxObject, u"com.sun.star.text.TextGraphicObject"_ustr))
+            ApplyToWriterFrame(xProps, rStyle);
+        else if (Supports(rxObject, u"com.sun.star.drawing.GraphicObjectShape"_ustr))
+        {
+            AddPictureUndo(rxObject); // shape properties set through UNO leave no undo action of their own
+            ApplyToShape(xProps, rStyle);
+        }
+        else
+            continue;
+        bApplied = true;
+    }
+    return bApplied;
+}
+}
