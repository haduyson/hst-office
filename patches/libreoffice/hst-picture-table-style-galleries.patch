+enum class GalleryKind
+{
+    Picture,
+    Table
+};
+
+class StyleGalleryWindow final : public InterimItemWindow
+{
+public:
+    StyleGalleryWindow(vcl::Window* pParent, css::uno::Reference<css::frame::XFrame> xFrame,
+                       GalleryKind eKind);
+    ~StyleGalleryWindow() override;
+    void dispose() override;
+    /// "hst-gallery-state" (0 large, 1 medium, 2 small) from the ribbon's scale ladder: 6, 4 or 3 tiles.
+    bool set_property(const OUString& rKey, const OUString& rValue) override;
+
+private:
+    struct Entry
+    {
+        OUString aId;
+        OUString aName;
+        Bitmap aTile;
+    };
+
+    void ApplyColumns();
+    void ShowPage();
+    void Apply(const OUString& rId);
+    DECL_LINK(SelectedHdl, weld::ItemView&, void);
+    DECL_LINK(ActivatedHdl, const weld::TreeIter&, bool);
+    DECL_LINK(PageHdl, weld::Button&, void);
+    DECL_LINK(MoreHdl, weld::Button&, void);
+
+    css::uno::Reference<css::frame::XFrame> m_xFrame;
+    GalleryKind m_eKind;
+    std::unique_ptr<weld::ScrolledWindow> m_xScroll;
+    std::unique_ptr<weld::IconView> m_xView;
+    std::unique_ptr<weld::Button> m_xPrev;
+    std::unique_ptr<weld::Button> m_xNext;
+    std::unique_ptr<weld::Button> m_xMore;
+    std::vector<Entry> m_aEntries;
+    size_t m_nFirst = 0;
+    int m_nState = 0;
+    bool m_bFilling = false;
+};
