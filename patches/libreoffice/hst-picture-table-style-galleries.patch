+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This file is part of the LibreOffice project.
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+// HST Office: the HST table styles of the ribbon gallery (svx HstStyleGalleryData) as Sheets table styles.
+// They are custom OOXML-like styles (whole table, header row, first row stripe), so a table that uses one
+// is saved to .xlsx with its own tableStyle and dxf formats, and the table's header row and banded rows
+// options keep working.
+
+#include <HstTableStyles.hxx>
+
+#include <document.hxx>
+#include <patattr.hxx>
+#include <scitems.hxx>
+#include <tablestyle.hxx>
+
+#include <editeng/borderline.hxx>
+#include <editeng/boxitem.hxx>
+#include <editeng/brushitem.hxx>
+#include <editeng/colritem.hxx>
+#include <editeng/wghtitem.hxx>
+#include <svx/HstStyleGalleryData.hxx>
+
+namespace
+{
+// widths in twips: 0.75 pt and 1.5 pt, as svx::hststyles::TABLE_THIN_LINE and TABLE_HEADER_LINE
+constexpr tools::Long THIN_TWIPS = 15;
+constexpr tools::Long HEADER_TWIPS = 30;
+
+std::unique_ptr<ScPatternAttr> MakePattern(ScDocument& rDoc)
+{
+    return std::make_unique<ScPatternAttr>(rDoc.getCellAttributeHelper());
+}
+
+void PutFill(SfxItemSet& rSet, Color aColor) { rSet.Put(SvxBrushItem(aColor, ATTR_BACKGROUND)); }
+
+std::unique_ptr<ScTableStyle> MakeStyle(ScDocument& rDoc, const svx::hststyles::TableStyle& rStyle)
+{
+    auto pStyle = std::make_unique<ScTableStyle>(OUString(rStyle.aId),
+                                                 svx::hststyles::StyleUIName(rStyle.aName));
+
+    // whole table: outer lines and inner horizontal lines, vertical lines for the grid styles
+    const editeng::SvxBorderLine aThin(&rStyle.aLineColor, THIN_TWIPS);
+    auto pTable = MakePattern(rDoc);
+    SfxItemSet& rTableSet = pTable->GetItemSetWritable();
+    SvxBoxItem aBox(ATTR_BORDER);
+    aBox.SetLine(&aThin, SvxBoxItemLine::TOP);
+    aBox.SetLine(&aThin, SvxBoxItemLine::BOTTOM);
+    SvxBoxInfoItem aInner(ATTR_BORDER_INNER);
+    aInner.SetLine(&aThin, SvxBoxInfoItemLine::HORI);
+    if (rStyle.bVerticalLines)
+    {
+        aBox.SetLine(&aThin, SvxBoxItemLine::LEFT);
+        aBox.SetLine(&aThin, SvxBoxItemLine::RIGHT);
+        aInner.SetLine(&aThin, SvxBoxInfoItemLine::VERT);
+    }
+    rTableSet.Put(aBox);
+    rTableSet.Put(aInner);
+    pStyle->SetPattern(ScTableStyleElement::WholeTable, std::move(pTable));
+
+    // header row: fill, bold text in the header colour and a strong bottom line
+    const Color aHeaderLine = svx::hststyles::HeaderLineColor(rStyle);
+    const editeng::SvxBorderLine aStrong(&aHeaderLine, HEADER_TWIPS);
+    auto pHeader = MakePattern(rDoc);
+    SfxItemSet& rHeaderSet = pHeader->GetItemSetWritable();
+    if (rStyle.aHeaderFill != COL_TRANSPARENT)
+        PutFill(rHeaderSet, rStyle.aHeaderFill);
+    SvxBoxItem aHeaderBox(ATTR_BORDER);
+    aHeaderBox.SetLine(&aStrong, SvxBoxItemLine::BOTTOM);
+    rHeaderSet.Put(aHeaderBox);
+    rHeaderSet.Put(SvxColorItem(rStyle.aHeaderText, ATTR_FONT_COLOR));
+    rHeaderSet.Put(SvxWeightItem(WEIGHT_BOLD, ATTR_FONT_WEIGHT));
+    rHeaderSet.Put(SvxWeightItem(WEIGHT_BOLD, ATTR_CJK_FONT_WEIGHT));
+    rHeaderSet.Put(SvxWeightItem(WEIGHT_BOLD, ATTR_CTL_FONT_WEIGHT));
+    pStyle->SetPattern(ScTableStyleElement::HeaderRow, std::move(pHeader));
+
+    // banded rows: the first stripe (the first data row) is tinted. Both stripes repeat the row line: the
+    // .xlsx export writes no inner lines of the whole table, so other readers draw the rows from the stripes
+    for (const ScTableStyleElement eStripe :
+         { ScTableStyleElement::FirstRowStripe, ScTableStyleElement::SecondRowStripe })
+    {
+        auto pStripe = MakePattern(rDoc);
+        SfxItemSet& rStripeSet = pStripe->GetItemSetWritable();
+        if (eStripe == ScTableStyleElement::FirstRowStripe && rStyle.aBandFill != COL_TRANSPARENT)
+            PutFill(rStripeSet, rStyle.aBandFill);
+        SvxBoxItem aRowLine(ATTR_BORDER);
+        aRowLine.SetLine(&aThin, SvxBoxItemLine::BOTTOM);
+        rStripeSet.Put(aRowLine);
+        pStyle->SetPattern(eStripe, std::move(pStripe));
+    }
+    return pStyle;
+}
+}
+
+void ScHstTableStyles::Register(ScDocument& rDoc)
+{
+    ScTableStyles* pStyles = rDoc.GetTableStyles();
+    if (!pStyles)
+        return;
+    for (const svx::hststyles::TableStyle& rStyle : svx::hststyles::TableStyles())
+        if (!pStyles->GetTableStyle(OUString(rStyle.aId)))
+            pStyles->AddTableStyle(MakeStyle(rDoc, rStyle));
+}
