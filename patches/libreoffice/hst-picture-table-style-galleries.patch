@@ -0,0 +1,165 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This file is part of the LibreOffice project.
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+// HST Office: a table style on the table at the cursor, through each application's own table styles.
+// Writer: a table style (autoformat) in the TableStyles family, set as the table's TableTemplateName; the
+// autoformat formats the cells directly, so .docx keeps the look. Slides: a table design in the "table"
+// family with cell styles in the "cell" family, set as the table's TableTemplate; the table's options
+// (header row, banded rows...) stay as they are. Sheets: the table's TableStyleName; the HST styles are
+// registered in every spreadsheet beside the OOXML ones (sc HstTableStyles.cxx) and the header row and
+// banded rows options of the table stay as they are.
+
+#include "HstStyleApply.hxx"
+#include <HstSlidesTableStyle.hxx>
+
+#include <com/sun/star/beans/XPropertySet.hpp>
+#include <com/sun/star/container/XIndexAccess.hpp>
+#include <com/sun/star/container/XNameContainer.hpp>
+#include <com/sun/star/frame/XModel.hpp>
+#include <com/sun/star/lang/XMultiServiceFactory.hpp>
+#include <com/sun/star/lang/XServiceInfo.hpp>
+#include <com/sun/star/lang/XSingleServiceFactory.hpp>
+#include <com/sun/star/sheet/XCellRangeAddressable.hpp>
+#include <com/sun/star/sheet/XDatabaseRange.hpp>
+#include <com/sun/star/text/XTextViewCursorSupplier.hpp>
+#include <com/sun/star/view/XSelectionSupplier.hpp>
+
+using namespace css;
+
+namespace svx::hststyles
+{
+namespace
+{
+using detail::Family;
+using detail::Part;
+using detail::SetCellProps;
+
+bool ApplyWriter(const uno::Reference<frame::XController>& rxController, const TableStyle& rStyle)
+{
+    uno::Reference<text::XTextViewCursorSupplier> xCursorSupplier(rxController, uno::UNO_QUERY_THROW);
+    uno::Reference<beans::XPropertySet> xCursor(xCursorSupplier->getViewCursor(), uno::UNO_QUERY_THROW);
+    uno::Reference<beans::XPropertySet> xTable(xCursor->getPropertyValue(u"TextTable"_ustr), uno::UNO_QUERY);
+    const uno::Reference<frame::XModel> xModel = rxController->getModel();
+    uno::Reference<container::XNameContainer> xStyles = Family(xModel, u"TableStyles"_ustr);
+    if (!xTable.is() || !xStyles.is())
+        return false;
+    const OUString aName(rStyle.aId);
+    if (!xStyles->hasByName(aName))
+    {
+        uno::Reference<lang::XMultiServiceFactory> xFactory(xModel, uno::UNO_QUERY_THROW);
+        xStyles->insertByName(aName, uno::Any(xFactory->createInstance(u"com.sun.star.style.TableStyle"_ustr)));
+        uno::Reference<container::XNameAccess> xStyle(xStyles->getByName(aName), uno::UNO_QUERY_THROW);
+        const auto CellStyle = [&xStyle](const OUString& rCell) {
+            return uno::Reference<beans::XPropertySet>(xStyle->getByName(rCell), uno::UNO_QUERY_THROW);
+        };
+        SetCellProps(CellStyle(u"body"_ustr), rStyle, Part::Body, false);
+        if (rStyle.aBandFill != COL_TRANSPARENT) // Writer counts the first row below the header as even
+            SetCellProps(CellStyle(u"even-rows"_ustr), rStyle, Part::Band, false);
+        SetCellProps(CellStyle(u"first-row"_ustr), rStyle, Part::Header, false);
+    }
+    xTable->setPropertyValue(u"TableTemplateName"_ustr, uno::Any(aName));
+    return true;
+}
+
+uno::Reference<beans::XPropertySet> SlidesCellStyle(const uno::Reference<container::XNameContainer>& rxCells,
+                                                    const OUString& rName)
+{
+    if (!rxCells->hasByName(rName))
+    {
+        uno::Reference<lang::XSingleServiceFactory> xFactory(rxCells, uno::UNO_QUERY_THROW);
+        rxCells->insertByName(rName, uno::Any(xFactory->createInstance()));
+    }
+    return { rxCells->getByName(rName), uno::UNO_QUERY_THROW };
+}
+
+bool ApplySlides(const uno::Reference<frame::XController>& rxController,
+                 const uno::Reference<container::XIndexAccess>& rxShapes, const TableStyle& rStyle)
+{
+    const uno::Reference<frame::XModel> xModel = rxController->getModel();
+    uno::Reference<container::XNameContainer> xDesigns = Family(xModel, u"table"_ustr);
+    uno::Reference<container::XNameContainer> xCells = Family(xModel, u"cell"_ustr);
+    if (!xDesigns.is() || !xCells.is())
+        return false;
+    const OUString aName(rStyle.aId);
+    if (!xDesigns->hasByName(aName))
+    {
+        uno::Reference<lang::XSingleServiceFactory> xFactory(xDesigns, uno::UNO_QUERY_THROW);
+        uno::Reference<container::XNameReplace> xDesign(xFactory->createInstance(), uno::UNO_QUERY_THROW);
+        const std::pair<const char16_t*, Part> aParts[]
+            = { { u"first-row", Part::Header }, { u"odd-rows", Part::Band }, { u"body", Part::Body } };
+        for (const auto& [pCell, ePart] : aParts)
+        {
+            if (ePart == Part::Band && rStyle.aBandFill == COL_TRANSPARENT)
+                continue;
+            // Slides counts the first row below the header as odd
+            auto xCell = SlidesCellStyle(xCells, aName + "-" + OUString(pCell));
+            SetCellProps(xCell, rStyle, ePart, true);
+            xDesign->replaceByName(OUString(pCell), uno::Any(xCell));
+        }
+        xDesigns->insertByName(aName, uno::Any(xDesign));
+    }
+    bool bApplied = false;
+    for (sal_Int32 i = 0; i < rxShapes->getCount(); ++i)
+    {
+        // Slides table shapes do not name the TableShape service; the table object tells
+        uno::Reference<uno::XInterface> xShape(rxShapes->getByIndex(i), uno::UNO_QUERY);
+        uno::Reference<container::XIndexAccess> xDesign(xDesigns->getByName(aName), uno::UNO_QUERY);
+        if (SetSlidesTableDesign(xShape, xDesign))
+            bApplied = true;
+    }
+    return bApplied;
+}
+
+bool ApplySheets(const uno::Reference<frame::XController>& rxController,
+                 const uno::Reference<sheet::XCellRangeAddressable>& rxCells, const TableStyle& rStyle)
+{
+    uno::Reference<beans::XPropertySet> xDocProps(rxController->getModel(), uno::UNO_QUERY_THROW);
+    uno::Reference<container::XNameAccess> xRanges(xDocProps->getPropertyValue(u"DatabaseRanges"_ustr),
+                                                   uno::UNO_QUERY_THROW);
+    const table::CellRangeAddress aCursor = rxCells->getRangeAddress();
+    for (const OUString& rName : xRanges->getElementNames())
+    {
+        uno::Reference<sheet::XDatabaseRange> xRange(xRanges->getByName(rName), uno::UNO_QUERY);
+        uno::Reference<beans::XPropertySet> xProps(xRange, uno::UNO_QUERY);
+        if (!xRange.is() || !xProps.is())
+            continue;
+        const table::CellRangeAddress aArea = xRange->getDataArea();
+        if (aArea.Sheet != aCursor.Sheet || aCursor.StartColumn < aArea.StartColumn
+            || aCursor.StartColumn > aArea.EndColumn || aCursor.StartRow < aArea.StartRow
+            || aCursor.StartRow > aArea.EndRow)
+            continue;
+        // only tables have a style; setting one on a plain database range would turn it into a table
+        if (!xProps->getPropertyValue(u"TableStyleName"_ustr).hasValue())
+            continue;
+        xProps->setPropertyValue(u"TableStyleName"_ustr, uno::Any(OUString(rStyle.aId)));
+        return true;
+    }
+    return false;
+}
+}
+
+bool ApplyTableStyle(const uno::Reference<frame::XController>& rxController, const TableStyle& rStyle)
+{
+    if (!rxController.is())
+        return false;
+    if (uno::Reference<text::XTextViewCursorSupplier>(rxController, uno::UNO_QUERY).is())
+        return ApplyWriter(rxController, rStyle);
+    uno::Reference<view::XSelectionSupplier> xSupplier(rxController, uno::UNO_QUERY);
+    if (!xSupplier.is())
+        return false;
+    const uno::Any aSelection = xSupplier->getSelection();
+    if (uno::Reference<sheet::XCellRangeAddressable> xCells{ aSelection, uno::UNO_QUERY })
+        return ApplySheets(rxController, xCells, rStyle);
+    if (uno::Reference<container::XIndexAccess> xShapes{ aSelection, uno::UNO_QUERY })
+        return ApplySlides(rxController, xShapes, rStyle);
+    return false;
+}
+}
