--- a/framework/source/services/documenttabgroup.cxx
+++ b/framework/source/services/documenttabgroup.cxx
@@ -145,6 +145,19 @@
 
 namespace
 {
+/** A tab window that was just shown has no picture yet: vcl paints it later (paint idle) and Skia
+    copies it to the screen later still. Hiding the previous tab in that gap shows the desktop
+    behind both windows for a frame (Windows: the whole screen flashes on every switch). Paint the
+    shown window and copy it to the screen now, before the previous tab is hidden. */
+void lcl_paintNow(vcl::Window* pWindow)
+{
+    if (!pWindow || pWindow->isDisposed() || !pWindow->IsVisible())
+        return;
+    pWindow->PaintImmediately();
+    if (!pWindow->isDisposed())
+        pWindow->GetOutDev()->Flush();
+}
