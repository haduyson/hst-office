+/// HST: Word's page border art. Keys in the page format's grab bag, one for each side, "name;size in points".
+inline constexpr int HST_PAGE_ART_SETS = 24;
+inline constexpr OUString HST_PAGE_ART_KEYS[4] = { u"hstArtTop"_ustr, u"hstArtLeft"_ustr, u"hstArtBottom"_ustr, u"hstArtRight"_ustr };
+
+/// The set that draws one of Word's 164 names, -1 if it is not one of them.
+SW_DLLPUBLIC int HstPageArtSetOf(std::u16string_view rName);
+SW_DLLPUBLIC OUString HstPageArtToken(int nSet);
+SW_DLLPUBLIC OUString HstPageArtLabel(int nSet);
+SW_DLLPUBLIC void HstPageArtPaintTile(OutputDevice& rOut, int nSet, const tools::Rectangle& rTile, Color aBorderColor);
+/// Paints art instead of the border lines of a page; false if this format has none on any side.
+bool HstPageArtPaint(OutputDevice& rOut, const SwFrameFormat& rFormat, const SwRect& rBorderRect);
