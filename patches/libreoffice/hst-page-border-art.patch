+namespace
+{
+const std::vector<basegfx::B2DPolyPolygon>& lcl_Polygons()
+{
+    static const std::vector<basegfx::B2DPolyPolygon> aPolygons = [] {
+        std::vector<basegfx::B2DPolyPolygon> aAll(gHstPageArtPartCount);
+        for (size_t i = 0; i < gHstPageArtPartCount; ++i)
+            basegfx::utils::importFromSvgD(aAll[i], OUString(gHstPageArtParts[i].pPath), false, nullptr);
+        return aAll;
+    }();
+    return aPolygons;
+}
+}
+
+int HstPageArtSetOf(std::u16string_view rName)
+{
+    for (size_t i = 0; i < gHstPageArtNameCount; ++i)
+        if (rName == gHstPageArtNames[i].pName)
+            return gHstPageArtNames[i].nSet;
+    return -1;
+}
+
+OUString HstPageArtToken(int nSet) { return OUString(gHstPageArtSets[nSet].pToken); }
+OUString HstPageArtLabel(int nSet) { return OUString(gHstPageArtSets[nSet].pLabel); }
+
+void HstPageArtPaintTile(OutputDevice& rOut, int nSet, const tools::Rectangle& rTile, Color aBorderColor)
+{
+    const basegfx::B2DHomMatrix aMatrix = basegfx::utils::createScaleTranslateB2DHomMatrix(
+        rTile.GetWidth() / 1000.0, rTile.GetHeight() / 1000.0, rTile.Left(), rTile.Top());
+    const auto& rPolygons = lcl_Polygons();
+    for (size_t i = 0; i < gHstPageArtPartCount; ++i)
+    {
+        const HstPageArtPart& rPart = gHstPageArtParts[i];
+        if (rPart.nSet != nSet)
+            continue;
+        basegfx::B2DPolyPolygon aPolygon(rPolygons[i]);
+        aPolygon.transform(aMatrix);
+        rOut.SetLineColor();
+        rOut.SetFillColor(rPart.nColor < 0 ? aBorderColor : Color(ColorTransparency, rPart.nColor));
+        rOut.DrawPolyPolygon(aPolygon);
+    }
+}
+
+bool HstPageArtPaint(OutputDevice& rOut, const SwFrameFormat& rFormat, const SwRect& rBorderRect)
+{
+    const auto& rBag = rFormat.GetAttrSet().Get(RES_FRMATR_GRABBAG).GetGrabBag();
+    const SvxBoxItem& rBox = rFormat.GetBox();
+    bool bPainted = false;
+    rOut.Push(vcl::PushFlags::LINECOLOR | vcl::PushFlags::FILLCOLOR);
+    for (int nSide = 0; nSide < 4; ++nSide)
+    {
+        const auto it = rBag.find(HST_PAGE_ART_KEYS[nSide]);
+        const editeng::SvxBorderLine* pLine = nSide == 0   ? rBox.GetTop()
+                                              : nSide == 1 ? rBox.GetLeft()
+                                              : nSide == 2 ? rBox.GetBottom()
+                                                           : rBox.GetRight();
+        if (it == rBag.end() || !pLine)
+            continue; // no line here: this format has no border, the other one of the page style has
+        OUString sValue;
+        it->second >>= sValue;
+        sal_Int32 nIndex = 0;
+        const std::u16string_view aName = o3tl::getToken(sValue, 0, ';', nIndex);
+        const tools::Long nSize = std::max<sal_Int32>(1, o3tl::toInt32(o3tl::getToken(sValue, 0, ';', nIndex))) * 20;
+        const int nSet = HstPageArtSetOf(aName);
+        if (nSet < 0)
+            continue;
+        const bool bAcross = nSide == 0 || nSide == 2;
+        const tools::Long nLength = bAcross ? rBorderRect.Width() : rBorderRect.Height() - 2 * nSize;
+        const tools::Long nCount = std::max<tools::Long>(1, nLength / nSize);
+        for (tools::Long n = 0; n < nCount; ++n)
+        {
+            const tools::Long nStep = nLength * n / nCount, nNext = nLength * (n + 1) / nCount;
+            tools::Rectangle aTile;
+            if (bAcross)
+                aTile = tools::Rectangle(Point(rBorderRect.Left() + nStep, nSide == 0 ? rBorderRect.Top() : rBorderRect.Bottom() - nSize),
+                                         Size(nNext - nStep, nSize));
+            else
+                aTile = tools::Rectangle(Point(nSide == 1 ? rBorderRect.Left() : rBorderRect.Right() - nSize, rBorderRect.Top() + nSize + nStep),
+                                         Size(nSize, nNext - nStep));
+            HstPageArtPaintTile(rOut, nSet, aTile, pLine->GetColor());
+        }
+        bPainted = true;
+    }
+    rOut.Pop();
+    return bPainted;
+}
