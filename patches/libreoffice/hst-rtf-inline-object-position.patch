     void runProps();
+    /// The current run's \up / \dn (ooxml position sprm, half-points) when it is not 0.
+    RTFValue::Pointer_t getRunPosition();
+    /// Sends a run property holding only that position (inside a character group).
+    void sendRunPosition(const RTFValue::Pointer_t& pPosition);
     void runBreak();
     void parBreak();
     void tableBreak();
@@ -940,6 +944,8 @@ private:
     /// OLE attributes are attributes of the ooxml:OLEObject_OLEObject sprm.
     RTFSprms m_aOLEAttributes;
     RTFSprms m_aObjectAttributes;
+    /// \up / \dn of the run that holds the object's \result picture (half-points, positive raises).
+    RTFValue::Pointer_t m_pObjectPosition;
     /** If we are in an object group and if the we use its
      *  \objdata element.
      *  (if we don't use the \objdata we use the \result element)*/
diff --git a/sw/qa/extras/rtfimport/rtfimport.cxx b/sw/qa/extras/rtfimport/rtfimport.cxx
index 488e333..04e0997 100644
--- a/sw/qa/extras/rtfimport/rtfimport.cxx
+++ b/sw/qa/extras/rtfimport/rtfimport.cxx
@@ -1000,6 +1000,30 @@ CPPUNIT_TEST_FIXTURE(Test, testTdf166191)
     CPPUNIT_ASSERT_EQUAL(12.0f, getProperty<float>(textRun, u"CharHeight"_ustr));
 }
 
+CPPUNIT_TEST_FIXTURE(Test, testRunPositionMovesInlineObjects)
+{
+    // MathType writes \dn on the run of each formula so the formula baseline meets the text baseline.
+    // An OLE object (\dn inside its \result), the \result picture of an object in a table cell (\dn
+    // around the object) and a plain picture in a \dn6 run are lowered by 3 pt: VertOrient NONE with the
+    // top at -height - position (in mm100); an object in a run without \dn keeps its default alignment.
+    createSwDoc("hst-run-position-objects.rtf");
+    CPPUNIT_ASSERT_EQUAL(4, getShapes());
+    int nMoved = 0;
+    for (int i = 1; i <= 4; ++i)
+    {
+        uno::Reference<drawing::XShape> xShape = getShape(i);
+        CPPUNIT_ASSERT_EQUAL(text::TextContentAnchorType_AS_CHARACTER,
+                             getProperty<text::TextContentAnchorType>(xShape, u"AnchorType"_ustr));
+        if (getProperty<sal_Int16>(xShape, u"VertOrient"_ustr) != text::VertOrientation::NONE)
+            continue;
+        ++nMoved;
+        // 527 mm100 high, \dn6 = -6 half-points = -105 mm100
+        CPPUNIT_ASSERT_EQUAL(sal_Int32(-527 + 105),
+                             getProperty<sal_Int32>(xShape, u"VertOrientPosition"_ustr));
+    }
+    CPPUNIT_ASSERT_EQUAL(3, nMoved);
+}
+
 // tests should only be added to rtfIMPORT *if* they fail round-tripping in rtfEXPORT
 } // end of anonymous namespace
 CPPUNIT_PLUGIN_IMPLEMENT();
