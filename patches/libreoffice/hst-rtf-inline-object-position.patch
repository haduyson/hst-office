HST Office: RTF \up / \dn move inline objects and pictures, as w:position does in .docx (MathType).

MathType writes \dn on the run of each formula (an Equation.DSMT4 \object whose \result picture sits in that
run) so the formula baseline meets the text baseline. The RTF reader only sent character properties with text,
so the object never got the run's position: every formula sat raised, lines grew taller and a worksheet that is
6 pages in Word became 8 pages. The reader now sends the run's position (ooxml position sprm, half-points) in a
character group around the OLE object of \object and around an inline \pict (also buffered, in table cells,
where the \result picture is used instead of the object); the mapper then applies it like the .docx import
(hst-docx-inline-object-position.patch: VertOrient NONE at -height - position).

Test: CppunitTest_sw_rtfimport testRunPositionMovesInlineObjects (an object with \dn in its \result, the
\result picture of an object in a table cell, a plain picture in a \dn run, an object without \dn).

License: these upstream files remain under their original license (MPL-2.0).
---
diff --git a/sw/source/writerfilter/rtftok/rtfdocumentimpl.cxx b/sw/source/writerfilter/rtftok/rtfdocumentimpl.cxx
index 6ad758c..3598244 100644
--- a/sw/source/writerfilter/rtftok/rtfdocumentimpl.cxx
+++ b/sw/source/writerfilter/rtftok/rtfdocumentimpl.cxx
@@ -691,6 +691,24 @@ void RTFDocumentImpl::checkNeedPap()
     }
 }
 
+RTFValue::Pointer_t RTFDocumentImpl::getRunPosition()
+{
+    RTFValue::Pointer_t pPosition
+        = m_aStates.top().getCharacterSprms().find(NS_ooxml::LN_EG_RPrBase_position);
+    if (pPosition && !pPosition->getInt())
+        pPosition.clear();
+    return pPosition;
+}
+
+void RTFDocumentImpl::sendRunPosition(const RTFValue::Pointer_t& pPosition)
+{
+    RTFSprms aRunSprms;
+    aRunSprms.set(NS_ooxml::LN_EG_RPrBase_position, pPosition);
+    writerfilter::Reference<Properties>::Pointer_t const pRunProperties
+        = new RTFReferenceProperties(RTFSprms(), std::move(aRunSprms));
+    Mapper().props(pRunProperties);
+}
+
 void RTFDocumentImpl::runProps()
 {
     if (!m_aStates.top().getCurrentBuffer())
@@ -1150,6 +1168,9 @@ void RTFDocumentImpl::resolvePict(bool const bInline, uno::Reference<drawing::XS
 
         auto pShapeValue = new RTFValue(xShape);
         m_aObjectAttributes.set(NS_ooxml::LN_shape, pShapeValue);
+        // Word moves the run holding the object by its \up / \dn (MathType writes \dn so the formula
+        // baseline meets the text baseline); the picture's group inherits it from the run.
+        m_pObjectPosition = getRunPosition();
         return;
     }
 
@@ -1316,18 +1337,39 @@ void RTFDocumentImpl::resolvePict(bool const bInline, uno::Reference<drawing::XS
     }
     checkFirstRun();
 
+    // An inline picture moves with its run's \up / \dn, as with w:position of a .docx run (the
+    // \result picture of a MathType formula in a table cell or a field result comes this way).
+    RTFValue::Pointer_t const pPosition = bInline ? getRunPosition() : RTFValue::Pointer_t();
     if (!m_aStates.top().getCurrentBuffer())
     {
+        if (pPosition)
+        {
+            Mapper().startCharacterGroup();
+            sendRunPosition(pPosition);
+        }
         writerfilter::Reference<Properties>::Pointer_t pProperties
             = new RTFReferenceProperties(RTFSprms(), std::move(aSprms));
         Mapper().props(pProperties);
+        if (pPosition)
+            Mapper().endCharacterGroup();
         // Make sure we don't lose these properties with a too early reset.
         m_bHadPicture = true;
     }
     else
     {
+        RTFBuffer_t& rBuffer = *m_aStates.top().getCurrentBuffer();
+        if (pPosition)
+        {
+            rBuffer.emplace_back(RTFBufferTypes::StartRun, nullptr, nullptr);
+            RTFSprms aRunSprms;
+            aRunSprms.set(NS_ooxml::LN_EG_RPrBase_position, pPosition);
+            bufferProperties(rBuffer, new RTFValue(RTFSprms(), aRunSprms), nullptr,
+                             NS_ooxml::LN_Value_ST_StyleType_character);
+        }
         auto pValue = new RTFValue(RTFSprms(), aSprms);
-        bufferProperties(*m_aStates.top().getCurrentBuffer(), pValue, nullptr);
+        bufferProperties(rBuffer, pValue, nullptr);
+        if (pPosition)
+            rBuffer.emplace_back(RTFBufferTypes::EndRun, nullptr, nullptr);
     }
 }
 
@@ -3008,10 +3050,20 @@ RTFError RTFDocumentImpl::beforePopState(RTFParserState& rState)
                 pShape->getAny() >>= xShape;
             if (xShape.is())
             {
+                // The run's position goes with the object, as w:position of a .docx run does: the
+                // mapper gives an as-character object VertOrient NONE below the baseline by it.
+                if (m_pObjectPosition)
+                {
+                    Mapper().startCharacterGroup();
+                    sendRunPosition(m_pObjectPosition);
+                }
                 Mapper().startShape(xShape);
                 Mapper().props(pProperties);
                 Mapper().endShape();
+                if (m_pObjectPosition)
+                    Mapper().endCharacterGroup();
             }
+            m_pObjectPosition.clear();
             m_aObjectAttributes.clear();
             m_aOLEAttributes.clear();
             m_bObject = false;
