@@ -77,12 +84,29 @@
             pOrcus->importODS_Styles(*m_pDocument, aPath);
             pStyleSheetPool->setAllParaStandard();
         }
+
+        // HST: new workbooks use Excel's size. In the style and not the pool default, so files that do
+        // not state a size keep the old one. Filters come through here too, before they load (their
+        // medium has a name), and leave the style alone where a file's size equals the pool default.
+        SfxStyleSheetBase* pDefault = bNewWorkbook
+            ? pStyleSheetPool->Find(ScResId(STR_STYLENAME_STANDARD), SfxStyleFamily::Para) : nullptr;
+        if (pDefault)
+        {
+            SfxItemSet& rSet = pDefault->GetItemSet();
+            rSet.Put(SvxFontHeightItem(220, 100, ATTR_FONT_HEIGHT));
+            rSet.Put(SvxFontHeightItem(220, 100, ATTR_CJK_FONT_HEIGHT));
+            rSet.Put(SvxFontHeightItem(220, 100, ATTR_CTL_FONT_HEIGHT));
+        }
     }
 
     //  SetDocumentModified is not allowed anymore in Load/InitNew!
     InitItems();
     CalcOutputFactor();
 
+    // HST: the empty rows follow the default style's size, as a change of that style makes them do.
+    if (bNewWorkbook)
+        AdjustRowHeight(0, m_pDocument->MaxRow(), 0);
+
     return bRet;
