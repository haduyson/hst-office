+tools::Long NotebookbarTabControl::HstWidestKeepWidth(const TabPage& rCurrent)
+{
+    // a page measures once it has been shown; the contextual tabs do not count
+    if (const tools::Long nCurrent = hst::ribbon::PageKeepWidth(rCurrent); nCurrent >= 0)
+        m_aHstPageKeepWidths[GetCurPageId()] = nCurrent;
+    tools::Long nWidest = -1;
+    for (const auto& [nPageId, nKeep] : m_aHstPageKeepWidths)
+        if (const TabPage* pMeasured = GetTabPage(nPageId);
+            pMeasured && pMeasured->HasContext(vcl::EnumContext::Context::Any))
+            nWidest = std::max(nWidest, nKeep);
+    return nWidest;
+}
