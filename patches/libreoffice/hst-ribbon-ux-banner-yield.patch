+/// HST Office: a large (lc_) theme image from the stock name of a small or large one, or an empty image
+Image hstLargeImage(const OUString& rStock)
+{
+    if (rStock.isEmpty())
+        return Image();
+    const Image aLarge(StockImage::Yes, rStock.replaceFirst("/sc_", "/lc_"));
+    return aLarge.GetSizePixel().Width() > 0 ? aLarge : Image(StockImage::Yes, rStock);
+}
+
+/// HST Office: the icon of a group's first command (toolbox item or drop-down button), at large size; the
+/// dialog launcher in the caption row does not count
+Image hstFirstImage(const vcl::Window& rWindow)
+{
+    if (rWindow.get_id().startsWith("bxHstCaption") || rWindow.get_id().startsWith("bxHstLaunch"))
+        return Image();
+    if (const ToolBox* pBox = dynamic_cast<const ToolBox*>(&rWindow))
+    {
+        for (ToolBox::ImplToolItems::size_type n = 0; n < pBox->GetItemCount(); ++n)
+        {
+            const ToolBoxItemId nId = pBox->GetItemId(n);
+            if (!pBox->IsItemVisible(nId))
+                continue;
+            OUString aCommand = pBox->GetItemCommand(nId);
+            if (aCommand.startsWith(".uno:"))
+            {
+                aCommand = aCommand.copy(5).getToken(0, '?').toAsciiLowerCase();
+                if (const Image aImage(StockImage::Yes, "cmd/lc_" + aCommand + ".png"); aImage.GetSizePixel().Width() > 0)
+                    return aImage;
+            }
+            if (Image aImage = hstLargeImage(pBox->GetItemImage(nId).GetStock()); aImage.GetSizePixel().Width() > 0)
+                return aImage;
+        }
+        return Image();
+    }
+    if (const Button* pButton = dynamic_cast<const Button*>(&rWindow))
+        return hstLargeImage(pButton->GetModeImage().GetStock());
+    for (const vcl::Window* pChild = rWindow.GetWindow(GetWindowType::FirstChild); pChild;
+         pChild = pChild->GetWindow(GetWindowType::Next))
+        if (pChild->IsVisible())
+            if (Image aImage = hstFirstImage(*pChild); aImage.GetSizePixel().Width() > 0)
+                return aImage;
+    return Image();
+}
+}
