+tools::Long PriorityMergedHBox::HstKeepWidth() const
+{
+    if (HstMinWidth() < 0)
+        return -1;
+    tools::Long nKeep = 0;
+    sal_uInt16 nGroups = 0;
+    for (vcl::Window* pChild : HstGroups())
+    {
+        const auto& rWidths = m_aHstWidths.find(pChild)->second.second;
+        const auto nStates = std::min(rWidths.size(), static_cast<size_t>(hst::ribbon::GroupStateCount));
+        nKeep += *std::min_element(rWidths.begin(), rWidths.begin() + nStates);
+        ++nGroups;
+    }
+    return nKeep + get_spacing() * (nGroups - 1);
 }
 
