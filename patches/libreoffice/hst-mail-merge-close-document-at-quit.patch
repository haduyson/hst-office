--- /dev/null
+++ b/sw/source/uibase/inc/hstmailmergetermination.hxx
@@ -0,0 +1,46 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ * This file is part of HST Office.
+ */
+
+#pragma once
+
+#include <com/sun/star/frame/XTerminateListener.hpp>
+#include <cppuhelper/implbase.hxx>
+
+#include <functional>
+
+namespace hst::sw
+{
+/* HST Office: runs a callback once when the office terminates, while Writer is still alive.
+
+   The mail merge engine (com.sun.star.text.MailMerge) owns the hidden document it loads from its
+   DocumentURL and closes it when the engine is destroyed. A client that still holds the engine when
+   the office quits (a script over UNO, released when the bridge goes away at shutdown) had that
+   document destroyed after Writer's module was gone: its pool defaults were freed, and SwDoc's
+   destructor crashed. The engine now closes the document in notifyTermination.
+
+   The guard registers itself with the Desktop; disarm() drops the callback and unregisters. The
+   callback and disarm() run under the SolarMutex. */
+class MailMergeTerminationGuard final
+    : public cppu::WeakImplHelper<css::frame::XTerminateListener>
+{
+public:
+    explicit MailMergeTerminationGuard(std::function<void()> aOnTermination);
+
+    /// The owner is going away: never call back, stop listening.
+    void disarm();
+
+    // XTerminateListener
+    void SAL_CALL queryTermination(const css::lang::EventObject& rEvent) override;
+    void SAL_CALL notifyTermination(const css::lang::EventObject& rEvent) override;
+    // XEventListener
+    void SAL_CALL disposing(const css::lang::EventObject& rEvent) override;
+
+private:
+    std::function<void()> m_aOnTermination;
+};
+}
