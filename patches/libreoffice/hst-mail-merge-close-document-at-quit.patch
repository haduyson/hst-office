@@ -0,0 +1,71 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ * This file is part of HST Office.
+ */
+
+#include <hstmailmergetermination.hxx>
+
+#include <com/sun/star/frame/Desktop.hpp>
+#include <comphelper/processfactory.hxx>
+#include <comphelper/diagnose_ex.hxx>
+#include <vcl/svapp.hxx>
+
+using namespace css;
+
+namespace hst::sw
+{
+MailMergeTerminationGuard::MailMergeTerminationGuard(std::function<void()> aOnTermination)
+    : m_aOnTermination(std::move(aOnTermination))
+{
+    try
+    {
+        frame::Desktop::create(comphelper::getProcessComponentContext())->addTerminateListener(this);
+    }
+    catch (const uno::Exception&)
+    {
+        // no Desktop (a unit test without one): the engine closes its document in its destructor
+        TOOLS_WARN_EXCEPTION("sw.uno", "mail merge: no terminate listener");
+        m_aOnTermination = nullptr;
+    }
+}
+
+void MailMergeTerminationGuard::disarm()
+{
+    {
+        SolarMutexGuard aGuard;
+        if (!m_aOnTermination)
+            return;
+        m_aOnTermination = nullptr;
+    }
+    // keep this alive while the Desktop drops its reference
+    rtl::Reference<MailMergeTerminationGuard> xKeepAlive(this);
+    try
+    {
+        frame::Desktop::create(comphelper::getProcessComponentContext())->removeTerminateListener(this);
+    }
+    catch (const uno::Exception&)
+    {
+        // the Desktop is already gone: nothing to unregister from
+    }
+}
+
+void MailMergeTerminationGuard::queryTermination(const lang::EventObject&) {}
+
+void MailMergeTerminationGuard::notifyTermination(const lang::EventObject&)
+{
+    SolarMutexGuard aGuard;
+    std::function<void()> aOnTermination = std::move(m_aOnTermination);
+    m_aOnTermination = nullptr;
+    if (aOnTermination)
+        aOnTermination();
+}
+
+void MailMergeTerminationGuard::disposing(const lang::EventObject&)
+{
+    SolarMutexGuard aGuard;
+    m_aOnTermination = nullptr;
+}
+}
+
