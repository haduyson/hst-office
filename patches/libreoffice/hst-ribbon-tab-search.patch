 using namespace css::uno;
+
+/** HST Office: the feature search box of the tab row ("Tìm tính năng… (Alt+Q)"). It is not an
+    entry: a click, Enter, Space, keyboard focus or a typed character opens the feature search
+    popup anchored under the box, with the typed character as its first text. The tab control
+    base places it after the last tab (child id "hst-tab-search") and gives it the rest of the row
+    up to the menu button; below 120 logical px it shows only the magnifier. */
+class HstTabSearchBox final : public Control
+{
+public:
+    explicit HstTabSearchBox(vcl::Window* pParent)
+        : Control(pParent, WB_TABSTOP)
+    {
+        set_id(u"hst-tab-search"_ustr);
+        SetPaintTransparent(true);
+        SetAccessibleRole(css::accessibility::AccessibleRole::PUSH_BUTTON);
+        SetAccessibleName(Placeholder());
+        SetQuickHelpText(Placeholder());
+    }
+
+    /** The owner's Vietnamese wording in the Vietnamese UI, English otherwise. */
+    static OUString Placeholder()
+    {
+        return SvtSysLocale().GetUILanguageTag().getLanguage() == "vi"
+                   ? u"Tìm tính năng… (Alt+Q)"_ustr
+                   : u"Search features… (Alt+Q)"_ustr;
+    }
+
+    bool Collapsed() const
+    {
+        return GetOutputSizePixel().Width() < std::lround(120 * GetDPIScaleFactor());
+    }
+
+    void OpenSearch(const OUString& rInitialText)
+    {
+#ifdef HST_HAVE_FEATURE_SEARCH
+        sfx2::hst::ShowFeatureSearch(this, rInitialText);
+#else
+        (void)rInitialText; // the command popup has no initial text
+        comphelper::dispatchCommand(u".uno:CommandPopup"_ustr, {});
+#endif
+    }
+
+    virtual void Paint(vcl::RenderContext& rDev, const tools::Rectangle&) override
+    {
+        const StyleSettings& rStyle = rDev.GetSettings().GetStyleSettings();
+        const bool bSystem = !hst::ribbon::ownerDrawAllowed(rStyle); // high contrast
+        const hst::ribbon::Palette aPalette = hst::ribbon::paletteFor(rStyle);
+        const double fDpi = GetDPIScaleFactor();
+        const tools::Long nRadius = std::lround(4 * fDpi);
+        const Size aOut = GetOutputSizePixel();
+        const Color aText = bSystem ? rStyle.GetFieldTextColor() : aPalette.aCaption;
+        rDev.Push(vcl::PushFlags::LINECOLOR | vcl::PushFlags::FILLCOLOR | vcl::PushFlags::FONT
+                  | vcl::PushFlags::TEXTCOLOR);
+        // an even 1 px border on all four sides; the accent colour while hovered or focused
+        rDev.SetFillColor(rStyle.GetFieldColor());
+        rDev.SetLineColor(bSystem ? rStyle.GetFieldTextColor()
+                          : (mbHover || HasFocus()) ? aPalette.aTabAccent
+                                                    : aPalette.aSeparator);
+        rDev.DrawRect(tools::Rectangle(Point(), Size(aOut.Width() - 1, aOut.Height() - 1)), nRadius,
+                      nRadius);
+        // magnifier: a ring and a short handle, drawn so it is sharp at any scale
+        const tools::Long nGlyph = std::lround(14 * fDpi);
+        const tools::Long nPad = std::lround(8 * fDpi);
+        const tools::Long nX = Collapsed() ? (aOut.Width() - nGlyph) / 2 : nPad;
+        const tools::Long nY = (aOut.Height() - nGlyph) / 2;
+        const tools::Long nRing = nGlyph * 10 / 14;
+        rDev.SetFillColor();
+        rDev.SetLineColor(aText);
+        LineInfo aLine(LineStyle::Solid, std::max<tools::Long>(1, std::lround(1.5 * fDpi)));
+        rDev.DrawEllipse(tools::Rectangle(Point(nX, nY), Size(nRing, nRing)));
+        rDev.DrawLine(Point(nX + nRing * 85 / 100, nY + nRing * 85 / 100),
+                      Point(nX + nGlyph - 1, nY + nGlyph - 1), aLine);
+        if (!Collapsed())
+        {
+            vcl::Font aFont(rStyle.GetAppFont());
+            rDev.SetFont(aFont);
+            rDev.SetTextColor(aText);
+            const tools::Long nTextX = nX + nGlyph + std::lround(6 * fDpi);
+            const tools::Rectangle aTextRect(Point(nTextX, 0),
+                                             Size(std::max<tools::Long>(0, aOut.Width() - nTextX - nPad), aOut.Height()));
+            rDev.DrawText(aTextRect, Placeholder(),
+                          DrawTextFlags::Left | DrawTextFlags::VCenter | DrawTextFlags::EndEllipsis);
+        }
+        if (HasFocus())
+        {
+            // keyboard focus: a second even ring inside the border
+            tools::Rectangle aRing(Point(1, 1), Size(aOut.Width() - 3, aOut.Height() - 3));
+            rDev.SetLineColor(bSystem ? rStyle.GetHighlightColor() : aPalette.aTabAccent);
+            rDev.DrawRect(aRing, nRadius, nRadius);
+        }
+        rDev.Pop();
+    }
+
+    virtual void MouseMove(const MouseEvent& rEvt) override
+    {
+        const bool bHover = !rEvt.IsLeaveWindow();
+        if (bHover != mbHover)
+        {
+            mbHover = bHover;
+            Invalidate();
+        }
+        Control::MouseMove(rEvt);
+    }
+
+    virtual void MouseButtonUp(const MouseEvent& rEvt) override
+    {
+        if (rEvt.IsLeft() && tools::Rectangle(Point(), GetOutputSizePixel()).Contains(rEvt.GetPosPixel()))
+        {
+            OpenSearch(OUString());
+            return;
+        }
+        Control::MouseButtonUp(rEvt);
+    }
+
+    virtual void KeyInput(const KeyEvent& rEvt) override
+    {
+        const vcl::KeyCode& rKey = rEvt.GetKeyCode();
+        if (!rKey.GetModifier() && (rKey.GetCode() == KEY_RETURN || rKey.GetCode() == KEY_SPACE))
+        {
+            OpenSearch(OUString());
+            return;
+        }
+        const sal_Unicode c = rEvt.GetCharCode();
+        if (!rKey.IsMod1() && !rKey.IsMod2() && c >= 0x20 && c != 0x7F)
+        {
+            OpenSearch(OUString(c)); // typing starts the search with that character
+            return;
+        }
+        Control::KeyInput(rEvt);
+    }
+
+    virtual void GetFocus() override
+    {
+        Control::GetFocus();
+        Invalidate();
+        // reached with the keyboard (Tab or F6): open the search at once, as the owner asked
+        if (GetGetFocusFlags() & (GetFocusFlags::Tab | GetFocusFlags::F6))
+            OpenSearch(OUString());
+    }
+
+    virtual void LoseFocus() override
+    {
+        Control::LoseFocus();
+        Invalidate();
+    }
+
+    virtual void DataChanged(const DataChangedEvent& rEvt) override
+    {
+        Control::DataChanged(rEvt);
+        if (rEvt.GetType() == DataChangedEventType::SETTINGS)
+            Invalidate(); // light/dark and high contrast follow the theme
+    }
+
+private:
+    bool mbHover = false;
+};
 using namespace css::ui;
 using namespace css::frame;
 
