+
+#include <memory>
+
+using namespace css;
+
+namespace hst::ole
+{
+namespace
+{
+/// A length-prefixed ANSI string of the CompObj stream ([MS-OLEDS] 2.1.4), skipped
+bool SkipString(SvStream& rStream)
+{
+    sal_uInt32 nLength = 0;
+    rStream.ReadUInt32(nLength);
+    if (!rStream.good() || nLength > rStream.remainingSize())
+        return false;
+    rStream.SeekRel(nLength);
+    return rStream.good();
+}
+
+/// The ProgID field of a CompObj stream ([MS-OLEDS] 2.3.8): header (28 bytes), user type,
+/// clipboard format (a string, a 32-bit format after a 0xFFFFFFFF/0xFFFFFFFE marker, or none),
+/// then the ProgID as a length-prefixed ANSI string.
+OUString ReadProgID(SvStream& rStream)
+{
+    rStream.Seek(28);
+    if (!SkipString(rStream))
+        return OUString();
+    sal_uInt32 nMarker = 0;
+    rStream.ReadUInt32(nMarker);
+    if (nMarker == 0xffffffff || nMarker == 0xfffffffe)
+        rStream.SeekRel(4);
+    else if (nMarker > 0)
+        rStream.SeekRel(nMarker);
+    sal_uInt32 nLength = 0;
+    rStream.ReadUInt32(nLength);
+    if (!rStream.good() || nLength < 2 || nLength > 40 || nLength > rStream.remainingSize())
+        return OUString();
+    OStringBuffer aProgID;
+    for (sal_uInt32 n = 0; n < nLength; ++n)
+    {
+        char c = 0;
+        rStream.ReadChar(c);
+        if (c == 0)
+            break;
+        if (c < 0x21 || c > 0x7e) // a ProgID is a short ASCII name
+            return OUString();
+        aProgID.append(c);
+    }
+    return OStringToOUString(aProgID, RTL_TEXTENCODING_ASCII_US);
+}
+}
+
+OUString StoredProgID(const uno::Reference<embed::XEmbeddedObject>& xObject)
+{
+    try
+    {
+        uno::Reference<document::XStorageBasedDocument> xParent(
+            uno::Reference<container::XChild>(xObject, uno::UNO_QUERY_THROW)->getParent(),
+            uno::UNO_QUERY_THROW);
+        uno::Reference<embed::XStorage> xStorage = xParent->getDocumentStorage();
+        const OUString aEntry
+            = uno::Reference<embed::XEmbedPersist>(xObject, uno::UNO_QUERY_THROW)->getEntryName();
+        if (!xStorage.is() || !xStorage->hasByName(aEntry) || !xStorage->isStreamElement(aEntry))
+            return OUString(); // an own (ODF) object has no OLE ProgID
+        std::unique_ptr<SvStream> pStream(utl::UcbStreamHelper::CreateStream(
+            xStorage->cloneStreamElement(aEntry)->getInputStream()));
+        if (!pStream || !SotStorage::IsStorageFile(pStream.get()))
+            return OUString();
+        rtl::Reference<SotStorage> xOle = new SotStorage(*pStream);
+        static constexpr OUString COMPOBJ = u"\001CompObj"_ustr;
+        if (xOle->GetError() || !xOle->IsStream(COMPOBJ))
+            return OUString();
+        rtl::Reference<SotStorageStream> xCompObj = xOle->OpenSotStream(COMPOBJ, StreamMode::READ);
+        return xCompObj.is() ? ReadProgID(*xCompObj) : OUString();
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("sw.ww8", "hst::ole::StoredProgID");
+        return OUString();
+    }
+}
+}
