+#pragma once
+
+#include <com/sun/star/embed/XEmbeddedObject.hpp>
+#include <rtl/ustring.hxx>
+
+namespace hst::ole
+{
+/** The ProgID an OLE object's own data names ("Equation.DSMT4" for MathType), "" if none.
+
+    A .docx export takes an object's ProgID from what the import remembered under the object's
+    name. An object that comes back from Undo (a converted MathType equation, a deleted and
+    restored object) has a new name, so it was written with ProgID="" and Word and MathType no
+    longer took it for a MathType equation. The stored compound file still says what it is: its
+    "\1CompObj" stream carries the ProgID after the user type and the clipboard format. */
+OUString StoredProgID(const css::uno::Reference<css::embed::XEmbeddedObject>& xObject);
+}
