+void PriorityMergedHBox::HstRestoreOrder()
+{
+    if (m_aHstAuthored.empty())
+    {
+        // the first layout sees the groups as the .ui file made them, before any fold
+        for (vcl::Window* pChild = GetWindow(GetWindowType::FirstChild); pChild;
+             pChild = pChild->GetWindow(GetWindowType::Next))
+            if (pChild != m_pButton)
+                m_aHstAuthored.emplace_back(pChild);
+        return;
+    }
+    std::vector<vcl::Window*> aNow;
+    for (vcl::Window* pChild = GetWindow(GetWindowType::FirstChild); pChild;
+         pChild = pChild->GetWindow(GetWindowType::Next))
+        if (pChild != m_pButton)
+            aNow.push_back(pChild);
+    std::vector<vcl::Window*> aWanted;
+    for (const VclPtr<vcl::Window>& xGroup : m_aHstAuthored)
+        if (xGroup && !xGroup->isDisposed() && xGroup->GetParent() == this)
+            aWanted.push_back(xGroup.get());
+    if (aNow == aWanted)
+        return;
+    // the chevron first, as the constructor made it, then the groups in authored order
+    sal_uInt16 nPos = 0;
+    if (m_pButton)
+        m_pButton->reorderWithinParent(nPos++);
+    for (vcl::Window* pGroup : aWanted)
+        pGroup->reorderWithinParent(nPos++);
+}
