+        const bool bNoParagraphFormats = rShell.HasSelection() && rShell.IsSelOnePara() && !rShell.IsSelFullPara();
+        m_pFormatClipboard->KeyCopy().Paste(rShell, GetDocShell()->GetStyleSheetPool(), false, bNoParagraphFormats);
+        return;
+    }
+
     if( m_pFormatClipboard->HasContent() )
     {
         m_pFormatClipboard->Erase();
