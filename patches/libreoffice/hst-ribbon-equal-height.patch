HST Office: one ribbon height in Writer, Sheets, Slides and Draw.

Gap list G06 (coordinator 15/11/2026): Sheets' ribbon was 3 px lower than the other apps' (its tallest tab page is
shorter), so its document started higher and its group captions sat higher. The full ribbon's tab control now
requests at least 165 logical px, the height of the other three apps; the compact ribbon and the quick access
toolbar's own row are unchanged. A fixed 106 px body is left for 1.0.3.

--- a/sfx2/source/notebookbar/NotebookbarTabControl.cxx
+++ b/sfx2/source/notebookbar/NotebookbarTabControl.cxx
@@ -1050,6 +1050,10 @@
         HstSetCompact(!m_pHstCompact->IsCompact());
 }
 
+// HST Office: the tab row and the tallest tab page of the full ribbon, in logical px (gap list G06: one height and
+// one caption row for Writer, Sheets, Slides and Draw)
+constexpr double HST_RIBBON_HEIGHT = 165;
+
 Size NotebookbarTabControl::calculateRequisition() const
 {
     Size aSize = NotebookbarTabControlBase::calculateRequisition();
@@ -1071,6 +1075,8 @@
         aSize.setWidth( 400 );
     if (m_pHstCompact && m_pHstCompact->IsCompact()) // the tab row and the quick row
         aSize.setHeight(HstHeaderHeight() + HstRibbonCompact::QuickHeight(HstHeaderHeight(), GetDPIScaleFactor()));
+    else // HST Office: one ribbon height in every app (the tallest pages of Writer, Slides and Draw; Sheets' were 3 px lower)
+        aSize.setHeight(std::max<tools::Long>(aSize.Height(), std::lround(HST_RIBBON_HEIGHT * GetDPIScaleFactor())));
     aSize.AdjustHeight(HstQatRow()); // the quick access toolbar's own row below the ribbon
 
     return aSize;
