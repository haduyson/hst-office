HST Office: one banner width per window for every ribbon tab; scaling steps keep 12 px of hysteresis.

1.0.2 ribbon (owner decisions 14/11/2026, gap list G04, G08): the banner beside the groups is 260 logical px
wide up to 1440 px of window width, then grows linearly to 360 px at 1920 and above
(hst::banner::windowSlotWidth); it no longer depends on the widest tab measured, so it never moves when the
user switches tabs, and the groups scale beside it. The ladder of a tab keeps its last plan while the width
stays within 12 logical px of the width it was made for and the plan still fits, so a window resized across
a threshold does not make a group change back and forth.

--- a/include/vcl/HstBannerGeometry.hxx
+++ b/include/vcl/HstBannerGeometry.hxx
@@ -150,6 +150,22 @@
     return nWant;
 }
 
+/** HST Office (1.0.2 ribbon, owner decision 14/11/2026): the width in px of the banner beside the ribbon's
+    groups for a window nWindowWidth px wide: MIN_WIDE_ART_WIDTH up to 1440 logical px, then growing linearly to
+    the artwork's 360 at 1920 and above. One width for every tab, so the banner never moves between tabs. */
+constexpr long WINDOW_NARROW = 1440;
+constexpr long WINDOW_WIDE = 1920;
+inline long windowSlotWidth(long nWindowWidth, double fDpi)
+{
+    const long nLogical = fDpi > 0 ? std::lround(nWindowWidth / fDpi) : nWindowWidth;
+    const long nWidth = nLogical <= WINDOW_NARROW ? MIN_WIDE_ART_WIDTH
+                        : nLogical >= WINDOW_WIDE
+                            ? ART_WIDTH
+                            : MIN_WIDE_ART_WIDTH
+                                  + (nLogical - WINDOW_NARROW) * (ART_WIDTH - MIN_WIDE_ART_WIDTH) / (WINDOW_WIDE - WINDOW_NARROW);
+    return scaled(nWidth, fDpi);
+}
