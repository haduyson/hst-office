+CPPUNIT_TEST_FIXTURE(Test, testHstEqualCellsShareOneFormat)
+{
+    // A 3x3 table (RTF goes through the same table handler as DOCX) where only B2 is shaded.
+    loadFromFile(u"hst-table-equal-cells.rtf");
+    SwDoc* pDoc = getSwDoc();
+    const SwTable& rTable = *SwTable::FindTable((*pDoc->GetTableFrameFormats())[0]);
+    const SwTableSortBoxes& rBoxes = rTable.GetTabSortBoxes();
+    CPPUNIT_ASSERT_EQUAL(size_t(9), rBoxes.size());
+    std::set<const SwFrameFormat*> aFormats;
+    for (const SwTableBox* pA : rBoxes)
+    {
+        aFormats.insert(pA->GetFrameFormat());
+        for (const SwTableBox* pB : rBoxes)
+        {
+            // Cells share a format exactly when their attributes are the same.
+            const bool bSameFormat = pA->GetFrameFormat() == pB->GetFrameFormat();
+            const bool bSameAttrs = pA->GetFrameFormat()->GetAttrSet() == pB->GetFrameFormat()->GetAttrSet();
+            CPPUNIT_ASSERT_EQUAL(bSameAttrs, bSameFormat);
+        }
+    }
+    // Without the accompanying change, every cell had its own format.
+    CPPUNIT_ASSERT_LESS(size_t(9), aFormats.size());
+    const SwTableBox* pA1 = rTable.GetTableBox(u"A1"_ustr);
+    const SwTableBox* pB2 = rTable.GetTableBox(u"B2"_ustr);
+    CPPUNIT_ASSERT(pA1->GetFrameFormat() != pB2->GetFrameFormat());
+    OUString aPartner; // a cell that shares A1's format
+    for (const SwTableBox* pBox : rBoxes)
+        if (pBox != pA1 && pBox->GetFrameFormat() == pA1->GetFrameFormat())
+            aPartner = pBox->GetName();
+    CPPUNIT_ASSERT(!aPartner.isEmpty());
+
+    // Changing one cell gives it a format of its own again: the cell that shared it keeps its look.
+    uno::Reference<text::XTextTablesSupplier> xTextDocument(mxComponent, uno::UNO_QUERY);
+    uno::Reference<container::XIndexAccess> xTables(xTextDocument->getTextTables(), uno::UNO_QUERY);
+    uno::Reference<text::XTextTable> xTable(xTables->getByIndex(0), uno::UNO_QUERY);
+    uno::Reference<beans::XPropertySet> xA1(xTable->getCellByName(u"A1"_ustr), uno::UNO_QUERY);
+    uno::Reference<beans::XPropertySet> xB2(xTable->getCellByName(u"B2"_ustr), uno::UNO_QUERY);
+    uno::Reference<beans::XPropertySet> xPartner(xTable->getCellByName(aPartner), uno::UNO_QUERY);
+    CPPUNIT_ASSERT_EQUAL(Color(0xFFFF00), getProperty<Color>(xB2, u"BackColor"_ustr));
+    const Color aOld = getProperty<Color>(xA1, u"BackColor"_ustr);
+    CPPUNIT_ASSERT_EQUAL(aOld, getProperty<Color>(xPartner, u"BackColor"_ustr));
+    xA1->setPropertyValue(u"BackColor"_ustr, uno::Any(Color(0x00FF00)));
+    CPPUNIT_ASSERT_EQUAL(Color(0x00FF00), getProperty<Color>(xA1, u"BackColor"_ustr));
+    CPPUNIT_ASSERT_EQUAL(aOld, getProperty<Color>(xPartner, u"BackColor"_ustr));
+    table::BorderLine2 aBorder;
+    xPartner->getPropertyValue(u"TopBorder"_ustr) >>= aBorder;
+    CPPUNIT_ASSERT(aBorder.LineWidth > 0);
+}
