+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/* SPDX-License-Identifier: LicenseRef-HST-Proprietary */
+#pragma once
+
+#include <swdllapi.h>
+
+class SwXTextTable;
+
+/// HST: let the cells of one imported table that have exactly the same cell attributes (and the same
+/// parent format) use one cell format, as tables created in Writer do. An imported table gets a
+/// format of its own for every cell, about half a kilobyte each. Changing one cell later gives it its
+/// own format again (SwTableBox::ClaimFrameFormat). Returns the number of formats removed.
+SW_DLLPUBLIC sal_Int32 HstShareEqualTableBoxFormats(SwXTextTable& rTable);
+
+/* vim:set shiftwidth=4 softtabstop=4 expandtab: */
--- /dev/null
+++ b/sw/source/core/table/hsttableboxformats.cxx
@@ -0,0 +1,77 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/* SPDX-License-Identifier: LicenseRef-HST-Proprietary */
+
+#include <hsttableboxformats.hxx>
+
+#include <cellatr.hxx>
+#include <frmfmt.hxx>
+#include <hintids.hxx>
+#include <swtable.hxx>
+#include <swtblfmt.hxx>
+#include <unotbl.hxx>
+
+#include <vector>
+
+namespace
+{
+/// Distinct formats compared per table: a table whose cells are all formatted differently gains
+/// nothing, and the search stays linear in the number of cells.
+constexpr size_t HST_MAX_DISTINCT_BOX_FORMATS = 64;
+
+/// A cell with a number format, value or formula must keep a format of its own: the core finds the
+/// cell of such a format through the format (SwTableBoxFormat::GetTableBox, SwTableBox::CheckBoxFormat).
+bool HstHasOwnBoxContent(const SwTableBoxFormat& rFormat)
+{
+    const SwAttrSet& rSet = rFormat.GetAttrSet();
+    return rSet.GetItemState(RES_BOXATR_FORMAT, false) == SfxItemState::SET
+           || rSet.GetItemState(RES_BOXATR_FORMULA, false) == SfxItemState::SET
+           || rSet.GetItemState(RES_BOXATR_VALUE, false) == SfxItemState::SET;
+}
+
+bool HstSameBoxAttributes(const SwTableBoxFormat& rA, const SwTableBoxFormat& rB)
+{
+    return rA.DerivedFrom() == rB.DerivedFrom() && rA.GetAttrSet() == rB.GetAttrSet();
+}
+}
+
+sal_Int32 HstShareEqualTableBoxFormats(SwXTextTable& rXTable)
+{
+    SwTable* pTable = SwTable::FindTable(rXTable.GetFrameFormat());
+    if (!pTable)
+        return 0;
+    std::vector<SwTableBoxFormat*> aDistinct;
+    sal_Int32 nRemoved = 0;
+    // Copy: changing a box format does not change the sorted box list, but keep the loop independent.
+    const std::vector<SwTableBox*> aBoxes(pTable->GetTabSortBoxes().begin(),
+                                          pTable->GetTabSortBoxes().end());
+    for (SwTableBox* pBox : aBoxes)
+    {
+        SwTableBoxFormat* pFormat = pBox->GetFrameFormat();
+        if (!pFormat || HstHasOwnBoxContent(*pFormat))
+            continue;
+        SwTableBoxFormat* pShared = nullptr;
+        for (SwTableBoxFormat* pCandidate : aDistinct)
+        {
+            if (pCandidate == pFormat || HstSameBoxAttributes(*pCandidate, *pFormat))
+            {
+                pShared = pCandidate;
+                break;
+            }
+        }
+        if (!pShared)
+        {
+            if (aDistinct.size() < HST_MAX_DISTINCT_BOX_FORMATS)
+                aDistinct.push_back(pFormat);
+            continue;
+        }
+        if (pShared == pFormat)
+            continue;
+        const bool bLastUser = pFormat->HasOnlyOneListener();
+        pBox->ChgFrameFormat(pShared); // deletes pFormat when no other box uses it
+        if (bLastUser)
+            ++nRemoved;
+    }
+    return nRemoved;
+}
+
