             if (!Quietly([&] {
                     for (auto& [xProps, aOld] : m_aParagraphs)
-                        xProps->setPropertyValue(u"ParaStyleName"_ustr, css::uno::Any(rStyle));
+                        xProps->setPropertyValue(u"ParaStyleName"_ustr, css::uno::Any(aStyle));
                 }))
             {
                 End(); // protected text or an unknown style: put back what was changed
@@ -638,6 +644,23 @@
     }
 
 private:
+    /** The name of the paragraph style shown as rDisplayName, or empty. */
+    static OUString StyleName(const css::uno::Reference<css::frame::XModel>& xModel, const OUString& rDisplayName)
+    {
+        css::uno::Reference<css::style::XStyleFamiliesSupplier> xSupplier(xModel, css::uno::UNO_QUERY_THROW);
+        css::uno::Reference<css::container::XNameAccess> xStyles(
+            xSupplier->getStyleFamilies()->getByName(u"ParagraphStyles"_ustr), css::uno::UNO_QUERY_THROW);
+        const css::uno::Sequence<OUString> aNames = xStyles->getElementNames();
+        for (const OUString& rName : aNames)
+        {
+            css::uno::Reference<css::beans::XPropertySet> xStyle(xStyles->getByName(rName), css::uno::UNO_QUERY);
+            OUString aDisplay;
+            if (xStyle.is() && (xStyle->getPropertyValue(u"DisplayName"_ustr) >>= aDisplay) && aDisplay == rDisplayName)
+                return rName;
+        }
+        return xStyles->hasByName(rDisplayName) ? rDisplayName : OUString();
+    }
+
     /** Run rEdit outside the document's history: undo locked, change tracking off, modified frozen. */
