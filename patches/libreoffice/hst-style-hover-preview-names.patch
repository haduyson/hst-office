HST Office: the Styles gallery hover preview sets the paragraph style by its own name.

The gallery lists display names (for example "Văn bản nội dung"); the ParaStyleName property of a
paragraph takes the style's own name ("Text body") and refuses a display name, so the preview never
started. The display name is now looked up in the paragraph style family (DisplayName).

- svx/source/tbxctrls/StylesPreviewWindow.cxx: HstStylePreview::StyleName().

--- a/svx/source/tbxctrls/StylesPreviewWindow.cxx
+++ b/svx/source/tbxctrls/StylesPreviewWindow.cxx
@@ -50,7 +50,9 @@
 #include <com/sun/star/document/XDocumentEventListener.hpp>
 #include <com/sun/star/document/XUndoManagerSupplier.hpp>
 #include <com/sun/star/frame/XStorable.hpp>
+#include <com/sun/star/container/XNameAccess.hpp>
 #include <com/sun/star/lang/XServiceInfo.hpp>
+#include <com/sun/star/style/XStyleFamiliesSupplier.hpp>
 #include <com/sun/star/text/XTextRange.hpp>
 #include <com/sun/star/util/XModifiable2.hpp>
 #include <com/sun/star/view/XSelectionSupplier.hpp>
@@ -566,11 +568,15 @@
             }
             if (aParagraphs.empty())
                 return false;
+            // the gallery shows display names; the paragraph property takes the style's own name
