+
+/** Windows: show a tab window without the compositor showing it yet. A newly shown window is composed
+    at once, before vcl has painted it and Skia has presented the picture: for a frame or two the
+    screen shows the window blank (white) over the previous tab. A cloaked window (DWMWA_CLOAK) is
+    shown, painted and presented like any other, but not composed. ParkIdleHdl uncloaks it once its
+    picture is presented (DwmFlush: one composition), then hides the previous tab. */
+void lcl_cloak(vcl::Window* pWindow, bool bCloak)
+{
+#ifdef _WIN32
+    if (!pWindow || pWindow->isDisposed())
+        return;
+    const SystemEnvData* pData = pWindow->GetSystemData();
+    if (!pData || !pData->hWnd)
+        return;
+    using SetAttributeFn = HRESULT(WINAPI*)(HWND, DWORD, LPCVOID, DWORD);
+    static HMODULE hDwm = LoadLibraryW(L"dwmapi.dll");
+    static auto pSet = hDwm ? reinterpret_cast<SetAttributeFn>(GetProcAddress(hDwm, "DwmSetWindowAttribute")) : nullptr;
+    if (pSet)
+    {
+        BOOL bValue = bCloak;
+        pSet(pData->hWnd, 13 /* DWMWA_CLOAK */, &bValue, sizeof(bValue));
+    }
+#else
+    (void)pWindow;
+    (void)bCloak;
+#endif
+}
+
+/// Windows: wait until the compositor has composed the next frame (what was presented is on screen).
+void lcl_waitForComposition()
+{
+#ifdef _WIN32
+    using FlushFn = HRESULT(WINAPI*)();
+    static HMODULE hDwm = LoadLibraryW(L"dwmapi.dll");
+    static auto pFlush = hDwm ? reinterpret_cast<FlushFn>(GetProcAddress(hDwm, "DwmFlush")) : nullptr;
+    if (pFlush)
+        pFlush();
+#endif
 }
 
