+# HST Office: the ReadMe names the HST release (major.minor of include/hst_version.h, written
+# from /VERSION by scripts/write-hst-version.py), never the engine version.
+readlicense_oo_HST_VERSION_H := $(SRCDIR)/include/hst_version.h
+readlicense_oo_HST_VERSION := $(shell $(gb_AWK) '$$2 == "HST_VERSION_MAJOR" { a = $$3 } $$2 == "HST_VERSION_MINOR" { b = $$3 } END { if (a != "" && b != "") print a "." b }' $(readlicense_oo_HST_VERSION_H))
+
 readlicense_oo_README_SED := \
 	-e 's,$${PRODUCTNAME},$(PRODUCTNAME),g' \
-	-e 's,$${PRODUCTVERSION},$(LIBO_VERSION_MAJOR).$(LIBO_VERSION_MINOR),g' \
+	-e 's,$${PRODUCTVERSION},$(readlicense_oo_HST_VERSION),g' \
 	-e 's,$${LCPRODUCTNAME},'"$$(printf %s '$(PRODUCTNAME)' | tr A-Z a-z)",g \
 
 $(readlicense_oo_DIR)/$(call gb_README,%) : \
 		$(SRCDIR)/readlicense_oo/docs/readme.xsl \
+		$(readlicense_oo_HST_VERSION_H) \
 		$(readlicense_oo_README_XRM) \
 		| $(readlicense_oo_DIR)/.dir \
 		  $(call gb_ExternalExecutable_get_dependencies,xsltproc)
 	$(call gb_Output_announce,$(subst $(WORKDIR)/,,$@),$(true),XSL,1)
 	$(call gb_Trace_StartRange,$(subst $(WORKDIR)/,,$@),XSL)
+	$(if $(readlicense_oo_HST_VERSION),,$(error readlicense_oo: no HST_VERSION_MAJOR/MINOR in $(readlicense_oo_HST_VERSION_H) (run scripts/write-hst-version.py)))
 	$(call gb_Helper_abbreviate_dirs, \
