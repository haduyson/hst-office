+/// UNO side of the group: document events, frame closing, termination, option changes.
+class DocumentTabGroupListener final
+    : public cppu::WeakImplHelper<document::XDocumentEventListener, util::XCloseListener,
+                                  frame::XTerminateListener>,
+      public comphelper::ConfigurationListenerPropertyBase
+{
+public:
+    DocumentTabGroupListener()
+    {
+        maName = u"DocumentTabs"_ustr;
+        mxListener = new comphelper::ConfigurationListener(
+            u"/org.openoffice.Office.Common/Misc"_ustr);
+        mxListener->addListener(this); // reports the current value at once: ignored
+        m_bReady = true;
+    }
+
+    void stop()
+    {
+        if (mxListener.is())
+        {
+            mxListener->removeListener(this);
+            mxListener->dispose();
+            mxListener.clear();
+        }
+    }
+
+    // ConfigurationListenerPropertyBase
+    virtual void setProperty(const uno::Any& rValue) override
+    {
+        if (!m_bReady)
+            return;
+        bool bValue = true;
+        rValue >>= bValue;
+        SolarMutexGuard aGuard;
+        DocumentTabGroup::get().optionChanged(bValue);
+    }
+
+    // XDocumentEventListener: modified state, title, load/save: repaint the strips
+    virtual void SAL_CALL documentEventOccured(const document::DocumentEvent&) override
+    {
+        SolarMutexGuard aGuard;
+        DocumentTabGroup::get().documentEvent();
+    }
+
+    // XCloseListener
+    virtual void SAL_CALL queryClosing(const lang::EventObject&, sal_Bool) override {}
+    virtual void SAL_CALL notifyClosing(const lang::EventObject& rEvent) override
+    {
+        SolarMutexGuard aGuard;
+        DocumentTabGroup::get().frameClosing(
+            uno::Reference<frame::XFrame>(rEvent.Source, uno::UNO_QUERY));
+    }
+
+    // XTerminateListener
+    virtual void SAL_CALL queryTermination(const lang::EventObject&) override {}
+    virtual void SAL_CALL notifyTermination(const lang::EventObject&) override
+    {
+        SolarMutexGuard aGuard;
+        DocumentTabGroup::get().shutdown();
+    }
+
+    // XEventListener
+    virtual void SAL_CALL disposing(const lang::EventObject& rEvent) override
+    {
+        SolarMutexGuard aGuard;
+        uno::Reference<frame::XFrame> xFrame(rEvent.Source, uno::UNO_QUERY);
+        if (xFrame.is())
+            DocumentTabGroup::get().frameClosing(xFrame);
+    }
+
+private:
+    bool m_bReady = false;
+};
+
+namespace
+{
+uno::Reference<frame::XFrame> lcl_get(const uno::WeakReference<frame::XFrame>& rWeak)
+{
+    return uno::Reference<frame::XFrame>(rWeak);
+}
+
+// Frames can be disposed at any time (closing documents): every UNO call on a member
+// is guarded, nothing may escape into the VCL event loop.
+uno::Reference<frame::XModel> lcl_model(const uno::Reference<frame::XFrame>& xFrame)
+{
+    try
+    {
+        uno::Reference<frame::XController> xController = xFrame.is() ? xFrame->getController() : nullptr;
+        if (xController.is())
+            return xController->getModel();
+    }
+    catch (const uno::Exception&)
+    {
+    }
+    return {};
+}
+
+bool lcl_isModified(const uno::Reference<frame::XFrame>& xFrame)
+{
+    try
+    {
+        uno::Reference<util::XModifiable> xModifiable(lcl_model(xFrame), uno::UNO_QUERY);
+        return xModifiable.is() && xModifiable->isModified();
+    }
+    catch (const uno::Exception&)
+    {
+        return false;
+    }
+}
+
+/// Writer blue, Calc green, Impress orange, Draw purple, other grey.
+Color lcl_moduleColor(const uno::Reference<frame::XFrame>& xFrame)
+{
+    try
+    {
+        uno::Reference<frame::XModuleManager2> xManager
+            = frame::ModuleManager::create(comphelper::getProcessComponentContext());
+        const OUString aModule = xManager->identify(xFrame);
+        if (aModule.startsWith("com.sun.star.text.") || aModule.startsWith("com.sun.star.sdb.")
+            || aModule == "com.sun.star.xforms.XMLFormDocument")
+            return Color(0x2B, 0x57, 0x9A);
+        if (aModule == "com.sun.star.sheet.SpreadsheetDocument")
+            return Color(0x21, 0x73, 0x46);
+        if (aModule == "com.sun.star.presentation.PresentationDocument")
+            return Color(0xC4, 0x3E, 0x1C);
+        if (aModule == "com.sun.star.drawing.DrawingDocument")
+            return Color(0x7B, 0x3F, 0x9E);
+    }
+    catch (const uno::Exception&)
+    {
+    }
+    return Color(0x80, 0x80, 0x80);
+}
+
+OUString lcl_title(const uno::Reference<frame::XFrame>& xFrame)
+{
+    OUString aTitle;
+    try
+    {
+        uno::Reference<frame::XTitle> xTitle(xFrame->getController(), uno::UNO_QUERY);
+        if (xTitle.is() && lcl_model(xFrame).is())
+            aTitle = xTitle->getTitle();
+    }
+    catch (const uno::Exception&)
+    {
+    }
+    if (aTitle.isEmpty() && !lcl_model(xFrame).is())
+        aTitle = FwkResId(STR_DOCTAB_START);
+    return aTitle;
+}
+
+void lcl_relayout(const uno::Reference<frame::XFrame>& xFrame)
+{
+    try
+    {
+        uno::Reference<frame::XFrame2> xFrame2(xFrame, uno::UNO_QUERY);
+        if (!xFrame2.is())
+            return;
+        uno::Reference<frame::XLayoutManager> xLM(xFrame2->getLayoutManager(), uno::UNO_QUERY);
+        if (xLM.is())
+            xLM->doLayout();
+    }
+    catch (const uno::Exception&)
+    {
+    }
+}
+
+void lcl_dispatch(const uno::Reference<frame::XFrame>& xFrame, const OUString& rURL,
+                  const OUString& rTarget)
+{
+    uno::Reference<frame::XDispatchProvider> xProvider(xFrame, uno::UNO_QUERY);
+    if (!xProvider.is())
+        return;
+    util::URL aURL;
+    aURL.Complete = rURL;
+    uno::Reference<util::XURLTransformer> xParser(
+        util::URLTransformer::create(comphelper::getProcessComponentContext()));
+    xParser->parseStrict(aURL);
+    uno::Reference<frame::XDispatch> xDispatch = xProvider->queryDispatch(aURL, rTarget, 0);
+    if (xDispatch.is())
+        xDispatch->dispatch(aURL, {});
+}
+}
+
+DocumentTabGroup& DocumentTabGroup::get()
+{
+    // Intentionally leaked: it must outlive every frame and VCL, and is shut down by
+    // notifyTermination; destroying it at exit time would touch dead UNO objects.
+    static DocumentTabGroup* s_pGroup = new DocumentTabGroup;
+    return *s_pGroup;
+}
+
+DocumentTabGroup::DocumentTabGroup()
+{
+    if (Application::IsHeadlessModeEnabled() || comphelper::LibreOfficeKit::isActive())
+        return;
+    try
+    {
+        m_bEnabled = officecfg::Office::Common::Misc::DocumentTabs::get();
+        m_xListener = new DocumentTabGroupListener;
+        uno::Reference<uno::XComponentContext> xContext = comphelper::getProcessComponentContext();
+        uno::Reference<document::XDocumentEventBroadcaster> xEvents(
+            frame::theGlobalEventBroadcaster::get(xContext), uno::UNO_QUERY_THROW);
+        xEvents->addDocumentEventListener(m_xListener);
+        frame::Desktop::create(xContext)->addTerminateListener(m_xListener);
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("fwk", "DocumentTabGroup: listeners not registered");
+    }
+    Application::AddEventListener(LINK(this, DocumentTabGroup, WindowEventHdl));
+}
+
+bool DocumentTabGroup::isEnabled()
+{
+    if (Application::IsHeadlessModeEnabled() || comphelper::LibreOfficeKit::isActive())
+        return false;
+    return get().m_bEnabled;
+}
+
+bool DocumentTabGroup::isCandidate(const uno::Reference<frame::XFrame>& xFrame) const
+{
+    if (!xFrame.is() || !isEnabled())
+        return false;
+    try
+    {
+        // Only task frames of the desktop (not sub-frames, previews, in-place frames) with a
+        // top-level WorkWindow (not frames embedded in foreign windows); never the Help task.
+        uno::Reference<frame::XDesktop> xDesktop(xFrame->getCreator(), uno::UNO_QUERY);
+        if (!xDesktop.is() || xFrame->getName() == "OFFICE_HELP_TASK")
+            return false;
+        VclPtr<vcl::Window> pWindow = VCLUnoHelper::GetWindow(xFrame->getContainerWindow());
+        if (!pWindow || pWindow->isDisposed() || pWindow->GetType() != WindowType::WORKWINDOW
+            || !pWindow->IsSystemWindow())
+            return false;
+        // Never the full-screen slide show (its own frame in a presentation-mode window).
+        auto* pWorkWindow = static_cast<WorkWindow*>(pWindow.get());
+        return !pWorkWindow->IsPresentationMode() && !pWorkWindow->IsFullScreenMode();
+    }
+    catch (const uno::Exception&)
+    {
+        return false;
+    }
+}
+
+uno::Reference<frame::XFrame> DocumentTabGroup::findTaskFrame(const vcl::Window* pWindow) const
+{
+    try
+    {
+        uno::Reference<frame::XFramesSupplier> xDesktop
+            = frame::Desktop::create(comphelper::getProcessComponentContext());
+        uno::Reference<container::XIndexAccess> xFrames(xDesktop->getFrames(),
+                                                        uno::UNO_QUERY_THROW);
+        for (sal_Int32 i = 0; i < xFrames->getCount(); ++i)
+        {
+            uno::Reference<frame::XFrame> xFrame(xFrames->getByIndex(i), uno::UNO_QUERY);
+            if (xFrame.is() && VCLUnoHelper::GetWindow(xFrame->getContainerWindow()) == pWindow)
+                return xFrame;
+        }
+    }
+    catch (const uno::Exception&)
+    {
+    }
+    return {};
+}
+
+DocumentTabGroup::Member* DocumentTabGroup::find(const uno::Reference<frame::XFrame>& xFrame)
+{
+    for (Member& rMember : m_aMembers)
+        if (xFrame.is() && lcl_get(rMember.xFrame) == xFrame)
+            return &rMember;
+    return nullptr;
+}
+
+const DocumentTabGroup::Member*
+DocumentTabGroup::find(const uno::Reference<frame::XFrame>& xFrame) const
+{
+    return const_cast<DocumentTabGroup*>(this)->find(xFrame);
+}
+
+DocumentTabGroup::Member* DocumentTabGroup::findByWindow(const vcl::Window* pWindow)
+{
+    for (Member& rMember : m_aMembers)
+        if (rMember.pWindow.get() == pWindow)
+            return &rMember;
+    return nullptr;
+}
+
+DocumentTabGroup::Member* DocumentTabGroup::activeMember() { return find(lcl_get(m_xActive)); }
+
+bool DocumentTabGroup::isParked(const uno::Reference<frame::XFrame>& xFrame) const
+{
+    const Member* pMember = find(xFrame);
+    return pMember && pMember->bParked;
+}
+
+DocumentTabGroup::Member& DocumentTabGroup::join(const uno::Reference<frame::XFrame>& xFrame)
+{
+    if (Member* pMember = find(xFrame))
+        return *pMember;
+    cleanUp();
+    Member aMember;
+    aMember.xFrame = xFrame;
+    aMember.pWindow = VCLUnoHelper::GetWindow(xFrame->getContainerWindow());
+    // New tabs open to the right of the active one, like a browser.
+    auto it = m_aMembers.end();
+    if (Member* pActive = activeMember())
+        it = m_aMembers.begin() + (pActive - m_aMembers.data()) + 1;
+    it = m_aMembers.insert(it, aMember);
+    uno::Reference<util::XCloseBroadcaster> xClose(xFrame, uno::UNO_QUERY);
+    if (xClose.is() && m_xListener.is())
+        xClose->addCloseListener(m_xListener);
+    return *it;
+}
+
+void DocumentTabGroup::cleanUp()
+{
+    std::erase_if(m_aMembers, [](Member& rMember) {
+        if (lcl_get(rMember.xFrame).is() && rMember.pWindow && !rMember.pWindow->isDisposed())
+            return false;
+        rMember.pBar.disposeAndClear();
+        return true;
+    });
+}
+
+void DocumentTabGroup::copyGeometry(vcl::Window* pFrom, vcl::Window* pTo)
+{
+    if (!pFrom || !pTo || pFrom == pTo || !pFrom->IsSystemWindow() || !pTo->IsSystemWindow())
+        return;
+    auto* pSource = static_cast<WorkWindow*>(pFrom);
+    // A minimized group keeps its restored size; never minimize the incoming window.
+    const vcl::WindowDataMask nMask
+        = pSource->IsMinimized() ? vcl::WindowDataMask::PosSize : vcl::WindowDataMask::All;
+    const OUString aState = pSource->GetWindowState(nMask);
+    if (!aState.isEmpty())
+        static_cast<SystemWindow*>(pTo)->SetWindowState(aState);
+}
+
+void DocumentTabGroup::park(Member& rMember)
+{
+    if (!rMember.pWindow || rMember.pWindow->isDisposed())
+        return;
+    rMember.bParked = true; // before hiding: XFrameImpl::windowHidden asks isParked()
+    ++m_nInternal;
+    rMember.pWindow->Show(false);
+    --m_nInternal;
+}
+
+void DocumentTabGroup::focus(const uno::Reference<frame::XFrame>& xFrame)
+{
+    // Without a window manager (and on some backends) showing a window does not move the
+    // focus; activate the frame explicitly so ribbon, sidebar and dispatchers follow.
+    try
+    {
+        xFrame->activate();
+        if (VclPtr<vcl::Window> pComponent = VCLUnoHelper::GetWindow(xFrame->getComponentWindow()))
+            pComponent->GrabFocus();
+    }
+    catch (const uno::Exception&)
+    {
+    }
+}
+
+void DocumentTabGroup::prepareShow(const uno::Reference<frame::XFrame>& xFrame)
+{
+    try
+    {
+        if (!isCandidate(xFrame))
+            return;
+        Member& rMember = join(xFrame);
+        Member* pPrevious = activeMember(); // after join(): it may move members
+        if (!pPrevious || pPrevious == &rMember || !rMember.pWindow || rMember.pWindow->IsVisible())
+            return;
+        if (pPrevious->pWindow && pPrevious->pWindow->IsVisible())
+        {
+            copyGeometry(pPrevious->pWindow, rMember.pWindow);
+            m_xPrepared = xFrame;
+        }
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("fwk", "DocumentTabGroup: prepare show");
+    }
+}
+
+IMPL_LINK(DocumentTabGroup, WindowEventHdl, VclSimpleEvent&, rEvent, void)
+{
+    try
+    {
+        const VclEventId nId = rEvent.GetId();
+        if (nId != VclEventId::WindowShow && nId != VclEventId::WindowHide)
+            return;
+        vcl::Window* pWindow = static_cast<VclWindowEvent&>(rEvent).GetWindow();
+        if (m_nInternal || !pWindow || pWindow->GetType() != WindowType::WORKWINDOW)
+            return;
+    
+        if (nId == VclEventId::WindowHide)
+        {
+            // Hidden by someone else (macro, frame being closed, autorecovery): leave the group,
+            // and if that was the shown tab show a neighbour so the documents stay reachable.
+            if (Member* pMember = findByWindow(pWindow))
+                if (!pMember->bParked)
+                    removeMember(lcl_get(pMember->xFrame), true);
+            return;
+        }
+    
+        if (!isEnabled())
+            return;
+        uno::Reference<frame::XFrame> xFrame = findTaskFrame(pWindow);
+        if (!isCandidate(xFrame))
+            return;
+        const bool bPrepared = lcl_get(m_xPrepared) == xFrame;
+        m_xPrepared.clear();
+        Member* pPrevious = activeMember();
+        if (pPrevious && lcl_get(pPrevious->xFrame) == xFrame && !pPrevious->bParked)
+            return;
+        uno::Reference<frame::XFrame> xPrevious;
+        VclPtr<vcl::Window> pPreviousWindow;
+        if (pPrevious)
+        {
+            xPrevious = lcl_get(pPrevious->xFrame);
+            pPreviousWindow = pPrevious->pWindow;
+        }
+    
+        Member& rMember = join(xFrame);
+        rMember.bParked = false;
+        m_xActive = xFrame;
+        if (xPrevious.is() && xPrevious != xFrame && pPreviousWindow && pPreviousWindow->IsVisible())
+        {
+            // Shown without prepareShow(): take over the group geometry now.
+            if (!bPrepared)
+                copyGeometry(pPreviousWindow, pWindow);
+            // Park the previous tab once the new window is up (never leave zero windows).
+            m_xToPark = xPrevious;
+            Application::PostUserEvent(LINK(this, DocumentTabGroup, ParkPreviousHdl));
+        }
+        update();
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("fwk", "DocumentTabGroup: window event");
+    }
+}
+
+IMPL_LINK_NOARG(DocumentTabGroup, ParkPreviousHdl, void*, void)
+{
+    try
+    {
+        uno::Reference<frame::XFrame> xToPark = lcl_get(m_xToPark);
+        m_xToPark.clear();
+        Member* pMember = find(xToPark);
+        if (pMember && xToPark != lcl_get(m_xActive) && !pMember->bParked)
+        {
+            park(*pMember);
+            focus(lcl_get(m_xActive));
+            update();
+        }
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("fwk", "DocumentTabGroup: park");
+    }
+}
+
+void DocumentTabGroup::activate(const uno::Reference<frame::XFrame>& xFrame)
+{
+    try
+    {
+        Member* pTarget = find(xFrame);
+        if (!pTarget || !pTarget->pWindow || pTarget->pWindow->isDisposed())
+            return;
+        Member* pPrevious = activeMember();
+        if (pPrevious == pTarget && pTarget->pWindow->IsVisible())
+        {
+            focus(xFrame);
+            return;
+        }
+        const uno::Reference<frame::XFrame> xPrevious
+            = pPrevious ? lcl_get(pPrevious->xFrame) : uno::Reference<frame::XFrame>();
+        if (pPrevious && pPrevious->pWindow && pPrevious->pWindow->IsVisible())
+            copyGeometry(pPrevious->pWindow, pTarget->pWindow);
+        pTarget->bParked = false;
+        VclPtr<vcl::Window> pTargetWindow = pTarget->pWindow;
+        ++m_nInternal;
+        pTargetWindow->Show(true, ShowFlags::ForegroundTask);
+        --m_nInternal;
+        m_xActive = xFrame;
+        // find() again: Show() can run events that change the member list
+        if (Member* pOld = find(xPrevious); pOld && xPrevious != xFrame)
+            park(*pOld);
+        focus(xFrame);
+        update();
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("fwk", "DocumentTabGroup: activate");
+    }
+}
+
+void DocumentTabGroup::activateRelative(sal_Int32 nDelta)
+{
+    cleanUp();
+    Member* pActive = activeMember();
+    if (!pActive || m_aMembers.size() < 2)
+        return;
+    const sal_Int32 nCount = m_aMembers.size();
+    const sal_Int32 nIndex = pActive - m_aMembers.data();
+    const sal_Int32 nNew = ((nIndex + nDelta) % nCount + nCount) % nCount;
+    activate(lcl_get(m_aMembers[nNew].xFrame));
+}
+
+void DocumentTabGroup::closeTab(const uno::Reference<frame::XFrame>& xFrame)
+{
+    try
+    {
+        Member* pMember = find(xFrame);
+        if (!pMember)
+            return;
+        // The save query is parented to the frame's window: show it first when it has one.
+        if (pMember->bParked && lcl_isModified(xFrame))
+            activate(xFrame);
+        // .uno:CloseWin closes this view only (not other views of the document), asks to save
+        // when it is the last view, and turns the last tab into the Start Center.
+        lcl_dispatch(xFrame, u".uno:CloseWin"_ustr, u"_self"_ustr);
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("fwk", "DocumentTabGroup: close tab");
+    }
+}
+
+bool DocumentTabGroup::requestCloseWindow(const uno::Reference<frame::XFrame>& xFrame)
+{
+    cleanUp();
+    if (!isEnabled() || !find(xFrame) || m_aMembers.size() < 2)
+        return false;
+    if (!lcl_get(m_xCloseWindowFrom).is())
+    {
+        m_xCloseWindowFrom = xFrame;
+        Application::PostUserEvent(LINK(this, DocumentTabGroup, CloseWindowHdl));
+    }
+    return true;
+}
+
+IMPL_LINK_NOARG(DocumentTabGroup, CloseWindowHdl, void*, void)
+{
+    uno::Reference<frame::XFrame> xClicked = lcl_get(m_xCloseWindowFrom);
+    m_xCloseWindowFrom.clear();
+    if (!xClicked.is())
+        return;
+    // The other tabs first, each shown before its save query; Cancel ends the whole action.
+    std::vector<uno::Reference<frame::XFrame>> aOthers;
+    for (const Member& rMember : m_aMembers)
+        if (uno::Reference<frame::XFrame> xFrame = lcl_get(rMember.xFrame); xFrame.is() && xFrame != xClicked)
+            aOthers.push_back(xFrame);
+    for (const uno::Reference<frame::XFrame>& xFrame : aOthers)
+    {
+        if (!find(xFrame))
+            continue;
+        try
+        {
+            if (lcl_isModified(xFrame))
+                activate(xFrame);
+            uno::Reference<frame::XController> xController = xFrame->getController();
+            if (xController.is() && !xController->suspend(true))
+                return; // Cancel: this tab stays shown, the remaining tabs stay open
+            uno::Reference<util::XCloseable> xCloseable(xFrame, uno::UNO_QUERY);
+            if (xCloseable.is())
+            {
+                try
+                {
+                    xCloseable->close(true);
+                }
+                catch (const util::CloseVetoException&)
+                {
+                    if (xController.is())
+                        xController->suspend(false);
+                    return;
+                }
+            }
+        }
+        catch (const uno::Exception&)
+        {
+            TOOLS_WARN_EXCEPTION("fwk", "DocumentTabGroup: closing a tab failed");
+            return;
+        }
+    }
+    // Finally the tab whose window was closed: the upstream title-bar close of a window.
+    if (find(xClicked))
+    {
+        activate(xClicked);
+        lcl_dispatch(xClicked, u".uno:CloseFrame"_ustr, u"_self"_ustr);
+    }
+}
+
+void DocumentTabGroup::newTab(const OUString& rURL)
+{
+    m_aPendingURLs.push_back(rURL);
+    Application::PostUserEvent(LINK(this, DocumentTabGroup, DispatchHdl));
+}
+
+IMPL_LINK_NOARG(DocumentTabGroup, DispatchHdl, void*, void)
+{
+    try
+    {
+        std::vector<OUString> aURLs;
+        aURLs.swap(m_aPendingURLs);
+        uno::Reference<frame::XFrame> xActive = lcl_get(m_xActive);
+        if (!xActive.is())
+            return;
+        for (const OUString& rURL : aURLs)
+            lcl_dispatch(xActive, rURL, rURL.startsWith(".uno:") ? u"_self"_ustr : u"_blank"_ustr);
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("fwk", "DocumentTabGroup: dispatch");
+    }
+}
+
+void DocumentTabGroup::removeMember(const uno::Reference<frame::XFrame>& xFrame,
+                                    bool bShowNeighbour)
+{
+    try
+    {
+        Member* pMember = find(xFrame);
+        if (!pMember)
+            return;
+        const bool bWasActive = lcl_get(m_xActive) == xFrame;
+        VclPtr<vcl::Window> pGeometry = pMember->pWindow;
+        size_t nIndex = pMember - m_aMembers.data();
+        pMember->pBar.disposeAndClear();
+        uno::Reference<util::XCloseBroadcaster> xClose(xFrame, uno::UNO_QUERY);
+        if (xClose.is() && m_xListener.is())
+            xClose->removeCloseListener(m_xListener);
+        m_aMembers.erase(m_aMembers.begin() + nIndex);
+        cleanUp();
+        if (bWasActive)
+            m_xActive.clear();
+    
+        if (bWasActive && bShowNeighbour && !m_bClosingAll && !m_aMembers.empty())
+        {
+            Member& rNext = m_aMembers[std::min(nIndex, m_aMembers.size() - 1)];
+            if (pGeometry && !pGeometry->isDisposed() && pGeometry->IsVisible())
+                copyGeometry(pGeometry, rNext.pWindow);
+            uno::Reference<frame::XFrame> xNext = lcl_get(rNext.xFrame);
+            rNext.bParked = false;
+            ++m_nInternal;
+            rNext.pWindow->Show(true, ShowFlags::ForegroundTask);
+            --m_nInternal;
+            m_xActive = xNext;
+            focus(xNext);
+        }
+        else if (bWasActive && !m_aMembers.empty() && !m_bClosingAll)
+            m_xActive = m_aMembers.front().xFrame;
+        update();
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("fwk", "DocumentTabGroup: remove");
+    }
+}
+
+void DocumentTabGroup::frameClosing(const uno::Reference<frame::XFrame>& xFrame)
+{
+    removeMember(xFrame, true);
+}
+
+void DocumentTabGroup::setClosingAll(bool bClosingAll)
+{
+    m_bClosingAll = bClosingAll;
+    if (bClosingAll)
+        return;
+    // Termination was cancelled: make sure one tab is shown.
+    cleanUp();
+    if (m_aMembers.empty())
+        return;
+    Member* pActive = activeMember();
+    if (pActive && pActive->pWindow->IsVisible())
+        return;
+    for (const Member& rMember : m_aMembers)
+        if (rMember.pWindow->IsVisible())
+        {
+            m_xActive = rMember.xFrame;
+            update();
+            return;
+        }
+    activate(lcl_get((pActive ? *pActive : m_aMembers.back()).xFrame));
+}
+
+void DocumentTabGroup::documentEvent()
+{
+    for (const Member& rMember : m_aMembers)
+        if (rMember.pBar && !rMember.pBar->isDisposed())
+            rMember.pBar->Invalidate();
+}
+
+void DocumentTabGroup::optionChanged(bool bEnabled)
+{
+    if (m_bEnabled == bEnabled)
+        return;
+    m_bEnabled = bEnabled;
+    if (!bEnabled)
+        dissolve();
+}
+
+void DocumentTabGroup::dissolve()
+{
+    // Option switched off: every tab becomes a window again (cascaded from the shown one).
+    cleanUp();
+    Member* pActive = activeMember();
+    VclPtr<vcl::Window> pAnchor = pActive ? pActive->pWindow : nullptr;
+    std::vector<uno::Reference<frame::XFrame>> aFrames;
+    tools::Long nOffset = 0;
+    for (Member& rMember : m_aMembers)
+    {
+        aFrames.push_back(lcl_get(rMember.xFrame));
+        rMember.pBar.disposeAndClear();
+        uno::Reference<util::XCloseBroadcaster> xClose(aFrames.back(), uno::UNO_QUERY);
+        if (xClose.is() && m_xListener.is())
+            xClose->removeCloseListener(m_xListener);
+        if (!rMember.bParked)
+            continue;
+        rMember.bParked = false;
+        if (pAnchor)
+        {
+            nOffset += 30;
+            Point aPos = pAnchor->GetPosPixel();
+            rMember.pWindow->SetPosSizePixel(aPos + Point(nOffset, nOffset),
+                                             pAnchor->GetSizePixel());
+        }
+        ++m_nInternal;
+        rMember.pWindow->Show(true, ShowFlags::NoActivate);
+        --m_nInternal;
+    }
+    m_aMembers.clear();
+    m_xActive.clear();
+    for (const uno::Reference<frame::XFrame>& xFrame : aFrames)
+        if (xFrame.is())
+            lcl_relayout(xFrame);
+}
+
+bool DocumentTabGroup::showsTabBar(const Member& rMember) const
+{
+    if (!isEnabled() || !rMember.pWindow || rMember.pWindow->isDisposed())
+        return false;
+    if (static_cast<WorkWindow*>(rMember.pWindow.get())->IsFullScreenMode())
+        return false;
+    // A lone Start Center needs no strip; a lone document shows its tab and "+".
+    return m_aMembers.size() > 1 || lcl_model(lcl_get(rMember.xFrame)).is();
+}
+
+sal_Int32 DocumentTabGroup::tabBarHeight(const uno::Reference<frame::XFrame>& xFrame,
+                                         bool bLayoutVisible)
+{
+    Member* pMember = find(xFrame);
+    if (!pMember)
+        return 0;
+    if (!bLayoutVisible || !showsTabBar(*pMember))
+    {
+        if (pMember->pBar)
+            pMember->pBar->Hide();
+        return 0;
+    }
+    if (!pMember->pBar)
+        pMember->pBar = VclPtr<DocumentTabBar>::Create(pMember->pWindow, xFrame);
+    return pMember->pBar->GetOptimalHeight();
+}
+
+void DocumentTabGroup::placeTabBar(const uno::Reference<frame::XFrame>& xFrame,
+                                   const tools::Rectangle& rRect)
+{
+    Member* pMember = find(xFrame);
+    if (!pMember || !pMember->pBar)
+        return;
+    pMember->pBar->SetPosSizePixel(rRect.TopLeft(), rRect.GetSize());
+    pMember->pBar->Show();
+    pMember->pBar->Invalidate();
+}
+
+std::vector<DocumentTabInfo> DocumentTabGroup::getTabs() const
+{
+    try
+    {
+        std::vector<DocumentTabInfo> aTabs;
+        const uno::Reference<frame::XFrame> xActive = lcl_get(m_xActive);
+        for (const Member& rMember : m_aMembers)
+        {
+            uno::Reference<frame::XFrame> xFrame = lcl_get(rMember.xFrame);
+            if (!xFrame.is())
+                continue;
+            DocumentTabInfo aInfo;
+            aInfo.xFrame = xFrame;
+            aInfo.aTitle = lcl_title(xFrame);
+            aInfo.bModified = lcl_isModified(xFrame);
+            aInfo.bActive = xFrame == xActive;
+            aInfo.aModuleColor = lcl_moduleColor(xFrame);
+            aTabs.push_back(aInfo);
+        }
+        return aTabs;
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("fwk", "DocumentTabGroup: tabs");
+    }
+    return {};
+}
+
+void DocumentTabGroup::update()
+{
+    // Strip visibility can change with the member count: relayout every member.
+    std::vector<uno::Reference<frame::XFrame>> aFrames;
+    for (const Member& rMember : m_aMembers)
+        aFrames.push_back(lcl_get(rMember.xFrame));
+    for (const uno::Reference<frame::XFrame>& xFrame : aFrames)
+    {
+        if (!xFrame.is())
+            continue;
+        lcl_relayout(xFrame);
+    }
+    documentEvent();
+}
+
+void DocumentTabGroup::shutdown()
+{
+    for (Member& rMember : m_aMembers)
+        rMember.pBar.disposeAndClear();
+    m_aMembers.clear();
+    m_xActive.clear();
+    m_bEnabled = false;
+    Application::RemoveEventListener(LINK(this, DocumentTabGroup, WindowEventHdl));
+    if (m_xListener.is())
+    {
+        m_xListener->stop();
+        try
+        {
+            uno::Reference<document::XDocumentEventBroadcaster> xEvents(
+                frame::theGlobalEventBroadcaster::get(comphelper::getProcessComponentContext()),
+                uno::UNO_QUERY);
+            if (xEvents.is())
+                xEvents->removeDocumentEventListener(m_xListener);
+        }
+        catch (const uno::Exception&)
+        {
+        }
+        m_xListener.clear();
+    }
+}
+
+namespace
+{
+/// Keyboard/menu commands: switch to the next or previous tab.
+class DocumentTabCommandDispatch final : public cppu::WeakImplHelper<frame::XDispatch>
+{
+public:
+    virtual void SAL_CALL dispatch(const util::URL& rURL,
+                                   const uno::Sequence<beans::PropertyValue>&) override
+    {
+        SolarMutexGuard aGuard;
+        if (!DocumentTabGroup::isEnabled())
+            return;
+        DocumentTabGroup::get().activateRelative(rURL.Complete == ".uno:PrevDocumentTab" ? -1 : 1);
+    }
+    virtual void SAL_CALL addStatusListener(const uno::Reference<frame::XStatusListener>& xListener,
+                                            const util::URL& rURL) override
+    {
+        if (!xListener.is())
+            return;
+        frame::FeatureStateEvent aEvent;
+        aEvent.FeatureURL = rURL;
+        aEvent.IsEnabled = true;
+        aEvent.Source = getXWeak();
+        xListener->statusChanged(aEvent);
+    }
+    virtual void SAL_CALL removeStatusListener(const uno::Reference<frame::XStatusListener>&,
+                                               const util::URL&) override
+    {
+    }
+};
+}
+
+bool DocumentTabGroup::isTabCommand(std::u16string_view rCommand)
+{
+    return rCommand == u".uno:NextDocumentTab" || rCommand == u".uno:PrevDocumentTab";
+}
+
+uno::Reference<frame::XDispatch> DocumentTabGroup::createCommandDispatch()
+{
+    return new DocumentTabCommandDispatch;
+}
+
+void DocumentTabs::prepareShow(const uno::Reference<frame::XFrame>& xFrame)
+{
+    SolarMutexGuard aGuard;
+    if (DocumentTabGroup::isEnabled())
+        DocumentTabGroup::get().prepareShow(xFrame);
+}
