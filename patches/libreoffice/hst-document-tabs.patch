+/// What the tab strip shows for one member of the group.
+struct DocumentTabInfo
+{
+    css::uno::Reference<css::frame::XFrame> xFrame;
+    OUString aTitle;
+    bool bModified = false;
+    bool bActive = false;
+    Color aModuleColor;
