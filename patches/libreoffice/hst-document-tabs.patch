+/** HST Office: browser-like document tabs on top of ordinary task frames.
+
+    Every document keeps its own task frame and top-level WorkWindow (menubar, ribbon,
+    sidebar, status bar and window title stay per document, exactly as upstream). The
+    members of the (single, per-process) group share one position/size/maximized state;
+    only the active member is shown, the others are "parked" (hidden). A DocumentTabBar,
+    placed by the LayoutManager between the top docking area and the document, lists the
+    members and switches between them.
+
+    Membership is decided when a task frame's window is shown: by prepareShow() from the
+    code paths that know they are about to show a frame (LoadEnv, SfxFrame::Appear,
+    autorecovery), otherwise by a global VCL WindowShow listener (macros, Window menu, ...).
+
+    Parked frames keep IsHidden=false (see XFrameImpl::windowHidden), so CloseDispatcher,
+    the Start Center logic and the Window menu treat them as open, visible documents:
+    closing the active tab closes only that frame and the group shows a neighbour.
+
+    All methods require the SolarMutex.
+*/
+class DocumentTabGroup
+{
+public:
+    static DocumentTabGroup& get();
+    /// Option Office.Common/Misc/DocumentTabs, and never under headless or LibreOfficeKit.
+    static bool isEnabled();
+
+    void prepareShow(const css::uno::Reference<css::frame::XFrame>& xFrame);
+    bool isParked(const css::uno::Reference<css::frame::XFrame>& xFrame) const;
+
+    /// LayoutManager: height to reserve for the strip of xFrame (0 = no strip).
+    sal_Int32 tabBarHeight(const css::uno::Reference<css::frame::XFrame>& xFrame,
+                           bool bLayoutVisible);
+    /// LayoutManager: place (creating it on demand) the strip of xFrame.
+    void placeTabBar(const css::uno::Reference<css::frame::XFrame>& xFrame,
+                     const tools::Rectangle& rRect);
+
+    std::vector<DocumentTabInfo> getTabs() const;
+    void activate(const css::uno::Reference<css::frame::XFrame>& xFrame);
+    void activateRelative(sal_Int32 nDelta);
+    void closeTab(const css::uno::Reference<css::frame::XFrame>& xFrame);
+    /// Dispatch rURL ("private:factory/..." into a new task, or ".uno:Open") asynchronously.
+    void newTab(const OUString& rURL);
+
+    /// .uno:NextDocumentTab / .uno:PrevDocumentTab (DispatchProvider routes them here).
+    static bool isTabCommand(std::u16string_view rCommand);
+    static css::uno::Reference<css::frame::XDispatch> createCommandDispatch();
+
+    /** Title-bar close of a member window: close the whole group like a browser window,
+        asking to save each modified document in turn (Cancel stops and keeps the rest).
+        Returns false when xFrame is no member of a group with several tabs. */
+    bool requestCloseWindow(const css::uno::Reference<css::frame::XFrame>& xFrame);
+
+    /// Desktop::terminate: frames are about to be closed one by one, don't re-show neighbours.
+    void setClosingAll(bool bClosingAll);
+
+    // listener callbacks
+    void frameClosing(const css::uno::Reference<css::frame::XFrame>& xFrame);
+    void documentEvent();
+    void optionChanged(bool bEnabled);
+    void shutdown();
+
+private:
+    struct Member
+    {
+        css::uno::WeakReference<css::frame::XFrame> xFrame;
+        VclPtr<vcl::Window> pWindow; ///< the frame's container (top-level WorkWindow)
+        VclPtr<DocumentTabBar> pBar;
+        bool bParked = false;
+    };
+
+    DocumentTabGroup();
+
+    bool isCandidate(const css::uno::Reference<css::frame::XFrame>& xFrame) const;
+    css::uno::Reference<css::frame::XFrame> findTaskFrame(const vcl::Window* pWindow) const;
+    Member* find(const css::uno::Reference<css::frame::XFrame>& xFrame);
+    const Member* find(const css::uno::Reference<css::frame::XFrame>& xFrame) const;
+    Member* findByWindow(const vcl::Window* pWindow);
+    Member* activeMember();
+    Member& join(const css::uno::Reference<css::frame::XFrame>& xFrame);
+    void removeMember(const css::uno::Reference<css::frame::XFrame>& xFrame,
+                      bool bShowNeighbour);
+    void cleanUp();
+    void park(Member& rMember);
+    void focus(const css::uno::Reference<css::frame::XFrame>& xFrame);
+    void dissolve();
+    void update();
+    bool showsTabBar(const Member& rMember) const;
+
+    static void copyGeometry(vcl::Window* pFrom, vcl::Window* pTo);
+
+    DECL_LINK(WindowEventHdl, VclSimpleEvent&, void);
+    DECL_LINK(ParkPreviousHdl, void*, void);
+    DECL_LINK(DispatchHdl, void*, void);
+    DECL_LINK(CloseWindowHdl, void*, void);
+
+
+    std::vector<Member> m_aMembers;
+    css::uno::WeakReference<css::frame::XFrame> m_xActive;
+    css::uno::WeakReference<css::frame::XFrame> m_xPrepared; ///< geometry already applied
+    css::uno::WeakReference<css::frame::XFrame> m_xToPark;
+    std::vector<OUString> m_aPendingURLs;
+    css::uno::WeakReference<css::frame::XFrame> m_xCloseWindowFrom;
+    rtl::Reference<DocumentTabGroupListener> m_xListener;
+    sal_Int32 m_nInternal = 0; ///< >0 while we show/hide windows ourselves
+    bool m_bClosingAll = false;
+    bool m_bEnabled = true; ///< last known option value
+};
+}
