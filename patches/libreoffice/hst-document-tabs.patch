+// Sizes in pixels at 100% scale.
+constexpr tools::Long TAB_MIN_WIDTH = 72;
+constexpr tools::Long TAB_MAX_WIDTH = 220;
+constexpr tools::Long TAB_PAD = 10;
+constexpr tools::Long CLOSE_SIZE = 16;
+constexpr tools::Long PLUS_WIDTH = 30;
+constexpr tools::Long ACCENT = 2;
+
+constexpr sal_uInt16 MENU_WRITER = 1;
+constexpr sal_uInt16 MENU_CALC = 2;
+constexpr sal_uInt16 MENU_IMPRESS = 3;
+constexpr sal_uInt16 MENU_OPEN = 4;
+
+/// Scale a 100% pixel size by the window's DPI factor.
+tools::Long Px(const vcl::Window& rWindow, double fPixels)
+{
+    return static_cast<tools::Long>(fPixels * rWindow.GetDPIScaleFactor() + 0.5);
+}
+}
+
+DocumentTabBar::DocumentTabBar(vcl::Window* pParent,
+                               const css::uno::Reference<css::frame::XFrame>& xFrame)
+    : vcl::Window(pParent, WB_CLIPCHILDREN)
+    , m_xFrame(xFrame)
+{
+    ImplInitSettings();
+    SetAccessibleName(FwkResId(STR_DOCTAB_BAR));
+}
+
+void DocumentTabBar::ImplInitSettings()
+{
+    const StyleSettings& rStyle = GetSettings().GetStyleSettings();
+    vcl::Font aFont = rStyle.GetToolFont();
+    SetPointFont(*GetOutDev(), aFont);
+    SetBackground(rStyle.GetFaceColor());
+}
+
+tools::Long DocumentTabBar::GetOptimalHeight() const
+{
+    return GetTextHeight() + 2 * Px(*this, TAB_PAD - 2) + ACCENT;
+}
+
+void DocumentTabBar::ImplLayout()
+{
+    const tools::Long nHeight = GetOutputSizePixel().Height();
+    const tools::Long nWidth = GetOutputSizePixel().Width();
+    const tools::Long nPlus = Px(*this, PLUS_WIDTH);
+    const tools::Long nClose = Px(*this, CLOSE_SIZE);
+    const tools::Long nPad = Px(*this, TAB_PAD);
+    const tools::Long nMin = Px(*this, TAB_MIN_WIDTH);
+
+    std::vector<DocumentTabInfo> aInfos = DocumentTabGroup::get().getTabs();
+    m_aTabs.clear();
+
+    // Natural widths, then shrink evenly when they don't fit next to the "+" button.
+    std::vector<tools::Long> aWidths;
+    tools::Long nSum = 0;
+    // measure with the bold font of the active tab, so a tab doesn't change width on switch
+    GetOutDev()->Push(vcl::PushFlags::FONT);
+    vcl::Font aBold(GetOutDev()->GetFont());
+    aBold.SetWeight(WEIGHT_BOLD);
+    GetOutDev()->SetFont(aBold);
+    for (const DocumentTabInfo& rInfo : aInfos)
+    {
+        tools::Long nTab = nPad + GetOutDev()->GetTextWidth(rInfo.aTitle) + nPad + nClose
+                           + Px(*this, 12) + nPad / 2;
+        nTab = std::clamp<tools::Long>(nTab, nMin, Px(*this, TAB_MAX_WIDTH));
+        aWidths.push_back(nTab);
+        nSum += nTab;
+    }
+    GetOutDev()->Pop();
+    const tools::Long nAvail = std::max<tools::Long>(nWidth - nPlus - 4, 0);
+    if (nSum > nAvail && !aInfos.empty())
+    {
+        const tools::Long nEach
+            = std::max<tools::Long>(nAvail / static_cast<tools::Long>(aInfos.size()), nMin);
+        for (tools::Long& rWidth : aWidths)
+            rWidth = std::min(rWidth, nEach);
+    }
+
+    // With many tabs keep the active one in view: skip tabs on the left.
+    size_t nFirst = 0;
+    {
+        size_t nActive = 0;
+        for (size_t i = 0; i < aInfos.size(); ++i)
+            if (aInfos[i].bActive)
+                nActive = i;
+        tools::Long nUsed = 0;
+        for (size_t i = 0; i <= nActive && i < aWidths.size(); ++i)
+            nUsed += aWidths[i];
+        while (nUsed > nAvail && nFirst < nActive)
+            nUsed -= aWidths[nFirst++];
+    }
+
+    tools::Long nX = 0;
+    for (size_t i = nFirst; i < aInfos.size(); ++i)
+    {
+        if (nX + aWidths[i] > nAvail && i > nFirst)
+            break;
+        TabLayout aTab;
+        aTab.aInfo = aInfos[i];
+        aTab.aRect = tools::Rectangle(Point(nX, 0), Size(aWidths[i], nHeight));
+        const tools::Long nCloseX = aTab.aRect.Right() - nPad / 2 - nClose;
+        aTab.aCloseRect = tools::Rectangle(Point(nCloseX, (nHeight + Px(*this, ACCENT) - nClose) / 2),
+                                           Size(nClose, nClose));
+        m_aTabs.push_back(aTab);
+        nX += aWidths[i];
+    }
+    const tools::Long nPlusHeight = std::min(nPlus - Px(*this, 6), nHeight - ACCENT - 2);
+    m_aPlusRect = tools::Rectangle(Point(nX + 2, ACCENT + (nHeight - ACCENT - nPlusHeight) / 2),
+                                   Size(nPlus - 4, nPlusHeight));
+}
+
+void DocumentTabBar::Paint(vcl::RenderContext& rRenderContext, const tools::Rectangle&)
+{
+    ImplLayout();
+
+    const StyleSettings& rStyle = rRenderContext.GetSettings().GetStyleSettings();
+    const Color aFace = rStyle.GetFaceColor();
+    const Color aActiveBg = rStyle.GetWindowColor();
+    const Color aShadow = rStyle.GetShadowColor();
+    Color aHover(aFace);
+    if (aFace.IsDark())
+        aHover.IncreaseLuminance(24);
+    else
+        aHover.DecreaseLuminance(16);
+    const Size aOut = GetOutputSizePixel();
+    const tools::Long nAccent = Px(*this, ACCENT);
+
+    rRenderContext.Push(vcl::PushFlags::FILLCOLOR | vcl::PushFlags::LINECOLOR
+                        | vcl::PushFlags::TEXTCOLOR | vcl::PushFlags::FONT);
+    rRenderContext.SetLineColor();
+    rRenderContext.SetFillColor(aFace);
+    rRenderContext.DrawRect(tools::Rectangle(Point(0, 0), aOut));
+
+    for (size_t i = 0; i < m_aTabs.size(); ++i)
+    {
+        const TabLayout& rTab = m_aTabs[i];
+        const bool bHover = static_cast<sal_Int32>(i) == m_nHoverTab;
+        tools::Rectangle aBody(rTab.aRect);
+        aBody.SetTop(aBody.Top() + nAccent);
+
+        rRenderContext.SetLineColor();
+        if (rTab.aInfo.bActive)
+        {
+            rRenderContext.SetFillColor(aActiveBg);
+            rRenderContext.DrawRect(aBody);
+            // accent line in the module colour on top of the active tab
+            rRenderContext.SetFillColor(rTab.aInfo.aModuleColor);
+            rRenderContext.DrawRect(tools::Rectangle(Point(aBody.Left(), 0),
+                                                     Size(aBody.GetWidth(), nAccent)));
+        }
+        else
+        {
+            if (bHover)
+            {
+                rRenderContext.SetFillColor(aHover);
+                rRenderContext.DrawRect(aBody);
+            }
+            // module colour as a small marker, separator on the right
+            rRenderContext.SetFillColor(rTab.aInfo.aModuleColor);
+            rRenderContext.DrawRect(
+                tools::Rectangle(Point(aBody.Left() + 3, aBody.Bottom() - Px(*this, 2)),
+                                 Size(aBody.GetWidth() - 6, Px(*this, 2))));
+            rRenderContext.SetLineColor(aShadow);
+            rRenderContext.DrawLine(Point(aBody.Right(), aBody.Top() + 4),
+                                    Point(aBody.Right(), aBody.Bottom() - 4));
+        }
+
+        // title, with ellipsis
+        const tools::Long nPad = Px(*this, TAB_PAD);
+        tools::Rectangle aText(Point(aBody.Left() + nPad, aBody.Top()),
+                               Point(rTab.aCloseRect.Left() - 4, aBody.Bottom()));
+        if (rTab.aInfo.bModified)
+            aText.SetRight(aText.Right() - Px(*this, 10));
+        rRenderContext.SetTextColor(rTab.aInfo.bActive ? rStyle.GetWindowTextColor()
+                                                        : rStyle.GetButtonTextColor());
+        rRenderContext.Push(vcl::PushFlags::FONT);
+        if (rTab.aInfo.bActive)
+        {
+            vcl::Font aBold(rRenderContext.GetFont());
+            aBold.SetWeight(WEIGHT_BOLD);
+            rRenderContext.SetFont(aBold);
+        }
+        rRenderContext.DrawText(aText, rTab.aInfo.aTitle,
+                                DrawTextFlags::Left | DrawTextFlags::VCenter
+                                    | DrawTextFlags::EndEllipsis);
+        rRenderContext.Pop();
+
+        // modified marker: a dot in the module colour
+        if (rTab.aInfo.bModified)
+        {
+            const tools::Long nR = Px(*this, 3);
+            const Point aC(aText.Right() + Px(*this, 5), rTab.aCloseRect.Center().Y());
+            rRenderContext.SetLineColor();
+            rRenderContext.SetFillColor(rTab.aInfo.aModuleColor);
+            rRenderContext.DrawEllipse(
+                tools::Rectangle(Point(aC.X() - nR, aC.Y() - nR), Size(2 * nR + 1, 2 * nR + 1)));
+        }
+
+        // close button
+        const tools::Rectangle& rClose = rTab.aCloseRect;
+        if (bHover && m_bHoverClose)
+        {
+            rRenderContext.SetLineColor();
+            rRenderContext.SetFillColor(aShadow);
+            rRenderContext.DrawRect(rClose, 3, 3);
+        }
+        rRenderContext.SetLineColor(rStyle.GetButtonTextColor());
+        const tools::Long nInset = Px(*this, 4);
+        rRenderContext.DrawLine(Point(rClose.Left() + nInset, rClose.Top() + nInset),
+                                Point(rClose.Right() - nInset, rClose.Bottom() - nInset));
+        rRenderContext.DrawLine(Point(rClose.Right() - nInset, rClose.Top() + nInset),
+                                Point(rClose.Left() + nInset, rClose.Bottom() - nInset));
+    }
+
+    // "+": new tab
+    if (m_bHoverPlus)
+    {
+        rRenderContext.SetLineColor();
+        rRenderContext.SetFillColor(aHover);
+        rRenderContext.DrawRect(m_aPlusRect, 3, 3);
+    }
+    rRenderContext.SetLineColor(rStyle.GetButtonTextColor());
+    const Point aPC = m_aPlusRect.Center();
+    const tools::Long nArm = Px(*this, 5);
+    rRenderContext.DrawLine(Point(aPC.X() - nArm, aPC.Y()), Point(aPC.X() + nArm, aPC.Y()));
+    rRenderContext.DrawLine(Point(aPC.X(), aPC.Y() - nArm), Point(aPC.X(), aPC.Y() + nArm));
+
+    // bottom edge joins the active tab to the document
+    rRenderContext.SetLineColor(aShadow);
+    rRenderContext.DrawLine(Point(0, aOut.Height() - 1), Point(aOut.Width(), aOut.Height() - 1));
+    for (const TabLayout& rTab : m_aTabs)
+        if (rTab.aInfo.bActive)
+        {
+            rRenderContext.SetLineColor(aActiveBg);
+            rRenderContext.DrawLine(Point(rTab.aRect.Left(), aOut.Height() - 1),
+                                    Point(rTab.aRect.Right() - 1, aOut.Height() - 1));
+        }
+    rRenderContext.Pop();
+}
+
+sal_Int32 DocumentTabBar::ImplHitTab(const Point& rPos, bool* pOnClose) const
+{
+    for (size_t i = 0; i < m_aTabs.size(); ++i)
+        if (m_aTabs[i].aRect.Contains(rPos))
+        {
+            if (pOnClose)
+                *pOnClose = m_aTabs[i].aCloseRect.Contains(rPos);
+            return i;
+        }
+    return -1;
+}
+
+void DocumentTabBar::MouseMove(const MouseEvent& rMEvt)
+{
+    bool bClose = false;
+    sal_Int32 nTab = rMEvt.IsLeaveWindow() ? -1 : ImplHitTab(rMEvt.GetPosPixel(), &bClose);
+    bool bPlus = !rMEvt.IsLeaveWindow() && m_aPlusRect.Contains(rMEvt.GetPosPixel());
+    if (nTab != m_nHoverTab || bClose != m_bHoverClose || bPlus != m_bHoverPlus)
+    {
+        m_nHoverTab = nTab;
+        m_bHoverClose = bClose;
+        m_bHoverPlus = bPlus;
+        Invalidate();
+    }
+}
+
+void DocumentTabBar::MouseButtonDown(const MouseEvent& rMEvt)
+{
+    bool bClose = false;
+    const sal_Int32 nTab = ImplHitTab(rMEvt.GetPosPixel(), &bClose);
+    if (nTab >= 0)
+    {
+        css::uno::Reference<css::frame::XFrame> xTarget = m_aTabs[nTab].aInfo.xFrame;
+        if (rMEvt.IsMiddle() || (rMEvt.IsLeft() && bClose))
+            DocumentTabGroup::get().closeTab(xTarget);
+        else if (rMEvt.IsLeft())
+            DocumentTabGroup::get().activate(xTarget);
+        return;
+    }
+    if (rMEvt.IsLeft() && m_aPlusRect.Contains(rMEvt.GetPosPixel()))
+        ImplShowNewMenu();
+}
+
+void DocumentTabBar::ImplShowNewMenu()
+{
+    VclPtrInstance<PopupMenu> aMenu;
+    aMenu->InsertItem(MENU_WRITER, FwkResId(STR_DOCTAB_NEW_WRITER));
+    aMenu->InsertItem(MENU_CALC, FwkResId(STR_DOCTAB_NEW_CALC));
+    aMenu->InsertItem(MENU_IMPRESS, FwkResId(STR_DOCTAB_NEW_IMPRESS));
+    aMenu->InsertSeparator();
+    aMenu->InsertItem(MENU_OPEN, FwkResId(STR_DOCTAB_OPEN));
+    const sal_uInt16 nId = aMenu->Execute(this, m_aPlusRect, PopupMenuFlags::ExecuteDown);
+    aMenu.disposeAndClear();
+    switch (nId)
+    {
+        case MENU_WRITER:
+            DocumentTabGroup::get().newTab(u"private:factory/swriter"_ustr);
+            break;
+        case MENU_CALC:
+            DocumentTabGroup::get().newTab(u"private:factory/scalc"_ustr);
+            break;
+        case MENU_IMPRESS:
+            DocumentTabGroup::get().newTab(u"private:factory/simpress"_ustr);
+            break;
+        case MENU_OPEN:
+            DocumentTabGroup::get().newTab(u".uno:Open"_ustr);
+            break;
+        default:
+            break;
+    }
+}
+
+void DocumentTabBar::RequestHelp(const HelpEvent& rHEvt)
+{
+    const Point aPos = ScreenToOutputPixel(rHEvt.GetMousePosPixel());
+    bool bClose = false;
+    const sal_Int32 nTab = ImplHitTab(aPos, &bClose);
+    OUString aText;
+    tools::Rectangle aRect;
+    if (nTab >= 0)
+    {
+        const DocumentTabInfo& rInfo = m_aTabs[nTab].aInfo;
+        aRect = bClose ? m_aTabs[nTab].aCloseRect : m_aTabs[nTab].aRect;
+        aText = bClose ? FwkResId(STR_DOCTAB_CLOSE) : rInfo.aTitle;
+        if (!bClose && rInfo.bModified)
+            aText += "\n" + FwkResId(STR_DOCTAB_MODIFIED);
+    }
+    else if (m_aPlusRect.Contains(aPos))
+    {
+        aRect = m_aPlusRect;
+        aText = FwkResId(STR_DOCTAB_NEW);
+    }
+    if (aText.isEmpty())
+    {
+        vcl::Window::RequestHelp(rHEvt);
+        return;
+    }
+    const Point aTopLeft = OutputToScreenPixel(aRect.TopLeft());
+    Help::ShowQuickHelp(this, tools::Rectangle(aTopLeft, aRect.GetSize()), aText);
+}
+
+void DocumentTabBar::DataChanged(const DataChangedEvent& rDCEvt)
+{
+    vcl::Window::DataChanged(rDCEvt);
+    if (rDCEvt.GetType() == DataChangedEventType::SETTINGS
+        && (rDCEvt.GetFlags() & AllSettingsFlags::STYLE))
+    {
+        ImplInitSettings();
+        Invalidate();
+    }
+}
+
+void DocumentTabBar::Resize()
+{
+    vcl::Window::Resize();
+    Invalidate();
+}
+}
