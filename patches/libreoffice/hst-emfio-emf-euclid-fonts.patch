+// HST Office: metafile text in fonts whose codes are not Unicode and whose fonts are rarely
+// installed: legacy Vietnamese fonts (TCVN3/VNI, hstlegacyvn.hxx) and the letter fonts of old
+// MathType equations (Euclid Math One: script, Euclid Math Two: double-struck, Euclid
+// Fraktur). The text is decoded to Unicode and drawn with a Unicode font that has the letters.
+
+#pragma once
+
+#include "hstlegacyvn.hxx"
+
+#include <o3tl/string_view.hxx>
+#include <rtl/ustrbuf.hxx>
+#include <rtl/ustring.hxx>
+
+#include <string_view>
+#include <vector>
+
+namespace emfio::hstfonttext
+{
+enum class EuclidLetters
+{
+    None,
+    Script, // "Euclid Math One"
+    DoubleStruck, // "Euclid Math Two"
+    Fraktur // "Euclid Fraktur"
+};
+
+inline EuclidLetters GetEuclidLetters(std::u16string_view rFamily)
+{
+    if (o3tl::equalsIgnoreAsciiCase(rFamily, u"Euclid Math One"))
+        return EuclidLetters::Script;
+    if (o3tl::equalsIgnoreAsciiCase(rFamily, u"Euclid Math Two"))
+        return EuclidLetters::DoubleStruck;
+    if (o3tl::equalsIgnoreAsciiCase(rFamily, u"Euclid Fraktur"))
+        return EuclidLetters::Fraktur;
+    return EuclidLetters::None;
+}
+
+// Unicode Mathematical Alphanumeric Symbols; the letters that Unicode encodes in the
+// Letterlike Symbols block (holes in the range) are listed first. 0 = not mapped.
+inline sal_uInt32 EuclidLetter(EuclidLetters eKind, unsigned char c)
+{
+    struct Hole
+    {
+        char cLetter;
+        sal_uInt32 nCode;
+    };
+    static constexpr Hole aScript[] = { { 'B', 0x212C }, { 'E', 0x2130 }, { 'F', 0x2131 }, { 'H', 0x210B },
+                                        { 'I', 0x2110 }, { 'L', 0x2112 }, { 'M', 0x2133 }, { 'R', 0x211B } };
+    static constexpr Hole aDoubleStruck[] = { { 'C', 0x2102 }, { 'H', 0x210D }, { 'N', 0x2115 }, { 'P', 0x2119 },
+                                              { 'Q', 0x211A }, { 'R', 0x211D }, { 'Z', 0x2124 } };
+    static constexpr Hole aFraktur[] = { { 'C', 0x212D }, { 'H', 0x210C }, { 'I', 0x2111 }, { 'R', 0x211C },
+                                         { 'Z', 0x2128 } };
+    const bool bUpper = c >= 'A' && c <= 'Z';
+    const bool bLower = c >= 'a' && c <= 'z';
+    switch (eKind)
+    {
+        case EuclidLetters::Script: // capitals only (the lower case of the font is not documented)
+            for (const Hole& r : aScript)
+                if (r.cLetter == static_cast<char>(c))
+                    return r.nCode;
+            return bUpper ? 0x1D49C + (c - 'A') : 0;
+        case EuclidLetters::DoubleStruck:
+            for (const Hole& r : aDoubleStruck)
+                if (r.cLetter == static_cast<char>(c))
+                    return r.nCode;
+            if (bUpper)
+                return 0x1D538 + (c - 'A');
+            if (bLower)
+                return 0x1D552 + (c - 'a');
+            switch (c) // relations of the font
+            {
+                case 0xB0: return 0x227C;
+                case 0xD8: return 0x228A;
+                case 0xD9: return 0x228B;
+                case 0xE4: return 0x2208;
+                default: return 0;
+            }
+        case EuclidLetters::Fraktur:
+            for (const Hole& r : aFraktur)
+                if (r.cLetter == static_cast<char>(c))
+                    return r.nCode;
+            if (bUpper)
+                return 0x1D504 + (c - 'A');
+            if (bLower)
+                return 0x1D51E + (c - 'a');
+            return 0;
+        case EuclidLetters::None:
+            break;
+    }
+    return 0;
+}
+
+// Decode nLen bytes of text in rFamily. Returns false (nothing done) for other fonts; otherwise
+// rText is the Unicode text, rBytes the number of source bytes behind each UTF-16 unit (0 for
+// the second half of a surrogate pair) and rReplacement the font to draw it with.
+inline bool Decode(std::u16string_view rFamily, const char* pChars, sal_Int32 nLen, OUString& rText,
+                   std::vector<sal_Int32>& rBytes, OUString& rReplacement)
+{
+    const legacyvn::Encoding eLegacyVn = legacyvn::GetEncoding(rFamily);
+    if (eLegacyVn != legacyvn::Encoding::None)
+    {
+        rText = legacyvn::Decode(eLegacyVn, pChars, nLen, rBytes);
+        rReplacement = legacyvn::GetReplacementFamily(rFamily);
+        return true;
+    }
+    const EuclidLetters eEuclid = GetEuclidLetters(rFamily);
+    if (eEuclid == EuclidLetters::None)
+        return false;
+    OUStringBuffer aBuf(nLen);
+    rBytes.clear();
+    for (sal_Int32 i = 0; i < nLen; ++i)
+    {
+        const unsigned char c = static_cast<unsigned char>(pChars[i]);
+        const sal_uInt32 nCode = EuclidLetter(eEuclid, c);
+        if (nCode > 0xFFFF)
+        {
+            aBuf.appendUtf32(nCode);
+            rBytes.push_back(1);
+            rBytes.push_back(0);
+        }
+        else
+        {
+            aBuf.append(nCode ? sal_Unicode(nCode) : legacyvn::DecodeCp1252(c));
+            rBytes.push_back(1);
+        }
+    }
+    rText = aBuf.makeStringAndClear();
+    rReplacement = u"DejaVu Math TeX Gyre"_ustr;
+    return true;
+}
+
+// The same for UTF-16 text (EMF EXTTEXTOUTW) written in such a font: Windows keeps the byte
+// codes there (as U+00xx, U+F0xx or the Windows-1252 character). Returns false when the text
+// holds other characters (it is real Unicode text then).
+inline bool DecodeWide(std::u16string_view rFamily, std::u16string_view rWide, OUString& rText,
+                       std::vector<sal_Int32>& rBytes, OUString& rReplacement)
+{
+    if (legacyvn::GetEncoding(rFamily) == legacyvn::Encoding::None
+        && GetEuclidLetters(rFamily) == EuclidLetters::None)
+        return false;
+    std::string aBytes;
+    aBytes.reserve(rWide.size());
+    for (sal_Unicode c : rWide)
+    {
+        if (c >= 0xF020 && c <= 0xF0FF)
+            c -= 0xF000;
+        if (c > 0xFF)
+        {
+            sal_Unicode nByte = 0;
+            for (sal_Unicode b = 0x80; b < 0xA0 && !nByte; ++b)
+                if (legacyvn::aCp1252High[b - 0x80] == c)
+                    nByte = b;
+            if (!nByte)
+                return false;
+            c = nByte;
+        }
+        aBytes.push_back(static_cast<char>(c));
+    }
+    return Decode(rFamily, aBytes.data(), aBytes.size(), rText, rBytes, rReplacement);
+}
+}
