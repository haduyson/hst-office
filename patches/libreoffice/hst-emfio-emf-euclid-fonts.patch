+namespace
+{
+// Minimal EMF writer for the legacy Vietnamese font test
+void writeEmfRecord(SvMemoryStream& rStream, sal_uInt32 nType, const std::vector<sal_uInt32>& rDwords)
+{
+    rStream.WriteUInt32(nType).WriteUInt32(8 + 4 * rDwords.size());
+    for (sal_uInt32 n : rDwords)
+        rStream.WriteUInt32(n);
+}
+
+void writeEmfFont(SvMemoryStream& rStream, std::u16string_view aFace)
+{
+    // EMR_EXTCREATEFONTINDIRECTW: handle 1, LOGFONTW height -16, weight 400, DEFAULT_CHARSET
+    std::vector<sal_uInt32> aDwords{ 1, sal_uInt32(-16), 0, 0, 0, 400, 0x01000000, 0 };
+    sal_Unicode aName[32] = {};
+    std::copy(aFace.begin(), aFace.end(), aName);
+    for (size_t i = 0; i < 32; i += 2)
+        aDwords.push_back(aName[i] | (sal_uInt32(aName[i + 1]) << 16));
+    writeEmfRecord(rStream, 82, aDwords);
+    writeEmfRecord(rStream, 37, { 1 }); // EMR_SELECTOBJECT
+}
+
+// EMR_EXTTEXTOUTA (bWide false: one byte per character) or EMR_EXTTEXTOUTW
+void writeEmfText(SvMemoryStream& rStream, sal_Int32 nY, std::u16string_view aText, bool bWide)
+{
+    const sal_uInt32 nChars = aText.size();
+    const sal_uInt32 nStringBytes = ((bWide ? 2 * nChars : nChars) + 3) & ~3u;
+    std::vector<sal_uInt32> aDwords{ 0, 0, 2000, 1000, 1, 0, 0, // bounds, GM_COMPATIBLE, scales
+                                     100, sal_uInt32(nY), nChars, 76, 0, 0, 0, 2000, 1000, 76 + nStringBytes };
+    std::vector<unsigned char> aBytes;
+    for (sal_Unicode c : aText)
+    {
+        aBytes.push_back(c & 0xFF);
+        if (bWide)
+            aBytes.push_back(c >> 8);
+    }
+    aBytes.resize(nStringBytes);
+    for (size_t i = 0; i < aBytes.size(); i += 4)
+        aDwords.push_back(aBytes[i] | aBytes[i + 1] << 8 | aBytes[i + 2] << 16 | sal_uInt32(aBytes[i + 3]) << 24);
+    for (sal_uInt32 i = 0; i < nChars; ++i)
+        aDwords.push_back(100);
+    writeEmfRecord(rStream, bWide ? 84 : 83, aDwords);
+}
+}
