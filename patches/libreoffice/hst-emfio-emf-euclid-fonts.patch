+void WmfTest::testEuclidFontsWmf()
+{
+    // HST Office: old MathType equations use the Euclid fonts. The letter fonts become Unicode
+    // mathematical letters drawn with a math font; Euclid Symbol / Euclid Extra use the
+    // Symbol / MT Extra handling (the same layout).
+    SvMemoryStream aStream;
+    aStream.WriteUInt16(1).WriteUInt16(9).WriteUInt16(0x0300);
+    aStream.WriteUInt32(0).WriteUInt16(1).WriteUInt32(0).WriteUInt16(0);
+    writeWmfRecord(aStream, 0x020B, { 0, 0 });
+    writeWmfRecord(aStream, 0x020C, { 1000, 2000 });
+    writeWmfFont(aStream, "Euclid Math Two");
+    writeWmfExtTextOut(aStream, 100, "RN"); // double-struck R and N (Letterlike Symbols)
+    writeWmfRecord(aStream, 0x01F0, { 0 });
+    writeWmfFont(aStream, "Euclid Math One");
+    writeWmfExtTextOut(aStream, 400, "AL"); // script A (U+1D49C, surrogate pair) and L (U+2112)
+    writeWmfRecord(aStream, 0x01F0, { 0 });
+    writeWmfFont(aStream, "Euclid Fraktur");
+    writeWmfExtTextOut(aStream, 700, "g");
+    writeWmfRecord(aStream, 0x01F0, { 0 });
+    writeWmfFont(aStream, "Euclid Symbol");
+    writeWmfExtTextOut(aStream, 1000, "a");
+    writeWmfRecord(aStream, 0x01F0, { 0 });
+    writeWmfFont(aStream, "Euclid");
+    writeWmfExtTextOut(aStream, 1300, "x");
+    writeWmfRecord(aStream, 0x0000, {});
+    aStream.Seek(6);
+    aStream.WriteUInt32(aStream.TellEnd() / 2);
+    aStream.Seek(0);
+
+    GDIMetaFile aGDIMetaFile;
+    ReadWindowMetafile(aStream, aGDIMetaFile);
+    xmlDocUniquePtr pDoc = dumpAndParse(aGDIMetaFile);
+    CPPUNIT_ASSERT(pDoc);
+
+    // Without the fix: "RN" in the missing font "Euclid Math Two"
+    assertXPathContent(pDoc, "(//textarray)[1]/text", u"ℝℕ");
+    assertXPath(pDoc, "(//textarray)[1]/preceding-sibling::font[1]", "name", u"DejaVu Math TeX Gyre");
+    assertXPathContent(pDoc, "(//textarray)[2]/text", u"\U0001D49Cℒ");
+    assertXPathContent(pDoc, "(//textarray)[3]/text", u"\U0001D524");
+    // Euclid Symbol is drawn as Symbol (symbol encoding)
+    assertXPath(pDoc, "(//textarray)[4]/preceding-sibling::font[1]", "name", u"Symbol");
+    assertXPath(pDoc, "//font[@name='Euclid Symbol']", 0);
+    assertXPath(pDoc, "(//textarray)[5]/preceding-sibling::font[1]", "name", u"Times New Roman");
+}
