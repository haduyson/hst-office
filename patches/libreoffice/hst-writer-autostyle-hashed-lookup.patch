 #include <vector>
 
 namespace {
@@ -36,6 +38,10 @@
     class Node
     {
         std::vector<std::unique_ptr<Node>> mChildren; // child nodes, create by findChildNode(..)
+        // HST Office: the children whose item supports hashCode(), by Which and hash. A run
+        // of a .docx with its own colour (OCR output, pasted web text) adds one child per
+        // distinct colour, and the linear search below made the import O(N^2).
+        std::unordered_multimap<size_t, Node*> maHashedChildren;
         // container of shared pointers of inserted item sets; for non-poolable
         // items more than one item set is needed
         std::vector< std::shared_ptr<SfxItemSet> > maItemSet;
@@ -111,15 +117,33 @@
     Node* Node::findChildNode( const SfxPoolItem& rItem,
                                const bool bIsItemIgnorable )
     {
-        for( auto const & rChild : mChildren )
-        {
-            if( rItem.Which() == rChild->mpItem->Which() &&
-                rItem == *rChild->mpItem )
-                return rChild.get();
+        // supportsHashCode() is fixed per item type and equal items have equal hash codes, so
+        // an equal child of a hashable item is always in maHashedChildren
+        const bool bHashed = rItem.supportsHashCode();
+        size_t nKey = 0;
+        if (bHashed)
+        {
+            nKey = rItem.hashCode();
+            o3tl::hash_combine(nKey, rItem.Which());
+            auto [aBegin, aEnd] = maHashedChildren.equal_range(nKey);
+            for (auto it = aBegin; it != aEnd; ++it)
+                if (rItem.Which() == it->second->mpItem->Which() && rItem == *it->second->mpItem)
+                    return it->second;
+        }
+        else
+        {
+            for( auto const & rChild : mChildren )
+            {
+                if( rItem.Which() == rChild->mpItem->Which() &&
+                    rItem == *rChild->mpItem )
+                    return rChild.get();
+            }
         }
         // #i86923#
         auto pNextNode = new Node( rItem, this, bIsItemIgnorable );
         mChildren.emplace_back( pNextNode );
+        if (bHashed)
+            maHashedChildren.emplace(nKey, pNextNode);
         return pNextNode;
     }
 
