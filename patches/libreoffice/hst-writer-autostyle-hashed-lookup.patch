+
+#include <svl/grabbagitem.hxx>
+
+#include <cppunit/TestAssert.h>
+#include <cppunit/TestFixture.h>
+#include <cppunit/extensions/HelperMacros.h>
+
+using namespace css;
+
+namespace
+{
+SfxGrabBagItem colourBag(const OUString& rColour, sal_Int32 nTint)
+{
+    std::map<OUString, uno::Any> aMap{ { u"CharThemeOriginalColor"_ustr, uno::Any(rColour) },
+                                       { u"Tint"_ustr, uno::Any(nTint) } };
+    return SfxGrabBagItem(1, std::move(aMap));
+}
+
+class GrabBagItemTest : public CppUnit::TestFixture
+{
+    void testHashCodeUsesStringValues()
+    {
+        // Equal bags hash equally:
+        CPPUNIT_ASSERT(colourBag(u"FF0000"_ustr, 1) == colourBag(u"FF0000"_ustr, 1));
+        CPPUNIT_ASSERT_EQUAL(colourBag(u"FF0000"_ustr, 1).hashCode(),
+                             colourBag(u"FF0000"_ustr, 1).hashCode());
+        // Bags that differ in a string value hash differently (only the keys counted before, so
+        // every run colour of a .docx fell into one hash bucket):
+        CPPUNIT_ASSERT(colourBag(u"FF0000"_ustr, 1) != colourBag(u"00FF00"_ustr, 1));
+        CPPUNIT_ASSERT(colourBag(u"FF0000"_ustr, 1).hashCode()
+                       != colourBag(u"00FF00"_ustr, 1).hashCode());
+        // Non-string values are not hashed (equal Anys may hold different integer types):
+        CPPUNIT_ASSERT_EQUAL(colourBag(u"FF0000"_ustr, 1).hashCode(),
+                             colourBag(u"FF0000"_ustr, 2).hashCode());
+    }
+
+    CPPUNIT_TEST_SUITE(GrabBagItemTest);
+    CPPUNIT_TEST(testHashCodeUsesStringValues);
+    CPPUNIT_TEST_SUITE_END();
+};
+
+CPPUNIT_TEST_SUITE_REGISTRATION(GrabBagItemTest);
+}
