+// HST Office: URW "Standard Symbols PS" (fonts-urw-base35) is a metric-compatible Symbol clone
+// whose Unicode cmap holds the glyphs at the Symbol byte codes; symbol-encoded text (U+F0xx)
+// is recoded to those codes, so equation pieces (long arrows, brackets) join as with Symbol.
+static sal_Unicode ImplSymbolToStandardSymbolsPS( sal_Unicode c )
+{
+    if( c >= 0xF020 && c <= 0xF0FF )
+        return c - 0xF000;
+    return c;
+}
+
+const ConvertChar aImplStandardSymbolsPSCvt = { nullptr, u"Standard Symbols PS"_ustr, ImplSymbolToStandardSymbolsPS };
