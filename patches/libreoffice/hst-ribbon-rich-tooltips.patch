+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+#include "HstRibbonTooltip.hxx"
+#include "HstRibbonTooltipTable.hrc"
+
+#include <sfx2/sfxresid.hxx>
+#include <vcl/commandinfoprovider.hxx>
+#include <vcl/event.hxx>
+#include <vcl/help.hxx>
+#include <vcl/mnemonic.hxx>
+#include <vcl/toolbox.hxx>
+
+namespace hst::ribbon
+{
+namespace
+{
+// the app bit of a module (HstRibbonTip::nApps); 0 for a module without a ribbon of its own
+sal_uInt8 AppBit(std::u16string_view rModule)
+{
+    if (rModule.starts_with(u"com.sun.star.text."))  // Text, Global and Web documents
+        return TIP_WRITER;
+    if (rModule == u"com.sun.star.sheet.SpreadsheetDocument")
+        return TIP_CALC;
+    if (rModule == u"com.sun.star.presentation.PresentationDocument")
+        return TIP_IMPRESS;
+    if (rModule == u"com.sun.star.drawing.DrawingDocument")
+        return TIP_DRAW;
+    return 0;
+}
+
+const HstRibbonTip* Find(std::u16string_view rCommand, sal_uInt8 nApp)
+{
+    const HstRibbonTip* pCommon = nullptr;
+    for (const HstRibbonTip& rTip : aHstRibbonTips)
+    {
+        if (rCommand != rTip.pCommand)
+            continue;
+        if (rTip.nApps == 0)
+            pCommon = &rTip;
+        else if (rTip.nApps & nApp)
+            return &rTip;
+    }
+    return pCommon;
+}
+}
+
+OUString GetTooltipDescription(std::u16string_view rModule, std::u16string_view rCommand)
+{
+    const sal_uInt8 nApp = AppBit(rModule);
+    const HstRibbonTip* pTip = Find(rCommand, nApp);
+    // ".uno:StyleApply?Style:string=..." etc.: a sentence for the exact call first, then for the command
+    const size_t nArgs = rCommand.find(u'?');
+    if (pTip == nullptr && nArgs != std::u16string_view::npos)
+        pTip = Find(rCommand.substr(0, nArgs), nApp);
+    return pTip ? SfxResId(pTip->aText) : OUString();
+}
+
+bool RequestRichHelp(ToolBox& rToolBox, const HelpEvent& rHEvt,
+                     const css::uno::Reference<css::frame::XFrame>& rxFrame)
+{
+    if (!(rHEvt.GetMode() & HelpEventMode::QUICK) || (rHEvt.GetMode() & HelpEventMode::BALLOON))
+        return false;
+    ToolBoxItemId nItemId;
+    if (rHEvt.KeyboardActivated())
+        nItemId = rToolBox.GetHighlightItemId();
+    else
+    {
+        const auto nPos = rToolBox.GetItemPos(rToolBox.ScreenToOutputPixel(rHEvt.GetMousePosPixel()));
+        if (nPos != ToolBox::ITEM_NOTFOUND)
+            nItemId = rToolBox.GetItemId(nPos);
+    }
+    if (!nItemId)
+        return false;
+    const tools::Rectangle aItemRect = rToolBox.GetItemRect(nItemId);
+    if (aItemRect.IsEmpty())
+        return false;
+
+    // first line: "Name (Shortcut)" as the toolbox has it (the label when there is no quick help)
+    OUString aText = rToolBox.GetQuickHelpText(nItemId);
+    if (aText.isEmpty())
+        aText = MnemonicGenerator::EraseAllMnemonicChars(rToolBox.GetItemText(nItemId)).replace('\n', ' ');
+    if (aText.isEmpty())
+        return false;
+    // a second line already set by the .ui (hst-ribbon-description) wins over the table
+    if (aText.indexOf('\n') < 0 && rxFrame.is())
+    {
+        const OUString aDescription = GetTooltipDescription(
+            vcl::CommandInfoProvider::GetModuleIdentifier(rxFrame), rToolBox.GetItemCommand(nItemId));
+        if (!aDescription.isEmpty())
+            aText += "\n" + aDescription;
+    }
+    const tools::Rectangle aScreenRect(rToolBox.OutputToScreenPixel(aItemRect.TopLeft()),
+                                       rToolBox.OutputToScreenPixel(aItemRect.BottomRight()));
+    Help::ShowQuickHelp(&rToolBox, aScreenRect, aText, QuickHelpFlags::RichTitle);
+    return true;
+}
+}
