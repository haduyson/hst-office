+// HST Office: rich ribbon tooltips. Hovering a ribbon button shows its name and shortcut in bold and, below, one
+// sentence saying what the command does. The sentences come from data/ribbon/tooltip-descriptions.json
+// (HstRibbonTooltipTable.hrc, generated by scripts/patches/generate-ribbon-tooltips.py); a button whose .ui already
+// has an "hst-ribbon-description" line keeps it, a command without a sentence shows its name only.
+
+#pragma once
+
+#include <com/sun/star/frame/XFrame.hpp>
+#include <rtl/ustring.hxx>
+
+#include <string_view>
+
+class HelpEvent;
+class ToolBox;
+
+namespace hst::ribbon
+{
+/// The sentence describing rCommand (".uno:Bold", arguments allowed) in the ribbon of the module rModule
+/// ("com.sun.star.text.TextDocument"...): the module's own sentence first, then the common one; empty if none.
+OUString GetTooltipDescription(std::u16string_view rModule, std::u16string_view rCommand);
+
+/// Shows the rich quick help of the ribbon item under the mouse (or the highlighted item for a keyboard request).
+/// Returns false when this is not a quick help request for an item, so the caller falls back to
+/// ToolBox::RequestHelp (extended tips, separators, empty space).
+bool RequestRichHelp(ToolBox& rToolBox, const HelpEvent& rHEvt,
+                     const css::uno::Reference<css::frame::XFrame>& rxFrame);
+}
