+namespace
+{
+constexpr DrawTextFlags RICH_BODY_FLAGS
+    = DrawTextFlags::MultiLine | DrawTextFlags::WordBreak | DrawTextFlags::Left | DrawTextFlags::Top;
+
+// HST Office: a RichTitle tip is "title\ndescription"; the title is the command name and its shortcut
+std::pair<OUString, OUString> SplitRichText(const OUString& rText)
+{
+    const sal_Int32 nBreak = rText.indexOf('\n');
+    if (nBreak < 0)
+        return { rText, OUString() };
+    return { rText.copy(0, nBreak), rText.copy(nBreak + 1) };
+}
+
+void SetBoldFont(vcl::RenderContext& rRenderContext)
+{
+    vcl::Font aBold(rRenderContext.GetFont());
+    aBold.SetWeight(WEIGHT_BOLD);
+    rRenderContext.SetFont(aBold);
+}
+}
+
+void HelpTextWindow::ImplLayoutRich()
+{
+    // HST Office: the bold title on its own line, then the description: on one line when it fits in about 60
+    // average characters, else on two lines of about the same length (a 90-character sentence), never narrower
+    // than the title; the width grows a little if a long word would push a third line
+    const auto [aTitle, aBody] = SplitRichText(maHelpText);
+    OutputDevice& rDev = *GetOutDev();
+    rDev.Push(vcl::PushFlags::FONT);
+    SetBoldFont(rDev);
+    const tools::Long nTitleWidth = rDev.GetTextWidth(aTitle);
+    const tools::Long nTitleHeight = rDev.GetTextHeight();
+    rDev.Pop();
+    Size aSize(nTitleWidth, nTitleHeight);
+    mnRichTitleHeight = nTitleHeight;
+    if (!aBody.isEmpty())
+    {
+        const tools::Long nBodyWidth = rDev.GetTextWidth(aBody);
+        const tools::Long nOneLine = rDev.GetTextWidth(OUString::Concat(RepeatedUChar('x', 60)));
+        // one line when short, or when the title is nearly as wide (two lines would leave an orphan word)
+        const bool bOneLine = nBodyWidth <= nOneLine || nBodyWidth <= nTitleWidth * 5 / 4;
+        tools::Long nWrap = std::max(nTitleWidth, bOneLine ? nBodyWidth : nBodyWidth * 11 / 20);
+        tools::Rectangle aBodyRect;
+        for (int nTry = 0; nTry < 4; ++nTry, nWrap += nWrap / 10)
+        {
+            aBodyRect = rDev.GetTextRect(tools::Rectangle(Point(), Size(nWrap, 0x7FFFFFFF)), aBody, RICH_BODY_FLAGS);
+            if (aBodyRect.GetHeight() <= 2 * rDev.GetTextHeight())
+                break;
+        }
+        mnRichTitleHeight = nTitleHeight + nTitleHeight / 3;
+        aSize = Size(std::max(nTitleWidth, aBodyRect.GetWidth()), mnRichTitleHeight + aBodyRect.GetHeight());
+    }
+    maTextRect = tools::Rectangle(Point(HELPTEXTMARGIN_BALLOON, HELPTEXTMARGIN_BALLOON), aSize);
+}
+
+void HelpTextWindow::ImplPaintRich(vcl::RenderContext& rRenderContext)
+{
+    const auto [aTitle, aBody] = SplitRichText(maHelpText);
+    rRenderContext.Push(vcl::PushFlags::FONT | vcl::PushFlags::TEXTCOLOR);
+    const Color aTextColor(rRenderContext.GetTextColor());
+    SetBoldFont(rRenderContext);
+    rRenderContext.SetTextColor(aTextColor);
+    rRenderContext.DrawText(maTextRect.TopLeft(), aTitle);
+    rRenderContext.Pop();
+    if (!aBody.isEmpty())
+        rRenderContext.DrawText(tools::Rectangle(Point(maTextRect.Left(), maTextRect.Top() + mnRichTitleHeight),
+                                                 maTextRect.BottomRight()),
+                                aBody, RICH_BODY_FLAGS);
+}
