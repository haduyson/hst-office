+// HST: Word's AutoFit behaviour, on the table just inserted, with the cursor still in it. Window is
+// what a new table already is: as wide as the text area, relative to it.
+static void lcl_HstApplyAutoFit(SwWrtShell& rSh, const SwHstInsTableAutoFit& rAutoFit, sal_uInt16 nCols)
+{
+    const SwHstInsTableAutoFit::Mode eMode = rAutoFit.GetHstAutoFitMode();
+    if (eMode == SwHstInsTableAutoFit::Mode::Window)
+        return;
+    SwTabCols aCols;
+    rSh.GetTabCols(aCols);
+    SwTwips nWidth = aCols.GetRight() - aCols.GetLeft();
+    if (rAutoFit.GetHstFixedColumnWidth() > 0 && eMode == SwHstInsTableAutoFit::Mode::Fixed)
+        nWidth = rAutoFit.GetHstFixedColumnWidth() * nCols;
+
+    SfxItemSet aSet(SfxItemSet::makeFixedSfxItemSet<RES_FRM_SIZE, RES_FRM_SIZE, RES_HORI_ORIENT, RES_HORI_ORIENT,
+                                                    RES_FRMATR_GRABBAG, RES_FRMATR_GRABBAG>(rSh.GetAttrPool()));
+    aSet.Put(SwFormatFrameSize(SwFrameSize::Variable, nWidth));
+    aSet.Put(SwFormatHoriOrient(0, text::HoriOrientation::LEFT));
+    if (eMode == SwHstInsTableAutoFit::Mode::Contents)
+    {
+        // Word then lays the table out by its content when it opens the DOCX.
+        std::map<OUString, css::uno::Any> aBag = rSh.GetTableFormat()->GetAttrSet().Get(RES_FRMATR_GRABBAG).GetGrabBag();
+        aBag[u"tblLayoutAutofit"_ustr] <<= true;
+        aSet.Put(SfxGrabBagItem(RES_FRMATR_GRABBAG, std::move(aBag)));
+    }
+    rSh.SetTableAttr(aSet);
+
+    if (eMode == SwHstInsTableAutoFit::Mode::Contents)
+    {
+        rSh.GetView().GetViewFrame().GetDispatcher()->Execute(FN_TABLE_SELECT_ALL);
+        rSh.AdjustCellWidth(false, false);
+        rSh.ClearMark();
+    }
+}
