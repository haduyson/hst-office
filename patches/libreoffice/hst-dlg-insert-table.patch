+// Word's "Remember dimensions for new tables": kept in the user profile, not in a document.
+void SwInsTableDlg::HstLoadDimensions()
+{
+    SvtViewOptions aOptions(EViewType::Dialog, HST_DIMENSIONS);
+    if (!aOptions.Exists())
+        return;
+    OUString aData;
+    aOptions.GetUserItem(u"Dimensions"_ustr) >>= aData;
+    sal_Int32 nIndex = 0;
+    const sal_Int32 nCols = o3tl::toInt32(o3tl::getToken(aData, 0, ';', nIndex));
+    const sal_Int32 nRows = o3tl::toInt32(o3tl::getToken(aData, 0, ';', nIndex));
+    const sal_Int32 nMode = o3tl::toInt32(o3tl::getToken(aData, 0, ';', nIndex));
+    const sal_Int32 nWidth = o3tl::toInt32(o3tl::getToken(aData, 0, ';', nIndex));
+    if (nCols < 1 || nRows < 1)
+        return;
+    m_xColSpinButton->set_value(nCols);
+    m_xRowSpinButton->set_value(nRows);
+    (nMode == 1 ? m_xContentsRB : nMode == 2 ? m_xWindowRB : m_xFixedRB)->set_active(true);
+    m_xFixedAutoCB->set_active(nWidth == 0);
+    if (nWidth > 0)
+        m_xFixedWidthMF->set_value(m_xFixedWidthMF->normalize(nWidth), FieldUnit::TWIP);
+    m_xRememberCB->set_active(true);
+}
+
+void SwInsTableDlg::HstStoreDimensions()
+{
+    SvtViewOptions aOptions(EViewType::Dialog, HST_DIMENSIONS);
+    if (!m_xRememberCB->get_active())
+    {
+        aOptions.Delete();
+        return;
+    }
+    const OUString aData = OUString::number(m_xColSpinButton->get_value()) + ";"
+                           + OUString::number(m_xRowSpinButton->get_value()) + ";"
+                           + OUString::number(static_cast<int>(GetHstAutoFitMode())) + ";"
+                           + OUString::number(GetHstFixedColumnWidth());
+    aOptions.SetUserItem(u"Dimensions"_ustr, css::uno::Any(aData));
+}
