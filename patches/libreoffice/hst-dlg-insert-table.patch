+namespace
+{
+/// Typing pauses this long before a refit: each refit measures every cell and relays out the table.
+constexpr sal_uInt64 HST_REFIT_DELAY_MS = 150;
+
+struct AutoFitState
+{
+    Timer aTimer{ "sw::HstTableAutoFit" };
+    DECL_STATIC_LINK(AutoFitState, Refit, Timer*, void);
+    const void* pBox = nullptr; ///< only compared, never dereferenced: the box may be gone
+    sal_Int32 nLength = -1;
+};
+
+sal_Int32 lcl_CellLength(const SwStartNode& rStart)
+{
+    sal_Int32 nLength = 0;
+    const SwNodes& rNodes = rStart.GetNodes();
+    const SwNodeOffset nEnd = rStart.EndOfSectionIndex();
+    for (SwNodeOffset n = rStart.GetIndex() + 1; n < nEnd; ++n)
+        if (const SwTextNode* pText = rNodes[n]->GetTextNode())
+            nLength += pText->Len() + 1;
+    return nLength;
+}
+
+bool lcl_IsMarked(const SwTable& rTable)
+{
+    return rTable.GetFrameFormat()->GetAttrSet().Get(RES_FRMATR_GRABBAG).GetGrabBag().contains(
+        u"tblLayoutAutofit"_ustr);
+}
+
+IMPL_STATIC_LINK_NOARG(AutoFitState, Refit, Timer*, void)
+{
+    SwWrtShell* pShell = ::GetActiveWrtShell();
+    const SwTableNode* pNode = pShell ? pShell->IsCursorInTable() : nullptr;
+    if (!pNode || !lcl_IsMarked(pNode->GetTable()) || pShell->ActionPend()
+        || Application::IsInModalMode())
+        return;
+    const SwTableSortBoxes& rBoxes = pNode->GetTable().GetTabSortBoxes();
+    if (rBoxes.empty())
+        return;
+
+    SwDoc& rDoc = *pShell->GetDoc();
+    // A cursor of its own over the whole table: the user's selection and cursor stay where they are.
+    SwNodeIndex aStart(*rBoxes.front()->GetSttNd(), 1);
+    SwCursor aCursor(SwPosition(aStart), nullptr);
+    aCursor.SetMark();
+    SwNodeIndex aEnd(*rBoxes.back()->GetSttNd()->EndOfSectionNode(), -1);
+    aCursor.GetPoint()->Assign(aEnd);
+
+    // Not an undo step: undoing the typing leaves a changed length, which refits again.
+    ::sw::UndoGuard aUndoGuard(rDoc.GetIDocumentUndoRedo());
+    pShell->StartAllAction();
+    rDoc.AdjustCellWidth(aCursor, false, false);
+    pShell->EndAllAction();
+}
+
+AutoFitState& lcl_State()
+{
+    static tools::DeleteOnDeinit<AutoFitState> aState;
+    return *aState.get();
+}
+}
+
+void HstTableAutoFitNotify(SwWrtShell& rShell)
+{
+    const SwTableNode* pNode = rShell.IsCursorInTable();
+    AutoFitState& rState = lcl_State();
+    if (!pNode || !lcl_IsMarked(pNode->GetTable()))
+    {
+        rState.pBox = nullptr;
+        return;
+    }
+    const SwTableBox* pBox = rShell.GetCursor()->GetPointNode().GetTableBox();
+    const SwStartNode* pStart = pBox ? pBox->GetSttNd() : nullptr;
+    if (!pStart)
+        return;
+    const sal_Int32 nLength = lcl_CellLength(*pStart);
+    if (pBox != rState.pBox)
+    {
+        // Arriving in a cell only records it.
+        rState.pBox = pBox;
+        rState.nLength = nLength;
+        return;
+    }
+    if (nLength == rState.nLength)
+        return;
+    rState.nLength = nLength;
+    rState.aTimer.SetTimeout(HST_REFIT_DELAY_MS);
+    rState.aTimer.SetInvokeHandler(LINK(nullptr, AutoFitState, Refit));
+    rState.aTimer.Start();
+}
