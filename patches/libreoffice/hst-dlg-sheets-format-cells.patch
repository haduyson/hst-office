+// HST: the category list of Format Cells in Sheets, in Excel's order. The Accounting row has no
+// SvxNumberFormatCategory value of its own: it works on the currency category.
+#define STR_HST_CAT_ACCOUNTING NC_("numberingformatpage|liststore1", "Accounting")
+
+namespace
+{
+const short CAT_ROW_ACCOUNTING = -1;
+const short aExcelCategoryRows[]
+    = { CAT_ALL,  CAT_NUMBER,  CAT_CURRENCY,   CAT_ROW_ACCOUNTING, CAT_DATE, CAT_TIME,
+        CAT_PERCENT, CAT_FRACTION, CAT_SCIENTIFIC, CAT_BOOLEAN,    CAT_TEXT, CAT_USERDEFINED };
+
+/// Excel's Accounting formats start with a space the width of a sign and fill up to the digits.
+bool lcl_IsAccountingFormat(std::u16string_view aFormat)
+{
+    return (o3tl::starts_with(aFormat, u"_-") || o3tl::starts_with(aFormat, u"_("))
+           && aFormat.find(u"* ") != std::u16string_view::npos;
+}
+
+/// The currency symbol of the first section of a currency format code, and whether it comes first.
+void lcl_GetCurrencySymbol(std::u16string_view aFormat, OUString& rSymbol, bool& rbPrefix)
+{
+    OUStringBuffer aSymbol;
+    bool bSeenDigit = false;
+    rbPrefix = false;
+    for (size_t i = 0; i < aFormat.size() && aFormat[i] != ';'; ++i)
+    {
+        const sal_Unicode c = aFormat[i];
+        if (c == '[' || c == '"')
+        {
+            const sal_Unicode cEnd = c == '[' ? ']' : '"';
+            size_t nEnd = aFormat.find(cEnd, i + 1);
+            if (nEnd == std::u16string_view::npos)
+                nEnd = aFormat.size() - 1;
+            if (!bSeenDigit)
+                rbPrefix = true;
+            aSymbol.append(aFormat.substr(i, nEnd - i + 1));
+            i = nEnd;
+        }
+        else if (c == '#' || c == '0' || c == '?')
+            bSeenDigit = true;
+        else if (c != '.' && c != ',' && c != ' ' && c != '-' && c != '\\')
+        {
+            if (!bSeenDigit)
+                rbPrefix = true;
+            aSymbol.append(c);
+        }
+    }
+    rSymbol = aSymbol.makeStringAndClear();
+}
+}
 
