+
+short SvxNumberFormatTabPage::GetSelectedCategory_Impl() const
+{
+    const int nRow = m_xLbCategory->get_selected_index();
+    if (!m_bExcelCategories || nRow < 0 || o3tl::make_unsigned(nRow) >= std::size(aExcelCategoryRows))
+        return nRow;
+    const short nValue = aExcelCategoryRows[nRow];
+    return nValue == CAT_ROW_ACCOUNTING ? short(CAT_CURRENCY) : nValue;
+}
+
+OUString SvxNumberFormatTabPage::GetUserDefinedLabel_Impl() const
+{
+    if (m_bExcelCategories)
+        return CuiResId(NUM_CATEGORIES[CAT_USERDEFINED]);
+    return m_xLbCategory->n_children() > 1 ? m_xLbCategory->get_text(1) : OUString();
+}
+
+bool SvxNumberFormatTabPage::IsAccountingRow_Impl() const
+{
+    if (!m_bExcelCategories)
+        return false;
+    const int nRow = m_xLbCategory->get_selected_index();
+    return nRow >= 0 && o3tl::make_unsigned(nRow) < std::size(aExcelCategoryRows)
+           && aExcelCategoryRows[nRow] == CAT_ROW_ACCOUNTING;
+}
+
+void SvxNumberFormatTabPage::ShowExcelCategories_Impl()
+{
+    if (m_bExcelCategories)
+        return;
+    m_bExcelCategories = true;
+    m_xLbCategory->freeze();
+    m_xLbCategory->clear();
+    for (short nValue : aExcelCategoryRows)
+        m_xLbCategory->append_text(CuiResId(nValue == CAT_ROW_ACCOUNTING
+                                                ? STR_HST_CAT_ACCOUNTING
+                                                : NUM_CATEGORIES[nValue]));
+    m_xLbCategory->thaw();
+}
+
+/// Accounting has no list of formats, as in Excel: the code follows the symbol and the decimals.
+void SvxNumberFormatTabPage::ShowAccountingList_Impl()
+{
+    const bool bAccounting = IsAccountingRow_Impl();
+    if (bAccounting)
+        m_xLbFormat->clear();
+    m_xLbFormat->set_sensitive(!bAccounting);
+}
+
+/// The minus sign, the symbol and the digits line up in the columns as Excel's Accounting does.
+void SvxNumberFormatTabPage::ApplyAccounting_Impl()
+{
+    OUString aSymbol;
+    bool bPrefix = false;
+    lcl_GetCurrencySymbol(pNumFmtShell->GetFormat4Entry(0), aSymbol, bPrefix);
+
+    const LocaleDataWrapper aLocale{ LanguageTag(pNumFmtShell->GetCurLanguage()) };
+    OUString sDigits = "#" + aLocale.getNumThousandSep() + "##0";
+    const sal_Int32 nDecimals = m_xEdDecimals->get_value();
+    if (nDecimals > 0)
+        sDigits += aLocale.getNumDecimalSep();
+    for (sal_Int32 i = 0; i < nDecimals; ++i)
+        sDigits += "0";
+
+    OUString aFormat;
+    if (bPrefix)
+        aFormat = "_-" + aSymbol + "* " + sDigits + "_-;-" + aSymbol + "* " + sDigits + "_-;_-"
+                  + aSymbol + "* \"-\"??_-;_-@_-";
+    else
+        aFormat = "_-* " + sDigits + " " + aSymbol + "_-;-* " + sDigits + " " + aSymbol + "_-;_-* \"-\"?? "
+                  + aSymbol + "_-;_-@_-";
+
+    m_xEdFormat->set_text(aFormat);
+    MakePreviewText(aFormat);
+    EditHdl_Impl(m_xEdFormat.get());
+    ShowAccountingList_Impl();
 }
 
