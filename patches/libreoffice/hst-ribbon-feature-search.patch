+namespace
+{
+// set by ShowFeatureSearch while it dispatches SID_COMMAND_POPUP
+sfx2::hst::FeatureSearchRequest g_aFeatureSearchRequest;
+
+// the search box of the ribbon tab row, a descendant of the notebookbar with this id
+vcl::Window* findFeatureSearchBox(vcl::Window* pWindow)
+{
+    for (vcl::Window* pChild = pWindow ? pWindow->GetWindow(GetWindowType::FirstChild) : nullptr;
+         pChild; pChild = pChild->GetWindow(GetWindowType::Next))
+    {
+        if (pChild->get_id() == u"hst-tab-search")
+            return pChild;
+        if (vcl::Window* pFound = findFeatureSearchBox(pChild))
+            return pFound;
+    }
+    return nullptr;
+}
+}
+
+sfx2::hst::FeatureSearchRequest sfx2::hst::TakeFeatureSearchRequest(vcl::Window& rViewWindow)
+{
+    FeatureSearchRequest aRequest = std::move(g_aFeatureSearchRequest);
+    g_aFeatureSearchRequest = FeatureSearchRequest();
+    if (!aRequest.xAnchor)
+    {
+        // Shift+Esc, Alt+Q: under the box when the ribbon shows it (it is hidden with no room)
+        SystemWindow* pSystem = rViewWindow.GetSystemWindow();
+        vcl::Window* pBox = pSystem && pSystem->GetNotebookBar()
+                                ? findFeatureSearchBox(pSystem->GetNotebookBar().get())
+                                : nullptr;
+        if (pBox && pBox->IsReallyVisible() && pBox->GetSizePixel().Width() > 0)
+            aRequest.xAnchor = pBox;
+    }
+    else if (aRequest.xAnchor->isDisposed() || !aRequest.xAnchor->IsReallyVisible())
+        aRequest.xAnchor.reset();
+    return aRequest;
+}
+
+void sfx2::hst::ShowFeatureSearch(vcl::Window* pAnchor, const OUString& rInitialText)
+{
+    // the view of the window that holds the box, else the current one
+    SfxViewFrame* pViewFrame = nullptr;
+    if (pAnchor)
+    {
+        for (SfxViewFrame* pFrame = SfxViewFrame::GetFirst(); pFrame && !pViewFrame;
+             pFrame = SfxViewFrame::GetNext(*pFrame))
+        {
+            if (pFrame->GetWindow().GetSystemWindow() == pAnchor->GetSystemWindow())
+                pViewFrame = pFrame;
+        }
+    }
+    if (!pViewFrame)
+        pViewFrame = SfxViewFrame::Current();
+    if (!pViewFrame)
+        return;
+    g_aFeatureSearchRequest = FeatureSearchRequest{ pAnchor, rInitialText };
+    pViewFrame->GetDispatcher()->Execute(SID_COMMAND_POPUP, SfxCallMode::SYNCHRON);
+    g_aFeatureSearchRequest = FeatureSearchRequest(); // not taken when the command is disabled
+}
