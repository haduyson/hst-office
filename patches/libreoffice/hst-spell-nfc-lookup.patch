 #define SPELL_NON_ASCII_APOSTROPHE 1 << 10
+
+// HST Office: the Hunspell dictionaries are stored composed (NFC), but text typed, pasted or
+// imported in decomposed form (a letter plus combining tone marks, usual for Vietnamese from the web,
+// PDF files and some input methods) would be looked up unchanged and reported as misspelled.
+// Returns the NFC form of the word, or the word itself when it is already composed.
+static OUString lcl_toNFC(const OUString& rWord)
+{
+    UErrorCode eErr = U_ZERO_ERROR;
+    const UNormalizer2* pNorm = unorm2_getNFCInstance(&eErr);
+    if (U_FAILURE(eErr) || !pNorm)
+        return rWord;
+    const UChar* pSrc = reinterpret_cast<const UChar*>(rWord.getStr());
+    if (unorm2_isNormalized(pNorm, pSrc, rWord.getLength(), &eErr) || U_FAILURE(eErr))
+        return rWord;
+    std::vector<UChar> aBuf(rWord.getLength() * 3 + 8);
+    eErr = U_ZERO_ERROR;
+    const int32_t nLen = unorm2_normalize(pNorm, pSrc, rWord.getLength(), aBuf.data(),
+                                          static_cast<int32_t>(aBuf.size()), &eErr);
+    if (U_FAILURE(eErr))
+        return rWord;
+    return OUString(reinterpret_cast<const sal_Unicode*>(aBuf.data()), nLen);
+}
