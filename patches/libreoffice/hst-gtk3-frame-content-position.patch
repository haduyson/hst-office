+// The frame geometry is that of the VCL content: its size is the size of the drawing area, and
+// UpdateGeometryFromEvent takes its position from the event box that mouse events report
+// against. A native menu bar sits above the event box inside the toplevel, so the toplevel's
+// position from a configure event is that far above the content. This offset (0 without a menu
+// bar) turns one into the other.
+void GtkSalFrame::GetContentOffset(int& rX, int& rY) const
+{
+    rX = rY = 0;
+    if (!GTK_IS_WINDOW(m_pWindow) || (m_nStyle & SalFrameStyleFlags::SYSTEMCHILD))
+        return;
+    gint nX(0), nY(0);
+    if (gtk_widget_translate_coordinates(getMouseEventWidget(), m_pWindow, 0, 0, &nX, &nY))
+    {
+        rX = nX;
+        rY = nY;
+    }
+}
+
+// The content moved inside the toplevel without the toplevel moving (the native menu bar was
+// added, shown or hidden): move the content position and the decoration hints with it.
+void GtkSalFrame::UpdateContentOffset()
+{
+    int nX, nY;
+    GetContentOffset(nX, nY);
+    const int nDeltaX = nX - m_nContentOffsetX, nDeltaY = nY - m_nContentOffsetY;
+    if (!nDeltaX && !nDeltaY)
+        return;
+    m_nContentOffsetX = nX;
+    m_nContentOffsetY = nY;
+    if (m_bGeometryIsProvisional) // the next configure event sets the position
+        return;
+    maGeometry.setPos({ maGeometry.x() + nDeltaX, maGeometry.y() + nDeltaY });
+    maGeometry.setLeftDecoration(std::max(0, static_cast<int>(maGeometry.leftDecoration()) + nDeltaX));
+    maGeometry.setTopDecoration(std::max(0, static_cast<int>(maGeometry.topDecoration()) + nDeltaY));
+    ImplSVData* pSVData = ImplGetSVData();
+    if (pSVData->maNWFData.mbCanDetermineWindowPosition)
+        CallCallbackExc(SalEvent::Move, nullptr);
+}
