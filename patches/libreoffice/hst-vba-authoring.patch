+bool DocxExport::WriteCurrentVBA()
+{
+    uno::Reference<frame::XModel> xModel(m_rDoc.GetDocShell() ? m_rDoc.GetDocShell()->GetModel() : nullptr);
+    uno::Reference<beans::XPropertySet> xProps(xModel, uno::UNO_QUERY);
+    if (!xProps.is())
+        return false;
+    uno::Reference<script::XLibraryContainer> xLibraries(xProps->getPropertyValue(u"BasicLibraries"_ustr), uno::UNO_QUERY);
+    uno::Reference<script::vba::XVBACompatibility> xVBA(xLibraries, uno::UNO_QUERY);
+    if (!xVBA.is() || !xVBA->getVBACompatibilityMode())
+        return false;
+    const OUString aProject = xVBA->getProjectName();
+    if (aProject.isEmpty() || !xLibraries->hasByName(aProject))
+        return false;
+    if (!xLibraries->isLibraryLoaded(aProject))
+        xLibraries->loadLibrary(aProject);
+    uno::Reference<container::XNameAccess> xLibrary(xLibraries->getByName(aProject), uno::UNO_QUERY);
+    if (!xLibrary.is() || !xLibrary->hasElements())
+        return false;
+
+    VbaExport aExport(xModel);
+    SvMemoryStream aVbaStream(4096, 4096);
+    {
+        rtl::Reference<SotStorage> xVBAStorage(new SotStorage(aVbaStream));
+        aExport.exportVBA(xVBAStorage.get());
+    }
+    aVbaStream.Seek(0);
+    uno::Reference<io::XOutputStream> xProjectStream
+        = GetFilter().openFragmentStream(u"word/vbaProject.bin"_ustr, u"application/vnd.ms-office.vbaProject"_ustr);
+    uno::Reference<io::XStream> xOutputStream(xProjectStream, uno::UNO_QUERY);
+    if (!xOutputStream.is())
+        return false;
+    {
+        std::unique_ptr<SvStream> pOut(utl::UcbStreamHelper::CreateStream(xOutputStream));
+        pOut->WriteStream(aVbaStream);
+    }
+    m_rFilter.addRelation(m_pDocumentFS->getOutputStream(), oox::getRelationship(Relationship::VBAPROJECT), u"vbaProject.bin");
+    // vbaData.xml (key bindings of the original project) is optional and would name stale macros: not written.
+    return true;
+}
