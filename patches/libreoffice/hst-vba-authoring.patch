+// HST: as in Word, the range is extended to include the inserted text.
+void SAL_CALL
+SwVbaRange::InsertBefore( const OUString& rText )
+{
+    const bool bCollapsed = mxTextCursor->isCollapsed();
+    uno::Reference< text::XTextRange > xEnd = mxTextCursor->getEnd();
+    uno::Reference< text::XTextCursor > xNew = mxText->createTextCursorByRange( mxTextCursor->getStart() );
+    xNew->collapseToStart();
+    mxText->insertString( xNew, rText, true );
+    mxTextCursor->gotoRange( xNew->getStart(), false );
+    mxTextCursor->gotoRange( bCollapsed ? xNew->getEnd() : xEnd, true );
+}
+
+void SAL_CALL
+SwVbaRange::InsertAfter( const OUString& rText )
+{
+    const bool bCollapsed = mxTextCursor->isCollapsed();
+    uno::Reference< text::XTextRange > xStart = mxTextCursor->getStart();
+    uno::Reference< text::XTextCursor > xNew = mxText->createTextCursorByRange( mxTextCursor->getEnd() );
+    xNew->collapseToEnd();
+    mxText->insertString( xNew, rText, true );
+    mxTextCursor->gotoRange( bCollapsed ? xNew->getStart() : xStart, false );
+    mxTextCursor->gotoRange( xNew->getEnd(), true );
+}
