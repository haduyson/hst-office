+namespace
+{
+/// HST: true when the stored original VBA project carries UserForms (designer storages besides
+/// "VBA"), which oox::ole::VbaExport cannot write; such a project is saved back unchanged.
+bool lcl_hasVbaDesignerStorages(const uno::Reference<io::XStream>& xMacrosStream)
+{
+    std::unique_ptr<SvStream> pIn(utl::UcbStreamHelper::CreateStream(xMacrosStream));
+    if (!pIn)
+        return true;
+    rtl::Reference<SotStorage> xStorage(new SotStorage(*pIn));
+    if (xStorage->GetError())
+        return true;
+    SvStorageInfoList aElements;
+    xStorage->FillInfoList(&aElements);
+    for (const SvStorageInfo& rElement : aElements)
+        if (rElement.IsStorage() && rElement.GetName() != "VBA")
+            return true;
+    return false;
+}
+}
