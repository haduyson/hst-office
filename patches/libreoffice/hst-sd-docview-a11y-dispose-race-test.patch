+
+// Accessibility clients (AT-SPI through the gtk3 bridge) call into the document view's accessible
+// object from the main loop without holding the SolarMutex, while another thread that holds it (a
+// UNO client closing the document) may be disposing it. A call made meanwhile must wait for the
+// SolarMutex before its disposed check and then throw DisposedException, instead of running on
+// against a disposed view under the object's own mutex only.
+
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <future>
+#include <thread>
+
+#include <com/sun/star/accessibility/XAccessibleComponent.hpp>
+#include <com/sun/star/accessibility/XAccessibleContext.hpp>
+#include <com/sun/star/lang/DisposedException.hpp>
+#include <com/sun/star/lang/XComponent.hpp>
+#include <com/sun/star/lang/XServiceInfo.hpp>
+
+#include <vcl/scheduler.hxx>
+#include <vcl/svapp.hxx>
+
+#include <test/a11y/accessibletestbase.hxx>
+
+using namespace css;
+
+namespace
+{
+class HstDocumentViewDisposeRace : public test::AccessibleTestBase
+{
+protected:
+    uno::Reference<accessibility::XAccessibleContext> loadDrawDocumentView()
+    {
+        load(u"private:factory/sdraw"_ustr);
+        Scheduler::ProcessEventsToIdle();
+        uno::Reference<accessibility::XAccessibleContext> xView = getDocumentAccessibleContext();
+        CPPUNIT_ASSERT_MESSAGE("no accessible Draw document view", xView.is());
+        uno::Reference<lang::XServiceInfo> xInfo(xView, uno::UNO_QUERY_THROW);
+        CPPUNIT_ASSERT_EQUAL(u"AccessibleDrawDocumentView"_ustr, xInfo->getImplementationName());
+        return xView;
+    }
+
+    /** Runs rCall on another thread while this thread holds the SolarMutex, disposes the document
+        view's accessible once the call is underway, and returns whether the call ended with
+        DisposedException (any other outcome, a result or another exception, counts as false). */
+    template <typename F>
+    bool disposedWhileWaiting(const uno::Reference<accessibility::XAccessibleContext>& xView,
+                              F rCall)
+    {
+        SolarMutexGuard aGuard;
+        std::atomic<bool> bStarted(false);
+        bool bDisposed = false;
+        std::promise<void> aDone;
+        std::future<void> aFinished = aDone.get_future();
+        std::thread aReader([&] {
+            bStarted = true;
+            try
+            {
+                rCall();
+            }
+            catch (const lang::DisposedException&)
+            {
+                bDisposed = true;
+            }
+            catch (...)
+            {
+            }
+            aDone.set_value();
+        });
+        while (!bStarted)
+            std::this_thread::yield();
+        // the reader is now inside the call; a correct implementation waits for the SolarMutex
+        std::this_thread::sleep_for(std::chrono::milliseconds(300));
+        // A reader holding the view's own mutex while it waits for the SolarMutex deadlocks
+        // against dispose(), which this thread runs with the SolarMutex held: either side may be
+        // the one stuck. A separate watchdog ends the run with a message instead of hanging.
+        std::promise<void> aSequenceDone;
+        std::future<void> aSequenceFinished = aSequenceDone.get_future();
+        std::thread aWatchdog([&aSequenceFinished] {
+            if (aSequenceFinished.wait_for(std::chrono::seconds(20)) != std::future_status::ready)
+            {
+                std::fprintf(stderr, "HstDocumentViewDisposeRace: dispose() and the waiting call "
+                                     "are still blocked after 20 s: deadlock between the view's "
+                                     "own mutex and the SolarMutex\n");
+                std::fflush(stderr);
+                std::_Exit(1);
+            }
+        });
+        uno::Reference<lang::XComponent>(xView, uno::UNO_QUERY_THROW)->dispose();
+        {
+            SolarMutexReleaser aReleaser;
+            aFinished.wait();
+            aReader.join();
+        }
+        aSequenceDone.set_value();
+        aWatchdog.join();
+        return bDisposed;
+    }
+};
+}
+
+CPPUNIT_TEST_FIXTURE(HstDocumentViewDisposeRace, testChildCountAfterDisposeWhileWaiting)
+{
+    auto xView = loadDrawDocumentView();
+    CPPUNIT_ASSERT(xView->getAccessibleChildCount() > 0);
+
+    CPPUNIT_ASSERT_MESSAGE("getAccessibleChildCount on a document view disposed while it waited",
+                           disposedWhileWaiting(xView, [&] { xView->getAccessibleChildCount(); }));
+}
+
+CPPUNIT_TEST_FIXTURE(HstDocumentViewDisposeRace, testChildAfterDisposeWhileWaiting)
+{
+    auto xView = loadDrawDocumentView();
+    CPPUNIT_ASSERT(xView->getAccessibleChild(0).is());
+
+    CPPUNIT_ASSERT_MESSAGE("getAccessibleChild on a document view disposed while it waited",
+                           disposedWhileWaiting(xView, [&] { xView->getAccessibleChild(0); }));
+}
+
+CPPUNIT_TEST_FIXTURE(HstDocumentViewDisposeRace, testAtPointAfterDisposeWhileWaiting)
+{
+    auto xView = loadDrawDocumentView();
+    uno::Reference<accessibility::XAccessibleComponent> xComponent(xView, uno::UNO_QUERY_THROW);
+
+    CPPUNIT_ASSERT_MESSAGE(
+        "getAccessibleAtPoint on a document view disposed while it waited",
+        disposedWhileWaiting(xView, [&] { xComponent->getAccessibleAtPoint(awt::Point(1, 1)); }));
+}
+
+CPPUNIT_TEST_FIXTURE(HstDocumentViewDisposeRace, testBackgroundAfterDisposeWhileWaiting)
+{
+    auto xView = loadDrawDocumentView();
+    uno::Reference<accessibility::XAccessibleComponent> xComponent(xView, uno::UNO_QUERY_THROW);
+
+    CPPUNIT_ASSERT_MESSAGE("getBackground on a document view disposed while it waited",
+                           disposedWhileWaiting(xView, [&] { xComponent->getBackground(); }));
+}
+
