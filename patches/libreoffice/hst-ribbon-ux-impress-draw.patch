+#. hstUX
+#: sd/uiconfig/simpress/ui/notebookbar.ui
+msgctxt "TabbedDraw|hstUXExportTabLabel"
+msgid "P~DF"
+msgstr "P~DF"
+
+#. hstUX
+#: sd/uiconfig/simpress/ui/notebookbar.ui
+msgctxt "TabbedImpress|hstRibbonDescription"
+msgid "Add a comment about the selection."
+msgstr "Thêm chú thích cho nội dung đang chọn."
+
+#. hstUX
+#: sd/uiconfig/simpress/ui/notebookbar.ui
+msgctxt "TabbedImpress|hstRibbonDescription"
+msgid "Add a slide after the current one; the arrow offers layouts and Duplicate Slide."
+msgstr "Thêm trang chiếu sau trang hiện tại; mũi tên mở các bố trí và Nhân đôi trang chiếu."
+
+#. hstUX
+#: sd/uiconfig/simpress/ui/notebookbar.ui
+msgctxt "TabbedImpress|hstRibbonDescription"
+msgid "Bring the selected objects forward or send them back."
+msgstr "Đưa đối tượng đang chọn lên trước hoặc ra sau các đối tượng khác."
+
+#. hstUX
+#: sd/uiconfig/simpress/ui/notebookbar.ui
+msgctxt "TabbedImpress|hstRibbonDescription"
+msgid "Center the paragraph."
+msgstr "Căn giữa đoạn văn."
+
+#. hstUX
+#: sd/uiconfig/simpress/ui/notebookbar.ui
+msgctxt "TabbedImpress|hstRibbonDescription"
+msgid "Change the color of the selected text."
+msgstr "Đổi màu chữ đang chọn."
+
+#. hstUX
+#: sd/uiconfig/simpress/ui/notebookbar.ui
+msgctxt "TabbedImpress|hstRibbonDescription"
+msgid "Change the color of the shape's outline."
+msgstr "Đổi màu viền của hình đang chọn."
+
+#. hstUX
+#: sd/uiconfig/simpress/ui/notebookbar.ui
+msgctxt "TabbedImpress|hstRibbonDescription"
+msgid "Change the size and orientation of the slides."
+msgstr "Đổi kích cỡ và hướng của trang chiếu."
+
+#. hstUX
+#: sd/uiconfig/simpress/ui/notebookbar.ui
+msgctxt "TabbedImpress|hstRibbonDescription"
+msgid "Change the size of the selected text."
+msgstr "Đổi cỡ chữ của chữ đang chọn."
+
+#. hstUX
+#: sd/uiconfig/simpress/ui/notebookbar.ui
+msgctxt "TabbedImpress|hstRibbonDescription"
+msgid "Change the space between lines of text."
+msgstr "Đổi khoảng cách giữa các dòng chữ."
+
+#. hstUX
+#: sd/uiconfig/simpress/ui/notebookbar.ui
+msgctxt "TabbedImpress|hstRibbonDescription"
+msgid "Check the spelling of the document."
+msgstr "Kiểm tra chính tả của tài liệu."
+
+#. hstUX
+#: sd/uiconfig/simpress/ui/notebookbar.ui
+msgctxt "TabbedImpress|hstRibbonDescription"
+msgid "Choose a font for the selected text."
+msgstr "Chọn phông chữ cho chữ đang chọn."
+
+#. hstUX
+#: sd/uiconfig/simpress/ui/notebookbar.ui
+msgctxt "TabbedImpress|hstRibbonDescription"
+msgid "Choose how the selected object appears."
+msgstr "Chọn cách đối tượng đang chọn xuất hiện."
+
+#. hstUX
+#: sd/uiconfig/simpress/ui/notebookbar.ui
+msgctxt "TabbedImpress|hstRibbonDescription"
+msgid "Choose how titles and content are placed on the selected slides."
+msgstr "Chọn cách đặt tiêu đề và nội dung trên các trang chiếu đang chọn."
+
+#. hstUX
+#: sd/uiconfig/simpress/ui/notebookbar.ui
+msgctxt "TabbedImpress|hstRibbonDescription"
+msgid "Choose the PDF settings, then export."
+msgstr "Chọn thiết lập PDF rồi xuất."
+
+#. hstUX
+#: sd/uiconfig/simpress/ui/notebookbar.ui
+msgctxt "TabbedImpress|hstRibbonDescription"
+msgid "Choose the effect shown when this slide appears."
+msgstr "Chọn hiệu ứng khi trang chiếu này xuất hiện."
+
+#. hstUX
+#: sd/uiconfig/simpress/ui/notebookbar.ui
+msgctxt "TabbedImpress|hstRibbonDescription"
+msgid "Copy the formatting of the selection and apply it to other text or objects."
+msgstr "Chép định dạng của vùng chọn rồi bấm vào chữ hoặc đối tượng khác để áp dụng."
+
+#. hstUX
+#: sd/uiconfig/simpress/ui/notebookbar.ui
+msgctxt "TabbedImpress|hstRibbonDescription"
+msgid "Digitally sign an existing PDF file."
+msgstr "Ký số một tệp PDF có sẵn."
+
+#. hstUX
+#: sd/uiconfig/simpress/ui/notebookbar.ui
+msgctxt "TabbedImpress|hstRibbonDescription"
+msgid "Draw a text box anywhere on the page."
+msgstr "Vẽ một hộp văn bản ở chỗ bất kỳ trên trang."
+
+#. hstUX
+#: sd/uiconfig/simpress/ui/notebookbar.ui
+msgctxt "TabbedImpress|hstRibbonDescription"
+msgid "Edit one slide with the slide pane beside it."
+msgstr "Soạn từng trang chiếu, có ngăn trang chiếu bên cạnh."
+
+#. hstUX
+#: sd/uiconfig/simpress/ui/notebookbar.ui
+msgctxt "TabbedImpress|hstRibbonDescription"
+msgid "Edit the design shared by the pages."
+msgstr "Sửa thiết kế dùng chung cho các trang."
+
+#. hstUX
+#: sd/uiconfig/simpress/ui/notebookbar.ui
+msgctxt "TabbedImpress|hstRibbonDescription"
+msgid "Edit the design shared by the slides."
+msgstr "Sửa thiết kế dùng chung cho các trang chiếu."
+
+#. hstUX
+#: sd/uiconfig/simpress/ui/notebookbar.ui
+msgctxt "TabbedImpress|hstRibbonDescription"
+msgid "Edit the pages of the drawing."
+msgstr "Soạn các trang của bản vẽ."
+
+#. hstUX
+#: sd/uiconfig/simpress/ui/notebookbar.ui
+msgctxt "TabbedImpress|hstRibbonDescription"
+msgid "Fill the selected shape with a color."
+msgstr "Tô màu bên trong hình đang chọn."
+
+#. hstUX
+#: sd/uiconfig/simpress/ui/notebookbar.ui
+msgctxt "TabbedImpress|hstRibbonDescription"
+msgid "Find text and replace it with other text."
+msgstr "Tìm chữ và thay bằng chữ khác."
+
+#. hstUX
+#: sd/uiconfig/simpress/ui/notebookbar.ui
+msgctxt "TabbedImpress|hstRibbonDescription"
+msgid "Find text in the document."
+msgstr "Tìm chữ trong tài liệu."
+
+#. hstUX
+#: sd/uiconfig/simpress/ui/notebookbar.ui
+msgctxt "TabbedImpress|hstRibbonDescription"
+msgid "Give every slide the transition, duration and sound of this slide."
+msgstr "Áp dụng hiệu ứng, thời lượng và âm thanh chuyển tiếp của trang này cho mọi trang chiếu."
+
+#. hstUX
+#: sd/uiconfig/simpress/ui/notebookbar.ui
+msgctxt "TabbedImpress|hstRibbonDescription"
+msgid "Go to the next slide by itself after the given time."
+msgstr "Tự chuyển sang trang chiếu kế tiếp sau thời gian đã đặt."
+
+#. hstUX
+#: sd/uiconfig/simpress/ui/notebookbar.ui
+msgctxt "TabbedImpress|hstRibbonDescription"
+msgid "How long the transition lasts, in seconds."
+msgstr "Thời lượng của hiệu ứng chuyển tiếp, tính bằng giây."
+
+#. hstUX
+#: sd/uiconfig/simpress/ui/notebookbar.ui
+msgctxt "TabbedImpress|hstRibbonDescription"
+msgid "Insert a chart."
+msgstr "Chèn biểu đồ."
+
+#. hstUX
+#: sd/uiconfig/simpress/ui/notebookbar.ui
+msgctxt "TabbedImpress|hstRibbonDescription"
+msgid "Insert a picture from a file."
+msgstr "Chèn ảnh từ tệp."
+
+#. hstUX
+#: sd/uiconfig/simpress/ui/notebookbar.ui
+msgctxt "TabbedImpress|hstRibbonDescription"
+msgid "Insert a table."
+msgstr "Chèn một bảng."
+
+#. hstUX
+#: sd/uiconfig/simpress/ui/notebookbar.ui
+msgctxt "TabbedImpress|hstRibbonDescription"
+msgid "Insert an audio or video file."
+msgstr "Chèn tệp âm thanh hoặc video."
+
+#. hstUX
+#: sd/uiconfig/simpress/ui/notebookbar.ui
+msgctxt "TabbedImpress|hstRibbonDescription"
+msgid "Insert decorative text."
+msgstr "Chèn chữ trang trí."
+
+#. hstUX
+#: sd/uiconfig/simpress/ui/notebookbar.ui
+msgctxt "TabbedImpress|hstRibbonDescription"
+msgid "Insert slides from another presentation."
+msgstr "Chèn trang chiếu từ một bản trình chiếu khác."
+
+#. hstUX
+#: sd/uiconfig/simpress/ui/notebookbar.ui
+msgctxt "TabbedImpress|hstRibbonDescription"
+msgid "Insert the contents of the clipboard."
+msgstr "Chèn nội dung đã sao chép hoặc cắt."
+
+#. hstUX
+#: sd/uiconfig/simpress/ui/notebookbar.ui
+msgctxt "TabbedImpress|hstRibbonDescription"
+msgid "Line up the selected objects."
+msgstr "Căn các đối tượng đang chọn theo cạnh hoặc theo giữa."
+
+#. hstUX
+#: sd/uiconfig/simpress/ui/notebookbar.ui
+msgctxt "TabbedImpress|hstRibbonDescription"
+msgid "Link to a web page, a file or another slide."
+msgstr "Liên kết tới trang web, tệp hoặc trang chiếu khác."
+
+#. hstUX
+#: sd/uiconfig/simpress/ui/notebookbar.ui
+msgctxt "TabbedImpress|hstRibbonDescription"
+msgid "Make a copy with the content you mark blacked out for good."
+msgstr "Tạo bản sao có phần nội dung đã đánh dấu bị che kín hoàn toàn."
+
+#. hstUX
