+void WorksheetFragment::importHstIgnoredError( const AttributeList& rAttribs )
+{
+    // HST: cells where "Ignore Error" was chosen for a number stored as text (no triangle, no button)
+    if( !rAttribs.getBool( XML_numberStoredAsText, false ) )
+        return;
+    ScRangeList aRanges;
+    getAddressConverter().convertToCellRangeList( aRanges, rAttribs.getString( XML_sqref, OUString() ), getSheetIndex(), true );
+    if( !aRanges.empty() )
+        getScDocument().GetHstIgnoredTextNumbers().Add( aRanges );
+}
