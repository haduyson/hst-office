+/// HST: <ignoredErrors> with the cells of a sheet where "Ignore Error" was chosen for a number stored as text.
+class XclExpHstIgnoredErrors : public XclExpRecordBase, protected XclExpRoot
+{
+public:
+    XclExpHstIgnoredErrors( const XclExpRoot& rRoot, SCTAB nScTab ) : XclExpRoot( rRoot )
+    {
+        if( ScHstIgnoredTextNumbers* pIgnored = GetDoc().GetHstIgnoredTextNumbersIfAny() )
+        {
+            ScRangeList aRanges = pIgnored->GetRanges( nScTab );
+            GetAddressConverter().ConvertRangeList( maRanges, aRanges, false );
+        }
+    }
+    virtual void SaveXml( XclExpXmlStream& rStrm ) override
+    {
+        if( maRanges.empty() )
+            return;
+        sax_fastparser::FSHelperPtr& rWorksheet = rStrm.GetCurrentStream();
+        rWorksheet->startElement( XML_ignoredErrors );
+        rWorksheet->singleElement( XML_ignoredError, XML_sqref, XclXmlUtils::ToOString( GetDoc(), maRanges ),
+                                   XML_numberStoredAsText, "1" );
+        rWorksheet->endElement( XML_ignoredErrors );
+    }
+private:
+    XclRangeList maRanges;
+};
+
