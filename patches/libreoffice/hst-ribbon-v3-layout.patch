+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ */
+
+#pragma once
+
+// HST Office: a ribbon group of the 1.0.3 (v3) design, a VclGrid whose .ui gives it the property
+// "hst-ribbon-layout" (scripts/patches/generate-ribbon-v3-ui.py): its children are its commands (one each, in order),
+// its caption (a label, or the box of the label and the dialog launcher) and its separator. The grid then lays its
+// children out by HstRibbonV3Pack.hxx instead of by its cells: the commands in blocks from the left of the content
+// (76 logical px high, 6 px under the group's top), the caption band (18 px, 4 px under the content), the separator at
+// the right edge. PriorityMergedHBox chooses every group's configuration for the width of its tab (the mockup's fit()).
+
+#include <rtl/ustring.hxx>
+#include <rtl/strbuf.hxx>
+#include <tools/gen.hxx>
+#include <tools/long.hxx>
+
+namespace vcl
+{
+class Window;
+}
+
+namespace hst::ribbon::v3
+{
+/// How a group shows: its state (L full, M medium, S small), whether the sparse tab's fill pass made it large, its
+/// gallery's state (L, M, S: 5/4/3 tiles), the tiles a sparse tab adds to it at L, and the tab's one large-button
+/// width in device px (0: natural widths)
+struct Config
+{
+    char state = 'L';
+    bool big = false;
+    char gallery = 'L';
+    int extra = 0;
+    tools::Long largeWidth = 0;
+    bool operator==(const Config&) const = default;
+};
+
+/// VclGrid::set_property("hst-ribbon-layout"): remembers the group's layout
+void SetSpec(const vcl::Window& rGrid, const OUString& rValue);
+
+/// rGroup is a v3 group: a grid with a valid layout whose commands match its children
+bool IsGroup(const vcl::Window& rGroup);
+
+/// VclGrid::calculateRequisition and setAllocation of a v3 group
+Size Requisition(const vcl::Window& rGrid);
+void Allocate(vcl::Window& rGrid, const Size& rSize);
+
+/// the group's current configuration, and a new one (applies the looks of its commands)
+Config Current(const vcl::Window& rGroup);
+void Apply(vcl::Window& rGroup, const Config& rConfig);
+
+/// the width in device px the group takes at rConfig (padding included), without changing it
+tools::Long Width(vcl::Window& rGroup, const Config& rConfig);
+
+/// the widest natural width in device px of the group's large buttons at rConfig, 0 when it shows none
+tools::Long LargeNatural(vcl::Window& rGroup, const Config& rConfig);
+
+/// the sparse tab's fill pass may make the group large (it has small commands, no box, no fixed rows, is not the
+/// clipboard and not marked nofill); it holds a gallery
+bool Fillable(const vcl::Window& rGroup);
+bool HasGallery(const vcl::Window& rGroup);
+
+/// the natural widths of the group's commands are measured again (fonts, scale, theme)
+void Forget(const vcl::Window& rGroup);
+
+/// the group as a JSON object for the layout dump (tests/runtime/ribbon_v3_rules.py), rects in device px relative to
+/// rOrigin; cState: the state to write ('C' for a group shown as its button, rFold its rectangle)
+void Dump(const vcl::Window& rGroup, const vcl::Window& rOrigin, char cState, const tools::Rectangle& rFold,
+          OStringBuffer& rOut);
+}
