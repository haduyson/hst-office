+// HST Office: the text metrics of the ribbon's menu buttons as their paint draws them. The ribbon lays a menu button
+// out from its label's width and height; on Windows at 125 % the button's window measured a smaller font than the
+// one its paint draws with, so the label lost its end ("Sắp xếp và l…") or its second line ("Bám …"). The paint
+// tells what it drew with (MenuButtonPainted); the layout measures with that from then on and lays out again once.
+
+#include <rtl/ustring.hxx>
+#include <sal/types.h>
+#include <tools/gen.hxx>
+#include <tools/long.hxx>
+
+class OutputDevice;
+class PushButton;
+
+namespace hst::ribbon
+{
+/** Called by PushButton's paint (button.cxx) with the device it draws on and its content rectangle, before it lays
+    its image and label out with the image-text gap rImageSep. A menu button of a v3 group remembers the paint's
+    metrics of its label, and when they differ from what its layout measured, the ribbon lays it out again. A large
+    one (image above a label of lines) gets a gap its lines fit under, not less than 1 px; a medium one whose font is
+    taller than its content draws over its frame's inner edge. Any other button: nothing. */
+void MenuButtonPainted(PushButton& rButton, OutputDevice& rDev, const tools::Rectangle& rInner,
+                       sal_Int32& rImageSep);
+
+/** The width of rText (no mnemonic) as rButton's paint draws it; its window's measure before its first paint. */
+tools::Long MenuButtonTextWidth(const PushButton& rButton, const OUString& rText);
+
+/** The height of a line of rButton's label as its paint draws it; its window's measure before its first paint. */
+tools::Long MenuButtonTextHeight(const PushButton& rButton);
+}
