+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ */
+
+// The update dot of the ribbon's File button follows the status of org.hst.office.update:Available, with fakes
+// for the frame (a dispatch provider) and the extension's handler (a dispatch that reports a status).
+
+#include <test/bootstrapfixture.hxx>
+
+#include <notebookbar/HstUpdateDot.hxx>
+
+#include <com/sun/star/frame/FeatureStateEvent.hpp>
+#include <com/sun/star/frame/XDispatch.hpp>
+#include <com/sun/star/frame/XDispatchProvider.hpp>
+#include <cppuhelper/implbase.hxx>
+#include <rtl/ref.hxx>
+
+#include <algorithm>
+#include <vector>
+
+using namespace css;
+
+namespace
+{
+/// the extension's handler: answers addStatusListener with its status, as the real one does
+class FakeDispatch final : public cppu::WeakImplHelper<frame::XDispatch>
+{
+public:
+    explicit FakeDispatch(bool bAvailable)
+        : mbAvailable(bAvailable)
+    {
+    }
+    void report(bool bAvailable)
+    {
+        mbAvailable = bAvailable;
+        const auto aListeners = maListeners;
+        for (const auto& xListener : aListeners)
+            xListener->statusChanged(event());
+    }
+    std::size_t listeners() const { return maListeners.size(); }
+    OUString maAsked;
+
+    void SAL_CALL dispatch(const util::URL&, const uno::Sequence<beans::PropertyValue>&) override {}
+    void SAL_CALL addStatusListener(const uno::Reference<frame::XStatusListener>& xListener,
+                                    const util::URL& rURL) override
+    {
+        maAsked = rURL.Complete;
+        maListeners.push_back(xListener);
+        xListener->statusChanged(event());
+    }
+    void SAL_CALL removeStatusListener(const uno::Reference<frame::XStatusListener>& xListener,
+                                       const util::URL&) override
+    {
+        maListeners.erase(std::remove(maListeners.begin(), maListeners.end(), xListener), maListeners.end());
+    }
+
+private:
+    frame::FeatureStateEvent event() const
+    {
+        frame::FeatureStateEvent aEvent;
+        aEvent.FeatureURL.Complete = hst::notebookbar::UPDATE_AVAILABLE_URL;
+        aEvent.IsEnabled = mbAvailable;
+        return aEvent;
+    }
+    bool mbAvailable;
+    std::vector<uno::Reference<frame::XStatusListener>> maListeners;
+};
+
+/// the document's frame: provides the handler's dispatch for the command, or none (no handler)
+class FakeFrame final : public cppu::WeakImplHelper<frame::XDispatchProvider>
+{
+public:
+    explicit FakeFrame(rtl::Reference<FakeDispatch> xDispatch)
+        : mxDispatch(std::move(xDispatch))
+    {
+    }
+    uno::Reference<frame::XDispatch> SAL_CALL queryDispatch(const util::URL& rURL, const OUString&,
+                                                            sal_Int32) override
+    {
+        if (rURL.Complete != hst::notebookbar::UPDATE_AVAILABLE_URL)
+            return {};
+        return mxDispatch;
+    }
+    uno::Sequence<uno::Reference<frame::XDispatch>>
+        SAL_CALL queryDispatches(const uno::Sequence<frame::DispatchDescriptor>&) override
+    {
+        return {};
+    }
+
+private:
+    rtl::Reference<FakeDispatch> mxDispatch;
+};
+
+class HstUpdateDotTest : public test::BootstrapFixture
+{
+protected:
+    std::vector<bool> maShown;
+    rtl::Reference<hst::notebookbar::UpdateDot> dot()
+    {
+        return new hst::notebookbar::UpdateDot([this](bool bShow) { maShown.push_back(bShow); });
+    }
+};
+
+CPPUNIT_TEST_FIXTURE(HstUpdateDotTest, testShowsWhileAnUpdateIsKnown)
+{
+    rtl::Reference<FakeDispatch> xHandler(new FakeDispatch(true));
+    rtl::Reference<hst::notebookbar::UpdateDot> xDot = dot();
+    xDot->SetFrame(new FakeFrame(xHandler));
+    CPPUNIT_ASSERT_EQUAL(hst::notebookbar::UPDATE_AVAILABLE_URL, xHandler->maAsked);
+    CPPUNIT_ASSERT_EQUAL(std::size_t(1), maShown.size());
+    CPPUNIT_ASSERT(maShown[0]);
+    xHandler->report(false); // a later check finds no newer release
+    xHandler->report(true);
+    CPPUNIT_ASSERT_EQUAL(std::size_t(3), maShown.size());
+    CPPUNIT_ASSERT(!maShown[1]);
+    CPPUNIT_ASSERT(maShown[2]);
+    xDot->Stop();
+    CPPUNIT_ASSERT_EQUAL(std::size_t(0), xHandler->listeners());
+    xHandler->report(false); // nothing reaches a stopped dot
+    CPPUNIT_ASSERT_EQUAL(std::size_t(3), maShown.size());
+}
+
+CPPUNIT_TEST_FIXTURE(HstUpdateDotTest, testNoHandlerNoDot)
+{
+    rtl::Reference<hst::notebookbar::UpdateDot> xDot = dot();
+    xDot->SetFrame(new FakeFrame(nullptr));
+    CPPUNIT_ASSERT_EQUAL(std::size_t(1), maShown.size());
+    CPPUNIT_ASSERT(!maShown[0]);
+    xDot->SetFrame(nullptr);
+    CPPUNIT_ASSERT_EQUAL(std::size_t(2), maShown.size());
+    CPPUNIT_ASSERT(!maShown[1]);
+    xDot->Stop();
+}
+
+CPPUNIT_TEST_FIXTURE(HstUpdateDotTest, testNewFrameLeavesTheOldHandler)
+{
+    rtl::Reference<FakeDispatch> xOld(new FakeDispatch(true));
+    rtl::Reference<FakeDispatch> xNew(new FakeDispatch(false));
+    rtl::Reference<hst::notebookbar::UpdateDot> xDot = dot();
+    uno::Reference<frame::XDispatchProvider> xFrame(new FakeFrame(xOld));
+    xDot->SetFrame(xFrame);
+    xDot->SetFrame(xFrame); // the same frame again: no second listener
+    CPPUNIT_ASSERT_EQUAL(std::size_t(1), xOld->listeners());
+    xDot->SetFrame(new FakeFrame(xNew));
+    CPPUNIT_ASSERT_EQUAL(std::size_t(0), xOld->listeners());
+    CPPUNIT_ASSERT_EQUAL(std::size_t(1), xNew->listeners());
+    CPPUNIT_ASSERT_EQUAL(std::size_t(2), maShown.size());
+    CPPUNIT_ASSERT(maShown[0]);
+    CPPUNIT_ASSERT(!maShown[1]);
+    xDot->Stop();
+}
+
+CPPUNIT_TEST_FIXTURE(HstUpdateDotTest, testHandlerGoneHidesTheDot)
+{
+    rtl::Reference<FakeDispatch> xHandler(new FakeDispatch(true));
+    rtl::Reference<hst::notebookbar::UpdateDot> xDot = dot();
+    xDot->SetFrame(new FakeFrame(xHandler));
+    const lang::EventObject aEvent(static_cast<cppu::OWeakObject*>(xHandler.get()));
+    xDot->disposing(aEvent);
+    CPPUNIT_ASSERT_EQUAL(std::size_t(2), maShown.size());
+    CPPUNIT_ASSERT(!maShown[1]);
+    xDot->Stop();
+}
+}
+
+CPPUNIT_PLUGIN_IMPLEMENT();
