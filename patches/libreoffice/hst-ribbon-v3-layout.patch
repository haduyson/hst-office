+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ */
+
+#pragma once
+
+// HST Office: the update dot of the ribbon's File button. The HST extension's status command
+// org.hst.office.update:Available is enabled while a newer release is known; UpdateDot listens to it on the
+// document's frame and tells its owner (the ribbon's tab control, vcl/HstRibbonUpdateDot.hxx) to show or hide
+// the dot. Without the command (no handler, an older extension) or after any failure there is no dot.
+
+#include <sfx2/dllapi.h>
+#include <com/sun/star/frame/XDispatch.hpp>
+#include <com/sun/star/frame/XDispatchProvider.hpp>
+#include <com/sun/star/frame/XStatusListener.hpp>
+#include <com/sun/star/util/URL.hpp>
+#include <cppuhelper/implbase.hxx>
+#include <rtl/ustring.hxx>
+
+#include <functional>
+
+namespace hst::notebookbar
+{
+inline constexpr OUString UPDATE_AVAILABLE_URL = u"org.hst.office.update:Available"_ustr;
+
+class SFX2_DLLPUBLIC UpdateDot final : public cppu::WeakImplHelper<css::frame::XStatusListener>
+{
+public:
+    /** aShow(true) shows the dot, aShow(false) hides it; called on the main thread with the SolarMutex held. */
+    explicit UpdateDot(std::function<void(bool)> aShow);
+
+    /** Listen to the update status of the dispatch xFrame (the document's frame) provides for the command (the same
+        frame again: nothing changes). No dispatch for the command: no dot. */
+    void SetFrame(const css::uno::Reference<css::frame::XDispatchProvider>& xFrame);
+
+    /** Stop listening and forget the owner: no call of aShow after this. */
+    void Stop();
+
+    // XStatusListener
+    virtual void SAL_CALL statusChanged(const css::frame::FeatureStateEvent& rEvent) override;
+    // XEventListener
+    virtual void SAL_CALL disposing(const css::lang::EventObject& rEvent) override;
+
+private:
+    void show(bool bShow);
+    void stopListening();
+
+    std::function<void(bool)> maShow;
+    css::uno::Reference<css::frame::XDispatchProvider> mxFrame;
+    css::uno::Reference<css::frame::XDispatch> mxDispatch;
+    css::util::URL maURL;
+};
+}
