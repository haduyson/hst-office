+void UpdateDot::SetFrame(const uno::Reference<frame::XDispatchProvider>& xFrame)
+{
+    if (xFrame == mxFrame)
+        return;
+    stopListening();
+    mxFrame = xFrame;
+    bool bListening = false;
+    try
+    {
+        uno::Reference<util::XURLTransformer> xTransformer
+            = util::URLTransformer::create(comphelper::getProcessComponentContext());
+        xTransformer->parseStrict(maURL);
+        if (xFrame.is())
+            mxDispatch = xFrame->queryDispatch(maURL, OUString(), 0);
+        if (mxDispatch.is())
+        {
+            // the handler answers at once with the current status, then whenever a check finds an update or none
+            mxDispatch->addStatusListener(this, maURL);
+            bListening = true;
+        }
+    }
+    catch (const uno::Exception&)
+    {
+        mxDispatch.clear(); // no handler or a failing one: no dot
+    }
+    if (!bListening)
+        show(false);
+}
+
+void UpdateDot::Stop()
+{
+    maShow = nullptr;
+    stopListening();
+    mxFrame.clear();
+}
+
+void UpdateDot::stopListening()
+{
+    uno::Reference<frame::XDispatch> xDispatch;
+    std::swap(xDispatch, mxDispatch);
+    if (!xDispatch.is())
+        return;
+    try
+    {
+        xDispatch->removeStatusListener(this, maURL);
+    }
+    catch (const uno::Exception&)
+    {
+        // the handler is gone already
+    }
+}
+
+void UpdateDot::show(bool bShow)
+{
+    // the handler may call from its own thread
+    SolarMutexGuard aGuard;
+    if (maShow)
+        maShow(bShow);
+}
+
+void SAL_CALL UpdateDot::statusChanged(const frame::FeatureStateEvent& rEvent)
+{
+    show(rEvent.IsEnabled);
+}
+
+void SAL_CALL UpdateDot::disposing(const lang::EventObject& rEvent)
+{
+    if (rEvent.Source == mxDispatch)
+    {
+        mxDispatch.clear();
+        show(false);
+    }
+}
+}
