+namespace hst::ribbon
+{
+namespace
+{
+/// the tab controls whose File button shows the dot; a control leaves the set when it dies
+struct UpdateDots
+{
+    static std::set<const vcl::Window*>& shown()
+    {
+        static std::set<const vcl::Window*> aShown;
+        return aShown;
+    }
+    DECL_STATIC_LINK(UpdateDots, WindowEventHdl, VclWindowEvent&, void);
+};
+
+IMPL_STATIC_LINK(UpdateDots, WindowEventHdl, VclWindowEvent&, rEvent, void)
+{
+    if (rEvent.GetId() == VclEventId::ObjectDying)
+        UpdateDots::shown().erase(rEvent.GetWindow());
+}
+
+/// the accent of the dot: an orange that stands out from the File button's blue in both themes, with a ring of
+/// the button's text colour around it; high contrast has the system's colours only
+constexpr Color DOT_COLOR(0xF7, 0x63, 0x0C);
+}
+
+void SetUpdateDot(vcl::Window& rTabControl, bool bShow)
+{
+    std::set<const vcl::Window*>& rShown = UpdateDots::shown();
+    const bool bShown = rShown.count(&rTabControl) > 0;
+    if (bShow == bShown)
+        return;
+    if (bShow)
+    {
+        rShown.insert(&rTabControl);
+        rTabControl.AddEventListener(LINK(nullptr, UpdateDots, WindowEventHdl));
+    }
+    else
+    {
+        rShown.erase(&rTabControl);
+        rTabControl.RemoveEventListener(LINK(nullptr, UpdateDots, WindowEventHdl));
+    }
+    if (!rTabControl.isDisposed())
+        rTabControl.Invalidate();
+}
+
+bool HasUpdateDot(const vcl::Window& rTabControl) { return UpdateDots::shown().count(&rTabControl) > 0; }
+
+void DrawUpdateDot(vcl::RenderContext& rDev, const tools::Rectangle& rItem)
+{
+    const tools::Rectangle aFill = FileTabFill(rDev, rItem);
+    const double fScale = rDev.GetDPIScaleFactor();
+    const tools::Long nRadius = std::max<tools::Long>(2, std::lround(3 * fScale));
+    const tools::Long nRing = std::max<tools::Long>(1, std::lround(fScale));
+    const tools::Long nEdge = std::max<tools::Long>(nRadius + nRing, std::lround(6 * fScale));
+    const Point aCenter(aFill.Right() - nEdge, aFill.Top() + nEdge);
+    const StyleSettings& rStyle = rDev.GetSettings().GetStyleSettings();
+    const FileTabColors aColors = fileTabColorsFor(rStyle, false, false);
+    rDev.Push(vcl::PushFlags::LINECOLOR | vcl::PushFlags::FILLCOLOR);
+    rDev.SetLineColor();
+    rDev.SetFillColor(aColors.aText);
+    rDev.DrawEllipse(tools::Rectangle(aCenter.X() - nRadius - nRing, aCenter.Y() - nRadius - nRing,
+                                      aCenter.X() + nRadius + nRing, aCenter.Y() + nRadius + nRing));
+    rDev.SetFillColor(rStyle.GetHighContrastMode() ? aColors.aFill : DOT_COLOR);
+    rDev.DrawEllipse(tools::Rectangle(aCenter.X() - nRadius, aCenter.Y() - nRadius, aCenter.X() + nRadius,
+                                      aCenter.Y() + nRadius));
+    rDev.Pop();
+}
+}
