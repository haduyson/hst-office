+/// the page's merged group box, breadth first (not a merged box nested in it)
+PriorityMergedHBox* lcl_HstPageBox(const vcl::Window& rPage)
+{
+    std::vector<const vcl::Window*> aLevel{ &rPage };
+    while (!aLevel.empty())
+    {
+        std::vector<const vcl::Window*> aNext;
+        for (const vcl::Window* pWindow : aLevel)
+            for (const vcl::Window* pChild = pWindow->GetWindow(GetWindowType::FirstChild); pChild;
+                 pChild = pChild->GetWindow(GetWindowType::Next))
+            {
+                if (!pChild->IsVisible())
+                    continue;
+                if (auto* pBox = dynamic_cast<const PriorityMergedHBox*>(pChild))
+                    return const_cast<PriorityMergedHBox*>(pBox);
+                aNext.push_back(pChild);
+            }
+        aLevel = std::move(aNext);
+    }
+    return nullptr;
+}
+}
+
+tools::Long hst::ribbon::PageUsedRight(const vcl::Window& rPage)
+{
+    const PriorityMergedHBox* pBox = lcl_HstPageBox(rPage);
+    if (!pBox || pBox->HstUsedWidth() < 0)
+        return -1;
+    return pBox->OutputToScreenPixel(Point()).X() - rPage.OutputToScreenPixel(Point()).X() + pBox->HstUsedWidth();
+}
+
+void hst::ribbon::SetUsedChangedHandler(UsedChangedHandler pHandler) { g_pHstUsedChanged = pHandler; }
+
+void PriorityMergedHBox::HstNotifyUsedChanged()
+{
+    if (!g_pHstUsedChanged)
+        return;
+    for (vcl::Window* pWindow = GetParent(); pWindow; pWindow = pWindow->GetParent())
+        if (dynamic_cast<TabPage*>(pWindow))
+        {
+            g_pHstUsedChanged(*pWindow);
+            return;
+        }
+}
+
+void hst::ribbon::SetPageSlack(vcl::Window& rPage, tools::Long nSlack)
+{
+    if (PriorityMergedHBox* pBox = lcl_HstPageBox(rPage))
+        pBox->HstSetSlack(std::max<tools::Long>(0, nSlack));
+}
+
+void hst::ribbon::DumpPageLayout(const vcl::Window& rPage, const tools::Rectangle& rBanner)
+{
+    static const char* const pDir = std::getenv("HST_RIBBON_DUMP_LAYOUT");
+    if (!pDir || !*pDir)
+        return;
+    const PriorityMergedHBox* pBox = lcl_HstPageBox(rPage);
+    if (!pBox || pBox->HstUsedWidth() < 0)
+        return;
+    const double fScale = rPage.GetDPIScaleFactor();
+    const vcl::Window* pFrame = rPage.GetFrameWindow();
+    const Size aWindow = pFrame ? pFrame->GetOutputSizePixel() : rPage.GetSizePixel();
+    const char* const pApp = std::getenv("HST_RIBBON_DUMP_APP");
+    OStringBuffer aOut("{\"app\":\"" + OString(pApp ? pApp : "") + "\",\"tab\":\"" + pBox->get_id().toUtf8()
+                       + "\",\"box\":\"" + pBox->get_id().toUtf8() + "\",\"scale\":" + OString::number(fScale)
+                       + ",\"window\":{\"w\":" + OString::number(sal_Int64(aWindow.Width())) + ",\"h\":"
+                       + OString::number(sal_Int64(aWindow.Height())) + "},\"body\":{\"x\":0,\"y\":0,\"w\":"
+                       + OString::number(sal_Int64(rPage.GetSizePixel().Width())) + ",\"h\":"
+                       + OString::number(sal_Int64(rPage.GetSizePixel().Height())) + "},\"banner\":");
+    if (rBanner.IsEmpty())
+        aOut.append("null");
+    else
+        aOut.append("{\"x\":" + OString::number(sal_Int64(rBanner.Left())) + ",\"y\":"
+                    + OString::number(sal_Int64(rBanner.Top())) + ",\"w\":"
+                    + OString::number(sal_Int64(rBanner.GetWidth())) + ",\"h\":"
+                    + OString::number(sal_Int64(rBanner.GetHeight())) + "}");
+    aOut.append(",");
+    pBox->HstDump(rPage, aOut);
+    aOut.append("}\n");
+    const OString aPath = OString(pDir) + "/" + pBox->get_id().toUtf8().replaceAll(" ", "_") + "-"
+                          + OString::number(sal_Int64(std::lround(aWindow.Width() / fScale))) + ".json";
+    if (FILE* pFile = std::fopen(aPath.getStr(), "w"))
+    {
+        std::fwrite(aOut.getStr(), 1, aOut.getLength(), pFile);
+        std::fclose(pFile);
+    }
+}
