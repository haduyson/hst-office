+/// the natural widths of one command, per look (L, M, S, W, and G at the gallery states L, M, S), -1 unknown
+struct Naturals
+{
+    std::array<tools::Long, 7> width{ -1, -1, -1, -1, -1, -1, -1 };
+};
+
+int lookIndex(char cLook, char cGallery)
+{
+    switch (cLook)
+    {
+        case 'L': return 0;
+        case 'M': return 1;
+        case 'S': return 2;
+        case 'W': return 3;
+        default: return cGallery == 'L' ? 4 : cGallery == 'M' ? 5 : 6;
+    }
+}
+
+struct Group
+{
+    Spec spec;
+    Config config;
+    bool listening = false;
+    bool applied = false;
+    std::map<const vcl::Window*, Naturals> naturals;
+    std::map<const vcl::Window*, char> looks; // the look each command shows now
+    std::map<const vcl::Window*, bool> size32; // a toolbox authored with the 32 px images (Paste)
+    Plan plan; // of the last allocation, for the dump
+    std::vector<const vcl::Window*> planChildren; // command child of each plan item index
+};
+
+std::map<const vcl::Window*, Group>& groups()
+{
+    static std::map<const vcl::Window*, Group> aGroups;
+    return aGroups;
+}
+
+struct Forgetter
+{
+    DECL_STATIC_LINK(Forgetter, DyingHdl, VclWindowEvent&, void);
+};
+
+IMPL_STATIC_LINK(Forgetter, DyingHdl, VclWindowEvent&, rEvent, void)
+{
+    if (rEvent.GetId() == VclEventId::ObjectDying)
+        groups().erase(rEvent.GetWindow());
+}
+
+/// the caption of a group (its label, or the box of its label and launcher) is under its commands: the .ui
+/// generator attaches the commands at rows 0-2 and the caption at row 3
+bool isCaption(const vcl::Window& rChild) { return rChild.get_grid_top_attach() >= 3; }
+
+struct Parts
+{
+    std::vector<vcl::Window*> commands;
+    vcl::Window* caption = nullptr;
+    vcl::Window* separator = nullptr;
+};
+
+Parts partsOf(const vcl::Window& rGrid)
+{
+    Parts aParts;
+    for (vcl::Window* pChild = rGrid.GetWindow(GetWindowType::FirstChild); pChild;
+         pChild = pChild->GetWindow(GetWindowType::Next))
+    {
+        if (dynamic_cast<FixedLine*>(pChild))
+            aParts.separator = aParts.separator ? aParts.separator : pChild;
+        else if (isCaption(*pChild))
+            aParts.caption = aParts.caption ? aParts.caption : pChild;
+        else
+            aParts.commands.push_back(pChild);
+    }
+    return aParts;
+}
+
+/// a command is shown: its window is, and a toolbox has a shown item
+bool shown(const vcl::Window& rCommand)
+{
+    if (!rCommand.IsVisible())
+        return false;
+    if (const ToolBox* pBox = dynamic_cast<const ToolBox*>(&rCommand))
+    {
+        for (ToolBox::ImplToolItems::size_type i = 0; i < pBox->GetItemCount(); ++i)
+            if (pBox->GetItemType(i) == ToolBoxItemType::BUTTON && pBox->IsItemVisible(pBox->GetItemId(i)))
+                return true;
+        return false;
+    }
+    return true;
+}
+
+bool holdsPaste(const vcl::Window& rCommand)
+{
+    if (const ToolBox* pBox = dynamic_cast<const ToolBox*>(&rCommand))
+        for (ToolBox::ImplToolItems::size_type i = 0; i < pBox->GetItemCount(); ++i)
+            if (pBox->GetItemCommand(pBox->GetItemId(i)) == ".uno:Paste")
+                return true;
+    return false;
+}
+
+Group* find(const vcl::Window& rGroup)
+{
+    auto it = groups().find(&rGroup);
+    if (it == groups().end() || !it->second.spec.valid)
+        return nullptr;
+    return &it->second;
+}
+
+double scaleOf(const vcl::Window& rWindow) { return rWindow.GetDPIScaleFactor(); }
+
+tools::Long px(long nLogical, const vcl::Window& rWindow) { return scaled(nLogical, scaleOf(rWindow)); }
+
+/// the look of a toolbox: L a large button (image above its label), M a small one with its label, S its image only
+void lookToolBox(ToolBox& rBox, char cLook, bool bSize32)
+{
+    ImplToolBoxPrivateData& rData = *rBox.ImplGetToolBoxPrivateData();
+    bool bChanged = false;
+    rBox.HstSetStretch(true);
+    rBox.HstSetGridRows(0);
+    // the toolbox takes its cell (the tab's large-button width, its column's width), its button stretched over it
+    if (rBox.get_halign() != VclAlign::Fill || rBox.get_valign() != VclAlign::Fill)
+    {
+        rBox.set_halign(VclAlign::Fill);
+        rBox.set_valign(VclAlign::Fill);
+        bChanged = true;
+    }
+    if (cLook == 'W' || cLook == 'G')
+    {
+        if (bChanged)
+            rBox.queue_resize();
+        return;
+    }
+    const ButtonType eType = cLook == 'S' ? ButtonType::SYMBOLONLY : ButtonType::SYMBOLTEXT;
+    const ToolBoxButtonSize eSize = cLook == 'L' ? (bSize32 ? ToolBoxButtonSize::Size32 : ToolBoxButtonSize::Large)
+                                                 : ToolBoxButtonSize::Small;
+    const ToolBoxTextPosition ePosition = cLook == 'L' ? ToolBoxTextPosition::Bottom : ToolBoxTextPosition::Right;
+    if (rBox.GetButtonType() != eType)
+    {
+        rBox.SetButtonType(eType);
+        bChanged = true;
+    }
+    if (rBox.GetToolboxButtonSize() != eSize)
+    {
+        rBox.SetToolboxButtonSize(eSize);
+        // the toolbox's owner loads the images of the new size (SidebarToolBox reloads its command images)
+        rBox.DataChanged(DataChangedEvent(DataChangedEventType::NONE));
+        bChanged = true;
+    }
+    if (rData.meHstTextPosition != ePosition)
+    {
+        rBox.SetToolBoxTextPosition(ePosition);
+        bChanged = true;
+    }
+    if (bChanged)
+        rBox.queue_resize();
+}
+
+void lookGallery(vcl::Window& rCommand, char cGallery)
+{
+    ToolBox* pBox = dynamic_cast<ToolBox*>(&rCommand);
+    if (!pBox)
+        return;
+    const OUString aState = OUString::number(cGallery == 'L' ? 0 : cGallery == 'M' ? 1 : 2);
+    for (ToolBox::ImplToolItems::size_type i = 0; i < pBox->GetItemCount(); ++i)
+    {
+        const ToolBoxItemId nId = pBox->GetItemId(i);
+        vcl::Window* pItemWindow = pBox->GetItemWindow(nId);
+        if (pItemWindow && pItemWindow->set_property(u"hst-gallery-state"_ustr, aState))
+        {
+            pBox->SetItemWindow(nId, pItemWindow); // the item takes the window's new size
+            pBox->queue_resize();
+        }
+    }
+}
+
+void setLook(Group& rData, vcl::Window& rCommand, char cLook, char cGallery)
+{
+    rData.looks[&rCommand] = cLook;
+    if (ToolBox* pBox = dynamic_cast<ToolBox*>(&rCommand))
+    {
+        if (!rData.size32.count(&rCommand))
+            rData.size32[&rCommand] = pBox->GetToolboxButtonSize() == ToolBoxButtonSize::Size32;
+        lookToolBox(*pBox, cLook, rData.size32[&rCommand]);
+        if (cLook == 'G')
+            lookGallery(rCommand, cGallery);
+    }
+    else if (MenuButton* pButton = dynamic_cast<MenuButton*>(&rCommand))
+        SetMenuButtonLook(*pButton, cLook);
+}
+
+Input inputFor(const Group& rData, const Parts& rParts, const Config& rConfig)
+{
+    Input aIn;
+    aIn.kinds = rData.spec.kinds;
+    aIn.rows = rData.spec.rows;
+    aIn.state = rConfig.state;
+    aIn.big = rConfig.big;
+    for (const vcl::Window* pCommand : rParts.commands)
+    {
+        aIn.paste.push_back(holdsPaste(*pCommand));
+        aIn.visible.push_back(shown(*pCommand));
+    }
+    return aIn;
+}
+
+/// the look of every shown command at rConfig, from the blocks (a row may show an icon-only command labelled)
+std::vector<char> looksFor(const Input& rIn)
+{
+    std::vector<char> aLooks(rIn.kinds.size(), 0);
+    for (const auto& rBlock : structure(rIn))
+        for (const auto& rLine : rBlock.lines)
+            for (const auto& [i, c] : rLine)
+                if (c != '|' && i < aLooks.size())
+                    aLooks[i] = c;
+    return aLooks;
+}
+
+/// the natural width of a command at a look, measured once (the command shows that look for a moment)
+tools::Long natural(Group& rData, vcl::Window& rCommand, char cLook, char cGallery)
+{
+    tools::Long& rWidth = rData.naturals[&rCommand].width[lookIndex(cLook, cGallery)];
+    if (rWidth < 0)
+    {
+        setLook(rData, rCommand, cLook, cGallery);
+        rWidth = VclContainer::getLayoutRequisition(rCommand).Width();
+    }
+    return rWidth;
+}
+
+Plan planFor(Group& rData, const Parts& rParts, const Config& rConfig, const vcl::Window& rGrid)
+{
+    const Input aIn = inputFor(rData, rParts, rConfig);
+    const std::vector<char> aLooks = looksFor(aIn);
+    // a group shows the looks of its configuration from its first layout on, fitted or not
+    bool bMeasured = !rData.applied;
+    rData.applied = true;
+    for (std::size_t i = 0; i < rParts.commands.size(); ++i)
+        if (aLooks[i] && rData.naturals[rParts.commands[i]].width[lookIndex(aLooks[i], rConfig.gallery)] < 0)
+        {
+            natural(rData, *rParts.commands[i], aLooks[i], rConfig.gallery);
+            bMeasured = true;
+        }
+    if (bMeasured)
+    {
+        // back to the looks of the group's current configuration
+        const Input aNow = inputFor(rData, rParts, rData.config);
+        const std::vector<char> aNowLooks = looksFor(aNow);
+        for (std::size_t i = 0; i < rParts.commands.size(); ++i)
+            if (aNowLooks[i])
+                setLook(rData, *rParts.commands[i], aNowLooks[i], rData.config.gallery);
+    }
+    const auto width = [&](std::size_t i, char cLook) -> long {
+        return static_cast<long>(natural(rData, *rParts.commands[i], cLook, rConfig.gallery));
+    };
+    return place(aIn, width, static_cast<long>(rConfig.largeWidth), scaleOf(rGrid));
+}
+
+tools::Long captionWidth(const Parts& rParts)
+{
+    return rParts.caption ? VclContainer::getLayoutRequisition(*rParts.caption).Width() : 0;
+}
+
+tools::Long captionHeight(const Parts& rParts, const vcl::Window& rGrid)
+{
+    const tools::Long nBand = px(18, rGrid);
+    return rParts.caption ? std::max(nBand, VclContainer::getLayoutRequisition(*rParts.caption).Height()) : nBand;
+}
+
+/// the content's height: three rows, or more when a command asks for more (a larger font)
+tools::Long contentHeight(const Plan& rPlan, const vcl::Window& rGrid)
+{
+    tools::Long nHeight = 3 * px(ROW, rGrid) + 2 * px(ROW_GAP, rGrid);
+    for (const Cell& rCell : rPlan.cells)
+        nHeight = std::max<tools::Long>(nHeight, rCell.y + rCell.h);
+    return nHeight;
+}
+
+void appendRect(OStringBuffer& rOut, const tools::Rectangle& rRect)
+{
+    rOut.append("{\"x\":" + OString::number(sal_Int64(rRect.Left())) + ",\"y\":"
+                + OString::number(sal_Int64(rRect.Top())) + ",\"w\":" + OString::number(sal_Int64(rRect.GetWidth()))
+                + ",\"h\":" + OString::number(sal_Int64(rRect.GetHeight())) + "}");
+}
+
+tools::Rectangle rectIn(const vcl::Window& rWindow, const vcl::Window& rOrigin)
+{
+    const Point aPos = rWindow.OutputToScreenPixel(Point()) - rOrigin.OutputToScreenPixel(Point());
+    return tools::Rectangle(aPos, rWindow.GetSizePixel());
+}
+
+OString jsonText(const OUString& rText)
+{
+    return rText.replaceAll(u"\\", u"\\\\").replaceAll(u"\"", u"\\\"").replaceAll(u"~", u"").replace('\n', ' ').toUtf8();
+}
+}
+
+void SetSpec(const vcl::Window& rGrid, const OUString& rValue)
+{
+    Group& rData = groups()[&rGrid];
+    const OString aUtf8 = rValue.toUtf8();
+    rData.spec = parseSpec(std::string_view(aUtf8.getStr(), aUtf8.getLength()));
+    if (!rData.listening)
+    {
+        const_cast<vcl::Window&>(rGrid).AddEventListener(LINK(nullptr, Forgetter, DyingHdl));
+        rData.listening = true;
+    }
+}
+
+bool IsGroup(const vcl::Window& rGroup)
+{
+    const Group* pData = find(rGroup);
+    return pData && partsOf(rGroup).commands.size() == pData->spec.kinds.size();
+}
+
+Config Current(const vcl::Window& rGroup)
+{
+    const Group* pData = find(rGroup);
+    return pData ? pData->config : Config();
+}
+
+void Apply(vcl::Window& rGroup, const Config& rConfig)
+{
+    Group* pData = find(rGroup);
+    if (!pData || !IsGroup(rGroup))
+        return;
+    const Parts aParts = partsOf(rGroup);
+    const bool bChanged = !(pData->config == rConfig);
+    pData->config = rConfig;
+    pData->applied = true;
+    const std::vector<char> aLooks = looksFor(inputFor(*pData, aParts, rConfig));
+    for (std::size_t i = 0; i < aParts.commands.size(); ++i)
+        if (aLooks[i])
+            setLook(*pData, *aParts.commands[i], aLooks[i], rConfig.gallery);
+    if (FixedText* pText = dynamic_cast<FixedText*>(aParts.caption))
+    {
+        const WinBits nStyle = (pText->GetStyle() & ~(WB_LEFT | WB_RIGHT | WB_TOP | WB_BOTTOM)) | WB_CENTER | WB_VCENTER;
+        if (pText->GetStyle() != nStyle)
+            pText->SetStyle(nStyle);
+    }
+    if (bChanged)
+        rGroup.queue_resize();
+}
+
+tools::Long Width(vcl::Window& rGroup, const Config& rConfig)
+{
+    Group* pData = find(rGroup);
+    if (!pData)
+        return 0;
+    const Parts aParts = partsOf(rGroup);
+    const Plan aPlan = planFor(*pData, aParts, rConfig, rGroup);
+    return 2 * px(6, rGroup) + std::max<tools::Long>(aPlan.width, captionWidth(aParts));
+}
+
+tools::Long LargeNatural(vcl::Window& rGroup, const Config& rConfig)
+{
+    Group* pData = find(rGroup);
+    if (!pData)
+        return 0;
+    const Parts aParts = partsOf(rGroup);
+    Config aNatural = rConfig;
+    aNatural.largeWidth = 0;
+    tools::Long nWidest = 0;
+    for (const Cell& rCell : planFor(*pData, aParts, aNatural, rGroup).cells)
+        if (rCell.look == 'L')
+            nWidest = std::max<tools::Long>(nWidest, rCell.w);
+    return nWidest;
+}
+
+bool Fillable(const vcl::Window& rGroup)
+{
+    const Group* pData = find(rGroup);
+    if (!pData || pData->spec.nofill || !pData->spec.rows.empty() || rGroup.get_id() == "gdHomeClipboard")
+        return false;
+    const std::string& rKinds = pData->spec.kinds;
+    return rKinds.find_first_of("MS") != std::string::npos && rKinds.find('W') == std::string::npos;
+}
+
+bool HasGallery(const vcl::Window& rGroup)
+{
+    const Group* pData = find(rGroup);
+    return pData && pData->spec.kinds.find('G') != std::string::npos;
+}
+
+void Forget(const vcl::Window& rGroup)
+{
+    if (Group* pData = find(rGroup))
+        pData->naturals.clear();
+}
+
+Size Requisition(const vcl::Window& rGrid)
+{
+    Group* pData = find(rGrid);
+    if (!pData)
+        return Size();
+    vcl::Window& rGroup = const_cast<vcl::Window&>(rGrid);
+    const Parts aParts = partsOf(rGroup);
+    const Plan aPlan = planFor(*pData, aParts, pData->config, rGroup);
+    const tools::Long nWidth = 2 * px(6, rGroup) + std::max<tools::Long>(aPlan.width, captionWidth(aParts));
+    const tools::Long nHeight = px(6, rGroup) + contentHeight(aPlan, rGroup) + px(4, rGroup)
+                                + captionHeight(aParts, rGroup) + px(2, rGroup);
+    return Size(nWidth, nHeight);
+}
+
+void Allocate(vcl::Window& rGrid, const Size& rSize)
+{
+    Group* pData = find(rGrid);
+    if (!pData)
+        return;
+    const Parts aParts = partsOf(rGrid);
+    pData->plan = planFor(*pData, aParts, pData->config, rGrid);
+    pData->planChildren.assign(aParts.commands.begin(), aParts.commands.end());
+    const tools::Long nPad = px(6, rGrid), nTop = px(6, rGrid);
+    const tools::Long nContentWidth = std::max<tools::Long>(pData->plan.width, captionWidth(aParts));
+    for (const Cell& rCell : pData->plan.cells)
+        VclContainer::setLayoutAllocation(*aParts.commands[rCell.item], Point(nPad + rCell.x, nTop + rCell.y),
+                                          Size(rCell.w, rCell.h));
+    const tools::Long nContent = contentHeight(pData->plan, rGrid);
+    const tools::Long nCaption = captionHeight(aParts, rGrid);
+    if (aParts.caption)
+        VclContainer::setLayoutAllocation(*aParts.caption, Point(nPad, nTop + nContent + px(4, rGrid)),
+                                          Size(nContentWidth, nCaption));
+    if (aParts.separator)
+    {
+        const tools::Long nLine = std::max<tools::Long>(1, px(1, rGrid));
+        VclContainer::setLayoutAllocation(
+            *aParts.separator, Point(std::max<tools::Long>(0, rSize.Width() - nLine), nTop),
+            Size(nLine, std::max<tools::Long>(1, nContent + px(4, rGrid) + nCaption - px(2, rGrid))));
+    }
+}
+
+void Dump(const vcl::Window& rGroup, const vcl::Window& rOrigin, char cState, const tools::Rectangle& rFold,
+          OStringBuffer& rOut)
+{
+    const Group* pData = find(rGroup);
+    const Parts aParts = partsOf(rGroup);
+    rOut.append("{\"id\":\"" + rGroup.get_id().toUtf8() + "\",\"caption\":\""
+                + jsonText(GroupCaption(const_cast<vcl::Window&>(rGroup))) + "\",\"state\":\""
+                + OStringChar(cState) + "\",\"big\":");
+    rOut.append(pData && pData->config.big ? "true" : "false");
+    rOut.append(",\"rect\":");
+    if (cState == 'C')
+    {
+        appendRect(rOut, rFold);
+        rOut.append(",\"caption_rect\":");
+        appendRect(rOut, rFold);
+        rOut.append(",\"caption_needed\":0,\"blocks\":[{\"type\":\"fold\",\"items\":[{\"id\":\"fold\",\"kind\":\"C\","
+                    "\"rect\":");
+        appendRect(rOut, rFold);
+        rOut.append("}]}]}");
+        return;
+    }
+    appendRect(rOut, rectIn(rGroup, rOrigin));
+    rOut.append(",\"caption_rect\":");
+    appendRect(rOut, aParts.caption ? rectIn(*aParts.caption, rOrigin) : tools::Rectangle());
+    rOut.append(",\"caption_needed\":" + OString::number(sal_Int64(captionWidth(aParts))) + ",\"blocks\":[");
+    if (pData)
+    {
+        static constexpr const char* aTypes[] = { "large", "gallery", "col", "rows" };
+        for (std::size_t b = 0; b < pData->plan.blocks.size(); ++b)
+        {
+            rOut.append(b ? "," : "");
+            rOut.append("{\"type\":\"");
+            rOut.append(aTypes[static_cast<int>(pData->plan.blocks[b])]);
+            rOut.append("\",\"items\":[");
+            bool bFirst = true;
+            for (const Cell& rCell : pData->plan.cells)
+            {
+                if (rCell.block != static_cast<int>(b) || rCell.item >= pData->planChildren.size())
+                    continue;
+                const vcl::Window& rCommand = *pData->planChildren[rCell.item];
+                rOut.append(bFirst ? "" : ",");
+                rOut.append("{\"id\":\"" + jsonText(rCommand.get_id())
+                            + "\",\"kind\":\"" + OStringChar(rCell.look) + "\",\"row\":"
+                            + OString::number(rCell.row) + ",\"rect\":");
+                const tools::Rectangle aRect = rectIn(rCommand, rOrigin);
+                appendRect(rOut, aRect);
+                // the command asks for more room than its cell gives it: its label (or its box) is cut
+                const Size aWant = VclContainer::getLayoutRequisition(rCommand);
+                rOut.append(",\"label_cut\":");
+                rOut.append(aWant.Width() > aRect.GetWidth() || aWant.Height() > aRect.GetHeight() ? "true" : "false");
+                rOut.append("}");
+                bFirst = false;
+            }
+            rOut.append("]}");
+        }
+    }
+    rOut.append("]}");
+}
+}
