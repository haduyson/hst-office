+namespace
+{
+/// what a menu button's paint measured: each string the layout asks for (the label, and each line of a large one's),
+/// the paint's width and its window's, and the height of a line
+struct Painted
+{
+    OUString label;
+    std::map<OUString, std::pair<tools::Long, tools::Long>> widths; // paint, window
+    tools::Long height = 0;
+};
+
+struct PaintedMetrics
+{
+    static std::map<const vcl::Window*, Painted>& metrics()
+    {
+        static std::map<const vcl::Window*, Painted> aMetrics;
+        return aMetrics;
+    }
+    /// the buttons whose metrics changed since their layout, laid out again together after the paint
+    static std::vector<VclPtr<PushButton>>& pending()
+    {
+        static std::vector<VclPtr<PushButton>> aPending;
+        return aPending;
+    }
+    static ImplSVEvent*& event()
+    {
+        static ImplSVEvent* pEvent = nullptr;
+        return pEvent;
+    }
+    DECL_STATIC_LINK(PaintedMetrics, DyingHdl, VclWindowEvent&, void);
+    DECL_STATIC_LINK(PaintedMetrics, RelayoutHdl, void*, void);
+};
+
+IMPL_STATIC_LINK(PaintedMetrics, DyingHdl, VclWindowEvent&, rEvent, void)
+{
+    if (rEvent.GetId() == VclEventId::ObjectDying)
+        PaintedMetrics::metrics().erase(rEvent.GetWindow());
+}
+
+IMPL_STATIC_LINK_NOARG(PaintedMetrics, RelayoutHdl, void*, void)
+{
+    PaintedMetrics::event() = nullptr;
+    std::vector<VclPtr<PushButton>> aButtons;
+    aButtons.swap(PaintedMetrics::pending());
+    std::vector<VclPtr<PriorityMergedHBox>> aBoxes;
+    for (const VclPtr<PushButton>& xButton : aButtons)
+    {
+        if (xButton->isDisposed())
+            continue;
+        // the button's own place (a large one's width and label line), then the widths its group and tab measured
+        RefreshMenuButton(*xButton);
+        for (vcl::Window* pParent = xButton->GetParent(); pParent; pParent = pParent->GetParent())
+        {
+            if (v3::IsGroup(*pParent))
+                v3::Forget(*pParent);
+            if (PriorityMergedHBox* pBox = dynamic_cast<PriorityMergedHBox*>(pParent))
+            {
+                if (std::find(aBoxes.begin(), aBoxes.end(), pBox) == aBoxes.end())
+                    aBoxes.emplace_back(pBox);
+                break;
+            }
+        }
+        xButton->queue_resize();
+    }
+    for (const VclPtr<PriorityMergedHBox>& xBox : aBoxes)
+    {
+        if (xBox->isDisposed())
+            continue;
+        // the tab's box measures its groups again, as after a font change
+        xBox->DataChanged(DataChangedEvent(DataChangedEventType::FONTS));
+        xBox->queue_resize();
+    }
+}
+
+/// the strings the layout measures of a label: the label, and each of its lines when it has several
+std::vector<OUString> measuredStrings(const OUString& rText)
+{
+    std::vector<OUString> aStrings{ rText };
+    if (rText.indexOf('\n') >= 0)
+    {
+        sal_Int32 nIndex = 0;
+        do
+            aStrings.push_back(rText.getToken(0, '\n', nIndex));
+        while (nIndex >= 0);
+    }
+    return aStrings;
+}
+}
+
+void MenuButtonPainted(PushButton& rButton, OutputDevice& rDev, const tools::Rectangle& rInner,
+                       sal_Int32& rImageSep)
+{
+    const char cLook = MenuButtonLook(rButton);
+    if (cLook != 'L' && cLook != 'M')
+        return;
+    const OUString aText = rButton.GetText().replaceAll("~", "");
+    Painted aNow;
+    aNow.label = aText;
+    aNow.height = rDev.GetTextHeight();
+    for (const OUString& rString : measuredStrings(aText))
+        aNow.widths[rString] = { rDev.GetTextWidth(rString), rButton.GetTextWidth(rString) };
+
+    // the layout measured with what was known before this paint (the window's measure before the first one)
+    const tools::Long nPaintHeight = aNow.height;
+    const bool bChanged = aNow.height != MenuButtonTextHeight(rButton)
+                          || std::any_of(aNow.widths.begin(), aNow.widths.end(), [&rButton](const auto& rWidth) {
+                                 return rWidth.second.first != MenuButtonTextWidth(rButton, rWidth.first);
+                             });
+    auto& rMetrics = PaintedMetrics::metrics();
+    auto it = rMetrics.find(&rButton);
+    if (it == rMetrics.end())
+    {
+        rButton.AddEventListener(LINK(nullptr, PaintedMetrics, DyingHdl));
+        rMetrics.emplace(&rButton, std::move(aNow));
+    }
+    else
+    {
+        // keep the strings of the other looks: the layout plans every look of the button
+        it->second.label = aNow.label;
+        it->second.height = aNow.height;
+        for (auto& [rString, rWidths] : aNow.widths)
+            it->second.widths[rString] = rWidths;
+    }
+    if (bChanged)
+    {
+        auto& rPending = PaintedMetrics::pending();
+        if (std::find(rPending.begin(), rPending.end(), &rButton) == rPending.end())
+            rPending.emplace_back(&rButton);
+        if (!PaintedMetrics::event())
+            PaintedMetrics::event() = Application::PostUserEvent(LINK(nullptr, PaintedMetrics, RelayoutHdl));
+    }
+
+    // a medium one: a font taller than its row's content (Windows at 125 %: 20 px in 16 px) draws its accents and
+    // the dots under its letters into the frame, which the paint's clip cut off ("Tìm và chon")
+    if (cLook == 'M' && nPaintHeight > rInner.GetHeight())
+    {
+        const tools::Long nOver = (nPaintHeight - rInner.GetHeight() + 1) / 2;
+        tools::Rectangle aClip(rInner);
+        aClip.AdjustTop(-nOver);
+        aClip.AdjustBottom(nOver);
+        rDev.SetClipRegion(vcl::Region(aClip));
+    }
+
+    // a large button: its lines under its image, the gap shrunk when the font is too tall for the content at the
+    // usual one (Windows at 125 %: 2 lines of 20 px under a 24 px icon in 68 px)
+    const Image aImage = rButton.GetModeImage();
+    if (cLook == 'L' && !aText.isEmpty() && !!aImage && rButton.GetImageAlign() == ImageAlign::Top)
+    {
+        const auto nLines = static_cast<tools::Long>(1 + std::count(aText.getStr(), aText.getStr() + aText.getLength(), u'\n'));
+        const tools::Long nRoom
+            = rInner.GetHeight() - aImage.GetSizePixel().Height() - nLines * rDev.GetTextHeight();
+        if (nRoom < rImageSep)
+            rImageSep = static_cast<sal_Int32>(std::max<tools::Long>(1, nRoom));
+    }
+}
+
+tools::Long MenuButtonTextWidth(const PushButton& rButton, const OUString& rText)
+{
+    const tools::Long nWindow = rButton.GetTextWidth(rText);
+    const auto it = PaintedMetrics::metrics().find(&rButton);
+    if (it == PaintedMetrics::metrics().end())
+        return nWindow;
+    const auto itText = it->second.widths.find(rText);
+    if (itText != it->second.widths.end())
+        return itText->second.first;
+    // a string the paint did not draw (the label of another look): the window's measure at the paint's ratio
+    const auto itLabel = it->second.widths.find(it->second.label);
+    if (itLabel == it->second.widths.end())
+        return nWindow;
+    const auto& [nPaint, nWindowLabel] = itLabel->second;
+    if (nWindowLabel <= 0 || nPaint == nWindowLabel)
+        return nWindow;
+    return static_cast<tools::Long>(std::ceil(double(nWindow) * nPaint / nWindowLabel));
+}
+
+tools::Long MenuButtonTextHeight(const PushButton& rButton)
+{
+    const auto it = PaintedMetrics::metrics().find(&rButton);
+    return it == PaintedMetrics::metrics().end() ? rButton.GetTextHeight() : it->second.height;
+}
+}
