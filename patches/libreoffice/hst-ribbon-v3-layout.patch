+void SetMenuButtonLook(MenuButton& rButton, char cLook)
+{
+    // the authored image, remembered the first time; the large look shows its large (lc_) image above the label,
+    // the others the small (sc_) one beside it
+    auto& rStocks = MenuLookStocks::stocks();
+    auto it = rStocks.find(&rButton);
+    if (it == rStocks.end())
+    {
+        it = rStocks.emplace(&rButton, rButton.GetModeImage().GetStock()).first;
+        rButton.AddEventListener(LINK(nullptr, MenuLookStocks, DyingHdl));
+    }
+    MenuLookStocks::looks()[&rButton] = cLook;
+    const bool bLarge = cLook == 'L';
+    const ImageAlign eAlign = bLarge ? ImageAlign::Top : ImageAlign::Left;
+    bool bChanged = false;
+    if (rButton.GetImageAlign() != eAlign)
+    {
+        rButton.SetImageAlign(eAlign);
+        bChanged = true;
+    }
+    if (!it->second.isEmpty())
+    {
+        const OUString aWanted = bLarge ? it->second.replaceFirst("/sc_", "/lc_") : it->second.replaceFirst("/lc_", "/sc_");
+        if (rButton.GetModeImage().GetStock() != aWanted)
+        {
+            const Image aImage(StockImage::Yes, aWanted);
+            rButton.SetModeImage(aImage.GetSizePixel().Width() > 0 ? aImage : Image(StockImage::Yes, it->second));
+            bChanged = true;
+        }
+    }
+    if (bChanged)
+        rButton.queue_resize();
+    applyToMenuButton(rButton, cLook == 'S' ? GroupSmall : GroupLarge);
