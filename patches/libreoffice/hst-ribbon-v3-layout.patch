+bool PriorityMergedHBox::HstIsV3() const
+{
+    if (comphelper::LibreOfficeKit::isActive())
+        return false;
+    bool bAny = false;
+    for (vcl::Window* pChild : HstGroups())
+    {
+        if (!dynamic_cast<VclGrid*>(pChild))
+            continue; // a merged box of add-ons stays as it is
+        if (!hst::ribbon::v3::IsGroup(*pChild))
+            return false;
+        bAny = true;
+    }
+    return bAny;
+}
+
+void PriorityMergedHBox::HstApplyV3(tools::Long nWidth)
+{
+    // HST Office (1.0.3): the owner-locked mockup's fit(): every group large; on a sparse tab (more than 40 % free)
+    // the groups turn large from the left and then every large button widens to 96 px; when the row is too wide the
+    // galleries shrink first, then the groups from the right go medium, small, then to their "Caption ▾" button;
+    // what still does not fit folds into the chevron, from the end
+    if (m_bHstLadder)
+        return;
+    m_bHstLadder = true;
+    namespace v3 = hst::ribbon::v3;
+    const std::vector<vcl::Window*> aWindows = HstGroups();
+    const size_t n = aWindows.size();
+    const double fScale = GetDPIScaleFactor();
+    const auto px = [fScale](long nLogical) { return v3::scaled(nLogical, fScale); };
+    std::vector<v3::Config> aConfigs(n);
+    std::vector<char> aStates(n, 'L');
+    std::vector<bool> aV3(n), aHidden(n, false);
+    for (size_t i = 0; i < n; ++i)
+        aV3[i] = v3::IsGroup(*aWindows[i]);
+    bool bWide = false;
+    const auto setLargeWidth = [&]() {
+        tools::Long nLarge = 0;
+        for (size_t i = 0; i < n; ++i)
+            if (aV3[i] && aStates[i] != 'C' && !aHidden[i])
+            {
+                v3::Config aNatural = aConfigs[i];
+                aNatural.state = aStates[i];
+                nLarge = std::max(nLarge, v3::LargeNatural(*aWindows[i], aNatural));
+            }
+        // the narrowest even width in logical px, 52 to 96, at which every large label of the tab fits (equalize())
+        const long nLogical = static_cast<long>(std::ceil(nLarge / fScale - 0.01));
+        const tools::Long nWanted
+            = nLarge <= 0 ? 0 : px(bWide ? 96 : std::clamp<long>((nLogical + 1) / 2 * 2, 52, 96));
+        for (size_t i = 0; i < n; ++i)
+        {
+            aConfigs[i].state = aStates[i] == 'C' ? 'L' : aStates[i];
+            aConfigs[i].largeWidth = nWanted;
+        }
+    };
+    const tools::Long nChevron = getLayoutRequisition(*m_pButton).Width() + m_pButton->get_padding() * 2;
+    const auto used = [&]() {
+        setLargeWidth();
+        tools::Long nUsed = 0;
+        bool bAnyHidden = false;
+        for (size_t i = 0; i < n; ++i)
+        {
+            if (aHidden[i])
+            {
+                bAnyHidden = true;
+                continue;
+            }
+            if (aStates[i] == 'C')
+            {
+                PushButton& rButton = HstGroupButton(*aWindows[i]);
+                nUsed += getLayoutRequisition(rButton).Width() + rButton.get_padding() * 2;
+            }
+            else if (aV3[i])
+                nUsed += v3::Width(*aWindows[i], aConfigs[i]);
+            else
+                nUsed += getLayoutRequisition(*aWindows[i]).Width() + aWindows[i]->get_padding() * 2;
+        }
+        return nUsed + (bAnyHidden ? nChevron : 0);
+    };
+    const auto over = [&]() { return used() > nWidth; };
+    const auto freeShare = [&]() { return nWidth > 0 ? double(nWidth - used()) / nWidth : 0.0; };
+    // the sparse tab's fill pass, left to right
+    const bool bSparse = freeShare() > 0.4;
+    for (size_t i = 0; bSparse && i < n && freeShare() > 0.4; ++i)
+    {
+        if (!aV3[i] || !v3::Fillable(*aWindows[i]))
+            continue;
+        aConfigs[i].big = true;
+        if (over())
+            aConfigs[i].big = false;
+    }
+    // still sparse: every large button of the tab widens to 96 px
+    if (freeShare() > 0.4)
+    {
+        bWide = true;
+        if (over())
+            bWide = false;
+    }
+    // the ladder, right to left: galleries first, then the groups go M, S, then C
+    const auto rank = [](char c) { return c == 'L' ? 0 : c == 'M' ? 1 : c == 'S' ? 2 : 3; };
+    for (const char cStep : { 'M', 'S' })
+        for (size_t j = n; j-- > 0;)
+        {
+            if (!over())
+                break;
+            if (aV3[j] && v3::HasGallery(*aWindows[j]) && rank(aConfigs[j].gallery) < rank(cStep))
+                aConfigs[j].gallery = cStep;
+        }
+    for (const char cStep : { 'M', 'S', 'C' })
+        for (size_t j = n; j-- > 0;)
+        {
+            if (!over())
+                break;
+            if (!aV3[j] || rank(aStates[j]) >= rank(cStep))
+                continue;
+            aStates[j] = cStep;
+            aConfigs[j].big = false;
+            if (rank(aConfigs[j].gallery) < rank(cStep))
+                aConfigs[j].gallery = cStep == 'C' ? 'S' : cStep;
+        }
+    // the last rung: groups from the end fold into the chevron ("Nhóm khác »")
+    for (size_t j = n; j-- > 1 && over();)
+        aHidden[j] = true;
+    setLargeWidth();
+    m_bHstWide = bWide;
+    OStringBuffer aSparse;
+    for (size_t i = 0; i < n; ++i)
+        aSparse.append(aConfigs[i].big ? '1' : '0');
+    m_aHstSparse = aSparse.makeStringAndClear();
+    const tools::Long nWasUsed = m_nHstUsed;
+    m_nHstUsed = used();
+    m_aHstFoldOrder.assign(aWindows.rbegin(), aWindows.rend());
+    m_aHstFolded.clear();
+    for (size_t i = 0; i < n; ++i)
+        if (aHidden[i])
+            m_aHstFolded.push_back(aWindows[i]);
+    m_nHstFoldedFor = nWidth;
+    for (size_t i = 0; i < n; ++i)
+    {
+        const int nState = aStates[i] == 'C' ? hst::ribbon::GroupCollapsed
+                           : aStates[i] == 'M' ? hst::ribbon::GroupMedium
+                           : aStates[i] == 'S' ? hst::ribbon::GroupSmall
+                                               : hst::ribbon::GroupLarge;
+        if (aV3[i])
+            v3::Apply(*aWindows[i], aConfigs[i]); // a collapsed group's content stays large for its popup
+        if (aStates[i] == 'C')
+            HstGroupButton(*aWindows[i]);
+        m_aHstStates[aWindows[i]] = nState;
+    }
+    m_bHstLadder = false;
+    if (m_nHstUsed != nWasUsed)
+        HstNotifyUsedChanged();
+}
+
+void PriorityMergedHBox::HstSetSlack(tools::Long nSlack)
+{
+    if (nSlack == m_nHstSlack)
+        return;
+    m_nHstSlack = nSlack;
+    queue_resize();
+}
+
+void PriorityMergedHBox::HstDump(const vcl::Window& rOrigin, OStringBuffer& rOut) const
+{
+    rOut.append("\"more\":");
+    rOut.append(m_pButton && m_pButton->IsVisible() ? "true" : "false");
+    rOut.append(",\"wide\":");
+    rOut.append(m_bHstWide ? "true" : "false");
+    rOut.append(",\"sparse\":\"" + m_aHstSparse + "\",\"track_width\":"
+                + OString::number(sal_Int64(GetSizePixel().Width() + m_nHstSlack)) + ",\"groups\":[");
+    bool bFirst = true;
+    for (vcl::Window* pGroup : HstGroups())
+    {
+        if (std::find(m_aHstFolded.begin(), m_aHstFolded.end(), pGroup) != m_aHstFolded.end()
+            || !hst::ribbon::v3::IsGroup(*pGroup))
+            continue;
+        const auto itState = m_aHstStates.find(pGroup);
+        const int nState = itState == m_aHstStates.end() ? 0 : itState->second;
+        const char cState = nState == hst::ribbon::GroupCollapsed ? 'C'
+                            : nState == hst::ribbon::GroupMedium ? 'M'
+                            : nState == hst::ribbon::GroupSmall ? 'S'
+                                                                : 'L';
+        tools::Rectangle aFold;
+        if (cState == 'C')
+        {
+            const auto it = m_aHstGroupButtons.find(pGroup);
+            if (it != m_aHstGroupButtons.end() && it->second)
+            {
+                const Point aPos = it->second->OutputToScreenPixel(Point()) - rOrigin.OutputToScreenPixel(Point());
+                aFold = tools::Rectangle(aPos, it->second->GetSizePixel());
+            }
+        }
+        rOut.append(bFirst ? "" : ",");
+        hst::ribbon::v3::Dump(*pGroup, rOrigin, cState, aFold, rOut);
+        bFirst = false;
+    }
+    rOut.append("]");
+}
