+Color Theme::GetHstFrameColor(const ThemeItem eItem, const Color& rDefault, const StyleSettings& rStyle)
+{
+    switch (eItem)
+    {
+        case Color_TabBarBackground:
+        case Color_DeckTitleBarBackground:
+        case Color_PanelTitleBarBackground:
+            if (hst::coat::FrameCoatActive(hst::coat::FrameComponent::Sidebar, rStyle))
+                return hst::design::GetPalette(rStyle).aFrameSurface;
+            return rDefault;
+        default:
+            return rDefault; // the contents keep the platform's colours
+    }
+}
+
+bool Theme::DrawHstTabBarFrame(vcl::RenderContext& rDev, const Size& rSize, const tools::Rectangle& rChecked)
+{
+    const StyleSettings& rStyle = rDev.GetSettings().GetStyleSettings();
+    if (!hst::coat::FrameCoatActive(hst::coat::FrameComponent::Sidebar, rStyle))
+        return false;
+    namespace d = hst::design;
+    const d::Palette& rPalette = d::GetPalette(rStyle);
+    const double fScale = std::max(1.0, double(rDev.GetDPIScaleFactor()));
+    auto aPush = rDev.ScopedPush(vcl::PushFlags::LINECOLOR | vcl::PushFlags::FILLCOLOR);
+    rDev.SetLineColor();
+    rDev.SetFillColor(rPalette.aFrameSurface);
+    rDev.DrawRect(tools::Rectangle(Point(0, 0), rSize));
+    const tools::Long nLine = std::max<tools::Long>(1, std::lround(d::size::FrameDivider * fScale));
+    rDev.SetFillColor(rPalette.aFrameDivider);
+    rDev.DrawRect(tools::Rectangle(Point(0, 0), Size(nLine, rSize.Height())));
+    if (!rChecked.IsEmpty())
+    {
+        // in the margin between the edge and the button, never over the button
+        const tools::Long nBar = std::min<tools::Long>(
+            std::lround(d::size::TabIndicator * fScale), std::max<tools::Long>(0, rChecked.Left()));
+        const tools::Long nHeight = rChecked.GetHeight() / 2;
+        if (nBar > 0 && nHeight > 0)
+        {
+            rDev.SetFillColor(rPalette.aSelectedIndicator);
+            rDev.DrawRect(tools::Rectangle(
+                Point(rChecked.Left() - nBar, rChecked.Top() + (rChecked.GetHeight() - nHeight) / 2),
+                Size(nBar, nHeight)));
+        }
+    }
+    return true;
+}
