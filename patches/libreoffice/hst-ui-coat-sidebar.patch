+void DeckTitleBar::UpdateTitleFont()
+{
+    // HST Office: in the sidebar's frame coat the deck's name is a title of the type scale. Without
+    // it the label keeps deck.ui's font, or, once the coat went off (high contrast), the application
+    // font in bold like deck.ui's.
+    const StyleSettings& rStyle = Application::GetSettings().GetStyleSettings();
+    const bool bCoat = hst::coat::FrameCoatActive(hst::coat::FrameComponent::Sidebar, rStyle);
