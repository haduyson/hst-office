 namespace sfx2::sidebar {
 
+namespace
+{
+/** HST Office, VCL backends: the panel title bars (panel.ui's "titlebar" boxes) under this window get
+    a background of the frame surface with the frame's divider along their top, as one tiled bitmap
+    taller than any title bar, so the line takes no space. On gtk3 the native title bars are not VCL
+    windows and their CSS draws the line (vcl/source/hst/coat/css/sidebar.cxx). */
+void ApplyHstPanelTitleDividers(vcl::Window& rWindow, const Wallpaper& rWallpaper)
+{
+    for (vcl::Window* pChild = rWindow.GetWindow(GetWindowType::FirstChild); pChild;
+         pChild = pChild->GetWindow(GetWindowType::Next))
+    {
+        if (pChild->get_id() == "titlebar" && rWindow.get_id() == "Panel")
+            pChild->SetBackground(rWallpaper);
+        else
+            ApplyHstPanelTitleDividers(*pChild, rWallpaper);
+    }
+}
+}
+
+void Deck::ApplyHstFrame()
+{
+    const StyleSettings& rStyle = GetSettings().GetStyleSettings();
+    if (!hst::coat::FrameCoatActive(hst::coat::FrameComponent::Sidebar, rStyle))
+        return; // the title bars keep the theme's colour, set by TitleBar
+    const hst::design::Palette& rPalette = hst::design::GetPalette(rStyle);
+    const double fScale = std::max(1.0, double(GetDPIScaleFactor()));
+    const tools::Long nLine
+        = std::max<tools::Long>(1, std::lround(hst::design::size::FrameDivider * fScale));
+    const Size aTile(8, std::lround(256 * fScale));
+    ScopedVclPtrInstance<VirtualDevice> pTile;
+    pTile->SetOutputSizePixel(aTile);
+    pTile->SetLineColor();
+    pTile->SetFillColor(rPalette.aFrameSurface);
+    pTile->DrawRect(tools::Rectangle(Point(0, 0), aTile));
+    pTile->SetFillColor(rPalette.aFrameDivider);
+    pTile->DrawRect(tools::Rectangle(Point(0, 0), Size(aTile.Width(), nLine)));
+    Wallpaper aWallpaper(pTile->GetBitmap(Point(0, 0), aTile));
+    aWallpaper.SetColor(rPalette.aFrameSurface);
+    aWallpaper.SetStyle(WallpaperStyle::Tile);
+    ApplyHstPanelTitleDividers(*this, aWallpaper);
+}
+
