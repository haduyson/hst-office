+uno::Any SAL_CALL SwVbaParagraph::getOutlineLevel()
+{
+    sal_Int16 nLevel = 0;
+    uno::Reference<beans::XPropertySet>(mxTextRange, uno::UNO_QUERY_THROW)->getPropertyValue(u"OutlineLevel"_ustr) >>= nLevel;
+    return uno::Any(nLevel == 0 ? sal_Int32(10) : sal_Int32(nLevel)); // wdOutlineLevelBodyText is 10
+}
+
+void SAL_CALL SwVbaParagraph::setOutlineLevel(const uno::Any& rValue)
+{
+    sal_Int32 nLevel = 10;
+    rValue >>= nLevel;
+    uno::Reference<beans::XPropertySet>(mxTextRange, uno::UNO_QUERY_THROW)->setPropertyValue(u"OutlineLevel"_ustr, uno::Any(static_cast<sal_Int16>(nLevel == 10 ? 0 : nLevel)));
+}
+
+uno::Any SAL_CALL SwVbaParagraphs::Add(const uno::Any& rRange)
+{
+    uno::Reference<word::XRange> xRange;
+    uno::Reference<text::XText> xText = mxTextDocument->getText();
+    uno::Reference<text::XTextRange> xPlace = xText->getEnd();
+    if ((rRange >>= xRange) && xRange.is())
+        xPlace = xRange->getXTextRange()->getEnd();
+    xPlace->getText()->insertControlCharacter(xPlace, text::ControlCharacter::PARAGRAPH_BREAK, false);
+    return Item(uno::Any(getCount()), uno::Any());
+}
+
+double SAL_CALL SwVbaPageSetup::getPageWidth()
+{
+    sal_Int32 nWidth = 0;
+    mxPageProps->getPropertyValue(u"Width"_ustr) >>= nWidth;
+    return convertMm100ToPoint<double>(nWidth);
+}
+
+void SAL_CALL SwVbaPageSetup::setPageWidth(double fWidth) { mxPageProps->setPropertyValue(u"Width"_ustr, uno::Any(static_cast<sal_Int32>(convertPointToMm100(fWidth)))); }
+
+double SAL_CALL SwVbaPageSetup::getPageHeight()
+{
+    sal_Int32 nHeight = 0;
+    mxPageProps->getPropertyValue(u"Height"_ustr) >>= nHeight;
+    return convertMm100ToPoint<double>(nHeight);
+}
+
+void SAL_CALL SwVbaPageSetup::setPageHeight(double fHeight) { mxPageProps->setPropertyValue(u"Height"_ustr, uno::Any(static_cast<sal_Int32>(convertPointToMm100(fHeight)))); }
+
+sal_Int32 SAL_CALL SwVbaPageSetup::getPaperSize()
+{
+    sal_Int32 nWidth = 0, nHeight = 0;
+    mxPageProps->getPropertyValue(u"Width"_ustr) >>= nWidth;
+    mxPageProps->getPropertyValue(u"Height"_ustr) >>= nHeight;
+    for (const PaperSize& rPaper : aPapers)
+        if ((std::abs(nWidth - rPaper.mnWidth) < 20 && std::abs(nHeight - rPaper.mnHeight) < 20) || (std::abs(nHeight - rPaper.mnWidth) < 20 && std::abs(nWidth - rPaper.mnHeight) < 20))
+            return rPaper.mnKind;
+    return word::WdPaperSize::wdPaperCustom;
+}
+
+void SAL_CALL SwVbaPageSetup::setPaperSize(sal_Int32 nSize)
+{
+    bool bLandscape = false;
+    mxPageProps->getPropertyValue(u"IsLandscape"_ustr) >>= bLandscape;
+    for (const PaperSize& rPaper : aPapers)
+        if (rPaper.mnKind == nSize)
+        {
+            mxPageProps->setPropertyValue(u"Width"_ustr, uno::Any(bLandscape ? rPaper.mnHeight : rPaper.mnWidth));
+            mxPageProps->setPropertyValue(u"Height"_ustr, uno::Any(bLandscape ? rPaper.mnWidth : rPaper.mnHeight));
+            return;
+        }
+    throw uno::RuntimeException(u"Not implemented for this paper size"_ustr);
+}
+
+uno::Any SAL_CALL SwVbaSections::Add(const uno::Any& rRange, const uno::Any& rStart)
+{
+    uno::Reference<word::XRange> xRange;
+    if (!(rRange >>= xRange) || !xRange.is())
+    {
+        uno::Reference<text::XText> xText = mxModel->getText();
+        xRange.set(new SwVbaRange(this, mxContext, mxModel, xText->getEnd(), xText->getEnd(), xText));
+    }
+    sal_Int32 nStart = word::WdBreakType::wdSectionBreakNextPage;
+    rStart >>= nStart;
+    xRange->InsertBreak(uno::Any(nStart));
+    return Item(uno::Any(getCount()), uno::Any());
+}
+
+uno::Any SAL_CALL SwVbaStyles::Add(const OUString& rName, const uno::Any&)
+{
+    rtl::Reference<SwXStyleFamily> xParagraphStyles = mxModel->getSwStyleFamilies()->GetParagraphStyles();
+    uno::Reference<style::XStyle> xStyle(mxModel->createInstance(u"com.sun.star.style.ParagraphStyle"_ustr), uno::UNO_QUERY_THROW);
+    xParagraphStyles->insertByName(rName, uno::Any(xStyle));
+    return Item(uno::Any(rName), uno::Any());
+}
