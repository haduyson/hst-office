+uno::Reference<text::XText> lcl_firstCell(const uno::Reference<text::XTextTable>& xTable, sal_Int32 nRow)
+{
+    uno::Reference<table::XCellRange> xCells(xTable, uno::UNO_QUERY_THROW);
+    return uno::Reference<text::XText>(xCells->getCellByPosition(0, nRow), uno::UNO_QUERY_THROW);
+}
+
+uno::Any lcl_item(const uno::Reference<XCollection>& xCol, const uno::Any& rIndex)
+{
+    return rIndex.hasValue() ? xCol->Item(rIndex, uno::Any()) : uno::Any(xCol);
+}
+}
+
+SwVbaTableRange::SwVbaTableRange(const uno::Reference<XHelperInterface>& xParent, const uno::Reference<uno::XComponentContext>& xContext,
+                                 const rtl::Reference<SwXTextDocument>& xDocument, const uno::Reference<text::XTextTable>& xTable,
+                                 sal_Int32 nFirstRow, sal_Int32 nLastRow)
+    : SwVbaRange(xParent, xContext, xDocument, lcl_firstCell(xTable, nFirstRow)->getStart(), lcl_firstCell(xTable, nFirstRow)->getEnd(), lcl_firstCell(xTable, nFirstRow))
+    , mxTable(xTable)
+    , mnFirstRow(nFirstRow)
+    , mnLastRow(nLastRow)
+{
+    SwVbaTableHelper aHelper(xTable);
+    uno::Reference<table::XCellRange> xWhole(xTable, uno::UNO_QUERY_THROW);
+    mxCells = xWhole->getCellRangeByName("A" + OUString::number(nFirstRow + 1) + ":"
+                                         + SwVbaTableHelper::getColumnStr(aHelper.getTabColumnsCount(nLastRow) - 1) + OUString::number(nLastRow + 1));
+}
+
+OUString SAL_CALL SwVbaTableRange::getText()
+{
+    // as Word gives it: each cell ends with its marks, as does each row
+    OUStringBuffer aText;
+    uno::Reference<table::XCellRange> xWhole(mxTable, uno::UNO_QUERY_THROW);
+    SwVbaTableHelper aHelper(mxTable);
+    for (sal_Int32 nRow = mnFirstRow; nRow <= mnLastRow; ++nRow)
+    {
+        for (sal_Int32 nColumn = 0, n = aHelper.getTabColumnsCount(nRow); nColumn < n; ++nColumn)
+        {
+            uno::Reference<text::XText> xCell(xWhole->getCellByPosition(nColumn, nRow), uno::UNO_QUERY_THROW);
+            aText.append(xCell->getString() + u"\r\x0007");
+        }
+        aText.append(u"\r\x0007");
+    }
+    return aText.makeStringAndClear();
+}
+
+uno::Reference<word::XFont> SAL_CALL SwVbaTableRange::getFont()
+{
+    VbaPalette aColors;
+    return new SwVbaFont(this, mxContext, aColors.getPalette(), uno::Reference<beans::XPropertySet>(mxCells, uno::UNO_QUERY_THROW));
+}
+
+uno::Reference<word::XParagraphFormat> SAL_CALL SwVbaTableRange::getParagraphFormat()
+{
+    return new SwVbaParagraphFormat(this, mxContext, uno::Reference<beans::XPropertySet>(mxCells, uno::UNO_QUERY_THROW));
+}
+
+void SAL_CALL SwVbaTableRange::Select()
+{
+    uno::Reference<view::XSelectionSupplier> xSelection(getDocument()->getCurrentController(), uno::UNO_QUERY_THROW);
+    xSelection->select(uno::Any(mxCells));
+}
+
+sal_Int32 SAL_CALL SwVbaTableRange::Delete(const uno::Any&, const uno::Any&)
+{
+    // Word's Range.Delete empties the cells of a whole table or row and keeps them
+    sal_Int32 nGone = 0;
+    uno::Reference<table::XCellRange> xWhole(mxTable, uno::UNO_QUERY_THROW);
+    SwVbaTableHelper aHelper(mxTable);
+    for (sal_Int32 nRow = mnFirstRow; nRow <= mnLastRow; ++nRow)
+        for (sal_Int32 nColumn = 0, n = aHelper.getTabColumnsCount(nRow); nColumn < n; ++nColumn)
+        {
+            uno::Reference<text::XText> xCell(xWhole->getCellByPosition(nColumn, nRow), uno::UNO_QUERY_THROW);
+            nGone += xCell->getString().getLength();
+            xCell->setString(OUString());
+        }
+    return nGone;
+}
+
+uno::Any SAL_CALL SwVbaTableRange::Rows(const uno::Any& rIndex)
+{
+    rtl::Reference<SwXTextTable> xTable(dynamic_cast<SwXTextTable*>(mxTable.get()));
+    return lcl_item(new SwVbaRows(this, mxContext, xTable, xTable->getRows(), mnFirstRow, mnLastRow), rIndex);
+}
+
+uno::Any SAL_CALL SwVbaTableRange::Columns(const uno::Any& rIndex)
+{
+    return lcl_item(new SwVbaColumns(this, mxContext, mxTable, mxTable->getColumns()), rIndex);
+}
+
+uno::Any SAL_CALL SwVbaTableRange::Cells(const uno::Any& rIndex)
+{
+    SwVbaTableHelper aHelper(mxTable);
+    return lcl_item(new SwVbaCells(this, mxContext, mxTable, 0, mnFirstRow, aHelper.getTabColumnsCount(mnLastRow) - 1, mnLastRow), rIndex);
+}
