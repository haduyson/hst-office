+OUString lcl_name(sal_Int32 nColumn, sal_Int32 nRow) { return SwVbaTableHelper::getColumnStr(nColumn) + OUString::number(nRow + 1); }
+
+/// the index of the row or column to add before, or the end
+sal_Int32 lcl_before(const uno::Any& rBefore, sal_Int32 nCount)
+{
+    uno::Reference<word::XRow> xRow;
+    if ((rBefore >>= xRow) && xRow.is())
+        return xRow->getIndex() - 1;
+    uno::Reference<word::XColumn> xColumn;
+    if ((rBefore >>= xColumn) && xColumn.is())
+        return xColumn->getIndex() - 1;
+    return nCount;
+}
+
+void lcl_merge(const uno::Reference<text::XTextTable>& xTable, const OUString& rFrom, const OUString& rTo)
+{
+    uno::Reference<text::XTextTableCursor> xCursor = xTable->createCursorByCellName(rFrom);
+    xCursor->gotoCellByName(rTo, true);
+    xCursor->mergeRange();
+}
+}
