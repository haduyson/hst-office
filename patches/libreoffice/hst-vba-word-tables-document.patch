+SwVbaHyperlinks::SwVbaHyperlinks(const uno::Reference<XHelperInterface>& xParent, const uno::Reference<uno::XComponentContext>& xContext,
+                                 const rtl::Reference<SwXTextDocument>& xTextDocument, const uno::Reference<text::XTextRange>& xScope)
+    : CollTestImplHelper(xParent, xContext, new WordLinks(lcl_links(xTextDocument, xScope)))
+    , mxTextDocument(xTextDocument)
+    , mxScope(xScope)
+{
+}
+
+uno::Reference<word::XHyperlink> SAL_CALL SwVbaHyperlinks::Add(const uno::Any& rAnchor, const uno::Any& rAddress, const uno::Any& rSubAddress, const uno::Any&,
+                                                               const uno::Any& rTextToDisplay, const uno::Any&)
+{
+    uno::Reference<word::XRange> xAnchor;
+    rAnchor >>= xAnchor;
+    if (!xAnchor.is())
+        throw uno::RuntimeException(u"Hyperlinks.Add needs a range"_ustr);
+    uno::Reference<text::XTextRange> xPlace = dynamic_cast<SwVbaRange&>(*xAnchor).getXTextRange();
+    OUString aAddress, aSub, aText;
+    rAddress >>= aAddress;
+    rSubAddress >>= aSub;
+    uno::Reference<text::XTextCursor> xCursor = xPlace->getText()->createTextCursorByRange(xPlace);
+    if ((rTextToDisplay >>= aText) && !aText.isEmpty())
+        xCursor->setString(aText);
+    else if (xCursor->isCollapsed())
+        xCursor->setString(aAddress);
+    uno::Reference<beans::XPropertySet>(xCursor, uno::UNO_QUERY_THROW)->setPropertyValue(u"HyperLinkURL"_ustr, uno::Any(aSub.isEmpty() ? aAddress : aAddress + "#" + aSub));
+    return new WordLink(mxParent, mxContext, mxTextDocument, xCursor);
+}
+
+uno::Type SwVbaHyperlinks::getElementType() { return cppu::UnoType<word::XHyperlink>::get(); }
+
+uno::Reference<container::XEnumeration> SwVbaHyperlinks::createEnumeration() { return new LinksEnum(this); }
+
+uno::Any SwVbaHyperlinks::createCollectionObject(const uno::Any& aSource)
+{
+    uno::Reference<text::XTextRange> xRange(aSource, uno::UNO_QUERY_THROW);
+    return uno::Any(uno::Reference<word::XHyperlink>(new WordLink(mxParent, mxContext, mxTextDocument, xRange)));
+}
