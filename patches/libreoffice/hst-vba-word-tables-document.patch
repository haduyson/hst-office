+void SAL_CALL SwVbaDocument::ExportAsFixedFormat(const OUString& OutputFileName, sal_Int32, const uno::Any&, const uno::Any&, const uno::Any&, const uno::Any&, const uno::Any&, const uno::Any&,
+                                                 const uno::Any&, const uno::Any&, const uno::Any&, const uno::Any&, const uno::Any&, const uno::Any&)
+{
