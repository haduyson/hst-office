+    sal_Int16 nOrient = text::VertOrientation::TOP;
+    xProps->getPropertyValue(u"VertOrient"_ustr) >>= nOrient;
+    return uno::Any(nOrient == text::VertOrientation::CENTER   ? word::WdCellVerticalAlignment::wdCellAlignVerticalCenter
+                    : nOrient == text::VertOrientation::BOTTOM ? word::WdCellVerticalAlignment::wdCellAlignVerticalBottom
