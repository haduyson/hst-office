+sal_Bool SAL_CALL SwVbaDocument::Undo(const uno::Any& rTimes)
+{
+    sal_Int32 nTimes = 1;
+    rTimes >>= nTimes;
+    uno::Reference<document::XUndoManager> xUndo = uno::Reference<document::XUndoManagerSupplier>(getModel(), uno::UNO_QUERY_THROW)->getUndoManager();
+    bool bDone = false;
+    for (sal_Int32 i = 0; i < nTimes && xUndo->isUndoPossible(); ++i, bDone = true)
+        xUndo->undo();
+    return bDone;
+}
+
+sal_Bool SAL_CALL SwVbaDocument::Redo(const uno::Any& rTimes)
+{
+    sal_Int32 nTimes = 1;
+    rTimes >>= nTimes;
+    uno::Reference<document::XUndoManager> xUndo = uno::Reference<document::XUndoManagerSupplier>(getModel(), uno::UNO_QUERY_THROW)->getUndoManager();
+    bool bDone = false;
+    for (sal_Int32 i = 0; i < nTimes && xUndo->isRedoPossible(); ++i, bDone = true)
+        xUndo->redo();
+    return bDone;
+}
