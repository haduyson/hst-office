+uno::Reference<word::XNote> SAL_CALL SwVbaNotes::Add(const uno::Reference<word::XRange>& rRange, const uno::Any& rReference, const uno::Any& rText)
+{
+    uno::Reference<text::XFootnote> xNote(mxTextDocument->createInstance(mbEndnotes ? u"com.sun.star.text.Endnote"_ustr : u"com.sun.star.text.Footnote"_ustr), uno::UNO_QUERY_THROW);
+    OUString aLabel;
+    if (rReference >>= aLabel)
+        xNote->setLabel(aLabel);
+    uno::Reference<text::XTextRange> xPlace = dynamic_cast<SwVbaRange&>(*rRange).getXTextRange();
+    xPlace->getText()->insertTextContent(xPlace->getEnd(), xNote, false);
+    OUString aText;
+    if (rText >>= aText)
+        uno::Reference<text::XText>(xNote, uno::UNO_QUERY_THROW)->setString(aText);
+    return new Note(mxParent, mxContext, mxTextDocument, xNote, getCount());
