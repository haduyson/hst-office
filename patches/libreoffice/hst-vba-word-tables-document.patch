+    xProps->setPropertyValue(u"VertOrient"_ustr, uno::Any(nAlign == word::WdCellVerticalAlignment::wdCellAlignVerticalCenter   ? text::VertOrientation::CENTER
+                                                          : nAlign == word::WdCellVerticalAlignment::wdCellAlignVerticalBottom ? text::VertOrientation::BOTTOM
+                                                                                                                               : text::VertOrientation::TOP));
