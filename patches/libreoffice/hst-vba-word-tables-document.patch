+uno::Reference<word::XRange> SAL_CALL SwVbaTable::Range()
+{
+    uno::Reference<text::XTextTable> xTable(mxTextTable);
+    return new SwVbaTableRange(mxParent, mxContext, mxTextDocument, xTable, 0, mxTextTable->getRows()->getCount() - 1);
+}
+
+uno::Any SAL_CALL SwVbaTable::getStyle()
+{
+    uno::Reference<beans::XPropertySet> xProps(mxTextTable);
+    return xProps->getPropertyValue(u"TableTemplateName"_ustr);
+}
+
+void SAL_CALL SwVbaTable::setStyle(const uno::Any& rStyle)
+{
+    OUString aName;
+    rStyle >>= aName;
+    uno::Reference<beans::XPropertySet> xProps(mxTextTable);
+    xProps->setPropertyValue(u"TableTemplateName"_ustr, uno::Any(aName));
+    // Writer has no such style to draw from; Word's most used one is plain lines
+    if (aName.indexOf("Grid") >= 0)
+        uno::Reference<word::XBorders>(Borders(uno::Any()), uno::UNO_QUERY_THROW)->setEnable(uno::Any(true));
+}
+
+uno::Any SAL_CALL SwVbaTable::getPreferredWidth()
+{
+    uno::Reference<beans::XPropertySet> xProps(mxTextTable);
+    bool bRelative = false;
+    xProps->getPropertyValue(u"IsWidthRelative"_ustr) >>= bRelative;
+    sal_Int32 nValue = 0;
+    if (bRelative)
+    {
+        sal_Int16 nPercent = 0;
+        xProps->getPropertyValue(u"RelativeWidth"_ustr) >>= nPercent;
+        return uno::Any(static_cast<float>(nPercent));
+    }
+    xProps->getPropertyValue(u"Width"_ustr) >>= nValue;
+    return uno::Any(static_cast<float>(convertMm100ToPoint(nValue)));
+}
+
+void SAL_CALL SwVbaTable::setPreferredWidth(const uno::Any& rWidth)
+{
+    float fWidth = 0;
+    rWidth >>= fWidth;
+    uno::Reference<beans::XPropertySet> xProps(mxTextTable);
+    xProps->setPropertyValue(u"HoriOrient"_ustr, uno::Any(text::HoriOrientation::LEFT_AND_WIDTH));
+    if (mnPreferredWidthType == word::WdPreferredWidthType::wdPreferredWidthPercent)
+        xProps->setPropertyValue(u"RelativeWidth"_ustr, uno::Any(static_cast<sal_Int16>(fWidth)));
+    else
+        xProps->setPropertyValue(u"Width"_ustr, uno::Any(static_cast<sal_Int32>(convertPointToMm100(fWidth))));
+}
+
+uno::Any SAL_CALL SwVbaTable::getPreferredWidthType() { return uno::Any(mnPreferredWidthType); }
+
+void SAL_CALL SwVbaTable::setPreferredWidthType(const uno::Any& rType) { rType >>= mnPreferredWidthType; }
+
+void SAL_CALL SwVbaTable::AutoFitBehavior(sal_Int32 nBehavior)
+{
+    // to the window fills the width; to the content has no call to make, the table keeps its widths
+    if (nBehavior == word::WdAutoFitBehavior::wdAutoFitWindow)
+    {
+        uno::Reference<beans::XPropertySet> xProps(mxTextTable);
+        xProps->setPropertyValue(u"HoriOrient"_ustr, uno::Any(text::HoriOrientation::FULL));
+    }
+}
+
+uno::Any SAL_CALL SwVbaBorders::getEnable()
+{
+    uno::Reference<word::XBorder> xBorder(getItemByIntIndex(word::WdBorderType::wdBorderTop), uno::UNO_QUERY_THROW);
+    sal_Int32 nStyle = word::WdLineStyle::wdLineStyleNone;
+    xBorder->getLineStyle() >>= nStyle;
+    return uno::Any(nStyle != word::WdLineStyle::wdLineStyleNone);
+}
+
+void SAL_CALL SwVbaBorders::setEnable(const uno::Any& rValue)
+{
+    sal_Int32 nValue = 0;
+    bool bValue = false;
+    if (rValue >>= bValue)
+        nValue = bValue ? 1 : 0;
+    else
+        rValue >>= nValue;
+    const sal_Int32 nStyle = nValue == 0 ? word::WdLineStyle::wdLineStyleNone : word::WdLineStyle::wdLineStyleSingle;
+    static const sal_Int32 aSides[] = { word::WdBorderType::wdBorderTop, word::WdBorderType::wdBorderLeft, word::WdBorderType::wdBorderBottom,
+                                        word::WdBorderType::wdBorderRight, word::WdBorderType::wdBorderHorizontal, word::WdBorderType::wdBorderVertical };
+    for (sal_Int32 nSide : aSides)
+    {
+        uno::Reference<word::XBorder> xBorder(getItemByIntIndex(nSide), uno::UNO_QUERY_THROW);
+        xBorder->setLineStyle(uno::Any(nStyle));
+    }
+}
