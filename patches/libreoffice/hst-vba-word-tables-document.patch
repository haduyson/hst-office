+uno::Any lcl_neighbour(const uno::Reference<XHelperInterface>& xParent, const uno::Reference<uno::XComponentContext>& xContext, const rtl::Reference<SwXTextDocument>& xDocument,
+                       const uno::Reference<text::XTextRange>& xParagraph, const uno::Any& rCount, bool bForward)
+{
+    sal_Int32 nCount = 1;
+    rCount >>= nCount;
+    uno::Reference<text::XTextCursor> xCursor = xParagraph->getText()->createTextCursorByRange(bForward ? xParagraph->getEnd() : xParagraph->getStart());
+    uno::Reference<text::XParagraphCursor> xPara(xCursor, uno::UNO_QUERY_THROW);
+    for (sal_Int32 i = 0; i < nCount; ++i)
+        if (!(bForward ? xPara->gotoNextParagraph(false) : xPara->gotoPreviousParagraph(false)))
+            return uno::Any(); // Nothing as in Word
+    xPara->gotoStartOfParagraph(false);
+    xPara->gotoEndOfParagraph(true);
+    return uno::Any(uno::Reference<word::XParagraph>(new SwVbaParagraph(xParent, xContext, xDocument, xCursor)));
+}
+
+struct PaperSize
+{
+    sal_Int32 mnKind, mnWidth, mnHeight; // 1/100 mm
+};
+const PaperSize aPapers[] = { { word::WdPaperSize::wdPaperA3, 29700, 42000 },
+                              { word::WdPaperSize::wdPaperA4, 21000, 29700 },
+                              { word::WdPaperSize::wdPaperA5, 14800, 21000 },
+                              { word::WdPaperSize::wdPaperLetter, 21590, 27940 },
+                              { word::WdPaperSize::wdPaperLegal, 21590, 35560 } };
+}
+
+uno::Any SAL_CALL SwVbaParagraph::Next(const uno::Any& rCount) { return lcl_neighbour(mxParent, mxContext, mxTextDocument, mxTextRange, rCount, true); }
+uno::Any SAL_CALL SwVbaParagraph::Previous(const uno::Any& rCount) { return lcl_neighbour(mxParent, mxContext, mxTextDocument, mxTextRange, rCount, false); }
