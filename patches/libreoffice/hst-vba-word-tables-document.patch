+std::vector<uno::Reference<text::XTextRange>> lcl_links(const rtl::Reference<SwXTextDocument>& xDoc, const uno::Reference<text::XTextRange>& xScope)
+{
+    std::vector<uno::Reference<text::XTextRange>> aLinks;
+    uno::Reference<text::XText> xText = xScope.is() ? xScope->getText() : uno::Reference<text::XText>(xDoc->getText());
+    uno::Reference<text::XTextRangeCompare> xCompare(xText, uno::UNO_QUERY_THROW);
+    uno::Reference<container::XEnumerationAccess> xBody(xText, uno::UNO_QUERY_THROW);
+    uno::Reference<container::XEnumeration> xParagraphs = xBody->createEnumeration();
+    while (xParagraphs->hasMoreElements())
+    {
+        uno::Reference<container::XEnumerationAccess> xParagraph(xParagraphs->nextElement(), uno::UNO_QUERY);
+        if (!xParagraph.is())
+            continue; // a table
+        uno::Reference<container::XEnumeration> xPortions = xParagraph->createEnumeration();
+        while (xPortions->hasMoreElements())
+        {
+            uno::Reference<beans::XPropertySet> xPortion(xPortions->nextElement(), uno::UNO_QUERY_THROW);
+            OUString aUrl;
+            xPortion->getPropertyValue(u"HyperLinkURL"_ustr) >>= aUrl;
+            if (aUrl.isEmpty())
+                continue;
+            uno::Reference<text::XTextRange> xRange(xPortion, uno::UNO_QUERY_THROW);
+            if (xScope.is() && (xCompare->compareRegionStarts(xScope->getStart(), xRange) < 0 || xCompare->compareRegionEnds(xRange, xScope->getEnd()) < 0))
+                continue;
+            aLinks.push_back(xRange);
+        }
+    }
+    return aLinks;
+}
+
+class WordLinks : public ::cppu::WeakImplHelper<container::XIndexAccess>
+{
+    std::vector<uno::Reference<text::XTextRange>> maLinks;
+
+public:
+    explicit WordLinks(std::vector<uno::Reference<text::XTextRange>>&& rLinks)
+        : maLinks(std::move(rLinks))
+    {
+    }
+    sal_Int32 SAL_CALL getCount() override { return maLinks.size(); }
+    uno::Any SAL_CALL getByIndex(sal_Int32 nIndex) override
+    {
+        if (nIndex < 0 || nIndex >= getCount())
+            throw lang::IndexOutOfBoundsException();
+        return uno::Any(maLinks[nIndex]);
+    }
+    uno::Type SAL_CALL getElementType() override { return cppu::UnoType<text::XTextRange>::get(); }
+    sal_Bool SAL_CALL hasElements() override { return !maLinks.empty(); }
+};
+
+class WordLink : public InheritedHelperInterfaceWeakImpl<word::XHyperlink>
+{
+    rtl::Reference<SwXTextDocument> mxDoc;
+    uno::Reference<text::XTextRange> mxRange;
+    uno::Reference<beans::XPropertySet> mxProps;
+
+    // the part after # is Word's SubAddress
+    OUString part(bool bSub)
+    {
+        OUString aUrl;
+        mxProps->getPropertyValue(u"HyperLinkURL"_ustr) >>= aUrl;
+        const sal_Int32 nHash = aUrl.indexOf('#');
+        return nHash < 0 ? (bSub ? OUString() : aUrl) : (bSub ? aUrl.copy(nHash + 1) : aUrl.copy(0, nHash));
+    }
+
+public:
+    WordLink(const uno::Reference<XHelperInterface>& xParent, const uno::Reference<uno::XComponentContext>& xContext,
+         rtl::Reference<SwXTextDocument> xDoc, const uno::Reference<text::XTextRange>& xRange)
+        : InheritedHelperInterfaceWeakImpl(xParent, xContext)
+        , mxDoc(std::move(xDoc))
+        , mxRange(xRange->getText()->createTextCursorByRange(xRange), uno::UNO_QUERY_THROW)
+        , mxProps(mxRange, uno::UNO_QUERY_THROW)
+    {
+    }
+    OUString SAL_CALL getAddress() override { return part(false); }
+    void SAL_CALL setAddress(const OUString& rAddress) override
+    {
+        const OUString aSub = part(true);
+        mxProps->setPropertyValue(u"HyperLinkURL"_ustr, uno::Any(aSub.isEmpty() ? rAddress : rAddress + "#" + aSub));
+    }
+    OUString SAL_CALL getSubAddress() override { return part(true); }
+    void SAL_CALL setSubAddress(const OUString& rSub) override
+    {
+        const OUString aAddress = part(false);
+        mxProps->setPropertyValue(u"HyperLinkURL"_ustr, uno::Any(rSub.isEmpty() ? aAddress : aAddress + "#" + rSub));
+    }
+    OUString SAL_CALL getTextToDisplay() override { return mxRange->getString(); }
+    void SAL_CALL setTextToDisplay(const OUString& rText) override { mxRange->setString(rText); }
+    uno::Reference<word::XRange> SAL_CALL getRange() override
+    {
+        return new SwVbaRange(this, mxContext, mxDoc, mxRange->getStart(), mxRange->getEnd(), mxRange->getText());
+    }
+    void SAL_CALL Delete() override { mxProps->setPropertyValue(u"HyperLinkURL"_ustr, uno::Any(OUString())); }
+    OUString getServiceImplName() override { return u"SwVbaHyperlink"_ustr; }
+    uno::Sequence<OUString> getServiceNames() override { return { u"ooo.vba.word.Hyperlink"_ustr }; }
+};
+
+class LinksEnum : public EnumerationHelper_BASE
+{
+    uno::Reference<XCollection> mxCollection;
+    sal_Int32 mnIndex = 0;
+
+public:
+    explicit LinksEnum(uno::Reference<XCollection> xCollection)
+        : mxCollection(std::move(xCollection))
+    {
+    }
+    sal_Bool SAL_CALL hasMoreElements() override { return mnIndex < mxCollection->getCount(); }
+    uno::Any SAL_CALL nextElement() override
+    {
+        if (mnIndex < mxCollection->getCount())
+            return mxCollection->Item(uno::Any(++mnIndex), uno::Any());
+        throw container::NoSuchElementException();
+    }
+};
+}
