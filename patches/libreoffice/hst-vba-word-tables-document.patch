+{
+const sal_Int32 WD_COLOR_AUTOMATIC = -16777216;
+}
+
+SwVbaShading::SwVbaShading(const uno::Reference<XHelperInterface>& xParent, const uno::Reference<uno::XComponentContext>& xContext,
+                           uno::Reference<beans::XPropertySet> xProps, OUString aColorProperty)
+    : SwVbaShading_BASE(xParent, xContext)
+    , mxProps(std::move(xProps))
+    , maColorProperty(std::move(aColorProperty))
+{
+}
+
+uno::Any SAL_CALL SwVbaShading::getBackgroundPatternColor()
+{
+    sal_Int32 nColor = -1;
+    mxProps->getPropertyValue(maColorProperty) >>= nColor;
+    return uno::Any(nColor == -1 ? WD_COLOR_AUTOMATIC : OORGBToXLRGB(nColor));
+}
+
+void SAL_CALL SwVbaShading::setBackgroundPatternColor(const uno::Any& rValue)
+{
+    sal_Int32 nColor = WD_COLOR_AUTOMATIC;
+    rValue >>= nColor;
+    mxProps->setPropertyValue(maColorProperty, uno::Any(nColor == WD_COLOR_AUTOMATIC ? sal_Int32(-1) : XLRGBToOORGB(nColor)));
+}
+
+uno::Any SAL_CALL SwVbaShading::getBackgroundPatternColorIndex()
+{
+    sal_Int32 nColor = -1;
+    mxProps->getPropertyValue(maColorProperty) >>= nColor;
+    if (nColor == -1)
+        return uno::Any(sal_Int32(0)); // wdAuto
+    VbaPalette aPalette;
+    const uno::Reference<container::XIndexAccess>& xPalette = aPalette.getPalette();
+    for (sal_Int32 i = 0; i < xPalette->getCount(); ++i)
+    {
+        sal_Int32 nEntry = 0;
+        if ((xPalette->getByIndex(i) >>= nEntry) && nEntry == nColor)
+            return uno::Any(i);
+    }
+    return uno::Any(sal_Int32(9999999)); // wdUndefined
+}
+
+void SAL_CALL SwVbaShading::setBackgroundPatternColorIndex(const uno::Any& rValue)
+{
+    sal_Int32 nIndex = 0, nColor = -1;
+    rValue >>= nIndex;
+    if (nIndex > 0)
+    {
+        VbaPalette aPalette;
+        aPalette.getPalette()->getByIndex(nIndex) >>= nColor;
+    }
+    mxProps->setPropertyValue(maColorProperty, uno::Any(nColor));
+}
