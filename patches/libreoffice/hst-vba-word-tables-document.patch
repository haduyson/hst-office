+uno::Any SAL_CALL SwVbaRow::getHeadingFormat()
+{
+    uno::Reference<beans::XPropertySet> xProps(mxTextTable, uno::UNO_QUERY_THROW);
+    sal_Int32 nCount = 0;
+    xProps->getPropertyValue(u"HeaderRowCount"_ustr) >>= nCount;
+    return uno::Any(mnIndex < nCount);
+}
+
+void SAL_CALL SwVbaRow::setHeadingFormat(const uno::Any& rValue)
+{
+    bool bOn = false;
+    sal_Int32 nOn = 0;
+    if (!(rValue >>= bOn) && (rValue >>= nOn))
+        bOn = nOn != 0;
+    uno::Reference<beans::XPropertySet> xProps(mxTextTable, uno::UNO_QUERY_THROW);
+    xProps->setPropertyValue(u"RepeatHeadline"_ustr, uno::Any(bOn));
+    xProps->setPropertyValue(u"HeaderRowCount"_ustr, uno::Any(bOn ? mnIndex + 1 : sal_Int32(0)));
+}
+
+void SAL_CALL SwVbaRow::Delete() { mxTableRows->removeByIndex(mnIndex, 1); }
+
+uno::Any SAL_CALL SwVbaRows::Add(const uno::Any& rBeforeRow)
+{
+    const sal_Int32 nIndex = lcl_before(rBeforeRow, mxTableRows->getCount());
+    mxTableRows->insertByIndex(nIndex, 1);
+    return uno::Any(uno::Reference<word::XRow>(new SwVbaRow(this, mxContext, mxTextTable, nIndex)));
