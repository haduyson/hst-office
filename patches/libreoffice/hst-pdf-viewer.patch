+void PdfViewerWindow::showSignPanel(bool bShow)
+{
+    if (m_xSign->get_active() != bShow)
+        m_xSign->set_active(bShow);
+    paintPrimaryButton(*m_xSign, XsResId(STR_HSTPDF_SIGN), bShow, true);
+    m_xSignSeparator->set_visible(bShow);
+    m_xSignPanel->set_visible(bShow);
+    if (bShow && !m_bCertificateLookedUp)
+    {
+        m_bCertificateLookedUp = true;
+        weld::WaitObject aWait(GetFrameWeld());
+        m_xCertificate = lastUsedCertificate();
+    }
+    if (bShow && m_xVisible->get_active() && !m_xPages->getPlacement())
+        defaultPlacement();
+    m_xPages->setPlacementMode(bShow && m_xVisible->get_active());
+    m_xPages->setPlacement(bShow && m_xVisible->get_active() ? m_xPages->getPlacement()
+                                                             : std::nullopt);
+    updateSignPanel();
+    m_xPages->Invalidate();
