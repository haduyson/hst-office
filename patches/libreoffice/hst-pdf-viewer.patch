+constexpr OUString LOADER_SERVICE = u"com.sun.star.frame.SynchronousFrameLoader"_ustr;
+
+typedef comphelper::WeakComponentImplHelper<frame::XController, frame::XTitle,
+                                            frame::XTitleChangeBroadcaster,
+                                            frame::XDispatchProvider, frame::XNotifyingDispatch,
+                                            lang::XServiceInfo>
+    PdfViewerControllerBase;
+
+class PdfViewerController final : public PdfViewerControllerBase
+{
+public:
+    explicit PdfViewerController(VclPtr<PdfViewerWindow> pWindow)
+        : m_pWindow(std::move(pWindow))
+    {
+        m_pWindow->setTitleChangedHdl(LINK(this, PdfViewerController, TitleChangedHdl));
+    }
+
+    // XController
+    void SAL_CALL attachFrame(const uno::Reference<frame::XFrame>& xFrame) override
+    {
+        SolarMutexGuard aGuard;
+        m_xFrame = xFrame;
+        if (m_pWindow)
+            m_pWindow->setFrame(xFrame);
+    }
+    sal_Bool SAL_CALL attachModel(const uno::Reference<frame::XModel>&) override { return false; }
+    sal_Bool SAL_CALL suspend(sal_Bool) override { return true; } // nothing to save
+    uno::Any SAL_CALL getViewData() override { return {}; }
+    void SAL_CALL restoreViewData(const uno::Any&) override {}
+    uno::Reference<frame::XModel> SAL_CALL getModel() override { return {}; }
+    uno::Reference<frame::XFrame> SAL_CALL getFrame() override { return m_xFrame; }
+
+    // XTitle
+    OUString SAL_CALL getTitle() override
+    {
+        SolarMutexGuard aGuard;
+        return m_pWindow ? m_pWindow->getTitle() : OUString();
+    }
+    void SAL_CALL setTitle(const OUString&) override {}
+
+    // XTitleChangeBroadcaster
+    void SAL_CALL addTitleChangeListener(const uno::Reference<frame::XTitleChangeListener>& xListener) override
+    {
+        std::unique_lock aGuard(m_aMutex);
+        m_aTitleListeners.addInterface(aGuard, xListener);
+    }
+    void SAL_CALL removeTitleChangeListener(const uno::Reference<frame::XTitleChangeListener>& xListener) override
+    {
+        std::unique_lock aGuard(m_aMutex);
+        m_aTitleListeners.removeInterface(aGuard, xListener);
+    }
+
+    // XDispatchProvider
+    uno::Reference<frame::XDispatch> SAL_CALL queryDispatch(const util::URL& rURL, const OUString&,
+                                                            sal_Int32) override
+    {
+        if (PdfViewerWindow::isCommand(rURL.Complete))
+            return this;
+        return {};
+    }
+    uno::Sequence<uno::Reference<frame::XDispatch>> SAL_CALL
+    queryDispatches(const uno::Sequence<frame::DispatchDescriptor>& rRequests) override
+    {
+        uno::Sequence<uno::Reference<frame::XDispatch>> aResult(rRequests.getLength());
+        auto pResult = aResult.getArray();
+        for (sal_Int32 i = 0; i < rRequests.getLength(); ++i)
+            pResult[i] = queryDispatch(rRequests[i].FeatureURL, rRequests[i].FrameName,
+                                       rRequests[i].SearchFlags);
+        return aResult;
+    }
+
+    // XDispatch
+    void SAL_CALL dispatch(const util::URL& rURL, const uno::Sequence<beans::PropertyValue>& rArgs) override
+    {
+        dispatchWithNotification(rURL, rArgs, {});
+    }
+    void SAL_CALL addStatusListener(const uno::Reference<frame::XStatusListener>&, const util::URL&) override {}
+    void SAL_CALL removeStatusListener(const uno::Reference<frame::XStatusListener>&, const util::URL&) override {}
+
+    // XNotifyingDispatch
+    void SAL_CALL dispatchWithNotification(const util::URL& rURL,
+                                           const uno::Sequence<beans::PropertyValue>& rArgs,
+                                           const uno::Reference<frame::XDispatchResultListener>& xListener) override
+    {
+        uno::Any aResult;
+        bool bDone = false;
+        {
+            SolarMutexGuard aGuard;
+            // keep the window alive: a command may close the frame (Edit in HST Draw)
+            VclPtr<PdfViewerWindow> pWindow = m_pWindow;
+            if (pWindow && !pWindow->isDisposed())
+                bDone = pWindow->executeCommand(rURL.Complete, comphelper::SequenceAsHashMap(rArgs), aResult);
+        }
+        if (xListener.is())
+            xListener->dispatchFinished(frame::DispatchResultEvent(
+                getXWeak(), bDone ? frame::DispatchResultState::SUCCESS : frame::DispatchResultState::FAILURE,
+                aResult));
+    }
+
+    // XServiceInfo
+    OUString SAL_CALL getImplementationName() override
+    {
+        return u"org.hasontech.comp.PdfViewerController"_ustr;
+    }
+    sal_Bool SAL_CALL supportsService(const OUString& rName) override
+    {
+        return cppu::supportsService(this, rName);
+    }
+    uno::Sequence<OUString> SAL_CALL getSupportedServiceNames() override { return { CONTROLLER_SERVICE }; }
+
+private:
+    void disposing(std::unique_lock<std::mutex>& rGuard) override
+    {
+        m_aTitleListeners.disposeAndClear(rGuard, lang::EventObject(getXWeak()));
+        rGuard.unlock();
+        {
+            SolarMutexGuard aGuard;
+            if (m_pWindow)
+            {
+                m_pWindow->setTitleChangedHdl(Link<PdfViewerWindow&, void>());
+                m_pWindow.disposeAndClear();
+            }
+            m_xFrame.clear();
+        }
+        rGuard.lock();
+    }
+
+    DECL_LINK(TitleChangedHdl, PdfViewerWindow&, void);
+
+    VclPtr<PdfViewerWindow> m_pWindow;
+    uno::Reference<frame::XFrame> m_xFrame;
+    comphelper::OInterfaceContainerHelper4<frame::XTitleChangeListener> m_aTitleListeners;
+};
+
+IMPL_LINK_NOARG(PdfViewerController, TitleChangedHdl, PdfViewerWindow&, void)
+{
+    frame::TitleChangedEvent aEvent(getXWeak(), m_pWindow ? m_pWindow->getTitle() : OUString());
+    std::unique_lock aGuard(m_aMutex);
+    m_aTitleListeners.notifyEach(aGuard, &frame::XTitleChangeListener::titleChanged, aEvent);
+}
