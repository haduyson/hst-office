+class PdfViewerFrameLoader final
+    : public cppu::WeakImplHelper<frame::XSynchronousFrameLoader, lang::XServiceInfo>
+{
+public:
+    explicit PdfViewerFrameLoader(uno::Reference<uno::XComponentContext> xContext)
+        : m_xContext(std::move(xContext))
+    {
+    }
+
+    sal_Bool SAL_CALL load(const uno::Sequence<beans::PropertyValue>& rDescriptor,
+                           const uno::Reference<frame::XFrame>& xFrame) override
+    {
+        const auto tStart = std::chrono::steady_clock::now();
+        comphelper::SequenceAsHashMap aDescriptor(rDescriptor);
+        if (!xFrame.is() || openInDraw(aDescriptor))
+            return delegate(rDescriptor, xFrame);
+
+        const OUString aURL = aDescriptor.getUnpackedValueOrDefault(utl::MediaDescriptor::PROP_URL, OUString());
+        std::vector<sal_uInt8> aData;
+        if (!readFile(aDescriptor, aURL, aData))
+            return delegate(rDescriptor, xFrame);
+
+        SolarMutexGuard aGuard;
+        VclPtr<vcl::Window> pParent = VCLUnoHelper::GetWindow(xFrame->getContainerWindow());
+        if (!pParent)
+            return delegate(rDescriptor, xFrame);
+        VclPtr<PdfViewerWindow> pWindow = VclPtr<PdfViewerWindow>::Create(pParent);
+        if (!pWindow->loadDocument(aURL, std::move(aData), tStart))
+        {
+            pWindow.disposeAndClear();
+            return delegate(rDescriptor, xFrame);
+        }
+        rtl::Reference<PdfViewerController> xController = new PdfViewerController(pWindow);
+        xFrame->setComponent(VCLUnoHelper::GetInterface(pWindow), xController);
+        xController->attachFrame(xFrame);
+        sizeNewWindow(*pParent);
+        pWindow->Show();
+        return true;
+    }
+
+    void SAL_CALL cancel() override {}
+
+    OUString SAL_CALL getImplementationName() override
+    {
+        return u"org.hasontech.comp.PdfViewerFrameLoader"_ustr;
+    }
+    sal_Bool SAL_CALL supportsService(const OUString& rName) override
+    {
+        return cppu::supportsService(this, rName);
+    }
+    uno::Sequence<OUString> SAL_CALL getSupportedServiceNames() override { return { LOADER_SERVICE }; }
+
+private:
+    /// The full Draw import (or Writer/Impress for hybrid PDFs) instead of the viewer.
+    static bool openInDraw(const comphelper::SequenceAsHashMap& rDescriptor)
+    {
+        if (Application::IsHeadlessModeEnabled() || comphelper::LibreOfficeKit::isActive())
+            return true;
+        if (!officecfg::Office::HSTPdfViewer::Viewer::OpenPdfInViewer::get())
+            return true;
+        // hidden loads (scripts, --convert-to, printing from the command line) need a model
+        if (rDescriptor.getUnpackedValueOrDefault(utl::MediaDescriptor::PROP_HIDDEN, false)
+            || rDescriptor.getUnpackedValueOrDefault(utl::MediaDescriptor::PROP_PREVIEW, false)
+            || rDescriptor.getUnpackedValueOrDefault(u"HSTPdfOpenInDraw"_ustr, false))
+            return true;
+        // "PDF (Writer/Impress)" chosen in the Open dialog, or a hybrid PDF with an ODF inside
+        const OUString aFilter
+            = rDescriptor.getUnpackedValueOrDefault(utl::MediaDescriptor::PROP_FILTERNAME, OUString());
+        return !aFilter.isEmpty() && aFilter != "draw_pdf_import";
+    }
+
+    bool delegate(const uno::Sequence<beans::PropertyValue>& rDescriptor,
+                  const uno::Reference<frame::XFrame>& xFrame)
+    {
+        uno::Reference<frame::XSynchronousFrameLoader> xLoader
+            = frame::OfficeFrameLoader::create(m_xContext);
+        return xLoader->load(rDescriptor, xFrame);
+    }
+
+    static bool readFile(const comphelper::SequenceAsHashMap& rDescriptor, const OUString& rURL,
+                         std::vector<sal_uInt8>& rData)
+    {
+        std::unique_ptr<SvStream> pStream;
+        uno::Reference<io::XInputStream> xInput = rDescriptor.getUnpackedValueOrDefault(
+            utl::MediaDescriptor::PROP_INPUTSTREAM, uno::Reference<io::XInputStream>());
+        if (xInput.is())
+            pStream = utl::UcbStreamHelper::CreateStream(xInput);
+        else if (!rURL.isEmpty())
+            pStream = utl::UcbStreamHelper::CreateStream(rURL, StreamMode::READ | StreamMode::SHARE_DENYNONE);
+        if (!pStream || pStream->GetError())
+            return false;
+        pStream->Seek(0);
+        const sal_uInt64 nSize = pStream->TellEnd();
+        if (nSize < 8)
+            return false;
+        rData.resize(nSize);
+        return pStream->ReadBytes(rData.data(), nSize) == nSize;
+    }
+
+    /// A frame created for this file starts small: give it a comfortable reading size.
+    static void sizeNewWindow(vcl::Window& rContainer)
+    {
+        vcl::Window* pTop = rContainer.GetSystemWindow();
+        if (!pTop)
+            return;
+        const Size aSize = pTop->GetSizePixel();
+        if (aSize.Width() >= 800 && aSize.Height() >= 560)
+            return;
+        const AbsoluteScreenPixelRectangle aDesktop = pTop->GetDesktopRectPixel();
+        pTop->SetSizePixel(Size(std::min<tools::Long>(1280, aDesktop.GetWidth() * 9 / 10),
+                                std::min<tools::Long>(880, aDesktop.GetHeight() * 9 / 10)));
+    }
+
+    uno::Reference<uno::XComponentContext> m_xContext;
+};
+}
