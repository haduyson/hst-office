+#pragma once
+
+// HST PDF: the scrolling page column. The same widget shows the pages (zoom, text selection,
+// search highlights, signature box) and the thumbnail strip (fixed small scale, page numbers).
+// Only the pages in view are rendered; bitmaps are cached.
+
+#include "pdfviewerdocument.hxx"
+
+#include <tools/link.hxx>
+#include <vcl/idle.hxx>
