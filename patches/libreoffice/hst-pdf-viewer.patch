+# HST PDF: the lightweight PDF viewer (opens PDF files; "Edit in HST Draw" switches to Draw)
+[Desktop Entry]
+Version=1.0
+Terminal=false
+Icon=draw
+Type=Application
+Categories=Office;Viewer;
+Exec=${UNIXBASISROOTNAME} %%FILE%%
+MimeType=application/pdf;
+Name=HST PDF
+GenericName=PDF Viewer
+Comment=View PDF files and sign them digitally.
+StartupNotify=true
+X-GIO-NoFuse=true
+Keywords=PDF;Viewer;Digital signature;
+InitialPreference=6
+X-KDE-Protocols=file,http,webdav,webdavs
