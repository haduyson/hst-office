+void PdfViewerWindow::updateStatus()
+{
+    if (!m_xDocument)
+        return;
+    m_xStatusPage->set_label(XsResId(STR_HSTPDF_PAGE_STATUS)
+                                 .replaceFirst("%1", OUString::number(m_xPages->getCurrentPage() + 1))
+                                 .replaceFirst("%2", OUString::number(m_xDocument->getPageCount())));
+    OUString aSign;
+    if (m_xDocument->getSignatureCount() == 0)
+        aSign = XsResId(STR_HSTPDF_NOT_SIGNED);
+    else if (!m_bSignaturesChecked)
+        aSign = XsResId(STR_HSTPDF_SIG_CHECKING);
+    else if (m_aSignatures.nInvalid > 0)
+        aSign = XsResId(STR_HSTPDF_SIG_INVALID);
+    else if (m_aSignatures.nUntrusted > 0)
+        aSign = XsResId(STR_HSTPDF_SIG_UNTRUSTED);
+    else
+        aSign = XsResId(STR_HSTPDF_SIG_VALID).replaceFirst("%1", OUString::number(m_aSignatures.nValid));
+    m_xStatusSign->set_label(aSign);
+    if (m_nOpenMillis >= 0)
+        setInfo(XsResId(STR_HSTPDF_OPEN_TIME).replaceFirst("%1", formatSeconds(m_nOpenMillis)));
