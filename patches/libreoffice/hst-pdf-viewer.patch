+void PdfViewerWindow::startSignatureCheck()
+{
+    if (m_pSignatureCheckEvent)
+        Application::RemoveUserEvent(m_pSignatureCheckEvent);
+    m_pSignatureCheckEvent = nullptr;
+    if (!m_xDocument || m_xDocument->getSignatureCount() == 0)
+    {
+        m_bSignaturesChecked = true;
+        updateSignPanel();
+        return;
+    }
+    // after the first page is on screen: verification initialises the certificate store
+    m_pSignatureCheckEvent
+        = Application::PostUserEvent(LINK(this, PdfViewerWindow, SignatureCheckHdl));
+}
+
+IMPL_LINK_NOARG(PdfViewerWindow, SignatureCheckHdl, void*, void)
+{
+    m_pSignatureCheckEvent = nullptr;
+    if (!m_xDocument)
+        return;
+    m_aSignatures = verifySignatures(m_xDocument->getData());
+    m_bSignaturesChecked = true;
+    updateStatus();
+    updateSignPanel();
+}
