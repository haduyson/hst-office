+/// The chosen certificate in the signing panel: signer, authority and expiry in a green card.
+class CertificateCard final : public weld::CustomWidgetController
+{
+public:
+    void setCertificate(const CertificateDescription* pDescription)
+    {
+        m_oDescription.reset();
+        if (pDescription)
+            m_oDescription = *pDescription;
+        Invalidate();
+    }
+    OUString getSubject() const { return m_oDescription ? m_oDescription->aSubject : OUString(); }
+
+    void Paint(vcl::RenderContext& rRenderContext, const tools::Rectangle&) override
+    {
+        const Size aSize = GetOutputSizePixel();
+        const bool bChosen = m_oDescription.has_value();
+        rRenderContext.SetBackground(
+            Wallpaper(Application::GetSettings().GetStyleSettings().GetDialogColor()));
+        rRenderContext.Erase();
+        rRenderContext.SetLineColor(bChosen ? (m_oDescription->bExpired ? COL_LIGHTRED : COL_SIGN_GREEN)
+                                            : COL_CARD_BORDER);
+        rRenderContext.SetFillColor(bChosen ? COL_SIGN_GREEN_LIGHT : COL_WHITE);
+        rRenderContext.DrawRect(tools::Rectangle(Point(0, 0), Size(aSize.Width(), aSize.Height())), 6,
+                                6);
+        const OUString aTitle = bChosen ? m_oDescription->aSubject : XsResId(STR_HSTPDF_NO_CERT);
+        const OUString aDetail
+            = bChosen ? m_oDescription->aIssuer + u" · "_ustr + m_oDescription->aValidity
+                      : XsResId(STR_HSTPDF_NO_CERT_HINT);
+        vcl::Font aFont = rRenderContext.GetFont();
+        rRenderContext.Push(vcl::PushFlags::FONT | vcl::PushFlags::TEXTCOLOR);
+        const tools::Long nPad = 10;
+        tools::Rectangle aText(Point(nPad, nPad), Size(aSize.Width() - 2 * nPad, aSize.Height() - 2 * nPad));
+        aFont.SetWeight(WEIGHT_BOLD);
+        rRenderContext.SetFont(aFont);
+        rRenderContext.SetTextColor(COL_BLACK);
+        rRenderContext.DrawText(aText, aTitle, DrawTextFlags::Left | DrawTextFlags::Top | DrawTextFlags::EndEllipsis);
+        aText.AdjustTop(rRenderContext.GetTextHeight() + 4);
+        aFont.SetWeight(WEIGHT_NORMAL);
+        rRenderContext.SetFont(aFont);
+        rRenderContext.SetTextColor(bChosen && m_oDescription->bExpired ? COL_LIGHTRED : COL_MUTED);
+        rRenderContext.DrawText(aText, aDetail,
+                                DrawTextFlags::Left | DrawTextFlags::Top | DrawTextFlags::MultiLine
+                                    | DrawTextFlags::WordBreak);
+        rRenderContext.Pop();
+    }
+
+private:
+    std::optional<CertificateDescription> m_oDescription;
+};
