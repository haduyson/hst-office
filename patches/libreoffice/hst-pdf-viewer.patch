+bool PdfViewerWindow::PreNotify(NotifyEvent& rNEvt)
+{
+    if (rNEvt.GetType() != NotifyEventType::KEYINPUT || !m_xDocument)
+        return InterimItemWindow::PreNotify(rNEvt);
+    const KeyEvent* pEvent = rNEvt.GetKeyEvent();
+    const vcl::KeyCode& rKey = pEvent->GetKeyCode();
+    const bool bInEntry = m_xSearch->has_focus() || m_xPage->has_focus() || m_xReason->has_focus()
+                          || m_xZoom->has_focus();
+    if (rKey.IsMod1() && !rKey.IsMod2())
+    {
+        switch (rKey.GetCode())
+        {
+            case KEY_F:
+                m_xSearch->grab_focus();
+                m_xSearch->select_region(0, -1);
+                return true;
+            case KEY_P:
+                print();
+                return true;
+            case KEY_ADD:
+            case KEY_EQUAL:
+                m_xPages->setZoom(m_xPages->getZoom() * 1.25);
+                return true;
+            case KEY_SUBTRACT:
+                m_xPages->setZoom(m_xPages->getZoom() / 1.25);
+                return true;
+            case KEY_0:
+                m_xPages->setZoom(1.0);
+                return true;
+            case KEY_C:
+                if (!bInEntry)
+                {
+                    copySelection();
+                    return true;
+                }
+                break;
+            case KEY_W:
+                dispatch(u".uno:CloseWin"_ustr);
+                return true;
+            default:
+                break;
+        }
+    }
+    if (rKey.GetCode() == KEY_F3 && !rKey.IsMod1())
+    {
+        find(m_xSearch->get_text(), rKey.IsShift());
+        return true;
+    }
+    if (!bInEntry && !rKey.GetModifier()
+        && (rKey.GetCode() == KEY_PAGEUP || rKey.GetCode() == KEY_PAGEDOWN
+            || rKey.GetCode() == KEY_HOME || rKey.GetCode() == KEY_END)
+        && !m_xThumbs->HasFocus())
+        return m_xPages->KeyInput(*pEvent);
+
+    // global shortcuts (new document, quit, document tabs...)
+    if (!m_xAccExec && m_xFrame.is())
+    {
+        m_xAccExec = svt::AcceleratorExecute::createAcceleratorHelper();
+        m_xAccExec->init(comphelper::getProcessComponentContext(), m_xFrame);
+    }
+    if (m_xAccExec && rKey.GetModifier() && m_xAccExec->execute(rKey))
+        return true;
+    return InterimItemWindow::PreNotify(rNEvt);
+}
