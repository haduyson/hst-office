+void PdfViewerWindow::find(const OUString& rText, bool bBackwards)
+{
+    if (!m_xDocument)
+        return;
+    if (rText.isEmpty())
+    {
+        m_aMatches.clear();
+        m_aSearchText.clear();
+        m_nCurrentMatch = -1;
+        m_xPages->setMatches(nullptr, -1);
+        m_xStatusFind->set_label(OUString());
+        return;
+    }
+    if (rText != m_aSearchText)
+    {
+        weld::WaitObject aWait(GetFrameWeld());
+        m_aSearchText = rText;
+        m_aMatches = m_xDocument->find(rText);
+        // start at the page in view
+        m_nCurrentMatch = -1;
+        const int nPage = m_xPages->getCurrentPage();
+        for (size_t i = 0; i < m_aMatches.size(); ++i)
+            if (m_aMatches[i].nPage >= nPage)
+            {
+                m_nCurrentMatch = static_cast<int>(i);
+                break;
+            }
+        if (m_nCurrentMatch < 0 && !m_aMatches.empty())
+            m_nCurrentMatch = 0;
+    }
+    else if (!m_aMatches.empty())
+    {
+        const int nCount = static_cast<int>(m_aMatches.size());
+        m_nCurrentMatch = (m_nCurrentMatch + (bBackwards ? nCount - 1 : 1)) % nCount;
+    }
+    if (m_aMatches.empty())
+    {
+        m_xPages->setMatches(nullptr, -1);
+        m_xStatusFind->set_label(XsResId(STR_HSTPDF_NO_MATCH).replaceFirst("%1", rText));
+        return;
+    }
+    m_xPages->setMatches(&m_aMatches, m_nCurrentMatch);
+    m_xStatusFind->set_label(XsResId(STR_HSTPDF_MATCHES)
+                                 .replaceFirst("%1", OUString::number(m_nCurrentMatch + 1))
+                                 .replaceFirst("%2", OUString::number(m_aMatches.size())));
+}
