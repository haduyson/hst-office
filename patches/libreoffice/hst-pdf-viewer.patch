+        print();
+    else if (&rButton == m_xZoomOut.get())
+        m_xPages->setZoom(m_xPages->getZoom() / 1.25);
+    else if (&rButton == m_xZoomIn.get())
+        m_xPages->setZoom(m_xPages->getZoom() * 1.25);
+    else if (&rButton == m_xFitPage.get())
+        m_xPages->setFit(PdfPageView::Fit::Page);
+    else if (&rButton == m_xFindPrev.get())
+        find(m_xSearch->get_text(), true);
+    else if (&rButton == m_xFindNext.get())
+        find(m_xSearch->get_text(), false);
+    else if (&rButton == m_xEdit.get())
+        editInDraw();
+    else if (&rButton == m_xChooseCert.get())
+        chooseCertificate();
+    else if (&rButton == m_xSignSave.get())
+        sign(OUString());
