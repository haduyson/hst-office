+/// Text layers kept open: the visible pages while selecting text.
+constexpr size_t TEXT_LAYER_CACHE = 4;
+
+bool isLineBreak(sal_uInt32 c) { return c == '\r' || c == '\n'; }
+}
+
+std::unique_ptr<PdfViewerDocument> PdfViewerDocument::load(std::vector<sal_uInt8>&& rData,
+                                                           const OString& rPassword,
+                                                           LoadResult& rResult)
+{
+    rResult = LoadResult::Failed;
+    std::shared_ptr<vcl::pdf::PDFium>& pPdfium = vcl::pdf::PDFiumLibrary::get();
+    if (!pPdfium || rData.empty())
+        return nullptr;
+
+    std::unique_ptr<PdfViewerDocument> pDoc(new PdfViewerDocument);
+    pDoc->m_aData = std::move(rData);
+    pDoc->m_pDocument = pPdfium->openDocument(pDoc->m_aData.data(),
+                                              static_cast<int>(pDoc->m_aData.size()), rPassword);
+    if (!pDoc->m_pDocument)
+    {
+        if (pPdfium->getLastErrorCode() == vcl::pdf::PDFErrorType::Password)
+            rResult = LoadResult::NeedsPassword;
+        rData = std::move(pDoc->m_aData); // hand the bytes back for a second try
+        return nullptr;
+    }
+
+    const int nPages = pDoc->m_pDocument->getPageCount();
+    if (nPages <= 0)
+        return nullptr;
+    // Page sizes come from the page tree: no page is parsed until it is shown.
+    pDoc->m_aPageSizes.reserve(nPages);
+    for (int i = 0; i < nPages; ++i)
+    {
+        basegfx::B2DSize aSize = pDoc->m_pDocument->getPageSize(i);
+        if (aSize.getWidth() <= 0 || aSize.getHeight() <= 0)
+            aSize = basegfx::B2DSize(595.0, 842.0); // A4 for a broken page entry
+        pDoc->m_fMaxWidth = std::max(pDoc->m_fMaxWidth, aSize.getWidth());
+        pDoc->m_aPageSizes.push_back(aSize);
+    }
+    rResult = LoadResult::Ok;
+    return pDoc;
+}
+
+Bitmap PdfViewerDocument::renderPage(int nPage, int nWidthPx, int nHeightPx)
+{
+    std::shared_ptr<vcl::pdf::PDFium>& pPdfium = vcl::pdf::PDFiumLibrary::get();
+    if (!pPdfium || nWidthPx <= 0 || nHeightPx <= 0)
+        return Bitmap();
+    std::unique_ptr<vcl::pdf::PDFiumPage> pPage = m_pDocument->openPage(nPage);
+    if (!pPage)
+        return Bitmap();
+    int nWidth = nWidthPx, nHeight = nHeightPx;
+    std::unique_ptr<vcl::pdf::PDFiumBitmap> pBitmap
+        = pPdfium->createBitmap(nWidth, nHeight, /*nAlpha=*/0);
+    if (!pBitmap)
+        return Bitmap();
+    pBitmap->fillRect(0, 0, nWidth, nHeight, 0xFFFFFFFF);
+    pBitmap->renderPageBitmap(m_pDocument.get(), pPage.get(), 0, 0, nWidth, nHeight);
+    return pBitmap->createBitmapFromBuffer();
+}
+
+PdfViewerDocument::TextLayer& PdfViewerDocument::textLayer(int nPage)
+{
+    auto it = std::find_if(m_aTextLayers.begin(), m_aTextLayers.end(),
+                           [nPage](const auto& rEntry) { return rEntry.first == nPage; });
+    if (it != m_aTextLayers.end())
+        return it->second;
+    if (m_aTextLayers.size() >= TEXT_LAYER_CACHE)
+        m_aTextLayers.erase(m_aTextLayers.begin());
+    TextLayer aLayer;
+    aLayer.pPage = m_pDocument->openPage(nPage);
+    if (aLayer.pPage)
+        aLayer.pText = aLayer.pPage->getTextPage();
+    m_aTextLayers.emplace_back(nPage, std::move(aLayer));
+    return m_aTextLayers.back().second;
+}
+
+const std::vector<PointRect>& PdfViewerDocument::charBoxes(int nPage)
+{
+    TextLayer& rLayer = textLayer(nPage);
+    if (rLayer.aBoxes.empty() && rLayer.pText)
+    {
+        const int nChars = rLayer.pText->countChars();
+        const double fHeightMm100 = pointToMm100(m_aPageSizes[nPage].getHeight());
+        rLayer.aBoxes.reserve(nChars);
+        for (int i = 0; i < nChars; ++i)
+        {
+            basegfx::B2DRectangle aBox = rLayer.pText->getCharBox(i, fHeightMm100);
+            rLayer.aBoxes.emplace_back(mm100ToPoint(aBox.getMinX()), mm100ToPoint(aBox.getMinY()),
+                                       mm100ToPoint(aBox.getMaxX()), mm100ToPoint(aBox.getMaxY()));
+        }
+    }
+    return rLayer.aBoxes;
+}
+
+namespace
+{
+/// Joins the boxes of consecutive characters on one line into one highlight rectangle.
+void appendMerged(std::vector<PointRect>& rOut, const PointRect& rBox)
+{
+    if (rBox.isEmpty() || rBox.getWidth() <= 0)
+        return;
+    if (!rOut.empty())
+    {
+        PointRect& rLast = rOut.back();
+        const double fOverlap = std::min(rLast.getMaxY(), rBox.getMaxY())
+                                - std::max(rLast.getMinY(), rBox.getMinY());
+        if (fOverlap > 0.5 * std::min(rLast.getHeight(), rBox.getHeight())
+            && rBox.getMinX() >= rLast.getMinX() - 1.0)
+        {
+            rLast.expand(rBox);
+            return;
+        }
+    }
+    rOut.push_back(rBox);
+}
+}
+
+std::vector<TextMatch> PdfViewerDocument::find(const OUString& rText)
+{
+    std::vector<TextMatch> aMatches;
+    if (rText.isEmpty())
+        return aMatches;
+    for (int nPage = 0; nPage < getPageCount(); ++nPage)
+    {
+        // A text layer of its own per page: a search over hundreds of pages must not keep
+        // them all open.
+        std::unique_ptr<vcl::pdf::PDFiumPage> pPage = m_pDocument->openPage(nPage);
+        if (!pPage)
+            continue;
+        std::unique_ptr<vcl::pdf::PDFiumTextPage> pText = pPage->getTextPage();
+        if (!pText)
+            continue;
+        std::unique_ptr<vcl::pdf::PDFiumSearchHandle> pSearch
+            = pText->findStart(rText, vcl::pdf::PDFFindFlags(0), 0);
+        if (!pSearch)
+            continue;
+        const double fHeightMm100 = pointToMm100(m_aPageSizes[nPage].getHeight());
+        while (pSearch->findNext())
+        {
+            TextMatch aMatch;
+            aMatch.nPage = nPage;
+            aMatch.nFirstChar = pSearch->getSearchResultIndex();
+            aMatch.nCharCount = pSearch->getSearchCount();
+            for (int i = 0; i < aMatch.nCharCount; ++i)
+            {
+                basegfx::B2DRectangle aBox = pText->getCharBox(aMatch.nFirstChar + i, fHeightMm100);
+                appendMerged(aMatch.aBoxes,
+                             PointRect(mm100ToPoint(aBox.getMinX()), mm100ToPoint(aBox.getMinY()),
+                                       mm100ToPoint(aBox.getMaxX()), mm100ToPoint(aBox.getMaxY())));
+            }
+            aMatches.push_back(std::move(aMatch));
+        }
+    }
+    return aMatches;
+}
+
+namespace
+{
+/// Index of the character closest to rPoint (0 distance inside a box), -1 for no characters.
+int nearestChar(const std::vector<PointRect>& rBoxes, const basegfx::B2DPoint& rPoint)
+{
+    int nBest = -1;
+    double fBest = 0;
+    for (size_t i = 0; i < rBoxes.size(); ++i)
+    {
+        const PointRect& rBox = rBoxes[i];
+        if (rBox.isEmpty() || rBox.getWidth() <= 0)
+            continue;
+        const double dx = std::max({ rBox.getMinX() - rPoint.getX(), 0.0, rPoint.getX() - rBox.getMaxX() });
+        // Lines matter more than columns: a point between two lines picks the nearer line.
+        const double dy = std::max({ rBox.getMinY() - rPoint.getY(), 0.0, rPoint.getY() - rBox.getMaxY() });
+        const double fDist = dx + 4.0 * dy;
+        if (nBest < 0 || fDist < fBest)
+        {
+            nBest = static_cast<int>(i);
+            fBest = fDist;
+        }
+    }
+    return nBest;
+}
+}
+
+OUString PdfViewerDocument::selectText(int nPage, const basegfx::B2DPoint& rFrom,
+                                       const basegfx::B2DPoint& rTo,
+                                       std::vector<PointRect>& rBoxes)
+{
+    rBoxes.clear();
+    const std::vector<PointRect>& rCharBoxes = charBoxes(nPage);
+    TextLayer& rLayer = textLayer(nPage);
+    if (rCharBoxes.empty() || !rLayer.pText)
+        return OUString();
+    int nFirst = nearestChar(rCharBoxes, rFrom);
+    int nLast = nearestChar(rCharBoxes, rTo);
+    if (nFirst < 0 || nLast < 0)
+        return OUString();
+    if (nFirst > nLast)
+        std::swap(nFirst, nLast);
+    OUStringBuffer aText;
+    for (int i = nFirst; i <= nLast; ++i)
+    {
+        const sal_uInt32 c = rLayer.pText->getUnicode(i);
+        if (c == '\r')
+            continue; // PDFium ends generated lines with \r\n: keep one break
+        if (c)
+            aText.appendUtf32(isLineBreak(c) ? '\n' : c);
+        appendMerged(rBoxes, rCharBoxes[i]);
+    }
+    return aText.makeStringAndClear();
+}
+}
