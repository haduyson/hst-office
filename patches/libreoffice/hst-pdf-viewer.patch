+bool PdfViewerWindow::sign(const OUString& rTargetURL)
+{
+    if (!m_xDocument || !m_xCertificate.is())
+        return false;
+    OUString aTarget = rTargetURL;
+    if (aTarget.isEmpty())
+    {
+        // always a new file: the dialog proposes "<name>-da-ky.pdf" next to the original
+        sfx2::FileDialogHelper aDialog(ui::dialogs::TemplateDescription::FILESAVE_AUTOEXTENSION,
+                                       FileDialogFlags::NONE, GetFrameWeld());
+        aDialog.SetTitle(XsResId(STR_HSTPDF_SAVE_TITLE));
+        aDialog.AddFilter(u"PDF"_ustr, u"*.pdf"_ustr);
+        INetURLObject aURL(m_aURL);
+        OUString aName = aURL.getBase(INetURLObject::LAST_SEGMENT, true,
+                                      INetURLObject::DecodeMechanism::WithCharset);
+        aName += XsResId(STR_HSTPDF_SIGNED_SUFFIX) + ".pdf";
+        if (aURL.GetProtocol() == INetProtocol::File)
+        {
+            aURL.removeSegment();
+            aDialog.SetDisplayDirectory(aURL.GetMainURL(INetURLObject::DecodeMechanism::NONE));
+        }
+        aDialog.SetFileName(aName);
+        if (aDialog.Execute() != ERRCODE_NONE)
+            return false;
+        aTarget = aDialog.GetPath();
+    }
+    if (aTarget.isEmpty())
+        return false;
+    if (INetURLObject(aTarget) == INetURLObject(m_aURL))
+    {
+        // the original stays as it was: the signed PDF is a copy
+        std::unique_ptr<weld::MessageDialog> xBox(Application::CreateMessageDialog(
+            GetFrameWeld(), VclMessageType::Warning, VclButtonsType::Ok,
+            XsResId(STR_HSTPDF_SAME_FILE)));
+        xBox->run();
+        return false;
+    }
+
+    std::optional<SignaturePlacement> oPlacement;
+    if (m_xVisible->get_active() && m_xPages->getPlacement())
+    {
+        const auto& rPlacement = *m_xPages->getPlacement();
+        oPlacement = SignaturePlacement{ rPlacement.first, rPlacement.second,
+                                         m_xDocument->getPageSize(rPlacement.first) };
+    }
+    std::vector<sal_uInt8> aSigned;
+    bool bSigned;
+    {
+        weld::WaitObject aWait(GetFrameWeld());
+        bSigned = signPdf(m_xDocument->getData(), m_xCertificate, m_xReason->get_text(), oPlacement,
+                          aSigned);
+    }
+    if (bSigned)
+    {
+        std::unique_ptr<SvStream> pStream = utl::UcbStreamHelper::CreateStream(
+            aTarget, StreamMode::WRITE | StreamMode::TRUNC);
+        bSigned = pStream && pStream->WriteBytes(aSigned.data(), aSigned.size()) == aSigned.size();
+        if (pStream)
+        {
+            pStream->Flush();
+            bSigned = bSigned && pStream->good();
+        }
+    }
+    if (!bSigned)
+    {
+        std::unique_ptr<weld::MessageDialog> xBox(Application::CreateMessageDialog(
+            GetFrameWeld(), VclMessageType::Error, VclButtonsType::Ok,
+            XsResId(STR_HSTPDF_SIGN_FAILED)));
+        xBox->run();
+        return false;
+    }
+    rememberCertificate(m_xCertificate);
+    // show the signed copy (with its signature) in this window
+    const OUString aName = INetURLObject(aTarget).GetLastName(INetURLObject::DecodeMechanism::WithCharset);
+    const int nPage = m_xPages->getCurrentPage();
+    m_xPages->setPlacement(std::nullopt);
+    loadDocument(aTarget, std::move(aSigned), std::chrono::steady_clock::now());
+    m_xPages->goToPage(nPage);
+    m_xVisible->set_active(false);
+    m_xPages->setPlacementMode(false);
+    m_xStatusFind->set_label(XsResId(STR_HSTPDF_SIGNED_SAVED).replaceFirst("%1", aName));
+    return true;
+}
