+#pragma once
+
+// HST PDF: one opened PDF file for the lightweight viewer. Owns the file bytes (PDFium reads them
+// in place, signing appends to a copy) and gives page sizes, page bitmaps and the text layer.
+
+#include <basegfx/range/b2drectangle.hxx>
+#include <basegfx/vector/b2dsize.hxx>
+#include <rtl/ustring.hxx>
+#include <vcl/bitmap.hxx>
+#include <vcl/filter/PDFiumLibrary.hxx>
+
+#include <memory>
+#include <vector>
+
+namespace hstpdf
+{
+/// A rectangle in PDF points, origin at the top-left corner of the page.
+using PointRect = basegfx::B2DRectangle;
+
+struct TextMatch
+{
+    int nPage = 0;
+    int nFirstChar = 0;
+    int nCharCount = 0;
+    std::vector<PointRect> aBoxes;
+};
+
+class PdfViewerDocument
+{
+public:
+    enum class LoadResult
+    {
+        Ok,
+        NeedsPassword,
+        Failed
+    };
+
+    /// Takes the bytes of a PDF file. rPassword is empty unless the user typed one.
+    static std::unique_ptr<PdfViewerDocument> load(std::vector<sal_uInt8>&& rData,
+                                                   const OString& rPassword, LoadResult& rResult);
+
+    int getPageCount() const { return static_cast<int>(m_aPageSizes.size()); }
+    /// Page size in points, rotation applied.
+    basegfx::B2DSize getPageSize(int nPage) const { return m_aPageSizes[nPage]; }
+    double getMaxPageWidth() const { return m_fMaxWidth; }
+
+    /// The page as an opaque bitmap of the given pixel size (white paper).
+    Bitmap renderPage(int nPage, int nWidthPx, int nHeightPx);
+
+    /// All matches of rText (case-insensitive), in page order.
+    std::vector<TextMatch> find(const OUString& rText);
+
+    /// The characters of a page between two points (reading order, like a text editor
+    /// selection), with their boxes; empty when no character is under the drag.
+    OUString selectText(int nPage, const basegfx::B2DPoint& rFrom, const basegfx::B2DPoint& rTo,
+                        std::vector<PointRect>& rBoxes);
+
+    int getSignatureCount() { return m_pDocument->getSignatureCount(); }
+    const std::vector<sal_uInt8>& getData() const { return m_aData; }
+
+private:
+    PdfViewerDocument() = default;
+
+    struct TextLayer
+    {
+        std::unique_ptr<vcl::pdf::PDFiumPage> pPage;
+        std::unique_ptr<vcl::pdf::PDFiumTextPage> pText;
+        /// Character boxes in points, filled on first use.
+        std::vector<PointRect> aBoxes;
+    };
+    TextLayer& textLayer(int nPage);
+    const std::vector<PointRect>& charBoxes(int nPage);
+
+    std::vector<sal_uInt8> m_aData;
+    std::unique_ptr<vcl::pdf::PDFiumDocument> m_pDocument;
+    std::vector<basegfx::B2DSize> m_aPageSizes;
+    double m_fMaxWidth = 0;
+    /// Text layers kept for the last pages used (searching all pages keeps none).
+    std::vector<std::pair<int, TextLayer>> m_aTextLayers;
+};
+
+/// Points (1/72 inch) to 1/100 mm and back.
+inline double pointToMm100(double fPoint) { return fPoint * 2540.0 / 72.0; }
+inline double mm100ToPoint(double fMm100) { return fMm100 * 72.0 / 2540.0; }
+}
