+OUString formatDate(const util::DateTime& rDate, bool bTime)
+{
+    OUString aDate = OUString::Concat(rDate.Day < 10 ? u"0" : u"") + OUString::number(rDate.Day)
+                     + "/" + (rDate.Month < 10 ? u"0" : u"") + OUString::number(rDate.Month) + "/"
+                     + OUString::number(rDate.Year);
+    if (bTime)
+        aDate += OUString::Concat(u" ") + (rDate.Hours < 10 ? u"0" : u"")
+                 + OUString::number(rDate.Hours) + ":" + (rDate.Minutes < 10 ? u"0" : u"")
+                 + OUString::number(rDate.Minutes);
+    return aDate;
+}
+
+OUString commonName(const OUString& rDistinguishedName)
+{
+    OUString aName = comphelper::xmlsec::GetContentPart(rDistinguishedName,
+                                                         security::CertificateKind_X509);
+    return aName.isEmpty() ? rDistinguishedName : aName;
+}
+
+/// A one-page PDF of the target page size with the visible signature in its box: the appearance
+/// of the signature widget (vcl::filter::PDFDocument places it over the whole page).
+std::vector<sal_Int8> createAppearance(const SignaturePlacement& rPlacement,
+                                       const CertificateDescription& rSigner,
+                                       const OUString& rReason)
+{
+    std::vector<sal_Int8> aResult;
+    utl::TempFileNamed aTemp;
+    aTemp.EnableKillingFile();
+    {
+        vcl::pdf::PDFWriter::PDFWriterContext aContext;
+        aContext.URL = aTemp.GetURL();
+        aContext.DocumentInfo.Producer = u"HST PDF"_ustr;
+        vcl::pdf::PDFWriter aWriter(aContext, uno::Reference<beans::XMaterialHolder>());
+        aWriter.NewPage(rPlacement.aPageSize.getWidth(), rPlacement.aPageSize.getHeight());
+        const MapMode aTwips(MapUnit::MapTwip);
+        aWriter.SetMapMode(aTwips);
+
+        // twips, origin top-left like the placement
+        const tools::Rectangle aBox(
+            static_cast<tools::Long>(rPlacement.aRect.getMinX() * 20),
+            static_cast<tools::Long>(rPlacement.aRect.getMinY() * 20),
+            static_cast<tools::Long>(rPlacement.aRect.getMaxX() * 20),
+            static_cast<tools::Long>(rPlacement.aRect.getMaxY() * 20));
+
+        OUStringBuffer aText(XsResId(STR_HSTPDF_SIGNED_BY).replaceFirst("%1", rSigner.aSubject));
+        aText.append("\n"
+                     + XsResId(STR_HSTPDF_SIGNED_ON)
+                           .replaceFirst("%1", formatDate(DateTime(DateTime::SYSTEM).GetUNODateTime(), true)));
+        if (!rReason.isEmpty())
+            aText.append("\n" + XsResId(STR_HSTPDF_REASON).replaceFirst("%1", rReason));
+        const sal_Int32 nLines = rReason.isEmpty() ? 2 : 3;
+        // font height: the lines fill the box, 6 to 11 points
+        const double fFontPt = std::clamp(rPlacement.aRect.getHeight() / (nLines * 1.45 + 0.6), 6.0, 11.0);
+
+        ScopedVclPtrInstance<VirtualDevice> pDevice;
+        pDevice->SetMapMode(aTwips);
+        GDIMetaFile aMetaFile;
+        aMetaFile.Record(pDevice.get());
+        const Color aGreen(0x0E, 0x7A, 0x36);
+        pDevice->SetLineColor(aGreen);
+        pDevice->SetFillColor(Color(0xF1, 0xF8, 0xF3));
+        pDevice->DrawRect(aBox);
+        vcl::Font aFont(u"Liberation Sans"_ustr, Size(0, static_cast<tools::Long>(fFontPt * 20)));
+        pDevice->SetFont(aFont);
+        pDevice->SetTextColor(Color(0x0B, 0x5D, 0x29));
+        tools::Rectangle aTextBox(aBox);
+        const tools::Long nPadding = static_cast<tools::Long>(fFontPt * 8);
+        aTextBox.AdjustLeft(nPadding);
+        aTextBox.AdjustRight(-nPadding);
+        aTextBox.AdjustTop(nPadding / 2);
+        aTextBox.AdjustBottom(-nPadding / 2);
+        pDevice->DrawText(aTextBox, aText.makeStringAndClear(),
+                          DrawTextFlags::Left | DrawTextFlags::VCenter | DrawTextFlags::MultiLine
+                              | DrawTextFlags::WordBreak);
+        aMetaFile.Stop();
+        aMetaFile.WindStart();
+        aMetaFile.SetPrefMapMode(aTwips);
+
+        aWriter.PlayMetafile(aMetaFile, vcl::pdf::PDFWriter::PlayMetafileContext());
+        if (!aWriter.Emit())
+            return aResult;
+    }
+    SvFileStream aStream(aTemp.GetURL(), StreamMode::READ);
+    const sal_uInt64 nSize = aStream.TellEnd();
+    aResult.resize(nSize);
+    aStream.ReadBytes(aResult.data(), nSize);
+    return aResult;
+}
+}
+
+CertificateDescription
+describeCertificate(const uno::Reference<security::XCertificate>& xCertificate)
+{
+    CertificateDescription aDescription;
+    if (!xCertificate.is())
+        return aDescription;
+    aDescription.aSubject = commonName(xCertificate->getSubjectName());
+    aDescription.aIssuer = commonName(xCertificate->getIssuerName());
+    const util::DateTime aNotAfter = xCertificate->getNotValidAfter();
+    aDescription.bExpired = DateTime(aNotAfter) < DateTime(DateTime::SYSTEM);
+    aDescription.aValidity = XsResId(aDescription.bExpired ? STR_HSTPDF_CERT_EXPIRED
+                                                           : STR_HSTPDF_CERT_EXPIRES)
+                                 .replaceFirst("%1", formatDate(aNotAfter, false));
+    return aDescription;
+}
+
+uno::Reference<security::XCertificate> lastUsedCertificate()
+{
+    try
+    {
+        const OUString aThumbprint
+            = officecfg::Office::HSTPdfViewer::Signing::LastCertificateThumbprint::get();
+        if (aThumbprint.isEmpty())
+            return {};
+        DocumentSignatureManager aManager(comphelper::getProcessComponentContext(),
+                                          DocumentSignatureMode::Content);
+        if (!aManager.init())
+            return {};
+        uno::Reference<security::XCertificate> xCertificate
+            = comphelper::xmlsec::FindCertInContext(aManager.getSecurityContext(), aThumbprint);
+        if (xCertificate.is() && !describeCertificate(xCertificate).bExpired)
+            return xCertificate;
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("xmlsecurity.hstpdf", "no last used certificate");
+    }
+    return {};
+}
+
+void rememberCertificate(const uno::Reference<security::XCertificate>& xCertificate)
+{
+    if (!xCertificate.is())
+        return;
+    try
+    {
+        std::shared_ptr<comphelper::ConfigurationChanges> xChanges
+            = comphelper::ConfigurationChanges::create();
+        officecfg::Office::HSTPdfViewer::Signing::LastCertificateThumbprint::set(
+            comphelper::xmlsec::GetHexString(xCertificate->getSHA1Thumbprint(), ""), xChanges);
+        xChanges->commit();
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("xmlsecurity.hstpdf", "could not remember the certificate");
+    }
+}
+
+uno::Reference<security::XCertificate> chooseCertificate(const uno::Reference<awt::XWindow>& xParent,
+                                                         OUString& rDescription)
+{
+    uno::Reference<security::XDocumentDigitalSignatures> xSigner
+        = security::DocumentDigitalSignatures::createDefault(comphelper::getProcessComponentContext());
+    if (xParent.is())
+        xSigner->setParentWindow(xParent);
+    return xSigner->selectSigningCertificateWithType(security::CertificateKind_X509, rDescription);
+}
+
+SignatureSummary verifySignatures(const std::vector<sal_uInt8>& rData)
+{
+    SignatureSummary aSummary;
+    SvMemoryStream aStream(const_cast<sal_uInt8*>(rData.data()), rData.size(), StreamMode::READ);
+    PDFSignatureHelper aHelper;
+    if (!aHelper.ReadAndVerifySignatureSvStream(aStream))
+        return aSummary;
+    const SignatureInformations& rInfos = aHelper.GetSignatureInformations();
+    if (rInfos.empty())
+        return aSummary;
+    DocumentSignatureManager aManager(comphelper::getProcessComponentContext(),
+                                      DocumentSignatureMode::Content);
+    if (!aManager.init())
+        return aSummary;
+    const uno::Sequence<security::DocumentSignatureInformation> aInfos
+        = aHelper.GetDocumentSignatureInformations(aManager.getSecurityEnvironment());
+    for (sal_Int32 i = 0; i < aInfos.getLength(); ++i)
+    {
+        const security::DocumentSignatureInformation& rInfo = aInfos[i];
+        ++aSummary.nCount;
+        TranslateId aStatus;
+        if (!rInfo.SignatureIsValid)
+        {
+            ++aSummary.nInvalid;
+            aStatus = STR_HSTPDF_SIG_STATUS_INVALID;
+        }
+        else if (rInfo.CertificateStatus == security::CertificateValidity::VALID)
+        {
+            ++aSummary.nValid;
+            aStatus = rInfo.PartialDocumentSignature ? STR_HSTPDF_SIG_STATUS_PARTIAL
+                                                     : STR_HSTPDF_SIG_STATUS_VALID;
+        }
+        else
+        {
+            ++aSummary.nUntrusted;
+            aStatus = STR_HSTPDF_SIG_STATUS_UNTRUSTED;
+        }
+        const OUString aSigner = rInfo.Signer.is() ? commonName(rInfo.Signer->getSubjectName())
+                                                   : OUString(u"?"_ustr);
+        OUString aLine = aSigner;
+        if (o3tl::make_unsigned(i) < rInfos.size() && rInfos[i].stDateTime.Year > 0)
+            aLine += u" — "_ustr + formatDate(rInfos[i].stDateTime, true);
+        aSummary.aLines.push_back(aLine + u" — "_ustr + XsResId(aStatus));
+    }
+    return aSummary;
+}
+
+bool signPdf(const std::vector<sal_uInt8>& rData,
+             const uno::Reference<security::XCertificate>& xCertificate, const OUString& rReason,
+             const std::optional<SignaturePlacement>& oPlacement, std::vector<sal_uInt8>& rSigned)
+{
+    if (!xCertificate.is())
+        return false;
+    SvMemoryStream aInput(const_cast<sal_uInt8*>(rData.data()), rData.size(), StreamMode::READ);
+    vcl::filter::PDFDocument aDocument;
+    if (!aDocument.Read(aInput))
+    {
+        SAL_WARN("xmlsecurity.hstpdf", "signPdf: cannot read the PDF");
+        return false;
+    }
+    if (oPlacement)
+    {
+        std::vector<sal_Int8> aAppearance
+            = createAppearance(*oPlacement, describeCertificate(xCertificate), rReason);
+        if (!aAppearance.empty())
+        {
+            aDocument.SetSignaturePage(oPlacement->nPage);
+            aDocument.SetSignatureLine(std::move(aAppearance));
+        }
+    }
+    svl::crypto::SigningContext aContext;
+    aContext.m_xCertificate = xCertificate;
+    if (!aDocument.Sign(aContext, rReason, /*bAdES=*/true))
+    {
+        SAL_WARN("xmlsecurity.hstpdf", "signPdf: signing failed");
+        return false;
+    }
+    SvMemoryStream aOutput;
+    if (!aDocument.Write(aOutput))
+        return false;
+    const sal_uInt8* pData = static_cast<const sal_uInt8*>(aOutput.GetData());
+    rSigned.assign(pData, pData + aOutput.TellEnd());
+    return true;
+}
+}
