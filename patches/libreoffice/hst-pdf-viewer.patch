+void PdfViewerWindow::dispatch(const OUString& rCommand)
+{
+    uno::Reference<frame::XDispatchProvider> xProvider(m_xFrame, uno::UNO_QUERY);
+    if (!xProvider.is())
+        return;
+    util::URL aURL;
+    aURL.Complete = rCommand;
+    util::URLTransformer::create(comphelper::getProcessComponentContext())->parseStrict(aURL);
+    uno::Reference<frame::XDispatch> xDispatch = xProvider->queryDispatch(aURL, OUString(), 0);
+    if (xDispatch.is())
+        xDispatch->dispatch(aURL, {});
+}
+
+void PdfViewerWindow::editInDraw()
+{
+    if (m_aURL.isEmpty())
+        return;
+    const uno::Reference<frame::XFrame> xOldFrame = m_xFrame;
+    try
+    {
+        weld::WaitObject aWait(GetFrameWeld());
+        uno::Reference<frame::XDesktop2> xDesktop
+            = frame::Desktop::create(comphelper::getProcessComponentContext());
+        uno::Reference<lang::XComponent> xComponent = xDesktop->loadComponentFromURL(
+            m_aURL, u"_blank"_ustr, 0,
+            { comphelper::makePropertyValue(u"HSTPdfOpenInDraw"_ustr, true) });
+        if (!xComponent.is())
+            return;
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("xmlsecurity.hstpdf", "editInDraw");
+        return;
+    }
+    // the document is open in Draw: close the viewer (later, this window is in a handler)
+    Application::PostUserEvent(LINK(nullptr, PdfViewerWindow, CloseFrameHdl),
+                               new CloseRequest{ xOldFrame });
+}
+
+IMPL_STATIC_LINK(PdfViewerWindow, CloseFrameHdl, void*, pRequest, void)
+{
+    std::unique_ptr<CloseRequest> xRequest(static_cast<CloseRequest*>(pRequest));
+    uno::Reference<util::XCloseable> xCloseable(xRequest->xFrame, uno::UNO_QUERY);
+    try
+    {
+        if (xCloseable.is())
+            xCloseable->close(true);
+    }
+    catch (const uno::Exception&)
+    {
+    }
+}
