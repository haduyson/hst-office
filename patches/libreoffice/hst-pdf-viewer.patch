+bool PdfViewerWindow::loadDocument(const OUString& rURL, std::vector<sal_uInt8>&& rData,
+                                   std::chrono::steady_clock::time_point tStart)
+{
+    PdfViewerDocument::LoadResult eResult;
+    std::unique_ptr<PdfViewerDocument> xDocument
+        = PdfViewerDocument::load(std::move(rData), OString(), eResult);
+    if (eResult == PdfViewerDocument::LoadResult::NeedsPassword)
+    {
+        // up to three tries, like other password prompts
+        for (int nTry = 0; nTry < 3 && eResult == PdfViewerDocument::LoadResult::NeedsPassword; ++nTry)
+        {
+            SfxPasswordDialog aDialog(GetFrameWeld());
+            aDialog.ShowExtras(SfxShowExtras::NONE);
+            if (aDialog.run() != RET_OK)
+                return false;
+            xDocument = PdfViewerDocument::load(std::move(rData),
+                                                OUStringToOString(aDialog.GetPassword(), RTL_TEXTENCODING_UTF8),
+                                                eResult);
+        }
+    }
+    if (!xDocument)
+        return false;
+
+    m_tStart = tStart;
+    m_nOpenMillis = -1;
+    m_aURL = rURL;
+    m_xDocument = std::move(xDocument);
+    m_aMatches.clear();
+    m_nCurrentMatch = -1;
+    m_aSearchText.clear();
+    m_bSignaturesChecked = false;
+    m_aSignatures = SignatureSummary();
+    m_xPages->setDocument(m_xDocument.get());
+    m_xThumbs->setDocument(m_xDocument.get());
+    m_xPageCount->set_label(u"/ "_ustr + OUString::number(m_xDocument->getPageCount()));
+    m_xStatusFind->set_label(OUString());
+    updatePageWidgets();
+    updateZoomWidget();
+    updateStatus();
+    if (m_xSignPanel->get_visible())
+    {
+        defaultPlacement();
+        updateSignPanel();
+    }
+    startSignatureCheck();
+    m_aTitleChangedHdl.Call(*this);
+
+    INetURLObject aURL(rURL);
+    if (aURL.GetProtocol() == INetProtocol::File)
+        SvtHistoryOptions::AppendItem(EHistoryType::PickList, rURL, u"draw_pdf_import"_ustr,
+                                      getTitle(), std::nullopt, std::nullopt);
+    return true;
+}
