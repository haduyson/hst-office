+void PdfViewerWindow::defaultPlacement()
+{
+    if (!m_xDocument)
+        return;
+    // bottom right of the page in view, where Vietnamese documents put the signature
+    const int nPage = m_xPages->getCurrentPage();
+    const basegfx::B2DSize aSize = m_xDocument->getPageSize(nPage);
+    const double fWidth = std::min(200.0, aSize.getWidth() / 2);
+    const double fHeight = 70.0;
+    const double fX = std::max(0.0, aSize.getWidth() - 56.0 - fWidth);
+    const double fY = std::max(0.0, aSize.getHeight() - 90.0 - fHeight);
+    m_xPages->setPlacement(std::make_pair(nPage, PointRect(fX, fY, fX + fWidth, fY + fHeight)));
+}
+
+void PdfViewerWindow::updateSignPanel()
+{
+    if (!m_xSignPanel || !m_xSignPanel->get_visible())
+        return;
+    if (m_xCertificate.is())
+    {
+        const CertificateDescription aDescription = describeCertificate(m_xCertificate);
+        m_xCertCard->setCertificate(&aDescription);
+        m_xChooseCert->set_label(XsResId(STR_HSTPDF_CHOOSE_OTHER_CERT));
+    }
+    else
+    {
+        m_xCertCard->setCertificate(nullptr);
+        m_xChooseCert->set_label(XsResId(STR_HSTPDF_CHOOSE_CERT));
+    }
+    paintPrimaryButton(*m_xSignSave, XsResId(STR_HSTPDF_SIGN_SAVE), false, m_xCertificate.is(),
+                       300);
+    m_xSignSave->set_sensitive(m_xCertificate.is() && m_xDocument);
+
+    OUStringBuffer aExisting;
+    if (m_xDocument && m_xDocument->getSignatureCount() > 0)
+    {
+        aExisting.append(XsResId(STR_HSTPDF_EXISTING));
+        if (!m_bSignaturesChecked)
+            aExisting.append("\n" + XsResId(STR_HSTPDF_SIG_CHECKING));
+        for (const OUString& rLine : m_aSignatures.aLines)
+            aExisting.append(u"\n• "_ustr + rLine);
+    }
+    m_xExisting->set_label(aExisting.makeStringAndClear());
+    m_xExisting->set_visible(m_xDocument && m_xDocument->getSignatureCount() > 0);
+}
