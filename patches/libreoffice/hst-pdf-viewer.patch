+bool PdfViewerWindow::isCommand(std::u16string_view rCommand)
+{
+    return o3tl::starts_with(rCommand, CMD_PREFIX) || rCommand == u".uno:Print"
+           || rCommand == u".uno:PrintDefault" || rCommand == u".uno:Copy";
+}
+
+bool PdfViewerWindow::executeCommand(std::u16string_view rCommand,
+                                     const comphelper::SequenceAsHashMap& rArgs, uno::Any& rResult)
+{
+    if (rCommand == u".uno:HSTPdfInfo")
+    {
+        std::vector<beans::NamedValue> aInfo;
+        aInfo.emplace_back(u"URL"_ustr, uno::Any(m_aURL));
+        aInfo.emplace_back(u"Title"_ustr, uno::Any(getTitle()));
+        aInfo.emplace_back(u"PageCount"_ustr,
+                           uno::Any(sal_Int32(m_xDocument ? m_xDocument->getPageCount() : 0)));
+        aInfo.emplace_back(u"CurrentPage"_ustr, uno::Any(sal_Int32(m_xPages->getCurrentPage() + 1)));
+        aInfo.emplace_back(u"Zoom"_ustr, uno::Any(sal_Int32(std::lround(m_xPages->getZoom() * 100))));
+        aInfo.emplace_back(u"OpenMillis"_ustr, uno::Any(sal_Int64(m_nOpenMillis)));
+        aInfo.emplace_back(u"SignatureCount"_ustr,
+                           uno::Any(sal_Int32(m_xDocument ? m_xDocument->getSignatureCount() : 0)));
+        aInfo.emplace_back(u"SignaturesChecked"_ustr, uno::Any(m_bSignaturesChecked));
+        aInfo.emplace_back(u"ValidSignatures"_ustr, uno::Any(sal_Int32(m_aSignatures.nValid)));
+        aInfo.emplace_back(u"UntrustedSignatures"_ustr, uno::Any(sal_Int32(m_aSignatures.nUntrusted)));
+        aInfo.emplace_back(u"InvalidSignatures"_ustr, uno::Any(sal_Int32(m_aSignatures.nInvalid)));
+        aInfo.emplace_back(u"SignatureStatus"_ustr, uno::Any(m_xStatusSign->get_label()));
+        aInfo.emplace_back(u"StatusText"_ustr,
+                           uno::Any(m_xStatusPage->get_label() + " | " + m_xStatusSign->get_label()
+                                    + " | " + m_xStatusFind->get_label() + " | "
+                                    + m_xStatusInfo->get_label()));
+        aInfo.emplace_back(u"SignPanelVisible"_ustr, uno::Any(m_xSignPanel->get_visible()));
+        aInfo.emplace_back(u"Certificate"_ustr, uno::Any(m_xCertCard->getSubject()));
+        aInfo.emplace_back(u"MatchCount"_ustr, uno::Any(sal_Int32(m_aMatches.size())));
+        aInfo.emplace_back(u"CurrentMatch"_ustr, uno::Any(sal_Int32(m_nCurrentMatch + 1)));
+        aInfo.emplace_back(u"MatchPage"_ustr,
+                           uno::Any(sal_Int32(m_nCurrentMatch >= 0 ? m_aMatches[m_nCurrentMatch].nPage + 1 : 0)));
+        if (m_xDocument && rArgs.getUnpackedValueOrDefault(u"RenderPage"_ustr, sal_Int32(0)) > 0)
+        {
+            // render check: share of non-white pixels of a page at 50%
+            const int nPage = std::min(rArgs.getUnpackedValueOrDefault(u"RenderPage"_ustr, sal_Int32(1)),
+                                       sal_Int32(m_xDocument->getPageCount())) - 1;
+            const basegfx::B2DSize aSize = m_xDocument->getPageSize(nPage);
+            const Bitmap aBitmap = m_xDocument->renderPage(nPage, std::lround(aSize.getWidth() * 2 / 3),
+                                                           std::lround(aSize.getHeight() * 2 / 3));
+            sal_Int64 nInk = 0, nAll = 0;
+            const Size aPixels = aBitmap.GetSizePixel();
+            for (tools::Long y = 0; y < aPixels.Height(); y += 2)
+                for (tools::Long x = 0; x < aPixels.Width(); x += 2)
+                {
+                    ++nAll;
+                    if (aBitmap.GetPixelColor(x, y).GetLuminance() < 200)
+                        ++nInk;
+                }
+            aInfo.emplace_back(u"RenderInkPermille"_ustr,
+                               uno::Any(sal_Int32(nAll ? nInk * 1000 / nAll : 0)));
+        }
+        rResult <<= comphelper::containerToSequence(aInfo);
+        return true;
+    }
+    if (!m_xDocument)
+        return false;
+    if (rCommand == u".uno:HSTPdfGoToPage")
+    {
+        m_xPages->goToPage(rArgs.getUnpackedValueOrDefault(u"Page"_ustr, sal_Int32(1)) - 1);
+        updatePageWidgets();
+        return true;
+    }
+    if (rCommand == u".uno:HSTPdfZoom")
+    {
+        const OUString aFit = rArgs.getUnpackedValueOrDefault(u"Fit"_ustr, OUString());
+        if (aFit == "page")
+            m_xPages->setFit(PdfPageView::Fit::Page);
+        else if (aFit == "width")
+            m_xPages->setFit(PdfPageView::Fit::Width);
+        else
+            m_xPages->setZoom(rArgs.getUnpackedValueOrDefault(u"Zoom"_ustr, sal_Int32(100)) / 100.0);
+        return true;
+    }
+    if (rCommand == u".uno:HSTPdfFind")
+    {
+        const OUString aText = rArgs.getUnpackedValueOrDefault(u"SearchString"_ustr, OUString());
+        m_xSearch->set_text(aText);
+        find(aText, rArgs.getUnpackedValueOrDefault(u"Backwards"_ustr, false));
+        rResult <<= sal_Int32(m_aMatches.size());
+        return true;
+    }
+    if (rCommand == u".uno:HSTPdfSelectText")
+    {
+        std::vector<PointRect> aBoxes;
+        const sal_Int32 nPage = rArgs.getUnpackedValueOrDefault(u"Page"_ustr, sal_Int32(1)) - 1;
+        if (nPage < 0 || nPage >= m_xDocument->getPageCount())
+            return false;
+        rResult <<= m_xDocument->selectText(
+            nPage,
+            basegfx::B2DPoint(rArgs.getUnpackedValueOrDefault(u"X1"_ustr, 0.0),
+                              rArgs.getUnpackedValueOrDefault(u"Y1"_ustr, 0.0)),
+            basegfx::B2DPoint(rArgs.getUnpackedValueOrDefault(u"X2"_ustr, 0.0),
+                              rArgs.getUnpackedValueOrDefault(u"Y2"_ustr, 0.0)),
+            aBoxes);
+        return true;
+    }
+    if (rCommand == u".uno:Copy")
+    {
+        copySelection();
+        return true;
+    }
+    if (rCommand == u".uno:Print" || rCommand == u".uno:PrintDefault")
+    {
+        print();
+        return true;
+    }
+    if (rCommand == u".uno:HSTPdfEditInDraw")
+    {
+        editInDraw();
+        return true;
+    }
+    if (rCommand == u".uno:HSTPdfSignPanel")
+    {
+        showSignPanel(rArgs.getUnpackedValueOrDefault(u"Show"_ustr, !m_xSignPanel->get_visible()));
+        return true;
+    }
+    if (rCommand == u".uno:HSTPdfChooseCertificate")
+    {
+        rResult <<= chooseCertificate();
+        return true;
+    }
+    if (rCommand == u".uno:HSTPdfSign")
+    {
+        // optional arguments set the panel first: Reason, Visible, Page/X/Y/Width/Height (points)
+        if (!m_xSignPanel->get_visible())
+            showSignPanel(true);
+        if (rArgs.find(u"Reason"_ustr) != rArgs.end())
+            m_xReason->set_text(rArgs.getUnpackedValueOrDefault(u"Reason"_ustr, OUString()));
+        if (rArgs.find(u"Visible"_ustr) != rArgs.end())
+        {
+            m_xVisible->set_active(rArgs.getUnpackedValueOrDefault(u"Visible"_ustr, true));
+            VisibleToggleHdl(*m_xVisible);
+        }
+        if (rArgs.find(u"Width"_ustr) != rArgs.end())
+        {
+            const sal_Int32 nPage
+                = std::clamp<sal_Int32>(rArgs.getUnpackedValueOrDefault(u"Page"_ustr, sal_Int32(1)) - 1,
+                                        0, m_xDocument->getPageCount() - 1);
+            const double fX = rArgs.getUnpackedValueOrDefault(u"X"_ustr, 0.0);
+            const double fY = rArgs.getUnpackedValueOrDefault(u"Y"_ustr, 0.0);
+            m_xPages->setPlacement(std::make_pair(
+                nPage, PointRect(fX, fY, fX + rArgs.getUnpackedValueOrDefault(u"Width"_ustr, 200.0),
+                                 fY + rArgs.getUnpackedValueOrDefault(u"Height"_ustr, 70.0))));
+        }
+        if (rArgs.getUnpackedValueOrDefault(u"PanelOnly"_ustr, false))
+            return true;
+        rResult <<= sign(rArgs.getUnpackedValueOrDefault(u"TargetURL"_ustr, OUString()));
+        return true;
+    }
+    return false;
+}
+}
