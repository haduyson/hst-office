+struct CertificateDescription
+{
+    OUString aSubject; ///< the signer's common name
+    OUString aIssuer; ///< the certificate authority's common name
+    OUString aValidity; ///< "expires dd/mm/yyyy" or "expired dd/mm/yyyy"
+    bool bExpired = false;
+};
+
+CertificateDescription
+describeCertificate(const css::uno::Reference<css::security::XCertificate>& xCertificate);
+
+/// The certificate used for the previous PDF signature, when it is still in the store.
+css::uno::Reference<css::security::XCertificate> lastUsedCertificate();
+void rememberCertificate(const css::uno::Reference<css::security::XCertificate>& xCertificate);
+
+/// The certificate chooser of document signing; rDescription gets its description field.
+css::uno::Reference<css::security::XCertificate>
+chooseCertificate(const css::uno::Reference<css::awt::XWindow>& xParent, OUString& rDescription);
+
+struct SignatureSummary
+{
+    int nCount = 0;
+    int nValid = 0; ///< valid signature and trusted certificate
+    int nUntrusted = 0; ///< valid signature, certificate not validated
+    int nInvalid = 0;
+    std::vector<OUString> aLines; ///< "signer — date — status" per signature
+};
+
+/// Verifies the signatures of a PDF file (NSS is initialised only when there are any).
+SignatureSummary verifySignatures(const std::vector<sal_uInt8>& rData);
+
+struct SignaturePlacement
+{
+    int nPage = 0;
+    PointRect aRect; ///< points, origin top-left of the page
+    basegfx::B2DSize aPageSize; ///< points
+};
+
+/// Appends a signature to rData; rSigned receives the whole signed file.
+bool signPdf(const std::vector<sal_uInt8>& rData,
+             const css::uno::Reference<css::security::XCertificate>& xCertificate,
+             const OUString& rReason, const std::optional<SignaturePlacement>& oPlacement,
+             std::vector<sal_uInt8>& rSigned);
+}
