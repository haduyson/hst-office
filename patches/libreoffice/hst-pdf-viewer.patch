+/// The green primary button of the design (Sign, Sign and Save a Copy): drawn as the button's
+/// custom content, the label moves into the accessible name.
+void paintPrimaryButton(weld::Button& rButton, const OUString& rText, bool bPressed, bool bEnabled,
+                        tools::Long nMinWidth = 0)
+{
+    ScopedVclPtr<VirtualDevice> pDevice = rButton.create_virtual_device();
+    vcl::Font aFont = Application::GetSettings().GetStyleSettings().GetPushButtonFont();
+    aFont.SetWeight(WEIGHT_BOLD);
+    aFont.SetFontHeight(aFont.GetFontHeight() * 5 / 4);
+    pDevice->SetFont(aFont);
+    const OUString aText = rText.replaceAll("~", "").replaceAll("_", "");
+    const Size aTextSize(pDevice->GetTextWidth(aText), pDevice->GetTextHeight());
+    const Size aSize(std::max(aTextSize.Width() + 40, nMinWidth), aTextSize.Height() + 18);
+    pDevice->SetOutputSizePixel(aSize);
+    pDevice->SetBackground(Wallpaper(Application::GetSettings().GetStyleSettings().GetDialogColor()));
+    pDevice->Erase();
+    pDevice->SetLineColor();
+    pDevice->SetFillColor(!bEnabled ? COL_DISABLED : bPressed ? COL_SIGN_GREEN_DARK : COL_SIGN_GREEN);
+    pDevice->DrawRect(tools::Rectangle(Point(), aSize), 6, 6);
+    pDevice->SetTextColor(COL_WHITE);
+    pDevice->DrawText(Point((aSize.Width() - aTextSize.Width()) / 2,
+                            (aSize.Height() - aTextSize.Height()) / 2),
+                      aText);
+    rButton.set_label(OUString());
+    rButton.set_custom_button(pDevice.get());
+    rButton.set_size_request(aSize.Width(), aSize.Height());
+    rButton.set_accessible_name(aText);
+}
