+constexpr Color COL_PAGE_AREA(0xEE, 0xF1, 0xF5);
+constexpr Color COL_THUMB_AREA(0xF7, 0xF8, 0xFA);
+constexpr Color COL_PAGE_BORDER(0xD5, 0xDA, 0xE2);
+constexpr Color COL_SELECTED_THUMB(0x2B, 0x57, 0x97);
+constexpr Color COL_MUTED_TEXT(0x6B, 0x72, 0x80);
+constexpr Color COL_MATCH(0xFF, 0xD5, 0x4F);
+constexpr Color COL_CURRENT_MATCH(0xFF, 0x8F, 0x00);
+constexpr Color COL_SELECTION(0x35, 0x84, 0xE4);
+constexpr Color COL_SIGN_GREEN(0x0E, 0x7A, 0x36);
+
+constexpr tools::Long PAGE_MARGIN = 16; // around and between pages
+constexpr tools::Long THUMB_WIDTH = 96;
+constexpr tools::Long THUMB_LABEL = 18;
+constexpr tools::Long THUMB_GAP = 14;
+constexpr size_t PAGE_CACHE = 10;
+constexpr size_t THUMB_CACHE = 600;
+constexpr double MIN_ZOOM = 0.1;
+constexpr double MAX_ZOOM = 6.4;
+/// Smallest signature box a drag makes (points); a click places a box of the default size.
+constexpr double MIN_PLACEMENT = 24.0;
+constexpr double DEFAULT_PLACEMENT_W = 200.0;
+constexpr double DEFAULT_PLACEMENT_H = 70.0;
+}
+
+PdfPageView::PdfPageView(Mode eMode, std::unique_ptr<weld::Scrollbar> xVScroll,
+                         std::unique_ptr<weld::Scrollbar> xHScroll)
+    : m_eMode(eMode)
+    , m_xVScroll(std::move(xVScroll))
+    , m_xHScroll(std::move(xHScroll))
+    , m_aSmoothScroll("hstpdf::PdfPageView m_aSmoothScroll")
+    , m_aThumbnailIdle("hstpdf::PdfPageView m_aThumbnailIdle")
+{
+    if (m_eMode == Mode::Thumbnails)
+        m_eFit = Fit::None;
+    m_xVScroll->connect_adjustment_value_changed(LINK(this, PdfPageView, VScrollHdl));
+    if (m_xHScroll)
+    {
+        m_xHScroll->connect_adjustment_value_changed(LINK(this, PdfPageView, HScrollHdl));
+        m_xHScroll->set_visible(false);
+    }
+    m_aSmoothScroll.SetTimeout(16);
+    m_aSmoothScroll.SetInvokeHandler(LINK(this, PdfPageView, SmoothScrollHdl));
+    m_aThumbnailIdle.SetPriority(TaskPriority::LOWEST);
+    m_aThumbnailIdle.SetInvokeHandler(LINK(this, PdfPageView, ThumbnailIdleHdl));
+}
+
+PdfPageView::~PdfPageView()
+{
+    m_aSmoothScroll.Stop();
+    m_aThumbnailIdle.Stop();
+}
+
+void PdfPageView::SetDrawingArea(weld::DrawingArea* pDrawingArea)
+{
+    weld::CustomWidgetController::SetDrawingArea(pDrawingArea);
+    pDrawingArea->set_size_request(m_eMode == Mode::Thumbnails ? THUMB_WIDTH + 2 * PAGE_MARGIN : 200,
+                                   120);
+}
+
+void PdfPageView::setDocument(PdfViewerDocument* pDocument)
+{
+    m_pDocument = pDocument;
+    m_aCache.clear();
+    m_pMatches = nullptr;
+    m_nCurrentMatch = -1;
+    m_nScrollX = m_nScrollY = m_nScrollTarget = 0;
+    m_nCurrentPage = m_nSelectedPage = 0;
+    m_oPlacement.reset();
+    m_bPainted = false; // the next paint is the first page of this document
+    clearSelection();
+    layout();
+    Invalidate();
+}
+
+double PdfPageView::pixelsPerPoint() const
+{
+    if (m_eMode == Mode::Thumbnails)
+        return m_pDocument && m_pDocument->getMaxPageWidth() > 0
+                   ? THUMB_WIDTH / m_pDocument->getMaxPageWidth()
+                   : 1.0;
+    return m_fZoom * 96.0 / 72.0;
+}
+
+void PdfPageView::layout()
+{
+    m_aPageTops.clear();
+    if (!m_pDocument)
+    {
+        updateScrollbars();
+        return;
+    }
+    const Size aView = GetOutputSizePixel();
+    if (m_eMode == Mode::Pages && m_eFit != Fit::None && aView.Width() > 0)
+    {
+        const double fWidthZoom = (aView.Width() - 2.0 * PAGE_MARGIN)
+                                  / (m_pDocument->getMaxPageWidth() * 96.0 / 72.0);
+        const basegfx::B2DSize aPage = m_pDocument->getPageSize(m_nCurrentPage);
+        const double fPageZoom
+            = std::min(fWidthZoom, (aView.Height() - 2.0 * PAGE_MARGIN) / (aPage.getHeight() * 96.0 / 72.0));
+        double fZoom = m_eFit == Fit::Page ? fPageZoom : fWidthZoom;
+        if (m_eFit == Fit::Auto)
+            fZoom = std::min(fZoom, 1.0);
+        m_fZoom = std::clamp(fZoom, MIN_ZOOM, MAX_ZOOM);
+    }
+    const double fPpp = pixelsPerPoint();
+    const tools::Long nGap = m_eMode == Mode::Thumbnails ? THUMB_GAP + THUMB_LABEL : PAGE_MARGIN;
+    tools::Long nY = m_eMode == Mode::Thumbnails ? THUMB_GAP : PAGE_MARGIN;
+    for (int i = 0; i < m_pDocument->getPageCount(); ++i)
+    {
+        m_aPageTops.push_back(nY);
+        nY += std::lround(m_pDocument->getPageSize(i).getHeight() * fPpp) + nGap;
+    }
+    m_aPageTops.push_back(nY); // content height
+    m_nContentWidth = std::lround(m_pDocument->getMaxPageWidth() * fPpp) + 2 * PAGE_MARGIN;
+    updateScrollbars();
+}
+
+void PdfPageView::updateScrollbars()
+{
+    const Size aView = GetOutputSizePixel();
+    const tools::Long nHeight = m_aPageTops.empty() ? 0 : m_aPageTops.back();
+    const tools::Long nMaxY = std::max<tools::Long>(0, nHeight - aView.Height());
+    m_nScrollY = std::clamp<tools::Long>(m_nScrollY, 0, nMaxY);
+    m_nScrollTarget = std::clamp<tools::Long>(m_nScrollTarget, 0, nMaxY);
+    m_xVScroll->adjustment_set_upper(std::max<tools::Long>(nHeight, 1));
+    m_xVScroll->adjustment_set_page_size(std::max<tools::Long>(aView.Height(), 1));
+    m_xVScroll->adjustment_set_step_increment(40);
+    m_xVScroll->adjustment_set_page_increment(std::max<tools::Long>(aView.Height() * 9 / 10, 1));
+    m_xVScroll->adjustment_set_value(m_nScrollY);
+    if (m_xHScroll)
+    {
+        const bool bHorz = m_nContentWidth > aView.Width() && aView.Width() > 0;
+        const tools::Long nMaxX = std::max<tools::Long>(0, m_nContentWidth - aView.Width());
+        m_nScrollX = bHorz ? std::clamp<tools::Long>(m_nScrollX, 0, nMaxX) : 0;
+        m_xHScroll->set_visible(bHorz);
+        m_xHScroll->adjustment_set_upper(std::max<tools::Long>(m_nContentWidth, 1));
+        m_xHScroll->adjustment_set_page_size(std::max<tools::Long>(aView.Width(), 1));
+        m_xHScroll->adjustment_set_step_increment(40);
+        m_xHScroll->adjustment_set_page_increment(std::max<tools::Long>(aView.Width() * 9 / 10, 1));
+        m_xHScroll->adjustment_set_value(m_nScrollX);
+    }
+}
+
+void PdfPageView::Resize()
+{
+    layout();
+    updateCurrentPage();
+    Invalidate();
+}
+
+void PdfPageView::setZoom(double fZoom)
+{
+    if (!m_pDocument)
+        return;
+    fZoom = std::clamp(fZoom, MIN_ZOOM, MAX_ZOOM);
+    // keep the point at the top of the view on the same place of its page
+    const int nPage = pageAt(0);
+    const tools::Long nPageTop = m_aPageTops.empty() ? 0 : m_aPageTops[nPage];
+    const double fOldPpp = pixelsPerPoint();
+    const double fInPage = (m_nScrollY - nPageTop) / fOldPpp;
+    m_eFit = Fit::None;
+    m_fZoom = fZoom;
+    m_aCache.clear();
+    layout();
+    scrollTo(m_aPageTops[nPage] + std::lround(fInPage * pixelsPerPoint()), m_nScrollX);
+    m_aZoomChangedHdl.Call(*this);
+}
+
+void PdfPageView::setFit(Fit eFit)
+{
+    m_eFit = eFit;
+    m_aCache.clear();
+    const int nPage = m_nCurrentPage;
+    layout();
+    if (!m_aPageTops.empty())
+        scrollTo(m_aPageTops[nPage] - PAGE_MARGIN, 0);
+    m_aZoomChangedHdl.Call(*this);
+}
+
+void PdfPageView::goToPage(int nPage)
+{
+    if (!m_pDocument || m_aPageTops.empty())
+        return;
+    nPage = std::clamp(nPage, 0, m_pDocument->getPageCount() - 1);
+    m_aSmoothScroll.Stop();
+    if (m_eMode == Mode::Thumbnails)
+    {
+        // only bring the thumbnail into view
+        const tools::Rectangle aRect = pageRect(nPage);
+        const tools::Long nViewHeight = GetOutputSizePixel().Height();
+        if (aRect.Top() < 0 || aRect.Bottom() + THUMB_LABEL > nViewHeight)
+            scrollTo(m_aPageTops[nPage] - THUMB_GAP, 0);
+        return;
+    }
+    if (m_eFit == Fit::Page)
+    {
+        m_nCurrentPage = nPage; // fit page follows the page shown
+        layout();
+    }
+    scrollTo(m_aPageTops[nPage] - PAGE_MARGIN / 2, m_nScrollX);
+}
+
+void PdfPageView::setSelectedPage(int nPage)
+{
+    if (m_nSelectedPage == nPage)
+        return;
+    m_nSelectedPage = nPage;
+    goToPage(nPage);
+    Invalidate();
+}
+
+void PdfPageView::scrollTo(tools::Long nY, tools::Long nX)
+{
+    const tools::Long nHeight = m_aPageTops.empty() ? 0 : m_aPageTops.back();
+    const tools::Long nMaxY = std::max<tools::Long>(0, nHeight - GetOutputSizePixel().Height());
+    const tools::Long nMaxX = std::max<tools::Long>(0, m_nContentWidth - GetOutputSizePixel().Width());
+    m_nScrollY = m_nScrollTarget = std::clamp<tools::Long>(nY, 0, nMaxY);
+    m_nScrollX = std::clamp<tools::Long>(nX, 0, nMaxX);
+    m_xVScroll->adjustment_set_value(m_nScrollY);
+    if (m_xHScroll)
+        m_xHScroll->adjustment_set_value(m_nScrollX);
+    updateCurrentPage();
+    Invalidate();
+}
+
+void PdfPageView::scrollBy(tools::Long nDelta, bool bSmooth)
+{
+    const tools::Long nHeight = m_aPageTops.empty() ? 0 : m_aPageTops.back();
+    const tools::Long nMaxY = std::max<tools::Long>(0, nHeight - GetOutputSizePixel().Height());
+    const tools::Long nBase = m_aSmoothScroll.IsActive() ? m_nScrollTarget : m_nScrollY;
+    const tools::Long nTarget = std::clamp<tools::Long>(nBase + nDelta, 0, nMaxY);
+    if (!bSmooth)
+    {
+        m_aSmoothScroll.Stop();
+        scrollTo(nTarget, m_nScrollX);
+        return;
+    }
+    m_nScrollTarget = nTarget;
+    if (!m_aSmoothScroll.IsActive())
+        m_aSmoothScroll.Start();
+}
+
+IMPL_LINK_NOARG(PdfPageView, SmoothScrollHdl, Timer*, void)
+{
+    const tools::Long nDistance = m_nScrollTarget - m_nScrollY;
+    if (nDistance == 0)
+        return;
+    // ease out: a third of the way per frame, at least one pixel
+    tools::Long nStep = nDistance / 3;
+    if (nStep == 0)
+        nStep = nDistance > 0 ? 1 : -1;
+    const tools::Long nTarget = m_nScrollTarget;
+    scrollTo(m_nScrollY + nStep, m_nScrollX);
+    m_nScrollTarget = nTarget;
+    if (m_nScrollY != m_nScrollTarget)
+        m_aSmoothScroll.Start();
+}
+
+IMPL_LINK_NOARG(PdfPageView, VScrollHdl, weld::Scrollbar&, void)
+{
+    m_aSmoothScroll.Stop();
+    m_nScrollY = m_nScrollTarget = m_xVScroll->adjustment_get_value();
+    updateCurrentPage();
+    Invalidate();
+}
+
+IMPL_LINK_NOARG(PdfPageView, HScrollHdl, weld::Scrollbar&, void)
+{
+    m_nScrollX = m_xHScroll->adjustment_get_value();
+    Invalidate();
+}
+
+tools::Rectangle PdfPageView::pageRect(int nPage) const
+{
+    const double fPpp = pixelsPerPoint();
+    const basegfx::B2DSize aSize = m_pDocument->getPageSize(nPage);
+    const tools::Long nWidth = std::lround(aSize.getWidth() * fPpp);
+    const tools::Long nHeight = std::lround(aSize.getHeight() * fPpp);
+    const tools::Long nViewWidth = GetOutputSizePixel().Width();
+    tools::Long nX;
+    if (m_nContentWidth <= nViewWidth || m_eMode == Mode::Thumbnails)
+        nX = (nViewWidth - nWidth) / 2;
+    else
+        nX = (m_nContentWidth - nWidth) / 2 - m_nScrollX;
+    return tools::Rectangle(Point(nX, m_aPageTops[nPage] - m_nScrollY), Size(nWidth, nHeight));
+}
+
+int PdfPageView::pageAt(tools::Long nViewY) const
+{
+    if (m_aPageTops.size() < 2)
+        return 0;
+    const tools::Long nY = nViewY + m_nScrollY;
+    auto it = std::upper_bound(m_aPageTops.begin(), m_aPageTops.end() - 1, nY);
+    const int nPage = static_cast<int>(it - m_aPageTops.begin()) - 1;
+    return std::clamp(nPage, 0, static_cast<int>(m_aPageTops.size()) - 2);
+}
+
+void PdfPageView::updateCurrentPage()
+{
+    if (m_eMode != Mode::Pages || !m_pDocument)
+        return;
+    const int nPage = pageAt(GetOutputSizePixel().Height() / 3);
+    if (nPage != m_nCurrentPage)
+    {
+        m_nCurrentPage = nPage;
+        m_aPageChangedHdl.Call(*this);
+    }
+}
+
+basegfx::B2DPoint PdfPageView::toPagePoint(int nPage, const Point& rPixel) const
+{
+    const tools::Rectangle aRect = pageRect(nPage);
+    const double fPpp = pixelsPerPoint();
+    return basegfx::B2DPoint((rPixel.X() - aRect.Left()) / fPpp, (rPixel.Y() - aRect.Top()) / fPpp);
+}
+
+tools::Rectangle PdfPageView::toPixel(int nPage, const PointRect& rRect) const
+{
+    const tools::Rectangle aPage = pageRect(nPage);
+    const double fPpp = pixelsPerPoint();
+    return tools::Rectangle(aPage.Left() + std::lround(rRect.getMinX() * fPpp),
+                            aPage.Top() + std::lround(rRect.getMinY() * fPpp),
+                            aPage.Left() + std::lround(rRect.getMaxX() * fPpp),
+                            aPage.Top() + std::lround(rRect.getMaxY() * fPpp));
+}
+
+Bitmap PdfPageView::pageBitmap(int nPage, const Size& rPixelSize, bool bRenderMissing)
+{
+    auto it = std::find_if(m_aCache.begin(), m_aCache.end(), [&](const CachedPage& rEntry) {
+        return rEntry.nPage == nPage && rEntry.aSize == rPixelSize;
+    });
+    if (it != m_aCache.end())
+    {
+        m_aCache.splice(m_aCache.begin(), m_aCache, it); // most recently used first
+        return m_aCache.front().aBitmap;
+    }
+    if (!bRenderMissing)
+        return Bitmap();
+    Bitmap aBitmap = m_pDocument->renderPage(nPage, rPixelSize.Width(), rPixelSize.Height());
+    m_aCache.push_front({ nPage, rPixelSize, aBitmap });
+    if (m_aCache.size() > (m_eMode == Mode::Thumbnails ? THUMB_CACHE : PAGE_CACHE))
+        m_aCache.pop_back();
+    return aBitmap;
+}
+
+void PdfPageView::paintPage(vcl::RenderContext& rRenderContext, int nPage, float fScale)
+{
+    const tools::Rectangle aRect = pageRect(nPage);
+    const bool bThumbs = m_eMode == Mode::Thumbnails;
+
+    // paper with a light border (a shadow line below)
+    rRenderContext.SetLineColor();
+    rRenderContext.SetFillColor(COL_PAGE_BORDER);
+    rRenderContext.DrawRect(tools::Rectangle(aRect.Left() - 1, aRect.Top() - 1, aRect.Right() + 1,
+                                             aRect.Bottom() + 2));
+    const Size aPixels(std::lround(aRect.GetWidth() * fScale), std::lround(aRect.GetHeight() * fScale));
+    Bitmap aBitmap = pageBitmap(nPage, aPixels, !bThumbs);
+    if (aBitmap.IsEmpty())
+    {
+        rRenderContext.SetFillColor(COL_WHITE);
+        rRenderContext.DrawRect(aRect);
+        if (bThumbs)
+            m_aThumbnailIdle.Start();
+    }
+    else
+        rRenderContext.DrawBitmap(aRect.TopLeft(), aRect.GetSize(), aBitmap);
+
+    if (bThumbs)
+    {
+        if (nPage == m_nSelectedPage)
+        {
+            rRenderContext.SetFillColor();
+            rRenderContext.SetLineColor(COL_SELECTED_THUMB);
+            rRenderContext.DrawRect(tools::Rectangle(aRect.Left() - 2, aRect.Top() - 2,
+                                                     aRect.Right() + 2, aRect.Bottom() + 2));
+            rRenderContext.DrawRect(tools::Rectangle(aRect.Left() - 3, aRect.Top() - 3,
+                                                     aRect.Right() + 3, aRect.Bottom() + 3));
+        }
+        const OUString aNumber = OUString::number(nPage + 1);
+        rRenderContext.SetTextColor(nPage == m_nSelectedPage ? COL_SELECTED_THUMB : COL_MUTED_TEXT);
+        const tools::Long nTextWidth = rRenderContext.GetTextWidth(aNumber);
+        rRenderContext.DrawText(Point(aRect.Center().X() - nTextWidth / 2, aRect.Bottom() + 4), aNumber);
+        return;
+    }
+
+    if (m_pMatches)
+    {
+        for (size_t i = 0; i < m_pMatches->size(); ++i)
+        {
+            const TextMatch& rMatch = (*m_pMatches)[i];
+            if (rMatch.nPage != nPage)
+                continue;
+            rRenderContext.SetLineColor();
+            rRenderContext.SetFillColor(static_cast<int>(i) == m_nCurrentMatch ? COL_CURRENT_MATCH : COL_MATCH);
+            for (const PointRect& rBox : rMatch.aBoxes)
+                rRenderContext.DrawTransparent(tools::PolyPolygon(tools::Polygon(toPixel(nPage, rBox))), 55);
+        }
+    }
+    if (m_nSelectionPage == nPage)
+    {
+        rRenderContext.SetLineColor();
+        rRenderContext.SetFillColor(COL_SELECTION);
+        for (const PointRect& rBox : m_aSelectionBoxes)
+            rRenderContext.DrawTransparent(tools::PolyPolygon(tools::Polygon(toPixel(nPage, rBox))), 65);
+    }
+    if (m_oPlacement && m_oPlacement->first == nPage)
+    {
+        const tools::Rectangle aBox = toPixel(nPage, m_oPlacement->second);
+        rRenderContext.SetLineColor();
+        rRenderContext.SetFillColor(COL_SIGN_GREEN);
+        rRenderContext.DrawTransparent(tools::PolyPolygon(tools::Polygon(aBox)), 93);
+        LineInfo aDash(LineStyle::Dash, 2);
+        aDash.SetDashLen(8);
+        aDash.SetDashCount(1);
+        aDash.SetDistance(5);
+        rRenderContext.SetLineColor(COL_SIGN_GREEN);
+        rRenderContext.SetFillColor();
+        rRenderContext.DrawPolyLine(tools::Polygon(aBox), aDash);
+        vcl::Font aFont = rRenderContext.GetFont();
+        aFont.SetWeight(WEIGHT_SEMIBOLD);
+        rRenderContext.Push(vcl::PushFlags::FONT | vcl::PushFlags::TEXTCOLOR);
+        rRenderContext.SetFont(aFont);
+        rRenderContext.SetTextColor(COL_SIGN_GREEN);
+        rRenderContext.DrawText(aBox, XsResId(STR_HSTPDF_SIGNATURE_PLACE),
+                                DrawTextFlags::Center | DrawTextFlags::VCenter | DrawTextFlags::MultiLine
+                                    | DrawTextFlags::WordBreak);
+        rRenderContext.Pop();
+    }
+}
+
+void PdfPageView::Paint(vcl::RenderContext& rRenderContext, const tools::Rectangle& /*rRect*/)
+{
+    const Size aView = GetOutputSizePixel();
+    rRenderContext.SetLineColor();
+    rRenderContext.SetFillColor(m_eMode == Mode::Thumbnails ? COL_THUMB_AREA : COL_PAGE_AREA);
+    rRenderContext.DrawRect(tools::Rectangle(Point(), aView));
+    if (!m_pDocument || m_aPageTops.size() < 2)
+        return;
+    const float fScale = std::max(1.0f, rRenderContext.GetDPIScaleFactor());
+    const int nFirst = pageAt(0);
+    for (int nPage = nFirst; nPage < m_pDocument->getPageCount(); ++nPage)
+    {
+        if (m_aPageTops[nPage] - m_nScrollY > aView.Height())
+            break;
+        paintPage(rRenderContext, nPage, fScale);
+    }
+    if (!m_bPainted && m_eMode == Mode::Pages)
+    {
+        m_bPainted = true;
+        m_aFirstPaintHdl.Call(*this);
+    }
+}
+
+IMPL_LINK_NOARG(PdfPageView, ThumbnailIdleHdl, Timer*, void)
+{
+    // render one missing thumbnail in view per idle round, so the window stays responsive
+    if (!m_pDocument || m_aPageTops.size() < 2)
+        return;
+    const tools::Long nViewHeight = GetOutputSizePixel().Height();
+    const float fScale = std::max(1.0f, GetDrawingArea()->get_ref_device().GetDPIScaleFactor());
+    for (int nPage = pageAt(0); nPage < m_pDocument->getPageCount(); ++nPage)
+    {
+        const tools::Rectangle aRect = pageRect(nPage);
+        if (aRect.Top() > nViewHeight)
+            break;
+        const Size aPixels(std::lround(aRect.GetWidth() * fScale), std::lround(aRect.GetHeight() * fScale));
+        if (pageBitmap(nPage, aPixels, false).IsEmpty())
+        {
+            pageBitmap(nPage, aPixels, true);
+            Invalidate();
+            m_aThumbnailIdle.Start();
+            return;
+        }
+    }
+}
+
+void PdfPageView::setMatches(const std::vector<TextMatch>* pMatches, int nCurrent)
+{
+    m_pMatches = pMatches;
+    m_nCurrentMatch = nCurrent;
+    if (pMatches && nCurrent >= 0 && nCurrent < static_cast<int>(pMatches->size()))
+    {
+        const TextMatch& rMatch = (*pMatches)[nCurrent];
+        // bring the match into view: centre it vertically when it is outside the view
+        if (!rMatch.aBoxes.empty())
+        {
+            const tools::Rectangle aBox = toPixel(rMatch.nPage, rMatch.aBoxes.front());
+            const Size aView = GetOutputSizePixel();
+            if (aBox.Top() < 0 || aBox.Bottom() > aView.Height())
+                scrollTo(m_nScrollY + aBox.Top() - aView.Height() / 3, m_nScrollX);
+            if (aBox.Left() < 0 || aBox.Right() > aView.Width())
+                scrollTo(m_nScrollY, m_nScrollX + aBox.Left() - aView.Width() / 3);
+        }
+    }
+    Invalidate();
+}
+
+void PdfPageView::clearSelection()
+{
+    m_nSelectionPage = -1;
+    m_aSelectionBoxes.clear();
+    m_aSelectedText.clear();
+    m_bSelecting = false;
+}
+
+void PdfPageView::setPlacementMode(bool bOn)
+{
+    m_bPlacementMode = bOn;
+    SetPointer(bOn ? PointerStyle::Cross : PointerStyle::Text);
+}
+
+void PdfPageView::setPlacement(std::optional<std::pair<int, PointRect>> oPlacement)
+{
+    m_oPlacement = std::move(oPlacement);
+    Invalidate();
+}
+
+bool PdfPageView::MouseButtonDown(const MouseEvent& rMEvt)
+{
+    if (!m_pDocument || m_aPageTops.size() < 2 || !rMEvt.IsLeft())
+        return false;
+    GrabFocus();
+    const int nPage = pageAt(rMEvt.GetPosPixel().Y());
+    if (!pageRect(nPage).Contains(rMEvt.GetPosPixel()))
+        return false;
+    if (m_eMode == Mode::Thumbnails)
+    {
+        m_nSelectedPage = nPage;
+        Invalidate();
+        m_aPageActivatedHdl.Call(*this);
+        return true;
+    }
+    CaptureMouse();
+    if (m_bPlacementMode)
+    {
+        m_bPlacing = true;
+        m_nPlacingPage = nPage;
+        m_aPlacingStart = toPagePoint(nPage, rMEvt.GetPosPixel());
+        return true;
+    }
+    clearSelection();
+    m_bSelecting = true;
+    m_nSelectionPage = nPage;
+    m_aSelectionStart = toPagePoint(nPage, rMEvt.GetPosPixel());
+    Invalidate();
+    return true;
+}
+
+bool PdfPageView::MouseMove(const MouseEvent& rMEvt)
+{
+    if (m_eMode == Mode::Thumbnails || !m_pDocument || m_aPageTops.size() < 2)
+        return false;
+    if (m_bPlacing)
+    {
+        const basegfx::B2DSize aSize = m_pDocument->getPageSize(m_nPlacingPage);
+        basegfx::B2DPoint aPoint = toPagePoint(m_nPlacingPage, rMEvt.GetPosPixel());
+        aPoint = basegfx::B2DPoint(std::clamp(aPoint.getX(), 0.0, aSize.getWidth()),
+                                   std::clamp(aPoint.getY(), 0.0, aSize.getHeight()));
+        PointRect aBox(m_aPlacingStart, aPoint);
+        m_oPlacement = std::make_pair(m_nPlacingPage, aBox);
+        Invalidate();
+        return true;
+    }
+    if (m_bSelecting)
+    {
+        const basegfx::B2DPoint aPoint = toPagePoint(m_nSelectionPage, rMEvt.GetPosPixel());
+        m_aSelectedText = m_pDocument->selectText(m_nSelectionPage, m_aSelectionStart, aPoint,
+                                                  m_aSelectionBoxes);
+        Invalidate();
+        return true;
+    }
+    const int nPage = pageAt(rMEvt.GetPosPixel().Y());
+    const bool bOnPage = pageRect(nPage).Contains(rMEvt.GetPosPixel());
+    SetPointer(m_bPlacementMode ? PointerStyle::Cross : bOnPage ? PointerStyle::Text : PointerStyle::Arrow);
+    return false;
+}
+
+bool PdfPageView::MouseButtonUp(const MouseEvent& rMEvt)
+{
+    if (m_eMode == Mode::Thumbnails)
+        return false;
+    if (IsMouseCaptured())
+        ReleaseMouse();
+    if (m_bPlacing)
+    {
+        m_bPlacing = false;
+        const basegfx::B2DSize aSize = m_pDocument->getPageSize(m_nPlacingPage);
+        PointRect aBox = m_oPlacement && m_oPlacement->first == m_nPlacingPage
+                             ? m_oPlacement->second
+                             : PointRect(m_aPlacingStart, m_aPlacingStart);
+        if (aBox.getWidth() < MIN_PLACEMENT || aBox.getHeight() < MIN_PLACEMENT)
+        {
+            // a click: a box of the usual size centred on the click, kept on the page
+            const double fX = std::clamp(m_aPlacingStart.getX() - DEFAULT_PLACEMENT_W / 2, 0.0,
+                                         std::max(0.0, aSize.getWidth() - DEFAULT_PLACEMENT_W));
+            const double fY = std::clamp(m_aPlacingStart.getY() - DEFAULT_PLACEMENT_H / 2, 0.0,
+                                         std::max(0.0, aSize.getHeight() - DEFAULT_PLACEMENT_H));
+            aBox = PointRect(fX, fY, fX + DEFAULT_PLACEMENT_W, fY + DEFAULT_PLACEMENT_H);
+        }
+        m_oPlacement = std::make_pair(m_nPlacingPage, aBox);
+        Invalidate();
+        m_aPlacementHdl.Call(*this);
+        return true;
+    }
+    if (m_bSelecting)
+    {
+        MouseMove(rMEvt);
+        m_bSelecting = false;
+        m_aSelectionHdl.Call(*this);
+        return true;
+    }
+    return false;
+}
+
+bool PdfPageView::Command(const CommandEvent& rCEvt)
+{
+    if (rCEvt.GetCommand() != CommandEventId::Wheel || !m_pDocument)
+        return false;
+    const CommandWheelData* pData = rCEvt.GetWheelData();
+    if (!pData)
+        return false;
+    if (m_eMode == Mode::Pages
+        && (pData->GetMode() == CommandWheelMode::ZOOM || pData->IsMod1()))
+    {
+        setZoom(m_fZoom * (pData->GetDelta() > 0 ? 1.1 : 1.0 / 1.1));
+        return true;
+    }
+    double fPixels;
+    if (pData->IsDeltaPixel())
+        fPixels = -pData->GetDelta();
+    else
+    {
+        const double fLines = pData->GetScrollLines() == COMMAND_WHEEL_PAGESCROLL
+                                  ? GetOutputSizePixel().Height() / 18.0
+                                  : std::max(1.0, pData->GetScrollLines());
+        fPixels = -pData->GetDelta() / 120.0 * fLines * 18.0;
+    }
+    if (pData->IsHorz() || pData->IsShift())
+    {
+        if (m_xHScroll && m_xHScroll->get_visible())
+            scrollTo(m_nScrollY, m_nScrollX + std::lround(fPixels));
+        return true;
+    }
+    scrollBy(std::lround(fPixels), true);
+    return true;
+}
+
+bool PdfPageView::KeyInput(const KeyEvent& rKEvt)
+{
+    if (!m_pDocument)
+        return false;
+    const vcl::KeyCode& rKey = rKEvt.GetKeyCode();
+    const tools::Long nPage = std::max<tools::Long>(GetOutputSizePixel().Height() * 9 / 10, 40);
+    if (m_eMode == Mode::Thumbnails)
+    {
+        int nNew = m_nSelectedPage;
+        switch (rKey.GetCode())
+        {
+            case KEY_UP: nNew--; break;
+            case KEY_DOWN: nNew++; break;
+            case KEY_HOME: nNew = 0; break;
+            case KEY_END: nNew = m_pDocument->getPageCount() - 1; break;
+            default: return false;
+        }
+        nNew = std::clamp(nNew, 0, m_pDocument->getPageCount() - 1);
+        setSelectedPage(nNew);
+        m_aPageActivatedHdl.Call(*this);
+        return true;
+    }
+    switch (rKey.GetCode())
+    {
+        case KEY_UP: scrollBy(-48, true); return true;
+        case KEY_DOWN: scrollBy(48, true); return true;
+        case KEY_PAGEUP: scrollBy(-nPage, true); return true;
+        case KEY_PAGEDOWN:
+        case KEY_SPACE: scrollBy(rKey.IsShift() ? -nPage : nPage, true); return true;
+        case KEY_HOME: scrollTo(0, m_nScrollX); return true;
+        case KEY_END: scrollTo(m_aPageTops.back(), m_nScrollX); return true;
+        case KEY_LEFT:
+            if (m_xHScroll && m_xHScroll->get_visible())
+                scrollTo(m_nScrollY, m_nScrollX - 48);
+            else
+                goToPage(m_nCurrentPage - 1);
+            return true;
+        case KEY_RIGHT:
+            if (m_xHScroll && m_xHScroll->get_visible())
+                scrollTo(m_nScrollY, m_nScrollX + 48);
+            else
+                goToPage(m_nCurrentPage + 1);
+            return true;
+        default: return false;
+    }
+}
+}
