+<!DOCTYPE oor:component-schema SYSTEM "../../../../component-schema.dtd">
+<oor:component-schema xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" oor:name="HSTPdfViewer" oor:package="org.openoffice.Office" xml:lang="en-US">
+  <info>
+    <desc>HST PDF, the lightweight PDF viewer with digital signing.</desc>
+  </info>
+  <component>
+    <group oor:name="Viewer">
+      <info>
+        <desc>How PDF files open.</desc>
+      </info>
+      <prop oor:name="OpenPdfInViewer" oor:type="xs:boolean" oor:nillable="false">
+        <info>
+          <desc>Open PDF files in HST PDF (fast, read-only, signing). When false they open in HST Draw
+            (full import for editing), as in LibreOffice.</desc>
+          <label>Open PDF files in HST PDF</label>
+        </info>
+        <value>true</value>
+      </prop>
+    </group>
+    <group oor:name="Signing">
+      <info>
+        <desc>The certificate used for the last PDF signature, offered again next time.</desc>
+      </info>
+      <prop oor:name="LastCertificateThumbprint" oor:type="xs:string" oor:nillable="false">
+        <info>
+          <desc>SHA-1 thumbprint (hex) of the last signing certificate.</desc>
+        </info>
+        <value/>
+      </prop>
+    </group>
+  </component>
+</oor:component-schema>
