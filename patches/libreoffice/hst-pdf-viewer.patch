+/// Printing renders pages at this resolution (enough for text, keeps the spool small).
+constexpr double PRINT_DPI = 200.0;
+
+class PdfPrinterController final : public vcl::PrinterController
+{
+public:
+    PdfPrinterController(const VclPtr<Printer>& rPrinter, weld::Window* pParent,
+                         PdfViewerDocument& rDocument, int nCurrentPage, const OUString& rJobName)
+        : PrinterController(rPrinter, pParent)
+        , m_rDocument(rDocument)
+        , m_nCurrentPage(nCurrentPage)
+    {
+        setValue(u"JobName"_ustr, uno::Any(rJobName));
+        std::vector<beans::PropertyValue> aOptions;
+        vcl::PrinterOptionsHelper::UIControlOptions aRangeGroup;
+        aRangeGroup.mbInternalOnly = true;
+        aRangeGroup.maGroupHint = "PrintRange";
+        aOptions.push_back(comphelper::makePropertyValue(
+            u""_ustr, vcl::PrinterOptionsHelper::setSubgroupControlOpt(
+                          u"printrange"_ustr, XsResId(STR_HSTPDF_PRINT_PAGES), OUString(), aRangeGroup)));
+        const uno::Sequence<OUString> aIds{ u"rbAllPages"_ustr, u"rbRangePages"_ustr,
+                                            u"rbRangeSelection"_ustr };
+        const uno::Sequence<OUString> aChoices{ XsResId(STR_HSTPDF_PRINT_ALL),
+                                                XsResId(STR_HSTPDF_PRINT_RANGE),
+                                                XsResId(STR_HSTPDF_PRINT_CURRENT) };
+        aOptions.push_back(comphelper::makePropertyValue(
+            u""_ustr, vcl::PrinterOptionsHelper::setChoiceRadiosControlOpt(
+                          aIds, OUString(), uno::Sequence<OUString>(), u"PrintContent"_ustr,
+                          aChoices, 0)));
+        vcl::PrinterOptionsHelper::UIControlOptions aRangeEdit(u"PrintContent"_ustr, 1, true);
+        aOptions.push_back(comphelper::makePropertyValue(
+            u""_ustr, vcl::PrinterOptionsHelper::setEditControlOpt(
+                          u"pagerange"_ustr, OUString(), OUString(), u"PageRange"_ustr,
+                          OUString::number(nCurrentPage + 1), aRangeEdit)));
+        setUIOptions(comphelper::containerToSequence(aOptions));
+    }
+
+    // The base versions are empty and not exported from vcl: override them here.
+    void jobStarted() override {}
+    void jobFinished(view::PrintableState) override {}
+
+    int getPageCount() const override { return static_cast<int>(pages().size()); }
+
+    uno::Sequence<beans::PropertyValue> getPageParameters(int nPage) const override
+    {
+        const std::vector<sal_Int32> aPages = pages();
+        if (nPage < 0 || nPage >= static_cast<int>(aPages.size()))
+            return {};
+        const basegfx::B2DSize aSize = m_rDocument.getPageSize(aPages[nPage]);
+        return { comphelper::makePropertyValue(
+            u"PageSize"_ustr, awt::Size(std::lround(pointToMm100(aSize.getWidth())),
+                                        std::lround(pointToMm100(aSize.getHeight())))) };
+    }
+
+    void printPage(int nPage) const override
+    {
+        const std::vector<sal_Int32> aPages = pages();
+        if (nPage < 0 || nPage >= static_cast<int>(aPages.size()))
+            return;
+        const int nPdfPage = aPages[nPage];
+        const basegfx::B2DSize aSize = m_rDocument.getPageSize(nPdfPage);
+        const double fScale = std::min(PRINT_DPI / 72.0,
+                                       5000.0 / std::max(aSize.getWidth(), aSize.getHeight()));
+        const Bitmap aBitmap = m_rDocument.renderPage(nPdfPage, std::lround(aSize.getWidth() * fScale),
+                                                      std::lround(aSize.getHeight() * fScale));
+        VclPtr<Printer> xPrinter = getPrinter();
+        xPrinter->Push();
+        xPrinter->SetMapMode(MapMode(MapUnit::Map100thMM));
+        xPrinter->DrawBitmap(Point(0, 0),
+                             Size(std::lround(pointToMm100(aSize.getWidth())),
+                                  std::lround(pointToMm100(aSize.getHeight()))),
+                             aBitmap);
+        xPrinter->Pop();
+    }
+
+private:
+    /// 0-based PDF pages chosen in the print dialog.
+    std::vector<sal_Int32> pages() const
+    {
+        const int nCount = m_rDocument.getPageCount();
+        std::vector<sal_Int32> aPages;
+        sal_Int32 nContent = 0;
+        if (const beans::PropertyValue* pContent = getValue(u"PrintContent"_ustr))
+            pContent->Value >>= nContent;
+        if (nContent == 2)
+            return { m_nCurrentPage };
+        OUString aRange;
+        if (const beans::PropertyValue* pRange = getValue(u"PageRange"_ustr))
+            pRange->Value >>= aRange;
+        if (nContent == 1 && !aRange.isEmpty())
+        {
+            StringRangeEnumerator::getRangesFromString(aRange, aPages, 0, nCount - 1, 0);
+            if (!aPages.empty())
+                return aPages;
+        }
+        aPages.resize(nCount);
+        for (int i = 0; i < nCount; ++i)
+            aPages[i] = i;
+        return aPages;
+    }
+
+    PdfViewerDocument& m_rDocument;
+    int m_nCurrentPage;
+};
+}
+
+void printDocument(PdfViewerDocument& rDocument, int nCurrentPage, const OUString& rJobName,
+                   weld::Window* pParent)
+{
+    auto xController = std::make_shared<PdfPrinterController>(VclPtr<Printer>(), pParent,
+                                                               rDocument, nCurrentPage, rJobName);
+    Printer::PrintJob(xController, JobSetup());
+}
+}
