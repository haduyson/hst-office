+bool PdfViewerWindow::chooseCertificate()
+{
+    OUString aDescription;
+    uno::Reference<security::XCertificate> xCertificate;
+    try
+    {
+        xCertificate = hstpdf::chooseCertificate(VCLUnoHelper::GetInterface(this), aDescription);
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("xmlsecurity.hstpdf", "chooseCertificate");
+    }
+    if (!xCertificate.is())
+        return false;
+    m_xCertificate = xCertificate;
+    if (m_xReason->get_text().isEmpty() && !aDescription.isEmpty())
+        m_xReason->set_text(aDescription);
+    updateSignPanel();
+    return true;
