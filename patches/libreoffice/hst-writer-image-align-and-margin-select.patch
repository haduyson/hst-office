+#include <sal/types.h>
+
+class SfxItemSet;
+class SfxRequest;
+class SwWrtShell;
+
+/// Left / Center / Right for a selected picture, embedded object or drawing shape (also a group),
+/// as a user expects from a word processor: the paragraph alignment commands (Home tab, Ctrl+L/E/R, sidebar) and the
+/// object alignment commands (picture context menu, Picture tab) both apply.
+/// - Object anchored as character: the alignment of the paragraph that holds it.
+/// - Any other anchor: the horizontal position, relative to the text area of the anchor.
+/// Text frames are not covered: the paragraph commands stay disabled for them and the object
+/// commands keep their own behaviour.
+namespace hst::imagealign
+{
+/// Runs rReq when it is one of the alignment commands and a picture or object is selected.
+/// Returns false when the request is not handled here.
+bool Execute(SwWrtShell& rSh, SfxRequest& rReq);
+
+/// Fills the enabled / checked state of nWhich when it is one of the alignment commands.
+/// Returns false when the state is not handled here.
+bool GetState(SwWrtShell& rSh, sal_uInt16 nWhich, SfxItemSet& rSet);
+}
