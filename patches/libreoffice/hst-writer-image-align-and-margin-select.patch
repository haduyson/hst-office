+namespace hst::imagealign
+{
+namespace
+{
+namespace HoriOrientation = css::text::HoriOrientation;
+
+/// What one alignment command means for an inline object (its paragraph) and for a floating
+/// one (its horizontal position).
+struct Alignment
+{
+    SvxAdjust eParagraph;
+    sal_Int16 nHoriOrient;
+};
+
+/// The alignment a command asks for, or nothing when nSlot is not an alignment command.
+std::optional<Alignment> AlignmentOf(sal_uInt16 nSlot)
+{
+    switch (nSlot)
+    {
+        case SID_ATTR_PARA_ADJUST_LEFT:
+        case SID_OBJECT_ALIGN_LEFT:
+            return Alignment{ SvxAdjust::Left, HoriOrientation::LEFT };
+        case SID_ATTR_PARA_ADJUST_START:
+            return Alignment{ SvxAdjust::ParaStart, HoriOrientation::LEFT };
+        case SID_ATTR_PARA_ADJUST_CENTER:
+        case SID_OBJECT_ALIGN_CENTER:
+            return Alignment{ SvxAdjust::Center, HoriOrientation::CENTER };
+        case SID_ATTR_PARA_ADJUST_RIGHT:
+        case SID_OBJECT_ALIGN_RIGHT:
+            return Alignment{ SvxAdjust::Right, HoriOrientation::RIGHT };
+        case SID_ATTR_PARA_ADJUST_END:
+            return Alignment{ SvxAdjust::ParaEnd, HoriOrientation::RIGHT };
+        default:
+            return std::nullopt;
+    }
+}
+
+/// The paragraph commands, which only the text shell offered before.
+bool IsParagraphCommand(sal_uInt16 nSlot)
+{
+    return nSlot != SID_OBJECT_ALIGN_LEFT && nSlot != SID_OBJECT_ALIGN_CENTER
+           && nSlot != SID_OBJECT_ALIGN_RIGHT;
+}
+
+/// The format of the selected object: a frame showing a picture or an embedded object (not text),
+/// or one drawing shape (a group counts as one; not a form control, not a shape inside an entered
+/// group, which has no anchor of its own).
+SwFrameFormat* SelectedObjectFormat(const SwWrtShell& rSh)
+{
+    if (SwFlyFrame* pFly = rSh.GetSelectedFlyFrame())
+    {
+        if (!pFly->Lower() || !pFly->Lower()->IsNoTextFrame())
+            return nullptr;
+        return pFly->GetFormat();
+    }
+    const SdrView* pSdrView = rSh.GetDrawView();
+    if (!pSdrView || pSdrView->IsGroupEntered())
+        return nullptr;
+    const SdrMarkList& rMarks = pSdrView->GetMarkedObjectList();
+    if (rMarks.GetMarkCount() != 1)
+        return nullptr;
+    SdrObject* pObj = rMarks.GetMark(0)->GetMarkedSdrObj();
+    if (!pObj || pObj->GetObjInventor() == SdrInventor::FmForm)
+        return nullptr;
+    SwFrameFormat* pFormat = ::FindFrameFormat(pObj);
+    return pFormat && pFormat->Which() == RES_DRAWFRMFMT ? pFormat : nullptr;
+}
+
+/// The paragraph holding rFormat when it is anchored as character, else nullptr.
+SwTextNode* InlineParagraph(const SwFrameFormat& rFormat)
+{
+    const SwFormatAnchor& rAnchor = rFormat.GetAnchor();
+    if (rAnchor.GetAnchorId() != RndStdIds::FLY_AS_CHAR)
+        return nullptr;
+    SwNode* pNode = rAnchor.GetAnchorNode();
+    return pNode ? pNode->GetTextNode() : nullptr;
+}
+
+bool IsPositionProtected(const SwWrtShell& rSh)
+{
+    return rSh.IsSelObjProtected(FlyProtectFlags::Pos | FlyProtectFlags::Parent)
+           != FlyProtectFlags::NONE;
+}
+
+bool IsHtmlDocument(SwWrtShell& rSh) { return GetHtmlMode(rSh.GetView().GetDocShell()) != 0; }
+
+void InvalidateAlignmentState(SwWrtShell& rSh)
+{
+    SfxBindings& rBindings = rSh.GetView().GetViewFrame().GetBindings();
+    static constexpr sal_uInt16 aSlots[]
+        = { SID_ATTR_PARA_ADJUST_LEFT, SID_ATTR_PARA_ADJUST_START, SID_ATTR_PARA_ADJUST_CENTER,
+            SID_ATTR_PARA_ADJUST_RIGHT, SID_ATTR_PARA_ADJUST_END,  SID_OBJECT_ALIGN_LEFT,
+            SID_OBJECT_ALIGN_CENTER,    SID_OBJECT_ALIGN_RIGHT };
+    for (sal_uInt16 nSlot : aSlots)
+        rBindings.Invalidate(nSlot);
+}
+}
+
+bool Execute(SwWrtShell& rSh, SfxRequest& rReq)
+{
+    const std::optional<Alignment> oAlignment = AlignmentOf(rReq.GetSlot());
+    if (!oAlignment)
+        return false;
+    SwFrameFormat* pFormat = SelectedObjectFormat(rSh);
+    if (!pFormat)
+        return false;
+
+    if (SwTextNode* pParagraph = InlineParagraph(*pFormat))
+    {
+        if (pParagraph->IsInProtectSect())
+            return true;
+        // One attribute change of the anchor paragraph: one undo step, the object stays selected.
+        rSh.StartAllAction();
+        rSh.GetDoc()->getIDocumentContentOperations().InsertPoolItem(
+            SwPaM(*pParagraph), SvxAdjustItem(oAlignment->eParagraph, RES_PARATR_ADJUST),
+            SetAttrMode::DEFAULT, rSh.GetLayout());
+        rSh.EndAllAction();
+    }
+    else
+    {
+        if (IsPositionProtected(rSh)
+            || (oAlignment->nHoriOrient == HoriOrientation::CENTER && IsHtmlDocument(rSh)))
+            return true;
+        SfxItemSet aSet(
+            SfxItemSet::makeFixedSfxItemSet<RES_HORI_ORIENT, RES_HORI_ORIENT>(rSh.GetAttrPool()));
+        aSet.Put(SwFormatHoriOrient(0, oAlignment->nHoriOrient,
+                                    css::text::RelOrientation::PRINT_AREA));
+        // A single frame attribute change: one undo step.
+        if (pFormat->Which() == RES_DRAWFRMFMT)
+        {
+            rSh.StartAllAction();
+            rSh.GetDoc()->SetFlyFrameAttr(*pFormat, aSet);
+            rSh.EndAllAction();
+        }
+        else
+            rSh.SetFlyFrameAttr(aSet);
+    }
+    InvalidateAlignmentState(rSh);
+    rReq.Done();
+    return true;
+}
+
+bool GetState(SwWrtShell& rSh, sal_uInt16 nWhich, SfxItemSet& rSet)
+{
+    const std::optional<Alignment> oAlignment = AlignmentOf(nWhich);
+    if (!oAlignment)
+        return false;
+    const SwFrameFormat* pFormat = SelectedObjectFormat(rSh);
+    if (!pFormat)
+    {
+        if (!IsParagraphCommand(nWhich))
+            return false;
+        rSet.DisableItem(nWhich);
+        return true;
+    }
+
+    if (const SwTextNode* pParagraph = InlineParagraph(*pFormat))
+    {
+        if (pParagraph->IsInProtectSect())
+            rSet.DisableItem(nWhich);
+        else
+            rSet.Put(SfxBoolItem(nWhich, pParagraph->GetSwAttrSet().GetAdjust().GetAdjust()
+                                             == oAlignment->eParagraph));
+        return true;
+    }
+
+    if (IsPositionProtected(rSh)
+        || (oAlignment->nHoriOrient == HoriOrientation::CENTER && IsHtmlDocument(rSh)))
+        rSet.DisableItem(nWhich);
+    else
+        rSet.Put(SfxBoolItem(nWhich,
+                             pFormat->GetHoriOrient().GetHoriOrient() == oAlignment->nHoriOrient));
+    return true;
+}
+}
