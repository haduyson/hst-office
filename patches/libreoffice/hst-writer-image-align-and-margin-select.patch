+/// Left / Center / Right on a selected picture: its paragraph when it is inline, its horizontal
+/// position when it floats.
+class HstImageAlignTest : public SwModelTestBase
+{
+public:
+    HstImageAlignTest()
+        : SwModelTestBase(u"/sw/qa/uibase/hst/"_ustr)
+    {
+    }
+
+protected:
+    /// Paragraphs "Before", the picture (2 cm square) and "After"; the picture anchored as given.
+    void createDocWithPicture(text::TextContentAnchorType eAnchor)
+    {
+        createSwDoc();
+        uno::Reference<lang::XMultiServiceFactory> xFactory(mxComponent, uno::UNO_QUERY_THROW);
+        uno::Reference<text::XTextDocument> xTextDocument(mxComponent, uno::UNO_QUERY_THROW);
+        uno::Reference<text::XText> xText = xTextDocument->getText();
+        uno::Reference<text::XTextCursor> xCursor = xText->createTextCursor();
+        xCursor->gotoEnd(false);
+        xText->insertString(xCursor, u"Before"_ustr, false);
+        xText->insertControlCharacter(xCursor, text::ControlCharacter::PARAGRAPH_BREAK, false);
+
+        Bitmap aBitmap(Size(16, 16), vcl::PixelFormat::N24_BPP);
+        aBitmap.Erase(COL_LIGHTRED);
+        uno::Reference<beans::XPropertySet> xPicture(
+            xFactory->createInstance(u"com.sun.star.text.TextGraphicObject"_ustr),
+            uno::UNO_QUERY_THROW);
+        xPicture->setPropertyValue(u"Graphic"_ustr, uno::Any(Graphic(aBitmap).GetXGraphic()));
+        xPicture->setPropertyValue(u"AnchorType"_ustr, uno::Any(eAnchor));
+        xPicture->setPropertyValue(u"Size"_ustr, uno::Any(awt::Size(2000, 2000)));
+        uno::Reference<text::XTextContent> xContent(xPicture, uno::UNO_QUERY_THROW);
+        xText->insertTextContent(xCursor, xContent, false);
+
+        xText->insertControlCharacter(xCursor, text::ControlCharacter::PARAGRAPH_BREAK, false);
+        xText->insertString(xCursor, u"After"_ustr, false);
+    }
+
+    /// Paragraphs "Before", a drawing shape (a group of two rectangles when bGroup) and "After";
+    /// the shape anchored as given.
+    void createDocWithShape(text::TextContentAnchorType eAnchor, bool bGroup)
+    {
+        createSwDoc();
+        uno::Reference<lang::XMultiServiceFactory> xFactory(mxComponent, uno::UNO_QUERY_THROW);
+        uno::Reference<text::XTextDocument> xTextDocument(mxComponent, uno::UNO_QUERY_THROW);
+        uno::Reference<text::XText> xText = xTextDocument->getText();
+        uno::Reference<text::XTextCursor> xCursor = xText->createTextCursor();
+        xCursor->gotoEnd(false);
+        xText->insertString(xCursor, u"Before"_ustr, false);
+        xText->insertControlCharacter(xCursor, text::ControlCharacter::PARAGRAPH_BREAK, false);
+        xText->insertControlCharacter(xCursor, text::ControlCharacter::PARAGRAPH_BREAK, false);
+        xText->insertString(xCursor, u"After"_ustr, false);
+        xCursor->gotoStart(false);
+        xCursor->gotoNextParagraph(false); // the empty second paragraph holds the shape
+
+        uno::Reference<drawing::XShapes> xGroup
+            = drawing::ShapeCollection::create(comphelper::getProcessComponentContext());
+        for (int i = 0; i < (bGroup ? 2 : 1); ++i)
+        {
+            uno::Reference<drawing::XShape> xShape(
+                xFactory->createInstance(u"com.sun.star.drawing.RectangleShape"_ustr),
+                uno::UNO_QUERY_THROW);
+            xShape->setSize(awt::Size(1500, 1000));
+            uno::Reference<beans::XPropertySet>(xShape, uno::UNO_QUERY_THROW)
+                ->setPropertyValue(u"AnchorType"_ustr,
+                                   uno::Any(bGroup ? text::TextContentAnchorType_AT_PARAGRAPH
+                                                   : eAnchor));
+            xText->insertTextContent(
+                xCursor, uno::Reference<text::XTextContent>(xShape, uno::UNO_QUERY_THROW), false);
+            xShape->setPosition(awt::Point(i * 2000, 0));
+            xGroup->add(xShape);
+        }
+        if (bGroup)
+        {
+            uno::Reference<drawing::XDrawPageSupplier> xSupplier(mxComponent, uno::UNO_QUERY_THROW);
+            uno::Reference<drawing::XShapeGrouper> xGrouper(xSupplier->getDrawPage(),
+                                                            uno::UNO_QUERY_THROW);
+            uno::Reference<beans::XPropertySet> xGroupShape(xGrouper->group(xGroup),
+                                                            uno::UNO_QUERY_THROW);
+            xGroupShape->setPropertyValue(u"AnchorType"_ustr, uno::Any(eAnchor));
+        }
+        calcLayout();
+    }
+
+    void selectFirstObject()
+    {
+        selectShape(1);
+        Scheduler::ProcessEventsToIdle(); // the frame or drawing shells come with the selection
+        SwWrtShell* pWrtShell = getSwDocShell()->GetWrtShell();
+        CPPUNIT_ASSERT(pWrtShell->IsFrameSelected() || pWrtShell->GetSelectedObjCount() == 1);
+    }
+
+    /// Horizontal centre of the body text area and of the first drawing object, in twips.
+    std::pair<tools::Long, tools::Long> bodyAndShapeCentres()
+    {
+        SwWrtShell* pWrtShell = getSwDocShell()->GetWrtShell();
+        const SwPageFrame* pPage = static_cast<const SwPageFrame*>(pWrtShell->GetLayout()->Lower());
+        SdrPage* pDrawPage
+            = getSwDoc()->getIDocumentDrawModelAccess().GetDrawModel()->GetPage(0);
+        return { pPage->FindBodyCont()->getFrameArea().Center().X(),
+                 pDrawPage->GetObj(0)->GetSnapRect().Center().X() };
+    }
+
+    /// The state of nSlot for the current selection; rChecked is its checkmark.
+    SfxItemState queryState(sal_uInt16 nSlot, bool& rChecked)
+    {
+        SfxPoolItemHolder aResult;
+        SfxDispatcher* pDispatcher = getSwDocShell()->GetView()->GetViewFrame().GetDispatcher();
+        const SfxItemState eState = pDispatcher->QueryState(nSlot, aResult);
+        const auto* pBool = dynamic_cast<const SfxBoolItem*>(aResult.getItem());
+        rChecked = pBool && pBool->GetValue();
+        return eState;
+    }
+
+    sal_Int16 paraAdjust(int nParagraph)
+    {
+        return getProperty<sal_Int16>(getParagraph(nParagraph), u"ParaAdjust"_ustr);
+    }
+
+    size_t undoCount() { return getSwDoc()->GetIDocumentUndoRedo().GetUndoActionCount(); }
+};
+
+constexpr sal_Int16 ADJUST_LEFT = sal_Int16(style::ParagraphAdjust_LEFT);
+constexpr sal_Int16 ADJUST_CENTER = sal_Int16(style::ParagraphAdjust_CENTER);
+constexpr sal_Int16 ADJUST_RIGHT = sal_Int16(style::ParagraphAdjust_RIGHT);
+}
+
+CPPUNIT_TEST_FIXTURE(HstImageAlignTest, testInlinePictureCenterAlignsItsParagraph)
+{
+    createDocWithPicture(text::TextContentAnchorType_AS_CHARACTER);
+    selectFirstObject();
+
+    // Center is offered for the selected picture, not checked yet:
+    bool bChecked = true;
+    CPPUNIT_ASSERT(queryState(SID_ATTR_PARA_ADJUST_CENTER, bChecked) >= SfxItemState::DEFAULT);
+    CPPUNIT_ASSERT(!bChecked);
+
+    const size_t nUndo = undoCount();
+    dispatchCommand(mxComponent, u".uno:CenterPara"_ustr, {});
+
+    // The picture's paragraph is centred, the others are not, and the picture stays selected:
+    CPPUNIT_ASSERT_EQUAL(ADJUST_LEFT, paraAdjust(1));
+    CPPUNIT_ASSERT_EQUAL(ADJUST_CENTER, paraAdjust(2));
+    CPPUNIT_ASSERT_EQUAL(ADJUST_LEFT, paraAdjust(3));
+    CPPUNIT_ASSERT(getSwDocShell()->GetWrtShell()->IsFrameSelected());
+    queryState(SID_ATTR_PARA_ADJUST_CENTER, bChecked);
+    CPPUNIT_ASSERT(bChecked);
+
+    // One undo step brings it back:
+    CPPUNIT_ASSERT_EQUAL(nUndo + 1, undoCount());
+    dispatchCommand(mxComponent, u".uno:Undo"_ustr, {});
+    CPPUNIT_ASSERT_EQUAL(ADJUST_LEFT, paraAdjust(2));
+}
+
+CPPUNIT_TEST_FIXTURE(HstImageAlignTest, testInlinePictureRightAndContextMenuCommands)
+{
+    createDocWithPicture(text::TextContentAnchorType_AS_CHARACTER);
+    selectFirstObject();
+
+    // Ctrl+R / Home tab:
+    dispatchCommand(mxComponent, u".uno:RightPara"_ustr, {});
+    CPPUNIT_ASSERT_EQUAL(ADJUST_RIGHT, paraAdjust(2));
+
+    // Picture context menu / Picture tab:
+    bool bChecked = false;
+    CPPUNIT_ASSERT(queryState(SID_OBJECT_ALIGN_CENTER, bChecked) >= SfxItemState::DEFAULT);
+    dispatchCommand(mxComponent, u".uno:AlignCenter"_ustr, {});
+    CPPUNIT_ASSERT_EQUAL(ADJUST_CENTER, paraAdjust(2));
+    dispatchCommand(mxComponent, u".uno:ObjectAlignLeft"_ustr, {});
+    CPPUNIT_ASSERT_EQUAL(ADJUST_LEFT, paraAdjust(2));
+}
