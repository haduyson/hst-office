+    dispatchCommand(mxComponent, u".uno:Undo"_ustr, {});
+    CPPUNIT_ASSERT(text::HoriOrientation::CENTER
+                   != getProperty<sal_Int16>(xPicture, u"HoriOrient"_ustr));
+}
