+    const SwRect& rBody = pPage->FindBodyCont()->getFrameArea();
+    auto pFormat = dynamic_cast<SwFlyFrameFormat*>((*getSwDoc()->GetSpzFrameFormats())[0]);
+    CPPUNIT_ASSERT(pFormat);
+    const SwFlyFrame* pFly = pFormat->GetFrame();
+    CPPUNIT_ASSERT(pFly);
+    CPPUNIT_ASSERT_DOUBLES_EQUAL(double(rBody.Center().X()),
