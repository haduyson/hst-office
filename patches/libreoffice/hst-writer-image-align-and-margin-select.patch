+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * Part of HST Office. This file is HST's own work and is not covered by the MPL.
+ */
+
+#pragma once
+
+#include <sal/types.h>
+
+class Point;
+class SwWrtShell;
+namespace vcl
+{
+class Window;
+}
+
+/// The selection margin left of the body text: the pointer turns into a right-pointing arrow,
+/// a click selects the line beside it, a double click its paragraph, a drag whole lines, and a
+/// triple click or Ctrl+click the whole document.
+/// Only plain body text of a left-to-right horizontal page takes part: tables, footnotes,
+/// headers / footers, objects and the comment sidebar keep their own mouse handling.
+/// All points are document coordinates (twips).
+namespace hst::marginselect
+{
+/// Whether rDocPt is in the selection margin beside a body text line. Cheap when rDocPt is not
+/// in a left page margin: a few rectangle tests on the visible pages.
+bool IsOverMargin(SwWrtShell& rSh, const Point& rDocPt);
+
+/// A left button press at rDocPt in the selection margin selects the line (one click), the
+/// paragraph (double click) or the whole document (triple click, or Ctrl+click: nModifier
+/// KEY_MOD1). Other modifiers are not handled. Returns whether it selected; the caller then
+/// captures the mouse and skips its own handling.
+bool ButtonDown(const vcl::Window& rWin, SwWrtShell& rSh, const Point& rDocPt, sal_uInt16 nClicks,
+                sal_uInt16 nModifier);
+
+/// Mouse move while a margin press of rWin is active: extends the selection over whole lines
+/// up to the line at rDocPt (only after a single click, and only inside the visible area).
+/// Returns whether the move belongs to a margin press.
+bool Drag(const vcl::Window& rWin, SwWrtShell& rSh, const Point& rDocPt, bool bInVisArea);
+
+/// Button release: ends a margin press of rWin. Returns whether there was one.
+bool ButtonUp(const vcl::Window& rWin);
+}
