+namespace hst::marginselect
+{
+namespace
+{
+/// The press that started in the selection margin. There is one mouse, and the window captures
+/// it from the press to the release, so one state is enough; it is tied to its window.
+struct MarginPress
+{
+    const vcl::Window* pWindow = nullptr;
+    Point aAnchor; ///< where the press was: its line stays selected while dragging
+    bool bLines = false; ///< single click: a drag extends by lines
+};
+
+MarginPress g_aPress;
+
+/// The visible page that contains rPt. Only the pages on screen are visited.
+const SwPageFrame* VisiblePageAt(const SwWrtShell& rSh, const Point& rPt)
+{
+    const SwViewShellImp* pImp = rSh.Imp();
+    if (!pImp)
+        return nullptr;
+    const tools::Long nVisBottom = rSh.VisArea().Bottom();
+    for (const SwFrame* pFrame = pImp->GetFirstVisPage(rSh.GetOut()); pFrame;
+         pFrame = pFrame->GetNext())
+    {
+        const SwRect& rArea = pFrame->getFrameArea();
+        if (rArea.Top() > rPt.Y() || rArea.Top() > nVisBottom)
+            break; // pages come row by row: the rest is further down
+        if (rArea.Contains(rPt))
+            return static_cast<const SwPageFrame*>(pFrame);
+    }
+    return nullptr;
+}
+
+/// The body text frame whose line lies beside rPt, when rPt is in the left margin of a page.
+const SwContentFrame* MarginLineFrame(SwWrtShell& rSh, const Point& rPt)
+{
+    if (comphelper::LibreOfficeKit::isActive() || rSh.GetViewOptions()->getBrowseMode())
+        return nullptr;
+
+    const SwPageFrame* pPage = VisiblePageAt(rSh, rPt);
+    if (!pPage || pPage->IsEmptyPage() || pPage->IsVertical() || pPage->IsRightToLeft())
+        return nullptr;
+    const SwLayoutFrame* pBody = pPage->FindBodyCont();
+    if (!pBody)
+        return nullptr;
+    const SwRect& rBody = pBody->getFrameArea();
+    // Left margin beside the body only: headers, footers and the space under the text keep
+    // their own handling.
+    if (rPt.X() >= rBody.Left() || rPt.Y() < rBody.Top() || rPt.Y() >= rBody.Bottom())
+        return nullptr;
+
+    // The leftmost content at this height (with columns, the first column).
+    const bool bColumns = pBody->Lower() && pBody->Lower()->IsColumnFrame();
+    const SwContentFrame* pLine = nullptr;
+    for (const SwContentFrame* pContent = pBody->ContainsContent();
+         pContent && pBody->IsAnLower(pContent); pContent = pContent->GetNextContentFrame())
+    {
+        const SwRect& rArea = pContent->getFrameArea();
+        if (rArea.Top() > rPt.Y() && !bColumns)
+            break;
+        if (rPt.Y() < rArea.Top() || rPt.Y() >= rArea.Bottom())
+            continue;
+        if (!pLine || rArea.Left() < pLine->getFrameArea().Left())
+            pLine = pContent;
+    }
+    if (!pLine || !pLine->IsTextFrame() || pLine->IsInTab() || pLine->IsInFootnote()
+        || pLine->IsRightToLeft() || pLine->IsVertical())
+        return nullptr;
+    // Text pulled into the margin (negative indent) is text, not margin.
+    if (rPt.X() >= pLine->getFrameArea().Left() + pLine->getFramePrintArea().Left())
+        return nullptr;
+    // A picture or shape over the margin keeps its own selection.
+    if (rSh.IsObjSelectable(rPt))
+        return nullptr;
+    return pLine;
+}
+
+/// Selects whole lines from the line beside rAnchor to the line beside rTo, in either direction.
+void SelectLines(SwWrtShell& rSh, const Point& rAnchor, const Point& rTo)
+{
+    {
+        SwMvContext aMvContext(&rSh);
+        rSh.ClearMark();
+        rSh.SwCursorShell::SetCursor(rAnchor, /*bOnlyText=*/true);
+        rSh.SwCursorShell::LeftMargin();
+        const SwPosition aAnchorStart(*rSh.GetCursor()->GetPoint());
+        rSh.SwCursorShell::SetCursor(rTo, /*bOnlyText=*/true);
+        rSh.SwCursorShell::LeftMargin();
+        const bool bUpwards = *rSh.GetCursor()->GetPoint() < aAnchorStart;
+
+        // The mark goes to the far end of the anchor line, the cursor to the far end of the
+        // line the mouse is at.
+        rSh.SwCursorShell::SetCursor(rAnchor, /*bOnlyText=*/true);
+        if (bUpwards)
+            rSh.SwCursorShell::RightMargin();
+        else
+            rSh.SwCursorShell::LeftMargin();
+        rSh.SttSelect();
+        rSh.SwCursorShell::SetCursor(rTo, /*bOnlyText=*/true);
+        if (bUpwards)
+            rSh.SwCursorShell::LeftMargin();
+        else
+            rSh.SwCursorShell::RightMargin();
+    }
+    rSh.EndSelect();
+}
+}
+
+bool IsOverMargin(SwWrtShell& rSh, const Point& rDocPt)
+{
+    return MarginLineFrame(rSh, rDocPt) != nullptr;
+}
+
+bool ButtonDown(const vcl::Window& rWin, SwWrtShell& rSh, const Point& rDocPt, sal_uInt16 nClicks,
+                sal_uInt16 nModifier)
+{
+    g_aPress = MarginPress();
+    if ((nModifier != 0 && nModifier != KEY_MOD1) || !MarginLineFrame(rSh, rDocPt))
+        return false;
+
+    // Leave a selected object, table selection or extended selection mode first.
+    rSh.EnterStdMode();
+    const bool bLines = nClicks <= 1 && nModifier == 0;
+    if (nModifier == KEY_MOD1 || nClicks >= 3)
+        rSh.SelAll();
+    else if (bLines)
+        SelectLines(rSh, rDocPt, rDocPt);
+    else
+    {
+        rSh.SwCursorShell::SetCursor(rDocPt, /*bOnlyText=*/true);
+        rSh.SelPara(&rDocPt);
+    }
+    g_aPress.pWindow = &rWin;
+    g_aPress.aAnchor = rDocPt;
+    g_aPress.bLines = bLines;
+    return true;
+}
+
+bool Drag(const vcl::Window& rWin, SwWrtShell& rSh, const Point& rDocPt, bool bInVisArea)
+{
+    if (g_aPress.pWindow != &rWin)
+        return false;
+    if (g_aPress.bLines && bInVisArea)
+        SelectLines(rSh, g_aPress.aAnchor, rDocPt);
+    return true;
+}
+
+bool ButtonUp(const vcl::Window& rWin)
+{
+    if (g_aPress.pWindow != &rWin)
+        return false;
+    g_aPress = MarginPress();
+    return true;
+}
+}
