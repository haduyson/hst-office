+CPPUNIT_TEST_FIXTURE(HstMarginLineSelectTest, testMarginClickThenCenterCentresInlinePicture)
+{
+    // "Text", then a paragraph with only an inline picture:
+    createSwDoc();
+    shell().Insert(u"Text"_ustr);
+    shell().SplitNode();
+    uno::Reference<lang::XMultiServiceFactory> xFactory(mxComponent, uno::UNO_QUERY_THROW);
+    uno::Reference<text::XTextDocument> xTextDocument(mxComponent, uno::UNO_QUERY_THROW);
+    uno::Reference<text::XText> xText = xTextDocument->getText();
+    Bitmap aBitmap(Size(16, 16), vcl::PixelFormat::N24_BPP);
+    aBitmap.Erase(COL_LIGHTBLUE);
+    uno::Reference<beans::XPropertySet> xPicture(
+        xFactory->createInstance(u"com.sun.star.text.TextGraphicObject"_ustr),
+        uno::UNO_QUERY_THROW);
+    xPicture->setPropertyValue(u"Graphic"_ustr, uno::Any(Graphic(aBitmap).GetXGraphic()));
+    xPicture->setPropertyValue(u"AnchorType"_ustr,
+                               uno::Any(text::TextContentAnchorType_AS_CHARACTER));
+    xPicture->setPropertyValue(u"Size"_ustr, uno::Any(awt::Size(3000, 3000)));
+    uno::Reference<text::XTextContent> xContent(xPicture, uno::UNO_QUERY_THROW);
+    xText->insertTextContent(xText->getEnd(), xContent, false);
+    calcLayout();
+
+    // Click beside the picture's line, then Center:
+    click(marginPoint(lineMiddle(1)));
+    CPPUNIT_ASSERT(shell().HasSelection());
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(0), startOffset());
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(1), endOffset()); // the picture's anchor character
+    dispatchCommand(mxComponent, u".uno:CenterPara"_ustr, {});
+
+    CPPUNIT_ASSERT_EQUAL(sal_Int16(style::ParagraphAdjust_CENTER),
+                         getProperty<sal_Int16>(getParagraph(2), u"ParaAdjust"_ustr));
+    CPPUNIT_ASSERT_EQUAL(sal_Int16(style::ParagraphAdjust_LEFT),
+                         getProperty<sal_Int16>(getParagraph(1), u"ParaAdjust"_ustr));
+}
