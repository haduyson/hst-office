+CPPUNIT_TEST_FIXTURE(HstMarginLineSelectTest, testDragSelectsWholeLines)
+{
+    createDocWithLongParagraph();
+    const tools::Long nFirst = lineMiddle(0);
+    shell().SttEndDoc(/*bStt=*/false);
+    const tools::Long nLast = shell().GetCharRect().Center().Y();
+    const SwNodeOffset nLastPara = shell().GetCursor()->GetPoint()->GetNodeIndex();
+
+    // Press beside the last line, drag up to the first one, release:
+    editWin().MouseButtonDown(mouseEvent(marginPoint(nLast), 1, MOUSE_LEFT));
+    editWin().MouseMove(mouseEvent(marginPoint(nFirst), 0, MOUSE_LEFT));
+    editWin().MouseButtonUp(mouseEvent(marginPoint(nFirst), 1, MOUSE_LEFT));
+    Scheduler::ProcessEventsToIdle();
+
+    // Everything from the start of the first line to the end of the last one:
+    CPPUNIT_ASSERT(shell().HasSelection());
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(0), startOffset());
+    CPPUNIT_ASSERT_EQUAL(nLastPara, endNode());
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(4), endOffset()); // "Last"
+    CPPUNIT_ASSERT(startNode() < endNode());
+}
