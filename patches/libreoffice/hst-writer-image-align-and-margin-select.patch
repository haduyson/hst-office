+    const tools::Long nY = lineMiddle(2);
+    shell().SwCursorShell::SetCursor(Point(bodyArea().Left() + 1, nY));
+    const sal_Int32 nLineStart = shell().GetCursor()->GetPoint()->GetContentIndex();
+    shell().RightMargin(/*bSelect=*/false, /*bBasicCall=*/false);
+    const sal_Int32 nLineEnd = shell().GetCursor()->GetPoint()->GetContentIndex();
+    const SwNodeOffset nPara = shell().GetCursor()->GetPoint()->GetNodeIndex();
+    CPPUNIT_ASSERT(nLineStart > 0);
+    CPPUNIT_ASSERT(nLineEnd > nLineStart);
+
+    click(marginPoint(nY));
+
+    CPPUNIT_ASSERT(shell().HasSelection());
+    CPPUNIT_ASSERT_EQUAL(nPara, startNode());
+    CPPUNIT_ASSERT_EQUAL(nPara, endNode());
+    CPPUNIT_ASSERT_EQUAL(nLineStart, startOffset());
+    CPPUNIT_ASSERT_EQUAL(nLineEnd, endOffset());
+}
