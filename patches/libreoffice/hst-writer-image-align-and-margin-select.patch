+/// Clicking in the left page margin selects the line beside it, as in common word processors.
+class HstMarginLineSelectTest : public SwModelTestBase
+{
+public:
+    HstMarginLineSelectTest()
+        : SwModelTestBase(u"/sw/qa/uibase/hst/"_ustr)
+    {
+    }
+
+protected:
+    SwWrtShell& shell() { return *getSwDocShell()->GetWrtShell(); }
+    vcl::Window& editWin() { return getSwDocShell()->GetView()->GetEditWin(); }
+
+    /// "First", a paragraph long enough for several lines, "Last".
+    void createDocWithLongParagraph()
+    {
+        createSwDoc();
+        SwWrtShell& rSh = shell();
+        rSh.Insert(u"First"_ustr);
+        rSh.SplitNode();
+        OUStringBuffer aLong;
+        for (int i = 0; i < 40; ++i)
+            aLong.append("Lorem ipsum dolor sit amet. ");
+        rSh.Insert(aLong.makeStringAndClear());
+        rSh.SplitNode();
+        rSh.Insert(u"Last"_ustr);
+        calcLayout();
+    }
+
+    const SwRect& bodyArea()
+    {
+        const SwPageFrame* pPage = static_cast<const SwPageFrame*>(shell().GetLayout()->Lower());
+        return pPage->FindBodyCont()->getFrameArea();
+    }
+
+    /// Halfway between the page edge and the body text, at height nY.
+    Point marginPoint(tools::Long nY)
+    {
+        const SwPageFrame* pPage = static_cast<const SwPageFrame*>(shell().GetLayout()->Lower());
+        return Point((pPage->getFrameArea().Left() + bodyArea().Left()) / 2, nY);
+    }
+
+    /// The middle height of the line the cursor is on after going nDown lines down from the start.
+    tools::Long lineMiddle(sal_uInt16 nDown)
+    {
+        shell().SttEndDoc(/*bStt=*/true);
+        if (nDown)
+            shell().Down(/*bSelect=*/false, nDown);
+        return shell().GetCharRect().Center().Y();
+    }
+
+    MouseEvent mouseEvent(const Point& rDocPt, sal_uInt16 nClicks, sal_uInt16 nButtons,
+                          sal_uInt16 nModifier = 0)
+    {
+        return MouseEvent(editWin().LogicToPixel(rDocPt), nClicks,
+                          nClicks ? MouseEventModifiers::SIMPLECLICK
+                                  : MouseEventModifiers::SIMPLEMOVE,
+                          nButtons, nModifier);
+    }
+
+    void click(const Point& rDocPt, sal_uInt16 nClicks = 1, sal_uInt16 nModifier = 0)
+    {
+        editWin().MouseButtonDown(mouseEvent(rDocPt, nClicks, MOUSE_LEFT, nModifier));
+        editWin().MouseButtonUp(mouseEvent(rDocPt, nClicks, MOUSE_LEFT, nModifier));
+        Scheduler::ProcessEventsToIdle();
+    }
+
+    /// The selection runs from the start of "First" to the end of "Last": the whole document.
+    void assertWholeDocumentSelected()
+    {
+        CPPUNIT_ASSERT(shell().HasSelection());
+        CPPUNIT_ASSERT_EQUAL(sal_Int32(0), startOffset());
+        CPPUNIT_ASSERT_EQUAL(u"First"_ustr,
+                             shell().GetCursor()->Start()->GetNode().GetTextNode()->GetText());
+        CPPUNIT_ASSERT_EQUAL(u"Last"_ustr,
+                             shell().GetCursor()->End()->GetNode().GetTextNode()->GetText());
+        CPPUNIT_ASSERT_EQUAL(sal_Int32(4), endOffset());
+    }
+
+    sal_Int32 startOffset() { return shell().GetCursor()->Start()->GetContentIndex(); }
+    sal_Int32 endOffset() { return shell().GetCursor()->End()->GetContentIndex(); }
+    SwNodeOffset startNode() { return shell().GetCursor()->Start()->GetNodeIndex(); }
+    SwNodeOffset endNode() { return shell().GetCursor()->End()->GetNodeIndex(); }
+};
