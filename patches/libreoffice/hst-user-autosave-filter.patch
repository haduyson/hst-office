+namespace hst::autosave
+{
+/** Declines every question of a store, as nobody is there to answer it: warnings are approved (the store goes on, as
+    the UI save does after showing them), everything else is aborted. A "changed by another program" question
+    (SfxMedium::CheckFileDate) is remembered: the store stops before it writes anything. */
+class SilentInteraction : public cppu::WeakImplHelper<task::XInteractionHandler>
+{
+public:
+    bool ChangedByOthers() const { return m_bChangedByOthers; }
+
+    void SAL_CALL handle(const uno::Reference<task::XInteractionRequest>& xRequest) override
+    {
+        const uno::Any aRequest = xRequest->getRequest();
+        uno::Reference<task::XInteractionAbort> xAbort;
+        uno::Reference<task::XInteractionApprove> xApprove;
+        for (const auto& rContinuation : xRequest->getContinuations())
+        {
+            if (!xAbort.is())
+                xAbort.set(rContinuation, uno::UNO_QUERY);
+            if (!xApprove.is())
+                xApprove.set(rContinuation, uno::UNO_QUERY);
+        }
+        task::ErrorCodeRequest aError;
+        if ((aRequest >>= aError) && ErrCode(aError.ErrCode).IsWarning() && xApprove.is())
+        {
+            xApprove->select();
+            return;
+        }
+        if (aRequest.isExtractableTo(cppu::UnoType<document::ChangedByOthersRequest>::get()))
+            m_bChangedByOthers = true;
+        if (xAbort.is())
+            xAbort->select();
+    }
+
+private:
+    bool m_bChangedByOthers = false;
+};
+
+namespace
+{
+DocState& docState(SfxObjectShell& rShell) { return rShell.HstAutoSaveState(); }
+
+bool isHiddenOrEmbedded(SfxObjectShell& rShell)
+{
+    if (rShell.GetCreateMode() != SfxObjectCreateMode::STANDARD)
+        return true;
+    const SfxMedium* pMedium = rShell.GetMedium();
+    const SfxBoolItem* pHidden = pMedium ? pMedium->GetItemSet().GetItem(SID_HIDDEN, false) : nullptr;
+    return pHidden && pHidden->GetValue();
+}
+
+bool macrosLost(SfxObjectShell& rShell, const std::shared_ptr<const SfxFilter>& pFilter, bool bRefresh)
+{
+    DocState& rState = docState(rShell);
+    if (pFilter->IsOwnFormat())
+        return false; // ODF keeps every macro
+    if (bRefresh || rState.nMacroLoss < 0)
+        rState.nMacroLoss
+            = FormatKeepsMacros(rShell.GetModel(), pFilter->GetFilterName(), pFilter->GetFilterFlags()) ? 0 : 1;
+    return rState.nMacroLoss == 1;
+}
+
+bool isSigned(SfxObjectShell& rShell, const std::shared_ptr<const SfxFilter>& pFilter)
+{
+    if (rShell.GetDocumentSignatureState() != SignatureState::NOSIGNATURES)
+        return true;
+    return pFilter->IsOwnFormat() && rShell.GetScriptingSignatureState() != SignatureState::NOSIGNATURES;
+}
+
+/// the toggle before the user's choice and the pause: whether the document may store itself at all
+State eligibility(SfxObjectShell& rShell, bool bRefresh)
+{
+    if (isHiddenOrEmbedded(rShell))
+        return State::Unsupported;
+    const SfxMedium* pMedium = rShell.GetMedium();
+    if (!pMedium || !rShell.HasName() || pMedium->GetName().isEmpty()
+        || pMedium->GetName().startsWithIgnoreAsciiCase("private:"))
+        return State::NotSaved;
+    if (INetURLObject(pMedium->GetName()).GetProtocol() != INetProtocol::File)
+        return State::Remote;
+    if (rShell.IsReadOnly() || rShell.IsReadOnlyMedium())
+        return State::ReadOnly;
+    const std::shared_ptr<const SfxFilter> pFilter = pMedium->GetFilter();
+    if (isLossyFilter(pFilter))
+        return State::Format;
+    if (isSigned(rShell, pFilter))
+        return State::Signed;
+    if (macrosLost(rShell, pFilter, bRefresh))
+        return State::Macro;
+    if (!officecfg::Office::Recovery::AutoSave::Enabled::get())
+        return officecfg::Office::Recovery::AutoSave::Enabled::isReadOnly() ? State::AdminOff : State::RecoveryOff;
+    if (officecfg::Office::Recovery::AutoSave::UserAutoSaveEnabled::isReadOnly())
+        return officecfg::Office::Recovery::AutoSave::UserAutoSaveEnabled::get() ? State::AdminOn
+                                                                                 : State::AdminOff;
+    return State::On;
+}
+}
+
+bool isLossyFilter(const std::shared_ptr<const SfxFilter>& pFilter)
+{
+    if (!pFilter || !pFilter->CanExport() || (pFilter->GetFilterFlags() & SfxFilterFlags::INTERNAL))
+        return true;
+    if (pFilter->IsOwnFormat() && !pFilter->IsAlienFormat())
+        return false; // ODF (and its templates)
+    // the default formats of HST Office (hst-msoffice-defaults.patch): Ctrl+S saves them without a question
+    const OUString& rName = pFilter->GetFilterName();
+    return rName != "MS Word 2007 XML" && rName != "Calc MS Excel 2007 XML"
+           && rName != "Impress MS PowerPoint 2007 XML";
+}
+
+State stateOf(SfxObjectShell& rShell, bool bRefresh)
+{
+    const State eBase = eligibility(rShell, bRefresh);
+    if (eBase != State::On && eBase != State::AdminOn)
+        return eBase;
+    DocState& rState = docState(rShell);
+    if (rState.ePause != State::On)
+        return rState.ePause;
+    if (eBase == State::AdminOn)
+        return eBase;
+    if (!rState.oOn)
+        rState.oOn = officecfg::Office::Recovery::AutoSave::UserAutoSaveEnabled::get();
+    return *rState.oOn ? State::On : State::Off;
+}
+
+bool isActive(State eState) { return eState == State::On || eState == State::AdminOn; }
+
+bool isSwitchable(State eState)
+{
+    return eState == State::On || eState == State::Off || eState == State::Paused
+           || eState == State::PausedConflict;
+}
+
+OUString valueOf(State eState)
+{
+    switch (eState)
+    {
+        case State::On:
+        case State::AdminOn:
+            return SfxResId(STR_HST_AUTOSAVE_ON);
+        case State::Paused:
+        case State::PausedConflict:
+            return SfxResId(STR_HST_AUTOSAVE_PAUSED);
+        default:
+            return SfxResId(STR_HST_AUTOSAVE_OFF);
+    }
+}
+
+OUString tooltipOf(State eState)
+{
+    TranslateId aId;
+    switch (eState)
+    {
+        case State::On: aId = STR_HST_AUTOSAVE_TIP_ON; break;
+        case State::Off: aId = STR_HST_AUTOSAVE_TIP_OFF; break;
+        case State::Paused: aId = STR_HST_AUTOSAVE_TIP_PAUSED; break;
+        case State::PausedConflict: aId = STR_HST_AUTOSAVE_TIP_CONFLICT; break;
+        case State::NotSaved: aId = STR_HST_AUTOSAVE_TIP_NOTSAVED; break;
+        case State::Remote: aId = STR_HST_AUTOSAVE_TIP_REMOTE; break;
+        case State::ReadOnly: aId = STR_HST_AUTOSAVE_TIP_READONLY; break;
+        case State::Format: aId = STR_HST_AUTOSAVE_TIP_FORMAT; break;
+        case State::Macro: aId = STR_HST_AUTOSAVE_TIP_MACRO; break;
+        case State::Signed: aId = STR_HST_AUTOSAVE_TIP_SIGNED; break;
+        case State::RecoveryOff: aId = STR_HST_AUTOSAVE_TIP_RECOVERYOFF; break;
+        case State::AdminOn:
+        case State::AdminOff: aId = STR_HST_AUTOSAVE_TIP_ADMIN; break;
+        case State::Unsupported: return OUString();
+    }
+    return SfxResId(aId);
+}
+
+void Invalidate(SfxObjectShell& rShell)
+{
+    for (SfxViewFrame* pFrame = SfxViewFrame::GetFirst(&rShell); pFrame;
+         pFrame = SfxViewFrame::GetNext(*pFrame, &rShell))
+        pFrame->GetBindings().Invalidate(SID_HST_AUTOSAVE);
+}
+
+void Exec(SfxObjectShell& rShell, SfxRequest& rReq)
+{
+    const State eState = stateOf(rShell, true);
+    if (!isSwitchable(eState))
+        return;
+    DocState& rState = docState(rShell);
+    const SfxBoolItem* pValue = rReq.GetArg<SfxBoolItem>(FN_PARAM_1); // "Enable": an explicit value
+    if (eState == State::Paused || eState == State::PausedConflict)
+    {
+        // a click on a paused toggle tries again at the next AutoSave; an explicit false turns it off instead
+        rState.ePause = State::On;
+        rState.oOn = pValue ? pValue->GetValue() : true;
+    }
+    else
+        rState.oOn = pValue ? pValue->GetValue() : eState != State::On;
+    Invalidate(rShell);
+    rReq.Done();
+}
+
+void GetState(SfxObjectShell& rShell, SfxItemSet& rSet, sal_uInt16 nWhich)
+{
+    const State eState = stateOf(rShell);
+    if (isSwitchable(eState))
+        rSet.Put(SfxBoolItem(nWhich, isActive(eState)));
+    else
+        rSet.DisableItem(nWhich);
+}
+
+void AddArgs(SfxObjectShell& rShell, const std::set<std::u16string_view>& rRequested,
+             comphelper::SequenceAsHashMap& rArgs)
+{
+    if (rRequested.count(u"HstUserAutoSave"))
+    {
+        bool bNow = false;
+        try
+        {
+            // an edit in progress (a Calc cell) or a modal dialog: skip this round, the next one stores
+            bNow = isActive(stateOf(rShell, true)) && !rShell.HstIsInputActive()
+                   && !Application::IsInModalMode();
+        }
+        catch (const uno::Exception&)
+        {
+            TOOLS_WARN_EXCEPTION("sfx.doc", "AutoSave state");
+        }
+        rArgs[u"HstUserAutoSave"_ustr] <<= bNow;
+    }
+    if (rRequested.count(u"HstUserAutoSaving"))
+        rArgs[u"HstUserAutoSaving"_ustr] <<= docState(rShell).bSaving;
+}
+
+StoreScope::StoreScope(SfxObjectShell& rShell, uno::Sequence<beans::PropertyValue>& rArgs)
+    : m_rShell(rShell)
+    , m_xHandler(new SilentInteraction)
+{
+    std::vector<beans::PropertyValue> aArgs;
+    for (const beans::PropertyValue& rArg : rArgs)
+        if (rArg.Name != "HstUserAutoSave" && rArg.Name != "InteractionHandler")
+            aArgs.push_back(rArg);
+    beans::PropertyValue aHandler;
+    aHandler.Name = "InteractionHandler";
+    aHandler.Value <<= uno::Reference<task::XInteractionHandler>(m_xHandler);
+    aArgs.push_back(aHandler);
+    rArgs = comphelper::containerToSequence(aArgs);
+
+    m_bAllowed = isActive(stateOf(rShell, true));
+    if (m_bAllowed)
+        docState(rShell).bSaving = true;
+    else
+        m_bDone = true; // nothing is stored, nothing pauses
+}
+
+StoreScope::~StoreScope()
+{
+    if (!m_bDone)
+        Done(false);
+}
+
+void StoreScope::Done(bool bStored)
+{
+    if (m_bDone)
+        return;
+    m_bDone = true;
+    DocState& rState = docState(m_rShell);
+    rState.bSaving = false;
+    if (!bStored)
+        rState.ePause = m_xHandler->ChangedByOthers() ? State::PausedConflict : State::Paused;
+    Invalidate(m_rShell);
+}
+
+void ManualSaveDone(SfxObjectShell& rShell)
+{
+    DocState& rState = docState(rShell);
+    if (rState.bSaving)
+        return;
+    rState.ePause = State::On;
+    rState.nMacroLoss = -1;
+    Invalidate(rShell);
+}
+}
+
+hst::autosave::DocState& SfxObjectShell::HstAutoSaveState()
+{
+    if (!pImpl->m_pHstAutoSave)
+        pImpl->m_pHstAutoSave = std::make_shared<hst::autosave::DocState>();
+    return *pImpl->m_pHstAutoSave;
+}
