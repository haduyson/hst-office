+
+class SfxItemSet;
+class SfxObjectShell;
+class SfxRequest;
+namespace comphelper
+{
+class SequenceAsHashMap;
+}
+
+/** HST Office: "Tự động lưu" (AutoSave into the document's own file, owner decision 21/11/2026).
+
+    The AutoRecovery timer (framework autorecovery.cxx, every 3 minutes, 10 for large files, after 10 s without
+    input) asks each document, through getArgs2({"HstUserAutoSave"}), whether it stores itself in place now; if so it
+    calls storeSelf({HstUserAutoSave=true}). The answer is per document and only for the open session: the AutoSave
+    toggle of the tab row (.uno:HstAutoSave) switches it, every opened document starts with
+    Recovery/AutoSave/UserAutoSaveEnabled (true in HST Office).
+
+    A document stores itself only when Ctrl+S would save it silently and without loss: a local, network or USB file
+    (file: URL), in ODF or in the default .docx/.xlsx/.pptx formats, not read only, without a digital signature and
+    without macros its format drops. The store never shows a dialog: a silent interaction handler declines every
+    question (the "file changed by another program" one included), so a conflict or a write error never overwrites
+    anything and pauses AutoSave for the document ("Tạm dừng") until the user saves or clicks the toggle. */
+namespace hst::autosave
+{
+/// what the toggle of one document shows
+enum class State : sal_uInt8
+{
+    On, ///< saves itself in place
+    Off, ///< the user turned it off for this document
+    Paused, ///< the last AutoSave could not write the file (drive removed, network lost, file locked)
+    PausedConflict, ///< another program changed the file since it was opened or saved
+    NotSaved, ///< no file yet ("Hãy lưu tệp trước")
+    Remote, ///< not a file: URL (WebDAV, CMIS...)
+    ReadOnly, ///< opened read only, or locked by someone else
+    Format, ///< a format that may lose data (.doc, .xls, .ppt, .rtf, .txt, .csv, .html...)
+    Macro, ///< macros that the format does not keep
+    Signed, ///< digitally signed: saving drops the signature
+    RecoveryOff, ///< AutoRecovery itself is off (Tools > Options > Load/Save > General)
+    AdminOn, ///< locked on by the administrator
+    AdminOff, ///< locked off by the administrator
+    Unsupported, ///< hidden or embedded documents: no toggle, never saved in place
+};
+
+/// per-document data, kept in SfxObjectShell_Impl for the session only
+struct DocState
+{
+    std::optional<bool> oOn; ///< the toggle; unset = UserAutoSaveEnabled when it is first needed
+    State ePause = State::On; ///< On, Paused or PausedConflict
+    bool bSaving = false; ///< inside an AutoSave store (HstUserAutoSaving)
+    sal_Int8 nMacroLoss = -1; ///< cached: 1 the format drops macros of the document, 0 not, -1 unknown
+};
+
+/// the toggle's state for rShell; bRefresh: check the macros again (the UI uses the cached answer)
+SAL_DLLPRIVATE State stateOf(SfxObjectShell& rShell, bool bRefresh = false);
+/// On or AdminOn: the document saves itself in place
+SAL_DLLPRIVATE bool isActive(State eState);
+/// the toggle can be switched (On, Off, Paused, PausedConflict)
+SAL_DLLPRIVATE bool isSwitchable(State eState);
+/// whether a store of rShell's filter could lose data: false for ODF and the default .docx, .xlsx, .pptx
+SAL_DLLPRIVATE bool isLossyFilter(const std::shared_ptr<const SfxFilter>& pFilter);
+
+/// tooltip text of the toggle: what it does now, and why it is dimmed
+SAL_DLLPRIVATE OUString tooltipOf(State eState);
+/// the word after the switch: "Bật", "Tắt" or "Tạm dừng"
+SAL_DLLPRIVATE OUString valueOf(State eState);
+
+/// the slot .uno:HstAutoSave (SfxObjectShell::ExecFile_Impl, GetState_Impl)
+SAL_DLLPRIVATE void Exec(SfxObjectShell& rShell, SfxRequest& rReq);
+SAL_DLLPRIVATE void GetState(SfxObjectShell& rShell, SfxItemSet& rSet, sal_uInt16 nWhich);
+/// the toggle of every view of rShell shows the new state
+SAL_DLLPRIVATE void Invalidate(SfxObjectShell& rShell);
+
+/// SfxBaseModel::getArgs2: HstUserAutoSave (store in place now) and HstUserAutoSaving (inside such a store), only
+/// when asked for by name, so getArgs() and every media descriptor built from it stay as they were
+SAL_DLLPRIVATE void AddArgs(SfxObjectShell& rShell, const std::set<std::u16string_view>& rRequested,
+                            comphelper::SequenceAsHashMap& rArgs);
+
+/** SfxBaseModel::storeSelf with HstUserAutoSave: checks the document again, replaces the argument by the silent
+    interaction handler and marks the store (HstUserAutoSaving, read by the "Phiên bản trước" job at OnSave). Its
+    destructor without Done() counts as a failed store. */
+class SilentInteraction;
+
+class SAL_DLLPRIVATE StoreScope
+{
+public:
+    /// rArgs: the storeSelf arguments; HstUserAutoSave is taken out, an InteractionHandler put in
+    StoreScope(SfxObjectShell& rShell, css::uno::Sequence<css::beans::PropertyValue>& rArgs);
+    ~StoreScope();
+    StoreScope(const StoreScope&) = delete;
+    StoreScope& operator=(const StoreScope&) = delete;
+
+    /// false: do not store (the document no longer qualifies); nothing is paused for it
+    bool Allowed() const { return m_bAllowed; }
+    /// the store ended; bStored false pauses AutoSave of the document
+    void Done(bool bStored);
+
+private:
+    SfxObjectShell& m_rShell;
+    rtl::Reference<SilentInteraction> m_xHandler;
+    bool m_bAllowed = false;
+    bool m_bDone = false;
+};
+
+/// a save by the user (Ctrl+S, Save As) succeeded: a paused AutoSave runs again
+SAL_DLLPRIVATE void ManualSaveDone(SfxObjectShell& rShell);
+
+/// guisaveas.cxx: the macro test of Save As (hst-macro-save-guard.patch): whether rFilter keeps the macros of xModel
+SAL_DLLPRIVATE bool FormatKeepsMacros(const css::uno::Reference<css::frame::XModel>& xModel,
+                                      std::u16string_view rFilter, SfxFilterFlags nFlags);
+}
