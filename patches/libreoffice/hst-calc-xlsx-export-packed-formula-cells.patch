+CPPUNIT_TEST_FIXTURE(ScExportTest6, testXlsxPackedFormulaCellsWriteTheSameSheet)
+{
+    // The .xlsx export keeps formula cells outside of a matrix as packed runs of their row. The sheet, the shared
+    // strings and the styles must be the same as with one record per formula cell (the environment variable
+    // selects that path).
+    createScDoc();
+    ScDocument* pDoc = getScDoc();
+    for (SCROW nRow = 0; nRow < 6; ++nRow)
+    {
+        pDoc->SetValue(ScAddress(0, nRow, 0), nRow + 1);
+        pDoc->SetString(ScAddress(1, nRow, 0), u"chữ "_ustr + OUString::number(nRow));
+        // a group of shared formulas, a text result, a boolean, an error, a volatile function
+        pDoc->SetString(ScAddress(2, nRow, 0), u"=A"_ustr + OUString::number(nRow + 1) + u"*2"_ustr);
+        pDoc->SetString(ScAddress(3, nRow, 0), u"=B"_ustr + OUString::number(nRow + 1) + u"&\"!\""_ustr);
+        pDoc->SetString(ScAddress(4, nRow, 0), u"=A"_ustr + OUString::number(nRow + 1) + u">3"_ustr);
+        pDoc->SetString(ScAddress(5, nRow, 0), u"=1/(A"_ustr + OUString::number(nRow + 1) + u"-3)"_ustr);
+        pDoc->SetString(ScAddress(6, nRow, 0), u"=NOW()*0+A"_ustr + OUString::number(nRow + 1));
+        pDoc->SetString(ScAddress(8, nRow, 0), u"=SUM($A$1:A"_ustr + OUString::number(nRow + 1) + u")"_ustr);
+    }
+    // formatted formula cells, a matrix formula, a formula in the base of a merged range, a hidden row
+    ScPatternAttr aBold(pDoc->getCellAttributeHelper());
+    aBold.ItemSetPut(SvxWeightItem(WEIGHT_BOLD, ATTR_FONT_WEIGHT));
+    pDoc->ApplyPatternAreaTab(2, 1, 3, 2, 0, aBold);
+    ScMarkData aMark(pDoc->GetSheetLimits());
+    aMark.SelectOneTable(0);
+    pDoc->InsertMatrixFormula(10, 0, 11, 1, aMark, u"=A1:B2"_ustr);
+    pDoc->SetString(ScAddress(2, 8, 0), u"=A1+1"_ustr);
+    pDoc->DoMerge(2, 8, 3, 9, 0);
+    pDoc->SetString(ScAddress(4, 8, 0), u"=C9*3"_ustr);
+    pDoc->SetRowHidden(5, 5, 0, true);
+    pDoc->SetString(ScAddress(7, 0, 0), u"=ABS(A1)"_ustr);
+    pDoc->CalcAll();
+
+    static constexpr std::array<OUString, 4> aParts{ u"xl/worksheets/sheet1.xml"_ustr,
+                                                     u"xl/sharedStrings.xml"_ustr, u"xl/styles.xml"_ustr,
+                                                     u"xl/workbook.xml"_ustr };
+    osl_setEnvironment(u"HST_SC_XLSX_PACKED_FORMULAS_OFF"_ustr.pData, u"1"_ustr.pData);
+    save(TestFilter::XLSX);
+    std::vector<OString> aOld;
+    for (const OUString& rPart : aParts)
+        aOld.push_back(dumpExportedPart(parseExport(rPart)));
+    osl_clearEnvironment(u"HST_SC_XLSX_PACKED_FORMULAS_OFF"_ustr.pData);
+
+    save(TestFilter::XLSX);
+    for (size_t i = 0; i < aParts.size(); ++i)
+        CPPUNIT_ASSERT_EQUAL_MESSAGE(aParts[i].toUtf8().getStr(), aOld[i],
+                                     dumpExportedPart(parseExport(aParts[i])));
+
+    // the packed runs are really written: every formula of row 1 with its formula, the volatile one with aca
+    xmlDocUniquePtr pSheet = parseExport(u"xl/worksheets/sheet1.xml"_ustr);
+    assertXPath(pSheet, "/x:worksheet/x:sheetData/x:row[1]/x:c[x:f]", 8);
+    assertXPath(pSheet, "/x:worksheet/x:sheetData/x:row[1]/x:c[@r='G1']/x:f", "aca", u"true");
+    assertXPath(pSheet, "/x:worksheet/x:sheetData/x:row[1]/x:c[@r='D1']", "t", u"str");
+    assertXPath(pSheet, "/x:worksheet/x:sheetData/x:row[1]/x:c[@r='E1']", "t", u"b");
+    assertXPath(pSheet, "/x:worksheet/x:sheetData/x:row[1]/x:c[@r='F1']/x:v", u"-0.5");
+    assertXPath(pSheet, "/x:worksheet/x:sheetData/x:row[3]/x:c[@r='F3']", "t", u"e");
+}
