+class ScFormulaCell;
+
+/** A run of formula cells of one row, side by side, as the .xlsx export keeps them until it writes the sheet.
+
+    The export created one XclExpFormulaCell record per formula cell (about 100 bytes on the heap with its slot in
+    the row, plus a compiled binary token array for a formula that is not shared) and held all of them until the
+    sheet was written: 3.4 million formula cells took about 400 MB at the peak of saving a 50 MB workbook, and a
+    200 MB workbook of formulas ran out of 8 GB while saving. For .xlsx, a finished formula cell outside of a matrix
+    needs only its Calc cell, its cell format identifier and the "aca" (volatile) flag: XclExpFormulaCell::SaveXml
+    writes nothing else, it reads the formula text and the cached result from the Calc cell when the sheet is
+    written. So the cells of a run are kept as 16 bytes each.
+
+    Each formula cell is still created as an XclExpFormulaCell first, so the cell formats, shared formulas, table
+    operations and the formula compiler see exactly the same calls in the same order; only the finished record is
+    replaced. SaveXml writes each cell with XclExpFormulaCell::HstSaveXmlPlain, the code XclExpFormulaCell::SaveXml
+    uses for such a cell. Not used for the binary formats, for cells of a matrix or for the base cell of a merged
+    range. The row's finalisation sees these runs as non-blank cells, as it saw the single formula cells.
+
+    The environment variable HST_SC_XLSX_PACKED_FORMULAS_OFF keeps one record per formula cell (used by a test to
+    compare both paths). */
+class HstXlsxPackedFormulas final : public XclExpCellBase
+{
+public:
+    /** True when the formula cells of an .xlsx export are packed into runs. */
+    static bool IsEnabled(const XclExpRoot& rRoot)
+    {
+        return rRoot.GetOutput() != EXC_OUTPUT_BINARY && !std::getenv("HST_SC_XLSX_PACKED_FORMULAS_OFF");
+    }
+
+    explicit HstXlsxPackedFormulas(const XclExpFormulaCell& rCell)
+        : XclExpCellBase(EXC_ID2_FORMULA, 0, rCell.GetXclPos())
+    {
+        maEntries.push_back({ &rCell.HstGetScCell(), rCell.GetFirstXFId(), rCell.HstIsVolatileXml() });
+    }
+
+    virtual sal_uInt16 GetLastXclCol() const override
+    {
+        return static_cast<sal_uInt16>(GetXclCol() + maEntries.size() - 1);
+    }
+    virtual sal_uInt32 GetFirstXFId() const override { return maEntries.front().mnXFId; }
+    virtual bool IsEmpty() const override { return false; }
+
+    /** Takes over a run that starts right after this one in the same row. */
+    virtual bool TryMerge(const XclExpCellBase& rCell) override
+    {
+        const HstXlsxPackedFormulas* pRun = dynamic_cast<const HstXlsxPackedFormulas*>(&rCell);
+        if (!pRun || pRun->GetXclRow() != GetXclRow() || pRun->GetXclCol() != GetLastXclCol() + 1)
+            return false;
+        maEntries.insert(maEntries.end(), pRun->maEntries.begin(), pRun->maEntries.end());
+        return true;
+    }
+
+    /** Nothing to convert: SaveXml looks the cell format index up from the identifier, as the single cells do. */
+    virtual void ConvertXFIndexes(const XclExpRoot&) override {}
+
+    virtual void Save(XclExpStream&) override
+    {
+        OSL_FAIL("HstXlsxPackedFormulas::Save - formula cells are packed for .xlsx only");
+    }
+
+    virtual void SaveXml(XclExpXmlStream& rStrm) override
+    {
+        XclAddress aPos(GetXclPos());
+        for (const Entry& rEntry : maEntries)
+        {
+            XclExpFormulaCell::HstSaveXmlPlain(rStrm, aPos, rEntry.mnXFId, *rEntry.mpCell, rEntry.mbVolatile);
+            ++aPos.mnCol;
+        }
+    }
+
+private:
+    struct Entry
+    {
+        ScFormulaCell* mpCell;
+        sal_uInt32 mnXFId;
+        bool mbVolatile;
+    };
+    std::vector<Entry> maEntries;
+};
