+CPPUNIT_TEST_FIXTURE(StatusBarCoatTest, testZoomSliderFromTokens)
+{
+    // SvxZoomSliderControl's layout of a 130 px item (min 20 %, 100 % in the middle, max 600 %;
+    // Zoom2Offset truncates): 50 % lies at 36 px, 100 % at 64 px, 200 % at 74 px
+    StatusBar& rBar = makeBar();
+    const design::Palette& rPalette = light();
+    constexpr tools::Long WIDTH = 130, HEIGHT = 20, MID = HEIGHT / 2;
+    // the buttons' images: 8 px squares of a marker colour
+    constexpr Color MARKER(0xFF, 0x00, 0xFF);
+    Bitmap aSquare(Size(8, 8), vcl::PixelFormat::N24_BPP);
+    aSquare.Erase(MARKER);
+    const Image aButton(aSquare);
+
+    for (auto [nThumb, bOnCentre] : { std::pair(36, false), std::pair(64, true), std::pair(74, false) })
+    {
+        ScopedVclPtrInstance<VirtualDevice> pDev;
+        pDev->SetOutputSizePixel(Size(WIDTH, HEIGHT));
+        pDev->SetBackground(Wallpaper(rPalette.aFrameSurface));
+        pDev->Erase();
+        hst::coat::ZoomSliderLayout aLayout{ tools::Rectangle(Point(), Size(WIDTH, HEIGHT)),
+                                             WIDTH, HEIGHT, 20, nThumb, 64, { 36, 64, 100 } };
+        hst::coat::DrawZoomSlider(*pDev, rBar, aLayout, aButton, aButton);
+        const VirtualDevice& aShot = *pDev;
+
+        // the thumb: an accent pill centred on the zoom
+        tools::Long nLeft = -1, nRight = -1;
+        for (tools::Long nX = 0; nX < WIDTH; ++nX)
+            if (pixel(aShot, nX, MID) == rPalette.aAccent)
+            {
+                if (nLeft < 0)
+                    nLeft = nX;
+                nRight = nX;
+            }
+        CPPUNIT_ASSERT_MESSAGE("no thumb", nLeft >= 0);
+        CPPUNIT_ASSERT_LESSEQUAL(tools::Long(1), std::abs((nLeft + nRight + 1) / 2 - nThumb));
+        CPPUNIT_ASSERT_EQUAL(tools::Long(6), nRight - nLeft + 1);
+
+        // the track: the divider's outline around the scroll-track groove, away from the thumb
+        const tools::Long nTrackX = nThumb < 90 ? 105 : 30;
+        CPPUNIT_ASSERT_EQUAL(rPalette.aFrameDivider, pixel(aShot, nTrackX, MID - 2));
+        CPPUNIT_ASSERT_EQUAL(rPalette.aScrollTrack, pixel(aShot, nTrackX, MID));
+
+        // the 100 % mark reaches further than a snapping point and is in the text colour
+        if (!bOnCentre)
+            CPPUNIT_ASSERT_EQUAL(rPalette.aText, pixel(aShot, 64, MID - 5));
+        CPPUNIT_ASSERT_EQUAL(rPalette.aFrameDivider, pixel(aShot, 100, MID - 3));
+        CPPUNIT_ASSERT_EQUAL(rPalette.aFrameSurface, pixel(aShot, 100, MID - 5));
+
+        // the buttons where the control takes their clicks: (20 - 8) / 2 = 6 px in from each side
+        CPPUNIT_ASSERT_EQUAL(MARKER, pixel(aShot, 6, 6));
+        CPPUNIT_ASSERT_EQUAL(MARKER, pixel(aShot, 13, 13));
+        CPPUNIT_ASSERT_EQUAL(MARKER, pixel(aShot, WIDTH - 14, 6));
+        CPPUNIT_ASSERT_EQUAL(rPalette.aFrameSurface, pixel(aShot, 5, 6));
+    }
+}
+
+CPPUNIT_TEST_FIXTURE(StatusBarCoatTest, testTypingRepaintsNoMoreItems)
+{
+    // the word count changing on every key: the coat repaints no more items than the platform look
+    // (only the invalidated ones: the changed item, not the zoom slider beside it)
+    auto countUpdates = [this](bool bCoat) {
+        if (!bCoat)
+            setenv("HST_UI_COAT", "0", 1);
+        hst::coat::ResetSwitchForTesting();
+        StatusBar& rBar = makeBar();
+        CPPUNIT_ASSERT_EQUAL(bCoat, hst::coat::StatusBarCoatActive(rBar));
+        DrawCounter aCounter(rBar);
+        for (int i = 1; i <= 1000; ++i)
+            rBar.SetItemText(ITEM_INFO, OUString::number(i) + u" từ");
+        Scheduler::ProcessEventsToIdle();
+        unsetenv("HST_UI_COAT");
+        return aCounter.Count();
+    };
+    const int nPlain = countUpdates(false);
+    const int nCoat = countUpdates(true);
+    const std::string sCounts
+        = "plain " + std::to_string(nPlain) + ", coat " + std::to_string(nCoat) + " item paints";
+    CPPUNIT_ASSERT_MESSAGE(sCounts, nCoat > 0);
+    CPPUNIT_ASSERT_MESSAGE(sCounts, nCoat <= nPlain);
+}
+}
+
+CPPUNIT_PLUGIN_IMPLEMENT();
