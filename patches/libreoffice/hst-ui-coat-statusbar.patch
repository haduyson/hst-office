+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * This file is part of HST Office.
+ */
+
+/* The status bar of a document window in the HST look (<vcl/hst/statusbarcoat.hxx>). Everything here
+   is flat fills and filled shapes, no gradient and no bitmap of its own, so a repaint of an item (the
+   word count while typing) costs no more than the platform's look. */
+
+#include <vcl/hst/statusbarcoat.hxx>
+
+#include <vcl/hst/designtokens.hxx>
+#include <vcl/hst/drawhelpers.hxx>
+#include <vcl/hst/framecoat.hxx>
+
+#include <vcl/image.hxx>
+#include <vcl/outdev.hxx>
+#include <vcl/settings.hxx>
+#include <vcl/window.hxx>
+
+#include <algorithm>
+#include <cmath>
+#include <iterator>
+
+namespace hst::coat
+{
+namespace
+{
+namespace design = hst::design;
+
+const design::Palette& paletteOf(const vcl::Window& rBar)
+{
+    return design::GetPalette(rBar.GetSettings().GetStyleSettings());
+}
+
+double scaleOf(const vcl::Window& rBar) { return std::max(1.0, double(rBar.GetDPIScaleFactor())); }
+
+/** A token length in whole device pixels, at least one. */
+tools::Long px(double fLogical, double fScale)
+{
+    return std::max<tools::Long>(1, std::lround(fLogical * fScale));
+}
+
+/** A crisp axis-parallel rectangle of whole pixels. */
+void fillRect(OutputDevice& rDev, const tools::Rectangle& rRect, const Color& rColor)
+{
+    if (rRect.IsEmpty())
+        return;
+    auto aPop = rDev.ScopedPush(vcl::PushFlags::LINECOLOR | vcl::PushFlags::FILLCOLOR);
+    rDev.SetLineColor();
+    rDev.SetFillColor(rColor);
+    rDev.DrawRect(rRect);
+}
+}
+
+bool StatusBarCoatActive(const vcl::Window& rBar)
+{
+    const vcl::Window* pParent = rBar.GetParent();
+    return pParent && pParent->GetType() == WindowType::WORKWINDOW
+           && FrameCoatActive(FrameComponent::StatusBar, rBar.GetSettings().GetStyleSettings());
+}
+
+bool IsStatusBarItemClickable(std::u16string_view aCommand)
+{
+    // What a single click does (the item's controller, then the view shell's Execute of its slot).
+    // Not here: .uno:Size (acts only with an object, table or frame selected), .uno:RowColSelCount and
+    // .uno:Context (no Execute), .uno:ViewLayout and .uno:ZoomSlider (buttons of their own inside).
+    static constexpr std::u16string_view CLICKABLE[] = {
+        // every application
+        u".uno:ModifiedStatus", // saves a modified document
+        u".uno:Signature", // the Digital Signatures dialog
+        u".uno:LanguageStatus", // the language menu
+        u".uno:Zoom", // the Zoom dialog
+        // Writer
+        u".uno:StatePageNumber", // Go to Page
+        u".uno:StateWordCount", // the Word Count dialog
+        u".uno:StateAccessibilityCheck", // the accessibility check deck
+        u".uno:PageStyleName", // the Page Style dialog
+        u".uno:InsertMode", // insert / overwrite
+        u".uno:SelectionMode", // the selection mode menu
+        // Sheets
+        u".uno:StatusDocPos", // the Navigator
+        u".uno:StatusPageStyle", // the Page Style dialog
+        u".uno:AutomaticCalculation", // AutoCalculate on / off
+        u".uno:StatusSelectionMode", // the selection mode menu
+        // Slides and Draw
+        u".uno:PageStatus", // Go to Page
+        u".uno:LayoutStatus", // the slide layouts
+        u".uno:ZoomPage", // fit the slide to the window
+    };
+    return std::find(std::begin(CLICKABLE), std::end(CLICKABLE), aCommand) != std::end(CLICKABLE);
+}
+
+Color StatusBarBackground(const vcl::Window& rBar) { return paletteOf(rBar).aFrameSurface; }
+
+Color StatusBarTextColor(const vcl::Window& rBar) { return paletteOf(rBar).aText; }
+
+void DrawStatusBarTopLine(OutputDevice& rDev, const vcl::Window& rBar, tools::Long nWidth)
+{
+    const tools::Long nThick = px(design::size::FrameDivider, scaleOf(rBar));
+    fillRect(rDev, tools::Rectangle(Point(0, 0), Size(nWidth, nThick)), paletteOf(rBar).aFrameDivider);
+}
+
+void DrawStatusBarDivider(OutputDevice& rDev, const vcl::Window& rBar, const Point& rTop,
+                          const Point& rBottom)
+{
+    const double fScale = scaleOf(rBar);
+    const tools::Long nInset = px(design::space::XXS, fScale);
+    const tools::Long nTop = rTop.Y() + nInset;
+    const tools::Long nBottom = rBottom.Y() - nInset;
+    if (nBottom < nTop)
+        return;
+    const tools::Long nThick = px(design::size::FrameDivider, fScale);
+    fillRect(rDev, tools::Rectangle(rTop.X(), nTop, rTop.X() + nThick - 1, nBottom),
+             paletteOf(rBar).aFrameDivider);
+}
+
+void DrawStatusBarHover(OutputDevice& rDev, const vcl::Window& rBar, const tools::Rectangle& rRect)
+{
+    design::DrawRoundRect(rDev, rRect, design::radius::Row * scaleOf(rBar), paletteOf(rBar).aHover,
+                          COL_TRANSPARENT, 0);
+}
+
+void DrawZoomSlider(OutputDevice& rDev, const vcl::Window& rBar, const ZoomSliderLayout& rLayout,
+                    const Image& rDecrease, const Image& rIncrease)
+{
+    const design::Palette& rPalette = paletteOf(rBar);
+    const double fScale = scaleOf(rBar);
+    const tools::Rectangle& rArea = rLayout.aArea;
+    const tools::Long nMid = rArea.Top() + rLayout.nHeight / 2;
+
+    // the track: a groove of the scroll-track colour, outlined with the frame divider so it reads
+    // against the frame surface (the track colour alone is too close to it)
+    const tools::Long nTrackHeight = px(4, fScale);
+    const tools::Long nTrackTop = nMid - nTrackHeight / 2;
+    const tools::Rectangle aTrack(rArea.Left() + rLayout.nEdge, nTrackTop,
+                                  rArea.Right() - rLayout.nEdge, nTrackTop + nTrackHeight - 1);
+    design::DrawRoundRect(rDev, aTrack, nTrackHeight / 2.0, rPalette.aScrollTrack,
+                          rPalette.aFrameDivider, design::stroke::Border * fScale);
+
+    // the snapping points: short marks across the groove; the 100 % mark longer and in the text
+    // colour, so the default zoom is easy to find
+    const tools::Long nMark = px(design::size::FrameDivider, fScale);
+    const tools::Long nSnapReach = px(design::space::XXS, fScale);
+    for (tools::Long nSnap : rLayout.aSnaps)
+    {
+        if (nSnap == rLayout.nCentre)
+            continue;
+        const tools::Long nX = rArea.Left() + nSnap - nMark / 2;
+        fillRect(rDev,
+                 tools::Rectangle(nX, aTrack.Top() - nSnapReach, nX + nMark - 1,
+                                  aTrack.Bottom() + nSnapReach),
+                 rPalette.aFrameDivider);
+    }
+    const tools::Long nCentreReach = px(design::space::XS, fScale);
+    const tools::Long nCentreX = rArea.Left() + rLayout.nCentre - nMark / 2;
+    fillRect(rDev,
+             tools::Rectangle(nCentreX, aTrack.Top() - nCentreReach, nCentreX + nMark - 1,
+                              aTrack.Bottom() + nCentreReach),
+             rPalette.aText);
+
+    // the thumb: an upright accent pill on the current zoom, narrow so that at the ends of the track
+    // it stays clear of the buttons' click zones
+    const tools::Long nThumbWidth = px(6, fScale);
+    const tools::Long nThumbHeight = px(14, fScale);
+    const tools::Long nThumbLeft = rArea.Left() + rLayout.nThumb - nThumbWidth / 2;
+    const tools::Long nThumbTop = nMid - nThumbHeight / 2;
+    design::DrawRoundRect(
+        rDev, tools::Rectangle(Point(nThumbLeft, nThumbTop), Size(nThumbWidth, nThumbHeight)),
+        nThumbWidth / 2.0, rPalette.aAccent, COL_TRANSPARENT, 0);
+
+    // the decrease and increase buttons: the icon theme's images where the control has always drawn
+    // them (and takes their clicks); an HST glyph for them comes with the icon set
+    const Size aDecrease = rDecrease.GetSizePixel();
+    const tools::Long nButtonTop = rArea.Top() + (rLayout.nHeight - aDecrease.Height()) / 2;
+    rDev.DrawImage(Point(rArea.Left() + (rLayout.nEdge - aDecrease.Width()) / 2, nButtonTop),
+                   rDecrease);
+    const Size aIncrease = rIncrease.GetSizePixel();
+    rDev.DrawImage(Point(rArea.Left() + rLayout.nWidth - aIncrease.Width()
+                             - (rLayout.nEdge - aIncrease.Height()) / 2,
+                         nButtonTop),
+                   rIncrease);
+}
+}
