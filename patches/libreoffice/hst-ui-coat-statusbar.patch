+constexpr Color DARK_WINDOW(0x20, 0x20, 0x20);
+constexpr tools::Long BAR_WIDTH = 400;
+
+// the items of the test bar: a selection count (a click does nothing), the zoom percentage and the
+// language (both clickable); each STATUSBAR_OFFSET (5 px) apart, the first at x 5
+constexpr sal_uInt16 ITEM_INFO = 1;
+constexpr sal_uInt16 ITEM_ZOOM = 2;
+constexpr sal_uInt16 ITEM_LANGUAGE = 3;
+
+/** Counts the items a status bar draws (VclEventId::StatusbarDrawItem): one per item repainted. */
+class DrawCounter
+{
+public:
+    explicit DrawCounter(vcl::Window& rBar)
+        : mrBar(rBar)
+    {
+        rBar.AddEventListener(LINK(this, DrawCounter, Listener));
+    }
+    ~DrawCounter() { mrBar.RemoveEventListener(LINK(this, DrawCounter, Listener)); }
+    int Count() const { return mnCount; }
+
+private:
+    DECL_LINK(Listener, VclWindowEvent&, void);
+    vcl::Window& mrBar;
+    int mnCount = 0;
+};
+
+IMPL_LINK(DrawCounter, Listener, VclWindowEvent&, rEvent, void)
+{
+    if (rEvent.GetId() == VclEventId::StatusbarDrawItem)
+        ++mnCount;
+}
