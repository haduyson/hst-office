+/* The status bar of a document window in the HST look (the StatusBar frame part of
+   <vcl/hst/framecoat.hxx>): the frame surface, text in the token colour, thin dividers instead of
+   3D separators, a hover behind the items that open something when clicked, and a zoom slider drawn
+   from the tokens. Only colours and shapes change: the bar keeps its font (which sizes the bar and
+   its items), so its height, the items' widths and their click areas stay exactly as without the
+   coat. */
+namespace hst::coat
+{
+/** Whether rBar (a StatusBar) is drawn in the HST look: the bar of a document window (its parent is
+    the frame's work window, so the bars of dialogs keep the platform's look), the StatusBar part
+    switched on and not in high contrast. */
+VCL_DLLPUBLIC bool StatusBarCoatActive(const vcl::Window& rBar);
+
+/** Whether a status bar item with this command does something on a single click (opens a dialog, a
+    menu or a deck, toggles a mode, saves), in Writer, Sheets or Slides, so it shows a hover. An item
+    whose text is empty (and that draws nothing of its own) shows none: the bar checks that. */
+VCL_DLLPUBLIC bool IsStatusBarItemClickable(std::u16string_view aCommand);
+
+/** The background and text colour of the bar in the HST look, for rBar's theme. */
+VCL_DLLPUBLIC Color StatusBarBackground(const vcl::Window& rBar);
+VCL_DLLPUBLIC Color StatusBarTextColor(const vcl::Window& rBar);
+
+/* The shapes below are drawn on rDev (the bar itself, or the off-screen device its items are drawn
+   on; pixel map mode) in the colours of rBar's theme and at rBar's DPI scale. */
+
+/** The line along the bar's top edge, nWidth pixels long, between the document and the bar. */
+VCL_DLLPUBLIC void DrawStatusBarTopLine(OutputDevice& rDev, const vcl::Window& rBar,
+                                        tools::Long nWidth);
+
+/** The divider between two items: a thin vertical line from rTop to rBottom (the 3D separator's
+    place), inset at both ends. */
+VCL_DLLPUBLIC void DrawStatusBarDivider(OutputDevice& rDev, const vcl::Window& rBar,
+                                        const Point& rTop, const Point& rBottom);
+
+/** The hover of a clickable item, a rounded row filling rRect. */
+VCL_DLLPUBLIC void DrawStatusBarHover(OutputDevice& rDev, const vcl::Window& rBar,
+                                      const tools::Rectangle& rRect);
+
+/** Where the parts of the zoom slider lie, as SvxZoomSliderControl lays them out: offsets are pixels
+    from aArea's left edge. */
+struct ZoomSliderLayout
+{
+    tools::Rectangle aArea; ///< the item's drawing area
+    tools::Long nWidth = 0; ///< the item's width, from which the offsets and the right button are laid out
+    tools::Long nHeight = 0; ///< the item's height, the parts are centred in it
+    tools::Long nEdge = 0; ///< the track starts and ends this far from the area's sides
+    tools::Long nThumb = 0; ///< the thumb's centre: the current zoom
+    tools::Long nCentre = 0; ///< the 100 % mark (the slider's centre zoom)
+    std::vector<tools::Long> aSnaps; ///< the snapping points
+};
+
+/** The zoom slider's track, its marks (the 100 % mark stronger than the snapping points) and its
+    thumb, as vector shapes from the tokens; then the decrease and increase buttons centred in the
+    track's end zones, where the control takes their clicks. The buttons are the icon theme's images
+    (their look follows the icon set). */
+VCL_DLLPUBLIC void DrawZoomSlider(OutputDevice& rDev, const vcl::Window& rBar,
+                                  const ZoomSliderLayout& rLayout, const Image& rDecrease,
+                                  const Image& rIncrease);
+}
