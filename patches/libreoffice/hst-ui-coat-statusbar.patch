+/* The status bar of a document window (a StatusBar whose parent is a work window) in the HST look,
+   painted on the headless backend and probed pixel by pixel. */
+class StatusBarCoatTest : public test::BootstrapFixture
+{
+public:
+    StatusBarCoatTest()
+        : test::BootstrapFixture(true, false)
+    {
+    }
+
+    void setUp() override
+    {
+        test::BootstrapFixture::setUp();
+        unsetenv("HST_UI_COAT");
+        setSwitches(true, true);
+    }
+
+    void tearDown() override
+    {
+        for (auto& xDevice : maDevices)
+            xDevice.disposeAndClear();
+        maDevices.clear();
+        // children before their parents
+        for (auto it = maWindows.rbegin(); it != maWindows.rend(); ++it)
+            it->disposeAndClear();
+        maWindows.clear();
+        unsetenv("HST_UI_COAT"); // a test that set it may have stopped at a failed assertion
+        setSwitches(true, true);
+        test::BootstrapFixture::tearDown();
+    }
+
+protected:
+    static void setSwitches(bool bCoat, bool bStatusBar)
+    {
+        auto xChanges = comphelper::ConfigurationChanges::create();
+        officecfg::Office::HSTAppearance::UiCoat::Enabled::set(bCoat, xChanges);
+        officecfg::Office::HSTAppearance::FrameCoat::StatusBar::set(bStatusBar, xChanges);
+        xChanges->commit();
+        hst::coat::ResetSwitchForTesting();
+        hst::coat::ResetFrameCoatForTesting();
+    }
+
+    static void setTheme(vcl::Window& rWindow, bool bDark, bool bHighContrast)
+    {
+        AllSettings aSettings = rWindow.GetSettings();
+        StyleSettings aStyle = aSettings.GetStyleSettings();
+        if (bDark)
+            aStyle.SetWindowColor(DARK_WINDOW);
+        aStyle.SetHighContrastMode(bHighContrast);
+        aSettings.SetStyleSettings(aStyle);
+        rWindow.SetSettings(aSettings);
+    }
+
+    /** A shown status bar with three items, under a work window (a document window's frame) or, with
+        bDocument false, under a plain child window (a dialog's bar). */
+    StatusBar& makeBar(bool bDocument = true, bool bDark = false, bool bHighContrast = false)
+    {
+        VclPtr<WorkWindow> xFrame = VclPtr<WorkWindow>::Create(nullptr, WB_STDWORK);
+        xFrame->SetSizePixel(Size(BAR_WIDTH + 40, 200));
+        maWindows.emplace_back(xFrame.get());
+        vcl::Window* pParent = xFrame.get();
+        if (!bDocument)
+        {
+            VclPtr<vcl::Window> xChild = VclPtr<vcl::Window>::Create(xFrame.get());
+            xChild->SetPosSizePixel(Point(), Size(BAR_WIDTH + 20, 150));
+            xChild->Show();
+            maWindows.emplace_back(xChild.get());
+            pParent = xChild.get();
+        }
+        VclPtr<StatusBar> xBar = VclPtr<StatusBar>::Create(pParent, WB_LEFT | WB_3DLOOK);
+        maWindows.emplace_back(xBar.get());
+        setTheme(*xBar, bDark, bHighContrast);
+        xBar->InsertItem(ITEM_INFO, 80, StatusBarItemBits::Left | StatusBarItemBits::In);
+        xBar->SetItemCommand(ITEM_INFO, u".uno:RowColSelCount"_ustr);
+        xBar->InsertItem(ITEM_ZOOM, 60);
+        xBar->SetItemCommand(ITEM_ZOOM, u".uno:Zoom"_ustr);
+        xBar->InsertItem(ITEM_LANGUAGE, 80);
+        xBar->SetItemCommand(ITEM_LANGUAGE, u".uno:LanguageStatus"_ustr);
+        xBar->SetPosSizePixel(Point(), Size(BAR_WIDTH, xBar->CalcWindowSizePixel().Height()));
+        xFrame->Show();
+        xBar->Show();
+        xBar->SetItemText(ITEM_INFO, u"3 hàng, 2 cột"_ustr);
+        xBar->SetItemText(ITEM_ZOOM, u"100%"_ustr);
+        xBar->SetItemText(ITEM_LANGUAGE, u"Tiếng Việt"_ustr);
+        Scheduler::ProcessEventsToIdle();
+        shot(*xBar); // a first paint lays the items out (GetItemRect, GetItemId need it)
+        return *xBar;
+    }
+
+    /** The bar painted on a device of its own size. */
+    const VirtualDevice& shot(StatusBar& rBar)
+    {
+        VclPtr<VirtualDevice> xDev = VclPtr<VirtualDevice>::Create();
+        xDev->SetOutputSizePixel(rBar.GetOutputSizePixel());
+        rBar.PaintToDevice(*xDev, Point());
+        maDevices.push_back(xDev);
+        return *xDev;
+    }
+
+    static Color pixel(const VirtualDevice& rShot, tools::Long nX, tools::Long nY)
+    {
+        return rShot.GetPixel(Point(nX, nY));
+    }
+
+    static void hover(StatusBar& rBar, const Point& rPos, bool bLeave = false)
+    {
+        rBar.MouseMove(
+            MouseEvent(rPos, 0, bLeave ? MouseEventModifiers::LEAVEWINDOW : MouseEventModifiers::NONE));
+    }
+
+    static const design::Palette& light() { return design::GetPalette(false); }
+
+    std::vector<VclPtr<vcl::Window>> maWindows;
+    std::vector<VclPtr<VirtualDevice>> maDevices;
+};
+
+CPPUNIT_TEST_FIXTURE(StatusBarCoatTest, testDocumentBarTakesTheFrameColours)
+{
+    for (bool bDark : { false, true })
+    {
+        StatusBar& rBar = makeBar(true, bDark);
+        const design::Palette& rPalette = design::GetPalette(bDark);
+        CPPUNIT_ASSERT(hst::coat::StatusBarCoatActive(rBar));
+        CPPUNIT_ASSERT_EQUAL(rPalette.aText, rBar.GetTextColor());
+
+        const VirtualDevice& aShot = shot(rBar);
+        const tools::Long nMid = rBar.GetOutputSizePixel().Height() / 2;
+        // the surface beside and inside the items, the divider along the top edge
+        CPPUNIT_ASSERT_EQUAL(rPalette.aFrameSurface, pixel(aShot, BAR_WIDTH - 20, nMid));
+        CPPUNIT_ASSERT_EQUAL(rPalette.aFrameSurface, pixel(aShot, 7, nMid));
+        CPPUNIT_ASSERT_EQUAL(rPalette.aFrameDivider, pixel(aShot, BAR_WIDTH - 20, 0));
+        CPPUNIT_ASSERT_EQUAL(rPalette.aFrameSurface, pixel(aShot, BAR_WIDTH - 20, 1));
+    }
+}
+
+CPPUNIT_TEST_FIXTURE(StatusBarCoatTest, testDividersAreThinLinesNot3D)
+{
+    StatusBar& rBar = makeBar();
+    const VirtualDevice& aShot = shot(rBar);
+    const tools::Long nMid = rBar.GetOutputSizePixel().Height() / 2;
+    // the divider before the zoom item: 4 px left of the item, one pixel wide, no light line beside
+    const tools::Long nX = rBar.GetItemRect(ITEM_ZOOM).Left() - 1 - 4;
+    CPPUNIT_ASSERT_EQUAL(light().aFrameDivider, pixel(aShot, nX, nMid));
+    CPPUNIT_ASSERT_EQUAL(light().aFrameSurface, pixel(aShot, nX - 1, nMid));
+    CPPUNIT_ASSERT_EQUAL(light().aFrameSurface, pixel(aShot, nX + 1, nMid));
+    // inset from the item's top
+    CPPUNIT_ASSERT_EQUAL(light().aFrameSurface, pixel(aShot, nX, 3));
+}
+
+CPPUNIT_TEST_FIXTURE(StatusBarCoatTest, testHoverOnClickableItemsOnly)
+{
+    StatusBar& rBar = makeBar();
+    const tools::Rectangle aZoom = rBar.GetItemRect(ITEM_ZOOM);
+    const tools::Rectangle aInfo = rBar.GetItemRect(ITEM_INFO);
+    const tools::Rectangle aLanguage = rBar.GetItemRect(ITEM_LANGUAGE);
+    const tools::Long nMid = rBar.GetOutputSizePixel().Height() / 2;
+    // left of the centred texts, right of the left-aligned one: no glyph there
+    const Point aInZoom(aZoom.Left() + 3, nMid);
+    const Point aInInfo(aInfo.Right() - 3, nMid);
+    const Point aInLanguage(aLanguage.Left() + 3, nMid);
+
+    hover(rBar, aZoom.Center());
+    const VirtualDevice* pShot = &shot(rBar);
+    CPPUNIT_ASSERT_EQUAL(light().aHover, pixel(*pShot, aInZoom.X(), aInZoom.Y()));
+    // rounded: the hover's corner pixel is not filled
+    CPPUNIT_ASSERT(light().aHover != pixel(*pShot, aZoom.Left() + 1, aZoom.Top() + 1));
+
+    // a click on the selection count does nothing: no hover, and the zoom item's is gone
+    hover(rBar, aInfo.Center());
+    pShot = &shot(rBar);
+    CPPUNIT_ASSERT_EQUAL(light().aFrameSurface, pixel(*pShot, aInInfo.X(), aInInfo.Y()));
+    CPPUNIT_ASSERT_EQUAL(light().aFrameSurface, pixel(*pShot, aInZoom.X(), aInZoom.Y()));
+
+    hover(rBar, aZoom.Center());
+    hover(rBar, aZoom.Center(), true); // the mouse leaves the bar
+    pShot = &shot(rBar);
+    CPPUNIT_ASSERT_EQUAL(light().aFrameSurface, pixel(*pShot, aInZoom.X(), aInZoom.Y()));
+
+    // a blank clickable item that keeps its tip still acts (Writer's insert mode): the hover
+    rBar.SetItemText(ITEM_LANGUAGE, OUString());
+    rBar.SetQuickHelpText(ITEM_LANGUAGE, u"Chế độ chèn. Bấm để đổi sang chế độ ghi đè."_ustr);
+    hover(rBar, aLanguage.Center());
+    pShot = &shot(rBar);
+    CPPUNIT_ASSERT_EQUAL(light().aHover, pixel(*pShot, aInLanguage.X(), aInLanguage.Y()));
+    hover(rBar, aLanguage.Center(), true);
+    // blank and no tip: its slot is off (Sheets' insert mode outside cell editing), a click does nothing
+    rBar.SetQuickHelpText(ITEM_LANGUAGE, OUString());
+    hover(rBar, aLanguage.Center());
+    pShot = &shot(rBar);
+    CPPUNIT_ASSERT_EQUAL(light().aFrameSurface, pixel(*pShot, aInLanguage.X(), aInLanguage.Y()));
+}
+
+CPPUNIT_TEST_FIXTURE(StatusBarCoatTest, testEveryItemThatActsOnAClickIsClickable)
+{
+    // Writer, Sheets and Slides alike: the items a single click acts on
+    for (std::u16string_view aCommand :
+         { u".uno:ModifiedStatus", u".uno:Signature", u".uno:LanguageStatus", u".uno:Zoom",
+           u".uno:StatePageNumber", u".uno:StateWordCount", u".uno:StateAccessibilityCheck",
+           u".uno:PageStyleName", u".uno:InsertMode", u".uno:SelectionMode", u".uno:StatusDocPos",
+           u".uno:StatusPageStyle", u".uno:StatusSelectionMode",
+           u".uno:PageStatus", u".uno:LayoutStatus", u".uno:ZoomPage" })
+        CPPUNIT_ASSERT_MESSAGE(OUString(aCommand).toUtf8().getStr(),
+                               hst::coat::IsStatusBarItemClickable(aCommand));
+    // a click does nothing (or only with a selection), or the item has buttons of its own
+    for (std::u16string_view aCommand : { u".uno:Size", u".uno:RowColSelCount", u".uno:Context",
+                                          u".uno:ViewLayout", u".uno:ZoomSlider",
+                                          u".uno:AutomaticCalculation", u"" })
+        CPPUNIT_ASSERT_MESSAGE(OUString(aCommand).toUtf8().getStr(),
+                               !hst::coat::IsStatusBarItemClickable(aCommand));
+}
+
+CPPUNIT_TEST_FIXTURE(StatusBarCoatTest, testHeightAndClickAreasUnchanged)
+{
+    StatusBar& rCoat = makeBar();
