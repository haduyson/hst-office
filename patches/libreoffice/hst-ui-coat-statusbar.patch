+#pragma once
+
+#include <tools/color.hxx>
+#include <tools/gen.hxx>
+#include <tools/long.hxx>
+#include <vcl/dllapi.h>
+
+#include <string_view>
+#include <vector>
+
+class Image;
+class OutputDevice;
+namespace vcl
+{
+class Window;
+}
