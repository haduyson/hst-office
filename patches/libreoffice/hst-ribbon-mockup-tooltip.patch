+namespace
+{
+// HST Office: where a ribbon tip goes (the reference design: under the ribbon, not next to the pointer over the
+// group captions). A tip of the ribbon hangs RIBBON_TIP_GAP px under the ribbon's bottom edge with its left edge
+// at the button's, at least RIBBON_TIP_INSET px inside the document window; a tip of the tab row (tabs, search box,
+// chevron) hangs under the tab row; a tip in a popup that shows part of the ribbon (the compact ribbon's dropped
+// page, an unfolded group) hangs under that popup. Lengths are at 100 % and follow the display scale.
+constexpr tools::Long RIBBON_TIP_GAP = 2;
+constexpr tools::Long RIBBON_TIP_INSET = 4;
+// widest tip: wider titles keep their width, descriptions wrap
+constexpr tools::Long RIBBON_TIP_MAX_WIDTH = 300;
+
+struct RibbonTipPlace
+{
+    AbsoluteScreenPixelPoint maTopLeft; // where the tip's top left corner goes
+    AbsoluteScreenPixelRectangle maBounds; // the document window
+};
+
+tools::Long Scaled(const vcl::Window& rWindow, tools::Long nPixels)
+{
+    return std::lround(nPixels * rWindow.GetDPIScaleFactor());
+}
+
+AbsoluteScreenPixelRectangle AbsoluteRect(const vcl::Window& rWindow)
+{
+    const Size aSize(rWindow.GetOutputSizePixel());
+    return AbsoluteScreenPixelRectangle(rWindow.OutputToAbsoluteScreenPixel(Point()),
+                                        AbsoluteScreenPixelSize(aSize.Width(), aSize.Height()));
+}
+
+/// The place of the tip of an item of the ribbon; rArea is the item in the coordinates of pParent's frame (as
+/// Help::ShowQuickHelp has it). False when pParent is not in a notebookbar or the layout is right to left: the tip
+/// then goes where VCL puts any tip.
+bool ImplRibbonTipPlace(vcl::Window* pParent, const tools::Rectangle& rArea, RibbonTipPlace& rPlace)
+{
+    if (!pParent || rArea.IsEmpty() || AllSettings::GetLayoutRTL())
+        return false;
+    std::optional<tools::Long> oEdge; // the bottom edge the tip hangs from, absolute
+    bool bInPage = false;
+    for (vcl::Window* pWin = pParent; pWin; pWin = pWin->GetParent())
+    {
+        if (pWin->GetType() == WindowType::TABPAGE)
+            bInPage = true;
+        if (NotebookBar* pBar = dynamic_cast<NotebookBar*>(pWin))
+        {
+            if (!oEdge)
+                oEdge = AbsoluteRect(*pBar).Bottom() + 1;
+            vcl::Window* pDocument = pBar->ImplGetFrameWindow();
+            rPlace.maBounds = AbsoluteRect(pDocument ? *pDocument : *pBar);
+            const vcl::Window* pFrame = pParent->ImplGetFrameWindow();
+            rPlace.maTopLeft = AbsoluteScreenPixelPoint(pFrame->OutputToAbsoluteScreenPixel(rArea.TopLeft()).X(),
+                                                        *oEdge + Scaled(*pParent, RIBBON_TIP_GAP));
+            return true;
+        }
+        if (oEdge)
+            continue;
+        if (pWin->IsSystemWindow()) // a popup showing part of the ribbon: its outer edge
+        {
+            vcl::Window* pFrame = pWin->ImplGetFrameWindow();
+            oEdge = AbsoluteRect(pFrame ? *pFrame : *pWin).Bottom() + 1;
+        }
+        else if (TabControl* pTabs = !bInPage ? dynamic_cast<TabControl*>(pWin) : nullptr)
+        {
+            // an item of the tab row: under the row, i.e. at the top of the shown page (none in the compact
+            // ribbon, whose tab row items then hang under the quick command row like the rest)
+            const TabPage* pPage = pTabs->GetTabPage(pTabs->GetCurPageId());
+            if (pPage && pPage->IsReallyVisible())
+                oEdge = pPage->OutputToAbsoluteScreenPixel(Point()).Y();
+        }
+    }
+    return false;
+}
+
+/// A button of the ribbon with a plain tip (a menu button "Wrap Text ▾" whose tip is "label\ndescription", a
+/// folded group's button): it gets the ribbon's tip too, the first line in bold.
+bool ImplIsRibbonButton(vcl::Window* pParent, const tools::Rectangle& rArea, QuickHelpFlags nStyle)
+{
+    if (nStyle & (QuickHelpFlags::RichTitle | QuickHelpFlags::NoAutoPos | QuickHelpFlags::TipStyleBalloon))
+        return false;
+    const WindowType eType = pParent ? pParent->GetType() : WindowType::NONE;
+    RibbonTipPlace aPlace;
+    return (eType == WindowType::MENUBUTTON || eType == WindowType::PUSHBUTTON)
+           && ImplRibbonTipPlace(pParent, rArea, aPlace);
+}
+}
