HST Office: the ribbon tooltips of the reference design (1.0.2) and the toolbar strings.

- STR_HST_RIBBON_PIN: "Pin the Toolbar (Ctrl+F1)", the pin button of the compact ribbon's dropped page
  (hst-ribbon-mockup-compact.patch), with its Vietnamese translation. User-facing Vietnamese text says
  "thanh công cụ", never "ribbon"; the vi text of the other ribbon strings is set in l10n/vi-overrides.jsonl.

License: these upstream files remain under their original license (MPL-2.0).
---
--- a/include/sfx2/strings.hrc
+++ b/include/sfx2/strings.hrc
@@ -301,6 +301,8 @@
 #define STR_NEW_FROM_TEMPLATE                   NC_("STR_NEW_FROM_TEMPLATE", "New From Template")
 #define STR_REPAIREDDOCUMENT                    NC_("STR_REPAIREDDOCUMENT", " (repaired document)")
 #define STR_NONCHECKEDOUT_DOCUMENT              NC_("STR_NONCHECKEDOUT_DOCUMENT", "This document is not checked out on the server.")
+// HST Office: the pin button of the compact ribbon's dropped page: keep the full ribbon shown
+#define STR_HST_RIBBON_PIN                      NC_("STR_HST_RIBBON_PIN", "Pin the Toolbar (Ctrl+F1)")
 #define STR_GET_INVOLVED_TEXT                   NC_("STR_GET_INVOLVED_TEXT", "Help us make %PRODUCTNAME even better!")
 #define STR_GET_INVOLVED_BUTTON                 NC_("STR_GET_INVOLVED_BUTTON", "Get involved")
 #define STR_DONATE_TEXT                         NC_("STR_DONATE_TEXT", "Support the development of %PRODUCTNAME.")
--- a/translations/source/vi/sfx2/messages.po
+++ b/translations/source/vi/sfx2/messages.po
@@ -1572,6 +1572,12 @@
 msgid "This document is not checked out on the server."
 msgstr "Tài liệu này chưa được kiểm xuất trên máy chủ."
 
+#. hstRibbonPin
+#: include/sfx2/strings.hrc
+msgctxt "STR_HST_RIBBON_PIN"
+msgid "Pin the Toolbar (Ctrl+F1)"
+msgstr "Ghim thanh công cụ (Ctrl+F1)"
