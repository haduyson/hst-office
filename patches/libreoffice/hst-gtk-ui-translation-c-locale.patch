+#pragma once
+
+#include <rtl/string.hxx>
+#include <rtl/ustring.hxx>
+
+#include <string_view>
+
+namespace vcl::hst
+{
+/** Whether GtkBuilder can translate .ui texts in this process.
+
+    GtkBuilder translates through gettext, which uses LANGUAGE (set to the office's UI language) only when the
+    LC_MESSAGES locale is not C: glibc ignores LANGUAGE in the C/POSIX locales, C.UTF-8 included. An office
+    started in such a locale with a Vietnamese UI showed the code's strings in Vietnamese but every .ui text in
+    English. */
+bool GettextIgnoresUILanguage(std::string_view aMessagesLocale);
+
+/** The .ui file's translatable texts (translatable="yes", with their context) translated with LibreOffice's own
+    catalogs for the UI language, as VclBuilder does, and their translatable flags removed, so GtkBuilder takes them
+    as they are. The interface's domain names the catalog. Empty when no translation is needed (gettext works, or
+    the UI is English) or the file cannot be read. */
+OString TranslateUiFileForGtkBuilder(const OUString& rSystemPath);
+}
