+void PDFIProcessor::paintTransparencyGroup(double fAlpha)
+{
+    // e.g. a watermark exported as a form XObject painted with /ca 0.1: without this, its text
+    // came in opaque
+    GroupElement* pGroup = std::exchange(m_pEndedGroup, nullptr);
+    if (pGroup && !pGroup->isForSoftMask && fAlpha >= 0.0 && fAlpha < 1.0)
+        applyGroupAlpha(*pGroup, fAlpha);
+}
+
+void PDFIProcessor::applyGroupAlpha(Element& rElement, double fAlpha)
+{
+    for (const auto& rChild : rElement.Children)
+    {
+        if (auto pGraphical = dynamic_cast<GraphicalElement*>(rChild.get()))
+        {
+            GraphicsContext aGC = getGraphicsContext(pGraphical->GCId);
+            aGC.FillColor.Alpha *= fAlpha;
+            aGC.LineColor.Alpha *= fAlpha;
+            pGraphical->GCId = getGCId(aGC);
+        }
+        applyGroupAlpha(*rChild, fAlpha);
+    }
 }
 
