--- a/framework/source/helper/titlebarupdate.cxx
+++ b/framework/source/helper/titlebarupdate.cxx
@@ -25,6 +25,7 @@
 #include <com/sun/star/awt/XWindow.hpp>
 #include <com/sun/star/lang/IllegalArgumentException.hpp>
 #include <com/sun/star/frame/ModuleManager.hpp>
+#include <com/sun/star/lang/XServiceInfo.hpp>
 #include <com/sun/star/beans/XPropertySet.hpp>
 #include <com/sun/star/frame/XTitle.hpp>
 #include <com/sun/star/frame/XTitleChangeBroadcaster.hpp>
@@ -145,9 +146,16 @@
             SolarMutexGuard aGuard;
             bOfficeWindow = DocumentTabGroup::isEnabled() && DocumentTabGroup::get().isOfficeWindow(xFrame);
         }
-        OUString aModuleId = bOfficeWindow ? OUString() : xModuleManager->identify(xFrame);
+        // HST PDF is no module of its own (the module manager cannot identify its viewer): its
+        // windows group under HST PDF (HASONTECH.HSTOffice.Pdf, vn.hasontech.hstoffice-pdf)
+        css::uno::Reference< css::lang::XServiceInfo > xViewer( xFrame->getController(), css::uno::UNO_QUERY );
+        const bool bPdfViewer = !bOfficeWindow && xViewer.is()
+                                && xViewer->supportsService( u"org.hasontech.hstoffice.PdfViewer"_ustr );
+        OUString aModuleId = bOfficeWindow || bPdfViewer ? OUString() : xModuleManager->identify(xFrame);
         if ( bOfficeWindow )
             sDesktopName = "Startcenter";
+        else if ( bPdfViewer )
+            sDesktopName = "Pdf";
         else if ( aModuleId.startsWith("com.sun.star.text.") || aModuleId.startsWith("com.sun.star.xforms.") )
             sDesktopName = "Writer";
         else if ( aModuleId.startsWith("com.sun.star.sheet.") )
