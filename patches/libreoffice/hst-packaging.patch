HST Office packaging: installer product definition.

The EPM/MSI installer looks up the product by PRODUCTNAME without spaces
("HSTOffice"), which upstream's openoffice.lst.in does not define, so
`make` failed with "Product HSTOffice not defined". Adds an HSTOffice
section (copy of the LibreOffice one) without the TDF update URL and with
HSTOffice_* download names.

It also overrides the package/install-root names that the Globals section
sets to LibreOffice values (libobasis*, libreoffice*-ure, /opt/libreoffice26.8),
so the HST .deb set installs under /opt/hst-office<MAJOR>.<MINOR> with hst-officebasis<MAJOR>.<MINOR>-*
and hst-office<MAJOR>.<MINOR>-* package names and cannot conflict with an official
LibreOffice install. Profile dir stays product-specific
(from instsetoo_native/CustomTarget_setup.mk).

The version is the HST Office release version (/VERSION), not the engine version:
@HST_VERSION_MAJOR/MINOR/MICRO@ are filled by scripts/build-linux.sh after config.status
(configure does not know them). Package version is MAJOR.MINOR.MICRO.

License: modified upstream file keeps its license (MPL-2.0).
---
--- a/instsetoo_native/util/openoffice.lst.in
+++ b/instsetoo_native/util/openoffice.lst.in
@@ -73,6 +73,48 @@
     }
 }
 
+# The HST_VERSION placeholders are filled from /VERSION by scripts/build-linux.sh (not by configure).
+HSTOffice
+{
+    Settings
+    {
+        variables
+        {
+            WINDOWSBASISROOTNAME HSTOffice
+            UNIXBASISROOTNAME hst-office@HST_VERSION_MAJOR@.@HST_VERSION_MINOR@
+            BASISPACKAGEPREFIX hst-officebasis
+            UREPACKAGEPREFIX hst-office
+            SOLSUREPACKAGEPREFIX hst-office
+            PRODUCTNAME @PRODUCTNAME@
+            PRODUCTVERSION @HST_VERSION_MAJOR@.@HST_VERSION_MINOR@
+            PRODUCTEXTENSION .@HST_VERSION_MICRO@
+            POSTVERSIONEXTENSION
+            BUNDLEIDENTIFIER @MACOSX_BUNDLE_IDENTIFIER@
+            BRANDPACKAGEVERSION @HST_VERSION_MAJOR@.@HST_VERSION_MINOR@
+            USERDIRPRODUCTVERSION 4
+            BASEPRODUCTVERSION @HST_VERSION_MAJOR@.@HST_VERSION_MINOR@
+            ADD_INCLUDE_FILES cli_ure/version/version.txt,unoil/climaker/version.txt
+            ADDSYSTEMINTEGRATION 1
+            PACKAGEVERSION @HST_VERSION_MAJOR@.@HST_VERSION_MINOR@.@HST_VERSION_MICRO@
+            UREPACKAGEVERSION @HST_VERSION_MAJOR@.@HST_VERSION_MINOR@.@HST_VERSION_MICRO@
+            PACKAGEREVISION {buildid}
+            LICENSENAME @LICENSE@
+            ROOTMODULEGID gid_Module_Root
+            GLOBALPATCHFILEGID gid_File_Txt_Patchfiles
+            SPELLCHECKERFILE spellchecker_selection.txt
+            CHANGETARGETDIR 1
+            PATCHCODEFILE ooo_patchcodes.txt
+        }
+        active          1
+        compression     5
+        script          setup_osl
+        downloadname    HSTOffice_{productversion}_{os}_install_{languages}
+        langpackdownloadname    HSTOffice_{productversion}_languagepack_{os}_install_{languages}
+        helppackdownloadname    HSTOffice_{productversion}_helppack_{os}_install_{languages}
+        include         {installscriptdir},{customtargetpath}/readlicense_oo/readme,{customtargetpath}/sysui/{pkgtype},{customtargetpath}/setup_native,{filelistpath}/PackageSet,{filelistpath}/GeneratedPackage,{filelistpath}/Package,{filelistpath}/ExtensionPackage,{filelistpath}/CustomTarget/helpcontent2/help3xsl/filelists,{extensionsdir},{licensepath},{packinfopath}
+    }
+}
+
 LibreOfficeDev
