+constexpr TranslateId STR_HST_WRAP_CLEARS_UNDO
+    = NC_("hsttabledlg|wrapundo", "Changing the text wrapping of a table cannot be undone, and it clears the undo history of this document. Continue?");
+
+// HST: Word's Text Wrapping. Around puts the table in a splitting frame, the same model as a floating
+// table from DOCX, which exports as w:tblpPr. Moving a table between the text and a frame is not
+// undoable in this core: MakeFlyAndMove and the unfloat button both clear the undo stack.
+static void lcl_HstApplyTableWrap(SwWrtShell& rSh, sal_uInt16 nWrap)
+{
+    constexpr tools::Long HST_FLOAT_DISTANCE = 187; // twips, 0.13 inch: Word's default for a floating table
+    const SwFrame* pFrame = rSh.GetCurrFrame();
+    SwFlyFrame* pFly = pFrame ? const_cast<SwFlyFrame*>(pFrame->FindFlyFrame()) : nullptr;
+    const bool bFloating = pFly && pFly->IsFlySplitAllowed();
+    // The move cannot be undone and takes the document's undo history with it: ask first, if there is any.
+    if (bFloating == (nWrap == 0) && rSh.GetDoc()->GetIDocumentUndoRedo().GetUndoActionCount() > 0)
+    {
+        std::unique_ptr<weld::MessageDialog> xQuery(Application::CreateMessageDialog(
+            rSh.GetView().GetFrameWeld(), VclMessageType::Question, VclButtonsType::YesNo,
+            SwResId(STR_HST_WRAP_CLEARS_UNDO)));
+        if (xQuery->run() != RET_YES)
+            return;
+    }
+    if (nWrap == 0)
+    {
+        if (bFloating)
+            HstUnfloatTableFrame(*pFly, rSh);
+        return;
+    }
+    if (!bFloating)
+    {
+        rSh.GetView().GetViewFrame().GetDispatcher()->Execute(FN_TABLE_SELECT_ALL, SfxCallMode::SYNCHRON);
+        SwTabCols aCols;
+        rSh.GetTabCols(aCols);
+        SwFlyFrameAttrMgr aMgr(true, &rSh, Frmmgr_Type::TEXT, nullptr);
+        aMgr.SetAnchor(RndStdIds::FLY_AT_PARA);
+        aMgr.SetSize(Size(aCols.GetRight() - aCols.GetLeft(), MINLAY));
+        aMgr.SetHeightSizeType(SwFrameSize::Variable);
+        aMgr.SetLRSpace(HST_FLOAT_DISTANCE, HST_FLOAT_DISTANCE);
+        aMgr.SetAttrSet(SfxItemSet(aMgr.GetAttrSet()));
+        SfxItemSet aFly(aMgr.GetAttrSet());
+        aFly.Put(SwFormatSurround(css::text::WrapTextMode_PARALLEL));
+        aFly.Put(SwFormatFlySplit(true));
+        aFly.Put(SvxBoxItem(RES_BOX));
+        rSh.NewFlyFrame(aFly);
+    }
+    if (nWrap == 2)
+    {
+        if (!rSh.IsFrameSelected())
+            if (const SwFrameFormat* pFlyFormat = rSh.GetFlyFrameFormat())
+                rSh.GotoFly(pFlyFormat->GetName());
+        rSh.GetView().GetViewFrame().GetDispatcher()->Execute(FN_FORMAT_FRAME_DLG, SfxCallMode::ASYNCHRON);
+    }
+    else if (rSh.IsFrameSelected())
+    {
+        rSh.UnSelectFrame();
+        rSh.LeaveSelFrameMode();
+    }
+}
