+    , m_xMarginsFrame(m_xBuilder->weld_widget(u"hstcellmarginsframe"_ustr))
+    , m_xTopMF(m_xBuilder->weld_metric_spin_button(u"hstcelltop"_ustr, FieldUnit::CM))
+    , m_xBottomMF(m_xBuilder->weld_metric_spin_button(u"hstcellbottom"_ustr, FieldUnit::CM))
+    , m_xLeftMF(m_xBuilder->weld_metric_spin_button(u"hstcellleft"_ustr, FieldUnit::CM))
+    , m_xRightMF(m_xBuilder->weld_metric_spin_button(u"hstcellright"_ustr, FieldUnit::CM))
+{
+    for (weld::MetricSpinButton* pField :
+         { m_xWidthMF.get(), m_xTopMF.get(), m_xBottomMF.get(), m_xLeftMF.get(), m_xRightMF.get() })
+        HstTableSetUnit(*pField);
+    m_xWidthMF->set_min(MINLAY, FieldUnit::TWIP);
+}
+
+std::unique_ptr<SfxTabPage> SwHstTableCellPage::Create(weld::Container* pPage,
+                                                       weld::DialogController* pController,
+                                                       const SfxItemSet* pSet)
+{
+    return std::make_unique<SwHstTableCellPage>(pPage, pController, *pSet);
+}
+
+void SwHstTableCellPage::Reset(const SfxItemSet* pSet)
+{
+    const SfxUInt32Item* pWidth = pSet->GetItemIfSet(FN_HST_CELL_WIDTH, false);
+    m_xSizeFrame->set_visible(pWidth != nullptr);
+    if (pWidth)
+        HstTableSetTwips(*m_xWidthMF, pWidth->GetValue());
+    const SvxBoxItem* pBox = pSet->GetItemIfSet(FN_HST_CELL_MARGINS, false);
+    m_xMarginsFrame->set_visible(pBox != nullptr);
+    if (pBox)
+    {
+        HstTableSetTwips(*m_xTopMF, pBox->GetDistance(SvxBoxItemLine::TOP));
+        HstTableSetTwips(*m_xBottomMF, pBox->GetDistance(SvxBoxItemLine::BOTTOM));
+        HstTableSetTwips(*m_xLeftMF, pBox->GetDistance(SvxBoxItemLine::LEFT));
+        HstTableSetTwips(*m_xRightMF, pBox->GetDistance(SvxBoxItemLine::RIGHT));
+    }
+    if (const SfxUInt16Item* pAlign = pSet->GetItemIfSet(FN_TABLE_SET_VERT_ALIGN, false))
+    {
+        const sal_uInt16 nAlign = pAlign->GetValue();
+        m_xVertOrientLB->set_active(
+            nAlign == text::VertOrientation::CENTER ? 1 : nAlign == text::VertOrientation::BOTTOM ? 2 : 0);
+    }
+    m_xVertOrientLB->save_value();
+}
+
+bool SwHstTableCellPage::FillItemSet(SfxItemSet* pSet)
+{
+    bool bModified = false;
+    if (m_xWidthMF->get_value_changed_from_saved())
+        bModified |= nullptr != pSet->Put(SfxUInt32Item(FN_HST_CELL_WIDTH, HstTableTwips(*m_xWidthMF)));
+    if (m_xTopMF->get_value_changed_from_saved() || m_xBottomMF->get_value_changed_from_saved()
+        || m_xLeftMF->get_value_changed_from_saved() || m_xRightMF->get_value_changed_from_saved())
+    {
+        SvxBoxItem aBox(FN_HST_CELL_MARGINS);
+        aBox.SetDistance(HstTableTwips(*m_xTopMF), SvxBoxItemLine::TOP);
+        aBox.SetDistance(HstTableTwips(*m_xBottomMF), SvxBoxItemLine::BOTTOM);
+        aBox.SetDistance(HstTableTwips(*m_xLeftMF), SvxBoxItemLine::LEFT);
+        aBox.SetDistance(HstTableTwips(*m_xRightMF), SvxBoxItemLine::RIGHT);
+        bModified |= nullptr != pSet->Put(aBox);
+    }
+    if (m_xVertOrientLB->get_value_changed_from_saved())
+    {
+        const int nPos = m_xVertOrientLB->get_active();
+        const sal_uInt16 nOrient = nPos == 1   ? text::VertOrientation::CENTER
+                                   : nPos == 2 ? text::VertOrientation::BOTTOM
+                                               : text::VertOrientation::NONE;
+        bModified |= nullptr != pSet->Put(SfxUInt16Item(FN_TABLE_SET_VERT_ALIGN, nOrient));
+    }
+    return bModified;
+}
