+/// HST: <table:title> and <table:desc> of a text table, the table's Alt Text.
+class SwXMLTableAltContext_Impl : public SvXMLImportContext
+{
+    SwTableNode* m_pTableNode;
+    OUString m_sKey;
+    OUStringBuffer m_aText;
+
+public:
+    SwXMLTableAltContext_Impl(SvXMLImport& rImport, SwTableNode* pTableNode, OUString sKey)
+        : SvXMLImportContext(rImport), m_pTableNode(pTableNode), m_sKey(std::move(sKey)) {}
+    virtual void SAL_CALL characters(const OUString& rChars) override { m_aText.append(rChars); }
+    virtual void SAL_CALL endFastElement(sal_Int32) override
+    {
+        if (!m_pTableNode || m_aText.isEmpty())
+            return;
+        SwFrameFormat* pFormat = m_pTableNode->GetTable().GetFrameFormat();
+        std::map<OUString, css::uno::Any> aBag = pFormat->GetAttrSet().Get(RES_FRMATR_GRABBAG).GetGrabBag();
+        aBag[m_sKey] <<= m_aText.makeStringAndClear();
+        pFormat->SetFormatAttr(SfxGrabBagItem(RES_FRMATR_GRABBAG, std::move(aBag)));
+    }
+};
