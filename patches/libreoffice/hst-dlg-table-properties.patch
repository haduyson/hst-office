+{
+OUString lcl_Value(const std::map<OUString, css::uno::Any>& rBag, const OUString& rKey)
+{
+    OUString sValue;
+    auto it = rBag.find(rKey);
+    if (it != rBag.end())
+        it->second >>= sValue;
+    return sValue;
+}
+
+void lcl_Store(std::map<OUString, css::uno::Any>& rBag, const OUString& rKey, const OUString& rValue)
+{
+    if (rValue.isEmpty())
+        rBag.erase(rKey);
+    else
+        rBag[rKey] <<= rValue;
+}
+}
+
+SwHstTableAltPage::SwHstTableAltPage(weld::Container* pPage, weld::DialogController* pController,
+                                     const SfxItemSet& rSet)
+    : SfxTabPage(pPage, pController, u"modules/swriter/ui/hsttablealtpage.ui"_ustr,
+                 u"HstTableAltPage"_ustr, &rSet)
+    , m_xTitleED(m_xBuilder->weld_entry(u"hstalttitle"_ustr))
+    , m_xDescTV(m_xBuilder->weld_text_view(u"hstaltdesc"_ustr))
+{
+    m_xDescTV->set_size_request(-1, m_xDescTV->get_height_rows(8));
+}
+
+std::unique_ptr<SfxTabPage> SwHstTableAltPage::Create(weld::Container* pPage,
+                                                      weld::DialogController* pController,
+                                                      const SfxItemSet* pSet)
+{
+    return std::make_unique<SwHstTableAltPage>(pPage, pController, *pSet);
+}
+
+void SwHstTableAltPage::Reset(const SfxItemSet* pSet)
+{
+    if (const SfxGrabBagItem* pBag = pSet->GetItemIfSet(RES_FRMATR_GRABBAG, false))
+    {
+        m_xTitleED->set_text(lcl_Value(pBag->GetGrabBag(), u"tblCaption"_ustr));
+        m_xDescTV->set_text(lcl_Value(pBag->GetGrabBag(), u"tblDescription"_ustr));
+    }
+    m_xTitleED->save_value();
+    m_xDescTV->save_value();
+}
+
+bool SwHstTableAltPage::FillItemSet(SfxItemSet* pSet)
+{
+    if (!m_xTitleED->get_value_changed_from_saved() && !m_xDescTV->get_value_changed_from_saved())
+        return false;
+    std::map<OUString, css::uno::Any> aBag;
+    if (const SfxGrabBagItem* pBag = GetItemSet().GetItemIfSet(RES_FRMATR_GRABBAG, false))
+        aBag = pBag->GetGrabBag();
+    lcl_Store(aBag, u"tblCaption"_ustr, m_xTitleED->get_text());
+    lcl_Store(aBag, u"tblDescription"_ustr, m_xDescTV->get_text());
+    pSet->Put(SfxGrabBagItem(RES_FRMATR_GRABBAG, std::move(aBag)));
+    return true;
+}
