+    if (pModeItem && pModeItem->GetValue() & HTMLMODE_ON)
+        m_xSplitRowCB->hide();
+    HstTableSetUnit(*m_xHeightMF);
+    m_xHeightMF->set_min(MINLAY, FieldUnit::TWIP);
+    m_xHeightCB->connect_toggled(LINK(this, SwHstTableRowPage, HeightToggledHdl));
+    m_xHeadLineCB->connect_toggled(LINK(this, SwHstTableRowPage, HeadLineToggledHdl));
+}
