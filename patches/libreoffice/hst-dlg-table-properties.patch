+// Previous Row and Next Row change nothing yet: as in the rest of the dialog, Cancel must leave the
+// document alone, and OK reaches the document through ItemSetToTableParam.
+void SwHstTableRowPage::InitRows()
+{
+    SwWrtShell* pShell = ::GetActiveWrtShell();
+    const bool bOneRow = pShell && pShell->IsCursorInTable() && !pShell->IsTableMode()
+                         && GetItemSet().GetItemState(FN_HST_ROW_HEIGHT, false) == SfxItemState::SET;
+    m_xPrevBtn->set_visible(bOneRow);
+    m_xNextBtn->set_visible(bOneRow);
+    m_xRowLabel->set_visible(bOneRow);
+    if (!bOneRow)
+        return;
+    const SwTable* pTable = SwTable::FindTable(pShell->GetTableFormat());
+    const SwTableBox* pBox = pShell->GetCursor()->GetPointNode().GetTableBox();
+    while (pBox && pBox->GetUpper()->GetUpper())
+        pBox = pBox->GetUpper()->GetUpper();
+    const SwTableLine* pCurrent = pBox ? pBox->GetUpper() : nullptr;
+    const SwTableLines& rLines = pTable->GetTabLines();
+    for (size_t i = 0; i < rLines.size(); ++i)
+    {
+        const SwTableLine* pLine = rLines[i];
+        const SwFormatFrameSize& rSize = pLine->GetFrameFormat()->GetFrameSize();
+        m_aRows.push_back({ pLine->GetTabBoxes()[0]->GetName(), rSize.GetHeightSizeType(),
+                            rSize.GetHeight(), pLine->GetFrameFormat()->GetRowSplit().GetValue() });
+        if (pLine == pCurrent)
+            m_nRow = i;
+    }
+    ShowRow();
+}
+
+void SwHstTableRowPage::ShowRow()
+{
+    if (m_nRow < 0)
+        return;
+    const RowState& rRow = m_aRows[m_nRow];
+    m_xRowLabel->set_label(m_sRowLabel.replaceFirst("%1", OUString::number(m_nRow + 1)));
+    const bool bFixed = rRow.eType == SwFrameSize::Fixed;
+    m_xHeightCB->set_active(bFixed || rRow.nHeight > MINLAY);
+    m_xRuleLB->set_active(bFixed ? 1 : 0);
+    if (rRow.nHeight >= MINLAY)
+        HstTableSetTwips(*m_xHeightMF, rRow.nHeight);
+    m_xSplitRowCB->set_active(rRow.bSplit);
+    HeightToggledHdl(*m_xHeightCB);
+    m_xPrevBtn->set_sensitive(m_nRow > 0);
+    m_xNextBtn->set_sensitive(m_nRow + 1 < static_cast<int>(m_aRows.size()));
+}
+
+void SwHstTableRowPage::StoreRow()
+{
+    RowState& rRow = m_aRows[m_nRow];
+    const SwFrameSize eType = !m_xHeightCB->get_active() ? SwFrameSize::Variable
+                              : m_xRuleLB->get_active() == 1 ? SwFrameSize::Fixed : SwFrameSize::Minimum;
+    const tools::Long nHeight = m_xHeightCB->get_active() ? HstTableTwips(*m_xHeightMF) : 0;
+    const bool bSameHeight = !m_xHeightCB->get_active() ? rRow.nHeight <= MINLAY && rRow.eType != SwFrameSize::Fixed
+                                                        : eType == rRow.eType && nHeight == rRow.nHeight;
+    if (bSameHeight && m_xSplitRowCB->get_active() == rRow.bSplit)
+        return;
+    rRow.eType = eType;
+    rRow.nHeight = nHeight;
+    rRow.bSplit = m_xSplitRowCB->get_active();
+    rRow.bChanged = true;
+}
+
+void SwHstTableRowPage::MoveRow(int nDelta)
+{
+    StoreRow();
+    m_bMoved = true;
+    m_nRow += nDelta;
+    ShowRow();
+}
+
+IMPL_LINK_NOARG(SwHstTableRowPage, PrevHdl, weld::Button&, void) { MoveRow(-1); }
+IMPL_LINK_NOARG(SwHstTableRowPage, NextHdl, weld::Button&, void) { MoveRow(1); }
