+
+void SwHstTableRowPage::Reset(const SfxItemSet* pSet)
+{
+    // The insert-from-database dialog has no table yet, so it has no row height to show.
+    SfxItemState eHeight = pSet->GetItemState(FN_HST_ROW_HEIGHT, false);
+    m_xSizeFrame->set_visible(eHeight != SfxItemState::DEFAULT);
+    m_xRuleLB->set_active(0);
+    m_xHeightCB->set_state(eHeight == SfxItemState::SET ? TRISTATE_FALSE : TRISTATE_INDET);
+    if (const SwFormatFrameSize* pSize = pSet->GetItemIfSet(FN_HST_ROW_HEIGHT, false))
+    {
+        const bool bFixed = pSize->GetHeightSizeType() == SwFrameSize::Fixed;
+        m_xHeightCB->set_active(bFixed || pSize->GetHeight() > MINLAY);
+        m_xRuleLB->set_active(bFixed ? 1 : 0);
+        HstTableSetTwips(*m_xHeightMF, pSize->GetHeight());
+    }
+    m_xHeightCB->save_state();
+    m_xRuleLB->save_value();
+    HeightToggledHdl(*m_xHeightCB);
+
+    if (const SwFormatRowSplit* pSplit = pSet->GetItemIfSet(RES_ROW_SPLIT, false))
+        m_xSplitRowCB->set_active(pSplit->GetValue());
+    else
+        m_xSplitRowCB->set_state(TRISTATE_INDET);
+    m_xSplitRowCB->save_state();
+
+    if (const SfxUInt16Item* pHeadline = pSet->GetItemIfSet(FN_PARAM_TABLE_HEADLINE, false))
+    {
+        sal_uInt16 nRepeat = pHeadline->GetValue();
+        m_xHeadLineCB->set_active(nRepeat > 0);
+        m_xRepeatHeaderNF->set_value(nRepeat);
+        m_xRepeatHeaderNF->set_min(1);
+    }
+    m_xHeadLineCB->save_state();
+    m_xRepeatHeaderNF->save_value();
+    HeadLineToggledHdl(*m_xHeadLineCB);
+    InitRows();
+}
+
+bool SwHstTableRowPage::FillItemSet(SfxItemSet* pSet)
+{
+    bool bModified = false;
+    if (m_bMoved)
+    {
+        StoreRow();
+        OUStringBuffer aEdits;
+        for (const RowState& rRow : m_aRows)
+            if (rRow.bChanged)
+                aEdits.append(rRow.sBoxName + "," + OUString::number(static_cast<int>(rRow.eType))
+                              + "," + OUString::number(rRow.nHeight) + ","
+                              + OUString::number(rRow.bSplit ? 1 : 0) + ";");
+        if (!aEdits.isEmpty())
+            bModified |= nullptr != pSet->Put(SfxStringItem(FN_HST_ROW_EDITS, aEdits.makeStringAndClear()));
+    }
+    else if (m_xHeightCB->get_state() != TRISTATE_INDET
+        && (m_xHeightCB->get_state_changed_from_saved() || m_xHeightMF->get_value_changed_from_saved()
+            || m_xRuleLB->get_value_changed_from_saved()))
+    {
+        SwFormatFrameSize aSize; // no height: the row fits its text, like Optimal Row Height
+        if (m_xHeightCB->get_active())
+        {
+            aSize.SetHeightSizeType(m_xRuleLB->get_active() == 1 ? SwFrameSize::Fixed
+                                                                 : SwFrameSize::Minimum);
+            aSize.SetHeight(HstTableTwips(*m_xHeightMF));
+        }
+        aSize.SetWhich(FN_HST_ROW_HEIGHT);
+        bModified |= nullptr != pSet->Put(aSize);
+    }
+    if (!m_bMoved && m_xSplitRowCB->get_state_changed_from_saved())
+        bModified |= nullptr != pSet->Put(SwFormatRowSplit(m_xSplitRowCB->get_active()));
+    if (m_xHeadLineCB->get_state_changed_from_saved()
+        || m_xRepeatHeaderNF->get_value_changed_from_saved())
+        bModified |= nullptr
+                     != pSet->Put(SfxUInt16Item(FN_PARAM_TABLE_HEADLINE,
+                                                m_xHeadLineCB->get_active()
+                                                    ? sal_uInt16(m_xRepeatHeaderNF->get_value())
+                                                    : 0));
+    return bModified;
+}
