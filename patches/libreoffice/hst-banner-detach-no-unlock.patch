 Core::~Core() { assert(!mpView); }
 
+namespace
+{
+// workers of detached cores, joined later from the main loop or at exit (JoinDetachedWorkers)
+std::mutex g_aDetachedMutex;
+std::vector<rtl::Reference<salhelper::Thread>> g_aDetached;
+ImplSVEvent* g_pJoinEvent = nullptr; // guarded by the SolarMutex
+
+std::vector<rtl::Reference<salhelper::Thread>> takeDetached()
+{
+    std::scoped_lock aGuard(g_aDetachedMutex);
+    return std::exchange(g_aDetached, {});
+}
+}
+
 void Core::Detach()
 {
     maRotateTimer.Stop();
     maFadeTimer.Stop();
     maShownTimer.Stop();
     mpView = nullptr;
-    // the workers take the SolarMutex to post their results: let them finish
-    for (salhelper::Thread* pThread : { static_cast<salhelper::Thread*>(mxThread.get()),
-                                        static_cast<salhelper::Thread*>(mxClickThread.get()),
-                                        static_cast<salhelper::Thread*>(mxShownThread.get()) })
-        if (pThread)
-        {
-            SolarMutexReleaser aReleaser;
-            pThread->join();
-        }
+    {
+        std::scoped_lock aGuard(g_aDetachedMutex);
+        for (salhelper::Thread* pThread : { static_cast<salhelper::Thread*>(mxThread.get()),
+                                            static_cast<salhelper::Thread*>(mxClickThread.get()),
+                                            static_cast<salhelper::Thread*>(mxShownThread.get()) })
+            if (pThread)
+                g_aDetached.emplace_back(pThread);
+    }
+    const bool bWorkers = mxThread.is() || mxClickThread.is() || mxShownThread.is();
     mxThread.clear();
     mxClickThread.clear();
     mxShownThread.clear();
+    if (bWorkers && !g_pJoinEvent)
+        g_pJoinEvent = Application::PostUserEvent(LINK(nullptr, Core, JoinHdl));
+}
+
+// from the main loop, outside any dispose: waiting may release the SolarMutex here
+IMPL_STATIC_LINK_NOARG(Core, JoinHdl, void*, void)
+{
+    g_pJoinEvent = nullptr;
+    std::vector<rtl::Reference<salhelper::Thread>> aThreads = takeDetached();
+    if (aThreads.empty())
+        return;
+    SolarMutexReleaser aReleaser; // the workers take it to post (and then see the core detached)
+    for (const auto& xThread : aThreads)
+        xThread->join();
+}
+
+void JoinDetachedWorkers()
+{
+    for (const auto& xThread : takeDetached())
+        xThread->join();
 }
 
