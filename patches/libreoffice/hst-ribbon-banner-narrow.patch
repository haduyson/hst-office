+tools::Long hst::ribbon::PageFullWidth(const vcl::Window& rPage)
+{
+    // the page's merged group box, breadth first (not a merged box nested in it)
+    std::vector<const vcl::Window*> aLevel{ &rPage };
+    const PriorityMergedHBox* pMerged = nullptr;
+    while (!aLevel.empty() && !pMerged)
+    {
+        std::vector<const vcl::Window*> aNext;
+        for (const vcl::Window* pWindow : aLevel)
+            for (const vcl::Window* pChild = pWindow->GetWindow(GetWindowType::FirstChild); pChild && !pMerged;
+                 pChild = pChild->GetWindow(GetWindowType::Next))
+            {
+                if (!pChild->IsVisible())
+                    continue;
+                pMerged = dynamic_cast<const PriorityMergedHBox*>(pChild);
+                aNext.push_back(pChild);
+            }
+        aLevel = std::move(aNext);
+    }
+    const vcl::Window* pContent = rPage.GetWindow(GetWindowType::FirstChild);
+    const tools::Long nFull = pMerged ? pMerged->HstFullWidth() : -1;
+    if (nFull < 0 || !pContent)
+        return -1;
+    // the page's content asks for the box at its smallest (calculateRequisition): count its full width
+    return VclContainer::getLayoutRequisition(*pContent).Width()
+           - VclContainer::getLayoutRequisition(*pMerged).Width() + nFull;
+}
