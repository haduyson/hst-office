     if (rTheme == u"hst_dark")
         return u"hst_classic_dark"_ustr;
     return OUString(rTheme);
 }
 
-/// The two HST icon styles a user chooses between: "hst_modern" (colourful, the default) and
-/// "hst" (classic). Each has a "_dark" variant drawn for dark UI surfaces; a choice made by
+/// The two HST icon styles a user chooses between: "hst_classic" (classic, the default) and
+/// "hst_modern" (colourful); "hst" is the former name of the classic style. Each has a "_dark" variant drawn for dark UI surfaces; a choice made by
 /// style follows the UI mode, so the options page needs one value per style only.
 inline OUString styleForMode(std::u16string_view rTheme, bool bDark)
 {
     OUString aTheme(rTheme);
     if (bDark && (rTheme == u"hst" || rTheme == u"hst_modern" || rTheme == u"hst_classic"))
         aTheme += "_dark";
