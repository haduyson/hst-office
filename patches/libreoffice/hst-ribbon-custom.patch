+            nToday);
+        CPPUNIT_ASSERT_EQUAL(std::size_t(1), aBad.size());
+        CPPUNIT_ASSERT_EQUAL(3, aBad.ranked(nToday)[0].count);
+        CPPUNIT_ASSERT(UsageHistory::parse("garbage", nToday).empty());
+        CPPUNIT_ASSERT(UsageHistory::parse(aHistory.write(), nToday + UsageHistory::WINDOW_DAYS + 1).empty());
