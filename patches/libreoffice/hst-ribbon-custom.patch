+std::unique_ptr<VclBuilder> RibbonController::Build(vcl::Window& rParent, const std::string& rDocument)
+{
+    // the builder reads a .ui file: the document goes to a file of its own in the profile, removed once read
+    const OUString aDir = ProfileDirUrl(true);
+    const OUString aFile = "ui-generated-" + OUString::number(++g_nDocuments) + ".ui";
+    if (aDir.isEmpty() || !WriteProfileFile(aFile, rDocument))
+        return nullptr;
+    std::unique_ptr<VclBuilder> xBuilder;
+    try
+    {
+        xBuilder.reset(new VclBuilder(&rParent, aDir, aFile, OUString(), Frame(), true));
+    }
+    catch (const css::uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("sfx.notebookbar", "HST ribbon: a generated tab or group was not built");
+        xBuilder.reset();
+    }
+    RemoveProfileFile(aFile);
+    return xBuilder;
+}
+
+void RibbonController::ReadDefaults()
+{
+    m_aDefaults = core::Layout();
+    const css::uno::Reference<css::frame::XFrame> xFrame = Frame();
+    const OUString aModule = ModuleOf(xFrame);
+    // the layout specs of the groups, from the ribbon's .ui file (one read per process and file)
+    static std::map<OUString, std::map<std::string, std::string>> s_aSpecs;
+    const NotebookBar* pBar = nullptr;
+    for (vcl::Window* pWindow = m_xTabs->GetParent(); pWindow && !pBar; pWindow = pWindow->GetParent())
+        pBar = dynamic_cast<const NotebookBar*>(pWindow);
+    const OUString aUi = pBar ? AllSettings::GetUIRootDir() + pBar->GetUIFilePath() : OUString();
+    if (!s_aSpecs.count(aUi))
+    {
+        const std::optional<std::string> aText = ReadUrl(aUi);
+        s_aSpecs[aUi] = aText ? readLayoutSpecs(*aText) : std::map<std::string, std::string>();
+    }
+    const std::map<std::string, std::string>& rSpecs = s_aSpecs[aUi];
+
+    for (sal_uInt16 nPos = 0; nPos < m_xTabs->GetPageCount(); ++nPos)
+    {
+        const sal_uInt16 nId = m_xTabs->GetPageId(nPos);
+        TabPage* pPage = m_xTabs->GetTabPage(nId);
+        const OUString aName = m_xTabs->GetPageName(nId);
+        // the main tabs: not the File tab, not the contextual tabs
+        if (!pPage || aName.isEmpty() || aName == "FileLabel" || !pPage->HasContext(vcl::EnumContext::Context::Any))
+            continue;
+        vcl::Window* pBox = GroupBoxOf(*pPage);
+        if (!pBox)
+            continue;
+        core::Tab aTab;
+        aTab.id = ToUtf8(aName);
+        aTab.label = ToUtf8(Plain(m_xTabs->GetPageText(nId)));
+        for (vcl::Window* pGrid : ChildrenOf(*pBox))
+        {
+            const std::string aGroupId = ToUtf8(pGrid->get_id());
+            const auto itSpec = rSpecs.find(aGroupId);
+            if (aGroupId.empty() || itSpec == rSpecs.end() || m_aGroupWindows.count(aGroupId))
+                continue; // not a v3 group (an add-on box): it stays as it is
+            const LayoutSpec aSpec = parseLayoutSpec(itSpec->second);
+            const std::vector<vcl::Window*> aCommands = CommandChildren(*pGrid);
+            if (!aSpec.valid || aSpec.kinds.size() != aCommands.size())
+                continue;
+            core::Group aGroup;
+            aGroup.id = aGroupId;
+            aGroup.label = ToUtf8(CaptionOf(*pGrid));
+            std::vector<VclPtr<vcl::Window>> aWindows;
+            for (int nChild : readingOrder(aSpec))
+            {
+                core::Command aCommand;
+                aCommand.id = CommandIdOf(*aCommands[nChild], &aCommand.dropdown);
+                aCommand.label = ToUtf8(LabelOf(*aCommands[nChild], aModule));
+                aCommand.kind = aSpec.kinds[nChild];
+                aGroup.commands.push_back(std::move(aCommand));
+                aWindows.emplace_back(aCommands[nChild]);
+            }
+            m_aGroupWindows[aGroupId] = pGrid;
+            m_aCommandWindows[aGroupId] = std::move(aWindows);
+            m_aGroupSpecs[aGroupId] = itSpec->second;
+            aTab.groups.push_back(std::move(aGroup));
+        }
+        if (!aTab.groups.empty())
+            m_aDefaults.tabs.push_back(std::move(aTab));
+    }
+}
+
+void RibbonController::ApplyBuiltinTab(const core::Tab& rTab)
+{
+    const core::Tab* pDefault = m_aDefaults.findTab(rTab.id);
+    if (!pDefault || *pDefault == rTab || pDefault->groups.empty())
+        return;
+    const auto itFirst = m_aGroupWindows.find(pDefault->groups.front().id);
+    vcl::Window* pBox = itFirst != m_aGroupWindows.end() ? itFirst->second->GetParent() : nullptr;
+    if (!pBox)
+        return;
+    std::vector<vcl::Window*> aShown;
+    for (const core::Group& rGroup : rTab.groups)
+    {
+        if (rGroup.custom)
+        {
+            const bool bAny = std::any_of(rGroup.commands.begin(), rGroup.commands.end(),
+                                          [](const core::Command& r) { return !r.hidden; });
+            if (rGroup.hidden || !bAny)
+                continue;
+            MarkupGroup aMarkup{ rGroup.id, rGroup.label, {} };
+            std::vector<char> aKinds;
+            for (const core::Command& rCommand : rGroup.commands)
+                if (!rCommand.hidden)
+                    aKinds.push_back(rCommand.kind);
+            const std::string aKindText = core::groupKinds(aKinds);
+            std::size_t n = 0;
+            for (const core::Command& rCommand : rGroup.commands)
+                if (!rCommand.hidden)
+                {
+                    aMarkup.commands.push_back({ rCommand.id, aKindText[n], rCommand.dropdown });
+                    ++n;
+                }
+            std::unique_ptr<VclBuilder> xBuilder = Build(*pBox, groupDocument(aMarkup));
+            if (!xBuilder)
+                continue;
+            if (vcl::Window* pGrid = xBuilder->get<vcl::Window>(FromUtf8(rGroup.id)))
+                aShown.push_back(pGrid);
+            m_aBuilders.push_back(std::move(xBuilder));
+            Watch(*pBox);
+            continue;
+        }
+        const auto itGrid = m_aGroupWindows.find(rGroup.id);
+        vcl::Window* pGrid = itGrid != m_aGroupWindows.end() ? itGrid->second.get() : nullptr;
+        const core::Group* pDefaultGroup = nullptr;
+        for (const core::Group& r : pDefault->groups)
+            if (r.id == rGroup.id)
+                pDefaultGroup = &r;
+        if (!pGrid || !pDefaultGroup)
+            continue;
+        const bool bAnyShown = std::any_of(rGroup.commands.begin(), rGroup.commands.end(),
+                                           [](const core::Command& r) { return !r.hidden; });
+        if (rGroup.hidden || !bAnyShown)
+        {
+            // out of the group box until the ribbon goes
+            pGrid->SetParent(&Parking());
+            continue;
+        }
+        aShown.push_back(pGrid);
+        if (rGroup == *pDefaultGroup)
+            continue;
+        // the group's commands: hidden ones hide; a new order takes the commands' kinds without the fixed rows
+        const std::vector<VclPtr<vcl::Window>>& rWindows = m_aCommandWindows[rGroup.id];
+        std::vector<bool> aUsed(rWindows.size(), false);
+        std::vector<vcl::Window*> aOrder;
+        std::string aKinds;
+        for (const core::Command& rCommand : rGroup.commands)
+            for (std::size_t i = 0; i < pDefaultGroup->commands.size() && i < rWindows.size(); ++i)
+                if (!aUsed[i] && pDefaultGroup->commands[i].id == rCommand.id)
+                {
+                    aUsed[i] = true;
+                    rWindows[i]->Show(!rCommand.hidden);
+                    aOrder.push_back(rWindows[i].get());
+                    aKinds += pDefaultGroup->commands[i].kind;
+                    break;
+                }
+        bool bReordered = false;
+        for (std::size_t i = 0; i < rGroup.commands.size() && i < pDefaultGroup->commands.size(); ++i)
+            bReordered = bReordered || rGroup.commands[i].id != pDefaultGroup->commands[i].id;
+        if (bReordered && aOrder.size() == rWindows.size())
+        {
+            Arrange(*pGrid, aOrder);
+            pGrid->set_property(u"hst-ribbon-layout"_ustr,
+                                FromUtf8(writeLayoutSpec(aKinds, parseLayoutSpec(m_aGroupSpecs[rGroup.id]).nofill)));
+        }
+        pGrid->queue_resize();
+    }
+    Arrange(*pBox, aShown);
+    pBox->queue_resize();
+}
+
+void RibbonController::AddCustomTab(const core::Tab& rTab, const OUString& rAfterPage)
+{
+    std::vector<MarkupGroup> aGroups;
+    for (const core::Group& rGroup : rTab.groups)
+    {
+        if (rGroup.hidden)
+            continue;
+        MarkupGroup aMarkup{ rGroup.id, rGroup.label, {} };
+        std::vector<char> aKinds;
+        for (const core::Command& rCommand : rGroup.commands)
+            if (!rCommand.hidden)
+                aKinds.push_back(rCommand.kind);
+        if (aKinds.empty())
+            continue;
+        const std::string aKindText = core::groupKinds(aKinds);
+        std::size_t n = 0;
+        for (const core::Command& rCommand : rGroup.commands)
+            if (!rCommand.hidden)
+                aMarkup.commands.push_back({ rCommand.id, aKindText[n++], rCommand.dropdown });
+        aGroups.push_back(std::move(aMarkup));
+    }
+    const sal_uInt16 nAfter = rAfterPage.isEmpty() ? TAB_PAGE_NOTFOUND : m_xTabs->GetPageId(rAfterPage);
+    const sal_uInt16 nAfterPos = nAfter ? m_xTabs->GetPagePos(nAfter) : TAB_PAGE_NOTFOUND;
+    const sal_uInt16 nPos = nAfterPos == TAB_PAGE_NOTFOUND ? TAB_APPEND : nAfterPos + 1;
+    TabPage* pPage = InsertPage(FromUtf8(rTab.id), FromUtf8(rTab.label), nPos);
+    // a custom tab without a command shows the empty state of its first group's place
+    std::unique_ptr<VclBuilder> xBuilder
+        = Build(*pPage, aGroups.empty() ? messageDocument(rTab.id, "") : pageDocument(rTab.id, aGroups));
+    if (xBuilder)
+        m_aBuilders.push_back(std::move(xBuilder));
+}
+
+void RibbonController::AddRecentTab()
+{
+    const sal_uInt16 nHome = m_xTabs->GetPageId(u"HomeLabel"_ustr);
+    const sal_uInt16 nHomePos = nHome ? m_xTabs->GetPagePos(nHome) : TAB_PAGE_NOTFOUND;
+    const sal_uInt16 nPos = nHomePos == TAB_PAGE_NOTFOUND ? TAB_APPEND : nHomePos + 1;
+    InsertPage(RECENT_PAGE, SfxResId(STR_HST_RIBBON_RECENT_TAB), nPos);
+    m_nRecentPage = m_xTabs->GetPageId(RECENT_PAGE);
+    // its content is built when it is first shown: only then is the width of the ribbon known
+}
+
+void RibbonController::RefreshRecent()
+{
+    TabPage* pPage = m_nRecentPage ? m_xTabs->GetTabPage(m_nRecentPage) : nullptr;
+    if (!pPage)
+        return;
+    const double fScale = m_xTabs->GetDPIScaleFactor();
+    // the room of the groups beside the smallest banner (360 px, 8 px before it and 8 px after it, the page's
+    // insets): what the v3 fit gives the groups of every tab
+    const tools::Long nWidth = m_xTabs->GetOutputSizePixel().Width();
+    const tools::Long nRoom
+        = nWidth - pPage->GetPosPixel().X() - static_cast<tools::Long>(std::lround(fScale * (360 + 8 + 8 + 12)));
+    const unsigned nRevision = UsageRevision(m_aApp);
+    if (m_bRecentBuilt && nRevision == m_nRecentRevision && nWidth == m_nRecentWidth)
+        return;
+    m_bRecentBuilt = true;
+    m_nRecentRevision = nRevision;
+    m_nRecentWidth = nWidth;
+    if (m_xRecentBuilder)
+    {
+        m_xRecentBuilder->disposeBuilder();
+        m_xRecentBuilder.reset();
+    }
+
+    // the commands the app can show as a button (a label), most used first
+    const css::uno::Reference<css::frame::XFrame> xFrame = Frame();
+    const OUString aModule = ModuleOf(xFrame);
+    std::vector<std::string> aUsable;
+    for (const std::string& rCommand : RankedCommands(m_aApp, 3 * RECENT_CANDIDATES))
+    {
+        const OUString aCommand = FromUtf8(rCommand);
+        if (!vcl::CommandInfoProvider::GetLabelForCommand(
+                 vcl::CommandInfoProvider::GetCommandProperties(aCommand, aModule))
+                 .isEmpty())
+            aUsable.push_back(rCommand);
+    }
+    std::vector<core::RecentGroup> aPlan = core::planRecentGroups(aUsable, m_aDefaults, RECENT_CANDIDATES,
+                                                                  ToUtf8(SfxResId(STR_HST_RIBBON_RECENT_OTHER)));
+    if (aPlan.empty())
+    {
+        m_xRecentBuilder = Build(*pPage, messageDocument(ToUtf8(RECENT_PAGE),
+                                                         ToUtf8(SfxResId(STR_HST_RIBBON_RECENT_EMPTY))));
+        return;
+    }
+    const auto markup = [](const std::vector<core::RecentGroup>& rPlan) {
+        std::vector<MarkupGroup> aGroups;
+        for (const core::RecentGroup& rGroup : rPlan)
+        {
+            std::vector<char> aKinds;
+            for (const core::RecentCommand& rCommand : rGroup.commands)
+                aKinds.push_back(rCommand.kind);
+            const std::string aKindText = core::groupKinds(aKinds);
+            MarkupGroup aMarkup{ rGroup.id, rGroup.label, {} };
+            for (std::size_t i = 0; i < rGroup.commands.size(); ++i)
+                aMarkup.commands.push_back({ rGroup.commands[i].id, aKindText[i], rGroup.commands[i].dropdown });
+            aGroups.push_back(std::move(aMarkup));
+        }
+        return aGroups;
+    };
+    // only as many commands as fit at their full size: the least used go first; one command always stays
+    while (true)
+    {
+        m_xRecentBuilder = Build(*pPage, pageDocument(ToUtf8(RECENT_PAGE), markup(aPlan)));
+        if (!m_xRecentBuilder)
+            return;
+        tools::Long nUsed = 0;
+        for (const core::RecentGroup& rGroup : aPlan)
+            if (vcl::Window* pGrid = m_xRecentBuilder->get<vcl::Window>(FromUtf8(rGroup.id)))
+                nUsed += VclContainer::getLayoutRequisition(*pGrid).Width();
+        std::size_t nCommands = 0;
+        for (const core::RecentGroup& rGroup : aPlan)
+            nCommands += rGroup.commands.size();
+        if (nUsed <= nRoom || nCommands <= 1)
+            break;
+        // drop the least used commands in proportion to the excess, then build again (a few rounds at most)
+        const std::size_t nDrop = std::max<std::size_t>(
+            1, static_cast<std::size_t>(nCommands * double(nUsed - nRoom) / std::max<tools::Long>(nUsed, 1)));
+        for (std::size_t i = 0; i < nDrop && nCommands > 1; ++i, --nCommands)
+            core::dropLeastUsed(aPlan);
+        m_xRecentBuilder->disposeBuilder();
+        m_xRecentBuilder.reset();
+    }
+}
+
+void RibbonController::Apply()
+{
+    if (m_bApplied || !Tabs())
+        return;
+    m_bApplied = true;
+    try
+    {
+        ReadDefaults();
+        core::Customization aCustom;
+        if (const std::optional<std::string> aText = ReadProfileFile(OUString("custom-" + FromUtf8(m_aApp) + ".json")))
+        {
+            std::vector<std::string> aWarnings;
+            aCustom = core::parseCustomization(*aText, &aWarnings);
+            for (const std::string& rWarning : aWarnings)
+                SAL_INFO("sfx.notebookbar", "HST ribbon customization of " << m_aApp << ": " << rWarning);
+        }
+        m_aEffective = core::merge(m_aDefaults, aCustom);
+        OUString aPrevious;
+        for (const core::Tab& rTab : m_aEffective.tabs)
+        {
+            if (rTab.custom)
+                AddCustomTab(rTab, aPrevious);
+            else
+                ApplyBuiltinTab(rTab);
+            aPrevious = FromUtf8(rTab.id);
+        }
+        if (RecentEnabled())
+            AddRecentTab();
+    }
+    catch (const css::uno::Exception&)
+    {
+        // the ribbon stays as built: a broken customization never breaks it
+        TOOLS_WARN_EXCEPTION("sfx.notebookbar", "HST ribbon: customization not applied");
+    }
+}
+
+void RibbonController::Watch(vcl::Window& rWindow)
+{
+    if (std::find(m_aWatched.begin(), m_aWatched.end(), &rWindow) != m_aWatched.end())
+        return;
+    rWindow.AddEventListener(LINK(this, RibbonController, TabsEventHdl));
+    m_aWatched.emplace_back(&rWindow);
+}
+
+void RibbonController::DisposeOwned()
+{
+    for (VclPtr<vcl::Window>& rWatched : m_aWatched)
+        if (rWatched && !rWatched->isDisposed())
+            rWatched->RemoveEventListener(LINK(this, RibbonController, TabsEventHdl));
+    m_aWatched.clear();
+    if (m_xRecentBuilder)
+        m_xRecentBuilder->disposeBuilder();
+    m_xRecentBuilder.reset();
+    for (const std::unique_ptr<VclBuilder>& rBuilder : m_aBuilders)
+        rBuilder->disposeBuilder();
+    m_aBuilders.clear();
+    for (VclPtr<TabPage>& rPage : m_aPages)
+        rPage.disposeAndClear();
+    m_aPages.clear();
+    m_xParking.disposeAndClear();
+}
+
+IMPL_LINK(RibbonController, TabsEventHdl, VclWindowEvent&, rEvent, void)
+{
+    switch (rEvent.GetId())
+    {
+        case VclEventId::ObjectDying:
+            if (rEvent.GetWindow() == m_xTabs.get())
+            {
+                m_xTabs->RemoveEventListener(LINK(this, RibbonController, TabsEventHdl));
+                DisposeOwned();
+                controllers().erase(m_xTabs.get()); // deletes this: nothing after it
+                return;
+            }
+            // a built-in group box goes before the tab control: the custom groups built into it go first
+            rEvent.GetWindow()->RemoveEventListener(LINK(this, RibbonController, TabsEventHdl));
+            std::erase(m_aWatched, rEvent.GetWindow());
+            for (auto it = m_aBuilders.begin(); it != m_aBuilders.end();)
+            {
+                vcl::Window* pRoot = (*it)->get_widget_root();
+                if (pRoot && pRoot->GetParent() == rEvent.GetWindow())
+                {
+                    (*it)->disposeBuilder();
+                    it = m_aBuilders.erase(it);
+                }
+                else
+                    ++it;
+            }
+            break;
+        case VclEventId::TabpageActivate:
+            if (m_nRecentPage && m_xTabs->GetCurPageId() == m_nRecentPage)
+                RefreshRecent();
+            break;
+        case VclEventId::WindowResize:
+            if (m_nRecentPage && m_bRecentBuilt && m_xTabs->GetCurPageId() == m_nRecentPage
+                && m_xTabs->GetOutputSizePixel().Width() != m_nRecentWidth && !m_pRefreshEvent)
+                m_pRefreshEvent = Application::PostUserEvent(LINK(this, RibbonController, RefreshHdl));
+            break;
+        default:
+            break;
+    }
+}
+
+IMPL_LINK_NOARG(RibbonController, RefreshHdl, void*, void)
+{
+    m_pRefreshEvent = nullptr;
+    if (Tabs() && m_nRecentPage && m_xTabs->GetCurPageId() == m_nRecentPage)
+        RefreshRecent();
+}
+
+void Attach(NotebookBar& rBar, const css::uno::Reference<css::frame::XFrame>& xFrame)
+{
+    if (comphelper::LibreOfficeKit::isActive())
+        return;
+    // the Tabbed ribbon (notebookbar.ui) of Writer, Sheets, Slides and Draw only
+    const OUString& rFile = rBar.GetUIFilePath();
+    if (!rFile.endsWith("/notebookbar.ui"))
+        return;
+    const std::string aApp = rFile.indexOf("/swriter/") >= 0    ? "writer"
+                             : rFile.indexOf("/scalc/") >= 0    ? "calc"
+                             : rFile.indexOf("/simpress/") >= 0 ? "impress"
+                             : rFile.indexOf("/sdraw/") >= 0    ? "draw"
+                                                                : "";
+    if (aApp.empty())
+        return;
+    vcl::Window* pTabs = FindDescendant(rBar, [](const vcl::Window& r) { return dynamic_cast<const TabControl*>(&r); });
+    TabControl* pTabControl = static_cast<TabControl*>(pTabs);
+    if (!pTabControl || controllers().count(pTabControl))
+        return;
+    std::unique_ptr<RibbonController>& rController = controllers()[pTabControl];
+    rController.reset(new RibbonController(*pTabControl, aApp, xFrame));
+    rController->Apply();
+}
+
+bool ContextMenu(TabControl& rTabs, const NotifyEvent& rEvent)
+{
+    if (rEvent.GetType() != NotifyEventType::COMMAND)
+        return false;
+    const CommandEvent* pCommand = rEvent.GetCommandEvent();
+    vcl::Window* pWindow = rEvent.GetWindow();
+    if (!pCommand || !pWindow || pCommand->GetCommand() != CommandEventId::ContextMenu)
+        return false;
+    // the ribbon's own surfaces only: an input field of a command keeps its menu (cut, copy, paste)
+    switch (pWindow->GetType())
+    {
+        case WindowType::TABCONTROL:
+        case WindowType::TABPAGE:
+        case WindowType::CONTAINER:
+        case WindowType::FIXEDTEXT:
+        case WindowType::FIXEDLINE:
+        case WindowType::TOOLBOX:
+            break;
+        default:
+            return false;
+    }
+    RibbonController* pController = RibbonController::Of(rTabs);
+    if (!pController)
+        return false;
+    ScopedVclPtrInstance<PopupMenu> pMenu;
+    pMenu->InsertItem(MENU_CUSTOMIZE, SfxResId(STR_HST_RIBBON_CUSTOMIZE));
+    const Point aAt = pCommand->IsMouseEvent()
+                          ? pCommand->GetMousePosPixel()
+                          : Point(pWindow->GetOutputSizePixel().Width() / 2, pWindow->GetOutputSizePixel().Height() / 2);
+    if (pMenu->Execute(pWindow, tools::Rectangle(aAt, Size(1, 1)), PopupMenuFlags::ExecuteDown) == MENU_CUSTOMIZE)
+        OpenCustomizeDialog(*pController, pWindow->GetFrameWeld());
+    return true;
+}
+
+void AppendMenuItem(PopupMenu& rMenu, sal_uInt16 nId)
+{
+    rMenu.InsertSeparator();
+    rMenu.InsertItem(nId, SfxResId(STR_HST_RIBBON_CUSTOMIZE));
+}
+
+bool RunMenuItem(vcl::Window& rWindow, sal_uInt16 nId, sal_uInt16 nChosen)
+{
+    if (nChosen != nId)
+        return false;
+    if (RibbonController* pController = RibbonController::Of(rWindow))
+        OpenCustomizeDialog(*pController, rWindow.GetFrameWeld());
+    return true;
+}
+}
