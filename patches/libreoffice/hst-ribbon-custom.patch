@@ -0,0 +1,528 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ */
+
+#include "ribbon-layout-model.hxx"
+#include "ribbon-json.hxx"
+
+#include <algorithm>
+#include <set>
+
+namespace hst::ribbon::core
+{
+namespace
+{
+constexpr std::string_view FORMAT = "hst-ribbon-customization";
+constexpr std::string_view BUNDLE_FORMAT = "hst-ribbon-customization-bundle";
+constexpr int VERSION = 1;
+
+void warn(std::vector<std::string>* pWarnings, std::string aText)
+{
+    if (pWarnings)
+        pWarnings->push_back(std::move(aText));
+}
+
+/// an id of a tab or group: printable ASCII without spaces at the ends, at most MAX_ID_BYTES
+bool isValidId(std::string_view aId)
+{
+    if (aId.empty() || aId.size() > MAX_ID_BYTES)
+        return false;
+    return std::all_of(aId.begin(), aId.end(), [](char c) { return c > 0x20 && c < 0x7F; });
+}
+
+/// the length of the longest prefix of at most nMax bytes that ends at a UTF-8 character boundary
+std::size_t utf8Cut(std::string_view aText, std::size_t nMax)
+{
+    if (aText.size() <= nMax)
+        return aText.size();
+    std::size_t n = nMax;
+    while (n > 0 && (static_cast<unsigned char>(aText[n]) & 0xC0) == 0x80)
+        --n;
+    return n;
+}
+
+CommandEntry readCommand(const Json& rJson, bool& rValid)
+{
+    CommandEntry aEntry;
+    rValid = rJson.isObject() && rJson.get("id").isString();
+    if (rValid)
+    {
+        aEntry.id = rJson.get("id").asString();
+        aEntry.hidden = rJson.get("hidden").asBool(false);
+    }
+    return aEntry;
+}
+
+std::optional<GroupEntry> readGroup(const Json& rJson, std::vector<std::string>* pWarnings)
+{
+    if (!rJson.isObject() || !rJson.get("id").isString() || !isValidId(rJson.get("id").asString()))
+    {
+        warn(pWarnings, "group without a valid id skipped");
+        return std::nullopt;
+    }
+    GroupEntry aGroup;
+    aGroup.id = rJson.get("id").asString();
+    aGroup.custom = rJson.get("custom").asBool(false);
+    aGroup.label = cleanLabel(rJson.get("label").asString());
+    aGroup.hidden = rJson.get("hidden").asBool(false);
+    if (aGroup.custom && aGroup.label.empty())
+    {
+        warn(pWarnings, "custom group " + aGroup.id + " without a label skipped");
+        return std::nullopt;
+    }
+    for (const Json& rCommand : rJson.get("commands").items())
+    {
+        bool bValid = false;
+        CommandEntry aCommand = readCommand(rCommand, bValid);
+        if (!bValid)
+        {
+            warn(pWarnings, "command entry of group " + aGroup.id + " skipped");
+            continue;
+        }
+        if (aGroup.custom && !isValidCommandId(aCommand.id))
+        {
+            warn(pWarnings, "command " + aCommand.id + " of group " + aGroup.id + " skipped");
+            continue;
+        }
+        if (aGroup.commands.size() >= MAX_COMMANDS_PER_GROUP)
+        {
+            warn(pWarnings, "group " + aGroup.id + " has too many commands");
+            break;
+        }
+        aGroup.commands.push_back(std::move(aCommand));
+    }
+    return aGroup;
+}
+
+std::optional<TabEntry> readTab(const Json& rJson, std::vector<std::string>* pWarnings)
+{
+    if (!rJson.isObject() || !rJson.get("id").isString() || !isValidId(rJson.get("id").asString()))
+    {
+        warn(pWarnings, "tab without a valid id skipped");
+        return std::nullopt;
+    }
+    TabEntry aTab;
+    aTab.id = rJson.get("id").asString();
+    aTab.custom = rJson.get("custom").asBool(false);
+    aTab.label = cleanLabel(rJson.get("label").asString());
+    aTab.after = rJson.get("after").isString() ? rJson.get("after").asString() : std::string();
+    if (aTab.custom && aTab.label.empty())
+    {
+        warn(pWarnings, "custom tab " + aTab.id + " without a label skipped");
+        return std::nullopt;
+    }
+    for (const Json& rGroup : rJson.get("groups").items())
+    {
+        if (aTab.groups.size() >= MAX_GROUPS_PER_TAB)
+        {
+            warn(pWarnings, "tab " + aTab.id + " has too many groups");
+            break;
+        }
+        if (std::optional<GroupEntry> aGroup = readGroup(rGroup, pWarnings))
+            aTab.groups.push_back(std::move(*aGroup));
+    }
+    return aTab;
+}
+
+Customization readCustomization(const Json& rRoot, std::vector<std::string>* pWarnings)
+{
+    Customization aCustom;
+    if (!rRoot.isObject() || rRoot.get("format").asString() != FORMAT)
+    {
+        warn(pWarnings, "not a ribbon customization");
+        return aCustom;
+    }
+    if (rRoot.get("version").asInt(0) > VERSION)
+        warn(pWarnings, "written by a newer version: only the known entries are used");
+    std::size_t nCustomTabs = 0;
+    for (const Json& rTab : rRoot.get("tabs").items())
+    {
+        std::optional<TabEntry> aTab = readTab(rTab, pWarnings);
+        if (!aTab)
+            continue;
+        if (aTab->custom && ++nCustomTabs > MAX_CUSTOM_TABS)
+        {
+            warn(pWarnings, "too many custom tabs");
+            continue;
+        }
+        aCustom.tabs.push_back(std::move(*aTab));
+    }
+    return aCustom;
+}
+
+Json commandJson(const std::string& rId, bool bHidden)
+{
+    Json aCommand = Json::object();
+    aCommand.set("id", Json::string(rId));
+    if (bHidden)
+        aCommand.set("hidden", Json::boolean(true));
+    return aCommand;
+}
+
+Json groupJson(const GroupEntry& rGroup)
+{
+    Json aGroup = Json::object();
+    aGroup.set("id", Json::string(rGroup.id));
+    if (rGroup.custom)
+    {
+        aGroup.set("custom", Json::boolean(true));
+        aGroup.set("label", Json::string(rGroup.label));
+    }
+    if (rGroup.hidden)
+        aGroup.set("hidden", Json::boolean(true));
+    Json aCommands = Json::array();
+    for (const CommandEntry& rCommand : rGroup.commands)
+        aCommands.push(commandJson(rCommand.id, rCommand.hidden));
+    aGroup.set("commands", std::move(aCommands));
+    return aGroup;
+}
+
+Json customizationJson(const Customization& rCustom, std::string_view aApp)
+{
+    Json aRoot = Json::object();
+    aRoot.set("format", Json::string(std::string(FORMAT)));
+    aRoot.set("version", Json::number(VERSION));
+    if (!aApp.empty())
+        aRoot.set("app", Json::string(std::string(aApp)));
+    Json aTabs = Json::array();
+    for (const TabEntry& rTab : rCustom.tabs)
+    {
+        Json aTab = Json::object();
+        aTab.set("id", Json::string(rTab.id));
+        if (rTab.custom)
+        {
+            aTab.set("custom", Json::boolean(true));
+            aTab.set("label", Json::string(rTab.label));
+            aTab.set("after", Json::string(rTab.after));
+        }
+        Json aGroups = Json::array();
+        for (const GroupEntry& rGroup : rTab.groups)
+            aGroups.push(groupJson(rGroup));
+        aTab.set("groups", std::move(aGroups));
+        aTabs.push(std::move(aTab));
+    }
+    aRoot.set("tabs", std::move(aTabs));
+    return aRoot;
+}
+
+/// a custom group of the merge: valid commands, each once
+Group customGroup(const Layout& rDefaults, const GroupEntry& rEntry)
+{
+    Group aGroup;
+    aGroup.id = rEntry.id;
+    aGroup.label = rEntry.label;
+    aGroup.custom = true;
+    aGroup.hidden = rEntry.hidden;
+    std::set<std::string> aSeen;
+    for (const CommandEntry& rCommand : rEntry.commands)
+    {
+        if (!isValidCommandId(rCommand.id) || !aSeen.insert(rCommand.id).second)
+            continue;
+        Command aCommand = customCommand(rDefaults, rCommand.id);
+        aCommand.hidden = rCommand.hidden;
+        aGroup.commands.push_back(std::move(aCommand));
+    }
+    return aGroup;
+}
+
+/// a built-in group in the entry's order: its listed commands first, the others after them
+Group builtinGroup(const Group& rDefault, const GroupEntry& rEntry)
+{
+    Group aGroup = rDefault;
+    aGroup.hidden = rEntry.hidden;
+    aGroup.commands.clear();
+    std::vector<bool> aUsed(rDefault.commands.size(), false);
+    for (const CommandEntry& rCommand : rEntry.commands)
+    {
+        for (std::size_t i = 0; i < rDefault.commands.size(); ++i)
+        {
+            if (aUsed[i] || rDefault.commands[i].id != rCommand.id)
+                continue;
+            aUsed[i] = true;
+            Command aCommand = rDefault.commands[i];
+            aCommand.hidden = rCommand.hidden;
+            aGroup.commands.push_back(std::move(aCommand));
+            break;
+        }
+    }
+    for (std::size_t i = 0; i < rDefault.commands.size(); ++i)
+        if (!aUsed[i])
+            aGroup.commands.push_back(rDefault.commands[i]);
+    return aGroup;
+}
+
+void collectGroupIds(const Layout& rLayout, std::set<std::string>& rIds)
+{
+    for (const Tab& rTab : rLayout.tabs)
+        for (const Group& rGroup : rTab.groups)
+            rIds.insert(rGroup.id);
+}
+
+GroupEntry groupEntry(const Group& rGroup)
+{
+    GroupEntry aEntry;
+    aEntry.id = rGroup.id;
+    aEntry.custom = rGroup.custom;
+    aEntry.label = rGroup.custom ? rGroup.label : std::string();
+    aEntry.hidden = rGroup.hidden;
+    for (const Command& rCommand : rGroup.commands)
+        aEntry.commands.push_back({ rCommand.id, rCommand.hidden });
+    return aEntry;
+}
+}
+
+const Tab* Layout::findTab(std::string_view aId) const
+{
+    for (const Tab& rTab : tabs)
+        if (rTab.id == aId)
+            return &rTab;
+    return nullptr;
+}
+
+const Tab* Layout::homeOf(std::string_view aCommand, const Group** ppGroup) const
+{
+    for (const Tab& rTab : tabs)
+        for (const Group& rGroup : rTab.groups)
+            for (const Command& rCommand : rGroup.commands)
+                if (rCommand.id == aCommand && !rCommand.hidden && !rGroup.hidden)
+                {
+                    if (ppGroup)
+                        *ppGroup = &rGroup;
+                    return &rTab;
+                }
+    return nullptr;
+}
+
+const Command* Layout::findCommand(std::string_view aCommand) const
+{
+    for (const Tab& rTab : tabs)
+        for (const Group& rGroup : rTab.groups)
+            for (const Command& rCommand : rGroup.commands)
+                if (rCommand.id == aCommand)
+                    return &rCommand;
+    return nullptr;
+}
+
+Command customCommand(const Layout& rDefaults, std::string_view aId)
+{
+    Command aCommand;
+    aCommand.id = std::string(aId);
+    if (const Command* pKnown = rDefaults.findCommand(aId))
+    {
+        aCommand.label = pKnown->label;
+        aCommand.dropdown = pKnown->dropdown;
+        // a box or a gallery keeps its widget; a button is laid out by the group (small with its label by default)
+        aCommand.kind = pKnown->kind == 'W' || pKnown->kind == 'G' ? pKnown->kind : 'M';
+    }
+    return aCommand;
+}
+
+bool isValidCommandId(std::string_view aId)
+{
+    if (aId.size() <= 5 || aId.size() > MAX_ID_BYTES || aId.substr(0, 5) != ".uno:")
+        return false;
+    const std::string_view aName = aId.substr(5, aId.find('?') == std::string_view::npos ? std::string_view::npos
+                                                                                        : aId.find('?') - 5);
+    if (aName.empty())
+        return false;
+    for (const char c : aName)
+        if (!((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_' || c == '.'))
+            return false;
+    return std::all_of(aId.begin(), aId.end(), [](char c) { return c > 0x20 && c < 0x7F; });
+}
+
+std::string cleanLabel(std::string_view aLabel)
+{
+    std::string aOut;
+    for (const char c : aLabel)
+        if (static_cast<unsigned char>(c) >= 0x20 && c != 0x7F)
+            aOut += c;
+    const std::size_t nStart = aOut.find_first_not_of(' ');
+    if (nStart == std::string::npos)
+        return std::string();
+    aOut = aOut.substr(nStart, aOut.find_last_not_of(' ') - nStart + 1);
+    aOut.resize(utf8Cut(aOut, MAX_LABEL_BYTES));
+    return aOut;
+}
+
+Customization parseCustomization(std::string_view aJson, std::vector<std::string>* pWarnings)
+{
+    const std::optional<Json> aRoot = Json::parse(aJson);
+    if (!aRoot)
+    {
+        warn(pWarnings, "the customization is not valid JSON");
+        return Customization();
+    }
+    return readCustomization(*aRoot, pWarnings);
+}
+
+std::string writeCustomization(const Customization& rCustom, std::string_view aApp)
+{
+    return customizationJson(rCustom, aApp).write(true);
+}
+
+Layout merge(const Layout& rDefaults, const Customization& rCustom)
+{
+    Layout aLayout = rDefaults;
+    std::set<std::string> aGroupIds;
+    collectGroupIds(rDefaults, aGroupIds);
+    std::set<std::string> aMergedTabs;
+    const auto addCustomGroup = [&](std::vector<Group>& rGroups, const GroupEntry& rEntry) {
+        if (aGroupIds.insert(rEntry.id).second)
+            rGroups.push_back(customGroup(rDefaults, rEntry));
+    };
+    // built-in tabs
+    for (const TabEntry& rEntry : rCustom.tabs)
+    {
+        if (rEntry.custom || !aMergedTabs.insert(rEntry.id).second)
+            continue;
+        const Tab* pDefault = rDefaults.findTab(rEntry.id);
+        if (!pDefault || pDefault->custom)
+            continue;
+        Tab& rTab = *std::find_if(aLayout.tabs.begin(), aLayout.tabs.end(),
+                                  [&](const Tab& r) { return r.id == rEntry.id; });
+        rTab.groups.clear();
+        std::vector<bool> aUsed(pDefault->groups.size(), false);
+        for (const GroupEntry& rGroup : rEntry.groups)
+        {
+            if (rGroup.custom)
+            {
+                addCustomGroup(rTab.groups, rGroup);
+                continue;
+            }
+            for (std::size_t i = 0; i < pDefault->groups.size(); ++i)
+                if (!aUsed[i] && pDefault->groups[i].id == rGroup.id)
+                {
+                    aUsed[i] = true;
+                    rTab.groups.push_back(builtinGroup(pDefault->groups[i], rGroup));
+                    break;
+                }
+        }
+        for (std::size_t i = 0; i < pDefault->groups.size(); ++i)
+            if (!aUsed[i])
+                rTab.groups.push_back(pDefault->groups[i]);
+    }
+    // custom tabs, each after the tab it names (the first place when it names none, the end when it is unknown)
+    std::set<std::string> aTabIds;
+    for (const Tab& rTab : aLayout.tabs)
+        aTabIds.insert(rTab.id);
+    std::size_t nCustomTabs = 0;
+    for (const TabEntry& rEntry : rCustom.tabs)
+    {
+        if (!rEntry.custom || rEntry.label.empty() || nCustomTabs >= MAX_CUSTOM_TABS
+            || !aTabIds.insert(rEntry.id).second)
+            continue;
+        ++nCustomTabs;
+        Tab aTab;
+        aTab.id = rEntry.id;
+        aTab.label = rEntry.label;
+        aTab.custom = true;
+        for (const GroupEntry& rGroup : rEntry.groups)
+            if (rGroup.custom)
+                addCustomGroup(aTab.groups, rGroup);
+        auto itAt = aLayout.tabs.begin();
+        if (!rEntry.after.empty())
+        {
+            itAt = std::find_if(aLayout.tabs.begin(), aLayout.tabs.end(),
+                                [&](const Tab& r) { return r.id == rEntry.after; });
+            if (itAt != aLayout.tabs.end())
+                ++itAt;
+        }
+        aLayout.tabs.insert(itAt, std::move(aTab));
+    }
+    return aLayout;
+}
+
+Customization diff(const Layout& rDefaults, const Layout& rEffective)
+{
+    Customization aCustom;
+    std::string aPrevious;
+    for (const Tab& rTab : rEffective.tabs)
+    {
+        if (rTab.custom)
+        {
+            TabEntry aEntry;
+            aEntry.id = rTab.id;
+            aEntry.custom = true;
+            aEntry.label = rTab.label;
+            aEntry.after = aPrevious;
+            for (const Group& rGroup : rTab.groups)
+                if (rGroup.custom)
+                    aEntry.groups.push_back(groupEntry(rGroup));
+            aCustom.tabs.push_back(std::move(aEntry));
+        }
+        else if (const Tab* pDefault = rDefaults.findTab(rTab.id); pDefault && !(pDefault->groups == rTab.groups))
+        {
+            TabEntry aEntry;
+            aEntry.id = rTab.id;
+            for (const Group& rGroup : rTab.groups)
+                aEntry.groups.push_back(groupEntry(rGroup));
+            aCustom.tabs.push_back(std::move(aEntry));
+        }
+        aPrevious = rTab.id;
+    }
+    return aCustom;
+}
+
+std::string writeBundle(const std::map<std::string, Customization>& rApps)
+{
+    Json aRoot = Json::object();
+    aRoot.set("format", Json::string(std::string(BUNDLE_FORMAT)));
+    aRoot.set("version", Json::number(VERSION));
+    Json aApps = Json::object();
+    for (const auto& [rApp, rCustom] : rApps)
+        if (isKnownApp(rApp))
+            aApps.set(rApp, customizationJson(rCustom, rApp));
+    aRoot.set("apps", std::move(aApps));
+    return aRoot.write(true);
+}
+
+std::optional<std::map<std::string, Customization>> parseBundle(std::string_view aJson,
+                                                                 std::vector<std::string>* pWarnings)
+{
+    const std::optional<Json> aRoot = Json::parse(aJson);
+    if (!aRoot || !aRoot->isObject())
+    {
+        warn(pWarnings, "the file is not valid JSON");
+        return std::nullopt;
+    }
+    std::map<std::string, Customization> aApps;
+    const std::string& rFormat = aRoot->get("format").asString();
+    if (rFormat == FORMAT)
+    {
+        const std::string& rApp = aRoot->get("app").asString();
+        if (!isKnownApp(rApp))
+        {
+            warn(pWarnings, "the customization names no known app");
+            return std::nullopt;
+        }
+        aApps[rApp] = readCustomization(*aRoot, pWarnings);
+        return aApps;
+    }
+    if (rFormat != BUNDLE_FORMAT || !aRoot->get("apps").isObject())
+    {
+        warn(pWarnings, "not a ribbon customization file");
+        return std::nullopt;
+    }
+    if (aRoot->get("version").asInt(0) > VERSION)
+        warn(pWarnings, "written by a newer version: only the known entries are used");
+    for (const auto& [rApp, rValue] : aRoot->get("apps").members())
+    {
+        if (!isKnownApp(rApp))
+        {
+            warn(pWarnings, "unknown app " + rApp + " skipped");
+            continue;
+        }
+        aApps[rApp] = readCustomization(rValue, pWarnings);
+    }
+    return aApps;
+}
+
+bool isKnownApp(std::string_view aApp)
+{
+    return aApp == "writer" || aApp == "calc" || aApp == "impress" || aApp == "draw";
+}
+}
