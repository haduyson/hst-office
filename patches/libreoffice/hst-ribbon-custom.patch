+RibbonController* RibbonController::Of(const vcl::Window& rWindow)
+{
+    for (const vcl::Window* pWindow = &rWindow; pWindow; pWindow = pWindow->GetParent())
+    {
+        const TabControl* pTabs = dynamic_cast<const TabControl*>(pWindow);
+        // a window of the ribbon outside its tab control (the quick access toolbar): the notebookbar's tab control
+        if (!pTabs && dynamic_cast<const NotebookBar*>(pWindow))
+            pTabs = static_cast<const TabControl*>(FindDescendant(
+                *pWindow, [](const vcl::Window& r) { return dynamic_cast<const TabControl*>(&r) != nullptr; }));
+        if (pTabs)
+        {
+            const auto it = controllers().find(pTabs);
+            if (it != controllers().end())
+                return it->second.get();
+        }
+    }
+    return nullptr;
+}
+
+RibbonController* RibbonController::OfFrame(const css::uno::Reference<css::frame::XFrame>& xFrame)
+{
+    if (!xFrame.is())
+        return nullptr;
+    const SystemWindow* pSystem = SystemOf(xFrame);
+    if (!pSystem)
+        return nullptr;
+    for (const auto& [pTabs, xController] : controllers())
+        if (!pTabs->isDisposed() && xController->System() == pSystem)
+            return xController.get();
+    return nullptr;
+}
+
+css::uno::Reference<css::frame::XFrame> RibbonController::Frame() const
+{
+    if (css::uno::Reference<css::frame::XFrame> xFrame = m_xFrame)
+        return xFrame;
+    const SystemWindow* pSystem = System();
+    if (!pSystem)
+        return {};
+    for (SfxViewFrame* pView = SfxViewFrame::GetFirst(nullptr, false); pView;
+         pView = SfxViewFrame::GetNext(*pView, nullptr, false))
+        if (pView->GetWindow().GetSystemWindow() == pSystem)
+            return pView->GetFrame().GetFrameInterface();
+    return {};
+}
