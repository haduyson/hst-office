+
+// HST Office ribbon core: customization parse/merge/fallback, the dialog's edits, export/import, the usage history
+// (prune, cap, ranking, noise) and the recently used tab's groups; and the adapter's .ui markup.
+
+#include <sal/types.h> // SAL_DLLPUBLIC_EXPORT, used by CPPUNIT_PLUGIN_IMPLEMENT
+
+#include <cppunit/TestAssert.h>
+#include <cppunit/TestFixture.h>
+#include <cppunit/extensions/HelperMacros.h>
+#include <cppunit/plugin/TestPlugIn.h>
+
+#include "../../ribbon/core/ribbon-json.hxx"
+#include "../../ribbon/core/ribbon-layout-edit.hxx"
+#include "../../ribbon/core/ribbon-layout-model.hxx"
+#include "../../ribbon/core/ribbon-recent-plan.hxx"
+#include "../../ribbon/core/ribbon-usage-history.hxx"
