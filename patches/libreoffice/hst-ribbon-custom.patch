+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ */
+
+#pragma once
+
+// HST Office ribbon core: the commands a user ran in one app, per day, for the "Sử dụng gần đây" (recently used)
+// tab. Standard C++ only.
+//
+// Privacy: the history lives only in the user's profile (the adapter writes it there), is never sent anywhere,
+// keeps only the last WINDOW_DAYS days and at most MAX_COMMANDS commands, and can be cleared or switched off.
+// It holds command names (".uno:Bold") and day counts, never document content.
+//
+// Recording is a map update (no I/O): the adapter writes the history in batches.
+
+#include <cstddef>
+#include <cstdint>
+#include <map>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace hst::ribbon::core
+{
+/// days since 1970-01-01 (the adapter's clock, local days)
+using Day = std::int64_t;
+
+class UsageHistory
+{
+public:
+    static constexpr Day WINDOW_DAYS = 30; // a run older than this many days is forgotten
+    static constexpr std::size_t MAX_COMMANDS = 300; // the least used commands beyond this go
+    static constexpr double HALF_LIFE_DAYS = 7.0; // a run counts half as much a week later
+    static constexpr int MAX_DAILY_COUNT = 100000;
+
+    /// counts one run of aCommand today; noise and malformed commands are ignored. True when it was counted.
+    bool record(std::string_view aCommand, Day nToday);
+    /// forgets the days older than the window and, beyond MAX_COMMANDS, the commands that rank lowest
+    void prune(Day nToday);
+    void clear() { m_aDays.clear(); }
+    bool empty() const { return m_aDays.empty(); }
+    std::size_t size() const { return m_aDays.size(); }
+
+    struct Ranked
+    {
+        std::string command;
+        double score = 0;
+        Day lastDay = 0;
+        int count = 0;
+    };
+    /// the commands of the window, most used first: frequency weighted by recency (each run counts
+    /// 0.5^(age / HALF_LIFE_DAYS)); ties go to the more recent, then to the name. At most nLimit.
+    std::vector<Ranked> ranked(Day nToday, std::size_t nLimit = MAX_COMMANDS) const;
+
+    /// the history file: { "format": "hst-ribbon-usage", "version": 1, "commands": { ".uno:Bold": { "<day>": n } } }
+    std::string write() const;
+    /// reads a history file and prunes it to the window ending today; a malformed file gives an empty history
+    static UsageHistory parse(std::string_view aJson, Day nToday);
+
+private:
+    std::map<std::string, std::map<Day, int>> m_aDays;
+};
+
+/// ".uno:Name" without its arguments ("?..."), or empty when it is not a .uno: command
+std::string normalizeCommand(std::string_view aCommand);
+
+/// commands that say nothing about what the user works with, so the recently used tab never shows them:
+/// - cursor movement and selection by keys (Go*, Jump*, the Writer/Calc/Impress cursor commands, Select* by keys),
+/// - typing and deleting characters, Enter, Tab, Escape,
+/// - Undo, Redo, Repeat, Save, Save All, AutoSave,
+/// - scrolling and zoom ticks (Scroll*, Zoom*, the zoom slider), page up/down,
+/// - window and document plumbing the office dispatches by itself (context menus, sidebar decks, status bar
+///   fields, focus moves, closing).
+/// The full list is in ribbon-usage-history.cxx.
+bool isNoiseCommand(std::string_view aNormalizedCommand);
+
+/// the "Sử dụng gần đây" switch of Tùy chọn › HST Office (true by default)
+struct UsageSettings
+{
+    bool recentEnabled = true;
+    std::string write() const;
+    static UsageSettings parse(std::string_view aJson);
+};
+}
+
