+                                                      TransliterationFlags::IGNORE_CASE
+                                                          | TransliterationFlags::IGNORE_DIACRITICS_CTL));
+        m_xFold->loadModuleIfNeeded(Application::GetSettings().GetUILanguageTag().getLanguageType());
+    }
