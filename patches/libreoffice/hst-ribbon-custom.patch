+
+void appendUtf8(std::string& rOut, std::uint32_t nCode)
+{
+    if (nCode < 0x80)
+        rOut += static_cast<char>(nCode);
+    else if (nCode < 0x800)
+    {
+        rOut += static_cast<char>(0xC0 | (nCode >> 6));
+        rOut += static_cast<char>(0x80 | (nCode & 0x3F));
+    }
+    else if (nCode < 0x10000)
+    {
+        rOut += static_cast<char>(0xE0 | (nCode >> 12));
+        rOut += static_cast<char>(0x80 | ((nCode >> 6) & 0x3F));
+        rOut += static_cast<char>(0x80 | (nCode & 0x3F));
+    }
+    else
+    {
+        rOut += static_cast<char>(0xF0 | (nCode >> 18));
+        rOut += static_cast<char>(0x80 | ((nCode >> 12) & 0x3F));
+        rOut += static_cast<char>(0x80 | ((nCode >> 6) & 0x3F));
+        rOut += static_cast<char>(0x80 | (nCode & 0x3F));
+    }
+}
+
+/// a recursive-descent reader over the text; every method returns false on malformed input
+class Reader
+{
+public:
+    explicit Reader(std::string_view aText)
+        : m_aText(aText)
+    {
+    }
+
+    bool document(Json& rOut)
+    {
+        skipSpace();
+        if (!value(rOut, 0))
+            return false;
+        skipSpace();
+        return m_nPos == m_aText.size();
+    }
+
+private:
+    static constexpr int MAX_DEPTH = 64;
+
+    void skipSpace()
+    {
+        while (m_nPos < m_aText.size()
+               && (m_aText[m_nPos] == ' ' || m_aText[m_nPos] == '\t' || m_aText[m_nPos] == '\n'
+                   || m_aText[m_nPos] == '\r'))
+            ++m_nPos;
+    }
+
+    bool literal(std::string_view aWord)
+    {
+        if (m_aText.substr(m_nPos, aWord.size()) != aWord)
+            return false;
+        m_nPos += aWord.size();
+        return true;
+    }
+
+    bool value(Json& rOut, int nDepth)
+    {
+        if (nDepth > MAX_DEPTH || m_nPos >= m_aText.size())
+            return false;
+        switch (m_aText[m_nPos])
+        {
+            case '{':
+                return object(rOut, nDepth);
+            case '[':
+                return array(rOut, nDepth);
+            case '"':
+            {
+                std::string aText;
+                if (!string(aText))
+                    return false;
+                rOut = Json::string(std::move(aText));
+                return true;
+            }
+            case 't':
+                rOut = Json::boolean(true);
+                return literal("true");
+            case 'f':
+                rOut = Json::boolean(false);
+                return literal("false");
+            case 'n':
+                rOut = Json();
+                return literal("null");
+            default:
+                return number(rOut);
+        }
+    }
+
+    bool number(Json& rOut)
+    {
+        const std::size_t nStart = m_nPos;
+        if (m_nPos < m_aText.size() && m_aText[m_nPos] == '-')
+            ++m_nPos;
+        const auto digits = [this]() {
+            const std::size_t nFrom = m_nPos;
+            while (m_nPos < m_aText.size() && m_aText[m_nPos] >= '0' && m_aText[m_nPos] <= '9')
+                ++m_nPos;
+            return m_nPos - nFrom;
+        };
+        const std::size_t nIntStart = m_nPos;
+        const std::size_t nInt = digits();
+        if (nInt == 0 || (nInt > 1 && m_aText[nIntStart] == '0'))
+            return false;
+        if (m_nPos < m_aText.size() && m_aText[m_nPos] == '.')
+        {
+            ++m_nPos;
+            if (digits() == 0)
+                return false;
+        }
+        if (m_nPos < m_aText.size() && (m_aText[m_nPos] == 'e' || m_aText[m_nPos] == 'E'))
+        {
+            ++m_nPos;
+            if (m_nPos < m_aText.size() && (m_aText[m_nPos] == '+' || m_aText[m_nPos] == '-'))
+                ++m_nPos;
+            if (digits() == 0)
+                return false;
+        }
+        // strtod reads the C locale's "." (the office keeps LC_NUMERIC "C")
+        const std::string aNumber(m_aText.substr(nStart, m_nPos - nStart));
+        char* pEnd = nullptr;
+        const double f = std::strtod(aNumber.c_str(), &pEnd);
+        if (!pEnd || *pEnd != '\0' || !std::isfinite(f))
+            return false;
+        rOut = Json::number(f);
+        return true;
+    }
+
+    bool hex4(std::uint32_t& rCode)
+    {
+        if (m_nPos + 4 > m_aText.size())
+            return false;
+        rCode = 0;
+        for (int i = 0; i < 4; ++i)
+        {
+            const char c = m_aText[m_nPos++];
+            rCode <<= 4;
+            if (c >= '0' && c <= '9')
+                rCode |= static_cast<std::uint32_t>(c - '0');
+            else if (c >= 'a' && c <= 'f')
+                rCode |= static_cast<std::uint32_t>(c - 'a' + 10);
+            else if (c >= 'A' && c <= 'F')
+                rCode |= static_cast<std::uint32_t>(c - 'A' + 10);
+            else
+                return false;
+        }
+        return true;
+    }
+
+    bool string(std::string& rOut)
+    {
+        ++m_nPos; // the opening quote
+        while (m_nPos < m_aText.size())
+        {
+            const unsigned char c = static_cast<unsigned char>(m_aText[m_nPos++]);
+            if (c == '"')
+                return true;
+            if (c < 0x20)
+                return false;
+            if (c != '\\')
+            {
+                rOut += static_cast<char>(c);
+                continue;
+            }
+            if (m_nPos >= m_aText.size())
+                return false;
+            switch (m_aText[m_nPos++])
+            {
+                case '"': rOut += '"'; break;
+                case '\\': rOut += '\\'; break;
+                case '/': rOut += '/'; break;
+                case 'b': rOut += '\b'; break;
+                case 'f': rOut += '\f'; break;
+                case 'n': rOut += '\n'; break;
+                case 'r': rOut += '\r'; break;
+                case 't': rOut += '\t'; break;
+                case 'u':
+                {
+                    std::uint32_t nCode = 0;
+                    if (!hex4(nCode))
+                        return false;
+                    if (nCode >= 0xD800 && nCode <= 0xDBFF)
+                    {
+                        std::uint32_t nLow = 0;
+                        if (!literal("\\u") || !hex4(nLow) || nLow < 0xDC00 || nLow > 0xDFFF)
+                            return false;
+                        nCode = 0x10000 + ((nCode - 0xD800) << 10) + (nLow - 0xDC00);
+                    }
+                    else if (nCode >= 0xDC00 && nCode <= 0xDFFF)
+                        return false;
+                    appendUtf8(rOut, nCode);
+                    break;
+                }
+                default:
+                    return false;
+            }
+        }
+        return false;
+    }
+
+    bool array(Json& rOut, int nDepth)
+    {
+        ++m_nPos;
+        rOut = Json::array();
+        skipSpace();
+        if (m_nPos < m_aText.size() && m_aText[m_nPos] == ']')
+        {
+            ++m_nPos;
+            return true;
+        }
+        while (true)
+        {
+            skipSpace();
+            Json aItem;
+            if (!value(aItem, nDepth + 1))
+                return false;
+            rOut.push(std::move(aItem));
+            skipSpace();
+            if (m_nPos >= m_aText.size())
+                return false;
+            const char c = m_aText[m_nPos++];
+            if (c == ']')
+                return true;
+            if (c != ',')
+                return false;
+        }
+    }
+
+    bool object(Json& rOut, int nDepth)
+    {
+        ++m_nPos;
+        rOut = Json::object();
+        skipSpace();
+        if (m_nPos < m_aText.size() && m_aText[m_nPos] == '}')
+        {
+            ++m_nPos;
+            return true;
+        }
+        while (true)
+        {
+            skipSpace();
+            if (m_nPos >= m_aText.size() || m_aText[m_nPos] != '"')
+                return false;
+            std::string aKey;
+            if (!string(aKey))
+                return false;
+            skipSpace();
+            if (m_nPos >= m_aText.size() || m_aText[m_nPos++] != ':')
+                return false;
+            skipSpace();
+            Json aValue;
+            if (!value(aValue, nDepth + 1))
+                return false;
+            rOut.set(std::move(aKey), std::move(aValue));
+            skipSpace();
+            if (m_nPos >= m_aText.size())
+                return false;
+            const char c = m_aText[m_nPos++];
+            if (c == '}')
+                return true;
+            if (c != ',')
+                return false;
+        }
+    }
+
+    std::string_view m_aText;
+    std::size_t m_nPos = 0;
+};
+
+void newline(std::string& rOut, bool bPretty, int nDepth)
+{
+    if (!bPretty)
+        return;
+    rOut += '\n';
+    rOut.append(static_cast<std::size_t>(nDepth) * 2, ' ');
+}
+}
+
+Json Json::boolean(bool b)
+{
+    Json a;
+    a.m_eType = Type::Bool;
+    a.m_bValue = b;
+    return a;
+}
+
+Json Json::number(double f)
+{
+    Json a;
+    a.m_eType = Type::Number;
+    a.m_fValue = f;
+    return a;
+}
+
+Json Json::string(std::string s)
+{
+    Json a;
+    a.m_eType = Type::String;
+    a.m_aString = std::move(s);
+    return a;
+}
+
+Json Json::array()
+{
+    Json a;
+    a.m_eType = Type::Array;
+    return a;
+}
+
+Json Json::object()
+{
+    Json a;
+    a.m_eType = Type::Object;
+    return a;
+}
+
+std::int64_t Json::asInt(std::int64_t nDefault) const
+{
+    if (m_eType != Type::Number || !std::isfinite(m_fValue) || m_fValue > 9.0e15 || m_fValue < -9.0e15)
+        return nDefault;
+    return static_cast<std::int64_t>(std::floor(m_fValue));
+}
+
+void Json::push(Json aItem)
+{
+    if (m_eType == Type::Array)
+        m_aItems.push_back(std::move(aItem));
+}
+
+const Json& Json::get(std::string_view aKey) const
+{
+    for (const auto& [rKey, rValue] : m_aMembers)
+        if (rKey == aKey)
+            return rValue;
+    return nullValue();
+}
+
+bool Json::has(std::string_view aKey) const
+{
+    for (const auto& rMember : m_aMembers)
+        if (rMember.first == aKey)
+            return true;
+    return false;
+}
+
+void Json::set(std::string aKey, Json aValue)
+{
+    if (m_eType != Type::Object)
+        return;
+    for (auto& rMember : m_aMembers)
+        if (rMember.first == aKey)
+        {
+            rMember.second = std::move(aValue);
+            return;
+        }
+    m_aMembers.emplace_back(std::move(aKey), std::move(aValue));
+}
+
+std::optional<Json> Json::parse(std::string_view aText)
+{
+    // a UTF-8 byte order mark written by an editor is allowed
+    if (aText.substr(0, 3) == "\xEF\xBB\xBF")
+        aText.remove_prefix(3);
+    Json aOut;
+    if (!Reader(aText).document(aOut))
+        return std::nullopt;
+    return aOut;
+}
+
+std::string jsonEscape(std::string_view aText)
+{
+    std::string aOut;
+    aOut.reserve(aText.size());
+    for (const char c : aText)
+    {
+        switch (c)
+        {
+            case '"': aOut += "\\\""; break;
+            case '\\': aOut += "\\\\"; break;
+            case '\n': aOut += "\\n"; break;
+            case '\r': aOut += "\\r"; break;
+            case '\t': aOut += "\\t"; break;
+            default:
+                if (static_cast<unsigned char>(c) < 0x20)
+                {
+                    char aBuf[8];
+                    std::snprintf(aBuf, sizeof aBuf, "\\u%04x", static_cast<unsigned>(static_cast<unsigned char>(c)));
+                    aOut += aBuf;
+                }
+                else
+                    aOut += c;
+        }
+    }
+    return aOut;
+}
+
+void Json::writeTo(std::string& rOut, bool bPretty, int nDepth) const
+{
+    switch (m_eType)
+    {
+        case Type::Null:
+            rOut += "null";
+            break;
+        case Type::Bool:
+            rOut += m_bValue ? "true" : "false";
+            break;
+        case Type::Number:
+        {
+            char aBuf[32];
+            if (std::floor(m_fValue) == m_fValue && std::fabs(m_fValue) < 9.0e15)
+                std::snprintf(aBuf, sizeof aBuf, "%lld", static_cast<long long>(m_fValue));
+            else
+                std::snprintf(aBuf, sizeof aBuf, "%.17g", m_fValue);
+            rOut += aBuf;
+            break;
+        }
+        case Type::String:
+            rOut += '"';
+            rOut += jsonEscape(m_aString);
+            rOut += '"';
+            break;
+        case Type::Array:
+        {
+            rOut += '[';
+            bool bFirst = true;
+            for (const Json& rItem : m_aItems)
+            {
+                if (!bFirst)
+                    rOut += ',';
+                bFirst = false;
+                newline(rOut, bPretty, nDepth + 1);
+                rItem.writeTo(rOut, bPretty, nDepth + 1);
+            }
+            if (!m_aItems.empty())
+                newline(rOut, bPretty, nDepth);
+            rOut += ']';
+            break;
+        }
+        case Type::Object:
+        {
+            rOut += '{';
+            bool bFirst = true;
+            for (const auto& [rKey, rValue] : m_aMembers)
+            {
+                if (!bFirst)
+                    rOut += ',';
+                bFirst = false;
+                newline(rOut, bPretty, nDepth + 1);
+                rOut += '"';
+                rOut += jsonEscape(rKey);
+                rOut += bPretty ? "\": " : "\":";
+                rValue.writeTo(rOut, bPretty, nDepth + 1);
+            }
+            if (!m_aMembers.empty())
+                newline(rOut, bPretty, nDepth);
+            rOut += '}';
+            break;
+        }
+    }
+}
+
+std::string Json::write(bool bPretty) const
+{
+    std::string aOut;
+    writeTo(aOut, bPretty, 0);
+    if (bPretty)
+        aOut += '\n';
+    return aOut;
+}
+}
