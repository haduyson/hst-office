+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ */
+
+#pragma once
+
+// HST Office ribbon adapter: counts the commands the user runs in Writer, Sheets, Slides and Draw (the dispatch of
+// every .uno: command passes here: ribbon, menus, shortcuts, the quick access toolbar) in the app's usage history
+// (ribbon-usage-history.hxx). A run is a map update; the histories are written to the profile once a minute at most
+// and when the office ends, never per command. Nothing is recorded while the recently used tab is switched off.
+
+#include <rtl/ustring.hxx>
+
+#include <cstddef>
+#include <string>
+#include <string_view>
+#include <vector>
+
+class SfxViewFrame;
+
+namespace hst::ribbon::lo
+{
+/// "writer", "calc", "impress", "draw" for an object factory name ("swriter", ...), else ""
+std::string AppOfFactory(std::u16string_view aFactoryName);
+
+/// a dispatched command of the frame's document
+void RecordCommand(SfxViewFrame* pFrame, std::u16string_view aProtocol, std::u16string_view aPath);
+
+/// the app's commands, most used first (frequency weighted by recency, last 30 days)
+std::vector<std::string> RankedCommands(const std::string& rApp, std::size_t nLimit);
+/// changes whenever the app's history does (the recently used tab rebuilds when it is shown after a change)
+unsigned UsageRevision(const std::string& rApp);
+
+bool RecentEnabled();
+/// switches the recently used tab and the recording on or off (the ribbons are rebuilt by the caller)
+void SetRecentEnabled(bool bEnabled);
+/// forgets every app's history, in memory and in the profile
+void ClearHistory();
+/// writes the changed histories now
+void FlushHistory();
+}
+
