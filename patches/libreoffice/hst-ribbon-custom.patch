+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ */
+
+#pragma once
+
+// HST Office ribbon core: the ribbon of an app as data (tabs, groups, commands), the user's customization of it and
+// the merge of both. Standard C++ only: no toolkit, no office types; ids and labels are UTF-8.
+//
+// The default layout is what the app's ribbon shows out of the box (the adapter reads it from the built ribbon). The
+// customization file (one per app in the user profile) records only what the user changed:
+//
+//   { "format": "hst-ribbon-customization", "version": 1, "app": "writer",
+//     "tabs": [
+//       { "id": "HomeLabel",                                  a built-in tab the user changed: its groups in order
+//         "groups": [ { "id": "gdHomeFont", "hidden": false,
+//                       "commands": [ { "id": ".uno:Bold" }, { "id": ".uno:Italic", "hidden": true } ] },
+//                     { "id": "hst-group-1", "custom": true, "label": "Của tôi",
+//                       "commands": [ { "id": ".uno:InsertTable" } ] } ] },
+//       { "id": "hst-tab-1", "custom": true, "label": "Của tôi", "after": "HomeLabel",
+//         "groups": [ ... ] } ] }
+//
+// Merge rules: an entry that does not fit the default layout (an unknown built-in tab, group or command, a malformed
+// entry, a duplicate) is skipped and the default stays; built-in groups and commands the file does not mention are
+// shown at the end in their default order (a newer version may add commands). A custom command is any ".uno:"
+// command. Positions and sizes are never stored: the ribbon's layout computes them from the order alone.
+
+#include <cstddef>
+#include <map>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace hst::ribbon::core
+{
+/// one command of a group; kind is the ribbon layout's letter (L large, M small with label, S icon only, W box,
+/// G gallery), dropdown: the command shows a ▾ list
+struct Command
+{
+    std::string id;
+    std::string label;
+    char kind = 'M';
+    bool dropdown = false;
+    bool hidden = false;
+    bool operator==(const Command&) const = default;
+};
+
+struct Group
+{
+    std::string id;
+    std::string label;
+    bool custom = false;
+    bool hidden = false;
+    std::vector<Command> commands;
+    bool operator==(const Group&) const = default;
+};
+
+struct Tab
+{
+    std::string id;
+    std::string label;
+    bool custom = false;
+    std::vector<Group> groups;
+    bool operator==(const Tab&) const = default;
+};
+
+struct Layout
+{
+    std::vector<Tab> tabs;
+    bool operator==(const Layout&) const = default;
+
+    const Tab* findTab(std::string_view aId) const;
+    /// the first tab and group (in tab order) that show the command, nullptr when none does
+    const Tab* homeOf(std::string_view aCommand, const Group** ppGroup = nullptr) const;
+    /// the command as the default layout knows it (its kind, its ▾), the first occurrence
+    const Command* findCommand(std::string_view aCommand) const;
+};
+
+/// the customization file's entries, as read (see the file comment)
+struct CommandEntry
+{
+    std::string id;
+    bool hidden = false;
+    bool operator==(const CommandEntry&) const = default;
+};
+
+struct GroupEntry
+{
+    std::string id;
+    bool custom = false;
+    std::string label;
+    bool hidden = false;
+    std::vector<CommandEntry> commands;
+    bool operator==(const GroupEntry&) const = default;
+};
+
+struct TabEntry
+{
+    std::string id;
+    bool custom = false;
+    std::string label;
+    std::string after; // custom tabs: the tab it follows ("" = first)
+    std::vector<GroupEntry> groups;
+    bool operator==(const TabEntry&) const = default;
+};
+
+struct Customization
+{
+    std::vector<TabEntry> tabs;
+    bool empty() const { return tabs.empty(); }
+    bool operator==(const Customization&) const = default;
+};
+
+/// limits of a customization: what goes beyond is skipped
+constexpr std::size_t MAX_CUSTOM_TABS = 20;
+constexpr std::size_t MAX_GROUPS_PER_TAB = 40;
+constexpr std::size_t MAX_COMMANDS_PER_GROUP = 60;
+constexpr std::size_t MAX_LABEL_BYTES = 120;
+constexpr std::size_t MAX_ID_BYTES = 200;
+
+/// a command a custom group may hold: ".uno:Name" with an optional "?arg" part, printable, at most MAX_ID_BYTES
+bool isValidCommandId(std::string_view aId);
+/// a command added to a custom group: its label, kind (a box or gallery keeps it, a button is M) and ▾ as the
+/// default layout shows it, else just its id (the adapter labels it)
+Command customCommand(const Layout& rDefaults, std::string_view aId);
+/// a label trimmed, without control characters, at most MAX_LABEL_BYTES (cut at a UTF-8 boundary)
+std::string cleanLabel(std::string_view aLabel);
+
+/// reads a customization file; never fails: a malformed document or entry is skipped (rWarnings says what)
+Customization parseCustomization(std::string_view aJson, std::vector<std::string>* pWarnings = nullptr);
+/// the file of rCustom for the app (pretty-printed UTF-8 JSON)
+std::string writeCustomization(const Customization& rCustom, std::string_view aApp);
+
+/// the ribbon the user sees: rDefaults with rCustom applied (the merge rules above)
+Layout merge(const Layout& rDefaults, const Customization& rCustom);
+/// what rEffective changes against rDefaults: built-in tabs that differ (in full) and every custom tab, so that
+/// merge(rDefaults, diff(rDefaults, rEffective)) == rEffective
+Customization diff(const Layout& rDefaults, const Layout& rEffective);
+
+/// the export file of a school or office: the customization of several apps in one document
+///   { "format": "hst-ribbon-customization-bundle", "version": 1, "apps": { "writer": { <customization> }, ... } }
+std::string writeBundle(const std::map<std::string, Customization>& rApps);
+/// nullopt when the text is not a bundle (an app's single customization file is accepted as a bundle of that app)
+std::optional<std::map<std::string, Customization>> parseBundle(std::string_view aJson,
+                                                                 std::vector<std::string>* pWarnings = nullptr);
+
+/// the apps a customization or the usage history belongs to
+bool isKnownApp(std::string_view aApp);
+}
+
