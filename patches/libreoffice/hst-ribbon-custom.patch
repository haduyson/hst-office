+
+void CustomizeDialog::FillRibbonCatalog()
+{
+    // the commands of the default ribbon, each once (menu buttons and boxes without a command are left out)
+    std::set<std::string> aSeen;
+    for (const core::Tab& rTab : m_aDefaults.tabs)
+        for (const core::Group& rGroup : rTab.groups)
+            for (const core::Command& rCommand : rGroup.commands)
+                if (core::isValidCommandId(rCommand.id) && aSeen.insert(rCommand.id).second)
+                {
+                    const OUString aLabel = CommandLabel(rCommand);
+                    m_aRibbonCatalog.push_back({ FromUtf8(rCommand.id), aLabel, Fold(aLabel) });
+                }
+    SortByLabel(m_aRibbonCatalog);
+}
+
+void CustomizeDialog::FillAllCatalog()
+{
+    // every command the frame's dispatch providers offer for configuration, filled when first chosen
+    if (m_bAllFilled)
+        return;
+    m_bAllFilled = true;
+    try
+    {
+        const css::uno::Reference<css::frame::XDispatchInformationProvider> xProvider(m_xFrame,
+                                                                                    css::uno::UNO_QUERY);
+        if (!xProvider.is())
+            return;
+        std::set<OUString> aAll;
+        for (const sal_Int16 nGroup : xProvider->getSupportedCommandGroups())
+            for (const css::frame::DispatchInformation& rInfo : xProvider->getConfigurableDispatchInformation(nGroup))
+                aAll.insert(rInfo.Command.getToken(0, '?'));
+        for (const OUString& rCommand : aAll)
+        {
+            if (!core::isValidCommandId(ToUtf8(rCommand)))
+                continue;
+            const OUString aLabel = vcl::CommandInfoProvider::GetLabelForCommand(
+                                        vcl::CommandInfoProvider::GetCommandProperties(rCommand, m_aModule))
+                                        .replaceAll("~", "");
+            if (!aLabel.isEmpty())
+                m_aAllCatalog.push_back({ rCommand, aLabel, Fold(aLabel) });
+        }
+        SortByLabel(m_aAllCatalog);
+    }
+    catch (const css::uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("sfx.notebookbar", "HST ribbon dialog: the list of all commands is not available");
+    }
+}
+
+void CustomizeDialog::FillCommands()
+{
+    const std::vector<CatalogEntry>& rCatalog = m_xSource->get_active() == 1 ? m_aAllCatalog : m_aRibbonCatalog;
+    const OUString aFilter = Fold(m_xSearch->get_text().trim());
+    m_xCommands->freeze();
+    m_xCommands->clear();
+    for (const CatalogEntry& rEntry : rCatalog)
+        if (aFilter.isEmpty() || rEntry.key.indexOf(aFilter) >= 0)
+            m_xCommands->append(rEntry.command, rEntry.label);
+    m_xCommands->thaw();
+    if (m_xCommands->n_children())
+        m_xCommands->select(0);
+    UpdateButtons(false);
+}
+
+void CustomizeDialog::FillRibbon(const core::Path& rSelect)
+{
+    m_bFilling = true;
+    m_xRibbon->freeze();
+    m_xRibbon->clear();
+    std::unique_ptr<weld::TreeIter> xTab = m_xRibbon->make_iterator();
+    std::unique_ptr<weld::TreeIter> xGroup = m_xRibbon->make_iterator();
+    std::unique_ptr<weld::TreeIter> xCommand = m_xRibbon->make_iterator();
+    const auto label = [](const OUString& rText, bool bCustom) {
+        return bCustom ? SfxResId(STR_HST_RIBBON_CUSTOM).replaceFirst("%1", rText) : rText;
+    };
+    for (std::size_t t = 0; t < m_aLayout.tabs.size(); ++t)
+    {
+        const core::Tab& rTab = m_aLayout.tabs[t];
+        const core::Path aTabPath{ int(t) };
+        const OUString aTabText = label(FromUtf8(rTab.label), rTab.custom);
+        const OUString aTabId = PathId(aTabPath);
+        m_xRibbon->insert(nullptr, -1, &aTabText, &aTabId, nullptr, nullptr, false, xTab.get());
+        // a tab is never hidden: its row has no check box
+        for (std::size_t g = 0; g < rTab.groups.size(); ++g)
+        {
+            const core::Group& rGroup = rTab.groups[g];
+            const OUString aGroupText = label(FromUtf8(rGroup.label), rGroup.custom);
+            const OUString aGroupId = PathId(core::Path{ int(t), int(g) });
+            m_xRibbon->insert(xTab.get(), -1, &aGroupText, &aGroupId, nullptr, nullptr, false, xGroup.get());
+            m_xRibbon->set_toggle(*xGroup, rGroup.hidden ? TRISTATE_FALSE : TRISTATE_TRUE);
+            for (std::size_t c = 0; c < rGroup.commands.size(); ++c)
+            {
+                const core::Command& rCommand = rGroup.commands[c];
+                const OUString aText = CommandLabel(rCommand);
+                const OUString aId = PathId(core::Path{ int(t), int(g), int(c) });
+                m_xRibbon->insert(xGroup.get(), -1, &aText, &aId, nullptr, nullptr, false, xCommand.get());
+                m_xRibbon->set_toggle(*xCommand, rCommand.hidden ? TRISTATE_FALSE : TRISTATE_TRUE);
+            }
+        }
+    }
+    m_xRibbon->thaw();
+    // the selection, with its tab (and group) open
+    const OUString aSelect = PathId(core::isValid(m_aLayout, rSelect) ? rSelect : core::Path{ 0 });
+    m_xRibbon->all_foreach([this, &aSelect](weld::TreeIter& rIter) {
+        const OUString aId = m_xRibbon->get_id(rIter);
+        if (aId != aSelect && !aSelect.startsWith(OUString(aId + ".")))
+            return false;
+        if (aId == aSelect)
+        {
+            m_xRibbon->set_cursor(rIter);
+            m_xRibbon->select(rIter);
+            m_xRibbon->scroll_to_row(rIter);
+            return true;
+        }
+        m_xRibbon->expand_row(rIter);
+        return false;
+    });
+    m_bFilling = false;
+    UpdateButtons();
+}
+
+core::Path CustomizeDialog::Selected() const
+{
+    std::unique_ptr<weld::TreeIter> xIter = m_xRibbon->get_selected();
+    if (!xIter)
+        return core::Path();
+    const core::Path aPath = PathOf(m_xRibbon->get_id(*xIter));
+    return core::isValid(m_aLayout, aPath) ? aPath : core::Path();
+}
+
+void CustomizeDialog::UpdateButtons(bool bName)
+{
+    const core::Path aPath = Selected();
+    const OUString aCommand = m_xCommands->get_selected_id();
+    m_xAdd->set_sensitive(core::canAddCommand(m_aLayout, aPath, ToUtf8(aCommand)));
+    m_xRemove->set_sensitive(core::canRemove(m_aLayout, aPath));
+    m_xUp->set_sensitive(core::canMove(m_aLayout, aPath, -1));
+    m_xDown->set_sensitive(core::canMove(m_aLayout, aPath, 1));
+    m_xNewGroup->set_sensitive(core::isValid(m_aLayout, aPath));
+    m_xResetTab->set_sensitive(core::canReset(m_aLayout, m_aDefaults, aPath));
+    m_xResetAll->set_sensitive(!(m_aLayout == m_aDefaults));
+    const bool bRename = core::canRename(m_aLayout, aPath);
+    m_xName->set_sensitive(bRename);
+    if (bName && !m_bFilling)
+    {
+        // the name field follows the selection (its own change handler must not rename anything)
+        m_bFilling = true;
+        if (!bRename)
+            m_xName->set_text(OUString());
+        else if (aPath.isTab())
+            m_xName->set_text(FromUtf8(m_aLayout.tabs[aPath.tab].label));
+        else
+            m_xName->set_text(FromUtf8(m_aLayout.tabs[aPath.tab].groups[aPath.group].label));
+        m_bFilling = false;
+    }
+}
+
+IMPL_LINK_NOARG(CustomizeDialog, SourceHdl, weld::ComboBox&, void)
+{
+    if (m_xSource->get_active() == 1)
+        FillAllCatalog();
+    FillCommands();
+}
+
+IMPL_LINK_NOARG(CustomizeDialog, SearchHdl, weld::Entry&, void) { FillCommands(); }
+
+IMPL_LINK_NOARG(CustomizeDialog, SelectHdl, weld::ItemView&, void)
+{
+    if (!m_bFilling)
+        UpdateButtons();
+}
+
+IMPL_LINK_NOARG(CustomizeDialog, CommandSelectHdl, weld::ItemView&, void) { UpdateButtons(false); }
+
+IMPL_LINK(CustomizeDialog, ToggleHdl, const weld::TreeView::iter_col&, rRowCol, void)
+{
+    const core::Path aPath = PathOf(m_xRibbon->get_id(rRowCol.first));
+    if (!core::canHide(m_aLayout, aPath))
+    {
+        m_xRibbon->set_toggle(rRowCol.first, TRISTATE_TRUE);
+        return;
+    }
+    core::setHidden(m_aLayout, aPath, m_xRibbon->get_toggle(rRowCol.first) != TRISTATE_TRUE);
+    UpdateButtons(false);
+}
+
+IMPL_LINK_NOARG(CustomizeDialog, NameHdl, weld::Entry&, void)
+{
+    if (m_bFilling)
+        return;
+    const core::Path aPath = Selected();
+    if (!core::rename(m_aLayout, aPath, ToUtf8(m_xName->get_text())))
+        return;
+    // the row shows the new name at once
+    if (std::unique_ptr<weld::TreeIter> xIter = m_xRibbon->get_selected())
+        m_xRibbon->set_text(*xIter, SfxResId(STR_HST_RIBBON_CUSTOM).replaceFirst("%1", m_xName->get_text().trim()));
+    UpdateButtons(false);
+}
+
+IMPL_LINK(CustomizeDialog, ClickHdl, weld::Button&, rButton, void)
+{
+    const core::Path aPath = Selected();
+    std::optional<core::Path> aNext;
+    if (&rButton == m_xAdd.get())
+        aNext = core::addCommand(m_aLayout, m_aDefaults, aPath, ToUtf8(m_xCommands->get_selected_id()));
+    else if (&rButton == m_xRemove.get())
+        aNext = core::remove(m_aLayout, aPath);
+    else if (&rButton == m_xUp.get())
+        aNext = core::move(m_aLayout, aPath, -1);
+    else if (&rButton == m_xDown.get())
+        aNext = core::move(m_aLayout, aPath, 1);
+    else if (&rButton == m_xNewTab.get())
+    {
+        // "Của tôi", "Của tôi 2", ...: a name no tab has yet
+        const OUString aBase = SfxResId(STR_HST_RIBBON_NEW_TAB);
+        OUString aName = aBase;
+        for (int n = 2; std::any_of(m_aLayout.tabs.begin(), m_aLayout.tabs.end(),
+                                    [&aName](const core::Tab& r) { return FromUtf8(r.label) == aName; });
+             ++n)
+            aName = aBase + " " + OUString::number(n);
+        aNext = core::addCustomTab(m_aLayout, core::Path{ aPath.tab }, ToUtf8(aName),
+                                   ToUtf8(SfxResId(STR_HST_RIBBON_NEW_GROUP)));
+    }
+    else if (&rButton == m_xNewGroup.get())
+        aNext = core::addCustomGroup(m_aLayout, aPath, ToUtf8(SfxResId(STR_HST_RIBBON_NEW_GROUP)));
+    else if (&rButton == m_xResetTab.get())
+    {
+        if (core::resetTab(m_aLayout, m_aDefaults, aPath))
+            aNext = core::Path{ aPath.tab };
+    }
+    else if (&rButton == m_xResetAll.get())
+    {
+        std::unique_ptr<weld::MessageDialog> xAsk(Application::CreateMessageDialog(
+            m_xDialog.get(), VclMessageType::Question, VclButtonsType::YesNo, SfxResId(STR_HST_RIBBON_RESET_ALL_ASK)));
+        if (xAsk->run() == RET_YES)
+        {
+            m_aLayout = m_aDefaults;
+            aNext = core::Path{ 0 };
+        }
+    }
+    else if (&rButton == m_xImport.get())
+        Import();
+    else if (&rButton == m_xExport.get())
+        Export();
+    if (aNext)
+        FillRibbon(*aNext);
+    UpdateButtons();
+}
+
+void CustomizeDialog::Import()
+{
+    sfx2::FileDialogHelper aPicker(css::ui::dialogs::TemplateDescription::FILEOPEN_SIMPLE, FileDialogFlags::NONE,
+                                   m_xDialog.get());
+    aPicker.AddFilter(SfxResId(STR_HST_RIBBON_FILTER), u"*.json"_ustr);
+    aPicker.SetCurrentFilter(SfxResId(STR_HST_RIBBON_FILTER));
+    if (aPicker.Execute() != ERRCODE_NONE)
+        return;
+    const std::optional<std::string> aText = ReadUrl(aPicker.GetPath());
+    std::vector<std::string> aWarnings;
+    const std::optional<std::map<std::string, core::Customization>> aApps
+        = aText ? core::parseBundle(*aText, &aWarnings) : std::nullopt;
+    if (!aApps)
+    {
+        std::unique_ptr<weld::MessageDialog> xError(Application::CreateMessageDialog(
+            m_xDialog.get(), VclMessageType::Error, VclButtonsType::Ok, SfxResId(STR_HST_RIBBON_IMPORT_FAILED)));
+        xError->run();
+        return;
+    }
+    for (const auto& [rApp, rCustom] : *aApps)
+    {
+        if (rApp == m_aApp)
+            m_aLayout = core::merge(m_aDefaults, rCustom);
+        else
+            m_aImported[rApp] = rCustom;
+    }
+    FillRibbon(core::Path{ 0 });
+    if (!aWarnings.empty())
+    {
+        std::unique_ptr<weld::MessageDialog> xInfo(Application::CreateMessageDialog(
+            m_xDialog.get(), VclMessageType::Info, VclButtonsType::Ok, SfxResId(STR_HST_RIBBON_IMPORT_SKIPPED)));
+        xInfo->run();
+    }
+}
+
+void CustomizeDialog::Export()
+{
+    sfx2::FileDialogHelper aPicker(css::ui::dialogs::TemplateDescription::FILESAVE_AUTOEXTENSION,
+                                   FileDialogFlags::NONE, m_xDialog.get());
+    aPicker.AddFilter(SfxResId(STR_HST_RIBBON_FILTER), u"*.json"_ustr);
+    aPicker.SetCurrentFilter(SfxResId(STR_HST_RIBBON_FILTER));
+    aPicker.SetFileName(u"hst-ribbon.json"_ustr);
+    if (aPicker.Execute() != ERRCODE_NONE)
+        return;
+    // every app's customization: this app's as edited here, the others' as saved (or imported)
+    std::map<std::string, core::Customization> aApps;
+    for (const char* pApp : { "writer", "calc", "impress", "draw" })
+    {
+        if (pApp == m_aApp)
+            aApps[pApp] = core::diff(m_aDefaults, m_aLayout);
+        else if (m_aImported.count(pApp))
+            aApps[pApp] = m_aImported[pApp];
+        else if (const std::optional<std::string> aText = ReadProfileFile(AppFile(pApp)))
+            aApps[pApp] = core::parseCustomization(*aText);
+    }
+    if (!WriteUrl(aPicker.GetPath(), core::writeBundle(aApps)))
+    {
+        std::unique_ptr<weld::MessageDialog> xError(Application::CreateMessageDialog(
+            m_xDialog.get(), VclMessageType::Error, VclButtonsType::Ok, SfxResId(STR_HST_RIBBON_EXPORT_FAILED)));
+        xError->run();
+    }
+}
+
+bool CustomizeDialog::Save()
+{
+    std::set<std::string> aChanged;
+    const auto store = [&aChanged](const std::string& rApp, const core::Customization& rCustom) {
+        const bool bWritten = rCustom.empty() ? RemoveProfileFile(AppFile(rApp))
+                                              : WriteProfileFile(AppFile(rApp), core::writeCustomization(rCustom, rApp));
+        if (bWritten)
+            aChanged.insert(rApp);
+        return bWritten;
+    };
+    bool bOk = store(m_aApp, core::diff(m_aDefaults, m_aLayout));
+    for (const auto& [rApp, rCustom] : m_aImported)
+        bOk = store(rApp, rCustom) && bOk;
+    for (const std::string& rApp : aChanged)
+        RibbonController::ReloadApp(rApp);
+    return bOk;
+}
+}
+
+void OpenCustomizeDialog(RibbonController& rController, weld::Window* pParent)
+{
+    try
+    {
+        CustomizeDialog aDialog(pParent, rController);
+        if (aDialog.run() == RET_OK && !aDialog.Save())
+        {
+            std::unique_ptr<weld::MessageDialog> xError(Application::CreateMessageDialog(
+                pParent, VclMessageType::Error, VclButtonsType::Ok, SfxResId(STR_HST_RIBBON_SAVE_FAILED)));
+            xError->run();
+        }
+    }
+    catch (const css::uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("sfx.notebookbar", "HST ribbon: the customize dialog failed");
+    }
+}
+}
