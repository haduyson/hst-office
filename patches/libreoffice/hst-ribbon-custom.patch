+    : GenericDialogController(pParent, u"sfx/ui/hstribboncustomizedialog.ui"_ustr, u"HstRibbonCustomizeDialog"_ustr)
+    , m_aApp(rController.App())
+    , m_xFrame(rController.Frame())
+    , m_aDefaults(rController.Defaults())
+    , m_aLayout(rController.Effective())
+    , m_xSource(m_xBuilder->weld_combo_box(u"source"_ustr))
+    , m_xSearch(m_xBuilder->weld_entry(u"search"_ustr))
+    , m_xCommands(m_xBuilder->weld_tree_view(u"commands"_ustr))
+    , m_xAdd(m_xBuilder->weld_button(u"add"_ustr))
+    , m_xRemove(m_xBuilder->weld_button(u"remove"_ustr))
+    , m_xUp(m_xBuilder->weld_button(u"up"_ustr))
+    , m_xDown(m_xBuilder->weld_button(u"down"_ustr))
+    , m_xNewTab(m_xBuilder->weld_button(u"newtab"_ustr))
+    , m_xNewGroup(m_xBuilder->weld_button(u"newgroup"_ustr))
+    , m_xResetTab(m_xBuilder->weld_button(u"resettab"_ustr))
+    , m_xResetAll(m_xBuilder->weld_button(u"resetall"_ustr))
+    , m_xImport(m_xBuilder->weld_button(u"import"_ustr))
+    , m_xExport(m_xBuilder->weld_button(u"export"_ustr))
