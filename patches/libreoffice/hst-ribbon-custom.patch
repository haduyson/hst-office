+    void testSwitchingOffKeepsTheHistory()
+    {
+        // the profile folder: name -> text
+        std::map<std::string, std::string> aProfile;
+        const UsageStore::Files aFiles{
+            [&aProfile](const std::string& rName) -> std::optional<std::string> {
+                const auto it = aProfile.find(rName);
+                return it == aProfile.end() ? std::nullopt : std::optional<std::string>(it->second);
+            },
+            [&aProfile](const std::string& rName, const std::string& rText) {
+                aProfile[rName] = rText;
+                return true;
+            },
+            [&aProfile](const std::string& rName) { return aProfile.erase(rName) == 1; }
+        };
+        const Day nToday = 20000;
+        UsageStore aStore(aFiles);
+        CPPUNIT_ASSERT(aStore.recentEnabled());
+        CPPUNIT_ASSERT(aStore.record("writer", ".uno:Bold", nToday));
+        CPPUNIT_ASSERT(aStore.record("calc", ".uno:AutoSum", nToday));
+        aStore.flush(nToday);
+        CPPUNIT_ASSERT_EQUAL(std::size_t(1), aProfile.count(UsageStore::usageFile("writer")));
+
+        // off: nothing is recorded, every history stays in memory and in the profile
+        const unsigned nRevision = aStore.revision("writer");
+        aStore.setRecentEnabled(false);
+        CPPUNIT_ASSERT(!aStore.recentEnabled());
+        CPPUNIT_ASSERT(!aStore.record("writer", ".uno:Italic", nToday));
+        CPPUNIT_ASSERT_EQUAL(nRevision, aStore.revision("writer"));
+        aStore.flush(nToday);
+        CPPUNIT_ASSERT_EQUAL(std::size_t(1), aProfile.count(UsageStore::usageFile("writer")));
+        CPPUNIT_ASSERT_EQUAL(std::size_t(1), aProfile.count(UsageStore::usageFile("calc")));
+        CPPUNIT_ASSERT(std::vector<std::string>{ ".uno:Bold" } == aStore.ranked("writer", nToday, 10));
+
+        // the next start reads the switch and the same history
+        UsageStore aNextStart(aFiles);
+        CPPUNIT_ASSERT(!aNextStart.recentEnabled());
+        aNextStart.setRecentEnabled(true);
+        CPPUNIT_ASSERT(std::vector<std::string>{ ".uno:Bold" } == aNextStart.ranked("writer", nToday + 1, 10));
+        CPPUNIT_ASSERT(std::vector<std::string>{ ".uno:AutoSum" } == aNextStart.ranked("calc", nToday + 1, 10));
+        CPPUNIT_ASSERT(aNextStart.record("writer", ".uno:Italic", nToday + 1));
+        CPPUNIT_ASSERT_EQUAL(std::size_t(2), aNextStart.ranked("writer", nToday + 1, 10).size());
+
+        // only "Xóa lịch sử" forgets: memory and profile, every app
+        CPPUNIT_ASSERT(aNextStart.clearAll().empty());
+        CPPUNIT_ASSERT(aNextStart.ranked("writer", nToday + 1, 10).empty());
+        CPPUNIT_ASSERT(aNextStart.ranked("calc", nToday + 1, 10).empty());
+        CPPUNIT_ASSERT_EQUAL(std::size_t(0), aProfile.count(UsageStore::usageFile("writer")));
+        CPPUNIT_ASSERT_EQUAL(std::size_t(0), aProfile.count(UsageStore::usageFile("calc")));
+        CPPUNIT_ASSERT_EQUAL(std::size_t(1), aProfile.count("settings.json"));
+    }
