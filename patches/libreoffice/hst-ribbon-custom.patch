+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ */
+
+#include "ribbon-layout-edit.hxx"
+
+#include <algorithm>
+#include <set>
+#include <utility>
+
+namespace hst::ribbon::core
+{
+namespace
+{
+template <typename T> bool inRange(const std::vector<T>& rItems, int n)
+{
+    return n >= 0 && static_cast<std::size_t>(n) < rItems.size();
+}
+
+Tab& tabOf(Layout& r, const Path& p) { return r.tabs[p.tab]; }
+Group& groupOf(Layout& r, const Path& p) { return r.tabs[p.tab].groups[p.group]; }
+const Group& groupOf(const Layout& r, const Path& p) { return r.tabs[p.tab].groups[p.group]; }
+
+template <typename T> std::optional<int> moved(std::vector<T>& rItems, int n, int nDelta)
+{
+    const int nTo = n + nDelta;
+    if (nDelta == 0 || !inRange(rItems, n) || !inRange(rItems, nTo))
+        return std::nullopt;
+    T aItem = std::move(rItems[n]);
+    rItems.erase(rItems.begin() + n);
+    rItems.insert(rItems.begin() + nTo, std::move(aItem));
+    return nTo;
+}
+}
+
+bool isValid(const Layout& rLayout, const Path& rPath)
+{
+    if (!inRange(rLayout.tabs, rPath.tab))
+        return false;
+    if (rPath.group < 0)
+        return rPath.command < 0;
+    const Tab& rTab = rLayout.tabs[rPath.tab];
+    if (!inRange(rTab.groups, rPath.group))
+        return false;
+    return rPath.command < 0 || inRange(rTab.groups[rPath.group].commands, rPath.command);
+}
+
+bool isCustom(const Layout& rLayout, const Path& rPath)
+{
+    if (!isValid(rLayout, rPath))
+        return false;
+    if (rPath.isTab())
+        return rLayout.tabs[rPath.tab].custom;
+    return groupOf(rLayout, rPath).custom;
+}
+
+bool canMove(const Layout& rLayout, const Path& rPath, int nDelta)
+{
+    if (!isValid(rLayout, rPath) || nDelta == 0)
+        return false;
+    if (rPath.isTab())
+        return rLayout.tabs[rPath.tab].custom && inRange(rLayout.tabs, rPath.tab + nDelta);
+    if (rPath.isGroup())
+        return inRange(rLayout.tabs[rPath.tab].groups, rPath.group + nDelta);
+    return inRange(groupOf(rLayout, rPath).commands, rPath.command + nDelta);
+}
+
+std::optional<Path> move(Layout& rLayout, const Path& rPath, int nDelta)
+{
+    if (!canMove(rLayout, rPath, nDelta))
+        return std::nullopt;
+    Path aPath = rPath;
+    if (rPath.isTab())
+        aPath.tab = *moved(rLayout.tabs, rPath.tab, nDelta);
+    else if (rPath.isGroup())
+        aPath.group = *moved(tabOf(rLayout, rPath).groups, rPath.group, nDelta);
+    else
+        aPath.command = *moved(groupOf(rLayout, rPath).commands, rPath.command, nDelta);
+    return aPath;
+}
+
+bool canHide(const Layout& rLayout, const Path& rPath) { return isValid(rLayout, rPath) && !rPath.isTab(); }
+
+bool setHidden(Layout& rLayout, const Path& rPath, bool bHidden)
+{
+    if (!canHide(rLayout, rPath))
+        return false;
+    if (rPath.isGroup())
+        groupOf(rLayout, rPath).hidden = bHidden;
+    else
+        groupOf(rLayout, rPath).commands[rPath.command].hidden = bHidden;
+    return true;
+}
+
+bool isHidden(const Layout& rLayout, const Path& rPath)
+{
+    if (!canHide(rLayout, rPath))
+        return false;
+    if (rPath.isGroup())
+        return groupOf(rLayout, rPath).hidden;
+    return groupOf(rLayout, rPath).commands[rPath.command].hidden;
+}
+
+bool canRename(const Layout& rLayout, const Path& rPath)
+{
+    return isCustom(rLayout, rPath) && !rPath.isCommand();
+}
+
+bool rename(Layout& rLayout, const Path& rPath, std::string_view aLabel)
+{
+    const std::string aClean = cleanLabel(aLabel);
+    if (!canRename(rLayout, rPath) || aClean.empty())
+        return false;
+    if (rPath.isTab())
+        tabOf(rLayout, rPath).label = aClean;
+    else
+        groupOf(rLayout, rPath).label = aClean;
+    return true;
+}
+
+bool canRemove(const Layout& rLayout, const Path& rPath) { return isCustom(rLayout, rPath); }
+
+std::optional<Path> remove(Layout& rLayout, const Path& rPath)
+{
+    if (!canRemove(rLayout, rPath))
+        return std::nullopt;
+    Path aNext = rPath;
+    if (rPath.isTab())
+    {
+        rLayout.tabs.erase(rLayout.tabs.begin() + rPath.tab);
+        aNext.tab = std::min<int>(rPath.tab, static_cast<int>(rLayout.tabs.size()) - 1);
+        if (aNext.tab < 0)
+            return Path();
+        return aNext;
+    }
+    if (rPath.isGroup())
+    {
+        std::vector<Group>& rGroups = tabOf(rLayout, rPath).groups;
+        rGroups.erase(rGroups.begin() + rPath.group);
+        aNext.group = std::min<int>(rPath.group, static_cast<int>(rGroups.size()) - 1);
+        return aNext; // the tab itself when it has no group left
+    }
+    std::vector<Command>& rCommands = groupOf(rLayout, rPath).commands;
+    rCommands.erase(rCommands.begin() + rPath.command);
+    aNext.command = std::min<int>(rPath.command, static_cast<int>(rCommands.size()) - 1);
+    return aNext;
+}
+
+std::optional<Path> addCustomTab(Layout& rLayout, const Path& rSelected, std::string_view aTabLabel,
+                                 std::string_view aGroupLabel)
+{
+    const auto nCustom = static_cast<std::size_t>(
+        std::count_if(rLayout.tabs.begin(), rLayout.tabs.end(), [](const Tab& r) { return r.custom; }));
+    const std::string aTabClean = cleanLabel(aTabLabel), aGroupClean = cleanLabel(aGroupLabel);
+    if (nCustom >= MAX_CUSTOM_TABS || aTabClean.empty() || aGroupClean.empty())
+        return std::nullopt;
+    Tab aTab;
+    aTab.id = newId(rLayout, "hst-tab-");
+    aTab.label = aTabClean;
+    aTab.custom = true;
+    const int nAt = inRange(rLayout.tabs, rSelected.tab) ? rSelected.tab + 1 : static_cast<int>(rLayout.tabs.size());
+    rLayout.tabs.insert(rLayout.tabs.begin() + nAt, std::move(aTab));
+    Group aGroup;
+    aGroup.id = newId(rLayout, "hst-group-");
+    aGroup.label = aGroupClean;
+    aGroup.custom = true;
+    rLayout.tabs[nAt].groups.push_back(std::move(aGroup));
+    return Path{ nAt, 0, -1 };
+}
+
+std::optional<Path> addCustomGroup(Layout& rLayout, const Path& rSelected, std::string_view aLabel)
+{
+    const std::string aClean = cleanLabel(aLabel);
+    if (!inRange(rLayout.tabs, rSelected.tab) || aClean.empty())
+        return std::nullopt;
+    std::vector<Group>& rGroups = rLayout.tabs[rSelected.tab].groups;
+    if (rGroups.size() >= MAX_GROUPS_PER_TAB)
+        return std::nullopt;
+    Group aGroup;
+    aGroup.id = newId(rLayout, "hst-group-");
+    aGroup.label = aClean;
+    aGroup.custom = true;
+    const int nAt = inRange(rGroups, rSelected.group) ? rSelected.group + 1 : static_cast<int>(rGroups.size());
+    rGroups.insert(rGroups.begin() + nAt, std::move(aGroup));
+    return Path{ rSelected.tab, nAt, -1 };
+}
+
+bool canAddCommand(const Layout& rLayout, const Path& rSelected, std::string_view aCommand)
+{
+    if (!isValid(rLayout, rSelected) || rSelected.isTab() || !isValidCommandId(aCommand))
+        return false;
+    const Group& rGroup = groupOf(rLayout, rSelected);
+    return rGroup.custom && rGroup.commands.size() < MAX_COMMANDS_PER_GROUP
+           && std::none_of(rGroup.commands.begin(), rGroup.commands.end(),
+                           [&](const Command& r) { return r.id == aCommand; });
+}
+
+std::optional<Path> addCommand(Layout& rLayout, const Layout& rDefaults, const Path& rSelected,
+                               std::string_view aCommand)
+{
+    if (!canAddCommand(rLayout, rSelected, aCommand))
+        return std::nullopt;
+    std::vector<Command>& rCommands = groupOf(rLayout, rSelected).commands;
+    const int nAt = rSelected.isCommand() ? rSelected.command + 1 : static_cast<int>(rCommands.size());
+    rCommands.insert(rCommands.begin() + nAt, customCommand(rDefaults, aCommand));
+    return Path{ rSelected.tab, rSelected.group, nAt };
+}
+
+bool canReset(const Layout& rLayout, const Layout& rDefaults, const Path& rSelected)
+{
+    if (!isValid(rLayout, rSelected) || rLayout.tabs[rSelected.tab].custom)
+        return false;
+    const Tab* pDefault = rDefaults.findTab(rLayout.tabs[rSelected.tab].id);
+    return pDefault && !(*pDefault == rLayout.tabs[rSelected.tab]);
+}
+
+bool resetTab(Layout& rLayout, const Layout& rDefaults, const Path& rSelected)
+{
+    if (!canReset(rLayout, rDefaults, rSelected))
+        return false;
+    rLayout.tabs[rSelected.tab] = *rDefaults.findTab(rLayout.tabs[rSelected.tab].id);
+    return true;
+}
+
+std::string newId(const Layout& rLayout, std::string_view aPrefix)
+{
+    std::set<std::string> aUsed;
+    for (const Tab& rTab : rLayout.tabs)
+    {
+        aUsed.insert(rTab.id);
+        for (const Group& rGroup : rTab.groups)
+            aUsed.insert(rGroup.id);
+    }
+    for (int n = 1;; ++n)
+    {
+        std::string aId = std::string(aPrefix) + std::to_string(n);
+        if (!aUsed.count(aId))
+            return aId;
+    }
+}
+}
+
