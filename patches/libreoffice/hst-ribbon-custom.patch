+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ */
+
+#include "ribbon-recent-plan.hxx"
+
+#include <algorithm>
+#include <map>
+#include <set>
+
+namespace hst::ribbon::core
+{
+std::vector<RecentGroup> planRecentGroups(const std::vector<std::string>& rRanked, const Layout& rDefaults,
+                                          std::size_t nMaxCommands, std::string_view aOtherLabel)
+{
+    // the home tab's position, or the tab count for "other"
+    std::map<std::size_t, RecentGroup> aByTab;
+    std::set<std::string> aSeen;
+    std::size_t nRank = 0;
+    for (const std::string& rCommand : rRanked)
+    {
+        if (nRank >= nMaxCommands)
+            break;
+        if (!isValidCommandId(rCommand) || !aSeen.insert(rCommand).second)
+            continue;
+        const Tab* pHome = rDefaults.homeOf(rCommand);
+        const std::size_t nTab = pHome ? static_cast<std::size_t>(pHome - rDefaults.tabs.data()) : rDefaults.tabs.size();
+        RecentGroup& rGroup = aByTab[nTab];
+        if (rGroup.id.empty())
+        {
+            rGroup.id = pHome ? "hst-recent-" + pHome->id : std::string("hst-recent-other");
+            rGroup.label = pHome ? pHome->label : std::string(aOtherLabel);
+        }
+        RecentCommand aCommand;
+        aCommand.id = rCommand;
+        aCommand.rank = nRank++;
+        if (const Command* pKnown = rDefaults.findCommand(rCommand))
+        {
+            aCommand.kind = pKnown->kind == 'W' || pKnown->kind == 'G' ? pKnown->kind : 'M';
+            aCommand.dropdown = pKnown->dropdown;
+        }
+        rGroup.commands.push_back(std::move(aCommand));
+    }
+    std::vector<RecentGroup> aGroups;
+    for (auto& rEntry : aByTab)
+        aGroups.push_back(std::move(rEntry.second));
+    return aGroups;
+}
+
+std::string groupKinds(const std::vector<char>& rKinds)
+{
+    std::string aKinds;
+    for (const char c : rKinds)
+        aKinds += c == 'W' || c == 'G' ? c : 'M';
+    if (aKinds == "M")
+        aKinds = "L";
+    return aKinds;
+}
+
+bool dropLeastUsed(std::vector<RecentGroup>& rGroups)
+{
+    RecentGroup* pGroup = nullptr;
+    std::size_t nCommand = 0, nWorst = 0;
+    for (RecentGroup& rGroup : rGroups)
+        for (std::size_t i = 0; i < rGroup.commands.size(); ++i)
+            if (!pGroup || rGroup.commands[i].rank >= nWorst)
+            {
+                pGroup = &rGroup;
+                nCommand = i;
+                nWorst = rGroup.commands[i].rank;
+            }
+    if (!pGroup)
+        return false;
+    pGroup->commands.erase(pGroup->commands.begin() + nCommand);
+    rGroups.erase(std::remove_if(rGroups.begin(), rGroups.end(), [](const RecentGroup& r) { return r.commands.empty(); }),
+                  rGroups.end());
+    return true;
+}
+}
