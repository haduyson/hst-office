+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ */
+
+#pragma once
+
+// HST Office ribbon core: a small JSON value with a strict parser and a writer, enough for the ribbon's own files
+// (customization, usage history, settings). Standard C++ only; strings are UTF-8. The parser never throws: a broken
+// document gives an empty optional, so a bad profile file falls back to the defaults.
+
+#include <cstdint>
+#include <map>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace hst::ribbon::core
+{
+class Json
+{
+public:
+    enum class Type
+    {
+        Null,
+        Bool,
+        Number,
+        String,
+        Array,
+        Object
+    };
+
+    Json() = default;
+    static Json boolean(bool b);
+    static Json number(double f);
+    static Json string(std::string s);
+    static Json array();
+    static Json object();
+
+    Type type() const { return m_eType; }
+    bool isObject() const { return m_eType == Type::Object; }
+    bool isArray() const { return m_eType == Type::Array; }
+    bool isString() const { return m_eType == Type::String; }
+
+    /// typed reads with a fallback for a missing member or another type
+    bool asBool(bool bDefault = false) const { return m_eType == Type::Bool ? m_bValue : bDefault; }
+    double asNumber(double fDefault = 0) const { return m_eType == Type::Number ? m_fValue : fDefault; }
+    std::int64_t asInt(std::int64_t nDefault = 0) const;
+    const std::string& asString() const { return m_aString; }
+
+    /// array access (empty for another type)
+    const std::vector<Json>& items() const { return m_aItems; }
+    void push(Json aItem);
+
+    /// object access in insertion order; get() returns a null value for a missing member
+    const Json& get(std::string_view aKey) const;
+    bool has(std::string_view aKey) const;
+    void set(std::string aKey, Json aValue);
+    const std::vector<std::pair<std::string, Json>>& members() const { return m_aMembers; }
+
+    /// strict RFC 8259 parsing (nesting at most 64 deep); nullopt for anything malformed
+    static std::optional<Json> parse(std::string_view aText);
+    /// compact UTF-8 output; bPretty: two-space indented
+    std::string write(bool bPretty = false) const;
+
+private:
+    void writeTo(std::string& rOut, bool bPretty, int nDepth) const;
+
+    Type m_eType = Type::Null;
+    bool m_bValue = false;
+    double m_fValue = 0;
+    std::string m_aString;
+    std::vector<Json> m_aItems;
+    std::vector<std::pair<std::string, Json>> m_aMembers;
+};
+
+/// the string with JSON escapes (no quotes around it)
+std::string jsonEscape(std::string_view aText);
+}
