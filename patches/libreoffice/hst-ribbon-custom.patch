+using namespace hst::ribbon::core;
+
+namespace
+{
+Command cmd(std::string aId, char cKind = 'S')
+{
+    Command a;
+    a.id = std::move(aId);
+    a.label = a.id.substr(5);
+    a.kind = cKind;
+    return a;
+}
+
+/// Home (Clipboard: Paste Cut Copy; Font: FontName Bold Italic), Insert (Tables: InsertTable), View (Zoom: Zoom100)
+Layout defaults()
+{
+    Layout aLayout;
+    Tab aHome{ "HomeLabel", "Trang đầu", false, {} };
+    aHome.groups.push_back(
+        Group{ "gdClipboard", "Bảng tạm", false, false, { cmd(".uno:Paste", 'L'), cmd(".uno:Cut"), cmd(".uno:Copy") } });
+    aHome.groups.push_back(Group{ "gdFont", "Phông chữ", false, false,
+                                  { cmd(".uno:CharFontName", 'W'), cmd(".uno:Bold"), cmd(".uno:Italic") } });
+    Tab aInsert{ "InsertLabel", "Chèn", false, {} };
+    aInsert.groups.push_back(Group{ "gdTables", "Bảng", false, false, { cmd(".uno:InsertTable", 'L') } });
+    Tab aView{ "ViewLabel", "Xem", false, {} };
+    aView.groups.push_back(Group{ "gdZoom", "Thu phóng", false, false, { cmd(".uno:Zoom100Percent", 'L') } });
+    aLayout.tabs = { aHome, aInsert, aView };
+    return aLayout;
+}
+
+std::vector<std::string> ids(const Group& rGroup)
+{
+    std::vector<std::string> a;
+    for (const Command& r : rGroup.commands)
+        a.push_back(r.id + (r.hidden ? "-" : ""));
+    return a;
+}
+
+std::vector<std::string> tabIds(const Layout& rLayout)
+{
+    std::vector<std::string> a;
+    for (const Tab& r : rLayout.tabs)
+        a.push_back(r.id);
+    return a;
+}
+
+using Strings = std::vector<std::string>;
+}
+
+class RibbonCoreTest : public CppUnit::TestFixture
+{
+public:
+    void testJsonRoundTrip()
+    {
+        const std::string aText = R"({"a":[1,2.5,-3e2,true,false,null],"b":"x\"\\\n\u00e9\ud83d\ude00","c":{}})";
+        const std::optional<Json> aJson = Json::parse(aText);
+        CPPUNIT_ASSERT(aJson);
+        CPPUNIT_ASSERT_EQUAL(std::string("x\"\\\n\xC3\xA9\xF0\x9F\x98\x80"), aJson->get("b").asString());
+        CPPUNIT_ASSERT_EQUAL(std::int64_t(-300), aJson->get("a").items()[2].asInt());
+        const std::optional<Json> aAgain = Json::parse(aJson->write());
+        CPPUNIT_ASSERT(aAgain);
+        CPPUNIT_ASSERT_EQUAL(aJson->write(), aAgain->write());
+        CPPUNIT_ASSERT_EQUAL(aJson->write(), Json::parse(aJson->write(true))->write());
+    }
+
+    void testJsonRejectsMalformed()
+    {
+        for (const char* p : { "", "{", "{\"a\":}", "[1,]", "{\"a\" 1}", "01", "1.", "\"\\x\"", "\"\x01\"", "[1] 2",
+                               "{'a':1}", "\"\\ud800\"", "nul", "1e", "--1" })
+            CPPUNIT_ASSERT_MESSAGE(p, !Json::parse(p));
+        std::string aDeep(100, '[');
+        aDeep += std::string(100, ']');
+        CPPUNIT_ASSERT(!Json::parse(aDeep));
+        CPPUNIT_ASSERT(Json::parse("\xEF\xBB\xBF{}")); // a byte order mark
+    }
+
+    void testMergeEmptyIsDefault()
+    {
+        CPPUNIT_ASSERT(merge(defaults(), Customization()) == defaults());
+        CPPUNIT_ASSERT(merge(defaults(), parseCustomization("not json")) == defaults());
+        CPPUNIT_ASSERT(merge(defaults(), parseCustomization("{\"format\":\"other\",\"tabs\":[]}")) == defaults());
+        CPPUNIT_ASSERT(diff(defaults(), defaults()).empty());
+    }
+
+    void testMergeOrderHideAndFallback()
+    {
+        const char* const pJson = R"({"format":"hst-ribbon-customization","version":1,"app":"writer","tabs":[
+            {"id":"HomeLabel","groups":[
+                {"id":"gdFont","commands":[{"id":".uno:Italic"},{"id":".uno:Bold","hidden":true},{"id":".uno:Nope"},
+                                           {"id":".uno:Italic"}, 7]},
+                {"id":"gdUnknown"},
+                {"id":"gdClipboard","hidden":true},
+                {"id":"hst-group-1","custom":true,"label":"Của tôi","commands":[{"id":".uno:InsertTable"},
+                    {"id":"bad"},{"id":".uno:InsertTable"},{"id":".uno:Save"}]},
+                {"id":"hst-group-2","custom":true,"commands":[]}
+            ]},
+            {"id":"NoSuchTab","groups":[]},
+            {"id":"hst-tab-1","custom":true,"label":"  Của tôi  ","after":"InsertLabel","groups":[
+                {"id":"hst-group-3","custom":true,"label":"Nhóm","commands":[{"id":".uno:Zoom100Percent"}]},
+                {"id":"gdTables"}]},
+            {"id":"hst-tab-2","custom":true,"label":"Đầu","after":"","groups":[]},
+            {"id":"hst-tab-3","custom":true,"label":"Cuối","after":"Gone","groups":[]},
+            {"id":"hst-tab-1","custom":true,"label":"Trùng","groups":[]},
+            {"id":"HomeLabel","groups":[]}
+        ]})";
+        std::vector<std::string> aWarnings;
+        const Customization aCustom = parseCustomization(pJson, &aWarnings);
+        CPPUNIT_ASSERT(!aWarnings.empty());
+        const Layout aLayout = merge(defaults(), aCustom);
+        CPPUNIT_ASSERT(Strings({ "hst-tab-2", "HomeLabel", "InsertLabel", "hst-tab-1", "ViewLabel", "hst-tab-3" })
+                       == tabIds(aLayout));
+        const Tab& rHome = aLayout.tabs[1];
+        CPPUNIT_ASSERT_EQUAL(std::size_t(3), rHome.groups.size());
+        CPPUNIT_ASSERT_EQUAL(std::string("gdFont"), rHome.groups[0].id);
+        // the listed order, a hidden one, the unknown and the duplicate skipped, the unlisted default at the end
+        CPPUNIT_ASSERT(Strings({ ".uno:Italic", ".uno:Bold-", ".uno:CharFontName" }) == ids(rHome.groups[0]));
+        CPPUNIT_ASSERT(rHome.groups[1].hidden);
+        CPPUNIT_ASSERT_EQUAL(std::string("hst-group-1"), rHome.groups[2].id);
+        CPPUNIT_ASSERT(Strings({ ".uno:InsertTable", ".uno:Save" }) == ids(rHome.groups[2]));
+        // a custom command takes what the default ribbon knows of it
+        CPPUNIT_ASSERT_EQUAL('M', rHome.groups[2].commands[0].kind);
+        CPPUNIT_ASSERT_EQUAL(std::string("InsertTable"), rHome.groups[2].commands[0].label);
+        const Tab& rMine = aLayout.tabs[3];
+        CPPUNIT_ASSERT_EQUAL(std::string("Của tôi"), rMine.label);
+        CPPUNIT_ASSERT_EQUAL(std::size_t(1), rMine.groups.size()); // a built-in group cannot move to a custom tab
+        // the untouched tabs stay as they are
+        CPPUNIT_ASSERT(*defaults().findTab("InsertLabel") == aLayout.tabs[2]);
+    }
+
+    void testDiffRoundTrip()
+    {
+        const Layout aDefaults = defaults();
+        Layout aLayout = aDefaults;
+        std::optional<Path> aTab = addCustomTab(aLayout, Path{ 0 }, "Của tôi", "Nhóm mới");
+        CPPUNIT_ASSERT(aTab);
+        CPPUNIT_ASSERT(addCommand(aLayout, aDefaults, *aTab, ".uno:Bold"));
+        CPPUNIT_ASSERT(addCommand(aLayout, aDefaults, *aTab, ".uno:InsertHyperlinkDialog"));
+        CPPUNIT_ASSERT(move(aLayout, Path{ 0, 1 }, -1));
+        CPPUNIT_ASSERT(setHidden(aLayout, Path{ 0, 0, 1 }, true));
+        CPPUNIT_ASSERT(addCustomGroup(aLayout, Path{ 2, 0 }, "Thêm"));
+        const Customization aCustom = diff(aDefaults, aLayout);
+        CPPUNIT_ASSERT_EQUAL(std::size_t(3), aCustom.tabs.size()); // Home, the custom tab, Insert
+        CPPUNIT_ASSERT(merge(aDefaults, aCustom) == aLayout);
+        // the file and back
+        const std::string aFile = writeCustomization(aCustom, "writer");
+        CPPUNIT_ASSERT(parseCustomization(aFile) == aCustom);
+        CPPUNIT_ASSERT(merge(aDefaults, parseCustomization(aFile)) == aLayout);
+    }
+
+    void testBundleRoundTrip()
+    {
+        Layout aLayout = defaults();
+        addCustomTab(aLayout, Path{}, "Trường", "Hay dùng");
+        std::map<std::string, Customization> aApps{ { "writer", diff(defaults(), aLayout) },
+                                                   { "calc", Customization() },
+                                                   { "nonsense", diff(defaults(), aLayout) } };
+        const std::string aFile = writeBundle(aApps);
+        const auto aBack = parseBundle(aFile);
+        CPPUNIT_ASSERT(aBack);
+        CPPUNIT_ASSERT_EQUAL(std::size_t(2), aBack->size()); // an unknown app is never written
+        CPPUNIT_ASSERT(aBack->at("writer") == aApps["writer"]);
+        CPPUNIT_ASSERT(aBack->at("calc").empty());
+        // a single app's file is accepted; anything else is not
+        const auto aSingle = parseBundle(writeCustomization(aApps["writer"], "impress"));
+        CPPUNIT_ASSERT(aSingle && aSingle->count("impress"));
+        CPPUNIT_ASSERT(!parseBundle("{\"format\":\"hst-ribbon-customization\",\"app\":\"x\"}"));
+        CPPUNIT_ASSERT(!parseBundle("[]"));
+        CPPUNIT_ASSERT(!parseBundle("{\"format\":\"something\"}"));
+    }
+
+    void testEditRules()
+    {
+        const Layout aDefaults = defaults();
+        Layout aLayout = aDefaults;
+        // built-in items: no rename, no remove, no moving a built-in tab, no adding to a built-in group
+        CPPUNIT_ASSERT(!canRename(aLayout, Path{ 0 }));
+        CPPUNIT_ASSERT(!canRemove(aLayout, Path{ 0, 0 }));
+        CPPUNIT_ASSERT(!canMove(aLayout, Path{ 1 }, -1));
+        CPPUNIT_ASSERT(!canAddCommand(aLayout, Path{ 0, 0 }, ".uno:Save"));
+        CPPUNIT_ASSERT(!canMove(aLayout, Path{ 0, 0, 0 }, -1));
+        CPPUNIT_ASSERT(canMove(aLayout, Path{ 0, 0, 0 }, 1));
+        const std::optional<Path> aTab = addCustomTab(aLayout, Path{ 2 }, "Của tôi", "Nhóm");
+        CPPUNIT_ASSERT(aTab && aTab->tab == 3);
+        CPPUNIT_ASSERT(canMove(aLayout, Path{ 3 }, -3));
+        CPPUNIT_ASSERT(!canAddCommand(aLayout, *aTab, "Save")); // not a command id
+        CPPUNIT_ASSERT(addCommand(aLayout, aDefaults, *aTab, ".uno:Save"));
+        CPPUNIT_ASSERT(!addCommand(aLayout, aDefaults, *aTab, ".uno:Save")); // once per group
+        CPPUNIT_ASSERT(rename(aLayout, Path{ 3, 0 }, "Đổi"));
+        CPPUNIT_ASSERT(!rename(aLayout, Path{ 3, 0 }, "   "));
+        CPPUNIT_ASSERT_EQUAL(std::string("Đổi"), aLayout.tabs[3].groups[0].label);
+        CPPUNIT_ASSERT(remove(aLayout, Path{ 3, 0, 0 }));
+        CPPUNIT_ASSERT(remove(aLayout, Path{ 3 }));
+        CPPUNIT_ASSERT(aLayout == aDefaults);
+        // reset one tab
+        CPPUNIT_ASSERT(!canReset(aLayout, aDefaults, Path{ 0 }));
+        setHidden(aLayout, Path{ 0, 1, 1 }, true);
+        addCustomGroup(aLayout, Path{ 0 }, "Khác");
+        CPPUNIT_ASSERT(canReset(aLayout, aDefaults, Path{ 0, 1 }));
+        CPPUNIT_ASSERT(resetTab(aLayout, aDefaults, Path{ 0 }));
+        CPPUNIT_ASSERT(aLayout == aDefaults);
+        // fresh ids
+        CPPUNIT_ASSERT_EQUAL(std::string("hst-tab-1"), newId(aLayout, "hst-tab-"));
+    }
+
+    void testLimits()
+    {
+        Layout aLayout = defaults();
+        for (std::size_t i = 0; i < MAX_CUSTOM_TABS; ++i)
+            CPPUNIT_ASSERT(addCustomTab(aLayout, Path{}, "T", "G"));
+        CPPUNIT_ASSERT(!addCustomTab(aLayout, Path{}, "T", "G"));
+        CPPUNIT_ASSERT_EQUAL(std::size_t(MAX_LABEL_BYTES), cleanLabel(std::string(500, 'a')).size());
+        // a cut never splits a UTF-8 character
+        const std::string aCut = cleanLabel(std::string(MAX_LABEL_BYTES - 1, 'a') + "ệ");
+        CPPUNIT_ASSERT_EQUAL(std::size_t(MAX_LABEL_BYTES - 1), aCut.size());
+        CPPUNIT_ASSERT(isValidCommandId(".uno:Bold"));
+        CPPUNIT_ASSERT(isValidCommandId(".uno:StyleApply?Style:string=Heading 1") == false); // a space
+        CPPUNIT_ASSERT(isValidCommandId(".uno:PageFormatDialog?Page:string=sheet"));
+        CPPUNIT_ASSERT(!isValidCommandId(".uno:"));
+        CPPUNIT_ASSERT(!isValidCommandId("vnd.sun.star.script:x"));
+        CPPUNIT_ASSERT(!isValidCommandId(".uno:A<b>"));
+    }
+
+    void testUsageRanking()
+    {
+        UsageHistory aHistory;
+        const Day nToday = 20000;
+        for (int i = 0; i < 3; ++i)
+            CPPUNIT_ASSERT(aHistory.record(".uno:Bold", nToday - 14)); // 3 runs two weeks ago: 0.75
+        CPPUNIT_ASSERT(aHistory.record(".uno:Italic", nToday)); // 1 run today: 1.0
+        CPPUNIT_ASSERT(aHistory.record(".uno:Underline?Underline.LineStyle:short=1", nToday - 7)); // 0.5
+        CPPUNIT_ASSERT(aHistory.record(".uno:Underline", nToday - 7)); // 1.0 in all
+        const auto aRanked = aHistory.ranked(nToday);
+        CPPUNIT_ASSERT_EQUAL(std::size_t(3), aRanked.size());
+        // Italic and Underline tie at 1.0: the more recent first
+        CPPUNIT_ASSERT_EQUAL(std::string(".uno:Italic"), aRanked[0].command);
+        CPPUNIT_ASSERT_EQUAL(std::string(".uno:Underline"), aRanked[1].command);
+        CPPUNIT_ASSERT_EQUAL(std::string(".uno:Bold"), aRanked[2].command);
+        CPPUNIT_ASSERT_EQUAL(3, aRanked[2].count);
+        CPPUNIT_ASSERT_EQUAL(std::size_t(1), aHistory.ranked(nToday, 1).size());
+    }
+
+    void testUsageNoise()
+    {
+        UsageHistory aHistory;
+        for (const char* p : { ".uno:Undo", ".uno:Redo", ".uno:Save", ".uno:GoLeft", ".uno:GoToEndOfDoc",
+                               ".uno:JumpToNextTable", ".uno:ScrollToNextObject", ".uno:ZoomPlus", ".uno:SwBackspace",
+                               ".uno:PageDown", ".uno:SidebarDeck.PropertyDeck", ".uno:CharLeftSel", "slot:5000",
+                               "macro:///x", ".uno:", ".uno:Bad Name" })
+            CPPUNIT_ASSERT_MESSAGE(p, !aHistory.record(p, 1));
+        CPPUNIT_ASSERT(aHistory.empty());
+        // real commands that look like noise are kept
+        for (const char* p : { ".uno:GoalSeekDialog", ".uno:SaveAs", ".uno:ZoomPageWidth", ".uno:SelectAll" })
+            CPPUNIT_ASSERT_MESSAGE(p, aHistory.record(p, 1));
+    }
+
+    void testUsagePruneAndCap()
+    {
+        UsageHistory aHistory;
+        const Day nToday = 20000;
+        aHistory.record(".uno:Old", nToday - UsageHistory::WINDOW_DAYS);
+        aHistory.record(".uno:Edge", nToday - UsageHistory::WINDOW_DAYS + 1);
+        aHistory.prune(nToday);
+        CPPUNIT_ASSERT_EQUAL(std::size_t(1), aHistory.size());
+        CPPUNIT_ASSERT_EQUAL(std::string(".uno:Edge"), aHistory.ranked(nToday)[0].command);
+        // the cap keeps the most used
+        UsageHistory aBig;
+        for (std::size_t i = 0; i < UsageHistory::MAX_COMMANDS * 2; ++i)
+            for (std::size_t n = 0; n <= i % 3; ++n)
+                aBig.record(".uno:C" + std::to_string(i), nToday);
+        aBig.prune(nToday);
+        CPPUNIT_ASSERT_EQUAL(std::size_t(UsageHistory::MAX_COMMANDS), aBig.size());
+        std::size_t nThree = 0;
+        for (const auto& rItem : aBig.ranked(nToday))
+        {
+            CPPUNIT_ASSERT(rItem.count >= 2);
+            nThree += rItem.count == 3 ? 1 : 0;
+        }
+        CPPUNIT_ASSERT_EQUAL(std::size_t(UsageHistory::MAX_COMMANDS * 2 / 3), nThree);
+        // the file: written and read back; old, malformed and noise entries dropped on reading
+        aHistory.record(".uno:Bold", nToday);
+        const UsageHistory aBack = UsageHistory::parse(aHistory.write(), nToday);
+        CPPUNIT_ASSERT_EQUAL(aHistory.write(), aBack.write());
+        const UsageHistory aBad = UsageHistory::parse(
