@@ -0,0 +1,315 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ */
+
+#include "ribbon-ui-markup.hxx"
+
+#include <algorithm>
+#include <set>
+
+namespace hst::ribbon::lo
+{
+namespace
+{
+void property(std::string& rOut, std::string_view aName, std::string_view aValue, int nIndent)
+{
+    rOut.append(static_cast<std::size_t>(nIndent), ' ');
+    rOut += "<property name=\"";
+    rOut += aName;
+    rOut += "\">";
+    rOut += xmlEscape(aValue);
+    rOut += "</property>\n";
+}
+
+void packing(std::string& rOut, int nLeft, int nTop, int nWidth, int nHeight, int nIndent)
+{
+    const std::string aPad(static_cast<std::size_t>(nIndent), ' ');
+    rOut += aPad + "<packing>\n";
+    property(rOut, "left-attach", std::to_string(nLeft), nIndent + 2);
+    property(rOut, "top-attach", std::to_string(nTop), nIndent + 2);
+    property(rOut, "width", std::to_string(nWidth), nIndent + 2);
+    property(rOut, "height", std::to_string(nHeight), nIndent + 2);
+    rOut += aPad + "</packing>\n";
+}
+
+void boxPacking(std::string& rOut, bool bExpand, int nPosition, int nIndent)
+{
+    const std::string aPad(static_cast<std::size_t>(nIndent), ' ');
+    rOut += aPad + "<packing>\n";
+    property(rOut, "expand", bExpand ? "True" : "False", nIndent + 2);
+    property(rOut, "fill", "True", nIndent + 2);
+    property(rOut, "position", std::to_string(nPosition), nIndent + 2);
+    rOut += aPad + "</packing>\n";
+}
+
+void command(std::string& rOut, const std::string& rGroupId, std::size_t nIndex, const MarkupCommand& rCommand,
+             int nIndent)
+{
+    const std::string aPad(static_cast<std::size_t>(nIndent), ' ');
+    const std::string aIndex = std::to_string(nIndex);
+    rOut += aPad + "<child>\n";
+    rOut += aPad + "  <object class=\"sfxlo-NotebookbarToolBox\" id=\"" + xmlEscape(rGroupId) + "-bx" + aIndex
+            + "\">\n";
+    property(rOut, "visible", "True", nIndent + 4);
+    property(rOut, "can-focus", "False", nIndent + 4);
+    property(rOut, "halign", "fill", nIndent + 4);
+    property(rOut, "valign", "fill", nIndent + 4);
+    property(rOut, "toolbar-style", "both-horiz", nIndent + 4);
+    property(rOut, "show-arrow", "False", nIndent + 4);
+    rOut += aPad + "    <child>\n";
+    rOut += aPad + "      <object class=\"" + std::string(rCommand.dropdown ? "GtkMenuToolButton" : "GtkToolButton")
+            + "\" id=\"" + xmlEscape(rGroupId) + "-btn" + aIndex + "\">\n";
+    property(rOut, "visible", "True", nIndent + 8);
+    property(rOut, "can-focus", "False", nIndent + 8);
+    property(rOut, "action-name", rCommand.command, nIndent + 8);
+    rOut += aPad + "      </object>\n";
+    rOut += aPad + "      <packing>\n";
+    property(rOut, "expand", "False", nIndent + 8);
+    property(rOut, "homogeneous", "True", nIndent + 8);
+    rOut += aPad + "      </packing>\n";
+    rOut += aPad + "    </child>\n";
+    rOut += aPad + "  </object>\n";
+    packing(rOut, static_cast<int>(nIndex), 0, 1, 3, nIndent + 2);
+    rOut += aPad + "</child>\n";
+}
+
+/// the group's grid object (without the <child> around it)
+void grid(std::string& rOut, const MarkupGroup& rGroup, int nIndent)
+{
+    const std::string aPad(static_cast<std::size_t>(nIndent), ' ');
+    const std::string aId = xmlEscape(rGroup.id);
+    const int nCount = static_cast<int>(rGroup.commands.size());
+    rOut += aPad + "<object class=\"GtkGrid\" id=\"" + aId + "\">\n";
+    property(rOut, "visible", "True", nIndent + 2);
+    property(rOut, "can-focus", "False", nIndent + 2);
+    property(rOut, "row-spacing", "3", nIndent + 2);
+    property(rOut, "column-spacing", "4", nIndent + 2);
+    property(rOut, "hst-ribbon-layout", layoutSpec(rGroup.commands), nIndent + 2);
+    rOut += aPad + "  <accessibility>\n";
+    rOut += aPad + "    <relation type=\"labelled-by\" target=\"" + aId + "-caption\"/>\n";
+    rOut += aPad + "  </accessibility>\n";
+    for (std::size_t i = 0; i < rGroup.commands.size(); ++i)
+        command(rOut, rGroup.id, i, rGroup.commands[i], nIndent + 2);
+    // the caption under the commands (row 3), as the built-in groups have it
+    rOut += aPad + "  <child>\n";
+    rOut += aPad + "    <object class=\"GtkLabel\" id=\"" + aId + "-caption\">\n";
+    property(rOut, "visible", "True", nIndent + 6);
+    property(rOut, "can-focus", "False", nIndent + 6);
+    property(rOut, "valign", "end", nIndent + 6);
+    property(rOut, "vexpand", "True", nIndent + 6);
+    property(rOut, "label", rGroup.caption, nIndent + 6);
+    rOut += aPad + "      <attributes>\n";
+    rOut += aPad + "        <attribute name=\"style\" value=\"normal\"/>\n";
+    rOut += aPad + "        <attribute name=\"scale\" value=\"0.9\"/>\n";
+    rOut += aPad + "      </attributes>\n";
+    rOut += aPad + "      <accessibility>\n";
+    rOut += aPad + "        <relation type=\"label-for\" target=\"" + aId + "\"/>\n";
+    rOut += aPad + "      </accessibility>\n";
+    rOut += aPad + "    </object>\n";
+    packing(rOut, 0, 3, std::max(1, nCount), 1, nIndent + 4);
+    rOut += aPad + "  </child>\n";
+    // the separator at the group's right edge
+    rOut += aPad + "  <child>\n";
+    rOut += aPad + "    <object class=\"GtkSeparator\" id=\"" + aId + "-separator\">\n";
+    property(rOut, "visible", "True", nIndent + 6);
+    property(rOut, "can-focus", "False", nIndent + 6);
+    property(rOut, "orientation", "vertical", nIndent + 6);
+    rOut += aPad + "    </object>\n";
+    packing(rOut, nCount, 0, 1, 4, nIndent + 4);
+    rOut += aPad + "  </child>\n";
+    rOut += aPad + "</object>\n";
+}
+
+const char* const HEADER = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+                           "<!-- HST Office: generated ribbon content, rebuilt by the office as needed -->\n"
+                           "<interface domain=\"sfx\">\n"
+                           "  <requires lib=\"gtk+\" version=\"3.20\"/>\n";
+}
+
+std::string xmlEscape(std::string_view aText)
+{
+    std::string aOut;
+    aOut.reserve(aText.size());
+    for (const char c : aText)
+    {
+        switch (c)
+        {
+            case '&': aOut += "&amp;"; break;
+            case '<': aOut += "&lt;"; break;
+            case '>': aOut += "&gt;"; break;
+            case '"': aOut += "&quot;"; break;
+            case '\'': aOut += "&apos;"; break;
+            default:
+                // control characters are not allowed in XML 1.0 (tab, newline, return are)
+                if (static_cast<unsigned char>(c) >= 0x20 || c == '\t' || c == '\n' || c == '\r')
+                    aOut += c;
+        }
+    }
+    return aOut;
+}
+
+std::string layoutSpec(const std::vector<MarkupCommand>& rCommands)
+{
+    std::string aSpec = "kinds=";
+    for (const MarkupCommand& rCommand : rCommands)
+        aSpec += rCommand.kind;
+    return aSpec;
+}
+
+std::string groupDocument(const MarkupGroup& rGroup)
+{
+    std::string aOut = HEADER;
+    grid(aOut, rGroup, 2);
+    aOut += "</interface>\n";
+    return aOut;
+}
+
+std::string pageDocument(std::string_view aPageId, const std::vector<MarkupGroup>& rGroups)
+{
+    const std::string aId = xmlEscape(aPageId);
+    std::string aOut = HEADER;
+    // as the built-in tabs: the box fills the page's height, so the groups stand at its top (the v3 rows)
+    aOut += "  <object class=\"sfxlo-PriorityHBox\" id=\"" + aId + " Tab\">\n";
+    property(aOut, "visible", "True", 4);
+    property(aOut, "can-focus", "False", 4);
+    property(aOut, "spacing", "6", 4);
+    aOut += "    <child>\n";
+    aOut += "      <object class=\"sfxlo-PriorityMergedHBox\" id=\"pmhb" + aId + "\">\n";
+    property(aOut, "visible", "True", 8);
+    property(aOut, "can-focus", "False", 8);
+    for (std::size_t i = 0; i < rGroups.size(); ++i)
+    {
+        aOut += "        <child>\n";
+        grid(aOut, rGroups[i], 10);
+        boxPacking(aOut, false, static_cast<int>(i), 10);
+        aOut += "        </child>\n";
+    }
+    aOut += "      </object>\n";
+    boxPacking(aOut, true, 0, 6);
+    aOut += "    </child>\n";
+    aOut += "  </object>\n";
+    aOut += "</interface>\n";
+    return aOut;
+}
+
+std::string messageDocument(std::string_view aPageId, std::string_view aText)
+{
+    const std::string aId = xmlEscape(aPageId);
+    std::string aOut = HEADER;
+    aOut += "  <object class=\"GtkBox\" id=\"" + aId + " Tab\">\n";
+    property(aOut, "visible", "True", 4);
+    property(aOut, "can-focus", "False", 4);
+    property(aOut, "valign", "center", 4);
+    property(aOut, "vexpand", "True", 4);
+    aOut += "    <child>\n";
+    aOut += "      <object class=\"GtkLabel\" id=\"" + aId + "-message\">\n";
+    property(aOut, "visible", "True", 8);
+    property(aOut, "can-focus", "False", 8);
+    property(aOut, "halign", "start", 8);
+    property(aOut, "valign", "center", 8);
+    property(aOut, "margin-start", "18", 8);
+    property(aOut, "label", aText, 8);
+    property(aOut, "wrap", "True", 8);
+    aOut += "      </object>\n";
+    boxPacking(aOut, false, 0, 6);
+    aOut += "    </child>\n";
+    aOut += "  </object>\n";
+    aOut += "</interface>\n";
+    return aOut;
+}
+LayoutSpec parseLayoutSpec(std::string_view aText)
+{
+    LayoutSpec aSpec;
+    const auto split = [](std::string_view aIn, char cSep) {
+        std::vector<std::string_view> aParts;
+        while (true)
+        {
+            const std::size_t n = aIn.find(cSep);
+            aParts.push_back(aIn.substr(0, n));
+            if (n == std::string_view::npos)
+                return aParts;
+            aIn.remove_prefix(n + 1);
+        }
+    };
+    for (std::string_view aPart : split(aText, ';'))
+    {
+        if (aPart.substr(0, 6) == "kinds=")
+            aSpec.kinds = std::string(aPart.substr(6));
+        else if (aPart == "nofill")
+            aSpec.nofill = true;
+        else if (aPart.substr(0, 5) == "rows=")
+        {
+            for (std::string_view aRow : split(aPart.substr(5), '/'))
+            {
+                std::vector<int> aItems;
+                for (std::string_view aItem : split(aRow, '.'))
+                {
+                    if (aItem == "|")
+                        aItems.push_back(-1);
+                    else if (!aItem.empty() && aItem.size() < 4
+                             && std::all_of(aItem.begin(), aItem.end(), [](char c) { return c >= '0' && c <= '9'; }))
+                        aItems.push_back(std::stoi(std::string(aItem)));
+                    else
+                        return LayoutSpec();
+                }
+                aSpec.rows.push_back(std::move(aItems));
+            }
+        }
+    }
+    aSpec.valid = !aSpec.kinds.empty()
+                  && std::all_of(aSpec.kinds.begin(), aSpec.kinds.end(),
+                                 [](char c) { return c == 'L' || c == 'M' || c == 'S' || c == 'W' || c == 'G'; });
+    for (const auto& rRow : aSpec.rows)
+        for (int n : rRow)
+            if (n >= static_cast<int>(aSpec.kinds.size()))
+                aSpec.valid = false;
+    return aSpec;
+}
+
+std::string writeLayoutSpec(std::string_view aKinds, bool bNofill)
+{
+    std::string aSpec = "kinds=" + std::string(aKinds);
+    if (bNofill)
+        aSpec += ";nofill";
+    return aSpec;
+}
+
+std::vector<int> readingOrder(const LayoutSpec& rSpec)
+{
+    std::vector<int> aOrder;
+    std::set<int> aSeen;
+    for (const auto& rRow : rSpec.rows)
+        for (int n : rRow)
+            if (n >= 0 && aSeen.insert(n).second)
+                aOrder.push_back(n);
+    for (int n = 0; n < static_cast<int>(rSpec.kinds.size()); ++n)
+        if (aSeen.insert(n).second)
+            aOrder.push_back(n);
+    return aOrder;
+}
+
+std::map<std::string, std::string> readLayoutSpecs(std::string_view aUiText)
+{
+    static constexpr std::string_view PROPERTY = "<property name=\"hst-ribbon-layout\">";
+    static constexpr std::string_view GRID = "<object class=\"GtkGrid\" id=\"";
+    std::map<std::string, std::string> aSpecs;
+    for (std::size_t nAt = aUiText.find(PROPERTY); nAt != std::string_view::npos;
+         nAt = aUiText.find(PROPERTY, nAt + PROPERTY.size()))
+    {
+        const std::size_t nValue = nAt + PROPERTY.size();
+        const std::size_t nEnd = aUiText.find('<', nValue);
+        const std::size_t nGrid = aUiText.rfind(GRID, nAt);
+        if (nEnd == std::string_view::npos || nGrid == std::string_view::npos)
+            continue;
+        const std::size_t nId = nGrid + GRID.size();
+        const std::size_t nIdEnd = aUiText.find('"', nId);
+        if (nIdEnd == std::string_view::npos || nIdEnd > nAt)
+            continue;
+        aSpecs[std::string(aUiText.substr(nId, nIdEnd - nId))] = std::string(aUiText.substr(nValue, nEnd - nValue));
+    }
+    return aSpecs;
+}
+}
+
