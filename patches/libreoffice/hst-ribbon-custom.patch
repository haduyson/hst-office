+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ */
+
+#include "ribbon-usage-recorder.hxx"
+#include "ribbon-profile-files.hxx"
+#include "../core/ribbon-usage-store.hxx"
+
+#include <com/sun/star/frame/Desktop.hpp>
+#include <com/sun/star/frame/XTerminateListener.hpp>
+#include <comphelper/processfactory.hxx>
+#include <comphelper/diagnose_ex.hxx>
+#include <cppuhelper/implbase.hxx>
+#include <sal/log.hxx>
+#include <sfx2/docfac.hxx>
+#include <sfx2/objsh.hxx>
+#include <sfx2/viewfrm.hxx>
+#include <vcl/svapp.hxx>
+#include <vcl/timer.hxx>
+
+#include <memory>
+#include <mutex>
+
+namespace core = hst::ribbon::core;
+
+namespace hst::ribbon::lo
+{
+namespace
+{
+constexpr sal_uInt64 FLUSH_DELAY_MS = 60 * 1000;
+
+class FlushTimer : public Timer
+{
+public:
+    FlushTimer()
+        : Timer("hst ribbon usage flush")
+    {
+        SetTimeout(FLUSH_DELAY_MS);
+    }
+    virtual void Invoke() override { FlushHistory(); }
+};
+
+class TerminateListener : public cppu::WeakImplHelper<css::frame::XTerminateListener>
+{
+public:
+    virtual void SAL_CALL queryTermination(const css::lang::EventObject&) override {}
+    virtual void SAL_CALL notifyTermination(const css::lang::EventObject&) override;
+    virtual void SAL_CALL disposing(const css::lang::EventObject&) override {}
+};
+
+/// the store's files are the profile's hst-ribbon/ folder
+core::UsageStore::Files profileFiles()
+{
+    return { [](const std::string& rName) { return ReadProfileFile(FromUtf8(rName)); },
+             [](const std::string& rName, const std::string& rText) { return WriteProfileFile(FromUtf8(rName), rText); },
+             [](const std::string& rName) { return RemoveProfileFile(FromUtf8(rName)); } };
+}
+
+/// the process's usage state; never destroyed (its timer must not outlive the toolkit at exit)
+struct Usage
+{
+    std::mutex mutex;
+    core::UsageStore store{ profileFiles() };
+    std::unique_ptr<FlushTimer> timer;
+    bool listening = false;
+    bool terminated = false;
+};
+
+Usage& usage()
+{
+    static Usage* const pUsage = new Usage;
+    return *pUsage;
+}
+
+/// the first record starts the flush timer and the listener that writes the histories when the office ends
+void armFlush(Usage& rUsage)
+{
+    if (rUsage.terminated)
+        return;
+    if (!rUsage.timer)
+        rUsage.timer.reset(new FlushTimer);
+    if (!rUsage.timer->IsActive())
+        rUsage.timer->Start();
+    if (rUsage.listening)
+        return;
+    rUsage.listening = true;
+    try
+    {
+        css::frame::Desktop::create(comphelper::getProcessComponentContext())
+            ->addTerminateListener(new TerminateListener);
+    }
+    catch (const css::uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("sfx.notebookbar", "HST ribbon: no terminate listener, usage written by the timer only");
+    }
+}
+
+void TerminateListener::notifyTermination(const css::lang::EventObject&)
+{
+    FlushHistory();
+    SolarMutexGuard aGuard;
+    Usage& rUsage = usage();
+    rUsage.terminated = true;
+    rUsage.timer.reset();
+}
+}
+
+std::string AppOfFactory(std::u16string_view aFactoryName)
+{
+    // "swriter/web" and "swriter/GlobalDocument" are Writer too
+    if (aFactoryName.substr(0, 7) == u"swriter")
+        return "writer";
+    if (aFactoryName == u"scalc")
+        return "calc";
+    if (aFactoryName == u"simpress")
+        return "impress";
+    if (aFactoryName == u"sdraw")
+        return "draw";
+    return std::string();
+}
+
+void RecordCommand(SfxViewFrame* pFrame, std::u16string_view aProtocol, std::u16string_view aPath)
+{
+    if (!pFrame || aProtocol != u".uno:" || aPath.empty() || aPath.size() > 200)
+        return;
+    SfxObjectShell* pShell = pFrame->GetObjectShell();
+    if (!pShell)
+        return;
+    const std::string aApp = AppOfFactory(pShell->GetFactory().GetFactoryName());
+    if (aApp.empty())
+        return;
+    Usage& rUsage = usage();
+    std::scoped_lock aLock(rUsage.mutex);
+    if (rUsage.store.record(aApp, ".uno:" + ToUtf8(aPath), Today()))
+        armFlush(rUsage);
+}
+
+std::vector<std::string> RankedCommands(const std::string& rApp, std::size_t nLimit)
+{
+    Usage& rUsage = usage();
+    std::scoped_lock aLock(rUsage.mutex);
+    return rUsage.store.ranked(rApp, Today(), nLimit);
+}
+
+unsigned UsageRevision(const std::string& rApp)
+{
+    Usage& rUsage = usage();
+    std::scoped_lock aLock(rUsage.mutex);
+    return rUsage.store.revision(rApp);
+}
+
+bool RecentEnabled()
+{
+    Usage& rUsage = usage();
+    std::scoped_lock aLock(rUsage.mutex);
+    return rUsage.store.recentEnabled();
+}
+
+void SetRecentEnabled(bool bEnabled)
+{
+    Usage& rUsage = usage();
+    std::scoped_lock aLock(rUsage.mutex);
+    rUsage.store.setRecentEnabled(bEnabled); // off keeps every history (UsageStore)
+}
+
+void ClearHistory()
+{
+    Usage& rUsage = usage();
+    std::scoped_lock aLock(rUsage.mutex);
+    for (const std::string& rApp : rUsage.store.clearAll())
+        SAL_WARN("sfx.notebookbar", "HST ribbon: the usage history of " << rApp << " was not removed");
+}
+
+void FlushHistory()
+{
+    Usage& rUsage = usage();
+    std::scoped_lock aLock(rUsage.mutex);
+    rUsage.store.flush(Today());
+}
+}
+
