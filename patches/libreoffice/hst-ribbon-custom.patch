+OUString Plain(const OUString& rText) { return rText.replaceAll("~", ""); }
+
+std::vector<vcl::Window*> ChildrenOf(const vcl::Window& rParent)
+{
+    std::vector<vcl::Window*> aChildren;
+    for (vcl::Window* pChild = rParent.GetWindow(GetWindowType::FirstChild); pChild;
+         pChild = pChild->GetWindow(GetWindowType::Next))
+        aChildren.push_back(pChild);
+    return aChildren;
+}
+
+/// the first descendant (breadth first) rTest accepts
+vcl::Window* FindDescendant(const vcl::Window& rRoot, const std::function<bool(const vcl::Window&)>& rTest)
+{
+    std::vector<vcl::Window*> aLevel = ChildrenOf(rRoot);
+    while (!aLevel.empty())
+    {
+        std::vector<vcl::Window*> aNext;
+        for (vcl::Window* pWindow : aLevel)
+        {
+            if (rTest(*pWindow))
+                return pWindow;
+            for (vcl::Window* pChild : ChildrenOf(*pWindow))
+                aNext.push_back(pChild);
+        }
+        aLevel = std::move(aNext);
+    }
+    return nullptr;
+}
+
+/// a tab page's group box: the merged box of the v3 groups (its .ui id starts with "pmhb")
+vcl::Window* GroupBoxOf(const vcl::Window& rPage)
+{
+    return FindDescendant(rPage, [](const vcl::Window& r) { return r.get_id().startsWith("pmhb"); });
+}
+
+/// the command children of a v3 group (not its caption at row 3, not its separator), in child order
+std::vector<vcl::Window*> CommandChildren(const vcl::Window& rGrid)
+{
+    std::vector<vcl::Window*> aCommands;
+    for (vcl::Window* pChild : ChildrenOf(rGrid))
+        if (pChild->GetType() != WindowType::FIXEDLINE && pChild->get_grid_top_attach() < 3)
+            aCommands.push_back(pChild);
+    return aCommands;
+}
+
+/// the command of a group's child: a toolbox's button command, a menu button "menu:<id>", else "widget:<id>"
+std::string CommandIdOf(const vcl::Window& rChild, bool* pDropdown = nullptr)
+{
+    if (const ToolBox* pBox = dynamic_cast<const ToolBox*>(&rChild))
+        for (ToolBox::ImplToolItems::size_type i = 0; i < pBox->GetItemCount(); ++i)
+        {
+            const ToolBoxItemId nId = pBox->GetItemId(i);
+            if (pBox->GetItemType(i) == ToolBoxItemType::BUTTON && !pBox->GetItemCommand(nId).isEmpty())
+            {
+                if (pDropdown)
+                    *pDropdown = bool(pBox->GetItemBits(nId) & ToolBoxItemBits::DROPDOWN);
+                return ToUtf8(pBox->GetItemCommand(nId));
+            }
+        }
+    return ToUtf8(OUString((rChild.GetType() == WindowType::MENUBUTTON ? u"menu:" : u"widget:") + rChild.get_id()));
+}
+
+OUString LabelOf(const vcl::Window& rChild, const OUString& rModule)
+{
+    if (const ToolBox* pBox = dynamic_cast<const ToolBox*>(&rChild))
+        for (ToolBox::ImplToolItems::size_type i = 0; i < pBox->GetItemCount(); ++i)
+        {
+            const ToolBoxItemId nId = pBox->GetItemId(i);
+            if (pBox->GetItemType(i) != ToolBoxItemType::BUTTON)
+                continue;
+            const OUString aCommand = pBox->GetItemCommand(nId);
+            OUString aLabel = aCommand.isEmpty() ? OUString()
+                                                 : vcl::CommandInfoProvider::GetLabelForCommand(
+                                                       vcl::CommandInfoProvider::GetCommandProperties(aCommand, rModule));
+            if (aLabel.isEmpty())
+                aLabel = pBox->GetItemText(nId);
+            return Plain(aLabel);
+        }
+    if (!rChild.GetText().isEmpty())
+        return Plain(rChild.GetText());
+    return Plain(rChild.GetAccessibleName());
+}
+
+/// a group's caption: the first label under its commands
+OUString CaptionOf(const vcl::Window& rGrid)
+{
+    for (vcl::Window* pChild : ChildrenOf(rGrid))
+    {
+        if (pChild->get_grid_top_attach() < 3)
+            continue;
+        if (pChild->GetType() == WindowType::FIXEDTEXT)
+            return Plain(pChild->GetText());
+        if (vcl::Window* pLabel = FindDescendant(
+                *pChild, [](const vcl::Window& r) { return r.GetType() == WindowType::FIXEDTEXT; }))
+            return Plain(pLabel->GetText());
+    }
+    return OUString();
+}
+
+/// puts the managed children of rParent in rDesired's order, in the places they hold now; other children stay
+void Arrange(vcl::Window& rParent, const std::vector<vcl::Window*>& rDesired)
+{
+    const std::set<vcl::Window*> aManaged(rDesired.begin(), rDesired.end());
+    std::vector<vcl::Window*> aOrder;
+    std::size_t nNext = 0;
+    for (vcl::Window* pChild : ChildrenOf(rParent))
+        aOrder.push_back(aManaged.count(pChild) && nNext < rDesired.size() ? rDesired[nNext++] : pChild);
+    for (std::size_t i = 0; i < aOrder.size(); ++i)
+        aOrder[i]->reorderWithinParent(static_cast<sal_uInt16>(i));
+}
+
+OUString ModuleOf(const css::uno::Reference<css::frame::XFrame>& xFrame)
+{
+    try
+    {
+        return xFrame.is() ? vcl::CommandInfoProvider::GetModuleIdentifier(xFrame) : OUString();
+    }
+    catch (const css::uno::Exception&)
+    {
+        return OUString();
+    }
+}
+
+/// the document window of a frame
+SystemWindow* SystemOf(const css::uno::Reference<css::frame::XFrame>& xFrame)
+{
+    if (!xFrame.is())
+        return nullptr;
+    VclPtr<vcl::Window> xWindow = VCLUnoHelper::GetWindow(xFrame->getContainerWindow());
+    return xWindow ? xWindow->GetSystemWindow() : nullptr;
+}
+
+OUString UiDirOf(const OUString& rFile)
+{
+    const sal_Int32 nSlash = rFile.lastIndexOf('/');
+    return nSlash < 0 ? OUString() : rFile.copy(0, nSlash + 1);
+}
+
+/// the apps whose ribbons are rebuilt once the current event is handled ("" = all)
+std::set<std::string>& pendingReloads()
+{
+    static std::set<std::string> aApps;
+    return aApps;
+}
+
+struct Reloader
+{
+    DECL_STATIC_LINK(Reloader, ReloadHdl, void*, void);
+};
+
+IMPL_STATIC_LINK_NOARG(Reloader, ReloadHdl, void*, void)
+{
+    const std::set<std::string> aApps = std::move(pendingReloads());
+    pendingReloads().clear();
+    // every window once (a window may hold several documents' frames)
+    std::set<const SystemWindow*> aDone;
+    std::vector<std::pair<VclPtr<SystemWindow>, css::uno::Reference<css::frame::XFrame>>> aTodo;
+    for (SfxViewFrame* pView = SfxViewFrame::GetFirst(nullptr, false); pView;
+         pView = SfxViewFrame::GetNext(*pView, nullptr, false))
+    {
+        SystemWindow* pSystem = pView->GetWindow().GetSystemWindow();
+        if (!pSystem || !aDone.insert(pSystem).second || !pSystem->GetNotebookBar())
+            continue;
+        std::string aApp;
+        for (const auto& [pTabs, xController] : controllers())
+            if (!pTabs->isDisposed() && xController->System() == pSystem)
+                aApp = xController->App();
+        if (!aApp.empty() && (aApps.count(std::string()) || aApps.count(aApp)))
+            aTodo.emplace_back(pSystem, pView->GetFrame().GetFrameInterface());
+    }
+    for (const auto& [xSystem, xFrame] : aTodo)
+    {
+        if (xSystem->isDisposed() || !xSystem->GetNotebookBar())
+            continue;
+        try
+        {
+            sfx2::SfxNotebookBar::StateMethod(xSystem.get(), xFrame,
+                                              UiDirOf(xSystem->GetNotebookBar()->GetUIFilePath()), true);
+        }
+        catch (const css::uno::Exception&)
+        {
+            TOOLS_WARN_EXCEPTION("sfx.notebookbar", "HST ribbon: a ribbon was not rebuilt");
+        }
+    }
+}
