--- /dev/null
+++ b/hst/ribbon/lo/ribbon-ui-markup.hxx
@@ -0,0 +1,68 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ */
+
+#pragma once
+
+// HST Office ribbon adapter: the .ui markup of the ribbon's own tabs and groups (custom tabs and groups, the recently
+// used tab), loaded by the office's widget builder exactly as the built-in ribbon is, so they get the same command
+// controllers and the same v3 layout (the "hst-ribbon-layout" contract of the built-in groups: one command per grid
+// child, the caption at row 3, one separator). Standard C++ only (it writes text); the CppunitTest checks it.
+
+#include <map>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace hst::ribbon::lo
+{
+struct MarkupCommand
+{
+    std::string command; // ".uno:Bold"
+    char kind = 'M'; // the v3 layout letter (L, M, S, W, G)
+    bool dropdown = false; // a ▾ button (GtkMenuToolButton)
+};
+
+struct MarkupGroup
+{
+    std::string id; // unique in the ribbon; the widgets' ids are derived from it
+    std::string caption;
+    std::vector<MarkupCommand> commands;
+};
+
+/// "kinds=LMM" for the commands of a group
+std::string layoutSpec(const std::vector<MarkupCommand>& rCommands);
+
+/// a .ui document whose root is the group's grid (to be built into a tab's merged group box)
+std::string groupDocument(const MarkupGroup& rGroup);
+
+/// a .ui document whose root is a tab page's content: a priority box holding a merged group box of the groups
+/// (rPageId names the boxes: "<id> Tab", "pmhb<id>")
+std::string pageDocument(std::string_view aPageId, const std::vector<MarkupGroup>& rGroups);
+
+/// a .ui document whose root is a tab page's content showing one line of text (the recently used tab's empty state)
+std::string messageDocument(std::string_view aPageId, std::string_view aText);
+
+/// the text with XML escapes for an attribute or element
+std::string xmlEscape(std::string_view aText);
+
+/// a built-in group's "hst-ribbon-layout" (the ribbon-v3 contract): one kind letter per command child, its fixed
+/// rows (child indexes, -1 for a gap) and "nofill"
+struct LayoutSpec
+{
+    std::string kinds;
+    std::vector<std::vector<int>> rows;
+    bool nofill = false;
+    bool valid = false;
+};
+LayoutSpec parseLayoutSpec(std::string_view aText);
+/// the spec of commands in a new order: their kinds, no fixed rows (the order is the user's now)
+std::string writeLayoutSpec(std::string_view aKinds, bool bNofill);
+/// the command children in the order a reader sees them: row by row for a fixed layout, else the child order
+std::vector<int> readingOrder(const LayoutSpec& rSpec);
+/// every GtkGrid id of a .ui document with its "hst-ribbon-layout" value
+std::map<std::string, std::string> readLayoutSpecs(std::string_view aUiText);
+}
+
