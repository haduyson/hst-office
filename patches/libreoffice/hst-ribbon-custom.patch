+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ */
+
+#pragma once
+
+// HST Office ribbon core: the edits of the "Tùy chỉnh ribbon" dialog on the effective layout (ribbon-layout-model).
+// What the user may do:
+// - custom tabs: add, rename, remove, move among the tabs; their groups and commands: anything below;
+// - groups: add a custom group to any tab, rename or remove a custom group, show/hide and move any group in its tab;
+// - commands: add any command to a custom group (each once per group), remove it from a custom group, show/hide and
+//   move any command in its group;
+// - reset one built-in tab, or everything, to the default.
+// Built-in tabs, groups and commands are never removed or renamed, only hidden or moved, so a reset brings them back.
+
+#include "ribbon-layout-model.hxx"
+
+#include <optional>
+#include <string>
+#include <string_view>
+
+namespace hst::ribbon::core
+{
+/// an item of the layout: a tab (group, command -1), a group (command -1) or a command
+struct Path
+{
+    int tab = -1;
+    int group = -1;
+    int command = -1;
+    bool isTab() const { return tab >= 0 && group < 0; }
+    bool isGroup() const { return tab >= 0 && group >= 0 && command < 0; }
+    bool isCommand() const { return tab >= 0 && group >= 0 && command >= 0; }
+    bool operator==(const Path&) const = default;
+};
+
+bool isValid(const Layout& rLayout, const Path& rPath);
+/// the item is the user's own (a custom tab, a custom group, a command of a custom group)
+bool isCustom(const Layout& rLayout, const Path& rPath);
+
+bool canMove(const Layout& rLayout, const Path& rPath, int nDelta);
+/// moves the item nDelta places among its siblings; the item's new path, nullopt when it cannot move
+std::optional<Path> move(Layout& rLayout, const Path& rPath, int nDelta);
+
+bool canHide(const Layout& rLayout, const Path& rPath);
+bool setHidden(Layout& rLayout, const Path& rPath, bool bHidden);
+bool isHidden(const Layout& rLayout, const Path& rPath);
+
+bool canRename(const Layout& rLayout, const Path& rPath);
+bool rename(Layout& rLayout, const Path& rPath, std::string_view aLabel);
+
+bool canRemove(const Layout& rLayout, const Path& rPath);
+/// the item to select afterwards (its neighbour or its parent)
+std::optional<Path> remove(Layout& rLayout, const Path& rPath);
+
+/// a new custom tab after the selected tab (after the last tab without a selection), with one empty group
+std::optional<Path> addCustomTab(Layout& rLayout, const Path& rSelected, std::string_view aTabLabel,
+                                 std::string_view aGroupLabel);
+/// a new custom group in the selected tab, after the selected group (at the end of the tab otherwise)
+std::optional<Path> addCustomGroup(Layout& rLayout, const Path& rSelected, std::string_view aLabel);
+
+bool canAddCommand(const Layout& rLayout, const Path& rSelected, std::string_view aCommand);
+/// adds the command to the selected custom group (after the selected command), nullopt when the group is built-in,
+/// full, or already holds the command
+std::optional<Path> addCommand(Layout& rLayout, const Layout& rDefaults, const Path& rSelected,
+                               std::string_view aCommand);
+
+/// the selected built-in tab as it is by default (a custom tab stays)
+bool canReset(const Layout& rLayout, const Layout& rDefaults, const Path& rSelected);
+bool resetTab(Layout& rLayout, const Layout& rDefaults, const Path& rSelected);
+
+/// an id no tab or group of the layout has: "<prefix>1", "<prefix>2", ...
+std::string newId(const Layout& rLayout, std::string_view aPrefix);
+}
