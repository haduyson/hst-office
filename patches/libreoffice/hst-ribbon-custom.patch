+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ */
+
+#include "ribbon-usage-history.hxx"
+#include "ribbon-json.hxx"
+#include "ribbon-layout-model.hxx"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+
+namespace hst::ribbon::core
+{
+namespace
+{
+constexpr std::string_view USAGE_FORMAT = "hst-ribbon-usage";
+constexpr std::string_view SETTINGS_FORMAT = "hst-ribbon-settings";
+
+// The noise exclusion list (isNoiseCommand). Names are without ".uno:".
+// Exact names:
+constexpr std::array NOISE_NAMES = {
+    // undo history and saving
+    std::string_view("Undo"), std::string_view("Redo"), std::string_view("Repeat"), std::string_view("Save"),
+    std::string_view("SaveAll"), std::string_view("AutoSave"),
+    // typing, deleting characters, Enter, Tab, Escape
+    std::string_view("InsertText"), std::string_view("InsertPara"), std::string_view("SwBackspace"),
+    std::string_view("Backspace"), std::string_view("Escape"), std::string_view("Cancel"),
+    std::string_view("Tab"), std::string_view("ShiftTab"), std::string_view("InsertLinebreak"),
+    // scrolling and zoom ticks (a chosen zoom such as Page Width stays)
+    std::string_view("Zoom"), std::string_view("ZoomPlus"), std::string_view("ZoomMinus"),
+    std::string_view("ZoomIn"), std::string_view("ZoomOut"), std::string_view("ZoomSlider"),
+    std::string_view("PageUp"), std::string_view("PageDown"), std::string_view("PageUpSel"),
+    std::string_view("PageDownSel"),
+    // selection by keys
+    std::string_view("SelectWord"), std::string_view("SelectSentence"), std::string_view("SelectionMode"),
+    std::string_view("SelectionModeBlock"), std::string_view("SelectionModeDefault"),
+    // plumbing the office dispatches itself: context menus, status bar fields, focus, closing, the UI mode
+    std::string_view("ContextMenu"), std::string_view("StatusBarFunc"), std::string_view("LanguageStatus"),
+    std::string_view("ModifiedStatus"), std::string_view("Signature"), std::string_view("Context"),
+    std::string_view("Position"), std::string_view("StateWordCount"), std::string_view("StatusDocPos"),
+    std::string_view("StatusPageStyle"), std::string_view("FocusToDocument"), std::string_view("FocusToFindbar"),
+    std::string_view("CloseDoc"), std::string_view("CloseWin"), std::string_view("Quit"),
+    std::string_view("ToolbarMode"), std::string_view("Notebookbar"), std::string_view("Sidebar"),
+    std::string_view("ToggleMenubar"), std::string_view("ActivateHelp"), std::string_view("NextTrackedChange"),
+    std::string_view("Deselect"), std::string_view("SetDocumentModified"), std::string_view("AttributePageSize"),
+    std::string_view("CellCursor"), std::string_view("SetInputMode"),
+    // Writer updates the input fields itself when a document opens
+    std::string_view("UpdateInputFields"),
+};
+
+// Name prefixes: cursor movement, jumps, extending the selection by keys, deleting by words, scrolling, sidebar
+// decks. "Go" alone is not one ("GoalSeekDialog" is a real command).
+constexpr std::array NOISE_PREFIXES = {
+    std::string_view("GoUp"),         std::string_view("GoDown"),     std::string_view("GoLeft"),
+    std::string_view("GoRight"),      std::string_view("GoTo"),       std::string_view("Goto"),
+    std::string_view("GoPrev"),       std::string_view("GoNext"),     std::string_view("JumpTo"),
+    std::string_view("CharLeft"),     std::string_view("CharRight"),  std::string_view("LineUp"),
+    std::string_view("LineDown"),     std::string_view("WordLeft"),   std::string_view("WordRight"),
+    std::string_view("StartOf"),      std::string_view("EndOf"),      std::string_view("DelTo"),
+    std::string_view("Scroll"),       std::string_view("SidebarDeck"), std::string_view("FocusTo"),
+    std::string_view("MoveUp"),       std::string_view("MoveDown"),   std::string_view("FirstPage"),
+    std::string_view("LastPage"),     std::string_view("NextPage"),   std::string_view("PreviousPage"),
+    std::string_view("SelectRow"),    std::string_view("SelectColumn"),
+};
+
+double weight(Day nAge) { return std::pow(0.5, static_cast<double>(nAge) / UsageHistory::HALF_LIFE_DAYS); }
+}
+
+std::string normalizeCommand(std::string_view aCommand)
+{
+    if (aCommand.substr(0, 5) != ".uno:")
+        return std::string();
+    const std::size_t nArgs = aCommand.find('?');
+    std::string aOut(aCommand.substr(0, nArgs));
+    // a command with a broken name is not counted
+    return isValidCommandId(aOut) ? aOut : std::string();
+}
+
+bool isNoiseCommand(std::string_view aNormalizedCommand)
+{
+    if (aNormalizedCommand.substr(0, 5) != ".uno:")
+        return true;
+    const std::string_view aName = aNormalizedCommand.substr(5);
+    if (std::find(NOISE_NAMES.begin(), NOISE_NAMES.end(), aName) != NOISE_NAMES.end())
+        return true;
+    return std::any_of(NOISE_PREFIXES.begin(), NOISE_PREFIXES.end(),
+                       [&](std::string_view aPrefix) { return aName.substr(0, aPrefix.size()) == aPrefix; });
+}
+
+bool UsageHistory::record(std::string_view aCommand, Day nToday)
+{
+    const std::string aName = normalizeCommand(aCommand);
+    if (aName.empty() || isNoiseCommand(aName))
+        return false;
+    // the cap applies when the history is written (prune); between writes it may hold twice as many commands
+    if (m_aDays.size() >= 2 * MAX_COMMANDS && !m_aDays.count(aName))
+        prune(nToday);
+    int& rCount = m_aDays[aName][nToday];
+    rCount = std::min(rCount + 1, MAX_DAILY_COUNT);
+    return true;
+}
+
+void UsageHistory::prune(Day nToday)
+{
+    for (auto it = m_aDays.begin(); it != m_aDays.end();)
+    {
+        std::map<Day, int>& rDays = it->second;
+        // a day in the future (the clock went back) counts as today
+        for (auto itDay = rDays.begin(); itDay != rDays.end();)
+            itDay = (nToday - itDay->first >= WINDOW_DAYS || itDay->second <= 0) ? rDays.erase(itDay) : std::next(itDay);
+        it = rDays.empty() ? m_aDays.erase(it) : std::next(it);
+    }
+    if (m_aDays.size() <= MAX_COMMANDS)
+        return;
+    const std::vector<Ranked> aKeep = ranked(nToday, MAX_COMMANDS);
+    std::map<std::string, std::map<Day, int>> aKept;
+    for (const Ranked& rItem : aKeep)
+        aKept[rItem.command] = std::move(m_aDays[rItem.command]);
+    m_aDays = std::move(aKept);
+}
+
+std::vector<UsageHistory::Ranked> UsageHistory::ranked(Day nToday, std::size_t nLimit) const
+{
+    std::vector<Ranked> aOut;
+    for (const auto& [rCommand, rDays] : m_aDays)
+    {
+        Ranked aItem;
+        aItem.command = rCommand;
+        for (const auto& [nDay, nCount] : rDays)
+        {
+            const Day nAge = std::max<Day>(0, nToday - nDay);
+            if (nAge >= WINDOW_DAYS || nCount <= 0)
+                continue;
+            aItem.score += nCount * weight(nAge);
+            aItem.count += nCount;
+            aItem.lastDay = std::max(aItem.lastDay, nDay);
+        }
+        if (aItem.count > 0)
+            aOut.push_back(std::move(aItem));
+    }
+    std::sort(aOut.begin(), aOut.end(), [](const Ranked& a, const Ranked& b) {
+        if (a.score != b.score)
+            return a.score > b.score;
+        if (a.lastDay != b.lastDay)
+            return a.lastDay > b.lastDay;
+        return a.command < b.command;
+    });
+    if (aOut.size() > nLimit)
+        aOut.resize(nLimit);
+    return aOut;
+}
+
+std::string UsageHistory::write() const
+{
+    Json aRoot = Json::object();
+    aRoot.set("format", Json::string(std::string(USAGE_FORMAT)));
+    aRoot.set("version", Json::number(1));
+    Json aCommands = Json::object();
+    for (const auto& [rCommand, rDays] : m_aDays)
+    {
+        Json aDays = Json::object();
+        for (const auto& [nDay, nCount] : rDays)
+            aDays.set(std::to_string(nDay), Json::number(nCount));
+        aCommands.set(rCommand, std::move(aDays));
+    }
+    aRoot.set("commands", std::move(aCommands));
+    return aRoot.write(false);
+}
+
+UsageHistory UsageHistory::parse(std::string_view aJson, Day nToday)
+{
+    UsageHistory aHistory;
+    const std::optional<Json> aRoot = Json::parse(aJson);
+    if (!aRoot || !aRoot->isObject() || aRoot->get("format").asString() != USAGE_FORMAT)
+        return aHistory;
+    for (const auto& [rCommand, rDays] : aRoot->get("commands").members())
+    {
+        const std::string aName = normalizeCommand(rCommand);
+        if (aName.empty() || isNoiseCommand(aName) || !rDays.isObject())
+            continue;
+        for (const auto& [rDay, rCount] : rDays.members())
+        {
+            // a day is a decimal number of days; anything else is skipped
+            if (rDay.empty() || rDay.size() > 9
+                || !std::all_of(rDay.begin(), rDay.end(), [](char c) { return c >= '0' && c <= '9'; }))
+                continue;
+            const Day nDay = std::stoll(rDay);
+            const std::int64_t nCount = rCount.asInt(0);
+            if (nCount <= 0 || nDay > nToday + 1)
+                continue;
+            int& rStored = aHistory.m_aDays[aName][nDay];
+            rStored = static_cast<int>(std::min<std::int64_t>(rStored + nCount, MAX_DAILY_COUNT));
+        }
+    }
+    aHistory.prune(nToday);
+    return aHistory;
+}
+
+std::string UsageSettings::write() const
+{
+    Json aRoot = Json::object();
+    aRoot.set("format", Json::string(std::string(SETTINGS_FORMAT)));
+    aRoot.set("version", Json::number(1));
+    aRoot.set("recentEnabled", Json::boolean(recentEnabled));
+    return aRoot.write(true);
+}
+
+UsageSettings UsageSettings::parse(std::string_view aJson)
+{
+    UsageSettings aSettings;
+    const std::optional<Json> aRoot = Json::parse(aJson);
+    if (aRoot && aRoot->isObject() && aRoot->get("format").asString() == SETTINGS_FORMAT)
+        aSettings.recentEnabled = aRoot->get("recentEnabled").asBool(true);
+    return aSettings;
+}
+}
