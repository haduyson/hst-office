+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ */
+
+#include "ribbon-profile-files.hxx"
+
+#include <osl/file.hxx>
+#include <rtl/ustrbuf.hxx>
+#include <sal/log.hxx>
+#include <tools/date.hxx>
+#include <unotools/bootstrap.hxx>
+
+#include <vector>
+
+namespace hst::ribbon::lo
+{
+namespace
+{
+constexpr sal_uInt64 MAX_FILE_BYTES = 4 * 1024 * 1024;
+
+/// <profile>/user/hst-ribbon, created on first use; empty when the profile cannot be found
+OUString ProfileDir(bool bCreate)
+{
+    OUString aUser;
+    if (utl::Bootstrap::locateUserData(aUser) != utl::Bootstrap::PATH_EXISTS || aUser.isEmpty())
+        return OUString();
+    const OUString aDir = aUser + (aUser.endsWith("/") ? u"hst-ribbon"_ustr : u"/hst-ribbon"_ustr);
+    if (bCreate)
+    {
+        const osl::FileBase::RC eRc = osl::Directory::createPath(aDir);
+        if (eRc != osl::FileBase::E_None && eRc != osl::FileBase::E_EXIST)
+        {
+            SAL_WARN("sfx.notebookbar", "HST ribbon: cannot create " << aDir);
+            return OUString();
+        }
+    }
+    return aDir;
+}
+
+OUString ProfileUrl(std::u16string_view aName, bool bCreate)
+{
+    const OUString aDir = ProfileDir(bCreate);
+    return aDir.isEmpty() ? OUString() : aDir + "/" + aName;
+}
+}
+
+OUString ProfileDirUrl(bool bCreate)
+{
+    const OUString aDir = ProfileDir(bCreate);
+    return aDir.isEmpty() ? OUString() : aDir + "/";
+}
+
+std::optional<std::string> ReadUrl(const OUString& rUrl)
+{
+    if (rUrl.isEmpty())
+        return std::nullopt;
+    osl::File aFile(rUrl);
+    if (aFile.open(osl_File_OpenFlag_Read) != osl::FileBase::E_None)
+        return std::nullopt;
+    sal_uInt64 nSize = 0;
+    if (aFile.getSize(nSize) != osl::FileBase::E_None || nSize > MAX_FILE_BYTES)
+        return std::nullopt;
+    std::string aText(static_cast<std::size_t>(nSize), '\0');
+    sal_uInt64 nRead = 0;
+    if (nSize && (aFile.read(aText.data(), nSize, nRead) != osl::FileBase::E_None || nRead != nSize))
+        return std::nullopt;
+    return aText;
+}
+
+bool WriteUrl(const OUString& rUrl, std::string_view aText)
+{
+    if (rUrl.isEmpty())
+        return false;
+    // the new text goes to a temporary file next to the target first, then replaces it
+    const OUString aTemp = rUrl + ".tmp";
+    osl::File aFile(aTemp);
+    if (aFile.open(osl_File_OpenFlag_Write | osl_File_OpenFlag_Create) != osl::FileBase::E_None)
+    {
+        // a temporary file left behind by an earlier crash
+        osl::File::remove(aTemp);
+        if (aFile.open(osl_File_OpenFlag_Write | osl_File_OpenFlag_Create) != osl::FileBase::E_None)
+            return false;
+    }
+    sal_uInt64 nWritten = 0;
+    const bool bWritten = aFile.write(aText.data(), aText.size(), nWritten) == osl::FileBase::E_None
+                          && nWritten == aText.size() && aFile.sync() == osl::FileBase::E_None;
+    aFile.close();
+    if (!bWritten || osl::File::move(aTemp, rUrl) != osl::FileBase::E_None)
+    {
+        osl::File::remove(aTemp);
+        SAL_WARN("sfx.notebookbar", "HST ribbon: cannot write " << rUrl);
+        return false;
+    }
+    return true;
+}
+
+std::optional<std::string> ReadProfileFile(std::u16string_view aName) { return ReadUrl(ProfileUrl(aName, false)); }
+
+bool WriteProfileFile(std::u16string_view aName, std::string_view aText)
+{
+    return WriteUrl(ProfileUrl(aName, true), aText);
+}
+
+bool RemoveProfileFile(std::u16string_view aName)
+{
+    const OUString aUrl = ProfileUrl(aName, false);
+    if (aUrl.isEmpty())
+        return true;
+    const osl::FileBase::RC eRc = osl::File::remove(aUrl);
+    return eRc == osl::FileBase::E_None || eRc == osl::FileBase::E_NOENT;
+}
+
+sal_Int64 Today()
+{
+    return sal_Int64(Date(Date::SYSTEM) - Date(1, 1, 1970));
+}
+
+OUString FromUtf8(std::string_view aText)
+{
+    return OUString(aText.data(), static_cast<sal_Int32>(aText.size()), RTL_TEXTENCODING_UTF8);
+}
+
+std::string ToUtf8(std::u16string_view aText)
+{
+    const OString aUtf8 = OUStringToOString(aText, RTL_TEXTENCODING_UTF8);
+    return std::string(aUtf8.getStr(), aUtf8.getLength());
+}
+}
