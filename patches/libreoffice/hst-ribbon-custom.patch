+OUString PathId(const core::Path& rPath)
+{
+    OUString aId = OUString::number(rPath.tab);
+    if (rPath.group >= 0)
+        aId += "." + OUString::number(rPath.group);
+    if (rPath.command >= 0)
+        aId += "." + OUString::number(rPath.command);
+    return aId;
+}
+
+core::Path PathOf(std::u16string_view aId)
+{
+    core::Path aPath;
+    sal_Int32 nIndex = 0;
+    int* const aParts[] = { &aPath.tab, &aPath.group, &aPath.command };
+    for (int* pPart : aParts)
+    {
+        if (nIndex < 0)
+            break;
+        const std::u16string_view aToken = o3tl::getToken(aId, 0, '.', nIndex);
+        if (aToken.empty())
+            break;
+        *pPart = o3tl::toInt32(aToken);
+    }
+    return aPath;
+}
