+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ */
+
+#pragma once
+
+// HST Office ribbon adapter: the ribbon's files in the user profile (<profile>/user/hst-ribbon/):
+//   custom-<app>.json   the app's ribbon customization (ribbon-layout-model.hxx)
+//   usage-<app>.json    the app's usage history for the recently used tab (ribbon-usage-history.hxx)
+//   settings.json       the recently used tab's switch
+// Nothing here leaves the machine.
+
+#include <rtl/ustring.hxx>
+
+#include <optional>
+#include <string>
+#include <string_view>
+
+namespace hst::ribbon::lo
+{
+/// the URL of <profile>/user/hst-ribbon/ (with the slash), created when bCreate; empty without a profile
+OUString ProfileDirUrl(bool bCreate);
+
+/// the file's text, nullopt when it is missing or unreadable (a file over 4 MB is not read)
+std::optional<std::string> ReadProfileFile(std::u16string_view aName);
+/// writes the file through a temporary one (a crash never leaves half a file); false on failure
+bool WriteProfileFile(std::u16string_view aName, std::string_view aText);
+bool RemoveProfileFile(std::u16string_view aName);
+
+/// any file URL: read (at most 4 MB) and written whole (export and import of the dialog)
+std::optional<std::string> ReadUrl(const OUString& rUrl);
+bool WriteUrl(const OUString& rUrl, std::string_view aText);
+
+/// today's local date as days since 1970-01-01
+sal_Int64 Today();
+
+OUString FromUtf8(std::string_view aText);
+std::string ToUtf8(std::u16string_view aText);
+}
