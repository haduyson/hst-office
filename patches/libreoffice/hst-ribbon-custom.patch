+++ b/hst/ribbon/core/ribbon-usage-store.hxx
@@ -0,0 +1,81 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ */
+
+#pragma once
+
+// HST Office ribbon core: the recently used tab's state for every app, without I/O. It holds the switch
+// (settings.json) and each app's usage history (usage-<app>.json), read on first use and written through the
+// Files callbacks the adapter supplies (the user profile). Standard C++ only; not thread-safe, the adapter
+// serialises every call.
+//
+// Switching the tab off stops recording and hides the tab, but keeps every history, in memory and in the
+// profile: switching it on again shows the same commands. Only clearAll() ("Xóa lịch sử") forgets them.
+
+#include "ribbon-usage-history.hxx"
+
+#include <functional>
+#include <map>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace hst::ribbon::core
+{
+class UsageStore
+{
+public:
+    /// the profile folder by file name: read (nullopt when missing or unreadable), write whole, remove
+    struct Files
+    {
+        std::function<std::optional<std::string>(const std::string& rName)> read;
+        std::function<bool(const std::string& rName, const std::string& rText)> write;
+        std::function<bool(const std::string& rName)> remove;
+    };
+
+    static constexpr std::string_view SETTINGS_FILE = "settings.json";
+    /// the apps the recently used tab exists in
+    static const std::vector<std::string>& apps();
+    /// "usage-<app>.json"
+    static std::string usageFile(const std::string& rApp);
+
+    explicit UsageStore(Files aFiles);
+
+    bool recentEnabled();
+    /// writes the switch; never touches a history
+    void setRecentEnabled(bool bEnabled);
+
+    /// counts a run of aCommand in the app's history; false (nothing changed) when the switch is off, or for
+    /// noise and malformed commands
+    bool record(const std::string& rApp, std::string_view aCommand, Day nToday);
+    /// the app's commands, most used first (UsageHistory::ranked), at most nLimit
+    std::vector<std::string> ranked(const std::string& rApp, Day nToday, std::size_t nLimit);
+    /// changes whenever the app's history does
+    unsigned revision(const std::string& rApp) const;
+
+    /// forgets every app's history, in memory and in the profile; the apps whose file was not removed
+    std::vector<std::string> clearAll();
+    /// writes the changed histories, pruned to the window ending nToday; a failed write is tried again later
+    void flush(Day nToday);
+
+private:
+    struct App
+    {
+        UsageHistory history;
+        bool loaded = false;
+        bool dirty = false;
+        unsigned revision = 0;
+    };
+
+    const UsageSettings& settings();
+    App& app(const std::string& rApp, Day nToday);
+
+    Files m_aFiles;
+    std::optional<UsageSettings> m_oSettings;
+    std::map<std::string, App> m_aApps;
+};
+}
