+namespace
+{
+constexpr OUString IMPLEMENTATION = u"vn.hasontech.hst.RibbonCustomization"_ustr;
+
+class RibbonCustomization : public cppu::WeakImplHelper<css::lang::XServiceInfo, css::task::XJob>
+{
+public:
+    virtual OUString SAL_CALL getImplementationName() override { return IMPLEMENTATION; }
+    virtual sal_Bool SAL_CALL supportsService(const OUString& rName) override
+    {
+        return cppu::supportsService(this, rName);
+    }
+    virtual css::uno::Sequence<OUString> SAL_CALL getSupportedServiceNames() override { return { IMPLEMENTATION }; }
+
+    virtual css::uno::Any SAL_CALL execute(const css::uno::Sequence<css::beans::NamedValue>& rArguments) override
+    {
+        OUString aAction;
+        bool bEnabled = true;
+        css::uno::Reference<css::awt::XWindow> xParent;
+        for (const css::beans::NamedValue& rArgument : rArguments)
+        {
+            if (rArgument.Name == "Action")
+                rArgument.Value >>= aAction;
+            else if (rArgument.Name == "Enabled")
+                rArgument.Value >>= bEnabled;
+            else if (rArgument.Name == "ParentWindow")
+                rArgument.Value >>= xParent;
+        }
+        SolarMutexGuard aGuard;
+        if (aAction == "getRecentEnabled")
+            return css::uno::Any(RecentEnabled());
+        if (aAction == "setRecentEnabled")
+        {
+            if (bEnabled != RecentEnabled())
+            {
+                SetRecentEnabled(bEnabled);
+                RibbonController::ReloadApp(std::string());
+            }
+            return css::uno::Any(true);
+        }
+        if (aAction == "clearHistory")
+        {
+            ClearHistory();
+            RibbonController::RefreshRecentTabs();
+            return css::uno::Any(true);
+        }
+        if (aAction == "customize")
+        {
+            weld::Window* pParent = xParent.is() ? Application::GetFrameWeld(xParent) : nullptr;
+            SfxViewFrame* pView = SfxViewFrame::Current();
+            RibbonController* pController
+                = pView ? RibbonController::OfFrame(pView->GetFrame().GetFrameInterface()) : nullptr;
+            if (!pController)
+            {
+                std::unique_ptr<weld::MessageDialog> xInfo(Application::CreateMessageDialog(
+                    pParent, VclMessageType::Info, VclButtonsType::Ok, SfxResId(STR_HST_RIBBON_NO_RIBBON)));
+                xInfo->run();
+                return css::uno::Any(false);
+            }
+            OpenCustomizeDialog(*pController, pParent);
+            return css::uno::Any(true);
+        }
+        throw css::lang::IllegalArgumentException("unknown Action: " + aAction, getXWeak(), 0);
+    }
+};
+}
