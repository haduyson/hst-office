+OUString CustomizeDialog::Fold(const OUString& rText) const
+{
+    OUString aText = rText.replaceAll("~", "");
+    if (m_xFold)
+        aText = m_xFold->transliterate(aText, Application::GetSettings().GetUILanguageTag().getLanguageType(), 0,
+                                       aText.getLength(), nullptr);
+    // đ has no accent to drop: it is d for a search typed without accents
+    return aText.toAsciiLowerCase().replace(u'đ', 'd').replace(u'Đ', 'd');
+}
+
+OUString CustomizeDialog::CommandLabel(const core::Command& rCommand) const
+{
+    if (!rCommand.label.empty())
+        return FromUtf8(rCommand.label);
+    const OUString aId = FromUtf8(rCommand.id);
+    const OUString aLabel = vcl::CommandInfoProvider::GetLabelForCommand(
+        vcl::CommandInfoProvider::GetCommandProperties(aId, m_aModule));
+    return aLabel.isEmpty() ? aId : aLabel.replaceAll("~", "");
+}
+
+namespace
+{
+void SortByLabel(std::vector<CatalogEntry>& rEntries)
+{
+    CollatorWrapper aCollator(comphelper::getProcessComponentContext());
+    aCollator.loadDefaultCollator(Application::GetSettings().GetUILanguageTag().getLocale(), 0);
+    std::sort(rEntries.begin(), rEntries.end(), [&aCollator](const CatalogEntry& a, const CatalogEntry& b) {
+        return aCollator.compareString(a.label, b.label) < 0;
+    });
+}
