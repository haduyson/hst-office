+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ */
+
+#pragma once
+
+// HST Office ribbon core: the groups of the "Sử dụng gần đây" (recently used) tab. Standard C++ only.
+//
+// The most used commands (UsageHistory::ranked) are grouped by their home: the first tab of the app's default ribbon
+// that shows the command, captioned with that tab's name ("Trang đầu", "Chèn", ...); commands no tab shows (menus,
+// shortcuts only) go to one last group. The groups follow the tab order, so a command keeps its place among its
+// neighbours as the ranking moves; inside a group the commands are most used first. The ribbon layout computes
+// positions and sizes; the adapter shows only as many commands as fit (it drops them from the end of the ranking).
+
+#include "ribbon-layout-model.hxx"
+
+#include <cstddef>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace hst::ribbon::core
+{
+struct RecentCommand
+{
+    std::string id;
+    char kind = 'M';
+    bool dropdown = false;
+    std::size_t rank = 0; // 0 = the most used
+};
+
+struct RecentGroup
+{
+    std::string id; // "hst-recent-<home tab id>", "hst-recent-other"
+    std::string label;
+    std::vector<RecentCommand> commands;
+};
+
+/// rRanked: commands, most used first (the adapter has left out those the app cannot show as a button). At most
+/// nMaxCommands commands in all.
+std::vector<RecentGroup> planRecentGroups(const std::vector<std::string>& rRanked, const Layout& rDefaults,
+                                          std::size_t nMaxCommands, std::string_view aOtherLabel);
+
+/// the layout letters of a recent or custom group (ribbon-v3: one per command): a box or gallery keeps its letter,
+/// a group of one button shows it large, buttons are small with their labels otherwise (the layout makes them
+/// large on a sparse tab)
+std::string groupKinds(const std::vector<char>& rKinds);
+
+/// drops the least used command of rGroups (the highest rank); false when none is left
+bool dropLeastUsed(std::vector<RecentGroup>& rGroups);
+}
