@@ -0,0 +1,112 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ */
+
+#include "ribbon-usage-store.hxx"
+
+#include <utility>
+
+namespace hst::ribbon::core
+{
+const std::vector<std::string>& UsageStore::apps()
+{
+    static const std::vector<std::string> aApps{ "writer", "calc", "impress", "draw" };
+    return aApps;
+}
+
+std::string UsageStore::usageFile(const std::string& rApp) { return "usage-" + rApp + ".json"; }
+
+UsageStore::UsageStore(Files aFiles)
+    : m_aFiles(std::move(aFiles))
+{
+}
+
+const UsageSettings& UsageStore::settings()
+{
+    if (!m_oSettings)
+    {
+        const std::optional<std::string> aText = m_aFiles.read(std::string(SETTINGS_FILE));
+        m_oSettings = aText ? UsageSettings::parse(*aText) : UsageSettings();
+    }
+    return *m_oSettings;
+}
+
+UsageStore::App& UsageStore::app(const std::string& rApp, Day nToday)
+{
+    App& rState = m_aApps[rApp];
+    if (!rState.loaded)
+    {
+        rState.loaded = true;
+        if (const std::optional<std::string> aText = m_aFiles.read(usageFile(rApp)))
+            rState.history = UsageHistory::parse(*aText, nToday);
+    }
+    return rState;
+}
+
+bool UsageStore::recentEnabled() { return settings().recentEnabled; }
+
+void UsageStore::setRecentEnabled(bool bEnabled)
+{
+    UsageSettings aSettings = settings();
+    aSettings.recentEnabled = bEnabled;
+    m_oSettings = aSettings;
+    m_aFiles.write(std::string(SETTINGS_FILE), aSettings.write());
+}
+
+bool UsageStore::record(const std::string& rApp, std::string_view aCommand, Day nToday)
+{
+    if (!settings().recentEnabled)
+        return false;
+    App& rState = app(rApp, nToday);
+    if (!rState.history.record(aCommand, nToday))
+        return false;
+    rState.dirty = true;
+    ++rState.revision;
+    return true;
+}
+
+std::vector<std::string> UsageStore::ranked(const std::string& rApp, Day nToday, std::size_t nLimit)
+{
+    std::vector<std::string> aOut;
+    for (const UsageHistory::Ranked& rItem : app(rApp, nToday).history.ranked(nToday, nLimit))
+        aOut.push_back(rItem.command);
+    return aOut;
+}
+
+unsigned UsageStore::revision(const std::string& rApp) const
+{
+    const auto it = m_aApps.find(rApp);
+    return it == m_aApps.end() ? 0 : it->second.revision;
+}
+
+std::vector<std::string> UsageStore::clearAll()
+{
+    std::vector<std::string> aKept;
+    for (const std::string& rApp : apps())
+    {
+        App& rState = m_aApps[rApp];
+        rState.history.clear();
+        rState.loaded = true;
+        rState.dirty = false;
+        ++rState.revision;
+        // a missing file is already cleared
+        if (!m_aFiles.remove(usageFile(rApp)) && m_aFiles.read(usageFile(rApp)))
+            aKept.push_back(rApp);
+    }
+    return aKept;
+}
+
+void UsageStore::flush(Day nToday)
+{
+    for (auto& [rApp, rState] : m_aApps)
+    {
+        if (!rState.dirty)
+            continue;
+        rState.history.prune(nToday);
+        rState.dirty = !m_aFiles.write(usageFile(rApp), rState.history.write());
+    }
+}
+}
+
