+ */
+
+#pragma once
+
+// HST Office ribbon adapter: one Tabbed ribbon (its tab control) with the user's customization and the recently
+// used tab applied.
+//
+// The built-in ribbon is read as it was built (the default layout: its main tabs, the v3 groups of each tab, the
+// commands of each group in reading order). The customization (custom-<app>.json) is merged into it by the core;
+// the result is applied to the widgets:
+// - a hidden built-in group leaves its tab's group box (it waits in a hidden window until the ribbon goes);
+//   a hidden built-in command is hidden in its group (the v3 layout skips it);
+// - a group whose commands the user reordered gets its commands in that order and a layout spec without the fixed
+//   rows of its default design; groups of a tab are reordered in the box;
+// - custom groups and tabs are .ui documents (ribbon-ui-markup) built by the office's widget builder into the
+//   tab's group box or into a new tab page, so their commands get the usual controllers and the v3 layout.
+// The recently used tab stands right after Trang đầu (Home); it is rebuilt when it is shown after the history
+// changed or the window's width did. A customization change rebuilds the app's ribbons.
+
+#include "../core/ribbon-layout-model.hxx"
+
+#include <com/sun/star/frame/XFrame.hpp>
+#include <cppuhelper/weakref.hxx>
+#include <rtl/ustring.hxx>
+#include <tools/link.hxx>
+#include <tools/long.hxx>
+#include <vcl/vclptr.hxx>
+
+#include <map>
+#include <memory>
+#include <string>
+#include <vector>
+
+class SystemWindow;
+class TabControl;
+class TabPage;
+class VclBuilder;
+class VclWindowEvent;
+struct ImplSVEvent;
+namespace vcl
+{
+class Window;
+}
+
+namespace hst::ribbon::lo
+{
+class RibbonController
+{
+public:
+    RibbonController(TabControl& rTabs, std::string aApp, const css::uno::Reference<css::frame::XFrame>& xFrame);
+    ~RibbonController();
+
+    /// the controller of the ribbon that holds rWindow (or is its tab control), nullptr when there is none
+    static RibbonController* Of(const vcl::Window& rWindow);
+    /// the controller of the frame's window, nullptr when it shows no Tabbed ribbon
+    static RibbonController* OfFrame(const css::uno::Reference<css::frame::XFrame>& xFrame);
+    /// rebuilds the ribbons of rApp ("" = every app) once the current event is handled
+    static void ReloadApp(const std::string& rApp);
+    /// the recently used tabs that are shown now are rebuilt (the history was cleared)
+    static void RefreshRecentTabs();
+
+    const std::string& App() const { return m_aApp; }
+    const core::Layout& Defaults() const { return m_aDefaults; }
+    const core::Layout& Effective() const { return m_aEffective; }
+    css::uno::Reference<css::frame::XFrame> Frame() const;
+    TabControl* Tabs() const;
+    /// the document window the ribbon belongs to (the notebookbar is not a child of it: it sits in its border)
+    SystemWindow* System() const;
+
+    /// reads the built ribbon and applies the customization and the recently used tab (once)
+    void Apply();
+
+private:
+    struct BuiltGroup
+    {
+        VclPtr<vcl::Window> grid;
+        std::vector<char> kinds; // of the commands built, in child order
+    };
+
+    void ReadDefaults();
+    void ApplyBuiltinTab(const core::Tab& rTab);
+    void AddCustomTab(const core::Tab& rTab, const OUString& rAfterPage);
+    void AddRecentTab();
+    void RefreshRecent();
+    void DisposeOwned();
+    void Watch(vcl::Window& rWindow);
+    sal_uInt16 NewPageId() const;
+    TabPage* InsertPage(const OUString& rName, const OUString& rText, sal_uInt16 nPos);
+    /// builds a .ui document into rParent; nullptr on failure (the ribbon stays as it was)
+    std::unique_ptr<VclBuilder> Build(vcl::Window& rParent, const std::string& rDocument);
+    vcl::Window& Parking();
+
+    DECL_LINK(TabsEventHdl, VclWindowEvent&, void);
+    DECL_LINK(RefreshHdl, void*, void);
+
+    VclPtr<TabControl> m_xTabs;
+    std::string m_aApp;
+    css::uno::WeakReference<css::frame::XFrame> m_xFrame;
+    VclPtr<SystemWindow> m_xSystem;
+    core::Layout m_aDefaults;
+    core::Layout m_aEffective;
+    bool m_bApplied = false;
+    ImplSVEvent* m_pRefreshEvent = nullptr;
+
+    /// built-in widgets by id: tab pages, groups (grids), the commands of a group in reading order
+    std::map<std::string, VclPtr<vcl::Window>> m_aGroupWindows;
+    std::map<std::string, std::vector<VclPtr<vcl::Window>>> m_aCommandWindows;
+    std::map<std::string, std::string> m_aGroupSpecs;
+    /// what this controller built or moved: disposed before the ribbon goes
+    std::vector<std::unique_ptr<VclBuilder>> m_aBuilders;
+    std::vector<VclPtr<TabPage>> m_aPages;
+    VclPtr<vcl::Window> m_xParking;
+    /// group boxes holding custom groups: those groups go when the box does
+    std::vector<VclPtr<vcl::Window>> m_aWatched;
+
+    /// the recently used tab
+    sal_uInt16 m_nRecentPage = 0;
+    std::unique_ptr<VclBuilder> m_xRecentBuilder;
+    unsigned m_nRecentRevision = 0;
+    tools::Long m_nRecentWidth = -1;
+    bool m_bRecentBuilt = false;
+};
+}
