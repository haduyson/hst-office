+// The Go To tab of Find and Replace: Word's list of places, moving the document's own view cursor.
+
+#include <hstfindtabs.hxx>
+
+#include <com/sun/star/beans/XPropertySet.hpp>
+#include <com/sun/star/container/XIndexAccess.hpp>
+#include <com/sun/star/container/XNameAccess.hpp>
+#include <com/sun/star/frame/DispatchHelper.hpp>
+#include <com/sun/star/frame/XController.hpp>
+#include <com/sun/star/frame/XDispatchProvider.hpp>
+#include <com/sun/star/frame/XModel.hpp>
+#include <com/sun/star/text/XBookmarksSupplier.hpp>
+#include <com/sun/star/text/XEndnotesSupplier.hpp>
+#include <com/sun/star/text/XFootnotesSupplier.hpp>
+#include <com/sun/star/text/XPageCursor.hpp>
+#include <com/sun/star/text/XTextContent.hpp>
+#include <com/sun/star/text/XTextViewCursorSupplier.hpp>
+#include <com/sun/star/view/XViewCursor.hpp>
+#include <comphelper/processfactory.hxx>
+#include <comphelper/propertysequence.hxx>
+#include <sfx2/bindings.hxx>
+#include <sfx2/dispatch.hxx>
+#include <sfx2/frame.hxx>
+#include <sfx2/viewfrm.hxx>
+#include <cstdlib>
+
+using namespace css;
+
+namespace
+{
+// Word's list, in Word's order, and how Writer browses each. The numbers are Writer's NID_* values (workctrl.hxx).
+enum What { PAGE, SECTION, LINE, BOOKMARK, COMMENT, FOOTNOTE, ENDNOTE, FIELD, TABLE, GRAPHIC, EQUATION, OBJECT, HEADING };
+constexpr sal_Int32 aMoveType[] = { 20002, 20005, 0, 20006, 20013, 20011, 20011, 20019, 20000, 20007, 20008, 20008, 20009 };
+// Lines of the hidden list of prompts in the .ui file.
+enum Prompts { P_PAGE, P_SECTION, P_LINE, P_NAME, P_NUMBER, P_NOT_FOUND, P_ADVANCED };
+}
+
+uno::Reference<frame::XFrame> HstFindTabs::Frame() const
+{
+    SfxDispatcher* pDispatcher = m_rBindings.GetDispatcher();
+    SfxViewFrame* pFrame = pDispatcher ? pDispatcher->GetFrame() : nullptr;
+    return pFrame ? pFrame->GetFrame().GetFrameInterface() : nullptr;
+}
+
+uno::Reference<text::XTextViewCursor> HstFindTabs::ViewCursor() const
+{
+    uno::Reference<frame::XFrame> xFrame = Frame();
+    uno::Reference<text::XTextViewCursorSupplier> xSupplier(xFrame ? xFrame->getController() : nullptr, uno::UNO_QUERY);
+    return xSupplier ? xSupplier->getViewCursor() : nullptr;
+}
+
+void HstFindTabs::Dispatch(const OUString& rCommand, sal_Int32 nMoveType) const
+{
+    uno::Reference<frame::XDispatchProvider> xProvider(Frame(), uno::UNO_QUERY);
+    if (!xProvider)
+        return;
+    uno::Sequence<beans::PropertyValue> aArgs = nMoveType
+        ? comphelper::InitPropertySequence({ { "SynchronMode", uno::Any(true) }, { "NavElement", uno::Any(nMoveType) } })
+        : comphelper::InitPropertySequence({ { "SynchronMode", uno::Any(true) } });
+    frame::DispatchHelper::create(comphelper::getProcessComponentContext())
+        ->executeDispatch(xProvider, rCommand, u""_ustr, 0, aArgs);
+}
+
+/// One item on. False when Writer found none, or wrapped round the document: it reports that in the search label.
+bool HstFindTabs::Step(bool bNext)
+{
+    const int nWhat = m_xWhat->get_active();
+    uno::Reference<text::XTextViewCursor> xCursor = ViewCursor();
+    if (!xCursor)
+        return false;
+    if (nWhat == PAGE)
+    {
+        uno::Reference<text::XPageCursor> xPages(xCursor, uno::UNO_QUERY_THROW);
+        const sal_Int16 nPage = xPages->getPage();
+        return xPages->jumpToPage(nPage + (bNext ? 1 : -1)) && xPages->getPage() != nPage;
+    }
+    if (nWhat == LINE)
+    {
+        uno::Reference<view::XViewCursor> xLines(xCursor, uno::UNO_QUERY_THROW);
+        return bNext ? xLines->goDown(1, false) : xLines->goUp(1, false);
+    }
+    m_xSearchLabel->set_label(OUString());
+    Dispatch(u".uno:NavElement"_ustr, aMoveType[nWhat]);
+    Dispatch(bNext ? u".uno:ScrollToNext"_ustr : u".uno:ScrollToPrevious"_ustr);
+    return m_xSearchLabel->get_label().isEmpty();
+}
+
+void HstFindTabs::GoRelative(int nSteps)
+{
+    Say(OUString());
+    for (int i = 0; i < std::abs(nSteps); ++i)
+    {
+        if (!Step(nSteps > 0))
+        {
+            Say(m_xSearchLabel->get_label().isEmpty() ? Prompt(P_NOT_FOUND) : m_xSearchLabel->get_label());
+            return;
+        }
+    }
+}
+
+void HstFindTabs::ShowContent(const uno::Reference<text::XTextViewCursor>& xCursor,
+                              const uno::Reference<text::XTextContent>& xContent)
+{
+    if (xContent)
+        xCursor->gotoRange(xContent->getAnchor(), false);
+    else
+        Say(Prompt(P_NOT_FOUND));
+}
+
+void HstFindTabs::GoToValue()
+{
+    const OUString aValue = m_xValue->get_active_text().trim();
+    const int nWhat = m_xWhat->get_active();
+    uno::Reference<text::XTextViewCursor> xCursor = ViewCursor();
+    if (aValue.isEmpty() || !xCursor)
+        return;
+    Say(OUString());
+    uno::Reference<frame::XModel> xModel = Frame()->getController()->getModel();
+    if (nWhat == BOOKMARK)
+    {
+        uno::Reference<text::XBookmarksSupplier> xMarks(xModel, uno::UNO_QUERY);
+        uno::Reference<container::XNameAccess> xNames = xMarks ? xMarks->getBookmarks() : nullptr;
+        uno::Reference<text::XTextContent> xMark;
+        if (xNames && xNames->hasByName(aValue))
+            xNames->getByName(aValue) >>= xMark;
+        return ShowContent(xCursor, xMark);
+    }
+    const sal_Int32 nNumber = aValue.toInt32();
+    if (aValue[0] == '+' || aValue[0] == '-')
+        return GoRelative(nNumber);
+    if (nNumber <= 0)
+        return Say(Prompt(P_NOT_FOUND));
+    if (nWhat == PAGE)
+    {
+        uno::Reference<text::XPageCursor> xPages(xCursor, uno::UNO_QUERY_THROW);
+        // As in Word, a number past the end goes to the last page.
+        if (!xPages->jumpToPage(nNumber) || xPages->getPage() != nNumber)
+            xPages->jumpToLastPage();
+        return;
+    }
+    if (nWhat == FOOTNOTE || nWhat == ENDNOTE)
+    {
+        uno::Reference<text::XFootnotesSupplier> xFoot(xModel, uno::UNO_QUERY);
+        uno::Reference<text::XEndnotesSupplier> xEnd(xModel, uno::UNO_QUERY);
+        uno::Reference<container::XIndexAccess> xNotes = nWhat == FOOTNOTE ? xFoot->getFootnotes() : xEnd->getEndnotes();
+        uno::Reference<text::XTextContent> xNote;
+        if (nNumber <= xNotes->getCount())
+            xNotes->getByIndex(nNumber - 1) >>= xNote;
+        return ShowContent(xCursor, xNote);
+    }
+    // The Nth from the start of the document. What the start itself already is counts as the first.
+    uno::Reference<text::XTextRange> xWasAt = xCursor->getStart();
+    xCursor->gotoStart(false);
+    int nSteps = nNumber;
+    uno::Reference<beans::XPropertySet> xProps(xCursor, uno::UNO_QUERY);
+    if (nWhat == LINE || (nWhat == TABLE && xProps->getPropertyValue(u"TextTable"_ustr).hasValue())
+        || (nWhat == HEADING && xProps->getPropertyValue(u"OutlineLevel"_ustr).get<sal_Int16>() > 0))
+        --nSteps;
+    for (int i = 0; i < nSteps; ++i)
+    {
+        if (!Step(true))
+        {
+            xCursor->gotoRange(xWasAt, false);
+            return Say(Prompt(P_NOT_FOUND));
+        }
+    }
+}
+
+IMPL_LINK_NOARG(HstFindTabs, WhatHdl, weld::ComboBox&, void)
+{
+    const int nWhat = m_xWhat->get_active();
+    m_xValue->clear();
+    m_xValue->set_entry_text(OUString());
+    m_xGo->set_sensitive(false);
+    Say(OUString());
+    m_xPrompt->set_label(Prompt(nWhat == PAGE ? P_PAGE : nWhat == SECTION ? P_SECTION : nWhat == LINE ? P_LINE
+                                : nWhat == BOOKMARK ? P_NAME : P_NUMBER));
+    if (nWhat != BOOKMARK)
+        return;
+    uno::Reference<text::XBookmarksSupplier> xMarks(Frame()->getController()->getModel(), uno::UNO_QUERY);
+    if (xMarks)
+        for (const OUString& rName : xMarks->getBookmarks()->getElementNames())
+            m_xValue->append_text(rName);
+}
+
+IMPL_LINK_NOARG(HstFindTabs, ValueHdl, weld::ComboBox&, void) { m_xGo->set_sensitive(!m_xValue->get_active_text().trim().isEmpty()); }
+IMPL_LINK_NOARG(HstFindTabs, PrevHdl, weld::Button&, void) { GoRelative(-1); }
+IMPL_LINK_NOARG(HstFindTabs, NextHdl, weld::Button&, void) { GoRelative(1); }
+IMPL_LINK_NOARG(HstFindTabs, GoHdl, weld::Button&, void) { GoToValue(); }
+IMPL_LINK_NOARG(HstFindTabs, ActivateHdl, weld::ComboBox&, bool) { return GoToValue(), true; }
+
