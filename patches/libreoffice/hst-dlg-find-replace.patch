+// Lines of the hidden list of prompts in the .ui file.
+enum Prompts { P_PAGE, P_ADVANCED = 6 };
+constexpr int PAGE_ENTRY = 0;
+}
+
+HstFindTabs::HstFindTabs(weld::Builder& rBuilder, weld::Dialog& rDialog, SfxBindings& rBindings)
+    : m_rDialog(rDialog)
+    , m_rBindings(rBindings)
+    , m_xTabs(rBuilder.weld_notebook(u"hsttabs"_ustr))
+    , m_xSearchFrame(rBuilder.weld_widget(u"searchframe"_ustr))
+    , m_xReplaceFrame(rBuilder.weld_widget(u"replaceframe"_ustr))
+    , m_xControls(rBuilder.weld_widget(u"controlbox"_ustr))
+    , m_xComponent(rBuilder.weld_widget(u"componentframe"_ustr))
+    , m_xOptions(rBuilder.weld_widget(u"optionsgrid"_ustr))
+    , m_xReplace(rBuilder.weld_widget(u"replace"_ustr))
+    , m_xReplaceAll(rBuilder.weld_widget(u"replaceall"_ustr))
+    , m_xReplaceBack(rBuilder.weld_widget(u"replace_backwards"_ustr))
+    , m_xPanel(rBuilder.weld_widget(u"hstgotopanel"_ustr))
+    , m_xWhat(rBuilder.weld_combo_box(u"hstgotowhat"_ustr))
+    , m_xValue(rBuilder.weld_combo_box(u"hstgotovalue"_ustr))
+    , m_xPrompts(rBuilder.weld_combo_box(u"hstgotoprompts"_ustr))
+    , m_xPrompt(rBuilder.weld_label(u"hstgotoprompt"_ustr))
+    , m_xMessage(rBuilder.weld_label(u"hstgotomessage"_ustr))
+    , m_xSearchLabel(rBuilder.weld_label(u"searchlabel"_ustr))
+    , m_xPrev(rBuilder.weld_button(u"hstgotoprev"_ustr))
+    , m_xNext(rBuilder.weld_button(u"hstgotonext"_ustr))
+    , m_xGo(rBuilder.weld_button(u"hstgotogo"_ustr))
+{
+    m_xTabs->connect_enter_page(LINK(this, HstFindTabs, PageHdl));
+    m_xWhat->connect_changed(LINK(this, HstFindTabs, WhatHdl));
+    m_xValue->connect_changed(LINK(this, HstFindTabs, ValueHdl));
+    m_xValue->connect_entry_activate(LINK(this, HstFindTabs, ActivateHdl));
+    m_xPrev->connect_clicked(LINK(this, HstFindTabs, PrevHdl));
+    m_xNext->connect_clicked(LINK(this, HstFindTabs, NextHdl));
+    m_xGo->connect_clicked(LINK(this, HstFindTabs, GoHdl));
+    m_xWhat->set_active(PAGE_ENTRY);
+    m_xPrompt->set_label(Prompt(P_PAGE));
+    m_xGo->set_sensitive(false);
+    // As before this strip: the dialog comes up with both search and replace.
+    m_xTabs->set_current_page(u"hsttabreplace"_ustr);
+    if (comphelper::LibreOfficeKit::isActive())
+        m_xTabs->hide();
+}
+
+void HstFindTabs::Refresh(bool bWriter, weld::Expander& rOptions)
+{
+    if (!bWriter && m_xTabs->get_page_index(u"hsttabgoto"_ustr) != -1)
+    {
+        m_xTabs->remove_page(u"hsttabgoto"_ustr);
+        if (m_aPage == "hsttabgoto")
+            m_aPage = m_xTabs->get_current_page_ident();
+    }
+    if (bWriter)
+        rOptions.set_label(Prompt(P_ADVANCED));
+    ApplyPage(OUString());
+}
+
+void HstFindTabs::ApplyPage(const OUString& rPage)
+{
+    // gtk reports the page being entered before it becomes the current one, and hiding controls then can make the
+    // dialog refresh within that signal: keep the page from the signal rather than asking the strip.
+    if (!rPage.isEmpty())
+        m_aPage = rPage;
+    const OUString& aPage = m_aPage;
+    const bool bGoTo = aPage == "hsttabgoto";
+    const bool bReplace = aPage == "hsttabreplace";
+    if (bGoTo && !m_bInGoTo)
+        m_bComponentShown = m_xComponent->get_visible();
+    if (m_bInGoTo && !bGoTo)
+        m_xComponent->set_visible(m_bComponentShown);
+    else if (bGoTo)
+        m_xComponent->hide();
+    m_bInGoTo = bGoTo;
+
+    m_xPanel->set_visible(bGoTo);
+    m_xSearchFrame->set_visible(!bGoTo);
+    m_xControls->set_visible(!bGoTo);
+    m_xOptions->set_visible(!bGoTo);
+    m_xReplaceFrame->set_visible(bReplace);
+    m_xReplace->set_visible(bReplace);
+    m_xReplaceAll->set_visible(bReplace);
+    m_xReplaceBack->set_visible(bReplace);
+    m_rDialog.resize_to_request();
+}
+
+IMPL_LINK(HstFindTabs, PageHdl, const OUString&, rPage, void) { ApplyPage(rPage); }
