+
+private:
+    void ApplyPage(const OUString& rPage);
+    void GoRelative(int nSteps);
+    void GoToValue();
+    void ShowContent(const css::uno::Reference<css::text::XTextViewCursor>& xCursor,
+                     const css::uno::Reference<css::text::XTextContent>& xContent);
+    bool Step(bool bNext);
+    void Say(const OUString& rText) { m_xMessage->set_label(rText); }
+    OUString Prompt(int nId) const { return m_xPrompts->get_text(nId); }
+    css::uno::Reference<css::frame::XFrame> Frame() const;
+    css::uno::Reference<css::text::XTextViewCursor> ViewCursor() const;
+    void Dispatch(const OUString& rCommand, sal_Int32 nMoveType = 0) const;
+
+    DECL_LINK(PageHdl, const OUString&, void);
+    DECL_LINK(WhatHdl, weld::ComboBox&, void);
+    DECL_LINK(ValueHdl, weld::ComboBox&, void);
+    DECL_LINK(PrevHdl, weld::Button&, void);
+    DECL_LINK(NextHdl, weld::Button&, void);
+    DECL_LINK(GoHdl, weld::Button&, void);
+    DECL_LINK(ActivateHdl, weld::ComboBox&, bool);
+
+    weld::Dialog& m_rDialog;
+    SfxBindings& m_rBindings;
+    bool m_bComponentShown = false;
+    bool m_bInGoTo = false;
+    OUString m_aPage = u"hsttabreplace"_ustr; ///< the page shown
+    std::unique_ptr<weld::Notebook> m_xTabs;
+    std::unique_ptr<weld::Widget> m_xSearchFrame, m_xReplaceFrame, m_xControls, m_xComponent, m_xOptions;
+    std::unique_ptr<weld::Widget> m_xReplace, m_xReplaceAll, m_xReplaceBack, m_xPanel;
+    std::unique_ptr<weld::ComboBox> m_xWhat, m_xValue, m_xPrompts;
+    std::unique_ptr<weld::Label> m_xPrompt, m_xMessage, m_xSearchLabel;
+    std::unique_ptr<weld::Button> m_xPrev, m_xNext, m_xGo;
+};
