+/// Word's three tabs on Find and Replace. The strip only shows or hides the existing controls, so searching
+/// itself is untouched; Go To, in Writer only, moves the document's own view cursor.
+class HstFindTabs
+{
+public:
+    HstFindTabs(weld::Builder& rBuilder, weld::Dialog& rDialog, SfxBindings& rBindings);
