+Color ReadablePushButtonText(const OutputDevice& rDev, const Color& rText, bool bPressed,
+                             bool bHover)
+{
+    if (!DrawsOn(rDev))
+        return rText;
+    // the fill PaintPushButton gives the state (enabled: a disabled label is drawn in VCL's own
+    // disabled colour, whatever rText is)
+    const auto& p = hst::design::GetPalette(rDev.GetSettings().GetStyleSettings());
+    const Color aFill = bPressed ? p.aPressed : bHover ? p.aHover : p.aControlFill;
+    return ContrastRatio(rText, aFill) >= 4.5 ? rText : p.aText;
+}
