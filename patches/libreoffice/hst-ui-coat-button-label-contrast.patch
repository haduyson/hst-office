+/* A push button's label stays readable (WCAG AA, 4.5:1) on the coat's fill in every state, light and
+   dark: macOS gives a default button white text for its native accent bezel, and the coat draws the
+   button on its light control fill instead. A readable colour is kept as it is. */
+CPPUNIT_TEST_FIXTURE(CoatTest, testPushButtonLabelReadable)
+{
+    auto contrast = [](const Color& rA, const Color& rB) {
+        auto luminance = [](const Color& rColor) {
+            auto channel = [](sal_uInt8 n) {
+                const double f = n / 255.0;
+                return f <= 0.04045 ? f / 12.92 : std::pow((f + 0.055) / 1.055, 2.4);
+            };
+            return 0.2126 * channel(rColor.GetRed()) + 0.7152 * channel(rColor.GetGreen())
+                   + 0.0722 * channel(rColor.GetBlue());
+        };
+        const double fA = luminance(rA);
+        const double fB = luminance(rB);
+        return (std::max(fA, fB) + 0.05) / (std::min(fA, fB) + 0.05);
+    };
+    for (const bool bDark : { false, true })
+    {
+        const auto& p = hst::design::GetPalette(bDark);
+        ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(80, 30), bDark);
+        // the states: resting (also default and focused, which change only the border), hover, pressed
+        const std::pair<bool, bool> aStates[] = { { false, false }, { false, true }, { true, false } };
+        for (const auto & [ bPressed, bHover ] : aStates)
+        {
+            const Color aFill = bPressed ? p.aPressed : bHover ? p.aHover : p.aControlFill;
+            const OString aWhat = OString::Concat(bDark ? "dark" : "light")
+                                  + (bPressed ? ", pressed" : bHover ? ", hover" : ", resting");
+            // the palette's text colour is readable on each fill
+            CPPUNIT_ASSERT_MESSAGE(aWhat.getStr(), contrast(p.aText, aFill) >= 4.5);
+            // the platform's label colours (macOS: white on a default button; black otherwise)
+            for (const Color& rPlatform : { COL_WHITE, COL_BLACK, Color(0xF5, 0xF5, 0xF5) })
+            {
+                const Color aLabel
+                    = hst::coat::ReadablePushButtonText(*pDev, rPlatform, bPressed, bHover);
+                const OString aCase(aWhat + ", label " + rPlatform.AsRGBHexString().toUtf8());
+                CPPUNIT_ASSERT_MESSAGE(aCase.getStr(), contrast(aLabel, aFill) >= 4.5);
+                // a colour already readable is not changed
+                if (contrast(rPlatform, aFill) >= 4.5)
+                    CPPUNIT_ASSERT_EQUAL(rPlatform, aLabel);
+            }
+        }
+    }
+    // the white label of a macOS default button on the light fill: the palette's text
+    {
+        ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(80, 30));
+        CPPUNIT_ASSERT_EQUAL(light().aText,
+                             hst::coat::ReadablePushButtonText(*pDev, COL_WHITE, false, false));
+    }
+    // without the coat (high contrast, or switched off) the platform's colour stays
+    {
+        ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(80, 30), false, true);
+        CPPUNIT_ASSERT_EQUAL(COL_WHITE,
+                             hst::coat::ReadablePushButtonText(*pDev, COL_WHITE, false, false));
+    }
+    {
+        setSwitch(false);
+        ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(80, 30));
+        CPPUNIT_ASSERT_EQUAL(COL_WHITE,
+                             hst::coat::ReadablePushButtonText(*pDev, COL_WHITE, false, false));
+        setSwitch(true);
+    }
+    // GTK: a default button's label in the text colour, except a primary action's (accent and ink)
+    for (const bool bDark : { false, true })
+    {
+        const OString aCss = hst::coat::CreateGtkCss(bDark);
+        const OString aRule("button.default:not(:disabled):not(.suggested-action) label { color: #"
+                            + hst::design::GetPalette(bDark).aText.AsRGBHexString().toUtf8());
+        CPPUNIT_ASSERT(aCss.indexOf(aRule) >= 0);
+        CPPUNIT_ASSERT(aCss.indexOf(aRule) < aCss.indexOf("button.suggested-action label"));
+    }
+}
