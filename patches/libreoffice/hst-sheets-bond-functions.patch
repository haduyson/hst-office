+#pragma once
+
+#include <sal/types.h>
+
+// HST Office: bond functions of the Analysis add-in computed like the leading spreadsheet
+// application documents them. Dates are serial numbers relative to the document null date
+// (nNullDate, an absolute day number as returned by GetNullDate()). Frequency is 1, 2 or 4 and
+// basis 0 (US 30/360), 1 (actual/actual), 2 (actual/360), 3 (actual/365) or 4 (European 30/360).
+// Every function throws css::lang::IllegalArgumentException for an argument outside the
+// function's domain, which the spreadsheet shows as #NUM!.
+
+namespace sca::analysis::hst
+{
+/// Macaulay duration (in years) of a security paying periodic coupons, assumed par 100.
+double bondDuration(sal_Int32 nNullDate, sal_Int32 nSettle, sal_Int32 nMat, double fCoup,
+                    double fYield, sal_Int32 nFreq, sal_Int32 nBase);
+
+/// Modified duration: the Macaulay duration divided by (1 + yield / frequency).
+double bondModifiedDuration(sal_Int32 nNullDate, sal_Int32 nSettle, sal_Int32 nMat, double fCoup,
+                            double fYield, sal_Int32 nFreq, sal_Int32 nBase);
+
+/// Price per 100 face value of a security with an odd (short or long) first period.
+double oddFirstPrice(sal_Int32 nNullDate, sal_Int32 nSettle, sal_Int32 nMat, sal_Int32 nIssue,
+                     sal_Int32 nFirstCoup, double fRate, double fYield, double fRedemp,
+                     sal_Int32 nFreq, sal_Int32 nBase);
+
+/// Yield of a security with an odd (short or long) first period, the inverse of oddFirstPrice().
+double oddFirstYield(sal_Int32 nNullDate, sal_Int32 nSettle, sal_Int32 nMat, sal_Int32 nIssue,
+                     sal_Int32 nFirstCoup, double fRate, double fPrice, double fRedemp,
+                     sal_Int32 nFreq, sal_Int32 nBase);
+}
