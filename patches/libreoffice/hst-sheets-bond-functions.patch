+++ b/scaddins/source/analysis/hstbondfunctions.cxx
@@ -0,0 +1,298 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ * Copyright (c) HASON TECH. HST Office.
+ */
+
+#include "hstbondfunctions.hxx"
+#include "analysishelper.hxx"
+
+#include <com/sun/star/lang/IllegalArgumentException.hpp>
+
+#include <algorithm>
+#include <cmath>
+#include <vector>
+
+// Bond math used below. Coupons fall on a schedule stepping 12 / frequency months back from an
+// anchor date (the maturity, or the first coupon for the odd first period); the day is the
+// anchor's day clamped to the month, or the month's last day when the anchor is a month end.
+// For a (quasi-)coupon period, E is its normal length (360/f for bases 0, 2 and 4, 365/f for
+// basis 3, the actual days for basis 1); A is the days from its start to the settlement and DSC
+// the days from the settlement to its end, counted with the basis (for basis 0, DSC = E - A).
+// With C = 100 * rate / f and v = 1 / (1 + yield / f), a cash flow at t periods from the
+// settlement is discounted by v^t, the first one falling at t = DSC / E.
+
+namespace sca::analysis::hst
+{
+namespace
+{
+[[noreturn]] void domainError() { throw css::lang::IllegalArgumentException(); }
+
+struct Ymd
+{
+    sal_Int32 nYear;
+    sal_Int32 nMonth;
+    sal_Int32 nDay;
+};
+
+Ymd toYmd(sal_Int32 nNullDate, sal_Int32 nSerial)
+{
+    sal_uInt16 nDay, nMonth, nYear;
+    DaysToDate(nNullDate + nSerial, nDay, nMonth, nYear);
+    return { nYear, nMonth, nDay };
+}
+
+sal_Int32 toDays(const Ymd& r)
+{
+    return DateToDays(static_cast<sal_uInt16>(r.nDay), static_cast<sal_uInt16>(r.nMonth),
+                      static_cast<sal_uInt16>(r.nYear));
+}
+
+sal_Int32 daysInMonth(sal_Int32 nYear, sal_Int32 nMonth)
+{
+    return DaysInMonth(static_cast<sal_uInt16>(nMonth), static_cast<sal_uInt16>(nYear));
+}
+
+bool isMonthEnd(const Ymd& r) { return r.nDay == daysInMonth(r.nYear, r.nMonth); }
+
+/// The anchor moved by nMonths whole months (negative: backwards).
+Ymd addMonths(const Ymd& rAnchor, sal_Int32 nMonths, bool bMonthEnd)
+{
+    const sal_Int32 nTotal = rAnchor.nYear * 12 + rAnchor.nMonth - 1 + nMonths;
+    const sal_Int32 nYear = nTotal / 12;
+    if (nTotal < 12 || nYear > 9999)
+        domainError();
+    const sal_Int32 nMonth = nTotal % 12 + 1;
+    const sal_Int32 nLast = daysInMonth(nYear, nMonth);
+    return { nYear, nMonth, bMonthEnd ? nLast : std::min(rAnchor.nDay, nLast) };
+}
+
+/// Days from r1 to r2 counted with the basis.
+double dayCount(const Ymd& r1, const Ymd& r2, sal_Int32 nBase)
+{
+    if (nBase != 0 && nBase != 4)
+        return toDays(r2) - toDays(r1);
+    sal_Int32 nDay1 = r1.nDay, nDay2 = r2.nDay;
+    if (nBase == 4)
+    {
+        nDay1 = std::min<sal_Int32>(nDay1, 30);
+        nDay2 = std::min<sal_Int32>(nDay2, 30);
+    }
+    else
+    {
+        // US (NASD) 30/360: the end of February counts as day 30
+        const bool bFebEnd1 = r1.nMonth == 2 && isMonthEnd(r1);
+        const bool bFebEnd2 = r2.nMonth == 2 && isMonthEnd(r2);
+        if (bFebEnd1 && bFebEnd2)
+            nDay2 = 30;
+        if (bFebEnd1)
+            nDay1 = 30;
+        if (nDay2 == 31 && nDay1 >= 30)
+            nDay2 = 30;
+        if (nDay1 == 31)
+            nDay1 = 30;
+    }
+    return (r2.nYear - r1.nYear) * 360.0 + (r2.nMonth - r1.nMonth) * 30.0 + (nDay2 - nDay1);
+}
+
+/// Normal length E of the (quasi-)coupon period rStart..rEnd.
+double periodLength(const Ymd& rStart, const Ymd& rEnd, sal_Int32 nFreq, sal_Int32 nBase)
+{
+    if (nBase == 1)
+        return toDays(rEnd) - toDays(rStart);
+    return (nBase == 3 ? 365.0 : 360.0) / nFreq;
+}
+
+/// Coupon period of the schedule anchored at rAnchor holding rDate (rPrev <= rDate < rNext);
+/// returns the number of schedule dates after rDate up to the anchor.
+sal_Int32 findPeriod(const Ymd& rAnchor, const Ymd& rDate, sal_Int32 nFreq, Ymd& rPrev, Ymd& rNext)
+{
+    const sal_Int32 nStep = 12 / nFreq;
+    const bool bMonthEnd = isMonthEnd(rAnchor);
+    const sal_Int32 nDate = toDays(rDate);
+    const sal_Int32 nMonths
+        = (rAnchor.nYear - rDate.nYear) * 12 + rAnchor.nMonth - rDate.nMonth;
+    sal_Int32 nBack = std::max<sal_Int32>(nMonths / nStep, 0);
+    while (toDays(addMonths(rAnchor, -nBack * nStep, bMonthEnd)) > nDate)
+        ++nBack;
+    while (nBack > 0 && toDays(addMonths(rAnchor, -(nBack - 1) * nStep, bMonthEnd)) <= nDate)
+        --nBack;
+    rPrev = addMonths(rAnchor, -nBack * nStep, bMonthEnd);
+    rNext = addMonths(rAnchor, -(nBack - 1) * nStep, bMonthEnd);
+    return nBack;
+}
+
+void checkFreqAndBasis(sal_Int32 nFreq, sal_Int32 nBase)
+{
+    if ((nFreq != 1 && nFreq != 2 && nFreq != 4) || nBase < 0 || nBase > 4)
+        domainError();
+}
+
+/// Schedule quantities of the odd first period, which spans one (short) or several (long)
+/// quasi-coupon periods ending on the first coupon.
+struct OddFirstTerms
+{
+    double fAccruedFraction; ///< sum of A_i / NL_i over the quasi periods
+    double fCouponFraction; ///< sum of DC_i / NL_i over the quasi periods
+    double fFirstTime; ///< periods from the settlement to the first coupon: Nq + DSC / E
+    sal_Int32 nRegular; ///< regular coupons after the first coupon, up to the maturity
+};
+
+OddFirstTerms oddFirstTerms(sal_Int32 nNullDate, sal_Int32 nSettle, sal_Int32 nMat,
+                            sal_Int32 nIssue, sal_Int32 nFirstCoup, sal_Int32 nFreq,
+                            sal_Int32 nBase)
+{
+    checkFreqAndBasis(nFreq, nBase);
+    if (!(nMat > nFirstCoup && nFirstCoup > nSettle && nSettle > nIssue))
+        domainError();
+    const Ymd aSettle = toYmd(nNullDate, nSettle);
+    const Ymd aIssue = toYmd(nNullDate, nIssue);
+    const Ymd aFirst = toYmd(nNullDate, nFirstCoup);
+    const sal_Int32 nStep = 12 / nFreq;
+    const bool bMonthEnd = isMonthEnd(aFirst);
+
+    // quasi-coupon dates from the first coupon back to the first one not after the issue
+    std::vector<Ymd> aQuasi{ aFirst };
+    while (toDays(aQuasi.back()) > nNullDate + nIssue)
+        aQuasi.push_back(
+            addMonths(aFirst, -static_cast<sal_Int32>(aQuasi.size()) * nStep, bMonthEnd));
+    std::reverse(aQuasi.begin(), aQuasi.end());
+
+    OddFirstTerms aTerms{ 0.0, 0.0, 0.0, 0 };
+    const sal_Int32 nPeriods = static_cast<sal_Int32>(aQuasi.size()) - 1;
+    for (sal_Int32 i = 0; i < nPeriods; ++i)
+    {
+        const Ymd& rStart = aQuasi[i];
+        const Ymd& rEnd = aQuasi[i + 1];
+        const double fLength = periodLength(rStart, rEnd, nFreq, nBase);
+        const Ymd& rFrom = i == 0 ? aIssue : rStart;
+        aTerms.fCouponFraction += dayCount(rFrom, rEnd, nBase) / fLength;
+        if (nSettle > (i == 0 ? nIssue : toDays(rStart) - nNullDate))
+        {
+            const Ymd& rTo = toDays(rEnd) - nNullDate < nSettle ? rEnd : aSettle;
+            aTerms.fAccruedFraction += dayCount(rFrom, rTo, nBase) / fLength;
+        }
+        if (toDays(rStart) - nNullDate <= nSettle && nSettle < toDays(rEnd) - nNullDate)
+        {
+            const double fDsc = nBase == 0 ? fLength - dayCount(rStart, aSettle, nBase)
+                                           : dayCount(aSettle, rEnd, nBase);
+            aTerms.fFirstTime = (nPeriods - 1 - i) + fDsc / fLength;
+        }
+    }
+
+    Ymd aPrev, aNext;
+    aTerms.nRegular = findPeriod(toYmd(nNullDate, nMat), aFirst, nFreq, aPrev, aNext);
+    return aTerms;
+}
+
+double oddFirstPriceOf(const OddFirstTerms& rTerms, double fRate, double fYield, double fRedemp,
+                       sal_Int32 nFreq)
+{
+    const double fCoupon = 100.0 * fRate / nFreq;
+    const double fBase = 1.0 + fYield / nFreq;
+    const double t0 = rTerms.fFirstTime;
+    double fPrice = fRedemp / std::pow(fBase, rTerms.nRegular + t0)
+                    + fCoupon * rTerms.fCouponFraction / std::pow(fBase, t0);
+    for (sal_Int32 k = 1; k <= rTerms.nRegular; ++k)
+        fPrice += fCoupon / std::pow(fBase, k + t0);
+    return fPrice - fCoupon * rTerms.fAccruedFraction;
+}
+}
+
+double bondDuration(sal_Int32 nNullDate, sal_Int32 nSettle, sal_Int32 nMat, double fCoup,
+                    double fYield, sal_Int32 nFreq, sal_Int32 nBase)
+{
+    checkFreqAndBasis(nFreq, nBase);
+    if (fCoup < 0.0 || fYield < 0.0 || nSettle >= nMat)
+        domainError();
+    const Ymd aSettle = toYmd(nNullDate, nSettle);
+    Ymd aPrev, aNext;
+    const sal_Int32 nCoupons = findPeriod(toYmd(nNullDate, nMat), aSettle, nFreq, aPrev, aNext);
+    const double fLength = periodLength(aPrev, aNext, nFreq, nBase);
+    const double fDsc = nBase == 0 ? fLength - dayCount(aPrev, aSettle, nBase)
+                                   : dayCount(aSettle, aNext, nBase);
+    const double fCoupon = 100.0 * fCoup / nFreq;
+    const double fBase = 1.0 + fYield / nFreq;
+
+    // present-value weighted average time of the cash flows, in coupon periods
+    double fWeighted = 0.0, fPresent = 0.0;
+    for (sal_Int32 k = 1; k <= nCoupons; ++k)
+    {
+        const double t = k - 1 + fDsc / fLength;
+        const double fValue = (fCoupon + (k == nCoupons ? 100.0 : 0.0)) / std::pow(fBase, t);
+        fWeighted += t * fValue;
+        fPresent += fValue;
+    }
+    if (!(fPresent > 0.0))
+        domainError();
+    return fWeighted / fPresent / nFreq;
+}
+
+double bondModifiedDuration(sal_Int32 nNullDate, sal_Int32 nSettle, sal_Int32 nMat, double fCoup,
+                            double fYield, sal_Int32 nFreq, sal_Int32 nBase)
+{
+    return bondDuration(nNullDate, nSettle, nMat, fCoup, fYield, nFreq, nBase)
+           / (1.0 + fYield / nFreq);
+}
+
+double oddFirstPrice(sal_Int32 nNullDate, sal_Int32 nSettle, sal_Int32 nMat, sal_Int32 nIssue,
+                     sal_Int32 nFirstCoup, double fRate, double fYield, double fRedemp,
+                     sal_Int32 nFreq, sal_Int32 nBase)
+{
+    if (fRate < 0.0 || fYield < 0.0 || fRedemp <= 0.0)
+        domainError();
+    const OddFirstTerms aTerms
+        = oddFirstTerms(nNullDate, nSettle, nMat, nIssue, nFirstCoup, nFreq, nBase);
+    return oddFirstPriceOf(aTerms, fRate, fYield, fRedemp, nFreq);
+}
+
+double oddFirstYield(sal_Int32 nNullDate, sal_Int32 nSettle, sal_Int32 nMat, sal_Int32 nIssue,
+                     sal_Int32 nFirstCoup, double fRate, double fPrice, double fRedemp,
+                     sal_Int32 nFreq, sal_Int32 nBase)
+{
+    if (fRate < 0.0 || fPrice <= 0.0 || fRedemp <= 0.0)
+        domainError();
+    const OddFirstTerms aTerms
+        = oddFirstTerms(nNullDate, nSettle, nMat, nIssue, nFirstCoup, nFreq, nBase);
+    auto excess = [&](double fYield) {
+        return oddFirstPriceOf(aTerms, fRate, fYield, fRedemp, nFreq) - fPrice;
+    };
+
+    // the price falls as the yield grows: bracket the yield in [fLow, fHigh] with fLow >= 0,
+    // then refine by Newton steps, falling back to bisection when a step leaves the bracket
+    double fLow = 0.0, fHigh = 1.0;
+    if (excess(fLow) < 0.0)
+        domainError(); // only a negative yield gives this price
+    while (excess(fHigh) > 0.0)
+    {
+        fHigh *= 2.0;
+        if (fHigh > 1e6)
+            domainError();
+    }
+    double fYield = (fRate > fLow && fRate < fHigh) ? fRate : 0.5 * (fLow + fHigh);
+    for (int nIter = 0; nIter < 200; ++nIter)
+    {
+        const double fExcess = excess(fYield);
+        if (std::fabs(fExcess) < 1e-12)
+            break;
+        if (fExcess > 0.0)
+            fLow = fYield;
+        else
+            fHigh = fYield;
+        const double fStep = 1e-7;
+        const double fSlope = (excess(fYield + fStep) - excess(fYield - fStep)) / (2.0 * fStep);
+        double fNext = fSlope < 0.0 ? fYield - fExcess / fSlope : 0.5 * (fLow + fHigh);
+        if (!(fNext > fLow && fNext < fHigh))
+            fNext = 0.5 * (fLow + fHigh);
+        if (std::fabs(fNext - fYield) < 1e-15)
+        {
+            fYield = fNext;
+            break;
+        }
+        fYield = fNext;
+    }
+    return fYield;
+}
+}
