+CPPUNIT_TEST_FIXTURE(TestCondformat, testOptimalRowHeightsOnePassEqualsRowByRow)
+{
+    // The optimal row height pass keeps one text height per font and one height per row: one pass over
+    // many rows gives every row the height it gets when it is measured on its own. Fonts differ per
+    // cell, by script (Latin, CJK) and by a conditional style with a taller font.
+    m_pDoc->InsertTab(0, u"Test"_ustr);
+    CellAttributeHelper& rHelper = m_pDoc->getCellAttributeHelper();
+    ScStyleSheetPool* pStylePool = m_pDoc->GetStyleSheetPool();
+    ScStyleSheet& rTall = static_cast<ScStyleSheet&>(
+        pStylePool->Make(u"HstTallResult"_ustr, SfxStyleFamily::Para, SfxStyleSearchBits::UserDefined));
+    rTall.GetItemSet().Put(SvxFontHeightItem(720, 100, ATTR_FONT_HEIGHT));
+
+    constexpr SCROW nRows = 300;
+    const sal_uInt32 aSizes[] = { 180, 240, 400 };
+    for (SCROW nRow = 0; nRow < nRows; ++nRow)
+    {
+        for (SCCOL nCol = 0; nCol < 3; ++nCol)
+        {
+            ScPatternAttr aPattern(rHelper);
+            aPattern.ItemSetPut(SvxFontHeightItem(aSizes[(nRow * 7 + nCol) % 3], 100, ATTR_FONT_HEIGHT));
+            aPattern.ItemSetPut(SvxFontHeightItem(aSizes[(nRow + nCol) % 3], 100, ATTR_CJK_FONT_HEIGHT));
+            m_pDoc->ApplyPattern(nCol, nRow, 0, aPattern);
+        }
+        m_pDoc->SetValue(ScAddress(0, nRow, 0), nRow % 10);
+        m_pDoc->SetString(ScAddress(1, nRow, 0), nRow % 4 == 0 ? u"\u6F22\u5B57"_ustr : u"Ti\u1EBFng Vi\u1EC7t"_ustr);
+        if (nRow % 5)
+            m_pDoc->SetString(ScAddress(2, nRow, 0), nRow % 3 ? u"x"_ustr : u"'"_ustr);
+    }
+    auto pFormat = std::make_unique<ScConditionalFormat>(1, *m_pDoc);
+    pFormat->SetRange(ScRange(0, 0, 0, 0, nRows - 1, 0));
+    auto pFormatTmp = pFormat.get();
+    sal_uInt32 nKey = m_pDoc->AddCondFormat(std::move(pFormat), 0);
+    pFormatTmp->AddEntry(new ScCondFormatEntry(ScConditionMode::Greater, u"6"_ustr, u""_ustr, *m_pDoc,
+                                               ScAddress(0, 0, 0), u"HstTallResult"_ustr));
+    m_pDoc->AddCondFormatData(pFormatTmp->GetRange(), 0, nKey);
+
+    m_xDocShell->AdjustRowHeight(0, nRows - 1, 0);
+    std::vector<sal_uInt16> aOnePass;
+    for (SCROW nRow = 0; nRow < nRows; ++nRow)
+        aOnePass.push_back(m_pDoc->GetRowHeight(nRow, 0, false));
+    m_pDoc->SetRowHeightOnly(0, nRows - 1, 0, 100);
+    for (SCROW nRow = 0; nRow < nRows; ++nRow)
+        m_xDocShell->AdjustRowHeight(nRow, nRow, 0);
+    for (SCROW nRow = 0; nRow < nRows; ++nRow)
+        CPPUNIT_ASSERT_EQUAL_MESSAGE(OString::number(nRow).getStr(), aOnePass[nRow],
+                                     m_pDoc->GetRowHeight(nRow, 0, false));
+    // the rows really differ: the conditional style and the fonts change their heights
+    CPPUNIT_ASSERT(std::adjacent_find(aOnePass.begin(), aOnePass.end(), std::not_equal_to<>())
+                   != aOnePass.end());
+
+    m_pDoc->DeleteTab(0);
+}
