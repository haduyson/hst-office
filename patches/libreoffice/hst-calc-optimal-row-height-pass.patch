+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ * Copyright (c) HASON TECH. HST Office.
+ */
+
+// HST Office: the row heights collected by one optimal row height pass, one value per row.
+//
+// The pass sets the height of single rows in every column. When neighbouring rows need different
+// heights (cells with different font sizes), a run-length array has one entry per row, and each
+// change in the middle of it moved the whole rest of the array: on a sheet of 300 000 rows that was
+// about a tenth of the time spent opening the file. Here every row has its own slot, so setting a
+// row costs the same anywhere in the sheet.
+//
+// The interface is the one the pass uses. A "run" reported by the readers is a stretch of rows with
+// the same height that ends at or before the real end of that stretch: the callers step from run to
+// run, so a shorter run only means one more step, never a different result. Runs are looked for at
+// most RUN_SCAN rows ahead or behind, so stepping over a long stretch of equal heights stays linear.
+// Rows after the last one ever set keep the initial height and are not stored.
+
+#pragma once
+
+#include <sal/types.h>
+#include "types.hxx"
+
+#include <algorithm>
+#include <vector>
+
+namespace sc
+{
+class HstRowHeights
+{
+public:
+    struct RangeData
+    {
+        SCROW mnRow1, mnRow2;
+        sal_uInt16 maValue;
+    };
+
+    HstRowHeights(SCROW nMaxRow, sal_uInt16 nInitial)
+        : mnMaxRow(nMaxRow)
+        , mnInitial(nInitial)
+    {
+    }
+
+    sal_uInt16 GetValue(SCROW nRow) const
+    {
+        return nRow >= 0 && static_cast<size_t>(nRow) < maHeights.size() ? maHeights[nRow] : mnInitial;
+    }
+
+    /** The height of nRow, and the last row of a stretch from nRow on with that height. */
+    sal_uInt16 GetValue(SCROW nRow, size_t& rIndex, SCROW& rEnd) const
+    {
+        rIndex = static_cast<size_t>(std::max<SCROW>(nRow, 0));
+        const sal_uInt16 nValue = GetValue(nRow);
+        const SCROW nStored = static_cast<SCROW>(maHeights.size());
+        if (nRow >= nStored)
+        {
+            rEnd = mnMaxRow;
+            return nValue;
+        }
+        const SCROW nLimit = std::min<SCROW>(nStored, nRow + RUN_SCAN);
+        SCROW nEnd = nRow;
+        while (nEnd + 1 < nLimit && maHeights[nEnd + 1] == nValue)
+            ++nEnd;
+        if (nEnd + 1 == nStored && nValue == mnInitial)
+            nEnd = mnMaxRow; // the stored rows end in the initial height: so does the rest
+        rEnd = nEnd;
+        return nValue;
+    }
+
+    /** The height of nRow, with a stretch of rows around it that have the same height. */
+    RangeData GetRangeData(SCROW nRow) const
+    {
+        RangeData aData;
+        size_t nIndex;
+        aData.maValue = GetValue(nRow, nIndex, aData.mnRow2);
+        const SCROW nStored = static_cast<SCROW>(maHeights.size());
+        SCROW nStart = std::min(nRow, nStored);
+        if (nRow >= nStored)
+        {
+            // rows after the stored ones all have the initial height; so may the last stored rows
+            while (nStart > 0 && nRow - nStart < RUN_SCAN && maHeights[nStart - 1] == mnInitial)
+                --nStart;
+        }
+        else
+        {
+            const SCROW nLimit = std::max<SCROW>(0, nRow - RUN_SCAN);
+            while (nStart > nLimit && maHeights[nStart - 1] == aData.maValue)
+                --nStart;
+        }
+        aData.mnRow1 = nStart;
+        return aData;
+    }
+
+    void SetValue(SCROW nStart, SCROW nEnd, sal_uInt16 nValue)
+    {
+        if (nStart < 0 || nEnd > mnMaxRow || nStart > nEnd)
+            return;
+        const size_t nNeeded = static_cast<size_t>(nEnd) + 1;
+        if (maHeights.size() < nNeeded)
+        {
+            if (nValue == mnInitial && static_cast<size_t>(nStart) >= maHeights.size())
+                return; // already the height of every row that is not stored
+            maHeights.resize(nNeeded, mnInitial);
+        }
+        std::fill(maHeights.begin() + nStart, maHeights.begin() + nNeeded, nValue);
+    }
+
+private:
+    static constexpr SCROW RUN_SCAN = 4096;
+
+    SCROW mnMaxRow;
+    sal_uInt16 mnInitial;
+    std::vector<sal_uInt16> maHeights;
+};
+}
