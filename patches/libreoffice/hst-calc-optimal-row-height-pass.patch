+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ * Copyright (c) HASON TECH. HST Office.
+ */
+
+// HST Office: the text height of single-line cells, measured once per font in one optimal row height pass.
+//
+// A cell whose text is shown on one line (no wrap, no rotation, standard orientation, no edit text, one
+// script) is as high as the text height of its font plus its margins, whatever the text says. The font
+// follows from the cell's format, its conditional style, the sheet's table format and the script of the
+// text. Setting a font on the measuring device and asking for its text height made the device look the
+// font up again for every cell, because neighbouring cells rarely share their format: on a workbook with
+// thousands of formats that was over a third of the time spent opening it.
+//
+// The cache belongs to one pass (sc::RowHeightContext), so the device and zoom are those of the pass. It
+// keeps every format it has seen alive, so a format freed during the pass can never be mistaken for a new
+// one at the same address. Conditional styles and table formats live in the document for the whole pass.
+
+#pragma once
+
+#include "patattr.hxx"
+
+#include <svl/languageoptions.hxx>
+#include <svl/itemset.hxx>
+#include <tools/long.hxx>
+
+#include <functional>
+#include <unordered_map>
+
+namespace sc
+{
+class HstTextHeightCache
+{
+public:
+    /** The text height stored for this font source, or -1. */
+    tools::Long find(const ScPatternAttr* pPattern, const SfxItemSet* pCondSet,
+                     const SfxItemSet* pTableSet, SvtScriptType nScript) const
+    {
+        auto it = maHeights.find(Key{ pPattern, pCondSet, pTableSet, nScript });
+        return it == maHeights.end() ? -1 : it->second.mnHeight;
+    }
+
+    void insert(const ScPatternAttr* pPattern, const SfxItemSet* pCondSet,
+                const SfxItemSet* pTableSet, SvtScriptType nScript, tools::Long nHeight)
+    {
+        maHeights.try_emplace(Key{ pPattern, pCondSet, pTableSet, nScript },
+                              Entry{ CellAttributeHolder(pPattern), nHeight });
+    }
+
+private:
+    struct Key
+    {
+        const ScPatternAttr* mpPattern;
+        const SfxItemSet* mpCondSet;
+        const SfxItemSet* mpTableSet;
+        SvtScriptType mnScript;
+
+        bool operator==(const Key& r) const
+        {
+            return mpPattern == r.mpPattern && mpCondSet == r.mpCondSet
+                   && mpTableSet == r.mpTableSet && mnScript == r.mnScript;
+        }
+    };
+
+    struct KeyHash
+    {
+        size_t operator()(const Key& r) const
+        {
+            size_t nHash = std::hash<const void*>()(r.mpPattern);
+            nHash = nHash * 31 + std::hash<const void*>()(r.mpCondSet);
+            nHash = nHash * 31 + std::hash<const void*>()(r.mpTableSet);
+            return nHash * 31 + static_cast<size_t>(r.mnScript);
+        }
+    };
+
+    struct Entry
+    {
+        CellAttributeHolder maPattern; // keeps the format alive while it is a key
+        tools::Long mnHeight;
+    };
+
+    std::unordered_map<Key, Entry, KeyHash> maHeights;
+};
+}
