@@ -0,0 +1,190 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This file is part of the LibreOffice project.
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+// HST Office: recovery index, orphan scan and backup folder sweep (see hstrecoverystore.hxx).
+
+#include <hstrecoverystore.hxx>
+
+#include <comphelper/hstdurablefile.hxx>
+#include <o3tl/string_view.hxx>
+#include <osl/file.hxx>
+#include <osl/time.h>
+#include <rtl/byteseq.hxx>
+#include <rtl/character.hxx>
+#include <rtl/strbuf.hxx>
+#include <sal/log.hxx>
+
+#include <algorithm>
+#include <mutex>
+
+namespace framework::hstrecovery
+{
+namespace
+{
+constexpr OUString INDEX_NAME = u"hst-recovery-index.txt"_ustr;
+constexpr std::string_view INDEX_HEADER = "HST-RECOVERY-INDEX 1";
+constexpr sal_Int64 KEEP_SECONDS = 7 * 24 * 3600;
+
+OString field(const OUString& rText)
+{
+    return OUStringToOString(rText.replace('\t', ' ').replace('\n', ' ').replace('\r', ' '),
+                             RTL_TEXTENCODING_UTF8);
+}
+
+sal_Int64 now()
+{
+    TimeValue aNow;
+    osl_getSystemTime(&aNow);
+    return aNow.Seconds;
+}
+
+/// "<prefix>_<token>.<od?>": the names implts_generateNewTempURL gives recovery copies.
+bool splitCopyName(const OUString& rName, OUString& rPrefix, OUString& rExtension)
+{
+    const sal_Int32 nDot = rName.lastIndexOf('.');
+    const sal_Int32 nUnderscore = nDot > 0 ? rName.lastIndexOf('_', nDot) : -1;
+    if (nUnderscore <= 0 || nUnderscore + 1 >= nDot || rName.startsWith("."))
+        return false;
+    const OUString aExtension = rName.copy(nDot + 1).toAsciiLowerCase();
+    static constexpr std::u16string_view aKnown[] = { u"odt", u"ods", u"odp", u"odg", u"odf", u"odb" };
+    if (std::find(std::begin(aKnown), std::end(aKnown), aExtension) == std::end(aKnown))
+        return false;
+    for (sal_Int32 i = nUnderscore + 1; i < nDot; ++i)
+        if (!rtl::isAsciiAlphanumeric(rName[i]))
+            return false;
+    rPrefix = rName.copy(0, nUnderscore);
+    rExtension = aExtension;
+    return true;
+}
+}
+
+void forEachFile(const OUString& rDirURL,
+                 const std::function<void(const OUString&, const OUString&, sal_uInt64, sal_Int64)>& rFn)
+{
+    osl::Directory aDir(rDirURL);
+    if (aDir.open() != osl::FileBase::E_None)
+        return;
+    osl::DirectoryItem aItem;
+    while (aDir.getNextItem(aItem) == osl::FileBase::E_None)
+    {
+        osl::FileStatus aStatus(osl_FileStatus_Mask_Type | osl_FileStatus_Mask_FileName
+                                | osl_FileStatus_Mask_FileURL | osl_FileStatus_Mask_FileSize
+                                | osl_FileStatus_Mask_ModifyTime);
+        if (aItem.getFileStatus(aStatus) != osl::FileBase::E_None
+            || aStatus.getFileType() != osl::FileStatus::Regular)
+            continue;
+        rFn(aStatus.getFileURL(), aStatus.getFileName(), aStatus.getFileSize(),
+            aStatus.getModifyTime().Seconds);
+    }
+}
+
+void writeIndex(const OUString& rBackupDirURL, const std::vector<Entry>& rEntries)
+{
+    OStringBuffer aText(OString::Concat(INDEX_HEADER) + "\n");
+    for (const Entry& r : rEntries)
+        aText.append("entry\t" + OString::number(r.nID) + "\t" + OString::number(r.nState) + "\t"
+                     + field(r.aOrgURL) + "\t" + field(r.aTempURL) + "\t" + field(r.aTemplateURL)
+                     + "\t" + field(r.aFilter) + "\t" + field(r.aModule) + "\t" + field(r.aTitle)
+                     + "\t" + field(r.aViewNames) + "\n");
+    const OUString aURL = rBackupDirURL + "/" + INDEX_NAME;
+    // the list is mirrored after every configuration commit; most commits leave it unchanged
+    static std::mutex aMutex;
+    static OString aLastWritten;
+    std::scoped_lock aGuard(aMutex);
+    const OString aNew = aText.makeStringAndClear();
+    if (aNew == aLastWritten && (rEntries.empty() || modifiedTime(aURL) > 0))
+        return;
+    aLastWritten = aNew;
+    if (rEntries.empty()) // nothing to recover: no index (a missing index means the same)
+    {
+        if (osl::File::remove(aURL) == osl::FileBase::E_None)
+            comphelper::hst::syncParentDirectory(aURL);
+        return;
+    }
+    const osl::FileBase::RC eDir = osl::Directory::createPath(rBackupDirURL);
+    if ((eDir != osl::FileBase::E_None && eDir != osl::FileBase::E_EXIST)
+        || !comphelper::hst::writeFileAtomically(aURL, aNew))
+        aLastWritten.clear();
+}
+
+std::vector<Entry> readIndex(const OUString& rBackupDirURL)
+{
+    std::vector<Entry> aEntries;
+    osl::File aFile(rBackupDirURL + "/" + INDEX_NAME);
+    if (aFile.open(osl_File_OpenFlag_Read) != osl::FileBase::E_None)
+        return aEntries;
+    rtl::ByteSequence aLine;
+    bool bHeader = false;
+    sal_Bool bEOF = false;
+    while (aFile.isEndOfFile(&bEOF) == osl::FileBase::E_None && !bEOF
+           && aFile.readLine(aLine) == osl::FileBase::E_None)
+    {
+        const OUString aText(reinterpret_cast<const char*>(aLine.getConstArray()),
+                             aLine.getLength(), RTL_TEXTENCODING_UTF8);
+        if (!bHeader)
+        {
+            bHeader = aText == OUString::fromUtf8(INDEX_HEADER);
+            if (!bHeader)
+                break; // unknown format: ignore the file
+            continue;
+        }
+        sal_Int32 nIndex = 0;
+        if (o3tl::getToken(aText, 0, '\t', nIndex) != u"entry" || nIndex < 0)
+            continue;
+        Entry r;
+        r.nID = o3tl::toInt32(o3tl::getToken(aText, 0, '\t', nIndex));
+        r.nState = o3tl::toInt32(o3tl::getToken(aText, 0, '\t', nIndex));
+        OUString* aFields[] = { &r.aOrgURL, &r.aTempURL, &r.aTemplateURL, &r.aFilter,
+                                &r.aModule, &r.aTitle, &r.aViewNames };
+        for (OUString* pField : aFields)
+            *pField = nIndex >= 0 ? OUString(o3tl::getToken(aText, 0, '\t', nIndex)) : OUString();
+        if (r.nID > 0)
+            aEntries.push_back(r);
+    }
+    aFile.close();
+    return aEntries;
+}
+
+std::vector<Orphan> findOrphans(const OUString& rBackupDirURL, const std::set<OUString>& rReferenced)
+{
+    std::vector<Orphan> aOrphans;
+    const sal_Int64 nOldest = now() - KEEP_SECONDS;
+    forEachFile(rBackupDirURL, [&](const OUString& rURL, const OUString& rName, sal_uInt64 nSize,
+                                   sal_Int64 nModified) {
+        Orphan aOrphan;
+        if (nSize == 0 || nModified < nOldest || rReferenced.count(rURL)
+            || !splitCopyName(rName, aOrphan.aPrefix, aOrphan.aExtension))
+            return;
+        aOrphan.aURL = rURL;
+        aOrphan.nModified = nModified;
+        aOrphans.push_back(aOrphan);
+    });
+    std::sort(aOrphans.begin(), aOrphans.end(),
+              [](const Orphan& rA, const Orphan& rB) { return rA.nModified > rB.nModified; });
+    return aOrphans;
+}
+
+void sweepBackupDir(const OUString& rBackupDirURL, const std::set<OUString>& rReferenced)
+{
+    const sal_Int64 nOldest = now() - KEEP_SECONDS;
+    forEachFile(rBackupDirURL, [&](const OUString& rURL, const OUString& rName, sal_uInt64,
+                                   sal_Int64 nModified) {
+        if (nModified >= nOldest || rReferenced.count(rURL))
+            return;
+        OUString aPrefix, aExtension;
+        const bool bLeftover = (rName.startsWith("lu") && rName.endsWith(".tmp"))
+                               || (rName.startsWith(".~lock.") && rName.endsWith("#"))
+                               || splitCopyName(rName, aPrefix, aExtension);
+        if (bLeftover && osl::File::remove(rURL) == osl::FileBase::E_None)
+            SAL_INFO("fwk.autorecovery", "hst: removed old leftover " << rURL);
+    });
+}
+}
+
+/* vim:set shiftwidth=4 softtabstop=4 expandtab: */
--- /dev/null
+++ b/framework/source/services/hstunsavedstore.cxx
@@ -0,0 +1,157 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This file is part of the LibreOffice project.
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+// HST Office: "Tài liệu chưa lưu", the recovery copies of documents closed without saving
+// (see hstrecoverystore.hxx). Layout of user/hst-unsaved, read by the bundled extension
+// (hst_office/unsaved_store.py):
+//   <yyyymmdd-hhmmss>-<id>.<ext>       the document as of its last recovery copy (ODF)
+//   <yyyymmdd-hhmmss>-<id>.<ext>.txt   HST-UNSAVED 1, then "key<TAB>value" lines:
+//                                      title, url (original file, empty if never saved),
+//                                      module, saved (seconds of the copy), closed (seconds)
+
+#include <hstrecoverystore.hxx>
+
+#include <comphelper/hstdurablefile.hxx>
+#include <osl/file.hxx>
+#include <osl/time.h>
+#include <rtl/strbuf.hxx>
+#include <sal/log.hxx>
+#include <unotools/pathoptions.hxx>
+
+#include <algorithm>
+#include <map>
+
+namespace framework::hstrecovery
+{
+namespace
+{
+constexpr sal_Int64 KEEP_SECONDS = 7 * 24 * 3600;
+constexpr sal_uInt64 KEEP_BYTES = sal_uInt64(500) * 1024 * 1024;
+
+OString line(std::string_view aKey, const OUString& rValue)
+{
+    return OString::Concat(aKey) + "\t"
+           + OUStringToOString(rValue.replace('\t', ' ').replace('\n', ' ').replace('\r', ' '),
+                               RTL_TEXTENCODING_UTF8)
+           + "\n";
+}
+
+OUString stamp(sal_Int64 nSeconds)
+{
+    TimeValue aUTC{ static_cast<sal_uInt32>(nSeconds), 0 };
+    TimeValue aLocal;
+    oslDateTime aDT{};
+    if (osl_getLocalTimeFromSystemTime(&aUTC, &aLocal))
+        osl_getDateTimeFromTimeValue(&aLocal, &aDT);
+    return OUString::number(aDT.Year * 10000 + aDT.Month * 100 + aDT.Day) + "-"
+           + OUString(OUString::number(1000000 + aDT.Hours * 10000 + aDT.Minutes * 100 + aDT.Seconds)).copy(1);
+}
+
+/// One kept document: its copy and description file.
+struct Kept
+{
+    OUString aCopyURL;
+    OUString aInfoURL;
+    sal_uInt64 nSize = 0;
+    sal_Int64 nTime = 0; ///< when it was closed (description written), else the copy's time
+};
+}
+
+sal_Int64 modifiedTime(const OUString& rURL)
+{
+    osl::DirectoryItem aItem;
+    osl::FileStatus aStatus(osl_FileStatus_Mask_ModifyTime);
+    if (osl::DirectoryItem::get(rURL, aItem) != osl::FileBase::E_None
+        || aItem.getFileStatus(aStatus) != osl::FileBase::E_None)
+        return 0;
+    return aStatus.getModifyTime().Seconds;
+}
+
+OUString unsavedDir() { return SvtPathOptions().SubstituteVariable(u"$(user)/hst-unsaved"_ustr); }
+
+bool keepUnsaved(const OUString& rStoreDirURL, const Entry& rEntry)
+{
+    const sal_Int64 nCopyTime = modifiedTime(rEntry.aTempURL);
+    if (rEntry.aTempURL.isEmpty() || nCopyTime == 0)
+        return false;
+    const osl::FileBase::RC eDir = osl::Directory::createPath(rStoreDirURL);
+    if (eDir != osl::FileBase::E_None && eDir != osl::FileBase::E_EXIST)
+        return false;
+    TimeValue aNow;
+    osl_getSystemTime(&aNow);
+    const sal_Int32 nDot = rEntry.aTempURL.lastIndexOf('.');
+    const OUString aExtension = nDot > 0 ? rEntry.aTempURL.copy(nDot) : u".odt"_ustr;
+    const OUString aCopyURL = rStoreDirURL + "/" + stamp(aNow.Seconds) + "-"
+                              + OUString::number(rEntry.nID) + aExtension;
+    if (osl::File::move(rEntry.aTempURL, aCopyURL) != osl::FileBase::E_None
+        && (osl::File::copy(rEntry.aTempURL, aCopyURL) != osl::FileBase::E_None
+            || osl::File::remove(rEntry.aTempURL) != osl::FileBase::E_None))
+    {
+        SAL_WARN("fwk.autorecovery", "hst: cannot keep the unsaved document " << rEntry.aTempURL);
+        return false;
+    }
+    comphelper::hst::syncFile(aCopyURL);
+    const OString aInfo = "HST-UNSAVED 1\n" + line("title", rEntry.aTitle)
+                          + line("url", rEntry.aOrgURL) + line("module", rEntry.aModule)
+                          + line("saved", OUString::number(nCopyTime))
+                          + line("closed", OUString::number(sal_Int64(aNow.Seconds)));
+    comphelper::hst::writeFileAtomically(aCopyURL + ".txt", aInfo);
+    pruneUnsaved(rStoreDirURL);
+    return true;
+}
+
+void pruneUnsaved(const OUString& rStoreDirURL)
+{
+    std::map<OUString, Kept> aKept; // by copy URL
+    std::vector<OUString> aStrayInfos;
+    forEachFile(rStoreDirURL, [&](const OUString& rURL, const OUString& rName, sal_uInt64 nSize,
+                                  sal_Int64 nModified) {
+        if (rName.endsWith(".txt"))
+        {
+            Kept& r = aKept[rURL.copy(0, rURL.getLength() - 4)];
+            r.aInfoURL = rURL;
+            r.nTime = std::max(r.nTime, nModified);
+        }
+        else if (!rName.startsWith("."))
+        {
+            Kept& r = aKept[rURL];
+            r.aCopyURL = rURL;
+            r.nSize = nSize;
+            r.nTime = std::max(r.nTime, nModified);
+        }
+    });
+    TimeValue aNow;
+    osl_getSystemTime(&aNow);
+    std::vector<Kept> aList;
+    for (auto& [aURL, rKept] : aKept)
+    {
+        if (rKept.aCopyURL.isEmpty())
+            aStrayInfos.push_back(rKept.aInfoURL); // the copy is gone
+        else
+            aList.push_back(rKept);
+    }
+    std::sort(aList.begin(), aList.end(),
+              [](const Kept& rA, const Kept& rB) { return rA.nTime > rB.nTime; }); // newest first
+    sal_uInt64 nTotal = 0;
+    for (const Kept& r : aList)
+    {
+        nTotal += r.nSize;
+        if (r.nTime >= sal_Int64(aNow.Seconds) - KEEP_SECONDS && nTotal <= KEEP_BYTES)
+            continue;
+        osl::File::remove(r.aCopyURL);
+        if (!r.aInfoURL.isEmpty())
+            osl::File::remove(r.aInfoURL);
+        SAL_INFO("fwk.autorecovery", "hst: unsaved document expired " << r.aCopyURL);
+    }
+    for (const OUString& rURL : aStrayInfos)
+        osl::File::remove(rURL);
+}
+}
