@@ -0,0 +1,143 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This file is part of the LibreOffice project.
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+// HST Office: at start, bring back recovery entries the configuration lost (see hstrecoverystore.hxx).
+
+#include <hstrecoverystore.hxx>
+
+#include <classes/fwkresid.hxx>
+#include <strings.hrc>
+
+#include <comphelper/diagnose_ex.hxx>
+#include <osl/time.h>
+
+#include <algorithm>
+#include <map>
+
+using namespace css;
+
+namespace framework::hstrecovery
+{
+namespace
+{
+constexpr sal_Int32 STATE_MODIFIED_SUCCEEDED = 1 | 512; // DocState::Modified | Succeeded
+
+/// "untitled" or the original file name: the part of a recovery copy name before its last '_'.
+OUString prefixOf(const OUString& rTempURL)
+{
+    const OUString aName = rTempURL.copy(rTempURL.lastIndexOf('/') + 1);
+    const sal_Int32 nUnderscore = aName.lastIndexOf('_');
+    return nUnderscore > 0 ? aName.copy(0, nUnderscore) : OUString();
+}
+
+/// A new entry for an orphaned copy: module and filter from its ODF extension.
+Entry orphanEntry(const Orphan& rOrphan, sal_Int32 nID)
+{
+    static const std::map<OUString, std::pair<OUString, OUString>> aKinds{
+        { u"odt"_ustr, { u"com.sun.star.text.TextDocument"_ustr, u"writer8"_ustr } },
+        { u"ods"_ustr, { u"com.sun.star.sheet.SpreadsheetDocument"_ustr, u"calc8"_ustr } },
+        { u"odp"_ustr, { u"com.sun.star.presentation.PresentationDocument"_ustr, u"impress8"_ustr } },
+        { u"odg"_ustr, { u"com.sun.star.drawing.DrawingDocument"_ustr, u"draw8"_ustr } },
+        { u"odf"_ustr, { u"com.sun.star.formula.FormulaProperties"_ustr, u"math8"_ustr } },
+    };
+    Entry r;
+    r.nID = nID;
+    r.aTempURL = rOrphan.aURL;
+    r.nState = STATE_MODIFIED_SUCCEEDED;
+    if (auto it = aKinds.find(rOrphan.aExtension); it != aKinds.end())
+        std::tie(r.aModule, r.aFilter) = it->second;
+    TimeValue aUTC{ static_cast<sal_uInt32>(rOrphan.nModified), 0 }, aLocal;
+    oslDateTime aDT{};
+    if (osl_getLocalTimeFromSystemTime(&aUTC, &aLocal))
+        osl_getDateTimeFromTimeValue(&aLocal, &aDT);
+    auto two = [](sal_Int32 n) { return OUString(OUString::number(100 + n)).copy(1); };
+    const OUString aTime = two(aDT.Hours) + ":" + two(aDT.Minutes) + ", " + two(aDT.Day) + "/"
+                           + two(aDT.Month) + "/" + OUString::number(aDT.Year);
+    const OUString aName = rOrphan.aPrefix == "untitled" ? FwkResId(STR_HST_RECOVERY_UNTITLED)
+                                                         : rOrphan.aPrefix;
+    r.aTitle = FwkResId(STR_HST_RECOVERY_ORPHAN).replaceFirst("%1", aName).replaceFirst("%2", aTime);
+    return r;
+}
+}
+
+void mergeIntoConfiguration(const uno::Reference<uno::XComponentContext>& xContext)
+{
+    try
+    {
+        const OUString aDir = backupDir();
+        std::vector<Entry> aEntries = readConfiguration();
+        std::set<OUString> aReferenced;
+        sal_Int32 nMaxID = 0;
+        for (const Entry& r : aEntries)
+        {
+            aReferenced.insert(r.aTempURL);
+            nMaxID = std::max(nMaxID, r.nID);
+        }
+        std::vector<Entry> aChanged;
+        for (const Entry& r : readIndex(aDir))
+        {
+            const bool bKnown = std::any_of(aEntries.begin(), aEntries.end(), [&](const Entry& e) {
+                return e.nID == r.nID || (!r.aTempURL.isEmpty() && e.aTempURL == r.aTempURL);
+            });
+            const bool bUsable = r.aTempURL.isEmpty() ? !r.aOrgURL.isEmpty() : modifiedTime(r.aTempURL) > 0;
+            if (bKnown || !bUsable)
+                continue;
+            aEntries.push_back(r);
+            aChanged.push_back(r);
+            aReferenced.insert(r.aTempURL);
+            nMaxID = std::max(nMaxID, r.nID);
+        }
+        std::set<sal_Int32> aReplaced;
+        for (const Orphan& rOrphan : findOrphans(aDir, aReferenced))
+        {
+            std::vector<Entry*> aSame, aMissing;
+            for (Entry& r : aEntries)
+                if (!r.aTempURL.isEmpty() && prefixOf(r.aTempURL) == rOrphan.aPrefix && !aReplaced.count(r.nID))
+                {
+                    aSame.push_back(&r);
+                    if (modifiedTime(r.aTempURL) == 0)
+                        aMissing.push_back(&r);
+                }
+            Entry* pTarget = aMissing.size() == 1 ? aMissing[0] : nullptr;
+            if (!pTarget && aMissing.empty() && aSame.size() == 1
+                && modifiedTime(aSame[0]->aTempURL) < rOrphan.nModified)
+                pTarget = aSame[0]; // a newer copy than the one the entry still names
+            if (!pTarget && !aSame.empty() && aMissing.empty())
+                continue; // an older copy of a document whose entry has a newer one
+            if (pTarget)
+            {
+                pTarget->aTempURL = rOrphan.aURL;
+                aReplaced.insert(pTarget->nID);
+                aChanged.push_back(*pTarget);
+            }
+            else
+            {
+                aEntries.push_back(orphanEntry(rOrphan, ++nMaxID));
+                aChanged.push_back(aEntries.back());
+            }
+            aReferenced.insert(rOrphan.aURL);
+        }
+        if (!aChanged.empty())
+        {
+            setEntries(aChanged);
+            flushConfiguration(xContext);
+            SAL_WARN("fwk.autorecovery", "hst: recovered " << aChanged.size() << " recovery entries");
+        }
+        writeIndex(aDir, aEntries);
+        sweepBackupDir(aDir, aReferenced);
+        pruneUnsaved(unsavedDir());
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("fwk.autorecovery", "hst: merging the recovery index");
+    }
+}
+}
