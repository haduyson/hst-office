+
+void setEntry(const uno::Reference<container::XNameAccess>& xList, const Entry& r)
+{
+    const OUString aName = ITEM_PREFIX + OUString::number(r.nID);
+    uno::Reference<beans::XPropertySet> xSet;
+    const bool bNew = !xList->hasByName(aName);
+    if (bNew)
+        xSet.set(uno::Reference<lang::XSingleServiceFactory>(xList, uno::UNO_QUERY_THROW)
+                     ->createInstance(), uno::UNO_QUERY_THROW);
+    else
+        xList->getByName(aName) >>= xSet;
+    xSet->setPropertyValue(u"OriginalURL"_ustr, uno::Any(r.aOrgURL));
+    xSet->setPropertyValue(u"TempURL"_ustr, uno::Any(r.aTempURL));
+    xSet->setPropertyValue(u"TemplateURL"_ustr, uno::Any(r.aTemplateURL));
+    xSet->setPropertyValue(u"Filter"_ustr, uno::Any(r.aFilter));
+    xSet->setPropertyValue(u"DocumentState"_ustr, uno::Any(r.nState));
+    xSet->setPropertyValue(u"Module"_ustr, uno::Any(r.aModule));
+    xSet->setPropertyValue(u"Title"_ustr, uno::Any(r.aTitle));
+    std::vector<OUString> aViews;
+    for (sal_Int32 nIndex = 0; nIndex >= 0 && !r.aViewNames.isEmpty();)
+        aViews.emplace_back(o3tl::getToken(r.aViewNames, 0, '|', nIndex));
+    xSet->setPropertyValue(u"ViewNames"_ustr, uno::Any(comphelper::containerToSequence(aViews)));
+    if (bNew)
+        uno::Reference<container::XNameContainer>(xList, uno::UNO_QUERY_THROW)
+            ->insertByName(aName, uno::Any(xSet));
+}
+
+}
+
+OUString backupDir() { return SvtPathOptions().GetBackupPath(); }
+
+std::vector<Entry> readConfiguration()
+{
+    std::vector<Entry> aEntries;
+    uno::Reference<container::XNameAccess> xList(officecfg::Office::Recovery::RecoveryList::get());
+    for (const OUString& rName : xList->getElementNames())
+    {
+        uno::Reference<beans::XPropertySet> xItem;
+        xList->getByName(rName) >>= xItem;
+        std::u16string_view aID;
+        if (!xItem.is() || !rName.startsWith(ITEM_PREFIX, &aID))
+            continue;
+        Entry r;
+        r.nID = o3tl::toInt32(aID);
+        xItem->getPropertyValue(u"OriginalURL"_ustr) >>= r.aOrgURL;
+        xItem->getPropertyValue(u"TempURL"_ustr) >>= r.aTempURL;
+        xItem->getPropertyValue(u"TemplateURL"_ustr) >>= r.aTemplateURL;
+        xItem->getPropertyValue(u"Filter"_ustr) >>= r.aFilter;
+        xItem->getPropertyValue(u"DocumentState"_ustr) >>= r.nState;
+        xItem->getPropertyValue(u"Module"_ustr) >>= r.aModule;
+        xItem->getPropertyValue(u"Title"_ustr) >>= r.aTitle;
+        uno::Sequence<OUString> aViews;
+        xItem->getPropertyValue(u"ViewNames"_ustr) >>= aViews;
+        for (const OUString& rView : aViews)
+            r.aViewNames += (r.aViewNames.isEmpty() ? u""_ustr : u"|"_ustr) + rView;
+        aEntries.push_back(r);
+    }
+    return aEntries;
+}
+
+void setEntries(const std::vector<Entry>& rEntries)
+{
+    std::shared_ptr<comphelper::ConfigurationChanges> batch(comphelper::ConfigurationChanges::create());
+    uno::Reference<container::XNameAccess> xList(officecfg::Office::Recovery::RecoveryList::get(batch));
+    for (const Entry& r : rEntries)
+        setEntry(xList, r);
+    batch->commit();
+}
+
+void flushConfiguration(const uno::Reference<uno::XComponentContext>& xContext)
+{
+    try
+    {
+        uno::Reference<util::XFlushable>(configuration::theDefaultProvider::get(xContext),
+                                         uno::UNO_QUERY_THROW)->flush();
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("fwk.autorecovery", "hst: flushing the configuration");
+    }
+}
+
+void writeIndexFromConfiguration()
+{
+    try
+    {
+        writeIndex(backupDir(), readConfiguration());
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("fwk.autorecovery", "hst: writing the recovery index");
+    }
+}
+
+}
