+/** HST Office: recovery data that does not depend on registrymodifications.xcu.
+
+    backup/hst-recovery-index.txt mirrors the RecoveryList entries after every change, written
+    through a temporary file, fsync and rename, so a power cut that empties or rolls back the
+    configuration file still leaves the recovery list. At start the index entries missing from
+    the configuration and the recovery copies nobody refers to ("orphans") are offered again;
+    unreferenced leftovers older than 7 days are removed. The AutoRecovery service
+    (autorecovery.cxx) owns the entries; this module only reads and writes files.
+*/
+namespace com::sun::star::uno
+{
+class XComponentContext;
+}
+
+namespace framework::hstrecovery
+{
+/// One RecoveryList entry (same meaning as the configuration properties).
+struct Entry
+{
+    sal_Int32 nID = 0;
+    OUString aOrgURL;
+    OUString aTempURL;
+    OUString aTemplateURL;
+    OUString aFilter;
+    sal_Int32 nState = 0;
+    OUString aModule;
+    OUString aTitle;
+    OUString aViewNames; ///< view names joined by '|'
+};
+
+/// A recovery copy in the backup folder that no entry refers to.
+struct Orphan
+{
+    OUString aURL;
+    OUString aPrefix; ///< the part before the last '_': "untitled" or the original file name
+    OUString aExtension; ///< without the dot, e.g. "odt"
+    sal_Int64 nModified = 0; ///< seconds since the epoch
+};
+
+/// Replace the index with rEntries (temporary file, fsync, rename).
+void writeIndex(const OUString& rBackupDirURL, const std::vector<Entry>& rEntries);
+
+/// The entries of the index; empty when it is missing or unreadable.
+std::vector<Entry> readIndex(const OUString& rBackupDirURL);
+
+/// Non-empty recovery copies (<prefix>_<n>.od?) younger than 7 days that are not in rReferenced,
+/// newest first.
+std::vector<Orphan> findOrphans(const OUString& rBackupDirURL, const std::set<OUString>& rReferenced);
+
+/** Remove what a crash left behind and nobody refers to, once older than 7 days: recovery copies
+    (also empty placeholders), temporary files (lu*.tmp) and lock files (.~lock.*#). Files kept by
+    "Always create backup copy" (*.bak) and HST's own files are never touched. */
+void sweepBackupDir(const OUString& rBackupDirURL, const std::set<OUString>& rReferenced);
+
+/** "Tài liệu chưa lưu": the last recovery copy of a document closed without saving is moved to
+    rStoreDirURL (user/hst-unsaved) as <time>-<id>.<ext> with a description <time>-<id>.<ext>.txt
+    (title, original URL, module, time of the copy), then the store is pruned. The bundled extension
+    lists, opens and deletes them (unsaved_store.py). False when the copy could not be kept. */
+bool keepUnsaved(const OUString& rStoreDirURL, const Entry& rEntry);
+
+/// user/hst-unsaved (file URL).
+OUString unsavedDir();
+
+/// Remove kept documents older than 7 days, then the oldest ones until the store holds 500 MB.
+void pruneUnsaved(const OUString& rStoreDirURL);
+
+/// Calls rFn(URL, name, size, modified seconds) for every regular file of the folder.
+void forEachFile(const OUString& rDirURL,
+                 const std::function<void(const OUString&, const OUString&, sal_uInt64, sal_Int64)>& rFn);
+
+// Glue between the configuration RecoveryList and the files (hstrecoverylist.cxx).
+
+/// Write the in-memory configuration to disk now (registrymodifications.xcu, fsync'd) instead of
+/// the background write about a second later; called before a superseded recovery copy is deleted.
+void flushConfiguration(const css::uno::Reference<css::uno::XComponentContext>& xContext);
+
+/// The profile's backup folder (file URL).
+OUString backupDir();
+
+/// The RecoveryList entries as the configuration holds them now.
+std::vector<Entry> readConfiguration();
+
+/// Add or update these RecoveryList entries (one configuration commit).
+void setEntries(const std::vector<Entry>& rEntries);
+
+/// Mirror the current RecoveryList into the index file.
+void writeIndexFromConfiguration();
+
+/** At start, before the RecoveryList is read: add the index entries the configuration lost and the
+    orphaned recovery copies (a copy replaces the missing or older copy of the only entry with the
+    same name prefix, otherwise it becomes a new entry titled with its time), then sweep the backup
+    folder and prune the unsaved-documents store. */
+void mergeIntoConfiguration(const css::uno::Reference<css::uno::XComponentContext>& xContext);
+
+/// Seconds since the epoch of the last change of a file; 0 when unknown.
+sal_Int64 modifiedTime(const OUString& rURL);
+}
