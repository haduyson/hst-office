+
+void PdfViewerWindow::applyBackground()
+{
+    SetBackground(Wallpaper(GetSettings().GetStyleSettings().GetWorkspaceColor()));
+}
+
+void PdfViewerWindow::DataChanged(const DataChangedEvent& rDCEvt)
+{
+    InterimItemWindow::DataChanged(rDCEvt);
+    if (rDCEvt.GetType() == DataChangedEventType::SETTINGS
+        && (rDCEvt.GetFlags() & AllSettingsFlags::STYLE))
+    {
+        applyBackground();
+        Invalidate();
+    }
 }
 
