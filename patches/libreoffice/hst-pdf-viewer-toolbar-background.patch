+    // transparent, and with the Windows dark appearance nothing repainted the area under the
+    // toolbar, so labels and boxes kept stale copies of themselves after a relayout. The colour
+    // is the one the frame showed through before (the dialog colour on Windows).
+    SetPaintTransparent(false);
+    applyBackground();
