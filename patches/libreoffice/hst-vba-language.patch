+// HST: VBA conditional compilation. Both branches used to compile, so #If VBA7 and #If Win64 with a
+// Declare in each stopped the module with "already defined". Code sees 64-bit Office for Windows.
+
+#include <conditional.hxx>
+#include <rtl/character.hxx>
+#include <rtl/math.hxx>
+#include <string_view>
+
+namespace
+{
+/// Recursive descent over: Or Xor, And, Not, comparisons, parentheses, numbers, True False, names.
+class Evaluator
+{
+    std::u16string_view m;
+    size_t mn = 0;
+    const std::map<OUString, double>& mrConstants;
+
+    void skipSpace()
+    {
+        while (mn < m.size() && (m[mn] == ' ' || m[mn] == '\t'))
+            ++mn;
+    }
+
+    bool word(std::u16string_view rWord)
+    {
+        skipSpace();
+        if (m.size() - mn < rWord.size())
+            return false;
+        for (size_t i = 0; i < rWord.size(); ++i)
+            if (rtl::toAsciiLowerCase(m[mn + i]) != rWord[i])
+                return false;
+        size_t nEnd = mn + rWord.size();
+        if (rtl::isAsciiAlpha(rWord[0]) && nEnd < m.size() && (rtl::isAsciiAlphanumeric(m[nEnd]) || m[nEnd] == '_'))
+            return false;
+        mn = nEnd;
+        return true;
+    }
+
+    double atom()
+    {
+        if (word(u"("))
+        {
+            double f = orExpr();
+            word(u")");
+            return f;
+        }
+        skipSpace();
+        size_t nStart = mn;
+        if (mn < m.size() && rtl::isAsciiDigit(m[mn]))
+        {
+            while (mn < m.size() && (rtl::isAsciiDigit(m[mn]) || m[mn] == '.'))
+                ++mn;
+            return rtl::math::stringToDouble(OUString(m.substr(nStart, mn - nStart)), '.', ',');
+        }
+        while (mn < m.size() && (rtl::isAsciiAlphanumeric(m[mn]) || m[mn] == '_'))
+            ++mn;
+        OUString aName = OUString(m.substr(nStart, mn - nStart)).toAsciiLowerCase();
+        if (aName == "true")
+            return -1;
+        auto it = mrConstants.find(aName);
+        return it == mrConstants.end() ? 0 : it->second; // an undeclared name is False, like Empty
+    }
+
+    double unary()
+    {
+        if (word(u"not"))
+            return ~static_cast<int>(unary());
+        if (word(u"-"))
+            return -unary();
+        return atom();
+    }
+
+    double comparison()
+    {
+        double f = unary();
+        if (word(u"<>"))
+            return f != unary() ? -1 : 0;
+        if (word(u"<="))
+            return f <= unary() ? -1 : 0;
+        if (word(u">="))
+            return f >= unary() ? -1 : 0;
+        if (word(u"="))
+            return f == unary() ? -1 : 0;
+        if (word(u"<"))
+            return f < unary() ? -1 : 0;
+        if (word(u">"))
+            return f > unary() ? -1 : 0;
+        return f;
+    }
+
+    double andExpr()
+    {
+        double f = comparison();
+        while (word(u"and"))
+            f = static_cast<int>(f) & static_cast<int>(comparison());
+        return f;
+    }
+
+public:
+    Evaluator(std::u16string_view rExpr, const std::map<OUString, double>& rConstants)
+        : m(rExpr)
+        , mrConstants(rConstants)
+    {
+    }
+
+    double orExpr()
+    {
+        double f = andExpr();
+        while (true)
+        {
+            if (word(u"or"))
+                f = static_cast<int>(f) | static_cast<int>(andExpr());
+            else if (word(u"xor"))
+                f = static_cast<int>(f) ^ static_cast<int>(andExpr());
+            else
+                return f;
+        }
+    }
+};
+}
+
+SbiConditional::SbiConditional()
+{
+    for (const OUString& rName : { u"vba6"_ustr, u"vba7"_ustr, u"win32"_ustr, u"win64"_ustr })
+        maConstants[rName] = -1;
+}
+
+double SbiConditional::evaluate(std::u16string_view rExpr) const { return Evaluator(rExpr, maConstants).orExpr(); }
+
+bool SbiConditional::skipLine(const OUString& rLine)
+{
+    const bool bActive = maBlocks.empty() || (maBlocks.back().bActive && maBlocks.back().bParent);
+    OUString aLine = rLine.trim();
+    if (!aLine.startsWith("#"))
+        return !bActive;
+    // up to a comment, and without the Then
+    sal_Int32 nQuote = aLine.indexOf('\'');
+    if (nQuote >= 0)
+        aLine = aLine.copy(0, nQuote).trim();
+    OUString aLower = aLine.copy(1).trim().toAsciiLowerCase();
+    if (aLower.endsWith(" then"))
+        aLower = aLower.copy(0, aLower.getLength() - 5);
+    if (aLower.startsWith("if ") || aLower.startsWith("if("))
+    {
+        const bool bValue = bActive && evaluate(aLower.subView(2)) != 0;
+        maBlocks.push_back({ bValue, bValue, bActive });
+    }
+    else if ((aLower.startsWith("elseif ") || aLower.startsWith("elseif(")) && !maBlocks.empty())
+    {
+        Block& rBlock = maBlocks.back();
+        rBlock.bActive = !rBlock.bTaken && rBlock.bParent && evaluate(aLower.subView(6)) != 0;
+        rBlock.bTaken = rBlock.bTaken || rBlock.bActive;
+    }
+    else if (aLower == "else" && !maBlocks.empty())
+    {
+        Block& rBlock = maBlocks.back();
+        rBlock.bActive = !rBlock.bTaken;
+        rBlock.bTaken = true;
+    }
+    else if ((aLower.startsWith("end if") || aLower == "endif") && !maBlocks.empty())
+        maBlocks.pop_back();
+    else if (aLower.startsWith("const ") && bActive)
+    {
+        sal_Int32 nEq = aLower.indexOf('=');
+        if (nEq > 0)
+            maConstants[aLower.copy(6, nEq - 6).trim()] = evaluate(aLower.subView(nEq + 1));
+    }
+    return true;
+}
