+bool BasicRegExpMatch::call(const OUString& rName, SbxVariable& rVar, SbxArray* pArgs, sal_uInt32 nArgs, bool)
+{
+    if (rName == "value")
+        rVar.PutString(maValue);
+    else if (rName == "firstindex")
+        rVar.PutLong(mnFirstIndex);
+    else if (rName == "length")
+        rVar.PutLong(mnLength);
+    else if (rName == "submatches" && nArgs > 1)
+        rVar.PutString(mxSubMatches->GetItemForKey(*pArgs->Get(1))->GetOUString());
+    else if (rName == "submatches")
+    {
+        SbxFlagBits nFlags = rVar.GetFlags();
+        rVar.ResetFlag(SbxFlagBits::Fixed);
+        rVar.PutObject(mxSubMatches.get());
+        rVar.SetFlags(nFlags);
+    }
+    else
+        return false;
+    return true;
