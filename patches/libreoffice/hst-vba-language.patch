+// HST: VBA conditional compilation (#If, #ElseIf, #Else, #End If, #Const).
+
+#pragma once
+
+#include <rtl/ustring.hxx>
+#include <map>
+#include <vector>
+
+class SbiConditional
+{
+    struct Block
+    {
+        bool bActive; // this branch compiles
+        bool bTaken; // a branch of this #If has compiled
+        bool bParent; // the enclosing code compiles
+    };
+    std::vector<Block> maBlocks;
+    std::map<OUString, double> maConstants;
+
+    double evaluate(std::u16string_view rExpr) const;
+
+public:
+    SbiConditional();
+    /** Whether the line is a directive or lies in a branch that does not compile. Either way the
+        scanner sees an empty line, so line numbers stay those of the source. */
+    bool skipLine(const OUString& rLine);
+};
