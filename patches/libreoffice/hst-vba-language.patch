+OUString settingsFile()
+{
+    OUString aUrl = OUString::createFromAscii("${$BRAND_BASE_DIR/" LIBO_ETC_FOLDER "/" SAL_CONFIGFILE("bootstrap") "::UserInstallation}/user/vba-settings.ini");
+    rtl::Bootstrap::expandMacros(aUrl);
+    OUString aPath;
+    osl::FileBase::getSystemPathFromFileURL(aUrl, aPath);
+    return aPath;
+}
+
+OString groupOf(SbxArray& rPar)
+{
+    return OUStringToOString(OUString(rPar.Get(1)->GetOUString() + "\\" + rPar.Get(2)->GetOUString()), RTL_TEXTENCODING_UTF8);
+}
+
+OString keyOf(SbxArray& rPar) { return OUStringToOString(rPar.Get(3)->GetOUString(), RTL_TEXTENCODING_UTF8); }
+}
+
+void SbRtl_SaveSetting(StarBASIC*, SbxArray& rPar, bool)
+{
+    if (rPar.Count() != 5)
+        return StarBASIC::Error(ERRCODE_BASIC_BAD_ARGUMENT);
+    Config aConfig(settingsFile());
+    aConfig.SetGroup(groupOf(rPar));
+    aConfig.WriteKey(keyOf(rPar), OUStringToOString(rPar.Get(4)->GetOUString(), RTL_TEXTENCODING_UTF8));
+}
+
+void SbRtl_GetSetting(StarBASIC*, SbxArray& rPar, bool)
+{
+    if (rPar.Count() < 4)
+        return StarBASIC::Error(ERRCODE_BASIC_BAD_ARGUMENT);
+    Config aConfig(settingsFile());
+    aConfig.SetGroup(groupOf(rPar));
+    const OUString aDefault = rPar.Count() > 4 ? rPar.Get(4)->GetOUString() : OUString();
+    rPar.Get(0)->PutString(OStringToOUString(aConfig.ReadKey(keyOf(rPar), OUStringToOString(aDefault, RTL_TEXTENCODING_UTF8)), RTL_TEXTENCODING_UTF8));
+}
+
+void SbRtl_DeleteSetting(StarBASIC*, SbxArray& rPar, bool)
+{
+    if (rPar.Count() < 3)
+        return StarBASIC::Error(ERRCODE_BASIC_BAD_ARGUMENT);
+    Config aConfig(settingsFile());
+    if (rPar.Count() > 3)
+    {
+        aConfig.SetGroup(groupOf(rPar));
+        aConfig.DeleteKey(keyOf(rPar));
+    }
+    else
+        aConfig.DeleteGroup(groupOf(rPar));
+}
+
+void SbRtl_Filter(StarBASIC*, SbxArray& rPar, bool)
+{
+    const sal_uInt32 nCount = rPar.Count();
+    if (nCount < 3)
+        return StarBASIC::Error(ERRCODE_BASIC_BAD_ARGUMENT);
+    SbxDimArray* pSource = dynamic_cast<SbxDimArray*>(rPar.Get(1)->GetObject());
+    if (!pSource || pSource->GetDims() != 1)
+        return StarBASIC::Error(ERRCODE_BASIC_BAD_ARGUMENT);
+    const bool bInclude = nCount < 4 || rPar.Get(3)->GetBool();
+    const bool bText = nCount > 4 && rPar.Get(4)->GetInteger() == 1;
+    const auto fold = [bText](const OUString& r) { return bText ? SbxVariable::NameToCaseInsensitiveName(r) : r; };
+    const OUString aMatch = fold(rPar.Get(2)->GetOUString());
+    sal_Int32 nLower = 0, nUpper = -1;
+    pSource->GetDim(1, nLower, nUpper);
+    std::vector<OUString> aOut;
+    for (sal_Int32 i = nLower; i <= nUpper; ++i)
+    {
+        const OUString aItem = pSource->Get(&i)->GetOUString();
+        if ((fold(aItem).indexOf(aMatch) >= 0) == bInclude)
+            aOut.push_back(aItem);
+    }
+    SbxDimArray* pResult = new SbxDimArray(SbxVARIANT);
+    pResult->unoAddDim(0, static_cast<sal_Int32>(aOut.size()) - 1);
+    for (sal_Int32 i = 0; i < static_cast<sal_Int32>(aOut.size()); ++i)
+    {
+        SbxVariableRef xItem = new SbxVariable(SbxVARIANT);
+        xItem->PutString(aOut[i]);
+        pResult->Put(xItem.get(), &i);
+    }
+    SbxVariableRef xResult = rPar.Get(0);
+    SbxFlagBits nFlags = xResult->GetFlags();
+    xResult->ResetFlag(SbxFlagBits::Fixed);
+    xResult->PutObject(pResult);
+    xResult->SetFlags(nFlags);
+}
