+// HST: Debug.Print [expr {; | , expr}], Debug.Assert expr. The expressions run; the Immediate window
+// of the VBA editor does not exist here, so the text goes nowhere.
+
+void SbiParser::DebugStatement()
+{
+    Next(); // Debug
+    aGen.Statement();
+    Next(); // .
+    Next(); // Print, Assert
+    while( !bAbort && !IsEoln( Peek() ) && Peek() != ELSE )
+    {
+        SbiExpression aExpr( this );
+        aExpr.Gen();
+        aGen.Gen( SbiOpcode::GET_ );
+        if( Peek() == COMMA || Peek() == SEMICOLON )
+            Next();
+        else
+            break;
+    }
+}
