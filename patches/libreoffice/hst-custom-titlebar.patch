+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This file is part of the LibreOffice project.
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+// HST Office: painting of the caption area of the own title bar (vcl/source/window/HstTitleBar.cxx):
+// the window title and the minimize, maximize/restore and close buttons in the style of the system, with
+// hover and pressed states, dimmed in an inactive window, system colours in high contrast.
+
+#include <sal/config.h>
+
+#include <brdwin.hxx>
+#include <HstTitleBarGeometry.hxx>
+#include <HstTitleBarWindow.hxx>
+
+#include <vcl/notebookbar/notebookbar.hxx>
+#include <vcl/settings.hxx>
+#include <vcl/wrkwin.hxx>
+#include <com/sun/star/accessibility/AccessibleRole.hpp>
+
+using namespace hst::titlebar;
+
+namespace
+{
+/// rBase with fAmount of rOver laid over it.
+Color Mix(Color aBase, const Color& rOver, double fAmount)
+{
+    aBase.Merge(rOver, static_cast<sal_uInt8>(std::lround(255 * (1.0 - fAmount))));
+    return aBase;
+}
+
+/// The system's caption glyph font: Segoe Fluent Icons (Windows 11), Segoe MDL2 Assets (Windows 10).
+OUString GlyphFont(const OutputDevice& rDev)
+{
+    static const OUString aFont = [&rDev] {
+        for (const OUString& rName : { u"Segoe Fluent Icons"_ustr, u"Segoe MDL2 Assets"_ustr })
+            if (rDev.IsFontAvailable(rName))
+                return rName;
+        return OUString();
+    }();
+    return aFont;
+}
+
+/// Lines of a caption glyph when no glyph font exists: 10 logical px, centred in rRect.
+void DrawVectorGlyph(vcl::RenderContext& rDev, const tools::Rectangle& rRect, int nButton, bool bRestore, double f)
+{
+    const tools::Long n = scaled(10, f);
+    const Point aC = rRect.Center();
+    const tools::Rectangle aBox(Point(aC.X() - n / 2, aC.Y() - n / 2), Size(n, n));
+    rDev.SetFillColor();
+    if (nButton == MinButton)
+        rDev.DrawLine(Point(aBox.Left(), aC.Y()), Point(aBox.Right(), aC.Y()));
+    else if (nButton == CloseButton)
+    {
+        rDev.DrawLine(aBox.TopLeft(), aBox.BottomRight());
+        rDev.DrawLine(aBox.TopRight(), aBox.BottomLeft());
+    }
+    else if (!bRestore)
+        rDev.DrawRect(aBox);
+    else
+    {
+        const tools::Long d = scaled(2, f);
+        rDev.DrawRect(tools::Rectangle(Point(aBox.Left(), aBox.Top() + d), Point(aBox.Right() - d, aBox.Bottom())));
+        rDev.DrawLine(Point(aBox.Left() + d, aBox.Top()), aBox.TopRight());
+        rDev.DrawLine(aBox.TopRight(), Point(aBox.Right(), aBox.Bottom() - d));
+    }
+}
+}
+
+HstTitleBar::HstTitleBar(vcl::Window* pParent)
+    : vcl::Window(pParent, WB_NOTABSTOP)
+{
+    SetAccessibleRole(css::accessibility::AccessibleRole::LABEL); // reads the window title
+    SetText(pParent->GetText());
+}
+
+void HstTitleBar::SetButtons(int nHot, int nPressed)
+{
+    if (mnHot == nHot && mnPressed == nPressed)
+        return;
+    mnHot = nHot;
+    mnPressed = nPressed;
+    Invalidate();
+}
+
+tools::Long HstTitleBar::TitleTextWidth()
+{
+    OutputDevice& rDev = *GetOutDev();
+    rDev.Push(vcl::PushFlags::FONT);
+    SetPointFont(rDev, GetSettings().GetStyleSettings().GetTitleFont());
+    const tools::Long nWidth = rDev.GetTextWidth(GetText());
+    rDev.Pop();
+    return nWidth;
+}
+
+int HstTitleBar::HitTest(const Point& rPos) const
+{
+    if (rPos.Y() < 0 || rPos.Y() >= GetOutputSizePixel().Height())
+        return Client;
+    return captionAreaHit(rPos.X(), GetOutputSizePixel().Width(), GetDPIScaleFactor());
+}
+
+void HstTitleBar::DrawButton(vcl::RenderContext& rDev, const tools::Rectangle& rRect, int nButton,
+                             const Color& rBack, bool bActive)
+{
+    const StyleSettings& rStyle = rDev.GetSettings().GetStyleSettings();
+    const bool bHighContrast = rStyle.GetHighContrastMode();
+    const bool bHot = mnHot == nButton;
+    const bool bPressed = bHot && mnPressed == nButton;
+    Color aGlyph = rStyle.GetDialogTextColor();
+    if (bHot)
+    {
+        const Color aClose(0xC4, 0x2B, 0x1C); // the system's close button red
+        const Color aOver = rBack.IsDark() ? COL_WHITE : COL_BLACK;
+        Color aFill = bPressed ? Mix(rBack, aOver, 0.06) : Mix(rBack, aOver, 0.09);
+        if (bHighContrast)
+            aFill = rStyle.GetHighlightColor();
+        else if (nButton == CloseButton)
+            aFill = bPressed ? Mix(rBack, aClose, 0.9) : aClose;
+        rDev.SetLineColor();
+        rDev.SetFillColor(aFill);
+        rDev.DrawRect(rRect);
+        aGlyph = bHighContrast ? rStyle.GetHighlightTextColor() : nButton == CloseButton ? COL_WHITE : aGlyph;
+    }
+    else if (!bActive)
+        aGlyph = Mix(aGlyph, rBack, 0.45);
+
+    const double f = GetDPIScaleFactor();
+    const bool bRestore = static_cast<const WorkWindow*>(GetParent()->ImplGetClientWindow())->IsMaximized();
+    const OUString aFontName = GlyphFont(rDev);
+    if (aFontName.isEmpty())
+    {
+        rDev.SetLineColor(aGlyph);
+        DrawVectorGlyph(rDev, rRect, nButton, bRestore, f);
+        return;
+    }
+    // ChromeMinimize, ChromeMaximize, ChromeRestore, ChromeClose
+    const sal_Unicode cGlyph = nButton == MinButton ? 0xE921 : nButton == CloseButton ? 0xE8BB : bRestore ? 0xE923 : 0xE922;
+    vcl::Font aFont(aFontName, Size(0, scaled(10, f)));
+    aFont.SetColor(aGlyph);
+    aFont.SetTransparent(true);
+    rDev.SetFont(aFont);
+    rDev.SetTextColor(aGlyph);
+    rDev.DrawText(rRect, OUString(cGlyph), DrawTextFlags::Center | DrawTextFlags::VCenter);
+}
+
+void HstTitleBar::Paint(vcl::RenderContext& rDev, const tools::Rectangle&)
+{
+    const StyleSettings& rStyle = rDev.GetSettings().GetStyleSettings();
+    auto* pBorder = static_cast<ImplBorderWindow*>(GetParent());
+    const VclPtr<NotebookBar>& rBar = pBorder->GetNotebookBar();
+    const Wallpaper aBack = rBar && rBar->IsBackground() ? rBar->GetBackground() : Wallpaper(rStyle.GetFaceColor());
+    const Color aBackColor = aBack.IsBitmap() || aBack.IsGradient() ? rStyle.GetFaceColor() : aBack.GetColor();
+    const Size aSize = GetOutputSizePixel();
+    rDev.DrawWallpaper(tools::Rectangle(Point(), aSize), aBack);
+
+    const bool bActive = pBorder->HstIsDisplayActive();
+    const double f = GetDPIScaleFactor();
+    const tools::Long nButton = scaled(BUTTON_WIDTH, f);
+    if (mnTitleWidth > 0)
+    {
+        const tools::Long nPad = scaled(TITLE_PAD, f);
+        Color aText = rStyle.GetDialogTextColor();
+        if (!bActive)
+            aText = Mix(aText, aBackColor, 0.45);
+        rDev.Push(vcl::PushFlags::FONT | vcl::PushFlags::TEXTCOLOR);
+        SetPointFont(rDev, rStyle.GetTitleFont());
+        rDev.SetTextColor(aText);
+        // the title stands in the tab row's line, with the tabs and the search box
+        const tools::Rectangle aTitle(Point(nPad, mnBand), Size(mnTitleWidth - 2 * nPad, aSize.Height() - mnBand));
+        rDev.DrawText(aTitle, GetText(),
+                      DrawTextFlags::Center | DrawTextFlags::VCenter
+                          | DrawTextFlags::EndEllipsis);
+        rDev.Pop();
+    }
+    rDev.Push(vcl::PushFlags::FONT | vcl::PushFlags::TEXTCOLOR | vcl::PushFlags::LINECOLOR
+              | vcl::PushFlags::FILLCOLOR);
+    const int aButtons[] = { MinButton, MaxButton, CloseButton };
+    for (int i = 0; i < 3; ++i)
+    {
+        const tools::Rectangle aRect(Point(aSize.Width() - (3 - i) * nButton, 0), Size(nButton, aSize.Height()));
+        DrawButton(rDev, aRect, aButtons[i], aBackColor, bActive);
+    }
+    rDev.Pop();
+}
