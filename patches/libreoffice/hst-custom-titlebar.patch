+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This file is part of the LibreOffice project.
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+#pragma once
+
+// HST Office: the caption area of the own title bar (vcl/source/window/HstTitleBar.cxx): the window
+// title and the minimize, maximize/restore and close buttons at the right end of the merged top row.
+// The border window places it over the right end of the ribbon tab row, which keeps that room free
+// (hst::titlebar::RowReserve). It receives no mouse input: the frame answers the system hit test and
+// reports hover and press (SalFrame::m_aHstTitleBarButtons).
+
+#include <vcl/window.hxx>
+
+class HstTitleBar final : public vcl::Window
+{
+public:
+    explicit HstTitleBar(vcl::Window* pParent);
+
+    /// The button under the pointer and the pressed one (hst::titlebar::Hit), repainting on a change.
+    void SetButtons(int nHot, int nPressed);
+    /// Width of the title slot left of the buttons; 0 hides the title.
+    void SetTitleWidth(tools::Long nWidth) { mnTitleWidth = nWidth; }
+    tools::Long TitleWidth() const { return mnTitleWidth; }
+    /// Width of the window title in the title font.
+    tools::Long TitleTextWidth();
+    /// Height of the drag band above the tab row; the title is centred in the row below it.
+    void SetBand(tools::Long nBand) { mnBand = nBand; }
+    /// The part at a point of this window (hst::titlebar::Hit).
+    int HitTest(const Point& rPos) const;
+
+    virtual void Paint(vcl::RenderContext& rDev, const tools::Rectangle& rRect) override;
+
+private:
+    void DrawButton(vcl::RenderContext& rDev, const tools::Rectangle& rRect, int nButton, const Color& rBack,
+                    bool bActive);
+
+    int mnHot = 0;
+    int mnPressed = 0;
+    tools::Long mnTitleWidth = 0;
+    tools::Long mnBand = 0;
+};
+
+namespace hst::titlebar
+{
+/** The room the ribbon tab row rTabControl keeps free at its right end for the caption area, 0 without
+    the own title bar. nFree: room left in the row after the tabs and before the menu button. */
+tools::Long RowReserve(const vcl::Window& rTabControl, tools::Long nFree);
+}
