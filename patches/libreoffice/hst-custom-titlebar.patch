+++ b/vcl/inc/HstTitleBarGeometry.hxx
@@ -0,0 +1,84 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This file is part of the LibreOffice project.
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+#pragma once
+
+// HST Office: geometry of the own title bar (vcl/source/window/HstTitleBar.cxx), in pixels for a DPI
+// scale factor. No VCL types, so that tests/unit/test_custom_titlebar.py compiles it on its own.
+
+#include <algorithm>
+#include <cmath>
+
+namespace hst::titlebar
+{
+/// What the title bar has at a point; the frame turns it into the system hit-test code.
+enum Hit : int
+{
+    Client = 0, ///< a control of the window: tabs, quick access buttons, search
+    Caption = 1, ///< the title or an empty part of the row: drag, double-click, system menu
+    MinButton = 2,
+    MaxButton = 3,
+    CloseButton = 4
+};
+
+/// The merged top row (drag band + ribbon tab row) is this high, as in the reference suite.
+constexpr long ROW_HEIGHT = 48;
+/// The drag band above the tab row is at least this high, so a resize edge never covers a tab.
+constexpr long MIN_BAND = 4;
+/// Width of one caption button (Windows 10 and 11).
+constexpr long BUTTON_WIDTH = 46;
+/// The title shows only when this much room is left; the feature search keeps its preferred width first.
+constexpr long TITLE_MIN = 96;
+constexpr long TITLE_MAX = 420;
+constexpr long TITLE_PAD = 12;
+constexpr long SEARCH_PREFERRED = 320;
+
+inline long scaled(long n, double fScale) { return std::lround(n * fScale); }
+
+/// The drag band above a tab row nTabRow pixels high.
+inline long bandHeight(long nTabRow, double fScale)
+{
+    return std::max(scaled(MIN_BAND, fScale), scaled(ROW_HEIGHT, fScale) - nTabRow);
+}
+
+inline long buttonsWidth(double fScale) { return 3 * scaled(BUTTON_WIDTH, fScale); }
+
+/** Width of the title slot, left of the buttons. nFree: room the tab row has after its tabs and before
+    the buttons; nText: width of the title text. The title yields first: the search box keeps
+    SEARCH_PREFERRED, a title that does not fit is elided, below TITLE_MIN it is not shown. */
+inline long titleWidth(long nFree, long nText, double fScale)
+{
+    const long nWant = std::min(nText + 2 * scaled(TITLE_PAD, fScale), scaled(TITLE_MAX, fScale));
+    const long nRoom = std::min(nFree - scaled(SEARCH_PREFERRED, fScale), nWant);
+    if (nText <= 0 || nRoom <= 0)
+        return 0;
+    return (nRoom >= nWant || nRoom >= scaled(TITLE_MIN, fScale)) ? nRoom : 0;
+}
+
+/// The caption area (title, then the three buttons) at x of an area nWidth pixels wide.
+inline Hit captionAreaHit(long nX, long nWidth, double fScale)
+{
+    const long nButton = scaled(BUTTON_WIDTH, fScale);
+    const long nFromRight = nWidth - nX;
+    if (nX < 0 || nFromRight <= 0)
+        return Client;
+    if (nFromRight <= nButton)
+        return CloseButton;
+    if (nFromRight <= 2 * nButton)
+        return MaxButton;
+    if (nFromRight <= 3 * nButton)
+        return MinButton;
+    return Caption;
+}
+
+/// The system resize edge at the top of a restored window: y below nFrame pixels.
+inline bool onTopEdge(long nY, long nFrame) { return nY >= 0 && nY < nFrame; }
+}
