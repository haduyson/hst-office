+// HST Office: the Windows part of the own title bar (vcl/source/window/HstTitleBar.cxx draws it).
+// The caption is taken out of the non-client area (WM_NCCALCSIZE); everything else stays native through
+// hit testing: drag, double-click, Aero Snap and the system menu answer HTCAPTION, the buttons answer
+// HTMINBUTTON/HTMAXBUTTON/HTCLOSE (Windows 11 opens Snap Layouts for HTMAXBUTTON), the top edge HTTOP*.
+// Button presses never reach DefWindowProc, which would paint classic buttons; the frame tracks hover and
+// press, tells vcl to paint them and runs the system command. WM_GETTITLEBARINFOEX reports the real
+// rectangles, so UI Automation exposes the title bar and its buttons.
+
+#include <sal/config.h>
+
+#include <win/svsys.h>
+#include <dwmapi.h>
+#include <shellapi.h>
+#include <windowsx.h>
+
+#include <HstTitleBarGeometry.hxx>
+#include <win/saldata.hxx>
+#include <win/salframe.h>
+
+#include <initializer_list>
+
+namespace
+{
+using namespace hst::titlebar;
+
+/// Thickness of the sizing frame: also how far a maximized window reaches beyond the monitor.
+int FrameHeight() { return GetSystemMetrics(SM_CYFRAME) + GetSystemMetrics(SM_CXPADDEDBORDER); }
+int FrameWidth() { return GetSystemMetrics(SM_CXFRAME) + GetSystemMetrics(SM_CXPADDEDBORDER); }
+
+bool IsButton(WPARAM nCode) { return nCode == HTMINBUTTON || nCode == HTMAXBUTTON || nCode == HTCLOSE; }
+
+int ButtonOfCode(WPARAM nCode)
+{
+    switch (nCode)
+    {
+        case HTMINBUTTON: return MinButton;
+        case HTMAXBUTTON: return MaxButton;
+        case HTCLOSE: return CloseButton;
+        default: return Client;
+    }
+}
+
+/// A maximized window leaves one pixel to an auto-hide taskbar of its monitor, or it could not appear.
+void LeaveRoomForAutoHideTaskbar(HWND hWnd, RECT& rClient)
+{
+    APPBARDATA aState{ sizeof(APPBARDATA) };
+    if (!(SHAppBarMessage(ABM_GETSTATE, &aState) & ABS_AUTOHIDE))
+        return;
+    MONITORINFO aMonitor{ sizeof(MONITORINFO) };
+    if (!GetMonitorInfoW(MonitorFromWindow(hWnd, MONITOR_DEFAULTTONEAREST), &aMonitor))
+        return;
+    for (UINT nEdge : { ABE_BOTTOM, ABE_TOP, ABE_LEFT, ABE_RIGHT })
+    {
+        APPBARDATA aBar{ sizeof(APPBARDATA) };
+        aBar.uEdge = nEdge;
+        aBar.rc = aMonitor.rcMonitor;
+        if (!SHAppBarMessage(ABM_GETAUTOHIDEBAREX, &aBar))
+            continue;
+        if (nEdge == ABE_BOTTOM) rClient.bottom -= 1;
+        else if (nEdge == ABE_TOP) rClient.top += 1;
+        else if (nEdge == ABE_LEFT) rClient.left += 1;
+        else rClient.right -= 1;
+    }
+}
+
+/// vcl's answer for a client point; vcl is entered with the solar mutex, like every other message.
+int AskVcl(const WinSalFrame& rFrame, POINT aClient)
+{
+    if (!rFrame.m_aHstTitleBarHitTest)
+        return Client;
+    ImplSalYieldMutexAcquireWithWait();
+    const int nHit = rFrame.m_aHstTitleBarHitTest(aClient.x, aClient.y);
+    ImplSalYieldMutexRelease();
+    return nHit;
+}
+
+void SetButtons(WinSalFrame& rFrame, int nHot, int nPressed)
+{
+    if (rFrame.mnHstHotButton == nHot && rFrame.mnHstPressedButton == nPressed)
+        return;
+    rFrame.mnHstHotButton = nHot;
+    rFrame.mnHstPressedButton = nPressed;
+    if (!rFrame.m_aHstTitleBarButtons)
+        return;
+    ImplSalYieldMutexAcquireWithWait();
+    rFrame.m_aHstTitleBarButtons(nHot, nPressed);
+    ImplSalYieldMutexRelease();
+}
+
+LRESULT HitTest(WinSalFrame& rFrame, HWND hWnd, WPARAM wParam, LPARAM lParam)
+{
+    // the side and bottom sizing borders are still non-client
+    LRESULT nDefault = DefWindowProcW(hWnd, WM_NCHITTEST, wParam, lParam);
+    POINT aPoint{ GET_X_LPARAM(lParam), GET_Y_LPARAM(lParam) };
+    ScreenToClient(hWnd, &aPoint);
+    const bool bTopEdge = !IsZoomed(hWnd) && onTopEdge(aPoint.y, GetSystemMetrics(SM_CYFRAME));
+    if (nDefault == HTLEFT && bTopEdge)
+        return HTTOPLEFT;
+    if (nDefault == HTRIGHT && bTopEdge)
+        return HTTOPRIGHT;
+    if (nDefault != HTCLIENT)
+        return nDefault;
+    if (bTopEdge)
+    {
+        RECT aClient;
+        GetClientRect(hWnd, &aClient);
+        if (aPoint.x < FrameWidth())
+            return HTTOPLEFT;
+        if (aPoint.x >= aClient.right - FrameWidth())
+            return HTTOPRIGHT;
+        return HTTOP;
+    }
+    switch (AskVcl(rFrame, aPoint))
+    {
+        case Caption: return HTCAPTION;
+        case MinButton: return HTMINBUTTON;
+        case MaxButton: return HTMAXBUTTON;
+        case CloseButton: return HTCLOSE;
+        default: return HTCLIENT;
+    }
+}
+
+void RunButton(HWND hWnd, int nButton)
+{
+    WPARAM nCommand = SC_CLOSE;
+    if (nButton == MinButton)
+        nCommand = SC_MINIMIZE;
+    else if (nButton == MaxButton)
+        nCommand = IsZoomed(hWnd) ? SC_RESTORE : SC_MAXIMIZE;
+    PostMessageW(hWnd, WM_SYSCOMMAND, nCommand, 0);
+}
+
+void FillTitleBarInfo(const WinSalFrame& rFrame, HWND hWnd, TITLEBARINFOEX& rInfo)
+{
+    RECT aClient;
+    GetClientRect(hWnd, &aClient);
+    POINT aOrigin{ 0, 0 };
+    ClientToScreen(hWnd, &aOrigin);
+    const LONG nRight = aOrigin.x + aClient.right;
+    const LONG nBottom = aOrigin.y + static_cast<LONG>(rFrame.m_nHstTitleBarHeight);
+    const LONG nButton = static_cast<LONG>(rFrame.m_nHstCaptionButtonsWidth / 3);
+    rInfo.rcTitleBar = { aOrigin.x, aOrigin.y, nRight, nBottom };
+    rInfo.rgstate[0] = STATE_SYSTEM_FOCUSABLE;
+    rInfo.rgstate[1] = rInfo.rgstate[4] = STATE_SYSTEM_INVISIBLE; // reserved, help
+    rInfo.rgrect[1] = rInfo.rgrect[4] = RECT{ 0, 0, 0, 0 };
+    const int aButtons[] = { 5, 3, 2 }; // close, maximize, minimize from the right
+    for (int i = 0; i < 3; ++i)
+    {
+        const int nIndex = aButtons[i];
+        rInfo.rgrect[nIndex] = { nRight - (i + 1) * nButton, aOrigin.y, nRight - i * nButton, nBottom };
+        const int nButtonHit = nIndex == 5 ? CloseButton : nIndex == 3 ? MaxButton : MinButton;
+        rInfo.rgstate[nIndex] = rFrame.mnHstPressedButton == nButtonHit ? STATE_SYSTEM_PRESSED
+                                : rFrame.mnHstHotButton == nButtonHit   ? STATE_SYSTEM_HOTTRACKED
+                                                                        : 0;
+    }
+}
+}
+
+bool WinSalFrame::HstSetOwnTitleBar(bool bOn)
+{
+    const DWORD nStyle = GetWindowStyle(mhWnd);
+    if (bOn && (isFullScreen() || mbPresentation || !(nStyle & WS_CAPTION) || !(nStyle & WS_THICKFRAME)))
+        bOn = false;
+    if (bOn == mbHstOwnTitleBar)
+        return bOn;
+    mbHstOwnTitleBar = bOn;
+    mnHstHotButton = mnHstPressedButton = 0;
+    // a one-pixel frame extension keeps the system shadow (and on Windows 10 the top border) of the window
+    const MARGINS aMargins{ 0, 0, bOn ? 1 : 0, 0 };
+    DwmExtendFrameIntoClientArea(mhWnd, &aMargins);
+    SetWindowPos(mhWnd, nullptr, 0, 0, 0, 0,
+                 SWP_FRAMECHANGED | SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE | SWP_NOOWNERZORDER);
+    return bOn;
+}
+
+/// Window rectangle for a client rectangle, like AdjustWindowRectEx, without the caption when the frame
+/// draws its own title bar (the client then starts at the window's top edge).
+void ImplHstAdjustWindowRect(const WinSalFrame* pFrame, RECT* pRect)
+{
+    const LONG nTop = pRect->top;
+    AdjustWindowRectEx(pRect, GetWindowStyle(pFrame->mhWnd), FALSE, GetWindowExStyle(pFrame->mhWnd));
+    if (pFrame->mbHstOwnTitleBar && !pFrame->isFullScreen())
+        pRect->top = nTop;
+}
+
+/// How much lower the client would start with the system caption: window states are kept in those terms.
+tools::Long ImplHstWindowStateShift(const WinSalFrame* pFrame)
+{
+    if (!pFrame->mbHstOwnTitleBar || pFrame->isFullScreen() || IsIconic(pFrame->mhWnd))
+        return 0;
+    RECT aDeco{ 0, 0, 0, 0 };
+    AdjustWindowRectEx(&aDeco, GetWindowStyle(pFrame->mhWnd), FALSE, GetWindowExStyle(pFrame->mhWnd));
+    return tools::Long(-aDeco.top) - tools::Long(pFrame->GetUnmirroredGeometry().topDecoration());
+}
+
+/// The messages of the own title bar; true when handled (rResult is the answer).
+bool ImplHstTitleBarProc(HWND hWnd, UINT nMsg, WPARAM wParam, LPARAM lParam, LRESULT& rResult)
+{
+    WinSalFrame* pFrame = GetWindowPtr(hWnd);
+    if (!pFrame || !pFrame->mbHstOwnTitleBar || pFrame->isFullScreen())
+        return false;
+    switch (nMsg)
+    {
+        case WM_NCCALCSIZE:
+        {
+            if (!wParam)
+                return false;
+            RECT& rClient = reinterpret_cast<NCCALCSIZE_PARAMS*>(lParam)->rgrc[0];
+            const LONG nTop = rClient.top;
+            rResult = DefWindowProcW(hWnd, nMsg, wParam, lParam);
+            rClient.top = nTop;
+            if (IsZoomed(hWnd))
+            {
+                rClient.top += FrameHeight(); // not off-screen: the frame reaches beyond the monitor
+                LeaveRoomForAutoHideTaskbar(hWnd, rClient);
+            }
+            return true;
+        }
+        case WM_NCHITTEST:
+            rResult = HitTest(*pFrame, hWnd, wParam, lParam);
+            return true;
+        case WM_NCMOUSEMOVE:
+        {
+            const int nHot = IsButton(wParam) ? ButtonOfCode(wParam) : Client;
+            SetButtons(*pFrame, nHot, pFrame->mnHstPressedButton); // a press lasts until the button is released
+            if (nHot != Client)
+            {
+                TRACKMOUSEEVENT aTrack{ sizeof(TRACKMOUSEEVENT), TME_LEAVE | TME_NONCLIENT, hWnd, 0 };
+                TrackMouseEvent(&aTrack);
+            }
+            return false; // vcl still learns that the pointer left its client area
+        }
+        case WM_NCMOUSELEAVE:
+        case WM_MOUSEMOVE:
+        case WM_LBUTTONUP:
+            SetButtons(*pFrame, Client, Client);
+            return false;
+        case WM_NCLBUTTONDOWN:
+        case WM_NCLBUTTONDBLCLK:
+            if (!IsButton(wParam))
+                return false;
+            SetButtons(*pFrame, ButtonOfCode(wParam), ButtonOfCode(wParam));
+            rResult = 0;
+            return true;
+        case WM_NCLBUTTONUP:
+        {
+            const int nPressed = pFrame->mnHstPressedButton;
+            SetButtons(*pFrame, IsButton(wParam) ? ButtonOfCode(wParam) : Client, Client);
+            if (!IsButton(wParam))
+                return false;
+            if (nPressed == ButtonOfCode(wParam))
+                RunButton(hWnd, nPressed);
+            rResult = 0;
+            return true;
+        }
+        case WM_GETTITLEBARINFOEX:
+        {
+            auto* pInfo = reinterpret_cast<TITLEBARINFOEX*>(lParam);
+            if (!pInfo || pInfo->cbSize < sizeof(TITLEBARINFOEX) || pFrame->m_nHstTitleBarHeight <= 0)
+                return false;
+            FillTitleBarInfo(*pFrame, hWnd, *pInfo);
+            rResult = 0;
+            return true;
+        }
+        default:
+            return false;
+    }
+}
