+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This file is part of the LibreOffice project.
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+// HST Office: the own title bar of the document windows, Tabbed user interface (gap list G19).
+// The merged top row is ROW_HEIGHT logical px: a drag band above the ribbon tab row (quick access
+// toolbar, tabs, feature search), and at its right end the caption area (HstTitleBar): the window title,
+// then minimize, maximize/restore and close in the style of the system. The frame takes the caption out
+// of the system frame and asks HstHitTest what is under the pointer (SalFrame::HstSetOwnTitleBar,
+// Windows: vcl/win/window/HstWinTitleBar.cxx). Other platforms, other user interfaces, full screen, a
+// shown menu bar and the option "Use the operating system's title bar" keep the system title bar.
+
+#include <sal/config.h>
+
+#include <brdwin.hxx>
+#include <salframe.hxx>
+#include <window.h>
+#include <HstTitleBarGeometry.hxx>
+#include <HstTitleBarWindow.hxx>
+
+#include <comphelper/configuration.hxx>
+#include <officecfg/Office/Common.hxx>
+#include <vcl/HstTitleBar.hxx>
+#include <vcl/notebookbar/notebookbar.hxx>
+#include <vcl/svapp.hxx>
+#include <vcl/tabctrl.hxx>
+#include <vcl/wrkwin.hxx>
+
+using namespace hst::titlebar;
+
+namespace
+{
+ImplBorderWindow* BorderOf(const vcl::Window& rWindow)
+{
+    vcl::Window* pFrame = rWindow.ImplGetFrameWindow();
+    return pFrame && pFrame->GetType() == WindowType::BORDERWINDOW ? static_cast<ImplBorderWindow*>(pFrame)
+                                                                    : nullptr;
+}
+}
+
+NotebookbarTabControlBase* ImplBorderWindow::HstTabControl() const
+{
+    if (!mpNotebookBar || mpNotebookBar->isDisposed())
+        return nullptr;
+    // the tab row is a child or grandchild of the notebookbar
+    for (vcl::Window* pChild = mpNotebookBar->GetWindow(GetWindowType::FirstChild); pChild;
+         pChild = pChild->GetWindow(GetWindowType::Next))
+    {
+        if (auto* pTab = dynamic_cast<NotebookbarTabControlBase*>(pChild))
+            return pTab;
+        for (vcl::Window* pGrand = pChild->GetWindow(GetWindowType::FirstChild); pGrand;
+             pGrand = pGrand->GetWindow(GetWindowType::Next))
+            if (auto* pTab = dynamic_cast<NotebookbarTabControlBase*>(pGrand))
+                return pTab;
+    }
+    return nullptr;
+}
+
+bool ImplBorderWindow::HstWantsTitleBar() const
+{
+    if (!mpWindowImpl->mbFrame || isDisposed() || !Supported() || comphelper::IsFuzzing())
+        return false;
+    try
+    {
+        if (officecfg::Office::Common::Misc::HstSystemTitleBar::get())
+            return false;
+    }
+    catch (const css::uno::Exception&)
+    {
+        return false; // no configuration: the system title bar
+    }
+    const vcl::Window* pClient = ImplGetClientWindow();
+    if (!pClient || pClient->GetType() != WindowType::WORKWINDOW
+        || static_cast<const WorkWindow*>(pClient)->IsFullScreenMode())
+        return false;
+    if (mpMenuBarWindow && !mbMenuHide && mpMenuBarWindow->GetSizePixel().Height() > 0)
+        return false; // a shown menu bar stays under the system title bar
+    return mpNotebookBar && mpNotebookBar->IsVisible() && mpNotebookBar->HstHasOwnBanner() && HstTabControl();
+}
+
+void ImplBorderWindow::HstUpdateTitleBar()
+{
+    if (mpHstTitleBarEvent || isDisposed() || HstWantsTitleBar() == bool(mpHstTitleBar))
+        return;
+    // not inside a resize: switching the frame resizes the window again
+    mpHstTitleBarEvent = Application::PostUserEvent(LINK(this, ImplBorderWindow, HstTitleBarHdl));
+}
+
+IMPL_LINK_NOARG(ImplBorderWindow, HstTitleBarHdl, void*, void)
+{
+    mpHstTitleBarEvent = nullptr;
+    SalFrame* pFrame = mpWindowImpl->mpFrame;
+    if (isDisposed() || !pFrame || HstWantsTitleBar() == bool(mpHstTitleBar))
+        return;
+    if (!mpHstTitleBar)
+    {
+        mpHstTitleBar = VclPtr<HstTitleBar>::Create(this);
+        pFrame->m_aHstTitleBarHitTest = [this](tools::Long nX, tools::Long nY) { return HstHitTest(Point(nX, nY)); };
+        pFrame->m_aHstTitleBarButtons = [this](int nHot, int nPressed) {
+            if (mpHstTitleBar)
+                mpHstTitleBar->SetButtons(nHot, nPressed);
+        };
+        Resize(); // band and caption area are in place before the frame asks for them
+        if (!pFrame->HstSetOwnTitleBar(true))
+        {
+            pFrame->m_aHstTitleBarHitTest = nullptr;
+            pFrame->m_aHstTitleBarButtons = nullptr;
+            mpHstTitleBar.disposeAndClear(); // the platform keeps the system title bar
+        }
+    }
+    else
+    {
+        pFrame->HstSetOwnTitleBar(false);
+        pFrame->m_aHstTitleBarHitTest = nullptr;
+        pFrame->m_aHstTitleBarButtons = nullptr;
+        pFrame->m_nHstTitleBarHeight = pFrame->m_nHstCaptionButtonsWidth = 0;
+        mpHstTitleBar.disposeAndClear();
+    }
+    Resize();
+    if (NotebookbarTabControlBase* pTab = HstTabControl())
+        pTab->Resize(); // the tab row takes or gives back the room of the caption area
+    Invalidate();
+}
+
+tools::Long ImplBorderWindow::HstTitleBand() const
+{
+    if (!mpHstTitleBar)
+        return 0;
+    return bandHeight(NotebookbarTabControlBase::HstHeaderHeight(), GetDPIScaleFactor());
+}
+
+void ImplBorderWindow::HstPlaceTitleBar()
+{
+    if (!mpHstTitleBar || !mpNotebookBar)
+        return;
+    const double f = GetDPIScaleFactor();
+    const tools::Long nBand = HstTitleBand();
+    const tools::Long nWidth = buttonsWidth(f) + mpHstTitleBar->TitleWidth();
+    const tools::Long nHeight = nBand + NotebookbarTabControlBase::HstHeaderHeight();
+    const Point aBar = mpNotebookBar->GetPosPixel();
+    const Point aPos(aBar.X() + mpNotebookBar->GetSizePixel().Width() - nWidth, aBar.Y() - nBand);
+    mpHstTitleBar->SetBand(nBand);
+    mpHstTitleBar->SetPosSizePixel(aPos, Size(nWidth, nHeight));
+    if (GetWindow(GetWindowType::FirstChild) != mpHstTitleBar.get())
+        mpHstTitleBar->SetZOrder(nullptr, ZOrderFlags::First); // above the notebookbar
+    mpNotebookBar->EnableClipSiblings(true); // the tab row never paints over the caption area
+    mpHstTitleBar->Show();
+    mpHstTitleBar->Invalidate();
+    mpWindowImpl->mpFrame->m_nHstTitleBarHeight = aPos.Y() + nHeight;
+    mpWindowImpl->mpFrame->m_nHstCaptionButtonsWidth = buttonsWidth(f);
+}
+
+int ImplBorderWindow::HstHitTest(const Point& rPos) const
+{
+    if (!mpHstTitleBar || !mpHstTitleBar->IsVisible() || !mpNotebookBar)
+        return Client;
+    const tools::Rectangle aCaption(mpHstTitleBar->GetPosPixel(), mpHstTitleBar->GetSizePixel());
+    if (aCaption.Contains(rPos))
+        return mpHstTitleBar->HitTest(rPos - aCaption.TopLeft());
+    if (rPos.Y() >= 0 && rPos.Y() < mpNotebookBar->GetPosPixel().Y())
+        return Caption; // the drag band
+    NotebookbarTabControlBase* pTab = HstTabControl();
+    if (!pTab || !pTab->IsReallyVisible())
+        return Client;
+    const Point aPos = pTab->ScreenToOutputPixel(OutputToScreenPixel(rPos));
+    if (aPos.X() < 0 || aPos.Y() < 0 || aPos.X() >= pTab->GetOutputSizePixel().Width()
+        || aPos.Y() >= NotebookbarTabControlBase::HstHeaderHeight())
+        return Client;
+    if (pTab->GetPageId(aPos) != 0)
+        return Client;
+    // the quick access toolbar, the search box and the menu button are controls
+    for (vcl::Window* pChild = pTab->GetWindow(GetWindowType::FirstChild); pChild;
+         pChild = pChild->GetWindow(GetWindowType::Next))
+        if (pChild->IsVisible() && tools::Rectangle(pChild->GetPosPixel(), pChild->GetSizePixel()).Contains(aPos))
+            return Client;
+    return Caption; // an empty part of the tab row
+}
+
+tools::Long hst::titlebar::RowReserve(const vcl::Window& rTabControl, tools::Long nFree)
+{
+    ImplBorderWindow* pBorder = BorderOf(rTabControl);
+    if (!pBorder || !pBorder->GetHstTitleBar() || pBorder->HstTabControl() != &rTabControl)
+        return 0;
+    HstTitleBar& rBar = *pBorder->GetHstTitleBar();
+    const double f = rTabControl.GetDPIScaleFactor();
+    const tools::Long nButtons = buttonsWidth(f);
+    const tools::Long nTitle = titleWidth(nFree - nButtons, rBar.TitleTextWidth(), f);
+    if (nTitle != rBar.TitleWidth())
+    {
+        rBar.SetTitleWidth(nTitle);
+        pBorder->HstPlaceTitleBar();
+    }
+    return nButtons + nTitle;
+}
+
+bool hst::titlebar::Supported()
+{
+#ifdef _WIN32
+    return true; // Windows 10 and 11
+#else
+    return false; // gtk3 (client-side decorations differ per desktop) and macOS keep the system title bar
+#endif
+}
+
+void hst::titlebar::SettingChanged()
+{
+    for (vcl::Window* pWin = Application::GetFirstTopLevelWindow(); pWin;
+         pWin = Application::GetNextTopLevelWindow(pWin))
+        if (pWin->GetType() == WindowType::BORDERWINDOW)
+            static_cast<ImplBorderWindow*>(pWin)->HstUpdateTitleBar();
+}
