--- a/solenv/bin/modules/installer/windows/upgrade.pm
+++ b/solenv/bin/modules/installer/windows/upgrade.pm
@@ -62,6 +62,13 @@ sub create_upgrade_table
         # 257 = msidbUpgradeAttributesMigrateFeatures (1) + msidbUpgradeAttributesVersionMinInclusive (256); the maximum is exclusive.
         $newline = $legacycode . "\t" . $legacymin . "\t" . $legacymax . "\t" . "\t" . "257" . "\t" . "\t" . "OLDPRODUCTS" . "\n";
         push(@upgradetable, $newline);
+        # The same range, detect only (258 = msidbUpgradeAttributesOnlyDetect (2) + VersionMinInclusive (256)):
+        # HSTLEGACYPRODUCTS tells the installer it is replacing such a build. Their files may carry a
+        # higher version than ours, so costing would skip them before RemoveExistingProducts deletes the
+        # old copies; when it is set, the HstLegacy* actions (CustomAc.idt) force the files in
+        # (REINSTALLMODE=amus) and leave the system C++ runtime out of costing (VC_REDIST=0).
+        $newline = $legacycode . "\t" . $legacymin . "\t" . $legacymax . "\t" . "\t" . "258" . "\t" . "\t" . "HSTLEGACYPRODUCTS" . "\n";
+        push(@upgradetable, $newline);
     }
 
