+/** Dynamic arrays when typing in HST Sheets (sc/source/ui/hst/hstdynamicarrayinput.cxx). */
+namespace sc::hst
+{
+/** Whether a formula typed into the cursor cell spills like in the leading spreadsheet
+    application: its result is an array of more than one cell. Formulas that can only give a
+    single value are not calculated a second time to find out, nor are formulas calling macros
+    or add-ins. Not when a range is selected: Ctrl+Shift+Enter keeps filling a selection. */
+bool FormulaSpills(ScDocument& rDoc, const ScAddress& rPos, const ScMarkData& rMark,
+                   const ScTokenArray& rCode, const OUString& rFormula,
+                   formula::FormulaGrammar::Grammar eGrammar);
+
+/** The range a spilling formula is entered into: the result range, or only the formula cell
+    when another array formula is in the way, so the formula shows #SPILL! like in the leading
+    spreadsheet application instead of refusing the input. */
+ScRange SpillEntryRange(const ScDocument& rDoc, const ScMarkData& rMark, const ScRange& rResult,
+                        const ScAddress& rCursor);
+
+/** The input line text of a dynamic array (its formula cell or a cell of its spill range):
+    the formula as typed, without the braces of a legacy array formula. */
+void StripDynamicArrayBraces(const ScDocument& rDoc, const ScFormulaCell& rCell, OUString& rText);
+}
