+#include <vector>
+
+namespace formula
+{
+class FormulaToken;
+
+/** Formula text of the dynamic array operators in HST Sheets.
+
+    The UI grammars show ANCHORARRAY(A1) as A1#, the spill range operator as typed, and
+    @(A1:A9) read from a file as @A1:A9. OOXML has no @ operator: the operand is written as
+    the argument of _xlfn.SINGLE(). Used by FormulaCompiler::CreateStringFromTokenArray().
+ */
+class HstFormulaStringWriter
+{
+public:
+    explicit HstFormulaStringWriter(FormulaCompiler& rCompiler);
+
+    /// Appends the closing parentheses of _xlfn.SINGLE( that end before t.
+    void CloseBefore(OUStringBuffer& rBuffer, const FormulaToken* t);
+    /// Writes t and the tokens it takes along; true when it did, t is then the next token.
+    bool Write(OUStringBuffer& rBuffer, const FormulaToken*& t);
+    /// Appends the parentheses still open at the formula end (t is nullptr there).
+    void Finish(OUStringBuffer& rBuffer, const FormulaToken* t);
+
+private:
+    bool WriteSpillRange(OUStringBuffer& rBuffer, const FormulaToken*& t);
+    bool WriteSingleValue(OUStringBuffer& rBuffer, const FormulaToken*& t);
+    bool IsUiLanguage() const;
+
+    FormulaCompiler& mrCompiler;
+    /// Tokens before which a _xlfn.SINGLE( closes, innermost last; nullptr is the formula end.
+    std::vector<const FormulaToken*> maSingleValueEnds;
+};
+}
