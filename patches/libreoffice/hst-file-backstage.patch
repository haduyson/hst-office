+   (the Start Center's history list with its pinning), document information and save formats. */
+namespace sfx2::hst
+{
+/// The document application a backstage belongs to (decides colour, blank document, templates).
+enum class BackstageApp
+{
+    Writer,
+    Calc,
+    Impress,
+    Other
+};
+
+/// The HST administrative document wizard (Decree 30/2020/ND-CP) of the HST extension.
+inline constexpr OUString ND30_COMMAND = u"org.hst.office.vi:Nd30Wizard"_ustr;
+
+struct BackstageTemplate
+{
+    enum class Kind
+    {
+        Factory, // a blank document (private:factory/...)
+        Command, // a dispatch command (the administrative document wizard)
+        Template // an installed HST template, opened as a new untitled document
+    };
+    OUString aTitle;
+    OUString aTarget;
+    Kind eKind;
+};
+
+struct BackstageRecentFile
+{
+    OUString aURL;
+    OUString aName;
+    OUString aLocation; // the last two folders, "Documents › Reports"
+    OUString aDate; // "Today 14:20", "Yesterday", "02/11/2026"
+    OUString aIcon;
+    bool bPinned = false;
+};
+
+struct BackstageDocumentInfo
+{
+    OUString aName;
+    OUString aBaseName; // file name without extension (or the title of an unsaved document)
+    OUString aType;
+    OUString aFolder; // system path of the folder, empty when not saved yet
+    OUString aFolderURL;
+    OUString aSize;
+    OUString aCreated;
+    OUString aModified;
+    OUString aAuthor;
+    OUString aSignature;
+};
+
+struct BackstageFormat
+{
+    OUString aFilterName;
+    OUString aLabel;
+};
+
+OUString GetFactoryURL(BackstageApp eApp);
+
+/// Blank document first, then the administrative document wizard (Writer) and the HST
+/// templates of the application that are installed.
+std::vector<BackstageTemplate> GetNewDocumentChoices(BackstageApp eApp);
+
+/// The recent documents list (most recent first) with dates of the files on disk.
+std::vector<BackstageRecentFile> GetRecentFiles();
+
+/// System path for a file URL (the URL itself for other schemes).
+OUString GetDisplayPath(const OUString& rURL);
+
+/// "Today 14:20", "Yesterday" or the date as dd/mm/yyyy.
+OUString FormatRecentDate(const DateTime& rWhen, const DateTime& rNow);
+
+BackstageDocumentInfo GetDocumentInfo(const css::uno::Reference<css::frame::XFrame>& rxFrame,
+                                      bool bWithSignature = true);
+
+/// Save formats of the application, the OOXML format first; the format Save uses for new
+/// documents is marked as default; filters that are not installed are left out.
+std::vector<BackstageFormat> GetSaveFormats(BackstageApp eApp);
+
+int GetCurrentHour();
+}
