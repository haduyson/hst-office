+void BackstageWindow::dispose()
+{
+    if (m_pPendingSaveAs)
+    {
+        Application::RemoveUserEvent(m_pPendingSaveAs);
+        m_pPendingSaveAs = nullptr;
+    }
+    if (m_pPendingMenu)
+    {
+        Application::RemoveUserEvent(m_pPendingMenu);
+        m_pPendingMenu = nullptr;
+    }
+    if (m_xParent)
+        m_xParent->RemoveEventListener(LINK(this, BackstageWindow, ParentEventHdl));
+    if (m_bRibbonHidden)
+        SetRibbonVisible(true);
+    m_xParent.reset();
+    m_xAccExec.reset();
+    m_aNav.clear();
+    m_aTiles.clear();
+    m_aTitles.clear();
+    m_xNavBox.reset();
+    m_xNavSeparator.reset();
+    m_xContent.reset();
+    m_xPageHome.reset();
+    m_xPageNew.reset();
+    m_xPageOpen.reset();
+    m_xPageInfo.reset();
+    m_xPageSaveAs.reset();
+    m_xGreeting.reset();
+    m_xMoreTemplates.reset();
+    m_xRecentTabs.reset();
+    m_xRecentList.reset();
+    m_xPinnedList.reset();
+    m_xRecentEmpty.reset();
+    m_xPinnedEmpty.reset();
+    m_xRecentMenu.reset();
+    m_xNewBlank.reset();
+    m_xNewNd30.reset();
+    m_xNewManage.reset();
+    m_xTemplateViewWin.reset();
+    m_xTemplateView.reset();
+    m_xOpenBrowse.reset();
+    m_xOpenList.reset();
+    m_xInfoName.reset();
+    m_xInfoType.reset();
+    m_xInfoPath.reset();
+    m_xInfoSize.reset();
+    m_xInfoCreated.reset();
+    m_xInfoModified.reset();
+    m_xInfoAuthor.reset();
+    m_xInfoSignature.reset();
+    m_xInfoProperties.reset();
+    m_xInfoSign.reset();
+    m_xSaveAsFolder.reset();
+    m_xFormatList.reset();
+    m_xSaveAsBrowse.reset();
+    m_xFrame.clear();
+    InterimItemWindow::dispose();
+}
+
+void BackstageWindow::InitNavigation()
+{
+    static constexpr std::pair<OUString, bool> aIds[]
+        = { { u"navback"_ustr, true },    { u"navhome"_ustr, false },  { u"navnew"_ustr, false },
+            { u"navopen"_ustr, false },   { u"navinfo"_ustr, false },  { u"navsave"_ustr, false },
+            { u"navsaveas"_ustr, false }, { u"navprint"_ustr, false }, { u"navpdf"_ustr, false },
+            { u"navsign"_ustr, false },   { u"navclose"_ustr, false }, { u"navabout"_ustr, false },
+            { u"navoptions"_ustr, false } };
+    for (const auto& [rId, bLarge] : aIds)
+    {
+        NavItem aItem;
+        aItem.aId = rId;
+        aItem.xButton = m_xBuilder->weld_button(rId);
+        aItem.bLarge = bLarge;
+        // the text is drawn into the custom button image (white on the application colour);
+        // the translated label stays the accessible name
+        aItem.aText = aItem.xButton->get_label();
+        if (!bLarge)
+            aItem.xButton->set_accessible_name(aItem.aText);
+        aItem.xButton->set_label(OUString());
+        aItem.xButton->connect_clicked(LINK(this, BackstageWindow, NavClickHdl));
+        m_aNav.push_back(std::move(aItem));
+    }
+}
+
+tools::Long BackstageWindow::GetNavWidth()
+{
+    if (m_nNavWidth)
+        return m_nNavWidth;
+    // wide enough for the longest item, at least 220 pixels like the design
+    m_nNavWidth = 220;
+    if (!m_aNav.empty())
+    {
+        ScopedVclPtr<VirtualDevice> xDev = m_aNav.front().xButton->create_virtual_device();
+        vcl::Font aFont(GetNavFont(false, *xDev));
+        aFont.SetWeight(WEIGHT_BOLD); // the selected item
+        xDev->SetFont(aFont);
+        for (const NavItem& rItem : m_aNav)
+            if (!rItem.bLarge)
+                m_nNavWidth = std::max(m_nNavWidth, xDev->GetTextWidth(rItem.aText) + 2 * NAV_TEXT_INDENT);
+    }
+    return m_nNavWidth;
+}
+
+vcl::Font BackstageWindow::GetNavFont(bool bLarge, const OutputDevice& rDevice) const
+{
+    // the style font height is in points, the virtual device draws in pixels
+    vcl::Font aFont(Application::GetSettings().GetStyleSettings().GetLabelFont());
+    const double fPixels = aFont.GetFontHeight() * rDevice.GetDPIY() / 72.0;
+    aFont.SetFontHeight(fPixels * (bLarge ? 1.8 : 1.15));
+    return aFont;
+}
+
+void BackstageWindow::PaintNavItem(size_t nIndex)
+{
+    NavItem& rItem = m_aNav[nIndex];
+    const bool bSelected = static_cast<int>(nIndex) == m_nSelectedNav;
+    const tools::Long nWidth = GetNavWidth();
+    ScopedVclPtr<VirtualDevice> xDev = rItem.xButton->create_virtual_device();
+    xDev->SetOutputSizePixel(Size(nWidth, NAV_ITEM_HEIGHT));
+    Color aBack(m_aNavColor);
+    if (bSelected)
+        aBack.Merge(COL_WHITE, 210); // about 18 % white over the application colour
+    xDev->SetBackground(Wallpaper(aBack));
+    xDev->Erase();
+    vcl::Font aFont(GetNavFont(rItem.bLarge, *xDev));
+    if (bSelected)
+        aFont.SetWeight(WEIGHT_BOLD);
+    aFont.SetColor(COL_WHITE);
+    xDev->SetFont(aFont);
+    xDev->SetTextColor(COL_WHITE);
+    const tools::Long nTextY = (NAV_ITEM_HEIGHT - xDev->GetTextHeight()) / 2;
+    xDev->DrawText(Point(NAV_TEXT_INDENT, nTextY), rItem.aText);
+    rItem.xButton->set_size_request(nWidth, NAV_ITEM_HEIGHT);
+    rItem.xButton->set_custom_button(xDev.get());
+}
+
+void BackstageWindow::PaintNavItems()
+{
+    for (size_t i = 0; i < m_aNav.size(); ++i)
+        PaintNavItem(i);
+}
+
+void BackstageWindow::ApplyColors()
+{
+    const StyleSettings& rStyle = Application::GetSettings().GetStyleSettings();
+    m_xNavBox->set_background(m_aNavColor);
+    Color aSeparator(m_aNavColor);
+    aSeparator.Merge(COL_WHITE, 190);
+    m_xNavSeparator->set_background(aSeparator);
+    m_xContent->set_background(rStyle.GetWindowColor());
+    SetBackground(rStyle.GetWindowColor());
+    PaintNavItems();
+
+    vcl::Font aTitle(rStyle.GetLabelFont());
+    aTitle.SetFontHeight(aTitle.GetFontHeight() * 2.2);
+    aTitle.SetWeight(WEIGHT_SEMIBOLD);
+    m_xGreeting->set_font(aTitle);
+    for (size_t i = 0; i < m_aTitles.size(); ++i)
+    {
+        vcl::Font aFont(rStyle.GetLabelFont());
+        // the first four are page titles, the others section headings
+        aFont.SetFontHeight(aFont.GetFontHeight() * (i < 4 ? 2.2 : 1.1));
+        aFont.SetWeight(i < 4 ? WEIGHT_SEMIBOLD : WEIGHT_BOLD);
+        m_aTitles[i]->set_font(aFont);
+    }
+    for (TemplateTile& rTile : m_aTiles)
+        if (!rTile.aTarget.isEmpty())
+            PaintTile(rTile);
+}
+
+void BackstageWindow::PaintTile(TemplateTile& rTile)
+{
+    ScopedVclPtr<VirtualDevice> xDev = rTile.xButton->create_virtual_device();
+    lcl_paintTile(*xDev, rTile.bNd30, rTile.bBlank);
+    rTile.xButton->set_image(xDev.get());
+}
+
+void BackstageWindow::InitHomePage()
+{
+    std::vector<BackstageTemplate> aTemplates = GetNewDocumentChoices(m_eApp);
+    for (size_t i = 0; i < 5; ++i)
+    {
+        TemplateTile aTile;
+        aTile.xBox = m_xBuilder->weld_container(u"tilebox"_ustr + OUString::number(i));
+        aTile.xButton = m_xBuilder->weld_button(u"tile"_ustr + OUString::number(i));
+        aTile.xLabel = m_xBuilder->weld_label(u"tilelabel"_ustr + OUString::number(i));
+        if (i >= aTemplates.size())
+        {
+            aTile.xBox->hide();
+            m_aTiles.push_back(std::move(aTile));
+            continue;
+        }
+        const BackstageTemplate& rTemplate = aTemplates[i];
+        aTile.aTarget = rTemplate.aTarget;
+        aTile.eKind = rTemplate.eKind;
+        aTile.bBlank = rTemplate.eKind == BackstageTemplate::Kind::Factory;
+        aTile.bNd30 = rTemplate.eKind == BackstageTemplate::Kind::Command;
+        aTile.xLabel->set_label(rTemplate.aTitle);
+        aTile.xButton->set_accessible_name(rTemplate.aTitle);
+        aTile.xButton->set_tooltip_text(rTemplate.aTitle);
+        aTile.xButton->connect_clicked(LINK(this, BackstageWindow, TileClickHdl));
+        m_aTiles.push_back(std::move(aTile));
+    }
+}
+
+void BackstageWindow::InitNewPage()
+{
+    if (m_bNewPageInitialized)
+        return;
+    m_bNewPageInitialized = true;
+    m_xTemplateView.reset(new TemplateDefaultView(m_xBuilder->weld_scrolled_window(u"scrolllocal"_ustr, true),
+                                                  m_xBuilder->weld_menu(u"localmenu"_ustr)));
+    m_xTemplateViewWin.reset(new weld::CustomWeld(*m_xBuilder, u"local_view"_ustr, *m_xTemplateView));
+    m_xTemplateView->setOpenTemplateHdl(LINK(this, BackstageWindow, OpenTemplateHdl));
+    m_xTemplateView->ShowTooltips(true);
+    m_xTemplateView->Populate();
+    const FILTER_APPLICATION eFilter = m_eApp == BackstageApp::Writer    ? FILTER_APPLICATION::WRITER
+                                       : m_eApp == BackstageApp::Calc    ? FILTER_APPLICATION::CALC
+                                       : m_eApp == BackstageApp::Impress ? FILTER_APPLICATION::IMPRESS
+                                                                         : FILTER_APPLICATION::DRAW;
+    m_xTemplateView->filterItems(ViewFilter_Application(eFilter));
+    m_xTemplateView->showAllTemplates();
+}
+
+void BackstageWindow::ShowPage(Page ePage)
+{
+    m_ePage = ePage;
+    m_xPageHome->set_visible(ePage == Page::Home);
+    m_xPageNew->set_visible(ePage == Page::New);
+    m_xPageOpen->set_visible(ePage == Page::Open);
+    m_xPageInfo->set_visible(ePage == Page::Info);
+    m_xPageSaveAs->set_visible(ePage == Page::SaveAs);
+
+    const OUString aNavId = ePage == Page::Home     ? u"navhome"_ustr
+                            : ePage == Page::New    ? u"navnew"_ustr
+                            : ePage == Page::Open   ? u"navopen"_ustr
+                            : ePage == Page::Info   ? u"navinfo"_ustr
+                                                    : u"navsaveas"_ustr;
+    const int nOld = m_nSelectedNav;
+    for (size_t i = 0; i < m_aNav.size(); ++i)
+        if (m_aNav[i].aId == aNavId)
+            m_nSelectedNav = i;
+    if (nOld != m_nSelectedNav)
+    {
+        if (nOld >= 0 && o3tl::make_unsigned(nOld) < m_aNav.size())
+            PaintNavItem(nOld);
+        PaintNavItem(m_nSelectedNav);
+    }
+
+    if (ePage == Page::New)
+        InitNewPage();
+    else if (ePage == Page::Info)
+        FillInfoPage();
+    else if (ePage == Page::SaveAs)
+        FillSaveAsPage();
+}
+
+void BackstageWindow::FillRecentLists()
+{
+    std::vector<BackstageRecentFile> aFiles = GetRecentFiles();
+    FillRecentList(*m_xRecentList, aFiles, false);
+    FillRecentList(*m_xPinnedList, aFiles, true);
+    FillRecentList(*m_xOpenList, aFiles, false);
+
+    m_xRecentEmpty->set_label(SfxResId(STR_HST_BS_NO_RECENT));
+    m_xRecentEmpty->set_visible(m_xRecentList->n_children() == 0);
+    m_xPinnedEmpty->set_label(SfxResId(STR_HST_BS_NO_PINNED));
+    m_xPinnedEmpty->set_visible(m_xPinnedList->n_children() == 0);
+}
+
+void BackstageWindow::FillRecentList(weld::TreeView& rList,
+                                     const std::vector<BackstageRecentFile>& rFiles, bool bPinnedOnly)
+{
+    rList.freeze();
+    rList.clear();
+    for (const BackstageRecentFile& rFile : rFiles)
+    {
+        if (bPinnedOnly && !rFile.bPinned)
+            continue;
+        rList.insert(-1, rFile.aName, &rFile.aURL, &rFile.aIcon, nullptr);
+        const int nRow = rList.n_children() - 1;
+        rList.set_text(nRow, rFile.aLocation, 2);
+        rList.set_text(nRow, rFile.aDate, 3);
+        if (rFile.bPinned)
+            rList.set_image(nRow, u"res/recentdoc_pin.png"_ustr, 4);
+    }
+    rList.thaw();
+}
+
+void BackstageWindow::FillInfoPage()
+{
+    BackstageDocumentInfo aInfo = GetDocumentInfo(m_xFrame);
+    m_xInfoName->set_label(aInfo.aName);
+    m_xInfoType->set_label(aInfo.aType);
+    m_xInfoPath->set_label(aInfo.aFolder.isEmpty() ? SfxResId(STR_HST_BS_NOT_SAVED) : aInfo.aFolder);
+    m_xInfoSize->set_label(aInfo.aSize);
+    m_xInfoCreated->set_label(aInfo.aCreated);
+    m_xInfoModified->set_label(aInfo.aModified);
+    m_xInfoAuthor->set_label(aInfo.aAuthor);
+    m_xInfoSignature->set_label(aInfo.aSignature);
+}
+
+void BackstageWindow::FillSaveAsPage()
+{
+    BackstageDocumentInfo aInfo = GetDocumentInfo(m_xFrame, false);
+    m_xSaveAsFolder->set_label(
+        SfxResId(STR_HST_BS_SAVEAS_FOLDER)
+            .replaceFirst("%1", aInfo.aFolder.isEmpty() ? SfxResId(STR_HST_BS_NOT_SAVED) : aInfo.aFolder));
+    m_xFormatList->freeze();
+    m_xFormatList->clear();
+    for (const BackstageFormat& rFormat : GetSaveFormats(m_eApp))
+        m_xFormatList->append(rFormat.aFilterName, rFormat.aLabel);
+    m_xFormatList->thaw();
+    if (m_xFormatList->n_children())
+        m_xFormatList->select(0);
+}
+
+void BackstageWindow::LayoutToParent()
+{
+    if (!m_xParent)
+        return;
+    SetPosSizePixel(Point(0, 0), m_xParent->GetOutputSizePixel());
+}
+
+void BackstageWindow::SetRibbonVisible(bool bVisible)
+{
+    SystemWindow* pSysWin = m_xParent ? m_xParent->GetSystemWindow() : nullptr;
+    if (!pSysWin)
+        return;
+    const VclPtr<NotebookBar>& pNotebookBar = pSysWin->GetNotebookBar();
+    if (!pNotebookBar)
+        return;
+    if (bVisible && m_bRibbonHidden)
+    {
+        m_bRibbonHidden = false;
+        pNotebookBar->Show();
+        pNotebookBar->GetParent()->Resize();
+    }
+    else if (!bVisible && pNotebookBar->IsVisible())
+    {
+        m_bRibbonHidden = true;
+        pNotebookBar->Hide();
+        pNotebookBar->GetParent()->Resize();
+    }
+}
+
+void BackstageWindow::Open()
+{
+    if (m_bOpen)
+        return;
+    m_bOpen = true;
+
+    const int nHour = GetCurrentHour();
+    m_xGreeting->set_label(SfxResId(nHour < 12   ? STR_HST_BS_MORNING
+                                    : nHour < 18 ? STR_HST_BS_AFTERNOON
+                                                 : STR_HST_BS_EVENING));
+    FillRecentLists();
+    ShowPage(Page::Home);
+    m_xRecentTabs->set_current_page(0);
+
+    SetRibbonVisible(false);
+    LayoutToParent();
+    SetZOrder(nullptr, ZOrderFlags::First);
+    Show();
+    m_aNav[m_nSelectedNav].xButton->grab_focus();
+}
+
+void BackstageWindow::Close()
+{
+    if (!m_bOpen)
+        return;
+    m_bOpen = false;
+    Hide();
+    SetRibbonVisible(true);
+    // focus back to the document
+    for (SfxViewFrame* pFrame = SfxViewFrame::GetFirst(); pFrame; pFrame = SfxViewFrame::GetNext(*pFrame))
+    {
+        if (pFrame->GetFrame().GetFrameInterface() == m_xFrame)
+        {
+            if (SfxViewShell* pShell = pFrame->GetViewShell())
+                if (vcl::Window* pWin = pShell->GetWindow())
+                    pWin->GrabFocus();
+            break;
+        }
+    }
+}
+
+void BackstageWindow::CloseAndDispatch(const OUString& rCommand,
+                                       const uno::Sequence<beans::PropertyValue>& rArgs)
+{
+    uno::Reference<frame::XDispatchProvider> xProvider(m_xFrame, uno::UNO_QUERY);
+    Close();
+    lcl_dispatchAsync(xProvider, rCommand, OUString(), rArgs);
+}
+
+void BackstageWindow::OpenDocumentURL(const OUString& rURL, bool bAsTemplate)
+{
+    uno::Sequence<beans::PropertyValue> aArgs{
+        comphelper::makePropertyValue(u"Referer"_ustr, u"private:user"_ustr),
+        comphelper::makePropertyValue(u"AsTemplate"_ustr, bAsTemplate)
+    };
+    if (bAsTemplate)
+    {
+        aArgs = { comphelper::makePropertyValue(u"Referer"_ustr, u"private:user"_ustr),
+                  comphelper::makePropertyValue(u"AsTemplate"_ustr, true),
+                  comphelper::makePropertyValue(u"MacroExecutionMode"_ustr,
+                                                document::MacroExecMode::USE_CONFIG),
+                  comphelper::makePropertyValue(u"UpdateDocMode"_ustr,
+                                                document::UpdateDocMode::ACCORDING_TO_CONFIG) };
+    }
+    uno::Reference<frame::XDispatchProvider> xDesktop(
+        frame::Desktop::create(comphelper::getProcessComponentContext()), uno::UNO_QUERY);
+    Close();
+    lcl_dispatchAsync(xDesktop, rURL, u"_default"_ustr, aArgs);
+}
+
+void BackstageWindow::FocusNavItem(int nDelta)
+{
+    int nFocused = -1;
+    for (size_t i = 0; i < m_aNav.size(); ++i)
+        if (m_aNav[i].xButton->has_focus())
+            nFocused = i;
+    if (nFocused < 0)
+        return;
+    const int nCount = m_aNav.size();
+    int nNext = nDelta == INT_MIN ? 0 : nDelta == INT_MAX ? nCount - 1 : nFocused + nDelta;
+    nNext = std::clamp(nNext, 0, nCount - 1);
+    m_aNav[nNext].xButton->grab_focus();
+}
+
+bool BackstageWindow::IsNavFocused() const
+{
+    return std::any_of(m_aNav.begin(), m_aNav.end(),
+                       [](const NavItem& rItem) { return rItem.xButton->has_focus(); });
+}
+
+bool BackstageWindow::PreNotify(NotifyEvent& rNEvt)
+{
+    if (m_bOpen && rNEvt.GetType() == NotifyEventType::KEYINPUT)
+    {
+        const vcl::KeyCode& rKey = rNEvt.GetKeyEvent()->GetKeyCode();
+        const sal_uInt16 nCode = rKey.GetCode();
+        if (nCode == KEY_ESCAPE && !rKey.GetModifier())
+        {
+            Close();
+            return true;
+        }
+        if (!rKey.GetModifier() && IsNavFocused())
+        {
+            switch (nCode)
+            {
+                case KEY_UP:
+                    FocusNavItem(-1);
+                    return true;
+                case KEY_DOWN:
+                    FocusNavItem(1);
+                    return true;
+                case KEY_HOME:
+                    FocusNavItem(INT_MIN);
+                    return true;
+                case KEY_END:
+                    FocusNavItem(INT_MAX);
+                    return true;
+                case KEY_RIGHT:
+                {
+                    // into the page: the first tile on Home, else the page's first control
+                    if (m_ePage == Page::Home && !m_aTiles.empty())
+                        m_aTiles.front().xButton->grab_focus();
+                    else if (m_ePage == Page::Open)
+                        m_xOpenBrowse->grab_focus();
+                    else if (m_ePage == Page::SaveAs)
+                        m_xFormatList->grab_focus();
+                    else if (m_ePage == Page::Info)
+                        m_xInfoProperties->grab_focus();
+                    else if (m_ePage == Page::New)
+                        m_xNewBlank->grab_focus();
+                    return true;
+                }
+                default:
+                    break;
+            }
+        }
+        // tiles: left/right move between them, left from the first goes back to the navigation
+        if (!rKey.GetModifier() && (nCode == KEY_LEFT || nCode == KEY_RIGHT))
+        {
+            for (size_t i = 0; i < m_aTiles.size(); ++i)
+            {
+                if (!m_aTiles[i].xButton->has_focus())
+                    continue;
+                if (nCode == KEY_LEFT && i == 0)
+                    m_aNav[m_nSelectedNav].xButton->grab_focus();
+                else if (nCode == KEY_LEFT)
+                    m_aTiles[i - 1].xButton->grab_focus();
+                else if (i + 1 < m_aTiles.size() && m_aTiles[i + 1].xButton->get_visible())
+                    m_aTiles[i + 1].xButton->grab_focus();
+                return true;
+            }
+        }
+
+        // the frame's shortcuts (Alt+F closes this view, Ctrl+S saves, Ctrl+P prints...)
+        if (!m_xAccExec)
+        {
+            m_xAccExec = svt::AcceleratorExecute::createAcceleratorHelper();
+            m_xAccExec->init(comphelper::getProcessComponentContext(), m_xFrame);
+        }
+        const OUString aCommand
+            = m_xAccExec->findCommand(svt::AcceleratorExecute::st_VCLKey2AWTKey(rKey));
+        if (!aCommand.isEmpty() && rKey.GetModifier())
+        {
+            if (aCommand == BACKSTAGE_COMMAND)
+                Close();
+            else
+                CloseAndDispatch(aCommand);
+            return true;
+        }
+    }
+    return InterimItemWindow::PreNotify(rNEvt);
+}
+
+void BackstageWindow::DataChanged(const DataChangedEvent& rDCEvt)
+{
+    InterimItemWindow::DataChanged(rDCEvt);
+    if (rDCEvt.GetType() == DataChangedEventType::SETTINGS
+        && (rDCEvt.GetFlags() & AllSettingsFlags::STYLE))
+        ApplyColors();
+}
+
+IMPL_LINK(BackstageWindow, NavClickHdl, weld::Button&, rButton, void)
+{
+    OUString aId;
+    for (const NavItem& rItem : m_aNav)
+        if (rItem.xButton.get() == &rButton)
+            aId = rItem.aId;
+
+    if (aId == "navback")
+        Close();
+    else if (aId == "navhome")
+        ShowPage(Page::Home);
+    else if (aId == "navnew")
+        ShowPage(Page::New);
+    else if (aId == "navopen")
+        ShowPage(Page::Open);
+    else if (aId == "navinfo")
+        ShowPage(Page::Info);
+    else if (aId == "navsaveas")
+        ShowPage(Page::SaveAs);
+    else if (aId == "navsave")
+        CloseAndDispatch(u".uno:Save"_ustr);
+    else if (aId == "navprint")
+        CloseAndDispatch(u".uno:Print"_ustr);
+    else if (aId == "navpdf")
+        CloseAndDispatch(u".uno:ExportToPDF"_ustr);
+    else if (aId == "navsign")
+        CloseAndDispatch(u".uno:Signature"_ustr);
+    else if (aId == "navclose")
+        CloseAndDispatch(u".uno:CloseDoc"_ustr);
+    else if (aId == "navabout")
+        CloseAndDispatch(u".uno:About"_ustr);
+    else if (aId == "navoptions")
+        CloseAndDispatch(u".uno:OptionsTreeDialog"_ustr);
+}
+
+IMPL_LINK(BackstageWindow, TileClickHdl, weld::Button&, rButton, void)
+{
+    for (const TemplateTile& rTile : m_aTiles)
+    {
+        if (rTile.xButton.get() != &rButton)
+            continue;
+        if (rTile.eKind == BackstageTemplate::Kind::Command)
+            CloseAndDispatch(rTile.aTarget);
+        else
+            OpenDocumentURL(rTile.aTarget, rTile.eKind == BackstageTemplate::Kind::Template);
+        return;
+    }
+}
+
+IMPL_LINK_NOARG(BackstageWindow, MoreTemplatesHdl, weld::LinkButton&, bool)
+{
+    CloseAndDispatch(u".uno:NewDoc"_ustr);
+    return true;
+}
+
+IMPL_LINK(BackstageWindow, ButtonClickHdl, weld::Button&, rButton, void)
+{
+    if (&rButton == m_xNewBlank.get())
+        OpenDocumentURL(GetFactoryURL(m_eApp), false);
+    else if (&rButton == m_xNewNd30.get())
+        CloseAndDispatch(ND30_COMMAND);
+    else if (&rButton == m_xNewManage.get())
+        CloseAndDispatch(u".uno:NewDoc"_ustr);
+    else if (&rButton == m_xOpenBrowse.get())
+        CloseAndDispatch(u".uno:Open"_ustr);
+    else if (&rButton == m_xInfoProperties.get())
+        CloseAndDispatch(u".uno:SetDocumentProperties"_ustr);
+    else if (&rButton == m_xInfoSign.get())
+        CloseAndDispatch(u".uno:Signature"_ustr);
+    else if (&rButton == m_xSaveAsBrowse.get())
+        CloseAndDispatch(u".uno:SaveAs"_ustr);
+}
+
+IMPL_LINK(BackstageWindow, RecentActivatedHdl, const weld::TreeIter&, rIter, bool)
+{
+    for (weld::TreeView* pList : { m_xRecentList.get(), m_xPinnedList.get(), m_xOpenList.get() })
+    {
+        if (pList->get_visible() && pList->has_focus())
+        {
+            OpenDocumentURL(pList->get_id(rIter), false);
+            return true;
+        }
+    }
+    // activation by double click without focus change: use the selected row of the visible list
+    weld::TreeView* pList = m_ePage == Page::Open ? m_xOpenList.get()
+                            : m_xRecentTabs->get_current_page() == 1 ? m_xPinnedList.get()
+                                                                     : m_xRecentList.get();
+    OpenDocumentURL(pList->get_id(rIter), false);
+    return true;
+}
+
+weld::TreeView* BackstageWindow::GetActiveRecentList() const
+{
+    for (weld::TreeView* pList : { m_xRecentList.get(), m_xPinnedList.get(), m_xOpenList.get() })
+        if (pList->get_visible() && pList->has_focus())
+            return pList;
+    return m_ePage == Page::Open                 ? m_xOpenList.get()
+           : m_xRecentTabs->get_current_page() == 1 ? m_xPinnedList.get()
+                                                    : m_xRecentList.get();
+}
+
+void BackstageWindow::ShowRecentMenu(weld::TreeView& rList, const weld::TreeIter& rIter,
+                                     const tools::Rectangle& rRect)
+{
+    const OUString aURL = rList.get_id(rIter);
+    bool bPinned = false;
+    for (const BackstageRecentFile& rFile : GetRecentFiles())
+        if (rFile.aURL == aURL)
+            bPinned = rFile.bPinned;
+    m_xRecentMenu->set_visible(u"menupin"_ustr, !bPinned);
+    m_xRecentMenu->set_visible(u"menuunpin"_ustr, bPinned);
+
+    const OUString aAction = m_xRecentMenu->popup_at_rect(&rList, rRect);
+    if (aAction == "menuopen")
+        OpenDocumentURL(aURL, false);
+    else if (aAction == "menupin" || aAction == "menuunpin")
+    {
+        SvtHistoryOptions::TogglePinItem(EHistoryType::PickList, aURL);
+        FillRecentLists();
+    }
+    else if (aAction == "menuremove")
+    {
+        SvtHistoryOptions::DeleteItem(EHistoryType::PickList, aURL, false);
+        FillRecentLists();
+    }
+}
+
+IMPL_LINK(BackstageWindow, RecentCommandHdl, const CommandEvent&, rCEvt, bool)
+{
+    if (rCEvt.GetCommand() != CommandEventId::ContextMenu)
+        return false;
+    if (rCEvt.IsMouseEvent())
+    {
+        // this runs before the list's own handling of the press, which selects the clicked row:
+        // not handled here, the menu opens right after for the row selected by then
+        m_aPendingMenuPos = rCEvt.GetMousePosPixel();
+        if (m_pPendingMenu)
+            Application::RemoveUserEvent(m_pPendingMenu);
+        m_pPendingMenu = Application::PostUserEvent(LINK(this, BackstageWindow, RecentMenuHdl));
+        return false;
+    }
+    weld::TreeView* pList = GetActiveRecentList();
+    std::unique_ptr<weld::TreeIter> xIter = pList->get_cursor();
+    if (!xIter)
+        return false;
+    ShowRecentMenu(*pList, *xIter, pList->get_row_area(*xIter));
+    return true;
+}
+
+IMPL_LINK_NOARG(BackstageWindow, RecentMenuHdl, void*, void)
+{
+    m_pPendingMenu = nullptr;
+    weld::TreeView* pList = GetActiveRecentList();
+    std::unique_ptr<weld::TreeIter> xIter = pList->get_selected();
+    if (xIter)
+        ShowRecentMenu(*pList, *xIter, tools::Rectangle(m_aPendingMenuPos, Size(1, 1)));
+}
+
+IMPL_LINK(BackstageWindow, RecentTooltipHdl, const weld::TreeIter&, rIter, OUString)
+{
+    for (weld::TreeView* pList : { m_xRecentList.get(), m_xPinnedList.get(), m_xOpenList.get() })
+        if (pList->get_visible())
+        {
+            const OUString aURL = pList->get_id(rIter);
+            return GetDisplayPath(aURL);
+        }
+    return OUString();
+}
+
+IMPL_LINK(BackstageWindow, FormatActivatedHdl, const weld::TreeIter&, rIter, bool)
+{
+    m_aPendingFilter = m_xFormatList->get_id(rIter);
+    Close();
+    if (m_pPendingSaveAs)
+        Application::RemoveUserEvent(m_pPendingSaveAs);
+    m_pPendingSaveAs = Application::PostUserEvent(LINK(this, BackstageWindow, SaveAsFormatHdl));
+    return true;
+}
+
+IMPL_LINK_NOARG(BackstageWindow, SaveAsFormatHdl, void*, void)
+{
+    m_pPendingSaveAs = nullptr;
+    const OUString aFilterName = m_aPendingFilter;
+    std::shared_ptr<const SfxFilter> pFilter = SfxFilter::GetFilterByName(aFilterName);
+    if (!pFilter || !m_xFrame.is())
+        return;
+
+    BackstageDocumentInfo aInfo = GetDocumentInfo(m_xFrame, false);
+    const OUString aExtension = pFilter->GetDefaultExtension().replaceFirst("*.", "");
+    sfx2::FileDialogHelper aDialog(ui::dialogs::TemplateDescription::FILESAVE_AUTOEXTENSION,
+                                   FileDialogFlags::NONE, GetFrameWeld());
+    aDialog.AddFilter(pFilter->GetUIName(), pFilter->GetWildcard().getGlob());
+    aDialog.SetCurrentFilter(pFilter->GetUIName());
+    if (!aInfo.aFolderURL.isEmpty())
+        aDialog.SetDisplayFolder(aInfo.aFolderURL);
+    aDialog.SetFileName(aInfo.aBaseName + "." + aExtension);
+    if (aDialog.Execute() != ERRCODE_NONE)
+        return;
+
+    uno::Reference<frame::XDispatchProvider> xProvider(m_xFrame, uno::UNO_QUERY);
+    lcl_dispatchAsync(xProvider, u".uno:SaveAs"_ustr, OUString(),
+                      { comphelper::makePropertyValue(u"URL"_ustr, aDialog.GetPath()),
+                        comphelper::makePropertyValue(u"FilterName"_ustr, aFilterName) });
+}
+
+IMPL_LINK(BackstageWindow, OpenTemplateHdl, const OUString&, rTemplateURL, void)
+{
+    OpenDocumentURL(rTemplateURL, true);
+}
+
+IMPL_LINK(BackstageWindow, ParentEventHdl, VclWindowEvent&, rEvent, void)
+{
+    if (rEvent.GetId() == VclEventId::ObjectDying)
+    {
+        // normally gone already (FrameDisposeListener); nothing may touch the dying parent
+        m_xParent->RemoveEventListener(LINK(this, BackstageWindow, ParentEventHdl));
+        m_bRibbonHidden = false;
+        m_xParent.reset();
+    }
+    else if (rEvent.GetId() == VclEventId::WindowResize && m_bOpen)
+        LayoutToParent();
+}
+}
