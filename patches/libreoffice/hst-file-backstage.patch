+vcl::Window* lcl_containerWindow(const uno::Reference<frame::XFrame>& rxFrame)
+{
+    return rxFrame.is() ? VCLUnoHelper::GetWindow(rxFrame->getContainerWindow()) : nullptr;
+}
+
+/// The backstage child of the frame's container window, if it was created already.
+BackstageWindow* lcl_findBackstage(vcl::Window* pContainer)
+{
+    if (!pContainer)
+        return nullptr;
+    for (vcl::Window* pChild = pContainer->GetWindow(GetWindowType::FirstChild); pChild;
+         pChild = pChild->GetWindow(GetWindowType::Next))
+    {
+        if (auto* pBackstage = dynamic_cast<BackstageWindow*>(pChild))
+            if (!pBackstage->isDisposed())
+                return pBackstage;
+    }
+    return nullptr;
+}
+
+/// The frame of a ribbon widget. The ribbon is a child of the border window around the frame's
+/// container window, not of the container window, so GetSystemWindow() does not reach it.
+uno::Reference<frame::XFrame> lcl_frameOfRibbonWidget(const vcl::Window* pWindow)
+{
+    for (SfxViewFrame* pFrame = SfxViewFrame::GetFirst(); pWindow && pFrame;
+         pFrame = SfxViewFrame::GetNext(*pFrame))
+    {
+        uno::Reference<frame::XFrame> xFrame = pFrame->GetFrame().GetFrameInterface();
+        vcl::Window* pContainer = lcl_containerWindow(xFrame);
+        vcl::Window* pBorder = pContainer ? pContainer->GetWindow(GetWindowType::Border) : nullptr;
+        if (pBorder && pBorder->IsWindowOrChild(pWindow))
+            return xFrame;
+    }
+    return nullptr;
+}
+
+void lcl_openBackstageAsync(void*, void* pArg)
+{
+    std::unique_ptr<uno::WeakReference<frame::XFrame>> xWeak(
+        static_cast<uno::WeakReference<frame::XFrame>*>(pArg));
+    uno::Reference<frame::XFrame> xFrame(*xWeak);
+    vcl::Window* pContainer = lcl_containerWindow(xFrame);
+    BackstageWindow* pBackstage = lcl_findBackstage(pContainer);
+    if (pContainer && !(pBackstage && pBackstage->IsOpen()))
+        ToggleBackstage(xFrame);
+}
+
+/* The ribbon's File tab: TabControl::SelectTabPage (user selection only: click, keyboard,
+   access key, wheel) reports TabpageDeactivate with the old page, then TabpageActivate with the
+   new one. When the new page is the File tab ("FileLabel" in the Writer, Calc and Impress
+   notebookbar .ui files) the previous tab is selected again and the File view opens.
+   Scrolling the wheel over the tabs (the pointer is over the tab strip, not on the File tab)
+   only skips the File tab. */
+sal_uInt16 g_nPrevPageId = 0;
+
+void lcl_tabEvent(void*, VclSimpleEvent& rEvent)
+{
+    const VclEventId nId = rEvent.GetId();
+    if (nId != VclEventId::TabpageDeactivate && nId != VclEventId::TabpageActivate)
+        return;
+    auto* pTabs = dynamic_cast<NotebookbarTabControlBase*>(
+        static_cast<VclWindowEvent&>(rEvent).GetWindow());
+    if (!pTabs)
+        return;
+    const sal_uInt16 nPageId
+        = static_cast<sal_uInt16>(reinterpret_cast<sal_uIntPtr>(static_cast<VclWindowEvent&>(rEvent).GetData()));
+    if (nId == VclEventId::TabpageDeactivate)
+    {
+        g_nPrevPageId = nPageId;
+        return;
+    }
+    const sal_uInt16 nPrev = g_nPrevPageId;
+    g_nPrevPageId = 0;
+    if (!nPrev || nPrev == nPageId || pTabs->GetPageName(nPageId) != "FileLabel")
+        return;
+
+    const Point aPointer = pTabs->GetPointerPosPixel();
+    const bool bOnFileTab = pTabs->GetTabBounds(nPageId).Contains(aPointer);
+    const bool bOverTabs = tools::Rectangle(Point(), pTabs->GetOutputSizePixel()).Contains(aPointer);
+    pTabs->SelectTabPage(nPrev);
+    if (bOverTabs && !bOnFileTab)
+        return; // the wheel over the tab strip
+
+    uno::Reference<frame::XFrame> xFrame = lcl_frameOfRibbonWidget(pTabs);
+    if (!xFrame.is())
+        return;
+    std::unique_ptr<uno::WeakReference<frame::XFrame>> xWeak(new uno::WeakReference<frame::XFrame>(xFrame));
+    if (Application::PostUserEvent(LINK_NONMEMBER(nullptr, lcl_openBackstageAsync), xWeak.get()))
+        xWeak.release();
+}
+
+/// .uno:HSTBackstage of one frame: opens or closes the File view; always enabled.
+class BackstageDispatch final : public cppu::WeakImplHelper<frame::XDispatch>
+{
+    uno::WeakReference<frame::XFrame> m_xFrame;
+
+public:
+    explicit BackstageDispatch(const uno::Reference<frame::XFrame>& rxFrame)
+        : m_xFrame(rxFrame)
+    {
+    }
+
+    void SAL_CALL dispatch(const util::URL&, const uno::Sequence<beans::PropertyValue>&) override
+    {
+        SolarMutexGuard aGuard;
+        ToggleBackstage(uno::Reference<frame::XFrame>(m_xFrame));
+    }
+
+    void SAL_CALL addStatusListener(const uno::Reference<frame::XStatusListener>& rxListener,
+                                    const util::URL& rURL) override
+    {
+        if (!rxListener.is())
+            return;
+        frame::FeatureStateEvent aEvent;
+        aEvent.FeatureURL = rURL;
+        aEvent.IsEnabled = true;
+        aEvent.Source = getXWeak();
+        rxListener->statusChanged(aEvent);
+    }
+
+    void SAL_CALL removeStatusListener(const uno::Reference<frame::XStatusListener>&,
+                                       const util::URL&) override
+    {
+    }
+};
+}
+
+void ToggleBackstage(const uno::Reference<frame::XFrame>& rxFrame)
+{
+    vcl::Window* pContainer = lcl_containerWindow(rxFrame);
+    if (!pContainer)
+        return;
+    BackstageWindow* pBackstage = lcl_findBackstage(pContainer);
+    if (pBackstage && pBackstage->IsOpen())
+    {
+        pBackstage->Close();
+        return;
+    }
+    if (pBackstage && pBackstage->ShowsCurrentDocument())
+    {
+        pBackstage->Open();
+        return;
+    }
+    if (pBackstage)
+        pBackstage->disposeOnce();
+    // created on first use; the container window keeps it (and disposes it with the frame)
+    VclPtr<BackstageWindow> xNew = VclPtr<BackstageWindow>::Create(pContainer, rxFrame);
+    xNew->Open();
+}
+
+void InstallFileTabHandler()
+{
+    static bool bInstalled = false;
+    if (bInstalled)
+        return;
+    bInstalled = true;
+    Application::AddEventListener(LINK_NONMEMBER(nullptr, lcl_tabEvent));
+}
+
+bool CloseBackstage(const uno::Reference<frame::XFrame>& rxFrame)
+{
+    BackstageWindow* pBackstage = lcl_findBackstage(lcl_containerWindow(rxFrame));
+    if (!pBackstage || !pBackstage->IsOpen())
+        return false;
+    pBackstage->Close();
+    return true;
+}
+
+uno::Reference<frame::XDispatch> CreateBackstageDispatch(const uno::Reference<frame::XFrame>& rxFrame)
+{
+    return new BackstageDispatch(rxFrame);
+}
+}
