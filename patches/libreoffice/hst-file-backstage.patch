+/* HST Office: the full-window "File" view (backstage).
+
+   The view is a child window that covers the client area of the document's frame window while
+   the ribbon is hidden; it is created on first use only (no startup cost) and reused afterwards.
+   It opens from the ribbon's File tab and from the .uno:HSTBackstage command (Alt+F); Esc, the
+   back button and the command itself return to the document. */
+namespace sfx2::hst
+{
+inline constexpr OUString BACKSTAGE_COMMAND = u".uno:HSTBackstage"_ustr;
+
+/// Open the view over the given frame, or close it when it is open.
+void ToggleBackstage(const css::uno::Reference<css::frame::XFrame>& rxFrame);
+
+/// Close the view of this frame if it is open; returns whether it was open.
+bool CloseBackstage(const css::uno::Reference<css::frame::XFrame>& rxFrame);
+
+/** Make the ribbon's File tab open the view (once per process; cheap: one application event
+    listener that reacts to tab page activations of notebookbar tab controls only). */
+void InstallFileTabHandler();
+
+/// Dispatch object for .uno:HSTBackstage on this frame (see SfxBaseController::queryDispatch).
+css::uno::Reference<css::frame::XDispatch>
+CreateBackstageDispatch(const css::uno::Reference<css::frame::XFrame>& rxFrame);
+}
