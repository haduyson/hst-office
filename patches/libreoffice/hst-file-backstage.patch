+/// Paint the page preview of a "create new" tile: a page with a thin border; the
+/// administrative document also shows the national motto heading.
+void lcl_paintTile(VirtualDevice& rDev, bool bNd30, bool bBlank)
+{
+    const StyleSettings& rStyle = Application::GetSettings().GetStyleSettings();
+    const bool bDark = rStyle.GetWindowColor().IsDark();
+    rDev.SetOutputSizePixel(Size(TILE_WIDTH, TILE_HEIGHT));
+    rDev.SetBackground(Wallpaper(rStyle.GetWindowColor()));
+    rDev.Erase();
+    // the page stays white in dark mode (it is the paper), with a softer border
+    rDev.SetLineColor(bDark ? Color(0x5f, 0x63, 0x68) : Color(0xcf, 0xd6, 0xe0));
+    rDev.SetFillColor(bBlank ? COL_WHITE : Color(0xf7, 0xf8, 0xfa));
+    rDev.DrawRect(tools::Rectangle(Point(0, 0), Size(TILE_WIDTH, TILE_HEIGHT)));
+    if (bNd30)
+    {
+        vcl::Font aFont(rStyle.GetAppFont());
+        aFont.SetFontHeight(7);
+        aFont.SetWeight(WEIGHT_BOLD);
+        aFont.SetColor(Color(0x1d, 0x24, 0x33));
+        rDev.SetFont(aFont);
+        rDev.SetTextColor(Color(0x1d, 0x24, 0x33));
+        const OUString aLine1(u"CỘNG HÒA XÃ HỘI"_ustr);
+        const OUString aLine2(u"CHỦ NGHĨA VIỆT NAM"_ustr);
+        const tools::Long nH = rDev.GetTextHeight();
+        rDev.DrawText(Point((TILE_WIDTH - rDev.GetTextWidth(aLine1)) / 2, 22), aLine1);
+        rDev.DrawText(Point((TILE_WIDTH - rDev.GetTextWidth(aLine2)) / 2, 22 + nH), aLine2);
+        rDev.SetLineColor(Color(0x1d, 0x24, 0x33));
+        rDev.DrawLine(Point(TILE_WIDTH / 2 - 22, 26 + 2 * nH), Point(TILE_WIDTH / 2 + 22, 26 + 2 * nH));
+        // text lines of the body
+        rDev.SetLineColor(Color(0xcf, 0xd6, 0xe0));
+        for (tools::Long y = 60; y < TILE_HEIGHT - 20; y += 9)
+            rDev.DrawLine(Point(16, y), Point(TILE_WIDTH - 16, y));
+    }
+}
+}
