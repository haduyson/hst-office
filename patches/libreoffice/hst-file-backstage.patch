+std::vector<OUString> lcl_templateFolders()
+{
+    std::vector<OUString> aFolders;
+    try
+    {
+        const uno::Reference<uno::XComponentContext>& xContext
+            = comphelper::getProcessComponentContext();
+        uno::Reference<util::XPathSettings> xPaths = util::thePathSettings::get(xContext);
+        for (const auto& rProperty : { u"Template_internal"_ustr, u"Template_user"_ustr })
+        {
+            uno::Sequence<OUString> aList;
+            xPaths->getPropertyValue(rProperty) >>= aList;
+            for (const OUString& rFolder : aList)
+                aFolders.push_back(comphelper::getExpandedUri(xContext, rFolder));
+        }
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("sfx.backstage", "reading the template folders");
+    }
+    return aFolders;
+}
+
+OUString lcl_findTemplate(const std::vector<OUString>& rFolders, std::u16string_view aFolder,
+                          std::u16string_view aFile)
+{
+    for (const OUString& rBase : rFolders)
+    {
+        OUString aURL = rBase + (rBase.endsWith("/") ? u"" : u"/") + aFolder + u"/" + aFile;
+        if (lcl_fileExists(aURL))
+            return aURL;
+    }
+    return OUString();
+}
+
+bool lcl_stat(const OUString& rURL, sal_uInt32 nMask, osl::FileStatus& rStatus)
+{
+    osl::DirectoryItem aItem;
+    return rURL.startsWithIgnoreAsciiCase("file:")
+           && osl::DirectoryItem::get(rURL, aItem) == osl::FileBase::E_None
+           && aItem.getFileStatus(rStatus) == osl::FileBase::E_None && rStatus.isValid(nMask);
+}
+
+DateTime lcl_toLocalDateTime(const TimeValue& rUTC)
+{
+    TimeValue aLocal;
+    oslDateTime aDT;
+    if (!osl_getLocalTimeFromSystemTime(&rUTC, &aLocal) || !osl_getDateTimeFromTimeValue(&aLocal, &aDT))
+        return DateTime(DateTime::EMPTY);
+    return DateTime(Date(aDT.Day, aDT.Month, aDT.Year),
+                    tools::Time(aDT.Hours, aDT.Minutes, aDT.Seconds));
+}
+
+OUString lcl_twoDigits(sal_Int32 n) { return (n < 10 ? u"0"_ustr : OUString()) + OUString::number(n); }
+
+OUString lcl_formatDate(const Date& rDate)
+{
+    return lcl_twoDigits(rDate.GetDay()) + "/" + lcl_twoDigits(rDate.GetMonth()) + "/"
+           + OUString::number(rDate.GetYear());
+}
+
+OUString lcl_formatTime(const tools::Time& rTime)
+{
+    return lcl_twoDigits(rTime.GetHour()) + ":" + lcl_twoDigits(rTime.GetMin());
+}
+
+OUString lcl_formatDateTime(const util::DateTime& rDT)
+{
+    if (rDT.Year == 0)
+        return OUString();
+    return lcl_formatDate(Date(rDT.Day, rDT.Month, rDT.Year)) + " "
+           + lcl_formatTime(tools::Time(rDT.Hours, rDT.Minutes, rDT.Seconds));
+}
+
+/// "Documents › Reports": the last two folders of the file's location.
+OUString lcl_shortLocation(const OUString& rURL)
+{
+    INetURLObject aURL(rURL);
+    if (aURL.GetProtocol() != INetProtocol::File)
+        return aURL.GetHost(INetURLObject::DecodeMechanism::WithCharset);
+    aURL.removeSegment();
+    std::vector<OUString> aParts;
+    for (sal_Int32 n = aURL.getSegmentCount(); n > 0 && aParts.size() < 2; --n)
+    {
+        OUString aName = aURL.getName(n - 1, true, INetURLObject::DecodeMechanism::WithCharset);
+        if (!aName.isEmpty())
+            aParts.insert(aParts.begin(), aName);
+    }
+    OUStringBuffer aBuf;
+    for (const OUString& rPart : aParts)
+    {
+        if (!aBuf.isEmpty())
+            aBuf.append(u" › ");
+        aBuf.append(rPart);
+    }
+    return aBuf.makeStringAndClear();
+}
+
+OUString lcl_formatSize(sal_uInt64 nBytes)
+{
+    if (nBytes < 1024)
+        return OUString::number(nBytes) + " B";
+    const double fKB = nBytes / 1024.0;
+    if (fKB < 1024)
+        return OUString::number(static_cast<sal_Int64>(fKB + 0.5)) + " KB";
+    const double fMB = fKB / 1024.0;
+    // one decimal with the Vietnamese/HST decimal comma
+    const sal_Int64 nTenths = static_cast<sal_Int64>(fMB * 10 + 0.5);
+    return OUString::number(nTenths / 10) + "," + OUString::number(nTenths % 10) + " MB";
+}
+}
+
+OUString GetFactoryURL(BackstageApp eApp)
+{
+    switch (eApp)
+    {
+        case BackstageApp::Calc:
+            return u"private:factory/scalc"_ustr;
+        case BackstageApp::Impress:
+            return u"private:factory/simpress"_ustr;
+        case BackstageApp::Other:
+            return u"private:factory/sdraw"_ustr;
+        case BackstageApp::Writer:
+            break;
+    }
+    return u"private:factory/swriter"_ustr;
+}
+
+std::vector<BackstageTemplate> GetNewDocumentChoices(BackstageApp eApp)
+{
+    std::vector<BackstageTemplate> aChoices;
+    aChoices.push_back({ SfxResId(eApp == BackstageApp::Calc      ? STR_HST_BS_BLANK_CALC
+                                  : eApp == BackstageApp::Impress ? STR_HST_BS_BLANK_IMPRESS
+                                                                  : STR_HST_BS_BLANK_WRITER),
+                         GetFactoryURL(eApp), BackstageTemplate::Kind::Factory });
+    if (eApp == BackstageApp::Writer)
+        aChoices.push_back(
+            { SfxResId(STR_HST_BS_ND30), ND30_COMMAND, BackstageTemplate::Kind::Command });
+
+    const std::vector<OUString> aFolders = lcl_templateFolders();
+    for (const HstTemplateFile& rTemplate : aHstTemplates)
+    {
+        if (rTemplate.eApp != eApp)
+            continue;
+        OUString aURL = lcl_findTemplate(aFolders, rTemplate.aFolder, rTemplate.aFile);
+        if (!aURL.isEmpty())
+            aChoices.push_back({ SfxResId(rTemplate.aTitle), aURL, BackstageTemplate::Kind::Template });
+    }
+    return aChoices;
+}
+
+OUString FormatRecentDate(const DateTime& rWhen, const DateTime& rNow)
+{
+    if (rWhen.IsEmpty())
+        return OUString();
+    const Date aDay(rWhen.GetDate());
+    if (aDay == Date(rNow.GetDate()))
+        return SfxResId(STR_HST_BS_TODAY).replaceFirst("%1", lcl_formatTime(rWhen));
+    Date aYesterday(rNow.GetDate());
+    aYesterday.AddDays(-1);
+    if (aDay == aYesterday)
+        return SfxResId(STR_HST_BS_YESTERDAY);
+    return lcl_formatDate(aDay);
+}
+
+std::vector<BackstageRecentFile> GetRecentFiles()
+{
+    std::vector<BackstageRecentFile> aFiles;
+    const DateTime aNow(DateTime::SYSTEM);
+    for (const SvtHistoryOptions::HistoryItem& rItem : SvtHistoryOptions::GetList(EHistoryType::PickList))
+    {
+        if (rItem.sURL.isEmpty())
+            continue;
+        INetURLObject aURL(rItem.sURL);
+        BackstageRecentFile aFile;
+        aFile.aURL = rItem.sURL;
+        aFile.aName = aURL.getName(INetURLObject::LAST_SEGMENT, true,
+                                   INetURLObject::DecodeMechanism::WithCharset);
+        if (aFile.aName.isEmpty())
+            aFile.aName = rItem.sTitle;
+        aFile.aLocation = lcl_shortLocation(rItem.sURL);
+        aFile.aIcon = SvFileInformationManager::GetImageId(aURL, false);
+        aFile.bPinned = rItem.isPinned;
+        osl::FileStatus aStatus(osl_FileStatus_Mask_ModifyTime);
+        if (lcl_stat(rItem.sURL, osl_FileStatus_Mask_ModifyTime, aStatus))
+            aFile.aDate = FormatRecentDate(lcl_toLocalDateTime(aStatus.getModifyTime()), aNow);
+        aFiles.push_back(std::move(aFile));
+    }
+    // pinned files first (as in the Start Center), each group in history order
+    std::stable_partition(aFiles.begin(), aFiles.end(),
+                          [](const BackstageRecentFile& rFile) { return rFile.bPinned; });
+    return aFiles;
+}
+
+OUString GetDisplayPath(const OUString& rURL)
+{
+    OUString aPath;
+    if (rURL.startsWithIgnoreAsciiCase("file:")
+        && osl::FileBase::getSystemPathFromFileURL(rURL, aPath) == osl::FileBase::E_None)
+        return aPath;
+    return INetURLObject(rURL).GetMainURL(INetURLObject::DecodeMechanism::WithCharset);
+}
+
+BackstageDocumentInfo GetDocumentInfo(const uno::Reference<frame::XFrame>& rxFrame, bool bWithSignature)
+{
+    BackstageDocumentInfo aInfo;
+    try
+    {
+        uno::Reference<frame::XController> xController(rxFrame.is() ? rxFrame->getController() : nullptr);
+        uno::Reference<frame::XModel> xModel(xController.is() ? xController->getModel() : nullptr);
+        SfxObjectShell* pShell = SfxObjectShell::GetShellFromComponent(xModel);
+        if (!xModel.is() || !pShell)
+            return aInfo;
+
+        const OUString aURL = xModel->getURL();
+        if (!aURL.isEmpty())
+        {
+            INetURLObject aObj(aURL);
+            aInfo.aName = aObj.getName(INetURLObject::LAST_SEGMENT, true,
+                                       INetURLObject::DecodeMechanism::WithCharset);
+            aInfo.aBaseName = aObj.getBase(INetURLObject::LAST_SEGMENT, true,
+                                           INetURLObject::DecodeMechanism::WithCharset);
+            INetURLObject aFolder(aObj);
+            aFolder.removeSegment();
+            aInfo.aFolderURL = aFolder.GetMainURL(INetURLObject::DecodeMechanism::NONE);
+            aInfo.aFolder = GetDisplayPath(aInfo.aFolderURL);
+            osl::FileStatus aStatus(osl_FileStatus_Mask_FileSize);
+            if (lcl_stat(aURL, osl_FileStatus_Mask_FileSize, aStatus))
+                aInfo.aSize = lcl_formatSize(aStatus.getFileSize());
+        }
+        else
+        {
+            aInfo.aName = pShell->GetTitle();
+            aInfo.aBaseName = aInfo.aName;
+        }
+
+        // an unsaved document has no file type yet
+        if (SfxMedium* pMedium = aURL.isEmpty() ? nullptr : pShell->GetMedium())
+            if (std::shared_ptr<const SfxFilter> pFilter = pMedium->GetFilter())
+                aInfo.aType = pFilter->GetUIName();
+
+        uno::Reference<document::XDocumentPropertiesSupplier> xSupplier(xModel, uno::UNO_QUERY);
+        if (xSupplier.is())
+        {
+            uno::Reference<document::XDocumentProperties> xProps = xSupplier->getDocumentProperties();
+            aInfo.aCreated = lcl_formatDateTime(xProps->getCreationDate());
+            aInfo.aModified = lcl_formatDateTime(xProps->getModificationDate());
+            aInfo.aAuthor = xProps->getAuthor();
+            if (aInfo.aAuthor.isEmpty())
+                aInfo.aAuthor = xProps->getModifiedBy();
+        }
+
+        if (bWithSignature)
+        {
+            TranslateId aState;
+            switch (pShell->GetDocumentSignatureState())
+            {
+                case SignatureState::OK:
+                    aState = STR_HST_BS_SIG_OK;
+                    break;
+                case SignatureState::NOTVALIDATED:
+                    aState = STR_HST_BS_SIG_NOTVALIDATED;
+                    break;
+                case SignatureState::PARTIAL_OK:
+                case SignatureState::NOTVALIDATED_PARTIAL_OK:
+                    aState = STR_HST_BS_SIG_PARTIAL;
+                    break;
+                case SignatureState::BROKEN:
+                case SignatureState::INVALID:
+                    aState = STR_HST_BS_SIG_BROKEN;
+                    break;
+                default:
+                    aState = STR_HST_BS_SIG_NONE;
+                    break;
+            }
+            aInfo.aSignature = SfxResId(aState);
+        }
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("sfx.backstage", "reading the document information");
+    }
+    return aInfo;
+}
+
+std::vector<BackstageFormat> GetSaveFormats(BackstageApp eApp)
+{
+    std::vector<BackstageFormat> aFormats;
+    const SvtModuleOptions::EFactory eFactory
+        = eApp == BackstageApp::Writer    ? SvtModuleOptions::EFactory::WRITER
+          : eApp == BackstageApp::Calc    ? SvtModuleOptions::EFactory::CALC
+          : eApp == BackstageApp::Impress ? SvtModuleOptions::EFactory::IMPRESS
+                                          : SvtModuleOptions::EFactory::DRAW;
+    const OUString aDefault = SvtModuleOptions().GetFactoryDefaultFilter(eFactory);
+    for (const SaveFormat& rFormat : aSaveFormats)
+    {
+        if (rFormat.eApp != eApp || !SfxFilter::GetFilterByName(rFormat.aFilter))
+            continue;
+        OUString aLabel = SfxResId(rFormat.aLabel);
+        if (rFormat.aFilter == aDefault) // the format Save uses for new documents
+            aLabel = SfxResId(STR_HST_BS_DEFAULT_FORMAT).replaceFirst("%1", aLabel);
+        aFormats.push_back({ rFormat.aFilter, aLabel });
+    }
+    return aFormats;
+}
+
+int GetCurrentHour() { return DateTime(DateTime::SYSTEM).GetHour(); }
+}
