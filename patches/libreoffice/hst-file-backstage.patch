+double lcl_luminance(const Color& rColor)
+{
+    auto lin = [](sal_uInt8 c) {
+        double v = c / 255.0;
+        return v <= 0.03928 ? v / 12.92 : std::pow((v + 0.055) / 1.055, 2.4);
+    };
+    return 0.2126 * lin(rColor.GetRed()) + 0.7152 * lin(rColor.GetGreen())
+           + 0.0722 * lin(rColor.GetBlue());
+}
+
+/// The application colour, darkened until white text on it has at least a 4.5:1 contrast (WCAG AA).
+Color lcl_navColor(BackstageApp eApp)
+{
+    Color aBase = eApp == BackstageApp::Writer    ? WRITER_COLOR
+                  : eApp == BackstageApp::Calc    ? CALC_COLOR
+                  : eApp == BackstageApp::Impress ? IMPRESS_COLOR
+                                                  : OTHER_COLOR;
+    for (double fFactor = 1.0; fFactor > 0.3; fFactor -= 0.02)
+    {
+        Color aColor(static_cast<sal_uInt8>(aBase.GetRed() * fFactor),
+                     static_cast<sal_uInt8>(aBase.GetGreen() * fFactor),
+                     static_cast<sal_uInt8>(aBase.GetBlue() * fFactor));
+        if (1.05 / (lcl_luminance(aColor) + 0.05) >= 4.5)
+            return aColor;
+    }
+    return aBase;
+}
