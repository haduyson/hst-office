+struct DelayedDispatch
+{
+    uno::Reference<frame::XDispatch> xDispatch;
+    util::URL aURL;
+    uno::Sequence<beans::PropertyValue> aArgs;
+};
+
+void lcl_runDelayedDispatch(void*, void* pArg)
+{
+    std::unique_ptr<DelayedDispatch> pDispatch(static_cast<DelayedDispatch*>(pArg));
+    try
+    {
+        pDispatch->xDispatch->dispatch(pDispatch->aURL, pDispatch->aArgs);
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("sfx.backstage", "dispatching " << pDispatch->aURL.Complete);
+    }
+}
+
+/// Dispatch rURL through rxProvider after the current event has been handled.
+void lcl_dispatchAsync(const uno::Reference<frame::XDispatchProvider>& rxProvider,
+                       const OUString& rURL, const OUString& rTarget,
+                       const uno::Sequence<beans::PropertyValue>& rArgs)
+{
+    if (!rxProvider.is())
+        return;
+    try
+    {
+        util::URL aURL;
+        aURL.Complete = rURL;
+        util::URLTransformer::create(comphelper::getProcessComponentContext())->parseStrict(aURL);
+        uno::Reference<frame::XDispatch> xDispatch = rxProvider->queryDispatch(aURL, rTarget, 0);
+        if (!xDispatch.is())
+        {
+            SAL_WARN("sfx.backstage", "no dispatch for " << rURL);
+            return;
+        }
+        std::unique_ptr<DelayedDispatch> pDispatch(new DelayedDispatch{ xDispatch, aURL, rArgs });
+        if (Application::PostUserEvent(LINK_NONMEMBER(nullptr, lcl_runDelayedDispatch),
+                                       pDispatch.get()))
+            pDispatch.release();
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("sfx.backstage", "dispatching " << rURL);
+    }
+}
