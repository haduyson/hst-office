+BackstageApp lcl_detectApp(const uno::Reference<frame::XFrame>& rxFrame)
+{
+    try
+    {
+        uno::Reference<frame::XController> xController(rxFrame->getController());
+        uno::Reference<lang::XServiceInfo> xInfo(
+            xController.is() ? xController->getModel() : nullptr, uno::UNO_QUERY);
+        if (xInfo.is())
+        {
+            if (xInfo->supportsService(u"com.sun.star.text.TextDocument"_ustr))
+                return BackstageApp::Writer;
+            if (xInfo->supportsService(u"com.sun.star.sheet.SpreadsheetDocument"_ustr))
+                return BackstageApp::Calc;
+            if (xInfo->supportsService(u"com.sun.star.presentation.PresentationDocument"_ustr))
+                return BackstageApp::Impress;
+        }
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("sfx.backstage", "detecting the document type");
+    }
+    return BackstageApp::Other;
+}
