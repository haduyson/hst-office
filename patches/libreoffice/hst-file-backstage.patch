+// HST Office application colours, the same as the ribbon tint of NotebookBar::UpdateBackground()
+constexpr Color WRITER_COLOR(0x1a, 0x85, 0xd1);
+constexpr Color CALC_COLOR(0x3c, 0xbc, 0x45);
+constexpr Color IMPRESS_COLOR(0xe7, 0x57, 0x29);
+constexpr Color OTHER_COLOR(0x5b, 0x6b, 0x7f);
+
+constexpr tools::Long NAV_ITEM_HEIGHT = 44;
+constexpr tools::Long NAV_TEXT_INDENT = 24;
+constexpr tools::Long TILE_WIDTH = 150;
