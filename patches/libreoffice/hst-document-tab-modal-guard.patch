+
+#pragma once
+
+#include <vcl/vclptr.hxx>
+#include <vcl/window.hxx>
+
+#include <vector>
+
+namespace framework::documenttabmodal
+{
+/** HST Office: the tab window (a document's top-level WorkWindow) has a modal dialog running on it.
+
+    vcl counts the dialogs executed on a frame window (Dialog::ImplSetModalInputMode increments the
+    modal count of the dialog parent's frame window). Such a window must stay on screen: on macOS a
+    dialog is a child window of its parent, so hiding (parking) the tab window took the running
+    dialog off screen with it while it still blocked the office (frozen application, user report on
+    HST Office 1.0.2). */
+inline bool ownsModalDialog(const vcl::Window* pWindow)
+{
+    return pWindow && !pWindow->isDisposed() && pWindow->IsInModalMode();
+}
+
+/// One of the windows (the tabs of one tab window) has a modal dialog running on it.
+inline bool anyOwnsModalDialog(const std::vector<VclPtr<vcl::Window>>& rWindows)
+{
+    for (const VclPtr<vcl::Window>& pWindow : rWindows)
+        if (ownsModalDialog(pWindow.get()))
+            return true;
+    return false;
+}
+}
