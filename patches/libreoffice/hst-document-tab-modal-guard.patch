+
+// HST Office: the document tab group never parks (hides) a tab window that has a modal dialog
+// running on it, and opens a new document in a window of its own meanwhile. The decision reads
+// vcl's modal bookkeeping through documenttabmodal.hxx; this test drives that bookkeeping the way
+// Dialog::ImplSetModalInputMode does (IncModalCount on the dialog parent's frame window).
+
+#include <cppunit/TestAssert.h>
+#include <cppunit/extensions/HelperMacros.h>
+#include <test/bootstrapfixture.hxx>
+#include <vcl/svapp.hxx>
+#include <vcl/wrkwin.hxx>
+
+#include <documenttabmodal.hxx>
+
+using framework::documenttabmodal::anyOwnsModalDialog;
+using framework::documenttabmodal::ownsModalDialog;
+
+namespace
+{
+class HstDocumentTabModalTest : public test::BootstrapFixture
+{
+public:
+    void testModalDialogOnTheTab();
+    void testModalDialogOfAWindowOwnedByTheTab();
+    void testNoWindowOrDisposed();
+
+    CPPUNIT_TEST_SUITE(HstDocumentTabModalTest);
+    CPPUNIT_TEST(testModalDialogOnTheTab);
+    CPPUNIT_TEST(testModalDialogOfAWindowOwnedByTheTab);
+    CPPUNIT_TEST(testNoWindowOrDisposed);
+    CPPUNIT_TEST_SUITE_END();
+};
+
+void HstDocumentTabModalTest::testModalDialogOnTheTab()
+{
+    SolarMutexGuard aGuard;
+    VclPtr<WorkWindow> pTab = VclPtr<WorkWindow>::Create(nullptr, WB_STDWORK);
+    VclPtr<WorkWindow> pOther = VclPtr<WorkWindow>::Create(nullptr, WB_STDWORK);
+    CPPUNIT_ASSERT(!ownsModalDialog(pTab));
+    CPPUNIT_ASSERT(!anyOwnsModalDialog({ pTab, pOther }));
+
+    pTab->IncModalCount(); // a dialog starts executing on the tab window
+    CPPUNIT_ASSERT(ownsModalDialog(pTab));
+    CPPUNIT_ASSERT(!ownsModalDialog(pOther)); // the other window may still take or park tabs
+    CPPUNIT_ASSERT(anyOwnsModalDialog({ pOther, pTab }));
+    CPPUNIT_ASSERT(!anyOwnsModalDialog({ pOther }));
+
+    pTab->DecModalCount(); // the dialog ended: the tab may be parked again
+    CPPUNIT_ASSERT(!ownsModalDialog(pTab));
+
+    pOther.disposeAndClear();
+    pTab.disposeAndClear();
+}
+
+void HstDocumentTabModalTest::testModalDialogOfAWindowOwnedByTheTab()
+{
+    SolarMutexGuard aGuard;
+    VclPtr<WorkWindow> pTab = VclPtr<WorkWindow>::Create(nullptr, WB_STDWORK);
+    // a dialog executed on a (modeless) window that belongs to the tab window
+    VclPtr<WorkWindow> pOwned = VclPtr<WorkWindow>::Create(pTab.get(), WB_STDWORK);
+    pOwned->IncModalCount();
+    CPPUNIT_ASSERT(ownsModalDialog(pTab));
+    pOwned->DecModalCount();
+    CPPUNIT_ASSERT(!ownsModalDialog(pTab));
+    pOwned.disposeAndClear();
+    pTab.disposeAndClear();
+}
+
+void HstDocumentTabModalTest::testNoWindowOrDisposed()
+{
+    SolarMutexGuard aGuard;
+    CPPUNIT_ASSERT(!ownsModalDialog(nullptr));
+    CPPUNIT_ASSERT(!anyOwnsModalDialog({}));
+    VclPtr<WorkWindow> pTab = VclPtr<WorkWindow>::Create(nullptr, WB_STDWORK);
+    VclPtr<vcl::Window> pKept(pTab);
+    pTab.disposeAndClear();
+    CPPUNIT_ASSERT(!ownsModalDialog(pKept)); // a closed tab window never blocks anything
+    CPPUNIT_ASSERT(!anyOwnsModalDialog({ pKept }));
+}
+
+CPPUNIT_TEST_SUITE_REGISTRATION(HstDocumentTabModalTest);
+}
+
+CPPUNIT_PLUGIN_IMPLEMENT();
