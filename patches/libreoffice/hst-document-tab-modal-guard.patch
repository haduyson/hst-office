+bool DocumentTabGroup::ownsModalDialog(const Group& rGroup)
+{
+    std::vector<VclPtr<vcl::Window>> aWindows;
+    for (const Member& rMember : rGroup.aMembers)
+        aWindows.push_back(rMember.pWindow);
+    return documenttabmodal::anyOwnsModalDialog(aWindows);
+}
