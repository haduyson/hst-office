+/// Tip of a tab or command, or an empty view when it has none in the table.
+inline std::string_view lookup(const Key* pBegin, const Key* pEnd, std::string_view id)
+{
+    const Key* p = std::find_if(pBegin, pEnd, [id](const Key& k) { return k.id == id; });
+    return p == pEnd ? std::string_view() : p->tip;
+}
+
+/// One tip per id, in order, no tip being a prefix of another. preferred[i] may be empty or already
+/// taken; such ids get a free single letter, then Y1, Y2... (Y and Z stay reserved for that).
+inline std::vector<std::string> assign(const std::vector<std::string>& preferred)
+{
+    std::vector<std::string> result(preferred.size());
+    std::set<std::string> used;
+    const auto clashes = [&used](const std::string& tip) {
+        return std::any_of(used.begin(), used.end(), [&tip](const std::string& other) {
+            return other.starts_with(tip) || tip.starts_with(other);
+        });
+    };
+    for (size_t i = 0; i < preferred.size(); ++i)
+    {
+        if (!preferred[i].empty() && !clashes(preferred[i]))
+        {
+            result[i] = preferred[i];
+            used.insert(result[i]);
+        }
+    }
+    static constexpr std::string_view LETTERS = "ABCDEFGHIJKLMNOPQRSTUVWX";
+    static constexpr std::string_view SECOND = "123456789ABCDEFGHIJKLMNOPQRSTUVWXZ";
+    size_t nLetter = 0, nSecond = 0;
+    char cFirst = 'Y';
+    for (std::string& tip : result)
+    {
+        if (!tip.empty())
+            continue;
+        while (nLetter < LETTERS.size() && tip.empty())
+        {
+            const std::string candidate(1, LETTERS[nLetter++]);
+            if (!clashes(candidate))
+                tip = candidate;
+        }
+        while (tip.empty())
+        {
+            if (nSecond == SECOND.size())
+            {
+                nSecond = 0;
+                cFirst = 'Z';
+            }
+            tip = std::string(1, cFirst) + SECOND[nSecond++];
+        }
+        used.insert(tip);
+    }
+    return result;
+}
