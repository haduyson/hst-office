+namespace
+{
+/// The small label drawn over a tab or a command. It never takes the focus.
+class TipWindow final : public vcl::Window
+{
+public:
+    TipWindow(vcl::Window* pParent, const OUString& rTip, bool bEnabled)
+        : vcl::Window(pParent, 0)
+        , m_aTip(rTip)
+        , m_bEnabled(bEnabled)
+    {
+        SetPaintTransparent(false);
+        SetAccessibleRole(css::accessibility::AccessibleRole::LABEL);
+        SetAccessibleName(rTip);
+        vcl::Font aFont(GetSettings().GetStyleSettings().GetLabelFont());
+        aFont.SetWeight(WEIGHT_BOLD);
+        SetControlFont(aFont);
+        SetFont(aFont);
+    }
+
+    Size Measure()
+    {
+        const tools::Long nPad = GetTextHeight() / 3;
+        return Size(std::max(GetTextWidth(m_aTip) + 2 * nPad, GetTextHeight() + nPad),
+                    GetTextHeight() + nPad / 2);
+    }
+
+    virtual void Paint(vcl::RenderContext& rContext, const tools::Rectangle&) override
+    {
+        const StyleSettings& rStyle = rContext.GetSettings().GetStyleSettings();
+        const tools::Rectangle aRect(Point(), GetOutputSizePixel());
+        // the colours of an entry field: dark on light, and readable in a dark theme too
+        rContext.SetFillColor(rStyle.GetFieldColor());
+        rContext.SetLineColor(rStyle.GetShadowColor());
+        rContext.DrawRect(aRect);
+        rContext.SetFont(GetFont());
+        rContext.SetTextColor(m_bEnabled ? rStyle.GetFieldTextColor() : rStyle.GetDisableColor());
+        rContext.DrawText(aRect, m_aTip, DrawTextFlags::Center | DrawTextFlags::VCenter);
+    }
+
+private:
+    OUString m_aTip;
+    bool m_bEnabled;
+};
+
+/// A place on the ribbon that can show a tip and be activated.
+struct Target
+{
+    OUString aTip;
+    vcl::Window* pAnchor = nullptr; // coordinates of aRect
+    tools::Rectangle aRect;
+    bool bEnabled = true;
+    std::function<void()> aRun;
+    VclPtr<TipWindow> xTip;
+};
+
+class KeyTips
+{
+public:
+    KeyTips(TabControl& rTabs, NotebookBar& rBar, ToolBox* pQuickAccess, vcl::Window* pBanner)
+        : m_xTabs(&rTabs)
+        , m_xBar(&rBar)
+        , m_xQuick(pQuickAccess)
+        , m_xBanner(pBanner)
+    {
+        Application::AddKeyListener(LINK(this, KeyTips, KeyHdl));
+        Application::AddEventListener(LINK(this, KeyTips, AppEventHdl));
+        rBar.SetModKeyHdl(LINK(this, KeyTips, ModKeyHdl));
+        rTabs.AddEventListener(LINK(this, KeyTips, TabsEventHdl));
+    }
+
+private:
+    enum class Level { None, Tabs, Commands };
+
+    bool Mine(vcl::Window* pWindow) const
+    {
+        return pWindow && m_xTabs && m_xTabs->IsReallyVisible() && !m_xBar->IsInModalMode()
+               && pWindow->GetSystemWindow() == m_xTabs->GetSystemWindow()
+               && !vcl::IsInPopupMenuExecute();
+    }
+
+    void Clear()
+    {
+        for (Target& rTarget : m_aTargets)
+            rTarget.xTip.disposeAndClear();
+        m_aTargets.clear();
+        m_aTyped.clear();
+    }
+
+    void Close()
+    {
+        Clear();
+        m_eLevel = Level::None;
+    }
+
+    void Show(std::vector<Target>&& rTargets, const std::vector<std::string>& rPreferred)
+    {
+        Clear();
+        m_aTargets = std::move(rTargets);
+        const std::vector<std::string> aTips = assign(rPreferred);
+        const Size aBar = m_xBar->GetOutputSizePixel();
+        // The tab page is narrowed beside the banner after its children were placed: the overflow and menu
+        // buttons at its end can report a place under the banner. Tips stay on the page, side by side.
+        tools::Long nPageRight = aBar.Width();
+        if (m_eLevel == Level::Commands && m_xBanner && m_xBanner->IsVisible())
+            nPageRight = m_xBar->ScreenToOutputPixel(m_xBanner->OutputToScreenPixel(Point())).X();
+        tools::Long nEndTips = 0;
+        for (size_t i = 0; i < m_aTargets.size(); ++i)
+        {
+            Target& rTarget = m_aTargets[i];
+            rTarget.aTip = OUString::createFromAscii(aTips[i]);
+            rTarget.xTip = VclPtr<TipWindow>::Create(m_xBar.get(), rTarget.aTip, rTarget.bEnabled);
+            const Size aSize = rTarget.xTip->Measure();
+            // centred on the bottom edge of the command, inside the ribbon
+            const Point aBottom(rTarget.aRect.Center().X(), rTarget.aRect.Bottom());
+            const Point aOnBar = m_xBar->ScreenToOutputPixel(rTarget.pAnchor->OutputToScreenPixel(aBottom));
+            Point aPos(aOnBar.X() - aSize.Width() / 2, aOnBar.Y() - aSize.Height() / 2);
+            if (aPos.X() + aSize.Width() > nPageRight)
+            {
+                nEndTips += aSize.Width() + 2;
+                aPos.setX(nPageRight - nEndTips);
+            }
+            aPos.setX(std::clamp<tools::Long>(aPos.X(), 0, std::max<tools::Long>(0, aBar.Width() - aSize.Width())));
+            aPos.setY(std::clamp<tools::Long>(aPos.Y(), 0, std::max<tools::Long>(0, aBar.Height() - aSize.Height())));
+            rTarget.xTip->SetPosSizePixel(aPos, aSize);
+            rTarget.xTip->SetZOrder(nullptr, ZOrderFlags::First);
+            rTarget.xTip->Show(true, ShowFlags::NoFocusChange | ShowFlags::NoActivate);
+        }
+    }
+
+    void ShowTabs()
+    {
+        std::vector<Target> aTargets;
+        std::vector<std::string> aPreferred;
+        for (sal_uInt16 nPos = 0; nPos < m_xTabs->GetPageCount(); ++nPos)
+        {
+            const sal_uInt16 nId = m_xTabs->GetPageId(nPos);
+            const tools::Rectangle aRect = m_xTabs->GetTabBounds(nId);
+            if (aRect.GetWidth() <= 1) // pages hidden by the context have no tab
+                continue;
+            const OString aName = m_xTabs->GetPageName(nId).toUtf8();
+            aPreferred.emplace_back(lookup(std::begin(TAB_KEYS), std::end(TAB_KEYS), std::string_view(aName)));
+            Target aTarget;
+            aTarget.pAnchor = m_xTabs.get();
+            aTarget.aRect = aRect;
+            aTarget.aRun = [this, nId, bFile = aName == "FileLabel"] {
+                m_xTabs->SelectTabPage(nId);
+                if (bFile) // the handler of the File tab opens the full-window view
+                    Close();
+                else
+                    ShowCommands();
+            };
+            aTargets.push_back(std::move(aTarget));
+        }
+        // quick access buttons of the title row: digits, as the Quick Access Toolbar in Office
+        if (m_xQuick && m_xQuick->IsReallyVisible())
+        {
+            int nDigit = 1;
+            for (ToolBox::ImplToolItems::size_type i = 0; i < m_xQuick->GetItemCount() && nDigit < 10; ++i)
+                AddToolBoxItem(*m_xQuick, m_xQuick->GetItemId(i), aTargets, aPreferred, std::to_string(nDigit++));
+        }
+        m_eLevel = Level::Tabs;
+        Show(std::move(aTargets), aPreferred);
+    }
+
+    void AddToolBoxItem(ToolBox& rBox, ToolBoxItemId nId, std::vector<Target>& rTargets,
+                        std::vector<std::string>& rPreferred, const std::string& rTip)
+    {
+        const tools::Rectangle aRect = rBox.GetItemRect(nId);
+        if (rBox.GetItemType(rBox.GetItemPos(nId)) != ToolBoxItemType::BUTTON || !rBox.IsItemVisible(nId)
+            || rBox.IsItemClipped(nId) || aRect.IsEmpty())
+            return;
+        Target aTarget;
+        aTarget.pAnchor = &rBox;
+        aTarget.aRect = aRect;
+        aTarget.bEnabled = rBox.IsItemEnabled(nId);
+        VclPtr<ToolBox> xBox(&rBox);
+        aTarget.aRun = [xBox, nId] {
+            if (vcl::Window* pItem = xBox->GetItemWindow(nId))
+                pItem->GrabFocus(); // font name, size: the field takes the typing, as in Office
+            else if (xBox->GetItemBits(nId) & ToolBoxItemBits::DROPDOWNONLY)
+                xBox->TriggerItemDropdown(nId);
+            else
+                xBox->TriggerItem(nId);
+        };
+        rPreferred.push_back(rTip);
+        rTargets.push_back(std::move(aTarget));
+    }
+
+    void CollectCommands(vcl::Window& rWindow, std::vector<Target>& rTargets, std::vector<std::string>& rPreferred)
+    {
+        for (vcl::Window* pChild = rWindow.GetWindow(GetWindowType::FirstChild); pChild;
+             pChild = pChild->GetWindow(GetWindowType::Next))
+        {
+            if (!pChild->IsVisible())
+                continue;
+            if (ToolBox* pBox = dynamic_cast<ToolBox*>(pChild))
+            {
+                for (ToolBox::ImplToolItems::size_type i = 0; i < pBox->GetItemCount(); ++i)
+                {
+                    const ToolBoxItemId nId = pBox->GetItemId(i);
+                    OUString aCommand = pBox->GetItemCommand(nId);
+                    aCommand = aCommand.replaceFirst(".uno:", "");
+                    const OString aUtf8 = aCommand.toUtf8();
+                    AddToolBoxItem(*pBox, nId, rTargets, rPreferred,
+                                   std::string(lookup(std::begin(COMMAND_KEYS), std::end(COMMAND_KEYS),
+                                                      std::string_view(aUtf8))));
+                }
+            }
+            else if (pChild->GetType() == WindowType::PUSHBUTTON || pChild->GetType() == WindowType::MENUBUTTON)
+            {
+                // tab menu, overflow chevron: the button classes are private to vcl, so a click is posted
+                Target aTarget;
+                aTarget.pAnchor = pChild;
+                // these buttons can be allocated more width than they draw: the tip goes on their left end
+                const Size aSize = pChild->GetOutputSizePixel();
+                aTarget.aRect = tools::Rectangle(Point(), Size(std::min<tools::Long>(aSize.Width(), aSize.Height()), aSize.Height()));
+                aTarget.bEnabled = pChild->IsEnabled();
+                VclPtr<vcl::Window> xButton(pChild);
+                aTarget.aRun = [xButton] {
+                    const Point aCentre(xButton->GetOutputSizePixel().Width() / 2, xButton->GetOutputSizePixel().Height() / 2);
+                    const MouseEvent aDown(aCentre, 1, MouseEventModifiers::SIMPLECLICK, MOUSE_LEFT);
+                    const MouseEvent aUp(aCentre, 1, MouseEventModifiers::SIMPLECLICK, MOUSE_LEFT);
+                    Application::PostMouseEvent(VclEventId::WindowMouseButtonDown, xButton.get(), &aDown);
+                    Application::PostMouseEvent(VclEventId::WindowMouseButtonUp, xButton.get(), &aUp);
+                };
+                rPreferred.emplace_back();
+                rTargets.push_back(std::move(aTarget));
+            }
+            else
+                CollectCommands(*pChild, rTargets, rPreferred);
+        }
+    }
+
+    void ShowCommands()
+    {
+        std::vector<Target> aTargets;
+        std::vector<std::string> aPreferred;
+        if (TabPage* pPage = m_xTabs->GetTabPage(m_xTabs->GetCurPageId()))
+            CollectCommands(*pPage, aTargets, aPreferred);
+        m_eLevel = Level::Commands;
+        Show(std::move(aTargets), aPreferred);
+    }
+
+    /// A letter of the typed tip. Returns true when the key belonged to KeyTips.
+    bool Type(char cKey)
+    {
+        const OUString aTyped = m_aTyped + OUStringChar(cKey);
+        bool bAny = false;
+        for (const Target& rTarget : m_aTargets)
+            bAny = bAny || rTarget.aTip.startsWith(aTyped);
+        if (!bAny)
+            return true; // not a tip: ignored, the level stays open as in Office
+        m_aTyped = aTyped;
+        for (Target& rTarget : m_aTargets)
+        {
+            if (rTarget.aTip != aTyped)
+            {
+                rTarget.xTip->Show(rTarget.aTip.startsWith(aTyped), ShowFlags::NoFocusChange | ShowFlags::NoActivate);
+                continue;
+            }
+            if (!rTarget.bEnabled)
+                return true;
+            const std::function<void()> aRun = rTarget.aRun;
+            if (m_eLevel == Level::Commands)
+                Close();
+            aRun(); // tabs: goes on to the commands of the tab
+            return true;
+        }
+        return true;
+    }
+
+    static char LetterOf(const vcl::KeyCode& rKey)
+    {
+        const sal_uInt16 nCode = rKey.GetCode();
+        if (nCode >= KEY_A && nCode <= KEY_Z)
+            return static_cast<char>('A' + (nCode - KEY_A));
+        if (nCode >= KEY_0 && nCode <= KEY_9)
+            return static_cast<char>('0' + (nCode - KEY_0));
+        return 0;
+    }
+
+    DECL_LINK(KeyHdl, VclWindowEvent&, bool);
+    DECL_LINK(AppEventHdl, VclSimpleEvent&, void);
+    DECL_LINK(TabsEventHdl, VclWindowEvent&, void);
+    DECL_LINK(ModKeyHdl, const CommandModKeyData&, void);
+    DECL_LINK(DeleteHdl, void*, void);
+
+    VclPtr<TabControl> m_xTabs;
+    VclPtr<NotebookBar> m_xBar;
+    VclPtr<ToolBox> m_xQuick;
+    VclPtr<vcl::Window> m_xBanner;
+    std::vector<Target> m_aTargets;
+    OUString m_aTyped;
+    Level m_eLevel = Level::None;
+    bool m_bAltArmed = false;
+};
+
+IMPL_LINK(KeyTips, ModKeyHdl, const CommandModKeyData&, rData, void)
+{
+    if (!m_xTabs || !m_xTabs->IsReallyVisible())
+        return;
+    if (rData.IsDown())
+    {
+        m_bAltArmed = rData.IsMod2() && !rData.IsMod1() && !rData.IsLeftShift() && !rData.IsRightShift();
+        return;
+    }
+    // Alt released with no key in between
+    if (std::exchange(m_bAltArmed, false))
+    {
+        if (m_eLevel == Level::None)
+        {
+            if (!m_xBar->IsInModalMode() && !vcl::IsInPopupMenuExecute())
+                ShowTabs();
+        }
+        else
+            Close();
+    }
+}
+
+IMPL_LINK(KeyTips, KeyHdl, VclWindowEvent&, rEvent, bool)
+{
+    vcl::Window* pWindow = rEvent.GetWindow();
+    const KeyEvent* pKey = static_cast<const KeyEvent*>(rEvent.GetData());
+    if (!pKey || !Mine(pWindow))
+    {
+        if (m_eLevel != Level::None)
+            Close();
+        return false;
+    }
+    const vcl::KeyCode& rCode = pKey->GetKeyCode();
+    if (rEvent.GetId() == VclEventId::WindowKeyUp)
+        return m_eLevel != Level::None;
+    if (rEvent.GetId() != VclEventId::WindowKeyInput)
+        return false;
+    m_bAltArmed = false;
+
+    if (m_eLevel == Level::None)
+    {
+        // Alt+letter: the tab with that letter, then its commands. Other Alt keys are shortcuts.
+        const char cLetter = rCode.IsMod2() && !rCode.IsMod1() && !rCode.IsShift() ? LetterOf(rCode) : 0;
+        if (!cLetter || cLetter == 'F') // Alt+F has its own accelerator, the File view
+            return false;
+        ShowTabs();
+        const OUString aOne = OUString(OUStringChar(cLetter));
+        bool bTab = false;
+        for (const Target& rTarget : m_aTargets)
+            bTab = bTab || rTarget.aTip.startsWith(aOne);
+        if (bTab)
+            return Type(cLetter);
+        Close();
+        return false;
+    }
+    switch (rCode.GetCode())
+    {
+        case KEY_ESCAPE:
+            if (m_eLevel == Level::Commands)
+                ShowTabs();
+            else
+                Close();
+            return true;
+        case KEY_TAB: case KEY_LEFT: case KEY_RIGHT: case KEY_UP: case KEY_DOWN: case KEY_RETURN:
+            Close();
+            return false;
+        default:
+            break;
+    }
+    if (rCode.IsMod1())
+    {
+        Close();
+        return false;
+    }
+    if (const char cLetter = LetterOf(rCode))
+        return Type(cLetter);
+    return true;
+}
+
+IMPL_LINK(KeyTips, AppEventHdl, VclSimpleEvent&, rEvent, void)
+{
+    if (m_eLevel == Level::None)
+        return;
+    switch (rEvent.GetId())
+    {
+        case VclEventId::WindowMouseButtonDown:
+        case VclEventId::WindowResize:
+        case VclEventId::WindowDeactivate:
+        case VclEventId::WindowClose:
+            if (rEvent.GetId() == VclEventId::WindowMouseButtonDown
+                || static_cast<VclWindowEvent&>(rEvent).GetWindow() == m_xTabs->GetSystemWindow())
+                Close();
+            break;
+        default:
+            break;
+    }
+}
+
+IMPL_LINK(KeyTips, TabsEventHdl, VclWindowEvent&, rEvent, void)
+{
+    if (rEvent.GetId() != VclEventId::ObjectDying)
+        return;
+    Close();
+    Application::RemoveKeyListener(LINK(this, KeyTips, KeyHdl));
+    Application::RemoveEventListener(LINK(this, KeyTips, AppEventHdl));
+    m_xBar->SetModKeyHdl(Link<const CommandModKeyData&, void>());
+    m_xTabs->RemoveEventListener(LINK(this, KeyTips, TabsEventHdl));
+    m_xTabs.reset();
+    Application::PostUserEvent(LINK(this, KeyTips, DeleteHdl));
+}
+
+IMPL_LINK_NOARG(KeyTips, DeleteHdl, void*, void) { delete this; }
+}
+
+void Attach(TabControl& rTabs, NotebookBar& rBar, ToolBox* pQuickAccess, vcl::Window* pBanner)
+{
+    new KeyTips(rTabs, rBar, pQuickAccess, pBanner); // deletes itself when the tab control is disposed
+}
+}
