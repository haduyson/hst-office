+std::vector<OUString> VbaExport::getUnsupportedFormControls() const
+{
+    std::vector<OUString> aResult;
+    css::uno::Reference<css::container::XNameContainer> xLibrary = getBasicLibrary();
+    css::uno::Reference<css::script::vba::XVBAModuleInfo> xInfo(xLibrary, css::uno::UNO_QUERY);
+    if (!xInfo.is())
+        return aResult;
+    oox::ole::VbaFormExporter aForms(comphelper::getProcessComponentContext(), mxModel);
+    for (const OUString& rName : xLibrary->getElementNames())
+    {
+        if (!xInfo->hasModuleInfo(rName) || xInfo->getModuleInfo(rName).ModuleType != 3)
+            continue;
+        for (const OUString& rControl : oox::ole::VbaFormExporter::getUnsupportedControls(aForms.loadDialog(getProjectName(), rName)))
+            aResult.push_back(rName + "." + rControl);
+    }
+    return aResult;
+}
