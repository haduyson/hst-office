+ControlModelRef lclCreateModel(ControlNode& rNode, const ControlConverter& rConv)
+{
+    ControlModelRef xModel;
+    switch (rNode.mnClass)
+    {
+        case SITE_COMMANDBUTTON: xModel = std::make_shared<AxCommandButtonModel>(); break;
+        case SITE_LABEL: xModel = std::make_shared<AxLabelModel>(); break;
+        case SITE_TOGGLEBUTTON: xModel = std::make_shared<AxToggleButtonModel>(); break;
+        case SITE_CHECKBOX: xModel = std::make_shared<AxCheckBoxModel>(); break;
+        case SITE_OPTIONBUTTON: xModel = std::make_shared<AxOptionButtonModel>(); break;
+        case SITE_TEXTBOX: xModel = std::make_shared<AxTextBoxModel>(); break;
+        case SITE_LISTBOX: xModel = std::make_shared<AxListBoxModel>(); break;
+        case SITE_COMBOBOX: xModel = std::make_shared<AxComboBoxModel>(); break;
+        case SITE_SPINBUTTON: xModel = std::make_shared<AxSpinButtonModel>(); break;
+        case SITE_SCROLLBAR: xModel = std::make_shared<AxScrollBarModel>(); break;
+        default: return xModel;
+    }
+    xModel->setAwtModelMode();
+    PropertySet aPropSet(rNode.mxProps);
+    xModel->convertFromProperties(aPropSet, rConv);
+
+    if (auto* pMorph = dynamic_cast<AxMorphDataModelBase*>(xModel.get()))
+    {
+        // properties the importer maps for dialog models but convertFromProperties() leaves out
+        bool bValue = true;
+        if (aPropSet.getProperty(bValue, PROP_Enabled))
+            setFlag(pMorph->mnFlags, AX_FLAGS_ENABLED, bValue);
+        if (rNode.mnClass == SITE_LISTBOX && aPropSet.getProperty(bValue, PROP_MultiSelection))
+            pMorph->mnMultiSelect = bValue ? AX_SELECTION_MULTI : AX_SELECTION_SINGLE;
+        if (rNode.mnClass == SITE_COMBOBOX)
+        {
+            bool bList = rNode.mxInfo->supportsService(u"com.sun.star.awt.UnoControlListBoxModel"_ustr);
+            pMorph->mnDisplayStyle = bList ? AX_DISPLAYSTYLE_DROPDOWN : AX_DISPLAYSTYLE_COMBOBOX;
+            bool bDropdown = bList;
+            if (!bList)
+                aPropSet.getProperty(bDropdown, PROP_Dropdown);
+            pMorph->mnShowDropButton = bDropdown ? AX_SHOWDROPBUTTON_ALWAYS : AX_SHOWDROPBUTTON_NEVER;
+        }
+    }
+    return xModel;
+}
+
+/** Writes one MS-OFORMS record with AxBinaryPropertyWriter and replaces its version word: the
+    writer always starts with 0x0200, the form record needs 0x0400 and the site record 0. */
+template <typename Func>
+void lclWriteRecord(BinaryOutputStream& rOut, sal_uInt16 nVersion, Func aWrite)
+{
+    const sal_Int64 nStart = rOut.tell();
+    aWrite();
+    const sal_Int64 nEnd = rOut.tell();
+    rOut.seek(nStart);
+    rOut.WriteUInt16(nVersion);
+    rOut.seek(nEnd);
+}
+
+void lclWriteStream(SotStorage& rStorage, const OUString& rName, const std::vector<sal_uInt8>& rData)
+{
+    rtl::Reference<SotStorageStream> xStream = rStorage.OpenSotStream(rName, StreamMode::READWRITE | StreamMode::TRUNC);
+    xStream->WriteBytes(rData.data(), rData.size());
+    xStream->Commit();
+}
+
+/** \001CompObj per MS-OLEDS 2.3.8, the same layout as the exportCompObj() tables in axcontrol.cxx. */
+void lclWriteCompObj(SotStorage& rStorage, const SvGlobalName& rClass, const char* pUserType, const char* pProgId)
+{
+    rtl::Reference<SotStorageStream> xStream = rStorage.OpenSotStream(u"\001CompObj"_ustr, StreamMode::READWRITE | StreamMode::TRUNC);
+    SvStream& rOut = *xStream;
+    rOut.SetEndian(SvStreamEndian::LITTLE);
+    rOut.WriteUInt32(0xFFFE0001).WriteUInt32(0x00000A03).WriteInt32(-1);
+    const SvGUID& rClsId = rClass.GetCLSID();
+    rOut.WriteUInt32(rClsId.Data1).WriteUInt16(rClsId.Data2).WriteUInt16(rClsId.Data3);
+    rOut.WriteBytes(rClsId.Data4, 8);
+    const auto writeAnsi = [&rOut](const char* pText)
+    {
+        const sal_uInt32 nLen = strlen(pText) + 1;
+        rOut.WriteUInt32(nLen);
+        rOut.WriteBytes(pText, nLen);
+    };
+    writeAnsi(pUserType);
+    writeAnsi("Embedded Object");
+    writeAnsi(pProgId);
+    // Unicode marker and three empty Unicode strings
+    rOut.WriteUInt32(0x71B239F4).WriteUInt32(0).WriteUInt32(0).WriteUInt32(0);
+    xStream->Commit();
+}
+
+void lclPrepareStorage(SotStorage& rStorage, const SvGlobalName& rClass, const char* pUserType, const char* pProgId)
+{
+    // SetClass() stores the class id of the storage entry; its companion streams are replaced
+    rStorage.SetClass(rClass, SotClipboardFormatId::NONE, OUString::createFromAscii(pUserType));
+    rStorage.Remove(u"\001Ole"_ustr);
+    lclWriteCompObj(rStorage, rClass, pUserType, pProgId);
+}
