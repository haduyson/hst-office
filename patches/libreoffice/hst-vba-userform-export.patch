+/** Geometry helper: dialog models use AppFont units, the file 1/100 mm (reverse of ControlConverter). */
+class UnitConverter
+{
+public:
+    explicit UnitConverter(const GraphicHelper& rHelper)
+        : maScale(rHelper.convertHmmToAppFont(awt::Size(100000, 100000)))
+    {
+    }
+    sal_Int32 toHmmX(sal_Int32 nAppFont) const
+    {
+        return maScale.Width > 0 ? static_cast<sal_Int32>((sal_Int64(nAppFont) * 100000 + maScale.Width / 2) / maScale.Width) : nAppFont;
+    }
+    sal_Int32 toHmmY(sal_Int32 nAppFont) const
+    {
+        return maScale.Height > 0 ? static_cast<sal_Int32>((sal_Int64(nAppFont) * 100000 + maScale.Height / 2) / maScale.Height) : nAppFont;
+    }
+
+private:
+    awt::Size maScale;
+};
+
+sal_Int32 lclGetInt(const uno::Reference<beans::XPropertySet>& xProps, const OUString& rName)
+{
+    sal_Int32 nValue = 0;
+    if (xProps.is())
+        xProps->getPropertyValue(rName) >>= nValue;
+    return nValue;
+}
+
+/** The controls of a dialog or nested frame as a tree. A control inside the rectangle of a flat group
+    box (UNO group boxes cannot contain controls) goes back into that Frame. */
+std::vector<ControlNodeRef> lclBuildTree(const uno::Reference<container::XNameContainer>& xContainer,
+                                         const UnitConverter& rUnits, const ControlConverter& rConv,
+                                         sal_Int32& rnNextId)
+{
+    std::vector<ControlNodeRef> aFlat;
+    const uno::Sequence<OUString> aNames = xContainer->getElementNames();
+    for (const OUString& rName : aNames)
+    {
+        if (rName.startsWith(DUMMY_GROUP_SEP))
+            continue; // the importer's separator between option groups
+        uno::Reference<beans::XPropertySet> xProps(xContainer->getByName(rName), uno::UNO_QUERY);
+        uno::Reference<lang::XServiceInfo> xInfo(xProps, uno::UNO_QUERY);
+        if (!xProps.is())
+            continue;
+        auto xNode = std::make_shared<ControlNode>();
+        xNode->maName = rName;
+        xNode->mxProps = xProps;
+        xNode->mxInfo = xInfo;
+        xNode->mnClass = lclClassOf(xInfo, xProps);
+        if (xNode->mnClass == SITE_UNSUPPORTED)
+            continue;
+        PropertySet aPropSet(xProps);
+        aPropSet.getProperty(xNode->maTag, PROP_Tag);
+        aPropSet.getProperty(xNode->maToolTip, PROP_HelpText);
+        sal_Int16 nTabIndex = 0;
+        aPropSet.getProperty(nTabIndex, PROP_TabIndex);
+        xNode->mnTabIndex = nTabIndex;
+        bool bVisible = true;
+        aPropSet.getProperty(bVisible, PROP_EnableVisible);
+        bool bTabStop = true;
+        aPropSet.getProperty(bTabStop, PROP_Tabstop);
+        xNode->mnFlags = SITE_FLAG_DEFAULT | (bVisible ? SITE_FLAG_VISIBLE : 0) | (bTabStop ? SITE_FLAG_TABSTOP : 0);
+        xNode->maPos = { rUnits.toHmmX(lclGetInt(xProps, u"PositionX"_ustr)), rUnits.toHmmY(lclGetInt(xProps, u"PositionY"_ustr)) };
+        xNode->maSize = { rUnits.toHmmX(lclGetInt(xProps, u"Width"_ustr)), rUnits.toHmmY(lclGetInt(xProps, u"Height"_ustr)) };
+        xNode->mnId = rnNextId++;
+        if (xNode->mnClass == SITE_FRAME)
+        {
+            aPropSet.getProperty(xNode->maCaption, PROP_Label);
+            aPropSet.getProperty(xNode->mbEnabled, PROP_Enabled);
+            uno::Reference<container::XNameContainer> xNested(xProps, uno::UNO_QUERY);
+            if (xNested.is())
+            {
+                xNode->mbNested = true;
+                xNode->maChildren = lclBuildTree(xNested, rUnits, rConv, rnNextId);
+            }
+        }
+        else
+        {
+            xNode->mnFlags |= SITE_FLAG_STREAMED;
+            xNode->mxModel = lclCreateModel(*xNode, rConv);
+            if (!xNode->mxModel)
+                continue;
+            xNode->mxModel->maSize = xNode->maSize;
+        }
+        aFlat.push_back(xNode);
+    }
+    std::stable_sort(aFlat.begin(), aFlat.end(), [](const ControlNodeRef& rA, const ControlNodeRef& rB)
+                     { return rA->mnTabIndex < rB->mnTabIndex; });
+
+    const auto contains = [](const ControlNode& rFrame, const ControlNode& rNode)
+    {
+        return rNode.maPos.first >= rFrame.maPos.first && rNode.maPos.second >= rFrame.maPos.second
+               && rNode.maPos.first + rNode.maSize.first <= rFrame.maPos.first + rFrame.maSize.first
+               && rNode.maPos.second + rNode.maSize.second <= rFrame.maPos.second + rFrame.maSize.second;
+    };
+    std::vector<ControlNodeRef> aRoots;
+    std::vector<std::pair<ControlNodeRef, ControlNode*>> aMoved;
+    for (const ControlNodeRef& xNode : aFlat)
+    {
+        ControlNode* pParent = nullptr;
+        for (const ControlNodeRef& xFrame : aFlat)
+        {
+            if (xFrame == xNode || xFrame->mnClass != SITE_FRAME || xFrame->mbNested || !contains(*xFrame, *xNode))
+                continue;
+            // the innermost (smallest) group box holds the control
+            if (!pParent || xFrame->maSize.first * sal_Int64(xFrame->maSize.second) < pParent->maSize.first * sal_Int64(pParent->maSize.second))
+                pParent = xFrame.get();
+        }
+        if (pParent)
+        {
+            pParent->maChildren.push_back(xNode);
+            aMoved.emplace_back(xNode, pParent);
+        }
+        else
+            aRoots.push_back(xNode);
+    }
+    // relative to the parent: uses each parent's absolute position, so subtract only after all are known
+    std::vector<AxPairData> aOffsets;
+    aOffsets.reserve(aMoved.size());
+    for (const auto& [xNode, pParent] : aMoved)
+        aOffsets.push_back(pParent->maPos);
+    for (size_t i = 0; i < aMoved.size(); ++i)
+    {
+        aMoved[i].first->maPos.first -= aOffsets[i].first;
+        aMoved[i].first->maPos.second -= aOffsets[i].second;
+    }
+    return aRoots;
+}
+
+/** Option groups: in a dialog, contiguous radio buttons form a group; in MS Forms, buttons of a
+    container share a group unless GroupName differs. */
+void lclAssignOptionGroups(const std::vector<ControlNodeRef>& rControls, sal_Int32& rnGroup)
+{
+    std::vector<std::vector<AxMorphDataModelBase*>> aRuns;
+    bool bInRun = false;
+    for (const ControlNodeRef& xNode : rControls)
+    {
+        if (xNode->mnClass == SITE_OPTIONBUTTON)
+        {
+            if (!bInRun)
+                aRuns.emplace_back();
+            aRuns.back().push_back(static_cast<AxMorphDataModelBase*>(xNode->mxModel.get()));
+            bInRun = true;
+        }
+        else
+            bInRun = false;
+        if (xNode->mnClass == SITE_FRAME)
+            lclAssignOptionGroups(xNode->maChildren, rnGroup);
+    }
+    for (auto& rRun : aRuns)
+    {
+        const OUString aGroup = aRuns.size() > 1 ? "HstGroup" + OUString::number(++rnGroup) : OUString();
+        for (AxMorphDataModelBase* pButton : rRun)
+            if (pButton->maGroupName.isEmpty() || pButton->maGroupName.startsWith("autoGroup_"))
+                pButton->maGroupName = aGroup;
+    }
+}
+
+void lclWriteSite(BinaryOutputStream& rOut, ControlNode& rNode, sal_uInt32 nStreamSize)
+{
+    lclWriteRecord(rOut, 0x0000, [&]()
+    {
+        AxBinaryPropertyWriter aWriter(rOut);
+        aWriter.writeStringProperty(rNode.maName);
+        if (!rNode.maTag.isEmpty())
+            aWriter.writeStringProperty(rNode.maTag);
+        else
+            aWriter.skipProperty();
+        aWriter.writeIntProperty<sal_Int32>(rNode.mnId);
+        aWriter.skipProperty(); // help context id
+        aWriter.writeIntProperty<sal_uInt32>(rNode.mnFlags);
+        if (rNode.mnClass != SITE_FRAME)
+            aWriter.writeIntProperty<sal_uInt32>(nStreamSize);
+        else
+            aWriter.skipProperty();
+        aWriter.writeIntProperty<sal_Int16>(static_cast<sal_Int16>(rNode.mnTabIndex));
+        aWriter.writeIntProperty<sal_uInt16>(rNode.mnClass);
+        aWriter.writePairProperty(rNode.maPos);
+        aWriter.skipProperty(); // group id
+        aWriter.skipProperty(); // unused
+        if (!rNode.maToolTip.isEmpty())
+            aWriter.writeStringProperty(rNode.maToolTip);
+        else
+            aWriter.skipProperty();
+        aWriter.skipProperty(); // license key
+        aWriter.skipProperty(); // control source
+        aWriter.skipProperty(); // row source
+        aWriter.finalizeExport();
+    });
+}
+
+/** Writes the "f" and "o" streams of a form or Frame into rStorage (MS-OFORMS 2.2.10). */
+void lclWriteContainer(SotStorage& rStorage, const std::vector<ControlNodeRef>& rChildren,
+                       AxPairData aSize, OUString aCaption, bool bEnabled, sal_uInt32 nBackColor,
+                       sal_uInt32 nSpecialEffect, sal_Int32 nNextId)
+{
+    // the models first: each site records the size of its model in "o"
+    MemoryOutputStream aOStrm;
+    std::vector<sal_uInt32> aSizes;
+    {
+        for (const ControlNodeRef& xNode : rChildren)
+        {
+            const sal_Int64 nStart = aOStrm.tell();
+            if (xNode->mxModel)
+                xNode->mxModel->exportBinaryModel(aOStrm);
+            aSizes.push_back(static_cast<sal_uInt32>(aOStrm.tell() - nStart));
+        }
+    }
+    // Frames in their own iNN substorage
+    for (const ControlNodeRef& xNode : rChildren)
+    {
+        if (xNode->mnClass != SITE_FRAME)
+            continue;
+        OUString aStorageName = (xNode->mnId < 10 ? u"i0"_ustr : u"i"_ustr) + OUString::number(xNode->mnId);
+        rtl::Reference<SotStorage> xSub = rStorage.OpenSotStorage(aStorageName, StreamMode::READWRITE | StreamMode::TRUNC);
+        lclPrepareStorage(*xSub, SvGlobalName(0x6E182020, 0xF460, 0x11CE, 0x9B, 0xCD, 0x00, 0xAA, 0x00, 0x60, 0x8E, 0x01),
+                          "Microsoft Forms 2.0 Frame", "Forms.Frame.1");
+        lclWriteContainer(*xSub, xNode->maChildren, xNode->maSize, xNode->maCaption, xNode->mbEnabled,
+                          FRAME_BACKCOLOR_DEFAULT, FORM_SPECIALEFFECT_ETCHED, nNextId);
+        xSub->Commit();
+    }
+
+    MemoryOutputStream aFStrm;
+    {
+        lclWriteRecord(aFStrm, 0x0400, [&]()
+        {
+            AxBinaryPropertyWriter aWriter(aFStrm);
+            aWriter.skipProperty(); // unused
+            aWriter.writeIntProperty<sal_uInt32>(nBackColor);
+            aWriter.skipProperty(); // fore color
+            aWriter.writeIntProperty<sal_uInt32>(static_cast<sal_uInt32>(nNextId));
+            aWriter.skipProperty(); // unused
+            aWriter.skipProperty(); // unused
+            aWriter.writeIntProperty<sal_uInt32>(bEnabled ? FORM_FLAGS_ENABLED : 0);
+            aWriter.skipProperty(); // border style
+            aWriter.skipProperty(); // mouse pointer
+            aWriter.skipProperty(); // scroll bars
+            aWriter.writePairProperty(aSize);
+            aWriter.writePairProperty(aSize); // logical size
+            aWriter.skipProperty(); // scroll position
+            aWriter.skipProperty(); // group count
+            aWriter.skipProperty(); // reserved
+            aWriter.skipProperty(); // mouse icon
+            aWriter.skipProperty(); // cycle
+            aWriter.writeIntProperty<sal_uInt8>(static_cast<sal_uInt8>(nSpecialEffect));
+            aWriter.skipProperty(); // border color
+            if (!aCaption.isEmpty())
+                aWriter.writeStringProperty(aCaption);
+            else
+                aWriter.skipProperty();
+            aWriter.skipProperty(); // font
+            aWriter.skipProperty(); // picture
+            aWriter.skipProperty(); // zoom
+            aWriter.skipProperty(); // picture alignment
+            aWriter.skipProperty(); // picture tiling
+            aWriter.skipProperty(); // picture size mode
+            aWriter.skipProperty(); // shape cookie
+            aWriter.writeIntProperty<sal_uInt32>(FORM_DRAWBUFFER);
+            aWriter.finalizeExport();
+        });
+        aFStrm.WriteUInt16(0); // class table: empty
+
+        // FormSiteData: site count, byte count, one (depth, type) pair per site, 32-bit alignment
+        MemoryOutputStream aSiteStrm;
+        {
+            const sal_uInt32 nCount = rChildren.size();
+            for (sal_uInt32 i = 0; i < nCount; ++i)
+            {
+                const sal_uInt8 aDepthType[2] = { 0x00, 0x01 }; // depth, one control of type 1
+                aSiteStrm.writeMemory(aDepthType, 2);
+            }
+            const sal_uInt8 aPad[4] = { 0, 0, 0, 0 };
+            if (aSiteStrm.tell() % 4)
+                aSiteStrm.writeMemory(aPad, 4 - aSiteStrm.tell() % 4);
+            for (sal_uInt32 i = 0; i < nCount; ++i)
+                lclWriteSite(aSiteStrm, *rChildren[i], aSizes[i]);
+        }
+        aFStrm.WriteUInt32(static_cast<sal_uInt32>(rChildren.size()));
+        aFStrm.WriteUInt32(static_cast<sal_uInt32>(aSiteStrm.getData().size()));
+        aFStrm.writeMemory(aSiteStrm.getData().data(), aSiteStrm.getData().size());
+    }
+    lclWriteStream(rStorage, u"f"_ustr, aFStrm.getData());
+    if (!aOStrm.getData().empty())
+        lclWriteStream(rStorage, u"o"_ustr, aOStrm.getData());
+}
+}
