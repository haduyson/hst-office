+sal_uInt16 lclClassOf(const uno::Reference<lang::XServiceInfo>& xInfo,
+                      const uno::Reference<beans::XPropertySet>& xProps)
+{
+    if (!xInfo.is())
+        return SITE_UNSUPPORTED;
+    const auto is
+        = [&](const char* pName) { return xInfo->supportsService(OUString::createFromAscii(pName)); };
+    if (is("com.sun.star.awt.UnoControlFixedTextModel"))
+        return SITE_LABEL;
+    if (is("com.sun.star.awt.UnoControlButtonModel"))
+    {
+        bool bToggle = false;
+        xProps->getPropertyValue(u"Toggle"_ustr) >>= bToggle;
+        return bToggle ? SITE_TOGGLEBUTTON : SITE_COMMANDBUTTON;
+    }
+    if (is("com.sun.star.awt.UnoControlEditModel"))
+        return SITE_TEXTBOX;
+    if (is("com.sun.star.awt.UnoControlCheckBoxModel"))
+        return SITE_CHECKBOX;
+    if (is("com.sun.star.awt.UnoControlRadioButtonModel"))
+        return SITE_OPTIONBUTTON;
+    if (is("com.sun.star.awt.UnoControlComboBoxModel"))
+        return SITE_COMBOBOX;
+    if (is("com.sun.star.awt.UnoControlListBoxModel"))
+    {
+        bool bDropdown = false;
+        xProps->getPropertyValue(u"Dropdown"_ustr) >>= bDropdown;
+        return bDropdown ? SITE_COMBOBOX : SITE_LISTBOX;
+    }
+    // a group box drawn in the HST dialog editor, or the nested frame the importer creates
+    if (is("com.sun.star.awt.UnoControlGroupBoxModel") || is("com.sun.star.awt.UnoFrameModel"))
+        return SITE_FRAME;
+    if (is("com.sun.star.awt.UnoControlSpinButtonModel"))
+        return SITE_SPINBUTTON;
+    if (is("com.sun.star.awt.UnoControlScrollBarModel"))
+        return SITE_SCROLLBAR;
+    return SITE_UNSUPPORTED;
+}
