+bool VbaExport::hasForms() const
+{
+    css::uno::Reference<css::container::XNameContainer> xLibrary = getBasicLibrary();
+    css::uno::Reference<css::script::vba::XVBAModuleInfo> xInfo(xLibrary, css::uno::UNO_QUERY);
+    if (!xInfo.is())
+        return false;
+    for (const OUString& rName : xLibrary->getElementNames())
+        if (xInfo->hasModuleInfo(rName) && xInfo->getModuleInfo(rName).ModuleType == 3)
+            return true;
+    return false;
+}
