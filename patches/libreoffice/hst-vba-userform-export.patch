+
+uno::Reference<container::XNameContainer> VbaFormExporter::loadDialog(const OUString& rProject,
+                                                                      const OUString& rForm) const
+{
+    uno::Reference<container::XNameContainer> xDialog;
+    try
+    {
+        uno::Reference<beans::XPropertySet> xDocProps(mxDocModel, uno::UNO_QUERY_THROW);
+        uno::Reference<script::XLibraryContainer> xLibraries(xDocProps->getPropertyValue(u"DialogLibraries"_ustr), uno::UNO_QUERY_THROW);
+        if (!xLibraries->hasByName(rProject))
+            return xDialog;
+        if (!xLibraries->isLibraryLoaded(rProject))
+            xLibraries->loadLibrary(rProject);
+        uno::Reference<container::XNameContainer> xLibrary(xLibraries->getByName(rProject), uno::UNO_QUERY_THROW);
+        if (!xLibrary->hasByName(rForm))
+            return xDialog;
+        uno::Reference<io::XInputStreamProvider> xSource(xLibrary->getByName(rForm), uno::UNO_QUERY_THROW);
+        xDialog.set(mxContext->getServiceManager()->createInstanceWithContext(u"com.sun.star.awt.UnoControlDialogModel"_ustr, mxContext), uno::UNO_QUERY_THROW);
+        ::xmlscript::importDialogModel(xSource->createInputStream(), xDialog, mxContext, mxDocModel);
+    }
+    catch (const uno::Exception&)
+    {
+        DBG_UNHANDLED_EXCEPTION("oox");
+        xDialog.clear();
+    }
+    return xDialog;
+}
+
+OUString VbaFormExporter::getCaption(const uno::Reference<container::XNameContainer>& xDialog)
+{
+    OUString aCaption;
+    uno::Reference<beans::XPropertySet> xProps(xDialog, uno::UNO_QUERY);
+    if (xProps.is())
+        xProps->getPropertyValue(u"Title"_ustr) >>= aCaption;
+    return aCaption;
+}
+
+std::vector<OUString>
+VbaFormExporter::getUnsupportedControls(const uno::Reference<container::XNameContainer>& xDialog)
+{
+    std::vector<OUString> aNames;
+    if (!xDialog.is())
+        return aNames;
+    for (const OUString& rName : xDialog->getElementNames())
+    {
+        if (rName.startsWith(DUMMY_GROUP_SEP))
+            continue;
+        uno::Reference<beans::XPropertySet> xProps(xDialog->getByName(rName), uno::UNO_QUERY);
+        uno::Reference<lang::XServiceInfo> xInfo(xProps, uno::UNO_QUERY);
+        if (lclClassOf(xInfo, xProps) == SITE_UNSUPPORTED)
+            aNames.push_back(rName);
+        uno::Reference<container::XNameContainer> xNested(xProps, uno::UNO_QUERY);
+        if (xNested.is())
+            for (const OUString& rInner : getUnsupportedControls(xNested))
+                aNames.push_back(rInner);
+    }
+    return aNames;
+}
+
+void VbaFormExporter::exportForm(SotStorage& rProjectRoot, const OUString& rForm,
+                                 const uno::Reference<container::XNameContainer>& xDialog,
+                                 rtl_TextEncoding eTextEncoding) const
+{
+    GraphicHelper aGraphicHelper(mxContext, uno::Reference<frame::XFrame>(), StorageRef());
+    UnitConverter aUnits(aGraphicHelper);
+    ControlConverter aConv(mxDocModel, aGraphicHelper, true);
+
+    OUString aCaption = rForm;
+    AxPairData aSize(11000, 8000); // the Office default form size
+    sal_uInt32 nBackColor = AX_SYSCOLOR_BUTTONFACE;
+    sal_Int32 nNextId = 1;
+    std::vector<ControlNodeRef> aRoots;
+    if (xDialog.is())
+    {
+        uno::Reference<beans::XPropertySet> xProps(xDialog, uno::UNO_QUERY);
+        aCaption = getCaption(xDialog);
+        aSize = { aUnits.toHmmX(lclGetInt(xProps, u"Width"_ustr)), aUnits.toHmmY(lclGetInt(xProps, u"Height"_ustr)) };
+        PropertySet aPropSet(xProps);
+        ControlConverter::convertToMSColor(aPropSet, PROP_BackgroundColor, nBackColor, AX_SYSCOLOR_BUTTONFACE);
+        aRoots = lclBuildTree(xDialog, aUnits, aConv, nNextId);
+        sal_Int32 nGroup = 0;
+        lclAssignOptionGroups(aRoots, nGroup);
+    }
+
+    rtl::Reference<SotStorage> xForm = rProjectRoot.OpenSotStorage(rForm, StreamMode::READWRITE | StreamMode::TRUNC);
+    const SvGlobalName aFormClass(0xC62A69F0, 0x16DC, 0x11CE, 0x9E, 0x98, 0x00, 0xAA, 0x00, 0x57, 0x4A, 0x4F);
+    lclPrepareStorage(*xForm, aFormClass, "Microsoft Forms 2.0 Form", "Forms.Form.1");
+
+    // \003VBFrame: VB source text of the designer; sizes in twips, quotes doubled
+    const sal_Int32 nTwipsX = o3tl::convert(aSize.first, o3tl::Length::mm100, o3tl::Length::twip);
+    const sal_Int32 nTwipsY = o3tl::convert(aSize.second, o3tl::Length::mm100, o3tl::Length::twip);
+    const OUString aFrame = "VERSION 5.00\r\nBegin {C62A69F0-16DC-11CE-9E98-00AA00574A4F} " + rForm
+                            + " \r\n   Caption         =   \"" + aCaption.replaceAll("\"", "\"\"")
+                            + "\"\r\n   ClientHeight    =   " + OUString::number(nTwipsY)
+                            + "\r\n   ClientLeft      =   45\r\n   ClientTop       =   390"
+                            + "\r\n   ClientWidth     =   " + OUString::number(nTwipsX)
+                            + "\r\n   StartUpPosition =   1  'CenterOwner\r\n   TypeInfoVer     =   1\r\nEnd\r\n";
+    const OString aFrameBytes = OUStringToOString(aFrame, eTextEncoding);
+    rtl::Reference<SotStorageStream> xFrame = xForm->OpenSotStream(u"\003VBFrame"_ustr, StreamMode::READWRITE | StreamMode::TRUNC);
+    xFrame->WriteBytes(aFrameBytes.getStr(), aFrameBytes.getLength());
+    xFrame->Commit();
+
+    lclWriteContainer(*xForm, aRoots, aSize, OUString(), true, nBackColor, 0, nNextId);
+    xForm->Commit();
+}
+}
