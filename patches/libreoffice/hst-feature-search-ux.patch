+// HST Office: the tab control of the notebookbar
+TabControl* findTabControl(vcl::Window* pWindow)
+{
+    for (vcl::Window* pChild = pWindow ? pWindow->GetWindow(GetWindowType::FirstChild) : nullptr;
+         pChild; pChild = pChild->GetWindow(GetWindowType::Next))
+    {
+        if (TabControl* pTabs = dynamic_cast<TabControl*>(pChild))
+            return pTabs;
+        if (TabControl* pFound = findTabControl(pChild))
+            return pFound;
+    }
+    return nullptr;
+}
