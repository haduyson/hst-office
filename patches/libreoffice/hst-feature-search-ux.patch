+// HST Office: how rNeedle occurs in rHaystack: 6 the whole text, 5 at the start up to a word end,
+// 4 a whole word, 3 at the start inside the first word, 2 at a word start, 1 inside a word, 0 not
+sal_Int32 matchStrength(OUString const& rHaystack, OUString const& rNeedle)
+{
+    if (rHaystack.isEmpty() || rNeedle.isEmpty())
+        return 0;
+    if (rHaystack == rNeedle)
+        return 6;
+    sal_Int32 nBest = 0;
+    for (sal_Int32 nPos = rHaystack.indexOf(rNeedle); nPos >= 0 && nBest < 5;
+         nPos = rHaystack.indexOf(rNeedle, nPos + 1))
+    {
+        const sal_Int32 nEnd = nPos + rNeedle.getLength();
+        const bool bWordStart = nPos == 0 || !u_isalnum(rHaystack[nPos - 1]);
+        const bool bWordEnd = nEnd == rHaystack.getLength() || !u_isalnum(rHaystack[nEnd]);
+        sal_Int32 nStrength = 1;
+        if (nPos == 0)
+            nStrength = bWordEnd ? 5 : 3;
+        else if (bWordStart)
+            nStrength = bWordEnd ? 4 : 2;
+        nBest = std::max(nBest, nStrength);
+    }
+    return nBest;
+}
+
+/** HST Office: rank of a search result, 0 when it does not match. The own label (menu or ribbon)
+    counts most, from the whole label down to a word that starts with the text, then the search
+    keywords (FeatureSearch.xcu), then the menu or ribbon path, then every typed word anywhere.
+    HST commands and the commands that have keywords (the often used ones) rank a little higher,
+    so "tien" lists "Định dạng tiền VND" before "Ngôn ngữ giao diện ▸ Tiếng Việt".
+    tests/unit/test_feature_search_ux.py mirrors this function. */
+sal_Int32 scoreMatch(MenuContent const& rContent, OUString const& rQuery)
+{
+    static constexpr sal_Int32 aLabelScore[] = { 0, 30, 70, 80, 90, 95, 100 };
+    sal_Int32 nScore = aLabelScore[std::max(matchStrength(rContent.m_aSearchableLabel, rQuery),
+                                            matchStrength(rContent.m_aSearchableRibbonLabel, rQuery))];
+    const sal_Int32 nKeyword = matchStrength(rContent.m_aSearchableKeywords, rQuery);
+    nScore = std::max(nScore, nKeyword >= 4 ? sal_Int32(75) : nKeyword >= 2 ? sal_Int32(65) : 0);
+    const sal_Int32 nPath = matchStrength(rContent.m_aSearchableMenuLabel, rQuery);
+    nScore = std::max(nScore, nPath >= 4 ? sal_Int32(50)
+                              : nPath >= 2 ? sal_Int32(40)
+                              : nPath == 1 ? sal_Int32(25) : 0);
+    if (nScore == 0
+        && containsAllWords(rQuery, rContent.m_aSearchableMenuLabel,
+                            rContent.m_aSearchableTooltip + u" " + rContent.m_aSearchableKeywords))
+        nScore = 20;
+    if (nScore == 0)
+        return 0;
+    if (!rContent.m_aCommandURL.startsWith(".uno:"))
+        nScore += 8;
+    if (!rContent.m_aSearchableKeywords.isEmpty())
+        nScore += 5;
+    return nScore;
+}
+
+// HST Office: the first entry of the index that runs rCommand
+MenuContent const* findContent(MenuContent const& rMenuContent, OUString const& rCommand)
+{
+    for (MenuContent const& rSub : rMenuContent.m_aSubMenuContent)
+    {
+        if (rSub.m_aCommandURL == rCommand && rSub.m_aSubMenuContent.empty())
+            return &rSub;
+        if (MenuContent const* pFound = findContent(rSub, rCommand))
+            return pFound;
+    }
+    return nullptr;
+}
