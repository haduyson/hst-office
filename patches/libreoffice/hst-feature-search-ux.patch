+// HST Office: put rCommand first in the list of commands run from the search ("module command")
+void rememberCommand(OUString const& rModule, OUString const& rCommand)
+{
+    if (rModule.isEmpty() || rCommand.isEmpty())
+        return;
+    try
+    {
+        uno::Reference<lang::XMultiServiceFactory> xProvider(
+            configuration::theDefaultProvider::get(comphelper::getProcessComponentContext()));
+        uno::Sequence<uno::Any> aArgs{ uno::Any(
+            beans::NamedValue(u"nodepath"_ustr, uno::Any(aFeatureSearchNode))) };
+        uno::Reference<container::XNameReplace> xNode(
+            xProvider->createInstanceWithArguments(
+                u"com.sun.star.configuration.ConfigurationUpdateAccess"_ustr, aArgs),
+            uno::UNO_QUERY_THROW);
+        uno::Sequence<OUString> aOld;
+        xNode->getByName(u"Recent"_ustr) >>= aOld;
+        const OUString aEntry = rModule + " " + rCommand;
+        std::vector<OUString> aNew{ aEntry };
+        for (OUString const& rOld : aOld)
+        {
+            if (rOld != aEntry && aNew.size() < nRecentKept)
+                aNew.push_back(rOld);
+        }
+        xNode->replaceByName(u"Recent"_ustr, uno::Any(comphelper::containerToSequence(aNew)));
+        uno::Reference<util::XChangesBatch>(xNode, uno::UNO_QUERY_THROW)->commitChanges();
+    }
+    catch (const uno::Exception&)
+    {
+        // the extension that declares the node is not installed: nothing to remember
+        TOOLS_WARN_EXCEPTION("sfx", "CommandPopup: remembering the command failed");
+    }
+}
