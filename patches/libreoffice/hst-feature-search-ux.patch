+
+void MenuContentHandler::gatherRibbonContent()
+{
+    VclPtr<vcl::Window> xWindow
+        = m_xFrame.is() ? VCLUnoHelper::GetWindow(m_xFrame->getContainerWindow()) : nullptr;
+    SystemWindow* pSystem = xWindow ? xWindow->GetSystemWindow() : nullptr;
+    NotebookBar* pBar = pSystem ? pSystem->GetNotebookBar().get() : nullptr;
+    if (!pBar || !pBar->IsVisible()) // classic menus and toolbars: the menu path stays
+        return;
+    TabControl* pTabs = findTabControl(pBar);
+    if (!pTabs)
+        return;
+    // the tabs that are always there first, then the contextual ones (table, image, ...)
+    for (const bool bContextual : { false, true })
+    {
+        for (sal_uInt16 nPos = 0; nPos < pTabs->GetPageCount(); ++nPos)
+        {
+            const sal_uInt16 nId = pTabs->GetPageId(nPos);
+            TabPage* pPage = pTabs->GetTabPage(nId);
+            if (!pPage || pPage->HasContext(vcl::EnumContext::Context::Any) == bContextual)
+                continue;
+            const OUString aTab = pTabs->GetPageText(nId).replaceAll("~", "");
+            if (!aTab.isEmpty())
+                gatherRibbonCommands(*pPage, aTab);
+        }
+    }
+}
+
+void MenuContentHandler::gatherRibbonCommands(vcl::Window& rParent, OUString const& rTab)
+{
+    // groups folded into a "Group ▾" button keep their content as hidden children
+    for (vcl::Window* pChild = rParent.GetWindow(GetWindowType::FirstChild); pChild;
+         pChild = pChild->GetWindow(GetWindowType::Next))
+    {
+        if (ToolBox* pToolBox = dynamic_cast<ToolBox*>(pChild))
+        {
+            for (ToolBox::ImplToolItems::size_type nPos = 0; nPos < pToolBox->GetItemCount(); ++nPos)
+            {
+                if (pToolBox->GetItemType(nPos) != ToolBoxItemType::BUTTON)
+                    continue;
+                const ToolBoxItemId nId = pToolBox->GetItemId(nPos);
+                const OUString aCommand = pToolBox->GetItemCommand(nId);
+                if (aCommand.isEmpty() || !pToolBox->IsItemVisible(nId)
+                    || m_aRibbonIndex.contains(aCommand))
+                    continue;
+                m_aRibbonIndex.emplace(aCommand, m_aRibbon.size());
+                m_aRibbon.push_back(
+                    { aCommand, rTab, pToolBox->GetItemText(nId).replaceAll("~", "").trim() });
+            }
+        }
+        gatherRibbonCommands(*pChild, rTab);
+    }
+}
+
+// HST Office: commands with search keywords that neither the menus nor the ribbon list, e.g. the
+// items of a popup menu built at run time (Sheets "Định dạng có điều kiện ▸ Giá trị trùng lặp",
+// .uno:ConditionalFormatEasy?FormatRule:short=8). Only commands the module has a label for are
+// added, so the commands of another application stay out.
+void MenuContentHandler::addKeywordOnlyContent()
+{
+    std::vector<OUString> aCommands;
+    for (auto const& rKeywords : m_aKeywords)
+    {
+        if (rKeywords.first.startsWith(".uno:") && !m_aIndexed.contains(rKeywords.first))
+            aCommands.push_back(rKeywords.first);
+    }
+    std::sort(aCommands.begin(), aCommands.end()); // the same order at every opening
+    for (OUString const& rCommand : aCommands)
+    {
+        auto aCommandProperties
+            = vcl::CommandInfoProvider::GetCommandProperties(rCommand, m_sModuleLongName);
+        MenuContent aNewContent;
+        aNewContent.m_aCommandURL = rCommand;
+        aNewContent.m_aMenuLabel
+            = vcl::CommandInfoProvider::GetLabelForCommand(aCommandProperties).replaceAll("~", "");
+        if (aNewContent.m_aMenuLabel.isEmpty())
+            continue;
+        aNewContent.m_aFullLabelWithPath = aNewContent.m_aMenuLabel;
+        aNewContent.m_aTooltip = vcl::CommandInfoProvider::GetTooltipForCommand(
+            rCommand, aCommandProperties, m_xFrame);
+        setSearchKeys(aNewContent);
+        m_aMenuContent.m_aSubMenuContent.push_back(std::move(aNewContent));
+    }
+}
+
+void MenuContentHandler::addRibbonOnlyContent()
+{
+    std::u16string_view aSeparator = AllSettings::GetLayoutRTL() ? u" ◂ " : u" ▸ ";
+    for (RibbonCommand const& rRibbon : m_aRibbon)
+    {
+        if (m_aIndexed.contains(rRibbon.m_aCommandURL))
+            continue;
+        MenuContent aNewContent;
+        aNewContent.m_aCommandURL = rRibbon.m_aCommandURL;
+        aNewContent.m_aMenuLabel = rRibbon.m_aLabel;
+        if (rRibbon.m_aCommandURL.startsWith(".uno:"))
+        {
+            auto aCommandProperties = vcl::CommandInfoProvider::GetCommandProperties(
+                rRibbon.m_aCommandURL, m_sModuleLongName);
+            if (aNewContent.m_aMenuLabel.isEmpty())
+                aNewContent.m_aMenuLabel
+                    = vcl::CommandInfoProvider::GetLabelForCommand(aCommandProperties);
+            aNewContent.m_aTooltip = vcl::CommandInfoProvider::GetTooltipForCommand(
+                rRibbon.m_aCommandURL, aCommandProperties, m_xFrame);
+        }
+        if (aNewContent.m_aMenuLabel.isEmpty())
+            continue;
+        aNewContent.m_aFullLabelWithPath = rRibbon.m_aTab + aSeparator + aNewContent.m_aMenuLabel;
+        setSearchKeys(aNewContent);
+        m_aMenuContent.m_aSubMenuContent.push_back(std::move(aNewContent));
+    }
 }
 
