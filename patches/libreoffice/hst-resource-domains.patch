--- /dev/null
+++ b/postprocess/Package_hst_catalogs.mk
@@ -0,0 +1,34 @@
+# SPDX-License-Identifier: LicenseRef-HST-Proprietary
+# Install the compiled HST domains via the core package's platform-specific file list.
+$(eval $(call gb_Package_Package,postprocess_hst_catalogs,$(WORKDIR)/MoTarget))
+$(eval $(call gb_Postprocess_register_target,AllResources,Package,postprocess_hst_catalogs))
+
+hst_catalog_manifest := $(SRCDIR)/hst/l10n/domains.hxx
+hst_catalog_pairs := $(shell awk -F '[(),]' '/^HST_CATALOG/ {print $$2 ":" $$3}' "$(hst_catalog_manifest)")
+ifeq ($(strip $(hst_catalog_pairs)),)
+$(error HST translation domains missing from $(hst_catalog_manifest))
+endif
+
+# Compile the two composed catalogs with the same MoTarget rule as their upstream counterparts.
+define hst_catalog_compile
+$(call gb_MoTarget_get_target,hst-$(1)$(3)) : private HST_CATALOG_PO := $(SRCDIR)/hst/l10n/translations/source/$(3)/$(2)/messages.po
+$(call gb_MoTarget_get_target,hst-$(1)$(3)) : $(SRCDIR)/hst/l10n/translations/source/$(3)/$(2)/messages.po
+$(call gb_Package_get_clean_target,postprocess_hst_catalogs) : FILES += $(call gb_MoTarget_get_target,hst-$(1)$(3))
+
+endef
+
+# Use the original compiled MO verbatim for languages without a separate overlay.
+define hst_catalog_install
+$(if $(filter vi en-US,$(3)),$(call hst_catalog_compile,$(1),$(2),$(3)))
+$(call gb_Package_add_file,postprocess_hst_catalogs,$(LIBO_SHARE_RESOURCE_FOLDER)/$(4)/LC_MESSAGES/hst-$(1).mo,$(if $(filter vi en-US,$(3)),hst-)$(1)$(3).mo)
+
+endef
+
+hst_catalog_langs := en-US $(filter-out en-US qtz,$(gb_WITH_LANG))
+$(foreach lang,$(hst_catalog_langs),$(eval hst_catalog_dir_$(lang) := $(shell $(SRCDIR)/solenv/bin/localestr $(lang))))
+$(foreach pair,$(hst_catalog_pairs), \
+    $(foreach lang,$(hst_catalog_langs), \
+        $(if $(or $(filter vi en-US,$(lang)),$(filter $(firstword $(subst :, ,$(pair))),$(gb_AllLangMoTarget_REGISTERED))), \
+            $(eval $(call hst_catalog_install,$(firstword $(subst :, ,$(pair))),$(lastword $(subst :, ,$(pair))),$(lang),$(hst_catalog_dir_$(lang)))))))
+
+$(call gb_Package_get_target,postprocess_hst_catalogs) : $(hst_catalog_manifest) $(gb_Helper_LANGSTARGET)
