+vcl::Window* BackstageWindow::GetClientWindow() const { return m_xClient.get(); }
+
+bool BackstageWindow::Place()
+{
+    tools::Rectangle aAnchor;
+    Size aSize;
+    vcl::Window* pClient = GetClientWindow();
+    vcl::Window* pContainer = VCLUnoHelper::GetWindow(m_xFrame->getContainerWindow());
+    vcl::Window* pFrameWindow = pContainer ? pContainer->GetFrameWindow() : nullptr;
+    if (!pClient || !pFrameWindow || !GetPlacement(aAnchor, aSize))
+        return false;
+    // GetPlacement gives the anchor of a drop-down: in the frame window's pixels for GTK, else in
+    // its client window's; the panel's top-left corner is the anchor's
+    vcl::Window* pOrigin = Application::GetToolkitName().startsWith("gtk")
+                               ? pFrameWindow
+                               : pFrameWindow->GetWindow(GetWindowType::Client);
+    if (!pOrigin)
+        return false;
+    const Point aPos
+        = pClient->AbsoluteScreenToOutputPixel(pOrigin->OutputToAbsoluteScreenPixel(aAnchor.TopLeft()));
+    m_xPanel->set_size_request(aSize.Width(), aSize.Height());
+    m_xHost->InvalidateChildSizeCache();
+    const Size aWant = m_xHost->GetOptimalSize();
+    // never past the window's bottom and right edges: the pages scroll inside
+    const Size aRoom(pClient->GetOutputSizePixel().Width() - aPos.X(),
+                     pClient->GetOutputSizePixel().Height() - aPos.Y());
+    m_xHost->SetPosSizePixel(aPos, Size(std::min(aWant.Width(), aRoom.Width()),
+                                        std::min(aWant.Height(), aRoom.Height())));
+    m_xHost->SetZOrder(nullptr, ZOrderFlags::First); // above the document and the ribbon
+    return true;
+}
+
+IMPL_LINK(BackstageWindow, ClientEventHdl, VclWindowEvent&, rEvent, void)
+{
+    if (rEvent.GetId() == VclEventId::ObjectDying)
+    {
+        m_xClient->RemoveEventListener(LINK(this, BackstageWindow, ClientEventHdl));
+        m_xClient.reset();
+        return;
+    }
+    // maximize, restore, snap and resize: the ribbon lays itself out first
+    if (rEvent.GetId() == VclEventId::WindowResize && m_bOpen && !m_pPendingPlace)
+        m_pPendingPlace = Application::PostUserEvent(LINK(this, BackstageWindow, PlaceHdl));
+}
+
+IMPL_LINK_NOARG(BackstageWindow, PlaceHdl, void*, void)
+{
+    m_pPendingPlace = nullptr;
+    if (m_bOpen && !Place())
+        Close(); // no room under the ribbon any more
+}
+
+/* A press of a mouse button in the panel's window but outside the panel and the File title band
+   closes the panel, as the click outside a drop-down did. The window's title bar and frame are not
+   VCL windows: moving, snapping and resizing the window keep the panel open. */
+IMPL_LINK(BackstageWindow, AppEventHdl, VclSimpleEvent&, rEvent, void)
+{
+    if (!m_bOpen || rEvent.GetId() != VclEventId::WindowMouseButtonDown)
+        return;
+    vcl::Window* pWindow = static_cast<VclWindowEvent&>(rEvent).GetWindow();
+    if (!pWindow || !m_xClient || !m_xClient->IsWindowOrChild(pWindow))
+        return; // another window: a dialog, another document
+    if (m_xHost->IsWindowOrChild(pWindow)
+        || (m_xTitleBand && !m_xTitleBand->isDisposed() && m_xTitleBand->IsWindowOrChild(pWindow)))
+        return;
+    m_nDismissedAt = tools::Time::GetSystemTicks();
+    Close();
+}
+
+bool BackstageWindow::WasJustDismissed() const
+{
+    return m_nDismissedAt && tools::Time::GetSystemTicks() - m_nDismissedAt <= DISMISS_CLICK_MS;
+}
+
 void BackstageWindow::Close()
 {
     if (!m_bOpen)
         return;
     m_bOpen = false;
+    Application::RemoveEventListener(LINK(this, BackstageWindow, AppEventHdl));
+    if (m_xClient)
+        m_xClient->RemoveEventListener(LINK(this, BackstageWindow, ClientEventHdl));
     m_xPrintPage->Deactivate(); // a print job waiting on the Print page is cancelled
-    m_xPopover->popdown();
+    m_xHost->Hide();
     ShowTitleBand(false);
     FocusDocument();
 }
