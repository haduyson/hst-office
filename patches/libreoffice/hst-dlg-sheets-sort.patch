     m_xBtnLeftRight->connect_toggled( aLink );
     m_xBtnHeader->connect_toggled( aLink );
+    m_xBtnAddLevel->connect_clicked(LINK(this, ScTabPageSortFields, AddLevelHdl));
+    m_xBtnDeleteLevel->connect_clicked(LINK(this, ScTabPageSortFields, DeleteLevelHdl));
 
     const ScSortItem& rSortItem = GetItemSet().Get( nWhichSort );
 
@@ -432,6 +436,22 @@
         for ( sal_uInt16 i=0; i<nSortKeyCount; i++ )
             m_aSortWin.m_aSortKeyItems[i]->m_xLbSort->set_active(nCurSel[i]);
     }
+}
+
+// HST: Excel's Add Level and Delete Level (levels are also added as the last one gets a column).
+IMPL_LINK_NOARG(ScTabPageSortFields, AddLevelHdl, weld::Button&, void)
+{
+    SetLastSortKey(nSortKeyCount);
+}
+
+IMPL_LINK_NOARG(ScTabPageSortFields, DeleteLevelHdl, weld::Button&, void)
+{
+    if (nSortKeyCount <= 1)
+        return;
+    m_aSortWin.m_aSortKeyItems.pop_back();
+    --nSortKeyCount;
+    if (aSortData.maKeyState.size() > nSortKeyCount)
+        aSortData.maKeyState.resize(nSortKeyCount);
 }
 
 IMPL_LINK( ScTabPageSortFields, SelectHdl, weld::ComboBox&, rLb, void )
