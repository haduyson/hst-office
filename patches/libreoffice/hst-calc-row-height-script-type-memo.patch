+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ * Copyright (c) HST Office.
+ */
+
+#pragma once
+
+#include <cstdlib>
+#include <functional>
+#include <unordered_map>
+#include <vector>
+
+#include <rtl/ustring.hxx>
+#include <sal/types.h>
+
+enum class SvtScriptType : sal_uInt8;
+
+namespace sc
+{
+/** Script types of text cells already determined in one search of a column range for cells measured as edit text
+    (ScColumn::HasEditCells, run by the optimal row height pass for each range of equal cell formats).
+
+    The script type of a text cell (Latin, Asian, complex) is found by formatting the cell and running the script
+    detection over the whole text. After loading, the optimal row height pass determines it for every text cell of
+    the sheet, and a large workbook repeats the same strings a lot (codes, names, units): a sheet of 5.3 million
+    text cells over 1.2 million distinct strings spent about a tenth of its loading time there. For a text cell
+    without a conditional format the result depends only on the pooled string and the number format, so it is
+    determined once per (string, number format) in a pass and reused. The memo holds a reference to each string it keys. The environment variable HST_SC_SCRIPT_TYPE_MEMO_OFF determines every cell on its
+    own as before (read once per process). */
+class HstScriptTypeMemo
+{
+public:
+    HstScriptTypeMemo()
+        : mbEnabled(enabled())
+    {
+    }
+
+    bool isEnabled() const { return mbEnabled; }
+
+    const SvtScriptType* find(const rtl_uString* pString, sal_uInt32 nFormat) const
+    {
+        auto it = maTypes.find(Key{ pString, nFormat });
+        return it == maTypes.end() ? nullptr : &it->second;
+    }
+
+    void insert(const rtl_uString* pString, sal_uInt32 nFormat, SvtScriptType eType)
+    {
+        if (maTypes.size() >= MAX_ENTRIES)
+        {
+            maTypes.clear();
+            maStrings.clear();
+        }
+        if (maTypes.emplace(Key{ pString, nFormat }, eType).second)
+            maStrings.emplace_back(const_cast<rtl_uString*>(pString)); // a key never outlives its string
+    }
+
+private:
+    static bool enabled()
+    {
+        static const bool bEnabled = !std::getenv("HST_SC_SCRIPT_TYPE_MEMO_OFF");
+        return bEnabled;
+    }
+
+    static constexpr size_t MAX_ENTRIES = 1 << 17; // bounds the memory of a search over many distinct strings
+
+    struct Key
+    {
+        const rtl_uString* mpString;
+        sal_uInt32 mnFormat;
+        bool operator==(const Key& rOther) const
+        {
+            return mpString == rOther.mpString && mnFormat == rOther.mnFormat;
+        }
+    };
+    struct KeyHash
+    {
+        size_t operator()(const Key& rKey) const
+        {
+            return std::hash<const void*>()(rKey.mpString) ^ (static_cast<size_t>(rKey.mnFormat) * 0x9e3779b97f4a7c15ULL);
+        }
+    };
+
+    bool mbEnabled;
+    std::unordered_map<Key, SvtScriptType, KeyHash> maTypes;
+    std::vector<OUString> maStrings;
+};
+}
