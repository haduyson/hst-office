+CPPUNIT_TEST_FIXTURE(TestCondformat, testScriptTypesOncePerStringAndFormat)
+{
+    // The optimal row height pass searches each range of equal cell formats for cells to measure as edit text and
+    // determines the script type of a text cell once per pooled string and number format there. Every cell must
+    // get the script type of its own formatted text: Latin, Asian and complex texts repeated down a column, and
+    // digits stored as text, shown plain or through a format that puts an Asian character in front.
+    m_pDoc->InsertTab(0, u"Test"_ustr);
+    const OUString aTexts[] = { u"Tiếng Việt"_ustr, u"漢字"_ustr, u"مرحبا"_ustr };
+    ScSetStringParam aText;
+    aText.setTextInput();
+    constexpr SCROW nRows = 200;
+    for (SCROW nRow = 0; nRow < nRows; ++nRow)
+    {
+        m_pDoc->SetString(ScAddress(0, nRow, 0), nRow % 2 ? u"123"_ustr : u"456"_ustr, &aText);
+        m_pDoc->SetString(ScAddress(1, nRow, 0), aTexts[nRow % 3], &aText);
+    }
+    OUString aCode = u"\"漢\"@"_ustr;
+    sal_Int32 nCheckPos;
+    SvNumFormatType nType;
+    sal_uInt32 nFormat;
+    m_pDoc->GetFormatTable()->PutEntry(aCode, nCheckPos, nType, nFormat);
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(0), nCheckPos);
+    ScPatternAttr aPattern(m_pDoc->getCellAttributeHelper());
+    aPattern.ItemSetPut(SfxUInt32Item(ATTR_VALUE_FORMAT, nFormat));
+    m_pDoc->ApplyPatternAreaTab(0, 100, 0, 149, 0, aPattern);
+
+    m_xDocShell->AdjustRowHeight(0, nRows - 1, 0);
+    for (SCROW nRow = 0; nRow < nRows; ++nRow)
+        for (SCCOL nCol = 0; nCol < 2; ++nCol)
+            CPPUNIT_ASSERT_EQUAL_MESSAGE(
+                ScAddress(nCol, nRow, 0).Format(ScRefFlags::VALID).toUtf8().getStr(),
+                m_pDoc->GetStringScriptType(m_pDoc->GetString(nCol, nRow, 0)), m_pDoc->GetScriptType(nCol, nRow, 0));
+    // the same pooled string "123" has another script type behind the Asian prefix
+    CPPUNIT_ASSERT(m_pDoc->GetScriptType(0, 101, 0) != m_pDoc->GetScriptType(0, 99, 0));
+    CPPUNIT_ASSERT_EQUAL(SvtScriptType::ASIAN, m_pDoc->GetScriptType(1, 1, 0));
+    CPPUNIT_ASSERT_EQUAL(SvtScriptType::COMPLEX, m_pDoc->GetScriptType(1, 2, 0));
+
+    m_pDoc->DeleteTab(0);
+}
+
 CPPUNIT_PLUGIN_IMPLEMENT();
 
