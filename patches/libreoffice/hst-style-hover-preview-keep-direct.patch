 class HstStylePreview final : public cppu::WeakImplHelper<css::document::XDocumentEventListener>
 {
+    /** A previewed paragraph: its style and its direct formatting (DIRECT_VALUE properties). */
+    struct Paragraph
+    {
+        css::uno::Reference<css::beans::XPropertySet> xProps;
+        OUString aStyle;
+        std::vector<OUString> aDirect;
+        std::vector<css::uno::Any> aValues;
+    };
+
+    /** The writable properties of the paragraph, and their states (DEFAULT_VALUE where unknown). */
+    static std::pair<css::uno::Sequence<OUString>, css::uno::Sequence<css::beans::PropertyState>>
+    States(const css::uno::Reference<css::beans::XPropertySet>& xProps)
+    {
+        std::vector<OUString> aNames;
+        for (const css::beans::Property& rProperty : xProps->getPropertySetInfo()->getProperties())
+            if (!(rProperty.Attributes & css::beans::PropertyAttribute::READONLY)
+                && rProperty.Name != "ParaStyleName" && rProperty.Name != "ParaConditionalStyleName")
+                aNames.push_back(rProperty.Name);
+        const css::uno::Sequence<OUString> aSeq(aNames.data(), aNames.size());
+        css::uno::Reference<css::beans::XPropertyState> xState(xProps, css::uno::UNO_QUERY_THROW);
+        try
+        {
+            return { aSeq, xState->getPropertyStates(aSeq) };
+        }
+        catch (const css::uno::Exception&)
+        {
+            // one property without a state spoils the batch: ask one by one
+            css::uno::Sequence<css::beans::PropertyState> aStates(aSeq.getLength());
+            auto pStates = aStates.getArray();
+            for (sal_Int32 i = 0; i < aSeq.getLength(); ++i)
+            {
+                try
+                {
+                    pStates[i] = xState->getPropertyState(aSeq[i]);
+                }
+                catch (const css::uno::Exception&)
+                {
+                    pStates[i] = css::beans::PropertyState_DEFAULT_VALUE;
+                }
+            }
+            return { aSeq, aStates };
+        }
+    }
+
+    static void Snapshot(Paragraph& rParagraph)
+    {
+        const auto [aNames, aStates] = States(rParagraph.xProps);
+        for (sal_Int32 i = 0; i < aNames.getLength(); ++i)
+        {
+            if (aStates[i] != css::beans::PropertyState_DIRECT_VALUE)
+                continue;
+            try
+            {
+                css::uno::Any aValue = rParagraph.xProps->getPropertyValue(aNames[i]);
+                rParagraph.aDirect.push_back(aNames[i]);
+                rParagraph.aValues.push_back(std::move(aValue));
+            }
+            catch (const css::uno::Exception&)
+            {
+            }
+        }
+    }
+
+    /** After the style is back: what the preview made direct goes back to the style, and the saved
+        direct formatting is set again, numbering first (the list, then the level and restart). */
+    static void Restore(const Paragraph& rParagraph)
+    {
+        css::uno::Reference<css::beans::XPropertyState> xState(rParagraph.xProps, css::uno::UNO_QUERY_THROW);
+        const auto [aNames, aStates] = States(rParagraph.xProps);
+        for (sal_Int32 i = 0; i < aNames.getLength(); ++i)
+        {
+            if (aStates[i] == css::beans::PropertyState_DIRECT_VALUE
+                && std::find(rParagraph.aDirect.begin(), rParagraph.aDirect.end(), aNames[i])
+                       == rParagraph.aDirect.end())
+            {
+                try
+                {
+                    xState->setPropertyToDefault(aNames[i]);
+                }
+                catch (const css::uno::Exception&)
+                {
+                }
+            }
+        }
+        static constexpr std::u16string_view aFirst[]
+            = { u"NumberingStyleName", u"ListId", u"NumberingLevel", u"NumberingIsNumber",
+                u"ParaIsNumberingRestart", u"NumberingStartValue" };
+        std::vector<size_t> aOrder(rParagraph.aDirect.size());
+        for (size_t i = 0; i < aOrder.size(); ++i)
+            aOrder[i] = i;
+        const auto rank = [&](size_t i) {
+            const auto it = std::find(std::begin(aFirst), std::end(aFirst), rParagraph.aDirect[i]);
+            return static_cast<size_t>(it - std::begin(aFirst));
+        };
+        std::stable_sort(aOrder.begin(), aOrder.end(), [&](size_t a, size_t b) { return rank(a) < rank(b); });
+        for (size_t i : aOrder)
+        {
+            const OUString& rName = rParagraph.aDirect[i];
+            try
+            {
+                if (xState->getPropertyState(rName) == css::beans::PropertyState_DIRECT_VALUE
+                    && rParagraph.xProps->getPropertyValue(rName) == rParagraph.aValues[i])
+                    continue; // kept by the style change (page break, page style, hints)
+                rParagraph.xProps->setPropertyValue(rName, rParagraph.aValues[i]);
+            }
+            catch (const css::uno::Exception&)
+            {
+            }
+        }
+    }
+
