+/// Writes a zip archive of stored (uncompressed) entries: enough for a minimal .xlsx built by a test.
+void writeStoredZip(const OUString& rURL, const std::vector<std::pair<OString, OString>>& rEntries)
+{
+    SvFileStream aStream(rURL, StreamMode::WRITE | StreamMode::TRUNC);
+    aStream.SetEndian(SvStreamEndian::LITTLE);
+    std::vector<sal_uInt32> aOffsets;
+    for (const auto& [rName, rData] : rEntries)
+    {
+        aOffsets.push_back(aStream.Tell());
+        const sal_uInt32 nCrc = rtl_crc32(0, rData.getStr(), rData.getLength());
+        // signature, version, flags, method (stored), time, date (1980-01-01), crc, sizes, name and extra lengths
+        aStream.WriteUInt32(0x04034b50).WriteUInt16(20).WriteUInt16(0).WriteUInt16(0);
+        aStream.WriteUInt16(0).WriteUInt16(0x21).WriteUInt32(nCrc);
+        aStream.WriteUInt32(rData.getLength()).WriteUInt32(rData.getLength());
+        aStream.WriteUInt16(rName.getLength()).WriteUInt16(0);
+        aStream.WriteBytes(rName.getStr(), rName.getLength());
+        aStream.WriteBytes(rData.getStr(), rData.getLength());
+    }
+    const sal_uInt32 nDirStart = aStream.Tell();
+    for (size_t i = 0; i < rEntries.size(); ++i)
+    {
+        const auto& [rName, rData] = rEntries[i];
+        const sal_uInt32 nCrc = rtl_crc32(0, rData.getStr(), rData.getLength());
+        aStream.WriteUInt32(0x02014b50).WriteUInt16(20).WriteUInt16(20).WriteUInt16(0).WriteUInt16(0);
+        aStream.WriteUInt16(0).WriteUInt16(0x21).WriteUInt32(nCrc);
+        aStream.WriteUInt32(rData.getLength()).WriteUInt32(rData.getLength());
+        // name, extra and comment lengths, disk, internal and external attributes, offset
+        aStream.WriteUInt16(rName.getLength()).WriteUInt16(0).WriteUInt16(0);
+        aStream.WriteUInt16(0).WriteUInt16(0).WriteUInt32(0).WriteUInt32(aOffsets[i]);
+        aStream.WriteBytes(rName.getStr(), rName.getLength());
+    }
+    const sal_uInt32 nDirSize = aStream.Tell() - nDirStart;
+    aStream.WriteUInt32(0x06054b50).WriteUInt16(0).WriteUInt16(0);
+    aStream.WriteUInt16(rEntries.size()).WriteUInt16(rEntries.size());
+    aStream.WriteUInt32(nDirSize).WriteUInt32(nDirStart).WriteUInt16(0);
+    CPPUNIT_ASSERT_EQUAL(ERRCODE_NONE, aStream.GetError());
+}
+}
