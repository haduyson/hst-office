+CPPUNIT_TEST_FIXTURE(ScFiltersTest5, testXlsxSharedFormulaCachedResults)
+{
+    // B1:B4 is one shared (filled-down) formula =A1*2. B1:B3 carry cached results that differ from
+    // what the formula calculates, B4 has none. The import must keep the cached results, as it does
+    // for a formula of its own: a shared formula cell left dirty was calculated again by the first
+    // reader of its value (the optimal row height pass at the end of the import reads every cell),
+    // so large workbooks of filled-down formulas were calculated in full while loading.
+    static constexpr OString aSheet
+        = "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n"
+          "<worksheet xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\"><sheetData>"
+          "<row r=\"1\"><c r=\"A1\"><v>1</v></c>"
+          "<c r=\"B1\"><f t=\"shared\" ref=\"B1:B4\" si=\"0\">A1*2</f><v>100</v></c></row>"
+          "<row r=\"2\"><c r=\"A2\"><v>2</v></c><c r=\"B2\"><f t=\"shared\" si=\"0\"/><v>200</v></c></row>"
+          "<row r=\"3\"><c r=\"A3\"><v>3</v></c><c r=\"B3\"><f t=\"shared\" si=\"0\"/><v>300</v></c></row>"
+          "<row r=\"4\"><c r=\"A4\"><v>4</v></c><c r=\"B4\"><f t=\"shared\" si=\"0\"/></c></row>"
+          "</sheetData></worksheet>"_ostr;
+    static constexpr OString aRels = "http://schemas.openxmlformats.org/officeDocument/2006/relationships"_ostr;
+    static constexpr OString aMain
+        = "application/vnd.openxmlformats-officedocument.spreadsheetml"_ostr;
+    writeStoredZip(
+        maTempFile.GetURL(),
+        { { "[Content_Types].xml"_ostr,
+            "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n"
+            "<Types xmlns=\"http://schemas.openxmlformats.org/package/2006/content-types\">"
+            "<Default Extension=\"rels\" ContentType=\"application/vnd.openxmlformats-package.relationships+xml\"/>"
+            "<Default Extension=\"xml\" ContentType=\"application/xml\"/>"
+            "<Override PartName=\"/xl/workbook.xml\" ContentType=\""
+                + aMain + ".sheet.main+xml\"/>"
+                          "<Override PartName=\"/xl/worksheets/sheet1.xml\" ContentType=\""
+                + aMain + ".worksheet+xml\"/></Types>" },
+          { "_rels/.rels"_ostr,
+            "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n"
+            "<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\">"
+            "<Relationship Id=\"rId1\" Type=\""
+                + aRels + "/officeDocument\" Target=\"xl/workbook.xml\"/></Relationships>" },
+          { "xl/workbook.xml"_ostr,
+            "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n"
+            "<workbook xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\" xmlns:r=\""
+                + aRels + "\"><sheets><sheet name=\"Sheet1\" sheetId=\"1\" r:id=\"rId1\"/></sheets></workbook>" },
+          { "xl/_rels/workbook.xml.rels"_ostr,
+            "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n"
+            "<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\">"
+            "<Relationship Id=\"rId1\" Type=\""
+                + aRels + "/worksheet\" Target=\"worksheets/sheet1.xml\"/></Relationships>" },
+          { "xl/worksheets/sheet1.xml"_ostr, aSheet } });
+
+    loadFromURL(maTempFile.GetURL(),
+                { comphelper::makePropertyValue(u"FilterName"_ustr, u"Calc Office Open XML"_ustr) });
+    ScDocument* pDoc = getScDoc();
+
+    for (SCROW nRow = 0; nRow < 3; ++nRow)
+    {
+        const ScFormulaCell* pCell = pDoc->GetFormulaCell(ScAddress(1, nRow, 0));
+        CPPUNIT_ASSERT(pCell);
+        CPPUNIT_ASSERT_MESSAGE("shared formula cell with a cached result is dirty", !pCell->GetDirty());
+        // Without the fix this was the calculated value 2 * (nRow + 1).
+        CPPUNIT_ASSERT_EQUAL(100.0 * (nRow + 1), pDoc->GetValue(ScAddress(1, nRow, 0)));
+    }
+    // No cached result: calculated as before.
+    CPPUNIT_ASSERT_EQUAL(8.0, pDoc->GetValue(ScAddress(1, 3, 0)));
+    CPPUNIT_ASSERT_EQUAL(u"=A1*2"_ustr, pDoc->GetFormula(1, 0, 0));
+
+    // The cells still listen to their references.
+    pDoc->SetValue(ScAddress(0, 0, 0), 10.0);
+    CPPUNIT_ASSERT_EQUAL(20.0, pDoc->GetValue(ScAddress(1, 0, 0)));
+    CPPUNIT_ASSERT_EQUAL(200.0, pDoc->GetValue(ScAddress(1, 1, 0)));
+}
