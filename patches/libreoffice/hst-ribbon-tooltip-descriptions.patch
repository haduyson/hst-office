+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ArrowsToolbox"
+msgid "Draw a line or an arrow."
+msgstr "Vẽ đường thẳng hoặc mũi tên."
+
+#. hstTip
