+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:AutoFormat"
+msgid "Apply a ready-made style to the table."
+msgstr "Áp dụng một kiểu có sẵn cho bảng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:AutoSum"
+msgid "Add up the numbers above or to the left of the cell."
+msgstr "Cộng các số phía trên hoặc bên trái ô."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:AutomaticCalculation"
+msgid "Recalculate formulas automatically after every change."
+msgstr "Tự động tính lại công thức sau mỗi thay đổi."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:BackgroundColor"
+msgid "Fill the background with a colour."
+msgstr "Tô màu nền."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:BasicIDEAppear"
+msgid "Open the editor to write and change macros."
+msgstr "Mở trình soạn thảo để viết và sửa macro."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:BasicShapes"
+msgid "Draw a basic shape such as a rectangle or a circle."
+msgstr "Vẽ hình cơ bản như hình chữ nhật, hình tròn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:BasicShapes.ellipse"
+msgid "Draw an ellipse or a circle."
+msgstr "Vẽ hình elip hoặc hình tròn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:BasicShapes.rectangle"
+msgid "Draw a rectangle or a square."
+msgstr "Vẽ hình chữ nhật hoặc hình vuông."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:BelowSpacing"
+msgid "Change the space below the paragraph."
+msgstr "Đổi khoảng cách phía dưới đoạn văn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:BezierFill"
+msgid "Draw a closed curve filled with colour."
+msgstr "Vẽ một hình cong khép kín có tô màu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Bezier_Unfilled"
+msgid "Draw a smooth curved line."
+msgstr "Vẽ một đường cong trơn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:BorderDialog"
+msgid "Add a border around the page."
+msgstr "Thêm viền quanh trang."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Break"
+msgid "Split the selected object into separate parts."
+msgstr "Tách đối tượng đang chọn thành các phần riêng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:BringToFront"
+msgid "Put the selected object in front of all others."
+msgstr "Đặt đối tượng đang chọn lên trên cùng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:BrowseView"
+msgid "Show the document as a web page, without page breaks."
+msgstr "Xem tài liệu như một trang web, không chia trang."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:CalcPageMargin"
+msgid "Choose the margins of the printed page."
+msgstr "Chọn lề của trang in."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:CalcPageSize"
+msgid "Choose the paper size for printing."
+msgstr "Chọn khổ giấy để in."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Calculate"
+msgid "Recalculate all formulas now."
+msgstr "Tính lại mọi công thức ngay bây giờ."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:CalculatedFieldRun"
+msgid "Insert or edit a field calculated from other fields."
+msgstr "Chèn hoặc sửa trường được tính từ các trường khác."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:CalloutShapes"
+msgid "Draw a speech bubble or another callout."
+msgstr "Vẽ khung lời thoại hoặc khung chú dẫn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:CapturePoint"
+msgid "Add a guide line or point that objects snap to."
+msgstr "Thêm đường hoặc điểm gióng để đối tượng bám vào."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:CellVertBottom"
+msgid "Put the text at the bottom of the cell."
+msgstr "Đặt chữ sát cạnh dưới của ô."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:CellVertCenter"
+msgid "Center the text vertically in the cell."
+msgstr "Căn giữa chữ theo chiều dọc trong ô."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:CellVertTop"
+msgid "Put the text at the top of the cell."
+msgstr "Đặt chữ sát cạnh trên của ô."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ChainFrames"
+msgid "Let text flow from this frame into another."
+msgstr "Cho chữ chảy tiếp từ khung này sang khung khác."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ChangeCaseRotateCase"
+msgid "Switch the selection between sentence case, upper case and lower case."
+msgstr "Đổi chữ đang chọn qua lại giữa viết hoa đầu câu, chữ hoa, chữ thường."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ChangePicture"
+msgid "Replace the picture but keep its size and position."
+msgstr "Thay ảnh khác nhưng giữ nguyên cỡ và vị trí."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ChangeTheme"
+msgid "Switch between the light and dark appearance."
+msgstr "Chuyển qua lại giữa giao diện sáng và tối."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:CharBackColor"
+msgid "Highlight the text with a colour."
+msgstr "Tô sáng chữ bằng một màu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:CharFontName"
+msgid "Choose a font for the text."
+msgstr "Chọn phông chữ cho văn bản."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:CharmapControl"
+msgid "Insert a symbol or a character not on the keyboard."
+msgstr "Chèn ký hiệu hoặc ký tự không có trên bàn phím."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:CheckBox"
+msgid "Add a check box to the form."
+msgstr "Thêm ô đánh dấu vào biểu mẫu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ChiSquareTestDialog"
+msgid "Test whether two sets of data are related (chi-square)."
+msgstr "Kiểm tra hai bộ dữ liệu có liên quan nhau không (khi bình phương)."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ChooseDesign"
+msgid "Apply a colour and font theme to the spreadsheet."
+msgstr "Áp dụng chủ đề màu và phông chữ cho bảng tính."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ClearArrows"
+msgid "Remove all the arrows that trace formulas."
+msgstr "Xóa mọi mũi tên dò công thức."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ClearContents"
+msgid "Clear the contents of the selected cells."
+msgstr "Xóa nội dung của các ô đang chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:CloseMasterView"
+msgid "Go back to editing the slides."
+msgstr "Quay lại sửa các trang chiếu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ClosePreview"
+msgid "Close the print preview."
+msgstr "Đóng chế độ xem trước khi in."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Color"
+msgid "Change the colour of the text."
+msgstr "Đổi màu chữ."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ColorSettings"
+msgid "Show the colour palette to fill objects."
+msgstr "Hiện bảng màu để tô đối tượng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ColumnWidth"
+msgid "Set an exact width for the selected columns."
+msgstr "Đặt bề rộng chính xác cho các cột đang chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Combine"
+msgid "Combine the selected shapes into one shape."
+msgstr "Kết hợp các hình đang chọn thành một hình."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ComboBox"
+msgid "Add a box where the user types or picks from a list."
+msgstr "Thêm ô cho phép gõ hoặc chọn từ danh sách."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:CompareDocuments"
+msgid "Compare this document with another version and see what changed."
+msgstr "So sánh tài liệu với một bản khác để thấy chỗ thay đổi."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:CompressGraphic"
+msgid "Make the picture smaller in file size."
+msgstr "Giảm dung lượng của ảnh."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ConditionalFormatMenu"
+msgid "Format cells automatically according to their values."
+msgstr "Tự động định dạng ô theo giá trị trong ô."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Connect"
+msgid "Join the selected lines into one line."
+msgstr "Nối các đường đang chọn thành một đường."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ConnectorToolbox"
+msgid "Draw a connector line that stays attached to shapes."
+msgstr "Vẽ đường nối luôn bám theo các hình."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ContentControlProperties"
+msgid "Change the settings of the selected content control."
+msgstr "Đổi thiết lập của điều khiển nội dung đang chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ContourDialog"
+msgid "Edit the outline that text wraps around."
+msgstr "Sửa đường bao để chữ chạy quanh đối tượng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ControlCodes"
+msgid "Show or hide paragraph marks, spaces and other hidden marks."
+msgstr "Hiện hoặc ẩn dấu đoạn văn, dấu cách và các ký hiệu ẩn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ControlProperties"
+msgid "Change the settings of the selected form control."
+msgstr "Đổi thiết lập của điều khiển biểu mẫu đang chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ConvertTableToText"
+msgid "Turn the table into plain text."
+msgstr "Chuyển bảng thành văn bản thường."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:CorrelationDialog"
+msgid "Measure how strongly two sets of data are related."
+msgstr "Đo mức tương quan giữa hai bộ dữ liệu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:CovarianceDialog"
+msgid "Measure how two sets of data vary together."
+msgstr "Đo mức hai bộ dữ liệu cùng biến thiên."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:CreateNames"
+msgid "Create names for ranges from the row or column labels."
+msgstr "Tạo tên vùng từ nhãn của hàng hoặc cột."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:CrookSlant"
+msgid "Bend the selected object along a circle."
+msgstr "Uốn đối tượng đang chọn theo một đường tròn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Crop"
+msgid "Cut off the parts of the picture you don't need."
+msgstr "Cắt bỏ phần ảnh không cần."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:CurrencyField"
+msgid "Add a field for money amounts to the form."
+msgstr "Thêm ô nhập số tiền vào biểu mẫu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:CustomShowDialog"
+msgid "Choose which slides to show and in what order."
+msgstr "Chọn trang chiếu sẽ trình chiếu và thứ tự của chúng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DataConsolidate"
+msgid "Combine data from several ranges into one table."
+msgstr "Gộp dữ liệu từ nhiều vùng vào một bảng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DataFilterHideAutoFilter"
+msgid "Hide the filter buttons of the selected range."
+msgstr "Ẩn các nút lọc của vùng đang chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DataFilterSpecialFilter"
+msgid "Filter with conditions written in other cells."
+msgstr "Lọc dữ liệu theo điều kiện ghi ở các ô khác."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DataFilterStandardFilter"
+msgid "Filter the rows that meet the conditions you set."
+msgstr "Lọc các hàng thỏa điều kiện bạn đặt."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DataInColumns"
+msgid "Take the chart series from the columns."
+msgstr "Lấy chuỗi dữ liệu của biểu đồ theo cột."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DataInRows"
+msgid "Take the chart series from the rows."
+msgstr "Lấy chuỗi dữ liệu của biểu đồ theo hàng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DataPilotFilter"
+msgid "Filter the data shown in the pivot table."
+msgstr "Lọc dữ liệu hiện trong bảng tổng hợp."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DataProvider"
+msgid "Load data from a file or a web address into a range."
+msgstr "Nạp dữ liệu từ tệp tin hoặc địa chỉ web vào vùng ô."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DataProviderRefresh"
+msgid "Load the latest data from the data source again."
+msgstr "Nạp lại dữ liệu mới nhất từ nguồn dữ liệu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DataRanges"
+msgid "Choose the cells the chart takes its data from."
+msgstr "Chọn các ô mà biểu đồ lấy dữ liệu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DataStreams"
+msgid "Fill cells from a data stream that keeps updating."
+msgstr "Điền ô từ một luồng dữ liệu liên tục cập nhật."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DateField"
+msgid "Add a date field to the form."
+msgstr "Thêm ô nhập ngày vào biểu mẫu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DecrementIndent"
+msgid "Move the paragraph closer to the margin."
+msgstr "Đưa đoạn văn lùi về gần lề."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DefineDBName"
+msgid "Name a range so it can be sorted and filtered as a table."
+msgstr "Đặt tên cho vùng dữ liệu để sắp xếp và lọc như một bảng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DefinePrintArea"
+msgid "Print only the selected cells."
+msgstr "Chỉ in các ô đang chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Delete"
+msgid "Choose what to clear from the cells: contents, formats or comments."
+msgstr "Chọn phần cần xóa khỏi ô: nội dung, định dạng hoặc chú thích."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DeleteAllAnnotation"
+msgid "Delete every comment in the document."
+msgstr "Xóa mọi chú thích trong tài liệu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DeleteAllBreaks"
+msgid "Remove all manual page breaks."
+msgstr "Bỏ mọi ngắt trang đặt bằng tay."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DeleteAllNotes"
+msgid "Delete every comment in the sheet."
+msgstr "Xóa mọi chú thích trong trang tính."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DeleteAnnotation"
+msgid "Delete the selected comment."
+msgstr "Xóa chú thích đang chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DeleteCell"
+msgid "Delete the selected cells and move the others to fill the gap."
+msgstr "Xóa các ô đang chọn và dồn các ô còn lại vào chỗ trống."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DeleteColumnbreak"
+msgid "Remove the manual column break."
+msgstr "Bỏ ngắt cột đặt bằng tay."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DeleteColumns"
+msgid "Delete the selected columns."
+msgstr "Xóa các cột đang chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DeleteComment"
+msgid "Delete the selected comment."
+msgstr "Xóa chú thích đang chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DeleteMasterPage"
+msgid "Delete the selected master."
+msgstr "Xóa trang cái đang chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DeleteNote"
+msgid "Delete the comments of the selected cells."
+msgstr "Xóa chú thích của các ô đang chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DeletePage"
+msgid "Delete the current page."
+msgstr "Xóa trang hiện tại."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DeletePivotTable"
+msgid "Delete the selected pivot table."
+msgstr "Xóa bảng tổng hợp đang chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DeletePrintArea"
+msgid "Remove the print range and print the whole sheet."
+msgstr "Bỏ vùng in để in cả trang tính."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DeleteRowbreak"
+msgid "Remove the manual row break."
+msgstr "Bỏ ngắt hàng đặt bằng tay."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DeleteRows"
+msgid "Delete the selected rows."
+msgstr "Xóa các hàng đang chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DeleteTable"
+msgid "Delete the whole table."
+msgstr "Xóa toàn bộ bảng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DescriptiveStatisticsDialog"
+msgid "Get the mean, median, spread and other figures of the data."
+msgstr "Tính trung bình, trung vị, độ phân tán và các số liệu khác."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DesignerDialog"
+msgid "Show every style in the side panel."
+msgstr "Hiện mọi kiểu trong ngăn bên."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DiagramArea"
+msgid "Format the background area of the chart."
+msgstr "Định dạng vùng nền của biểu đồ."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DiagramData"
+msgid "Show or edit the data table of the chart."
+msgstr "Hiện hoặc sửa bảng dữ liệu của biểu đồ."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DiagramType"
+msgid "Change the type of the chart, such as column, line or pie."
+msgstr "Đổi loại biểu đồ, ví dụ cột, đường hoặc tròn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DiagramWall"
+msgid "Format the wall behind the chart data."
+msgstr "Định dạng mặt tường phía sau dữ liệu biểu đồ."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Dismantle"
+msgid "Split the combined shape back into its parts."
+msgstr "Tách hình đã kết hợp trở lại thành các phần."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DisplayMasterBackground"
+msgid "Show or hide the master's background on this slide."
+msgstr "Hiện hoặc ẩn nền của trang cái trên trang chiếu này."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DisplayMasterObjects"
+msgid "Show or hide the master's objects on this slide."
+msgstr "Hiện hoặc ẩn đối tượng của trang cái trên trang chiếu này."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DistributeColumns"
+msgid "Make the selected columns the same width."
+msgstr "Làm các cột đang chọn rộng bằng nhau."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DistributeRows"
+msgid "Make the selected rows the same height."
+msgstr "Làm các hàng đang chọn cao bằng nhau."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DistributeSelection"
+msgid "Space three or more objects evenly."
+msgstr "Giãn đều khoảng cách giữa ba đối tượng trở lên."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DrawCaption"
+msgid "Draw a callout that points to something."
+msgstr "Vẽ khung chú dẫn chỉ vào một chỗ."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DrawText"
+msgid "Draw a text box."
+msgstr "Vẽ một hộp văn bản."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:DuplicatePage"
+msgid "Make a copy of the current page."
+msgstr "Tạo một bản sao của trang hiện tại."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Edit"
+msgid "Add a text box to the form."
+msgstr "Thêm ô nhập chữ vào biểu mẫu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:EditAnnotation"
+msgid "Edit the selected comment."
+msgstr "Sửa chú thích đang chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:EditDoc"
+msgid "Switch between reading and editing the document."
+msgstr "Chuyển qua lại giữa chế độ đọc và chế độ sửa."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:EditGlossary"
+msgid "Save and insert text you use often."
+msgstr "Lưu và chèn đoạn chữ hay dùng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:EditHeaderAndFooter"
+msgid "Edit the headers and footers of the printed pages."
+msgstr "Sửa đầu trang và chân trang của trang in."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:EditLinks"
+msgid "See and update the links to other files."
+msgstr "Xem và cập nhật các liên kết tới tệp tin khác."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:EditPrintArea"
+msgid "Set the print range and the rows or columns repeated on every page."
+msgstr "Đặt vùng in và hàng, cột lặp lại trên mỗi trang."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:EndPara"
+msgid "Align the paragraph to the right."
+msgstr "Căn đoạn văn sang phải."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:EnterGroup"
+msgid "Enter the group to edit its objects one by one."
+msgstr "Vào trong nhóm để sửa từng đối tượng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:EntireCell"
+msgid "Select the whole table cell."
+msgstr "Chọn cả ô của bảng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:EntireColumn"
+msgid "Select the whole column."
+msgstr "Chọn cả cột."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:EntireRow"
+msgid "Select the whole row."
+msgstr "Chọn cả hàng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:EqualizeHeight"
+msgid "Make the selected objects the same height."
+msgstr "Làm các đối tượng đang chọn cao bằng nhau."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:EqualizeWidth"
+msgid "Make the selected objects the same width."
+msgstr "Làm các đối tượng đang chọn rộng bằng nhau."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ExtensionManager"
+msgid "Add, update or remove extensions."
+msgstr "Thêm, cập nhật hoặc gỡ phần mở rộng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Extrusion3DColor"
+msgid "Change the colour of the 3D sides."
+msgstr "Đổi màu các mặt 3D."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ExtrusionDepthFloater"
+msgid "Change how deep the 3D shape looks."
+msgstr "Đổi độ sâu của hình 3D."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ExtrusionDirectionFloater"
+msgid "Change the direction the 3D shape faces."
+msgstr "Đổi hướng nhìn của hình 3D."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ExtrusionSurfaceFloater"
+msgid "Change the surface of the 3D shape, such as matte or metal."
+msgstr "Đổi bề mặt hình 3D, ví dụ mờ hoặc kim loại."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ExtrusionToggle"
+msgid "Turn the 3D effect of the shape on or off."
+msgstr "Bật hoặc tắt hiệu ứng 3D của hình."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:FTestDialog"
+msgid "Compare the spread of two sets of data (F-test)."
+msgstr "So sánh độ phân tán của hai bộ dữ liệu (kiểm định F)."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:FileControl"
+msgid "Add a box for choosing a file to the form."
+msgstr "Thêm ô chọn tệp tin vào biểu mẫu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:FillDown"
+msgid "Copy the top cell into the selected cells below it."
+msgstr "Chép ô trên cùng xuống các ô đang chọn bên dưới."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:FillLeft"
+msgid "Copy the rightmost cell into the selected cells to its left."
+msgstr "Chép ô bên phải nhất sang các ô đang chọn bên trái."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:FillPageColor"
+msgid "Fill the page background with a colour."
+msgstr "Tô màu nền trang."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:FillRight"
+msgid "Copy the leftmost cell into the selected cells to its right."
+msgstr "Chép ô bên trái nhất sang các ô đang chọn bên phải."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:FillSeries"
+msgid "Fill the cells with a series of numbers or dates."
+msgstr "Điền vào ô một dãy số hoặc ngày tăng dần."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:FillShadow"
+msgid "Add a shadow to the selected object."
+msgstr "Thêm bóng đổ cho đối tượng đang chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:FillStyle"
+msgid "Choose how the object is filled: colour, gradient, picture or none."
+msgstr "Chọn cách tô đối tượng: màu, chuyển sắc, ảnh hoặc không tô."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:FillTable"
+msgid "Copy the selected cells to the same place on other sheets."
+msgstr "Chép các ô đang chọn sang cùng vị trí ở trang tính khác."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:FillUp"
+msgid "Copy the bottom cell into the selected cells above it."
+msgstr "Chép ô dưới cùng lên các ô đang chọn bên trên."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:FirstPage"
+msgid "Go to the first page."
+msgstr "Tới trang đầu tiên."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:FlipHorizontal"
+msgid "Flip the selected object from left to right."
+msgstr "Lật đối tượng đang chọn từ trái sang phải."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:FlipVertical"
+msgid "Flip the selected object upside down."
+msgstr "Lật ngược đối tượng đang chọn từ trên xuống dưới."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:FlowChartShapes"
+msgid "Draw a flowchart shape."
+msgstr "Vẽ một hình của lưu đồ."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:FontDialog"
+msgid "Open all the font settings: font, size, effects and spacing."
+msgstr "Mở mọi thiết lập phông chữ: phông, cỡ, hiệu ứng và giãn cách."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:FontHeight"
+msgid "Change the size of the text."
+msgstr "Đổi cỡ chữ."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:FontworkAlignmentFloater"
+msgid "Align the decorative text."
+msgstr "Căn chỉnh chữ nghệ thuật."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:FontworkCharacterSpacingFloater"
+msgid "Change the spacing between the letters of the decorative text."
+msgstr "Đổi khoảng cách giữa các chữ của chữ nghệ thuật."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:FontworkGalleryFloater"
+msgid "Insert decorative text."
+msgstr "Chèn chữ trang trí."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:FontworkSameLetterHeights"
+msgid "Make all letters of the decorative text the same height."
+msgstr "Làm mọi chữ của chữ nghệ thuật cao bằng nhau."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:FontworkShapeType"
+msgid "Change the shape the decorative text follows."
+msgstr "Đổi hình dáng mà chữ nghệ thuật uốn theo."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:FootnoteDialog"
+msgid "Set how footnotes and endnotes are numbered and placed."
+msgstr "Đặt cách đánh số và vị trí ghi chú, chú thích cuối."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:FormProperties"
+msgid "Change the settings of the form."
+msgstr "Đổi thiết lập của biểu mẫu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:FormatArea"
+msgid "Fill the object with a colour, gradient, picture or pattern."
+msgstr "Tô đối tượng bằng màu, chuyển sắc, ảnh hoặc hoa văn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:FormatCellDialog"
+msgid "Open all the cell settings, such as number, font and borders."
+msgstr "Mở mọi thiết lập của ô như số, phông chữ và đường viền."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:FormatDropcap"
+msgid "Make the first letter of the paragraph large."
+msgstr "Phóng to chữ cái đầu của đoạn văn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:FormatGroup"
+msgid "Group the selected objects so they move together."
+msgstr "Gộp các đối tượng đang chọn thành nhóm để di chuyển cùng nhau."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:FormatLine"
+msgid "Change the style, colour and width of the line."
+msgstr "Đổi kiểu, màu và độ dày của đường."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:FormatSelection"
+msgid "Format the selected part of the chart."
+msgstr "Định dạng phần biểu đồ đang chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:FormatUngroup"
+msgid "Split the group into separate objects."
+msgstr "Tách nhóm thành các đối tượng riêng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:FormattedField"
+msgid "Add a field that shows numbers in a set format."
+msgstr "Thêm ô hiện số theo định dạng đã đặt."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:FourierAnalysisDialog"
+msgid "Break the data down into frequencies (Fourier analysis)."
+msgstr "Phân tích dữ liệu thành các tần số (phân tích Fourier)."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:FrameDialog"
+msgid "Change the size, position, borders and wrap of the selected object."
+msgstr "Đổi cỡ, vị trí, viền và cách chữ bao quanh đối tượng đang chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:FrameLineColor"
+msgid "Change the colour of the borders."
+msgstr "Đổi màu đường viền."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Freeline"
+msgid "Draw a freehand shape filled with colour."
+msgstr "Vẽ tay một hình có tô màu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Freeline_Unfilled"
+msgid "Draw a freehand line."
+msgstr "Vẽ tay một đường tự do."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:FullScreen"
+msgid "Show only the document on the whole screen."
+msgstr "Chỉ hiện tài liệu trên toàn màn hình."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:FunctionBox"
+msgid "Show the list of functions in the side panel."
+msgstr "Hiện danh sách hàm ở ngăn bên."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Gallery"
+msgid "Insert clip art and media from the gallery."
+msgstr "Chèn hình mẫu và tệp đa phương tiện từ thư viện."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:GoToEndOfDoc"
+msgid "Go to the end of the document."
+msgstr "Tới cuối tài liệu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:GoToStartOfDoc"
+msgid "Go to the start of the document."
+msgstr "Về đầu tài liệu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:GoToStartOfPage"
+msgid "Go to the start of the page."
+msgstr "Tới đầu trang."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:GrafContrast"
+msgid "Change the contrast of the picture."
+msgstr "Đổi độ tương phản của ảnh."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:GrafGamma"
+msgid "Change the gamma of the picture to lighten or darken the midtones."
+msgstr "Đổi gamma của ảnh để làm sáng hoặc tối vùng màu trung gian."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:GrafLuminance"
+msgid "Change the brightness of the picture."
+msgstr "Đổi độ sáng của ảnh."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:GrafMode"
+msgid "Show the picture in colour, grey, black and white or as a watermark."
+msgstr "Hiện ảnh màu, xám, đen trắng hoặc dạng hình mờ."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:GrafTransparence"
+msgid "Make the picture partly transparent."
+msgstr "Làm ảnh trong suốt một phần."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:GraphicDialog"
+msgid "Change the size, position, crop and borders of the picture."
+msgstr "Đổi cỡ, vị trí, phần cắt và viền của ảnh."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:GraphicFilterToolbox"
+msgid "Apply an effect to the picture, such as sharpen or blur."
+msgstr "Áp dụng hiệu ứng cho ảnh, ví dụ làm nét hoặc làm mờ."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Grid"
+msgid "Add a table control to the form."
+msgstr "Thêm điều khiển bảng vào biểu mẫu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:GridUse"
+msgid "Make objects snap to the grid when moved."
+msgstr "Cho đối tượng bám vào lưới khi di chuyển."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:GridVisible"
+msgid "Show or hide the grid."
+msgstr "Hiện hoặc ẩn lưới."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Group"
+msgid "Group the selected rows or columns so they can be collapsed."
+msgstr "Nhóm các hàng hoặc cột đang chọn để thu gọn được."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:GroupBox"
+msgid "Add a frame that groups form controls."
+msgstr "Thêm khung để nhóm các điều khiển biểu mẫu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Grow"
+msgid "Make the text a little bigger."
+msgstr "Tăng cỡ chữ một chút."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:HandoutMode"
+msgid "Edit the layout of the printed handouts."
+msgstr "Sửa bố cục của bản phát tay khi in."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:HangingIndent"
+msgid "Indent every line of the paragraph except the first."
+msgstr "Thụt lề mọi dòng của đoạn văn trừ dòng đầu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:HeaderAndFooter"
+msgid "Add the date, footer text and slide numbers."
+msgstr "Thêm ngày, chữ chân trang và số trang chiếu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:HeadingRowsRepeat"
+msgid "Repeat the heading rows at the top of every page."
+msgstr "Lặp lại hàng tiêu đề ở đầu mỗi trang."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:HelpIndex"
+msgid "Open the help."
+msgstr "Mở trợ giúp."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:HelplinesMove"
+msgid "Show guide lines while moving an object."
+msgstr "Hiện đường gióng khi di chuyển đối tượng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:HelplinesUse"
+msgid "Make objects snap to the guide lines."
+msgstr "Cho đối tượng bám vào đường gióng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:HelplinesVisible"
+msgid "Show or hide the guide lines."
+msgstr "Hiện hoặc ẩn đường gióng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Hide"
+msgid "Hide the selected sheet."
+msgstr "Ẩn trang tính đang chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:HideAllNotes"
+msgid "Hide all comments in the sheet."
+msgstr "Ẩn mọi chú thích trong trang tính."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:HideColumn"
+msgid "Hide the selected columns."
+msgstr "Ẩn các cột đang chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:HideDetail"
+msgid "Collapse the selected group to hide its rows or columns."
+msgstr "Thu gọn nhóm đang chọn để ẩn các hàng hoặc cột."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:HideRow"
+msgid "Hide the selected rows."
+msgstr "Ẩn các hàng đang chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:HstDifferentFirstPage"
+msgid "Use another header and footer on the first page."
+msgstr "Dùng đầu trang, chân trang khác cho trang đầu tiên."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:HstDifferentOddEven"
+msgid "Use different headers and footers on odd and even pages."
+msgstr "Dùng đầu trang, chân trang khác nhau cho trang chẵn và trang lẻ."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:HstPictureStyles"
+msgid "Apply a ready-made frame, border or shadow to the picture."
+msgstr "Áp dụng khung, viền hoặc bóng có sẵn cho ảnh."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:HstRotatePageLeft"
+msgid "Rotate the page 90° to the left."
+msgstr "Xoay trang 90° sang trái."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:HstRotatePageRight"
+msgid "Rotate the page 90° to the right."
+msgstr "Xoay trang 90° sang phải."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:HstTableStyles"
+msgid "Apply a ready-made style to the table."
+msgstr "Áp dụng một kiểu có sẵn cho bảng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Hyphenate"
+msgid "Break long words at the line ends with hyphens."
+msgstr "Ngắt từ dài ở cuối dòng bằng dấu gạch nối."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ImageControl"
+msgid "Add a picture box to the form."
+msgstr "Thêm ô hiện ảnh vào biểu mẫu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Imagebutton"
+msgid "Add a button with a picture to the form."
+msgstr "Thêm nút có hình vào biểu mẫu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ImportFromFile"
+msgid "Insert pages from another file."
+msgstr "Chèn các trang từ tệp tin khác."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:IncrementIndent"
+msgid "Move the paragraph further from the margin."
+msgstr "Đẩy đoạn văn thụt vào xa lề hơn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InputLineVisible"
+msgid "Show or hide the formula bar."
+msgstr "Hiện hoặc ẩn thanh công thức."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Insert"
+msgid "Add a new sheet."
+msgstr "Thêm trang tính mới."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertAVMedia"
+msgid "Insert an audio or video file."
+msgstr "Chèn tệp âm thanh hoặc video."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertAuthorField"
+msgid "Insert the author's name."
+msgstr "Chèn tên tác giả."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertBookmark"
+msgid "Mark a place in the document so you can jump to it."
+msgstr "Đánh dấu một chỗ trong tài liệu để nhảy tới nhanh."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertBreak"
+msgid "Insert a line, column or page break."
+msgstr "Chèn ngắt dòng, ngắt cột hoặc ngắt trang."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertCell"
+msgid "Insert cells and move the others aside."
+msgstr "Chèn ô và đẩy các ô khác sang bên."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertCheckboxContentControl"
+msgid "Insert a check box the reader can tick."
+msgstr "Chèn ô đánh dấu để người đọc tích chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertColumnBreak"
+msgid "Start a new column from the selected cell."
+msgstr "Sang cột in mới từ ô đang chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertColumnsAfter"
+msgid "Insert a column to the right."
+msgstr "Chèn một cột bên phải."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertColumnsBefore"
+msgid "Insert a column to the left."
+msgstr "Chèn một cột bên trái."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertComboBoxContentControl"
+msgid "Insert a box where the reader types or picks from a list."
+msgstr "Chèn ô để người đọc gõ hoặc chọn từ danh sách."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertContentControl"
+msgid "Insert a box the reader fills with formatted text."
+msgstr "Chèn ô để người đọc nhập chữ có định dạng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertCurrentDate"
+msgid "Insert today's date in the cell."
+msgstr "Chèn ngày hôm nay vào ô."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertCurrentTime"
+msgid "Insert the current time in the cell."
+msgstr "Chèn giờ hiện tại vào ô."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertDateAndTime"
+msgid "Insert the date and time on the slide."
+msgstr "Chèn ngày và giờ vào trang chiếu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertDateContentControl"
+msgid "Insert a box where the reader picks a date."
+msgstr "Chèn ô để người đọc chọn ngày."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertDateField"
+msgid "Insert today's date; it does not change later."
+msgstr "Chèn ngày hôm nay, không tự đổi về sau."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertDateFieldVar"
+msgid "Insert the date; it updates each time the file opens."
+msgstr "Chèn ngày, tự cập nhật mỗi lần mở tệp tin."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertDropdownContentControl"
+msgid "Insert a list the reader picks one item from."
+msgstr "Chèn danh sách để người đọc chọn một mục."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertEndnote"
+msgid "Add a note at the end of the document."
+msgstr "Thêm chú thích ở cuối tài liệu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertEnvelope"
+msgid "Create an envelope with the addresses."
+msgstr "Tạo phong bì có địa chỉ người gửi và người nhận."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertExternalDataSource"
+msgid "Insert data from another file or a web page."
+msgstr "Chèn dữ liệu từ tệp tin khác hoặc trang web."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertFieldCtrl"
+msgid "Insert a field such as the page number, date or title."
+msgstr "Chèn trường như số trang, ngày hoặc tiêu đề."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertFormula"
+msgid "Insert a formula into a table cell."
+msgstr "Chèn công thức vào ô của bảng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertIndexesEntry"
+msgid "Mark the selected word for the index."
+msgstr "Đánh dấu từ đang chọn để đưa vào chỉ mục."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertLabels"
+msgid "Create pages of address labels."
+msgstr "Tạo trang nhãn in địa chỉ."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertLinebreak"
+msgid "Start a new line in the same paragraph."
+msgstr "Xuống dòng mới trong cùng đoạn văn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertMasterPage"
+msgid "Add a new master."
+msgstr "Thêm trang cái mới."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertMath"
+msgid "Insert a mathematical formula."
+msgstr "Chèn công thức toán học."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertMenuAxes"
+msgid "Show or hide the axes of the chart."
+msgstr "Hiện hoặc ẩn các trục của biểu đồ."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertMenuDataLabels"
+msgid "Show the values on the chart's data points."
+msgstr "Hiện giá trị trên các điểm dữ liệu của biểu đồ."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertMenuGrids"
+msgid "Show or hide the grid lines of the chart."
+msgstr "Hiện hoặc ẩn đường lưới của biểu đồ."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertMenuLegend"
+msgid "Choose where the chart legend goes."
+msgstr "Chọn vị trí chú giải của biểu đồ."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertMenuTitles"
+msgid "Add titles to the chart and its axes."
+msgstr "Thêm tiêu đề cho biểu đồ và các trục."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertMenuTrendlines"
+msgid "Add a trend line to the data series."
+msgstr "Thêm đường xu hướng cho chuỗi dữ liệu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertName"
+msgid "Use a named range in the formula."
+msgstr "Dùng một vùng đã đặt tên trong công thức."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertObject"
+msgid "Insert an object from another program."
+msgstr "Chèn đối tượng từ chương trình khác."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertObjectStarMath"
+msgid "Insert a mathematical formula."
+msgstr "Chèn công thức toán học."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertPage"
+msgid "Add a new page after the current one."
+msgstr "Thêm trang mới sau trang hiện tại."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertPageField"
+msgid "Insert the page number."
+msgstr "Chèn số trang."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertPageFooter"
+msgid "Add or remove the footer of the page."
+msgstr "Thêm hoặc bỏ chân trang."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertPageHeader"
+msgid "Add or remove the header of the page."
+msgstr "Thêm hoặc bỏ đầu trang."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertPagesField"
+msgid "Insert the total number of pages."
+msgstr "Chèn tổng số trang."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertPictureContentControl"
+msgid "Insert a box where the reader adds a picture."
+msgstr "Chèn ô để người đọc thêm ảnh."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertPlainTextContentControl"
+msgid "Insert a box the reader fills with plain text."
+msgstr "Chèn ô để người đọc nhập chữ thường."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertReferenceField"
+msgid "Refer to a heading, figure or table elsewhere in the document."
+msgstr "Dẫn chiếu tới đề mục, hình hoặc bảng ở chỗ khác trong tài liệu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertRowBreak"
+msgid "Start a new printed page from the selected row."
+msgstr "Sang trang in mới từ hàng đang chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertRowDialog"
+msgid "Insert rows into the table."
+msgstr "Chèn hàng vào bảng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertRowsAfter"
+msgid "Insert a row below."
+msgstr "Chèn một hàng bên dưới."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertRowsBefore"
+msgid "Insert a row above."
+msgstr "Chèn một hàng bên trên."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertSignatureLine"
+msgid "Add a line where the document can be signed."
+msgstr "Thêm dòng chữ ký để ký vào tài liệu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertSlideField"
+msgid "Insert the slide number."
+msgstr "Chèn số trang chiếu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertSparkline"
+msgid "Draw a tiny chart inside a cell."
+msgstr "Vẽ biểu đồ nhỏ ngay trong ô."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:InsertTimeFieldVar"
+msgid "Insert the time; it updates each time the file opens."
+msgstr "Chèn giờ, tự cập nhật mỗi lần mở tệp tin."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Intersect"
+msgid "Keep only the area where the selected shapes overlap."
+msgstr "Chỉ giữ phần các hình đang chọn chồng lên nhau."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Italic"
+msgid "Make the text italic."
+msgstr "Làm chữ nghiêng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:JumpToFooter"
+msgid "Move the cursor to the footer."
+msgstr "Đưa con trỏ xuống chân trang."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:JumpToHeader"
+msgid "Move the cursor to the header."
+msgstr "Đưa con trỏ lên đầu trang."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:JumpToSpecificPage"
+msgid "Go to the page with the number you enter."
+msgstr "Tới trang có số bạn nhập."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:JustifyPara"
+msgid "Justify the paragraph."
+msgstr "Căn đều hai bên đoạn văn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Label"
+msgid "Add a label to the form."
+msgstr "Thêm nhãn chữ vào biểu mẫu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:LastPage"
+msgid "Go to the last page."
+msgstr "Tới trang cuối cùng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:LeaveGroup"
+msgid "Leave the group you are editing."
+msgstr "Thoát khỏi nhóm đang sửa."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:LeftPaneDraw"
+msgid "Show or hide the page thumbnails."
+msgstr "Hiện hoặc ẩn hình thu nhỏ của các trang."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:LeftPaneImpress"
+msgid "Show or hide the slide thumbnails."
+msgstr "Hiện hoặc ẩn hình thu nhỏ của các trang chiếu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:LeftParaMargin"
+msgid "Change the indent of the paragraph from the left margin."
+msgstr "Đổi khoảng thụt lề trái của đoạn văn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Legend"
+msgid "Show, hide or format the chart legend."
+msgstr "Hiện, ẩn hoặc định dạng chú giải của biểu đồ."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Line"
+msgid "Draw a straight line."
+msgstr "Vẽ một đường thẳng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:LineArrowEnd"
+msgid "Draw a line that ends with an arrow."
+msgstr "Vẽ đường thẳng có mũi tên ở cuối."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:LineEndStyle"
+msgid "Choose the arrowheads at the ends of the line."
+msgstr "Chọn kiểu mũi tên ở hai đầu đường."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:LineNumberingDialog"
+msgid "Number the lines in the margin."
+msgstr "Đánh số các dòng ở lề."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:LineStyle"
+msgid "Change the style of the borders."
+msgstr "Đổi kiểu đường viền."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:LineToolbox"
+msgid "Draw a curve, a polygon or a freehand line."
+msgstr "Vẽ đường cong, đa giác hoặc đường tự do."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:LineWidth"
+msgid "Change the thickness of the line."
+msgstr "Đổi độ dày của đường."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ListBox"
+msgid "Add a list to pick from to the form."
+msgstr "Thêm danh sách để chọn vào biểu mẫu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:MacroDialog"
+msgid "Run, edit or organize macros."
+msgstr "Chạy, sửa hoặc sắp xếp các macro."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:MacroRecorder"
+msgid "Record your actions as a macro to repeat them later."
+msgstr "Ghi lại thao tác thành macro để lặp lại về sau."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ManageXMLSource"
+msgid "Import data from an XML file into the cells."
+msgstr "Nhập dữ liệu từ tệp tin XML vào các ô."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Margins"
+msgid "Choose the margins of the printed page."
+msgstr "Chọn lề của trang in."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Marks"
+msgid "Show fields with a grey background."
+msgstr "Tô nền xám cho các trường."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:MasterLayouts"
+msgid "Choose which placeholders the master shows, such as date or number."
+msgstr "Chọn các ô giữ chỗ trang cái hiện ra, như ngày hoặc số trang."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Menubar"
+msgid "Show or hide the menu bar."
+msgstr "Hiện hoặc ẩn thanh trình đơn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Merge"
+msgid "Merge the selected shapes into one outline."
+msgstr "Hợp các hình đang chọn thành một đường bao."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:MergeCells"
+msgid "Join the selected cells into one cell."
+msgstr "Gộp các ô đang chọn thành một ô."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:MergeDocuments"
+msgid "Bring the changes from another copy of the document into this one."
+msgstr "Đưa các thay đổi từ một bản khác của tài liệu vào bản này."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Morphing"
+msgid "Change one shape into another in several steps."
+msgstr "Biến dần hình này thành hình khác qua nhiều bước."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:MovePageDown"
+msgid "Move the page one place down."
+msgstr "Chuyển trang xuống sau một vị trí."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:MovePageUp"
+msgid "Move the page one place up."
+msgstr "Chuyển trang lên trước một vị trí."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:NavigationBar"
+msgid "Add record navigation buttons to the form."
+msgstr "Thêm thanh nút chuyển bản ghi vào biểu mẫu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Navigator"
+msgid "Show headings, sheets, objects and names to move around quickly."
+msgstr "Hiện đề mục, trang tính, đối tượng và tên để di chuyển nhanh."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:NewWindow"
+msgid "Open another window of the same document."
+msgstr "Mở thêm một cửa sổ của cùng tài liệu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:NextAnnotation"
+msgid "Go to the next comment."
+msgstr "Tới chú thích kế tiếp."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:NextPage"
+msgid "Go to the next page."
+msgstr "Tới trang sau."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:NextTrackedChange"
+msgid "Go to the next tracked change."
+msgstr "Tới thay đổi kế tiếp."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:NotesMasterPage"
+msgid "Edit the layout of the notes pages."
+msgstr "Sửa bố cục của trang ghi chú."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:NotesMode"
+msgid "Show each slide with the speaker notes below it."
+msgstr "Hiện từng trang chiếu với ghi chú của người trình bày bên dưới."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:NumberFormatCurrency"
+msgid "Format numbers as currency."
+msgstr "Định dạng số theo kiểu tiền tệ."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:NumberFormatDate"
+msgid "Show the numbers as dates."
+msgstr "Hiện số dưới dạng ngày."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:NumberFormatDecimal"
+msgid "Show the numbers with a thousands separator and two decimals."
+msgstr "Hiện số có dấu phân cách hàng nghìn và hai chữ số thập phân."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:NumberFormatPercent"
+msgid "Show numbers as percentages."
+msgstr "Hiện số dưới dạng phần trăm."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:NumberFormatType"
+msgid "Choose how the numbers are shown: number, money, date or percent."
+msgstr "Chọn cách hiện số: số, tiền tệ, ngày hoặc phần trăm."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:NumericField"
+msgid "Add a field for numbers to the form."
+msgstr "Thêm ô nhập số vào biểu mẫu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ObjectAlign"
+msgid "Line up the selected objects."
+msgstr "Căn các đối tượng đang chọn theo cạnh hoặc theo giữa."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ObjectAlignLeft"
+msgid "Line up the left edges of the selected objects."
+msgstr "Căn thẳng cạnh trái của các đối tượng đang chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ObjectAlignRight"
+msgid "Line up the right edges of the selected objects."
+msgstr "Căn thẳng cạnh phải của các đối tượng đang chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ObjectBackOne"
+msgid "Move the object one layer back."
+msgstr "Đưa đối tượng lùi xuống một lớp."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ObjectForwardOne"
+msgid "Move the object one layer forward."
+msgstr "Đưa đối tượng lên trên một lớp."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ObjectTitleDescription"
+msgid "Describe the object for people using a screen reader."
+msgstr "Mô tả đối tượng cho người dùng trình đọc màn hình."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Objects3DToolbox"
+msgid "Draw a 3D object such as a cube or a sphere."
+msgstr "Vẽ khối 3D như hình lập phương, hình cầu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:OpenReadOnly"
+msgid "Open forms in design mode so they can be edited."
+msgstr "Mở biểu mẫu ở chế độ thiết kế để sửa được."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:OptimizeTable"
+msgid "Make the rows and columns of the table fit their contents."
+msgstr "Chỉnh hàng và cột của bảng vừa với nội dung."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:OptionsSecurityDialog"
+msgid "Choose which macros are allowed to run."
+msgstr "Chọn những macro được phép chạy."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:OptionsTreeDialog"
+msgid "Change the settings of HST Office."
+msgstr "Đổi thiết lập của HST Office."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Orientation"
+msgid "Switch between portrait and landscape pages."
+msgstr "Đổi trang dọc hoặc trang ngang."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:OriginalSize"
+msgid "Give the object back its original size."
+msgstr "Đưa đối tượng về kích cỡ gốc."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:OutlineCollapse"
+msgid "Hide the subpoints of the selected paragraph."
+msgstr "Ẩn các ý phụ của đoạn đang chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:OutlineCollapseAll"
+msgid "Show only the slide titles."
+msgstr "Chỉ hiện tiêu đề các trang chiếu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:OutlineDown"
+msgid "Move the selected paragraphs down."
+msgstr "Chuyển các đoạn đang chọn xuống dưới."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:OutlineExpand"
+msgid "Show the subpoints of the selected paragraph."
+msgstr "Hiện các ý phụ của đoạn đang chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:OutlineExpandAll"
+msgid "Show all levels of the outline."
+msgstr "Hiện mọi cấp của dàn ý."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:OutlineFont"
+msgid "Show the letters as hollow outlines."
+msgstr "Hiện chữ thành nét viền rỗng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:OutlineFormat"
+msgid "Show or hide the text formatting in the outline."
+msgstr "Hiện hoặc ẩn định dạng chữ trong dàn ý."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:OutlineLeft"
+msgid "Raise the selected paragraphs one level."
+msgstr "Nâng các đoạn đang chọn lên một cấp."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:OutlineMode"
+msgid "Show the text of all slides as an outline."
+msgstr "Hiện chữ của mọi trang chiếu dưới dạng dàn ý."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:OutlineRight"
+msgid "Lower the selected paragraphs one level."
+msgstr "Hạ các đoạn đang chọn xuống một cấp."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:OutlineUp"
+msgid "Move the selected paragraphs up."
+msgstr "Chuyển các đoạn đang chọn lên trên."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:OutputQualityColor"
+msgid "Show the document in colour."
+msgstr "Hiện tài liệu có màu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:OutputQualityGrayscale"
+msgid "Show the document in shades of grey."
+msgstr "Hiện tài liệu theo thang xám."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:PageDialog"
+msgid "Set the paper size, margins and layout of the page."
+msgstr "Đặt khổ giấy, lề và bố cục trang."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:PageDown"
+msgid "Go to the next page."
+msgstr "Tới trang sau."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:PageFormatDialog"
+msgid "Set the paper, margins, headers and footers of the printed page."
+msgstr "Đặt khổ giấy, lề, đầu trang và chân trang khi in."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:PageSetup"
+msgid "Set the size, orientation and margins of the page."
+msgstr "Đặt cỡ, hướng và lề của trang."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:PageUp"
+msgid "Go to the previous page."
+msgstr "Về trang trước."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ParaLeftToRight"
+msgid "Write the paragraph from left to right."
+msgstr "Viết đoạn văn từ trái sang phải."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ParaRightToLeft"
+msgid "Write the paragraph from right to left."
+msgstr "Viết đoạn văn từ phải sang trái."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ParagraphDialog"
+msgid "Open all the paragraph settings, such as indents, spacing and tabs."
+msgstr "Mở mọi thiết lập đoạn văn như thụt lề, giãn cách và điểm dừng tab."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ParaspaceDecrease"
+msgid "Reduce the space above and below the paragraph."
+msgstr "Giảm khoảng cách trên và dưới đoạn văn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ParaspaceIncrease"
+msgid "Increase the space above and below the paragraph."
+msgstr "Tăng khoảng cách trên và dưới đoạn văn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:PasteSpecial"
+msgid "Paste in another format, such as values only or plain text."
+msgstr "Dán theo cách khác, ví dụ chỉ giá trị hoặc chữ thường."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:PatternField"
+msgid "Add a field that accepts text in a set pattern."
+msgstr "Thêm ô nhập chữ theo một mẫu định sẵn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:PhotoAlbumDialog"
+msgid "Create slides from a set of pictures."
+msgstr "Tạo các trang chiếu từ một loạt ảnh."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Polygon_Diagonal"
+msgid "Draw a filled shape with straight sides at 45° steps."
+msgstr "Vẽ hình có tô màu với các cạnh thẳng theo góc 45°."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Polygon_Diagonal_Unfilled"
+msgid "Draw lines with straight sides at 45° steps."
+msgstr "Vẽ đường gấp khúc với các cạnh theo góc 45°."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Polygon_Unfilled"
+msgid "Draw lines with straight sides."
+msgstr "Vẽ đường gấp khúc."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:PresentationDialog"
+msgid "Choose how the slide show runs: range, screen and timing."
+msgstr "Chọn cách chạy trình chiếu: phạm vi, màn hình và thời gian."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:PresentationLayout"
+msgid "Choose another master for the slides."
+msgstr "Chọn trang cái khác cho các trang chiếu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:PreviewZoom"
+msgid "Zoom the print preview in or out."
+msgstr "Phóng to hoặc thu nhỏ bản xem trước khi in."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:PreviousAnnotation"
+msgid "Go to the previous comment."
+msgstr "Về chú thích trước."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:PreviousPage"
+msgid "Go to the previous page."
+msgstr "Về trang trước."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:PreviousTrackedChange"
+msgid "Go to the previous tracked change."
+msgstr "Về thay đổi trước."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Print"
+msgid "Choose a printer and print the document."
+msgstr "Chọn máy in và in tài liệu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:PrintLayout"
+msgid "Show the pages as they will be printed."
+msgstr "Hiện các trang như khi in ra."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:PrintPreview"
+msgid "See the pages as they will be printed."
+msgstr "Xem trang như khi in ra giấy."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ProtectTraceChangeMode"
+msgid "Stop others turning off change tracking without a password."
+msgstr "Chặn người khác tắt theo dõi thay đổi nếu không có mật khẩu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Pushbutton"
+msgid "Add a button to the form."
+msgstr "Thêm nút bấm vào biểu mẫu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:RadioButton"
+msgid "Add an option button to the form; only one in a group can be chosen."
+msgstr "Thêm nút tùy chọn vào biểu mẫu; mỗi nhóm chỉ chọn được một."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:RecalcPivotTable"
+msgid "Update the pivot table with the latest data."
+msgstr "Cập nhật bảng tổng hợp theo dữ liệu mới nhất."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:RedactDoc"
+msgid "Make a copy with the content you mark blacked out for good."
+msgstr "Tạo bản sao có phần nội dung đã đánh dấu bị che kín hoàn toàn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:RegressionDialog"
+msgid "Find the line or curve that best fits the data."
+msgstr "Tìm đường thẳng hoặc đường cong khớp nhất với dữ liệu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:RejectAllTrackedChanges"
+msgid "Undo every tracked change in the document."
+msgstr "Từ chối mọi thay đổi đã theo dõi trong tài liệu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:RejectTrackedChange"
+msgid "Undo this change."
+msgstr "Từ chối thay đổi này."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:RejectTrackedChangeToNext"
+msgid "Undo this change and go to the next one."
+msgstr "Từ chối thay đổi này và chuyển sang thay đổi kế tiếp."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Remove"
+msgid "Delete the selected sheet."
+msgstr "Xóa trang tính đang chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:RemoveCalcTable"
+msgid "Delete the selected table."
+msgstr "Xóa bảng đang chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:RenameMasterPage"
+msgid "Rename the selected master."
+msgstr "Đổi tên trang cái đang chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:RenamePage"
+msgid "Rename the current page."
+msgstr "Đổi tên trang hiện tại."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:RenameTable"
+msgid "Rename the selected sheet."
+msgstr "Đổi tên trang tính đang chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ReplyComment"
+msgid "Reply to the selected comment."
+msgstr "Trả lời chú thích đang chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ResetAllDataPoints"
+msgid "Give every data point back the format of its series."
+msgstr "Đưa mọi điểm dữ liệu về định dạng của chuỗi."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ResetAttributes"
+msgid "Remove direct formatting from the selection."
+msgstr "Xóa định dạng trực tiếp, đưa chữ về kiểu đang dùng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ResetDataPoint"
+msgid "Give the data point back the format of its series."
+msgstr "Đưa điểm dữ liệu về định dạng của chuỗi."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:RightParaMargin"
+msgid "Change the indent of the paragraph from the right margin."
+msgstr "Đổi khoảng thụt lề phải của đoạn văn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:RotateLeft"
+msgid "Rotate the picture 90° to the left."
+msgstr "Xoay ảnh 90° sang trái."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:RotateRight"
+msgid "Rotate the picture 90° to the right."
+msgstr "Xoay ảnh 90° sang phải."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:RowHeight"
+msgid "Set an exact height for the selected rows."
+msgstr "Đặt chiều cao chính xác cho các hàng đang chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Ruler"
+msgid "Show or hide the rulers."
+msgstr "Hiện hoặc ẩn thước."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:RunMacro"
+msgid "Choose a macro and run it."
+msgstr "Chọn một macro và chạy."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SaveBackground"
+msgid "Save the background picture as a file."
+msgstr "Lưu ảnh nền thành tệp tin."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SaveGraphic"
+msgid "Save the picture as a file."
+msgstr "Lưu ảnh thành tệp tin."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SearchDialog"
+msgid "Find text and replace it."
+msgstr "Tìm chữ và thay bằng chữ khác."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SelectAll"
+msgid "Select everything."
+msgstr "Chọn tất cả."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SelectBackground"
+msgid "Use a picture as the page background."
+msgstr "Dùng một ảnh làm nền trang."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SelectData"
+msgid "Select the data range around the current cell."
+msgstr "Chọn vùng dữ liệu quanh ô hiện tại."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SelectObject"
+msgid "Click objects to select them."
+msgstr "Bấm vào đối tượng để chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SelectTable"
+msgid "Select the whole table."
+msgstr "Chọn cả bảng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SelectUnprotectedCells"
+msgid "Select the cells that can be edited in a protected sheet."
+msgstr "Chọn các ô sửa được trong trang tính đã khóa."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SelectionModeBlock"
+msgid "Select a rectangular block of text."
+msgstr "Chọn một khối chữ hình chữ nhật."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SendToBack"
+msgid "Put the selected object behind all others."
+msgstr "Đặt đối tượng đang chọn xuống dưới cùng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SetAnchorAtChar"
+msgid "Attach the object to a character so it moves with it."
+msgstr "Neo đối tượng vào một ký tự để di chuyển theo ký tự đó."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SetAnchorToChar"
+msgid "Place the object in the line like a character."
+msgstr "Đặt đối tượng nằm trong dòng chữ như một ký tự."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SetAnchorToPage"
+msgid "Keep the object at a fixed place on the page."
+msgstr "Giữ đối tượng cố định ở một chỗ trên trang."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SetAnchorToPara"
+msgid "Attach the object to a paragraph so it moves with it."
+msgstr "Neo đối tượng vào đoạn văn để di chuyển theo đoạn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SetBorderStyle"
+msgid "Add or remove borders around the selection."
+msgstr "Thêm hoặc bỏ đường viền quanh vùng chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SetColumnWidth"
+msgid "Set an exact width for the selected columns."
+msgstr "Đặt bề rộng chính xác cho các cột đang chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SetDefault"
+msgid "Remove direct formatting from the selection."
+msgstr "Xóa định dạng trực tiếp, đưa chữ về kiểu đang dùng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SetLanguageAllTextMenu"
+msgid "Set the language of the whole text for spell checking."
+msgstr "Đặt ngôn ngữ của toàn bộ văn bản để kiểm tra chính tả."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SetLanguageParagraphMenu"
+msgid "Set the language of this paragraph for spell checking."
+msgstr "Đặt ngôn ngữ của đoạn này để kiểm tra chính tả."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SetLanguageSelectionMenu"
+msgid "Set the language of the selected text for spell checking."
+msgstr "Đặt ngôn ngữ của chữ đang chọn để kiểm tra chính tả."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SetOptimalColumnWidth"
+msgid "Fit the column width to its contents."
+msgstr "Chỉnh bề rộng cột vừa với nội dung."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SetOptimalRowHeight"
+msgid "Fit the row height to its contents."
+msgstr "Chỉnh chiều cao hàng vừa với nội dung."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SetOutline"
+msgid "Choose a ready-made style for a multilevel list."
+msgstr "Chọn kiểu có sẵn cho danh sách nhiều cấp."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SetRowHeight"
+msgid "Set an exact height for the selected rows."
+msgstr "Đặt chiều cao chính xác cho các hàng đang chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SetTabBgColor"
+msgid "Colour the tab of the sheet."
+msgstr "Tô màu nhãn của trang tính."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Shadowed"
+msgid "Add a shadow to the text."
+msgstr "Thêm bóng đổ cho chữ."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ShareDocument"
+msgid "Let several people edit the spreadsheet at the same time."
+msgstr "Cho nhiều người cùng sửa bảng tính một lúc."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Shear"
+msgid "Slant or distort the selected object."
+msgstr "Làm nghiêng hoặc bóp méo đối tượng đang chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Show"
+msgid "Show a hidden sheet again."
+msgstr "Hiện lại trang tính đã ẩn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ShowAllNotes"
+msgid "Show all comments in the sheet."
+msgstr "Hiện mọi chú thích trong trang tính."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ShowAnnotations"
+msgid "Show or hide the comments."
+msgstr "Hiện hoặc ẩn các chú thích."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ShowBookview"
+msgid "See the pages side by side like an open book."
+msgstr "Xem các trang cạnh nhau như cuốn sách đang mở."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ShowColumn"
+msgid "Show the hidden columns in the selection again."
+msgstr "Hiện lại các cột bị ẩn trong vùng chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ShowDetail"
+msgid "Expand the selected group to show its rows or columns."
+msgstr "Mở rộng nhóm đang chọn để hiện các hàng hoặc cột."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ShowErrors"
+msgid "Draw arrows to the cells that cause the error."
+msgstr "Vẽ mũi tên tới các ô gây ra lỗi."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ShowFmExplorer"
+msgid "Show the forms and their controls as a tree."
+msgstr "Hiện các biểu mẫu và điều khiển dưới dạng cây."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ShowMultiplePages"
+msgid "See several pages at once in the preview."
+msgstr "Xem nhiều trang cùng lúc khi xem trước."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ShowRow"
+msgid "Show the hidden rows in the selection again."
+msgstr "Hiện lại các hàng bị ẩn trong vùng chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ShowRuler"
+msgid "Show or hide the rulers."
+msgstr "Hiện hoặc ẩn thước."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ShowSinglePage"
+msgid "See one page at a time in the preview."
+msgstr "Xem từng trang một khi xem trước."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ShowSlide"
+msgid "Show the hidden slide again in the slide show."
+msgstr "Cho trang chiếu đã ẩn hiện lại khi trình chiếu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ShowTrackedChanges"
+msgid "Show or hide the tracked changes in the text."
+msgstr "Hiện hoặc ẩn các thay đổi đã theo dõi trong văn bản."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ShowTwoPages"
+msgid "See two pages side by side in the preview."
+msgstr "Xem hai trang cạnh nhau khi xem trước."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ShowWhitespace"
+msgid "Show or hide the space between pages."
+msgstr "Hiện hoặc ẩn khoảng trống giữa các trang."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Shrink"
+msgid "Make the text a little smaller."
+msgstr "Giảm cỡ chữ một chút."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Sidebar"
+msgid "Show or hide the side panel."
+msgstr "Hiện hoặc ẩn ngăn bên."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SidebarDeck.A11yCheckDeck"
+msgid "Find content that is hard to read for people with disabilities."
+msgstr "Tìm nội dung khó đọc đối với người khuyết tật."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SidebarDeck.PropertyDeck"
+msgid "Change the background of the slide in the side panel."
+msgstr "Đổi nền của trang chiếu ở ngăn bên."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SlideChangeWindow"
+msgid "Set the speed, sound and timing of slide transitions."
+msgstr "Đặt tốc độ, âm thanh và thời gian chuyển trang chiếu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SmallCaps"
+msgid "Write lowercase letters as small capitals."
+msgstr "Viết chữ thường thành chữ in hoa nhỏ."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SnapBorder"
+msgid "Make objects snap to the page margins."
+msgstr "Cho đối tượng bám vào lề trang."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SnapFrame"
+msgid "Make objects snap to the edges of other objects."
+msgstr "Cho đối tượng bám vào cạnh đối tượng khác."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SnapPoints"
+msgid "Make objects snap to the points of other objects."
+msgstr "Cho đối tượng bám vào các điểm của đối tượng khác."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SolverDialog"
+msgid "Find the values that give the result you want."
+msgstr "Tìm các giá trị cho ra kết quả mong muốn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SortAscending"
+msgid "Sort from smallest to largest, or from A to Z."
+msgstr "Sắp xếp từ nhỏ đến lớn hoặc từ A đến Z."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SortDescending"
+msgid "Sort from largest to smallest, or from Z to A."
+msgstr "Sắp xếp từ lớn đến nhỏ hoặc từ Z đến A."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SortDialog"
+msgid "Sort the selected paragraphs or table rows."
+msgstr "Sắp xếp các đoạn hoặc hàng bảng đang chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SpacePara1"
+msgid "Set single line spacing."
+msgstr "Đặt giãn dòng đơn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SpacePara15"
+msgid "Set line spacing to 1.5 lines."
+msgstr "Đặt giãn dòng 1,5 dòng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SpacePara2"
+msgid "Set double line spacing."
+msgstr "Đặt giãn dòng gấp đôi."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Spacing"
+msgid "Change the space between the characters."
+msgstr "Đổi khoảng cách giữa các ký tự."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SpellOnline"
+msgid "Underline misspelt words while you type."
+msgstr "Gạch dưới từ sai chính tả ngay khi gõ."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SplitCell"
+msgid "Split the selected cell into several cells."
+msgstr "Tách ô đang chọn thành nhiều ô."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SplitTable"
+msgid "Split the table into two at the current row."
+msgstr "Tách bảng làm hai tại hàng hiện tại."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SplitWindow"
+msgid "Split the window to see two parts of the sheet at once."
+msgstr "Chia cửa sổ để xem hai phần của trang tính cùng lúc."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:StarShapes"
+msgid "Draw a star or a banner."
+msgstr "Vẽ hình ngôi sao hoặc băng rôn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:StartPara"
+msgid "Align the paragraph to the left."
+msgstr "Căn đoạn văn sang trái."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Strikeout"
+msgid "Draw a line through the text."
+msgstr "Gạch ngang qua chữ."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:StyleApply"
+msgid "Apply this style to the selected cells."
+msgstr "Áp dụng kiểu này cho các ô đang chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:StylesPreview"
+msgid "Pick a style for the paragraph from the gallery."
+msgstr "Chọn kiểu cho đoạn văn từ thư viện kiểu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SubScript"
+msgid "Make the text small and below the line."
+msgstr "Viết chữ nhỏ ở dưới dòng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Substract"
+msgid "Cut the shapes on top out of the bottom shape."
+msgstr "Khoét phần các hình bên trên ra khỏi hình dưới cùng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SuperScript"
+msgid "Make the text small and above the line."
+msgstr "Viết chữ nhỏ ở trên dòng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SwitchControlDesignMode"
+msgid "Switch between editing and using the form controls."
+msgstr "Chuyển qua lại giữa sửa và dùng các điều khiển biểu mẫu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:SymbolShapes"
+msgid "Draw a symbol such as a smiley face or a heart."
+msgstr "Vẽ hình biểu tượng như mặt cười, trái tim."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:TTestDialog"
+msgid "Compare the means of two paired sets of data (t-test)."
+msgstr "So sánh trung bình của hai bộ dữ liệu ghép cặp (kiểm định t)."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:TabDialog"
+msgid "Set the order in which Tab moves through the form controls."
+msgstr "Đặt thứ tự phím Tab đi qua các điều khiển biểu mẫu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:TableCellBackgroundColor"
+msgid "Fill the selected table cells with a colour."
+msgstr "Tô màu nền cho các ô bảng đang chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:TableDesign"
+msgid "Apply a ready-made design to the table."
+msgstr "Áp dụng mẫu thiết kế có sẵn cho bảng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:TableDialog"
+msgid "Change the size, borders and background of the table."
+msgstr "Đổi cỡ, viền và nền của bảng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:TableNumberFormatDialog"
+msgid "Choose how numbers are shown in the table cells."
+msgstr "Chọn cách hiện số trong ô bảng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:TableSort"
+msgid "Sort the rows of the table."
+msgstr "Sắp xếp các hàng của bảng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:TemplateManager"
+msgid "Start a document from a template or manage templates."
+msgstr "Tạo tài liệu từ mẫu hoặc quản lý các mẫu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:TextWrap"
+msgid "Choose how the text wraps around the object."
+msgstr "Chọn cách chữ bao quanh đối tượng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:TextdirectionLeftToRight"
+msgid "Write the text from left to right, in horizontal lines."
+msgstr "Viết chữ từ trái sang phải theo dòng ngang."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:TextdirectionTopToBottom"
+msgid "Write the text from top to bottom."
+msgstr "Viết chữ theo chiều từ trên xuống dưới."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ThemeDialog"
+msgid "Apply a colour and font theme to the document."
+msgstr "Áp dụng chủ đề màu và phông chữ cho tài liệu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ThemeSelectorPanel"
+msgid "Apply a colour and font theme to the presentation."
+msgstr "Áp dụng chủ đề màu và phông chữ cho bài trình chiếu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ThesaurusDialog"
+msgid "Find words with a similar meaning."
+msgstr "Tìm từ có nghĩa tương tự."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:TimeField"
+msgid "Add a time field to the form."
+msgstr "Thêm ô nhập giờ vào biểu mẫu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:TipOfTheDay"
+msgid "Show a useful tip."
+msgstr "Hiện một mẹo sử dụng hữu ích."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:TitlePageDialog"
+msgid "Add a cover page or make a page the title page."
+msgstr "Thêm trang bìa hoặc đặt một trang làm trang tiêu đề."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ToggleFormula"
+msgid "Show the formulas in the cells instead of their results."
+msgstr "Hiện công thức trong ô thay cho kết quả."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ToggleObjectBezierMode"
+msgid "Edit the points of the selected shape."
+msgstr "Sửa các điểm của hình đang chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ToggleObjectRotateMode"
+msgid "Rotate the selected object with the mouse."
+msgstr "Xoay đối tượng đang chọn bằng chuột."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ToggleSheetGrid"
+msgid "Show or hide the grid lines between cells."
+msgstr "Hiện hoặc ẩn đường lưới giữa các ô."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ToggleTabBarVisibility"
+msgid "Show or hide the tabs of the views."
+msgstr "Hiện hoặc ẩn các thẻ chế độ xem."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:TransformDialog"
+msgid "Set the exact position, size and rotation of the object."
+msgstr "Đặt chính xác vị trí, cỡ và góc xoay của đối tượng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Underline"
+msgid "Underline the text."
+msgstr "Gạch dưới chữ."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Ungroup"
+msgid "Remove the grouping of the selected rows or columns."
+msgstr "Bỏ nhóm của các hàng hoặc cột đang chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:UnhainFrames"
+msgid "Stop text flowing from this frame into the next."
+msgstr "Ngừng cho chữ chảy từ khung này sang khung kế tiếp."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:UpdateAll"
+msgid "Update fields, links, indexes and charts."
+msgstr "Cập nhật trường, liên kết, mục lục và biểu đồ."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:UseWizards"
+msgid "Open a helper when you add a form control."
+msgstr "Mở trình hướng dẫn khi thêm điều khiển biểu mẫu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:VerticalText"
+msgid "Draw a text box with vertical text."
+msgstr "Vẽ hộp văn bản viết chữ theo chiều dọc."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ViewColumnRowHighlighting"
+msgid "Highlight the row and column of the current cell."
+msgstr "Tô sáng hàng và cột của ô hiện tại."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ViewDataSourceBrowser"
+msgid "Show the data sources and their tables."
+msgstr "Hiện các nguồn dữ liệu và bảng của chúng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ViewHiddenColRow"
+msgid "Mark the places where rows or columns are hidden."
+msgstr "Đánh dấu chỗ có hàng hoặc cột bị ẩn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ViewRowColumnHeaders"
+msgid "Show or hide the row numbers and column letters."
+msgstr "Hiện hoặc ẩn số hàng và chữ cột."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ViewValueHighlighting"
+msgid "Show numbers in blue, text in black and formulas in green."
+msgstr "Hiện số màu xanh dương, chữ màu đen và công thức màu xanh lá."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Watermark"
+msgid "Put faint text behind the content of every page."
+msgstr "Đặt chữ mờ phía sau nội dung của mọi trang."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Window3D"
+msgid "Change the 3D effects of the selected object."
+msgstr "Đổi hiệu ứng 3D của đối tượng đang chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:WrapIdeal"
+msgid "Wrap the text tightly around the object."
+msgstr "Cho chữ bao sát quanh đối tượng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:WrapLeft"
+msgid "Put the text only on the left of the object."
+msgstr "Chỉ đặt chữ bên trái đối tượng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:WrapOff"
+msgid "Put the text above and below the object only."
+msgstr "Chỉ đặt chữ phía trên và phía dưới đối tượng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:WrapOn"
+msgid "Wrap the text around the object's frame."
+msgstr "Cho chữ bao quanh khung của đối tượng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:WrapRight"
+msgid "Put the text only on the right of the object."
+msgstr "Chỉ đặt chữ bên phải đối tượng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:WrapThrough"
+msgid "Put the object behind or in front of the text."
+msgstr "Đặt đối tượng phía sau hoặc phía trước chữ."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:XLineColor"
+msgid "Change the color of the shape's outline."
+msgstr "Đổi màu viền của hình đang chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:XLineStyle"
+msgid "Choose the line style: solid, dashed or dotted."
+msgstr "Chọn kiểu đường: liền, gạch hoặc chấm."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ZTestDialog"
+msgid "Compare the mean of the data with a known value (z-test)."
+msgstr "So sánh trung bình dữ liệu với một giá trị đã biết (kiểm định z)."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Zoom"
+msgid "Choose how large the document looks on screen."
+msgstr "Chọn mức phóng to tài liệu trên màn hình."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:Zoom100Percent"
+msgid "Show the document at its real size."
+msgstr "Xem tài liệu ở cỡ thật 100%."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ZoomMinus"
+msgid "Make the view smaller."
+msgstr "Thu nhỏ khung nhìn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ZoomMode"
+msgid "Click to zoom in, drag with Shift to move the view."
+msgstr "Bấm để phóng to, giữ Shift và kéo để dời khung nhìn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ZoomNext"
+msgid "Go back to the next zoom level."
+msgstr "Chuyển tới mức phóng kế tiếp."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ZoomOptimal"
+msgid "Zoom to fit the selection or the content."
+msgstr "Phóng vừa với vùng chọn hoặc nội dung."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ZoomPage"
+msgid "Show the whole page in the window."
+msgstr "Hiện trọn trang trong cửa sổ."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ZoomPageWidth"
+msgid "Fit the page width to the window."
+msgstr "Phóng vừa bề rộng trang với cửa sổ."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ZoomPlus"
+msgid "Make the view bigger."
+msgstr "Phóng to khung nhìn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|.uno:ZoomPrevious"
+msgid "Go back to the previous zoom level."
+msgstr "Quay về mức phóng trước."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|org.hst.office.mailmerge:AddressBlock"
+msgid "Insert the recipient's address from the list."
+msgstr "Chèn địa chỉ người nhận lấy từ danh sách."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|org.hst.office.mailmerge:Check"
+msgid "Check the merge for errors before you finish."
+msgstr "Kiểm tra lỗi trộn thư trước khi hoàn tất."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|org.hst.office.mailmerge:EditRecipients"
+msgid "Choose and edit the people who receive the letter."
+msgstr "Chọn và sửa danh sách người nhận thư."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|org.hst.office.mailmerge:Find"
+msgid "Find a recipient in the list."
+msgstr "Tìm một người nhận trong danh sách."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|org.hst.office.mailmerge:Finish"
+msgid "Create the merged letters, print them or save them."
+msgstr "Tạo các thư đã trộn, in ra hoặc lưu lại."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|org.hst.office.mailmerge:First"
+msgid "Show the letter of the first recipient."
+msgstr "Xem thư của người nhận đầu tiên."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|org.hst.office.mailmerge:Greeting"
+msgid "Insert a greeting line such as \"Kính gửi\" and the name."
+msgstr "Chèn dòng chào như \"Kính gửi\" kèm họ tên."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|org.hst.office.mailmerge:InsertField"
+msgid "Insert a field from the recipient list, such as the name."
+msgstr "Chèn một trường từ danh sách người nhận, ví dụ họ tên."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|org.hst.office.mailmerge:Last"
+msgid "Show the letter of the last recipient."
+msgstr "Xem thư của người nhận cuối cùng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|org.hst.office.mailmerge:Next"
+msgid "Show the letter of the next recipient."
+msgstr "Xem thư của người nhận kế tiếp."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|org.hst.office.mailmerge:Prev"
+msgid "Show the letter of the previous recipient."
+msgstr "Xem thư của người nhận trước."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|org.hst.office.mailmerge:Preview"
+msgid "Show the letter with the data of a recipient."
+msgstr "Xem thư với dữ liệu của một người nhận."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|org.hst.office.mailmerge:Recipients"
+msgid "Choose the list of people who receive the letter."
+msgstr "Chọn danh sách người nhận thư."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|org.hst.office.mailmerge:Record"
+msgid "Go to the recipient with this number."
+msgstr "Tới người nhận có số thứ tự này."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|org.hst.office.mailmerge:Rules"
+msgid "Show text only when a condition on the data is met."
+msgstr "Chỉ hiện chữ khi dữ liệu thỏa một điều kiện."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|org.hst.office.mailmerge:Start"
+msgid "Start a mail merge: letters, envelopes or labels."
+msgstr "Bắt đầu trộn thư: thư, phong bì hoặc nhãn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|org.hst.office.update:Check"
+msgid "Check whether a newer version of HST Office is available."
+msgstr "Kiểm tra xem đã có phiên bản HST Office mới hơn chưa."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|org.hst.office.vi:CitationBibliography"
+msgid "Insert the list of sources cited in the document."
+msgstr "Chèn danh mục tài liệu tham khảo đã trích dẫn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|org.hst.office.vi:CitationInsert"
+msgid "Cite a source at the cursor."
+msgstr "Trích dẫn một nguồn tại vị trí con trỏ."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|org.hst.office.vi:CitationLibrary"
+msgid "Add, edit or delete the sources you cite."
+msgstr "Thêm, sửa hoặc xóa các nguồn trích dẫn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|org.hst.office.vi:CitationReinsert"
+msgid "Insert again a source you cited before."
+msgstr "Chèn lại một nguồn đã trích dẫn trước đó."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|org.hst.office.vi:CitationStyle"
+msgid "Choose the citation style, such as APA or IEEE."
+msgstr "Chọn kiểu trích dẫn, ví dụ APA hoặc IEEE."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|org.hst.office.vi:CitationUpdate"
+msgid "Update the citations and the list of sources."
+msgstr "Cập nhật các trích dẫn và danh mục tài liệu tham khảo."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|org.hst.office.vi:ConvertEncoding"
+msgid "Convert TCVN3 or VNI text to Unicode."
+msgstr "Chuyển chữ gõ bằng bảng mã TCVN3 (ABC) hoặc VNI sang Unicode."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|org.hst.office.vi:DeleteBlankRows"
+msgid "Delete the empty rows in the selection."
+msgstr "Xóa các dòng trống trong vùng chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|org.hst.office.vi:EditVba"
+msgid "Open the VBA macros of the document."
+msgstr "Mở các macro VBA của tài liệu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|org.hst.office.vi:FormatPercent"
+msgid "Show the numbers as percentages."
+msgstr "Hiện số dưới dạng phần trăm."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|org.hst.office.vi:KeyboardShortcuts"
+msgid "See the list of keyboard shortcuts."
+msgstr "Xem danh sách phím tắt."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|org.hst.office.vi:Nd30Wizard"
+msgid "Create an administrative document with the official layout."
+msgstr "Soạn văn bản hành chính đúng thể thức Nghị định 30/2020/NĐ-CP."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|org.hst.office.vi:NumberToWords"
+msgid "Write the selected number in Vietnamese words."
+msgstr "Đọc số đang chọn thành chữ tiếng Việt."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|org.hst.office.vi:OpenInHstPdf"
+msgid "Open this file in HST PDF to read or sign it."
+msgstr "Mở tệp tin này bằng HST PDF để đọc hoặc ký."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|org.hst.office.vi:RemoveDiacritics"
+msgid "Remove the Vietnamese accents from the selected text."
+msgstr "Bỏ dấu tiếng Việt khỏi chữ đang chọn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|org.hst.office.vi:ReportError"
+msgid "Send HASON TECH a report about a problem."
+msgstr "Gửi báo cáo lỗi cho HASON TECH."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|org.hst.office.vi:SetupUsbToken"
+msgid "Set up the USB token that holds your digital signature certificate."
+msgstr "Thiết lập USB token chứa chứng thư số để ký số tài liệu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|org.hst.office.vi:ShowSolutions"
+msgid "See the products and services of HASON TECH."
+msgstr "Xem các sản phẩm và dịch vụ của HASON TECH."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|org.hst.office.vi:SortByGivenName"
+msgid "Sort Vietnamese names by given name, then by family name."
+msgstr "Sắp xếp họ tên tiếng Việt theo tên, rồi theo họ."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|org.hst.office.vi:SplitName"
+msgid "Split full names into family name, middle name and given name."
+msgstr "Tách họ tên thành họ, tên đệm và tên."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|org.hst.office.vi:UILanguageEn"
+msgid "Show the interface in English."
+msgstr "Hiện giao diện bằng tiếng Anh."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|org.hst.office.vi:UILanguageSystem"
+msgid "Use the language of the computer for the interface."
+msgstr "Dùng ngôn ngữ của máy tính cho giao diện."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|org.hst.office.vi:UILanguageVi"
+msgid "Show the interface in Vietnamese."
+msgstr "Hiện giao diện bằng tiếng Việt."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|org.hst.office.vi:WhereIsCommand"
+msgid "Find where a familiar command is in the ribbon."
+msgstr "Tìm vị trí của một lệnh quen thuộc trên thanh công cụ."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|writer|.uno:AddDirect"
+msgid "Create a new blank document."
+msgstr "Tạo một tài liệu trống mới."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|writer|.uno:BackgroundColor"
+msgid "Colour the background of the whole paragraph."
+msgstr "Tô màu nền cho cả đoạn văn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|writer|.uno:BasicShapes"
+msgid "Draw rectangles, arrows, connectors and more."
+msgstr "Vẽ hình chữ nhật, mũi tên, đường nối."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|writer|.uno:ChangeCaseRotateCase"
+msgid "Cycle between lowercase, UPPERCASE and Capitalized Words."
+msgstr "Xoay vòng giữa chữ thường, chữ hoa và hoa đầu từ."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|writer|.uno:CharmapControl"
+msgid "Insert a special symbol such as ©, € or ±."
+msgstr "Chèn ký hiệu đặc biệt như ©, €, ±."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|writer|.uno:ControlCodes"
+msgid "Show paragraph marks, spaces and tabs."
+msgstr "Hiện dấu đoạn, dấu cách và dấu tab."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|writer|.uno:DecrementIndent"
+msgid "Move the paragraph one step out."
+msgstr "Kéo đoạn văn ra ngoài một nấc."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|writer|.uno:DesignerDialog"
+msgid "Pick a ready-made paragraph style; open the Styles pane to see them all."
+msgstr "Chọn kiểu đoạn văn có sẵn; mở bảng Kiểu để xem hết."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|writer|.uno:EditGlossary"
+msgid "Insert a piece of text you use often, saved beforehand."
+msgstr "Chèn đoạn chữ hay dùng đã lưu sẵn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|writer|.uno:FontworkGalleryFloater"
+msgid "Insert decorative text with effects."
+msgstr "Chèn chữ trang trí có hiệu ứng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|writer|.uno:Gallery"
+msgid "Open the collection of ready-made pictures and themes."
+msgstr "Mở kho hình và chủ đề có sẵn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|writer|.uno:Grow"
+msgid "Make the selected text one step larger."
+msgstr "Làm chữ đã chọn to hơn một bậc."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|writer|.uno:HangingIndent"
+msgid "The first line sticks out, the next lines are indented."
+msgstr "Dòng đầu nhô ra, các dòng sau thụt vào."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|writer|.uno:IncrementIndent"
+msgid "Move the paragraph one step in."
+msgstr "Đẩy đoạn văn vào trong một nấc."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|writer|.uno:InsertBookmark"
+msgid "Name a place so that you can jump to it quickly."
+msgstr "Đặt tên cho một vị trí để nhảy tới nhanh."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|writer|.uno:InsertColumnBreak"
+msgid "Continue the text in the next column."
+msgstr "Đưa chữ tiếp theo sang cột kế tiếp."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|writer|.uno:InsertDateField"
+msgid "Insert today's date as dd/mm/yyyy."
+msgstr "Chèn ngày hôm nay dạng dd/mm/yyyy."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|writer|.uno:InsertFieldCtrl"
+msgid "Insert a field that updates itself: page number, date, author and more."
+msgstr "Chèn trường tự cập nhật: số trang, ngày, tác giả."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|writer|.uno:InsertObject"
+msgid "Insert a spreadsheet, a drawing or another file into the document."
+msgstr "Chèn bảng tính, bản vẽ hoặc tệp khác vào tài liệu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|writer|.uno:InsertObjectStarMath"
+msgid "Write a mathematical formula."
+msgstr "Viết công thức toán học."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|writer|.uno:InsertPageFooter"
+msgid "Add or edit the page footer."
+msgstr "Thêm hoặc sửa phần chân trang."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|writer|.uno:InsertPageHeader"
+msgid "Add or edit the page header."
+msgstr "Thêm hoặc sửa phần đầu trang."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|writer|.uno:InsertReferenceField"
+msgid "Refer to another heading, figure or table and update its number by itself."
+msgstr "Dẫn tới tiêu đề, hình hoặc bảng khác và tự cập nhật số."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|writer|.uno:InsertSignatureLine"
+msgid "Add a signature line with the signer's name and title."
+msgstr "Thêm dòng ký tên có họ tên và chức vụ."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|writer|.uno:Open"
+msgid "Open an existing file from this computer or the network."
+msgstr "Mở một tệp có sẵn trên máy hoặc mạng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|writer|.uno:Print"
+msgid "Print the document on a printer."
+msgstr "In tài liệu ra máy in."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|writer|.uno:Redo"
+msgid "Redo the action you just undid."
+msgstr "Làm lại thao tác vừa hoàn tác."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|writer|.uno:Save"
+msgid "Save the open document."
+msgstr "Lưu tài liệu đang mở."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|writer|.uno:SelectAll"
+msgid "Select the whole document or select by object."
+msgstr "Chọn toàn bộ tài liệu hoặc chọn theo đối tượng."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|writer|.uno:SetBorderStyle"
+msgid "Draw a border around the paragraph."
+msgstr "Kẻ viền quanh đoạn văn."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|writer|.uno:SetOutline"
+msgid "A list with sub-levels, such as 1.1, 1.2."
+msgstr "Danh sách có cấp con, như 1.1, 1.2."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|writer|.uno:Shrink"
+msgid "Make the selected text one step smaller."
+msgstr "Làm chữ đã chọn nhỏ hơn một bậc."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|writer|.uno:SortDialog"
+msgid "Sort the paragraphs or lines by letter or number."
+msgstr "Sắp xếp các đoạn hoặc dòng theo chữ cái hay số."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|writer|.uno:Spacing"
+msgid "Spread or tighten the space between letters."
+msgstr "Nới hoặc khép khoảng cách giữa các chữ."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|writer|.uno:Strikeout"
+msgid "Draw a line through the text."
+msgstr "Kẻ một đường ngang qua chữ."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|writer|.uno:SubScript"
+msgid "Write small text below the line, as in H₂O."
+msgstr "Viết chữ nhỏ ở dưới dòng, như H₂O."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|writer|.uno:SuperScript"
+msgid "Write small text above the line, as in m²."
+msgstr "Viết chữ nhỏ ở trên dòng, như m²."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|writer|.uno:TitlePageDialog"
+msgid "Insert a ready-made cover page at the start of the document."
+msgstr "Chèn trang bìa có sẵn vào đầu tài liệu."
+
+#. hstTip
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTip|writer|.uno:Undo"
+msgid "Undo the last action."
+msgstr "Bỏ thao tác vừa làm."
+
