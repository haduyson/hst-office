+
+#. hstTitle
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTitle|writer|.uno:Color"
+msgid "Font Colour"
+msgstr "Màu chữ"
+
+#. hstTitle
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTitle|writer|.uno:EditGlossary"
+msgid "AutoText"
+msgstr "Văn bản tự động"
+
+#. hstTitle
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTitle|writer|.uno:FontHeight"
+msgid "Font Size"
+msgstr "Cỡ chữ"
+
+#. hstTitle
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTitle|writer|.uno:FormatDropcap"
+msgid "Drop Cap"
+msgstr "Chữ hoa đầu đoạn"
+
+#. hstTitle
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTitle|writer|.uno:HangingIndent"
+msgid "Hanging Indent"
+msgstr "Thụt lề treo"
+
+#. hstTitle
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTitle|writer|.uno:InsertDateField"
+msgid "Date"
+msgstr "Ngày"
+
+#. hstTitle
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTitle|writer|.uno:SearchDialog"
+msgid "Replace"
+msgstr "Thay thế"
+
+#. hstTitle
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTitle|writer|.uno:SetBorderStyle"
+msgid "Borders"
+msgstr "Viền"
+
+#. hstTitle
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTitle|writer|.uno:SortDialog"
+msgid "Sort"
+msgstr "Sắp xếp"
+
+#. hstTitle
+#: sfx2/source/notebookbar/HstRibbonTooltipTable.hrc
+msgctxt "HstRibbonTitle|writer|.uno:Strikeout"
+msgid "Strikethrough"
+msgstr "Gạch ngang"
