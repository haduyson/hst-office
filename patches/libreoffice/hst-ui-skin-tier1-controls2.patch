+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * This file is part of HST Office.
+ */
+
+/* Grouping and tooltips.
+   - The border of a scrolled window (the frame around a list, a tree or a preview): one line of the
+     control border with softly rounded corners, instead of VCL's 3D frame, in VCL's border width.
+   - A separator control (a group's heading line, a dialog's separator): one thin line instead of
+     VCL's two-colour 3D line.
+   - A tooltip: the menu surface, outlined by the menu border, with square corners (a tooltip is a
+     window of its own: corners outside a rounded outline would show whatever was there). */
+
+#include <hst/coat.hxx>
+#include "coat-paint.hxx"
+
+#include <vcl/hst/designtokens.hxx>
+#include <vcl/hst/drawhelpers.hxx>
+#include <vcl/outdev.hxx>
+#include <vcl/settings.hxx>
+#include <vcl/toolkit/fixed.hxx>
+#include <vcl/window.hxx>
+#include <vcl/wintypes.hxx>
+
+#include <algorithm>
+#include <cmath>
+
+namespace hst::coat
+{
+bool PaintTooltip(const PaintContext& rCtx, ControlPart ePart)
+{
+    if (ePart != ControlPart::Entire)
+        return false;
+    FillAndStroke(rCtx, rCtx.aRect, 0, rCtx.rPalette.aMenuSurface, rCtx.rPalette.aMenuBorder,
+                  rCtx.Px(hst::design::stroke::Border));
+    return true;
+}
+
+bool DrawScrolledWindowBorder(OutputDevice& rDev, const tools::Rectangle& rRect,
+                              tools::Long nBorderWidth)
+{
+    // not while recording a metafile: its replay would map the device pixels again
+    if (nBorderWidth <= 0 || rRect.IsEmpty() || rDev.GetConnectMetaFile() || !DrawsOn(rDev))
+        return false;
+    const hst::design::Palette& p = hst::design::GetPalette(rDev.GetSettings().GetStyleSettings());
+    const tools::Rectangle aPixels = rDev.LogicToPixel(rRect);
+    // One line, whatever VCL's width: a wider border keeps the window's background between the
+    // line and the content. The content is an opaque window right inside the border, so the
+    // corners round no more than a field's.
+    PaintScope aScope(rDev);
+    hst::design::DrawRoundRect(rDev, aPixels, INNER_WINDOW_RADIUS, COL_TRANSPARENT,
+                               p.aControlBorder, hst::design::stroke::Border);
+    return true;
+}
+
+bool DrawSeparatorLine(OutputDevice& rDev, const Point& rStart, const Point& rStop,
+                       bool bVertical)
+{
+    const vcl::Window* pWindow = rDev.GetOwnerWindow();
+    if (!pWindow || pWindow->GetType() != WindowType::FIXEDLINE || rDev.GetConnectMetaFile()
+        || !DrawsOn(rDev))
+        return false;
+    const hst::design::Palette& p = hst::design::GetPalette(rDev.GetSettings().GetStyleSettings());
+    const double fScale = std::max(1.0, double(rDev.GetDPIScaleFactor()));
+    const tools::Long nThick
+        = std::max<tools::Long>(1, std::lround(hst::design::size::FrameDivider * fScale));
+    const Point aStart = rDev.LogicToPixel(rStart);
+    const Point aStop = rDev.LogicToPixel(rStop);
+    // on the first of VCL's two lines (its shadow line), towards the second
+    const tools::Rectangle aLine
+        = bVertical ? tools::Rectangle(aStart.X(), std::min(aStart.Y(), aStop.Y()),
+                                       aStart.X() + nThick - 1, std::max(aStart.Y(), aStop.Y()))
+                    : tools::Rectangle(std::min(aStart.X(), aStop.X()), aStart.Y(),
+                                       std::max(aStart.X(), aStop.X()), aStart.Y() + nThick - 1);
+    PaintScope aScope(rDev);
+    rDev.SetLineColor();
+    rDev.SetFillColor(p.aCardBorder);
+    rDev.DrawRect(aLine);
+    return true;
+}
+
+bool DrawSeparatorLineForTesting(vcl::Window* pParent, bool bVertical)
+{
+    ScopedVclPtrInstance<FixedLine> pLine(pParent, bVertical ? WB_VERT : WB_HORZ);
+    pLine->SetPosSizePixel(Point(10, 10), Size(100, 10));
+    pLine->Show();
+    return bVertical ? DrawSeparatorLine(*pLine->GetOutDev(), Point(4, 0), Point(4, 9), true)
+                     : DrawSeparatorLine(*pLine->GetOutDev(), Point(0, 4), Point(99, 4), false);
+}
+}
