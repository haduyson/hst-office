+/* GTK-drawn lists, sliders, progress bars, frames, menu items and tooltips get the same tokens. */
+CPPUNIT_TEST_FIXTURE(CoatControlsTest, testGtkCssCoversTheControls)
+{
+    const OString aLight = hst::coat::CreateGtkCss(false);
+    const OString aDark = hst::coat::CreateGtkCss(true);
+    for (const char* pSelector :
+         { "treeview.view:selected", "treeview.view.expander", "scale trough", "scale highlight",
+           "scale slider", "progressbar trough", "progressbar progress", "frame > border",
+           ":not(paned) > separator", "menu menuitem:hover", "menu menuitem accelerator",
+           "tooltip", "treeview.view:hover", "list row:hover" })
+        CPPUNIT_ASSERT_MESSAGE(pSelector, aLight.indexOf(pSelector) >= 0);
+    auto hex = [](const Color& rColor) { return OString("#" + rColor.AsRGBHexString().toUtf8()); };
+    // the selected row: the accent and its ink in light, the selected-item tint and text in dark
+    const OString aRule("treeview.view:selected, treeview.view:selected:focus, list row:selected { "
+                        "background-color: ");
+    CPPUNIT_ASSERT(
+        aLight.indexOf(OString(aRule + hex(light().aAccent) + "; color: " + hex(light().aOnAccent)))
+        >= 0);
+    CPPUNIT_ASSERT(
+        aDark.indexOf(OString(aRule + hex(dark().aPill) + "; color: " + hex(dark().aText))) >= 0);
+    // the hover comes before the selection, which outranks it
+    CPPUNIT_ASSERT(aLight.indexOf("treeview.view:hover") < aLight.indexOf("treeview.view:selected"));
+    // a theme's primary action keeps readable text: the accent fill with its ink
+    CPPUNIT_ASSERT(aLight.indexOf(OString("button.suggested-action { background-color: "
+                                          + hex(light().aAccent) + "; border-color: "
+                                          + hex(light().aAccent) + "; color: "
+                                          + hex(light().aOnAccent)))
+                   >= 0);
+    // a shortcut reads in its own colour
+    CPPUNIT_ASSERT(aLight.indexOf(hex(light().aMenuShortcut)) >= 0);
+}
