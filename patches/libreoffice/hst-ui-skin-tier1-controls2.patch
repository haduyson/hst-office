+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * This file is part of HST Office.
+ */
+
+/* The rows of VCL's tree and list views (SvTreeListBox: the Navigator, the Styles list, the Options
+   tree, the File tab's recent files on Windows) in the HST look: the selected row is a rounded shape
+   in the HST selection colour, and the row under the mouse gets a pale rounded tint. The hover is
+   cheap: the row under the mouse is looked up on each mouse move, and only when it changes are the
+   row it left and the row it entered invalidated, inside the rows' area so the scroll bars do not
+   repaint with them; the rounded shapes are anti-aliased only at their ends (DrawListSelection). It
+   is tracked only while the coat draws, and not when the list selects by hovering (the hovered row
+   is then the selected one). */
+
+#include <hst/coat.hxx>
+#include "coat-paint.hxx"
+
+#include <vcl/event.hxx>
+#include <vcl/hst/designtokens.hxx>
+#include <vcl/settings.hxx>
+#include <vcl/toolkit/treelistbox.hxx>
+#include <vcl/toolkit/treelistentry.hxx>
+#include <vcl/wrkwin.hxx>
+
+#include <svimpbox.hxx>
+
+#include <algorithm>
+#include <chrono>
+#include <utility>
+#include <vector>
+
+void SvTreeListBox::CoatTrackHover(const MouseEvent& rMEvt)
+{
+    const SvTreeListEntry* pEntry = nullptr;
+    tools::Rectangle aRow;
+    if (!mbHoverSelection && !rMEvt.IsLeaveWindow() && GetEntryHeight() > 0
+        && hst::coat::DrawsOn(*GetOutDev()))
+    {
+        const Point aPos = rMEvt.GetPosPixel();
+        pEntry = GetEntry(aPos);
+        if (pEntry)
+        {
+            // the row inside the rows' area (SvImpLBox's output size): its scroll bars are child
+            // windows over the list's right and bottom edges, which a wider rectangle would make
+            // repaint with the row although nothing of theirs changes
+            const tools::Long nHeight = GetEntryHeight();
+            const Size& rRows = m_pImpl->GetOutputSize();
+            aRow = tools::Rectangle(Point(0, aPos.Y() / nHeight * nHeight), Size(rRows.Width(), nHeight))
+                       .GetIntersection(tools::Rectangle(Point(), rRows));
+        }
+    }
+    if (pEntry == m_pCoatHoverEntry)
+        return;
+    if (!m_aCoatHoverRow.IsEmpty())
+        Invalidate(PixelToLogic(m_aCoatHoverRow));
+    m_pCoatHoverEntry = pEntry;
+    m_aCoatHoverRow = aRow;
+    if (!aRow.IsEmpty())
+        Invalidate(PixelToLogic(aRow));
+}
+
+bool SvTreeListBox::CoatPaintRowBackground(vcl::RenderContext& rRenderContext,
+                                           const tools::Rectangle& rRect, const Color& rBackground,
+                                           const SvTreeListEntry& rEntry, bool bHighlighted,
+                                           bool bRoundStart, bool bRoundEnd)
+{
+    if (bHighlighted)
+        return hst::coat::DrawListSelection(rRenderContext, rRect, rBackground,
+                                            rRenderContext.GetTextColor(), bRoundStart, bRoundEnd);
+    if (&rEntry != m_pCoatHoverEntry || mbHoverSelection || !hst::coat::DrawsOn(rRenderContext))
+        return false;
+    // the row's own background (VCL set its fill colour) under the hover's rounded ends
+    rRenderContext.DrawRect(rRect);
+    const Color aHover
+        = hst::design::GetPalette(rRenderContext.GetSettings().GetStyleSettings()).aHover;
+    hst::coat::DrawListSelection(rRenderContext, rRect, aHover, rRenderContext.GetTextColor(),
+                                 bRoundStart, bRoundEnd);
+    return true;
+}
+
+namespace hst::coat
+{
+namespace
+{
+/** A tree list of nRows rows, 300 x 200 pixels, in pParent. */
+VclPtr<SvTreeListBox> makeList(vcl::Window* pParent, int nRows, bool bHoverSelection)
+{
+    VclPtr<SvTreeListBox> pList = VclPtr<SvTreeListBox>::Create(pParent, WB_BORDER);
+    pList->SetPosSizePixel(Point(0, 0), Size(300, 200));
+    for (int i = 0; i < nRows; ++i)
+        pList->InsertEntry(OUString(u"Mục " + OUString::number(i)));
+    pList->SetHoverSelection(bHoverSelection);
+    pList->Show();
+    return pList;
+}
+
+int rowOf(const SvTreeListBox& rList, const SvTreeListEntry* pEntry)
+{
+    if (!pEntry)
+        return -1;
+    return int(rList.GetModel()->GetAbsPos(pEntry));
+}
+}
+
+std::vector<int> ListHoverForTesting(vcl::Window* pParent, bool bHoverSelection,
+                                     const std::vector<Point>& rMoves)
+{
+    VclPtr<SvTreeListBox> pList = makeList(pParent, 20, bHoverSelection);
+    std::vector<int> aRows;
+    for (std::size_t i = 0; i < rMoves.size(); ++i)
+    {
+        // the last move leaves the window
+        const MouseEventModifiers eModifiers = i + 1 == rMoves.size() && rMoves.size() > 1
+                                                   ? MouseEventModifiers::LEAVEWINDOW
+                                                   : MouseEventModifiers::NONE;
+        pList->MouseMove(MouseEvent(rMoves[i], 0, eModifiers));
+        aRows.push_back(rowOf(*pList, pList->GetCoatHoverEntry()));
+    }
+    pList.disposeAndClear();
+    return aRows;
+}
+
+std::pair<tools::Rectangle, tools::Rectangle> ListHoverRowForTesting(vcl::Window* pParent)
+{
+    VclPtr<SvTreeListBox> pList = makeList(pParent, 20, false);
+    const tools::Long nHeight = pList->GetEntryHeight();
+    pList->MouseMove(MouseEvent(Point(20, nHeight + nHeight / 2)));
+    const tools::Rectangle aRow = pList->GetCoatHoverRow();
+    tools::Rectangle aScrollBar;
+    for (sal_uInt16 i = 0; i < pList->GetChildCount(); ++i)
+    {
+        const vcl::Window* pChild = pList->GetChild(i);
+        if (pChild->GetType() == WindowType::SCROLLBAR && pChild->IsVisible()
+            && (pChild->GetStyle() & WB_VSCROLL))
+            aScrollBar = tools::Rectangle(pChild->GetPosPixel(), pChild->GetSizePixel());
+    }
+    pList.disposeAndClear();
+    return { aRow, aScrollBar };
+}
+
+bool ListHoverPaintForTesting(vcl::Window* pParent, OutputDevice& rDev, bool bHoveredRow)
+{
+    VclPtr<SvTreeListBox> pList = makeList(pParent, 20, false);
+    const tools::Long nHeight = pList->GetEntryHeight();
+    // the mouse over the second row
+    pList->MouseMove(MouseEvent(Point(20, nHeight + nHeight / 2)));
+    const SvTreeListEntry* pEntry = pList->GetEntry(Point(20, (bHoveredRow ? 1 : 0) * nHeight + 1));
+    bool bDrawn = false;
+    if (pEntry)
+    {
+        rDev.SetLineColor();
+        rDev.SetFillColor(rDev.GetSettings().GetStyleSettings().GetFieldColor());
+        bDrawn = pList->CoatPaintRowBackground(rDev, tools::Rectangle(Point(), rDev.GetOutputSizePixel()),
+                                               rDev.GetFillColor(), *pEntry, false, true, true);
+    }
+    pList.disposeAndClear();
+    return bDrawn;
+}
+
+std::pair<double, double> ListRepaintTimingForTesting(vcl::Window* pParent, int nRows, int nMoves,
+                                                      int nScrolls)
+{
+    using Clock = std::chrono::steady_clock;
+    VclPtr<SvTreeListBox> pList = makeList(pParent, nRows, false);
+    pList->PaintImmediately();
+    const tools::Long nHeight = std::max<tools::Long>(1, pList->GetEntryHeight());
+    const tools::Long nVisible = std::max<tools::Long>(1, 200 / nHeight);
+    // the mouse sweeps down and up the visible rows, a few moves per row, each followed by its repaint
+    auto aStart = Clock::now();
+    for (int i = 0; i < nMoves; ++i)
+    {
+        const tools::Long nStep = i % (2 * nVisible * 4);
+        const tools::Long nY = (nStep < nVisible * 4 ? nStep : 2 * nVisible * 4 - nStep) * nHeight / 4;
+        pList->MouseMove(MouseEvent(Point(40, std::min<tools::Long>(nY, 199))));
+        pList->PaintImmediately();
+    }
+    const double fMoves
+        = std::chrono::duration<double, std::micro>(Clock::now() - aStart).count() / std::max(1, nMoves);
+    // scrolling a row at a time from the middle of the list, down then up, each followed by its repaint
+    if (SvTreeListEntry* pMiddle = pList->GetEntry(sal_uInt32(nRows / 2)))
+        pList->MakeVisible(pMiddle, true);
+    pList->PaintImmediately();
+    aStart = Clock::now();
+    for (int i = 0; i < nScrolls; ++i)
+    {
+        pList->ScrollOutputArea(i % 40 < 20 ? -1 : 1);
+        pList->PaintImmediately();
+    }
+    const double fScrolls = std::chrono::duration<double, std::micro>(Clock::now() - aStart).count()
+                            / std::max(1, nScrolls);
+    pList.disposeAndClear();
+    return { fMoves, fScrolls };
+}
+}
