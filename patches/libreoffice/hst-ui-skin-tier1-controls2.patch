+/* The cost of the hover: per mouse move and per one-row scroll of a 500-row list, each with its
+   repaint, with the coat and without (printed for the report; a gross regression fails). */
+CPPUNIT_TEST_FIXTURE(CoatControlsTest, testTreeRowHoverRepaintCost)
+{
+    ScopedVclPtrInstance<WorkWindow> pParent(nullptr, WB_STDWORK);
+    pParent->SetPosSizePixel(Point(0, 0), Size(400, 300));
+    pParent->Show();
+    // warm up (fonts, glyph caches), then measure each way twice and keep the faster
+    hst::coat::ListRepaintTimingForTesting(pParent.get(), 500, 200, 100);
+    auto measure = [&] {
+        auto a = hst::coat::ListRepaintTimingForTesting(pParent.get(), 500, 2000, 400);
+        auto b = hst::coat::ListRepaintTimingForTesting(pParent.get(), 500, 2000, 400);
+        return std::make_pair(std::min(a.first, b.first), std::min(a.second, b.second));
+    };
+    const auto aOn = measure();
+    setSwitch(false);
+    const auto aOff = measure();
+    setSwitch(true);
+    std::fprintf(stderr,
+                 "coat list repaint cost: mouse move %.1f us (coat off %.1f us), one-row scroll "
+                 "%.1f us (coat off %.1f us, %+.1f %%)\n",
+                 aOn.first, aOff.first, aOn.second, aOff.second,
+                 aOff.second > 0 ? (aOn.second / aOff.second - 1) * 100 : 0.0);
+    CPPUNIT_ASSERT_LESS(aOff.second * 2 + 50, aOn.second);
+}
