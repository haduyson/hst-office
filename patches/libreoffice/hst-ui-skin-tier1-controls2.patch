+/* A tree list's row under the mouse is followed while the coat draws: not when the list selects by
+   hovering, not once the mouse leaves, not with the coat switched off. */
+CPPUNIT_TEST_FIXTURE(CoatControlsTest, testTreeRowHoverFollowsTheMouse)
+{
+    ScopedVclPtrInstance<WorkWindow> pParent(nullptr, WB_STDWORK);
+    pParent->SetPosSizePixel(Point(0, 0), Size(400, 300));
+    const std::vector<Point> aMoves{ Point(20, 2), Point(20, 3), Point(20, 150), Point(20, 150) };
+    const std::vector<int> aRows = hst::coat::ListHoverForTesting(pParent.get(), false, aMoves);
+    CPPUNIT_ASSERT_EQUAL(size_t(4), aRows.size());
+    CPPUNIT_ASSERT_EQUAL(0, aRows[0]);
+    CPPUNIT_ASSERT_EQUAL(0, aRows[1]);
+    CPPUNIT_ASSERT_GREATER(0, aRows[2]);
+    CPPUNIT_ASSERT_EQUAL(-1, aRows[3]); // left the window
+
+    for (int nRow : hst::coat::ListHoverForTesting(pParent.get(), true, aMoves))
+        CPPUNIT_ASSERT_EQUAL(-1, nRow); // hover selection: the hovered row is the selected one
+    setSwitch(false);
+    for (int nRow : hst::coat::ListHoverForTesting(pParent.get(), false, aMoves))
+        CPPUNIT_ASSERT_EQUAL(-1, nRow);
+}
+
+/* The row under the mouse is invalidated inside the rows' area: the full width of the rows, not the
+   vertical scroll bar over the list's right edge, which has nothing to repaint. */
+CPPUNIT_TEST_FIXTURE(CoatControlsTest, testTreeRowHoverInvalidatesOnlyTheRow)
+{
+    ScopedVclPtrInstance<WorkWindow> pParent(nullptr, WB_STDWORK);
+    pParent->SetPosSizePixel(Point(0, 0), Size(400, 300));
+    const auto [aRow, aScrollBar] = hst::coat::ListHoverRowForTesting(pParent.get());
+    CPPUNIT_ASSERT(!aRow.IsEmpty());
+    CPPUNIT_ASSERT(!aScrollBar.IsEmpty());
+    CPPUNIT_ASSERT_EQUAL(tools::Long(0), aRow.Left());
+    CPPUNIT_ASSERT_EQUAL(aScrollBar.Left() - 1, aRow.Right());
+    CPPUNIT_ASSERT(!aRow.Overlaps(aScrollBar));
+}
