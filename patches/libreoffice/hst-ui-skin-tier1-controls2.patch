+/* A tooltip: the menu surface outlined by the menu border, square, in the palette of its text. */
+CPPUNIT_TEST_FIXTURE(CoatControlsTest, testTooltip)
+{
+    ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(100, 30));
+    CPPUNIT_ASSERT(draw(*pDev, ControlType::Tooltip, ControlPart::Entire, ControlState::NONE));
+    assertPixel("surface", *pDev, 50, 15, light().aMenuSurface);
+    assertPixel("border", *pDev, 0, 15, light().aMenuBorder);
+    assertPixel("square corner", *pDev, 0, 0, light().aMenuBorder);
+}
+
+/* The coat claims the parts the platform may not draw (a tooltip, a submenu arrow) so VCL asks it
+   for them, only while it draws: not in high contrast, not switched off, not where the platform
+   has no native look at all. */
+CPPUNIT_TEST_FIXTURE(CoatControlsTest, testClaimsOnlyWhileDrawing)
+{
+    ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(10, 10));
+    CPPUNIT_ASSERT(pDev->IsNativeControlSupported(ControlType::Tooltip, ControlPart::Entire));
+    CPPUNIT_ASSERT(
+        pDev->IsNativeControlSupported(ControlType::MenuPopup, ControlPart::SubmenuArrow));
+    CPPUNIT_ASSERT(!pDev->IsNativeControlSupported(ControlType::Tooltip, ControlPart::Focus));
+
+    ScopedVclPtr<VirtualDevice> pContrast = makeDevice(Size(10, 10), false, true);
+    CPPUNIT_ASSERT(!pContrast->IsNativeControlSupported(ControlType::Tooltip, ControlPart::Entire));
+
+    setSwitch(false);
+    CPPUNIT_ASSERT(!pDev->IsNativeControlSupported(ControlType::Tooltip, ControlPart::Entire));
+    setSwitch(true);
+
+    hst::coat::ForceForTesting(false);
+    CPPUNIT_ASSERT(!pDev->IsNativeControlSupported(ControlType::Tooltip, ControlPart::Entire));
+    CPPUNIT_ASSERT(
+        !pDev->IsNativeControlSupported(ControlType::MenuPopup, ControlPart::SubmenuArrow));
+}
+
+/* The border of a scrolled window (a list's or a tree's frame): one control-border line in VCL's
+   border width with a field's soft corners; the content inside is not touched. */
+CPPUNIT_TEST_FIXTURE(CoatControlsTest, testScrolledWindowBorder)
+{
+    const tools::Rectangle aFrame(Point(), Size(100, 60));
+    ScopedVclPtr<VirtualDevice> pDev = makeDevice(aFrame.GetSize());
+    CPPUNIT_ASSERT(hst::coat::DrawScrolledWindowBorder(*pDev, aFrame, 1));
+    assertPixel("top", *pDev, 50, 0, light().aControlBorder);
+    assertPixel("left", *pDev, 0, 30, light().aControlBorder);
+    assertPixel("bottom", *pDev, 50, 59, light().aControlBorder);
+    assertPixel("inside untouched", *pDev, 50, 30, MARKER);
+    assertPixel("inside the border pixel", *pDev, 1, 30, MARKER);
+    CPPUNIT_ASSERT(!isNear(pDev->GetPixel(Point(0, 0)), light().aControlBorder));
+    CPPUNIT_ASSERT(!hst::coat::DrawScrolledWindowBorder(*pDev, aFrame, 0));
+}
