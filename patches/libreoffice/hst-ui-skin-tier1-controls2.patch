+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * This file is part of HST Office.
+ */
+
+/* Lists and trees: the expander of a tree node is a chevron (pointing at the children once they
+   show), and a selected row is a rounded shape in the HST selection colour. Rows, their heights,
+   indents, images and text stay VCL's. */
+
+#include <hst/coat.hxx>
+#include "coat-paint.hxx"
+
+#include <vcl/hst/designtokens.hxx>
+#include <vcl/hst/drawhelpers.hxx>
+#include <vcl/outdev.hxx>
+#include <vcl/region.hxx>
+#include <vcl/settings.hxx>
+
+#include <algorithm>
+#include <cmath>
+
+namespace hst::coat
+{
+namespace
+{
+/** The fill of a selected row: the HST selection colour (or, failing the contrast, the other HST
+    candidates) in place of the theme's highlight colour, as long as the text VCL draws on it in
+    rText stays readable; any other colour (an unfocused list's selection) is kept. */
+Color selectionFill(const StyleSettings& rStyle, const Color& rFill, const Color& rText)
+{
+    if (rFill != rStyle.GetHighlightColor() && rFill != rStyle.GetListBoxWindowHighlightColor())
+        return rFill;
+    const hst::design::Palette& p = hst::design::GetPalette(rStyle);
+    for (const Color& rCandidate : { RowSelectionColours(p).aFill, p.aAccent, p.aPill })
+        if (ContrastRatio(rCandidate, rText) >= 4.5)
+            return rCandidate;
+    return rFill;
+}
+
+void fillRect(OutputDevice& rDev, const tools::Rectangle& rRect, const Color& rColor)
+{
+    rDev.SetLineColor();
+    rDev.SetFillColor(rColor);
+    rDev.DrawRect(rRect);
+}
+}
+
+bool PaintListNode(const PaintContext& rCtx, ControlPart ePart, ButtonValue eValue)
+{
+    if (ePart != ControlPart::Entire)
+        return false;
+    const auto& p = rCtx.rPalette;
+    // on a selected row (SELECTED) the glyph takes the selected text's colour
+    const Color aGlyph = !rCtx.IsEnabled() ? p.aDisabledText
+                         : (rCtx.eState & ControlState::SELECTED)
+                             ? rCtx.rStyle.GetHighlightTextColor()
+                         : rCtx.IsHover() ? p.aText
+                                          : p.aMuted;
+    DrawChevron(rCtx, rCtx.aRect, eValue == ButtonValue::On ? Chevron::Down : Chevron::Right,
+                aGlyph);
+    return true;
+}
+
+bool DrawListSelection(OutputDevice& rDev, const tools::Rectangle& rRect, const Color& rFill,
+                       const Color& rText, bool bRoundStart, bool bRoundEnd)
+{
+    // not while recording a metafile: its replay would map the device pixels again
+    if (rRect.IsEmpty() || rFill == COL_TRANSPARENT || rDev.GetConnectMetaFile() || !DrawsOn(rDev))
+        return false;
+    const StyleSettings& rStyle = rDev.GetSettings().GetStyleSettings();
+    const Color aFill = selectionFill(rStyle, rFill, rText);
+    const double fScale = std::max(1.0, double(rDev.GetDPIScaleFactor()));
+    const tools::Rectangle aPixels = rDev.LogicToPixel(rRect);
+
+    PaintScope aScope(rDev);
+    if (!bRoundStart && !bRoundEnd)
+    {
+        // a row that continues in the columns on both sides: square at both ends
+        fillRect(rDev, aPixels, aFill);
+        return true;
+    }
+    const double fRadius = std::min(hst::design::radius::Row * fScale, aPixels.GetHeight() / 4.0);
+    // The rounded shape covers exactly the row's pixels (DrawRoundRect), so away from its rounded
+    // ends it is the plain fill of those pixels. Only the columns its arcs reach (and one more for
+    // the anti-aliasing) take the anti-aliased shape, clipped to them on whole pixels; the straight
+    // middle, and an end that continues in the next column, is one plain rectangle. The pixels are
+    // those of the whole shape, at a fraction of the cost: this is drawn for the row under the mouse
+    // and the selected row on every repaint of a list.
+    const tools::Long nEnd = tools::Long(std::ceil(fRadius)) + 1;
+    if (aPixels.GetWidth() <= 2 * nEnd)
+    {
+        // too narrow for a straight middle: the whole shape, then any square end over its half
+        hst::design::DrawRoundRect(rDev, aPixels, fRadius, aFill, COL_TRANSPARENT, 0);
+        if (bRoundStart != bRoundEnd)
+        {
+            tools::Rectangle aSquare(aPixels);
+            if (bRoundStart)
+                aSquare.SetLeft(aPixels.Center().X());
+            else
+                aSquare.SetRight(aPixels.Center().X());
+            fillRect(rDev, aSquare, aFill);
+        }
+        return true;
+    }
+    tools::Rectangle aMiddle(aPixels);
+    if (bRoundStart)
+        aMiddle.SetLeft(aPixels.Left() + nEnd);
+    if (bRoundEnd)
+        aMiddle.SetRight(aPixels.Right() - nEnd);
+    fillRect(rDev, aMiddle, aFill);
+    vcl::Region aEnds;
+    if (bRoundStart)
+        aEnds.Union(tools::Rectangle(aPixels.TopLeft(), Point(aMiddle.Left() - 1, aPixels.Bottom())));
+    if (bRoundEnd)
+        aEnds.Union(tools::Rectangle(Point(aMiddle.Right() + 1, aPixels.Top()), aPixels.BottomRight()));
+    rDev.Push(vcl::PushFlags::CLIPREGION);
+    rDev.IntersectClipRegion(aEnds);
+    hst::design::DrawRoundRect(rDev, aPixels, fRadius, aFill, COL_TRANSPARENT, 0);
+    rDev.Pop();
+    return true;
+}
+}
