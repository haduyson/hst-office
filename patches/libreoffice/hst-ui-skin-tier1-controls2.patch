@@ -0,0 +1,105 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * This file is part of HST Office.
+ */
+
+/* Sliders and progress bars.
+   Slider: a thin groove along the control, accent up to the thumb, and a round thumb (a ring around
+   an accent dot) at the centre of the thumb rectangle VCL computed from the platform's thumb size,
+   so dragging and clicking hit exactly where they did.
+   Progress bar: a rounded track in the control border, filled with the accent up to the value. */
+
+#include "coat-paint.hxx"
+
+#include <basegfx/point/b2dpoint.hxx>
+#include <basegfx/polygon/b2dpolygontools.hxx>
+#include <vcl/hst/designtokens.hxx>
+
+#include <algorithm>
+#include <cmath>
+
+namespace hst::coat
+{
+bool PaintSlider(const PaintContext& rCtx, ControlPart ePart, const ImplControlValue& /*rValue*/)
+{
+    const bool bHorizontal = ePart == ControlPart::TrackHorzArea;
+    if (!bHorizontal && ePart != ControlPart::TrackVertArea)
+        return false;
+    const auto& p = rCtx.rPalette;
+    const tools::Rectangle& rArea = rCtx.aRect;
+    const tools::Rectangle& rThumb = rCtx.aUpper;
+    const bool bEnabled = rCtx.IsEnabled();
+
+    // The groove ends half a thumb in from the control's ends, where the thumb's centre stops.
+    const tools::Long nGroove = std::max<tools::Long>(2, std::lround(rCtx.Px(4)));
+    const tools::Long nHalfThumb
+        = rThumb.IsEmpty() ? 0 : (bHorizontal ? rThumb.GetWidth() : rThumb.GetHeight()) / 2;
+    tools::Rectangle aGroove(rArea);
+    if (bHorizontal)
+    {
+        const tools::Long nTop = rArea.Top() + (rArea.GetHeight() - nGroove) / 2;
+        aGroove = tools::Rectangle(rArea.Left() + nHalfThumb, nTop, rArea.Right() - nHalfThumb,
+                                   nTop + nGroove - 1);
+    }
+    else
+    {
+        const tools::Long nLeft = rArea.Left() + (rArea.GetWidth() - nGroove) / 2;
+        aGroove = tools::Rectangle(nLeft, rArea.Top() + nHalfThumb, nLeft + nGroove - 1,
+                                   rArea.Bottom() - nHalfThumb);
+    }
+    if (aGroove.IsEmpty())
+        return false;
+    const double fGrooveRadius = nGroove / 2.0;
+    FillAndStroke(rCtx, aGroove, fGrooveRadius, bEnabled ? p.aControlBorder : p.aDisabledBorder,
+                  COL_TRANSPARENT, 0);
+    if (rThumb.IsEmpty())
+        return true;
+
+    // the groove up to the thumb's centre in the accent: the value at a glance
+    const Point aCentre = rThumb.Center();
+    tools::Rectangle aFilled(aGroove);
+    if (bHorizontal)
+        aFilled.SetRight(std::clamp(aCentre.X(), aGroove.Left(), aGroove.Right()));
+    else
+        aFilled.SetBottom(std::clamp(aCentre.Y(), aGroove.Top(), aGroove.Bottom()));
+    if (!aFilled.IsEmpty())
+        FillAndStroke(rCtx, aFilled, fGrooveRadius, bEnabled ? p.aAccent : p.aDisabledText,
+                      COL_TRANSPARENT, 0);
+
+    // the thumb: a ring of the control border (accent when hovered or focused) around an accent dot
+    const tools::Rectangle aBox = MarkBox(rThumb);
+    const bool bHover = bool(rCtx.eUpperState & ControlState::ROLLOVER);
+    const Color aRing = !bEnabled                         ? p.aDisabledBorder
+                        : (bHover || rCtx.IsFocused()) ? p.aAccent
+                                                          : p.aControlBorder;
+    const double fRing = rCtx.IsFocused() ? rCtx.Px(hst::design::FIELD_FOCUS_BORDER)
+                                          : rCtx.Px(hst::design::stroke::Border);
+    FillAndStroke(rCtx, aBox, aBox.GetWidth() / 2.0, p.aCard, aRing, fRing);
+    const double fSide = aBox.GetWidth();
+    const basegfx::B2DPoint aDotCentre(aBox.Left() + fSide / 2, aBox.Top() + fSide / 2);
+    FillShape(rCtx,
+              basegfx::B2DPolyPolygon(basegfx::utils::createPolygonFromCircle(
+                  aDotCentre, fSide * (bHover ? 0.3 : 0.25))),
+              bEnabled ? p.aAccent : p.aDisabledText);
+    return true;
+}
+
+bool PaintProgress(const PaintContext& rCtx, ControlPart ePart, const ImplControlValue& /*rValue*/)
+{
+    if (ePart != ControlPart::Entire)
+        return false;
+    const auto& p = rCtx.rPalette;
+    const double fRadius = std::min(rCtx.Px(hst::design::radius::MenuItem),
+                                    std::min(rCtx.aRect.GetWidth(), rCtx.aRect.GetHeight()) / 2.0);
+    FillAndStroke(rCtx, rCtx.aRect, fRadius, p.aScrollTrack, p.aControlBorder,
+                  rCtx.Px(hst::design::stroke::Border));
+    // the done part (aUpper: from the start to the value) covers the track's border too
+    if (!rCtx.aUpper.IsEmpty())
+        FillAndStroke(rCtx, rCtx.aUpper, fRadius, p.aAccent, COL_TRANSPARENT, 0);
+    return true;
+}
