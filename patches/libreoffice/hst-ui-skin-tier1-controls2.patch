+        return false;
+    // the arrow only beside items the coat draws: where the platform draws the menu natively
+    return eType != ControlType::MenuPopup || g_bForced.load(std::memory_order_relaxed)
+           || rDev.IsNativeControlSupported(ControlType::MenuPopup, ControlPart::Entire);
