+
+namespace
+{
+// a colour the coat never paints: what is left of it was not painted
+constexpr Color MARKER(0xFF, 0x00, 0xFF);
+constexpr ControlState ENABLED = ControlState::ENABLED;
+
+/* The coat's tree expanders, list selections, sliders, progress bars, menu items, tooltips, group
+   frames and separators, drawn on a VirtualDevice of the headless backend (ForceForTesting stands in
+   for a platform with a native look) and probed pixel by pixel. */
+class CoatControlsTest : public test::BootstrapFixture
+{
+public:
+    CoatControlsTest()
+        : test::BootstrapFixture(true, false)
+    {
+    }
+
+    void setUp() override
+    {
+        test::BootstrapFixture::setUp();
+        unsetenv("HST_UI_COAT");
+        setSwitch(true);
+        hst::coat::ForceForTesting(true);
+    }
+
+    void tearDown() override
+    {
+        hst::coat::ForceForTesting(false);
+        setSwitch(true);
+        test::BootstrapFixture::tearDown();
+    }
+
+protected:
+    static void setSwitch(bool bOn)
+    {
+        auto xChanges = comphelper::ConfigurationChanges::create();
+        officecfg::Office::HSTAppearance::UiCoat::Enabled::set(bOn, xChanges);
+        xChanges->commit();
+        hst::coat::ResetSwitchForTesting();
+    }
+
+    static ScopedVclPtr<VirtualDevice> makeDevice(const Size& rSize, bool bDark = false,
+                                                  bool bHighContrast = false)
+    {
+        ScopedVclPtr<VirtualDevice> pDev = VclPtr<VirtualDevice>::Create();
+        AllSettings aSettings = pDev->GetSettings();
+        StyleSettings aStyle = aSettings.GetStyleSettings();
+        aStyle.SetHighContrastMode(bHighContrast);
+        const Color aText = bDark ? COL_WHITE : COL_BLACK;
+        aStyle.SetWindowColor(bDark ? Color(0x20, 0x20, 0x20) : COL_WHITE);
+        aStyle.SetFieldColor(bDark ? Color(0x2A, 0x2A, 0x2A) : COL_WHITE);
+        aStyle.SetDialogColor(bDark ? Color(0x28, 0x28, 0x28) : Color(0xF0, 0xF0, 0xF0));
+        aStyle.SetMenuTextColor(aText);
+        aStyle.SetMenuHighlightTextColor(aText);
+        aStyle.SetHelpTextColor(aText);
+        aStyle.SetHighlightColor(Color(0x33, 0x99, 0xFF));
+        aStyle.SetHighlightTextColor(COL_WHITE);
+        aSettings.SetStyleSettings(aStyle);
+        pDev->SetSettings(aSettings);
+        pDev->SetOutputSizePixel(rSize);
+        pDev->SetBackground(Wallpaper(MARKER));
+        pDev->Erase();
+        return pDev;
+    }
+
+    static const hst::design::Palette& light() { return hst::design::GetPalette(false); }
+    static const hst::design::Palette& dark() { return hst::design::GetPalette(true); }
+
+    static bool draw(VirtualDevice& rDev, ControlType eType, ControlPart ePart,
+                     ControlState eState, const ImplControlValue& rValue = ImplControlValue())
+    {
+        return rDev.DrawNativeControl(eType, ePart,
+                                      tools::Rectangle(Point(), rDev.GetOutputSizePixel()),
+                                      eState, rValue, OUString());
+    }
+
+    static bool isNear(const Color& rA, const Color& rB, int nTolerance = 2)
+    {
+        return std::abs(rA.GetRed() - rB.GetRed()) <= nTolerance
+               && std::abs(rA.GetGreen() - rB.GetGreen()) <= nTolerance
+               && std::abs(rA.GetBlue() - rB.GetBlue()) <= nTolerance;
+    }
+
+    /** rExpected at (nX, nY), give or take the rounding of the anti-aliasing backend. */
+    static void assertPixel(const char* pWhat, const VirtualDevice& rDev, tools::Long nX,
+                            tools::Long nY, const Color& rExpected)
+    {
+        const Color aActual = rDev.GetPixel(Point(nX, nY));
+        CPPUNIT_ASSERT_MESSAGE(OString(OString::Concat(pWhat) + ": expected "
+                                       + rExpected.AsRGBHexString().toUtf8() + " at "
+                                       + OString::number(nX) + "," + OString::number(nY)
+                                       + ", got " + aActual.AsRGBHexString().toUtf8())
+                                   .getStr(),
+                               isNear(aActual, rExpected));
+    }
+
+    /** The bounds of the pixels painted in (nearly) rInk: a glyph's extent. */
+    static tools::Rectangle inkBounds(const VirtualDevice& rDev, const Color& rInk)
+    {
+        tools::Rectangle aBounds;
+        const Size aSize = rDev.GetOutputSizePixel();
+        for (tools::Long nY = 0; nY < aSize.Height(); ++nY)
+            for (tools::Long nX = 0; nX < aSize.Width(); ++nX)
+                if (isNear(rDev.GetPixel(Point(nX, nY)), rInk, 48))
+                    aBounds.Union(tools::Rectangle(Point(nX, nY), Size(1, 1)));
+        return aBounds;
+    }
+};
+
+/* A tree node's expander is a chevron in the muted text colour: pointing right (taller than wide)
+   while collapsed, down (wider than tall) once expanded; on a selected row in the selected text's
+   colour. Nothing else of the region is painted: the row's background stays. */
+CPPUNIT_TEST_FIXTURE(CoatControlsTest, testTreeExpanderIsAChevron)
+{
+    {
+        ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(16, 16));
+        CPPUNIT_ASSERT(draw(*pDev, ControlType::ListNode, ControlPart::Entire, ENABLED,
+                            ImplControlValue(ButtonValue::Off)));
+        const tools::Rectangle aInk = inkBounds(*pDev, light().aMuted);
+        CPPUNIT_ASSERT(!aInk.IsEmpty());
+        CPPUNIT_ASSERT_GREATER(aInk.GetWidth(), aInk.GetHeight());
+        assertPixel("row background kept", *pDev, 0, 0, MARKER);
+    }
+    {
+        ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(16, 16));
+        CPPUNIT_ASSERT(draw(*pDev, ControlType::ListNode, ControlPart::Entire, ENABLED,
+                            ImplControlValue(ButtonValue::On)));
+        const tools::Rectangle aInk = inkBounds(*pDev, light().aMuted);
+        CPPUNIT_ASSERT(!aInk.IsEmpty());
+        CPPUNIT_ASSERT_GREATER(aInk.GetHeight(), aInk.GetWidth());
+    }
+    {
+        ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(16, 16));
+        draw(*pDev, ControlType::ListNode, ControlPart::Entire, ENABLED | ControlState::SELECTED,
+             ImplControlValue(ButtonValue::Off));
+        CPPUNIT_ASSERT(!inkBounds(*pDev, COL_WHITE).IsEmpty());
+        CPPUNIT_ASSERT(inkBounds(*pDev, light().aMuted).IsEmpty());
+    }
+}
+
+/* A selected row is a rounded shape. The theme's highlight colour gives way to the HST selection
+   colour where the selected text stays readable on it: the accent under white text in the light
+   palette, the selected-item tint under white text in the dark one, the light tint under black
+   text. Any other colour (an unfocused list's) is kept. A row across columns rounds its ends only. */
+CPPUNIT_TEST_FIXTURE(CoatControlsTest, testListSelectionIsARoundedHstShape)
+{
+    const tools::Rectangle aRow(Point(), Size(100, 20));
+    {
+        ScopedVclPtr<VirtualDevice> pDev = makeDevice(aRow.GetSize());
+        CPPUNIT_ASSERT(hst::coat::DrawListSelection(*pDev, aRow, Color(0x33, 0x99, 0xFF),
+                                                    COL_WHITE, true, true));
+        assertPixel("accent fill", *pDev, 50, 10, light().aAccent);
+        assertPixel("rounded corner", *pDev, 0, 0, MARKER);
+        assertPixel("rounded corner, end", *pDev, 99, 19, MARKER);
+    }
+    {
+        ScopedVclPtr<VirtualDevice> pDev = makeDevice(aRow.GetSize());
+        hst::coat::DrawListSelection(*pDev, aRow, Color(0x33, 0x99, 0xFF), COL_WHITE, false, true);
+        assertPixel("square start of a row that continues", *pDev, 0, 0, light().aAccent);
+        assertPixel("rounded end", *pDev, 99, 19, MARKER);
+    }
+    {
+        ScopedVclPtr<VirtualDevice> pDev = makeDevice(aRow.GetSize(), true);
+        hst::coat::DrawListSelection(*pDev, aRow, Color(0x33, 0x99, 0xFF), COL_WHITE, true, true);
+        assertPixel("dark: the selected-item tint", *pDev, 50, 10, dark().aPill);
+    }
+    {
+        ScopedVclPtr<VirtualDevice> pDev = makeDevice(aRow.GetSize());
+        hst::coat::DrawListSelection(*pDev, aRow, Color(0x33, 0x99, 0xFF), COL_BLACK, true, true);
+        assertPixel("black text: the light tint", *pDev, 50, 10, light().aPill);
+    }
+    {
+        ScopedVclPtr<VirtualDevice> pDev = makeDevice(aRow.GetSize());
+        hst::coat::DrawListSelection(*pDev, aRow, Color(0xC0, 0xC0, 0xC0), COL_BLACK, true, true);
+        assertPixel("an unfocused selection keeps its colour", *pDev, 50, 10,
+                    Color(0xC0, 0xC0, 0xC0));
+    }
+    {
+        ScopedVclPtr<VirtualDevice> pDev = makeDevice(aRow.GetSize(), false, true);
+        CPPUNIT_ASSERT(!hst::coat::DrawListSelection(*pDev, aRow, Color(0x33, 0x99, 0xFF),
+                                                     COL_WHITE, true, true));
+        assertPixel("high contrast: VCL's own rectangle", *pDev, 50, 10, MARKER);
+    }
+}
+
+/* The selection (and the hover) is anti-aliased only at its rounded ends, the straight middle filled
+   as a plain rectangle: pixel for pixel the whole rounded shape drawn by the shared helper, with any
+   square end filled over its half, for every height (radius), width (down to rows too narrow for a
+   middle) and pair of ends. Inside a clip only the clipped part is painted, and the clip stays. */
+CPPUNIT_TEST_FIXTURE(CoatControlsTest, testListSelectionPixelsMatchTheWholeRoundedShape)
+{
+    // not a highlight colour: drawn as given, so the reference uses the same colour
+    const Color aFill(0xC0, 0xD8, 0xF0);
+    for (tools::Long nHeight : { 8, 16, 18, 20, 23, 24, 40 })
+        for (tools::Long nWidth : { 9, 12, 13, 14, 15, 16, 17, 31, 120 })
+            for (int nEnds = 0; nEnds < 4; ++nEnds)
+            {
+                const bool bStart = (nEnds & 1) != 0, bEnd = (nEnds & 2) != 0;
+                const Size aSize(nWidth + 6, nHeight + 4);
+                const tools::Rectangle aRow(Point(3, 2), Size(nWidth, nHeight));
+                ScopedVclPtr<VirtualDevice> pDev = makeDevice(aSize);
+                CPPUNIT_ASSERT(hst::coat::DrawListSelection(*pDev, aRow, aFill, COL_BLACK, bStart, bEnd));
+
+                ScopedVclPtr<VirtualDevice> pRef = makeDevice(aSize);
+                pRef->SetAntialiasing(AntialiasingFlags::Enable);
+                if (bStart || bEnd)
+                    hst::design::DrawRoundRect(
+                        *pRef, aRow, std::min(hst::design::radius::Row, nHeight / 4.0), aFill,
+                        COL_TRANSPARENT, 0);
+                if (!bStart || !bEnd)
+                {
+                    tools::Rectangle aSquare(aRow);
+                    if (bStart)
+                        aSquare.SetLeft(aRow.Center().X());
+                    if (bEnd)
+                        aSquare.SetRight(aRow.Center().X());
+                    pRef->SetLineColor();
+                    pRef->SetFillColor(aFill);
+                    pRef->DrawRect(aSquare);
+                }
+                for (tools::Long nY = 0; nY < aSize.Height(); ++nY)
+                    for (tools::Long nX = 0; nX < aSize.Width(); ++nX)
+                    {
+                        const Color aGot = pDev->GetPixel(Point(nX, nY));
+                        const Color aWant = pRef->GetPixel(Point(nX, nY));
+                        if (aGot != aWant)
+                            CPPUNIT_FAIL(OString("row " + OString::number(nWidth) + "x"
+                                                 + OString::number(nHeight) + " ends "
+                                                 + OString::number(nEnds) + " at "
+                                                 + OString::number(nX) + "," + OString::number(nY)
+                                                 + ": " + aGot.AsRGBHexString().toUtf8() + " instead of "
+                                                 + aWant.AsRGBHexString().toUtf8())
+                                             .getStr());
+                    }
+            }
+
+    // a clip already on the device (a repaint of part of the row): nothing outside it, and kept
+    const tools::Rectangle aRow(Point(), Size(100, 20));
+    ScopedVclPtr<VirtualDevice> pDev = makeDevice(aRow.GetSize());
+    const vcl::Region aClip(tools::Rectangle(Point(), Size(50, 20)));
+    pDev->SetClipRegion(aClip);
+    CPPUNIT_ASSERT(hst::coat::DrawListSelection(*pDev, aRow, aFill, COL_BLACK, true, true));
+    CPPUNIT_ASSERT(pDev->IsClipRegion());
+    CPPUNIT_ASSERT(bool(aClip == pDev->GetClipRegion()));
+    pDev->SetClipRegion();
+    assertPixel("inside the clip", *pDev, 30, 10, aFill);
+    assertPixel("left of the clip's edge", *pDev, 49, 10, aFill);
+    assertPixel("outside the clip", *pDev, 50, 10, MARKER);
+    assertPixel("the clipped-off rounded end", *pDev, 98, 10, MARKER);
+}
+
+/* A slider: a groove of the control border ending half a thumb in from the ends, the accent up to
+   the thumb's centre, a round thumb (a ring around an accent dot) inside the thumb rectangle VCL
+   gave, the ring in the accent when hovered, two pixels when focused. */
+CPPUNIT_TEST_FIXTURE(CoatControlsTest, testSliderGrooveValueAndThumb)
+{
+    const tools::Rectangle aThumb(Point(90, 5), Size(21, 21));
+    auto slider = [&](VirtualDevice& rDev, ControlState eState,
+                      ControlState eThumb = ControlState::NONE) {
+        return hst::coat::DrawSliderForTesting(rDev, ControlPart::TrackHorzArea, eState, aThumb,
+                                               eThumb);
+    };
+    {
+        ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(200, 30));
+        CPPUNIT_ASSERT(slider(*pDev, ENABLED));
+        assertPixel("groove up to the thumb", *pDev, 50, 14, light().aAccent);
+        assertPixel("groove after the thumb", *pDev, 150, 14, light().aControlBorder);
+        assertPixel("beside the groove", *pDev, 150, 8, MARKER);
+        assertPixel("before the groove's end", *pDev, 4, 14, MARKER);
+        assertPixel("thumb ring", *pDev, 100, 5, light().aControlBorder);
+        assertPixel("thumb fill", *pDev, 100, 9, light().aCard);
+        assertPixel("thumb dot", *pDev, 100, 15, light().aAccent);
+        assertPixel("outside the thumb", *pDev, 100, 2, MARKER);
+    }
+    {
+        ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(200, 30));
+        slider(*pDev, ENABLED, ControlState::ROLLOVER);
+        assertPixel("hovered ring", *pDev, 100, 5, light().aAccent);
+    }
+    {
+        ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(200, 30));
+        slider(*pDev, ENABLED | ControlState::FOCUSED);
+        assertPixel("focus ring, inner pixel", *pDev, 100, 6, light().aAccent);
+    }
+    {
+        ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(200, 30));
+        slider(*pDev, ControlState::NONE);
+        assertPixel("disabled value", *pDev, 50, 14, light().aDisabledText);
+    }
+    {
+        ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(30, 200));
+        CPPUNIT_ASSERT(hst::coat::DrawSliderForTesting(
+            *pDev, ControlPart::TrackVertArea, ENABLED,
+            tools::Rectangle(Point(5, 90), Size(21, 21)), ControlState::NONE));
+        assertPixel("vertical: up to the thumb", *pDev, 14, 50, light().aAccent);
+        assertPixel("vertical: after the thumb", *pDev, 14, 150, light().aControlBorder);
+    }
+}
+
+/* A progress bar: a rounded track outlined in the control border, the accent up to the value. */
