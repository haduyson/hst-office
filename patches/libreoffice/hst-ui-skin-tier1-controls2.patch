+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * This file is part of HST Office.
+ */
+
+/* Popup and context menus that VCL draws through the platform's native menu parts (Windows, and
+   any platform whose popup menus are VCL windows): the menu's surface, the highlighted item, the
+   separators, the check and radio marks and the submenu arrow. The palette is the one the menu's
+   text (drawn by VCL in the theme's menu text colours) reads on. Item heights, the check column,
+   the text and shortcut positions and the menu's size stay VCL's and the platform's: they are laid
+   out before any of this is drawn.
+
+   Where the menu's frame builds on this:
+   - paintSurface draws the whole menu (ControlPart::Entire; also behind the highlighted item, clipped
+     to its row) as one flat surface with square corners. The menu's outline, a rounded content
+     edge (radius::Menu) and a shadow belong there, under the frame's switch (FrameCoat/Menus).
+   - highlightRect is the shape of the highlighted item: inset from the menu's sides and rounded
+     with radius::MenuItem, so it stays clear of a rounded outline. */
+
+#include "coat-paint.hxx"
+
+#include <basegfx/point/b2dpoint.hxx>
+#include <basegfx/polygon/b2dpolygontools.hxx>
+#include <vcl/hst/designtokens.hxx>
+#include <vcl/outdev.hxx>
+#include <vcl/settings.hxx>
+
+#include <algorithm>
+#include <cmath>
+
+namespace hst::coat
+{
+namespace
+{
+void paintSurface(const PaintContext& rCtx)
+{
+    rCtx.rDev.SetLineColor();
+    rCtx.rDev.SetFillColor(rCtx.rPalette.aMenuSurface);
+    rCtx.rDev.DrawRect(rCtx.aRect);
+}
+
+/** The highlight of an item in rItem (the item's row between the menu's side borders). */
+tools::Rectangle highlightRect(const PaintContext& rCtx, const tools::Rectangle& rItem)
+{
+    tools::Rectangle aRect(rItem);
+    const tools::Long nInsetX = std::lround(rCtx.Px(hst::design::space::XXS));
+    if (aRect.GetWidth() > 4 * nInsetX)
+    {
+        aRect.AdjustLeft(nInsetX);
+        aRect.AdjustRight(-nInsetX);
+    }
+    // a pixel of the surface above and below, so neighbouring rows never merge
+    if (aRect.GetHeight() >= std::lround(rCtx.Px(16)))
+    {
+        aRect.AdjustTop(1);
+        aRect.AdjustBottom(-1);
+    }
+    return aRect;
+}
+
+double highlightRadius(const PaintContext& rCtx, const tools::Rectangle& rRect)
+{
+    return std::min(rCtx.Px(hst::design::radius::MenuItem), rRect.GetHeight() / 4.0);
+}
+
+/** The highlight's fill: the menu hover, or where the theme's highlighted text would not read on it
+    (4.5:1), the other palette's hover, the accent, or the theme's own highlight colour. */
+Color highlightFill(const PaintContext& rCtx)
+{
+    const Color aText = rCtx.rStyle.GetMenuHighlightTextColor();
+    const hst::design::Palette& rOther = hst::design::GetPalette(!rCtx.rPalette.bDark);
+    for (const Color& rCandidate : { rCtx.rPalette.aMenuHover, rOther.aMenuHover, rCtx.rPalette.aAccent })
+        if (ContrastRatio(rCandidate, aText) >= 4.5)
+            return rCandidate;
+    return rCtx.rStyle.GetMenuHighlightColor();
+}
+
+Color markColour(const PaintContext& rCtx)
+{
+    return rCtx.IsEnabled() ? rCtx.rPalette.aText : rCtx.rPalette.aDisabledText;
+}
+}
+
+bool PaintMenu(const PaintContext& rCtx, ControlPart ePart, const ImplControlValue& /*rValue*/)
+{
+    const auto& p = rCtx.rPalette;
+    switch (ePart)
+    {
+        case ControlPart::Entire:
+            paintSurface(rCtx);
+            return true;
+        case ControlPart::MenuItem:
+        {
+            // the highlight of the item under the mouse or the keyboard; a disabled item shows it
+            // too, so the keyboard's position stays visible
+            const tools::Rectangle aRect = highlightRect(rCtx, rCtx.aRect);
+            FillAndStroke(rCtx, aRect, highlightRadius(rCtx, aRect), highlightFill(rCtx),
+                          COL_TRANSPARENT, 0);
+            return true;
+        }
+        case ControlPart::Separator:
+        {
+            // a thin line across the menu, inset from its sides, centred in the separator's row
+            const tools::Long nThick
+                = std::max<tools::Long>(1, std::lround(rCtx.Px(hst::design::size::FrameDivider)));
+            const tools::Long nInset = std::lround(rCtx.Px(hst::design::space::S));
+            const tools::Rectangle& rRow = rCtx.aRect;
+            const tools::Long nTop = rRow.Top() + (rRow.GetHeight() - nThick) / 2;
+            const tools::Rectangle aLine(rRow.Left() + nInset, nTop, rRow.Right() - nInset,
+                                         nTop + nThick - 1);
+            if (!aLine.IsEmpty())
+            {
+                rCtx.rDev.SetLineColor();
+                rCtx.rDev.SetFillColor(p.aCardBorder);
+                rCtx.rDev.DrawRect(aLine);
+            }
+            return true;
+        }
+        case ControlPart::MenuItemCheckMark:
+        case ControlPart::MenuItemRadioMark:
+        {
+            // VCL passes a checked item as PRESSED; an unchecked one shows no mark
+            if (!rCtx.IsPressed())
+                return true;
+            const tools::Rectangle aBox = MarkBox(rCtx.aRect);
+            if (ePart == ControlPart::MenuItemCheckMark)
+                DrawCheckGlyph(rCtx, aBox, markColour(rCtx), false);
+            else
+            {
+                const double fSide = aBox.GetWidth();
+                const basegfx::B2DPoint aCentre(aBox.Left() + fSide / 2, aBox.Top() + fSide / 2);
+                FillShape(rCtx,
+                          basegfx::B2DPolyPolygon(
+                              basegfx::utils::createPolygonFromCircle(aCentre, fSide * 0.18)),
+                          markColour(rCtx));
+            }
+            return true;
+        }
+        case ControlPart::SubmenuArrow:
+            // right-mirrored with the menu in a right-to-left layout, like all of its drawing
+            DrawChevron(rCtx, rCtx.aRect, Chevron::Right, markColour(rCtx));
+            return true;
+        default:
+            return false;
+    }
+}
+}
