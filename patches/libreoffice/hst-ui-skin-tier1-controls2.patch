+/* The GTK 3 CSS of the coat for lists and trees, sliders, progress bars, group frames and
+   separators, the items of popup menus and tooltips: the same tokens as the VCL painters. Like the
+   rest of the dialogs' CSS it sets colours, corner radii and focus marks only, never widths,
+   paddings, margins, minimum sizes or fonts. A menu's own surface and outline belong to the frame's
+   menus fragment (css/menus.cxx), which follows and may override these. */
+
+#include "coat-paint.hxx"
+
+#include <rtl/ustrbuf.hxx>
+#include <vcl/hst/designtokens.hxx>
+
+#include <cmath>
+
+namespace hst::coat
+{
+namespace
+{
+OUString hex(const Color& rColor) { return u"#" + rColor.AsRGBHexString(); }
+
+OUString px(double fLength) { return OUString::number(std::lround(fLength)) + u"px"; }
+}
+
+OUString ListsRangesMenusCss(const hst::design::Palette& p)
+{
+    namespace d = hst::design;
+    const RowSelection aSelection = RowSelectionColours(p);
+    OUStringBuffer aCss(2048);
+    // lists and trees: a tint under the mouse (rounded where GTK can: list rows), the selected row
+    // in the HST selection colours (after the hover, which it outranks), the expander muted
+    aCss.append(u"treeview.view:hover { background-color: " + hex(p.aHover)
+                + u"; }\n"
+                  u"list row:hover { background-color: "
+                + hex(p.aHover) + u"; border-radius: " + px(d::radius::Row) + u"; }\n");
+    aCss.append(u"treeview.view:selected, treeview.view:selected:focus, list row:selected { "
+                u"background-color: "
+                + hex(aSelection.aFill) + u"; color: " + hex(aSelection.aText)
+                + u"; }\n"
+                  u"treeview.view.expander { color: "
+                + hex(p.aMuted) + u"; }\n"
+                  u"treeview.view.expander:hover { color: "
+                + hex(p.aText) + u"; }\n"
+                  u"treeview.view.expander:selected { color: "
+                + hex(aSelection.aText) + u"; }\n");
+    // sliders: the groove in the control border, the accent up to the thumb, a round thumb
+    aCss.append(u"scale trough { background-image: none; background-color: " + hex(p.aControlBorder)
+                + u"; border-color: " + hex(p.aControlBorder)
+                + u"; border-radius: 999px; box-shadow: none; }\n"
+                  u"scale highlight { background-image: none; background-color: "
+                + hex(p.aAccent) + u"; border-color: " + hex(p.aAccent)
+                + u"; border-radius: 999px; }\n"
+                  u"scale slider { background-image: none; background-color: "
+                + hex(p.aCard) + u"; border-color: " + hex(p.aControlBorder)
+                + u"; border-radius: 999px; box-shadow: none; }\n"
+                  u"scale slider:hover, scale:focus slider { border-color: "
+                + hex(p.aAccent) + u"; }\n"
+                  u"scale:disabled trough { background-color: "
+                + hex(p.aDisabledBorder) + u"; border-color: " + hex(p.aDisabledBorder)
+                + u"; }\n"
+                  u"scale:disabled highlight { background-color: "
+                + hex(p.aDisabledText) + u"; border-color: " + hex(p.aDisabledText)
+                + u"; }\n"
+                  u"scale:disabled slider { border-color: "
+                + hex(p.aDisabledBorder) + u"; }\n");
+    // progress bars: a rounded track in the control border, the accent up to the value
+    const OUString aBarRadius = px(d::radius::MenuItem);
+    aCss.append(u"progressbar trough { background-image: none; background-color: "
+                + hex(p.aScrollTrack) + u"; border-color: " + hex(p.aControlBorder)
+                + u"; border-radius: " + aBarRadius
+                + u"; box-shadow: none; }\n"
+                  u"progressbar progress { background-image: none; background-color: "
+                + hex(p.aAccent) + u"; border-color: " + hex(p.aAccent)
+                + u"; border-radius: " + aBarRadius + u"; box-shadow: none; }\n");
+    // group frames and the frames of scrolled lists: one control-border line, a field's corners;
+    // separators: one thin line of the card border (not a paned window's handle)
+    aCss.append(u"frame > border, scrolledwindow.frame { border-color: " + hex(p.aControlBorder)
+                + u"; border-radius: " + px(INNER_WINDOW_RADIUS)
+                + u"; }\n"
+                  u":not(paned) > separator { background-color: "
+                + hex(p.aCardBorder) + u"; }\n");
+    // popup menus' items: the highlight, the marks, the submenu arrow and the shortcut
+    aCss.append(u"menu menuitem:hover, .menu menuitem:hover { background-color: "
+                + hex(p.aMenuHover) + u"; color: " + hex(p.aText)
+                + u"; border-radius: " + px(d::radius::MenuItem)
+                + u"; }\n"
+                  u"menu menuitem check, menu menuitem radio, .menu menuitem check, "
+                  u".menu menuitem radio { background-image: none; background-color: transparent; "
+                  u"border-color: transparent; box-shadow: none; color: "
+                + hex(p.aText)
+                + u"; }\n"
+                  u"menu menuitem arrow, .menu menuitem arrow { color: "
+                + hex(p.aText)
+                + u"; }\n"
+                  u"menu menuitem accelerator, .menu menuitem accelerator { color: "
+                + hex(p.aMenuShortcut)
+                + u"; }\n"
+                  u"menu menuitem:disabled, menu menuitem:disabled check, menu menuitem:disabled "
+                  u"radio, menu menuitem:disabled arrow, menu menuitem:disabled accelerator, "
+                  u".menu menuitem:disabled, .menu menuitem:disabled check, .menu menuitem:disabled "
+                  u"radio, .menu menuitem:disabled arrow, .menu menuitem:disabled accelerator { color: "
+                + hex(p.aDisabledText)
+                + u"; }\n"
+                  u"menu separator, .menu separator { background-color: "
+                + hex(p.aCardBorder) + u"; }\n");
+    // tooltips: the menu surface and outline, the text colour
+    aCss.append(u"tooltip, tooltip.background { background-image: none; background-color: "
+                + hex(p.aMenuSurface) + u"; border-color: " + hex(p.aMenuBorder)
+                + u"; border-radius: " + px(d::radius::MenuItem)
+                + u"; box-shadow: none; }\n"
+                  u"tooltip label, tooltip * { color: "
+                + hex(p.aText) + u"; text-shadow: none; }\n");
+    return aCss.makeStringAndClear();
+}
+}
