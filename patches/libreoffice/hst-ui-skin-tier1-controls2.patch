+/* A popup menu drawn by VCL: the menu surface, the highlighted item inset and rounded, a thin
+   separator, vector check and radio marks for checked items only, a chevron for a submenu; the
+   palette is the one of the menu's text. */
+CPPUNIT_TEST_FIXTURE(CoatControlsTest, testMenuItemsInTheHstLook)
+{
+    const tools::Rectangle aItem(Point(), Size(200, 24));
+    auto menu = [&](VirtualDevice& rDev, ControlPart ePart, ControlState eState) {
+        return hst::coat::DrawMenuPartForTesting(rDev, ePart, eState, aItem);
+    };
+    {
+        ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(200, 24));
+        CPPUNIT_ASSERT(draw(*pDev, ControlType::MenuPopup, ControlPart::Entire, ENABLED));
+        assertPixel("menu surface", *pDev, 100, 12, light().aMenuSurface);
+    }
+    {
+        ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(200, 24), true);
+        draw(*pDev, ControlType::MenuPopup, ControlPart::Entire, ENABLED);
+        assertPixel("dark menu surface", *pDev, 100, 12, dark().aMenuSurface);
+    }
+    {
+        ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(200, 24));
+        CPPUNIT_ASSERT(menu(*pDev, ControlPart::MenuItem, ENABLED | ControlState::SELECTED));
+        assertPixel("highlight", *pDev, 100, 12, light().aMenuHover);
+        assertPixel("highlight's top row", *pDev, 100, 1, light().aMenuHover);
+        assertPixel("inset from the side", *pDev, 1, 12, MARKER);
+        assertPixel("a pixel of surface above", *pDev, 100, 0, MARKER);
+    }
+    {
+        // a theme whose highlighted menu text is white on a light menu: the highlight darkens so that
+        // text stays readable
+        ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(200, 24));
+        AllSettings aSettings = pDev->GetSettings();
+        StyleSettings aStyle = aSettings.GetStyleSettings();
+        aStyle.SetMenuHighlightTextColor(COL_WHITE);
+        aSettings.SetStyleSettings(aStyle);
+        pDev->SetSettings(aSettings);
+        menu(*pDev, ControlPart::MenuItem, ENABLED | ControlState::SELECTED);
+        assertPixel("readable highlight", *pDev, 100, 12, dark().aMenuHover);
+    }
+    {
+        ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(200, 9));
+        CPPUNIT_ASSERT(menu(*pDev, ControlPart::Separator, ENABLED));
+        assertPixel("separator", *pDev, 100, 4, light().aCardBorder);
+        assertPixel("one pixel thin", *pDev, 100, 3, MARKER);
+        assertPixel("inset from the side", *pDev, 4, 4, MARKER);
+    }
+    {
+        ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(16, 16));
+        CPPUNIT_ASSERT(
+            menu(*pDev, ControlPart::MenuItemCheckMark, ENABLED));
+        CPPUNIT_ASSERT(inkBounds(*pDev, light().aText).IsEmpty());
+        menu(*pDev, ControlPart::MenuItemCheckMark, ENABLED | ControlState::PRESSED);
+        CPPUNIT_ASSERT(!inkBounds(*pDev, light().aText).IsEmpty());
+        assertPixel("no box around the mark", *pDev, 0, 0, MARKER);
+    }
+    {
+        ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(16, 16));
+        menu(*pDev, ControlPart::MenuItemRadioMark, ENABLED | ControlState::PRESSED);
+        assertPixel("radio dot", *pDev, 8, 8, light().aText);
+    }
+    {
+        ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(16, 16));
+        CPPUNIT_ASSERT(
+            menu(*pDev, ControlPart::SubmenuArrow, ENABLED));
+        const tools::Rectangle aInk = inkBounds(*pDev, light().aText);
+        CPPUNIT_ASSERT(!aInk.IsEmpty());
+        CPPUNIT_ASSERT_GREATER(aInk.GetWidth(), aInk.GetHeight());
+    }
+}
