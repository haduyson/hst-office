+    switch (eType)
+    {
+        case ControlType::Tooltip:
+            bClaimed = ePart == ControlPart::Entire;
+            break;
+        case ControlType::MenuPopup:
+            bClaimed = ePart == ControlPart::SubmenuArrow;
+            break;
+        default:
+            break;
+    }
