+    CPPUNIT_ASSERT_EQUAL(CELLTYPE_VALUE, pDoc->GetCellType(ScAddress(1, 1, 0)));
+    CPPUNIT_ASSERT_EQUAL(202.0, pDoc->GetValue(ScAddress(1, 1, 0)));
+}
