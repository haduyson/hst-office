+using flashfill::Row;
+
+struct Region
+{
+    SCTAB nTab = 0;
+    SCCOL nCol = 0; ///< the column to fill
+    SCCOL nStartCol = 0;
+    SCCOL nEndCol = 0;
+    SCROW nStartRow = 0;
+    SCROW nEndRow = 0;
+};
+
+std::vector<Row> readRows(const ScDocument& rDoc, const Region& r, bool& rbNumeric)
+{
+    std::vector<Row> aRows;
+    aRows.reserve(r.nEndRow - r.nStartRow + 1);
+    rbNumeric = true;
+    bool bAnyExample = false;
+    for (SCROW nRow = r.nStartRow; nRow <= r.nEndRow; ++nRow)
+    {
+        Row aRow;
+        for (SCCOL nCol = r.nStartCol; nCol <= r.nEndCol; ++nCol)
+        {
+            if (nCol != r.nCol)
+                aRow.maSources.push_back(rDoc.GetString(nCol, nRow, r.nTab));
+        }
+        const ScAddress aPos(r.nCol, nRow, r.nTab);
+        const CellType eType = rDoc.GetCellType(aPos);
+        if (eType != CELLTYPE_NONE)
+        {
+            aRow.moExample = rDoc.GetString(aPos);
+            bAnyExample = true;
+            rbNumeric = rbNumeric && eType == CELLTYPE_VALUE;
+        }
+        aRows.push_back(std::move(aRow));
+    }
+    rbNumeric = rbNumeric && bAnyExample;
+    return aRows;
+}
+}
+
+size_t FlashFill(ScTabViewShell& rViewShell)
+{
+    ScViewData& rViewData = rViewShell.GetViewData();
+    ScDocument& rDoc = rViewData.GetDocument();
+    Region r;
+    r.nTab = rViewData.CurrentTabForData();
+    r.nCol = rViewData.GetCurX();
+    r.nStartCol = r.nEndCol = r.nCol;
+    r.nStartRow = r.nEndRow = rViewData.GetCurY();
+    rDoc.GetDataArea(r.nTab, r.nStartCol, r.nStartRow, r.nEndCol, r.nEndRow, true, false);
+    if (r.nStartCol == r.nEndCol)
+    {
+        rViewShell.ErrorMessage(STR_HST_FLASH_FILL_NO_DATA);
+        return 0;
+    }
+
+    bool bNumeric = false;
+    std::vector<Row> aRows = readRows(rDoc, r, bNumeric);
+    const CharClass& rCharClass = ScGlobal::getCharClass();
+    auto oValues = flashfill::Infer(aRows, rCharClass);
+    if (!oValues && aRows.front().moExample)
+    {
+        // The first row may be the header row ("Họ" above "Họ và tên"): try without it.
+        aRows.front() = Row();
+        oValues = flashfill::Infer(aRows, rCharClass);
+    }
+    if (!oValues)
+    {
+        rViewShell.ErrorMessage(STR_HST_FLASH_FILL_NO_PATTERN);
+        return 0;
+    }
+
+    std::vector<std::pair<SCROW, OUString>> aFills;
+    for (size_t i = 0; i < oValues->size(); ++i)
+    {
+        const SCROW nRow = r.nStartRow + static_cast<SCROW>(i);
+        if ((*oValues)[i] && !(*oValues)[i]->isEmpty()
+            && rDoc.GetCellType(ScAddress(r.nCol, nRow, r.nTab)) == CELLTYPE_NONE)
+            aFills.emplace_back(nRow, *(*oValues)[i]);
+    }
+    if (aFills.empty())
+    {
+        rViewShell.ErrorMessage(STR_HST_FLASH_FILL_NO_PATTERN);
+        return 0;
+    }
+    const ScEditableTester aTester = ScEditableTester::CreateAndTestBlock(
+        rDoc, r.nTab, r.nCol, aFills.front().first, r.nCol, aFills.back().first);
+    if (!aTester.IsEditable())
+    {
+        rViewShell.ErrorMessage(aTester.GetMessageId());
+        return 0;
+    }
+
+    // Numbers stay numbers when the examples are numbers, text otherwise (keeps 0905...).
+    ScDocFunc& rFunc = rViewData.GetDocFunc();
+    SvNumberFormatter* pFormatter = rDoc.GetFormatTable();
+    const bool bUndo = rDoc.IsUndoEnabled();
+    if (bUndo)
+        rFunc.EnterListAction(STR_HST_UNDO_FLASH_FILL);
+    for (const auto& [nRow, rText] : aFills)
+    {
+        const ScAddress aPos(r.nCol, nRow, r.nTab);
+        sal_uInt32 nFormat = rDoc.GetNumberFormat(r.nCol, nRow, r.nTab);
+        double fValue = 0.0;
+        if (bNumeric && pFormatter->IsNumberFormat(rText, nFormat, fValue))
+            rFunc.SetValueCell(aPos, fValue, true);
+        else
+            rFunc.SetStringCell(aPos, rText, true);
+    }
+    if (bUndo)
+        rFunc.EndListAction();
+    return aFills.size();
+}
+}
