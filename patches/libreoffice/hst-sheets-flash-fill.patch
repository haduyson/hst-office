+#pragma once
+
+#include "scdllapi.h"
+
+#include <rtl/ustring.hxx>
+
+#include <optional>
+#include <vector>
+
+class CharClass;
+
+/** Flash Fill (Ctrl+E) of HST Sheets: the pattern inference, independent of documents.
+
+    A program is a sequence of segments: constant text, or a part of a source column (the
+    whole text, the n-th word, run of letters or run of digits, the n-th field between
+    delimiters, the text before or after a delimiter, a word's first letter), each in its own
+    case (as is, UPPER, lower, Proper). The programs that produce the first example are
+    searched cheapest first; the first one that produces every other example too wins, a
+    program filling more rows winning among equally cheap ones.
+ */
+namespace sc::hst::flashfill
+{
+struct Row
+{
+    /// The display text of the source columns, left to right.
+    std::vector<OUString> maSources;
+    /// The text the user typed in the filled column, if any.
+    std::optional<OUString> moExample;
+};
+
+/** The values for the rows without an example (nullopt where the pattern does not apply or
+    every source is empty, and for the example rows); nullopt when no pattern explains all
+    examples, or there is no example. */
+SC_DLLPUBLIC std::optional<std::vector<std::optional<OUString>>>
+Infer(const std::vector<Row>& rRows, const CharClass& rCharClass);
+}
