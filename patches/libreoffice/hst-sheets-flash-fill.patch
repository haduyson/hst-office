@@ -0,0 +1,531 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ * Copyright (c) HASON TECH. HST Office.
+ */
+
+#include <hstflashfill.hxx>
+
+#include <rtl/character.hxx>
+#include <rtl/ustrbuf.hxx>
+#include <unotools/charclass.hxx>
+
+#include <algorithm>
+#include <map>
+#include <tuple>
+#include <utility>
+
+namespace sc::hst::flashfill
+{
+namespace
+{
+enum class Kind : sal_uInt8
+{
+    Whole, ///< the whole text without leading and trailing spaces
+    Field, ///< the n-th field between delimiters
+    Word, ///< the n-th run of letters and digits
+    Alpha, ///< the n-th run of letters
+    Number, ///< the n-th run of digits
+    BeforeFirst, ///< the text before the first delimiter
+    AfterFirst,
+    BeforeLast,
+    AfterLast, ///< the text after the last delimiter
+    Initial ///< the first letter of the n-th run of letters
+};
+
+enum class Case : sal_uInt8
+{
+    AsIs,
+    Upper,
+    Lower,
+    Proper
+};
+
+struct Spec
+{
+    sal_uInt16 nCol = 0;
+    Kind eKind = Kind::Whole;
+    sal_Unicode cDelim = 0;
+    sal_Int32 nIndex = 0;
+    bool bFromEnd = false;
+
+    auto key() const { return std::tie(nCol, eKind, cDelim, nIndex, bFromEnd); }
+    bool operator<(const Spec& r) const { return key() < r.key(); }
+};
+
+struct Segment
+{
+    bool bConst = false;
+    OUString aText; ///< the constant
+    Spec aSpec;
+    Case eCase = Case::AsIs;
+};
+
+using Program = std::vector<Segment>;
+
+constexpr std::u16string_view DELIMITERS = u" ,;-/._@|:\t";
+constexpr size_t BEAM = 120; ///< partial programs kept per output position
+constexpr size_t SAMPLE_ROWS = 1000; ///< rows that tell programs apart and count coverage
+constexpr sal_Int32 MAX_CONST = 30;
+
+class Inference
+{
+public:
+    Inference(const std::vector<Row>& rRows, const CharClass& rCharClass)
+        : mrRows(rRows)
+        , mrCharClass(rCharClass)
+    {
+    }
+
+    std::optional<std::vector<std::optional<OUString>>> run();
+
+private:
+    bool isLetter(const OUString& s, sal_Int32 i) const
+    {
+        const sal_Unicode c = s[i];
+        if (rtl::isAsciiAlpha(c) || (c >= 0x0300 && c <= 0x036F)) // combining diacritics too
+            return true;
+        if (c < 128)
+            return false;
+        return mrCharClass.isLetter(s, i);
+    }
+    static bool isDigit(sal_Unicode c) { return rtl::isAsciiDigit(c); }
+
+    std::vector<std::pair<sal_Int32, sal_Int32>> runs(const OUString& s, Kind eKind) const;
+    static std::vector<OUString> fields(const OUString& s, sal_Unicode cDelim);
+    std::optional<OUString> evalSpec(const Spec& rSpec, const Row& rRow) const;
+    OUString applyCase(const OUString& s, Case eCase) const;
+    std::optional<OUString> evalProgram(const Program& rProgram, const Row& rRow) const;
+    std::vector<std::pair<Spec, OUString>> atomsOf(const Row& rRow) const;
+    void addIndexed(std::vector<std::pair<Spec, OUString>>& rOut, Spec aSpec,
+                    const std::vector<OUString>& rValues) const;
+    std::vector<std::pair<Spec, OUString>> distinctAtoms(const Row& rRow) const;
+    std::vector<std::pair<Program, sal_Int32>> search(const Row& rRow) const;
+
+    const std::vector<Row>& mrRows;
+    const CharClass& mrCharClass;
+    std::vector<size_t> maSample; ///< rows that tell programs apart
+};
+
+std::vector<std::pair<sal_Int32, sal_Int32>> Inference::runs(const OUString& s, Kind eKind) const
+{
+    std::vector<std::pair<sal_Int32, sal_Int32>> aRuns;
+    sal_Int32 nStart = -1;
+    for (sal_Int32 i = 0; i <= s.getLength(); ++i)
+    {
+        bool bIn = false;
+        if (i < s.getLength())
+        {
+            switch (eKind)
+            {
+                case Kind::Number:
+                    bIn = isDigit(s[i]);
+                    break;
+                case Kind::Word:
+                    bIn = isDigit(s[i]) || isLetter(s, i);
+                    break;
+                default:
+                    bIn = isLetter(s, i);
+            }
+        }
+        if (bIn && nStart < 0)
+            nStart = i;
+        else if (!bIn && nStart >= 0)
+        {
+            aRuns.emplace_back(nStart, i);
+            nStart = -1;
+        }
+    }
+    return aRuns;
+}
+
+std::vector<OUString> Inference::fields(const OUString& s, sal_Unicode cDelim)
+{
+    std::vector<OUString> aFields;
+    sal_Int32 nStart = 0;
+    for (;;)
+    {
+        const sal_Int32 nPos = s.indexOf(cDelim, nStart);
+        if (nPos < 0)
+        {
+            aFields.push_back(s.copy(nStart).trim());
+            return aFields;
+        }
+        aFields.push_back(s.copy(nStart, nPos - nStart).trim());
+        nStart = nPos + 1;
+    }
+}
+
+std::optional<OUString> Inference::evalSpec(const Spec& rSpec, const Row& rRow) const
+{
+    if (rSpec.nCol >= rRow.maSources.size())
+        return std::nullopt;
+    const OUString s = rRow.maSources[rSpec.nCol].trim();
+    auto pick = [&rSpec](sal_Int32 nCount) -> sal_Int32 {
+        const sal_Int32 n = rSpec.bFromEnd ? nCount - 1 - rSpec.nIndex : rSpec.nIndex;
+        return (n >= 0 && n < nCount) ? n : -1;
+    };
+    switch (rSpec.eKind)
+    {
+        case Kind::Whole:
+            return s;
+        case Kind::Field:
+        {
+            if (s.indexOf(rSpec.cDelim) < 0)
+                return std::nullopt;
+            const std::vector<OUString> aFields = fields(s, rSpec.cDelim);
+            const sal_Int32 n = pick(aFields.size());
+            if (n < 0)
+                return std::nullopt;
+            return aFields[n];
+        }
+        case Kind::Word:
+        case Kind::Alpha:
+        case Kind::Number:
+        case Kind::Initial:
+        {
+            const auto aRuns = runs(s, rSpec.eKind == Kind::Initial ? Kind::Alpha : rSpec.eKind);
+            const sal_Int32 n = pick(aRuns.size());
+            if (n < 0)
+                return std::nullopt;
+            const auto& [nStart, nEnd] = aRuns[n];
+            if (rSpec.eKind == Kind::Initial)
+            {
+                // The base letter with the combining marks that follow it.
+                sal_Int32 nLen = 1;
+                while (nStart + nLen < nEnd && s[nStart + nLen] >= 0x0300 && s[nStart + nLen] <= 0x036F)
+                    ++nLen;
+                return s.copy(nStart, nLen);
+            }
+            return s.copy(nStart, nEnd - nStart);
+        }
+        case Kind::BeforeFirst:
+        case Kind::AfterFirst:
+        case Kind::BeforeLast:
+        case Kind::AfterLast:
+        {
+            const bool bFirst = rSpec.eKind == Kind::BeforeFirst || rSpec.eKind == Kind::AfterFirst;
+            const sal_Int32 nPos = bFirst ? s.indexOf(rSpec.cDelim) : s.lastIndexOf(rSpec.cDelim);
+            if (nPos < 0)
+                return std::nullopt;
+            if (rSpec.eKind == Kind::BeforeFirst || rSpec.eKind == Kind::BeforeLast)
+                return s.copy(0, nPos).trim();
+            return s.copy(nPos + 1).trim();
+        }
+    }
+    return std::nullopt;
+}
+
+OUString Inference::applyCase(const OUString& s, Case eCase) const
+{
+    switch (eCase)
+    {
+        case Case::Upper:
+            return mrCharClass.uppercase(s);
+        case Case::Lower:
+            return mrCharClass.lowercase(s);
+        case Case::Proper:
+        {
+            const OUString aLower = mrCharClass.lowercase(s);
+            OUStringBuffer aBuf(aLower.getLength());
+            bool bWordStart = true;
+            for (sal_Int32 i = 0; i < aLower.getLength(); ++i)
+            {
+                const bool bLetter = isLetter(aLower, i);
+                if (bLetter && bWordStart)
+                    aBuf.append(mrCharClass.uppercase(aLower, i, 1));
+                else
+                    aBuf.append(aLower[i]);
+                bWordStart = !bLetter && !isDigit(aLower[i]);
+            }
+            return aBuf.makeStringAndClear();
+        }
+        case Case::AsIs:
+            break;
+    }
+    return s;
+}
+
+std::optional<OUString> Inference::evalProgram(const Program& rProgram, const Row& rRow) const
+{
+    OUStringBuffer aBuf;
+    for (const Segment& rSeg : rProgram)
+    {
+        if (rSeg.bConst)
+        {
+            aBuf.append(rSeg.aText);
+            continue;
+        }
+        const std::optional<OUString> oValue = evalSpec(rSeg.aSpec, rRow);
+        if (!oValue || oValue->isEmpty())
+            return std::nullopt;
+        aBuf.append(applyCase(*oValue, rSeg.eCase));
+    }
+    return aBuf.makeStringAndClear();
+}
+
+void Inference::addIndexed(std::vector<std::pair<Spec, OUString>>& rOut, Spec aSpec,
+                           const std::vector<OUString>& rValues) const
+{
+    const sal_Int32 nCount = rValues.size();
+    for (sal_Int32 i = 0; i < nCount; ++i)
+    {
+        if (rValues[i].isEmpty())
+            continue;
+        aSpec.nIndex = i;
+        aSpec.bFromEnd = false;
+        rOut.emplace_back(aSpec, rValues[i]);
+        aSpec.nIndex = nCount - 1 - i;
+        aSpec.bFromEnd = true;
+        rOut.emplace_back(aSpec, rValues[i]);
+    }
+}
+
+std::vector<std::pair<Spec, OUString>> Inference::atomsOf(const Row& rRow) const
+{
+    std::vector<std::pair<Spec, OUString>> aAtoms;
+    for (size_t nCol = 0; nCol < rRow.maSources.size(); ++nCol)
+    {
+        const OUString s = rRow.maSources[nCol].trim();
+        if (s.isEmpty())
+            continue;
+        Spec aSpec;
+        aSpec.nCol = static_cast<sal_uInt16>(nCol);
+        aSpec.eKind = Kind::Whole;
+        aAtoms.emplace_back(aSpec, s);
+        for (const sal_Unicode cDelim : DELIMITERS)
+        {
+            if (s.indexOf(cDelim) < 0)
+                continue;
+            aSpec.cDelim = cDelim;
+            aSpec.eKind = Kind::Field;
+            addIndexed(aAtoms, aSpec, fields(s, cDelim));
+            aSpec.nIndex = 0;
+            aSpec.bFromEnd = false;
+            for (Kind eKind : { Kind::BeforeFirst, Kind::AfterFirst, Kind::BeforeLast, Kind::AfterLast })
+            {
+                aSpec.eKind = eKind;
+                if (std::optional<OUString> oValue = evalSpec(aSpec, rRow); oValue && !oValue->isEmpty())
+                    aAtoms.emplace_back(aSpec, *oValue);
+            }
+        }
+        aSpec.cDelim = 0;
+        for (Kind eKind : { Kind::Word, Kind::Alpha, Kind::Number, Kind::Initial })
+        {
+            aSpec.eKind = eKind;
+            std::vector<OUString> aValues;
+            for (const auto& [nStart, nEnd] : runs(s, eKind == Kind::Initial ? Kind::Alpha : eKind))
+            {
+                (void)nEnd;
+                Spec aOne = aSpec;
+                aOne.nIndex = aValues.size();
+                aValues.push_back(eKind == Kind::Initial ? *evalSpec(aOne, rRow) : s.copy(nStart, nEnd - nStart));
+            }
+            addIndexed(aAtoms, aSpec, aValues);
+        }
+    }
+    return aAtoms;
+}
+
+std::vector<std::pair<Spec, OUString>> Inference::distinctAtoms(const Row& rRow) const
+{
+    // Two parts that give the same text on every sampled row are one choice: keep the first,
+    // in the order atomsOf() lists them (the whole text, fields, words...).
+    std::vector<std::pair<Spec, OUString>> aDistinct;
+    std::map<std::vector<std::optional<OUString>>, bool> aSeen;
+    for (auto& rAtom : atomsOf(rRow))
+    {
+        std::vector<std::optional<OUString>> aValues;
+        aValues.reserve(maSample.size());
+        for (size_t nRow : maSample)
+            aValues.push_back(evalSpec(rAtom.first, mrRows[nRow]));
+        if (aSeen.emplace(std::move(aValues), true).second)
+            aDistinct.push_back(std::move(rAtom));
+    }
+    return aDistinct;
+}
+
+/// Lowest cost first. A part of a source costs 100, a case change 5; constant text costs 100
+/// when it holds no letters or digits, more and more with each letter or digit otherwise.
+std::vector<std::pair<Program, sal_Int32>> Inference::search(const Row& rRow) const
+{
+    const OUString& rOut = *rRow.moExample;
+    const sal_Int32 n = rOut.getLength();
+    struct Edge
+    {
+        sal_Int32 nLen;
+        Segment aSeg;
+        sal_Int32 nCost;
+    };
+    std::vector<std::vector<Edge>> aEdges(n);
+    for (const auto& [rSpec, rValue] : distinctAtoms(rRow))
+    {
+        // Counting from the nearer end of the list wins a tie, the start when in the middle.
+        sal_Int32 nFar = 0;
+        const bool bIndexed = rSpec.eKind == Kind::Field
+                              || (rSpec.cDelim == 0 && rSpec.eKind != Kind::Whole);
+        if (bIndexed)
+        {
+            Spec aOther = rSpec;
+            aOther.bFromEnd = !rSpec.bFromEnd;
+            // Index from the other end, counted by finding the same item from there.
+            for (sal_Int32 k = 0; k < 1000; ++k)
+            {
+                aOther.nIndex = k;
+                std::optional<OUString> oOther = evalSpec(aOther, rRow);
+                if (!oOther)
+                    break;
+                if (*oOther == rValue)
+                {
+                    if (rSpec.bFromEnd ? k <= rSpec.nIndex : k < rSpec.nIndex)
+                        nFar = 1;
+                    break;
+                }
+            }
+        }
+        for (Case eCase : { Case::AsIs, Case::Upper, Case::Lower, Case::Proper })
+        {
+            const OUString aValue = applyCase(rValue, eCase);
+            if (aValue.isEmpty() || (eCase != Case::AsIs && aValue == rValue))
+                continue;
+            for (sal_Int32 i = rOut.indexOf(aValue); i >= 0; i = rOut.indexOf(aValue, i + 1))
+            {
+                Segment aSeg;
+                aSeg.aSpec = rSpec;
+                aSeg.eCase = eCase;
+                aEdges[i].push_back({ aValue.getLength(), aSeg,
+                                      100 + (eCase == Case::AsIs ? 0 : 5) + nFar });
+            }
+        }
+    }
+    for (sal_Int32 i = 0; i < n; ++i)
+    {
+        sal_Int32 nAlnum = 0;
+        for (sal_Int32 nLen = 1; nLen <= MAX_CONST && i + nLen <= n; ++nLen)
+        {
+            if (isDigit(rOut[i + nLen - 1]) || isLetter(rOut, i + nLen - 1))
+                ++nAlnum;
+            Segment aSeg;
+            aSeg.bConst = true;
+            aSeg.aText = rOut.copy(i, nLen);
+            aEdges[i].push_back({ nLen, aSeg, nAlnum ? 200 + 50 * nAlnum : 100 });
+        }
+    }
+
+    struct Partial
+    {
+        Program aProgram;
+        sal_Int32 nCost = 0;
+    };
+    std::vector<std::vector<Partial>> aBeam(n + 1);
+    aBeam[0].emplace_back();
+    for (sal_Int32 i = 0; i < n; ++i)
+    {
+        auto& rHere = aBeam[i];
+        std::stable_sort(rHere.begin(), rHere.end(),
+                         [](const Partial& a, const Partial& b) { return a.nCost < b.nCost; });
+        if (rHere.size() > BEAM)
+            rHere.resize(BEAM);
+        for (const Partial& rPartial : rHere)
+        {
+            const bool bAfterConst = !rPartial.aProgram.empty() && rPartial.aProgram.back().bConst;
+            for (const Edge& rEdge : aEdges[i])
+            {
+                if (rEdge.aSeg.bConst && bAfterConst)
+                    continue; // one longer constant covers both
+                Partial aNext{ rPartial.aProgram, rPartial.nCost + rEdge.nCost };
+                aNext.aProgram.push_back(rEdge.aSeg);
+                aBeam[i + rEdge.nLen].push_back(std::move(aNext));
+            }
+        }
+        rHere.clear();
+        rHere.shrink_to_fit();
+    }
+    std::vector<std::pair<Program, sal_Int32>> aResult;
+    for (Partial& rPartial : aBeam[n])
+    {
+        const bool bUsesSource = std::any_of(rPartial.aProgram.begin(), rPartial.aProgram.end(),
+                                             [](const Segment& r) { return !r.bConst; });
+        if (bUsesSource)
+            aResult.emplace_back(std::move(rPartial.aProgram), rPartial.nCost);
+    }
+    std::stable_sort(aResult.begin(), aResult.end(),
+                     [](const auto& a, const auto& b) { return a.second < b.second; });
+    return aResult;
+}
+
+std::optional<std::vector<std::optional<OUString>>> Inference::run()
+{
+    std::vector<size_t> aExamples;
+    for (size_t i = 0; i < mrRows.size(); ++i)
+    {
+        if (mrRows[i].moExample && !mrRows[i].moExample->isEmpty())
+            aExamples.push_back(i);
+    }
+    if (aExamples.empty())
+        return std::nullopt;
+    for (size_t i = 0; i < mrRows.size() && maSample.size() < SAMPLE_ROWS; ++i)
+        maSample.push_back(i);
+    for (size_t nRow : aExamples)
+    {
+        if (nRow >= SAMPLE_ROWS)
+            maSample.push_back(nRow);
+    }
+
+    auto hasSource = [](const Row& rRow) {
+        return std::any_of(rRow.maSources.begin(), rRow.maSources.end(),
+                           [](const OUString& s) { return !s.trim().isEmpty(); });
+    };
+
+    const Program* pBest = nullptr;
+    std::tuple<sal_Int32, sal_Int32> aBestKey;
+    const auto aCandidates = search(mrRows[aExamples.front()]);
+    for (const auto& [rProgram, nCost] : aCandidates)
+    {
+        if (pBest && nCost / 10 > std::get<0>(aBestKey))
+            break; // the rest costs more
+        bool bConsistent = true;
+        for (size_t k = 1; k < aExamples.size() && bConsistent; ++k)
+        {
+            const std::optional<OUString> oValue = evalProgram(rProgram, mrRows[aExamples[k]]);
+            bConsistent = oValue && *oValue == *mrRows[aExamples[k]].moExample;
+        }
+        if (!bConsistent)
+            continue;
+        sal_Int32 nCovered = 0;
+        for (size_t nRow : maSample)
+        {
+            const Row& rRow = mrRows[nRow];
+            if (!rRow.moExample && hasSource(rRow) && evalProgram(rProgram, rRow))
+                ++nCovered;
+        }
+        // Programs whose costs differ only in the tie-breaks compare by the rows they fill.
+        const std::tuple<sal_Int32, sal_Int32> aKey(nCost / 10, -nCovered);
+        if (!pBest || aKey < aBestKey)
+        {
+            pBest = &rProgram;
+            aBestKey = aKey;
+        }
+    }
+    if (!pBest)
+        return std::nullopt;
+
+    std::vector<std::optional<OUString>> aValues(mrRows.size());
+    for (size_t i = 0; i < mrRows.size(); ++i)
+    {
+        const Row& rRow = mrRows[i];
+        if (!rRow.moExample && hasSource(rRow))
+            aValues[i] = evalProgram(*pBest, rRow);
+    }
+    return aValues;
+}
+}
+
+std::optional<std::vector<std::optional<OUString>>> Infer(const std::vector<Row>& rRows,
+                                                          const CharClass& rCharClass)
+{
+    return Inference(rRows, rCharClass).run();
+}
+}
