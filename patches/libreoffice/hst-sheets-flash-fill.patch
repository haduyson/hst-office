+// HST Office: Flash Fill of Sheets: the inference (sc/source/core/hst/hstflashfill.cxx) and the
+// .uno:FlashFill command (sc/source/ui/hst/hstflashfillcommand.cxx).
+
+#include "../helper/qahelper.hxx"
+
+#include <comphelper/processfactory.hxx>
+#include <i18nlangtag/languagetag.hxx>
+#include <unotools/charclass.hxx>
+#include <docsh.hxx>
