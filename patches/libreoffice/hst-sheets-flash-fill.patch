+namespace
+{
+class ScHstFlashFillTest : public ScModelTestBase
+{
+public:
+    ScHstFlashFillTest()
+        : ScModelTestBase(u"sc/qa/unit/uicalc/data"_ustr)
+    {
+    }
+
+protected:
+    /// Rows of one source column; the first nExamples rows carry the examples.
+    static std::vector<Row> rows(const std::vector<OUString>& rSources,
+                                 const std::vector<OUString>& rExamples)
+    {
+        std::vector<Row> aRows;
+        for (size_t i = 0; i < rSources.size(); ++i)
+        {
+            Row aRow;
+            aRow.maSources.push_back(rSources[i]);
+            if (i < rExamples.size())
+                aRow.moExample = rExamples[i];
+            aRows.push_back(std::move(aRow));
+        }
+        return aRows;
+    }
+
+    static CharClass charClass()
+    {
+        return CharClass(comphelper::getProcessComponentContext(), LanguageTag(u"vi-VN"_ustr));
+    }
+
+    /// The filled values of the rows without an example, joined by '|' ("" for a row left empty).
+    static OUString fill(const std::vector<Row>& rRows)
+    {
+        const auto oValues = Infer(rRows, charClass());
+        CPPUNIT_ASSERT_MESSAGE("no pattern found", oValues.has_value());
+        std::vector<OUString> aResult;
+        for (size_t i = 0; i < rRows.size(); ++i)
+        {
+            if (!rRows[i].moExample)
+                aResult.push_back((*oValues)[i].value_or(OUString()));
+        }
+        return join(aResult);
+    }
+
+    static OUString join(const std::vector<OUString>& rValues)
+    {
+        OUString aJoined;
+        for (size_t i = 0; i < rValues.size(); ++i)
+            aJoined += (i ? u"|" : u"") + rValues[i];
+        return aJoined;
+    }
+};
+
+using Strings = std::vector<OUString>;
+}
+
+CPPUNIT_TEST_FIXTURE(ScHstFlashFillTest, testSplitVietnameseNames)
+{
+    const Strings aNames{ u"Nguyễn Văn An"_ustr, u"Trần Thị Bình"_ustr, u"Lê Hoàng"_ustr,
+                          u"Phạm Thị Thu Hằng"_ustr };
+    // Family name: the first word.
+    CPPUNIT_ASSERT_EQUAL(join(Strings{ u"Trần"_ustr, u"Lê"_ustr, u"Phạm"_ustr }),
+                         fill(rows(aNames, { u"Nguyễn"_ustr })));
+    // Given name: the last word, also for names of two or four words.
+    CPPUNIT_ASSERT_EQUAL(join(Strings{ u"Bình"_ustr, u"Hoàng"_ustr, u"Hằng"_ustr }),
+                         fill(rows(aNames, { u"An"_ustr })));
+    // Everything after the family name.
+    CPPUNIT_ASSERT_EQUAL(join(Strings{ u"Thị Bình"_ustr, u"Hoàng"_ustr, u"Thị Thu Hằng"_ustr }),
+                         fill(rows(aNames, { u"Văn An"_ustr })));
+}
+
+CPPUNIT_TEST_FIXTURE(ScHstFlashFillTest, testJoinColumns)
+{
+    std::vector<Row> aRows(3);
+    aRows[0].maSources = { u"Nguyễn"_ustr, u"An"_ustr };
+    aRows[0].moExample = u"An Nguyễn"_ustr;
+    aRows[1].maSources = { u"Trần"_ustr, u"Bình"_ustr };
+    aRows[2].maSources = { u"Lê"_ustr, u"Cường"_ustr };
+    CPPUNIT_ASSERT_EQUAL(join(Strings{ u"Bình Trần"_ustr, u"Cường Lê"_ustr }), fill(aRows));
+}
+
+CPPUNIT_TEST_FIXTURE(ScHstFlashFillTest, testNumbersAndDates)
+{
+    CPPUNIT_ASSERT_EQUAL(join(Strings{ u"678"_ustr, u"90"_ustr }),
+                         fill(rows({ u"Mã SV: 12345"_ustr, u"Mã SV: 678"_ustr, u"Mã SV: 90"_ustr },
+                                   { u"12345"_ustr })));
+    CPPUNIT_ASSERT_EQUAL(join(Strings{ u"2025"_ustr }),
+                         fill(rows({ u"13/11/2026"_ustr, u"01/02/2025"_ustr }, { u"2026"_ustr })));
+    // Digits joined, the leading zero kept.
+    CPPUNIT_ASSERT_EQUAL(join(Strings{ u"0912345678"_ustr }),
+                         fill(rows({ u"0905-123-456"_ustr, u"0912-345-678"_ustr },
+                                   { u"0905123456"_ustr })));
+}
+
+CPPUNIT_TEST_FIXTURE(ScHstFlashFillTest, testCaseChanges)
+{
+    CPPUNIT_ASSERT_EQUAL(join(Strings{ u"TRẦN THỊ BÌNH"_ustr }),
+                         fill(rows({ u"nguyễn văn an"_ustr, u"trần thị bình"_ustr },
+                                   { u"NGUYỄN VĂN AN"_ustr })));
+    CPPUNIT_ASSERT_EQUAL(join(Strings{ u"Trần Thị Bình"_ustr }),
+                         fill(rows({ u"NGUYỄN VĂN AN"_ustr, u"TRẦN THỊ BÌNH"_ustr },
+                                   { u"Nguyễn Văn An"_ustr })));
+    CPPUNIT_ASSERT_EQUAL(join(Strings{ u"TTB"_ustr }),
+                         fill(rows({ u"Nguyễn Văn An"_ustr, u"Trần Thị Bình"_ustr },
+                                   { u"NVA"_ustr })));
+}
+
+CPPUNIT_TEST_FIXTURE(ScHstFlashFillTest, testTwoExamplesDisambiguate)
+{
+    // The first example fits several programs (fields, words, the text before '@'); the
+    // second one leaves only "the text before '@'".
+    CPPUNIT_ASSERT_EQUAL(
+        join(Strings{ u"le.van"_ustr }),
+        fill(rows({ u"an.nguyen@gmail.com"_ustr, u"binh-tran.hst@hst.vn"_ustr, u"le.van@x.com"_ustr },
+                  { u"an.nguyen"_ustr, u"binh-tran.hst"_ustr })));
+}
+
+CPPUNIT_TEST_FIXTURE(ScHstFlashFillTest, testNoPattern)
+{
+    // No example.
+    CPPUNIT_ASSERT(!Infer(rows({ u"a b"_ustr, u"c d"_ustr }, {}), charClass()));
+    // An example that no part of the sources explains.
+    CPPUNIT_ASSERT(!Infer(rows({ u"abc"_ustr, u"def"_ustr }, { u"xyz"_ustr }), charClass()));
+    // Examples that contradict each other.
+    CPPUNIT_ASSERT(!Infer(rows({ u"a b"_ustr, u"c d"_ustr, u"e f"_ustr }, { u"a"_ustr, u"d"_ustr }),
+                          charClass()));
+}
+
+CPPUNIT_TEST_FIXTURE(ScHstFlashFillTest, testCommandFillsAndUndoes)
+{
+    createScDoc();
+    ScDocument* pDoc = getScDoc();
+    pDoc->SetString(ScAddress(0, 0, 0), u"Họ và tên"_ustr);
+    pDoc->SetString(ScAddress(1, 0, 0), u"Tên"_ustr);
+    pDoc->SetString(ScAddress(0, 1, 0), u"Nguyễn Văn An"_ustr);
+    pDoc->SetString(ScAddress(0, 2, 0), u"Trần Thị Bình"_ustr);
+    pDoc->SetString(ScAddress(0, 3, 0), u"Lê Hoàng"_ustr);
+    pDoc->SetString(ScAddress(1, 1, 0), u"An"_ustr);
+
+    goToCell(u"B3"_ustr);
+    dispatchCommand(mxComponent, u".uno:FlashFill"_ustr, {});
+
+    // The header row does not stop the pattern and stays as it is.
+    CPPUNIT_ASSERT_EQUAL(u"Tên"_ustr, pDoc->GetString(ScAddress(1, 0, 0)));
+    CPPUNIT_ASSERT_EQUAL(u"Bình"_ustr, pDoc->GetString(ScAddress(1, 2, 0)));
+    CPPUNIT_ASSERT_EQUAL(u"Hoàng"_ustr, pDoc->GetString(ScAddress(1, 3, 0)));
+    CPPUNIT_ASSERT_EQUAL(CELLTYPE_NONE, pDoc->GetCellType(ScAddress(1, 4, 0)));
+
+    // One undo step removes the filled cells and keeps the example.
+    getScDocShell()->GetUndoManager()->Undo();
+    CPPUNIT_ASSERT_EQUAL(CELLTYPE_NONE, pDoc->GetCellType(ScAddress(1, 2, 0)));
+    CPPUNIT_ASSERT_EQUAL(CELLTYPE_NONE, pDoc->GetCellType(ScAddress(1, 3, 0)));
+    CPPUNIT_ASSERT_EQUAL(u"An"_ustr, pDoc->GetString(ScAddress(1, 1, 0)));
+}
+
+CPPUNIT_TEST_FIXTURE(ScHstFlashFillTest, testCommandKeepsNumbers)
+{
+    createScDoc();
+    ScDocument* pDoc = getScDoc();
+    pDoc->SetString(ScAddress(0, 0, 0), u"Mã 101"_ustr);
+    pDoc->SetString(ScAddress(0, 1, 0), u"Mã 202"_ustr);
+    pDoc->SetValue(ScAddress(1, 0, 0), 101.0);
+
+    goToCell(u"B1"_ustr);
+    dispatchCommand(mxComponent, u".uno:FlashFill"_ustr, {});
