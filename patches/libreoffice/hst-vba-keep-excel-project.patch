+bool XclExpKeepsOriginalVba( SfxObjectShell& rShell )
+{
+    try
+    {
+        css::uno::Reference<css::embed::XStorage> xDocStorage(rShell.GetStorage());
+        if (!xDocStorage.is() || !xDocStorage->hasByName(u"_MS_VBA_Macros"_ustr))
+            return false;
+        BasicManager* pBasicManager = rShell.GetBasicManager();
+        if (!pBasicManager || !pBasicManager->IsBasicModified())
+            return true;
+        return VbaExport(rShell.GetModel()).hasForms();
+    }
+    catch (const css::uno::Exception&)
+    {
+        return false;
+    }
+}
