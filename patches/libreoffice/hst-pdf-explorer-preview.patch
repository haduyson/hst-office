@@ -0,0 +1,77 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This file is part of the LibreOffice project.
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+#pragma once
+
+#include <fpdfview.h>
+
+#include <cstdint>
+#include <memory>
+#include <vector>
+
+// PDF rendering for the Explorer preview handler and thumbnail provider. PDFium is the
+// pdfiumlo library the office already installs; it is loaded at run time from the office's
+// program directory, so a missing or broken PDFium only disables the preview instead of
+// failing the COM class load. Every PDFium call is serialised: PDFium is not thread-safe.
+namespace hstpdf
+{
+/// Random-access bytes of the PDF file (an IStream from the shell).
+class ByteSource
+{
+public:
+    virtual ~ByteSource() = default;
+    virtual std::uint64_t size() const = 0;
+    /// Reads exactly len bytes at pos; false on any error or short read.
+    virtual bool read(std::uint64_t pos, unsigned char* buffer, unsigned long len) = 0;
+};
+
+enum class OpenResult
+{
+    Ok,
+    NoRenderer, ///< pdfiumlo could not be loaded
+    PasswordProtected,
+    Invalid ///< not a PDF, damaged, empty, or too large for PDFium's 32-bit file access
+};
+
+struct PageSize
+{
+    double width; ///< in points, rotation applied
+    double height;
+};
+
+class Document
+{
+public:
+    static OpenResult open(std::unique_ptr<ByteSource> source, std::unique_ptr<Document>& result);
+    ~Document();
+    Document(const Document&) = delete;
+    Document& operator=(const Document&) = delete;
+
+    int pageCount() const { return static_cast<int>(m_aPageSizes.size()); }
+    const PageSize& pageSize(int index) const { return m_aPageSizes[index]; }
+
+    /// Renders page `index` scaled to width x height into a top-down 32-bit BGRx buffer
+    /// (stride bytes per row, at least 4 * width), on a white background, with annotations.
+    bool renderPage(int index, int width, int height, unsigned char* pixels, int stride) const;
+
+private:
+    Document() = default;
+
+    std::unique_ptr<ByteSource> m_pSource;
+    FPDF_FILEACCESS m_aFileAccess{}; // PDFium reads through it until the document is closed
+    FPDF_DOCUMENT m_pDocument = nullptr;
+    std::vector<PageSize> m_aPageSizes;
+};
+
+/// Scales (width, height) in points to fit inside maxWidth x maxHeight pixels, keeping the
+/// aspect ratio; each side is at least 1 pixel.
+void fitInto(const PageSize& page, int maxWidth, int maxHeight, int& width, int& height);
+}
+
+/* vim:set shiftwidth=4 softtabstop=4 expandtab: */
