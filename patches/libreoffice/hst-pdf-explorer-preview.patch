+    decltype(&FPDFBitmap_FillRect) BitmapFillRect = nullptr;
+    decltype(&FPDFBitmap_Destroy) BitmapDestroy = nullptr;
+};
+
+// Guards every PDFium call and the one-time load. Recursive: a Document may be destroyed
+// (closing its FPDF_DOCUMENT) while Document::open still holds the lock.
+std::recursive_mutex g_aPdfiumMutex;
+
+#ifdef _WIN32
+void* loadLibrary()
+{
+    // pdfiumlo.dll is in the program directory, the parent of this DLL's shlxthdl directory.
+    // LOAD_WITH_ALTERED_SEARCH_PATH resolves its own dependencies (ICU, lcms2) from there too.
+    HMODULE hSelf = nullptr;
+    if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS
+                                | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                            reinterpret_cast<LPCWSTR>(&loadLibrary), &hSelf))
+        return nullptr;
+    std::wstring aPath(MAX_PATH, L'\0');
+    for (;;)
+    {
+        DWORD n = GetModuleFileNameW(hSelf, aPath.data(), static_cast<DWORD>(aPath.size()));
+        if (n == 0)
+            return nullptr;
+        if (n < aPath.size())
+        {
+            aPath.resize(n);
+            break;
+        }
+        if (aPath.size() >= 32768)
+            return nullptr;
+        aPath.resize(aPath.size() * 2);
+    }
+    for (int i = 0; i < 2; ++i) // strip "hstpdfpreview.dll", then "shlxthdl"
+    {
+        std::wstring::size_type nSep = aPath.find_last_of(L'\\');
+        if (nSep == std::wstring::npos)
+            return nullptr;
+        aPath.resize(nSep);
+    }
+    aPath += L"\\pdfiumlo.dll";
+    return LoadLibraryExW(aPath.c_str(), nullptr, LOAD_WITH_ALTERED_SEARCH_PATH);
+}
+
+void* symbol(void* pLibrary, const char* pName)
+{
+    return reinterpret_cast<void*>(GetProcAddress(static_cast<HMODULE>(pLibrary), pName));
+}
+#else
+// Not shipped outside Windows; this branch lets the rendering core be exercised against
+// libpdfiumlo.so (directory in HST_PDFIUM_DIR).
+void* loadLibrary()
+{
+    const char* pDir = getenv("HST_PDFIUM_DIR");
+    std::string aPath = std::string(pDir ? pDir : ".") + "/libpdfiumlo.so";
+    return dlopen(aPath.c_str(), RTLD_NOW | RTLD_LOCAL);
+}
+
+void* symbol(void* pLibrary, const char* pName) { return dlsym(pLibrary, pName); }
+#endif
+
+template <typename T> bool resolve(void* pLibrary, const char* pName, T& rFunction)
+{
+    rFunction = reinterpret_cast<T>(symbol(pLibrary, pName));
+    return rFunction != nullptr;
+}
+
+// Loads and initialises PDFium once per process; the library stays loaded for the process
+// lifetime (PDFium has no safe re-initialisation after FPDF_DestroyLibrary). Caller holds the mutex.
+const Pdfium* pdfium()
+{
+    static bool bTried = false;
+    static Pdfium aPdfium;
+    static bool bOk = false;
+    if (bTried)
+        return bOk ? &aPdfium : nullptr;
+    bTried = true;
+    void* pLibrary = loadLibrary();
+    if (!pLibrary)
+        return nullptr;
+    Pdfium a;
+    bOk = resolve(pLibrary, "FPDF_InitLibrary", a.InitLibrary)
+          && resolve(pLibrary, "FPDF_LoadCustomDocument", a.LoadCustomDocument)
+          && resolve(pLibrary, "FPDF_GetLastError", a.GetLastError)
+          && resolve(pLibrary, "FPDF_GetPageCount", a.GetPageCount)
+          && resolve(pLibrary, "FPDF_GetPageSizeByIndexF", a.GetPageSizeByIndexF)
+          && resolve(pLibrary, "FPDF_CloseDocument", a.CloseDocument)
+          && resolve(pLibrary, "FPDF_LoadPage", a.LoadPage)
+          && resolve(pLibrary, "FPDF_ClosePage", a.ClosePage)
+          && resolve(pLibrary, "FPDF_RenderPageBitmap", a.RenderPageBitmap)
+          && resolve(pLibrary, "FPDFBitmap_CreateEx", a.BitmapCreateEx)
+          && resolve(pLibrary, "FPDFBitmap_FillRect", a.BitmapFillRect)
+          && resolve(pLibrary, "FPDFBitmap_Destroy", a.BitmapDestroy);
+    if (!bOk)
+        return nullptr;
+    a.InitLibrary();
+    aPdfium = a;
+    return &aPdfium;
+}
+
+// FPDF_FILEACCESS callback: pParam is the ByteSource.
+int getBlock(void* pParam, unsigned long nPosition, unsigned char* pBuffer, unsigned long nSize)
+{
+    return static_cast<ByteSource*>(pParam)->read(nPosition, pBuffer, nSize) ? 1 : 0;
+}
+}
+
+OpenResult Document::open(std::unique_ptr<ByteSource> source, std::unique_ptr<Document>& result)
+{
+    result.reset();
+    if (!source)
+        return OpenResult::Invalid;
+    std::uint64_t nSize = source->size();
+    // FPDF_FILEACCESS::m_FileLen is an unsigned long: 32 bits on Windows.
+    if (nSize == 0 || nSize > ULONG_MAX)
+        return OpenResult::Invalid;
+
+    std::lock_guard aGuard(g_aPdfiumMutex);
+    const Pdfium* p = pdfium();
+    if (!p)
+        return OpenResult::NoRenderer;
+
+    std::unique_ptr<Document> pDoc(new Document);
+    pDoc->m_pSource = std::move(source);
+    // PDFium keeps the FPDF_FILEACCESS pointer until FPDF_CloseDocument; it must outlive the
+    // document, so it is stored with it.
+    pDoc->m_aFileAccess.m_FileLen = static_cast<unsigned long>(nSize);
+    pDoc->m_aFileAccess.m_GetBlock = &getBlock;
+    pDoc->m_aFileAccess.m_Param = pDoc->m_pSource.get();
+    FPDF_DOCUMENT pDocument = p->LoadCustomDocument(&pDoc->m_aFileAccess, nullptr);
+    if (!pDocument)
+        return p->GetLastError() == FPDF_ERR_PASSWORD ? OpenResult::PasswordProtected
+                                                       : OpenResult::Invalid;
+    pDoc->m_pDocument = pDocument;
+
+    int nPages = p->GetPageCount(pDocument);
+    if (nPages <= 0)
+        return OpenResult::Invalid; // pDoc's destructor closes the document
+    pDoc->m_aPageSizes.reserve(nPages);
+    for (int i = 0; i < nPages; ++i)
+    {
+        FS_SIZEF aSize{ 0, 0 };
+        if (!p->GetPageSizeByIndexF(pDocument, i, &aSize) || !(aSize.width > 0)
+            || !(aSize.height > 0))
+            aSize = FS_SIZEF{ 595, 842 }; // unreadable page box: lay it out as A4
+        pDoc->m_aPageSizes.push_back(PageSize{ aSize.width, aSize.height });
+    }
+    result = std::move(pDoc);
+    return OpenResult::Ok;
+}
+
+Document::~Document()
+{
+    if (!m_pDocument)
+        return;
+    std::lock_guard aGuard(g_aPdfiumMutex);
+    if (const Pdfium* p = pdfium())
+        p->CloseDocument(m_pDocument);
+}
+
+bool Document::renderPage(int index, int width, int height, unsigned char* pixels,
+                          int stride) const
+{
+    if (index < 0 || index >= pageCount() || width <= 0 || height <= 0 || !pixels
+        || stride < 4 * width)
+        return false;
+    std::lock_guard aGuard(g_aPdfiumMutex);
+    const Pdfium* p = pdfium();
+    if (!p)
+        return false;
+    FPDF_PAGE pPage = p->LoadPage(m_pDocument, index);
+    if (!pPage)
+        return false;
+    bool bOk = false;
+    if (FPDF_BITMAP pBitmap = p->BitmapCreateEx(width, height, FPDFBitmap_BGRx, pixels, stride))
+    {
+        p->BitmapFillRect(pBitmap, 0, 0, width, height, 0xFFFFFFFF);
+        p->RenderPageBitmap(pBitmap, pPage, 0, 0, width, height, 0, FPDF_ANNOT);
+        p->BitmapDestroy(pBitmap); // the pixels are the caller's and stay valid
+        bOk = true;
+    }
+    p->ClosePage(pPage);
+    return bOk;
+}
+
+void fitInto(const PageSize& page, int maxWidth, int maxHeight, int& width, int& height)
+{
+    double fScale = std::min(maxWidth / page.width, maxHeight / page.height);
+    width = std::max(1, static_cast<int>(std::lround(page.width * fScale)));
+    height = std::max(1, static_cast<int>(std::lround(page.height * fScale)));
+}
+}
+
