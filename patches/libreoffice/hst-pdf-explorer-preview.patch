+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This file is part of the LibreOffice project.
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+// Explorer preview pane for PDF files: every page, fitted to the pane width and stacked
+// vertically, scrolled with the scroll bar, the mouse wheel and the keyboard. Runs in the
+// shell's preview host process (prevhost.exe), not in Explorer and not in the office.
+
+#include "shellcommon.hxx"
+
+#include <ocidl.h>
+#include <propsys.h>
+#include <shobjidl.h>
+
+#include <algorithm>
+#include <climits>
+#include <cmath>
+#include <list>
+#include <new>
+#include <vector>
+
+namespace hstpdf
+{
+namespace
+{
+constexpr wchar_t WINDOW_CLASS[] = L"HSTOfficePdfPreview";
+constexpr int MARGIN = 12; // around and between pages, at 96 DPI
+constexpr int LINE_STEP = 40; // one scroll line, at 96 DPI
+constexpr int MAX_PAGE_WIDTH = 2400; // keeps one cached page under ~40 MB on very wide panes
+constexpr std::size_t PAGE_CACHE_SIZE = 6;
+
+bool g_bClassRegistered = false;
+
+bool isVietnameseUi() { return PRIMARYLANGID(GetUserDefaultUILanguage()) == LANG_VIETNAMESE; }
+
+const wchar_t* messageFor(OpenResult eResult)
+{
+    if (eResult == OpenResult::PasswordProtected)
+        return isVietnameseUi() ? L"Tệp PDF này có mật khẩu. Hãy "
+                                  L"mở bằng HST PDF để xem."
+                                : L"This PDF file is password protected. Open it in HST PDF.";
+    return isVietnameseUi() ? L"Không xem trước được tệp "
+                              L"PDF này."
+                            : L"This PDF file cannot be previewed.";
+}
+
+class PreviewHandler final : public IPreviewHandler,
+                             public IInitializeWithStream,
+                             public IObjectWithSite,
+                             public IOleWindow,
+                             public IPreviewHandlerVisuals
+{
+public:
+    PreviewHandler() = default;
+    PreviewHandler(const PreviewHandler&) = delete;
+    PreviewHandler& operator=(const PreviewHandler&) = delete;
+
+    IFACEMETHODIMP QueryInterface(REFIID riid, void** ppv) override
+    {
+        if (!ppv)
+            return E_POINTER;
+        if (riid == __uuidof(IUnknown) || riid == __uuidof(IPreviewHandler))
+            *ppv = static_cast<IPreviewHandler*>(this);
+        else if (riid == __uuidof(IInitializeWithStream))
+            *ppv = static_cast<IInitializeWithStream*>(this);
+        else if (riid == __uuidof(IObjectWithSite))
+            *ppv = static_cast<IObjectWithSite*>(this);
+        else if (riid == __uuidof(IOleWindow))
+            *ppv = static_cast<IOleWindow*>(this);
+        else if (riid == __uuidof(IPreviewHandlerVisuals))
+            *ppv = static_cast<IPreviewHandlerVisuals*>(this);
+        else
+        {
+            *ppv = nullptr;
+            return E_NOINTERFACE;
+        }
+        AddRef();
+        return S_OK;
+    }
+    IFACEMETHODIMP_(ULONG) AddRef() override { return ++m_nRefs; }
+    IFACEMETHODIMP_(ULONG) Release() override
+    {
+        long n = --m_nRefs;
+        if (n == 0)
+            delete this;
+        return n;
+    }
+
+    // IInitializeWithStream
+    IFACEMETHODIMP Initialize(IStream* pStream, DWORD) override
+    {
+        if (!pStream)
+            return E_INVALIDARG;
+        if (m_pStream)
+            return HRESULT_FROM_WIN32(ERROR_ALREADY_INITIALIZED);
+        m_pStream = pStream;
+        m_pStream->AddRef();
+        return S_OK;
+    }
+
+    // IPreviewHandler
+    IFACEMETHODIMP SetWindow(HWND hParent, const RECT* pRect) override
+    {
+        if (!hParent || !pRect)
+            return E_INVALIDARG;
+        m_hParent = hParent;
+        m_aRect = *pRect;
+        if (m_hWnd)
+        {
+            ::SetParent(m_hWnd, m_hParent);
+            placeWindow();
+        }
+        return S_OK;
+    }
+    IFACEMETHODIMP SetRect(const RECT* pRect) override
+    {
+        if (!pRect)
+            return E_INVALIDARG;
+        m_aRect = *pRect;
+        if (m_hWnd)
+            placeWindow();
+        return S_OK;
+    }
+    IFACEMETHODIMP DoPreview() override
+    {
+        if (m_hWnd)
+            return S_OK;
+        if (!m_hParent || !m_pStream)
+            return E_UNEXPECTED;
+        m_eOpenResult = openFromStream(m_pStream, m_pDocument);
+        if (!registerWindowClass())
+            return HRESULT_FROM_WIN32(GetLastError());
+        m_hWnd = CreateWindowExW(0, WINDOW_CLASS, nullptr,
+                                 WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_CLIPSIBLINGS,
+                                 m_aRect.left, m_aRect.top, m_aRect.right - m_aRect.left,
+                                 m_aRect.bottom - m_aRect.top, m_hParent, nullptr, g_hModule,
+                                 this);
+        if (!m_hWnd)
+            return HRESULT_FROM_WIN32(GetLastError());
+        return S_OK;
+    }
+    IFACEMETHODIMP Unload() override
+    {
+        if (m_hWnd)
+        {
+            DestroyWindow(m_hWnd); // WM_DESTROY detaches the window from this object
+            m_hWnd = nullptr;
+        }
+        clearCache();
+        m_pDocument.reset(); // before the stream it reads from
+        if (m_pStream)
+        {
+            m_pStream->Release();
+            m_pStream = nullptr;
+        }
+        return S_OK;
+    }
+    IFACEMETHODIMP SetFocus() override
+    {
+        if (m_hWnd)
+            ::SetFocus(m_hWnd);
+        return S_OK;
+    }
+    IFACEMETHODIMP QueryFocus(HWND* phWnd) override
+    {
+        if (!phWnd)
+            return E_POINTER;
+        *phWnd = ::GetFocus();
+        return *phWnd ? S_OK : HRESULT_FROM_WIN32(GetLastError());
+    }
+    IFACEMETHODIMP TranslateAccelerator(MSG* pMsg) override
+    {
+        // The host's accelerators (e.g. F5, Tab back to the file list) keep working.
+        return m_pFrame ? m_pFrame->TranslateAccelerator(pMsg) : S_FALSE;
+    }
+
+    // IObjectWithSite
+    IFACEMETHODIMP SetSite(IUnknown* pSite) override
+    {
+        if (m_pFrame)
+        {
+            m_pFrame->Release();
+            m_pFrame = nullptr;
+        }
+        if (m_pSite)
+        {
+            m_pSite->Release();
+            m_pSite = nullptr;
+        }
+        if (pSite)
+        {
+            m_pSite = pSite;
+            m_pSite->AddRef();
+            if (FAILED(pSite->QueryInterface(__uuidof(IPreviewHandlerFrame),
+                                             reinterpret_cast<void**>(&m_pFrame))))
+                m_pFrame = nullptr;
+        }
+        return S_OK;
+    }
+    IFACEMETHODIMP GetSite(REFIID riid, void** ppv) override
+    {
+        if (!ppv)
+            return E_POINTER;
+        *ppv = nullptr;
+        return m_pSite ? m_pSite->QueryInterface(riid, ppv) : E_FAIL;
+    }
+
+    // IOleWindow
+    IFACEMETHODIMP GetWindow(HWND* phWnd) override
+    {
+        if (!phWnd)
+            return E_POINTER;
+        *phWnd = m_hParent;
+        return m_hParent ? S_OK : E_FAIL;
+    }
+    IFACEMETHODIMP ContextSensitiveHelp(BOOL) override { return E_NOTIMPL; }
+
+    // IPreviewHandlerVisuals: follow the pane's colours and font (light and dark mode).
+    IFACEMETHODIMP SetBackgroundColor(COLORREF aColor) override
+    {
+        m_aBackground = aColor;
+        repaint();
+        return S_OK;
+    }
+    IFACEMETHODIMP SetFont(const LOGFONTW* pFont) override
+    {
+        if (!pFont)
+            return E_INVALIDARG;
+        HFONT hFont = CreateFontIndirectW(pFont);
+        if (!hFont)
+            return E_FAIL;
+        if (m_hFont)
+            DeleteObject(m_hFont);
+        m_hFont = hFont;
+        repaint();
+        return S_OK;
+    }
+    IFACEMETHODIMP SetTextColor(COLORREF aColor) override
+    {
+        m_aText = aColor;
+        repaint();
+        return S_OK;
+    }
+
+private:
+    struct CachedPage
+    {
+        int nIndex;
+        int nWidth;
+        int nHeight;
+        HBITMAP hBitmap;
+    };
+
+    ~PreviewHandler()
+    {
+        Unload();
+        SetSite(nullptr);
+        if (m_hFont)
+            DeleteObject(m_hFont);
+    }
+
+    static bool registerWindowClass()
+    {
+        if (g_bClassRegistered)
+            return true;
+        WNDCLASSEXW aClass{};
+        aClass.cbSize = sizeof(aClass);
+        aClass.style = CS_HREDRAW | CS_VREDRAW;
+        aClass.lpfnWndProc = &PreviewHandler::windowProc;
+        aClass.hInstance = g_hModule;
+        aClass.hCursor = LoadCursorW(nullptr, MAKEINTRESOURCEW(32512)); // IDC_ARROW (ANSI-typed without UNICODE)
+        aClass.lpszClassName = WINDOW_CLASS;
+        if (!RegisterClassExW(&aClass) && GetLastError() != ERROR_CLASS_ALREADY_EXISTS)
+            return false;
+        g_bClassRegistered = true;
+        return true;
+    }
+
+    static LRESULT CALLBACK windowProc(HWND hWnd, UINT nMsg, WPARAM wParam, LPARAM lParam)
+    {
+        if (nMsg == WM_NCCREATE)
+        {
+            auto* pCreate = reinterpret_cast<CREATESTRUCTW*>(lParam);
+            SetWindowLongPtrW(hWnd, GWLP_USERDATA,
+                              reinterpret_cast<LONG_PTR>(pCreate->lpCreateParams));
+        }
+        auto* pThis = reinterpret_cast<PreviewHandler*>(GetWindowLongPtrW(hWnd, GWLP_USERDATA));
+        if (!pThis)
+            return DefWindowProcW(hWnd, nMsg, wParam, lParam);
+        switch (nMsg)
+        {
+            case WM_CREATE:
+                pThis->m_hWnd = hWnd;
+                pThis->layout();
+                return 0;
+            case WM_SIZE:
+                pThis->layout();
+                return 0;
+            case WM_ERASEBKGND:
+                return 1; // WM_PAINT covers everything
+            case WM_PAINT:
+            {
+                PAINTSTRUCT aPaint;
+                if (HDC hDC = BeginPaint(hWnd, &aPaint))
+                {
+                    pThis->paint(hDC);
+                    EndPaint(hWnd, &aPaint);
+                }
+                return 0;
+            }
+            case WM_PRINTCLIENT: // window captures (PrintWindow) and the runtime check
+                pThis->paint(reinterpret_cast<HDC>(wParam));
+                return 0;
+            case WM_VSCROLL:
+                pThis->onScrollBar(LOWORD(wParam));
+                return 0;
+            case WM_MOUSEWHEEL:
+                pThis->onWheel(GET_WHEEL_DELTA_WPARAM(wParam));
+                return 0;
+            case WM_KEYDOWN:
+                if (pThis->onKey(wParam))
+                    return 0;
+                break;
+            case WM_LBUTTONDOWN:
+                ::SetFocus(hWnd);
+                return 0;
+            case WM_DESTROY: // also when the host destroys the parent window first
+                SetWindowLongPtrW(hWnd, GWLP_USERDATA, 0);
+                pThis->m_hWnd = nullptr;
+                return 0;
+        }
+        return DefWindowProcW(hWnd, nMsg, wParam, lParam);
+    }
+
+    void placeWindow()
+    {
+        SetWindowPos(m_hWnd, nullptr, m_aRect.left, m_aRect.top, m_aRect.right - m_aRect.left,
+                     m_aRect.bottom - m_aRect.top, SWP_NOZORDER | SWP_NOACTIVATE);
+    }
+
+    void repaint()
+    {
+        if (m_hWnd)
+            InvalidateRect(m_hWnd, nullptr, FALSE);
+    }
+
+    int scaled(int nPixelsAt96) const
+    {
+        UINT nDpi = m_hWnd ? GetDpiForWindow(m_hWnd) : 96;
+        return MulDiv(nPixelsAt96, nDpi ? static_cast<int>(nDpi) : 96, 96);
+    }
+
+    int clientHeight() const
+    {
+        RECT aClient{};
+        GetClientRect(m_hWnd, &aClient);
+        return aClient.bottom;
+    }
+
+    // Page width follows the pane width; page heights follow each page's aspect ratio.
+    void layout()
+    {
+        RECT aClient{};
+        GetClientRect(m_hWnd, &aClient);
+        int nMargin = scaled(MARGIN);
+        m_nPageWidth = std::clamp(static_cast<int>(aClient.right) - 2 * nMargin, 1, MAX_PAGE_WIDTH);
+        m_aPageTops.clear();
+        m_aPageHeights.clear();
+        int nTop = nMargin;
+        int nPages = m_pDocument ? m_pDocument->pageCount() : 0;
+        for (int i = 0; i < nPages; ++i)
+        {
+            const PageSize& rSize = m_pDocument->pageSize(i);
+            double fHeight = std::clamp(m_nPageWidth * rSize.height / rSize.width, 1.0, 1048576.0);
+            int nHeight = static_cast<int>(std::lround(fHeight));
+            m_aPageTops.push_back(nTop);
+            m_aPageHeights.push_back(nHeight);
+            // Saturate: a pathological page count must not overflow the scroll range.
+            nTop = nTop > INT_MAX / 2 - nHeight ? INT_MAX / 2 : nTop + nHeight + nMargin;
+        }
+        m_nTotalHeight = nTop;
+        scrollTo(m_nScroll);
+        repaint();
+    }
+
+    void scrollTo(int nPosition)
+    {
+        int nPage = clientHeight();
+        int nMax = std::max(0, m_nTotalHeight - nPage);
+        m_nScroll = std::clamp(nPosition, 0, nMax);
+        SCROLLINFO aInfo{};
+        aInfo.cbSize = sizeof(aInfo);
+        aInfo.fMask = SIF_RANGE | SIF_PAGE | SIF_POS | SIF_DISABLENOSCROLL;
+        aInfo.nMin = 0;
+        aInfo.nMax = std::max(0, m_nTotalHeight - 1);
+        aInfo.nPage = static_cast<UINT>(std::max(0, nPage));
+        aInfo.nPos = m_nScroll;
+        SetScrollInfo(m_hWnd, SB_VERT, &aInfo, TRUE);
+        repaint();
+    }
+
+    void onScrollBar(int nCode)
+    {
+        int nPage = clientHeight();
+        int nLine = scaled(LINE_STEP);
+        switch (nCode)
+        {
+            case SB_LINEUP:
+                scrollTo(m_nScroll - nLine);
+                break;
+            case SB_LINEDOWN:
+                scrollTo(m_nScroll + nLine);
+                break;
+            case SB_PAGEUP:
+                scrollTo(m_nScroll - std::max(nLine, nPage - nLine));
+                break;
+            case SB_PAGEDOWN:
+                scrollTo(m_nScroll + std::max(nLine, nPage - nLine));
+                break;
+            case SB_TOP:
+                scrollTo(0);
+                break;
+            case SB_BOTTOM:
+                scrollTo(m_nTotalHeight);
+                break;
+            case SB_THUMBTRACK:
+            case SB_THUMBPOSITION:
+            {
+                SCROLLINFO aInfo{};
+                aInfo.cbSize = sizeof(aInfo);
+                aInfo.fMask = SIF_TRACKPOS;
+                if (GetScrollInfo(m_hWnd, SB_VERT, &aInfo))
+                    scrollTo(aInfo.nTrackPos); // 32-bit position, unlike HIWORD(wParam)
+                break;
+            }
+        }
+    }
+
+    void onWheel(int nDelta)
+    {
+        UINT nLines = 3;
+        SystemParametersInfoW(SPI_GETWHEELSCROLLLINES, 0, &nLines, 0);
+        if (nLines == WHEEL_PAGESCROLL)
+        {
+            onScrollBar(nDelta > 0 ? SB_PAGEUP : SB_PAGEDOWN);
+            return;
+        }
+        m_nWheelRemainder += nDelta;
+        int nNotches = m_nWheelRemainder / WHEEL_DELTA;
+        m_nWheelRemainder -= nNotches * WHEEL_DELTA;
+        scrollTo(m_nScroll - nNotches * static_cast<int>(nLines) * scaled(LINE_STEP));
+    }
+
+    bool onKey(WPARAM nKey)
+    {
+        switch (nKey)
+        {
+            case VK_UP:
+                onScrollBar(SB_LINEUP);
+                return true;
+            case VK_DOWN:
+                onScrollBar(SB_LINEDOWN);
+                return true;
+            case VK_PRIOR:
+                onScrollBar(SB_PAGEUP);
+                return true;
+            case VK_NEXT:
+            case VK_SPACE:
+                onScrollBar(SB_PAGEDOWN);
+                return true;
+            case VK_HOME:
+                onScrollBar(SB_TOP);
+                return true;
+            case VK_END:
+                onScrollBar(SB_BOTTOM);
+                return true;
+        }
+        return false;
+    }
+
+    // Rendered page bitmap at the current width; least recently used pages are dropped.
+    HBITMAP pageBitmap(int nIndex, int nWidth, int nHeight)
+    {
+        for (auto it = m_aCache.begin(); it != m_aCache.end(); ++it)
+        {
+            if (it->nIndex == nIndex && it->nWidth == nWidth && it->nHeight == nHeight)
+            {
+                m_aCache.splice(m_aCache.begin(), m_aCache, it);
+                return it->hBitmap;
+            }
+        }
+        HBITMAP hBitmap = renderPageBitmap(*m_pDocument, nIndex, nWidth, nHeight);
+        if (!hBitmap)
+            return nullptr;
+        m_aCache.push_front(CachedPage{ nIndex, nWidth, nHeight, hBitmap });
+        while (m_aCache.size() > PAGE_CACHE_SIZE)
+        {
+            DeleteObject(m_aCache.back().hBitmap);
+            m_aCache.pop_back();
+        }
+        return hBitmap;
+    }
+
+    void clearCache()
+    {
+        for (const CachedPage& rPage : m_aCache)
+            DeleteObject(rPage.hBitmap);
+        m_aCache.clear();
+    }
+
+    void paint(HDC hDC)
+    {
+        RECT aClient{};
+        GetClientRect(m_hWnd, &aClient);
+        // Double buffered: scrolling repaints the whole pane without flicker.
+        HDC hBuffer = CreateCompatibleDC(hDC);
+        HBITMAP hBufferBitmap = hBuffer ? CreateCompatibleBitmap(hDC, aClient.right, aClient.bottom)
+                                        : nullptr;
+        HDC hTarget = hBufferBitmap ? hBuffer : hDC;
+        HGDIOBJ hOldBufferBitmap = hBufferBitmap ? SelectObject(hBuffer, hBufferBitmap) : nullptr;
+
+        HBRUSH hBackground = CreateSolidBrush(m_aBackground);
+        FillRect(hTarget, &aClient, hBackground);
+        DeleteObject(hBackground);
+
+        if (m_pDocument)
+            paintPages(hTarget, aClient);
+        else
+            paintMessage(hTarget, aClient);
+
+        if (hBufferBitmap)
+        {
+            BitBlt(hDC, 0, 0, aClient.right, aClient.bottom, hBuffer, 0, 0, SRCCOPY);
+            SelectObject(hBuffer, hOldBufferBitmap);
+            DeleteObject(hBufferBitmap);
+        }
+        if (hBuffer)
+            DeleteDC(hBuffer);
+    }
+
+    void paintPages(HDC hTarget, const RECT& rClient)
+    {
+        HDC hPageDC = CreateCompatibleDC(hTarget);
+        if (!hPageDC)
+            return;
+        HBRUSH hBorder = CreateSolidBrush(RGB(0xA0, 0xA0, 0xA0));
+        int nLeft = std::max(0, (static_cast<int>(rClient.right) - m_nPageWidth) / 2);
+        for (std::size_t i = 0; i < m_aPageTops.size(); ++i)
+        {
+            int nTop = m_aPageTops[i] - m_nScroll;
+            int nHeight = m_aPageHeights[i];
+            if (nTop + nHeight <= 0)
+                continue;
+            if (nTop >= rClient.bottom)
+                break;
+            RECT aFrame{ nLeft - 1, nTop - 1, nLeft + m_nPageWidth + 1, nTop + nHeight + 1 };
+            if (hBorder)
+                FrameRect(hTarget, &aFrame, hBorder);
+            if (HBITMAP hPage = pageBitmap(static_cast<int>(i), m_nPageWidth, nHeight))
+            {
+                HGDIOBJ hOld = SelectObject(hPageDC, hPage);
+                BitBlt(hTarget, nLeft, nTop, m_nPageWidth, nHeight, hPageDC, 0, 0, SRCCOPY);
+                SelectObject(hPageDC, hOld);
+            }
+            else
+            {
+                RECT aPage{ nLeft, nTop, nLeft + m_nPageWidth, nTop + nHeight };
+                FillRect(hTarget, &aPage, static_cast<HBRUSH>(GetStockObject(WHITE_BRUSH)));
+            }
+        }
+        if (hBorder)
+            DeleteObject(hBorder);
+        DeleteDC(hPageDC);
+    }
+
+    void paintMessage(HDC hTarget, const RECT& rClient)
+    {
+        int nMargin = scaled(MARGIN) * 2;
+        RECT aText{ rClient.left + nMargin, rClient.top + nMargin, rClient.right - nMargin,
+                    rClient.bottom - nMargin };
+        HGDIOBJ hOldFont = m_hFont ? SelectObject(hTarget, m_hFont) : nullptr;
+        SetBkMode(hTarget, TRANSPARENT);
+        ::SetTextColor(hTarget, m_aText);
+        DrawTextW(hTarget, messageFor(m_eOpenResult), -1, &aText,
+                  DT_CENTER | DT_WORDBREAK | DT_NOPREFIX);
+        if (hOldFont)
+            SelectObject(hTarget, hOldFont);
+    }
+
+    std::atomic<long> m_nRefs{ 1 };
+    ModuleRef m_aModuleRef;
+    IStream* m_pStream = nullptr;
+    IUnknown* m_pSite = nullptr;
+    IPreviewHandlerFrame* m_pFrame = nullptr;
+    HWND m_hParent = nullptr;
+    HWND m_hWnd = nullptr;
+    RECT m_aRect{};
+    std::unique_ptr<Document> m_pDocument;
+    OpenResult m_eOpenResult = OpenResult::Invalid;
+    COLORREF m_aBackground = GetSysColor(COLOR_WINDOW);
+    COLORREF m_aText = GetSysColor(COLOR_WINDOWTEXT);
+    HFONT m_hFont = nullptr;
+    int m_nPageWidth = 1;
+    std::vector<int> m_aPageTops;
+    std::vector<int> m_aPageHeights;
+    int m_nTotalHeight = 0;
+    int m_nScroll = 0;
+    int m_nWheelRemainder = 0;
+    std::list<CachedPage> m_aCache;
+};
+}
+
+HRESULT createPreviewHandler(REFIID riid, void** ppv)
+{
+    auto* pHandler = new (std::nothrow) PreviewHandler;
+    if (!pHandler)
+        return E_OUTOFMEMORY;
+    HRESULT hr = pHandler->QueryInterface(riid, ppv);
+    pHandler->Release();
+    return hr;
+}
+
+void unregisterPreviewWindowClass()
+{
+    if (g_bClassRegistered && UnregisterClassW(WINDOW_CLASS, g_hModule))
+        g_bClassRegistered = false;
+}
+}
