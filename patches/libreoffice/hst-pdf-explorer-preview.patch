+// COM entry points of hstpdfpreview.dll and the IStream/DIB helpers shared by the PDF
+// preview handler and thumbnail provider. The DLL is registered by the installer only
+// (no DllRegisterServer): see scp2/source/winexplorerext/registryitem_winexplorerext.scp.
+
+#include "shellcommon.hxx"
+
+#include <climits>
+#include <new>
+
+namespace hstpdf
+{
+std::atomic<long> g_nModuleRefs{ 0 };
+HINSTANCE g_hModule = nullptr;
+
+namespace
+{
+// ByteSource over the shell's IStream (the preview host and the thumbnail surrogate hand the
+// file over as a stream, never as a path).
+class StreamSource final : public ByteSource
+{
+public:
+    StreamSource(IStream* pStream, std::uint64_t nSize)
+        : m_pStream(pStream)
+        , m_nSize(nSize)
+    {
+        m_pStream->AddRef();
+    }
+    ~StreamSource() override { m_pStream->Release(); }
+    StreamSource(const StreamSource&) = delete;
+    StreamSource& operator=(const StreamSource&) = delete;
+
+    std::uint64_t size() const override { return m_nSize; }
+
+    bool read(std::uint64_t pos, unsigned char* buffer, unsigned long len) override
+    {
+        if (pos > m_nSize || len > m_nSize - pos)
+            return false;
+        LARGE_INTEGER aMove;
+        aMove.QuadPart = static_cast<LONGLONG>(pos);
+        if (FAILED(m_pStream->Seek(aMove, STREAM_SEEK_SET, nullptr)))
+            return false;
+        while (len > 0)
+        {
+            ULONG nRead = 0;
+            HRESULT hr = m_pStream->Read(buffer, len, &nRead);
+            if (FAILED(hr) || nRead == 0)
+                return false;
+            buffer += nRead;
+            len -= nRead;
+        }
+        return true;
+    }
+
+private:
+    IStream* m_pStream;
+    std::uint64_t m_nSize;
+};
+
+class ClassFactory final : public IClassFactory
+{
+public:
+    explicit ClassFactory(const CLSID& rClsid)
+        : m_aClsid(rClsid)
+    {
+    }
+
+    IFACEMETHODIMP QueryInterface(REFIID riid, void** ppv) override
+    {
+        if (!ppv)
+            return E_POINTER;
+        if (riid == __uuidof(IUnknown) || riid == __uuidof(IClassFactory))
+        {
+            *ppv = static_cast<IClassFactory*>(this);
+            AddRef();
+            return S_OK;
+        }
+        *ppv = nullptr;
+        return E_NOINTERFACE;
+    }
+    IFACEMETHODIMP_(ULONG) AddRef() override { return ++m_nRefs; }
+    IFACEMETHODIMP_(ULONG) Release() override
+    {
+        long n = --m_nRefs;
+        if (n == 0)
+            delete this;
+        return n;
+    }
+
+    IFACEMETHODIMP CreateInstance(IUnknown* pOuter, REFIID riid, void** ppv) override
+    {
+        if (!ppv)
+            return E_POINTER;
+        *ppv = nullptr;
+        if (pOuter)
+            return CLASS_E_NOAGGREGATION;
+        return m_aClsid == CLSID_PdfPreviewHandler ? createPreviewHandler(riid, ppv)
+                                                   : createThumbnailProvider(riid, ppv);
+    }
+    IFACEMETHODIMP LockServer(BOOL bLock) override
+    {
+        if (bLock)
+            ++g_nModuleRefs;
+        else
+            --g_nModuleRefs;
+        return S_OK;
+    }
+
+private:
+    std::atomic<long> m_nRefs{ 1 };
+    CLSID m_aClsid;
+    ModuleRef m_aModuleRef;
+};
+}
+
+OpenResult openFromStream(IStream* pStream, std::unique_ptr<Document>& result)
+{
+    result.reset();
+    if (!pStream)
+        return OpenResult::Invalid;
+    STATSTG aStat{};
+    if (FAILED(pStream->Stat(&aStat, STATFLAG_NONAME)))
+        return OpenResult::Invalid;
+    return Document::open(std::make_unique<StreamSource>(pStream, aStat.cbSize.QuadPart), result);
+}
+
+HBITMAP renderPageBitmap(const Document& rDocument, int index, int width, int height)
+{
+    if (width <= 0 || height <= 0 || width > INT_MAX / 4)
+        return nullptr;
+    BITMAPINFO aInfo{};
+    aInfo.bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
+    aInfo.bmiHeader.biWidth = width;
+    aInfo.bmiHeader.biHeight = -height; // top-down, as PDFium writes it
+    aInfo.bmiHeader.biPlanes = 1;
+    aInfo.bmiHeader.biBitCount = 32;
+    aInfo.bmiHeader.biCompression = BI_RGB;
+    void* pBits = nullptr;
+    HBITMAP hBitmap = CreateDIBSection(nullptr, &aInfo, DIB_RGB_COLORS, &pBits, nullptr, 0);
+    if (!hBitmap)
+        return nullptr;
+    if (!rDocument.renderPage(index, width, height, static_cast<unsigned char*>(pBits), width * 4))
+    {
+        DeleteObject(hBitmap);
+        return nullptr;
+    }
+    return hBitmap;
+}
+}
+
+extern "C" BOOL WINAPI DllMain(HINSTANCE hInstance, DWORD nReason, LPVOID)
+{
+    if (nReason == DLL_PROCESS_ATTACH)
+    {
+        hstpdf::g_hModule = hInstance;
+        DisableThreadLibraryCalls(hInstance);
+    }
+    return TRUE;
+}
+
+STDAPI DllGetClassObject(REFCLSID rclsid, REFIID riid, void** ppv)
+{
+    if (!ppv)
+        return E_POINTER;
+    *ppv = nullptr;
+    if (rclsid != hstpdf::CLSID_PdfPreviewHandler && rclsid != hstpdf::CLSID_PdfThumbnailProvider)
+        return CLASS_E_CLASSNOTAVAILABLE;
+    auto* pFactory = new (std::nothrow) hstpdf::ClassFactory(rclsid);
+    if (!pFactory)
+        return E_OUTOFMEMORY;
+    HRESULT hr = pFactory->QueryInterface(riid, ppv);
+    pFactory->Release();
+    return hr;
+}
+
+STDAPI DllCanUnloadNow()
+{
+    if (hstpdf::g_nModuleRefs != 0)
+        return S_FALSE;
+    hstpdf::unregisterPreviewWindowClass();
+    return S_OK;
+}
+
