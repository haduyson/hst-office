+
+#pragma once
+
+#include <windows.h>
+#include <objidl.h>
+
+#include <atomic>
+#include <memory>
+
+#include "pdfdocument.hxx"
+
+// Shared pieces of the PDF preview handler and thumbnail provider DLL.
+namespace hstpdf
+{
+// {6058E664-567B-4207-82EE-F250B8F88276}: the preview handler (scp2 registers it).
+inline constexpr CLSID CLSID_PdfPreviewHandler
+    = { 0x6058e664, 0x567b, 0x4207, { 0x82, 0xee, 0xf2, 0x50, 0xb8, 0xf8, 0x82, 0x76 } };
+// {61440647-9253-4376-A0B3-66622FA3B055}: the thumbnail provider (scp2 registers it).
+inline constexpr CLSID CLSID_PdfThumbnailProvider
+    = { 0x61440647, 0x9253, 0x4376, { 0xa0, 0xb3, 0x66, 0x62, 0x2f, 0xa3, 0xb0, 0x55 } };
+
+/// Live COM objects and class factory locks; DllCanUnloadNow answers S_OK at zero.
+extern std::atomic<long> g_nModuleRefs;
+/// This DLL's module handle (window class registration).
+extern HINSTANCE g_hModule;
+
+/// Holds a module reference for the lifetime of a COM object.
+class ModuleRef
+{
+public:
+    ModuleRef() { ++g_nModuleRefs; }
+    ~ModuleRef() { --g_nModuleRefs; }
+    ModuleRef(const ModuleRef&) = delete;
+    ModuleRef& operator=(const ModuleRef&) = delete;
+};
+
+/// Opens the PDF behind a shell stream. The stream is AddRef'ed and read lazily by PDFium,
+/// so it must stay valid as long as the document.
+OpenResult openFromStream(IStream* pStream, std::unique_ptr<Document>& result);
+
+/// Renders a page into a new top-down 32-bit DIB section of width x height; nullptr on failure.
+HBITMAP renderPageBitmap(const Document& rDocument, int index, int width, int height);
+
+HRESULT createPreviewHandler(REFIID riid, void** ppv);
+HRESULT createThumbnailProvider(REFIID riid, void** ppv);
+/// Drops the preview window class before the DLL may be unloaded (its window procedure goes too).
+void unregisterPreviewWindowClass();
+}
