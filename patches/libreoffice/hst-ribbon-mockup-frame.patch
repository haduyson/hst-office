+/** HST Office (1.0.2 ribbon mockup): the banner of the compact ribbon, MIN_WIDE_ART_WIDTH wide with the
+    artwork's ratio (260 x 75 logical px) at every window width. */
+inline StripSlot compactSlot(double fDpi)
+{
+    const long nW = scaled(MIN_WIDE_ART_WIDTH, fDpi);
+    return StripSlot{ nW, (nW * ART_HEIGHT + ART_WIDTH / 2) / ART_WIDTH };
+}
