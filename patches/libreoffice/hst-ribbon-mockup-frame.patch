+/** HST Office (1.0.2 ribbon mockup): the File page's title band. While the panel is open it covers the ribbon's body
+    left of the banner (the banner stays): a round back button, the greeting and "File · <document>". The panel itself
+    starts below the document tab strip, which stays where it is (owner, 14/11/2026). A click on the button closes the
+    panel as Esc does. The band is a child of the ribbon's tab control and goes with it. */
+class FileTitleBand final : public Control
+{
+public:
+    FileTitleBand(vcl::Window* pParent, std::function<void()> aBack)
+        : Control(pParent, WB_NOBORDER)
+        , m_aBack(std::move(aBack))
+    {
+        SetAccessibleRole(css::accessibility::AccessibleRole::PANEL);
+        pParent->AddEventListener(LINK(this, FileTitleBand, ParentEventHdl));
+    }
+
+    virtual ~FileTitleBand() override { disposeOnce(); }
+
+    virtual void dispose() override
+    {
+        if (vcl::Window* pParent = GetParent(); pParent && !pParent->isDisposed())
+            pParent->RemoveEventListener(LINK(this, FileTitleBand, ParentEventHdl));
+        Control::dispose();
+    }
+
+    void SetTexts(const OUString& rGreeting, const OUString& rSubtitle)
+    {
+        m_aGreeting = rGreeting;
+        m_aSubtitle = rSubtitle;
+        SetAccessibleName(rSubtitle.isEmpty() ? rGreeting : rGreeting + u", "_ustr + rSubtitle);
+        Invalidate();
+    }
+
+    virtual void Paint(vcl::RenderContext& rDev, const tools::Rectangle&) override
+    {
+        const StyleSettings& rStyle = rDev.GetSettings().GetStyleSettings();
+        const double fDpi = GetDPIScaleFactor();
+        const Size aOut = GetOutputSizePixel();
+        const Color aBack = rStyle.GetWindowColor();
+        const Color aText = rStyle.GetWindowTextColor();
+        Color aSoft(aText);
+        aSoft.Merge(aBack, 110); // the subtitle and the button's ring: a grey between text and window
+        rDev.Push(vcl::PushFlags::LINECOLOR | vcl::PushFlags::FILLCOLOR | vcl::PushFlags::FONT
+                  | vcl::PushFlags::TEXTCOLOR);
+        rDev.SetLineColor();
+        rDev.SetFillColor(aBack);
+        rDev.DrawRect(tools::Rectangle(Point(), aOut));
+        // the back button: a ring with a left arrow, the accent ring while hovered
+        const tools::Rectangle aButton = ButtonRect();
+        rDev.SetFillColor(m_bHover ? rStyle.GetFaceColor() : aBack);
+        rDev.SetLineColor(m_bHover ? rStyle.GetHighlightColor() : aSoft);
+        rDev.DrawEllipse(aButton);
+        const Point aCenter = aButton.Center();
+        const tools::Long nArm = std::lround(6 * fDpi), nHead = std::lround(4 * fDpi);
+        const LineInfo aLine(LineStyle::Solid, std::max<tools::Long>(1, std::lround(1.5 * fDpi)));
+        const Point aTip(aCenter.X() - nArm, aCenter.Y());
+        rDev.SetLineColor(aText);
+        rDev.DrawLine(aTip, Point(aCenter.X() + nArm, aCenter.Y()), aLine);
+        rDev.DrawLine(aTip, Point(aTip.X() + nHead, aTip.Y() - nHead), aLine);
+        rDev.DrawLine(aTip, Point(aTip.X() + nHead, aTip.Y() + nHead), aLine);
+        // the greeting (as large as the panel's page titles) and the subtitle below it, centred as one block
+        vcl::Font aTitleFont(rStyle.GetLabelFont());
+        aTitleFont.SetFontHeight(aTitleFont.GetFontHeight() * 1.6);
+        aTitleFont.SetWeight(WEIGHT_SEMIBOLD);
+        const vcl::Font aSubFont(rStyle.GetLabelFont());
+        rDev.SetFont(aTitleFont);
+        const tools::Long nTitle = rDev.GetTextHeight();
+        rDev.SetFont(aSubFont);
+        const tools::Long nSub = m_aSubtitle.isEmpty() ? 0 : rDev.GetTextHeight();
+        const tools::Long nGap = m_aSubtitle.isEmpty() ? 0 : std::lround(2 * fDpi);
+        const tools::Long nX = aButton.Right() + std::lround(16 * fDpi);
+        const tools::Long nWidth = std::max<tools::Long>(0, aOut.Width() - nX - std::lround(8 * fDpi));
+        const tools::Long nY = (aOut.Height() - nTitle - nGap - nSub) / 2;
+        const DrawTextFlags nFlags = DrawTextFlags::Left | DrawTextFlags::Top | DrawTextFlags::EndEllipsis;
+        rDev.SetFont(aTitleFont);
+        rDev.SetTextColor(aText);
+        rDev.DrawText(tools::Rectangle(Point(nX, nY), Size(nWidth, nTitle)), m_aGreeting, nFlags);
+        if (nSub)
+        {
+            rDev.SetFont(aSubFont);
+            rDev.SetTextColor(aSoft);
+            rDev.DrawText(tools::Rectangle(Point(nX, nY + nTitle + nGap), Size(nWidth, nSub)), m_aSubtitle, nFlags);
+        }
+        rDev.Pop();
+    }
+
+    virtual void MouseMove(const MouseEvent& rEvt) override
