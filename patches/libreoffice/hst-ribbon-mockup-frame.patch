+tools::Long NotebookbarTabControl::HstBannerRight() const
+{
+    // the document window's right edge in this control's pixels (this control may stop before it: the margins of
+    // the notebookbar's .ui), never past this control, less the 8 px gap of the mockup
+    const tools::Long nOwn = GetOutputSizePixel().Width();
+    tools::Long nEdge = nOwn;
+    const vcl::Window* pFrame = GetFrameWindow();
+    if (pFrame && !IsRTLEnabled())
+    {
+        const Point aEdge = ScreenToOutputPixel(pFrame->OutputToScreenPixel(Point(pFrame->GetOutputSizePixel().Width(), 0)));
+        if (aEdge.X() > 0)
+            nEdge = std::min(nOwn, aEdge.X());
+    }
+    return nEdge - hst::banner::scaled(hst::banner::RIGHT_GAP, GetDPIScaleFactor());
+}
