+// the tab control goes (a closed document window, a rebuilt ribbon): the band goes first, never a live child
+IMPL_LINK(FileTitleBand, ParentEventHdl, VclWindowEvent&, rEvent, void)
+{
+    if (rEvent.GetId() == VclEventId::ObjectDying)
+        disposeOnce();
+}
+
+void BackstageWindow::ShowTitleBand(bool bShow)
+{
+    if (!bShow)
+    {
+        if (m_xTitleBand && !m_xTitleBand->isDisposed())
+            m_xTitleBand->Hide();
+        m_xGreeting->set_visible(true);
+        return;
+    }
+    const TabControl* pFound = nullptr;
+    const vcl::Window* pBanner = nullptr;
+    lcl_findRibbonOf(VCLUnoHelper::GetWindow(m_xFrame->getContainerWindow()), pFound, pBanner);
+    // the band is a child window of the ribbon's tab control (the lookup only reads, the band is added to it)
+    TabControl* pTabs = const_cast<TabControl*>(pFound);
+    const TabPage* pPage = pTabs ? pTabs->GetTabPage(pTabs->GetCurPageId()) : nullptr;
+    if (!pPage || !pPage->IsVisible()) // no ribbon, or the compact ribbon: the greeting stays in the panel
+    {
+        ShowTitleBand(false);
+        return;
+    }
+    if (m_xTitleBand && (m_xTitleBand->isDisposed() || m_xTitleBand->GetParent() != pTabs))
+        m_xTitleBand.disposeAndClear();
+    if (!m_xTitleBand)
+        m_xTitleBand = VclPtr<FileTitleBand>::Create(pTabs, [this]() { Close(); });
+    // the whole body (the page and the tab control's 3 px above and below it), left of the banner and its 8 px gap
+    constexpr tools::Long PAGE_INSET = 3; // TAB_OFFSET of vcl/source/control/tabctrl.cxx, in px at every scale
+    const Point aPage = pPage->GetPosPixel();
+    tools::Long nRight = pTabs->GetOutputSizePixel().Width();
+    if (pBanner && pBanner->IsVisible() && pBanner->GetParent() == pTabs)
+        nRight = pBanner->GetPosPixel().X() - Scaled(8);
+    const tools::Long nTop = std::max<tools::Long>(0, aPage.Y() - PAGE_INSET);
+    const tools::Long nBottom = std::min(pTabs->GetOutputSizePixel().Height(),
+                                         aPage.Y() + pPage->GetSizePixel().Height() + PAGE_INSET);
+    if (nRight <= 0 || nBottom <= nTop)
+    {
+        ShowTitleBand(false);
+        return;
+    }
+    // "File · <document>": the File tab's own label and the document's title
+    OUString aFile;
+    for (sal_uInt16 nPos = 0; nPos < pTabs->GetPageCount(); ++nPos)
+        if (pTabs->GetPageName(pTabs->GetPageId(nPos)) == ::hst::ribbon::FILE_TAB_NAME)
+            aFile = pTabs->GetPageText(pTabs->GetPageId(nPos)).replaceAll("~", "");
+    OUString aTitle;
+    try
+    {
+        const uno::Reference<frame::XController> xController = m_xFrame->getController();
+        uno::Reference<frame::XTitle> xTitle;
+        if (xController.is())
+            xTitle.set(xController->getModel(), uno::UNO_QUERY);
+        if (xTitle.is())
+            aTitle = xTitle->getTitle();
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("sfx.backstage", "File title band: no document title");
+    }
+    const OUString aSubtitle = aFile.isEmpty() || aTitle.isEmpty() ? aFile + aTitle : aFile + u" · "_ustr + aTitle;
+    m_xTitleBand->SetPosSizePixel(Point(0, nTop), Size(nRight, nBottom - nTop));
+    m_xTitleBand->SetTexts(m_xGreeting->get_label(), aSubtitle);
+    m_xTitleBand->SetZOrder(nullptr, ZOrderFlags::First); // above the tab page and the ribbon's other children
+    m_xTitleBand->Show();
+    m_xGreeting->set_visible(false); // the greeting is in the band now
+}
