+// HST: Word's WdColorIndex 1-16 (wdBlack ... wdGray25), as RGB; 0 is wdAuto. 17 and 18 are accepted and give black.
+constexpr sal_Int32 aWordColorIndex[] = { 0x000000, 0x0000FF, 0x00FFFF, 0x00FF00, 0xFF00FF, 0xFF0000, 0xFFFF00, 0xFFFFFF,
+                                          0x000080, 0x008080, 0x008000, 0x800080, 0x800000, 0x808000, 0x808080, 0xC0C0C0 };
+constexpr sal_Int32 nWdColorAutomatic = -16777216;
+constexpr sal_Int32 nAutoColor = -1;
+
+sal_Int32 lcl_swapRedBlue( sal_Int32 nColor )
+{
+    return ( nColor & 0xFF00FF00 ) | ( ( nColor & 0xFF ) << 16 ) | ( ( nColor >> 16 ) & 0xFF );
+}
+}
