+CPPUNIT_TEST_FIXTURE(SwUibaseUnoTest, testNumberFormatsSupplierConcurrentQuery)
+{
+    // HST Office: a UNO bridge thread and a script on the main thread asking a new document for its
+    // number formats at the same moment must get the same object. Without a lock each created its
+    // own number formats aggregate, one replaced the other while still in use, and the heap broke.
+    for (int nRound = 0; nRound < 40; ++nRound)
+    {
+        if (mxComponent.is())
+        {
+            mxComponent->dispose();
+            mxComponent.clear();
+        }
+        createSwDoc();
+        uno::Reference<uno::XInterface> xDocument(mxComponent, uno::UNO_QUERY_THROW);
+        std::atomic<int> nReady(0);
+        uno::Reference<util::XNumberFormatsSupplier> aSuppliers[2];
+        auto query = [&](int nIndex) {
+            ++nReady;
+            while (nReady.load() < 2)
+                std::this_thread::yield();
+            aSuppliers[nIndex].set(xDocument, uno::UNO_QUERY);
+        };
+        std::thread aOther(query, 1);
+        query(0);
+        aOther.join();
+        CPPUNIT_ASSERT(aSuppliers[0].is());
+        // Without the fix, the two threads could get the interfaces of two different aggregates.
+        CPPUNIT_ASSERT_EQUAL(aSuppliers[0].get(), aSuppliers[1].get());
+    }
+}
+
 CPPUNIT_PLUGIN_IMPLEMENT();
 
