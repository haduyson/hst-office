+namespace
+{
+// HST Office: the ribbon (Tabbed notebookbar) has a tinted background that must show only as a thin frame.
+// The GTK and Qt backends draw the tab pane themselves with the theme's window colour; on the other backends
+// (macOS, Windows, generic) the pane is transparent, so the tint would fill the whole ribbon.
+bool lcl_ribbonNeedsOwnPanel()
+{
+    const OUString aToolkit = Application::GetToolkitName();
+    return !aToolkit.startsWith("gtk") && !aToolkit.startsWith("qt") && !aToolkit.startsWith("kf");
+}
