         case SID_PRINTSCALE_OPTIONS: // HST Office: the page style dialog on the Page tab, which has the scaling
             {
-                if ( pReqArgs == nullptr )
+                // HST: .uno:PageFormatDialog?Page:string=sheet opens the dialog on that tab (the ribbon's
+                // Sheet Options launcher); any other argument keeps the old meaning (no dialog).
+                const SfxStringItem* pHstPage = rReq.GetSlot() == SID_FORMATPAGE
+                                                    ? rReq.GetArg<SfxStringItem>(SID_FORMATPAGE) : nullptr;
+                if ( pReqArgs == nullptr || (pHstPage && pReqArgs->Count() == 1) )
                 {
                     OUString aOldName = m_pDocument->GetPageStyle( nCurTab );
                     ScStyleSheetPool* pStylePool = m_pDocument->GetStyleSheetPool();
@@ -2190,6 +2194,8 @@
                         VclPtr<SfxAbstractTabDialog> pDlg(pFact->CreateScStyleDlg(GetActiveDialogParent(), *pStyleSheet, true));
                         if ( rReq.GetSlot() == SID_PRINTSCALE_OPTIONS )
                             pDlg->SetCurPageId(u"page"_ustr);
+                        else if ( pHstPage && !pHstPage->GetValue().isEmpty() )
+                            pDlg->SetCurPageId(pHstPage->GetValue());
 
                         auto xRequest = std::make_shared<SfxRequest>(rReq);
                         rReq.Ignore(); // the 'old' request is not relevant any more
