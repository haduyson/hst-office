Test: tests/runtime/check-dialogs-sheets.py page-setup
---
--- a/sc/sdi/scalc.sdi
+++ b/sc/sdi/scalc.sdi
@@ -4304,7 +4304,7 @@
 
 
 SfxVoidItem PageFormatDialog SID_FORMATPAGE
-()
+(SfxStringItem Page SID_FORMATPAGE)
 [
     AutoUpdate = FALSE,
     FastCall = FALSE,
