+/* HST Office: the look of the File panel. With the frame coat (FrameCoat/Backstage, under the coat's
+   own switch, never in high contrast) every colour comes from the HST design tokens and the left
+   column is drawn as the Start Center's: a side panel, a pill for the selected and the hovered item,
+   the keyboard focus ring, 40 px items. Without it the panel keeps its earlier colours
+   (hstbackstagelegacycolors.hxx), so switching the coat off restores the old look. */
+namespace sfx2::hst
+{
+/** Every colour the File panel and its title band use, in one look. */
+struct BackstageColors
+{
+    bool bCoat = false; ///< the HST frame coat (tokens) or the earlier look
+    Color aAccent; ///< the strip along the panel's top edge; the selected item's bar (earlier look)
+    Color aPanel; ///< behind the pages and the footer
+    Color aCard; ///< behind a block of a page (the tiles, the document's properties, the export choices)
+    Color aNavBack; ///< the left column
+    Color aNavSeparator;
+    Color aNavSelected; ///< the selected item's fill
+    Color aNavHover; ///< the fill of the item under the mouse
+    Color aNavText;
+    Color aNavSelectedText;
+    Color aNavGlyph; ///< the Home item's house
+    Color aNavSelectedGlyph;
+    Color aPaper; ///< a tile's page preview: a template ...
+    Color aPaperBlank; ///< ... and the blank document
+    Color aPaperBorder;
+    Color aPaperInk; ///< the administrative document's heading
+    Color aPaperLines; ///< its text lines
+    Color aBand; ///< the File title band over the ribbon's body
+    Color aBandText;
+    Color aBandMuted; ///< its subtitle
+    Color aBandButtonRing; ///< the back button's ring
+    Color aBandButtonHover; ///< the back button's fill under the mouse ...
+    Color aBandButtonHoverRing; ///< ... and its ring
+};
+
+/** The colours of the File panel of eApp for these style settings: the tokens when bCoat, else the
+    earlier look (the application colour, the window and text colours of rStyle). */
+SFX2_DLLPUBLIC BackstageColors GetBackstageColors(const StyleSettings& rStyle, BackstageApp eApp,
+                                                  bool bCoat);
+
+/** Whether the File panel is drawn with the HST frame coat for these style settings. */
+SFX2_DLLPUBLIC bool BackstageCoatActive(const StyleSettings& rStyle);
+
+/** The left column's items in the coat: 40 px high, a pill inset from the column's edges. */
+namespace coat
+{
+constexpr tools::Long NAV_ITEM_HEIGHT = 40; ///< as the Start Center's menu rows
+constexpr tools::Long NAV_ITEM_MIN_HEIGHT = 24;
+constexpr tools::Long NAV_ITEM_GAP = 4; ///< the spacing of the column (hstbackstage.ui "nav")
+}
+
+/** The height of a left-column item in the coat: NAV_ITEM_HEIGHT (scaled) while nItems of it fit in
+    nAvailable pixels (after nFixed pixels of margins, gaps and the separator), less when they do not,
+    never below NAV_ITEM_MIN_HEIGHT nor below the text (nTextHeight) with 2 px above and below. */
+SFX2_DLLPUBLIC tools::Long CoatNavItemHeight(tools::Long nAvailable, tools::Long nFixed, int nItems,
+                                             tools::Long nTextHeight, double fScale);
+
+/** The state of a left-column item. */
+struct NavItemState
+{
