+StyleSettings makeStyle(bool bDark)
+{
+    StyleSettings aStyle(Application::GetSettings().GetStyleSettings());
+    aStyle.SetHighContrastMode(false);
+    aStyle.SetWindowColor(bDark ? Color(0x20, 0x20, 0x20) : COL_WHITE);
+    aStyle.SetWindowTextColor(bDark ? COL_WHITE : COL_BLACK);
+    return aStyle;
+}
+
+tools::Long px(double fLength, double fScale) { return std::lround(fLength * fScale); }
+
+/** An item of the left column painted into a device of nWidth x nHeight. */
+ScopedVclPtr<VirtualDevice> paintItem(const StyleSettings& rStyle, const NavItemState& rState,
+                                      tools::Long nWidth, tools::Long nHeight, double fScale)
+{
+    ScopedVclPtr<VirtualDevice> xDev(VclPtr<VirtualDevice>::Create(DeviceFormat::WITHOUT_ALPHA));
+    xDev->SetOutputSizePixel(Size(nWidth, nHeight));
+    PaintCoatNavItem(*xDev, rStyle, rState, u"Thông tin"_ustr, Image(), false, fScale);
+    return xDev;
+}
+
+std::string readFile(const OUString& rURL)
+{
+    osl::File aFile(rURL);
+    if (aFile.open(osl_File_OpenFlag_Read) != osl::FileBase::E_None)
+        return std::string();
+    OStringBuffer aBuf;
+    char aChunk[4096];
+    sal_uInt64 nRead = 0;
+    while (aFile.read(aChunk, sizeof(aChunk), nRead) == osl::FileBase::E_None && nRead > 0)
+        aBuf.append(aChunk, static_cast<sal_Int32>(nRead));
+    return std::string(aBuf.getStr(), aBuf.getLength());
+}
+
+/** The C++ files of a source directory (a URL ending in "/"). */
+std::vector<OUString> sourceFiles(const OUString& rDirURL)
+{
+    std::vector<OUString> aFiles;
+    osl::Directory aDir(rDirURL);
+    if (aDir.open() != osl::FileBase::E_None)
+        return aFiles;
+    osl::DirectoryItem aItem;
+    while (aDir.getNextItem(aItem) == osl::FileBase::E_None)
+    {
+        osl::FileStatus aStatus(osl_FileStatus_Mask_FileURL | osl_FileStatus_Mask_FileName);
+        if (aItem.getFileStatus(aStatus) != osl::FileBase::E_None)
+            continue;
+        const OUString aName = aStatus.getFileName();
+        if (aName.endsWith(".cxx") || aName.endsWith(".hxx") || aName.endsWith(".hrc"))
+            aFiles.push_back(aStatus.getFileURL());
+    }
+    return aFiles;
+}
+}
