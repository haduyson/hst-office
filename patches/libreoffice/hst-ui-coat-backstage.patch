+tools::Long px(double fLength, double fScale)
+{
+    return static_cast<tools::Long>(std::lround(fLength * fScale));
+}
+
+double luminance(const Color& rColor)
+{
+    auto lin = [](sal_uInt8 c) {
+        double v = c / 255.0;
+        return v <= 0.03928 ? v / 12.92 : std::pow((v + 0.055) / 1.055, 2.4);
+    };
+    return 0.2126 * lin(rColor.GetRed()) + 0.7152 * lin(rColor.GetGreen())
+           + 0.0722 * lin(rColor.GetBlue());
+}
+
+/// The application colour of the earlier look, darkened until white text on it has at least a 4.5:1
+/// contrast (WCAG AA).
+Color legacyAppColor(BackstageApp eApp)
+{
+    const Color aBase = eApp == BackstageApp::Writer    ? legacy::WRITER_COLOR
+                        : eApp == BackstageApp::Calc    ? legacy::CALC_COLOR
+                        : eApp == BackstageApp::Impress ? legacy::IMPRESS_COLOR
+                        : eApp == BackstageApp::Draw    ? legacy::DRAW_COLOR
+                                                        : legacy::OTHER_COLOR;
+    for (double fFactor = 1.0; fFactor > 0.3; fFactor -= 0.02)
+    {
+        Color aColor(static_cast<sal_uInt8>(aBase.GetRed() * fFactor),
+                     static_cast<sal_uInt8>(aBase.GetGreen() * fFactor),
+                     static_cast<sal_uInt8>(aBase.GetBlue() * fFactor));
+        if (1.05 / (luminance(aColor) + 0.05) >= 4.5)
+            return aColor;
+    }
+    return aBase;
+}
+
+BackstageColors legacyColors(const StyleSettings& rStyle, BackstageApp eApp)
+{
+    BackstageColors c;
+    const Color aWindow(rStyle.GetWindowColor());
+    const Color aText(rStyle.GetWindowTextColor());
+    const bool bDark = aWindow.IsDark();
+    const Color aApp = legacyAppColor(eApp);
+    c.aAccent = aApp;
+    if (bDark)
+        c.aAccent.Merge(legacy::LIGHTEN, 150); // the darkened colour is too dark on a dark window
+    c.aPanel = aWindow;
+    c.aCard = aWindow;
+    c.aNavBack = aWindow;
+    c.aNavBack.Merge(bDark ? legacy::LIGHTEN : aApp, 244);
+    c.aNavSeparator = c.aNavBack;
+    c.aNavSeparator.Merge(aText, 215);
+    // the selected item is tinted with the accent and marked by a bar of it, the hovered one is tinted lightly
+    c.aNavSelected = c.aNavBack;
+    c.aNavSelected.Merge(c.aAccent, 220);
+    c.aNavHover = c.aNavBack;
+    c.aNavHover.Merge(c.aAccent, 238);
+    c.aNavText = aText;
+    c.aNavSelectedText = aText;
+    c.aNavGlyph = aText;
+    c.aNavSelectedGlyph = aText;
+    c.aPaper = legacy::PAPER;
+    c.aPaperBlank = legacy::PAPER_BLANK;
+    c.aPaperBorder = bDark ? legacy::PAPER_BORDER_DARK : legacy::PAPER_BORDER;
+    c.aPaperInk = legacy::PAPER_INK;
+    c.aPaperLines = legacy::PAPER_LINES;
+    c.aBand = aWindow;
+    c.aBandText = aText;
+    c.aBandMuted = aText;
+    c.aBandMuted.Merge(aWindow, 110); // a grey between text and window
+    c.aBandButtonRing = c.aBandMuted;
+    c.aBandButtonHover = rStyle.GetFaceColor();
+    c.aBandButtonHoverRing = rStyle.GetHighlightColor();
+    return c;
+}
+
+BackstageColors coatColors(const StyleSettings& rStyle)
+{
+    const design::Palette& p = design::GetPalette(rStyle);
+    BackstageColors c;
+    c.bCoat = true;
+    c.aAccent = p.aSelectedIndicator;
+    c.aPanel = p.aFrameSurface;
+    c.aCard = p.aCard;
+    c.aNavBack = p.aSide;
+    c.aNavSeparator = p.aCardBorder;
+    c.aNavSelected = p.aPill;
+    c.aNavHover = p.aHover;
+    c.aNavText = p.aText;
+    c.aNavSelectedText = p.aAccent;
+    c.aNavGlyph = p.aIcon;
+    c.aNavSelectedGlyph = p.aAccent;
+    c.aPaper = p.aFrameSurface;
+    c.aPaperBlank = p.aCard;
+    c.aPaperBorder = p.aCardBorder;
+    c.aPaperInk = p.aText;
+    c.aPaperLines = p.aCardBorder;
+    c.aBand = p.aFrameSurface;
+    c.aBandText = p.aText;
+    c.aBandMuted = p.aMuted;
+    c.aBandButtonRing = p.aCardBorder;
+    c.aBandButtonHover = p.aHover;
+    c.aBandButtonHoverRing = p.aAccent;
+    return c;
+}
+}
+
+BackstageColors GetBackstageColors(const StyleSettings& rStyle, BackstageApp eApp, bool bCoat)
+{
+    return bCoat ? coatColors(rStyle) : legacyColors(rStyle, eApp);
+}
+
+bool BackstageCoatActive(const StyleSettings& rStyle)
+{
+    return ::hst::coat::FrameCoatActive(::hst::coat::FrameComponent::Backstage, rStyle);
+}
+
+tools::Long CoatNavItemHeight(tools::Long nAvailable, tools::Long nFixed, int nItems,
+                              tools::Long nTextHeight, double fScale)
+{
+    const tools::Long nFloor
+        = std::max(px(coat::NAV_ITEM_MIN_HEIGHT, fScale), nTextHeight + px(4, fScale));
+    const tools::Long nFull = std::max(px(coat::NAV_ITEM_HEIGHT, fScale), nFloor);
+    if (nItems <= 0)
+        return nFull;
+    const tools::Long nFit = (nAvailable - nFixed) / nItems;
+    return std::clamp(nFit, nFloor, nFull);
+}
+
+tools::Rectangle CoatNavPill(const Size& rSize, double fScale)
+{
+    const tools::Long nInset = px(design::space::S, fScale);
+    return tools::Rectangle(Point(nInset, 0),
+                            Size(std::max<tools::Long>(1, rSize.Width() - 2 * nInset), rSize.Height()));
+}
+
+tools::Long CoatNavWidth(tools::Long nTextWidth, double fScale)
+{
+    // the pill's insets, the glyph with space::M on both sides, the text and space::S after it
+    const tools::Long nChrome = px(2 * design::space::S + 2 * design::space::M + design::icon::Nav
+                                       + design::space::S,
+                                   fScale);
+    return std::max(px(200, fScale), nTextWidth + nChrome);
+}
+
+void DrawHouse(OutputDevice& rDev, const Point& rTopLeft, tools::Long nSize, const Color& rColor)
+{
+    const tools::Long x = rTopLeft.X(), y = rTopLeft.Y();
+    auto at = [&](double fX, double fY) {
+        return Point(x + static_cast<tools::Long>(fX * nSize), y + static_cast<tools::Long>(fY * nSize));
+    };
+    rDev.SetLineColor(rColor);
+    rDev.SetFillColor();
+    const Point aOutline[] = { at(0.06, 0.5), at(0.5, 0.1), at(0.94, 0.5) };
+    rDev.DrawPolyLine(tools::Polygon(3, aOutline));
+    const Point aBody[] = { at(0.2, 0.38), at(0.2, 0.92), at(0.8, 0.92), at(0.8, 0.38) };
+    rDev.DrawPolyLine(tools::Polygon(4, aBody));
+    rDev.DrawRect(tools::Rectangle(at(0.42, 0.62), at(0.58, 0.92)));
+}
+
+void PaintCoatNavItem(OutputDevice& rDev, const StyleSettings& rStyle, const NavItemState& rState,
+                      const OUString& rText, const Image& rIcon, bool bHouse, double fScale)
+{
+    const design::Palette& p = design::GetPalette(rStyle);
+    const BackstageColors c = coatColors(rStyle);
+    const Size aSize = rDev.GetOutputSizePixel();
+    const tools::Rectangle aAll(Point(), aSize);
+    auto aPop = rDev.ScopedPush(vcl::PushFlags::LINECOLOR | vcl::PushFlags::FILLCOLOR
+                                | vcl::PushFlags::FONT | vcl::PushFlags::TEXTCOLOR);
+    // the side panel's colour at the item (its gradient is a step of a few levels top to bottom)
+    rDev.SetLineColor();
+    rDev.SetFillColor(c.aNavBack);
+    rDev.DrawRect(aAll);
+
+    const tools::Rectangle aPill = CoatNavPill(aSize, fScale);
+    if (rState.bSelected || rState.bHover)
+        design::DrawPill(rDev, aPill, p, rState.bSelected, fScale);
+    if (rState.bFocus)
+    {
+        // the item has no room around its pill: the ring lies on the pill's edge, inside the item
+        const tools::Long nOut = px(design::FOCUS_RING_GAP + design::FOCUS_RING_WIDTH, fScale);
+        tools::Rectangle aInner(aPill);
+        aInner.shrink(nOut);
+        design::DrawFocusRing(rDev, aInner, std::max(0.0, design::radius::Control * fScale - nOut), p,
+                              fScale);
+    }
+
+    const tools::Long nGlyph = px(design::icon::Nav, fScale);
+    const tools::Long nGlyphX = aPill.Left() + px(design::space::M, fScale);
+    const tools::Long nCentreY = aSize.Height() / 2;
+    if (bHouse)
+    {
+        const tools::Long nHouse = px(16, fScale);
+        DrawHouse(rDev, Point(nGlyphX + (nGlyph - nHouse) / 2, nCentreY - nHouse / 2), nHouse,
+                  rState.bSelected ? c.aNavSelectedGlyph : c.aNavGlyph);
+    }
+    else if (!rIcon.GetSizePixel().IsEmpty())
+    {
+        const Size aIcon(rIcon.GetSizePixel());
+        rDev.DrawImage(Point(nGlyphX + (nGlyph - aIcon.Width()) / 2, nCentreY - aIcon.Height() / 2), rIcon);
+    }
+
+    rDev.SetFont(design::MakePixelFont(rStyle, rState.bSelected ? design::type::NavSelected
+                                                                : design::type::Nav,
+                                       rDev.GetDPIY()));
+    const tools::Long nTextX = nGlyphX + nGlyph + px(design::space::M, fScale);
+    const tools::Long nMaxWidth = aPill.Right() - px(design::space::S, fScale) - nTextX;
+    if (nMaxWidth > 0 && !rText.isEmpty())
+    {
+        rDev.SetTextColor(rState.bSelected ? c.aNavSelectedText : c.aNavText);
+        rDev.DrawText(Point(nTextX, nCentreY - rDev.GetTextHeight() / 2),
+                      rDev.GetEllipsisString(rText, nMaxWidth));
+    }
+}
+
+void PaintTilePage(VirtualDevice& rDev, const BackstageColors& rColors, const StyleSettings& rStyle,
+                   bool bNd30, bool bBlank, tools::Long nWidth, tools::Long nHeight, double fScale)
+{
+    auto scaled = [fScale](tools::Long n) { return static_cast<tools::Long>(n * fScale + 0.5); };
+    rDev.SetOutputSizePixel(Size(nWidth, nHeight));
+    rDev.SetBackground(Wallpaper(rColors.aCard));
+    rDev.Erase();
+    const tools::Rectangle aPage(Point(0, 0), Size(nWidth, nHeight));
+    const Color aFill = bBlank ? rColors.aPaperBlank : rColors.aPaper;
+    if (rColors.bCoat)
+        design::DrawRoundRect(rDev, aPage, design::radius::Check * fScale, aFill, rColors.aPaperBorder);
+    else
+    {
+        rDev.SetLineColor(rColors.aPaperBorder);
+        rDev.SetFillColor(aFill);
+        rDev.DrawRect(aPage);
+    }
+    if (!bNd30)
+        return;
+    vcl::Font aFont(rStyle.GetAppFont());
+    aFont.SetFontHeight(scaled(5));
+    aFont.SetWeight(WEIGHT_BOLD);
+    aFont.SetColor(rColors.aPaperInk);
+    rDev.SetFont(aFont);
+    rDev.SetTextColor(rColors.aPaperInk);
+    const OUString aLine1(u"CỘNG HÒA XÃ HỘI"_ustr);
+    const OUString aLine2(u"CHỦ NGHĨA VIỆT NAM"_ustr);
+    const tools::Long nH = rDev.GetTextHeight();
+    rDev.DrawText(Point((nWidth - rDev.GetTextWidth(aLine1)) / 2, scaled(12)), aLine1);
+    rDev.DrawText(Point((nWidth - rDev.GetTextWidth(aLine2)) / 2, scaled(12) + nH), aLine2);
+    rDev.SetLineColor(rColors.aPaperInk);
+    rDev.DrawLine(Point(nWidth / 2 - scaled(14), scaled(14) + 2 * nH),
+                  Point(nWidth / 2 + scaled(14), scaled(14) + 2 * nH));
+    // text lines of the body
+    rDev.SetLineColor(rColors.aPaperLines);
+    for (tools::Long y = scaled(36); y < nHeight - scaled(12); y += scaled(6))
+        rDev.DrawLine(Point(scaled(10), y), Point(nWidth - scaled(10), y));
+}
+}
