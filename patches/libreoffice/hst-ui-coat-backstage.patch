+class BackstageCoatTest : public test::BootstrapFixture
+{
+};
+
+/* In the coat every colour of the panel is a token: the side panel, the pills, the text, the cards
+   and the surfaces, light and dark. */
+CPPUNIT_TEST_FIXTURE(BackstageCoatTest, testCoatColoursComeFromTokens)
+{
+    for (bool bDark : { false, true })
+    {
+        const StyleSettings aStyle = makeStyle(bDark);
+        const design::Palette& p = design::GetPalette(bDark);
+        const BackstageColors c = GetBackstageColors(aStyle, BackstageApp::Writer, true);
+        CPPUNIT_ASSERT(c.bCoat);
+        CPPUNIT_ASSERT_EQUAL(p.aSide, c.aNavBack);
+        CPPUNIT_ASSERT_EQUAL(p.aPill, c.aNavSelected);
+        CPPUNIT_ASSERT_EQUAL(p.aHover, c.aNavHover);
+        CPPUNIT_ASSERT_EQUAL(p.aText, c.aNavText);
+        CPPUNIT_ASSERT_EQUAL(p.aAccent, c.aNavSelectedText);
+        CPPUNIT_ASSERT_EQUAL(p.aSelectedIndicator, c.aAccent);
+        CPPUNIT_ASSERT_EQUAL(p.aCardBorder, c.aNavSeparator);
+        CPPUNIT_ASSERT_EQUAL(p.aFrameSurface, c.aPanel);
+        CPPUNIT_ASSERT_EQUAL(p.aCard, c.aCard);
+        CPPUNIT_ASSERT_EQUAL(p.aFrameSurface, c.aBand);
+        CPPUNIT_ASSERT_EQUAL(p.aMuted, c.aBandMuted);
+        CPPUNIT_ASSERT_EQUAL(p.aCardBorder, c.aPaperBorder);
+        // the same for every application: the coat has one accent
+        const BackstageColors aCalc = GetBackstageColors(aStyle, BackstageApp::Calc, true);
+        CPPUNIT_ASSERT_EQUAL(c.aAccent, aCalc.aAccent);
+    }
+}
+
+/* Without the coat the panel keeps its earlier colours: the application colour darkened for white
+   text (Writer #177AC0, Sheets #2B8731) tints the left column. */
+CPPUNIT_TEST_FIXTURE(BackstageCoatTest, testEarlierLookKeepsItsColours)
+{
+    const StyleSettings aStyle = makeStyle(false);
+    const BackstageColors c = GetBackstageColors(aStyle, BackstageApp::Writer, false);
+    CPPUNIT_ASSERT(!c.bCoat);
+    CPPUNIT_ASSERT_EQUAL(Color(0x17, 0x7a, 0xc0), c.aAccent);
+    CPPUNIT_ASSERT_EQUAL(Color(0xf5, 0xf9, 0xfd), c.aNavBack);
+    CPPUNIT_ASSERT_EQUAL(Color(0xd6, 0xe8, 0xf5), c.aNavSelected);
+    CPPUNIT_ASSERT_EQUAL(Color(0xe6, 0xf1, 0xf9), c.aNavHover);
+    CPPUNIT_ASSERT_EQUAL(Color(0xce, 0xd2, 0xd5), c.aNavSeparator);
+    CPPUNIT_ASSERT_EQUAL(COL_WHITE, c.aPanel);
+    CPPUNIT_ASSERT_EQUAL(COL_WHITE, c.aPaperBlank);
+    CPPUNIT_ASSERT_EQUAL(Color(0x2b, 0x87, 0x31),
+                         GetBackstageColors(aStyle, BackstageApp::Calc, false).aAccent);
+}
+
+/* The selected item is a pill of the token colour inset in the side panel, with round corners; the
+   hovered one a lighter pill; the others only the side panel. At 100 % and 125 %, light and dark. */
+CPPUNIT_TEST_FIXTURE(BackstageCoatTest, testSelectedItemIsATokenPill)
+{
+    for (bool bDark : { false, true })
+        for (double fScale : { 1.0, 1.25 })
+        {
+            const StyleSettings aStyle = makeStyle(bDark);
+            const design::Palette& p = design::GetPalette(bDark);
+            const tools::Long nWidth = px(220, fScale), nHeight = px(40, fScale);
+            const tools::Rectangle aPill = CoatNavPill(Size(nWidth, nHeight), fScale);
+            CPPUNIT_ASSERT_EQUAL(px(design::space::S, fScale), aPill.Left());
+            CPPUNIT_ASSERT_EQUAL(nWidth - 1 - px(design::space::S, fScale), aPill.Right());
+            CPPUNIT_ASSERT_EQUAL(nHeight, aPill.GetHeight());
+            // right of the text, inside the pill
+            const Point aInside(aPill.Right() - px(5, fScale), nHeight / 2);
+            const Point aOutside(px(2, fScale), nHeight / 2);
+            const Point aCorner(aPill.Left(), 0);
+
+            NavItemState aState;
+            aState.bSelected = true;
+            ScopedVclPtr<VirtualDevice> xSelected = paintItem(aStyle, aState, nWidth, nHeight, fScale);
+            CPPUNIT_ASSERT_EQUAL(p.aPill, xSelected->GetPixel(aInside));
+            CPPUNIT_ASSERT_EQUAL(p.aSide, xSelected->GetPixel(aOutside));
+            CPPUNIT_ASSERT_EQUAL(p.aSide, xSelected->GetPixel(aCorner)); // a round corner
+
+            aState = NavItemState();
+            aState.bHover = true;
+            ScopedVclPtr<VirtualDevice> xHover = paintItem(aStyle, aState, nWidth, nHeight, fScale);
+            CPPUNIT_ASSERT_EQUAL(p.aHover, xHover->GetPixel(aInside));
+
+            ScopedVclPtr<VirtualDevice> xPlain
+                = paintItem(aStyle, NavItemState(), nWidth, nHeight, fScale);
+            CPPUNIT_ASSERT_EQUAL(p.aSide, xPlain->GetPixel(aInside));
+        }
+}
+
+/* The item with the keyboard focus shows the accent ring on its pill's edge; the others do not. */
+CPPUNIT_TEST_FIXTURE(BackstageCoatTest, testFocusedItemHasTheFocusRing)
+{
+    for (double fScale : { 1.0, 1.25 })
+    {
+        const StyleSettings aStyle = makeStyle(false);
+        const design::Palette& p = design::GetPalette(false);
+        const tools::Long nWidth = px(220, fScale), nHeight = px(40, fScale);
+        const tools::Rectangle aPill = CoatNavPill(Size(nWidth, nHeight), fScale);
+        const Point aRing(aPill.Right(), nHeight / 2);
+        NavItemState aState;
+        aState.bSelected = true;
+        aState.bFocus = true;
+        ScopedVclPtr<VirtualDevice> xFocused = paintItem(aStyle, aState, nWidth, nHeight, fScale);
+        CPPUNIT_ASSERT_EQUAL(p.aAccent, xFocused->GetPixel(aRing));
+        aState.bFocus = false;
+        ScopedVclPtr<VirtualDevice> xUnfocused = paintItem(aStyle, aState, nWidth, nHeight, fScale);
+        CPPUNIT_ASSERT(xUnfocused->GetPixel(aRing) != p.aAccent);
+    }
+}
+
+/* The items are 40 px high (scaled) while they fit; in a short panel they get lower, down to 24 px
+   or the text's height with 2 px above and below; the column is wide enough for the widest text. */
+CPPUNIT_TEST_FIXTURE(BackstageCoatTest, testItemsAre40pxAndFitThePanel)
+{
+    CPPUNIT_ASSERT_EQUAL(tools::Long(40), CoatNavItemHeight(2000, 100, 12, 17, 1.0));
+    CPPUNIT_ASSERT_EQUAL(tools::Long(50), CoatNavItemHeight(2000, 100, 12, 17, 1.25));
+    // 12 items in 100 + 12 * 30 pixels
+    CPPUNIT_ASSERT_EQUAL(tools::Long(30), CoatNavItemHeight(460, 100, 12, 17, 1.0));
+    CPPUNIT_ASSERT_EQUAL(tools::Long(24), CoatNavItemHeight(200, 100, 12, 17, 1.0));
+    CPPUNIT_ASSERT_EQUAL(tools::Long(26), CoatNavItemHeight(200, 100, 12, 22, 1.0));
+    CPPUNIT_ASSERT_EQUAL(tools::Long(200), CoatNavWidth(10, 1.0));
+    CPPUNIT_ASSERT_EQUAL(tools::Long(250), CoatNavWidth(10, 1.25));
+    CPPUNIT_ASSERT(CoatNavWidth(300, 1.0) > 300);
+}
+
+/* No colour is written into the panel's code: every literal is in the file of the earlier look. */
+CPPUNIT_TEST_FIXTURE(BackstageCoatTest, testNoColourLiteralsInThePanelCode)
+{
+    const std::regex aLiteral(
+        R"(0x[0-9a-fA-F]{2}\s*,\s*0x[0-9a-fA-F]{2}\s*,\s*0x[0-9a-fA-F]{2})"
+        R"(|\bCOL_(?!TRANSPARENT\b|AUTO\b)[A-Z_]+)"
+        R"(|\bColor\s*\(\s*(ColorTransparency|ColorAlpha|0x[0-9a-fA-F]{6}))");
+    std::vector<OUString> aFiles = sourceFiles(m_directories.getURLFromSrc(u"/sfx2/source/backstage/"));
+    const std::vector<OUString> aInc = sourceFiles(m_directories.getURLFromSrc(u"/sfx2/inc/backstage/"));
+    aFiles.insert(aFiles.end(), aInc.begin(), aInc.end());
+    aFiles.push_back(m_directories.getURLFromSrc(u"/vcl/source/hst/coat/css/backstage.cxx"));
+    CPPUNIT_ASSERT(aFiles.size() > 10);
+    int nChecked = 0;
+    for (const OUString& rURL : aFiles)
+    {
+        if (rURL.endsWith("/hstbackstagelegacycolors.hxx"))
+            continue;
+        const std::string aText = readFile(rURL);
+        CPPUNIT_ASSERT_MESSAGE(rURL.toUtf8().getStr(), !aText.empty());
+        std::smatch aMatch;
+        const bool bFound = std::regex_search(aText, aMatch, aLiteral);
+        CPPUNIT_ASSERT_MESSAGE(OString(rURL.toUtf8() + ": " + aMatch.str().c_str()).getStr(), !bFound);
+        ++nChecked;
+    }
+    CPPUNIT_ASSERT(nChecked > 10);
+}
+
+/* High contrast keeps the platform's look: the coat is off. */
+CPPUNIT_TEST_FIXTURE(BackstageCoatTest, testHighContrastHasNoCoat)
+{
+    StyleSettings aStyle = makeStyle(false);
+    aStyle.SetHighContrastMode(true);
+    CPPUNIT_ASSERT(!BackstageCoatActive(aStyle));
+    aStyle.SetHighContrastMode(false);
+    CPPUNIT_ASSERT(BackstageCoatActive(aStyle));
+}
+
+CPPUNIT_PLUGIN_IMPLEMENT();
