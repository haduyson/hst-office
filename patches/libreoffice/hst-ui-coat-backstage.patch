+    CPPUNIT_ASSERT_EQUAL(tools::Long(26), CoatNavItemHeight(200, 100, 12, 22, 1.0));
+    CPPUNIT_ASSERT_EQUAL(tools::Long(200), CoatNavWidth(10, 1.0));
