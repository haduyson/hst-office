+// HST Office: registrymodifications.xcu that is empty or cannot be parsed (a power cut between
+// the rename and the data reaching the disk) is kept as <name>.hong-<time> for diagnosis, replaced by
+// the copy the office keeps in user/pack at every normal exit, and a marker file tells the bundled
+// extension to inform the user (registrymodifications.xcu.hst-repaired: "restored" or "reset").
+bool hstIsEmptyFile(OUString const & url) {
+    osl::DirectoryItem item;
+    osl::FileStatus status(osl_FileStatus_Mask_FileSize);
+    return osl::DirectoryItem::get(url, item) == osl::FileBase::E_None
+        && item.getFileStatus(status) == osl::FileBase::E_None
+        && status.getFileSize() == 0;
+}
+
+bool hstRepairModificationFile(OUString const & url) {
+    TimeValue now;
+    TimeValue local;
+    oslDateTime dt{};
+    osl_getSystemTime(&now);
+    if (osl_getLocalTimeFromSystemTime(&now, &local)) {
+        osl_getDateTimeFromTimeValue(&local, &dt);
+    }
+    OUString stamp(OUString::number(dt.Year * 10000 + dt.Month * 100 + dt.Day) + "-"
+                   + OUString(OUString::number(1000000 + dt.Hours * 10000 + dt.Minutes * 100 + dt.Seconds)).copy(1));
+    osl::File::copy(url, url + ".hong-" + stamp);
+    bool restored = false;
+    try {
+        restored = comphelper::BackupFileHelper().tryPopRegistryModifications();
+    } catch (css::uno::Exception &) {
+        TOOLS_WARN_EXCEPTION("configmgr", "restoring registrymodifications.xcu");
+    }
+    SAL_WARN(
+        "configmgr",
+        "damaged " << url << (restored ? " restored from user/pack" : " reset to defaults"));
+    comphelper::hst::writeFileAtomically(
+        url + ".hst-repaired", restored ? "restored\n"_ostr : "reset\n"_ostr);
+    return restored;
+}
