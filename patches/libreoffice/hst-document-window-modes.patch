+        if (rKind == u"calc")
+            return officecfg::Office::Common::Misc::DocumentTabsCalc::get();
+        if (rKind == u"impress")
+            return officecfg::Office::Common::Misc::DocumentTabsImpress::get();
+        if (rKind == u"draw")
+            return officecfg::Office::Common::Misc::DocumentTabsDraw::get();
+        if (rKind == u"pdf")
+            return officecfg::Office::Common::Misc::DocumentTabsPdf::get();
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("fwk", "DocumentTabGroup: window mode option");
