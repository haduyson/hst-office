+void DocumentTabGroup::splitSeparateWindows()
+{
+    // Every tab but the shown one of a window of an application set to separate windows moves into
+    // a window of its own, cascaded from that window (a window in full screen keeps its tabs).
+    cleanUp();
+    std::vector<std::pair<uno::Reference<frame::XFrame>, std::optional<Point>>> aMoves;
+    for (const std::unique_ptr<Group>& pGroup : m_aGroups)
+    {
+        if (pGroup->aMembers.size() < 2 || !isSeparateWindow(*pGroup) || groupIsFullScreen(*pGroup))
+            continue;
+        Member* pShown = activeMember(*pGroup);
+        const std::vector<sal_Int32> aState = lcl_windowState(
+            pShown ? pShown->pWindow : pGroup->aMembers.front().pWindow, vcl::WindowDataMask::PosSize);
+        sal_Int32 nStep = 0;
+        for (const Member& rMember : pGroup->aMembers)
+        {
+            if (&rMember == pShown)
+                continue;
+            ++nStep;
+            std::optional<Point> aTopLeft;
+            if (aState.size() >= 2)
+                aTopLeft = Point(aState[0] + 30 * nStep, aState[1] + 30 * nStep);
+            aMoves.emplace_back(lcl_get(rMember.xFrame), aTopLeft);
+        }
+    }
+    for (const auto& [xFrame, aTopLeft] : aMoves)
+        if (xFrame.is())
+            detach(xFrame, aTopLeft); // the last tab of a window stays (canDetach)
+}
+
+void DocumentTabGroup::mergeTabWindows()
+{
+    // The windows of an application set to tabs become one window: the one the user works in when
+    // it is such a window, else the one used last. The other windows' documents become hidden tabs
+    // there. HST Office windows, windows in full screen and a Start Center standing alone in a
+    // window of the module stay as they are.
+    cleanUp();
+    uno::Reference<frame::XFrame> xActive;
+    try
+    {
+        xActive = frame::Desktop::create(comphelper::getProcessComponentContext())->getActiveFrame();
+    }
+    catch (const uno::Exception&)
+    {
+    }
+    const auto lcl_mergeable = [](const Group& rGroup) {
+        if (rGroup.aKind == OFFICE_KIND || groupIsFullScreen(rGroup) || !moduleUsesTabs(rGroup.aKind))
+            return false;
+        for (const Member& rMember : rGroup.aMembers)
+            if (lcl_moduleKey(lcl_get(rMember.xFrame)) == START_MODULE)
+                return false;
+        return true;
+    };
+    std::vector<OUString> aKinds;
+    for (const std::unique_ptr<Group>& pGroup : m_aGroups)
+        if (lcl_mergeable(*pGroup) && std::find(aKinds.begin(), aKinds.end(), pGroup->aKind) == aKinds.end())
+            aKinds.push_back(pGroup->aKind);
+    for (const OUString& rKind : aKinds)
+    {
+        Group* pTarget = nullptr;
+        if (Group* pContext = nullptr; find(xActive, &pContext) && pContext->aKind == rKind
+                                       && lcl_mergeable(*pContext))
+            pTarget = pContext;
+        std::vector<sal_uInt32> aSources;
+        for (const std::unique_ptr<Group>& pGroup : m_aGroups)
+            if (pGroup->aKind == rKind && lcl_mergeable(*pGroup) && pGroup.get() != pTarget)
+                aSources.push_back(pGroup->nId);
+        if (!pTarget)
+        {
+            // the window used last
+            for (sal_uInt32 nId : aSources)
+                if (Group* pGroup = groupById(nId); !pTarget || pGroup->nUsed > pTarget->nUsed)
+                    pTarget = pGroup;
+            std::erase(aSources, pTarget ? pTarget->nId : 0);
+        }
+        if (!pTarget || aSources.empty())
+            continue;
+        const sal_uInt32 nTarget = pTarget->nId;
+        for (sal_uInt32 nId : aSources)
+        {
+            Group* pSource = groupById(nId);
+            if (!pSource)
+                continue;
+            std::vector<Member> aMembers;
+            aMembers.swap(pSource->aMembers);
+            pSource->xActive.clear();
+            for (const Member& rMember : aMembers)
+            {
+                Group* pGroup = groupById(nTarget);
+                if (!pGroup)
+                    break;
+                if (rMember.pWindow && !rMember.pWindow->isDisposed())
+                    hst_vcl_set_tab_group(rMember.pWindow, nTarget);
+                pGroup->aMembers.push_back(rMember);
+                // hidden, not closed: the document and its unsaved changes stay as they are; parked
+                // once it is a member of the target, so XFrameImpl::windowHidden finds it parked
+                if (Member* pMoved = find(lcl_get(rMember.xFrame)); pMoved && !pMoved->bParked)
+                    park(*pMoved);
+            }
+        }
+        cleanUp(); // the emptied windows
+        if (Group* pGroup = groupById(nTarget))
+            update(*pGroup);
+    }
+}
