+        return;
+    try
+    {
+        const uno::Reference<frame::XFrame> xActive
+            = frame::Desktop::create(comphelper::getProcessComponentContext())->getActiveFrame();
+        splitSeparateWindows();
+        mergeTabWindows();
+        // The document the user worked in stays in front (it may have become a hidden tab).
+        if (Member* pMember = find(xActive); pMember && pMember->pWindow && !pMember->pWindow->isDisposed())
+        {
+            if (pMember->bParked)
+                activate(xActive);
+            else
