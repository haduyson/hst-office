+void OfaMiscTabPage::UpdateWindowModesSensitivity()
+{
+    // The window modes only matter while documents open as tabs.
+    const bool bTabs = m_xDocumentTabsCB->get_active();
+    m_xWindowModesGrid->set_sensitive(bTabs);
+    for (const WindowModeRow& rRow : m_aWindowModes)
+    {
+        rRow.xTabs->set_sensitive(bTabs && !rRow.bReadOnly);
+        rRow.xWindows->set_sensitive(bTabs && !rRow.bReadOnly);
+    }
+    m_xApplyOpenWindowsCB->set_sensitive(bTabs);
+}
