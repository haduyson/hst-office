+                            bBorder ? fTop > 0.97 && fLeft > 0.97 : fTop < 0.03 && fLeft < 0.03);
+                    }
+                    bool bBlend = false;
+                    for (tools::Long y = 0; y < std::min(nCorner, nH / 2); ++y)
+                        for (tools::Long x = 0; x < std::min(nCorner, nW / 2); ++x)
+                        {
+                            const double fC = cover(bMirror, x, y);
+                            bBlend |= fC > 0.1 && fC < 0.9;
+                            if (pixelIs(true, x, y, 0, 0, nW, nH, fRad)
+                                && pixelIs(false, x, y, nRing, nRing, nW - nRing, nH - nRing,
+                                           std::max(0.0, fRad - nRing)))
+                                CPPUNIT_ASSERT_MESSAGE(
+                                    OString(aSide + "ring pixel " + OString::number(x) + ","
+                                            + OString::number(y) + " pale: " + OString::number(fC))
+                                        .getStr(),
+                                    fC > 0.95);
+                        }
+                    CPPUNIT_ASSERT_MESSAGE(OString(aSide + "arc not anti-aliased").getStr(), bBlend);
+                }
+                // over another colour: nothing outside the outline, the fill inside the border
+                const Color aBack = bDark ? Color(0x40, 0x10, 0x40) : Color(0xF0, 0xD0, 0xF0);
+                ScopedVclPtr<VirtualDevice> pOut = render(aBack);
+                for (bool bMirror : { false, true })
+                    for (tools::Long y = 0; y < std::min(nCorner + nRing, nH / 2); ++y)
+                        for (tools::Long x = 0; x < std::min(nCorner + nRing, nW / 2); ++x)
+                        {
+                            const Point aPt = bMirror ? Point(nW - 1 - x, nH - 1 - y) : Point(x, y);
+                            if (pixelIs(false, x, y, 0, 0, nW, nH, fRad))
+                                assertPixel(OString(aWhat + "outside the outline").getStr(), *pOut,
+                                            aPt.X(), aPt.Y(), aBack);
+                            else if (rCase.aFill != COL_TRANSPARENT
+                                     && pixelIs(true, x, y, nRing, nRing, nW - nRing, nH - nRing,
+                                                std::max(0.0, fRad - nRing))
+                                     && x >= nRing + 1 && y >= nRing + 1)
+                                assertPixel(OString(aWhat + "inside the border").getStr(), *pOut,
+                                            aPt.X(), aPt.Y(), rCase.aFill);
+                        }
+            }
+        }
+}
+
+/* The dialogs' CSS comes first, then each frame part's fragment in a fixed order, each named by a
+   comment; a part switched off leaves its fragment out. */
+CPPUNIT_TEST_FIXTURE(CoatTest, testCssFragmentsAreConcatenatedInOrder)
+{
+    const char* const aNames[] = { "ribbon", "backstage", "sidebar", "statusbar", "menus", "doctabs" };
+    auto marker = [](const char* pName) { return OString(OString::Concat("/* hst frame: ") + pName + " */\n"); };
+    const OString aCss = hst::coat::CreateGtkCss(false);
+    sal_Int32 nLast = aCss.indexOf("scrollbar slider:active");
+    CPPUNIT_ASSERT(nLast >= 0);
+    for (const char* pName : aNames)
+    {
+        const sal_Int32 nAt = aCss.indexOf(marker(pName));
+        CPPUNIT_ASSERT_MESSAGE(pName, nAt > nLast);
+        nLast = nAt;
+    }
+    setFrameSwitch(hst::coat::FrameComponent::Sidebar, false);
+    const OString aWithout = hst::coat::CreateGtkCss(false);
+    CPPUNIT_ASSERT(aWithout.indexOf(marker("sidebar")) < 0);
+    for (const char* pName : { "ribbon", "backstage", "statusbar", "menus", "doctabs" })
+        CPPUNIT_ASSERT_MESSAGE(pName, aWithout.indexOf(marker(pName)) >= 0);
+}
+
+/* Each frame part has its own switch under the coat's: off alone, off with the coat, off in high
+   contrast. */
+CPPUNIT_TEST_FIXTURE(CoatTest, testFrameCoatSwitches)
+{
+    using hst::coat::FrameCoatActive;
+    using hst::coat::FrameCoatEnabled;
+    ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(4, 4));
+    ScopedVclPtr<VirtualDevice> pHighContrast = makeDevice(Size(4, 4), false, true);
+    for (auto eComponent : ALL_PARTS)
+    {
+        CPPUNIT_ASSERT(FrameCoatEnabled(eComponent));
+        CPPUNIT_ASSERT(FrameCoatActive(eComponent, pDev->GetSettings().GetStyleSettings()));
+        CPPUNIT_ASSERT(!FrameCoatActive(eComponent, pHighContrast->GetSettings().GetStyleSettings()));
+    }
+    for (auto eOff : ALL_PARTS)
+    {
+        setFrameSwitch(eOff, false);
+        for (auto eComponent : ALL_PARTS)
+            CPPUNIT_ASSERT_EQUAL(eComponent != eOff, FrameCoatEnabled(eComponent));
+        setFrameSwitch(eOff, true);
+    }
+    // the coat's own switch turns every part off
+    setSwitch(false);
+    for (auto eComponent : ALL_PARTS)
+        CPPUNIT_ASSERT(!FrameCoatEnabled(eComponent));
+    setSwitch(true);
+    setenv("HST_UI_COAT", "0", 1);
+    hst::coat::ResetSwitchForTesting();
+    for (auto eComponent : ALL_PARTS)
+        CPPUNIT_ASSERT(!FrameCoatEnabled(eComponent));
+    unsetenv("HST_UI_COAT");
+    hst::coat::ResetSwitchForTesting();
+    CPPUNIT_ASSERT(FrameCoatEnabled(hst::coat::FrameComponent::Ribbon));
+}
 }
 
