+/* The frame's tokens: every divider, border and selection mark reaches 3:1 against each surface it
+   sits on (WCAG 1.4.11), a menu's shortcut text 4.5:1, light and dark. */
+CPPUNIT_TEST_FIXTURE(CoatTest, testFramePaletteContrast)
+{
+    for (bool bDark : { false, true })
+    {
+        const auto& p = hst::design::GetPalette(bDark);
+        const OString aTheme(bDark ? "dark " : "light ");
+        auto require = [&](const char* pWhat, const Color& rFore, const Color& rBack, double fMin) {
+            const double fRatio = contrast(rFore, rBack);
+            CPPUNIT_ASSERT_MESSAGE(OString(aTheme + pWhat + " " + rFore.AsRGBHexString().toUtf8()
+                                           + " on " + rBack.AsRGBHexString().toUtf8() + ": "
+                                           + OString::number(fRatio))
+                                       .getStr(),
+                                   fRatio >= fMin);
+        };
+        for (const Color& rSurface : { p.aFrameSurface, p.aFrameSurfaceRaised })
+        {
+            require("frame divider", p.aFrameDivider, rSurface, 3.0);
+            require("selected indicator", p.aSelectedIndicator, rSurface, 3.0);
+            require("text", p.aText, rSurface, 4.5);
+        }
+        // a menu over the frame or over a document page
+        for (const Color& rUnder : { p.aMenuSurface, p.aFrameSurface })
+            require("menu border", p.aMenuBorder, rUnder, 3.0);
+        for (const Color& rItem : { p.aMenuSurface, p.aMenuHover })
+        {
+            require("menu shortcut", p.aMenuShortcut, rItem, 4.5);
+            require("menu text", p.aText, rItem, 4.5);
+            require("selected indicator", p.aSelectedIndicator, rItem, 3.0);
+        }
+        CPPUNIT_ASSERT_EQUAL(p.aAccent, p.aSelectedIndicator);
+        // the raised part and the hover stand apart from what they sit on
+        CPPUNIT_ASSERT(p.aFrameSurfaceRaised != p.aFrameSurface);
+        CPPUNIT_ASSERT(p.aMenuHover != p.aMenuSurface);
+    }
+    namespace d = hst::design;
+    CPPUNIT_ASSERT_EQUAL(1.0, d::size::FrameDivider);
+    CPPUNIT_ASSERT_EQUAL(28.0, d::size::MenuItemHeight);
+    CPPUNIT_ASSERT_EQUAL(24.0, d::size::StatusBarHeight);
+    CPPUNIT_ASSERT_EQUAL(30.0, d::size::DocTabHeight);
+    CPPUNIT_ASSERT_EQUAL(8.0, d::radius::Menu);
+    CPPUNIT_ASSERT_EQUAL(4.0, d::radius::MenuItem);
+    // the dialogs' layout (owner decision: 6 px between rows, never less than 4 px)
+    CPPUNIT_ASSERT_EQUAL(6.0, d::layout::RowGap);
+    CPPUNIT_ASSERT_EQUAL(4.0, d::layout::MinGap);
+    CPPUNIT_ASSERT_EQUAL(4.0, d::layout::ButtonGap);
+    CPPUNIT_ASSERT(d::layout::MinGap <= d::layout::RowGap && d::layout::RowGap <= d::layout::GroupGap);
+}
