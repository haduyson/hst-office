+#pragma once
+
+#include <vcl/dllapi.h>
+
+class StyleSettings;
+
+/* The coat of a document window's frame: the ribbon, the File tab (backstage), the sidebar, the status
+   bar, the menus and the document tabs drawn in the HST look. Each part has its own switch,
+   org.openoffice.Office.HSTAppearance/FrameCoat/<Part> (default on), under the coat's own switch
+   (UiCoat/Enabled, or HST_UI_COAT=0/1): turning the coat off turns every part off. High contrast
+   always uses the platform's look. */
+namespace hst::coat
+{
+/** The parts of the frame, in the order their GTK CSS follows the dialogs' CSS. */
+enum class FrameComponent
+{
+    Ribbon,
+    Backstage,
+    Sidebar,
+    StatusBar,
+    Menus,
+    DocumentTabs,
+};
+
+/** Whether the coat of eComponent is switched on: the coat's switch and the part's own. Both are
+    read once per process. */
+VCL_DLLPUBLIC bool FrameCoatEnabled(FrameComponent eComponent);
+
+/** Whether eComponent is drawn in the HST look with these style settings: switched on and not in
+    high-contrast mode. */
+VCL_DLLPUBLIC bool FrameCoatActive(FrameComponent eComponent, const StyleSettings& rStyle);
+}
