+/** rOuter shrunk by fBy on every side, its corners concentric with rOuter's (radius fRadius). */
+basegfx::B2DPolygon insetRect(const basegfx::B2DRange& rOuter, double fRadius, double fBy)
+{
+    const basegfx::B2DRange aInner(rOuter.getMinX() + fBy, rOuter.getMinY() + fBy,
+                                   rOuter.getMaxX() - fBy, rOuter.getMaxY() - fBy);
