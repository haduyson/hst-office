+
+/** rShape moved back by the pixel-origin shift of rDev's backend (see PixelOriginShift). */
+basegfx::B2DPolyPolygon onPixelEdges(const OutputDevice& rDev, const basegfx::B2DPolyPolygon& rShape)
+{
+    const SalGraphics* pGraphics = rDev.GetGraphics();
+    if (!pGraphics)
+        return rShape;
+    const double fShift
+        = PixelOriginShift(pGraphics->getRenderBackendName(), rShape.areControlPointsUsed());
+    if (fShift == 0.0)
+        return rShape;
+    basegfx::B2DPolyPolygon aShape(rShape);
+    aShape.transform(basegfx::utils::createTranslateB2DHomMatrix(-fShift, -fShift));
+    return aShape;
+}
+
+/** FillPixelShape without saving the device's colours and anti-aliasing (the caller has). */
+void fillOnPixelEdges(OutputDevice& rDev, const basegfx::B2DPolyPolygon& rShape, const Color& rFill)
+{
+    rDev.SetLineColor();
+    rDev.SetFillColor(rFill);
+    rDev.DrawPolyPolygon(onPixelEdges(rDev, rShape));
+}
+}
+
+double PixelOriginShift(std::u16string_view aBackend, bool bCurved)
+{
+    // Skia takes the coordinates of a polygon with curves as pixel centres and moves it by half a
+    // pixel (an anti-aliased polygon of straight edges only it leaves on the edges); GDI+ puts every
+    // pixel centre on whole coordinates; Cairo (svp, gtk3, gen) and Quartz fill on pixel edges.
+    if (aBackend == u"skia")
+        return bCurved ? 0.5 : 0.0;
+    if (aBackend == u"gdi")
+        return 0.5;
+    return 0.0;
+}
+
+void FillPixelShape(OutputDevice& rDev, const basegfx::B2DPolyPolygon& rShape, const Color& rFill)
+{
+    if (rFill == COL_TRANSPARENT || !rShape.count())
+        return;
+    auto aPop = rDev.ScopedPush(vcl::PushFlags::LINECOLOR | vcl::PushFlags::FILLCOLOR);
+    ScopedAntialiasing aAntialiasing(rDev);
+    fillOnPixelEdges(rDev, rShape, rFill);
 }
 
