+/* The switches of the frame's coat (<vcl/hst/framecoat.hxx>). */
+
+#include <vcl/hst/framecoat.hxx>
+#include <hst/coat.hxx>
+
+#include <officecfg/Office/HSTAppearance.hxx>
+#include <sal/log.hxx>
+#include <vcl/settings.hxx>
+
+#include <array>
+#include <atomic>
+
+namespace hst::coat
+{
+namespace
+{
+constexpr std::size_t COMPONENTS = std::size_t(FrameComponent::DocumentTabs) + 1;
+
+// per part, 0: not read yet, 1: off, 2: on
+std::array<std::atomic<int>, COMPONENTS> g_aSwitch{};
+
+bool readSwitch(FrameComponent eComponent)
+{
+    using F = officecfg::Office::HSTAppearance::FrameCoat; // a group: a struct, not a namespace
+    try
+    {
+        switch (eComponent)
+        {
+            case FrameComponent::Ribbon:
+                return F::Ribbon::get();
+            case FrameComponent::Backstage:
+                return F::Backstage::get();
+            case FrameComponent::Sidebar:
+                return F::Sidebar::get();
+            case FrameComponent::StatusBar:
+                return F::StatusBar::get();
+            case FrameComponent::Menus:
+                return F::Menus::get();
+            case FrameComponent::DocumentTabs:
+                return F::DocumentTabs::get();
+        }
+    }
+    catch (const css::uno::Exception&)
+    {
+        // no configuration (e.g. very early in start-up): the shipped default
+        SAL_WARN("vcl.hst", "coat: a FrameCoat setting could not be read, using on");
+    }
+    return true;
+}
+}
+
+bool FrameCoatEnabled(FrameComponent eComponent)
+{
+    if (!IsSwitchedOn())
+        return false;
+    std::atomic<int>& rSwitch = g_aSwitch[std::size_t(eComponent)];
+    int nSwitch = rSwitch.load(std::memory_order_relaxed);
+    if (nSwitch == 0)
+    {
+        nSwitch = readSwitch(eComponent) ? 2 : 1;
+        rSwitch.store(nSwitch, std::memory_order_relaxed);
+    }
+    return nSwitch == 2;
+}
+
+bool FrameCoatActive(FrameComponent eComponent, const StyleSettings& rStyle)
+{
+    return !rStyle.GetHighContrastMode() && FrameCoatEnabled(eComponent);
+}
+
+void ResetFrameCoatForTesting()
+{
+    for (std::atomic<int>& rSwitch : g_aSwitch)
+        rSwitch.store(0, std::memory_order_relaxed);
+}
+}
