+
+// HST: members of TextBox and Label that forms in real files set
+
+#include <com/sun/star/awt/Selection.hpp>
+#include <com/sun/star/awt/XTextComponent.hpp>
+
+#include "vbalabel.hxx"
+#include "vbatextbox.hxx"
+
+using namespace ::ooo::vba;
+using namespace css;
+
+namespace
+{
+const sal_Int32 fmScrollBarsHorizontal = 1, fmScrollBarsVertical = 2;
+
+// Windows-style values to those of the toolkit model
+sal_Int32 lcl_textAlign(const uno::Reference<beans::XPropertySet>& xProps)
+{
+    sal_Int16 nAlign = 0;
+    xProps->getPropertyValue(u"Align"_ustr) >>= nAlign;
+    return nAlign + 1; // fmTextAlignLeft is 1, Center 2, Right 3
+}
+
+void lcl_setTextAlign(const uno::Reference<beans::XPropertySet>& xProps, sal_Int32 nAlign)
+{
+    xProps->setPropertyValue(u"Align"_ustr, uno::Any(static_cast<sal_Int16>(nAlign - 1)));
+}
+
+void lcl_setColor(const uno::Reference<beans::XPropertySet>& xProps, sal_Int32 nColor)
+{
+    xProps->setPropertyValue(u"TextColor"_ustr, uno::Any(OORGBToXLRGB(nColor)));
+}
+}
+
+sal_Int32 SAL_CALL ScVbaTextBox::getForeColor() { return ScVbaControl::getForeColor(); }
+void SAL_CALL ScVbaTextBox::setForeColor(sal_Int32 nColor) { lcl_setColor(m_xProps, nColor); }
+
+OUString SAL_CALL ScVbaTextBox::getPasswordChar()
+{
+    sal_Int16 nChar = 0;
+    m_xProps->getPropertyValue(u"EchoChar"_ustr) >>= nChar;
+    return nChar ? OUString(static_cast<sal_Unicode>(nChar)) : OUString();
+}
+
+void SAL_CALL ScVbaTextBox::setPasswordChar(const OUString& rChar)
+{
+    m_xProps->setPropertyValue(u"EchoChar"_ustr, uno::Any(static_cast<sal_Int16>(rChar.isEmpty() ? 0 : rChar[0])));
+}
+
+sal_Int32 SAL_CALL ScVbaTextBox::getSelStart()
+{
+    uno::Reference<awt::XTextComponent> xText(m_xControl, uno::UNO_QUERY_THROW);
+    return xText->getSelection().Min;
+}
+
+void SAL_CALL ScVbaTextBox::setSelStart(sal_Int32 nStart)
+{
+    uno::Reference<awt::XTextComponent> xText(m_xControl, uno::UNO_QUERY_THROW);
+    const awt::Selection aOld = xText->getSelection();
+    xText->setSelection(awt::Selection(nStart, nStart + aOld.Max - aOld.Min));
+}
+
+sal_Int32 SAL_CALL ScVbaTextBox::getSelLength()
+{
+    uno::Reference<awt::XTextComponent> xText(m_xControl, uno::UNO_QUERY_THROW);
+    const awt::Selection aOld = xText->getSelection();
+    return aOld.Max - aOld.Min;
+}
+
+void SAL_CALL ScVbaTextBox::setSelLength(sal_Int32 nLength)
+{
+    uno::Reference<awt::XTextComponent> xText(m_xControl, uno::UNO_QUERY_THROW);
+    const awt::Selection aOld = xText->getSelection();
+    xText->setSelection(awt::Selection(aOld.Min, aOld.Min + nLength));
+}
+
+OUString SAL_CALL ScVbaTextBox::getSelText()
+{
+    return uno::Reference<awt::XTextComponent>(m_xControl, uno::UNO_QUERY_THROW)->getSelectedText();
+}
+
+void SAL_CALL ScVbaTextBox::setSelText(const OUString& rText)
+{
+    uno::Reference<awt::XTextComponent> xText(m_xControl, uno::UNO_QUERY_THROW);
+    xText->insertText(xText->getSelection(), rText);
+}
+
+sal_Int32 SAL_CALL ScVbaTextBox::getScrollBars()
+{
+    bool bHorizontal = false, bVertical = false;
+    m_xProps->getPropertyValue(u"HScroll"_ustr) >>= bHorizontal;
+    m_xProps->getPropertyValue(u"VScroll"_ustr) >>= bVertical;
+    return (bHorizontal ? fmScrollBarsHorizontal : 0) | (bVertical ? fmScrollBarsVertical : 0);
+}
+
+void SAL_CALL ScVbaTextBox::setScrollBars(sal_Int32 nBars)
+{
+    m_xProps->setPropertyValue(u"HScroll"_ustr, uno::Any((nBars & fmScrollBarsHorizontal) != 0));
+    m_xProps->setPropertyValue(u"VScroll"_ustr, uno::Any((nBars & fmScrollBarsVertical) != 0));
+}
+
+sal_Bool SAL_CALL ScVbaTextBox::getWordWrap()
+{
+    bool bHard = false;
+    m_xProps->getPropertyValue(u"HardLineBreaks"_ustr) >>= bHard;
+    return !bHard;
+}
+
+void SAL_CALL ScVbaTextBox::setWordWrap(sal_Bool bWrap) { m_xProps->setPropertyValue(u"HardLineBreaks"_ustr, uno::Any(!bWrap)); }
+
+sal_Int32 SAL_CALL ScVbaTextBox::getTextAlign() { return lcl_textAlign(m_xProps); }
+void SAL_CALL ScVbaTextBox::setTextAlign(sal_Int32 nAlign) { lcl_setTextAlign(m_xProps, nAlign); }
+
+sal_Int32 SAL_CALL ScVbaLabel::getForeColor() { return ScVbaControl::getForeColor(); }
+void SAL_CALL ScVbaLabel::setForeColor(sal_Int32 nColor) { lcl_setColor(m_xProps, nColor); }
+
+sal_Bool SAL_CALL ScVbaLabel::getWordWrap()
+{
+    bool bWrap = false;
+    m_xProps->getPropertyValue(u"MultiLine"_ustr) >>= bWrap;
+    return bWrap;
+}
+
+void SAL_CALL ScVbaLabel::setWordWrap(sal_Bool bWrap) { m_xProps->setPropertyValue(u"MultiLine"_ustr, uno::Any(static_cast<bool>(bWrap))); }
+
+sal_Int32 SAL_CALL ScVbaLabel::getTextAlign() { return lcl_textAlign(m_xProps); }
+void SAL_CALL ScVbaLabel::setTextAlign(sal_Int32 nAlign) { lcl_setTextAlign(m_xProps, nAlign); }
+
+sal_Int32 SAL_CALL ScVbaLabel::getBackStyle()
+{
+    sal_Int32 nColor = -1;
+    m_xProps->getPropertyValue(u"BackgroundColor"_ustr) >>= nColor;
+    return nColor == -1 ? 0 : 1; // fmBackStyleTransparent, fmBackStyleOpaque
+}
+
+void SAL_CALL ScVbaLabel::setBackStyle(sal_Int32 nStyle)
+{
+    if (nStyle == 0)
+        m_xProps->setPropertyValue(u"BackgroundColor"_ustr, uno::Any());
+}
+
