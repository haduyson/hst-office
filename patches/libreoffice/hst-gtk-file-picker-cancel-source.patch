---
diff --git a/vcl/unx/gtk3/fpicker/SalGtkPicker.cxx b/vcl/unx/gtk3/fpicker/SalGtkPicker.cxx
index 5fc4399..d324233 100644
--- a/vcl/unx/gtk3/fpicker/SalGtkPicker.cxx
+++ b/vcl/unx/gtk3/fpicker/SalGtkPicker.cxx
@@ -82,11 +82,39 @@ extern "C"
     static gboolean canceldialog(RunDialog *pDialog)
     {
         SolarMutexGuard g;
-        pDialog->cancel();
+        pDialog->cancelFromIdle();
         return false;
     }
 }
 
+// At most one cancel source is pending per RunDialog and its id is kept, so it can be removed
+// when the dialog stops running. g_source_remove_by_user_data() removes only one of several
+// sources with the same data: when two windows opened in a row (a document loading while the
+// picker is up), the second source outlived the RunDialog and canceldialog then cast a freed
+// dialog pointer (SIGSEGV in g_type_check_instance_cast).
+void RunDialog::queueCancel()
+{
+    if (!mnCancelSource)
+        mnCancelSource = g_timeout_add_full(G_PRIORITY_HIGH_IDLE, 0,
+                                            reinterpret_cast<GSourceFunc>(canceldialog), this, nullptr);
+}
+
+void RunDialog::removeQueuedCancel()
+{
+    if (mnCancelSource)
+    {
+        g_source_remove(mnCancelSource);
+        mnCancelSource = 0;
+    }
+}
+
+void RunDialog::cancelFromIdle()
+{
+    mnCancelSource = 0; // the source is being dispatched and removes itself by returning false
+    if (mbRunning)
+        cancel();
+}
+
 GtkWindow* RunDialog::GetTransientFor()
 {
     vcl::Window * pWindow = ::Application::GetActiveTopWindow();
@@ -103,6 +131,8 @@ RunDialog::RunDialog(GtkWidget *pDialog, uno::Reference<awt::XExtendedToolkit> x
     : cppu::WeakComponentImplHelper<awt::XTopWindowListener, frame::XTerminateListener>(maLock)
     , mpDialog(pDialog)
     , mbTerminateDesktop(false)
+    , mbRunning(false)
+    , mnCancelSource(0)
     , mxToolkit(std::move(xToolkit))
     , mxDesktop(std::move(xDesktop))
 {
@@ -112,7 +142,7 @@ RunDialog::~RunDialog()
 {
     SolarMutexGuard g;
 
-    g_source_remove_by_user_data (this);
+    removeQueuedCancel();
 }
 
 void SAL_CALL RunDialog::windowOpened(const css::lang::EventObject& e)
@@ -131,14 +161,14 @@ void SAL_CALL RunDialog::windowOpened(const css::lang::EventObject& e)
             return;
     }
 
-    g_timeout_add_full(G_PRIORITY_HIGH_IDLE, 0, reinterpret_cast<GSourceFunc>(canceldialog), this, nullptr);
+    queueCancel();
 }
 
 void SAL_CALL RunDialog::queryTermination( const css::lang::EventObject& )
 {
     SolarMutexGuard g;
 
-    g_timeout_add_full(G_PRIORITY_HIGH_IDLE, 0, reinterpret_cast<GSourceFunc>(canceldialog), this, nullptr);
+    queueCancel();
 
     mbTerminateDesktop = true;
 
@@ -190,7 +220,11 @@ gint RunDialog::run()
         xFrameWindow->ImplGetFrame()->NotifyModalHierarchy(true);
     }
 
+    mbRunning = true;
     gint nStatus = gtk_dialog_run(GTK_DIALOG(mpDialog));
+    mbRunning = false;
+    // a cancel queued for this run must not fire later, on a dialog that may be gone by then
+    removeQueuedCancel();
 
     if (xFrameWindow)
     {
diff --git a/vcl/unx/gtk3/fpicker/SalGtkPicker.hxx b/vcl/unx/gtk3/fpicker/SalGtkPicker.hxx
index cb11445..e2ddc43 100644
--- a/vcl/unx/gtk3/fpicker/SalGtkPicker.hxx
+++ b/vcl/unx/gtk3/fpicker/SalGtkPicker.hxx
@@ -92,6 +92,8 @@ private:
     osl::Mutex maLock;
     GtkWidget *mpDialog;
     bool mbTerminateDesktop;
+    bool mbRunning;
+    guint mnCancelSource;
     css::uno::Reference<css::awt::XExtendedToolkit> mxToolkit;
     css::uno::Reference<css::frame::XDesktop> mxDesktop;
     DECL_STATIC_LINK(RunDialog, TerminateDesktop, void*, void);
@@ -118,6 +120,9 @@ public:
     virtual ~RunDialog() override;
     gint run();
     void cancel();
+    void queueCancel();
+    void removeQueuedCancel();
+    void cancelFromIdle();
     static GtkWindow* GetTransientFor();
 };
 
