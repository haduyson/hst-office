+CPPUNIT_TEST_FIXTURE(SdImportTest, testPptx2024Slideshow)
+{
+    // The synthetic deck is stored in base64, because patch files carry no binary data.
+    SvFileStream aBase64File(createFileURL(u"pptx/hst-pptx-2024-slideshow.pptx.b64"), StreamMode::READ);
+    OStringBuffer aBase64;
+    OString aLine;
+    while (aBase64File.ReadLine(aLine))
+        aBase64.append(aLine);
+    uno::Sequence<sal_Int8> aBytes;
+    comphelper::Base64::decode(aBytes, OStringToOUString(aBase64, RTL_TEXTENCODING_ASCII_US));
+    CPPUNIT_ASSERT(aBytes.hasElements());
+    utl::TempFileNamed aDeck(u"hst-pptx-2024", true, u".pptx");
+    aDeck.EnableKillingFile();
+    aDeck.GetStream(StreamMode::WRITE)->WriteBytes(aBytes.getConstArray(), aBytes.getLength());
+    aDeck.CloseStream();
+    loadFromURL(aDeck.GetURL());
+
+    auto pageProperty = [this](int nPage, const OUString& rName) {
+        uno::Reference<beans::XPropertySet> xPage(getPage(nPage), uno::UNO_QUERY_THROW);
+        return xPage->getPropertyValue(rName);
+    };
+    // Slide 1: a p15 preset without counterpart (origami). Without the fix it had no transition at all;
+    // its fallback, like that of every such preset, is a fade.
+    CPPUNIT_ASSERT_EQUAL(animations::TransitionType::FADE,
+                         pageProperty(0, u"TransitionType"_ustr).get<sal_Int16>());
+    CPPUNIT_ASSERT_EQUAL(animations::TransitionSubType::CROSSFADE,
+                         pageProperty(0, u"TransitionSubtype"_ustr).get<sal_Int16>());
+    // Slide 2: morph falls back to a fade.
+    CPPUNIT_ASSERT_EQUAL(animations::TransitionType::FADE,
+                         pageProperty(1, u"TransitionType"_ustr).get<sal_Int16>());
+    // Slide 3: a plain cut is an instant change, marked by a zero duration.
+    CPPUNIT_ASSERT_EQUAL(sal_Int16(0), pageProperty(2, u"TransitionType"_ustr).get<sal_Int16>());
+    CPPUNIT_ASSERT_EQUAL(0.0, pageProperty(2, u"TransitionDuration"_ustr).get<double>());
+    // Slide 4: advances after 3 s without an effect.
+    CPPUNIT_ASSERT_EQUAL(sal_Int16(0), pageProperty(3, u"TransitionType"_ustr).get<sal_Int16>());
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(1), pageProperty(3, u"Change"_ustr).get<sal_Int32>());
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(3), pageProperty(3, u"Duration"_ustr).get<sal_Int32>());
+
+    // Slide 5: the sound object repeats indefinitely; without the fix it played once in the slide show.
+    uno::Reference<beans::XPropertySet> xSound(getShapeFromPage(1, 4));
+    CPPUNIT_ASSERT(xSound->getPropertySetInfo()->hasPropertyByName(u"MediaURL"_ustr));
+    CPPUNIT_ASSERT(xSound->getPropertyValue(u"Loop"_ustr).get<bool>());
+
+    // Slide 6: the fallback picture of a slide zoom jumps to slide 4 on click.
+    uno::Reference<document::XEventsSupplier> xZoom(getShapeFromPage(1, 5), uno::UNO_QUERY_THROW);
+    uno::Sequence<beans::PropertyValue> aClick;
+    xZoom->getEvents()->getByName(u"OnClick"_ustr) >>= aClick;
+    comphelper::SequenceAsHashMap aClickMap(aClick);
+    CPPUNIT_ASSERT_EQUAL(presentation::ClickAction_BOOKMARK,
+                         aClickMap[u"ClickAction"_ustr].get<presentation::ClickAction>());
+    CPPUNIT_ASSERT_EQUAL(u"page4"_ustr, aClickMap[u"Bookmark"_ustr].get<OUString>());
+
+    // Export: the cut is written back, the advance timing is written without a duration.
+    save(TestFilter::PPTX);
+    xmlDocUniquePtr pSlide3 = parseExport(u"ppt/slides/slide3.xml"_ustr);
+    assertXPath(pSlide3, "/p:sld/p:transition/p:cut", 1);
+    xmlDocUniquePtr pSlide4 = parseExport(u"ppt/slides/slide4.xml"_ustr);
+    assertXPath(pSlide4, "/p:sld/p:transition", "advTm", u"3000");
+    assertXPathNoAttribute(pSlide4, "/p:sld/p:transition", "dur");
+}
