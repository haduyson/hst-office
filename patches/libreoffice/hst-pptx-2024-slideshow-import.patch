HST Office: PPTX from the current reference presentation app keeps its transitions and looping media.

- p15:prstTrans presets without a counterpart (origami, airplane, curtains, wind, crush, ...) were imported as
  no transition, because the p15 choice is read and its fade fallback is ignored. They now fade, like their
  fallback. Morph (p159, not understood, so the fallback is read) already fades; the test covers it.
- A video or sound whose media node repeats indefinitely ("Loop until stopped") now sets the Loop property of
  its media shape, which is what the slide show uses; it played only once before.
- sd/qa: an import test on a small synthetic deck (stored in base64, generated by hand in the 2024 form):
  origami and morph fall back to fade, the plain cut and the advance-only timing import and export right, the
  looping sound loops, and the fallback picture of a slide zoom jumps to its target slide.

--- a/oox/source/ppt/slidetransition.cxx
+++ b/oox/source/ppt/slidetransition.cxx
@@ -463,7 +463,11 @@ namespace oox::ppt {
         }
         else
         {
-            mnTransitionType = 0;
+            // Other presets (origami, airplane, curtains, wind, ...) have no counterpart here. Their
+            // AlternateContent fallback is always a fade, but the p15 choice is the one read, so fade here too
+            // instead of dropping the transition.
+            mnTransitionType = TransitionType::FADE;
+            mnTransitionSubType = TransitionSubType::CROSSFADE;
         }
     }
 
--- a/oox/source/ppt/timenode.cxx
+++ b/oox/source/ppt/timenode.cxx
@@ -34,6 +34,7 @@
 #include <com/sun/star/animations/AnimationNodeType.hpp>
 #include <com/sun/star/animations/Event.hpp>
 #include <com/sun/star/animations/EventTrigger.hpp>
+#include <com/sun/star/animations/Timing.hpp>
 #include <com/sun/star/frame/XModel.hpp>
 #include <com/sun/star/io/WrongFormatException.hpp>
 #include <com/sun/star/presentation/EffectNodeType.hpp>
@@ -608,6 +609,17 @@ namespace oox::ppt {
             if (xAnimate.is() && xAnimate->getValues().getLength() != xAnimate->getKeyTimes().getLength())
                 throw css::io::WrongFormatException();
 
+            // A media node that repeats indefinitely is a looping video or sound; the slide show loops a
+            // media object only through the Loop property of its shape.
+            if (xAudio.is())
+            {
+                Timing eRepeat{};
+                Reference<XPropertySet> xMedia(xAudio->getSource(), UNO_QUERY);
+                if ((xNode->getRepeatCount() >>= eRepeat) && eRepeat == Timing_INDEFINITE && xMedia.is()
+                    && xMedia->getPropertySetInfo()->hasPropertyByName(u"Loop"_ustr))
+                    xMedia->setPropertyValue(u"Loop"_ustr, Any(true));
+            }
+
             if( mnNodeType == AnimationNodeType::TRANSITIONFILTER )
             {
 
