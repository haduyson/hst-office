+uno::Sequence< beans::PropertyValue > ModelData_Impl::GetMacroFilterInsteadOf( const OUString& rFilter )
+{
+    uno::Sequence< beans::PropertyValue > aResult;
+    const DocumentMacros aMacros = lclGetDocumentMacros( m_xModel );
+    if ( !aMacros.bAny )
+        return aResult;
+    uno::Sequence< beans::PropertyValue > aProps;
+    if ( !rFilter.isEmpty() && m_pOwner->GetFilterConfiguration()->hasByName( rFilter ) )
+        m_pOwner->GetFilterConfiguration()->getByName( rFilter ) >>= aProps;
+    const SfxFilterFlags nFlags = static_cast< SfxFilterFlags >(
+        ::comphelper::SequenceAsHashMap( aProps ).getUnpackedValueOrDefault( u"Flags"_ustr, sal_Int32( 0 ) ) );
+    if ( lclFormatKeepsMacros( aMacros, rFilter, nFlags ) )
+        return aResult;
+    const OUString aKeeping = lclMacroKeepingFilter( aMacros, GetDocServiceName() );
+    if ( !aKeeping.isEmpty() && m_pOwner->GetFilterConfiguration()->hasByName( aKeeping ) )
+        m_pOwner->GetFilterConfiguration()->getByName( aKeeping ) >>= aResult;
+    return aResult;
+}
+
+bool ModelData_Impl::ConfirmMacroFormat( const OUString& rFilter )
+{
+    if ( Application::IsHeadlessModeEnabled() || comphelper::LibreOfficeKit::isActive()
+         || GetDocProps().getUnpackedValueOrDefault( u"Hidden"_ustr, false ) )
+        return true;
+    const DocumentMacros aMacros = lclGetDocumentMacros( m_xModel );
+    if ( !aMacros.bAny || rFilter.isEmpty() || !m_pOwner->GetFilterConfiguration()->hasByName( rFilter ) )
+        return true;
+    uno::Sequence< beans::PropertyValue > aProps;
+    m_pOwner->GetFilterConfiguration()->getByName( rFilter ) >>= aProps;
+    const ::comphelper::SequenceAsHashMap aPropsHM( aProps );
+    const SfxFilterFlags nFlags = static_cast< SfxFilterFlags >(
+        aPropsHM.getUnpackedValueOrDefault( u"Flags"_ustr, sal_Int32( 0 ) ) );
+    if ( lclFormatKeepsMacros( aMacros, rFilter, nFlags ) )
+        return true;
+
+    OUString aText = SfxResId( STR_HST_MACRO_FORMAT_TEXT ).replaceAll(
+        "%FORMATNAME", aPropsHM.getUnpackedValueOrDefault( u"UIName"_ustr, rFilter ) );
+    const uno::Sequence< beans::PropertyValue > aKeeping = GetMacroFilterInsteadOf( rFilter );
+    if ( aKeeping.hasElements() )
+    {
+        aText += "\n\n" + SfxResId( STR_HST_MACRO_FORMAT_HINT ).replaceAll(
+            "%FORMATNAME", ::comphelper::SequenceAsHashMap( aKeeping ).getUnpackedValueOrDefault( u"UIName"_ustr, OUString() ) );
+    }
+    std::unique_ptr< weld::MessageDialog > xBox( Application::CreateMessageDialog(
+        SfxStoringHelper::GetModelWindow( m_xModel ), VclMessageType::Warning, VclButtonsType::NONE, aText ) );
+    xBox->set_title( SfxResId( STR_HST_MACRO_FORMAT_TITLE ) );
+    xBox->add_button( SfxResId( STR_HST_MACRO_FORMAT_LOSE ), RET_YES );
+    xBox->add_button( SfxResId( STR_HST_MACRO_FORMAT_BACK ), RET_NO );
+    xBox->set_default_response( RET_NO ); // as in Word: losing macros takes a deliberate choice
+    return xBox->run() == RET_YES;
+}
