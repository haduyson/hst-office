+namespace
+{
+/// HST: the macros of a document, as far as file formats differ in keeping them
+struct DocumentMacros
+{
+    bool bAny = false; ///< there is macro code
+    bool bBasic = false; ///< code outside the VBA project: VBA formats do not write it, only ODF does
+    bool bImportedVba = false; ///< the VBA project read from the file, which PowerPoint formats copy
+};
+
+bool lclHasMacroCode(const OUString& rCode)
+{
+    sal_Int32 nIndex = 0;
+    do
+    {
+        const OUString aLine = OUString(o3tl::getToken(rCode, 0, '\n', nIndex)).trim();
+        if (aLine.isEmpty() || aLine.startsWith("'") || aLine.equalsIgnoreAsciiCase("rem")
+            || aLine.startsWithIgnoreAsciiCase("rem ") || aLine.startsWithIgnoreAsciiCase("option ")
+            || aLine.startsWithIgnoreAsciiCase("attribute "))
+            continue;
+        return true;
+    } while (nIndex >= 0);
+    return false;
+}
+
+DocumentMacros lclGetDocumentMacros(const uno::Reference<frame::XModel>& xModel)
+{
+    DocumentMacros aMacros;
+    try
+    {
+        uno::Reference<document::XEmbeddedScripts> xScripts(xModel, uno::UNO_QUERY);
+        if (!xScripts.is())
+            return aMacros;
+        uno::Reference<script::XLibraryContainer> xLibraries(xScripts->getBasicLibraries(), uno::UNO_QUERY);
+        uno::Reference<container::XNameAccess> xNames(xLibraries, uno::UNO_QUERY);
+        if (!xNames.is())
+            return aMacros;
+        uno::Reference<script::vba::XVBACompatibility> xVba(xLibraries, uno::UNO_QUERY);
+        const OUString aProject = xVba.is() && xVba->getVBACompatibilityMode() ? xVba->getProjectName() : OUString();
+        for (const OUString& rLibrary : xNames->getElementNames())
+        {
+            if (!xLibraries->isLibraryLoaded(rLibrary))
+                xLibraries->loadLibrary(rLibrary);
+            uno::Reference<container::XNameAccess> xModules(xNames->getByName(rLibrary), uno::UNO_QUERY);
+            if (!xModules.is())
+                continue;
+            for (const OUString& rModule : xModules->getElementNames())
+            {
+                OUString aCode;
+                if ((xModules->getByName(rModule) >>= aCode) && lclHasMacroCode(aCode))
+                {
+                    aMacros.bAny = true;
+                    aMacros.bBasic = aMacros.bBasic || rLibrary != aProject;
+                    break;
+                }
+            }
+        }
+        uno::Reference<document::XStorageBasedDocument> xStorageDoc(xModel, uno::UNO_QUERY);
+        if (xStorageDoc.is())
+        {
+            uno::Reference<embed::XStorage> xStorage = xStorageDoc->getDocumentStorage();
+            aMacros.bImportedVba = xStorage.is() && xStorage->hasByName(u"_MS_VBA_Macros"_ustr);
+        }
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("sfx.doc", "macro check before saving");
+    }
+    return aMacros;
+}
+
+bool lclFormatKeepsMacros(const DocumentMacros& rMacros, std::u16string_view rFilter, SfxFilterFlags nFlags)
+{
+    if (!rMacros.bAny || (nFlags & SfxFilterFlags::OWN))
+        return true;
+    if (rMacros.bBasic)
+        return false;
+    if (rFilter == u"MS Word 97" || rFilter == u"MS Word 97 Vorlage" || rFilter == u"MS Word 2007 XML VBA"
+        || rFilter == u"Office Open XML Text VBA" || rFilter == u"MS Excel 97"
+        || rFilter == u"MS Excel 97 Vorlage/Template" || rFilter == u"Calc MS Excel 2007 VBA XML"
+        || rFilter == u"Calc Office Open XML VBA")
+        return true;
+    return rMacros.bImportedVba
+           && (rFilter == u"Impress MS PowerPoint 2007 XML VBA" || rFilter == u"MS PowerPoint 97"
+               || rFilter == u"MS PowerPoint 97 Vorlage");
+}
+
+/// The format Save As proposes for the document's macros: Office's when it can write them, else ODF.
+OUString lclMacroKeepingFilter(const DocumentMacros& rMacros, std::u16string_view rDocService)
+{
+    if (rDocService == u"com.sun.star.text.TextDocument")
+        return rMacros.bBasic ? u"writer8"_ustr : u"MS Word 2007 XML VBA"_ustr;
+    if (rDocService == u"com.sun.star.sheet.SpreadsheetDocument")
+        return rMacros.bBasic ? u"calc8"_ustr : u"Calc MS Excel 2007 VBA XML"_ustr;
+    if (rDocService == u"com.sun.star.presentation.PresentationDocument")
+        return !rMacros.bBasic && rMacros.bImportedVba ? u"Impress MS PowerPoint 2007 XML VBA"_ustr : u"impress8"_ustr;
+    return OUString();
+}
+}
