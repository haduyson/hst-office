+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * Part of HST Office. This file is HST's own work and is not covered by the MPL.
+ */
+
+/* Which ribbon tabs a short tab row leaves off (vcl/inc/HstRibbonTabsFit.hxx): the widths are those of the
+   Writer ribbon of 1.0.3 at 100 % on Linux, where at 1024 px the row before the menu button and the search box's
+   magnifier has about 760 px for the tabs. 1.0.3 left off the picture tab first (it comes last): a selected
+   picture showed no Picture Format tab. */
+
+#include <cppunit/TestAssert.h>
+#include <cppunit/TestFixture.h>
+#include <cppunit/extensions/HelperMacros.h>
+#include <cppunit/plugin/TestPlugIn.h>
+
+#include <HstRibbonTabsFit.hxx>
+
+#include <algorithm>
+#include <cstdint>
+#include <vector>
+
+namespace
+{
+using hst::ribbon::TabRank;
+
+// File, Home, Recently used, Insert, Design, Layout, References, Mailings, Review, View, Help, Extensions
+const std::vector<std::int64_t> WRITER = { 62, 70, 104, 46, 59, 59, 75, 58, 57, 44, 60, 89 };
+constexpr std::int64_t PICTURE = 98; // Picture Format
+
+std::vector<TabRank> ranks(bool bPicture)
+{
+    std::vector<TabRank> aRanks(WRITER.size(), TabRank::Plain);
+    aRanks.front() = TabRank::Kept;
+    if (bPicture)
+        aRanks.push_back(TabRank::Contextual);
+    return aRanks;
+}
+
+std::vector<std::int64_t> widths(bool bPicture)
+{
+    std::vector<std::int64_t> aWidths(WRITER);
+    if (bPicture)
+        aWidths.push_back(PICTURE);
+    return aWidths;
+}
+
+std::int64_t shown(const std::vector<std::int64_t>& rWidths, const std::vector<bool>& rOff)
+{
+    std::int64_t nSum = 0;
+    for (std::size_t i = 0; i < rWidths.size(); ++i)
+        nSum += rOff[i] ? 0 : rWidths[i];
+    return nSum;
+}
+
+class RibbonTabsFitTest : public CppUnit::TestFixture
+{
+public:
+    void testWideRowKeepsEveryTab()
+    {
+        const std::vector<bool> aOff = hst::ribbon::tabsLeftOff(widths(true), ranks(true), 2000);
+        for (bool bOff : aOff)
+            CPPUNIT_ASSERT(!bOff);
+    }
+
+    void testSelectedPictureKeepsItsTab()
+    {
+        const std::vector<std::int64_t> aWidths = widths(true);
+        const std::vector<bool> aOff = hst::ribbon::tabsLeftOff(aWidths, ranks(true), 760);
+        CPPUNIT_ASSERT_MESSAGE("the Picture Format tab stays on the row", !aOff.back());
+        CPPUNIT_ASSERT_MESSAGE("the File button stays on the row", !aOff.front());
+        // the tabs shown in every context go from the right end: Extensions, then Help
+        CPPUNIT_ASSERT(aOff[11]);
+        CPPUNIT_ASSERT(aOff[10]);
+        CPPUNIT_ASSERT(!aOff[1]); // Home
+        CPPUNIT_ASSERT(shown(aWidths, aOff) <= 760);
+    }
+
+    void testWithoutSelectionTheRightEndGoes()
+    {
+        // no contextual tab: the run of tabs at the right end that does not fit, as before
+        const std::vector<std::int64_t> aWidths = widths(false);
+        const std::vector<bool> aOff = hst::ribbon::tabsLeftOff(aWidths, ranks(false), 700);
+        std::int64_t nEnd = 0;
+        bool bOffSeen = false;
+        for (std::size_t i = 0; i < aWidths.size(); ++i)
+        {
+            if (aOff[i])
+                bOffSeen = true;
+            else
+            {
+                CPPUNIT_ASSERT_MESSAGE("a kept tab after a left-off one", !bOffSeen);
+                nEnd += aWidths[i];
+            }
+        }
+        CPPUNIT_ASSERT(nEnd <= 700);
+        CPPUNIT_ASSERT(nEnd + aWidths[std::size_t(std::count(aOff.begin(), aOff.end(), false))] > 700);
+    }
+
+    void testVeryShortRowStillFits()
+    {
+        // past the plain tabs the contextual tab goes, then the File button: no tab runs under the menu button
+        const std::vector<std::int64_t> aWidths = widths(true);
+        const std::vector<bool> aOff = hst::ribbon::tabsLeftOff(aWidths, ranks(true), 120);
+        CPPUNIT_ASSERT(aOff.back());
+        CPPUNIT_ASSERT(!aOff.front());
+        CPPUNIT_ASSERT(shown(aWidths, aOff) <= 120);
+        const std::vector<bool> aNone = hst::ribbon::tabsLeftOff(aWidths, ranks(true), 10);
+        CPPUNIT_ASSERT_EQUAL(std::int64_t(0), shown(aWidths, aNone));
+    }
+
+    CPPUNIT_TEST_SUITE(RibbonTabsFitTest);
+    CPPUNIT_TEST(testWideRowKeepsEveryTab);
+    CPPUNIT_TEST(testSelectedPictureKeepsItsTab);
+    CPPUNIT_TEST(testWithoutSelectionTheRightEndGoes);
+    CPPUNIT_TEST(testVeryShortRowStillFits);
+    CPPUNIT_TEST_SUITE_END();
+};
+
+CPPUNIT_TEST_SUITE_REGISTRATION(RibbonTabsFitTest);
+}
+
+CPPUNIT_PLUGIN_IMPLEMENT();
+
