+++ b/vcl/inc/HstRibbonTabsFit.hxx
@@ -0,0 +1,51 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * Part of HST Office. This file is HST's own work and is not covered by the MPL.
+ */
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace hst::ribbon
+{
+/// HST Office: what a tab of the ribbon's tab row is worth when the row is too short for all of its tabs.
+/// A contextual tab (Picture Format, Table Design...) comes last in the row but is the one the user needs
+/// while the object is selected; the File button opens the backstage.
+enum class TabRank
+{
+    Plain, ///< a tab shown in every context (Home, Insert, View, Help...)
+    Contextual, ///< a tab shown only for the selection or the view mode
+    Kept, ///< the File button
+};
+
+/// Which of the row's visible tabs (in row order, with their widths) a row nRoom px wide leaves off: plain tabs go
+/// first, from the right end, then contextual ones, then kept ones, until the rest fits. With no contextual tab
+/// this is the run of tabs at the right end that does not fit. True = left off.
+inline std::vector<bool> tabsLeftOff(const std::vector<std::int64_t>& rWidths, const std::vector<TabRank>& rRanks,
+                                     std::int64_t nRoom)
+{
+    std::vector<bool> aOff(rWidths.size(), false);
+    std::int64_t nUsed = 0;
+    for (std::int64_t nWidth : rWidths)
+        nUsed += nWidth;
+    for (TabRank eRank : { TabRank::Plain, TabRank::Contextual, TabRank::Kept })
+    {
+        for (std::size_t i = rWidths.size(); i-- > 0 && nUsed > nRoom;)
+        {
+            if (!aOff[i] && i < rRanks.size() && rRanks[i] == eRank)
+            {
+                aOff[i] = true;
+                nUsed -= rWidths[i];
+            }
+        }
+    }
+    return aOff;
+}
+}
