+++ b/sc/inc/hsttextnumberparse.hxx
@@ -0,0 +1,199 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This file is part of the LibreOffice project.
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+// HST Office: when is a text cell a "number stored as text"? Pure C++, tested by test_sheets_text_number_parse.py.
+// The separators are the locale's (vi-VN: "." groups, "," decimals; en-US the other way round), never
+// guessed: "1.234" is 1234 in vi-VN and 1.234 in en-US, and "1,234,567.89" is no number in vi-VN.
+// Spaces (also no-break, narrow and thin) may group thousands too. Accepted around the digits: one sign
+// ("-1", "+1", "1-" or "(1)"), a trailing "%", and a currency (đ, ₫, VND, VNĐ, đồng or the locale's
+// symbol) before or after. Full-width digits and signs count as ASCII ones. Not numbers, so that codes
+// keep their form: leading zeros ("0905123456", "007"), more than 15 significant digits, a "+" before
+// 8 or more digits (a phone number), exponents, dates and anything else.
+#pragma once
+
+#include <algorithm>
+#include <optional>
+#include <string>
+#include <string_view>
+
+namespace hst::textnumber
+{
+enum class Kind
+{
+    Plain,
+    Percent,
+    Currency
+};
+
+struct Separators
+{
+    char16_t cDecimal = u'.';
+    char16_t cGroup = u',';
+    std::u16string_view aCurrency; // the locale's currency symbol (e.g. u"$"), may be empty
+};
+
+struct Parsed
+{
+    std::string aNumber; // ASCII "[-]digits[.digits][E-2]", read with a '.' decimal separator
+    Kind eKind = Kind::Plain;
+    bool bVnd = false; // the currency was đ, ₫, VND, VNĐ or đồng
+    bool bGrouped = false; // thousands were grouped
+    int nDecimals = 0; // digits after the decimal separator
+};
+
+namespace detail
+{
+constexpr char16_t normalise(char16_t c)
+{
+    if (c >= 0xFF01 && c <= 0xFF5E) // full-width ASCII
+        return static_cast<char16_t>(c - 0xFF01 + u'!');
+    if (c == 0x2212) // minus sign
+        return u'-';
+    const bool bSpace = c == u'\t' || c == 0x00A0 || c == 0x2007 || c == 0x2009 || c == 0x202F || c == 0x3000;
+    return bSpace ? u' ' : c;
+}
+
+constexpr char16_t lower(char16_t c)
+{
+    return c >= u'A' && c <= u'Z' ? static_cast<char16_t>(c + 32) : c == u'Đ' ? u'đ' : c;
+}
+
+inline void trim(std::u16string_view& r)
+{
+    while (!r.empty() && r.front() == u' ')
+        r.remove_prefix(1);
+    while (!r.empty() && r.back() == u' ')
+        r.remove_suffix(1);
+}
+
+inline bool equalsNoCase(std::u16string_view a, std::u16string_view b)
+{
+    if (a.size() != b.size())
+        return false;
+    for (size_t i = 0; i < a.size(); ++i)
+        if (lower(a[i]) != lower(b[i]))
+            return false;
+    return true;
+}
+
+/// Length of the currency at the front (bFront) or back of r, 0 if none; rVnd tells which one.
+inline size_t currency(std::u16string_view r, bool bFront, const Separators& rSep, bool& rVnd)
+{
+    static constexpr std::u16string_view aVnd[] = { u"đồng", u"VNĐ", u"VND", u"₫", u"đ" };
+    auto match = [&](std::u16string_view aToken) {
+        return !aToken.empty() && aToken.size() <= r.size()
+               && equalsNoCase(bFront ? r.substr(0, aToken.size()) : r.substr(r.size() - aToken.size()),
+                               aToken);
+    };
+    rVnd = true;
+    for (std::u16string_view aToken : aVnd)
+        if (match(aToken))
+            return aToken.size();
+    rVnd = false;
+    return match(rSep.aCurrency) ? rSep.aCurrency.size() : 0;
+}
+
+/// The digits of an integer part written with group separator c, or nullopt if grouped wrongly.
+inline std::optional<std::string> ungroup(std::u16string_view r, char16_t c, bool& rGrouped)
+{
+    std::string aDigits;
+    size_t nGroup = 0, nGroups = 0;
+    for (char16_t ch : r)
+    {
+        const bool bDigit = ch >= u'0' && ch <= u'9';
+        if (!bDigit && (ch != c || nGroup == 0 || (nGroups == 0 ? nGroup > 3 : nGroup != 3)))
+            return std::nullopt;
+        if (bDigit)
+            aDigits += static_cast<char>(ch);
+        nGroup = bDigit ? nGroup + 1 : 0;
+        nGroups += bDigit ? 0 : 1;
+    }
+    if (nGroups > 0 && nGroup != 3)
+        return std::nullopt;
+    rGrouped = nGroups > 0;
+    return aDigits;
+}
+}
+
+/// The number in rText, or nullopt if rText is no number stored as text under these separators.
+inline std::optional<Parsed> parse(std::u16string_view rText, const Separators& rSep)
+{
+    using namespace detail;
+    if (rText.empty() || rText.size() > 64)
+        return std::nullopt;
+    std::u16string aBuffer;
+    for (char16_t c : rText)
+        aBuffer += normalise(c);
+    std::u16string_view r(aBuffer);
+    trim(r);
+
+    Parsed aResult;
+    bool bParen = false, bMinus = false, bPlus = false, bCurrency = false;
+    if (r.size() > 2 && r.front() == u'(' && r.back() == u')')
+    {
+        bParen = true;
+        r = r.substr(1, r.size() - 2);
+        trim(r);
+    }
+    for (bool bFront : { true, false })
+    {
+        for (int i = 0; i < 3 && !r.empty(); ++i)
+        {
+            const char16_t c = bFront ? r.front() : r.back();
+            size_t nCut = 1;
+            if ((c == u'-' || (bFront && c == u'+')) && !bMinus && !bPlus)
+                (c == u'+' ? bPlus : bMinus) = true;
+            else if (!bFront && c == u'%' && aResult.eKind == Kind::Plain)
+                aResult.eKind = Kind::Percent;
+            else if (bCurrency || (nCut = currency(r, bFront, rSep, aResult.bVnd)) == 0)
+                break;
+            else
+                bCurrency = true;
+            r = bFront ? r.substr(nCut) : r.substr(0, r.size() - nCut);
+            trim(r);
+        }
+    }
+    if ((bCurrency && aResult.eKind == Kind::Percent) || (bParen && (bMinus || bPlus)))
+        return std::nullopt;
+    if (bCurrency)
+        aResult.eKind = Kind::Currency;
+
+    const char16_t cGroup = normalise(rSep.cGroup), cDecimal = normalise(rSep.cDecimal);
+    const size_t nDecimal = r.find(cDecimal);
+    std::u16string_view aInt = r.substr(0, nDecimal);
+    std::u16string_view aFrac = nDecimal == std::u16string_view::npos ? std::u16string_view() : r.substr(nDecimal + 1);
+    if (aFrac.find_first_not_of(u"0123456789") != std::u16string_view::npos)
+        return std::nullopt;
+    const char16_t cUsed = aInt.find(u' ') != std::u16string_view::npos ? u' ' : cGroup;
+    std::optional<std::string> aDigits = ungroup(aInt, cUsed == cDecimal ? 0 : cUsed, aResult.bGrouped);
+    if (!aDigits || (aDigits->empty() && aFrac.empty()) || (aDigits->size() > 1 && aDigits->front() == '0')
+        || (bPlus && aDigits->size() >= 8))
+        return std::nullopt;
+
+    std::string aFracDigits(aFrac.begin(), aFrac.end());
+    const size_t nLead = aDigits->find_first_not_of('0');
+    size_t nSignificant = nLead == std::string::npos ? 0 : aDigits->size() - nLead;
+    const size_t nLastFrac = aFracDigits.find_last_not_of('0');
+    const size_t nFracUsed = nLastFrac == std::string::npos ? 0 : nLastFrac + 1;
+    nSignificant += nSignificant ? nFracUsed : nFracUsed - std::min(nFracUsed, aFracDigits.find_first_not_of('0'));
+    if (nSignificant > 15)
+        return std::nullopt;
+
+    const bool bNegative = (bParen || bMinus) && nSignificant > 0;
+    aResult.aNumber = (bNegative ? "-" : "") + (aDigits->empty() ? std::string("0") : *aDigits);
+    if (!aFracDigits.empty())
+        aResult.aNumber += "." + aFracDigits;
+    if (aResult.eKind == Kind::Percent)
+        aResult.aNumber += "E-2";
+    aResult.nDecimals = static_cast<int>(aFracDigits.size());
+    return aResult;
+}
+}
