+#include <comphelper/lok.hxx>
+#include <vcl/svapp.hxx>
+
+void ScGridWindow::PostHstTextNumberButtonUpdate()
+{
+    if (!mpHstTextNumberEvent)
+        mpHstTextNumberEvent = Application::PostUserEvent(LINK(this, ScGridWindow, HstTextNumberUpdateHdl));
+}
+
+IMPL_LINK_NOARG(ScGridWindow, HstTextNumberUpdateHdl, void*, void)
+{
+    mpHstTextNumberEvent = nullptr;
+    UpdateHstTextNumberButton();
+}
+
+void ScGridWindow::UpdateHstTextNumberButton()
+{
+    ScDocument& rDoc = mrViewData.GetDocument();
+    const SCCOL nX = mrViewData.GetCurX();
+    const SCROW nY = mrViewData.GetCurY();
+    const SCTAB nTab = mrViewData.CurrentTabForData();
+    const ScAddress aPos(nX, nY, nTab);
+    ScDocShell* pDocSh = mrViewData.GetDocShell();
+    bool bShow = !comphelper::LibreOfficeKit::isActive() && IsVisible() && mrViewData.IsActive()
+                 && eWhich == mrViewData.GetActivePart() && !mrViewData.HasEditView(eWhich) && pDocSh
+                 && !pDocSh->IsReadOnly() && sc::hst::TextNumberIndicatorEnabled();
+    if (bShow)
+    {
+        ScHstIgnoredTextNumbers* pIgnored = rDoc.GetHstIgnoredTextNumbersIfAny();
+        bShow = sc::hst::IsTextNumber(rDoc, ScRefCellValue(rDoc, aPos), rDoc.GetNumberFormat(nX, nY, nTab))
+                && !(pIgnored && pIgnored->Contains(aPos));
+    }
+    tools::Rectangle aCellRect;
+    if (bShow)
+    {
+        Point aScrPos = mrViewData.GetScrPos(nX, nY, eWhich, true);
+        tools::Long nSizeX = 0, nSizeY = 0;
+        mrViewData.GetMergeSizePixel(nX, nY, nSizeX, nSizeY);
+        if (rDoc.IsLayoutRTL(nTab))
+            aScrPos.AdjustX(-(nSizeX - 2));
+        aCellRect = tools::Rectangle(aScrPos, Size(nSizeX, nSizeY));
+        const Size aOut(GetOutputSizePixel());
+        bShow = aCellRect.Right() > 0 && aCellRect.Bottom() > 0 && aCellRect.Left() < aOut.Width()
+                && aCellRect.Top() < aOut.Height();
+    }
+    if (!bShow)
+    {
+        if (mxHstTextNumberButton && mxHstTextNumberButton->IsVisible())
+            mxHstTextNumberButton->Hide();
+        return;
+    }
+    if (!mxHstTextNumberButton)
+        mxHstTextNumberButton = VclPtr<ScHstTextNumberButton>::Create(this, mrViewData);
+    const Size aSize(ScHstTextNumberButton::GetButtonSize(*this));
+    tools::Long nLeft = aCellRect.Left() - aSize.Width() - 1;
+    if (nLeft < 0)
+        nLeft = aCellRect.Right() + 2;
+    mxHstTextNumberButton->Place(Point(nLeft, std::max<tools::Long>(0, aCellRect.Top())), aSize);
+}
