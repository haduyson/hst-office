+// HST Office: the green triangle in the top-left corner (top-right in right-to-left sheets) of a cell
+// holding a number stored as text. Only the painted cells are looked at, from the cell info the grid
+// already filled, so a sheet of 100 000 rows costs no more than the rows on screen.
+
+#include <output.hxx>
+
+#include <document.hxx>
