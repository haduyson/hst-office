+void ScHstTextNumberButton::Place(const Point& rPos, const Size& rSize)
+{
+    if (IsVisible() && GetPosPixel() == rPos && GetSizePixel() == rSize)
+        return; // unchanged: no repaint, so that painting the grid cannot loop
+    SetPosSizePixel(rPos, rSize);
+    PaintButton();
+    Show();
+}
+
+/// A yellow diamond with "!" (the warning sign of a cell error) and the arrow of a menu button.
+void ScHstTextNumberButton::PaintButton()
+{
+    const Size aSize(GetSizePixel());
+    const StyleSettings& rStyle = Application::GetSettings().GetStyleSettings();
+    const bool bContrast = rStyle.GetHighContrastMode();
+    m_xVirDev->SetOutputSizePixel(aSize);
+    m_xVirDev->SetBackground(Wallpaper(rStyle.GetFaceColor()));
+    m_xVirDev->Erase();
+
+    const tools::Long nH = aSize.Height(), nC = nH / 2, nR = nH / 2 - 2;
+    const Point aDiamond[4] = { Point(nC, nC - nR), Point(nC + nR, nC), Point(nC, nC + nR), Point(nC - nR, nC) };
+    m_xVirDev->SetLineColor(bContrast ? rStyle.GetButtonTextColor() : Color(0x9C, 0x6B, 0x00));
+    m_xVirDev->SetFillColor(bContrast ? rStyle.GetFaceColor() : Color(0xFF, 0xC8, 0x3D));
+    m_xVirDev->DrawPolygon(tools::Polygon(4, aDiamond));
+
+    const tools::Long nW = std::max<tools::Long>(2, nR / 4);
+    m_xVirDev->SetLineColor();
+    m_xVirDev->SetFillColor(bContrast ? rStyle.GetButtonTextColor() : COL_BLACK);
+    m_xVirDev->DrawRect(tools::Rectangle(Point(nC - nW / 2, nC - nR / 2), Size(nW, nR * 2 / 3)));
+    m_xVirDev->DrawRect(tools::Rectangle(Point(nC - nW / 2, nC + nR / 3), Size(nW, nW)));
+
+    const tools::Long nA = std::max<tools::Long>(2, nH / 6), nAX = nH + (aSize.Width() - nH) / 2;
+    const Point aArrow[3] = { Point(nAX - nA, nC - nA / 2), Point(nAX + nA, nC - nA / 2), Point(nAX, nC + nA / 2) };
+    m_xVirDev->SetFillColor(rStyle.GetButtonTextColor());
+    m_xVirDev->DrawPolygon(tools::Polygon(3, aArrow));
+
+    m_xMenuButton->set_custom_button(m_xVirDev.get());
+}
+
+/// "Bỏ qua lỗi": the selection (or the cell cursor) is no longer checked, also after saving.
+void ScHstTextNumberButton::Ignore()
+{
+    ScDocShell* pDocSh = m_rViewData.GetDocShell();
+    ScMarkData aMark(m_rViewData.GetMarkData());
+    ScRangeList aRanges;
+    if (aMark.IsMarked() || aMark.IsMultiMarked())
+    {
+        aMark.MarkToMulti();
+        aMark.FillRangeListWithMarks(&aRanges, false);
+    }
+    else
+        aRanges.push_back(ScRange(m_rViewData.GetCurX(), m_rViewData.GetCurY(), m_rViewData.CurrentTabForData()));
+    pDocSh->GetDocument().GetHstIgnoredTextNumbers().Add(aRanges);
+    pDocSh->SetDocumentModified();
+    pDocSh->PostPaint(aRanges, PaintPartFlags::Grid);
+}
+
+/// "Trợ giúp về lỗi này": the page of the offline guide about numbers stored as text.
+void ScHstTextNumberButton::OpenHelp()
+{
+    try
+    {
+        const css::uno::Reference<css::uno::XComponentContext> xContext = comphelper::getProcessComponentContext();
+        OUString aUrl = comphelper::getExpandedUri(xContext, officecfg::Office::Common::Help::HelpRootURL::get());
+        if (aUrl.endsWith("/index.html"))
+            aUrl = OUString::Concat(aUrl.subView(0, aUrl.getLength() - 10)) + "bang-tinh-so-dang-van-ban.html";
+        if (aUrl.isEmpty())
+            return;
+        css::system::SystemShellExecute::create(xContext)->execute(
+            aUrl, OUString(), css::system::SystemShellExecuteFlags::URIS_ONLY);
+    }
+    catch (const css::uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("sc.ui", "HST: the help page of numbers stored as text did not open");
+    }
+}
+
+/// Typing goes on in the grid once the menu is closed.
+IMPL_LINK_NOARG(ScHstTextNumberButton, ToggleHdl, weld::Toggleable&, void)
+{
+    if (!m_xMenuButton->get_active() && GetParent())
+        GetParent()->GrabFocus();
+}
+
+IMPL_LINK(ScHstTextNumberButton, SelectHdl, const OUString&, rIdent, void)
+{
+    SfxDispatcher& rDispatcher = m_rViewData.GetDispatcher();
+    if (rIdent == "convert")
+        rDispatcher.Execute(SID_HST_CONVERT_TEXT_TO_NUMBER, SfxCallMode::ASYNCHRON | SfxCallMode::RECORD);
+    else if (rIdent == "ignore")
+        Ignore();
+    else if (rIdent == "help")
+        OpenHelp();
+    else if (rIdent == "options")
+    {
+        const SfxUInt16Item aPage(SID_OPTIONS_PAGEID, SID_SC_TP_CONTENT);
+        rDispatcher.ExecuteList(SID_OPTIONS_TREEDIALOG, SfxCallMode::ASYNCHRON, { &aPage });
+    }
+}
