+    : InterimItemWindow(pParent, u"modules/scalc/ui/hsttextnumberbutton.ui"_ustr, u"HstTextNumberButton"_ustr)
+    , m_xMenuButton(m_xBuilder->weld_menu_button(u"menubutton"_ustr))
