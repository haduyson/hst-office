+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This file is part of the LibreOffice project.
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+// HST Office: the cells where "Bỏ qua lỗi" was chosen for a number stored as text.
+
+#include <hsttextnumber.hxx>
+
+#include <document.hxx>
+#include <hints.hxx>
+
+#include <o3tl/string_view.hxx>
+#include <rtl/ustrbuf.hxx>
+
+ScHstIgnoredTextNumbers::ScHstIgnoredTextNumbers(ScDocument& rDoc)
+    : mrDoc(rDoc)
+{
+    // the same hint keeps the ranges of UNO cell range objects up to date
+    mrDoc.AddUnoObject(*this);
+}
+
+ScHstIgnoredTextNumbers::~ScHstIgnoredTextNumbers() = default; // SfxListener stops listening
+
+void ScHstIgnoredTextNumbers::Notify(SfxBroadcaster&, const SfxHint& rHint)
+{
+    if (rHint.GetId() != SfxHintId::ScUpdateRef || maRanges.empty())
+        return;
+    const ScUpdateRefHint& rRef = static_cast<const ScUpdateRefHint&>(rHint);
+    maRanges.UpdateReference(rRef.GetMode(), mrDoc, rRef.GetRange(), rRef.GetDx(), rRef.GetDy(),
+                             rRef.GetDz());
+}
+
+void ScHstIgnoredTextNumbers::Resolve()
+{
+    if (maPending.isEmpty())
+        return;
+    const OUString aValue = std::exchange(maPending, OUString());
+    sal_Int32 nIndex = 0;
+    do
+    {
+        const std::u16string_view aItem = o3tl::getToken(aValue, 0, ' ', nIndex);
+        const size_t nBang = aItem.find('!');
+        const size_t nColon = aItem.find(':');
+        if (nBang == std::u16string_view::npos || nColon == std::u16string_view::npos || nColon < nBang)
+            continue;
+        const sal_Int32 nTab = o3tl::toInt32(aItem.substr(0, nBang));
+        ScAddress aStart, aEnd;
+        const bool bValid
+            = (aStart.Parse(OUString(aItem.substr(nBang + 1, nColon - nBang - 1)), mrDoc) & ScRefFlags::VALID)
+              && (aEnd.Parse(OUString(aItem.substr(nColon + 1)), mrDoc) & ScRefFlags::VALID);
+        if (!bValid || nTab < 0 || nTab > MAXTAB)
+            continue;
+        aStart.SetTab(static_cast<SCTAB>(nTab));
+        aEnd.SetTab(static_cast<SCTAB>(nTab));
+        maRanges.Join(ScRange(aStart, aEnd));
+    } while (nIndex >= 0);
+}
+
+bool ScHstIgnoredTextNumbers::Contains(const ScAddress& rPos)
+{
+    Resolve();
+    return maRanges.Contains(ScRange(rPos));
+}
+
+void ScHstIgnoredTextNumbers::Add(const ScRangeList& rRanges)
+{
+    Resolve();
+    for (size_t i = 0; i < rRanges.size(); ++i)
+        maRanges.Join(rRanges[i]);
+}
+
+ScRangeList ScHstIgnoredTextNumbers::GetRanges(SCTAB nTab)
+{
+    Resolve();
+    ScRangeList aResult;
+    for (size_t i = 0; i < maRanges.size(); ++i)
+        if (maRanges[i].aStart.Tab() <= nTab && nTab <= maRanges[i].aEnd.Tab())
+        {
+            ScRange aRange(maRanges[i]);
+            aRange.aStart.SetTab(nTab);
+            aRange.aEnd.SetTab(nTab);
+            aResult.push_back(aRange);
+        }
+    return aResult;
+}
+
+OUString ScHstIgnoredTextNumbers::ToSettings()
+{
+    Resolve();
+    OUStringBuffer aValue;
+    for (size_t i = 0; i < maRanges.size(); ++i)
+        for (SCTAB nTab = maRanges[i].aStart.Tab(); nTab <= maRanges[i].aEnd.Tab(); ++nTab)
+        {
+            if (!aValue.isEmpty())
+                aValue.append(' ');
+            aValue.append(OUString::number(nTab) + "!" + maRanges[i].aStart.Format(ScRefFlags::VALID) + ":"
+                          + maRanges[i].aEnd.Format(ScRefFlags::VALID));
+        }
+    return aValue.makeStringAndClear();
+}
+
+void ScHstIgnoredTextNumbers::SetSettings(const OUString& rValue)
+{
+    maRanges.RemoveAll();
+    maPending = rValue;
+}
+
+ScHstIgnoredTextNumbers& ScDocument::GetHstIgnoredTextNumbers()
+{
+    if (!mpHstIgnoredTextNumbers)
+        mpHstIgnoredTextNumbers.reset(new ScHstIgnoredTextNumbers(*this));
+    return *mpHstIgnoredTextNumbers;
+}
