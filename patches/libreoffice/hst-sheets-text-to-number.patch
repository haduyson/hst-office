+void ScOutputData::DrawHstTextNumberMarks(vcl::RenderContext& rRenderContext)
+{
+    SvNumberFormatter* pFormatter = mpDoc->GetFormatTable();
+    ScHstIgnoredTextNumbers* pIgnored = mpDoc->GetHstIgnoredTextNumbersIfAny();
+    const tools::Long nLayoutSign = mbLayoutRTL ? -1 : 1;
+    const tools::Long nInitPosX = mbLayoutRTL ? mnScrX + mnMirrorW - 1 : mnScrX;
+    const tools::Long nSize
+        = static_cast<tools::Long>(rRenderContext.GetDPIScaleFactor() * mfZoomX * 3 + 3);
+    bool bColorSet = false;
+
+    tools::Long nPosY = mnScrY;
+    for (SCSIZE nArrY = 1; nArrY + 1 < mnArrCount; nArrY++)
+    {
+        RowInfo* pThisRowInfo = &mpRowInfo[nArrY];
+        const SCROW nRow = pThisRowInfo->nRowNo;
+        tools::Long nPosX = nInitPosX;
+        for (SCCOL nX = mnX1; pThisRowInfo->bChanged && nX <= mnX2; nX++)
+        {
+            const tools::Long nWidth = mpRowInfo[0].basicCellInfo(nX).nWidth;
+            const ScCellInfo& rInfo = pThisRowInfo->cellInfo(nX);
+            const ScPatternAttr* pPattern = rInfo.getPatternAttr();
+            const bool bCandidate = nWidth > 2 * nSize && pThisRowInfo->nHeight > 2 * nSize && pPattern
+                                    && !rInfo.bHOverlapped && !rInfo.bVOverlapped
+                                    && (rInfo.maCell.getType() == CELLTYPE_STRING
+                                        || rInfo.maCell.getType() == CELLTYPE_EDIT);
+            if (bCandidate
+                && sc::hst::IsTextNumber(*mpDoc, rInfo.maCell,
+                                         pPattern->GetNumberFormat(pFormatter, rInfo.pConditionSet))
+                && !(pIgnored && pIgnored->Contains(ScAddress(nX, nRow, mnTab))))
+            {
+                if (!bColorSet)
+                {
+                    const StyleSettings& rStyle = Application::GetSettings().GetStyleSettings();
+                    const Color aGreen = mbUseStyleColor && rStyle.GetHighContrastMode()
+                                             ? ScModule::get()->GetColorConfig().GetColorValue(svtools::FONTCOLOR).nColor
+                                             : Color(0x00, 0x80, 0x00);
+                    rRenderContext.SetLineColor(aGreen);
+                    rRenderContext.SetFillColor(aGreen);
+                    bColorSet = true;
+                }
+                const tools::Long nX0 = mbLayoutRTL ? nPosX - 1 : nPosX;
+                Point aPoints[3] = { Point(nX0, nPosY), Point(nX0 + nSize * nLayoutSign, nPosY),
+                                     Point(nX0, nPosY + nSize) };
+                rRenderContext.DrawPolygon(tools::Polygon(3, aPoints));
+            }
+            nPosX += nWidth * nLayoutSign;
+        }
+        nPosY += pThisRowInfo->nHeight;
+    }
+}
