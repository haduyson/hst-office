+
+// HST Office: numbers stored as text ("Số được lưu dưới dạng văn bản"). A text cell whose text is a number
+// in the locale of the cell's number format (rules in hsttextnumberparse.hxx) gets a green triangle in its
+// top-left corner and a warning button when it is the cell cursor; "Chuyển thành số" turns such cells into
+// numbers. Cells formatted as Text, and cells where "Bỏ qua lỗi" was chosen, are left alone.
+#pragma once
+
+#include "scdllapi.h"
+#include "rangelst.hxx"
+#include <svl/lstner.hxx>
+#include <optional>
+
+class ScDocument;
+struct ScRefCellValue;
+
+namespace sc::hst
+{
+/// A number stored as text: its value and the format the cell gets (0: keep the cell's format).
+struct TextNumber
+{
+    double fValue = 0.0;
+    sal_uInt32 nFormat = 0;
+};
+
+/// Tools ▸ Options ▸ Sheets ▸ View ▸ "Number stored as text": the triangles and the button are shown.
+SC_DLLPUBLIC bool TextNumberIndicatorEnabled();
+
+/// Whether rCell, with number format nFormat, holds a number stored as text (cheap: used while painting).
+SC_DLLPUBLIC bool IsTextNumber(const ScDocument& rDoc, const ScRefCellValue& rCell, sal_uInt32 nFormat);
+
+/** The value of such a cell and the format it should get. Only a cell in the General format gets one:
+    percent ("15%"), currency ("1.000 đ": the VND format of HST), or thousands ("1.234.567") with as many
+    decimals as the text had; a cell with another number format keeps it. */
+SC_DLLPUBLIC std::optional<TextNumber> GetTextNumber(ScDocument& rDoc, const ScRefCellValue& rCell,
+                                                     sal_uInt32 nFormat);
+}
+
+/** Cells where "Bỏ qua lỗi" was chosen. Follows inserted and deleted rows, columns and sheets; saved in
+    .xlsx as <ignoredErrors numberStoredAsText="1"> and in .ods in the document settings. */
+class SC_DLLPUBLIC ScHstIgnoredTextNumbers final : public SfxListener
+{
+    ScDocument& mrDoc;
+    ScRangeList maRanges;
+    OUString maPending; // settings read before the sheets exist, resolved on first use
+
+    void Resolve();
+
+public:
+    explicit ScHstIgnoredTextNumbers(ScDocument& rDoc);
+    virtual ~ScHstIgnoredTextNumbers() override;
+    virtual void Notify(SfxBroadcaster& rBC, const SfxHint& rHint) override;
+
+    bool Contains(const ScAddress& rPos);
+    void Add(const ScRangeList& rRanges);
+    ScRangeList GetRanges(SCTAB nTab);
+
+    /// ODF settings value: "sheet!A1:B2 sheet!C3:C3", sheets by index (settings are read before the sheets)
+    OUString ToSettings();
+    void SetSettings(const OUString& rValue);
+};
+
