+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This file is part of the LibreOffice project.
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+#include <hsttextnumber.hxx>
+#include <hsttextnumberparse.hxx>
+
+#include <cellvalue.hxx>
+#include <document.hxx>
+#include <hints.hxx>
+
+#include <comphelper/string.hxx>
+#include <i18nlangtag/languagetag.hxx>
+#include <i18nlangtag/mslangid.hxx>
+#include <officecfg/Office/Calc.hxx>
+#include <rtl/math.hxx>
+#include <svl/numformat.hxx>
+#include <svl/zformat.hxx>
+#include <svl/zforlist.hxx>
+#include <unotools/localedatawrapper.hxx>
+
+namespace
+{
+struct LocaleSeparators
+{
+    LanguageType eLang = LANGUAGE_DONTKNOW;
+    char16_t cDecimal = u'.';
+    char16_t cGroup = u',';
+    OUString aCurrency;
+};
+
+/// The separators of eLang; the last language is kept, so painting a sheet asks the locale data once.
+const LocaleSeparators& lcl_Separators(LanguageType eLang)
+{
+    thread_local LocaleSeparators aLast;
+    if (aLast.eLang != eLang)
+    {
+        const LocaleDataWrapper* pData = LocaleDataWrapper::get(LanguageTag(eLang));
+        const OUString& rDecimal = pData->getNumDecimalSep();
+        const OUString& rGroup = pData->getNumThousandSep();
+        aLast.cDecimal = rDecimal.isEmpty() ? u'.' : rDecimal[0];
+        aLast.cGroup = rGroup.isEmpty() ? u',' : rGroup[0];
+        aLast.aCurrency = pData->getCurrSymbol();
+        aLast.eLang = eLang;
+    }
+    return aLast;
+}
+
+std::optional<hst::textnumber::Parsed> lcl_Parse(const ScDocument& rDoc, const ScRefCellValue& rCell,
+                                                 sal_uInt32 nFormat, LanguageType& rLang)
+{
+    const CellType eType = rCell.getType();
+    if (eType != CELLTYPE_STRING && eType != CELLTYPE_EDIT)
+        return std::nullopt;
+    const SvNumberFormatter* pFormatter = rDoc.GetFormatTable();
+    const SvNumberformat* pEntry = pFormatter->GetEntry(nFormat);
+    if (!pEntry || pEntry->GetMaskedType() == SvNumFormatType::TEXT)
+        return std::nullopt;
+    const OUString aText = rCell.getString(rDoc);
+    if (aText.isEmpty() || aText.getLength() > 64)
+        return std::nullopt;
+    rLang = MsLangId::getRealLanguage(pEntry->GetLanguage());
+    const LocaleSeparators& rSep = lcl_Separators(rLang);
+    return hst::textnumber::parse(aText, { rSep.cDecimal, rSep.cGroup, rSep.aCurrency });
+}
+
+/// The key of a format code written in eCodeLang, registered for eLang; 0 if the code is not valid.
+sal_uInt32 lcl_Key(SvNumberFormatter& rFormatter, OUString aCode, LanguageType eCodeLang, LanguageType eLang)
+{
+    sal_Int32 nCheckPos = 0;
+    SvNumFormatType nType = SvNumFormatType::ALL;
+    sal_uInt32 nKey = 0;
+    rFormatter.PutandConvertEntry(aCode, nCheckPos, nType, nKey, eCodeLang, eLang, false);
+    return nCheckPos == 0 ? nKey : 0;
+}
+
+sal_uInt32 lcl_Format(SvNumberFormatter& rFormatter, const hst::textnumber::Parsed& rParsed, LanguageType eLang)
+{
+    const sal_uInt16 nDecimals = static_cast<sal_uInt16>(rParsed.nDecimals);
+    switch (rParsed.eKind)
+    {
+        case hst::textnumber::Kind::Percent:
+        {
+            const sal_uInt32 nBase = rFormatter.GetStandardFormat(SvNumFormatType::PERCENT, eLang);
+            return lcl_Key(rFormatter, rFormatter.GenerateFormat(nBase, eLang, false, false, nDecimals), eLang,
+                           eLang);
+        }
+        case hst::textnumber::Kind::Currency:
+        {
+            if (!rParsed.bVnd)
+            {
+                const sal_uInt32 nBase = rFormatter.GetStandardFormat(SvNumFormatType::CURRENCY, eLang);
+                return lcl_Key(rFormatter, rFormatter.GenerateFormat(nBase, eLang, true, false, nDecimals),
+                               eLang, eLang);
+            }
+            // the "Tiền VND" format of HST (data/hst/number-formats.json), in en-US notation
+            OUStringBuffer aCode(u"#,##0");
+            if (nDecimals > 0)
+                comphelper::string::padToLength(aCode.append('.'), 6 + nDecimals, '0');
+            return lcl_Key(rFormatter, aCode.append(u" [$₫-42A]").makeStringAndClear(), LANGUAGE_ENGLISH_US,
+                           eLang);
+        }
+        case hst::textnumber::Kind::Plain:
+            break;
+    }
+    if (!rParsed.bGrouped)
+        return 0;
+    return lcl_Key(rFormatter,
+                   rFormatter.GenerateFormat(rFormatter.GetStandardIndex(eLang), eLang, true, false, nDecimals),
+                   eLang, eLang);
+}
+}
+
+namespace sc::hst
+{
+bool TextNumberIndicatorEnabled()
+{
+    return officecfg::Office::Calc::Content::Display::HstNumberStoredAsText::get();
+}
+
+bool IsTextNumber(const ScDocument& rDoc, const ScRefCellValue& rCell, sal_uInt32 nFormat)
+{
+    LanguageType eLang;
+    return lcl_Parse(rDoc, rCell, nFormat, eLang).has_value();
+}
+
+std::optional<TextNumber> GetTextNumber(ScDocument& rDoc, const ScRefCellValue& rCell, sal_uInt32 nFormat)
+{
+    LanguageType eLang;
+    const std::optional<::hst::textnumber::Parsed> aParsed = lcl_Parse(rDoc, rCell, nFormat, eLang);
+    if (!aParsed)
+        return std::nullopt;
+    rtl_math_ConversionStatus eStatus = rtl_math_ConversionStatus_Ok;
+    sal_Int32 nEnd = 0;
+    TextNumber aResult;
+    aResult.fValue = rtl::math::stringToDouble(aParsed->aNumber, '.', '\0', &eStatus, &nEnd);
+    if (eStatus != rtl_math_ConversionStatus_Ok || nEnd != static_cast<sal_Int32>(aParsed->aNumber.size()))
+        return std::nullopt;
+    if (nFormat % SV_COUNTRY_LANGUAGE_OFFSET == 0) // General: show the number as it was written
+        aResult.nFormat = lcl_Format(*rDoc.GetFormatTable(), *aParsed, eLang);
+    return aResult;
+}
+}
+
