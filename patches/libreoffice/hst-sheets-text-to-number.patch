+
+namespace
+{
+/// The selection, or the cell cursor when nothing is selected.
+ScRangeList lcl_Ranges(ScViewData& rViewData)
+{
+    ScMarkData aMark(rViewData.GetMarkData());
+    ScRangeList aRanges;
+    if (aMark.IsMarked() || aMark.IsMultiMarked())
+    {
+        aMark.MarkToMulti();
+        aMark.FillRangeListWithMarks(&aRanges, false);
+    }
+    else
+        aRanges.push_back(ScRange(rViewData.GetCurX(), rViewData.GetCurY(), rViewData.CurrentTabForData()));
+    return aRanges;
+}
+
+bool lcl_IsText(const ScRefCellValue& rCell)
+{
+    return rCell.getType() == CELLTYPE_STRING || rCell.getType() == CELLTYPE_EDIT;
+}
+
+/// Adds rPos to rRanges, growing the last range when rPos is the cell below it.
+void lcl_Append(std::vector<ScRange>& rRanges, const ScAddress& rPos)
+{
+    if (!rRanges.empty())
+    {
+        ScAddress& rEnd = rRanges.back().aEnd;
+        if (rEnd.Tab() == rPos.Tab() && rEnd.Col() == rPos.Col() && rEnd.Row() + 1 == rPos.Row()
+            && rRanges.back().aStart.Col() == rPos.Col())
+        {
+            rEnd.SetRow(rPos.Row());
+            return;
+        }
+    }
+    rRanges.emplace_back(rPos);
+}
+}
+
+namespace sc::hst
+{
+bool HasTextNumbers(ScViewData& rViewData)
+{
+    ScDocument& rDoc = rViewData.GetDocument();
+    const ScRangeList aRanges = lcl_Ranges(rViewData);
+    size_t nVisited = 0;
+    for (size_t i = 0; i < aRanges.size(); ++i)
+    {
+        ScCellIterator aIter(rDoc, aRanges[i]);
+        for (bool bHas = aIter.first(); bHas; bHas = aIter.next())
+        {
+            if (++nVisited > 5000)
+                return true; // a large selection: let the command look, it does nothing if there is none
+            const ScAddress& rPos = aIter.GetPos();
+            if (lcl_IsText(aIter.getRefCellValue())
+                && IsTextNumber(rDoc, aIter.getRefCellValue(), rDoc.GetNumberFormat(rPos.Col(), rPos.Row(), rPos.Tab())))
+                return true;
+        }
+    }
+    return false;
+}
+
+size_t ConvertTextNumbers(ScViewData& rViewData)
+{
+    ScDocShell* pDocSh = rViewData.GetDocShell();
+    ScDocument& rDoc = rViewData.GetDocument();
+    const ScRangeList aRanges = lcl_Ranges(rViewData);
+    const ScMarkData aMark(rDoc.GetSheetLimits(), aRanges);
+    ScEditableTester aTester = ScEditableTester::CreateAndTestSelection(rDoc, aMark);
+    if (!aTester.IsEditable())
+    {
+        rViewData.GetView()->ErrorMessage(aTester.GetMessageId());
+        return 0;
+    }
+
+    // runs of cells below each other become one SetValueCells; cells needing a format are grouped by it
+    std::vector<ScRange> aRuns;
+    std::vector<double> aValues;
+    std::map<sal_uInt32, std::vector<ScRange>> aFormats;
+    for (size_t i = 0; i < aRanges.size(); ++i)
+    {
+        ScCellIterator aIter(rDoc, aRanges[i]);
+        for (bool bHas = aIter.first(); bHas; bHas = aIter.next())
+        {
+            const ScAddress aPos = aIter.GetPos();
+            if (!lcl_IsText(aIter.getRefCellValue()))
+                continue;
+            const std::optional<TextNumber> aNumber = GetTextNumber(
+                rDoc, aIter.getRefCellValue(), rDoc.GetNumberFormat(aPos.Col(), aPos.Row(), aPos.Tab()));
+            if (!aNumber)
+                continue;
+            lcl_Append(aRuns, aPos);
+            aValues.push_back(aNumber->fValue);
+            if (aNumber->nFormat != 0)
+                lcl_Append(aFormats[aNumber->nFormat], aPos);
+        }
+    }
+    if (aValues.empty())
+        return 0;
+
+    SfxUndoManager* pUndoMgr = rDoc.IsUndoEnabled() ? pDocSh->GetUndoManager() : nullptr;
+    if (pUndoMgr)
+    {
+        const OUString aComment = ScResId(STR_HST_UNDO_TEXT_TO_NUMBER);
+        pUndoMgr->EnterListAction(aComment, aComment, 0, rViewData.GetViewShell()->GetViewShellId());
+    }
+    ScDocFunc& rFunc = pDocSh->GetDocFunc();
+    auto itValue = aValues.begin();
+    for (const ScRange& rRun : aRuns)
+    {
+        const auto itEnd = itValue + (rRun.aEnd.Row() - rRun.aStart.Row() + 1);
+        rFunc.SetValueCells(rRun.aStart, std::vector<double>(itValue, itEnd), true);
+        itValue = itEnd;
+    }
+    for (const auto& [nFormat, rCells] : aFormats)
+    {
+        ScMarkData aFormatMark(rDoc.GetSheetLimits());
+        for (const ScRange& rRange : rCells)
+        {
+            aFormatMark.SelectTable(rRange.aStart.Tab(), true); // ApplyAttributes works on the selected sheets
+            aFormatMark.SetMultiMarkArea(rRange);
+        }
+        ScPatternAttr aPattern(rDoc.getCellAttributeHelper());
+        aPattern.ItemSetPut(SfxUInt32Item(ATTR_VALUE_FORMAT, nFormat));
+        rFunc.ApplyAttributes(aFormatMark, aPattern, true);
+    }
+    if (pUndoMgr)
+        pUndoMgr->LeaveListAction();
+
+    rViewData.GetView()->CellContentChanged(); // cell slots and the input line show the numbers
+    return aValues.size();
+}
+}
