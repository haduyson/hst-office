+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/* SPDX-License-Identifier: LicenseRef-HST-Proprietary */
+
+#include <hstsortedpropertylookup.hxx>
+
+namespace
+{
+/// Steps tried forwards before falling back to a search: a sorted list of all names moves one
+/// entry per name, a list of a few names may jump far.
+constexpr size_t HST_MAX_FORWARD_STEPS = 8;
+}
+
+const SfxItemPropertyMapEntry* HstSortedPropertyLookup::Find(std::u16string_view rName)
+{
+    const auto& rEntries = m_rMap.getPropertyEntries();
+    const size_t nCount = rEntries.size();
+    size_t nPos = m_nPos;
+    size_t nSteps = 0;
+    // Walk forwards while the entry is before the name; give up on a long way or a name out of order.
+    while (nPos < nCount && rEntries[nPos]->aName < rName && nSteps < HST_MAX_FORWARD_STEPS)
+    {
+        ++nPos;
+        ++nSteps;
+    }
+    const bool bBefore = nPos < nCount && rEntries[nPos]->aName < rName;
+    const bool bOutOfOrder = nPos > 0 && !(rEntries[nPos - 1]->aName < rName);
+    if (bBefore || bOutOfOrder)
+    {
+        const SfxItemPropertyMapEntry* pEntry = m_rMap.getByName(rName);
+        if (pEntry)
+        {
+            auto it = rEntries.find(pEntry);
+            m_nPos = it - rEntries.begin();
+        }
+        return pEntry;
+    }
+    m_nPos = nPos;
+    if (nPos < nCount && rEntries[nPos]->aName == rName)
+        return rEntries[nPos];
+    return nullptr;
+}
