+#include <svl/itemprop.hxx>
+#include <swdllapi.h>
+
+#include <string_view>
+
+/// HST: finds the entries of a property map for a list of names given in ascending order (as the
+/// XTolerantMultiPropertySet calls require) by walking the map once, instead of one binary search
+/// with string compares per name. Names out of order are still found (by a new search).
+class SW_DLLPUBLIC HstSortedPropertyLookup
+{
+    const SfxItemPropertyMap& m_rMap;
+    size_t m_nPos = 0; ///< no later name is before this position, if the names are sorted
+
+public:
+    explicit HstSortedPropertyLookup(const SfxItemPropertyMap& rMap)
+        : m_rMap(rMap)
+    {
+    }
+    /// The entry of rName, nullptr if the map has none (as SfxItemPropertyMap::getByName).
+    const SfxItemPropertyMapEntry* Find(std::u16string_view rName);
+};
