+CPPUNIT_TEST_FIXTURE(SwCoreUnocoreTest, testHstSortedPropertyLookup)
+{
+    // Entries out of order on purpose: the map sorts them.
+    std::vector<SfxItemPropertyMapEntry> aEntries;
+    for (const char16_t* pName : { u"ParaTopMargin", u"CharWeight", u"ParaAdjust", u"CharHeight",
+                                   u"ParaBottomMargin", u"BorderDistance", u"ParaStyleName",
+                                   u"CharColor", u"CharFontName", u"ParaLineSpacing", u"Z" })
+        aEntries.emplace_back(OUString(pName), 1, cppu::UnoType<sal_Int32>::get(), 0, 0);
+    SfxItemPropertyMap aMap(aEntries);
+
+    auto check = [&aMap](const std::vector<OUString>& rNames) {
+        HstSortedPropertyLookup aLookup(aMap);
+        for (const OUString& rName : rNames)
+            CPPUNIT_ASSERT_EQUAL_MESSAGE(rName.toUtf8().getStr(), aMap.getByName(rName),
+                                         aLookup.Find(rName));
+    };
+    // All names in order (the getDirectPropertyValuesTolerant case), with unknown ones in between.
+    std::vector<OUString> aAll;
+    for (const SfxItemPropertyMapEntry* pEntry : aMap.getPropertyEntries())
+        aAll.push_back(pEntry->aName);
+    check(aAll);
+    check({ u"A"_ustr, u"CharColor"_ustr, u"CharColour"_ustr, u"ParaAdjust"_ustr, u"ParaZ"_ustr,
+            u"Z"_ustr, u"ZZ"_ustr });
+    // A few names far apart, out of order and repeated: still the same entries.
+    check({ u"Z"_ustr, u"BorderDistance"_ustr, u"ParaStyleName"_ustr, u"ParaStyleName"_ustr,
+            u"CharWeight"_ustr, u""_ustr, u"BorderDistance"_ustr });
+}
