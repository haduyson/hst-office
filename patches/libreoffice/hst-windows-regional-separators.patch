+/* Whether the locale data of rLocale carries the separators of the OS regional settings: the
+ * locale setting is the system default and rLocale is the OS user locale (same condition as
+ * i18npool LocaleDataImpl, Windows and macOS only). */
+bool lcl_UsesSystemSeparators(const lang::Locale& rLocale)
+{
+#if defined _WIN32 || defined MACOSX
+    try
+    {
+        if (!officecfg::Setup::L10N::ooSetupSystemLocale::get().isEmpty())
+            return false;
+    }
+    catch (const Exception&)
+    {
+        return false;
+    }
+    return LanguageTag(rLocale).getLanguageType() == MsLangId::getSystemLanguage();
+#else
+    (void)rLocale;
+    return false;
+#endif
+}
