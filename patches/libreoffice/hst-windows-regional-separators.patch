+/* On Windows and macOS the number separators follow the user's regional settings of the OS, like
+ * the leading spreadsheet application does: decimal, thousands and list separator of the OS user
+ * locale, including values the user customized. That applies only while the locale setting in
+ * Tools - Options - Languages is the system default (ooSetupSystemLocale empty), and only to the
+ * locale data of the OS user locale; an explicitly chosen locale keeps the LibreOffice data.
+ * sc ScFormulaOptions::GetDefaultFormulaSeparators uses the same condition.
+ *
+ * en-US keeps its decimal and thousands separators: en-US is the invariant locale that the .xlsx
+ * and .xls filters convert number format codes from and to, so it must not change. Its list
+ * separator (used only for the formula argument separator) follows the OS. */
+struct SystemSeparators
+{
+    OUString aDecimal;
+    OUString aThousand;
+    OUString aList;
+};
+
+#if defined _WIN32
+OUString readLocaleInfo(LCTYPE nType)
+{
+    wchar_t aBuf[16];
+    const int nLen = GetLocaleInfoEx(LOCALE_NAME_USER_DEFAULT, nType, aBuf, SAL_N_ELEMENTS(aBuf));
+    return nLen > 1 ? OUString(o3tl::toU(aBuf), nLen - 1) : OUString();
+}
+
+SystemSeparators readSystemSeparators()
+{
+    return { readLocaleInfo(LOCALE_SDECIMAL), readLocaleInfo(LOCALE_STHOUSAND),
+             readLocaleInfo(LOCALE_SLIST) };
+}
+#elif defined MACOSX
+OUString readLocaleValue(CFLocaleRef xLocale, CFLocaleKey aKey)
+{
+    CFStringRef xStr = static_cast<CFStringRef>(CFLocaleGetValue(xLocale, aKey));
+    if (!xStr)
+        return OUString();
+    const CFIndex nLen = CFStringGetLength(xStr);
+    if (nLen <= 0 || nLen > 8)
+        return OUString();
+    UniChar aBuf[8];
+    CFStringGetCharacters(xStr, CFRangeMake(0, nLen), aBuf);
+    return OUString(reinterpret_cast<const sal_Unicode*>(aBuf), nLen);
+}
+
+SystemSeparators readSystemSeparators()
+{
+    SystemSeparators aSeps;
+    CFLocaleRef xLocale = CFLocaleCopyCurrent();
+    if (!xLocale)
+        return aSeps;
+    aSeps.aDecimal = readLocaleValue(xLocale, kCFLocaleDecimalSeparator);
+    aSeps.aThousand = readLocaleValue(xLocale, kCFLocaleGroupingSeparator);
+    CFRelease(xLocale);
+    // macOS has no list separator; the leading application uses ';' when the decimal is ','.
+    aSeps.aList = aSeps.aDecimal == "," ? u";"_ustr : u","_ustr;
+    return aSeps;
+}
+#endif
+
+// The OS separators that replace the locale data of rLocale, or nothing.
+std::optional<SystemSeparators> getSystemSeparators(const Locale& rLocale)
+{
+#if defined _WIN32 || defined MACOSX
+    try
+    {
+        if (!officecfg::Setup::L10N::ooSetupSystemLocale::get().isEmpty())
+            return {};
+    }
+    catch (const uno::Exception&)
+    {
+        return {}; // no configuration (e.g. unit tests): plain locale data
+    }
+    const LanguageType nLang = LanguageTag(rLocale).getLanguageType();
+    if (nLang != MsLangId::getSystemLanguage())
+        return {};
+    static const SystemSeparators aSystem = readSystemSeparators();
+    SystemSeparators aSeps(aSystem);
+    if (nLang == LANGUAGE_ENGLISH_US)
+        aSeps.aDecimal.clear();
+    return aSeps;
+#else
+    (void)rLocale;
+    return {};
+#endif
+}
+
+bool isDigitPlaceholder(sal_Unicode c) { return c == '0' || c == '#' || c == '?'; }
+
+/* Rewrites a number format code of the locale data from the locale's decimal and thousands
+ * separators to the effective ones. Only separators next to digit placeholders are rewritten;
+ * quoted text, escaped characters and [...] modifiers stay as they are. */
+OUString convertNumberFormatCode(const OUString& rCode, sal_Unicode cOldDec, sal_Unicode cNewDec,
+                                 sal_Unicode cOldTh, sal_Unicode cNewTh)
+{
+    const sal_Int32 nLen = rCode.getLength();
+    OUStringBuffer aBuf(nLen);
+    sal_Unicode cEnd = 0; // '"' or ']' while inside quoted text or a modifier
+    for (sal_Int32 i = 0; i < nLen; ++i)
+    {
+        sal_Unicode c = rCode[i];
+        const bool bPrevDigit = i > 0 && isDigitPlaceholder(rCode[i - 1]);
+        const bool bNextDigit = i + 1 < nLen && isDigitPlaceholder(rCode[i + 1]);
+        if (cEnd)
+        {
+            if (c == cEnd)
+                cEnd = 0;
+        }
+        else if (c == '"')
+            cEnd = '"';
+        else if (c == '[')
+            cEnd = ']';
+        else if ((c == '\\' || c == '_' || c == '*') && i + 1 < nLen)
+        {
+            aBuf.append(c);
+            c = rCode[++i];
+        }
+        else if (c == cOldDec && (bPrevDigit || bNextDigit))
+            c = cNewDec;
+        else if (c == cOldTh && bPrevDigit && bNextDigit)
+            c = cNewTh;
+        aBuf.append(c);
+    }
+    return aBuf.makeStringAndClear();
+}
+
+/* Applies the OS separators to the separator items of the locale data. Returns false when the
+ * OS values are unusable (not a single character each, or decimal equal to thousands), then the
+ * locale data stays as it is. */
+template <typename Item> bool applySystemSeparators(Item& rItem, const SystemSeparators& rSeps)
+{
+    OUString aDecimal = rSeps.aDecimal.getLength() == 1 ? rSeps.aDecimal : rItem.decimalSeparator;
+    OUString aThousand = rSeps.aDecimal.getLength() == 1 && rSeps.aThousand.getLength() == 1
+                             ? rSeps.aThousand
+                             : rItem.thousandSeparator;
+    if (aDecimal.isEmpty() || aDecimal == aThousand)
+        return false;
+    rItem.decimalSeparator = aDecimal;
+    rItem.thousandSeparator = aThousand;
+    if (rSeps.aList.getLength() == 1)
+        rItem.listSeparator = rSeps.aList;
+    return true;
+}
+
