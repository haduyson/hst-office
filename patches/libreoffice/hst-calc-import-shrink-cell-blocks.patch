+#pragma once
+
+#include <cstdlib>
+
+#include "mtvelements.hxx"
+
+namespace sc
+{
+/** Gives back the spare capacity of a column's cell blocks once an import has filled them.
+
+    An import appends the cells of a column one by one, so every block of cells grows by doubling and ends up to
+    half empty: a sheet of 5.3 million text cells kept about 30 MB of unused block capacity for as long as the
+    document was open. After the import the blocks are cut to their size (the cells are moved, not copied: the
+    pooled strings and formula cells stay the same objects). A later edit that grows a block reallocates it once,
+    as an edit of any full block does. The environment variable HST_SC_IMPORT_SHRINK_OFF keeps the capacity as
+    before (read once per process). */
+inline void hstShrinkCellStores(CellStoreType& rCells, CellTextAttrStoreType& rTextAttrs)
+{
+    if (std::getenv("HST_SC_IMPORT_SHRINK_OFF"))
+        return;
+    rCells.shrink_to_fit();
+    rTextAttrs.shrink_to_fit();
+}
+}
