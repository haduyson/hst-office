 }
 
+CPPUNIT_TEST_FIXTURE(TestCondformat, testImportedColumnsStayEditableAfterShrink)
+{
+    // After an import the cell blocks of the columns are cut to their size (the environment variable keeps the
+    // spare capacity, as before). The cells are the same, and inserting rows in the middle of the blocks, writing
+    // into them and appending to them gives the same sheet either way.
+    const auto importAndEdit = [this](bool bShrink) {
+        if (!bShrink)
+            osl_setEnvironment(u"HST_SC_IMPORT_SHRINK_OFF"_ustr.pData, u"1"_ustr.pData);
+        m_pDoc->InsertTab(0, u"Test"_ustr);
+        {
+            ScDocumentImport aImport(*m_pDoc);
+            for (SCROW nRow = 0; nRow < 3000; ++nRow)
+            {
+                aImport.setStringCell(ScAddress(0, nRow, 0), "s" + OUString::number(nRow % 37));
+                aImport.setNumericCell(ScAddress(1, nRow, 0), nRow);
+                if (nRow % 3)
+                    aImport.setStringCell(ScAddress(2, nRow, 0), u"Vi\u1EC7t"_ustr);
+            }
+            aImport.finalize();
+        }
+        osl_clearEnvironment(u"HST_SC_IMPORT_SHRINK_OFF"_ustr.pData);
+
+        m_pDoc->InsertRow(ScRange(0, 1500, 0, m_pDoc->MaxCol(), 2499, 0));
+        for (SCROW nRow = 1500; nRow < 2500; nRow += 7)
+        {
+            m_pDoc->SetString(ScAddress(0, nRow, 0), "new" + OUString::number(nRow));
+            m_pDoc->SetValue(ScAddress(1, nRow, 0), -nRow);
+        }
+        m_pDoc->SetString(ScAddress(0, 0, 0), u"first"_ustr);
+        m_pDoc->SetString(ScAddress(2, 4000, 0), u"appended"_ustr);
+        m_pDoc->SetString(ScAddress(0, 4000, 0), u"appended"_ustr);
+
+        OUStringBuffer aDump;
+        for (SCCOL nCol = 0; nCol < 3; ++nCol)
+            for (SCROW nRow = 0; nRow <= 4001; ++nRow)
+                aDump.append(OUString::number(static_cast<int>(m_pDoc->GetCellType(ScAddress(nCol, nRow, 0)))) + ":"
+                             + m_pDoc->GetString(nCol, nRow, 0) + "\n");
+        m_pDoc->DeleteTab(0);
+        return aDump.makeStringAndClear();
+    };
+    const OUString aKept = importAndEdit(false);
+    CPPUNIT_ASSERT_EQUAL(aKept, importAndEdit(true));
+    CPPUNIT_ASSERT(aKept.indexOf(u"1:new1500\n") >= 0);
+}
+
 CPPUNIT_PLUGIN_IMPLEMENT();
 
