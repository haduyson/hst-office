+constexpr OString aXml = "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n"_ostr;
+constexpr OString aRels = "http://schemas.openxmlformats.org/officeDocument/2006/relationships"_ostr;
+constexpr OString aMain = "application/vnd.openxmlformats-officedocument.spreadsheetml"_ostr;
+}
