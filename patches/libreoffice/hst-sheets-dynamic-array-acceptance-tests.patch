+CPPUNIT_TEST_FIXTURE(ScHstDynamicArrayAcceptanceTest, testSpillRangeOfOneCell)
+{
+    createScDoc();
+    // A dynamic array whose result is one cell is still a spill range (A1# is that cell)...
+    insertStringToCell(u"A1"_ustr, u"a");
+    insertStringToCell(u"A2"_ustr, u"a");
+    insertStringToCell(u"A3"_ustr, u"a");
+    insertStringToCell(u"C1"_ustr, u"=UNIQUE(A1:A3)");
+    insertStringToCell(u"D1"_ustr, u"=COUNTA(C1#)");
+    CPPUNIT_ASSERT_EQUAL(u"a"_ustr, str("C1"));
+    CPPUNIT_ASSERT_EQUAL(1.0, val("D1"));
+    // ... and it spills when its result grows.
+    insertStringToCell(u"A2"_ustr, u"b");
+    recalc();
+    CPPUNIT_ASSERT_EQUAL(u"b"_ustr, str("C2"));
+    CPPUNIT_ASSERT_EQUAL(2.0, val("D1"));
+
+    // A typed array function with a one-cell result is a dynamic array too.
+    getScDoc()->SetValue(ScAddress(4, 0, 0), 1.0);
+    getScDoc()->SetValue(ScAddress(4, 1, 0), 2.0);
+    getScDoc()->SetValue(ScAddress(4, 2, 0), 3.0);
+    insertStringToCell(u"G1"_ustr, u"=FILTER(E1:E3,E1:E3>2)");
+    CPPUNIT_ASSERT_EQUAL(3.0, val("G1"));
+    CPPUNIT_ASSERT(dynamicAnchor("G1"));
+    insertStringToCell(u"H1"_ustr, u"=ROWS(G1#)");
+    CPPUNIT_ASSERT_EQUAL(1.0, val("H1"));
+    insertStringToCell(u"E2"_ustr, u"5");
+    recalc();
+    CPPUNIT_ASSERT_EQUAL(5.0, val("G1"));
+    CPPUNIT_ASSERT_EQUAL(3.0, val("G2"));
+    CPPUNIT_ASSERT_EQUAL(2.0, val("H1"));
+
+    // A constant or a formula with a single value is not a spill range.
+    insertStringToCell(u"A6"_ustr, u"5");
+    insertStringToCell(u"B6"_ustr, u"=SUM(A6#)");
+    CPPUNIT_ASSERT_EQUAL(u"#REF!"_ustr, str("B6"));
+    insertStringToCell(u"A7"_ustr, u"=SUM(E1:E3)");
+    insertStringToCell(u"B7"_ustr, u"=SUM(A7#)");
+    CPPUNIT_ASSERT_EQUAL(u"#REF!"_ustr, str("B7"));
+    CPPUNIT_ASSERT(!dynamicAnchor("A7"));
+    // Nor is a legacy array formula (Ctrl+Shift+Enter on a selection).
+    insertArrayToCell(u"J1:J2"_ustr, u"=E1:E2");
+    CPPUNIT_ASSERT_EQUAL(5.0, val("J2"));
+    insertStringToCell(u"K1"_ustr, u"=SUM(J1#)");
+    CPPUNIT_ASSERT_EQUAL(u"#REF!"_ustr, str("K1"));
+}
+
+CPPUNIT_TEST_FIXTURE(ScHstDynamicArrayAcceptanceTest, testSpillBlockedByMergedCells)
+{
+    createScDoc();
+    getScDoc()->DoMerge(2, 1, 3, 2, 0); // C2:D3, empty
+    insertStringToCell(u"C1"_ustr, u"=SEQUENCE(3)");
+    CPPUNIT_ASSERT_EQUAL(u"#SPILL!"_ustr, str("C1"));
+    CPPUNIT_ASSERT(empty("C2"));
+    CPPUNIT_ASSERT(getScDoc()->HasAttrib(ScRange(2, 1, 0, 3, 2, 0), HasAttrFlags::Merged));
+
+    // Unmerged, the array spills.
+    goToCell(u"C2:D3"_ustr);
+    dispatchCommand(mxComponent, u".uno:SplitCell"_ustr, {});
+    CPPUNIT_ASSERT(!getScDoc()->HasAttrib(ScRange(2, 1, 0, 3, 2, 0), HasAttrFlags::Merged));
+    recalc();
+    CPPUNIT_ASSERT_EQUAL(1.0, val("C1"));
+    CPPUNIT_ASSERT_EQUAL(3.0, val("C3"));
+
+    // A merged cell outside the spill range does not matter.
+    getScDoc()->DoMerge(5, 1, 6, 1, 0); // F2:G2
+    insertStringToCell(u"E1"_ustr, u"=SEQUENCE(3)");
+    CPPUNIT_ASSERT_EQUAL(3.0, val("E3"));
+}
+
+CPPUNIT_TEST_FIXTURE(ScHstDynamicArrayAcceptanceTest, testSpillBlockedByTable)
+{
+    createScDoc();
+    // A Sheets table (a database range with a table style) at D4:E6, header row 4.
+    ScDocument* pDoc = getScDoc();
+    insertStringToCell(u"D4"_ustr, u"Name");
+    insertStringToCell(u"E4"_ustr, u"Price");
+    auto pTable = std::make_unique<ScDBData>(u"Table1"_ustr, 0, 3, 3, 4, 5);
+    ScTableStyleParam aStyle;
+    aStyle.maStyleID = u"TableStyleMedium2"_ustr;
+    pTable->SetTableStyleInfo(aStyle);
+    CPPUNIT_ASSERT(pDoc->GetDBCollection()->getNamedDBs().insert(std::move(pTable)));
+
+    // A spill range running into the table: #SPILL!, the table stays empty.
+    insertStringToCell(u"D1"_ustr, u"=SEQUENCE(5)");
+    CPPUNIT_ASSERT_EQUAL(u"#SPILL!"_ustr, str("D1"));
+    CPPUNIT_ASSERT(empty("D5"));
+    // An array typed inside the table: #SPILL!.
+    insertStringToCell(u"E5"_ustr, u"=SEQUENCE(2)");
+    CPPUNIT_ASSERT_EQUAL(u"#SPILL!"_ustr, str("E5"));
+    CPPUNIT_ASSERT(empty("E6"));
+    // A single value inside the table is an ordinary formula.
+    insertStringToCell(u"D5"_ustr, u"=1+1");
+    CPPUNIT_ASSERT_EQUAL(2.0, val("D5"));
+    // A database range without a table style is not a table: the array spills over it.
+    CPPUNIT_ASSERT(pDoc->GetDBCollection()->getNamedDBs().insert(
+        std::make_unique<ScDBData>(u"Plain"_ustr, 0, 7, 3, 7, 5)));
+    insertStringToCell(u"H1"_ustr, u"=SEQUENCE(5)");
+    CPPUNIT_ASSERT_EQUAL(5.0, val("H5"));
+}
