+CPPUNIT_TEST_FIXTURE(ScHstDynamicArrayAcceptanceTest, testXlsxExport)
+{
+    createScDoc();
+    for (int i = 0; i < 5; ++i)
+        getScDoc()->SetValue(ScAddress(0, i, 0), i + 1.0);
+    insertStringToCell(u"C1"_ustr, u"=SEQUENCE(3)");
+    insertStringToCell(u"D1"_ustr, u"=SUM(C1#)");
+    insertStringToCell(u"E3"_ustr, u"=@A1:A5+1");
+    insertArrayToCell(u"G1:G2"_ustr, u"=A1:A2*2"); // Ctrl+Shift+Enter on a selection: legacy
+
+    saveAndReload(TestFilter::XLSX);
+    xmlDocUniquePtr pSheet = parseExport(u"xl/worksheets/sheet1.xml"_ustr);
+    CPPUNIT_ASSERT(pSheet);
+    assertXPath(pSheet, "/x:worksheet/x:sheetData/x:row[1]/x:c[@r='C1']", "cm", u"1");
+    assertXPath(pSheet, "/x:worksheet/x:sheetData/x:row[1]/x:c[@r='C1']/x:f", "t", u"array");
+    assertXPath(pSheet, "/x:worksheet/x:sheetData/x:row[1]/x:c[@r='C1']/x:f", "ref", u"C1:C3");
+    assertXPathContent(pSheet, "/x:worksheet/x:sheetData/x:row[1]/x:c[@r='D1']/x:f",
+                       u"SUM(_xlfn.ANCHORARRAY(C1))");
+    assertXPathContent(pSheet, "/x:worksheet/x:sheetData/x:row[3]/x:c[@r='E3']/x:f",
+                       u"_xlfn.SINGLE(A1:A5)+1");
+    assertXPathNoAttribute(pSheet, "/x:worksheet/x:sheetData/x:row[1]/x:c[@r='G1']", "cm");
+    xmlDocUniquePtr pMetadata = parseExport(u"xl/metadata.xml"_ustr);
+    CPPUNIT_ASSERT(pMetadata);
