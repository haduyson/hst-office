+    CPPUNIT_ASSERT_EQUAL(u"=SUM(C1#)"_ustr, formula("D1"));
+    CPPUNIT_ASSERT_EQUAL(4.0, val("E3"));
+    CPPUNIT_ASSERT_EQUAL(u"=@A1:A5+1"_ustr, formula("E3"));
+}
