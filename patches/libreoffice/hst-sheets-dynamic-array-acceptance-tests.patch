+CPPUNIT_TEST_FIXTURE(ScHstDynamicArrayAcceptanceTest, testAnyArrayResultSpills)
+{
+    createScDoc();
+    for (int i = 0; i < 4; ++i)
+        getScDoc()->SetValue(ScAddress(1, i, 0), 10.0 * (i + 1));
+
+    insertStringToCell(u"D1"_ustr, u"=B1:B4*2");
+    CPPUNIT_ASSERT_EQUAL(20.0, val("D1"));
+    CPPUNIT_ASSERT_EQUAL(80.0, val("D4"));
+    CPPUNIT_ASSERT(dynamicAnchor("D1"));
+    CPPUNIT_ASSERT_EQUAL(ScMatrixMode::Reference, formulaCell("D2")->GetMatrixFlag());
+    // The spill range is not left selected.
+    CPPUNIT_ASSERT(!getViewShell()->GetViewData().GetMarkData().IsMarked());
+
+    // A single value does not spill.
+    insertStringToCell(u"F1"_ustr, u"=SUM(B1:B4)");
+    CPPUNIT_ASSERT_EQUAL(100.0, val("F1"));
+    CPPUNIT_ASSERT_EQUAL(ScMatrixMode::NONE, formulaCell("F1")->GetMatrixFlag());
+    CPPUNIT_ASSERT(empty("F2"));
+
+    // One undo step each removes a formula with its spill range.
+    getScDocShell()->GetUndoManager()->Undo();
+    getScDocShell()->GetUndoManager()->Undo();
+    CPPUNIT_ASSERT(empty("D1"));
+    CPPUNIT_ASSERT(empty("D4"));
+}
+
+CPPUNIT_TEST_FIXTURE(ScHstDynamicArrayAcceptanceTest, testSpillBlockedAndRecovered)
+{
+    createScDoc();
+    for (int i = 0; i < 4; ++i)
+        getScDoc()->SetValue(ScAddress(1, i, 0), 10.0 * (i + 1));
+    insertStringToCell(u"D3"_ustr, u"x");
+
+    insertStringToCell(u"D1"_ustr, u"=B1:B4*2");
+    CPPUNIT_ASSERT_EQUAL(u"#SPILL!"_ustr, str("D1"));
+    CPPUNIT_ASSERT_EQUAL(u"x"_ustr, str("D3"));
+    CPPUNIT_ASSERT(empty("D2"));
+
+    clearCell(u"D3"_ustr);
+    recalc();
+    CPPUNIT_ASSERT_EQUAL(20.0, val("D1"));
+    CPPUNIT_ASSERT_EQUAL(60.0, val("D3"));
+
+    // Another array formula in the way gives #SPILL!, not an error dialog.
+    insertStringToCell(u"G2"_ustr, u"=SEQUENCE(3)");
+    insertStringToCell(u"G1"_ustr, u"=SEQUENCE(3)");
+    CPPUNIT_ASSERT_EQUAL(u"#SPILL!"_ustr, str("G1"));
+    CPPUNIT_ASSERT_EQUAL(1.0, val("G2"));
+    CPPUNIT_ASSERT_EQUAL(3.0, val("G4"));
+}
+
+CPPUNIT_TEST_FIXTURE(ScHstDynamicArrayAcceptanceTest, testTypedSpillFollowsResultSize)
+{
+    createScDoc();
+    insertStringToCell(u"A1"_ustr, u"a");
+    insertStringToCell(u"A2"_ustr, u"b");
+    insertStringToCell(u"A3"_ustr, u"a");
+    insertStringToCell(u"C1"_ustr, u"=UNIQUE(A1:A3)");
+    CPPUNIT_ASSERT_EQUAL(u"b"_ustr, str("C2"));
+    CPPUNIT_ASSERT(empty("C3"));
+
+    insertStringToCell(u"A3"_ustr, u"c");
+    recalc();
+    CPPUNIT_ASSERT_EQUAL(u"c"_ustr, str("C3"));
+
+    insertStringToCell(u"A2"_ustr, u"a");
+    insertStringToCell(u"A3"_ustr, u"a");
+    recalc();
+    CPPUNIT_ASSERT_EQUAL(u"a"_ustr, str("C1"));
+    CPPUNIT_ASSERT(empty("C2"));
+    CPPUNIT_ASSERT(empty("C3"));
+}
+
+CPPUNIT_TEST_FIXTURE(ScHstDynamicArrayAcceptanceTest, testSpillRangeOperator)
+{
+    createScDoc();
+    insertStringToCell(u"A1"_ustr, u"=SEQUENCE(4)");
+    insertStringToCell(u"C1"_ustr, u"=SUM(A1#)");
+    CPPUNIT_ASSERT_EQUAL(10.0, val("C1"));
+    CPPUNIT_ASSERT_EQUAL(u"=SUM(A1#)"_ustr, formula("C1"));
+    insertStringToCell(u"D1"_ustr, u"=A1#*10");
+    CPPUNIT_ASSERT_EQUAL(40.0, val("D4"));
+    insertStringToCell(u"E1"_ustr, u"=COUNT($A$1#)");
+    CPPUNIT_ASSERT_EQUAL(4.0, val("E1"));
+    CPPUNIT_ASSERT_EQUAL(u"=COUNT($A$1#)"_ustr, formula("E1"));
+
+    // The spill range follows the anchor's result.
+    insertStringToCell(u"A1"_ustr, u"=SEQUENCE(5)");
+    recalc();
+    CPPUNIT_ASSERT_EQUAL(15.0, val("C1"));
+    CPPUNIT_ASSERT_EQUAL(50.0, val("D5"));
+
+    // No array at the anchor.
+    insertStringToCell(u"F1"_ustr, u"=SUM(H1#)");
+    CPPUNIT_ASSERT_EQUAL(u"#REF!"_ustr, str("F1"));
+    // Error constants keep their meaning.
+    insertStringToCell(u"F2"_ustr, u"=ISNA(#N/A)");
+    CPPUNIT_ASSERT_EQUAL(1.0, val("F2"));
+    CPPUNIT_ASSERT_EQUAL(u"=ISNA(#N/A)"_ustr, formula("F2"));
+}
+
+CPPUNIT_TEST_FIXTURE(ScHstDynamicArrayAcceptanceTest, testSingleValueOperator)
+{
+    createScDoc();
+    for (int i = 0; i < 5; ++i)
+        getScDoc()->SetValue(ScAddress(0, i, 0), i + 1.0);
+    insertStringToCell(u"C3"_ustr, u"=@A1:A5");
+    CPPUNIT_ASSERT_EQUAL(3.0, val("C3"));
+    CPPUNIT_ASSERT(empty("C4"));
+    CPPUNIT_ASSERT_EQUAL(u"=@A1:A5"_ustr, formula("C3"));
+    insertStringToCell(u"D1"_ustr, u"=@SEQUENCE(4)");
+    CPPUNIT_ASSERT_EQUAL(1.0, val("D1"));
+    CPPUNIT_ASSERT(empty("D2"));
+    insertStringToCell(u"C7"_ustr, u"=@A1:A5");
+    CPPUNIT_ASSERT_EQUAL(u"#VALUE!"_ustr, str("C7"));
+}
