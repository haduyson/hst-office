+// HST Office: acceptance tests of the dynamic arrays of Sheets, written from the behaviour spec
+// (independent of the engine's own tests): any array result spills when typed, #SPILL!, the spill
+// range operator A1# (also of a one-cell result), the @ operator, merged cells and tables blocking a
+// spill, .xlsx cm metadata, _xlfn.ANCHORARRAY and _xlfn.SINGLE. The
+// .xlsx fixture is written the way the leading spreadsheet application writes its files
+// (ECMA-376 / MS-XLSX); Spill.xlsx was saved by that application.
+
+#include "../helper/qahelper.hxx"
+
+#include <comphelper/propertyvalue.hxx>
+#include <rtl/crc.h>
+#include <tools/stream.hxx>
+#include <vcl/scheduler.hxx>
+#include <dbdata.hxx>
+#include <docsh.hxx>
+#include <document.hxx>
+#include <formulacell.hxx>
+#include <tabvwsh.hxx>
+#include <undomanager.hxx>
+#include <viewdata.hxx>
+
+#include <utility>
+#include <vector>
+
+namespace
+{
+class ScHstDynamicArrayAcceptanceTest : public ScModelTestBase
+{
+public:
+    ScHstDynamicArrayAcceptanceTest()
+        : ScModelTestBase(u"sc/qa/unit/data"_ustr)
+    {
+    }
+
+protected:
+    ScAddress pos(const char* pCell)
+    {
+        ScAddress aPos;
+        aPos.Parse(OUString::createFromAscii(pCell), *getScDoc());
+        return aPos;
+    }
+    ScFormulaCell* formulaCell(const char* pCell) { return getScDoc()->GetFormulaCell(pos(pCell)); }
+    OUString str(const char* pCell) { return getScDoc()->GetString(pos(pCell)); }
+    double val(const char* pCell) { return getScDoc()->GetValue(pos(pCell)); }
+    bool empty(const char* pCell) { return getScDoc()->GetCellType(pos(pCell)) == CELLTYPE_NONE; }
+    OUString formula(const char* pCell)
+    {
+        const ScAddress aPos = pos(pCell);
+        return getScDoc()->GetFormula(aPos.Col(), aPos.Row(), aPos.Tab());
+    }
+    bool dynamicAnchor(const char* pCell)
+    {
+        const ScFormulaCell* pFormula = formulaCell(pCell);
+        return pFormula && pFormula->GetMatrixFlag() == ScMatrixMode::Formula
+               && pFormula->IsDynamicArrayMaster();
+    }
+    void recalc()
+    {
+        getScDoc()->CalcAll();
+        Scheduler::ProcessEventsToIdle();
+    }
+};
+
+/// Writes a zip archive of stored (uncompressed) entries: enough for a minimal .xlsx.
+void writeStoredZip(const OUString& rURL, const std::vector<std::pair<OString, OString>>& rEntries)
+{
+    SvFileStream aStream(rURL, StreamMode::WRITE | StreamMode::TRUNC);
+    aStream.SetEndian(SvStreamEndian::LITTLE);
+    std::vector<sal_uInt32> aOffsets;
+    for (const auto& [rName, rData] : rEntries)
+    {
+        aOffsets.push_back(aStream.Tell());
+        const sal_uInt32 nCrc = rtl_crc32(0, rData.getStr(), rData.getLength());
+        aStream.WriteUInt32(0x04034b50).WriteUInt16(20).WriteUInt16(0).WriteUInt16(0);
+        aStream.WriteUInt16(0).WriteUInt16(0x21).WriteUInt32(nCrc);
+        aStream.WriteUInt32(rData.getLength()).WriteUInt32(rData.getLength());
+        aStream.WriteUInt16(rName.getLength()).WriteUInt16(0);
+        aStream.WriteBytes(rName.getStr(), rName.getLength());
+        aStream.WriteBytes(rData.getStr(), rData.getLength());
+    }
+    const sal_uInt32 nDirStart = aStream.Tell();
+    for (size_t i = 0; i < rEntries.size(); ++i)
+    {
+        const auto& [rName, rData] = rEntries[i];
+        const sal_uInt32 nCrc = rtl_crc32(0, rData.getStr(), rData.getLength());
+        aStream.WriteUInt32(0x02014b50).WriteUInt16(20).WriteUInt16(20).WriteUInt16(0).WriteUInt16(0);
+        aStream.WriteUInt16(0).WriteUInt16(0x21).WriteUInt32(nCrc);
+        aStream.WriteUInt32(rData.getLength()).WriteUInt32(rData.getLength());
+        aStream.WriteUInt16(rName.getLength()).WriteUInt16(0).WriteUInt16(0);
+        aStream.WriteUInt16(0).WriteUInt16(0).WriteUInt32(0).WriteUInt32(aOffsets[i]);
+        aStream.WriteBytes(rName.getStr(), rName.getLength());
+    }
+    const sal_uInt32 nDirSize = aStream.Tell() - nDirStart;
+    aStream.WriteUInt32(0x06054b50).WriteUInt16(0).WriteUInt16(0);
+    aStream.WriteUInt16(rEntries.size()).WriteUInt16(rEntries.size());
+    aStream.WriteUInt32(nDirSize).WriteUInt32(nDirStart).WriteUInt16(0);
+    CPPUNIT_ASSERT_EQUAL(ERRCODE_NONE, aStream.GetError());
+}
