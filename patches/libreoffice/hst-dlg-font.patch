+void SvxCharNamePage::HstEscapementFromSet(const SfxItemSet& rSet)
+{
+    const sal_uInt16 nWhich = GetWhich(SID_ATTR_CHAR_ESCAPEMENT);
+    const SfxItemState eState = rSet.GetItemState(nWhich);
+    // Calc cells have no superscript or subscript: the options go away with the item.
+    const bool bAvailable = eState != SfxItemState::UNKNOWN && eState != SfxItemState::DISABLED;
+    m_xHstSuperscript->set_visible(bAvailable);
+    m_xHstSubscript->set_visible(bAvailable);
+    bool bSuper = false, bSub = false;
+    if (eState >= SfxItemState::DEFAULT)
+    {
+        const short nEsc = static_cast<const SvxEscapementItem&>(rSet.Get(nWhich)).GetEsc();
+        bSuper = nEsc > 0;
+        bSub = nEsc < 0;
+    }
+    m_xHstSuperscript->set_active(bSuper);
+    m_xHstSubscript->set_active(bSub);
+    m_xHstSuperscript->save_state();
+    m_xHstSubscript->save_state();
+    HstEscapementPreview();
+}
+
+void SvxCharNamePage::HstEscapementPreview()
+{
+    if (m_xHstSuperscript->get_active())
+        SetPrevFontEscapement(100, DFLT_ESC_PROP, DFLT_ESC_SUPER);
+    else if (m_xHstSubscript->get_active())
+        SetPrevFontEscapement(100, DFLT_ESC_PROP, DFLT_ESC_SUB);
+    else
+        SetPrevFontEscapement(100, 100, 0);
+    m_aPreviewWin.Invalidate();
+}
+
+IMPL_LINK(SvxCharNamePage, HstEscapementHdl, weld::Toggleable&, rButton, void)
+{
+    // A character is one or the other, as in Word.
+    if (rButton.get_active())
+    {
+        if (&rButton == m_xHstSuperscript.get())
+            m_xHstSubscript->set_active(false);
+        else
+            m_xHstSuperscript->set_active(false);
+    }
+    HstEscapementPreview();
+}
