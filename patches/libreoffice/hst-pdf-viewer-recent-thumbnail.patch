+/// Largest side of a Start Center thumbnail, as for the documents HST Office opens itself.
+constexpr int THUMBNAIL_EXTENT = 512;
+
+/// The Start Center "Recent documents" thumbnail of the first page, drawn by PDFium like the
+/// pages of this window, so a translucent watermark or signature stamp looks as faint there as in
+/// the open file. Empty (the generic icon) for a file that needed a password, as for other
+/// encrypted documents. No value when thumbnails are off: an existing one is kept.
+std::optional<OUString> recentDocumentThumbnail(PdfViewerDocument& rDocument, bool bPassword)
+{
+    if (Application::IsHeadlessModeEnabled()
+        || !officecfg::Office::Common::History::RecentDocsThumbnail::get())
+        return std::nullopt;
+    if (bPassword)
+        return OUString();
+    const basegfx::B2DSize aPage = rDocument.getPageSize(0);
+    const double fScale = THUMBNAIL_EXTENT / std::max(aPage.getWidth(), aPage.getHeight());
+    const int nWidth = std::max(1, static_cast<int>(std::lround(aPage.getWidth() * fScale)));
+    const int nHeight = std::max(1, static_cast<int>(std::lround(aPage.getHeight() * fScale)));
+    const Bitmap aBitmap = rDocument.renderPage(0, nWidth, nHeight);
+    if (aBitmap.IsEmpty())
+        return OUString();
+    SvMemoryStream aStream(65535, 65535);
+    vcl::PngImageWriter aWriter(aStream);
+    if (!aWriter.write(Graphic(aBitmap)))
+        return OUString();
+    OUStringBuffer aBuffer;
+    comphelper::Base64::encode(
+        aBuffer, uno::Sequence<sal_Int8>(static_cast<const sal_Int8*>(aStream.GetData()),
+                                         aStream.Tell()));
+    return aBuffer.makeStringAndClear();
+}
