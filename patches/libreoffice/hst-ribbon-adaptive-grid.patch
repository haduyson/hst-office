+// HST Office: the even grid of a ribbon toolbox at its medium/small size (HstRibbonGrid.hxx); item sizes
+// from ImplCalcItem, rows 24 logical px high with 2 px between them, as Office's 3-row columns.
+hst::ribbon::GridLayout ImplHstGrid(const ToolBox& rToolBox, const ImplToolBoxPrivateData& rData)
+{
+    const double fDpi = rToolBox.GetDPIScaleFactor();
+    std::vector<hst::ribbon::GridItem> aItems;
+    aItems.reserve(rData.m_aItems.size());
+    for (const ImplToolItem& rItem : rData.m_aItems)
+    {
+        hst::ribbon::GridItem aItem;
+        aItem.visible = rItem.mbVisible;
+        aItem.separator = rItem.meType == ToolBoxItemType::SEPARATOR;
+        if (rItem.meType == ToolBoxItemType::BUTTON || rItem.meType == ToolBoxItemType::SPACE)
+        {
+            aItem.w = rItem.maItemSize.Width();
+            aItem.h = rItem.maItemSize.Height();
+        }
+        else if (!aItem.separator)
+            aItem.visible = false; // breaks have no place in a grid
+        aItems.push_back(aItem);
+    }
+    return hst::ribbon::gridLayout(aItems, rData.mnHstGridRows, std::lround(24 * fDpi), std::lround(2 * fDpi),
+                                   std::lround(2 * fDpi), std::lround(7 * fDpi));
+}
