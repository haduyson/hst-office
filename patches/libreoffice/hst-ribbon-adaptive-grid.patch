+/// Grid attachments of a group's children as authored, kept while the window lives.
+struct AuthoredCells
+{
+    static std::map<const vcl::Window*, GroupCell>& cells()
+    {
+        static std::map<const vcl::Window*, GroupCell> aCells;
+        return aCells;
+    }
+    DECL_STATIC_LINK(AuthoredCells, DyingHdl, VclWindowEvent&, void);
+};
+
+IMPL_STATIC_LINK(AuthoredCells, DyingHdl, VclWindowEvent&, rEvent, void)
+{
+    if (rEvent.GetId() == VclEventId::ObjectDying)
+        AuthoredCells::cells().erase(rEvent.GetWindow());
+}
+
+GroupCell authoredCell(vcl::Window& rChild)
+{
+    auto& rCells = AuthoredCells::cells();
+    auto it = rCells.find(&rChild);
+    if (it == rCells.end())
+    {
+        GroupCell aCell{ rChild.get_grid_left_attach(), rChild.get_grid_top_attach(), rChild.get_grid_width(),
+                         rChild.get_grid_height(), false, false };
+        aCell.caption = dynamic_cast<FixedText*>(&rChild) && aCell.top == 2;
+        it = rCells.emplace(&rChild, aCell).first;
+        rChild.AddEventListener(LINK(nullptr, AuthoredCells, DyingHdl));
+    }
+    return it->second;
+}
+
+void attach(vcl::Window& rChild, const GroupCell& rCell)
+{
+    if (rChild.get_grid_left_attach() != rCell.left)
+        rChild.set_grid_left_attach(rCell.left);
+    if (rChild.get_grid_top_attach() != rCell.top)
+        rChild.set_grid_top_attach(rCell.top);
+    if (rChild.get_grid_width() != rCell.width)
+        rChild.set_grid_width(rCell.width);
+    if (rChild.get_grid_height() != rCell.height)
+        rChild.set_grid_height(rCell.height);
+}
+
+/** The large buttons of a group that stand alone in their columns (one toolbox each) form Office's 3-row
+    columns at the medium and small size (HstRibbonGrid.hxx stackGroup); the large size restores the authored
+    grid. Paste and the buttons of a group of few commands stay large. */
+void stackLargeButtons(vcl::Window& rGroup, int nState, bool bFewCommands)
+{
+    VclGrid* pGrid = dynamic_cast<VclGrid*>(&rGroup);
+    for (vcl::Window* pChild = rGroup.GetWindow(GetWindowType::FirstChild); !pGrid && pChild;
+         pChild = pChild->GetWindow(GetWindowType::Next))
+        pGrid = dynamic_cast<VclGrid*>(pChild);
+    if (!pGrid)
+        return;
+    std::vector<vcl::Window*> aChildren;
+    std::vector<GroupCell> aCells;
+    for (vcl::Window* pChild = pGrid->GetWindow(GetWindowType::FirstChild); pChild;
+         pChild = pChild->GetWindow(GetWindowType::Next))
+    {
+        GroupCell aCell = authoredCell(*pChild);
+        if (ToolBox* pToolBox = dynamic_cast<ToolBox*>(pChild))
+        {
+            const ImplToolBoxPrivateData& rData = *pToolBox->ImplGetToolBoxPrivateData();
+            aCell.stackable = !bFewCommands && rData.mbHstAuthored && !rData.mbHstKeepLarge
+                              && rData.meHstAuthoredSize == ToolBoxButtonSize::Large && commandCount(*pToolBox) == 1
+                              && aCell.top == 0 && aCell.height == 2;
+        }
+        aChildren.push_back(pChild);
+        aCells.push_back(aCell);
+    }
+    if (nState == GroupMedium || nState == GroupSmall)
+        stackGroup(aCells);
+    for (std::size_t i = 0; i < aChildren.size(); ++i)
+        attach(*aChildren[i], aCells[i]);
+}
