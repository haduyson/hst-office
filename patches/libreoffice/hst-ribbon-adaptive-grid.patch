+// HST Office: the label of a large ribbon button (text below its image) in at most two lines: one wider than
+// hst::ribbon::LABEL_WRAP logical px breaks at the space that makes its wider line the narrowest, as Office's
+// two-line labels; authored line breaks are kept. Other toolboxes and positions keep their text.
+OUString ImplHstLabel(const ToolBox& rToolBox, const ImplToolBoxPrivateData& rData, const OUString& rText,
+                      ToolBoxTextPosition ePosition)
+{
+    if (!rData.mbHstOwnerDraw || ePosition != ToolBoxTextPosition::Bottom || rText.indexOf('\n') >= 0)
+        return rText;
+    const OutputDevice& rDev = *rToolBox.GetOutDev();
+    if (rDev.GetCtrlTextWidth(rText) <= std::lround(hst::ribbon::LABEL_WRAP * rToolBox.GetDPIScaleFactor()))
+        return rText;
+    sal_Int32 nBest = -1;
+    tools::Long nBestWidth = 0;
+    for (sal_Int32 i = rText.indexOf(' '); i > 0; i = rText.indexOf(' ', i + 1))
+    {
+        const tools::Long nWidth = std::max(rDev.GetCtrlTextWidth(rText.copy(0, i)),
+                                            rDev.GetCtrlTextWidth(rText.copy(i + 1)));
+        if (nBest < 0 || nWidth < nBestWidth)
+        {
+            nBest = i;
+            nBestWidth = nWidth;
+        }
+    }
+    return nBest < 0 ? rText : rText.replaceAt(nBest, 1, u"\n");
+}
