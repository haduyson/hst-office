+{
+/// Logical px over which a large button's label wraps to a second line (at its most balanced space).
+constexpr long LABEL_WRAP = 62;
+
+struct GridItem
+{
+    long w = 0;
+    long h = 0;
+    bool separator = false;
+    bool visible = true;
+};
+
+struct GridCell
+{
+    long x = 0;
+    long y = 0;
+    long w = 0;
+    long h = 0;
+};
+
+struct GridLayout
+{
+    std::vector<GridCell> cells; // one per item, empty (0 x 0) for hidden items
+    long width = 0;
+    long height = 0;
+};
+
+/** Lay out rItems in an even grid of nRows rows nRowHeight high (at least the tallest item), nRowGap
+    between rows, nColumnGap between columns and nSeparator wide separators. */
+/** One child of a ribbon group's grid (GtkGrid attachments). The authored groups put their content in rows 0
+    and 1 (a large button spans both) and the caption in row 2. */
+struct GroupCell
+{
+    int left = 0;
+    int top = 0;
+    int width = 1;
+    int height = 1;
+    bool stackable = false; // a large button alone in its column (top 0, two rows high) that may become small
+    bool caption = false;
+};
+
+/** At the medium and small size, consecutive stackable large buttons of a group stand in columns of nRows
+    small buttons, top to bottom then left to right (Office's 3-row columns); the following columns move left,
+    the caption moves below the third row over the columns it spanned, and what stood across both content rows (the
+    large buttons that stay large) or across the content and the caption (separators) grows by a row.
+    Returns false (rCells unchanged) when no two stackable buttons stand next to each other. */
+inline bool stackGroup(std::vector<GroupCell>& rCells, int nRows = 3)
+{
+    constexpr int CONTENT_ROWS = 2;
+    const std::vector<GroupCell> aAuthored = rCells;
+    int nMaxColumn = -1;
+    for (const GroupCell& rCell : aAuthored)
+        if (!rCell.caption)
+            nMaxColumn = std::max(nMaxColumn, rCell.left + rCell.width - 1);
+    if (nMaxColumn < 0)
+        return false;
+    // a column is a slot when its only child is a stackable large button; slots next to slots are stacked
+    std::vector<int> aCount(nMaxColumn + 1, 0), aButton(nMaxColumn + 1, -1);
+    for (std::size_t i = 0; i < aAuthored.size(); ++i)
+    {
+        const GroupCell& rCell = aAuthored[i];
+        if (rCell.caption)
+            continue;
+        for (int c = rCell.left; c < rCell.left + rCell.width; ++c)
+            ++aCount[c];
+        if (rCell.stackable && rCell.width == 1)
+            aButton[rCell.left] = static_cast<int>(i);
+    }
+    auto slot = [&](int c) { return c >= 0 && c <= nMaxColumn && aCount[c] == 1 && aButton[c] >= 0; };
+    auto stacked = [&](int c) { return slot(c) && (slot(c - 1) || slot(c + 1)); };
+    bool bAny = false;
+    for (int c = 0; c <= nMaxColumn; ++c)
+        bAny = bAny || stacked(c);
+    if (!bAny)
+        return false;
+
+    std::vector<int> aMap(nMaxColumn + 1, 0), aRow(nMaxColumn + 1, 0);
+    int nNext = 0; // next free column
+    int nInStack = 0; // buttons in the open stack column; 0 when none is open
+    int nStackColumn = 0;
+    for (int c = 0; c <= nMaxColumn; ++c)
+    {
+        if (!stacked(c))
+        {
+            nInStack = 0;
+            aMap[c] = nNext++;
+            continue;
+        }
+        if (nInStack == 0 || nInStack == nRows)
+        {
+            nStackColumn = nNext++;
+            nInStack = 0;
+        }
+        aMap[c] = nStackColumn;
+        aRow[c] = nInStack++;
+    }
+    for (std::size_t i = 0; i < aAuthored.size(); ++i)
+    {
+        const GroupCell& rOld = aAuthored[i];
+        GroupCell& rCell = rCells[i];
+        if (rOld.caption)
+        {
+            // the caption keeps the columns it spanned, now fewer, below the third row
+            const int nLast = std::min(rOld.left + rOld.width - 1, nMaxColumn);
+            const int nFirst = std::min(rOld.left, nMaxColumn);
+            rCell = GroupCell{ aMap[nFirst], nRows, aMap[nLast] - aMap[nFirst] + 1, rOld.height, false, true };
+        }
+        else if (stacked(rOld.left) && aButton[rOld.left] == static_cast<int>(i))
+            rCell = GroupCell{ aMap[rOld.left], aRow[rOld.left], 1, 1, true, false };
+        else
+        {
+            rCell.left = aMap[rOld.left];
+            rCell.width = aMap[rOld.left + rOld.width - 1] - aMap[rOld.left] + 1;
+            if (rOld.top == 0 && rOld.height == CONTENT_ROWS)
+                rCell.height = nRows; // a large button that stays large spans the three rows
+            else if (rOld.top == 0 && rOld.height == CONTENT_ROWS + 1)
+                rCell.height = nRows + 1; // a separator spans the rows and the caption
+        }
+    }
+    return true;
+}
+
+inline GridLayout gridLayout(const std::vector<GridItem>& rItems, int nRows, long nRowHeight, long nRowGap,
+                             long nColumnGap, long nSeparator)
+{
+    GridLayout aLayout;
+    aLayout.cells.resize(rItems.size());
+    if (nRows < 1)
+        nRows = 1;
+    long nRow = nRowHeight;
+    for (const GridItem& rItem : rItems)
+        if (rItem.visible && !rItem.separator)
+            nRow = std::max(nRow, rItem.h);
+    aLayout.height = nRows * nRow + (nRows - 1) * nRowGap;
+
+    long nX = 0; // left edge of the current column
+    long nColumnWidth = 0; // widest item of the current column, 0 while the column is empty
+    int nInColumn = 0;
+    auto closeColumn = [&]() {
+        if (nInColumn == 0)
+            return;
+        nX += nColumnWidth + nColumnGap;
+        nColumnWidth = 0;
+        nInColumn = 0;
+    };
+    for (std::size_t i = 0; i < rItems.size(); ++i)
+    {
+        const GridItem& rItem = rItems[i];
+        if (!rItem.visible)
+            continue;
+        if (rItem.separator)
+        {
+            closeColumn();
+            if (nX == 0)
+                continue; // no separator before the first column
+            aLayout.cells[i] = GridCell{ nX, 0, nSeparator, aLayout.height };
+            nX += nSeparator + nColumnGap;
+            continue;
+        }
+        if (nInColumn == nRows)
+            closeColumn();
+        aLayout.cells[i] = GridCell{ nX, nInColumn * (nRow + nRowGap), rItem.w, nRow };
+        nColumnWidth = std::max(nColumnWidth, rItem.w);
+        ++nInColumn;
+    }
+    if (nInColumn > 0)
+        aLayout.width = nX + nColumnWidth;
+    else
+        aLayout.width = std::max(0L, nX - nColumnGap);
+    // a trailing separator does not stand alone at the right end
+    for (std::size_t i = rItems.size(); i-- > 0;)
+    {
+        if (!rItems[i].visible)
+            continue;
+        if (rItems[i].separator && aLayout.cells[i].w > 0 && aLayout.cells[i].x + aLayout.cells[i].w >= aLayout.width)
+        {
+            aLayout.width = aLayout.cells[i].x > nColumnGap ? aLayout.cells[i].x - nColumnGap : 0;
+            aLayout.cells[i] = GridCell{};
+        }
+        break;
+    }
+    return aLayout;
+}
