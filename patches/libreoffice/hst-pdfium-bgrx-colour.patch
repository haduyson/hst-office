HST PDF: red stays red. A PDFium page bitmap without alpha is BGRx, not RGBx.

PDFium documents FPDFBitmap_BGRx as 4 bytes per pixel in the order blue, green, red, unused, and
FPDFBitmap_Create(w, h, 0) returns that format. The conversion to a VCL Bitmap read it as
N32BitTcRgbx, so red and blue were swapped. Upstream callers always ask for alpha and take the BGRA
branch; HST PDF renders pages without alpha, so every red stamp, red text and scanned page showed
blue on screen, in thumbnails and in print.

The test fills a red and a blue rectangle in a PDFium bitmap with and without alpha and checks the
converted pixels. HSTPdfInfo with RenderPage also reports RenderRedPixels and RenderBluePixels,
which the runtime check uses on real stamp PDFs; RenderDpi renders the page at another resolution
and RenderFile saves that page bitmap as PNG, to compare it with other renderers.

License: modified upstream files keep their license (MPL-2.0).

--- a/vcl/qa/cppunit/PDFiumLibraryTest.cxx
+++ b/vcl/qa/cppunit/PDFiumLibraryTest.cxx
@@ -27,6 +27,7 @@
 #include <vcl/filter/PDFiumLibrary.hxx>
 #include <vcl/pdf/PDFAnnotationMarker.hxx>
 #include <vcl/pdf/PDFAnnotationSubType.hxx>
+#include <vcl/pdf/PDFBitmapType.hxx>
 #include <vcl/pdf/PDFPageObjectType.hxx>
 #include <vcl/pdf/PDFTextRenderMode.hxx>
 #include <vcl/pdfread.hxx>
@@ -637,6 +638,34 @@ CPPUNIT_TEST_FIXTURE(PDFiumLibraryTest, testStructureTree)
     }
 }
 
+CPPUNIT_TEST_FIXTURE(PDFiumLibraryTest, testBitmapColourChannels)
+{
+    // A page bitmap converted to a Bitmap keeps red red and blue blue, with and without alpha:
+    // without alpha PDFium hands out BGRx, with alpha BGRA.
+    auto pPdfium = vcl::pdf::PDFiumLibrary::get();
+    CPPUNIT_ASSERT(pPdfium);
+    for (int nAlpha : { 0, 1 })
+    {
+        int nWidth = 8;
+        int nHeight = 4;
+        std::unique_ptr<vcl::pdf::PDFiumBitmap> pPdfBitmap
+            = pPdfium->createBitmap(nWidth, nHeight, nAlpha);
+        CPPUNIT_ASSERT(pPdfBitmap);
+        CPPUNIT_ASSERT(pPdfBitmap->getFormat()
+                       == (nAlpha ? vcl::pdf::PDFBitmapType::BGRA : vcl::pdf::PDFBitmapType::BGRx));
+        // PDFium colours are 0xAARRGGBB
+        pPdfBitmap->fillRect(0, 0, 4, nHeight, 0xFFFF0000);
+        pPdfBitmap->fillRect(4, 0, 4, nHeight, 0xFF0000FF);
+        Bitmap aBitmap = pPdfBitmap->createBitmapFromBuffer();
+        CPPUNIT_ASSERT_EQUAL(Size(nWidth, nHeight), aBitmap.GetSizePixel());
+        CPPUNIT_ASSERT_EQUAL_MESSAGE(nAlpha ? "red, BGRA" : "red, BGRx", Color(0xFF, 0x00, 0x00).GetRGBColor(),
+                                     aBitmap.GetPixelColor(1, 1).GetRGBColor());
+        CPPUNIT_ASSERT_EQUAL_MESSAGE(nAlpha ? "blue, BGRA" : "blue, BGRx",
+                                     Color(0x00, 0x00, 0xFF).GetRGBColor(),
+                                     aBitmap.GetPixelColor(6, 2).GetRGBColor());
+    }
+}
+
 CPPUNIT_PLUGIN_IMPLEMENT();
 
