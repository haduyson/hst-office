+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * Part of HST Office. This file is HST's own work and is not covered by the MPL.
+ */
+
+#pragma once
+
+#include <tools/color.hxx>
+
+class SvxBrushItem;
+
+/// Rules for HTML that is pasted or inserted into an existing Writer document. Opening an HTML file
+/// as a document does not use them.
+///
+/// Browsers put the computed colours of the page into the clipboard. A page in dark mode gives light
+/// text (Chromium: rgb(226, 229, 233)) on dark bands (rgb(37, 39, 40)), and the bands are often
+/// wiped by "background-color: transparent" on links and names, so the text lands on Writer's white
+/// page and cannot be read. Pasted content must read as normal text on the page: dark bands are
+/// dropped, and a text colour that is too close to the background it gets in Writer is dropped
+/// (automatic colour instead). Readable colours (red, blue, green on white) stay as they are.
+namespace hst::htmlpaste
+{
+/// Lowest WCAG contrast ratio a pasted text colour needs against its background in Writer. The peach
+/// text of a "text on coloured background" post, rgb(255, 200, 145), is 1.51:1 on white and must go;
+/// light grey rgb(204, 204, 204), 1.61:1, is still read as grey text and stays.
+constexpr double MIN_TEXT_CONTRAST = 1.6;
+
+/// The same, for text whose own dark band was dropped: its colour was chosen for a dark page, so it
+/// has to be properly readable on the light one (WCAG 3:1 for large text). Chromium's secondary
+/// dark-mode grey rgb(176, 179, 184), 2.10:1 on white, goes; a dark-mode red rgb(240, 40, 73),
+/// 4.1:1, stays.
+constexpr double MIN_TEXT_CONTRAST_FROM_DARK_BAND = 3.0;
+
+/// A background is a dark band (and is dropped) when it is at most this luminance, which white text
+/// reads on at 7:1 or more...
+constexpr double MAX_DARK_BAND_LUMINANCE = 0.1;
+/// ...and it is a neutral surface: the channels differ by at most this much. Dark-mode surfaces are
+/// grey or slightly tinted (Solarized base03 rgb(0, 43, 54) is 54 apart), a dark design colour of a
+/// light page (navy, dark red) is not, and stays.
+constexpr int MAX_DARK_BAND_CHROMA = 64;
+
+/// WCAG 2 relative luminance of the colour's RGB, 0 (black) to 1 (white).
+double relativeLuminance(const Color& rColor);
+
+/// WCAG 2 contrast ratio of two colours, 1 to 21.
+double contrastRatio(const Color& rFirst, const Color& rSecond);
+
+/// The brush paints a solid colour that can be seen: not transparent, no image.
+bool hasVisibleSolidColor(const SvxBrushItem& rBrush);
+
+/// The brush is a dark band of a dark-mode page (see the constants above).
+bool isDarkBand(const SvxBrushItem& rBrush);
+
+/// A pasted text colour may stay on the given background. Automatic colour always may.
+bool isReadableTextColor(const Color& rText, const Color& rBackground, bool bFromDarkBand);
+}
