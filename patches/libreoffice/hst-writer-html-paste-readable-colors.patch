+
+#include <swmodeltestbase.hxx>
+
+#include <algorithm>
+#include <cmath>
+#include <vector>
+
+#include <com/sun/star/awt/FontSlant.hpp>
+#include <com/sun/star/awt/FontWeight.hpp>
+#include <com/sun/star/container/XEnumerationAccess.hpp>
+#include <com/sun/star/lang/XServiceInfo.hpp>
+#include <com/sun/star/text/XTextTable.hpp>
+#include <com/sun/star/text/XTextTablesSupplier.hpp>
+
+#include <rtl/strbuf.hxx>
+#include <sot/formats.hxx>
+#include <tools/color.hxx>
+#include <tools/stream.hxx>
+#include <vcl/transfer.hxx>
+
+#include <docsh.hxx>
+#include <swdtflvr.hxx>
+#include <wrtsh.hxx>
+
+namespace
+{
+/// HTML pasted from a web page reads as normal text on Writer's white page: a page in dark mode
+/// loses its dark bands and its light text colours, readable colours stay, light-mode content is
+/// unchanged, and opening the same HTML as a document is unchanged. The fixtures are trimmed copies
+/// of what Chromium puts on the clipboard (Facebook in dark and light mode), with neutral text.
+class HstHtmlPasteTest : public SwModelTestBase
+{
+public:
+    HstHtmlPasteTest()
+        : SwModelTestBase(u"/sw/qa/extras/hst/data/"_ustr)
+    {
+    }
+
+protected:
+    struct Run
+    {
+        OUString aText;
+        Color aColor;
+        Color aBack;
+        Color aParaBack;
+        float fWeight;
+        awt::FontSlant eSlant;
+        OUString aURL;
+    };
+
+    /// Pastes a fixture into a new text document as Ctrl+V does with that clipboard format.
+    /// HTML_SIMPLE is "HTML Format" of the Windows clipboard (with its offset header), HTML is
+    /// text/html of the Linux clipboard.
+    void pasteFixture(std::u16string_view aName, SotClipboardFormatId eFormat)
+    {
+        createSwDoc();
+        OString aHtml = readFixture(aName);
+        if (eFormat == SotClipboardFormatId::HTML_SIMPLE)
+            aHtml = withWindowsHeader(aHtml);
+        rtl::Reference<TransferDataContainer> xTransferable(new TransferDataContainer);
+        xTransferable->CopyByteString(eFormat, aHtml);
+        TransferableDataHelper aHelper(xTransferable);
+        SwWrtShell* pWrtShell = getSwDocShell()->GetWrtShell();
+        CPPUNIT_ASSERT(SwTransferable::PasteFormat(*pWrtShell, aHelper, eFormat));
+    }
+
+    void openFixture(const char* pName)
+    {
+        if (mxComponent.is())
+            dispose();
+        setImportFilterName(TestFilter::HTML_WRITER);
+        createSwDoc(pName);
+    }
+
+    /// Every text run of the body text and of its tables, in document order.
+    std::vector<Run> bodyRuns()
+    {
+        std::vector<Run> aRuns;
+        collectRuns(getBodyText(), aRuns);
+        return aRuns;
+    }
+
+    std::vector<Color> cellBackgrounds()
+    {
+        std::vector<Color> aColors;
+        uno::Reference<text::XTextTablesSupplier> xSupplier(mxComponent, uno::UNO_QUERY_THROW);
+        uno::Reference<container::XIndexAccess> xTables(xSupplier->getTextTables(),
+                                                        uno::UNO_QUERY_THROW);
+        for (sal_Int32 i = 0; i < xTables->getCount(); ++i)
+        {
+            uno::Reference<text::XTextTable> xTable(xTables->getByIndex(i), uno::UNO_QUERY_THROW);
+            for (const OUString& rName : xTable->getCellNames())
+                aColors.push_back(getProperty<Color>(xTable->getCellByName(rName), u"BackColor"_ustr));
+        }
+        return aColors;
+    }
+
+    Run runWith(std::u16string_view aText)
+    {
+        for (const Run& rRun : bodyRuns())
+            if (rRun.aText.indexOf(aText) >= 0)
+                return rRun;
+        CPPUNIT_FAIL(OUString(OUString::Concat(u"no text run in the body with: ") + aText).toUtf8().getStr());
+        return Run();
+    }
+
+    static double luminance(const Color& rColor)
+    {
+        auto lin = [](sal_uInt8 n) {
+            const double f = n / 255.0;
+            return f <= 0.04045 ? f / 12.92 : std::pow((f + 0.055) / 1.055, 2.4);
+        };
+        return 0.2126 * lin(rColor.GetRed()) + 0.7152 * lin(rColor.GetGreen())
+               + 0.0722 * lin(rColor.GetBlue());
+    }
+
+    /// A dark band: a visible background that light text was put on.
+    static bool isDark(const Color& rBack)
+    {
+        return !rBack.IsFullyTransparent() && luminance(rBack) <= 0.1;
+    }
+
+    /// Automatic colour, or a colour with at least this contrast on the white page.
+    static bool readsOnWhite(const Color& rText, double fMinContrast)
+    {
+        return rText == COL_AUTO || 1.05 / (luminance(rText) + 0.05) >= fMinContrast;
+    }
+
+    /// No text run sits on a dark band and every text colour reads on the white page.
+    void assertReadableOnWhite(double fMinContrast)
+    {
+        const std::vector<Run> aRuns = bodyRuns();
+        CPPUNIT_ASSERT(!aRuns.empty());
+        for (const Run& rRun : aRuns)
+        {
+            if (rRun.aText.trim().isEmpty())
+                continue;
+            const OString aWhat = rRun.aText.toUtf8();
+            CPPUNIT_ASSERT_MESSAGE(aWhat.getStr(), !isDark(rRun.aBack));
+            CPPUNIT_ASSERT_MESSAGE(aWhat.getStr(), !isDark(rRun.aParaBack));
+            CPPUNIT_ASSERT_MESSAGE(aWhat.getStr(), readsOnWhite(rRun.aColor, fMinContrast));
+        }
+    }
+
+private:
+    OString readFixture(std::u16string_view aName)
+    {
+        SvFileStream aStream(createFileURL(aName), StreamMode::READ);
+        CPPUNIT_ASSERT_EQUAL(ERRCODE_NONE, aStream.GetError());
+        const sal_uInt64 nSize = aStream.remainingSize();
+        std::vector<char> aBytes(nSize);
+        CPPUNIT_ASSERT_EQUAL(std::size_t(nSize), aStream.ReadBytes(aBytes.data(), nSize));
+        return OString(aBytes.data(), nSize);
+    }
+
+    /// The CF_HTML header Chromium writes on Windows: byte offsets of the HTML and the fragment.
+    static OString withWindowsHeader(const OString& rHtml)
+    {
+        auto header = [](sal_Int32 nStartHtml, sal_Int32 nEndHtml, sal_Int32 nStartFragment,
+                         sal_Int32 nEndFragment) -> OString {
+            auto pad = [](sal_Int32 n) -> OString {
+                OString aNumber = OString::number(n);
+                OStringBuffer aBuf;
+                for (sal_Int32 i = aNumber.getLength(); i < 10; ++i)
+                    aBuf.append('0');
+                return aBuf.append(aNumber).makeStringAndClear();
+            };
+            return "Version:0.9\r\nStartHTML:" + pad(nStartHtml) + "\r\nEndHTML:" + pad(nEndHtml)
+                   + "\r\nStartFragment:" + pad(nStartFragment) + "\r\nEndFragment:"
+                   + pad(nEndFragment) + "\r\nSourceURL:https://example.com/trang-tin-mau\r\n";
+        };
+        const sal_Int32 nHeader = header(0, 0, 0, 0).getLength();
+        const sal_Int32 nStartFragment
+            = rHtml.indexOf("<!--StartFragment-->") + RTL_CONSTASCII_LENGTH("<!--StartFragment-->");
+        const sal_Int32 nEndFragment = rHtml.indexOf("<!--EndFragment-->");
+        CPPUNIT_ASSERT(nStartFragment > 0);
+        CPPUNIT_ASSERT(nEndFragment > nStartFragment);
+        return header(nHeader, nHeader + rHtml.getLength(), nHeader + nStartFragment,
+                      nHeader + nEndFragment)
+               + rHtml;
+    }
+
+    void collectRuns(const uno::Reference<text::XText>& xText, std::vector<Run>& rRuns)
+    {
+        uno::Reference<container::XEnumerationAccess> xParas(xText, uno::UNO_QUERY_THROW);
+        uno::Reference<container::XEnumeration> xParaEnum = xParas->createEnumeration();
+        while (xParaEnum->hasMoreElements())
+        {
+            uno::Reference<lang::XServiceInfo> xInfo(xParaEnum->nextElement(), uno::UNO_QUERY_THROW);
+            if (xInfo->supportsService(u"com.sun.star.text.TextTable"_ustr))
+            {
+                uno::Reference<text::XTextTable> xTable(xInfo, uno::UNO_QUERY_THROW);
+                for (const OUString& rName : xTable->getCellNames())
+                    collectRuns(uno::Reference<text::XText>(xTable->getCellByName(rName),
+                                                            uno::UNO_QUERY_THROW),
+                                rRuns);
+                continue;
+            }
+            const Color aParaBack = getProperty<Color>(xInfo, u"ParaBackColor"_ustr);
+            uno::Reference<container::XEnumerationAccess> xPortions(xInfo, uno::UNO_QUERY_THROW);
+            uno::Reference<container::XEnumeration> xPortionEnum = xPortions->createEnumeration();
+            while (xPortionEnum->hasMoreElements())
+            {
+                uno::Reference<text::XTextRange> xRun(xPortionEnum->nextElement(),
+                                                      uno::UNO_QUERY_THROW);
+                if (getProperty<OUString>(xRun, u"TextPortionType"_ustr) != "Text")
+                    continue;
+                rRuns.push_back({ xRun->getString(), getProperty<Color>(xRun, u"CharColor"_ustr),
+                                  getProperty<Color>(xRun, u"CharBackColor"_ustr), aParaBack,
+                                  getProperty<float>(xRun, u"CharWeight"_ustr),
+                                  getProperty<awt::FontSlant>(xRun, u"CharPosture"_ustr),
+                                  getProperty<OUString>(xRun, u"HyperLinkURL"_ustr) });
+            }
+        }
+    }
+};
+
+CPPUNIT_TEST_FIXTURE(HstHtmlPasteTest, testDarkCommentReadsAsNormalText)
+{
+    // Given a comment copied from a page in dark mode (Windows clipboard), when pasting it:
+    pasteFixture(u"hst-web-paste-dark-comment.html", SotClipboardFormatId::HTML_SIMPLE);
+
+    // Then no text sits on a dark band and every colour is dark enough for body text. Before, the
+    // text kept rgb(226, 229, 233) on bands of rgb(51, 51, 52), and the name, "Tác giả" and the
+    // time stamp lost their band to "background-color: transparent": light grey on white.
+    assertReadableOnWhite(4.5);
+    CPPUNIT_ASSERT(runWith(u"Sáng nay, hội nghị").aColor != Color(0xE2E5E9));
+    const Run aTime = runWith(u"9 phút");
+    CPPUNIT_ASSERT_EQUAL(u"https://example.com/bai-viet/1"_ustr, aTime.aURL);
