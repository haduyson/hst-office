+namespace hst::htmlpaste
+{
+namespace
+{
+double linearChannel(sal_uInt8 nChannel)
+{
+    const double f = nChannel / 255.0;
+    return f <= 0.04045 ? f / 12.92 : std::pow((f + 0.055) / 1.055, 2.4);
+}
+}
+
+double relativeLuminance(const Color& rColor)
+{
+    return 0.2126 * linearChannel(rColor.GetRed()) + 0.7152 * linearChannel(rColor.GetGreen())
+           + 0.0722 * linearChannel(rColor.GetBlue());
+}
+
+double contrastRatio(const Color& rFirst, const Color& rSecond)
+{
+    const double fFirst = relativeLuminance(rFirst);
+    const double fSecond = relativeLuminance(rSecond);
+    return (std::max(fFirst, fSecond) + 0.05) / (std::min(fFirst, fSecond) + 0.05);
+}
+
+bool hasVisibleSolidColor(const SvxBrushItem& rBrush)
+{
+    return rBrush.GetGraphicPos() == GPOS_NONE && !rBrush.GetColor().IsFullyTransparent();
+}
+
+bool isDarkBand(const SvxBrushItem& rBrush)
+{
+    if (!hasVisibleSolidColor(rBrush))
+        return false;
+    const Color& rColor = rBrush.GetColor();
+    const int nMax = std::max({ rColor.GetRed(), rColor.GetGreen(), rColor.GetBlue() });
+    const int nMin = std::min({ rColor.GetRed(), rColor.GetGreen(), rColor.GetBlue() });
+    return relativeLuminance(rColor) <= MAX_DARK_BAND_LUMINANCE
+           && nMax - nMin <= MAX_DARK_BAND_CHROMA;
+}
+
+bool isReadableTextColor(const Color& rText, const Color& rBackground, bool bFromDarkBand)
+{
+    // COL_AUTO is fully transparent: automatic colour follows the background by itself.
+    if (rText.IsFullyTransparent())
+        return true;
+    return contrastRatio(rText, rBackground)
+           >= (bFromDarkBand ? MIN_TEXT_CONTRAST_FROM_DARK_BAND : MIN_TEXT_CONTRAST);
+}
+}
+
+using namespace hst::htmlpaste;
+
+Color SwHTMLParser::HstPastedTextBackground(const SvxBrushItem* pOwnBrush)
+{
+    // What the text will be painted on in Writer, innermost first: the element's own background,
+    // the open character background (the innermost one is the one that is set; a transparent one
+    // shows the paragraph), the open paragraph background, then the page.
+    if (pOwnBrush && hasVisibleSolidColor(*pOwnBrush))
+        return pOwnBrush->GetColor();
+    for (HTMLAttr* pAttr : { m_xAttrTab->pCharBrush, m_xAttrTab->pBrush })
+    {
+        if (!pAttr)
+            continue;
+        const auto& rBrush = static_cast<const SvxBrushItem&>(pAttr->GetItem());
+        if (hasVisibleSolidColor(rBrush))
+            return rBrush.GetColor();
+    }
+
+    if (!m_oHstPageColor)
+    {
+        m_oHstPageColor = COL_WHITE;
+        const SwPageDesc* pPageDesc = m_pPam->GetPointNode().FindPageDesc();
+        if (!pPageDesc && m_xDoc->GetPageDescCnt())
+            pPageDesc = &m_xDoc->GetPageDesc(0);
+        if (pPageDesc)
+        {
+            std::unique_ptr<SvxBrushItem> pPageBrush = pPageDesc->GetMaster().makeBackgroundBrushItem();
+            if (pPageBrush && hasVisibleSolidColor(*pPageBrush))
+                m_oHstPageColor = pPageBrush->GetColor();
+        }
+    }
+    return *m_oHstPageColor;
+}
+
+bool SwHTMLParser::HstIsInDroppedDarkBand(const HTMLAttrContext* pContext) const
+{
+    if (pContext && pContext->IsHstDarkBandDropped())
+        return true;
+    return std::any_of(m_aContexts.begin(), m_aContexts.end(),
+                       [](const std::unique_ptr<HTMLAttrContext>& rContext)
+                       { return rContext->IsHstDarkBandDropped(); });
+}
+
+bool SwHTMLParser::HstIsPastedColorReadable(const Color& rColor, const HTMLAttrContext* pContext)
+{
+    return isReadableTextColor(rColor, HstPastedTextBackground(nullptr),
+                               HstIsInDroppedDarkBand(pContext));
+}
+
+void SwHTMLParser::HstFilterPastedColors(SfxItemSet& rItemSet, HTMLAttrContext* pContext)
+{
+    bool bDroppedHere = false;
+    if (const SvxBrushItem* pBrush = rItemSet.GetItemIfSet(RES_BACKGROUND, false);
+        pBrush && isDarkBand(*pBrush))
+    {
+        rItemSet.ClearItem(RES_BACKGROUND);
+        bDroppedHere = true;
+        if (pContext)
+            pContext->SetHstDarkBandDropped();
+    }
+
+    const SvxColorItem* pColor = rItemSet.GetItemIfSet(RES_CHRATR_COLOR, false);
+    if (!pColor)
+        return;
+    const Color aBackground = HstPastedTextBackground(rItemSet.GetItemIfSet(RES_BACKGROUND, false));
+    if (!isReadableTextColor(pColor->GetValue(), aBackground,
+                             bDroppedHere || HstIsInDroppedDarkBand(pContext)))
+        rItemSet.ClearItem(RES_CHRATR_COLOR);
+}
