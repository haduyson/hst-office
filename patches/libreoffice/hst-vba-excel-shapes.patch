+uno::Reference<chart2::XDataSeriesContainer> ScVbaSeriesCollection::container(const uno::Reference<chart::XChartDocument>& xChart)
+{
+    uno::Reference<chart2::XChartDocument> xDoc(xChart, uno::UNO_QUERY_THROW);
+    uno::Reference<chart2::XCoordinateSystemContainer> xSystems(xDoc->getFirstDiagram(), uno::UNO_QUERY_THROW);
