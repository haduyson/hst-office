+const sal_Int32 nMaxRows = 1048576, nMaxColumns = 16384;
+
+/// the last row or column whose start is at or before the position in points
+sal_Int32 lcl_find(const uno::Reference<excel::XWorksheet>& xSheet, double fPos, bool bRow)
+{
+    sal_Int32 nLow = 1, nHigh = bRow ? nMaxRows : nMaxColumns;
+    while (nLow < nHigh)
+    {
+        const sal_Int32 nMiddle = (nLow + nHigh + 1) / 2;
+        uno::Reference<excel::XRange> xCell = xSheet->Cells(uno::Any(bRow ? nMiddle : sal_Int32(1)), uno::Any(bRow ? sal_Int32(1) : nMiddle));
+        double fStart = 0;
+        (bRow ? xCell->getTop() : xCell->getLeft()) >>= fStart;
+        if (fStart <= fPos)
+            nLow = nMiddle;
+        else
+            nHigh = nMiddle - 1;
+    }
+    return nLow;
+}
+
+uno::Any lcl_cellAt(const uno::Reference<XHelperInterface>& xParent, double fLeft, double fTop)
+{
+    uno::Reference<excel::XWorksheet> xSheet(xParent, uno::UNO_QUERY);
+    if (!xSheet.is())
+        return uno::Any(); // not in a sheet
+    return uno::Any(xSheet->Cells(uno::Any(lcl_find(xSheet, fTop, true)), uno::Any(lcl_find(xSheet, fLeft, false))));
+}
+}
+
+OUString SAL_CALL ScVbaShape::getOnAction()
+{
+    uno::Reference<document::XEventsSupplier> xSupplier(m_xShape, uno::UNO_QUERY_THROW);
+    uno::Sequence<beans::PropertyValue> aEvent;
+    xSupplier->getEvents()->getByName(u"OnClick"_ustr) >>= aEvent;
+    for (const beans::PropertyValue& rProp : aEvent)
+    {
+        OUString aUrl;
+        if (rProp.Name == "Script" && (rProp.Value >>= aUrl) && !aUrl.isEmpty())
+            return ooo::vba::extractMacroName(aUrl);
+    }
+    return OUString();
+}
+
+void SAL_CALL ScVbaShape::setOnAction(const OUString& rMacro)
+{
+    uno::Reference<document::XEventsSupplier> xSupplier(m_xShape, uno::UNO_QUERY_THROW);
+    uno::Sequence aEvent{ comphelper::makePropertyValue(u"EventType"_ustr, u"Script"_ustr),
+                          comphelper::makePropertyValue(u"Script"_ustr, rMacro.isEmpty() ? OUString() : ooo::vba::makeMacroURL(rMacro)) };
+    xSupplier->getEvents()->replaceByName(u"OnClick"_ustr, uno::Any(aEvent));
+}
+
+uno::Any SAL_CALL ScVbaShape::getTopLeftCell() { return lcl_cellAt(getParent(), getLeft(), getTop()); }
+
+uno::Any SAL_CALL ScVbaShape::getBottomRightCell() { return lcl_cellAt(getParent(), getLeft() + getWidth(), getTop() + getHeight()); }
+
+uno::Any SAL_CALL ScVbaShapes::AddPicture(const OUString& rFilename, const uno::Any&, const uno::Any&, double fLeft, double fTop, double fWidth, double fHeight)
+{
+    OUString aUrl;
+    if (osl::FileBase::getFileURLFromSystemPath(ooo::vba::vbaSystemPath(rFilename), aUrl) != osl::FileBase::E_None)
+        aUrl = rFilename;
+    uno::Reference<graphic::XGraphicProvider> xProvider = graphic::GraphicProvider::create(mxContext);
+    uno::Reference<graphic::XGraphic> xGraphic = xProvider->queryGraphic({ comphelper::makePropertyValue(u"URL"_ustr, aUrl) });
+    if (!xGraphic.is())
+        throw lang::IllegalArgumentException(u"Cannot load the picture "_ustr + rFilename, {}, 0);
+
+    uno::Reference<drawing::XShape> xShape(createShape(u"com.sun.star.drawing.GraphicObjectShape"_ustr), uno::UNO_SET_THROW);
+    m_xShapes->add(xShape);
+    setDefaultShapeProperties(xShape);
+    setShape_NameProperty(xShape, createName(u"Picture"));
+    uno::Reference<beans::XPropertySet>(xShape, uno::UNO_QUERY_THROW)->setPropertyValue(u"Graphic"_ustr, uno::Any(xGraphic));
+    rtl::Reference<ScVbaShape> pShape = new ScVbaShape(getParent(), mxContext, xShape, m_xShapes, m_xModel, ScVbaShape::getType(xShape));
+    pShape->setLeft(fLeft);
+    pShape->setTop(fTop);
+    // -1 keeps the size of the picture, which Excel allows
+    awt::Size aSize;
+    uno::Reference<beans::XPropertySet> xGraphicProps(xGraphic, uno::UNO_QUERY);
+    if (xGraphicProps.is())
+        xGraphicProps->getPropertyValue(u"Size100thMM"_ustr) >>= aSize;
+    pShape->setWidth(fWidth > 0 ? fWidth : aSize.Width * 72.0 / 2540.0);
+    pShape->setHeight(fHeight > 0 ? fHeight : aSize.Height * 72.0 / 2540.0);
+    return uno::Any(uno::Reference<msforms::XShape>(pShape));
+}
