+/// how the chart's data provider writes a range or an Excel address
+OUString lcl_representation(const uno::Any& rValue)
+{
+    uno::Reference<excel::XRange> xRange;
+    OUString aAddress;
+    if ((rValue >>= xRange) && xRange.is())
+    {
+        ScVbaRange* pRange = dynamic_cast<ScVbaRange*>(xRange.get());
+        if (!pRange)
+            throw uno::RuntimeException(u"Not a range of this sheet"_ustr);
+        ScDocument& rDoc = pRange->getScDocument();
+        return pRange->getScRangeList()[0].Format(rDoc, ScRefFlags::RANGE_ABS_3D, ScAddress::Details(formula::FormulaGrammar::CONV_OOO));
+    }
+    if (rValue >>= aAddress)
+        return aAddress;
+    throw lang::IllegalArgumentException(u"A chart in a sheet takes its values from cells"_ustr, {}, 0);
+}
+
+class Series : public InheritedHelperInterfaceWeakImpl<excel::XSeries>
+{
+    uno::Reference<chart::XChartDocument> mxChart;
+    uno::Reference<chart2::XDataSeries> mxSeries;
+
+    uno::Reference<chart2::data::XLabeledDataSequence> find(std::u16string_view rRole)
+    {
+        uno::Reference<chart2::data::XDataSource> xSource(mxSeries, uno::UNO_QUERY_THROW);
+        for (const auto& xLabeled : xSource->getDataSequences())
+        {
+            uno::Reference<beans::XPropertySet> xProps(xLabeled->getValues(), uno::UNO_QUERY);
+            OUString aRole;
+            if (xProps.is() && (xProps->getPropertyValue(u"Role"_ustr) >>= aRole) && aRole == rRole)
+                return xLabeled;
+        }
+        return {};
+    }
+
+    uno::Reference<chart2::data::XDataSequence> make(const OUString& rRepresentation, const OUString& rRole)
+    {
+        uno::Reference<chart2::XChartDocument> xDoc(mxChart, uno::UNO_QUERY_THROW);
+        uno::Reference<chart2::data::XDataSequence> xSequence = xDoc->getDataProvider()->createDataSequenceByRangeRepresentation(rRepresentation);
+        if (!xSequence.is())
+            throw lang::IllegalArgumentException(u"No cells at "_ustr + rRepresentation, {}, 0);
+        uno::Reference<beans::XPropertySet>(xSequence, uno::UNO_QUERY_THROW)->setPropertyValue(u"Role"_ustr, uno::Any(rRole));
+        return xSequence;
+    }
+
+    /// replaces, or adds, the sequence of a role and keeps the others
+    void put(const OUString& rRole, const uno::Reference<chart2::data::XDataSequence>& xValues, const uno::Reference<chart2::data::XDataSequence>& xLabel)
+    {
+        uno::Reference<chart2::data::XDataSource> xSource(mxSeries, uno::UNO_QUERY_THROW);
+        std::vector<uno::Reference<chart2::data::XLabeledDataSequence>> aAll;
+        uno::Reference<chart2::data::XDataSequence> xKeepLabel = xLabel;
+        for (const auto& xLabeled : xSource->getDataSequences())
+        {
+            uno::Reference<beans::XPropertySet> xProps(xLabeled->getValues(), uno::UNO_QUERY);
+            OUString aRole;
+            if (xProps.is())
+                xProps->getPropertyValue(u"Role"_ustr) >>= aRole;
+            if (aRole == rRole)
+            {
+                if (!xKeepLabel.is())
+                    xKeepLabel = xLabeled->getLabel();
+            }
+            else
+                aAll.push_back(xLabeled);
+        }
+        uno::Reference<chart2::data::XLabeledDataSequence> xNew = chart2::data::LabeledDataSequence::create(mxContext);
+        xNew->setValues(xValues);
+        if (xKeepLabel.is())
+            xNew->setLabel(xKeepLabel);
+        aAll.push_back(xNew);
+        uno::Reference<chart2::data::XDataSink>(mxSeries, uno::UNO_QUERY_THROW)->setData(comphelper::containerToSequence(aAll));
+    }
+
+public:
+    Series(const uno::Reference<XHelperInterface>& xParent, const uno::Reference<uno::XComponentContext>& xContext,
+           uno::Reference<chart::XChartDocument> xChart, uno::Reference<chart2::XDataSeries> xSeries)
+        : InheritedHelperInterfaceWeakImpl(xParent, xContext)
+        , mxChart(std::move(xChart))
+        , mxSeries(std::move(xSeries))
+    {
+    }
+
+    uno::Any SAL_CALL getName() override
+    {
+        uno::Reference<chart2::data::XLabeledDataSequence> xValues = find(u"values-y");
+        if (xValues.is() && xValues->getLabel().is())
+        {
+            const uno::Sequence<uno::Any> aLabel = xValues->getLabel()->getData();
+            if (aLabel.hasElements())
+                return aLabel[0];
+        }
+        return uno::Any(OUString());
+    }
+
+    void SAL_CALL setName(const uno::Any& rValue) override
+    {
+        // a name that is no cell becomes a string the provider keeps, as Excel's ="Sales"
+        OUString aName;
+        uno::Reference<excel::XRange> xRange;
+        if (!(rValue >>= xRange) && (rValue >>= aName) && !aName.startsWith("="))
+            aName = "\"" + aName.replaceAll("\"", "\"\"") + "\"";
+        else
+            aName = lcl_representation(rValue);
+        uno::Reference<chart2::data::XLabeledDataSequence> xValues = find(u"values-y");
+        uno::Reference<chart2::data::XDataSequence> xLabel = make(aName, u"label"_ustr);
+        if (xValues.is())
+            put(u"values-y"_ustr, xValues->getValues(), xLabel);
+        else
+            throw uno::RuntimeException(u"Set Values before Name"_ustr);
+    }
+
+    uno::Any SAL_CALL getValues() override
+    {
+        uno::Reference<chart2::data::XLabeledDataSequence> xValues = find(u"values-y");
+        return xValues.is() ? uno::Any(xValues->getValues()->getData()) : uno::Any();
+    }
+
+    void SAL_CALL setValues(const uno::Any& rValue) override { put(u"values-y"_ustr, make(lcl_representation(rValue), u"values-y"_ustr), {}); }
+
+    uno::Any SAL_CALL getXValues() override
+    {
+        uno::Reference<chart2::data::XLabeledDataSequence> xValues = find(u"values-x");
+        return xValues.is() ? uno::Any(xValues->getValues()->getData()) : uno::Any();
+    }
+
+    void SAL_CALL setXValues(const uno::Any& rValue) override { put(u"values-x"_ustr, make(lcl_representation(rValue), u"values-x"_ustr), {}); }
+
+    uno::Any SAL_CALL getAxisGroup() override
+    {
+        sal_Int32 nAxis = 0;
+        uno::Reference<beans::XPropertySet>(mxSeries, uno::UNO_QUERY_THROW)->getPropertyValue(u"AttachedAxisIndex"_ustr) >>= nAxis;
+        return uno::Any(nAxis + 1);
+    }
+
+    void SAL_CALL setAxisGroup(const uno::Any& rValue) override
+    {
+        sal_Int32 nGroup = 1;
+        rValue >>= nGroup;
+        uno::Reference<beans::XPropertySet>(mxSeries, uno::UNO_QUERY_THROW)->setPropertyValue(u"AttachedAxisIndex"_ustr, uno::Any(nGroup - 1));
+    }
+
+    void SAL_CALL Delete() override { ScVbaSeriesCollection::container(mxChart)->removeDataSeries(mxSeries); }
+
+    OUString getServiceImplName() override { return u"ScVbaSeries"_ustr; }
+    uno::Sequence<OUString> getServiceNames() override { return { u"ooo.vba.excel.Series"_ustr }; }
+};
+}
+
+uno::Reference<excel::XSeries> ScVbaSeriesCollection::seriesObject(const uno::Reference<XHelperInterface>& xParent, const uno::Reference<uno::XComponentContext>& xContext,
+                                                                   const uno::Reference<chart::XChartDocument>& xChart, const uno::Reference<chart2::XDataSeries>& xSeries)
+{
+    return new Series(xParent, xContext, xChart, xSeries);
+}
