+class Live : public ::cppu::WeakImplHelper<container::XIndexAccess>
+{
+    uno::Reference<chart::XChartDocument> mxChart;
+
+public:
+    explicit Live(uno::Reference<chart::XChartDocument> xChart)
+        : mxChart(std::move(xChart))
+    {
+    }
+    sal_Int32 SAL_CALL getCount() override { return ScVbaSeriesCollection::container(mxChart)->getDataSeries().getLength(); }
+    uno::Any SAL_CALL getByIndex(sal_Int32 nIndex) override
+    {
+        const auto aAll = ScVbaSeriesCollection::container(mxChart)->getDataSeries();
+        if (nIndex < 0 || nIndex >= aAll.getLength())
+            throw lang::IndexOutOfBoundsException();
+        return uno::Any(aAll[nIndex]);
+    }
+    uno::Type SAL_CALL getElementType() override { return cppu::UnoType<chart2::XDataSeries>::get(); }
+    sal_Bool SAL_CALL hasElements() override { return getCount() > 0; }
+};
