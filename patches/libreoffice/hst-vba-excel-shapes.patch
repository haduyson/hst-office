+    uno::Reference<excel::XSeries> SAL_CALL NewSeries() override
+    {
+        uno::Reference<chart2::XDataSeries> xSeries(mxContext->getServiceManager()->createInstanceWithContext(u"com.sun.star.chart2.DataSeries"_ustr, mxContext), uno::UNO_QUERY_THROW);
+        ScVbaSeriesCollection::container(mxChart)->addDataSeries(xSeries);
+        return ScVbaSeriesCollection::seriesObject(mxParent, mxContext, mxChart, xSeries);
+    }
+    uno::Type SAL_CALL getElementType() override { return cppu::UnoType<excel::XSeries>::get(); }
+    uno::Reference<container::XEnumeration> SAL_CALL createEnumeration() override { throw uno::RuntimeException(u"Not implemented"_ustr); }
+    uno::Any createCollectionObject(const uno::Any& aSource) override
+    {
+        uno::Reference<chart2::XDataSeries> xSeries(aSource, uno::UNO_QUERY_THROW);
+        return uno::Any(ScVbaSeriesCollection::seriesObject(mxParent, mxContext, mxChart, xSeries));
