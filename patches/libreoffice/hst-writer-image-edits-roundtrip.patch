+#include <cstdlib>
+#include <functional>
+
+namespace
+{
+/** Picture settings of the Picture tab and the Image dialog survive saving as .docx and .doc and reopening: as Word
+    properties where the format has them, applied to the written picture where it has none. */
+class HstImageEditsRoundtripTest : public SwModelTestBase
+{
+public:
+    HstImageEditsRoundtripTest()
+        : SwModelTestBase(u"/sw/qa/extras/hst/data/"_ustr)
+    {
+    }
+
+    /// A new document with one 6 x 4.5 cm picture of a colour gradient (64 x 48 pixels).
+    uno::Reference<beans::XPropertySet>
+    insertPicture(text::TextContentAnchorType eAnchor = text::TextContentAnchorType_AT_CHARACTER)
+    {
+        createSwDoc();
+        Bitmap aBitmap(Size(64, 48), vcl::PixelFormat::N24_BPP);
+        {
+            BitmapScopedWriteAccess pWrite(aBitmap);
+            for (tools::Long nY = 0; nY < 48; ++nY)
+                for (tools::Long nX = 0; nX < 64; ++nX)
+                    pWrite->SetPixel(nY, nX,
+                                     BitmapColor(sal_uInt8(40 + nX * 3), sal_uInt8(30 + nY * 4),
+                                                 sal_uInt8(200 - nX - nY)));
+        }
+        maOriginal = Graphic(aBitmap);
+
+        uno::Reference<lang::XMultiServiceFactory> xFactory(mxComponent, uno::UNO_QUERY_THROW);
+        uno::Reference<beans::XPropertySet> xPicture(
+            xFactory->createInstance(u"com.sun.star.text.TextGraphicObject"_ustr), uno::UNO_QUERY_THROW);
+        xPicture->setPropertyValue(u"Graphic"_ustr, uno::Any(maOriginal.GetXGraphic()));
+        xPicture->setPropertyValue(u"AnchorType"_ustr, uno::Any(eAnchor));
+        xPicture->setPropertyValue(u"Size"_ustr, uno::Any(awt::Size(6000, 4500)));
+        uno::Reference<text::XTextDocument> xDocument(mxComponent, uno::UNO_QUERY_THROW);
+        uno::Reference<text::XText> xText = xDocument->getText();
+        xText->insertTextContent(xText->getEnd(),
+                                 uno::Reference<text::XTextContent>(xPicture, uno::UNO_QUERY_THROW), false);
+        return xPicture;
+    }
+
+    /// The reopened document's Writer picture (empty when it came back as a drawing shape).
+    uno::Reference<beans::XPropertySet> writerPicture()
+    {
+        uno::Reference<text::XTextGraphicObjectsSupplier> xSupplier(mxComponent, uno::UNO_QUERY_THROW);
+        uno::Reference<container::XIndexAccess> xObjects(xSupplier->getGraphicObjects(), uno::UNO_QUERY_THROW);
+        if (!xObjects->getCount())
+            return {};
+        return uno::Reference<beans::XPropertySet>(xObjects->getByIndex(0), uno::UNO_QUERY_THROW);
+    }
+
+    /// The picture as HST Office draws it with rAttr's colour settings.
+    Bitmap rendered(const GraphicAttr& rAttr) const
+    {
+        return GraphicObject(maOriginal).GetTransformedGraphic(&rAttr).GetBitmap();
+    }
+
+    /// The picture data of xPicture.
+    static Bitmap pictureData(const uno::Reference<beans::XPropertySet>& xPicture)
+    {
+        uno::Reference<graphic::XGraphic> xGraphic;
+        xPicture->getPropertyValue(u"Graphic"_ustr) >>= xGraphic;
+        CPPUNIT_ASSERT(xGraphic.is());
+        return Graphic(xGraphic).GetBitmap();
+    }
+
+    /// Every pixel within 2 of the expected colour (and alpha).
+    static void assertSamePixels(const Bitmap& rExpected, const Bitmap& rActual)
+    {
+        CPPUNIT_ASSERT_EQUAL(rExpected.GetSizePixel().Width(), rActual.GetSizePixel().Width());
+        CPPUNIT_ASSERT_EQUAL(rExpected.GetSizePixel().Height(), rActual.GetSizePixel().Height());
+        int nDifferent = 0;
+        for (sal_Int32 nY = 0; nY < rExpected.GetSizePixel().Height(); ++nY)
+            for (sal_Int32 nX = 0; nX < rExpected.GetSizePixel().Width(); ++nX)
+            {
+                const Color aWant = rExpected.GetPixelColor(nX, nY);
+                const Color aGot = rActual.GetPixelColor(nX, nY);
+                if (std::abs(aWant.GetRed() - aGot.GetRed()) > 2
+                    || std::abs(aWant.GetGreen() - aGot.GetGreen()) > 2
+                    || std::abs(aWant.GetBlue() - aGot.GetBlue()) > 2
+                    || std::abs(aWant.GetAlpha() - aGot.GetAlpha()) > 2)
+                    ++nDifferent;
+            }
+        CPPUNIT_ASSERT_EQUAL(0, nDifferent);
+    }
+
+    /// The picture's colour setting rName set to aValue survives the round trip as a picture property.
+    void checkKeptProperty(TestFilter eFilter, const OUString& rName, const uno::Any& aValue)
+    {
+        uno::Reference<beans::XPropertySet> xPicture = insertPicture();
+        xPicture->setPropertyValue(rName, aValue);
+        saveAndReload(eFilter);
+        xPicture = writerPicture();
+        CPPUNIT_ASSERT(xPicture.is());
+        CPPUNIT_ASSERT_MESSAGE(rName.toUtf8().getStr(), aValue == xPicture->getPropertyValue(rName));
+    }
+
+    /// Settings the format cannot store come back applied to the picture, as HST Office showed it.
+    void checkApplied(TestFilter eFilter, const std::function<void(const uno::Reference<beans::XPropertySet>&)>& rSet,
+                      const GraphicAttr& rShown)
+    {
+        uno::Reference<beans::XPropertySet> xPicture = insertPicture();
+        rSet(xPicture);
+        saveAndReload(eFilter);
+        xPicture = writerPicture();
+        CPPUNIT_ASSERT(xPicture.is());
+        assertSamePixels(rendered(rShown), pictureData(xPicture));
+        // ... and the settings are not applied a second time
+        CPPUNIT_ASSERT_EQUAL(sal_Int16(0), xPicture->getPropertyValue(u"AdjustLuminance"_ustr).get<sal_Int16>());
+        CPPUNIT_ASSERT_EQUAL(sal_Int16(0), xPicture->getPropertyValue(u"AdjustContrast"_ustr).get<sal_Int16>());
+        CPPUNIT_ASSERT_EQUAL(sal_Int16(0), xPicture->getPropertyValue(u"AdjustRed"_ustr).get<sal_Int16>());
+        CPPUNIT_ASSERT_EQUAL(1.0, xPicture->getPropertyValue(u"Gamma"_ustr).get<double>());
+        CPPUNIT_ASSERT_EQUAL(drawing::ColorMode_STANDARD,
+                             xPicture->getPropertyValue(u"GraphicColorMode"_ustr).get<drawing::ColorMode>());
+    }
+
+    /// A picture rotated by nRotation (tenths of a degree, with rMirror set) keeps its rotation and size.
+    void checkRotation(TestFilter eFilter, text::TextContentAnchorType eAnchor, sal_Int16 nRotation,
+                       const OUString& rMirror)
+    {
+        uno::Reference<beans::XPropertySet> xPicture = insertPicture(eAnchor);
+        xPicture->setPropertyValue(u"GraphicRotation"_ustr, uno::Any(nRotation));
+        if (!rMirror.isEmpty())
+            xPicture->setPropertyValue(rMirror, uno::Any(true));
+        saveAndReload(eFilter);
+        xPicture = writerPicture();
+        sal_Int32 nRotation100 = 0;
+        awt::Size aSize;
+        if (xPicture.is())
+        {
+            nRotation100 = xPicture->getPropertyValue(u"GraphicRotation"_ustr).get<sal_Int16>() * 10;
+            xPicture->getPropertyValue(u"Size"_ustr) >>= aSize;
+            if (!rMirror.isEmpty())
+                CPPUNIT_ASSERT(xPicture->getPropertyValue(rMirror).get<bool>());
+        }
+        else // DOCX: a rotated picture comes back as a picture shape
+        {
+            uno::Reference<drawing::XShape> xShape = getShape(1);
+            uno::Reference<beans::XPropertySet> xShapeProps(xShape, uno::UNO_QUERY_THROW);
+            xShapeProps->getPropertyValue(u"RotateAngle"_ustr) >>= nRotation100;
+            aSize = xShape->getSize();
+        }
+        CPPUNIT_ASSERT_EQUAL(sal_Int32(nRotation) * 10, nRotation100);
+        // not 8000 x 6000 (the size of the rotated rectangle around the unrotated picture)
+        CPPUNIT_ASSERT_DOUBLES_EQUAL(6000.0, double(aSize.Width), 30.0);
+        CPPUNIT_ASSERT_DOUBLES_EQUAL(4500.0, double(aSize.Height), 30.0);
+    }
+
+    /// A turned picture placed by hand keeps its place: Writer positions it by its bounding box, Word by the
+    /// unrotated picture (it moved by half the difference of width and height).
+    void checkRotatedPosition(TestFilter eFilter)
+    {
+        uno::Reference<beans::XPropertySet> xPicture = insertPicture();
+        xPicture->setPropertyValue(u"HoriOrient"_ustr, uno::Any(text::HoriOrientation::NONE));
+        xPicture->setPropertyValue(u"HoriOrientPosition"_ustr, uno::Any(sal_Int32(3000)));
+        xPicture->setPropertyValue(u"VertOrient"_ustr, uno::Any(text::VertOrientation::NONE));
+        xPicture->setPropertyValue(u"VertOrientPosition"_ustr, uno::Any(sal_Int32(1000)));
+        xPicture->setPropertyValue(u"GraphicRotation"_ustr, uno::Any(sal_Int16(900)));
+        saveAndReload(eFilter);
+        uno::Reference<beans::XPropertySet> xProps = writerPicture();
+        if (!xProps.is()) // DOCX: a rotated picture comes back as a picture shape
+            xProps.set(getShape(1), uno::UNO_QUERY_THROW);
+        CPPUNIT_ASSERT_DOUBLES_EQUAL(3000.0, double(xProps->getPropertyValue(u"HoriOrientPosition"_ustr).get<sal_Int32>()),
+                                     30.0);
+        CPPUNIT_ASSERT_DOUBLES_EQUAL(1000.0, double(xProps->getPropertyValue(u"VertOrientPosition"_ustr).get<sal_Int32>()),
+                                     30.0);
+    }
+
+    /// Upstream's document with a picture linked to linked_graphic.jpg, and that picture.
+    uno::Reference<beans::XPropertySet> loadLinkedPicture()
+    {
+        loadFromURL(
+            m_directories.getURLFromSrc(u"/sw/qa/extras/globalfilter/data/document_with_linked_graphic.odt"));
+        getSwDocShell()->getEmbeddedObjectContainer().setUserAllowsLinkUpdate(true);
+        uno::Reference<beans::XPropertySet> xPicture = writerPicture();
+        CPPUNIT_ASSERT(xPicture.is());
+        return xPicture;
+    }
+
+    /// Saves and reopens; the picture must still be linked (never embedded), and is returned.
+    uno::Reference<beans::XPropertySet> reloadLinked(TestFilter eFilter)
+    {
+        saveAndReload(eFilter);
+        getSwDocShell()->getEmbeddedObjectContainer().setUserAllowsLinkUpdate(true);
+        sfx2::LinkManager& rLinks = getSwDoc()->getIDocumentLinksAdministration().GetLinkManager();
+        CPPUNIT_ASSERT_EQUAL(size_t(1), rLinks.GetLinks().size());
+        CPPUNIT_ASSERT(rLinks.GetLinks()[0]->GetLinkSourceName().indexOf("linked_graphic.jpg") >= 0);
+        uno::Reference<beans::XPropertySet> xPicture = writerPicture();
+        CPPUNIT_ASSERT(xPicture.is());
+        return xPicture;
+    }
+
+    /// Every setting of the Picture tab on a linked picture; Word keeps some of them as properties of the link.
+    static void setAllSettings(const uno::Reference<beans::XPropertySet>& xPicture)
+    {
+        xPicture->setPropertyValue(u"AdjustLuminance"_ustr, uno::Any(sal_Int16(20)));
+        xPicture->setPropertyValue(u"AdjustContrast"_ustr, uno::Any(sal_Int16(-30)));
+        xPicture->setPropertyValue(u"Transparency"_ustr, uno::Any(sal_Int16(40)));
+        xPicture->setPropertyValue(u"GraphicColorMode"_ustr, uno::Any(drawing::ColorMode_GREYS));
+        xPicture->setPropertyValue(u"VertMirrored"_ustr, uno::Any(true));
+        xPicture->setPropertyValue(u"Gamma"_ustr, uno::Any(1.5));
+        xPicture->setPropertyValue(u"AdjustRed"_ustr, uno::Any(sal_Int16(30)));
+    }
+
+    template <typename T> static T get(const uno::Reference<beans::XPropertySet>& xPicture, const OUString& rName)
+    {
+        return xPicture->getPropertyValue(rName).get<T>();
+    }
+
+    /// A cropped picture whose settings are applied to the written picture keeps its crop (the copy kept the size
+    /// of the original's pixels at another resolution, so the crop came back 4/3 larger).
+    void checkAppliedSettingsKeepCrop(TestFilter eFilter)
+    {
+        uno::Reference<beans::XPropertySet> xPicture = insertPicture();
+        // a picture with its own resolution (150 dpi), as photos have
+        Graphic aPhoto(maOriginal);
+        aPhoto.SetPrefMapMode(MapMode(MapUnit::Map100thMM));
+        aPhoto.SetPrefSize(Size(64 * 2540 / 150, 48 * 2540 / 150));
+        xPicture->setPropertyValue(u"Graphic"_ustr, uno::Any(aPhoto.GetXGraphic()));
+        text::GraphicCrop aCrop(200, 100, 150, 100); // top, bottom, left, right
+        xPicture->setPropertyValue(u"GraphicCrop"_ustr, uno::Any(aCrop));
+        xPicture->setPropertyValue(u"AdjustLuminance"_ustr, uno::Any(sal_Int16(20)));
+        xPicture->setPropertyValue(u"AdjustContrast"_ustr, uno::Any(sal_Int16(-30)));
+        saveAndReload(eFilter);
+        xPicture = writerPicture();
+        CPPUNIT_ASSERT(xPicture.is());
+        text::GraphicCrop aGot;
+        xPicture->getPropertyValue(u"GraphicCrop"_ustr) >>= aGot;
+        CPPUNIT_ASSERT_DOUBLES_EQUAL(200.0, double(aGot.Top), 10.0);
+        CPPUNIT_ASSERT_DOUBLES_EQUAL(100.0, double(aGot.Bottom), 10.0);
+        CPPUNIT_ASSERT_DOUBLES_EQUAL(150.0, double(aGot.Left), 10.0);
+        CPPUNIT_ASSERT_DOUBLES_EQUAL(100.0, double(aGot.Right), 10.0);
+    }
+
+private:
+    Graphic maOriginal;
+};
+}
