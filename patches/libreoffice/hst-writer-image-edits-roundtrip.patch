+// DOC: an as-character picture with a border (and a shadow, as the HST picture styles give) became smaller on every
+// save: the reader took the picture's size without the room of its borders as the frame size.
+CPPUNIT_TEST_FIXTURE(HstImageEditsRoundtripTest, testDocBorderedInlinePictureKeepsSize)
+{
+    uno::Reference<beans::XPropertySet> xPicture = insertPicture(text::TextContentAnchorType_AS_CHARACTER);
+    table::BorderLine2 aLine;
+    aLine.Color = 0x0072BB;
+    aLine.LineWidth = 53;
+    aLine.OuterLineWidth = 53;
+    for (const OUString& rSide : { u"TopBorder"_ustr, u"BottomBorder"_ustr, u"LeftBorder"_ustr, u"RightBorder"_ustr })
+        xPicture->setPropertyValue(rSide, uno::Any(aLine));
+    table::ShadowFormat aShadow;
+    aShadow.Location = table::ShadowLocation_BOTTOM_RIGHT;
+    aShadow.ShadowWidth = 106;
+    aShadow.Color = 0x000000;
+    xPicture->setPropertyValue(u"ShadowFormat"_ustr, uno::Any(aShadow));
+
+    awt::Size aSaved[2];
+    for (awt::Size& rSize : aSaved)
+    {
+        saveAndReload(TestFilter::DOC);
+        xPicture = writerPicture();
+        CPPUNIT_ASSERT(xPicture.is());
+        xPicture->getPropertyValue(u"Size"_ustr) >>= rSize;
+    }
+    // the same after the second save, and (up to Word's border units) the size it had
+    CPPUNIT_ASSERT_DOUBLES_EQUAL(double(aSaved[0].Width), double(aSaved[1].Width), 5.0);
+    CPPUNIT_ASSERT_DOUBLES_EQUAL(double(aSaved[0].Height), double(aSaved[1].Height), 5.0);
+    CPPUNIT_ASSERT_DOUBLES_EQUAL(6000.0, double(aSaved[1].Width), 60.0);
+    CPPUNIT_ASSERT_DOUBLES_EQUAL(4500.0, double(aSaved[1].Height), 60.0);
+}
