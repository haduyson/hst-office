+    xPicture->setPropertyValue(u"AdjustLuminance"_ustr, uno::Any(sal_Int16(10)));
+    xPicture = reloadLinked(TestFilter::DOCX);
+    // the brightness and contrast HST Office draws the watermark with
+    CPPUNIT_ASSERT_EQUAL(drawing::ColorMode_STANDARD, get<drawing::ColorMode>(xPicture, u"GraphicColorMode"_ustr));
+    CPPUNIT_ASSERT_EQUAL(sal_Int16(60), get<sal_Int16>(xPicture, u"AdjustLuminance"_ustr));
+    CPPUNIT_ASSERT_EQUAL(sal_Int16(-70), get<sal_Int16>(xPicture, u"AdjustContrast"_ustr));
+}
