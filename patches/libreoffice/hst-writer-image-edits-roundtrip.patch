+#pragma once
+
+#include <com/sun/star/beans/XPropertySet.hpp>
+
+/** DOCX pictures: what the drawing import reads into its picture shape and the Writer picture must keep. */
+namespace hst::pictureimport
+{
+/// The drawing import shows a vertical flip (a:xfrm flipV) as a half turn of the horizontally mirrored picture.
+/// Such a shape is no rotated picture: it can become a Writer picture, flipped vertically.
+bool IsVerticallyFlipped(const css::uno::Reference<css::beans::XPropertySet>& xShapeProps);
+
+/// The shape's effects (its "EffectProperties" grab bag) are only a plain outer shadow (a:outerShdw without blur,
+/// scaling or skew): a shadow a Writer picture has too, so the shape can still become a picture, as in Word.
+bool IsPictureShadowOnly(const css::uno::Any& rEffects);
+
+/// Gives the Writer picture the shape's transparency (a:alphaModFix) and its vertical flip, and adds its shadow to
+/// its size (Word's extent leaves the shadow out).
+void ApplyShapeSettings(const css::uno::Reference<css::beans::XPropertySet>& xShapeProps,
+                        const css::uno::Reference<css::beans::XPropertySet>& xGraphicObject);
+}
