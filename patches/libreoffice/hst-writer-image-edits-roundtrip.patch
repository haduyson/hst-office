+// DOCX: a picture with a shadow (as the HST picture styles give) came back as a picture shape (no Picture tab), smaller
+// by the shadow. A plain shadow is a picture's shadow in Word: it stays a picture with its shadow and its size.
+CPPUNIT_TEST_FIXTURE(HstImageEditsRoundtripTest, testDocxShadowedPictureStaysPicture)
+{
+    for (text::TextContentAnchorType eAnchor :
+         { text::TextContentAnchorType_AS_CHARACTER, text::TextContentAnchorType_AT_CHARACTER })
+    {
+        uno::Reference<beans::XPropertySet> xPicture = insertPicture(eAnchor);
+        table::ShadowFormat aShadow;
+        aShadow.Location = table::ShadowLocation_BOTTOM_RIGHT;
+        aShadow.ShadowWidth = 106;
+        aShadow.Color = 0x000000;
+        xPicture->setPropertyValue(u"ShadowFormat"_ustr, uno::Any(aShadow));
+
+        for (int nSave = 0; nSave < 2; ++nSave)
+        {
+            saveAndReload(TestFilter::DOCX);
+            xPicture = writerPicture();
+            CPPUNIT_ASSERT(xPicture.is());
+            const table::ShadowFormat aGot = xPicture->getPropertyValue(u"ShadowFormat"_ustr).get<table::ShadowFormat>();
+            CPPUNIT_ASSERT_EQUAL(table::ShadowLocation_BOTTOM_RIGHT, aGot.Location);
+            CPPUNIT_ASSERT_DOUBLES_EQUAL(106.0, double(aGot.ShadowWidth), 5.0);
+            awt::Size aSize;
+            xPicture->getPropertyValue(u"Size"_ustr) >>= aSize;
+            CPPUNIT_ASSERT_DOUBLES_EQUAL(6000.0, double(aSize.Width), 20.0);
+            CPPUNIT_ASSERT_DOUBLES_EQUAL(4500.0, double(aSize.Height), 20.0);
+        }
