+/// Word reads a picture turned between 45 and 135 or between 225 and 315 degrees with its anchor's width and height
+/// swapped.
+bool IsAnchorSwapped(sal_Int32 nDeg10)
+{
+    const sal_Int32 n = ((nDeg10 % 3600) + 3600) % 3600;
+    return (n > 450 && n <= 1350) || (n > 2250 && n <= 3150);
+}
+
+/// The picture node shown in rFormat, if rFormat is a frame holding one.
+const SwGrfNode* GetPictureNode(const SwFrameFormat& rFormat)
+{
+    if (rFormat.Which() != RES_FLYFRMFMT)
+        return nullptr;
+    const SwNodeIndex* pIdx = rFormat.GetContent().GetContentIdx();
+    if (!pIdx)
+        return nullptr;
+    return pIdx->GetNodes()[pIdx->GetIndex() + 1]->GetGrfNode();
+}
+}
+
+WordPictureSettings GetWordPictureSettings(const SwAttrSet& rSet, WordPictureFormat eFormat, bool bCanApply)
+{
+    WordPictureSettings aSettings;
+    const GraphicDrawMode eMode = rSet.GetDrawModeGrf().GetValue();
+    const sal_Int16 nLuminance = rSet.GetLuminanceGrf().GetValue();
+    const sal_Int16 nContrast = rSet.GetContrastGrf().GetValue();
+    const double fGamma = rSet.GetGammaGrf().GetValue();
+    const bool bGamma = !rtl::math::approxEqual(fGamma, 1.0);
+    const sal_Int16 nTransparency = rSet.GetTransparencyGrf().GetValue();
+
+    // Word applies brightness and contrast in another order than HST Office (its reader turns a picture with both into
+    // pixels too), a washout is Word's brightness 70 % with contrast -70 %, and Word has no colour channels or invert.
+    const bool bNotStorable
+        = rSet.GetChannelRGrf().GetValue() || rSet.GetChannelGGrf().GetValue() || rSet.GetChannelBGrf().GetValue()
+          || rSet.GetInvertGrf().GetValue() || (nLuminance && nContrast)
+          || (eMode == GraphicDrawMode::Watermark && (nLuminance || nContrast))
+          || (eFormat == WordPictureFormat::Docx && bGamma);
+
+    if (bCanApply && bNotStorable)
+        aSettings.bApplyColours = true;
+    else if (eMode == GraphicDrawMode::Watermark && (nLuminance || nContrast))
+    {
+        // A linked picture: as Word, only properties. HST Office draws a watermark as brightness +50 % and contrast
+        // -70 %; added to the picture's own, they show the same picture again (Word's washout is 70/-70 alone).
+        aSettings.nLuminance = static_cast<sal_Int16>(std::clamp(nLuminance + 50, -100, 100));
+        aSettings.nContrast = static_cast<sal_Int16>(std::clamp(nContrast - 70, -100, 100));
+        if (eFormat == WordPictureFormat::Doc)
+            aSettings.fGamma = fGamma;
+    }
+    else
+    {
+        aSettings.eDrawMode = eMode;
+        aSettings.nLuminance = nLuminance;
+        aSettings.nContrast = nContrast;
+        if (eFormat == WordPictureFormat::Doc)
+            aSettings.fGamma = fGamma;
+    }
+
+    if (eFormat == WordPictureFormat::Docx)
+        aSettings.nTransparency = nTransparency;
+    else
+        aSettings.bApplyTransparency = bCanApply && nTransparency > 0;
+    return aSettings;
+}
+
+Graphic GetWordPictureGraphic(const SwGrfNode& rNode, WordPictureFormat eFormat)
+{
+    const SwAttrSet& rSet = rNode.GetSwAttrSet();
+    const WordPictureSettings aSettings = GetWordPictureSettings(rSet, eFormat, !rNode.IsLinkedFile());
+    if (!aSettings.bApplyColours && !aSettings.bApplyTransparency)
+        return rNode.GetGrf();
+
+    // Only these settings: the crop, the flips and the rotation stay properties of the written picture.
+    GraphicAttr aAttr;
+    if (aSettings.bApplyColours)
+    {
+        aAttr.SetDrawMode(rSet.GetDrawModeGrf().GetValue());
+        aAttr.SetLuminance(rSet.GetLuminanceGrf().GetValue());
+        aAttr.SetContrast(rSet.GetContrastGrf().GetValue());
+        aAttr.SetChannelR(rSet.GetChannelRGrf().GetValue());
+        aAttr.SetChannelG(rSet.GetChannelGGrf().GetValue());
+        aAttr.SetChannelB(rSet.GetChannelBGrf().GetValue());
+        aAttr.SetGamma(rSet.GetGammaGrf().GetValue());
+        aAttr.SetInvert(rSet.GetInvertGrf().GetValue());
+    }
+    if (aSettings.bApplyTransparency)
+        aAttr.SetAlpha(255 - basegfx::fround<sal_uInt8>(rSet.GetTransparencyGrf().GetValue() * 2.55));
+
+    const Graphic& rOriginal = rNode.GetGrf();
+    Graphic aApplied(GraphicObject(rOriginal).GetTransformedGraphic(&aAttr));
+    // The crop is kept in the units of the picture's own size: the copy keeps that size (its resolution).
+    aApplied.SetPrefMapMode(rOriginal.GetPrefMapMode());
+    aApplied.SetPrefSize(rOriginal.GetPrefSize());
+    return aApplied;
+}
+
+void WriteDocxPictureEffects(const sax_fastparser::FSHelperPtr& pSerializer, const SwGrfNode& rNode)
+{
+    const WordPictureSettings aSettings
+        = GetWordPictureSettings(rNode.GetSwAttrSet(), WordPictureFormat::Docx, !rNode.IsLinkedFile());
+
+    switch (aSettings.eDrawMode)
+    {
+        case GraphicDrawMode::Greys:
+            pSerializer->singleElementNS(XML_a, XML_grayscl);
+            break;
+        case GraphicDrawMode::Mono: // black and white, at HST Office's threshold of 50 %
+            pSerializer->singleElementNS(XML_a, XML_biLevel, XML_thresh, OString::number(50000));
+            break;
+        case GraphicDrawMode::Watermark: // Word's washout, which the reader takes as a watermark again
+            pSerializer->singleElementNS(XML_a, XML_lum, XML_bright, OString::number(70000), XML_contrast,
+                                         OString::number(-70000));
+            break;
+        default:
+            break;
+    }
+
+    if (aSettings.eDrawMode != GraphicDrawMode::Watermark && (aSettings.nLuminance || aSettings.nContrast))
+    {
+        // a:lum in thousandths of a percent, as the reader takes it back
+        pSerializer->singleElementNS(
+            XML_a, XML_lum, XML_bright,
+            sax_fastparser::UseIf(OString::number(sal_Int32(aSettings.nLuminance) * 1000), aSettings.nLuminance != 0),
+            XML_contrast,
+            sax_fastparser::UseIf(OString::number(sal_Int32(aSettings.nContrast) * 1000), aSettings.nContrast != 0));
+    }
+
+    if (aSettings.nTransparency > 0)
+        pSerializer->singleElementNS(XML_a, XML_alphaModFix, XML_amt,
+                                     OString::number((100 - sal_Int32(aSettings.nTransparency)) * 1000));
+}
+
+void AddEscherPictureRotationAndGamma(const SwNoTextNode& rNode, const WordPictureSettings& rSettings,
+                                      EscherPropertyContainer& rPropOpt)
+{
+    if (!rtl::math::approxEqual(rSettings.fGamma, 1.0) && rSettings.fGamma > 0)
+        rPropOpt.AddOpt(DFF_Prop_pictureGamma,
+                        static_cast<sal_uInt32>(basegfx::fround<sal_Int64>(rSettings.fGamma * 0x10000)));
+
+    if (!rNode.GetGrfNode())
+        return;
+    const SwAttrSet& rSet = rNode.GetSwAttrSet();
+    const sal_Int32 nRotation = rSet.GetRotationGrf().GetValue().get() % 3600;
+    if (!nRotation)
+        return;
+    // HST Office turns counter-clockwise, Word stores clockwise degrees; with one flip Word turns the other way.
+    const MirrorGraph eMirror = rSet.GetMirrorGrf().GetValue();
+    const bool bOneFlip = eMirror == MirrorGraph::Vertical || eMirror == MirrorGraph::Horizontal;
+    const sal_Int32 nClockwise = bOneFlip ? nRotation : (3600 - nRotation) % 3600;
+    rPropOpt.AddOpt(ESCHER_Prop_Rotation, static_cast<sal_uInt32>((sal_Int64(nClockwise) << 16) / 10));
+}
+
+bool SetEscherAnchorOfRotatedPicture(const SwFrameFormat& rFormat, bool bInline, SwTwips nThick, SwTwips& rLeft,
+                                     SwTwips& rTop, SwTwips& rRight, SwTwips& rBottom)
+{
+    if (bInline)
+        return false;
+    const SwGrfNode* pNode = GetPictureNode(rFormat);
+    if (!pNode)
+        return false;
+    const sal_Int32 nRotation = pNode->GetSwAttrSet().GetRotationGrf().GetValue().get() % 3600;
+    if (!nRotation)
+        return false;
+
+    // The frame's size is the unrotated picture; its layout rectangle (rLeft..rBottom) bounds the turned picture
+    // around the same centre.
+    Size aSize(rFormat.GetFrameSize().GetSize());
+    if (IsAnchorSwapped(nRotation))
+        aSize = Size(aSize.Height(), aSize.Width());
+    const SwTwips nWidth = std::max<SwTwips>(aSize.Width() - 2 * nThick, 0);
+    const SwTwips nHeight = std::max<SwTwips>(aSize.Height() - 2 * nThick, 0);
+    const SwTwips nCentreX = (rLeft + rRight) / 2;
+    const SwTwips nCentreY = (rTop + rBottom) / 2;
+    rLeft = nCentreX - nWidth / 2;
+    rRight = rLeft + nWidth;
+    rTop = nCentreY - nHeight / 2;
+    rBottom = rTop + nHeight;
+    return true;
+}
+
+void AddDocxRotatedPicturePositionOffset(const SwFrameFormat& rFormat, sal_Int32& rX, sal_Int32& rY)
+{
+    const SwGrfNode* pNode = GetPictureNode(rFormat);
+    if (!pNode)
+        return;
+    const sal_Int32 nRotation = pNode->GetSwAttrSet().GetRotationGrf().GetValue().get() % 3600;
+    if (!nRotation)
+        return;
+    // Writer's position is the corner of the turned picture's bounding box, Word's that of the unrotated picture
+    // around the same centre.
+    const Size aSize(rFormat.GetFrameSize().GetSize());
+    const double fAngle = basegfx::deg2rad(nRotation / 10.0);
+    const double fCos = std::abs(std::cos(fAngle));
+    const double fSin = std::abs(std::sin(fAngle));
+    const double fBoundWidth = aSize.Width() * fCos + aSize.Height() * fSin;
+    const double fBoundHeight = aSize.Width() * fSin + aSize.Height() * fCos;
+    rX += basegfx::fround((fBoundWidth - aSize.Width()) / 2);
+    rY += basegfx::fround((fBoundHeight - aSize.Height()) / 2);
+}
+
+tools::Rectangle GetImportedPictureFrameRect(const SdrObject& rObject)
+{
+    const tools::Rectangle aBound(rObject.GetSnapRect());
+    if (rObject.GetObjIdentifier() != SdrObjKind::Graphic || !rObject.GetRotateAngle())
+        return aBound;
+    // Writer places a turned picture by its bounding box and sizes it unrotated: the box's corner, the logic size.
+    const tools::Rectangle& rLogic = rObject.GetLogicRect();
+    const Point aCorner(aBound.TopLeft());
+    return tools::Rectangle(aCorner, Size(rLogic.getOpenWidth(), rLogic.getOpenHeight()));
+}
+
+void SetImportedPictureRotation(SwGrfNode& rNode, const SdrObject& rObject, bool bFlipV)
+{
+    if (rObject.GetObjIdentifier() != SdrObjKind::Graphic)
+        return;
+    // The import shows a vertical flip as a half turn of the horizontally mirrored picture; the node keeps the flip.
+    sal_Int32 nAngle = NormAngle36000(rObject.GetRotateAngle()).get();
+    if (bFlipV)
+        nAngle = (nAngle + 18000) % 36000;
+    const sal_Int32 nRotation = ((nAngle + 5) / 10) % 3600;
+    if (!nRotation)
+        return;
+    // A copy of the node's item (the item's own functions are not exported to the filters), turned.
+    const SfxPoolItem& rItem = rNode.GetSwAttrSet().GetRotationGrf();
+    std::unique_ptr<SfxPoolItem> pRotation(rItem.Clone());
+    static_cast<SwRotationGrf&>(*pRotation).SetValue(Degree10(nRotation));
+    rNode.SetAttr(*pRotation);
+}
+
+Size GetInlinePictureFrameSize(const SfxItemSet& rFrameSet, const Size& rPicture)
+{
+    const SvxBoxItem* pBox = rFrameSet.GetItemIfSet(RES_BOX, false);
+    if (!pBox)
+        return rPicture;
+    bool bShadow = false;
+    if (const SvxShadowItem* pShadow = rFrameSet.GetItem<SvxShadowItem>(RES_SHADOW))
+        bShadow = pShadow->GetLocation() != SvxShadowLocation::NONE && pShadow->GetWidth() != 0;
+
+    tools::Long nWidth = rPicture.Width();
+    tools::Long nHeight = rPicture.Height();
+    for (SvxBoxItemLine eLine : { SvxBoxItemLine::TOP, SvxBoxItemLine::LEFT, SvxBoxItemLine::BOTTOM,
+                                  SvxBoxItemLine::RIGHT })
+    {
+        // the border as the export writes it into the picture header, and its room as Word takes it
+        WW8_BRC aBorder;
+        if (const editeng::SvxBorderLine* pLine = pBox->GetLine(eLine))
+        {
+            const WW8_BRCVer9 aBorder9 = WW8Export::TranslateBorderLine(*pLine, pBox->GetDistance(eLine), bShadow);
+            aBorder = WW8_BRC(aBorder9.dptLineWidth(), aBorder9.brcType(), 0, aBorder9.dptSpace(),
+                              aBorder9.fShadow(), aBorder9.fFrame());
+        }
+        short nSpacing = 0;
+        const short nThick = aBorder.DetermineBorderProperties(&nSpacing);
+        const tools::Long nRoom = (bShadow ? 2 * nThick : nThick) + nSpacing;
+        if (eLine == SvxBoxItemLine::TOP || eLine == SvxBoxItemLine::BOTTOM)
+            nHeight += nRoom;
+        else
+            nWidth += nRoom;
+    }
+    return Size(nWidth, nHeight);
+}
+}
