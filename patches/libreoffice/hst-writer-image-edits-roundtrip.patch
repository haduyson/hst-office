+// Linked pictures stay linked, as in Word: the settings Word keeps (brightness and contrast, also together, the draw
+// mode, flips, rotation, and in DOCX transparency, in DOC gamma) are properties of the link; the others are left out.
+CPPUNIT_TEST_FIXTURE(HstImageEditsRoundtripTest, testDocxLinkedPictureKeepsWordSettings)
+{
+    setAllSettings(loadLinkedPicture());
+    uno::Reference<beans::XPropertySet> xPicture = reloadLinked(TestFilter::DOCX);
+    xmlDocUniquePtr pXml = parseExport(u"word/document.xml"_ustr);
+    assertXPath(pXml, "//pic:blipFill/a:blip[@r:link]", 1);
+    assertXPath(pXml, "//pic:blipFill/a:blip/a:lum", "bright", u"20000");
+    assertXPath(pXml, "//pic:blipFill/a:blip/a:lum", "contrast", u"-30000");
+    assertXPath(pXml, "//pic:blipFill/a:blip/a:alphaModFix", "amt", u"60000");
+    CPPUNIT_ASSERT_EQUAL(sal_Int16(20), get<sal_Int16>(xPicture, u"AdjustLuminance"_ustr));
+    CPPUNIT_ASSERT_EQUAL(sal_Int16(-30), get<sal_Int16>(xPicture, u"AdjustContrast"_ustr));
+    CPPUNIT_ASSERT_EQUAL(sal_Int16(40), get<sal_Int16>(xPicture, u"Transparency"_ustr));
+    CPPUNIT_ASSERT_EQUAL(drawing::ColorMode_GREYS, get<drawing::ColorMode>(xPicture, u"GraphicColorMode"_ustr));
+    CPPUNIT_ASSERT(get<bool>(xPicture, u"VertMirrored"_ustr));
+    // DOCX has no gamma or colour channels for a link
+    CPPUNIT_ASSERT_EQUAL(1.0, get<double>(xPicture, u"Gamma"_ustr));
+    CPPUNIT_ASSERT_EQUAL(sal_Int16(0), get<sal_Int16>(xPicture, u"AdjustRed"_ustr));
+}
+
+CPPUNIT_TEST_FIXTURE(HstImageEditsRoundtripTest, testDocxLinkedWatermarkWithBrightness)
