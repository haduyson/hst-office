+// DOCX: brightness and contrast alone are a:lum, transparency is a:alphaModFix; they were not written at all.
+CPPUNIT_TEST_FIXTURE(HstImageEditsRoundtripTest, testDocxBrightnessKept)
+{
+    checkKeptProperty(TestFilter::DOCX, u"AdjustLuminance"_ustr, uno::Any(sal_Int16(20)));
+    xmlDocUniquePtr pXml = parseExport(u"word/document.xml"_ustr);
+    assertXPath(pXml, "//pic:blipFill/a:blip/a:lum", "bright", u"20000");
+}
+
+CPPUNIT_TEST_FIXTURE(HstImageEditsRoundtripTest, testDocxContrastKept)
+{
+    checkKeptProperty(TestFilter::DOCX, u"AdjustContrast"_ustr, uno::Any(sal_Int16(-30)));
+}
+
+CPPUNIT_TEST_FIXTURE(HstImageEditsRoundtripTest, testDocxTransparencyKept)
+{
+    checkKeptProperty(TestFilter::DOCX, u"Transparency"_ustr, uno::Any(sal_Int16(40)));
+    xmlDocUniquePtr pXml = parseExport(u"word/document.xml"_ustr);
+    assertXPath(pXml, "//pic:blipFill/a:blip/a:alphaModFix", "amt", u"60000");
+}
+
+CPPUNIT_TEST_FIXTURE(HstImageEditsRoundtripTest, testDocxGreysWithBrightnessKept)
+{
+    uno::Reference<beans::XPropertySet> xPicture = insertPicture();
+    xPicture->setPropertyValue(u"GraphicColorMode"_ustr, uno::Any(drawing::ColorMode_GREYS));
+    xPicture->setPropertyValue(u"AdjustLuminance"_ustr, uno::Any(sal_Int16(25)));
+    saveAndReload(TestFilter::DOCX);
+    xPicture = writerPicture();
+    CPPUNIT_ASSERT(xPicture.is());
+    CPPUNIT_ASSERT_EQUAL(drawing::ColorMode_GREYS,
+                         xPicture->getPropertyValue(u"GraphicColorMode"_ustr).get<drawing::ColorMode>());
+    CPPUNIT_ASSERT_EQUAL(sal_Int16(25), xPicture->getPropertyValue(u"AdjustLuminance"_ustr).get<sal_Int16>());
+}
+
+// DOCX: a vertical flip is a:xfrm flipV, and the picture stays a Writer picture flipped vertically.
+CPPUNIT_TEST_FIXTURE(HstImageEditsRoundtripTest, testDocxVerticalFlipKept)
+{
+    uno::Reference<beans::XPropertySet> xPicture = insertPicture();
+    xPicture->setPropertyValue(u"VertMirrored"_ustr, uno::Any(true));
+    saveAndReload(TestFilter::DOCX);
+    xmlDocUniquePtr pXml = parseExport(u"word/document.xml"_ustr);
+    assertXPath(pXml, "//pic:spPr/a:xfrm", "flipV", u"1");
+    xPicture = writerPicture();
+    CPPUNIT_ASSERT(xPicture.is());
+    CPPUNIT_ASSERT(xPicture->getPropertyValue(u"VertMirrored"_ustr).get<bool>());
+    CPPUNIT_ASSERT(!xPicture->getPropertyValue(u"HoriMirroredOnOddPages"_ustr).get<bool>());
+}
