+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * Part of HST Office. This file is HST's own work and is not covered by the MPL.
+ */
+
+#pragma once
+
+#include <sax/fshelper.hxx>
+#include <swtypes.hxx>
+#include <tools/gen.hxx>
+#include <vcl/GraphicAttributes.hxx>
+#include <vcl/graph.hxx>
+
+class EscherPropertyContainer;
+class SfxItemSet;
+class SdrObject;
+class SwAttrSet;
+class SwFrameFormat;
+class SwGrfNode;
+class SwNoTextNode;
+
+/** How the picture settings of Writer (Picture tab, Image dialog) are kept in Word files.
+
+    Word files store a draw mode (grey, black and white, washout), brightness or contrast alone, transparency (DOCX)
+    and gamma (DOC). What a format cannot store, or cannot store so that HST Office and Word show the same picture
+    (brightness together with contrast, a washout together with either, the red/green/blue channels, inverting, gamma
+    in DOCX, transparency in DOC), is applied to a copy of the picture that is written instead, the same way HST
+    Office draws it. Reopened, the picture looks as it did, with those settings at their defaults. A linked picture stays
+    linked and nothing is applied to it (see GetWordPictureSettings). */
+namespace sw::hst
+{
+enum class WordPictureFormat
+{
+    Docx,
+    Doc
+};
+
+/// The settings written as Word properties, and whether the rest is applied to the written picture.
+struct WordPictureSettings
+{
+    GraphicDrawMode eDrawMode = GraphicDrawMode::Standard;
+    sal_Int16 nLuminance = 0; ///< percent, -100 .. 100
+    sal_Int16 nContrast = 0; ///< percent, -100 .. 100
+    double fGamma = 1.0; ///< DOC only
+    sal_Int16 nTransparency = 0; ///< percent, DOCX only
+    bool bApplyColours = false; ///< draw mode and every colour setting are applied to the written picture
+    bool bApplyTransparency = false; ///< the transparency is applied to the written picture
+};
+
+/// What is written for a picture with the graphic attributes rSet. Without bCanApply (a linked picture, an OLE
+/// object's preview) nothing is applied, as in Word: the settings Word stores are written as properties of the link
+/// (brightness and contrast together too, a watermark with either as the brightness and contrast it shows), the
+/// others (gamma in DOCX, colour channels, invert, transparency in DOC) are left out.
+WordPictureSettings GetWordPictureSettings(const SwAttrSet& rSet, WordPictureFormat eFormat, bool bCanApply);
+
+/// The picture data to write for rNode: its graphic, or a copy with the settings the format cannot store applied.
+Graphic GetWordPictureGraphic(const SwGrfNode& rNode, WordPictureFormat eFormat);
+
+/// DOCX: the effects inside a:blip for rNode (a:grayscl, a:biLevel, a:lum, a:alphaModFix).
+void WriteDocxPictureEffects(const sax_fastparser::FSHelperPtr& pSerializer, const SwGrfNode& rNode);
+
+/// DOC: the escher rotation (16.16 degrees, clockwise, combined with the shape's flips as Word reads it) and gamma.
+void AddEscherPictureRotationAndGamma(const SwNoTextNode& rNode, const WordPictureSettings& rSettings,
+                                      EscherPropertyContainer& rPropOpt);
+
+/// DOC: Word anchors a rotated picture by its unrotated rectangle around the same centre, with width and height
+/// swapped for 45..135 and 225..315 degrees. Moves rLeft..rBottom (the rotated frame's rectangle, nThick inside its
+/// border) to it; false and nothing changed when rFormat is not a rotated floating picture.
+bool SetEscherAnchorOfRotatedPicture(const SwFrameFormat& rFormat, bool bInline, SwTwips nThick, SwTwips& rLeft,
+                                     SwTwips& rTop, SwTwips& rRight, SwTwips& rBottom);
+
+/// DOCX export: moves the position (rX, rY) of a turned picture from Writer's bounding-box corner to the corner of the
+/// unrotated picture, which Word positions.
+void AddDocxRotatedPicturePositionOffset(const SwFrameFormat& rFormat, sal_Int32& rX, sal_Int32& rY);
+
+/// DOC import: the frame rectangle of a picture read as the rotated escher object rObject: its unrotated size at the
+/// corner of its bounds (Writer positions a turned picture by its bounding box). Other objects keep their bounds.
+tools::Rectangle GetImportedPictureFrameRect(const SdrObject& rObject);
+
+/// DOC import: gives rNode the rotation of rObject without the half turn the import adds for a vertical flip.
+void SetImportedPictureRotation(SwGrfNode& rNode, const SdrObject& rObject, bool bFlipV);
+
+/// DOC import: the frame size of an as-character picture of rPicture (Word's size, without its borders) with the
+/// borders and shadow of rFrameSet around it, exactly what the export takes off again. Without it a bordered
+/// picture became smaller on every save.
+Size GetInlinePictureFrameSize(const SfxItemSet& rFrameSet, const Size& rPicture);
+}
