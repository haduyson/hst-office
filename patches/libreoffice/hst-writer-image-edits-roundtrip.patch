+
+#include "hstpictureimport.hxx"
+
+#include <com/sun/star/awt/Size.hpp>
+#include <com/sun/star/beans/PropertyValue.hpp>
+#include <com/sun/star/beans/XPropertySetInfo.hpp>
+#include <com/sun/star/table/ShadowFormat.hpp>
+
+using namespace css;
+
+namespace hst::pictureimport
+{
+namespace
+{
+template <typename T> T GetProperty(const uno::Reference<beans::XPropertySet>& xProps, const OUString& rName, T aDefault)
+{
+    if (!xProps.is() || !xProps->getPropertySetInfo()->hasPropertyByName(rName))
+        return aDefault;
+    T aValue = aDefault;
+    xProps->getPropertyValue(rName) >>= aValue;
+    return aValue;
+}
+}
+
+bool IsVerticallyFlipped(const uno::Reference<beans::XPropertySet>& xShapeProps)
+{
+    return GetProperty<sal_Int32>(xShapeProps, u"RotateAngle"_ustr, 0) == 18000
+           && GetProperty<bool>(xShapeProps, u"IsMirrored"_ustr, false);
+}
+
+bool IsPictureShadowOnly(const uno::Any& rEffects)
+{
+    uno::Sequence<beans::PropertyValue> aEffects;
+    if (!(rEffects >>= aEffects) || aEffects.getLength() != 1 || aEffects[0].Name != "outerShdw")
+        return false;
+    uno::Sequence<beans::PropertyValue> aShadow;
+    aEffects[0].Value >>= aShadow;
+    for (const beans::PropertyValue& rProp : aShadow)
+    {
+        if (rProp.Name != "Attribs")
+            continue;
+        uno::Sequence<beans::PropertyValue> aAttribs;
+        rProp.Value >>= aAttribs;
+        for (const beans::PropertyValue& rAttrib : aAttribs)
+        {
+            sal_Int32 nValue = 0;
+            rAttrib.Value >>= nValue;
+            if ((rAttrib.Name == "blurRad" || rAttrib.Name == "kx" || rAttrib.Name == "ky") && nValue != 0)
+                return false;
+            if ((rAttrib.Name == "sx" || rAttrib.Name == "sy") && nValue != 100000)
+                return false;
+        }
+    }
+    return true;
+}
+
+void ApplyShapeSettings(const uno::Reference<beans::XPropertySet>& xShapeProps,
+                        const uno::Reference<beans::XPropertySet>& xGraphicObject)
+{
+    if (!xShapeProps.is() || !xGraphicObject.is())
+        return;
+
+    const sal_Int16 nTransparency = GetProperty<sal_Int16>(xShapeProps, u"Transparency"_ustr, 0);
+    if (nTransparency > 0 && nTransparency <= 100)
+        xGraphicObject->setPropertyValue(u"Transparency"_ustr, uno::Any(nTransparency));
+
+    // A Writer picture's size includes its shadow, Word's extent does not (the export takes it off again).
+    const table::ShadowFormat aShadow
+        = GetProperty<table::ShadowFormat>(xGraphicObject, u"ShadowFormat"_ustr, table::ShadowFormat());
+    if (aShadow.Location != table::ShadowLocation_NONE && aShadow.ShadowWidth > 0)
+    {
+        awt::Size aSize = GetProperty<awt::Size>(xGraphicObject, u"Size"_ustr, awt::Size());
+        if (aSize.Width > 0 && aSize.Height > 0)
+        {
+            aSize.Width += aShadow.ShadowWidth;
+            aSize.Height += aShadow.ShadowWidth;
+            xGraphicObject->setPropertyValue(u"Size"_ustr, uno::Any(aSize));
+        }
+    }
+
+    if (IsVerticallyFlipped(xShapeProps))
+    {
+        // Not mirrored horizontally (the shape's mirror only completes the half turn), mirrored vertically.
+        xGraphicObject->setPropertyValue(u"HoriMirroredOnEvenPages"_ustr, uno::Any(false));
+        xGraphicObject->setPropertyValue(u"HoriMirroredOnOddPages"_ustr, uno::Any(false));
+        xGraphicObject->setPropertyValue(u"VertMirrored"_ustr, uno::Any(true));
+    }
+}
+}
