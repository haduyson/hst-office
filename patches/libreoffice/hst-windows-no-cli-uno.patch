 #include "macros.inc"
 
-#if defined _MSC_VER && ! defined _ARM64_
+#if defined _MSC_VER && ! defined _ARM64_ && defined ENABLE_CLI
 
 File gid_File_Lib_Cli_Oootypes_Assembly
     TXT_FILE_BODY;
