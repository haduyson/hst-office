+// HST Office: the label of a large ribbon button (text below its image) may have line breaks, as the
+// two-line labels of Office's large buttons. Other labels have none and keep their single line.
+bool ImplHasLabelLines(const OUString& rText, ToolBoxTextPosition ePosition)
+{
+    return ePosition == ToolBoxTextPosition::Bottom && rText.indexOf('\n') >= 0;
+}
+
+Size ImplLabelLinesSize(const OutputDevice& rDev, const OUString& rText)
+{
+    tools::Long nWidth = 0;
+    tools::Long nLines = 0;
+    sal_Int32 nIndex = 0;
+    do
+    {
+        const OUString aLine(o3tl::getToken(rText, 0, '\n', nIndex));
+        nWidth = std::max(nWidth, rDev.GetCtrlTextWidth(aLine));
+        ++nLines;
+    } while (nIndex >= 0);
+    return Size(nWidth, nLines * rDev.GetTextHeight());
+}
+}
