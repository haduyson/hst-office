+#if !defined(_WIN32) && !defined(MACOSX)
+    // HST Office: without a Firefox/Thunderbird profile, use the per-user shared NSS database
+    // (~/.pki/nssdb, also used by Chromium and PKCS#11 token tools) when it exists, so a USB
+    // signing token registered there with modutil is found instead of a throw-away temporary
+    // database.
+    if (m_sNSSPath.isEmpty())
+    {
+        OUString sHomeURL;
+        OUString sShared;
+        if (osl::Security().getHomeDir(sHomeURL)
+            && osl::FileBase::getSystemPathFromFileURL(sHomeURL + "/.pki/nssdb", sShared)
+                   == osl::FileBase::E_None
+            && lcl_pathExists(sShared + "/cert9.db"))
+        {
+            SAL_INFO("xmlsecurity.xmlsec", "Using the shared NSS database " << sShared);
+            m_sNSSPath = sShared;
+        }
+    }
+#endif
+
     SAL_INFO_IF(m_sNSSPath.isEmpty(), "xmlsecurity.xmlsec", "No Mozilla profile found");
     return m_sNSSPath;
 }
