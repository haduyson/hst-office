+#if USE_TLS_NSS
+// HST Office: initialise NSS the way the signing code does (the user's certificate database and
+// its PKCS#11 modules, e.g. USB signing tokens). A database-less NSS_NoDB_Init() here, e.g. on
+// the first PDF export, made the signing code's later NSS_InitReadWrite() a no-op, so
+// certificates and tokens stayed invisible for the rest of the session. Not on Windows, where
+// signing uses the system certificate store.
+void initNSSWithProfile()
+{
+#if !defined(_WIN32)
+    try
+    {
+        css::uno::Reference<css::uno::XComponentContext> xContext
+            = comphelper::getProcessComponentContext();
+        if (xContext.is())
+            css::xml::crypto::NSSInitializer::create(xContext)->getDigestContext(
+                css::xml::crypto::DigestID::SHA256, {});
+    }
+    catch (const css::uno::Exception&)
+    {
+        // no component context or xmlsecurity: the caller falls back to NSS_NoDB_Init()
+    }
+#endif
+}
+#endif
+
