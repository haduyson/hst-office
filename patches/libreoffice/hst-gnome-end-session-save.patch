+// HST Office: store the open documents as a session before anything is dropped, as the X11
+// session management does (SessionListener: doSessionSave, then doSessionQuietQuit). Every
+// document is written to its recovery file and closed with its entry kept (modified state
+// included), and the session is marked (RecoveryInfo/SessionData): the next start reopens the
+// documents with their changes. Without AutoRecovery (--norestore) both jobs do nothing and the
+// documents are dropped as before.
+static void store_session()
+{
+    try
+    {
+        const css::uno::Reference<css::uno::XComponentContext>& xContext = ::comphelper::getProcessComponentContext();
+        css::uno::Reference<css::frame::XDispatch> xRecovery = css::frame::theAutoRecovery::get(xContext);
+        css::uno::Reference<css::util::XURLTransformer> xParser = css::util::URLTransformer::create(xContext);
+        for (const OUString& rJob : { u"doSessionSave"_ustr, u"doSessionQuietQuit"_ustr })
+        {
+            css::util::URL aURL;
+            aURL.Complete = "vnd.sun.star.autorecovery:/" + rJob;
+            xParser->parseStrict(aURL);
+            xRecovery->dispatch(aURL, { comphelper::makePropertyValue(u"DispatchAsynchron"_ustr, false) });
+        }
+    }
+    catch (const css::uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("vcl.gtk", "session save at the end of the desktop session failed");
+    }
+}
+
+// HST Office: every frame gets EndSession/Stop; the first one stores the session and ends the
+// office. Storing runs the main loop, so the signal for another frame can arrive meanwhile: that
+// one only answers, a nested terminate would leave the office running.
+static bool first_session_end()
+{
+    static bool bEnding = false;
+    if (bEnding)
+        return false;
+    bEnding = true;
+    return true;
+}
+
 // unset documents "modify" flag so they won't veto closing
 static void clear_modify_and_terminate()
 {
@@ -1552,11 +1594,21 @@
     }
     else if (g_str_equal (signal_name, "EndSession"))
     {
+        if (!first_session_end())
+        {
+            session_client_response(client_proxy);
+            return;
+        }
+        // HST Office: store before answering, the session manager may end the session at once
+        store_session();
         session_client_response(client_proxy);
         clear_modify_and_terminate();
     }
     else if (g_str_equal (signal_name, "Stop"))
     {
+        if (!first_session_end())
+            return;
+        store_session();
         clear_modify_and_terminate();
     }
 }
