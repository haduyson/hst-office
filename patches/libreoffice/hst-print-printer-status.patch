+namespace
+{
+bool has(PrintQueueFlags nFlags, PrintQueueFlags nFlag) { return bool(nFlags & nFlag); }
+
+/// Flags that stop the printer until someone acts: red.
+constexpr PrintQueueFlags ERROR_FLAGS
+    = PrintQueueFlags::Error | PrintQueueFlags::PaperJam | PrintQueueFlags::PaperOut
+      | PrintQueueFlags::PaperProblem | PrintQueueFlags::DoorOpen | PrintQueueFlags::NoToner
+      | PrintQueueFlags::OutputBinFull | PrintQueueFlags::UserIntervention
+      | PrintQueueFlags::OutOfMemory | PrintQueueFlags::PagePunt;
+/// Flags of a printer that works but cannot start the job at once: amber.
+constexpr PrintQueueFlags BUSY_FLAGS
+    = PrintQueueFlags::Busy | PrintQueueFlags::Printing | PrintQueueFlags::Processing
+      | PrintQueueFlags::WarmingUp | PrintQueueFlags::Initializing | PrintQueueFlags::Waiting
+      | PrintQueueFlags::IOActive | PrintQueueFlags::ManualFeed | PrintQueueFlags::TonerLow;
+}
+
+PrinterStatus ClassifyPrinterStatus(PrintQueueFlags nFlags, bool bKnown)
+{
+    PrinterStatus aStatus;
+    aStatus.nFlags = nFlags;
+    if (!bKnown || has(nFlags, PrintQueueFlags::StatusUnknown))
+        aStatus.eState = PrinterState::Unknown;
+    else if (has(nFlags, PrintQueueFlags::Offline | PrintQueueFlags::PendingDeletion))
+        aStatus.eState = PrinterState::Offline;
+    else if (has(nFlags, ERROR_FLAGS))
+        aStatus.eState = PrinterState::Error;
+    else if (has(nFlags, PrintQueueFlags::Paused))
+        aStatus.eState = PrinterState::Paused;
+    else if (has(nFlags, BUSY_FLAGS))
+        aStatus.eState = PrinterState::Busy;
+    else // no flag (the systems report a printer that waits for jobs so), Ready, PowerSave
+        aStatus.eState = PrinterState::Ready;
+    return aStatus;
+}
+
+OUString PrinterStatusText(const PrinterStatus& rStatus)
+{
+    const PrintQueueFlags nFlags = rStatus.nFlags;
+    switch (rStatus.eState)
+    {
+        case PrinterState::Ready:
+            return VclResId(STR_HST_PRINTER_READY);
+        case PrinterState::Busy:
+            // a low toner is the only news of a printer that is otherwise idle
+            if (has(nFlags, PrintQueueFlags::TonerLow)
+                && !has(nFlags, BUSY_FLAGS & ~PrintQueueFlags::TonerLow))
+                return VclResId(STR_HST_PRINTER_TONER_LOW);
+            return VclResId(STR_HST_PRINTER_BUSY);
+        case PrinterState::Paused:
+            return VclResId(STR_HST_PRINTER_PAUSED);
+        case PrinterState::Offline:
+            return VclResId(STR_HST_PRINTER_OFFLINE);
+        case PrinterState::Error:
+            if (has(nFlags, PrintQueueFlags::PaperOut))
+                return VclResId(STR_HST_PRINTER_PAPER_OUT);
+            if (has(nFlags, PrintQueueFlags::PaperJam))
+                return VclResId(STR_HST_PRINTER_PAPER_JAM);
+            if (has(nFlags, PrintQueueFlags::DoorOpen))
+                return VclResId(STR_HST_PRINTER_DOOR_OPEN);
+            if (has(nFlags, PrintQueueFlags::NoToner))
+                return VclResId(STR_HST_PRINTER_NO_TONER);
+            return VclResId(STR_HST_PRINTER_ERROR);
+        case PrinterState::Unknown:
+            break;
+    }
+    return VclResId(STR_HST_PRINTER_UNKNOWN);
+}
+
+Color PrinterStatusColor(PrinterState eState)
+{
+    switch (eState)
+    {
+        case PrinterState::Ready:
+            return Color(0x2E, 0xA0, 0x43); // green
+        case PrinterState::Busy:
+        case PrinterState::Paused:
+            return Color(0xE5, 0x9F, 0x00); // amber
+        case PrinterState::Offline:
+        case PrinterState::Error:
+            return Color(0xD9, 0x30, 0x25); // red
+        case PrinterState::Unknown:
+            break;
+    }
+    return Color(0x9A, 0x9A, 0x9A); // grey
+}
+
+/* The states are asked on a thread; the view looks for them on a timer of the main thread, so the
+   thread never touches a widget and outlives the view without harm (it only holds Shared). */
+struct PrinterStatusView::Impl
+{
+    struct Shared
+    {
+        std::mutex aMutex;
+        std::vector<std::pair<OUString, PrinterStatus>> aResults;
+        bool bDone = false;
+    };
+
+    weld::ComboBox& m_rPrinters;
+    weld::Label& m_rStatus;
+    int m_nFirst;
+    OUString m_aText; ///< the label's own text (e.g. "Default printer")
+    std::vector<OUString> m_aNames; ///< of the entries from m_nFirst on
+    std::vector<PrinterStatus> m_aStates;
+    std::shared_ptr<Shared> m_xQuery; ///< the running query
+    Timer m_aPoll;
+
+    Impl(weld::ComboBox& rPrinters, weld::Label& rStatus, int nFirst)
+        : m_rPrinters(rPrinters)
+        , m_rStatus(rStatus)
+        , m_nFirst(nFirst)
+        , m_aText(rStatus.get_label())
+        , m_aPoll("vcl::hst::PrinterStatusView")
+    {
+        for (int i = m_nFirst; i < m_rPrinters.get_count(); ++i)
+            m_aNames.push_back(m_rPrinters.get_text(i));
+        m_aStates.resize(m_aNames.size());
+        m_aPoll.SetTimeout(200);
+        m_aPoll.SetInvokeHandler(LINK(this, Impl, PollHdl));
+        ShowDots();
+        ShowSelected();
+        Start();
+    }
+
+    ~Impl() { m_aPoll.Stop(); }
+
+    void Start()
+    {
+        if (m_xQuery || m_aNames.empty())
+            return;
+        auto xShared = std::make_shared<Shared>();
+        m_xQuery = xShared;
+        try
+        {
+            std::thread(
+                [xShared, aNames = m_aNames]()
+                {
+                    for (const OUString& rName : aNames)
+                    {
+                        PrinterStatus aStatus;
+                        try
+                        {
+                            aStatus = QueryPrinterStatus(rName);
+                        }
+                        catch (const std::exception&)
+                        {
+                            // grey: the state stays unknown
+                        }
+                        std::scoped_lock aGuard(xShared->aMutex);
+                        xShared->aResults.emplace_back(rName, aStatus);
+                    }
+                    std::scoped_lock aGuard(xShared->aMutex);
+                    xShared->bDone = true;
+                })
+                .detach();
+        }
+        catch (const std::exception& rException)
+        {
+            SAL_WARN("vcl.print", "no printer state thread: " << rException.what());
+            m_xQuery.reset();
+            return;
+        }
+        m_aPoll.Start();
+    }
+
+    DECL_LINK(PollHdl, Timer*, void);
+    DECL_LINK(PopupHdl, weld::ComboBox&, void);
+    bool m_bDotsPending = false; ///< states arrived while the list was dropped down
+
+    VclPtr<VirtualDevice> MakeDot(PrinterState eState) const
+    {
+        // 10 px at 100 %, with the DPI scale and with the list's own font (GDK_DPI_SCALE, large fonts)
+        const int nTextHeight = m_rPrinters.get_text_height();
+        const tools::Long nDiameter = std::max<tools::Long>(
+            std::lround(10 * Application::GetDefaultDevice()->GetDPIScaleFactor()),
+            nTextHeight * 5 / 8);
+        // as high as a text line, the dot in its middle: centred on the text whatever the row height
+        const Size aSize(nDiameter + 2, std::max<tools::Long>(nDiameter, nTextHeight));
+        VclPtr<VirtualDevice> xDev = VclPtr<VirtualDevice>::Create(DeviceFormat::WITH_ALPHA);
+        xDev->SetOutputSizePixel(aSize);
+        xDev->SetBackground(Wallpaper(COL_TRANSPARENT));
+        xDev->Erase();
+        const Color aColor = PrinterStatusColor(eState);
+        Color aRing(aColor); // 1 px darker outline: amber and grey show on light, dark and highlight
+        aRing.DecreaseLuminance(80);
+        xDev->SetAntialiasing(AntialiasingFlags::Enable);
+        xDev->SetFillColor(aColor);
+        xDev->SetLineColor(aRing);
+        xDev->DrawEllipse(tools::Rectangle(
+            Point((aSize.Width() - nDiameter) / 2, (aSize.Height() - nDiameter) / 2),
+            Size(nDiameter, nDiameter)));
+        return xDev;
+    }
+
+    /// Entries are made again with their dot (a combo box has no image setter); selection kept.
+    void ShowDots()
+    {
+        if (m_rPrinters.get_popup_shown())
+        {
+            m_bDotsPending = true; // never under the user's pointer: shown at the popdown
+            return;
+        }
+        m_bDotsPending = false;
+        const int nActive = m_rPrinters.get_active();
+        m_rPrinters.freeze();
+        for (size_t i = 0; i < m_aNames.size(); ++i)
+        {
+            const int nPos = m_nFirst + int(i);
+            if (nPos >= m_rPrinters.get_count() || m_rPrinters.get_text(nPos) != m_aNames[i])
+                break; // the list changed under us: leave it
+            VclPtr<VirtualDevice> xDot = MakeDot(m_aStates[i].eState);
+            m_rPrinters.remove(nPos);
+            m_rPrinters.insert(nPos, m_aNames[i], nullptr, nullptr, xDot.get());
+        }
+        m_rPrinters.thaw();
+        m_rPrinters.set_active(nActive);
+    }
+
+    void ShowSelected()
+    {
+        const int nActive = m_rPrinters.get_active();
+        const int nIndex = nActive - m_nFirst;
+        if (nIndex < 0 || o3tl::make_unsigned(nIndex) >= m_aStates.size())
+        {
+            m_rStatus.set_label(m_aText);
+            m_rPrinters.set_tooltip_text(OUString());
+            return;
+        }
+        const OUString aState = PrinterStatusText(m_aStates[nIndex]);
+        m_rStatus.set_label(m_aText.isEmpty() ? aState : aState + u" — " + m_aText);
+        m_rPrinters.set_tooltip_text(m_aNames[nIndex] + u": " + aState);
+        m_rPrinters.set_accessible_description(m_aNames[nIndex] + u": " + aState);
+    }
+};
+
+IMPL_LINK_NOARG(PrinterStatusView::Impl, PollHdl, Timer*, void)
+{
+    std::vector<std::pair<OUString, PrinterStatus>> aResults;
+    bool bDone = false;
+    if (m_xQuery)
+    {
+        std::scoped_lock aGuard(m_xQuery->aMutex);
+        aResults.swap(m_xQuery->aResults);
+        bDone = m_xQuery->bDone;
+    }
+    bool bChanged = false;
+    for (const auto & [ rName, rStatus ] : aResults)
+        for (size_t i = 0; i < m_aNames.size(); ++i)
+            if (m_aNames[i] == rName)
+            {
+                bChanged = bChanged || m_aStates[i].eState != rStatus.eState;
+                m_aStates[i] = rStatus; // the same dot may come with another text
+            }
+    if (bChanged)
+        ShowDots();
+    ShowSelected();
+    if (bDone)
+        m_xQuery.reset();
+    if (m_xQuery)
+        m_aPoll.Start();
+}
+
+IMPL_LINK_NOARG(PrinterStatusView::Impl, PopupHdl, weld::ComboBox&, void)
+{
+    if (m_rPrinters.get_popup_shown())
+        Start(); // the states again, fresh (a printer may have come back)
+    else if (m_bDotsPending)
+        ShowDots();
+}
+
+PrinterStatusView::PrinterStatusView(weld::ComboBox& rPrinters, weld::Label& rStatus,
+                                     int nFirstPrinter)
+    : m_pImpl(std::make_unique<Impl>(rPrinters, rStatus, nFirstPrinter))
+{
+    rPrinters.connect_popup_toggled(LINK(m_pImpl.get(), Impl, PopupHdl));
+}
+
+PrinterStatusView::~PrinterStatusView() = default;
+
+void PrinterStatusView::SelectionChanged(const OUString& rText)
+{
+    m_pImpl->m_aText = rText;
+    m_pImpl->ShowSelected();
+}
+}
