+    void testPrinterStatusMapping()
+    {
+        using vcl::hst::ClassifyPrinterStatus;
+        using vcl::hst::PrinterState;
+        auto state = [](PrintQueueFlags nFlags, bool bKnown = true)
+        { return ClassifyPrinterStatus(nFlags, bKnown).eState; };
+        auto text = [](PrintQueueFlags nFlags, bool bKnown = true)
+        { return vcl::hst::PrinterStatusText(ClassifyPrinterStatus(nFlags, bKnown)); };
+        // grey: nothing known
+        CPPUNIT_ASSERT(PrinterState::Unknown == state(PrintQueueFlags::NONE, false));
+        CPPUNIT_ASSERT(PrinterState::Unknown == state(PrintQueueFlags::StatusUnknown));
+        CPPUNIT_ASSERT_EQUAL(u"Status unknown"_ustr, text(PrintQueueFlags::NONE, false));
+        // green: a queue without news waits for jobs
+        CPPUNIT_ASSERT(PrinterState::Ready == state(PrintQueueFlags::NONE));
+        CPPUNIT_ASSERT(PrinterState::Ready == state(PrintQueueFlags::Ready));
+        CPPUNIT_ASSERT(PrinterState::Ready == state(PrintQueueFlags::PowerSave));
+        CPPUNIT_ASSERT_EQUAL(u"Ready"_ustr, text(PrintQueueFlags::NONE));
+        // amber: busy or paused
+        for (PrintQueueFlags nFlag : { PrintQueueFlags::Printing, PrintQueueFlags::Busy,
+                                       PrintQueueFlags::WarmingUp, PrintQueueFlags::Processing })
+        {
+            CPPUNIT_ASSERT(PrinterState::Busy == state(nFlag));
+            CPPUNIT_ASSERT_EQUAL(u"Busy"_ustr, text(nFlag));
+        }
+        CPPUNIT_ASSERT(PrinterState::Busy == state(PrintQueueFlags::TonerLow));
+        CPPUNIT_ASSERT_EQUAL(u"Toner low"_ustr, text(PrintQueueFlags::TonerLow));
+        CPPUNIT_ASSERT_EQUAL(u"Busy"_ustr, text(PrintQueueFlags::TonerLow | PrintQueueFlags::Printing));
+        CPPUNIT_ASSERT(PrinterState::Paused == state(PrintQueueFlags::Paused));
+        CPPUNIT_ASSERT_EQUAL(u"Paused"_ustr, text(PrintQueueFlags::Paused));
+        // red: offline wins over everything, errors over paused/busy
+        CPPUNIT_ASSERT(PrinterState::Offline
+                       == state(PrintQueueFlags::Offline | PrintQueueFlags::Paused));
+        CPPUNIT_ASSERT_EQUAL(u"Offline"_ustr, text(PrintQueueFlags::Offline));
+        CPPUNIT_ASSERT(PrinterState::Error
+                       == state(PrintQueueFlags::PaperOut | PrintQueueFlags::Printing));
+        CPPUNIT_ASSERT_EQUAL(u"Error: out of paper"_ustr, text(PrintQueueFlags::PaperOut));
+        CPPUNIT_ASSERT_EQUAL(u"Error: paper jam"_ustr, text(PrintQueueFlags::PaperJam));
+        CPPUNIT_ASSERT_EQUAL(u"Error: door open"_ustr, text(PrintQueueFlags::DoorOpen));
+        CPPUNIT_ASSERT_EQUAL(u"Error: out of toner"_ustr, text(PrintQueueFlags::NoToner));
+        CPPUNIT_ASSERT_EQUAL(u"Error"_ustr, text(PrintQueueFlags::Error));
+        // the dots: four distinct colours
+        const Color aGreen = vcl::hst::PrinterStatusColor(PrinterState::Ready);
+        const Color aAmber = vcl::hst::PrinterStatusColor(PrinterState::Busy);
+        const Color aRed = vcl::hst::PrinterStatusColor(PrinterState::Error);
+        const Color aGrey = vcl::hst::PrinterStatusColor(PrinterState::Unknown);
+        CPPUNIT_ASSERT_EQUAL(aAmber, vcl::hst::PrinterStatusColor(PrinterState::Paused));
+        CPPUNIT_ASSERT_EQUAL(aRed, vcl::hst::PrinterStatusColor(PrinterState::Offline));
+        CPPUNIT_ASSERT(aGreen.GetGreen() > aGreen.GetRed() && aRed.GetRed() > aRed.GetGreen());
+        CPPUNIT_ASSERT(aGreen != aAmber && aAmber != aRed && aRed != aGrey && aGrey != aGreen);
+    }
