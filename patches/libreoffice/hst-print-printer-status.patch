+
+// HST Office: the state of one printer, asked from the system on a thread of the Print page
+// (vcl::hst::PrinterStatusView). Windows: the spooler's printer status and its "use offline"
+// attribute; Linux/BSD: the CUPS printer state and state reasons; elsewhere: unknown (grey).
+
+#include <vcl/hstprinterstatus.hxx>
+
+#include <config_cups.h>
+
+#include <cstdlib>
+#include <string_view>
+
+#if defined(_WIN32)
+#include <prewin.h>
+#include <postwin.h>
+#include <winspool.h>
+#include <o3tl/char16_t2wchar_t.hxx>
+#include <vector>
+#elif ENABLE_CUPS && !defined(MACOSX) && !defined(IOS) && !defined(ANDROID) // vcl links cups
+#include <cups/cups.h>
+#include <rtl/string.hxx>
+#include <rtl/textenc.h>
+#include <string_view>
+#endif
+
+namespace vcl::hst
+{
+#if defined(_WIN32)
+namespace
+{
+struct WinFlag
+{
+    DWORD nWin;
+    PrintQueueFlags nFlag;
+};
+// the PRINTER_STATUS_* bits of PRINTER_INFO_2 (winspool.h) and what they mean here
+constexpr WinFlag WIN_FLAGS[]
+    = { { PRINTER_STATUS_PAUSED, PrintQueueFlags::Paused },
+        { PRINTER_STATUS_ERROR, PrintQueueFlags::Error },
+        { PRINTER_STATUS_PENDING_DELETION, PrintQueueFlags::PendingDeletion },
+        { PRINTER_STATUS_PAPER_JAM, PrintQueueFlags::PaperJam },
+        { PRINTER_STATUS_PAPER_OUT, PrintQueueFlags::PaperOut },
+        { PRINTER_STATUS_MANUAL_FEED, PrintQueueFlags::ManualFeed },
+        { PRINTER_STATUS_PAPER_PROBLEM, PrintQueueFlags::PaperProblem },
+        { PRINTER_STATUS_OFFLINE, PrintQueueFlags::Offline },
+        { PRINTER_STATUS_NOT_AVAILABLE, PrintQueueFlags::Offline },
+        { PRINTER_STATUS_IO_ACTIVE, PrintQueueFlags::IOActive },
+        { PRINTER_STATUS_BUSY, PrintQueueFlags::Busy },
+        { PRINTER_STATUS_PRINTING, PrintQueueFlags::Printing },
+        { PRINTER_STATUS_OUTPUT_BIN_FULL, PrintQueueFlags::OutputBinFull },
+        { PRINTER_STATUS_WAITING, PrintQueueFlags::Waiting },
+        { PRINTER_STATUS_PROCESSING, PrintQueueFlags::Processing },
+        { PRINTER_STATUS_INITIALIZING, PrintQueueFlags::Initializing },
+        { PRINTER_STATUS_WARMING_UP, PrintQueueFlags::WarmingUp },
+        { PRINTER_STATUS_TONER_LOW, PrintQueueFlags::TonerLow },
+        { PRINTER_STATUS_NO_TONER, PrintQueueFlags::NoToner },
+        { PRINTER_STATUS_PAGE_PUNT, PrintQueueFlags::PagePunt },
+        { PRINTER_STATUS_USER_INTERVENTION, PrintQueueFlags::UserIntervention },
+        { PRINTER_STATUS_OUT_OF_MEMORY, PrintQueueFlags::OutOfMemory },
+        { PRINTER_STATUS_DOOR_OPEN, PrintQueueFlags::DoorOpen },
+        { PRINTER_STATUS_SERVER_UNKNOWN, PrintQueueFlags::StatusUnknown },
+        { PRINTER_STATUS_POWER_SAVE, PrintQueueFlags::PowerSave } };
+}
+
+static PrinterStatus lcl_systemStatus(const OUString& rPrinterName)
+{
+    HANDLE hPrinter = nullptr;
+    if (!OpenPrinterW(const_cast<LPWSTR>(o3tl::toW(rPrinterName.getStr())), &hPrinter, nullptr))
+        return ClassifyPrinterStatus(PrintQueueFlags::NONE, false);
+    DWORD nBytes = 0;
+    GetPrinterW(hPrinter, 2, nullptr, 0, &nBytes);
+    PrinterStatus aStatus = ClassifyPrinterStatus(PrintQueueFlags::NONE, false);
+    if (nBytes)
+    {
+        std::vector<BYTE> aBuffer(nBytes);
+        if (GetPrinterW(hPrinter, 2, aBuffer.data(), nBytes, &nBytes))
+        {
+            const auto* pInfo = reinterpret_cast<const PRINTER_INFO_2W*>(aBuffer.data());
+            PrintQueueFlags nFlags = PrintQueueFlags::NONE;
+            for (const WinFlag& rFlag : WIN_FLAGS)
+                if (pInfo->Status & rFlag.nWin)
+                    nFlags |= rFlag.nFlag;
+            // "Use Printer Offline", also set by the spooler for an unreachable network printer
+            if (pInfo->Attributes & PRINTER_ATTRIBUTE_WORK_OFFLINE)
+                nFlags |= PrintQueueFlags::Offline;
+            aStatus = ClassifyPrinterStatus(nFlags, true);
+        }
+    }
+    ClosePrinter(hPrinter);
+    return aStatus;
+}
+
+#elif ENABLE_CUPS && !defined(MACOSX) && !defined(IOS) && !defined(ANDROID) // vcl links cups
+namespace
+{
+struct CupsReason
+{
+    std::string_view aKeyword;
+    PrintQueueFlags nFlag;
+};
+// printer-state-reasons keywords (RFC 8011, PWG 5100.9) without their -report/-warning/-error
+constexpr CupsReason CUPS_REASONS[] = { { "media-empty", PrintQueueFlags::PaperOut },
+                                        { "media-needed", PrintQueueFlags::PaperOut },
+                                        { "media-jam", PrintQueueFlags::PaperJam },
+                                        { "door-open", PrintQueueFlags::DoorOpen },
+                                        { "cover-open", PrintQueueFlags::DoorOpen },
+                                        { "toner-empty", PrintQueueFlags::NoToner },
+                                        { "marker-supply-empty", PrintQueueFlags::NoToner },
+                                        { "toner-low", PrintQueueFlags::TonerLow },
+                                        { "marker-supply-low", PrintQueueFlags::TonerLow },
+                                        { "offline", PrintQueueFlags::Offline },
+                                        { "shutdown", PrintQueueFlags::Offline },
+                                        { "connecting-to-device", PrintQueueFlags::Busy },
+                                        { "output-area-full", PrintQueueFlags::OutputBinFull },
+                                        { "moving-to-paused", PrintQueueFlags::Paused },
+                                        { "paused", PrintQueueFlags::Paused } };
+
+PrintQueueFlags lcl_reasons(std::string_view aReasons)
+{
+    PrintQueueFlags nFlags = PrintQueueFlags::NONE;
+    while (!aReasons.empty())
+    {
+        const size_t nComma = aReasons.find(',');
+        std::string_view aReason = aReasons.substr(0, nComma);
+        aReasons = nComma == std::string_view::npos ? std::string_view() : aReasons.substr(nComma + 1);
+        if (aReason == "offline-report") // the device itself reports that it is offline
+        {
+            nFlags |= PrintQueueFlags::Offline;
+            continue;
+        }
+        if (aReason.ends_with("-report"))
+            continue; // information only
+        bool bError = false;
+        if (aReason.ends_with("-warning"))
+            aReason.remove_suffix(8);
+        else if (aReason.ends_with("-error"))
+        {
+            aReason.remove_suffix(6);
+            bError = true;
+        }
+        if (aReason.empty() || aReason == "none")
+            continue;
+        bool bKnown = false;
+        for (const CupsReason& rReason : CUPS_REASONS)
+            if (rReason.aKeyword == aReason)
+            {
+                nFlags |= rReason.nFlag;
+                bKnown = true;
+            }
+        if (!bKnown && bError)
+            nFlags |= PrintQueueFlags::Error; // another reason that stops the printer
+    }
+    return nFlags;
+}
+}
+
+static PrinterStatus lcl_systemStatus(const OUString& rPrinterName)
+{
+    // "queue/instance": the instance has the state of its queue
+    const OString aName = OUStringToOString(rPrinterName, RTL_TEXTENCODING_UTF8);
+    const sal_Int32 nSlash = aName.indexOf('/');
+    const OString aQueue = nSlash < 0 ? aName : aName.copy(0, nSlash);
+    cups_dest_t* pDest = cupsGetNamedDest(CUPS_HTTP_DEFAULT, aQueue.getStr(), nullptr);
+    if (!pDest) // not a CUPS queue (e.g. the generic printer of the profile)
+        return ClassifyPrinterStatus(PrintQueueFlags::NONE, false);
+    PrintQueueFlags nFlags = PrintQueueFlags::NONE;
+    bool bKnown = false;
+    if (const char* pState = cupsGetOption("printer-state", pDest->num_options, pDest->options))
+    {
+        bKnown = true;
+        const std::string_view aState(pState);
+        if (aState == "4") // processing
+            nFlags |= PrintQueueFlags::Printing;
+        else if (aState == "5") // stopped (cupsdisable): it prints nothing
+            nFlags |= PrintQueueFlags::Offline;
+    }
+    if (const char* pAccepting
+        = cupsGetOption("printer-is-accepting-jobs", pDest->num_options, pDest->options))
+        if (std::string_view(pAccepting) == "false")
+            nFlags |= PrintQueueFlags::Offline;
+    if (const char* pReasons
+        = cupsGetOption("printer-state-reasons", pDest->num_options, pDest->options))
+        nFlags |= lcl_reasons(pReasons);
+    cupsFreeDests(1, pDest);
+    return ClassifyPrinterStatus(nFlags, bKnown);
+}
+
+#else
+static PrinterStatus lcl_systemStatus(const OUString&)
+{
+    // macOS and the rest: the system's queue information has no state here
+    return ClassifyPrinterStatus(PrintQueueFlags::NONE, false);
+}
+#endif
+
+namespace
+{
+/* Test runs only: HST_TEST_PRINTER_STATES="<printer>=<state>;..." with the states ready, busy,
+   paused, offline, paperout, unknown gives those printers that state instead of the system's
+   (runtime screenshots on a host without a print server). */
+bool lcl_testStatus(const OUString& rPrinterName, PrinterStatus& rStatus)
+{
+    const char* pStates = std::getenv("HST_TEST_PRINTER_STATES");
+    if (!pStates)
+        return false;
+    const OUString aStates = OUString::fromUtf8(pStates);
+    for (sal_Int32 nIndex = 0; nIndex >= 0;)
+    {
+        const OUString aItem = aStates.getToken(0, ';', nIndex);
+        const sal_Int32 nEq = aItem.lastIndexOf('=');
+        if (nEq <= 0 || aItem.copy(0, nEq) != rPrinterName)
+            continue;
+        const std::u16string_view aState = aItem.subView(nEq + 1);
+        if (aState == u"ready")
+            rStatus = ClassifyPrinterStatus(PrintQueueFlags::NONE, true);
+        else if (aState == u"busy")
+            rStatus = ClassifyPrinterStatus(PrintQueueFlags::Printing, true);
+        else if (aState == u"paused")
+            rStatus = ClassifyPrinterStatus(PrintQueueFlags::Paused, true);
+        else if (aState == u"offline")
+            rStatus = ClassifyPrinterStatus(PrintQueueFlags::Offline, true);
+        else if (aState == u"paperout")
+            rStatus = ClassifyPrinterStatus(PrintQueueFlags::PaperOut, true);
+        else
+            rStatus = ClassifyPrinterStatus(PrintQueueFlags::NONE, false);
+        return true;
+    }
+    return false;
+}
+}
+
+PrinterStatus QueryPrinterStatus(const OUString& rPrinterName)
+{
+    PrinterStatus aStatus;
+    if (lcl_testStatus(rPrinterName, aStatus))
+        return aStatus;
+    return lcl_systemStatus(rPrinterName);
+}
+}
