+
+#pragma once
+
+#include <rtl/ustring.hxx>
+#include <tools/color.hxx>
+#include <vcl/dllapi.h>
+#include <vcl/prntypes.hxx>
+
+#include <memory>
+#include <vector>
+
+namespace weld
+{
+class ComboBox;
+class Label;
+}
+
+namespace vcl::hst
+{
+/* HST Office: the connection state of the printers in the printer list of the Print page.
+
+   Each printer of the list gets a small dot before its name and the selected one a short text
+   beside it ("Status:"):
+   - green: ready to print;
+   - amber: paused or busy (printing, warming up, toner low...);
+   - red: offline or an error that stops printing (paper jam, out of paper, door open...);
+   - grey: not known (yet, or the system does not tell).
+   The text is also the tooltip and the accessible text, so the colour is never the only sign. */
+enum class PrinterState
+{
+    Unknown,
+    Ready,
+    Busy,
+    Paused,
+    Offline,
+    Error
+};
+
+struct PrinterStatus
+{
+    PrinterState eState = PrinterState::Unknown;
+    PrintQueueFlags nFlags = PrintQueueFlags::NONE; ///< what the system reported
+};
+
+/// The state of a printer from the flags of its queue; bKnown false: the system told nothing.
+VCL_DLLPUBLIC PrinterStatus ClassifyPrinterStatus(PrintQueueFlags nFlags, bool bKnown);
+/// The short text of a status ("Ready", "Error: out of paper"...), in the UI language.
+VCL_DLLPUBLIC OUString PrinterStatusText(const PrinterStatus& rStatus);
+/// The colour of the dot of a state.
+VCL_DLLPUBLIC Color PrinterStatusColor(PrinterState eState);
+
+/// Ask the system for the state of one printer. May take a while (network printers): call it
+/// off the main thread only.
+PrinterStatus QueryPrinterStatus(const OUString& rPrinterName);
+
+/* The dots of a printer list and the text of the selected printer. The states are asked on a
+   thread of their own when the view is made and when the list drops down; until they arrive the
+   dots are grey. The UI is never blocked. Entries before nFirstPrinter (e.g. "Print to File")
+   get no dot. */
+class VCL_DLLPUBLIC PrinterStatusView final
+{
+public:
+    PrinterStatusView(weld::ComboBox& rPrinters, weld::Label& rStatus, int nFirstPrinter);
+    ~PrinterStatusView();
+    PrinterStatusView(const PrinterStatusView&) = delete;
+    PrinterStatusView& operator=(const PrinterStatusView&) = delete;
+
+    /// The selected printer changed; rText is what the label shows besides the state.
+    void SelectionChanged(const OUString& rText);
+
+private:
+    struct Impl;
+    std::unique_ptr<Impl> m_pImpl;
+};
+}
