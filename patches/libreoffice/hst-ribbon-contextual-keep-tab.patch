+#pragma once
+
+#include <cstdint>
+
+namespace hst::ribbon
+{
+/// HST Office: a command on a selected object often rebuilds the selection's shells (the dispatcher pops and
+/// pushes them, or the object is unmarked and marked again), so the ribbon sees the object's context leave and
+/// come back within one burst of context changes, for example Graphic, Default, Frame, Graphic. The contextual
+/// tab is hidden in between and the ribbon falls back to the default tab; these two steps select the contextual
+/// tab again when it comes back, as Office keeps it while the object stays selected. The page remembered by
+/// keepTabBefore() is forgotten once the application is idle, so a later selection of an object does not open
+/// its tab.
+
+/// Before a context change: the page to remember. nCurrent when it is a contextual page shown by the context that
+/// ends (not shown in every context, not a sub-context's page), else the page already remembered (0: none).
+constexpr std::uint16_t keepTabBefore(std::uint16_t nKept, std::uint16_t nCurrent, bool bCurrentContextual)
+{
+    return bCurrentContextual && nCurrent ? nCurrent : nKept;
+}
+
+/// After the context change: the page to select again, 0 for none. The remembered page comes back when the new
+/// context shows it, it is not the current page already, and the change did not itself open another contextual
+/// page (an insert command, a view mode).
+constexpr std::uint16_t keepTabAfter(std::uint16_t nKept, std::uint16_t nCurrent, bool bKeptShown,
+                                     bool bOpenedOther)
+{
+    return nKept && nKept != nCurrent && bKeptShown && !bOpenedOther ? nKept : 0;
+}
+}
