             bHandled = true;
             bLastContextWasSupported = true;
+            bHstOpened = bHstOpened || !pPage->HasContext(vcl::EnumContext::Context::Any);
         }
 
         if (!bHandled && bLastContextWasSupported
@@ -2381,6 +2410,16 @@
