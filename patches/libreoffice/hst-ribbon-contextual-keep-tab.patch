 void NotebookbarTabControlBase::SetContext( vcl::EnumContext::Context eContext )
 {
     if (eLastContext == eContext)
         return;
 
+    // HST Office: a command on the selected object can hide its contextual tab for a moment (its shells are
+    // rebuilt, or it is unmarked and marked again); remember the contextual tab the user is on, to select it
+    // again below when the context comes back (see HstContextualKeepTab.hxx)
+    const bool bHstKeepTab = !comphelper::LibreOfficeKit::isActive();
+    if (bHstKeepTab)
+    {
+        const TabPage* pKeep = GetTabPage(mnCurPageId);
+        const bool bContextual = pKeep && eLastContext != vcl::EnumContext::Context::Any
+                                 && !pKeep->HasContext(vcl::EnumContext::Context::Any)
+                                 && !lcl_hstHasSubContext(pKeep, m_eHstSubContext)
+                                 && pKeep->HasContext(eLastContext);
+        m_nHstKeepPage = hst::ribbon::keepTabBefore(m_nHstKeepPage, mnCurPageId, bContextual);
+        if (m_nHstKeepPage)
+            m_aHstKeepIdle.Start();
+    }
+    bool bHstOpened = false; // this change opened a contextual page itself
+
     bool bHandled = false;
     // HST Office: a selection right after an insert command opens its contextual tab
     const bool bSelection = lcl_hstIsSelectionContext(eContext) && !lcl_hstTakeInsertNote();
@@ -2351,6 +2379,7 @@
