+SignatureImageError readSignatureImage(const OUString& rURL, Graphic& rGraphic)
+{
+    std::unique_ptr<SvStream> pStream = utl::UcbStreamHelper::CreateStream(rURL, StreamMode::READ);
+    if (!pStream || pStream->GetError() != ERRCODE_NONE)
+        return SignatureImageError::Unreadable;
+    if (pStream->TellEnd() > MAX_SIGNATURE_IMAGE_BYTES)
+        return SignatureImageError::FileTooLarge;
+    // the header first: a small file can still decode to a huge bitmap
+    GraphicDescriptor aDescriptor(*pStream, nullptr);
+    if (!aDescriptor.Detect(true)
+        || (aDescriptor.GetFileFormat() != GraphicFileFormat::PNG
+            && aDescriptor.GetFileFormat() != GraphicFileFormat::JPG))
+        return SignatureImageError::Unreadable;
+    const Size aPixels = aDescriptor.GetSizePixel();
+    if (aPixels.Width() > MAX_SIGNATURE_IMAGE_SIDE || aPixels.Height() > MAX_SIGNATURE_IMAGE_SIDE)
+        return SignatureImageError::TooManyPixels;
+    pStream->Seek(0);
+    Graphic aGraphic;
+    if (GraphicFilter::GetGraphicFilter().ImportGraphic(aGraphic, u"", *pStream) != ERRCODE_NONE
+        || aGraphic.GetType() != GraphicType::Bitmap || aspectRatio(aGraphic) <= 0)
+        return SignatureImageError::Unreadable;
+    aGraphic.makeAvailable();
+    rGraphic = aGraphic;
+    return SignatureImageError::None;
+}
