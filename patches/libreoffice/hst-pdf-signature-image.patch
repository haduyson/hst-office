+namespace
+{
+/// The default signature box (points). With images it is larger, so that the text beside or under
+/// them stays at a legible size: 240 x 90 with the images on the left, 200 x 120 with them above.
+basegfx::B2DSize defaultBoxSize(bool bImages, bool bImagesAbove)
+{
+    if (!bImages)
+        return basegfx::B2DSize(200.0, 70.0);
+    return bImagesAbove ? basegfx::B2DSize(200.0, 120.0) : basegfx::B2DSize(240.0, 90.0);
+}
+
+/// A thumbnail of at most 64 x 40 pixels for the panel.
+uno::Reference<graphic::XGraphic> thumbnail(const Graphic& rGraphic)
+{
+    if (rGraphic.IsNone())
+        return {};
+    Bitmap aBitmap = rGraphic.GetBitmap();
+    const Size aPixels = aBitmap.GetSizePixel();
+    const double fScale = std::min({ 64.0 / aPixels.Width(), 40.0 / aPixels.Height(), 1.0 });
+    aBitmap.Scale(Size(std::max<tools::Long>(1, aPixels.Width() * fScale),
+                       std::max<tools::Long>(1, aPixels.Height() * fScale)),
+                  BmpScaleFlag::BestQuality);
+    return Graphic(aBitmap).GetXGraphic();
+}
+}
+
+bool PdfViewerWindow::usingImages() const
+{
+    return m_xUseImages->get_active() && (!m_aSignatureImage.IsNone() || !m_aSealImage.IsNone());
+}
+
+void PdfViewerWindow::loadImageSettings()
+{
+    m_bImageSettingsLoaded = true;
+    using Signing = officecfg::Office::HSTPdfViewer::Signing;
+    m_aSignatureImageURL = Signing::SignatureImageURL::get();
+    m_aSealImageURL = Signing::SealImageURL::get();
+    // an image moved or deleted since: its slot is empty again
+    if (!m_aSignatureImageURL.isEmpty()
+        && readSignatureImage(m_aSignatureImageURL, m_aSignatureImage) != SignatureImageError::None)
+        m_aSignatureImageURL.clear();
+    if (!m_aSealImageURL.isEmpty()
+        && readSignatureImage(m_aSealImageURL, m_aSealImage) != SignatureImageError::None)
+        m_aSealImageURL.clear();
+    m_xUseImages->set_active(Signing::UseImages::get());
+    m_xImageLayout->set_active(Signing::ImagesAbove::get() ? 1 : 0);
+    updateImageWidgets();
+}
+
+void PdfViewerWindow::saveImageSettings()
+{
+    try
+    {
+        using Signing = officecfg::Office::HSTPdfViewer::Signing;
+        std::shared_ptr<comphelper::ConfigurationChanges> xChanges
+            = comphelper::ConfigurationChanges::create();
+        Signing::UseImages::set(m_xUseImages->get_active(), xChanges);
+        Signing::SignatureImageURL::set(m_aSignatureImageURL, xChanges);
+        Signing::SealImageURL::set(m_aSealImageURL, xChanges);
+        Signing::ImagesAbove::set(m_xImageLayout->get_active() == 1, xChanges);
+        xChanges->commit();
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("xmlsecurity.hstpdf", "could not remember the signature images");
+    }
+}
+
+void PdfViewerWindow::updateImageWidgets()
+{
+    // choosing an image switches the option on, so the buttons stay usable
+    m_xImageLayout->set_sensitive(m_xUseImages->get_active());
+    m_xSignatureImage->set_image(thumbnail(m_aSignatureImage));
+    m_xSealImage->set_image(thumbnail(m_aSealImage));
+    m_xSignatureImage->set_visible(!m_aSignatureImage.IsNone());
+    m_xSealImage->set_visible(!m_aSealImage.IsNone());
+    m_xNoImages->set_sensitive(m_xUseImages->get_active() || !m_aSignatureImage.IsNone()
+                               || !m_aSealImage.IsNone());
+}
+
+void PdfViewerWindow::chooseImage(bool bSeal)
+{
+    sfx2::FileDialogHelper aDialog(ui::dialogs::TemplateDescription::FILEOPEN_SIMPLE,
+                                   FileDialogFlags::NONE, GetFrameWeld());
+    aDialog.SetTitle(XsResId(bSeal ? STR_HSTPDF_CHOOSE_SEAL_IMAGE : STR_HSTPDF_CHOOSE_SIGNATURE_IMAGE));
+    aDialog.AddFilter(XsResId(STR_HSTPDF_IMAGE_FILTER), u"*.png;*.jpg;*.jpeg"_ustr);
+    if (aDialog.Execute() != ERRCODE_NONE)
+        return;
+    const OUString aURL = aDialog.GetPath();
+    Graphic aGraphic;
+    const SignatureImageError eError = readSignatureImage(aURL, aGraphic);
+    if (eError != SignatureImageError::None)
+    {
+        const OUString aMessage
+            = eError == SignatureImageError::FileTooLarge ? XsResId(STR_HSTPDF_IMAGE_FILE_TOO_LARGE)
+              : eError == SignatureImageError::TooManyPixels
+                  ? XsResId(STR_HSTPDF_IMAGE_TOO_MANY_PIXELS)
+                        .replaceAll("%1", OUString::number(MAX_SIGNATURE_IMAGE_SIDE))
+                  : XsResId(STR_HSTPDF_IMAGE_UNREADABLE);
+        std::unique_ptr<weld::MessageDialog> xBox(Application::CreateMessageDialog(
+            GetFrameWeld(), VclMessageType::Warning, VclButtonsType::Ok, aMessage));
+        xBox->run();
+        return;
+    }
+    (bSeal ? m_aSealImage : m_aSignatureImage) = aGraphic;
+    (bSeal ? m_aSealImageURL : m_aSignatureImageURL) = aURL;
+    m_xUseImages->set_active(true);
+    saveImageSettings();
+    updateImageWidgets();
+    resizeDefaultPlacement();
+}
+
+void PdfViewerWindow::clearImages()
+{
+    m_aSignatureImage.Clear();
+    m_aSealImage.Clear();
+    m_aSignatureImageURL.clear();
+    m_aSealImageURL.clear();
+    m_xUseImages->set_active(false);
+    m_xImageLayout->set_active(0);
+    saveImageSettings();
+    updateImageWidgets();
+    resizeDefaultPlacement();
+}
+
+void PdfViewerWindow::resizeDefaultPlacement()
+{
+    // only a box of a default size follows the image settings: one the user drew stays
+    const auto& oPlacement = m_xPages->getPlacement();
+    if (!oPlacement)
+        return;
+    const PointRect& rBox = oPlacement->second;
+    for (const basegfx::B2DSize& rSize : { defaultBoxSize(false, false), defaultBoxSize(true, false),
+                                           defaultBoxSize(true, true) })
+    {
+        if (std::abs(rBox.getHeight() - rSize.getHeight()) < 0.5
+            && (std::abs(rBox.getWidth() - rSize.getWidth()) < 0.5
+                || std::abs(rBox.getWidth()
+                            - m_xDocument->getPageSize(oPlacement->first).getWidth() / 2) < 0.5))
+        {
+            defaultPlacement();
+            m_xPages->Invalidate();
+            return;
+        }
+    }
+}
