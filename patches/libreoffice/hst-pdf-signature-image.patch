+/// Writes the bytes to rFile and returns its URL.
+OUString writeFile(utl::TempFileNamed& rFile, const void* pData, std::size_t nSize)
+{
+    rFile.EnableKillingFile();
+    SvStream* pStream = rFile.GetStream(StreamMode::WRITE);
+    pStream->WriteBytes(pData, nSize);
+    rFile.CloseStream();
+    return rFile.GetURL();
+}
+}
