+/// The images of the box in units of the group height: the seal is printed over the left third of
+/// the signature, as on administrative documents (Nghị định 30/2020, Phụ lục I), and the signature
+/// is 60 % of the seal's height, centred on it. fWidth is 0 without images.
+struct ImageGroup
+{
+    double fWidth = 0;
+    double fSignatureX = 0;
+    double fSignatureY = 0;
+    double fSignatureWidth = 0;
+    double fSignatureHeight = 1;
+    double fSealX = 0;
+    double fSealWidth = 0;
+};
+
+double aspectRatio(const Graphic& rGraphic)
+{
+    if (rGraphic.IsNone())
+        return 0;
+    const Size aPixels = rGraphic.GetSizePixel();
+    return aPixels.Height() > 0 ? double(aPixels.Width()) / aPixels.Height() : 0;
+}
+
+ImageGroup imageGroup(const SignaturePlacement& rPlacement)
+{
+    ImageGroup aGroup;
+    aGroup.fSignatureWidth = aspectRatio(rPlacement.aSignatureImage);
+    aGroup.fSealWidth = aspectRatio(rPlacement.aSealImage);
+    if (aGroup.fSignatureWidth > 0 && aGroup.fSealWidth > 0)
+    {
+        aGroup.fSignatureHeight = 0.6;
+        aGroup.fSignatureY = 0.2;
+        aGroup.fSignatureWidth *= aGroup.fSignatureHeight;
+        aGroup.fSignatureX = std::max(0.0, aGroup.fSealWidth - aGroup.fSignatureWidth / 3);
+        aGroup.fSealX = aGroup.fSignatureX + aGroup.fSignatureWidth / 3 - aGroup.fSealWidth;
+    }
+    aGroup.fWidth = std::max(aGroup.fSignatureX + aGroup.fSignatureWidth,
+                             aGroup.fSealX + aGroup.fSealWidth);
+    return aGroup;
+}
+
+/// Draws an image into rRect (twips) with its transparency; a large scan is first reduced to
+/// 300 dpi at the drawn size, so that it does not make every signed copy big.
+void drawImage(OutputDevice& rDevice, const Graphic& rGraphic, const tools::Rectangle& rRect)
+{
+    Bitmap aBitmap = rGraphic.GetBitmap();
+    const Size aMax(rRect.GetWidth() * 300 / 1440 + 1, rRect.GetHeight() * 300 / 1440 + 1);
+    const Size aPixels = aBitmap.GetSizePixel();
+    if (aPixels.Width() > aMax.Width() || aPixels.Height() > aMax.Height())
+        aBitmap.Scale(aMax, BmpScaleFlag::BestQuality);
+    rDevice.DrawBitmap(rRect.TopLeft(), rRect.GetSize(), aBitmap);
+}
