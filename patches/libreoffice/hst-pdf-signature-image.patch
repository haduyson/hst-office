+/// Signature and seal images: a PNG or JPEG of at most 5 MB and 6000 pixels a side, the pixel size
+/// read from the header before decoding; a signature with both images stays valid and embeds them
+/// with their transparency.
+CPPUNIT_TEST_FIXTURE(PDFSigningTest, testSignatureImages)
+{
+    // a 4 x 2 RGBA PNG
+    uno::Sequence<sal_Int8> aPng;
+    comphelper::Base64::decode(
+        aPng, u"iVBORw0KGgoAAAANSUhEUgAAAAQAAAACCAYAAAB/qH1jAAAAFElEQVR42mMQ0VjwnwEXuCQpdwIAPY8DrcSnDecAAAAASUVORK5CYII="_ustr);
+    utl::TempFileNamed aPngFile;
+    Graphic aImage;
+    CPPUNIT_ASSERT_EQUAL(int(hstpdf::SignatureImageError::None),
+                         int(hstpdf::readSignatureImage(
+                             writeFile(aPngFile, aPng.getConstArray(), aPng.getLength()), aImage)));
+    CPPUNIT_ASSERT_EQUAL(tools::Long(4), aImage.GetSizePixel().Width());
+    CPPUNIT_ASSERT_EQUAL(tools::Long(2), aImage.GetSizePixel().Height());
+
+    // only the header of a PNG 7000 pixels wide: refused without decoding a bitmap
+    const unsigned char aHuge[] = { 0x89, 'P', 'N', 'G', '\r', '\n', 0x1a, '\n', 0, 0, 0, 13,
+                                    'I', 'H', 'D', 'R', 0, 0, 0x1b, 0x58, 0, 0, 0, 10,
+                                    8, 6, 0, 0, 0, 0, 0, 0, 0 };
+    utl::TempFileNamed aHugeFile;
+    Graphic aRefused;
+    CPPUNIT_ASSERT_EQUAL(int(hstpdf::SignatureImageError::TooManyPixels),
+                         int(hstpdf::readSignatureImage(writeFile(aHugeFile, aHuge, sizeof(aHuge)),
+                                                        aRefused)));
+    const std::vector<char> aBig(hstpdf::MAX_SIGNATURE_IMAGE_BYTES + 1, 0);
+    utl::TempFileNamed aBigFile;
+    CPPUNIT_ASSERT_EQUAL(int(hstpdf::SignatureImageError::FileTooLarge),
+                         int(hstpdf::readSignatureImage(writeFile(aBigFile, aBig.data(), aBig.size()),
+                                                        aRefused)));
+    utl::TempFileNamed aTextFile;
+    CPPUNIT_ASSERT_EQUAL(int(hstpdf::SignatureImageError::Unreadable),
+                         int(hstpdf::readSignatureImage(writeFile(aTextFile, "not an image", 12),
+                                                        aRefused)));
+    CPPUNIT_ASSERT(aRefused.IsNone());
+
+    if (!vcl::pdf::PDFiumLibrary::get())
+        return;
+    uno::Reference<xml::crypto::XSEInitializer> xSEInitializer
+        = xml::crypto::SEInitializer::create(m_xContext);
+    uno::Reference<xml::crypto::XXMLSecurityContext> xSecurityContext
+        = xSEInitializer->createSecurityContext(OUString());
+    uno::Reference<security::XCertificate> xCertificate = signingCertificate(xSecurityContext);
+    if (!xCertificate.is())
+        return;
+    SvFileStream aFile(m_directories.getURLFromSrc(DATA_DIRECTORY) + "no.pdf", StreamMode::READ);
+    std::vector<sal_uInt8> aData(aFile.TellEnd());
+    aFile.ReadBytes(aData.data(), aData.size());
+    hstpdf::SignaturePlacement aWithImages{ 0, basegfx::B2DRectangle(40, 40, 280, 130),
+                                            basegfx::B2DSize(595, 842) };
+    aWithImages.aSignatureImage = aImage;
+    aWithImages.aSealImage = aImage;
+    std::vector<sal_uInt8> aSigned;
+    CPPUNIT_ASSERT_EQUAL(int(hstpdf::SignResult::Signed),
+                         int(hstpdf::signPdf(aData, xCertificate, OUString(), aWithImages, aSigned)));
+    CPPUNIT_ASSERT_EQUAL(size_t(1), verifyEncrypted(aSigned).size());
+    CPPUNIT_ASSERT(contains(aSigned, "/SMask"));
+}
