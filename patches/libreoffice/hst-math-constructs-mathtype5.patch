new file mode 100644
index 0000000..15d5ad8
--- /dev/null
+++ b/starmath/source/hst/ommlfixes.cxx
@@ -0,0 +1,113 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * Part of HST Office. This file is HST's own work and is not covered by the MPL.
+ */
+
+#include "ommlfixes.hxx"
+
+#include <rtl/ustrbuf.hxx>
+
+#include <initializer_list>
+
+namespace starmath::hst
+{
+namespace
+{
+std::u16string_view TextArrowKeyword(sal_Unicode c)
+{
+    switch (c)
+    {
+        case 0x2192:
+        case 0x27F6:
+            return u"xrightarrow";
+        case 0x2190:
+        case 0x27F5:
+            return u"xleftarrow";
+        case 0x21C4:
+            return u"xrightleftarrows";
+        case 0x21CC:
+            return u"xrightleftharpoons";
+        default:
+            return std::u16string_view();
+    }
+}
+
+bool IsTextArrowGroup(std::u16string_view e)
+{
+    for (std::u16string_view k : { u"} xrightarrow {", u"} xleftarrow {", u"} xrightleftarrows {",
+                                    u"} xrightleftharpoons {" })
+        if (e.find(k) != std::u16string_view::npos)
+            return true;
+    return false;
+}
+
+bool IsRelation(sal_Unicode c)
+{
+    switch (c)
+    {
+        case '=':
+        case '<':
+        case '>':
+        case 0x2248:
+        case 0x2260:
+        case 0x2264:
+        case 0x2265:
+        case 0x21D2:
+        case 0x21D4:
+            return true;
+        default:
+            return false;
+    }
+}
+}
+
+bool IsOmmlArcAccent(sal_Unicode c)
+{
+    return c == 0x2322 || c == 0x2312 || c == 0x23DC || c == 0x0311;
+}
+
+OUString OmmlTextArrowGroup(sal_Unicode cChr, bool bBelow, std::u16string_view e)
+{
+    const std::u16string_view aArrow = TextArrowKeyword(cChr);
+    if (aArrow.empty())
+        return OUString();
+    if (bBelow) // arrow below e: e is the text over the arrow
+        return OUString::Concat("{") + e + "} " + aArrow + " { }";
+    return OUString::Concat("{ } ") + aArrow + " {" + e + "}";
+}
+
+OUString OmmlTextArrowLimit(bool bLow, std::u16string_view e, std::u16string_view lim)
+{
+    if (!IsTextArrowGroup(e))
+        return OUString();
+    if (bLow && e.starts_with(u"{") && e.ends_with(u" { }"))
+        return OUString::Concat(e.substr(0, e.size() - 3)) + "{" + lim + "}";
+    if (!bLow && e.starts_with(u"{ } "))
+        return OUString::Concat("{") + lim + "}" + e.substr(3);
+    return OUString();
+}
+
+OUString OmmlLeftOperandForLeadingRelations(const OUString& rFormula)
+{
+    OUStringBuffer aOut(rFormula.getLength() + 8);
+    bool bInQuote = false;
+    sal_Unicode cPrev = '{'; // the formula start counts as an opening brace
+    for (sal_Int32 i = 0; i < rFormula.getLength(); ++i)
+    {
+        const sal_Unicode c = rFormula[i];
+        if (c == '"' && (i == 0 || rFormula[i - 1] != '\\'))
+            bInQuote = !bInQuote;
+        const bool bPlaceholder = c == '<' && i + 1 < rFormula.getLength() && rFormula[i + 1] == '?';
+        if (!bInQuote && !bPlaceholder && (cPrev == '{' || cPrev == '#') && IsRelation(c))
+            aOut.append("{} ");
+        aOut.append(c);
+        if (c != ' ')
+            cPrev = bInQuote ? '"' : c;
+    }
+    return aOut.makeStringAndClear();
+}
+}
