diff --git a/starmath/source/hst/mtef5symbols.cxx b/starmath/source/hst/mtef5symbols.cxx
new file mode 100644
index 0000000..a0034ac
--- /dev/null
+++ b/starmath/source/hst/mtef5symbols.cxx
@@ -0,0 +1,402 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * Part of HST Office. This file is HST's own work and is not covered by the MPL.
+ */
+
+#include "mtef5symbols.hxx"
+
+#include <parse5.hxx>
+
+#include <algorithm>
+#include <iterator>
+
+namespace hst::mtef
+{
+namespace
+{
+struct SymbolEntry
+{
+    sal_Unicode cChar;
+    std::u16string_view aToken;
+};
+
+// Characters with a StarMath name or operator, and characters written as themselves. Every
+// other printable character is quoted ("%" too: "%%" would start a StarMath comment).
+constexpr SymbolEntry aSymbols[] = {
+    { u'+', u"+" },
+    { u'-', u"-" },
+    { u'=', u"=" },
+    { u'<', u"<" },
+    { u'>', u">" },
+    { u'/', u"/" },
+    { u'*', u"*" },
+    { u'(', u"(" },
+    { u')', u")" },
+    { u'[', u"[" },
+    { u']', u"]" },
+    { u'{', u"lbrace" },
+    { u'}', u"rbrace" },
+    { u',', u"," },
+    { u';', u";" },
+    { u':', u":" },
+    { u'.', u"." },
+    { u'!', u"!" },
+    { u'\'', u"'" },
+    { u'|', u"divides" },
+    { 0x00AC, u"neg" },
+    { 0x00B1, u"+-" },
+    { 0x00B7, u"cdot" },
+    { 0x00D7, u"times" },
+    { 0x00F7, u"div" },
+    { 0x0394, u"%DELTA" },
+    { 0x2016, u"parallel" },
+    { 0x2022, u"cdot" },
+    { 0x2026, u"dotsaxis" },
+    { 0x2032, u"'" },
+    { 0x2033, u"''" },
+    { 0x2034, u"'''" },
+    { 0x2102, u"setC" },
+    { 0x2115, u"setN" },
+    { 0x211A, u"setQ" },
+    { 0x211D, u"setR" },
+    { 0x2124, u"setZ" },
+    { 0x2192, u"toward" },
+    { 0x21D0, u"dlarrow" },
+    { 0x21D2, u"drarrow" },
+    { 0x21D4, u"dlrarrow" },
+    { 0x2200, u"forall" },
+    { 0x2202, u"partial" },
+    { 0x2203, u"exists" },
+    { 0x2205, u"emptyset" },
+    { 0x2206, u"%DELTA" },
+    { 0x2207, u"nabla" },
+    { 0x2208, u"in" },
+    { 0x2209, u"notin" },
+    { 0x220B, u"owns" },
+    { 0x220F, u"prod" },
+    { 0x2211, u"sum" },
+    { 0x2212, u"-" },
+    { 0x2213, u"-+" },
+    { 0x2216, u"setminus" },
+    { 0x2218, u"circ" },
+    { 0x2219, u"cdot" },
+    { 0x221D, u"prop" },
+    { 0x221E, u"infinity" },
+    { 0x2223, u"divides" },
+    { 0x2224, u"ndivides" },
+    { 0x2225, u"parallel" },
+    { 0x2227, u"and" },
+    { 0x2228, u"or" },
+    { 0x2229, u"intersection" },
+    { 0x222A, u"union" },
+    { 0x222B, u"int" },
+    { 0x223C, u"sim" },
+    { 0x2243, u"simeq" },
+    { 0x2245, u"simeq" },
+    { 0x2248, u"approx" },
+    { 0x2260, u"<>" },
+    { 0x2261, u"equiv" },
+    { 0x2264, u"<=" },
+    { 0x2265, u">=" },
+    { 0x226A, u"<<" },
+    { 0x226B, u">>" },
+    { 0x2282, u"subset" },
+    { 0x2283, u"supset" },
+    { 0x2284, u"nsubset" },
+    { 0x2285, u"nsupset" },
+    { 0x2286, u"subseteq" },
+    { 0x2287, u"supseteq" },
+    { 0x2288, u"nsubseteq" },
+    { 0x2289, u"nsupseteq" },
+    { 0x2295, u"oplus" },
+    { 0x2297, u"otimes" },
+    { 0x22A5, u"ortho" },
+    { 0x22C2, u"Intersection" },
+    { 0x22C3, u"Union" },
+    { 0x22C5, u"cdot" },
+    { 0x22EE, u"dotsvert" },
+    { 0x22EF, u"dotsaxis" },
+    { 0x27F6, u"toward" },
+    { 0x2A7D, u"leslant" },
+    { 0x2A7E, u"geslant" },
+    // MathType private-use characters
+    { 0xE98F, u"toward" },
+    { 0xEB05, u"'" },
+    { 0xEF01, u"`" },
+    { 0xEF02, u"`" },
+    { 0xEF03, u"`" },
+    { 0xEF04, u"~" },
+    { 0xEF05, u"~" },
+    { 0xEF06, u"~~" },
+    { 0xEF08, u"~" },
+};
+
+// MathType private-use characters shown as an ordinary character.
+constexpr SymbolEntry aPrivateUseGlyphs[] = {
+    { 0xE934, u"⌒" }, { 0xE95C, u"⌒" }, { 0xE990, u"←" },
+    { 0xE991, u"↔" }, { 0xE998, u"⇌" }, { 0xE999, u"⇌" },
+    { 0xE99A, u"⇄" }, { 0xE99B, u"⇄" }, { 0xEC00, u"→" },
+};
+
+constexpr std::u16string_view aOperators[] = {
+    u"=",        u"<",        u">",         u"<=",        u">=",        u"<>",
+    u"approx",   u"equiv",    u"simeq",     u"sim",       u"prop",      u"toward",
+    u"drarrow",  u"dlrarrow", u"dlarrow",   u"in",        u"notin",     u"owns",
+    u"subset",   u"supset",   u"subseteq",  u"supseteq",  u"nsubset",   u"nsupset",
+    u"nsubseteq", u"nsupseteq", u"times",   u"cdot",      u"div",       u"divides",
+    u"ndivides", u"intersection", u"union", u"and",       u"or",        u"ortho",
+    u"parallel", u"/",        u"setminus",  u"circ",      u"oplus",     u"otimes",
+    u"<<",       u">>",       u"leslant",   u"geslant",   u"*",
+};
+
+constexpr std::u16string_view aPrefixes[]
+    = { u"+", u"-", u"+-", u"-+", u"neg", u"sum", u"prod", u"int", u"Union", u"Intersection" };
+
+constexpr std::u16string_view aBareFunctions[] = {
+    u"sin",    u"cos",    u"tan",    u"cot",    u"sinh",   u"cosh",   u"tanh",
+    u"coth",   u"arcsin", u"arccos", u"arctan", u"arccot", u"arsinh", u"arcosh",
+    u"artanh", u"arcoth", u"ln",     u"log",    u"exp",
+};
+
+struct GreekName
+{
+    sal_Unicode cChar;
+    std::u16string_view aName;
+};
+
+constexpr GreekName aUpperGreek[] = {
+    { 0x0393, u"%GAMMA" }, { 0x0394, u"%DELTA" },   { 0x0398, u"%THETA" }, { 0x039B, u"%LAMBDA" },
+    { 0x039E, u"%XI" },    { 0x03A0, u"%PI" },      { 0x03A3, u"%SIGMA" }, { 0x03A5, u"%UPSILON" },
+    { 0x03A6, u"%PHI" },   { 0x03A8, u"%PSI" },     { 0x03A9, u"%OMEGA" },
+};
+
+template <std::size_t N> bool Contains(const std::u16string_view (&rList)[N], std::u16string_view aWord)
+{
+    return std::find(std::begin(rList), std::end(rList), aWord) != std::end(rList);
+}
+
+template <std::size_t N>
+const SymbolEntry* Find(const SymbolEntry (&rTable)[N], sal_Unicode c)
+{
+    const auto it = std::find_if(std::begin(rTable), std::end(rTable),
+                                 [c](const SymbolEntry& rEntry) { return rEntry.cChar == c; });
+    return it == std::end(rTable) ? nullptr : it;
+}
+
+bool IsInvisible(sal_Unicode c)
+{
+    return c < 0x20 || (c >= 0x7F && c < 0xA0) || (c >= 0xD800 && c <= 0xDFFF)
+           || (c >= 0x200B && c <= 0x200F) || c == 0x2060 || c == 0xFEFF || c >= 0xFFFE;
+}
+
+bool IsSpaceChar(sal_Unicode c) { return c == 0x20 || c == 0xA0 || (c >= 0x2002 && c <= 0x200A); }
+
+bool IsPrivateUse(sal_Unicode c) { return c >= 0xE000 && c <= 0xF8FF; }
+
+/// MathType's private-use spacing and placeholder characters that are written as nothing.
+bool IsSilentPrivateUse(sal_Unicode c)
+{
+    return c == 0xEF00 || c == 0xEF07 || (c >= 0xEB00 && c <= 0xEB02) || (c >= 0xEE04 && c <= 0xEE18);
+}
+}
+
+TokenClass ClassifyToken(std::u16string_view aToken)
+{
+    if (Contains(aOperators, aToken))
+        return TokenClass::Operator;
+    if (Contains(aPrefixes, aToken))
+        return TokenClass::Prefix;
+    return TokenClass::Operand;
+}
+
+Token SymbolToken(sal_Unicode c)
+{
+    Token aToken;
+    if (IsInvisible(c) || IsSilentPrivateUse(c))
+        return aToken;
+    if (IsSpaceChar(c))
+    {
+        aToken.aText = u"`";
+        return aToken;
+    }
+    if (const SymbolEntry* pEntry = Find(aSymbols, c))
+    {
+        aToken.aText = pEntry->aToken;
+        switch (c)
+        {
+            case u'(':
+            case u'[':
+            case u'{':
+                aToken.eClass = TokenClass::Open;
+                break;
+            case u')':
+            case u']':
+            case u'}':
+                aToken.eClass = TokenClass::Close;
+                break;
+            default:
+                aToken.eClass = ClassifyToken(aToken.aText);
+                return aToken;
+        }
+        aToken.eBracket = (c == u'(' || c == u')') ? Bracket::Round
+                          : (c == u'[' || c == u']') ? Bracket::Square
+                                                     : Bracket::Curly;
+        return aToken;
+    }
+    if (const SymbolEntry* pEntry = Find(aPrivateUseGlyphs, c))
+    {
+        aToken.aText = QuoteText(pEntry->aToken);
+        return aToken;
+    }
+    if (IsPrivateUse(c))
+    {
+        aToken.aText = u"{}";
+        return aToken;
+    }
+    if (IsAsciiDigit(c))
+    {
+        aToken.aText = std::u16string(1, c);
+        return aToken;
+    }
+    aToken.aText = QuoteText(std::u16string_view(&c, 1));
+    return aToken;
+}
+
+std::u16string EscapedBracket(Bracket eBracket, bool bOpen)
+{
+    switch (eBracket)
+    {
+        case Bracket::Round:
+            return bOpen ? u"\\(" : u"\\)";
+        case Bracket::Square:
+            return bOpen ? u"\\[" : u"\\]";
+        case Bracket::Curly:
+            return bOpen ? u"\\{" : u"\\}";
+        case Bracket::None:
+            break;
+    }
+    return std::u16string();
+}
+
+std::u16string QuoteText(std::u16string_view aText)
+{
+    std::u16string aOut;
+    aOut.reserve(aText.size() + 2);
+    aOut.push_back(u'"');
+    for (sal_Unicode c : aText)
+    {
+        if (c == u'"')
+            aOut.append(u"\\\"");
+        else if (c == u'\\')
+            aOut.push_back(0x2216);
+        else
+            aOut.push_back(c);
+    }
+    aOut.push_back(u'"');
+    return aOut;
+}
+
+std::u16string_view UpperGreekName(sal_Unicode c)
+{
+    for (const GreekName& rEntry : aUpperGreek)
+        if (rEntry.cChar == c)
+            return rEntry.aName;
+    return std::u16string_view();
+}
+
+bool IsBareFunctionName(std::u16string_view aName) { return Contains(aBareFunctions, aName); }
+
+bool IsStarMathKeyword(std::u16string_view aWord)
+{
+    return GetTokenTableEntry(OUString(aWord)) != nullptr;
+}
+
+bool IsIdentifierLetter(sal_Unicode c)
+{
+    if ((c >= u'a' && c <= u'z') || (c >= u'A' && c <= u'Z'))
+        return true;
+    if (c >= 0xC0 && c <= 0x24F) // Latin-1 letters and Latin Extended-A/B
+        return c != 0xD7 && c != 0xF7;
+    if (c >= 0x0386 && c <= 0x03FF) // Greek, without the punctuation in the block
+        return c != 0x0387 && c != 0x03A2 && c != 0x03F6;
+    if (c >= 0x0400 && c <= 0x0481) // Cyrillic
+        return true;
+    return c >= 0x1E00 && c <= 0x1EFF; // Latin Extended Additional (Vietnamese)
+}
+
+sal_Unicode TextChar(sal_Unicode c)
+{
+    if (IsInvisible(c) || IsSilentPrivateUse(c))
+        return 0;
+    if (!IsPrivateUse(c))
+        return c;
+    if (const SymbolEntry* pEntry = Find(aPrivateUseGlyphs, c))
+        return pEntry->aToken[0];
+    if (c >= 0xEF01 && c <= 0xEF08)
+        return u' ';
+    return 0;
+}
+
+bool IsKnownEmbellishment(sal_uInt8 nKind) { return Embellish(std::u16string(), nKind) != u""; }
+
+std::u16string Embellish(std::u16string aBase, sal_uInt8 nKind)
+{
+    std::u16string_view aAttribute;
+    switch (nKind)
+    {
+        case 2:
+            aAttribute = u"dot";
+            break;
+        case 3:
+            aAttribute = u"ddot";
+            break;
+        case 4:
+            aAttribute = u"dddot";
+            break;
+        case 5:
+            return u"{" + aBase + u"} rsup {′}";
+        case 6:
+            return u"{" + aBase + u"} rsup {″}";
+        case 18:
+            return u"{" + aBase + u"} rsup {‴}";
+        case 8:
+            aAttribute = u"tilde";
+            break;
+        case 9:
+            aAttribute = u"hat";
+            break;
+        case 11:
+            aAttribute = u"vec";
+            break;
+        case 14:
+            aAttribute = u"harpoon";
+            break;
+        case 16:
+            aAttribute = u"overstrike";
+            break;
+        case 17:
+            aAttribute = u"bar";
+            break;
+        case 19:
+            aAttribute = u"widearc";
+            break;
+        case 20:
+            aAttribute = u"breve";
+            break;
+        case 29:
+            aAttribute = u"underline";
+            break;
+        default:
+            return aBase;
+    }
+    std::u16string aOut(aAttribute);
+    aOut.append(u" {");
+    aOut.append(aBase);
+    aOut.push_back(u'}');
+    return aOut;
+}
+}
+
+/* vim:set shiftwidth=4 softtabstop=4 expandtab: */
