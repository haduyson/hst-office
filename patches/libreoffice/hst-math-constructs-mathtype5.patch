+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * Part of HST Office. This file is HST's own work and is not covered by the MPL.
+ */
+
+#pragma once
+
+#include <sal/types.h>
+
+#include <string>
+#include <string_view>
+
+// Character-level StarMath vocabulary of the MathType reader: the symbol table, quoting,
+// keyword checks and embellishments.
+namespace hst::mtef
+{
+/// What a token needs around it to parse in StarMath.
+enum class TokenClass : sal_uInt8
+{
+    Operand, ///< stands on its own
+    Operator, ///< binary operator or relation: needs an operand on both sides
+    Prefix, ///< sign or prefix operator: needs an operand after it
+    Open, ///< opening bracket that must be closed in the same line
+    Close ///< closing bracket
+};
+
+enum class Bracket : sal_uInt8
+{
+    None,
+    Round,
+    Square,
+    Curly
+};
+
+struct Token
+{
+    std::u16string aText; ///< empty: the character is written as nothing
+    TokenClass eClass = TokenClass::Operand;
+    Bracket eBracket = Bracket::None;
+};
+
+/// StarMath for one character of the symbol typeface (and any typeface without own rules).
+Token SymbolToken(sal_Unicode c);
+
+/// Operator class of a token written by SymbolToken (Operand for anything unknown).
+TokenClass ClassifyToken(std::u16string_view aToken);
+
+/// A bracket written as a single character, for brackets without a partner.
+std::u16string EscapedBracket(Bracket eBracket, bool bOpen);
+
+/// StarMath string literal; a backslash, which quotes cannot hold, becomes U+2216.
+std::u16string QuoteText(std::u16string_view aText);
+
+/// "%DELTA" etc. for the upper-case Greek letters StarMath names; empty otherwise.
+std::u16string_view UpperGreekName(sal_Unicode c);
+
+/// sin, cos, ln ...: function names StarMath knows as keywords.
+bool IsBareFunctionName(std::u16string_view aName);
+
+/// The word would be read as a StarMath keyword instead of an identifier.
+bool IsStarMathKeyword(std::u16string_view aWord);
+
+/// The character can be part of a StarMath identifier.
+bool IsIdentifierLetter(sal_Unicode c);
+
+inline bool IsAsciiDigit(sal_Unicode c) { return c >= '0' && c <= '9'; }
+
+/// Character as written inside quoted text: 0 = left out; MathType spacing becomes a space.
+sal_Unicode TextChar(sal_Unicode c);
+
+/// The embellishment kind has a StarMath form (see Embellish).
+bool IsKnownEmbellishment(sal_uInt8 nKind);
+
+/** Applies a character embellishment (dots, primes, accents...) to the StarMath of one
+    character. The slash-through embellishment is handled by the caller; unknown kinds
+    leave the character unchanged. */
+std::u16string Embellish(std::u16string aBase, sal_uInt8 nKind);
+}
+
+/* vim:set shiftwidth=4 softtabstop=4 expandtab: */
diff --git a/starmath/source/hst/mtef5templates.cxx b/starmath/source/hst/mtef5templates.cxx
new file mode 100644
index 0000000..5cd7cfa
--- /dev/null
+++ b/starmath/source/hst/mtef5templates.cxx
@@ -0,0 +1,255 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * Part of HST Office. This file is HST's own work and is not covered by the MPL.
+ */
+
+#include "mtef5templates.hxx"
+
+namespace hst::mtef
+{
+namespace
+{
+// Template selectors of MTEF 5.
+enum : sal_uInt8
+{
+    SEL_LAST_FENCE = 8,
+    SEL_INTERVAL = 9,
+    SEL_ROOT = 10,
+    SEL_FRACTION = 11,
+    SEL_UNDERBAR = 12,
+    SEL_OVERBAR = 13,
+    SEL_ARROW = 14,
+    SEL_INTEGRAL = 15,
+    SEL_SUM = 16,
+    SEL_PRODUCT = 17,
+    SEL_COPRODUCT = 18,
+    SEL_UNION = 19,
+    SEL_INTERSECTION = 20,
+    SEL_INTEGRAL_OP = 21,
+    SEL_SUM_OP = 22,
+    SEL_LIMIT = 23,
+    SEL_HBRACE = 24,
+    SEL_HBRACKET = 25,
+    SEL_SUB = 27,
+    SEL_SUP = 28,
+    SEL_SUBSUP = 29,
+    SEL_DIRAC = 30,
+    SEL_VECTOR = 31,
+    SEL_TILDE = 32,
+    SEL_HAT = 33,
+    SEL_ARC = 34,
+    SEL_STRIKE = 36
+};
+
+struct FencePair
+{
+    std::u16string_view aLeft;
+    std::u16string_view aRight;
+};
+
+// Selectors 0-8: angle, parentheses, braces, brackets, bars, double bars, floor, ceiling,
+// double brackets.
+constexpr FencePair aFences[] = {
+    { u"langle", u"rangle" }, { u"(", u")" },         { u"lbrace", u"rbrace" },
+    { u"[", u"]" },           { u"lline", u"rline" }, { u"ldline", u"rdline" },
+    { u"lfloor", u"rfloor" }, { u"lceil", u"rceil" }, { u"ldbracket", u"rdbracket" },
+};
+
+// Interval ends by their two-bit code.
+constexpr std::u16string_view aIntervalEnds[] = { u"(", u"[", u"]", u")" };
+
+std::u16string Braced(std::u16string_view aContent)
+{
+    std::u16string aOut;
+    aOut.reserve(aContent.size() + 2);
+    aOut.push_back(u'{');
+    aOut.append(aContent);
+    aOut.push_back(u'}');
+    return aOut;
+}
+
+/// " keyword {content}", or nothing for empty content.
+std::u16string OptionalPart(std::u16string_view aKeyword, std::u16string_view aContent)
+{
+    if (aContent.empty())
+        return std::u16string();
+    std::u16string aOut(u" ");
+    aOut.append(aKeyword);
+    aOut.push_back(u' ');
+    aOut.append(Braced(aContent));
+    return aOut;
+}
+
+TemplateOutput Piece(std::u16string aText) { return { TemplateKind::Piece, std::move(aText) }; }
+
+std::u16string_view BigOperatorKeyword(sal_uInt8 nSelector, sal_uInt16 nVariation)
+{
+    switch (nSelector)
+    {
+        case SEL_INTEGRAL:
+        {
+            const bool bContour = (nVariation & 0x0C) != 0;
+            switch (nVariation & 0x03)
+            {
+                case 2:
+                    return bContour ? u"llint" : u"iint";
+                case 3:
+                    return bContour ? u"lllint" : u"iiint";
+                default:
+                    return bContour ? u"lint" : u"int";
+            }
+        }
+        case SEL_SUM:
+            return u"sum";
+        case SEL_PRODUCT:
+            return u"prod";
+        case SEL_COPRODUCT:
+            return u"coprod";
+        case SEL_UNION:
+            return u"Union";
+        default:
+            return u"Intersection";
+    }
+}
+}
+
+TemplateOutput RenderTemplate(sal_uInt8 nSelector, sal_uInt16 nVariation,
+                              const std::vector<std::u16string>& rSlots,
+                              std::u16string_view aCharacters)
+{
+    auto aSlot = [&rSlots](std::size_t nIndex) -> std::u16string_view {
+        return nIndex < rSlots.size() ? std::u16string_view(rSlots[nIndex]) : std::u16string_view();
+    };
+    const std::u16string_view aFirst = aSlot(0);
+
+    if (nSelector <= SEL_LAST_FENCE)
+    {
+        const bool bNeither = (nVariation & 0x03) == 0;
+        const FencePair& rFence = aFences[nSelector];
+        std::u16string aOut(u"left ");
+        aOut.append((bNeither || (nVariation & 0x01)) ? rFence.aLeft : u"none");
+        aOut.push_back(u' ');
+        aOut.append(Braced(aFirst));
+        aOut.append(u" right ");
+        aOut.append((bNeither || (nVariation & 0x02)) ? rFence.aRight : u"none");
+        return Piece(std::move(aOut));
+    }
+
+    switch (nSelector)
+    {
+        case SEL_INTERVAL:
+        {
+            std::u16string aOut(u"left ");
+            aOut.append(aIntervalEnds[nVariation & 0x03]);
+            aOut.push_back(u' ');
+            aOut.append(Braced(aFirst));
+            aOut.append(u" right ");
+            aOut.append(aIntervalEnds[(nVariation >> 4) & 0x03]);
+            return Piece(std::move(aOut));
+        }
+        case SEL_ROOT:
+            if ((nVariation & 0x01) && !aSlot(1).empty())
+                return Piece(u"nroot " + Braced(aSlot(1)) + u" " + Braced(aFirst));
+            return Piece(u"sqrt " + Braced(aFirst));
+        case SEL_FRACTION:
+            if (nVariation & 0x02)
+                return Piece(Braced(aFirst) + u" wideslash " + Braced(aSlot(1)));
+            return Piece(Braced(Braced(aFirst) + u" over " + Braced(aSlot(1))));
+        case SEL_UNDERBAR:
+            return Piece(u"underline " + Braced(aFirst));
+        case SEL_OVERBAR:
+            return Piece(u"overline " + Braced(aFirst));
+        case SEL_ARROW:
+        {
+            std::u16string_view aArrow = u"xrightarrow";
+            if (nVariation & 0x02)
+                aArrow = u"xrightleftharpoons";
+            else if (nVariation & 0x01)
+                aArrow = u"xrightleftarrows";
+            else if (((nVariation >> 4) & 0x03) == 1)
+                aArrow = u"xleftarrow";
+            std::u16string aOut = Braced(aFirst);
+            aOut.push_back(u' ');
+            aOut.append(aArrow);
+            aOut.push_back(u' ');
+            aOut.append(Braced(aSlot(1)));
+            return Piece(Braced(aOut));
+        }
+        case SEL_INTEGRAL:
+        case SEL_SUM:
+        case SEL_PRODUCT:
+        case SEL_COPRODUCT:
+        case SEL_UNION:
+        case SEL_INTERSECTION:
+        {
+            std::u16string aOut(BigOperatorKeyword(nSelector, nVariation));
+            aOut.append(OptionalPart(u"from", aSlot(1)));
+            aOut.append(OptionalPart(u"to", aSlot(2)));
+            aOut.push_back(u' ');
+            aOut.append(Braced(aFirst));
+            return Piece(Braced(aOut));
+        }
+        case SEL_INTEGRAL_OP:
+        case SEL_SUM_OP:
+        {
+            // The operator itself is the fourth slot; older equations carry it as a character.
+            const std::u16string_view aOperator = rSlots.size() > 3 ? aSlot(3) : aCharacters;
+            const bool bCentred = (nVariation & 0x40) != 0;
+            std::u16string aOut = Braced(aOperator);
+            aOut.append(OptionalPart(bCentred ? u"csub" : u"rsub", aSlot(1)));
+            aOut.append(OptionalPart(bCentred ? u"csup" : u"rsup", aSlot(2)));
+            aOut.push_back(u' ');
+            aOut.append(Braced(aFirst));
+            return Piece(Braced(aOut));
+        }
+        case SEL_LIMIT:
+            return Piece(Braced(Braced(aFirst) + OptionalPart(u"csub", aSlot(1))
+                                + OptionalPart(u"csup", aSlot(2))));
+        case SEL_HBRACE:
+        case SEL_HBRACKET:
+            return Piece(Braced(Braced(aFirst) + ((nVariation & 0x01) ? u" overbrace " : u" underbrace ")
+                                + Braced(aSlot(1))));
+        case SEL_SUB:
+        case SEL_SUP:
+        case SEL_SUBSUP:
+        {
+            const bool bBefore = (nVariation & 0x01) != 0;
+            std::u16string aOut = OptionalPart(bBefore ? u"lsub" : u"rsub", aFirst)
+                                  + OptionalPart(bBefore ? u"lsup" : u"rsup", aSlot(1));
+            if (aOut.empty())
+                return TemplateOutput();
+            aOut.erase(0, 1); // leading space of the first part
+            return { bBefore ? TemplateKind::PreScripts : TemplateKind::PostScripts, std::move(aOut) };
+        }
+        case SEL_DIRAC:
+            return Piece(u"langle " + Braced((nVariation & 0x01) ? aFirst : std::u16string_view())
+                         + u" mline " + Braced((nVariation & 0x02) ? aSlot(1) : std::u16string_view())
+                         + u" rangle");
+        case SEL_VECTOR:
+        {
+            std::u16string_view aAccent = u"widevec";
+            if (nVariation & 0x08)
+                aAccent = u"wideharpoon";
+            else if ((nVariation & 0x03) == 0x01)
+                aAccent = u"wideleftvec";
+            return Piece(std::u16string(aAccent) + u" " + Braced(aFirst));
+        }
+        case SEL_TILDE:
+            return Piece(u"widetilde " + Braced(aFirst));
+        case SEL_HAT:
+            return Piece(u"widehat " + Braced(aFirst));
+        case SEL_ARC:
+            return Piece(u"widearc " + Braced(aFirst));
+        case SEL_STRIKE:
+            if (nVariation & 0x01)
+                return Piece(u"overstrike " + Braced(aFirst));
+            return Piece(Braced(aFirst));
+        default: // long division, joint status, box and unknown templates keep their content
+            return Piece(Braced(aFirst));
+    }
+}
+}
+
