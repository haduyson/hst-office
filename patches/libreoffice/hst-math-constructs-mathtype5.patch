+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * Part of HST Office. This file is HST's own work and is not covered by the MPL.
+ */
+
+#pragma once
+
+#include <sal/types.h>
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+// MathType templates (fences, fractions, roots, big operators, scripts, accents...) as StarMath.
+namespace hst::mtef
+{
+enum class TemplateKind
+{
+    Piece, ///< a self-contained piece of the line
+    PostScripts, ///< scripts for the previous piece ("rsub {..} rsup {..}")
+    PreScripts, ///< scripts for the next piece ("lsub {..} lsup {..}")
+    Nothing ///< scripts template whose slots are all empty
+};
+
+struct TemplateOutput
+{
+    TemplateKind eKind = TemplateKind::Nothing;
+    std::u16string aText;
+};
+
+/** StarMath of one template.
+    @param rSlots the StarMath of the template's lines and piles, in record order, without
+                  braces; an empty string is an empty slot
+    @param aCharacters the StarMath of the template's own characters (e.g. the operator
+                       symbol), used where the operator is not given by a slot */
+TemplateOutput RenderTemplate(sal_uInt8 nSelector, sal_uInt16 nVariation,
+                              const std::vector<std::u16string>& rSlots,
+                              std::u16string_view aCharacters);
+}
