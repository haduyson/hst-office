+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * Part of HST Office. This file is HST's own work and is not covered by the MPL.
+ */
+
+#include "mathtypeglue.hxx"
+#include "mtef5converter.hxx"
+
+#include <format.hxx>
+#include <utility.hxx>
+
+#include <sal/log.hxx>
+#include <tools/stream.hxx>
+
+#include <vector>
+
+namespace starmath::hst
+{
+bool ParseMtef5(SvStream& rStream, sal_uInt64 nStart, OUStringBuffer& rOut,
+                sal_uInt16& rBaseHeightPt)
+{
+    const sal_uInt64 nSize = rStream.TellEnd();
+    if (nSize <= nStart || nSize - nStart > 16 * 1024 * 1024)
+        return false;
+    std::vector<sal_uInt8> aData(nSize - nStart);
+    rStream.Seek(nStart);
+    if (rStream.ReadBytes(aData.data(), aData.size()) != aData.size())
+        return false;
+    const ::hst::mtef::Result aRes = ::hst::mtef::ConvertEquationNative(aData.data(), aData.size());
+    if (aRes.eStatus != ::hst::mtef::Status::Converted)
+    {
+        SAL_INFO("starmath", "MathType 5 equation kept as OLE object");
+        return false;
+    }
+    rOut.append(aRes.aStarMath);
+    rBaseHeightPt = aRes.nBaseHeightPt;
+    return true;
+}
+
+void ApplyBaseHeight(SmFormat& rFormat, sal_uInt16 nPt)
+{
+    if (!nPt)
+        return;
+    Size aSize = rFormat.GetBaseSize();
+    aSize.setHeight(o3tl::convert(nPt, o3tl::Length::pt, SmO3tlLengthUnit()));
+    rFormat.SetBaseSize(aSize);
+    for (sal_uInt16 i = FNT_BEGIN; i <= FNT_END; ++i)
+        rFormat.SetFontSize(i, aSize);
+}
+}
+
