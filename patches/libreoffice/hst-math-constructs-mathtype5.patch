+
+// TranslateId with no translation shows its text as it is: HST Office's interface is Vietnamese
+const TranslateId aIds[] = { { "HST", "Mẫu Toán" }, { "HST", "Mẫu Vật lí" }, { "HST", "Mẫu Hoá học" } };
+constexpr std::span<const Template> aCategories[] = { aMath, aPhysics, aChemistry };
+}
+
+std::vector<TranslateId> WithTemplateCategories(const std::vector<TranslateId>& rCategories)
+{
+    std::vector<TranslateId> aAll(rCategories);
+    aAll.insert(aAll.empty() ? aAll.end() : aAll.end() - 1, std::begin(aIds), std::end(aIds));
+    return aAll;
+}
+
+int StartCategory(std::size_t nCategories)
+{
+    static constexpr OUString aPath(u"/org.hasontech.hstoffice.Formula"_ustr);
+    static constexpr OUString aKey(u"OpenTemplates"_ustr);
+    try
+    {
+        const css::uno::Reference<css::uno::XInterface> xConfig = comphelper::ConfigurationHelper::openConfig(
+            comphelper::getProcessComponentContext(), aPath, comphelper::EConfigurationModes::Standard);
+        css::uno::Reference<css::beans::XPropertySet> xProps(xConfig, css::uno::UNO_QUERY_THROW);
+        bool bOpen = false;
+        if (!(xProps->getPropertyValue(aKey) >>= bOpen) || !bOpen)
+            return 0;
+        xProps->setPropertyValue(aKey, css::uno::Any(false));
+        comphelper::ConfigurationHelper::flush(xConfig);
+    }
+    catch (const css::uno::Exception&)
+    {
+        return 0; // no HST extension: the usual first category
+    }
+    const std::size_t nTemplates = std::size(aIds);
+    return nCategories > nTemplates ? int(nCategories - nTemplates - 1) : 0;
+}
+
+bool AddTemplateElements(
+    int nIndex, const std::function<void(const OUString&, const OUString&, const OUString&)>& rAdd)
+{
+    if (nIndex < 0 || nIndex >= int(std::size(aCategories)))
+        return false;
+    for (const Template& rTemplate : aCategories[nIndex])
+    {
+        const OUString aFormula(rTemplate.aFormula);
+        rAdd(aFormula, aFormula, OUString(rTemplate.aHelp));
+    }
+    return true;
+}
+}
+
