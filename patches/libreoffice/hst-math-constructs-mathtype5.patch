diff --git a/starmath/source/hst/mtef5linebuilder.cxx b/starmath/source/hst/mtef5linebuilder.cxx
new file mode 100644
index 0000000..0f09f0d
--- /dev/null
+++ b/starmath/source/hst/mtef5linebuilder.cxx
@@ -0,0 +1,142 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * Part of HST Office. This file is HST's own work and is not covered by the MPL.
+ */
+
+#include "mtef5linebuilder.hxx"
+
+namespace hst::mtef
+{
+namespace
+{
+bool NeedsOperandAfter(TokenClass eClass)
+{
+    return eClass == TokenClass::Operator || eClass == TokenClass::Prefix;
+}
+}
+
+LineBuilder::LineBuilder() { m_aFrames.emplace_back(); }
+
+void LineBuilder::Add(const Token& rToken)
+{
+    if (rToken.aText.empty())
+        return;
+    switch (rToken.eClass)
+    {
+        case TokenClass::Open:
+        {
+            Frame aFrame;
+            aFrame.eBracket = rToken.eBracket;
+            aFrame.aOpen = rToken.aText;
+            m_aFrames.push_back(std::move(aFrame));
+            return;
+        }
+        case TokenClass::Close:
+        {
+            if (m_aFrames.size() > 1 && m_aFrames.back().eBracket == rToken.eBracket)
+            {
+                Frame aFrame = std::move(m_aFrames.back());
+                m_aFrames.pop_back();
+                const std::u16string aInner = Join(aFrame);
+                // The bracketed group is one piece, so scripts after it apply to all of it.
+                Push({ aFrame.aOpen + u" " + (aInner.empty() ? u"{}" : aInner) + u" " + rToken.aText,
+                       TokenClass::Operand, false });
+            }
+            else
+                Push({ EscapedBracket(rToken.eBracket, false), TokenClass::Operand, false });
+            return;
+        }
+        default:
+            Push({ rToken.aText, rToken.eClass, false });
+            return;
+    }
+}
+
+void LineBuilder::AddPostScripts(const std::u16string& rScripts)
+{
+    Frame& rFrame = m_aFrames.back();
+    FlushPreScripts(rFrame);
+    if (rFrame.aPieces.empty() || rFrame.aPieces.back().eClass != TokenClass::Operand)
+        rFrame.aPieces.push_back({ u"{}", TokenClass::Operand, false });
+    Piece& rBase = rFrame.aPieces.back();
+    if (rBase.bScripted) // x rsup {2} followed by rsub {1}: script the scripted piece
+        rBase.aText = u"{" + rBase.aText + u"}";
+    rBase.aText += u" " + rScripts;
+    rBase.bScripted = true;
+}
+
+void LineBuilder::AddPreScripts(const std::u16string& rScripts)
+{
+    Frame& rFrame = m_aFrames.back();
+    FlushPreScripts(rFrame);
+    rFrame.aPendingPreScripts = rScripts;
+}
+
+std::u16string LineBuilder::Finish()
+{
+    // Brackets that were never closed become single characters; their pieces join the
+    // enclosing frame.
+    while (m_aFrames.size() > 1)
+    {
+        Frame aFrame = std::move(m_aFrames.back());
+        m_aFrames.pop_back();
+        Push({ EscapedBracket(aFrame.eBracket, true), TokenClass::Operand, false });
+        Frame& rParent = m_aFrames.back();
+        for (Piece& rPiece : aFrame.aPieces)
+            rParent.aPieces.push_back(std::move(rPiece));
+        rParent.aPendingPreScripts = std::move(aFrame.aPendingPreScripts);
+    }
+    return Join(m_aFrames.back());
+}
+
+void LineBuilder::Push(Piece aPiece)
+{
+    Frame& rFrame = m_aFrames.back();
+    if (!rFrame.aPendingPreScripts.empty())
+    {
+        if (aPiece.eClass == TokenClass::Operand)
+        {
+            aPiece.aText = u"{" + aPiece.aText + u"} " + rFrame.aPendingPreScripts;
+            aPiece.bScripted = false;
+            rFrame.aPendingPreScripts.clear();
+        }
+        else
+            FlushPreScripts(rFrame); // an operator cannot carry scripts: use an empty base
+    }
+    rFrame.aPieces.push_back(std::move(aPiece));
+}
+
+void LineBuilder::FlushPreScripts(Frame& rFrame)
+{
+    if (rFrame.aPendingPreScripts.empty())
+        return;
+    rFrame.aPieces.push_back({ u"{} " + rFrame.aPendingPreScripts, TokenClass::Operand, false });
+    rFrame.aPendingPreScripts.clear();
+}
+
+std::u16string LineBuilder::Join(Frame& rFrame)
+{
+    FlushPreScripts(rFrame);
+    std::u16string aOut;
+    TokenClass ePrevious = TokenClass::Operand;
+    bool bFirst = true;
+    for (const Piece& rPiece : rFrame.aPieces)
+    {
+        if (!bFirst)
+            aOut.push_back(u' ');
+        // A binary operator needs a left operand: at the start, or after another operator.
+        if (rPiece.eClass == TokenClass::Operator && (bFirst || NeedsOperandAfter(ePrevious)))
+            aOut.append(u"{} ");
+        aOut.append(rPiece.aText);
+        ePrevious = rPiece.eClass;
+        bFirst = false;
+    }
+    if (!bFirst && NeedsOperandAfter(ePrevious))
+        aOut.append(u" {}");
+    return aOut;
+}
+}
+
+/* vim:set shiftwidth=4 softtabstop=4 expandtab: */
diff --git a/starmath/source/hst/mtef5linebuilder.hxx b/starmath/source/hst/mtef5linebuilder.hxx
new file mode 100644
index 0000000..702d0d7
--- /dev/null
+++ b/starmath/source/hst/mtef5linebuilder.hxx
@@ -0,0 +1,63 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * Part of HST Office. This file is HST's own work and is not covered by the MPL.
+ */
+
+#pragma once
+
+#include "mtef5symbols.hxx"
+
+#include <string>
+#include <vector>
+
+// Assembles the StarMath of one line from its pieces so that the result always parses:
+// operators get the operands StarMath requires, scripts find a base, and brackets written
+// as plain characters are either paired or written as single characters.
+namespace hst::mtef
+{
+class LineBuilder
+{
+public:
+    LineBuilder();
+
+    /// Appends one token; empty tokens are ignored.
+    void Add(const Token& rToken);
+
+    /// "rsub {..} rsup {..}" for the previous piece (or an empty base).
+    void AddPostScripts(const std::u16string& rScripts);
+
+    /// "lsub {..} lsup {..}" for the next piece (or an empty base).
+    void AddPreScripts(const std::u16string& rScripts);
+
+    /// The line's StarMath, pieces separated by single spaces.
+    std::u16string Finish();
+
+private:
+    struct Piece
+    {
+        std::u16string aText;
+        TokenClass eClass = TokenClass::Operand;
+        bool bScripted = false; ///< already carries post-scripts
+    };
+
+    /// The pieces since an opening bracket that is not closed yet (the first frame is the
+    /// line itself).
+    struct Frame
+    {
+        Bracket eBracket = Bracket::None;
+        std::u16string aOpen;
+        std::vector<Piece> aPieces;
+        std::u16string aPendingPreScripts;
+    };
+
+    void Push(Piece aPiece);
+    static void FlushPreScripts(Frame& rFrame);
+    static std::u16string Join(Frame& rFrame);
+
+    std::vector<Frame> m_aFrames;
+};
+}
