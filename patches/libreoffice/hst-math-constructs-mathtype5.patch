+++ b/starmath/qa/cppunit/test_hst_mtef5.cxx
@@ -0,0 +1,352 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * Part of HST Office. This file is HST's own work and is not covered by the MPL.
+ */
+
+// Tests of HST's MathType 4-7 (MTEF 5) reader: the acceptance fixtures, StarMath that must
+// always parse, and damaged input (truncated, corrupted, too deeply nested) that must be
+// reported as damaged without crashing.
+
+#include <sal/config.h>
+#include <test/bootstrapfixture.hxx>
+
+#include <node.hxx>
+#include <parse5.hxx>
+#include <smdll.hxx>
+
+#include <hst/mtef5converter.hxx>
+
+#include "hst_mtef5_fixtures.hxx"
+
+#include <memory>
+
+using namespace hst::mtef;
+using namespace hst::mtef::fixtures;
+
+namespace
+{
+Result Convert(const std::vector<sal_uInt8>& rBytes)
+{
+    return ConvertEquationNative(rBytes.data(), rBytes.size());
+}
+
+bool HasErrorNode(const SmNode* pNode)
+{
+    if (!pNode)
+        return false;
+    if (pNode->GetType() == SmNodeType::Error)
+        return true;
+    for (size_t i = 0; i < pNode->GetNumSubNodes(); ++i)
+        if (HasErrorNode(pNode->GetSubNode(i)))
+            return true;
+    return false;
+}
+
+void AssertParses(const OUString& rStarMath)
+{
+    std::unique_ptr<SmTableNode> pTree = SmParser5().Parse(rStarMath);
+    CPPUNIT_ASSERT_MESSAGE(OUString("does not parse: " + rStarMath).toUtf8().getStr(),
+                           pTree && !HasErrorNode(pTree.get()));
+}
+
+/// Converts and checks that the result is converted and is the expected StarMath.
+void AssertStarMath(std::u16string_view aExpected, const StreamBuilder& rStream)
+{
+    const Result aResult = Convert(rStream.Get());
+    CPPUNIT_ASSERT(aResult.eStatus == Status::Converted);
+    CPPUNIT_ASSERT_EQUAL(OUString(aExpected), aResult.aStarMath);
+    AssertParses(aResult.aStarMath);
+}
+
+Status StatusOf(Expect eExpect)
+{
+    switch (eExpect)
+    {
+        case Expect::Converted:
+            return Status::Converted;
+        case Expect::NotMtef5:
+            return Status::NotMtef5;
+        case Expect::Damaged:
+            break;
+    }
+    return Status::Damaged;
+}
+
+class Mtef5Test : public test::BootstrapFixture
+{
+public:
+    void setUp() override
+    {
+        BootstrapFixture::setUp();
+        SmGlobals::ensure();
+    }
+
+    void testAcceptanceFixtures()
+    {
+        for (const Fixture& rFixture : AcceptanceFixtures())
+        {
+            const Result aResult = Convert(rFixture.aBytes);
+            CPPUNIT_ASSERT_MESSAGE(rFixture.pName, aResult.eStatus == StatusOf(rFixture.eExpect));
+            if (aResult.eStatus != Status::Converted)
+                continue;
+            CPPUNIT_ASSERT_EQUAL_MESSAGE(rFixture.pName, OUString(rFixture.aStarMath),
+                                         aResult.aStarMath);
+            CPPUNIT_ASSERT_EQUAL_MESSAGE(rFixture.pName, rFixture.nBaseHeight, aResult.nBaseHeightPt);
+            AssertParses(aResult.aStarMath);
+        }
+    }
+
+    void testEmptyInput()
+    {
+        CPPUNIT_ASSERT(ConvertEquationNative(nullptr, 0).eStatus == Status::NotMtef5);
+        const sal_uInt8 aOne[] = { 28 };
+        CPPUNIT_ASSERT(ConvertEquationNative(aOne, 1).eStatus == Status::Damaged);
+        // header length pointing beyond the data
+        const sal_uInt8 aHeader[] = { 0xFF, 0x7F, 0, 0, 5 };
+        CPPUNIT_ASSERT(ConvertEquationNative(aHeader, sizeof aHeader).eStatus == Status::Damaged);
+        // an equation without any line (MathType writes these for empty objects)
+        AssertStarMath(u"{}", StreamBuilder().Bytes({ 10, 0 }));
+    }
+
+    void testTruncatedStreams()
+    {
+        for (const Fixture& rFixture : AcceptanceFixtures())
+        {
+            if (rFixture.eExpect != Expect::Converted)
+                continue;
+            const std::vector<sal_uInt8>& rBytes = rFixture.aBytes;
+            for (size_t nCut = 1; nCut + 1 < rBytes.size(); ++nCut)
+            {
+                const Result aResult = ConvertEquationNative(rBytes.data(), nCut);
+                // Data may end between top-level records, but not inside the MTEF header or
+                // inside the equation's line.
+                if (nCut >= StreamBuilder::HEADER_SIZE && nCut <= rFixture.nBodyStart)
+                {
+                    CPPUNIT_ASSERT(aResult.eStatus != Status::NotMtef5);
+                    continue;
+                }
+                CPPUNIT_ASSERT_MESSAGE(OString(OString::Concat(rFixture.pName) + " cut at "
+                                               + OString::number(sal_uInt64(nCut)))
+                                           .getStr(),
+                                       aResult.eStatus == Status::Damaged);
+                CPPUNIT_ASSERT(aResult.aStarMath.isEmpty());
+            }
+            // Without the closing top-level tag the data simply ends: still an equation.
+            CPPUNIT_ASSERT(ConvertEquationNative(rBytes.data(), rBytes.size() - 1).eStatus
+                           == Status::Converted);
+        }
+    }
+
+    void testCorruptedStreams()
+    {
+        sal_uInt32 nSeed = 0x2545F491;
+        auto aRandom = [&nSeed]() {
+            nSeed ^= nSeed << 13;
+            nSeed ^= nSeed >> 17;
+            nSeed ^= nSeed << 5;
+            return nSeed;
+        };
+        for (const Fixture& rFixture : AcceptanceFixtures())
+        {
+            if (rFixture.eExpect != Expect::Converted)
+                continue;
+            for (int nRound = 0; nRound < 1500; ++nRound)
+            {
+                std::vector<sal_uInt8> aBytes = rFixture.aBytes;
+                const int nChanges = 1 + aRandom() % 3;
+                for (int i = 0; i < nChanges; ++i)
+                {
+                    // keep the OLE header length and the version, corrupt the rest
+                    const size_t nPos = 29 + aRandom() % (aBytes.size() - 29);
+                    aBytes[nPos] = static_cast<sal_uInt8>(aRandom());
+                }
+                if (aRandom() % 4 == 0)
+                    aBytes.resize(29 + aRandom() % (aBytes.size() - 29));
+                const Result aResult = Convert(aBytes);
+                if (aResult.eStatus == Status::Converted)
+                {
+                    CPPUNIT_ASSERT(!aResult.aStarMath.isEmpty());
+                    AssertParses(aResult.aStarMath);
+                }
+                else
+                    CPPUNIT_ASSERT(aResult.aStarMath.isEmpty());
+            }
+        }
+    }
+
+    void testNesting()
+    {
+        auto aNested = [](int nLevels) {
+            StreamBuilder aStream;
+            aStream.Line();
+            for (int i = 0; i < nLevels; ++i)
+                aStream.Template(10, 0).Line();
+            aStream.Char(VARIABLE, 'x');
+            for (int i = 0; i < nLevels; ++i)
+                aStream.End().End();
+            aStream.End().End();
+            return aStream;
+        };
+        // a root inside a root: two list levels each
+        const Result aDeep = Convert(aNested(150).Get());
+        CPPUNIT_ASSERT(aDeep.eStatus == Status::Damaged);
+        const Result aFine = Convert(aNested(60).Get());
+        CPPUNIT_ASSERT(aFine.eStatus == Status::Converted);
+        AssertParses(aFine.aStarMath);
+    }
+
+    void testRecordErrors()
+    {
+        // unknown record type below 100
+        CPPUNIT_ASSERT(Convert(StreamBuilder().Line().Byte(50).End().End().Get()).eStatus
+                       == Status::Damaged);
+        // a future record is skipped by its length
+        AssertStarMath(u"x", StreamBuilder().Line().Bytes({ 100, 3, 9, 9, 9 }).Char(VARIABLE, 'x')
+                                 .End().End());
+        // matrix with fewer cells than rows times columns
+        CPPUNIT_ASSERT(Convert(StreamBuilder().Line().Matrix(2, 2).Line().End().Line().End()
+                                   .Line().End().End().End().End().Get())
+                           .eStatus
+                       == Status::Damaged);
+        // a pile can stand in for a matrix cell
+        AssertStarMath(u"matrix{{{x}}}", StreamBuilder().Line().Matrix(1, 1).Pile(1).Line()
+                                             .Char(VARIABLE, 'x').End().End().End().End().End());
+        // missing font and style indexes are not damage
+        AssertStarMath(u"\"a\"", StreamBuilder().Bytes({ 18, 0, 0, 0, 1, 7, 0 })
+                                     .Line().Bytes({ 2, 0, 128 - 5 }).Word('a').End().End());
+        // nudges, line spacing and rulers are read and dropped
+        AssertStarMath(u"x", StreamBuilder().Bytes({ 1, 0x08 | 0x04 | 0x02, 128, 128, 1, 0, 2, 0, 1, 0, 1, 0, 5, 0 })
+                                 .Bytes({ 2, 0x08, 130, 140, 128 + VARIABLE }).Word('x').End().End());
+    }
+
+    void testOperands()
+    {
+        // trailing sign in a superscript (ion charge)
+        AssertStarMath(u"nitalic Fe rsup {3 + {}}",
+                       StreamBuilder().Bytes({ 18, 0, 0, 0, 3, 1, 0, 1, 0, 1, 0 })
+                           .FontDef("Times New Roman").Line().Chars(VARIABLE, u"Fe")
+                           .Template(28, 0).NullLine().Line().Char(NUMBER, '3').Char(SYMBOL, '+')
+                           .End().End().End().End());
+        // relation at the end, operator after a sign
+        AssertStarMath(u"x = - {} times {}",
+                       StreamBuilder().Line().Char(VARIABLE, 'x').Chars(SYMBOL, u"=-×").End().End());
+        // a post-script without a base
+        AssertStarMath(u"{} rsup {2}",
+                       StreamBuilder().Line().Template(28, 0).NullLine().Line().Char(NUMBER, '2')
+                           .End().End().End().End());
+        // pre-scripts before an operator sit on an empty base
+        AssertStarMath(u"{} lsup {14} = x",
+                       StreamBuilder().Line().Template(28, 1).NullLine().Line().Chars(NUMBER, u"14")
+                           .End().End().Char(SYMBOL, '=').Char(VARIABLE, 'x').End().End());
+    }
+
+    void testBrackets()
+    {
+        // paired brackets form one group that takes the scripts
+        AssertStarMath(u"{( a + b ) rsup {2}} rsub {1}",
+                       StreamBuilder().Line().Char(SYMBOL, '(').Char(VARIABLE, 'a').Char(SYMBOL, '+')
+                           .Char(VARIABLE, 'b').Char(SYMBOL, ')').Template(28, 0).NullLine()
+                           .Line().Char(NUMBER, '2').End().End().Template(27, 0)
+                           .Line().Char(NUMBER, '1').End().NullLine().End().End().End());
+        // unpaired brackets become single characters
+        AssertStarMath(u"\\[ 0 , x \\)",
+                       StreamBuilder().Line().Char(SYMBOL, '[').Char(NUMBER, '0').Char(SYMBOL, ',')
+                           .Char(VARIABLE, 'x').Char(SYMBOL, ')').End().End());
+        // a decimal comma in another typeface stays inside the number
+        AssertStarMath(u"0,5 x",
+                       StreamBuilder().Line().Char(NUMBER, '0').Char(2, ',').Char(NUMBER, '5')
+                           .Char(VARIABLE, 'x').End().End());
+        AssertStarMath(u"\\( = 2",
+                       StreamBuilder().Line().Chars(SYMBOL, u"(=").Char(NUMBER, '2').End().End());
+    }
+
+    void testCharacters()
+    {
+        // text quoting
+        AssertStarMath(u"\"a\\\"b∖c\"",
+                       StreamBuilder().Line().Chars(TEXT, u"a\"b\\c").End().End());
+        // spaces only
+        AssertStarMath(u"` `", StreamBuilder().Line().Chars(TEXT, u"  ").End().End());
+        // functions
+        AssertStarMath(u"sin x", StreamBuilder().Line().Chars(2, u"sin").Char(VARIABLE, 'x').End().End());
+        AssertStarMath(u"func max", StreamBuilder().Line().Chars(2, u"max").End().End());
+        // symbols, private-use spacing and unknown characters
+        AssertStarMath(u"a <= b ~ \"°\" infinity {} \"%\"",
+                       StreamBuilder().Line().Char(VARIABLE, 'a').Char(SYMBOL, 0x2264)
+                           .Char(VARIABLE, 'b').Char(SYMBOL, 0xEF04).Char(SYMBOL, 0x00B0)
+                           .Char(SYMBOL, 0x221E).Char(SYMBOL, 0xE123).Char(SYMBOL, '%').End().End());
+        // embellishments: prime and dot; slash through an equals sign
+        AssertStarMath(u"{x} rsup {′} dot {y} <> z",
+                       StreamBuilder().Line().Bytes({ 2, 0x01, 128 + VARIABLE }).Word('x')
+                           .Bytes({ 6, 0, 5, 0 }).Bytes({ 2, 0x01, 128 + VARIABLE }).Word('y')
+                           .Bytes({ 6, 0, 2, 0 }).Bytes({ 2, 0x01, 128 + SYMBOL }).Word('=')
+                           .Bytes({ 6, 0, 10, 0 }).Char(VARIABLE, 'z').End().End());
+        // an accent on an operator keeps the operator as text
+        AssertStarMath(u"x hat {\"+\"}",
+                       StreamBuilder().Line().Char(VARIABLE, 'x').Bytes({ 2, 0x01, 128 + SYMBOL })
+                           .Word('+').Bytes({ 6, 0, 9, 0 }).End().End());
+    }
+
+    void testLegacyFonts()
+    {
+        // VNI: letter plus tone-mark byte, given as font positions
+        StreamBuilder aStream;
+        aStream.FontDef("VNI-Times").Bytes({ 18, 0, 0, 0, 1, 1, 0 }).Line();
+        // "V", "i", "e" + dot-below mark byte, "t"
+        for (sal_uInt8 nByte : std::initializer_list<sal_uInt8>{ 0x56, 0x69, 0x65, 0xE4, 0x74 })
+            aStream.Bytes({ 2, 0x04, 128 + TEXT }).Word(nByte).Byte(nByte);
+        aStream.End().End();
+        AssertStarMath(u"\"Việt\"", aStream);
+    }
+
+    void testTemplates()
+    {
+        // integral with limits, sum without limits
+        AssertStarMath(u"{int from {0} to {1} {x}}",
+                       StreamBuilder().Line().Template(15, 1).Line().Char(VARIABLE, 'x').End()
+                           .Line().Char(NUMBER, '0').End().Line().Char(NUMBER, '1').End()
+                           .Char(22, 0x222B).End().End().End());
+        AssertStarMath(u"{sum {k}}",
+                       StreamBuilder().Line().Template(16, 0).Line().Char(VARIABLE, 'k').End()
+                           .NullLine().NullLine().End().End().End());
+        // operator given by the fourth slot
+        AssertStarMath(u"{{T} csub {n} {x}}",
+                       StreamBuilder().Line().Template(22, 0x40 | 0x10).Line().Char(VARIABLE, 'x')
+                           .End().Line().Char(VARIABLE, 'n').End().NullLine()
+                           .Line().Char(VARIABLE, 'T').End().End().End().End());
+        AssertStarMath(u"nroot {3} {x}",
+                       StreamBuilder().Line().Template(10, 1).Line().Char(VARIABLE, 'x').End()
+                           .Line().Char(NUMBER, '3').End().End().End().End());
+        AssertStarMath(u"{x} wideslash {y}",
+                       StreamBuilder().Line().Template(11, 2).Line().Char(VARIABLE, 'x').End()
+                           .Line().Char(VARIABLE, 'y').End().End().End().End());
+        AssertStarMath(u"left [ {x} right )",
+                       StreamBuilder().Line().Template(9, 0x31).Line().Char(VARIABLE, 'x').End()
+                           .End().End().End());
+        AssertStarMath(u"{{func lim} csub {x toward 0}}",
+                       StreamBuilder().Line().Template(23, 0).Line().Chars(2, u"lim").End()
+                           .Line().Char(VARIABLE, 'x').Char(SYMBOL, 0x2192).Char(NUMBER, '0').End()
+                           .NullLine().End().End().End());
+    }
+
+    CPPUNIT_TEST_SUITE(Mtef5Test);
+    CPPUNIT_TEST(testAcceptanceFixtures);
+    CPPUNIT_TEST(testEmptyInput);
+    CPPUNIT_TEST(testTruncatedStreams);
+    CPPUNIT_TEST(testCorruptedStreams);
+    CPPUNIT_TEST(testNesting);
+    CPPUNIT_TEST(testRecordErrors);
+    CPPUNIT_TEST(testOperands);
+    CPPUNIT_TEST(testBrackets);
+    CPPUNIT_TEST(testCharacters);
+    CPPUNIT_TEST(testLegacyFonts);
+    CPPUNIT_TEST(testTemplates);
+    CPPUNIT_TEST_SUITE_END();
+};
+
+CPPUNIT_TEST_SUITE_REGISTRATION(Mtef5Test);
+}
