+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * Part of HST Office. This file is HST's own work and is not covered by the MPL.
+ */
+
+#pragma once
+
+#include <rtl/ustring.hxx>
+#include <sal/types.h>
+
+#include <cstddef>
+
+// Interface between HST Office's MathType 4-7 reader and the rest of HST Office.
+// The reader (mtef5converter.cxx and helpers) is written from the behaviour spec only.
+namespace hst::mtef
+{
+enum class Status
+{
+    Converted, ///< aStarMath holds the formula
+    NotMtef5, ///< not an MTEF version 5 equation; nothing was read
+    Damaged ///< truncated or inconsistent data; the caller keeps the original OLE object
+};
+
+struct Result
+{
+    Status eStatus = Status::NotMtef5;
+    OUString aStarMath; ///< StarMath 5 source text, only for Status::Converted
+    sal_uInt16 nBaseHeightPt = 0; ///< the equation's "full" size in points, 0 if not given
+};
+
+/** Converts the complete contents of an OLE "Equation Native" stream (its 28-byte header
+    followed by MTEF data) to StarMath. Never throws; never reads outside [pData, pData+nSize).
+*/
+Result ConvertEquationNative(const sal_uInt8* pData, std::size_t nSize);
+}
