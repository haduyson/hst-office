diff --git a/starmath/source/hst/mtef5fonts.cxx b/starmath/source/hst/mtef5fonts.cxx
new file mode 100644
index 0000000..2d606aa
--- /dev/null
+++ b/starmath/source/hst/mtef5fonts.cxx
@@ -0,0 +1,180 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * Part of HST Office. This file is HST's own work and is not covered by the MPL.
+ */
+
+#include "mtef5fonts.hxx"
+
+#include <hstlegacyvn.hxx>
+
+#include <vector>
+
+namespace hst::mtef
+{
+namespace
+{
+constexpr sal_uInt8 STYLE_BOLD = 0x01;
+constexpr sal_uInt8 STYLE_ITALIC = 0x02;
+constexpr sal_Int16 TYPEFACE_VARIABLE = 3;
+
+/// Windows-1252 byte of a Unicode character; false if it has none.
+bool EncodeCp1252(sal_uInt16 nCode, char& rByte)
+{
+    if (nCode < 0x80 || (nCode >= 0xA0 && nCode <= 0xFF))
+    {
+        rByte = static_cast<char>(nCode);
+        return true;
+    }
+    for (int i = 0; i < 32; ++i)
+    {
+        if (emfio::legacyvn::aCp1252High[i] == nCode)
+        {
+            rByte = static_cast<char>(0x80 + i);
+            return true;
+        }
+    }
+    return false;
+}
+
+void AppendDecoded(emfio::legacyvn::Encoding eEncoding, std::vector<char>& rBytes,
+                   std::u16string& rOut)
+{
+    if (rBytes.empty())
+        return;
+    std::vector<sal_Int32> aUsed;
+    const OUString aText = emfio::legacyvn::Decode(eEncoding, rBytes.data(),
+                                                   static_cast<sal_Int32>(rBytes.size()), aUsed);
+    rOut.append(aText.getStr(), aText.getLength());
+    rBytes.clear();
+}
+}
+
+Role RoleOfTypeface(sal_Int16 nTypeface)
+{
+    if (nTypeface < 0)
+        return Role::Text; // explicit font style
+    switch (nTypeface)
+    {
+        case 1: // text
+        case 9: // user 1
+        case 10: // user 2
+        case 12: // text (East Asian)
+            return Role::Text;
+        case 2:
+            return Role::Function;
+        case 3:
+            return Role::Variable;
+        case 4:
+            return Role::LowerGreek;
+        case 5:
+            return Role::UpperGreek;
+        case 7:
+            return Role::Vector;
+        case 8:
+            return Role::Number;
+        case 23:
+            return Role::Marker;
+        case 24:
+            return Role::Space;
+        default: // 6 symbol, 11 MT Extra, 22 expanding fences, unknown values
+            return Role::Symbol;
+    }
+}
+
+bool FontTables::Lookup(sal_Int16 nTypeface, sal_uInt8& rStyle, const FontDef*& rpFont) const
+{
+    std::size_t nFontDef = 0;
+    if (nTypeface > 0)
+    {
+        const std::size_t nIndex = std::size_t(nTypeface) - 1;
+        if (nIndex >= m_rEquation.aTypefaceStyles.size())
+            return false;
+        const TypefaceStyle& rEntry = m_rEquation.aTypefaceStyles[nIndex];
+        if (rEntry.nFontDef == 0)
+            return false;
+        rStyle = rEntry.nStyle;
+        nFontDef = rEntry.nFontDef;
+    }
+    else if (nTypeface < 0)
+    {
+        const std::size_t nIndex = std::size_t(-nTypeface) - 1;
+        if (nIndex >= m_rEquation.aFontStyles.size())
+            return false;
+        rStyle = m_rEquation.aFontStyles[nIndex].nStyle;
+        nFontDef = m_rEquation.aFontStyles[nIndex].nFontDef;
+    }
+    else
+        return false;
+    rpFont = (nFontDef >= 1 && nFontDef <= m_rEquation.aFonts.size())
+                 ? &m_rEquation.aFonts[nFontDef - 1]
+                 : nullptr;
+    return true;
+}
+
+bool FontTables::IsBold(sal_Int16 nTypeface) const
+{
+    sal_uInt8 nStyle = 0;
+    const FontDef* pFont = nullptr;
+    return Lookup(nTypeface, nStyle, pFont) && (nStyle & STYLE_BOLD);
+}
+
+bool FontTables::IsVariableUpright() const
+{
+    sal_uInt8 nStyle = 0;
+    const FontDef* pFont = nullptr;
+    return Lookup(TYPEFACE_VARIABLE, nStyle, pFont) && !(nStyle & STYLE_ITALIC);
+}
+
+std::u16string FontTables::DecodeRun(const Node* const* ppChars, std::size_t nCount) const
+{
+    using emfio::legacyvn::Encoding;
+    std::u16string aOut;
+    std::vector<char> aBytes; // pending legacy bytes, all in eBytesEncoding
+    Encoding eBytesEncoding = Encoding::None;
+    for (std::size_t i = 0; i < nCount; ++i)
+    {
+        const Node& rChar = *ppChars[i];
+        if (i == 0 || rChar.nTypeface != ppChars[i - 1]->nTypeface)
+        {
+            AppendDecoded(eBytesEncoding, aBytes, aOut);
+            eBytesEncoding = EncodingOf(rChar.nTypeface);
+        }
+        const bool bFontByte = rChar.bHasFontPos && rChar.nFontPos <= 0xFF;
+        if (eBytesEncoding == Encoding::None)
+        {
+            if (rChar.bHasCode)
+                aOut.push_back(static_cast<char16_t>(rChar.nCode));
+            else if (bFontByte)
+                aOut.push_back(emfio::legacyvn::DecodeCp1252(static_cast<unsigned char>(rChar.nFontPos)));
+            continue;
+        }
+        // Legacy font: the byte is the font position, else the Windows-1252 byte of the
+        // character value; a character without such a byte is kept as Unicode.
+        char cByte = 0;
+        if (bFontByte)
+            aBytes.push_back(static_cast<char>(rChar.nFontPos));
+        else if (rChar.bHasCode && EncodeCp1252(rChar.nCode, cByte))
+            aBytes.push_back(cByte);
+        else if (rChar.bHasCode)
+        {
+            AppendDecoded(eBytesEncoding, aBytes, aOut);
+            aOut.push_back(static_cast<char16_t>(rChar.nCode));
+        }
+    }
+    AppendDecoded(eBytesEncoding, aBytes, aOut);
+    return aOut;
+}
+
+emfio::legacyvn::Encoding FontTables::EncodingOf(sal_Int16 nTypeface) const
+{
+    sal_uInt8 nStyle = 0;
+    const FontDef* pFont = nullptr;
+    if (Lookup(nTypeface, nStyle, pFont) && pFont)
+        return emfio::legacyvn::GetEncoding(pFont->aName);
+    return emfio::legacyvn::Encoding::None;
+}
+}
+
