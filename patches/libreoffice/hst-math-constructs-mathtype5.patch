diff --git a/starmath/qa/cppunit/hst_mtef5_fixtures.hxx b/starmath/qa/cppunit/hst_mtef5_fixtures.hxx
new file mode 100644
index 0000000..d2601b1
--- /dev/null
+++ b/starmath/qa/cppunit/hst_mtef5_fixtures.hxx
@@ -0,0 +1,193 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * Part of HST Office. This file is HST's own work and is not covered by the MPL.
+ */
+
+#pragma once
+
+// Hand-built MTEF 5 equations for the tests of HST's MathType reader. They are written
+// record by record from the MTEF 5 layout; no third-party equation data is used.
+
+#include <sal/types.h>
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace hst::mtef::fixtures
+{
+/// Writes an OLE "Equation Native" stream record by record.
+class StreamBuilder
+{
+public:
+    explicit StreamBuilder(sal_uInt8 nVersion = 5)
+    {
+        // 28-byte OLE equation header; only its length field matters to the reader.
+        m_aBytes.assign(28, 0);
+        m_aBytes[0] = 28;
+        Bytes({ nVersion, 1, 0, 7, 0 });
+        for (char c : std::string_view("DSMT7"))
+            Byte(static_cast<sal_uInt8>(c));
+        Bytes({ 0, 0 }); // key terminator, equation options
+    }
+
+    StreamBuilder& Byte(sal_uInt8 n)
+    {
+        m_aBytes.push_back(n);
+        return *this;
+    }
+    StreamBuilder& Bytes(std::initializer_list<sal_uInt8> aList)
+    {
+        m_aBytes.insert(m_aBytes.end(), aList);
+        return *this;
+    }
+    StreamBuilder& Word(sal_uInt16 n) { return Byte(n & 0xFF).Byte(n >> 8); }
+
+    StreamBuilder& Line() { return MarkBody().Bytes({ 1, 0 }); }
+    StreamBuilder& NullLine() { return MarkBody().Bytes({ 1, 0x01 }); }
+    StreamBuilder& End() { return Byte(0); }
+    StreamBuilder& Char(sal_uInt8 nTypeface, sal_uInt16 nCode)
+    {
+        return Bytes({ 2, 0, static_cast<sal_uInt8>(nTypeface + 128) }).Word(nCode);
+    }
+    StreamBuilder& Chars(sal_uInt8 nTypeface, std::u16string_view aText)
+    {
+        for (char16_t c : aText)
+            Char(nTypeface, c);
+        return *this;
+    }
+    StreamBuilder& Template(sal_uInt8 nSelector, sal_uInt8 nVariation)
+    {
+        return Bytes({ 3, 0, nSelector, nVariation, 0 });
+    }
+    StreamBuilder& Pile(sal_uInt8 nHAlign) { return Bytes({ 4, 0, nHAlign, 1 }); }
+    StreamBuilder& Matrix(sal_uInt8 nRows, sal_uInt8 nCols)
+    {
+        Bytes({ 5, 0, 0, 1, 1, nRows, nCols });
+        m_aBytes.insert(m_aBytes.end(), (2 * (nRows + 1) + 7) / 8, 0);
+        m_aBytes.insert(m_aBytes.end(), (2 * (nCols + 1) + 7) / 8, 0);
+        return *this;
+    }
+    StreamBuilder& FontDef(std::string_view aName)
+    {
+        Byte(17).Byte(1);
+        for (char c : aName)
+            Byte(static_cast<sal_uInt8>(c));
+        return Byte(0);
+    }
+
+    const std::vector<sal_uInt8>& Get() const { return m_aBytes; }
+
+    /// Size of the MTEF header: data cut inside it is damaged.
+    static constexpr std::size_t HEADER_SIZE = 28 + 5 + 6 + 1;
+
+    /// Offset of the first line record (the equation body).
+    std::size_t BodyStart() const { return m_nBodyStart ? m_nBodyStart : m_aBytes.size(); }
+
+private:
+    StreamBuilder& MarkBody()
+    {
+        if (!m_nBodyStart)
+            m_nBodyStart = m_aBytes.size();
+        return *this;
+    }
+
+    std::vector<sal_uInt8> m_aBytes;
+    std::size_t m_nBodyStart = 0;
+};
+
+enum class Expect
+{
+    Converted,
+    NotMtef5,
+    Damaged
+};
+
+struct Fixture
+{
+    const char* pName;
+    std::vector<sal_uInt8> aBytes;
+    Expect eExpect;
+    std::u16string_view aStarMath;
+    sal_uInt16 nBaseHeight;
+    std::size_t nBodyStart; ///< offset of the top-level line
+};
+
+constexpr sal_uInt8 TEXT = 1;
+constexpr sal_uInt8 VARIABLE = 3;
+constexpr sal_uInt8 UPPER_GREEK = 5;
+constexpr sal_uInt8 SYMBOL = 6;
+constexpr sal_uInt8 NUMBER = 8;
+
+/// The acceptance fixtures of the behaviour spec. Each ends with its top-level line and the
+/// closing top-level tag.
+inline std::vector<Fixture> AcceptanceFixtures()
+{
+    std::vector<Fixture> aList;
+    auto aAdd = [&aList](const char* pName, const StreamBuilder& rStream, Expect eExpect,
+                         std::u16string_view aStarMath, sal_uInt16 nHeight = 0) {
+        aList.push_back({ pName, rStream.Get(), eExpect, aStarMath, nHeight, rStream.BodyStart() });
+    };
+
+    aAdd("fraction",
+         StreamBuilder().Line().Template(11, 0).Line().Char(VARIABLE, 'x').End()
+             .Line().Char(NUMBER, '2').End().End().End().End(),
+         Expect::Converted, u"{{x} over {2}}");
+    aAdd("leading relation, superscript",
+         StreamBuilder().Line().Char(SYMBOL, '=').Char(VARIABLE, 'x').Template(28, 0).NullLine()
+             .Line().Char(NUMBER, '2').End().End().End().End(),
+         Expect::Converted, u"{} = x rsup {2}");
+    aAdd("pre-scripts",
+         StreamBuilder().Line().Template(29, 1).Line().Char(NUMBER, '6').End()
+             .Line().Chars(NUMBER, u"14").End().End().Char(TEXT, 'C').End().End(),
+         Expect::Converted, u"{\"C\"} lsub {6} lsup {14}");
+    aAdd("arrow with text",
+         StreamBuilder().Line().Template(14, 0).Line().Char(TEXT, 't').End().NullLine().End()
+             .End().End(),
+         Expect::Converted, u"{{\"t\"} xrightarrow {}}");
+    aAdd("harpoon arrow",
+         StreamBuilder().Line().Template(14, 2).NullLine().NullLine().End().End().End(),
+         Expect::Converted, u"{{} xrightleftharpoons {}}");
+    aAdd("arc",
+         StreamBuilder().Line().Template(34, 0).Line().Chars(VARIABLE, u"AB").End().End().End()
+             .End(),
+         Expect::Converted, u"widearc {AB}");
+    aAdd("TCVN3 text and base size",
+         StreamBuilder().FontDef(".VnTime")
+             // preferences: sizes {12 pt}, no spaces, typeface 1 = font 1 upright
+             .Bytes({ 18, 0, 1, 0x21, 0x2F, 0, 1, 1, 0 })
+             .Line().Char(TEXT, 'r').Char(TEXT, 0x00BE).Char(TEXT, 'n').End().End(),
+         Expect::Converted, u"\"rắn\"", 12);
+    aAdd("truncated template", StreamBuilder().Line().Bytes({ 3, 0, 11 }), Expect::Damaged, u"");
+    aAdd("MTEF 3", StreamBuilder(3).Line().Char(VARIABLE, 'x').End().End(), Expect::NotMtef5, u"");
+    aAdd("second script on the same base",
+         StreamBuilder().Line().Char(VARIABLE, 'x').Template(28, 0).NullLine()
+             .Line().Char(NUMBER, '2').End().End()
+             .Template(27, 0).Line().Char(NUMBER, '1').End().NullLine().End().End().End(),
+         Expect::Converted, u"{x rsup {2}} rsub {1}");
+    aAdd("decimal comma",
+         StreamBuilder().Line().Chars(NUMBER, u"4,6").End().End(), Expect::Converted, u"4,6");
+    aAdd("left brace with pile",
+         StreamBuilder().Line().Template(2, 1).Line().Pile(1)
+             .Line().Char(VARIABLE, 'x').Char(SYMBOL, '=').Char(NUMBER, '1').End()
+             .Line().Char(VARIABLE, 'y').Char(SYMBOL, '=').Char(NUMBER, '2').End()
+             .End().End().End().End().End(),
+         Expect::Converted, u"left lbrace {stack{alignl {x = 1} # alignl {y = 2}}} right none");
+    aAdd("matrix in parentheses",
+         StreamBuilder().Line().Template(1, 3).Line().Matrix(2, 2)
+             .Line().Char(NUMBER, '1').End().Line().Char(NUMBER, '2').End()
+             .Line().Char(NUMBER, '3').End().Line().Char(NUMBER, '4').End()
+             .End().End().End().End().End(),
+         Expect::Converted, u"left ( {matrix{{1} # {2} ## {3} # {4}}} right )");
+    aAdd("letters spelling a keyword",
+         StreamBuilder().Line().Chars(VARIABLE, u"in").End().End(), Expect::Converted, u"i n");
+    aAdd("upper-case Greek",
+         StreamBuilder().Line().Char(UPPER_GREEK, 0x0394).Char(VARIABLE, 'x').End().End(),
+         Expect::Converted, u"%DELTA x");
+    return aList;
+}
+}
+
