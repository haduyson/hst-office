new file mode 100644
index 0000000..c24ef4c
--- /dev/null
+++ b/starmath/source/hst/mtef5converter.cxx
@@ -0,0 +1,59 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * Part of HST Office. This file is HST's own work and is not covered by the MPL.
+ */
+
+// Entry point of HST Office's MathType 4-7 (MTEF 5) reader: read the record tree, then
+// write it as StarMath. Any failure leaves the equation to the caller as an OLE object.
+
+#include "mtef5converter.hxx"
+
+#include "mtef5emitter.hxx"
+#include "mtef5reader.hxx"
+
+#include <sal/log.hxx>
+
+#include <exception>
+
+namespace hst::mtef
+{
+Result ConvertEquationNative(const sal_uInt8* pData, std::size_t nSize)
+{
+    Result aResult;
+    try
+    {
+        Equation aEquation;
+        switch (ReadEquationNative(pData, nSize, aEquation))
+        {
+            case ReadStatus::NotMtef5:
+                aResult.eStatus = Status::NotMtef5;
+                return aResult;
+            case ReadStatus::Damaged:
+                aResult.eStatus = Status::Damaged;
+                return aResult;
+            case ReadStatus::Ok:
+                break;
+        }
+        const std::u16string aStarMath = EmitStarMath(aEquation);
+        if (aStarMath.size() > std::size_t(SAL_MAX_INT32))
+        {
+            aResult.eStatus = Status::Damaged;
+            return aResult;
+        }
+        aResult.aStarMath = OUString(aStarMath.data(), static_cast<sal_Int32>(aStarMath.size()));
+        aResult.nBaseHeightPt = aEquation.nBaseHeightPt;
+        aResult.eStatus = Status::Converted;
+    }
+    catch (const std::exception& rException)
+    {
+        SAL_WARN("starmath", "MathType equation not converted: " << rException.what());
+        aResult = Result();
+        aResult.eStatus = Status::Damaged;
+    }
+    return aResult;
+}
+}
+
+/* vim:set shiftwidth=4 softtabstop=4 expandtab: */
