+
+#include <format.hxx>
+#include <node.hxx>
+
+#include <algorithm>
+
+namespace starmath::hst
+{
+bool IsTextArrow(SmTokenType eType)
+{
+    switch (eType)
+    {
+        case TXRIGHTARROW:
+        case TXLEFTARROW:
+        case TXRIGHTLEFTARROWS:
+        case TXRIGHTLEFTHARPOONS:
+            return true;
+        default:
+            return false;
+    }
+}
+
+void ArrangeTextArrow(SmVerticalBraceNode& rNode, OutputDevice& rDev, const SmFormat& rFormat)
+{
+    SmNode* pOver = rNode.Body();
+    SmNode* pArrow = rNode.Brace();
+    SmNode* pUnder = rNode.Script();
+
+    const double fLimitSize = double(rFormat.GetRelSize(SIZ_LIMITS)) / 100;
+    pOver->SetSize(fLimitSize);
+    pUnder->SetSize(fLimitSize);
+    pOver->Arrange(rDev, rFormat);
+    pUnder->Arrange(rDev, rFormat);
+
+    const tools::Long nFontHeight = rNode.GetFont().GetFontSize().Height();
+    const tools::Long nWidth
+        = std::max(std::max(pOver->GetItalicWidth(), pUnder->GetItalicWidth()) + nFontHeight / 2,
+                   nFontHeight * 3 / 2);
+    pArrow->AdaptToX(rDev, nWidth);
+    pArrow->Arrange(rDev, rFormat);
+
+    const tools::Long nDist = nFontHeight * rFormat.GetDistance(DIS_ORNAMENTSIZE) / 100;
+    Point aPos = pOver->AlignTo(*pArrow, RectPos::Top, RectHorAlign::Center, RectVerAlign::Baseline);
+    aPos.AdjustY(-nDist);
+    pOver->MoveTo(aPos);
+    aPos = pUnder->AlignTo(*pArrow, RectPos::Bottom, RectHorAlign::Center, RectVerAlign::Baseline);
+    aPos.AdjustY(nDist);
+    pUnder->MoveTo(aPos);
+
+    SmRect& rRect = rNode;
+    rRect = *pArrow;
+    rRect.ExtendBy(*pOver, RectCopyMBL::This).ExtendBy(*pUnder, RectCopyMBL::This);
+}
+}
