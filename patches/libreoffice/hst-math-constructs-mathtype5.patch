+/// (Word writes the text under a reaction arrow as the limit), empty if e is not such a group
+OUString OmmlTextArrowLimit(bool bLow, std::u16string_view e, std::u16string_view lim);
+
+/// A relation with nothing on its left ("= 105" on a new line) drops the operator in StarMath;
+/// gives it an empty left operand.
+OUString OmmlLeftOperandForLeadingRelations(const OUString& rFormula);
+}
