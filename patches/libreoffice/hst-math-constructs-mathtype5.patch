diff --git a/starmath/qa/cppunit/test_hst_formula_constructs.cxx b/starmath/qa/cppunit/test_hst_formula_constructs.cxx
new file mode 100644
index 0000000..19530ca
--- /dev/null
+++ b/starmath/qa/cppunit/test_hst_formula_constructs.cxx
@@ -0,0 +1,111 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * Part of HST Office. This file is HST's own work and is not covered by the MPL.
+ */
+
+// HST Office formula constructs: the arc over a name and arrows that stretch under/over text
+// (reaction conditions), and the Word formula (OMML) import fixes that go with them.
+
+#include <sal/config.h>
+#include <test/bootstrapfixture.hxx>
+
+#include <document.hxx>
+#include <node.hxx>
+#include <parse5.hxx>
+#include <smdll.hxx>
+#include <visitors.hxx>
+#include "../../source/hst/ommlfixes.hxx"
+
+namespace
+{
+class HstFormulaConstructsTest : public test::BootstrapFixture
+{
+public:
+    void setUp() override
+    {
+        BootstrapFixture::setUp();
+        SmGlobals::ensure();
+    }
+
+    void testTextArrowsParse()
+    {
+        for (const OUString& s : { u"{t} xrightarrow {H_2 SO_4}"_ustr, u"{} xleftarrow {a}"_ustr,
+                                   u"{a} xrightleftarrows {}"_ustr,
+                                   u"{a} xrightleftharpoons {b}"_ustr })
+        {
+            auto pTree = SmParser5().Parse(s);
+            const SmNode* pExpr = pTree->GetSubNode(0)->GetSubNode(0);
+            CPPUNIT_ASSERT_EQUAL_MESSAGE(s.toUtf8().getStr(), SmNodeType::VerticalBrace,
+                                         pExpr->GetType());
+            // the keyword survives a round trip through the formula text
+            OUString aBack;
+            SmNodeToTextVisitor(pTree.get(), aBack);
+            CPPUNIT_ASSERT_MESSAGE(aBack.toUtf8().getStr(),
+                                   aBack.indexOf(pExpr->GetToken().aText) >= 0);
+        }
+    }
+
+    void testArcParse()
+    {
+        auto pTree = SmParser5().Parse(u"widearc {AB}"_ustr);
+        const SmNode* pAttr = pTree->GetSubNode(0)->GetSubNode(0);
+        CPPUNIT_ASSERT_EQUAL(SmNodeType::Attribute, pAttr->GetType());
+        OUString aBack;
+        SmNodeToTextVisitor(pTree.get(), aBack);
+        CPPUNIT_ASSERT(aBack.indexOf("widearc") >= 0);
+    }
+
+    void testTextArrowStretches()
+    {
+        rtl::Reference<SmDocShell> xDocShell = new SmDocShell(
+            SfxModelFlags::EMBEDDED_OBJECT | SfxModelFlags::DISABLE_EMBEDDED_SCRIPTS
+            | SfxModelFlags::DISABLE_DOCUMENT_RECOVERY);
+        xDocShell->SetText(u"{a} xrightarrow {b}"_ustr);
+        const Size aShort = xDocShell->GetSize();
+        xDocShell->SetText(u"{\"H2SO4 đặc, nhiệt độ cao\"} xrightarrow {b}"_ustr);
+        const Size aLong = xDocShell->GetSize();
+        xDocShell->SetText(u"a toward b"_ustr);
+        const Size aPlain = xDocShell->GetSize();
+        // the arrow grows with its text, and the texts stack above and below it
+        CPPUNIT_ASSERT_GREATER(aShort.Width(), aLong.Width());
+        CPPUNIT_ASSERT_GREATER(aPlain.Height(), aShort.Height());
+        xDocShell->DoClose();
+    }
+
+    void testOmmlImportFixes()
+    {
+        using namespace starmath::hst;
+        CPPUNIT_ASSERT(IsOmmlArcAccent(0x2322));
+        CPPUNIT_ASSERT(!IsOmmlArcAccent(0x0302));
+        // arrow under "t" (groupChr pos=bot), then the limLow text under the arrow
+        const OUString aGroup = OmmlTextArrowGroup(0x2192, true, u"t");
+        CPPUNIT_ASSERT_EQUAL(u"{t} xrightarrow { }"_ustr, aGroup);
+        CPPUNIT_ASSERT_EQUAL(u"{t} xrightarrow {x}"_ustr, OmmlTextArrowLimit(true, aGroup, u"x"));
+        CPPUNIT_ASSERT_EQUAL(u"{ } xrightleftharpoons {u}"_ustr,
+                             OmmlTextArrowGroup(0x21CC, false, u"u"));
+        CPPUNIT_ASSERT(OmmlTextArrowGroup(0x23DF, true, u"t").isEmpty());
+        CPPUNIT_ASSERT(OmmlTextArrowLimit(true, u"{t} underbrace { }", u"x").isEmpty());
+        // a relation starting the formula or a new line gets an empty left operand
+        CPPUNIT_ASSERT_EQUAL(u"{} = 105"_ustr, OmmlLeftOperandForLeadingRelations(u"= 105"_ustr));
+        CPPUNIT_ASSERT_EQUAL(u"x = 1 # {} = 2"_ustr,
+                             OmmlLeftOperandForLeadingRelations(u"x = 1 # = 2"_ustr));
+        CPPUNIT_ASSERT_EQUAL(u"\"= 1\""_ustr, OmmlLeftOperandForLeadingRelations(u"\"= 1\""_ustr));
+        // a placeholder is not a relation
+        CPPUNIT_ASSERT_EQUAL(u"{<?>} over {2}"_ustr,
+                             OmmlLeftOperandForLeadingRelations(u"{<?>} over {2}"_ustr));
+    }
+
+    CPPUNIT_TEST_SUITE(HstFormulaConstructsTest);
+    CPPUNIT_TEST(testTextArrowsParse);
+    CPPUNIT_TEST(testArcParse);
+    CPPUNIT_TEST(testTextArrowStretches);
+    CPPUNIT_TEST(testOmmlImportFixes);
+    CPPUNIT_TEST_SUITE_END();
+};
+
+CPPUNIT_TEST_SUITE_REGISTRATION(HstFormulaConstructsTest);
+}
+
