diff --git a/starmath/source/hst/mtef5emitter.cxx b/starmath/source/hst/mtef5emitter.cxx
new file mode 100644
index 0000000..5c87ce9
--- /dev/null
+++ b/starmath/source/hst/mtef5emitter.cxx
@@ -0,0 +1,473 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * Part of HST Office. This file is HST's own work and is not covered by the MPL.
+ */
+
+#include "mtef5emitter.hxx"
+
+#include "mtef5fonts.hxx"
+#include "mtef5linebuilder.hxx"
+#include "mtef5symbols.hxx"
+#include "mtef5templates.hxx"
+
+#include <vector>
+
+namespace hst::mtef
+{
+namespace
+{
+constexpr sal_uInt8 EMBELL_SLASH = 10;
+constexpr sal_uInt8 PILE_ALIGN_LEFT = 1;
+constexpr sal_uInt8 PILE_ALIGN_RIGHT = 3;
+
+using NodeList = std::vector<const Node*>;
+
+std::u16string Braced(const std::u16string& rContent) { return u"{" + rContent + u"}"; }
+
+Token Operand(std::u16string aText) { return { std::move(aText), TokenClass::Operand, Bracket::None }; }
+
+bool IsAsciiName(std::u16string_view aName)
+{
+    if (aName.empty() || !((aName[0] >= u'a' && aName[0] <= u'z') || (aName[0] >= u'A' && aName[0] <= u'Z')))
+        return false;
+    for (sal_Unicode c : aName)
+        if (!((c >= u'a' && c <= u'z') || (c >= u'A' && c <= u'Z') || IsAsciiDigit(c)))
+            return false;
+    return true;
+}
+
+/// Length of the number starting at nStart; in a number run "4,6" and "0.5" stay one number.
+std::size_t NumberLength(const std::u16string& rText, std::size_t nStart, bool bJoinSeparators)
+{
+    std::size_t nEnd = nStart;
+    while (nEnd < rText.size() && IsAsciiDigit(rText[nEnd]))
+        ++nEnd;
+    while (bJoinSeparators && nEnd + 1 < rText.size() && (rText[nEnd] == u',' || rText[nEnd] == u'.')
+           && IsAsciiDigit(rText[nEnd + 1]))
+    {
+        ++nEnd;
+        while (nEnd < rText.size() && IsAsciiDigit(rText[nEnd]))
+            ++nEnd;
+    }
+    return nEnd - nStart;
+}
+
+std::u16string JoinTokens(const std::vector<Token>& rTokens)
+{
+    std::u16string aOut;
+    for (const Token& rToken : rTokens)
+    {
+        if (!aOut.empty())
+            aOut.push_back(u' ');
+        aOut.append(rToken.aText);
+    }
+    return aOut;
+}
+
+bool AllOperands(const std::vector<Token>& rTokens)
+{
+    for (const Token& rToken : rTokens)
+        if (rToken.eClass != TokenClass::Operand)
+            return false;
+    return true;
+}
+
+/// Characters whose roles share a run (variables and lower-case Greek form identifiers).
+Role RunRole(sal_Int16 nTypeface)
+{
+    const Role eRole = RoleOfTypeface(nTypeface);
+    return eRole == Role::LowerGreek ? Role::Variable : eRole;
+}
+
+bool IsPlainChar(const Node& rNode)
+{
+    return rNode.eType == NodeType::Char && rNode.aEmbellishments.empty();
+}
+
+bool IsNumberDigit(const Node& rNode)
+{
+    return IsPlainChar(rNode) && RoleOfTypeface(rNode.nTypeface) == Role::Number && rNode.bHasCode
+           && IsAsciiDigit(rNode.nCode);
+}
+
+bool IsDecimalSeparator(const Node& rNode)
+{
+    return IsPlainChar(rNode) && rNode.bHasCode && (rNode.nCode == u',' || rNode.nCode == u'.');
+}
+
+class Emitter
+{
+public:
+    explicit Emitter(const Equation& rEquation)
+        : m_rEquation(rEquation)
+        , m_aFonts(rEquation)
+        , m_bVariablesUpright(m_aFonts.IsVariableUpright())
+    {
+    }
+
+    std::u16string Whole()
+    {
+        std::u16string aOut;
+        auto aAppend = [&aOut](const std::u16string& rPart) {
+            if (rPart.empty())
+                return;
+            if (!aOut.empty())
+                aOut.push_back(u' ');
+            aOut.append(rPart);
+        };
+        NodeList aLoose; // characters and templates directly in the top-level list
+        for (const Node& rNode : m_rEquation.aTopLevel)
+        {
+            if (rNode.eType == NodeType::Line || rNode.eType == NodeType::Pile)
+            {
+                aAppend(Objects(aLoose));
+                aLoose.clear();
+                aAppend(rNode.eType == NodeType::Line ? LineContent(rNode) : Pile(rNode));
+            }
+            else
+                aLoose.push_back(&rNode);
+        }
+        aAppend(Objects(aLoose));
+        return aOut.empty() ? std::u16string(u"{}") : aOut;
+    }
+
+private:
+    static NodeList Children(const Node& rNode)
+    {
+        NodeList aList;
+        aList.reserve(rNode.aChildren.size());
+        for (const Node& rChild : rNode.aChildren)
+            aList.push_back(&rChild);
+        return aList;
+    }
+
+    std::u16string LineContent(const Node& rLine)
+    {
+        return rLine.bNullLine ? std::u16string() : Objects(Children(rLine));
+    }
+
+    /// Content of a template slot, pile line or matrix cell: a line or a pile.
+    std::u16string SlotContent(const Node& rNode)
+    {
+        return rNode.eType == NodeType::Pile ? Pile(rNode) : LineContent(rNode);
+    }
+
+    std::u16string Objects(const NodeList& rObjects)
+    {
+        LineBuilder aLine;
+        for (std::size_t i = 0; i < rObjects.size();)
+        {
+            const Node& rNode = *rObjects[i];
+            switch (rNode.eType)
+            {
+                case NodeType::Char:
+                {
+                    if (!rNode.aEmbellishments.empty())
+                    {
+                        Embellished(rNode, aLine);
+                        ++i;
+                        break;
+                    }
+                    std::size_t nEnd = i + 1;
+                    while (nEnd < rObjects.size())
+                    {
+                        // A run: same role, no embellishment, no new function name.
+                        if (IsPlainChar(*rObjects[nEnd]) && !rObjects[nEnd]->bFunctionStart
+                            && RunRole(rObjects[nEnd]->nTypeface) == RunRole(rNode.nTypeface))
+                            ++nEnd;
+                        // MathType sets the decimal separator of a number in another
+                        // typeface: "4,6" stays one number.
+                        else if (nEnd + 1 < rObjects.size() && IsNumberDigit(*rObjects[nEnd - 1])
+                                 && IsDecimalSeparator(*rObjects[nEnd])
+                                 && IsNumberDigit(*rObjects[nEnd + 1]))
+                            nEnd += 2;
+                        else
+                            break;
+                    }
+                    for (const Token& rToken : RunTokens(&rObjects[i], nEnd - i))
+                        aLine.Add(rToken);
+                    i = nEnd;
+                    break;
+                }
+                case NodeType::Template:
+                    Template(rNode, aLine);
+                    ++i;
+                    break;
+                case NodeType::Pile:
+                    aLine.Add(Operand(Pile(rNode)));
+                    ++i;
+                    break;
+                case NodeType::Matrix:
+                    aLine.Add(Operand(Matrix(rNode)));
+                    ++i;
+                    break;
+                case NodeType::Line:
+                    aLine.Add(Operand(Braced(LineContent(rNode))));
+                    ++i;
+                    break;
+            }
+        }
+        return aLine.Finish();
+    }
+
+    std::u16string Pile(const Node& rPile)
+    {
+        std::vector<std::u16string> aLines;
+        for (const Node& rChild : rPile.aChildren)
+            if (rChild.eType == NodeType::Line || rChild.eType == NodeType::Pile)
+                aLines.push_back(SlotContent(rChild));
+        if (aLines.empty())
+            return u"{}";
+        if (aLines.size() == 1)
+            return Braced(aLines[0]);
+        std::u16string_view aAlign;
+        if (rPile.nHAlign == PILE_ALIGN_LEFT)
+            aAlign = u"alignl ";
+        else if (rPile.nHAlign == PILE_ALIGN_RIGHT)
+            aAlign = u"alignr ";
+        std::u16string aOut(u"stack{");
+        for (std::size_t i = 0; i < aLines.size(); ++i)
+        {
+            if (i)
+                aOut.append(u" # ");
+            aOut.append(aAlign);
+            aOut.append(Braced(aLines[i]));
+        }
+        aOut.push_back(u'}');
+        return aOut;
+    }
+
+    std::u16string Matrix(const Node& rMatrix)
+    {
+        std::vector<std::u16string> aCells;
+        for (const Node& rChild : rMatrix.aChildren)
+            if (rChild.eType == NodeType::Line || rChild.eType == NodeType::Pile)
+                aCells.push_back(SlotContent(rChild));
+        // The reader checked that the cells fill the matrix exactly.
+        if (rMatrix.nRows == 0 || rMatrix.nCols == 0 || aCells.size() != std::size_t(rMatrix.nRows) * rMatrix.nCols)
+            return u"{}";
+        std::u16string aOut(u"matrix{");
+        for (std::size_t nRow = 0; nRow < rMatrix.nRows; ++nRow)
+        {
+            if (nRow)
+                aOut.append(u" ## ");
+            for (std::size_t nCol = 0; nCol < rMatrix.nCols; ++nCol)
+            {
+                if (nCol)
+                    aOut.append(u" # ");
+                aOut.append(Braced(aCells[nRow * rMatrix.nCols + nCol]));
+            }
+        }
+        aOut.push_back(u'}');
+        return aOut;
+    }
+
+    void Template(const Node& rTemplate, LineBuilder& rLine)
+    {
+        std::vector<std::u16string> aSlots;
+        NodeList aCharacters;
+        for (const Node& rChild : rTemplate.aChildren)
+        {
+            if (rChild.eType == NodeType::Line || rChild.eType == NodeType::Pile)
+                aSlots.push_back(SlotContent(rChild));
+            else if (rChild.eType == NodeType::Char)
+                aCharacters.push_back(&rChild);
+        }
+        TemplateOutput aOutput = RenderTemplate(rTemplate.nSelector, rTemplate.nVariation, aSlots,
+                                                Objects(aCharacters));
+        switch (aOutput.eKind)
+        {
+            case TemplateKind::Piece:
+                rLine.Add(Operand(std::move(aOutput.aText)));
+                break;
+            case TemplateKind::PostScripts:
+                rLine.AddPostScripts(aOutput.aText);
+                break;
+            case TemplateKind::PreScripts:
+                rLine.AddPreScripts(aOutput.aText);
+                break;
+            case TemplateKind::Nothing:
+                break;
+        }
+    }
+
+    void Embellished(const Node& rChar, LineBuilder& rLine)
+    {
+        const Node* pChar = &rChar;
+        const std::vector<Token> aTokens = RunTokens(&pChar, 1);
+        Token aResult;
+        aResult.aText = JoinTokens(aTokens);
+        aResult.eClass = aTokens.size() == 1 ? aTokens[0].eClass : TokenClass::Operand;
+        aResult.eBracket = aTokens.size() == 1 ? aTokens[0].eBracket : Bracket::None;
+        for (sal_uInt8 nKind : rChar.aEmbellishments)
+        {
+            if (nKind == EMBELL_SLASH)
+            {
+                if (aResult.aText == u"=")
+                    aResult.aText = u"<>"; // a slashed equals sign is "not equal"
+                continue;
+            }
+            if (!IsKnownEmbellishment(nKind))
+                continue;
+            if (aResult.eClass != TokenClass::Operand || !AllOperands(aTokens))
+            {
+                // An accent needs an operand: write an operator or bracket as plain text.
+                aResult.aText = QuoteText(m_aFonts.DecodeRun(&pChar, 1));
+                aResult.eClass = TokenClass::Operand;
+                aResult.eBracket = Bracket::None;
+            }
+            aResult.aText = Embellish(std::move(aResult.aText), nKind);
+        }
+        rLine.Add(aResult);
+    }
+
+    /// Tokens for consecutive characters of one typeface.
+    std::vector<Token> RunTokens(const Node* const* ppChars, std::size_t nCount)
+    {
+        const sal_Int16 nTypeface = ppChars[0]->nTypeface;
+        Role eRole = RoleOfTypeface(nTypeface);
+        for (std::size_t i = 0; i < nCount && eRole == Role::LowerGreek; ++i)
+            if (RoleOfTypeface(ppChars[i]->nTypeface) == Role::Variable)
+                eRole = Role::Variable; // Greek letters within variables, as in "μm"
+        const std::u16string aText = m_aFonts.DecodeRun(ppChars, nCount);
+        std::vector<Token> aTokens;
+        switch (eRole)
+        {
+            case Role::Text:
+                TextTokens(aText, aTokens);
+                break;
+            case Role::Function:
+                FunctionTokens(aText, aTokens);
+                break;
+            case Role::Variable:
+            case Role::LowerGreek:
+            case Role::Vector:
+            case Role::UpperGreek:
+            case Role::Number:
+            case Role::Symbol:
+                MathTokens(aText, eRole, aTokens);
+                break;
+            case Role::Space:
+                for (sal_Unicode c : aText)
+                {
+                    Token aToken = SymbolToken(c);
+                    if (aToken.aText == u"`" || aToken.aText == u"~" || aToken.aText == u"~~")
+                        aTokens.push_back(std::move(aToken));
+                }
+                break;
+            case Role::Marker:
+                break;
+        }
+        const bool bBold = eRole == Role::Vector
+                           || (m_aFonts.IsBold(nTypeface) && eRole != Role::Symbol
+                               && eRole != Role::Space && eRole != Role::Marker);
+        if (bBold && !aTokens.empty() && AllOperands(aTokens))
+        {
+            Token aBold = Operand(u"bold {" + JoinTokens(aTokens) + u"}");
+            aTokens.clear();
+            aTokens.push_back(std::move(aBold));
+        }
+        return aTokens;
+    }
+
+    static void TextTokens(const std::u16string& rText, std::vector<Token>& rTokens)
+    {
+        std::u16string aClean;
+        bool bOnlySpaces = true;
+        for (sal_Unicode c : rText)
+        {
+            const sal_Unicode cOut = TextChar(c);
+            if (!cOut)
+                continue;
+            aClean.push_back(cOut);
+            if (cOut != u' ' && cOut != 0xA0)
+                bOnlySpaces = false;
+        }
+        if (aClean.empty())
+            return;
+        if (!bOnlySpaces)
+        {
+            rTokens.push_back(Operand(QuoteText(aClean)));
+            return;
+        }
+        std::u16string aSpaces; // one thin space per space
+        for (std::size_t i = 0; i < aClean.size(); ++i)
+            aSpaces.append(i ? u" `" : u"`");
+        rTokens.push_back(Operand(std::move(aSpaces)));
+    }
+
+    static void FunctionTokens(const std::u16string& rText, std::vector<Token>& rTokens)
+    {
+        std::u16string aName;
+        for (sal_Unicode c : rText)
+            if (const sal_Unicode cOut = TextChar(c))
+                aName.push_back(cOut);
+        if (aName.empty())
+            return;
+        if (IsBareFunctionName(aName))
+            rTokens.push_back(Operand(aName));
+        else if (IsAsciiName(aName))
+            rTokens.push_back(Operand(u"func " + aName));
+        else
+            rTokens.push_back(Operand(QuoteText(aName)));
+    }
+
+    void MathTokens(const std::u16string& rText, Role eRole, std::vector<Token>& rTokens) const
+    {
+        const bool bJoinLetters = eRole == Role::Variable || eRole == Role::LowerGreek || eRole == Role::Vector;
+        const bool bUpright = eRole == Role::Variable && m_bVariablesUpright;
+        for (std::size_t i = 0; i < rText.size();)
+        {
+            const sal_Unicode c = rText[i];
+            if (IsAsciiDigit(c))
+            {
+                const std::size_t nLength = NumberLength(rText, i, eRole == Role::Number);
+                rTokens.push_back(Operand(rText.substr(i, nLength)));
+                i += nLength;
+                continue;
+            }
+            if (eRole == Role::UpperGreek)
+            {
+                const std::u16string_view aName = UpperGreekName(c);
+                if (!aName.empty())
+                {
+                    rTokens.push_back(Operand(std::u16string(aName)));
+                    ++i;
+                    continue;
+                }
+            }
+            if (!IsIdentifierLetter(c) || eRole == Role::Number || eRole == Role::Symbol)
+            {
+                rTokens.push_back(SymbolToken(c));
+                ++i;
+                continue;
+            }
+            std::size_t nEnd = i + 1;
+            while (bJoinLetters && nEnd < rText.size() && IsIdentifierLetter(rText[nEnd]))
+                ++nEnd;
+            const std::u16string aWord = rText.substr(i, nEnd - i);
+            const std::u16string_view aPrefix = bUpright ? u"nitalic " : u"";
+            if (aWord.size() > 1 && IsStarMathKeyword(aWord))
+            {
+                // "in" written as two variables must not become the keyword "in".
+                for (sal_Unicode cLetter : aWord)
+                    rTokens.push_back(Operand(std::u16string(aPrefix) + cLetter));
+            }
+            else
+                rTokens.push_back(Operand(std::u16string(aPrefix) + aWord));
+            i = nEnd;
+        }
+    }
+
+    const Equation& m_rEquation;
+    FontTables m_aFonts;
+    bool m_bVariablesUpright;
+};
+}
+
+std::u16string EmitStarMath(const Equation& rEquation) { return Emitter(rEquation).Whole(); }
+}
+
+/* vim:set shiftwidth=4 softtabstop=4 expandtab: */
