diff --git a/starmath/source/hst/mtef5reader.cxx b/starmath/source/hst/mtef5reader.cxx
new file mode 100644
index 0000000..a4e59ee
--- /dev/null
+++ b/starmath/source/hst/mtef5reader.cxx
@@ -0,0 +1,519 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * Part of HST Office. This file is HST's own work and is not covered by the MPL.
+ */
+
+#include "mtef5reader.hxx"
+
+#include <hstlegacyvn.hxx>
+
+#include <cmath>
+
+namespace hst::mtef
+{
+namespace
+{
+// Record tags of MTEF 5.
+enum : sal_uInt8
+{
+    TAG_END = 0,
+    TAG_LINE = 1,
+    TAG_CHAR = 2,
+    TAG_TMPL = 3,
+    TAG_PILE = 4,
+    TAG_MATRIX = 5,
+    TAG_EMBELL = 6,
+    TAG_RULER = 7,
+    TAG_FONT_STYLE_DEF = 8,
+    TAG_SIZE = 9,
+    TAG_FULL = 10,
+    TAG_SUBSYM = 14,
+    TAG_COLOR = 15,
+    TAG_COLOR_DEF = 16,
+    TAG_FONT_DEF = 17,
+    TAG_EQN_PREFS = 18,
+    TAG_ENCODING_DEF = 19,
+    TAG_FUTURE = 100
+};
+
+// Option bits.
+constexpr sal_uInt8 OPT_NUDGE = 0x08;
+constexpr sal_uInt8 OPT_CHAR_EMBELL = 0x01;
+constexpr sal_uInt8 OPT_CHAR_FUNC_START = 0x02;
+constexpr sal_uInt8 OPT_CHAR_ENC_CHAR_8 = 0x04;
+constexpr sal_uInt8 OPT_CHAR_ENC_CHAR_16 = 0x10;
+constexpr sal_uInt8 OPT_CHAR_ENC_NO_MTCODE = 0x20;
+constexpr sal_uInt8 OPT_LINE_NULL = 0x01;
+constexpr sal_uInt8 OPT_LP_RULER = 0x02;
+constexpr sal_uInt8 OPT_LINE_LSPACE = 0x04;
+constexpr sal_uInt8 OPT_COLOR_CMYK = 0x01;
+constexpr sal_uInt8 OPT_COLOR_NAME = 0x04;
+
+constexpr sal_uInt8 DIM_UNIT_POINT = 2;
+
+/// Bounds-checked little-endian reader over the stream bytes. Every getter returns
+/// false (and leaves the output untouched) when the data ends.
+class Cursor
+{
+public:
+    Cursor(const sal_uInt8* pData, std::size_t nSize)
+        : m_pData(pData)
+        , m_nSize(nSize)
+    {
+    }
+
+    bool AtEnd() const { return m_nPos >= m_nSize; }
+
+    bool Byte(sal_uInt8& rValue)
+    {
+        if (m_nPos >= m_nSize)
+            return false;
+        rValue = m_pData[m_nPos++];
+        return true;
+    }
+
+    bool UInt16(sal_uInt16& rValue)
+    {
+        if (m_nPos > m_nSize || m_nSize - m_nPos < 2)
+            return false;
+        rValue = static_cast<sal_uInt16>(m_pData[m_nPos] | (m_pData[m_nPos + 1] << 8));
+        m_nPos += 2;
+        return true;
+    }
+
+    bool Skip(std::size_t nCount)
+    {
+        if (m_nPos > m_nSize || m_nSize - m_nPos < nCount)
+            return false;
+        m_nPos += nCount;
+        return true;
+    }
+
+    /// One byte; 255 means that the real value follows as 16 bits.
+    bool CompactUnsigned(sal_uInt16& rValue)
+    {
+        sal_uInt8 nByte = 0;
+        if (!Byte(nByte))
+            return false;
+        if (nByte != 255)
+        {
+            rValue = nByte;
+            return true;
+        }
+        return UInt16(rValue);
+    }
+
+    /// Zero-terminated byte string, decoded as Windows-1252 when pOut is given.
+    bool ZeroTerminated(std::u16string* pOut)
+    {
+        for (;;)
+        {
+            sal_uInt8 nByte = 0;
+            if (!Byte(nByte))
+                return false;
+            if (nByte == 0)
+                return true;
+            if (pOut)
+                pOut->push_back(emfio::legacyvn::DecodeCp1252(nByte));
+        }
+    }
+
+    /// Two signed offset bytes; both 128 means two 16-bit offsets follow. Ignored.
+    bool Nudge()
+    {
+        sal_uInt8 nDx = 0;
+        sal_uInt8 nDy = 0;
+        if (!Byte(nDx) || !Byte(nDy))
+            return false;
+        if (nDx == 128 && nDy == 128)
+            return Skip(4);
+        return true;
+    }
+
+    /// Tab-stop list without its tag: a count, then per stop a type byte and a 16-bit offset.
+    bool Ruler()
+    {
+        sal_uInt8 nStops = 0;
+        if (!Byte(nStops))
+            return false;
+        return Skip(std::size_t(nStops) * 3);
+    }
+
+    /** Dimension array of the equation preferences: a count byte, then the dimensions
+        packed in nibbles (high nibble first), padded to a byte boundary. Each dimension is
+        a unit nibble followed by digit nibbles (0-9, 0xA point, 0xB minus) up to 0xF.
+        pFirst receives the first dimension if it is given in points. */
+    bool DimensionArray(double* pFirstPoints)
+    {
+        sal_uInt8 nCount = 0;
+        if (!Byte(nCount))
+            return false;
+        bool bHighNibble = true;
+        sal_uInt8 nCurrent = 0;
+        auto aNextNibble = [&](sal_uInt8& rNibble) {
+            if (bHighNibble)
+            {
+                if (!Byte(nCurrent))
+                    return false;
+                rNibble = nCurrent >> 4;
+            }
+            else
+                rNibble = nCurrent & 0x0F;
+            bHighNibble = !bHighNibble;
+            return true;
+        };
+        for (sal_uInt8 nDim = 0; nDim < nCount; ++nDim)
+        {
+            sal_uInt8 nUnit = 0;
+            if (!aNextNibble(nUnit))
+                return false;
+            double fValue = 0;
+            double fScale = 0; // 0 while in the integer part
+            bool bNegative = false;
+            bool bValid = true;
+            for (;;)
+            {
+                sal_uInt8 nNibble = 0;
+                if (!aNextNibble(nNibble))
+                    return false;
+                if (nNibble == 0x0F)
+                    break;
+                if (nNibble <= 9)
+                {
+                    if (fScale == 0)
+                        fValue = fValue * 10 + nNibble;
+                    else
+                    {
+                        fValue += nNibble * fScale;
+                        fScale /= 10;
+                    }
+                }
+                else if (nNibble == 0x0A && fScale == 0)
+                    fScale = 0.1;
+                else if (nNibble == 0x0B)
+                    bNegative = true;
+                else
+                    bValid = false;
+            }
+            if (nDim == 0 && pFirstPoints && bValid && nUnit == DIM_UNIT_POINT)
+                *pFirstPoints = bNegative ? -fValue : fValue;
+        }
+        return true;
+    }
+
+private:
+    const sal_uInt8* m_pData;
+    std::size_t m_nSize;
+    std::size_t m_nPos = 0;
+};
+
+class Parser
+{
+public:
+    Parser(Cursor& rCursor, Equation& rEquation)
+        : m_rCursor(rCursor)
+        , m_rEquation(rEquation)
+    {
+    }
+
+    /// The top-level list ends with a zero tag or with the data.
+    bool TopLevel()
+    {
+        while (!m_rCursor.AtEnd())
+        {
+            sal_uInt8 nTag = 0;
+            if (!m_rCursor.Byte(nTag))
+                return false;
+            if (nTag == TAG_END)
+                break;
+            if (!Record(nTag, 0, &m_rEquation.aTopLevel, nullptr))
+                return false;
+        }
+        return true;
+    }
+
+private:
+    /// Reads records up to the zero tag that closes the list; the data must not end first.
+    bool List(int nDepth, std::vector<Node>* pNodes, std::vector<sal_uInt8>* pEmbellishments)
+    {
+        if (nDepth > MAX_NESTING)
+            return false;
+        for (;;)
+        {
+            sal_uInt8 nTag = 0;
+            if (!m_rCursor.Byte(nTag))
+                return false;
+            if (nTag == TAG_END)
+                return true;
+            if (!Record(nTag, nDepth, pNodes, pEmbellishments))
+                return false;
+        }
+    }
+
+    /// Structural records go to pNodes (if given), embellishment kinds to pEmbellishments.
+    bool Record(sal_uInt8 nTag, int nDepth, std::vector<Node>* pNodes,
+                std::vector<sal_uInt8>* pEmbellishments)
+    {
+        switch (nTag)
+        {
+            case TAG_LINE:
+            case TAG_CHAR:
+            case TAG_TMPL:
+            case TAG_PILE:
+            case TAG_MATRIX:
+            {
+                Node aNode;
+                if (!Structural(nTag, nDepth, aNode))
+                    return false;
+                if (pNodes)
+                    pNodes->push_back(std::move(aNode));
+                return true;
+            }
+            case TAG_EMBELL:
+            {
+                sal_uInt8 nOptions = 0;
+                sal_uInt8 nKind = 0;
+                if (!m_rCursor.Byte(nOptions))
+                    return false;
+                if ((nOptions & OPT_NUDGE) && !m_rCursor.Nudge())
+                    return false;
+                if (!m_rCursor.Byte(nKind))
+                    return false;
+                if (pEmbellishments)
+                    pEmbellishments->push_back(nKind);
+                return true;
+            }
+            case TAG_RULER:
+                return m_rCursor.Ruler();
+            case TAG_FONT_STYLE_DEF:
+            {
+                FontStyleDef aDef;
+                if (!m_rCursor.CompactUnsigned(aDef.nFontDef) || !m_rCursor.Byte(aDef.nStyle))
+                    return false;
+                m_rEquation.aFontStyles.push_back(aDef);
+                return true;
+            }
+            case TAG_SIZE:
+            {
+                sal_uInt8 nSelect = 0;
+                if (!m_rCursor.Byte(nSelect))
+                    return false;
+                if (nSelect == 101)
+                    return m_rCursor.Skip(2);
+                if (nSelect == 100)
+                    return m_rCursor.Skip(3);
+                return m_rCursor.Skip(1);
+            }
+            case TAG_COLOR:
+            {
+                sal_uInt16 nIndex = 0;
+                return m_rCursor.CompactUnsigned(nIndex);
+            }
+            case TAG_COLOR_DEF:
+            {
+                sal_uInt8 nOptions = 0;
+                if (!m_rCursor.Byte(nOptions))
+                    return false;
+                if (!m_rCursor.Skip((nOptions & OPT_COLOR_CMYK) ? 8 : 6))
+                    return false;
+                return !(nOptions & OPT_COLOR_NAME) || m_rCursor.ZeroTerminated(nullptr);
+            }
+            case TAG_FONT_DEF:
+            {
+                sal_uInt16 nEncoding = 0;
+                FontDef aDef;
+                if (!m_rCursor.CompactUnsigned(nEncoding) || !m_rCursor.ZeroTerminated(&aDef.aName))
+                    return false;
+                m_rEquation.aFonts.push_back(std::move(aDef));
+                return true;
+            }
+            case TAG_EQN_PREFS:
+                return Preferences();
+            case TAG_ENCODING_DEF:
+                return m_rCursor.ZeroTerminated(nullptr);
+            default:
+                break;
+        }
+        if (nTag >= TAG_FULL && nTag <= TAG_SUBSYM)
+            return true; // size shortcuts have no content
+        if (nTag >= TAG_FUTURE)
+        {
+            sal_uInt16 nLength = 0;
+            return m_rCursor.CompactUnsigned(nLength) && m_rCursor.Skip(nLength);
+        }
+        return false; // unknown record type below 100
+    }
+
+    bool Structural(sal_uInt8 nTag, int nDepth, Node& rNode)
+    {
+        sal_uInt8 nOptions = 0;
+        if (!m_rCursor.Byte(nOptions))
+            return false;
+        if ((nOptions & OPT_NUDGE) && !m_rCursor.Nudge())
+            return false;
+        switch (nTag)
+        {
+            case TAG_LINE:
+            {
+                rNode.eType = NodeType::Line;
+                if ((nOptions & OPT_LINE_LSPACE) && !m_rCursor.Skip(2))
+                    return false;
+                if ((nOptions & OPT_LP_RULER) && !m_rCursor.Ruler())
+                    return false;
+                if (nOptions & OPT_LINE_NULL)
+                {
+                    rNode.bNullLine = true;
+                    return true;
+                }
+                return List(nDepth + 1, &rNode.aChildren, nullptr);
+            }
+            case TAG_CHAR:
+            {
+                rNode.eType = NodeType::Char;
+                sal_uInt8 nTypeface = 0;
+                if (!m_rCursor.Byte(nTypeface))
+                    return false;
+                rNode.nTypeface = static_cast<sal_Int16>(nTypeface) - 128;
+                rNode.bFunctionStart = (nOptions & OPT_CHAR_FUNC_START) != 0;
+                if (!(nOptions & OPT_CHAR_ENC_NO_MTCODE))
+                {
+                    if (!m_rCursor.UInt16(rNode.nCode))
+                        return false;
+                    rNode.bHasCode = true;
+                }
+                if (nOptions & OPT_CHAR_ENC_CHAR_8)
+                {
+                    sal_uInt8 nPos = 0;
+                    if (!m_rCursor.Byte(nPos))
+                        return false;
+                    rNode.nFontPos = nPos;
+                    rNode.bHasFontPos = true;
+                }
+                else if (nOptions & OPT_CHAR_ENC_CHAR_16)
+                {
+                    if (!m_rCursor.UInt16(rNode.nFontPos))
+                        return false;
+                    rNode.bHasFontPos = true;
+                }
+                if (nOptions & OPT_CHAR_EMBELL)
+                    return List(nDepth + 1, nullptr, &rNode.aEmbellishments);
+                return true;
+            }
+            case TAG_TMPL:
+            {
+                rNode.eType = NodeType::Template;
+                sal_uInt8 nFirst = 0;
+                sal_uInt8 nTemplateOptions = 0;
+                if (!m_rCursor.Byte(rNode.nSelector) || !m_rCursor.Byte(nFirst))
+                    return false;
+                rNode.nVariation = nFirst;
+                if (nFirst & 0x80)
+                {
+                    sal_uInt8 nSecond = 0;
+                    if (!m_rCursor.Byte(nSecond))
+                        return false;
+                    rNode.nVariation = static_cast<sal_uInt16>((nFirst & 0x7F) | (nSecond << 8));
+                }
+                if (!m_rCursor.Byte(nTemplateOptions))
+                    return false;
+                return List(nDepth + 1, &rNode.aChildren, nullptr);
+            }
+            case TAG_PILE:
+            {
+                rNode.eType = NodeType::Pile;
+                sal_uInt8 nVAlign = 0;
+                if (!m_rCursor.Byte(rNode.nHAlign) || !m_rCursor.Byte(nVAlign))
+                    return false;
+                if ((nOptions & OPT_LP_RULER) && !m_rCursor.Ruler())
+                    return false;
+                return List(nDepth + 1, &rNode.aChildren, nullptr);
+            }
+            case TAG_MATRIX:
+            {
+                rNode.eType = NodeType::Matrix;
+                sal_uInt8 nAlign = 0;
+                if (!m_rCursor.Byte(nAlign) || !m_rCursor.Byte(nAlign) || !m_rCursor.Byte(nAlign)
+                    || !m_rCursor.Byte(rNode.nRows) || !m_rCursor.Byte(rNode.nCols))
+                    return false;
+                // Two bits per partition line (one more line than rows/columns), whole bytes.
+                if (!m_rCursor.Skip((2 * (std::size_t(rNode.nRows) + 1) + 7) / 8)
+                    || !m_rCursor.Skip((2 * (std::size_t(rNode.nCols) + 1) + 7) / 8))
+                    return false;
+                if (!List(nDepth + 1, &rNode.aChildren, nullptr))
+                    return false;
+                // A cell is a line, or a pile standing in for one.
+                std::size_t nCells = 0;
+                for (const Node& rChild : rNode.aChildren)
+                    if (rChild.eType == NodeType::Line || rChild.eType == NodeType::Pile)
+                        ++nCells;
+                return nCells == std::size_t(rNode.nRows) * rNode.nCols;
+            }
+            default:
+                return false;
+        }
+    }
+
+    bool Preferences()
+    {
+        sal_uInt8 nOptions = 0;
+        if (!m_rCursor.Byte(nOptions))
+            return false;
+        double fFullPoints = 0;
+        if (!m_rCursor.DimensionArray(&fFullPoints) || !m_rCursor.DimensionArray(nullptr))
+            return false;
+        sal_uInt8 nStyles = 0;
+        if (!m_rCursor.Byte(nStyles))
+            return false;
+        std::vector<TypefaceStyle> aStyles(nStyles);
+        for (TypefaceStyle& rStyle : aStyles)
+        {
+            if (!m_rCursor.Byte(rStyle.nFontDef))
+                return false;
+            if (rStyle.nFontDef != 0 && !m_rCursor.Byte(rStyle.nStyle))
+                return false;
+        }
+        m_rEquation.aTypefaceStyles = std::move(aStyles);
+        m_rEquation.nBaseHeightPt = (fFullPoints >= 1 && fFullPoints <= 199)
+                                        ? static_cast<sal_uInt16>(std::lround(fFullPoints))
+                                        : 0;
+        return true;
+    }
+
+    Cursor& m_rCursor;
+    Equation& m_rEquation;
+};
+
+}
+
+ReadStatus ReadEquationNative(const sal_uInt8* pData, std::size_t nSize, Equation& rEquation)
+{
+    if (!pData || nSize == 0)
+        return ReadStatus::NotMtef5;
+    if (nSize < 2)
+        return ReadStatus::Damaged;
+    // OLE equation header: its first 16-bit value is its own length.
+    const std::size_t nHeaderLength = pData[0] | (pData[1] << 8);
+    if (nHeaderLength < 2 || nHeaderLength >= nSize)
+        return ReadStatus::Damaged;
+
+    Cursor aCursor(pData + nHeaderLength, nSize - nHeaderLength);
+    sal_uInt8 nVersion = 0;
+    if (!aCursor.Byte(nVersion))
+        return ReadStatus::Damaged;
+    if (nVersion != 5)
+        return ReadStatus::NotMtef5;
+    // platform, product, product version, product subversion, application key, options
+    sal_uInt8 nEquationOptions = 0;
+    if (!aCursor.Skip(4) || !aCursor.ZeroTerminated(nullptr) || !aCursor.Byte(nEquationOptions))
+        return ReadStatus::Damaged;
+
+    Parser aParser(aCursor, rEquation);
+    if (!aParser.TopLevel())
+        return ReadStatus::Damaged;
+    return ReadStatus::Ok;
+}
+}
+
+/* vim:set shiftwidth=4 softtabstop=4 expandtab: */
diff --git a/starmath/source/hst/mtef5reader.hxx b/starmath/source/hst/mtef5reader.hxx
new file mode 100644
index 0000000..e57883b
--- /dev/null
+++ b/starmath/source/hst/mtef5reader.hxx
@@ -0,0 +1,106 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * Part of HST Office. This file is HST's own work and is not covered by the MPL.
+ */
+
+#pragma once
+
+#include <sal/types.h>
+
+#include <cstddef>
+#include <string>
+#include <vector>
+
+// Binary reader for MathType MTEF version 5 data: turns the untrusted bytes of an OLE
+// "Equation Native" stream into a small object tree plus the font and style tables.
+// Every read is bounds-checked; nothing here throws except std::bad_alloc.
+namespace hst::mtef
+{
+/// Maximum nesting of lists (lines, templates, piles, matrices, embellishments).
+constexpr int MAX_NESTING = 200;
+
+enum class NodeType : sal_uInt8
+{
+    Line,
+    Char,
+    Template,
+    Pile,
+    Matrix
+};
+
+/// One structural record of the equation. Which fields matter depends on eType.
+struct Node
+{
+    NodeType eType = NodeType::Line;
+
+    // Line
+    bool bNullLine = false; ///< placeholder line without an object list (empty slot)
+
+    // Char
+    sal_Int16 nTypeface = 0; ///< typeface byte minus 128; negative = font style definition
+    bool bHasCode = false;
+    sal_uInt16 nCode = 0; ///< MTCode (Unicode superset) value
+    bool bHasFontPos = false;
+    sal_uInt16 nFontPos = 0; ///< position of the glyph in its font
+    bool bFunctionStart = false; ///< first character of a function name
+    std::vector<sal_uInt8> aEmbellishments; ///< embellishment kinds in record order
+
+    // Template
+    sal_uInt8 nSelector = 0;
+    sal_uInt16 nVariation = 0;
+
+    // Pile
+    sal_uInt8 nHAlign = 0; ///< 1 left, 2 centre, 3 right, 4 relational, 5 decimal
+
+    // Matrix
+    sal_uInt8 nRows = 0;
+    sal_uInt8 nCols = 0;
+
+    /// Line: its objects. Template: its slots and characters. Pile: its lines.
+    /// Matrix: its cells, row by row.
+    std::vector<Node> aChildren;
+};
+
+struct FontDef
+{
+    std::u16string aName; ///< font family name, decoded as Windows-1252
+};
+
+struct FontStyleDef
+{
+    sal_uInt16 nFontDef = 0; ///< 1-based index into Equation::aFonts
+    sal_uInt8 nStyle = 0; ///< bit 0 bold, bit 1 italic
+};
+
+/// Style table entry of the equation preferences, one per typeface (1-based typeface number).
+struct TypefaceStyle
+{
+    sal_uInt8 nFontDef = 0; ///< 1-based index into Equation::aFonts, 0 = not defined
+    sal_uInt8 nStyle = 0; ///< bit 0 bold, bit 1 italic
+};
+
+struct Equation
+{
+    std::vector<FontDef> aFonts;
+    std::vector<FontStyleDef> aFontStyles;
+    std::vector<TypefaceStyle> aTypefaceStyles;
+    sal_uInt16 nBaseHeightPt = 0;
+    std::vector<Node> aTopLevel; ///< the structural records of the top-level list
+};
+
+enum class ReadStatus
+{
+    Ok,
+    NotMtef5,
+    Damaged
+};
+
+/** Reads an OLE "Equation Native" stream (28-byte OLE header, then MTEF data).
+    Returns NotMtef5 without reading further when the MTEF version is not 5, Damaged
+    when the data is truncated, inconsistent or nested too deeply. */
+ReadStatus ReadEquationNative(const sal_uInt8* pData, std::size_t nSize, Equation& rEquation);
+}
+
