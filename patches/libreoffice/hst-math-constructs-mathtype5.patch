+++ b/starmath/source/hst/mtef5fonts.hxx
@@ -0,0 +1,67 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * Part of HST Office. This file is HST's own work and is not covered by the MPL.
+ */
+
+#pragma once
+
+#include "mtef5reader.hxx"
+
+#include <hstlegacyvn.hxx>
+
+#include <cstddef>
+#include <string>
+
+// Typefaces, fonts and styles of an MTEF 5 equation, and the decoding of characters set in
+// legacy Vietnamese 8-bit fonts (TCVN3 ".Vn..." and VNI "VNI-...").
+namespace hst::mtef
+{
+/// How the characters of a typeface are written in StarMath.
+enum class Role
+{
+    Text, ///< quoted text
+    Function, ///< function name
+    Variable, ///< italic letters joined into identifiers
+    LowerGreek,
+    UpperGreek,
+    Vector, ///< bold variables
+    Number,
+    Symbol, ///< one token per character
+    Space, ///< MathType spacing characters
+    Marker ///< alignment markers, written as nothing
+};
+
+Role RoleOfTypeface(sal_Int16 nTypeface);
+
+class FontTables
+{
+public:
+    explicit FontTables(const Equation& rEquation)
+        : m_rEquation(rEquation)
+    {
+    }
+
+    /// The style table or font style definition makes the typeface bold.
+    bool IsBold(sal_Int16 nTypeface) const;
+
+    /// The style table sets the variable typeface upright (not italic).
+    bool IsVariableUpright() const;
+
+    /** Unicode text of consecutive characters. Characters in a legacy Vietnamese font are
+        collected as bytes and decoded together per typeface, because VNI writes some
+        letters as two bytes. */
+    std::u16string DecodeRun(const Node* const* ppChars, std::size_t nCount) const;
+
+private:
+    emfio::legacyvn::Encoding EncodingOf(sal_Int16 nTypeface) const;
+
+    /// Style bits and font of a typeface; false if the tables do not define it.
+    bool Lookup(sal_Int16 nTypeface, sal_uInt8& rStyle, const FontDef*& rpFont) const;
+
+    const Equation& m_rEquation;
+};
+}
+
