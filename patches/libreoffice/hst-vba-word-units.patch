+// HST: Range.Words / Range.Sentences
+uno::Any SAL_CALL
+SwVbaRange::Words( const uno::Any& rIndex )
+{
+    uno::Reference< XCollection > xCol( new SwVbaTextUnits( this, mxContext, mxTextDocument, SwVbaTextUnits::Unit::Word, getXTextRange() ) );
+    return rIndex.hasValue() ? xCol->Item( rIndex, uno::Any() ) : uno::Any( xCol );
+}
+
+uno::Any SAL_CALL
+SwVbaRange::Sentences( const uno::Any& rIndex )
+{
+    uno::Reference< XCollection > xCol( new SwVbaTextUnits( this, mxContext, mxTextDocument, SwVbaTextUnits::Unit::Sentence, getXTextRange() ) );
+    return rIndex.hasValue() ? xCol->Item( rIndex, uno::Any() ) : uno::Any( xCol );
+}
+
+// HST: Range.Bold / Range.Italic as in Word (True = -1, False = 0)
+::sal_Int32 SAL_CALL
+SwVbaRange::getBold()
+{
+    uno::Reference< beans::XPropertySet > xProps( mxTextCursor, uno::UNO_QUERY_THROW );
+    float fWeight = awt::FontWeight::NORMAL;
+    xProps->getPropertyValue( u"CharWeight"_ustr ) >>= fWeight;
+    return fWeight >= awt::FontWeight::BOLD ? -1 : 0;
+}
+
+void SAL_CALL
+SwVbaRange::setBold( ::sal_Int32 nBold )
+{
+    uno::Reference< beans::XPropertySet > xProps( mxTextCursor, uno::UNO_QUERY_THROW );
+    xProps->setPropertyValue( u"CharWeight"_ustr, uno::Any( nBold != 0 ? awt::FontWeight::BOLD : awt::FontWeight::NORMAL ) );
+}
+
+::sal_Int32 SAL_CALL
+SwVbaRange::getItalic()
+{
+    uno::Reference< beans::XPropertySet > xProps( mxTextCursor, uno::UNO_QUERY_THROW );
+    awt::FontSlant eSlant = awt::FontSlant_NONE;
+    xProps->getPropertyValue( u"CharPosture"_ustr ) >>= eSlant;
+    return eSlant == awt::FontSlant_ITALIC ? -1 : 0;
+}
+
+void SAL_CALL
+SwVbaRange::setItalic( ::sal_Int32 nItalic )
+{
+    uno::Reference< beans::XPropertySet > xProps( mxTextCursor, uno::UNO_QUERY_THROW );
+    xProps->setPropertyValue( u"CharPosture"_ustr, uno::Any( nItalic != 0 ? awt::FontSlant_ITALIC : awt::FontSlant_NONE ) );
+}
