+// HST Office: once per theme and process, drop the rasters an earlier product version cached
+// (vcl/inc/HstIconTheme.hxx). Theme ids never contain a path separator; refuse any that does.
+void purgeStaleThemeCacheOnce(OUString const & rCacheDir, OUString const & rStyle)
+{
+    static std::mutex aMutex;
+    static std::unordered_set<OUString> aCheckedStyles;
+    if (rStyle.isEmpty() || rStyle.indexOf('/') >= 0 || rStyle.indexOf('.') >= 0)
+        return;
+    std::scoped_lock aGuard(aMutex);
+    if (!aCheckedStyles.insert(rStyle).second)
+        return;
+    static const OString aStamp = OString::Concat(HST_RELEASE "+") + OString::number(HST_VERSION_BUILD);
+    if (vcl::hst::purgeStaleIconCache(rCacheDir + rStyle, aStamp))
+        SAL_INFO("vcl", "icon raster cache for " << rStyle << " stamped " << aStamp);
+}
+
 OUString getIconCacheUrl(std::u16string_view sVariant, ImageRequestParameters const & rParameters)
 {
     // the macro expansion can be expensive in bulk, so cache that
     static OUString CACHE_DIR = getIconCacheUrlImpl();
+    purgeStaleThemeCacheOnce(CACHE_DIR, rParameters.msStyle);
     return CACHE_DIR + rParameters.msStyle + "/" + sVariant + "/" + rParameters.msName;
 }
 
