+namespace
+{
+OUString uniqueTempDir()
+{
+    OUString aTemp;
+    CPPUNIT_ASSERT_EQUAL(osl::FileBase::E_None, osl::FileBase::getTempDirURL(aTemp));
+    sal_uInt8 aUuid[16];
+    rtl_createUuid(aUuid, nullptr, false);
+    OUStringBuffer aName(aTemp + "/hst-icon-cache-test-");
+    for (sal_uInt8 n : aUuid)
+        aName.append(static_cast<sal_Int32>(n), 16);
+    return aName.makeStringAndClear();
+}
+
+void writeFile(const OUString& rUrl, std::string_view rData)
+{
+    osl::File aFile(rUrl);
+    CPPUNIT_ASSERT_EQUAL(osl::FileBase::E_None,
+                         aFile.open(osl_File_OpenFlag_Write | osl_File_OpenFlag_Create));
+    sal_uInt64 nWritten = 0;
+    CPPUNIT_ASSERT_EQUAL(osl::FileBase::E_None, aFile.write(rData.data(), rData.size(), nWritten));
+    aFile.close();
+}
+
+std::string readFile(const OUString& rUrl)
+{
+    osl::File aFile(rUrl);
+    if (aFile.open(osl_File_OpenFlag_Read) != osl::FileBase::E_None)
+        return "<missing>";
+    char aBuffer[256];
+    sal_uInt64 nRead = 0;
+    aFile.read(aBuffer, sizeof aBuffer, nRead);
+    aFile.close();
+    return std::string(aBuffer, nRead);
+}
+
+bool exists(const OUString& rUrl)
+{
+    osl::DirectoryItem aItem;
+    return osl::DirectoryItem::get(rUrl, aItem) == osl::FileBase::E_None;
+}
+}
+
+class HstIconThemeTest : public CppUnit::TestFixture
+{
+    void SvgOnlyThemesScaleAtTheSurface();
+    void FallbacksStayOnSvgColibre();
+    void CacheOfAnotherVersionIsPurged();
+
+    CPPUNIT_TEST_SUITE(HstIconThemeTest);
+    CPPUNIT_TEST(SvgOnlyThemesScaleAtTheSurface);
+    CPPUNIT_TEST(FallbacksStayOnSvgColibre);
+    CPPUNIT_TEST(CacheOfAnotherVersionIsPurged);
+    CPPUNIT_TEST_SUITE_END();
+};
+
+void HstIconThemeTest::SvgOnlyThemesScaleAtTheSurface()
+{
+    CPPUNIT_ASSERT(vcl::hst::isSvgIconTheme(u"hst"));
+    CPPUNIT_ASSERT(vcl::hst::isSvgIconTheme(u"hst_dark"));
+    CPPUNIT_ASSERT(vcl::hst::isSvgIconTheme(u"colibre_svg"));
+    CPPUNIT_ASSERT(vcl::hst::isSvgIconTheme(u"colibre_dark_svg"));
+    CPPUNIT_ASSERT(!vcl::hst::isSvgIconTheme(u"colibre"));
+    CPPUNIT_ASSERT(!vcl::hst::isSvgIconTheme(u"colibre_dark"));
+    CPPUNIT_ASSERT(!vcl::hst::isSvgIconTheme(u"hst_svgx"));
+    CPPUNIT_ASSERT(!vcl::hst::isSvgIconTheme(u""));
+}
+
+void HstIconThemeTest::FallbacksStayOnSvgColibre()
+{
+    CPPUNIT_ASSERT_EQUAL(u"colibre_svg"_ustr, vcl::hst::fallbackIconStyle(u"hst"));
+    CPPUNIT_ASSERT_EQUAL(u"colibre_dark_svg"_ustr, vcl::hst::fallbackIconStyle(u"hst_dark"));
+    CPPUNIT_ASSERT_EQUAL(u"colibre_dark"_ustr, vcl::hst::fallbackIconStyle(u"colibre_dark_svg"));
+    // Every other theme keeps the upstream chain (ImplImageTree::fallbackStyle).
+    CPPUNIT_ASSERT(vcl::hst::fallbackIconStyle(u"colibre_svg").isEmpty());
+    CPPUNIT_ASSERT(vcl::hst::fallbackIconStyle(u"colibre").isEmpty());
+    CPPUNIT_ASSERT(vcl::hst::fallbackIconStyle(u"breeze_dark").isEmpty());
+}
+
+void HstIconThemeTest::CacheOfAnotherVersionIsPurged()
+{
+    const OUString aRoot = uniqueTempDir();
+    const OUString aTheme = aRoot + "/hst";
+    const OUString aStamp = aTheme + "/" + vcl::hst::ICON_CACHE_STAMP_FILE;
+    const OUString aRaster = aTheme + "/200/cmd/sc_bold.png";
+    CPPUNIT_ASSERT_EQUAL(osl::FileBase::E_None, osl::Directory::createPath(aTheme + "/200/cmd"));
+
+    // A profile from a version without stamps: its rasters go, and the stamp is written.
+    writeFile(aRaster, "old raster");
+    CPPUNIT_ASSERT(vcl::hst::purgeStaleIconCache(aTheme, "1.0.0+1000"));
+    CPPUNIT_ASSERT(!exists(aRaster));
+    CPPUNIT_ASSERT_EQUAL(std::string("1.0.0+1000"), readFile(aStamp));
+
+    // The same version keeps what it cached.
+    CPPUNIT_ASSERT_EQUAL(osl::FileBase::E_None, osl::Directory::createPath(aTheme + "/200/cmd"));
+    writeFile(aRaster, "current raster");
+    CPPUNIT_ASSERT(!vcl::hst::purgeStaleIconCache(aTheme, "1.0.0+1000"));
+    CPPUNIT_ASSERT_EQUAL(std::string("current raster"), readFile(aRaster));
+
+    // A different version, including a longer one, purges again.
+    CPPUNIT_ASSERT(vcl::hst::purgeStaleIconCache(aTheme, "1.0.1+1010"));
+    CPPUNIT_ASSERT(!exists(aRaster));
+    CPPUNIT_ASSERT_EQUAL(std::string("1.0.1+1010"), readFile(aStamp));
+
+    // A theme directory that does not exist yet is created and stamped.
+    const OUString aOther = aRoot + "/colibre_svg";
+    CPPUNIT_ASSERT(vcl::hst::purgeStaleIconCache(aOther, "1.0.1+1010"));
+    CPPUNIT_ASSERT_EQUAL(std::string("1.0.1+1010"),
+                         readFile(aOther + "/" + vcl::hst::ICON_CACHE_STAMP_FILE));
+
+    // Nothing to stamp: refuse without touching anything.
+    CPPUNIT_ASSERT(!vcl::hst::purgeStaleIconCache(OUString(), "1.0.1+1010"));
+    CPPUNIT_ASSERT(!vcl::hst::purgeStaleIconCache(aTheme, ""));
+    CPPUNIT_ASSERT_EQUAL(std::string("1.0.1+1010"), readFile(aStamp));
+
+    comphelper::DirectoryHelper::deleteDirRecursively(aRoot);
+    CPPUNIT_ASSERT(!exists(aRoot));
+}
+
+CPPUNIT_TEST_SUITE_REGISTRATION(HstIconThemeTest);
