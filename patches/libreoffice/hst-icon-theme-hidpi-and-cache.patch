+// HST Office: icon theme rules shared by ImplImage (HiDPI rasterisation), ImplImageTree
+// (theme fallback and the per-profile raster cache) and their unit test. Header-only, so
+// the test needs no new vcl export.
+
+#pragma once
+
+#include <sal/config.h>
+
+#include <comphelper/DirectoryHelper.hxx>
+#include <o3tl/string_view.hxx>
+#include <osl/file.hxx>
+#include <rtl/ustring.hxx>
+
+#include <string_view>
+
+namespace vcl::hst
+{
+/// The HST themes ship SVG masters only, exactly like the upstream "*_svg" themes. On macOS
+/// such a theme must be rasterised at the backing scale of the surface; a 1x raster would be
+/// stretched into the Retina backing store with a smoothing filter.
+inline bool isSvgIconTheme(std::u16string_view rTheme)
+{
+    return o3tl::ends_with(rTheme, u"_svg") || rTheme == u"hst" || rTheme == u"hst_dark";
+}
+
+/// Fallback for icons a HST theme does not draw: the SVG Colibre, rasterised at the requested
+/// scale, instead of the PNG Colibre that VCL nearest-neighbour doubles at 150/200 %. The dark
+/// SVG Colibre then keeps to the dark PNG set. Empty: the upstream fallback rules apply.
+inline OUString fallbackIconStyle(std::u16string_view rStyle)
+{
+    if (rStyle == u"hst")
+        return u"colibre_svg"_ustr;
+    if (rStyle == u"hst_dark")
+        return u"colibre_dark_svg"_ustr;
+    if (rStyle == u"colibre_dark_svg")
+        return u"colibre_dark"_ustr;
+    return OUString();
+}
+
+/// Name of the stamp file inside each "<UserInstallation>/cache/<theme>" directory.
+inline constexpr OUString ICON_CACHE_STAMP_FILE = u"hst-icon-cache-version"_ustr;
+
+/// VCL keys its disk cache of rasterised icons by theme, scale and name only. After an update
+/// the rasters of the previous product version would keep hiding redrawn icons, so the cache
+/// of one theme is dropped when its stamp differs from rVersionStamp, then stamped again.
+/// rThemeCacheDirUrl is "<cache>/<theme>" as a file URL, without a trailing slash.
+/// Returns true when the directory was purged or created and the new stamp was written.
+inline bool purgeStaleIconCache(const OUString& rThemeCacheDirUrl, std::string_view rVersionStamp)
+{
+    if (rThemeCacheDirUrl.isEmpty() || rVersionStamp.empty())
+        return false;
+    const OUString aStampUrl = rThemeCacheDirUrl + "/" + ICON_CACHE_STAMP_FILE;
+    {
+        osl::File aStamp(aStampUrl);
+        if (aStamp.open(osl_File_OpenFlag_Read) == osl::FileBase::E_None)
+        {
+            char aBuffer[256];
+            sal_uInt64 nRead = 0;
+            const bool bCurrent = aStamp.read(aBuffer, sizeof aBuffer, nRead) == osl::FileBase::E_None
+                                  && std::string_view(aBuffer, nRead) == rVersionStamp;
+            aStamp.close();
+            if (bCurrent)
+                return false;
+        }
+    }
+    if (comphelper::DirectoryHelper::dirExists(rThemeCacheDirUrl))
+        comphelper::DirectoryHelper::deleteDirRecursively(rThemeCacheDirUrl);
+    const osl::FileBase::RC eDir = osl::Directory::createPath(rThemeCacheDirUrl);
+    if (eDir != osl::FileBase::E_None && eDir != osl::FileBase::E_EXIST)
+        return false;
+    osl::File aStamp(aStampUrl);
+    if (aStamp.open(osl_File_OpenFlag_Write | osl_File_OpenFlag_Create) != osl::FileBase::E_None)
+        return false;
+    sal_uInt64 nWritten = 0;
+    const bool bWritten
+        = aStamp.write(rVersionStamp.data(), rVersionStamp.size(), nWritten) == osl::FileBase::E_None
+          && nWritten == rVersionStamp.size();
+    aStamp.close();
+    return bWritten;
+}
+}
