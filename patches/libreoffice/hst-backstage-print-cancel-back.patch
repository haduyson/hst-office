+++ b/sfx2/source/backstage/hstbackstageprintcancel.cxx
@@ -0,0 +1,50 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ * Copyright (c) HASON TECH. HST Office.
+ */
+
+#include "hstbackstageprintcancel.hxx"
+
+#include <backstage/hstbackstage.hrc>
+#include <com/sun/star/document/XUndoManagerSupplier.hpp>
+#include <com/sun/star/frame/XController.hpp>
+#include <comphelper/diagnose_ex.hxx>
+#include <sfx2/sfxresid.hxx>
+
+using namespace css;
+
+namespace sfx2::hst
+{
+sal_Int32 UndoPrintPageMargins(const uno::Reference<frame::XFrame>& rxFrame, sal_Int32 nSteps)
+{
+    if (nSteps <= 0 || !rxFrame.is())
+        return 0;
+    sal_Int32 nUndone = 0;
+    try
+    {
+        const uno::Reference<frame::XController> xController(rxFrame->getController());
+        const uno::Reference<document::XUndoManagerSupplier> xSupplier(
+            xController.is() ? xController->getModel() : nullptr, uno::UNO_QUERY);
+        const uno::Reference<document::XUndoManager> xUndo(
+            xSupplier.is() ? xSupplier->getUndoManager() : nullptr);
+        if (!xUndo.is())
+            return 0;
+        // the title the margins box gives its undo step (ApplyMarginPreset)
+        const OUString aTitle = SfxResId(STR_HST_BS_PRINT_MARGINS);
+        while (nUndone < nSteps && !xUndo->isLocked() && xUndo->isUndoPossible()
+               && xUndo->getCurrentUndoActionTitle() == aTitle)
+        {
+            xUndo->undo();
+            ++nUndone;
+        }
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("sfx.backstage", "the margins of the Print page were not undone");
+    }
+    return nUndone;
+}
+}
+
