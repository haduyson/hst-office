+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ * Copyright (c) HASON TECH. HST Office.
+ */
+
+#pragma once
+
+#include <com/sun/star/frame/XFrame.hpp>
+
+namespace sfx2::hst
+{
+/* HST Office: "Cancel" of the Print page of the File panel.
+
+   The print settings of the page belong to its print job, which is cancelled whenever the page
+   closes, so they are dropped by "Back" (Esc, the back arrow) as well. The only change the page
+   makes outside the job is the margins box: each pick is one undo step of the document. "Cancel"
+   takes those steps back too, so the document is as it was when the page opened.
+
+   Undo the last nSteps margin changes of the page in the frame's document, newest first. Only
+   steps that are the page's own (on top of the undo stack, with its title) are undone; it stops
+   at the first other step. Returns the number undone. */
+sal_Int32 UndoPrintPageMargins(const css::uno::Reference<css::frame::XFrame>& rxFrame,
+                               sal_Int32 nSteps);
+}
