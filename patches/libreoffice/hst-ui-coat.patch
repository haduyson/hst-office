--- a/vcl/source/hst/coat/coat-paint.hxx
+++ b/vcl/source/hst/coat/coat-paint.hxx
@@ -0,0 +1,90 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * This file is part of HST Office.
+ */
+
+#pragma once
+
+#include <basegfx/polygon/b2dpolygon.hxx>
+#include <tools/color.hxx>
+#include <tools/gen.hxx>
+#include <vcl/salnativewidgets.hxx>
+
+class OutputDevice;
+class StyleSettings;
+
+namespace hst::design
+{
+struct Palette;
+}
+
+/* What the painters of the coat share. A painter draws one part of one control in device pixels
+   (the dispatcher has switched the map mode off and saved the device state) and returns false when it
+   leaves the part to the platform. */
+namespace hst::coat
+{
+/** One paint request, in device pixels. */
+struct PaintContext
+{
+    OutputDevice& rDev;
+    const hst::design::Palette& rPalette;
+    const StyleSettings& rStyle;
+    double fScale; ///< the DPI scale: token lengths are multiplied by it
+    ControlState eState;
+    Color aBackground; ///< the control's own background, or COL_AUTO
+    tools::Rectangle aRect; ///< the part's region
+    /** The two buttons of a spin field (SpinbuttonValue), when the request carries them. */
+    tools::Rectangle aUpper{};
+    tools::Rectangle aLower{};
+    ControlState eUpperState = ControlState::NONE;
+    ControlState eLowerState = ControlState::NONE;
+
+    bool IsEnabled() const { return bool(eState & ControlState::ENABLED); }
+    bool IsPressed() const { return bool(eState & ControlState::PRESSED); }
+    bool IsHover() const { return bool(eState & ControlState::ROLLOVER); }
+    bool IsFocused() const { return bool(eState & ControlState::FOCUSED); }
+    double Px(double fLogical) const { return fLogical * fScale; }
+    /** The fill of an input field: the control's own background, else the theme's field colour, so
+        the field's inner window (painted by the control itself) has the same colour. */
+    Color FieldFill() const;
+};
+
+/** Directions of a chevron glyph. */
+enum class Chevron
+{
+    Up,
+    Down,
+    Left,
+    Right,
+};
+
+/** The corner radius of a control of height nHeight: the token radius, but at most a fifth of
+    the height so small controls are not drawn as pills. */
+double ControlRadius(const PaintContext& rCtx, tools::Long nHeight);
+
+/** A rounded rectangle with a border of fBorder pixels drawn inside rRect, so the border never
+    reaches outside the part's region. */
+void FillAndStroke(const PaintContext& rCtx, const tools::Rectangle& rRect, double fRadius,
+                   const Color& rFill, const Color& rBorder, double fBorder);
+
+/** A chevron of the given direction centred in rBox. */
+void DrawChevron(const PaintContext& rCtx, const tools::Rectangle& rBox, Chevron eDirection,
+                 const Color& rColor);
+
+/** An open polyline with round joins and caps, fWidth pixels wide. */
+void StrokePolyLine(const PaintContext& rCtx, const basegfx::B2DPolygon& rLine, const Color& rColor,
+                    double fWidth);
+
+bool PaintPushButton(const PaintContext& rCtx, ControlPart ePart);
+bool PaintCheckBox(const PaintContext& rCtx, ControlPart ePart, ButtonValue eValue);
+bool PaintRadioButton(const PaintContext& rCtx, ControlPart ePart, ButtonValue eValue);
+bool PaintField(const PaintContext& rCtx, ControlType eType, ControlPart ePart);
+bool PaintSpinButtons(const PaintContext& rCtx, ControlPart ePart);
+bool PaintTab(const PaintContext& rCtx, ControlType eType, ControlPart ePart,
+              const ImplControlValue& rValue);
+bool PaintScrollBar(const PaintContext& rCtx, ControlPart ePart);
+}
