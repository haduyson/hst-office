--- a/vcl/source/hst/coat/coat-fields.cxx
+++ b/vcl/source/hst/coat/coat-fields.cxx
@@ -0,0 +1,102 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * This file is part of HST Office.
+ */
+
+/* Input fields (entries, multi-line entries, spin fields), combo and list boxes, their drop-down
+   buttons and the buttons of spin fields. The field's inner window paints its own background in the
+   field colour; the coat fills with the same colour, so only the border and the rounded corners
+   change. */
+
+#include "coat-paint.hxx"
+
+#include <vcl/hst/designtokens.hxx>
+#include <vcl/outdev.hxx>
+
+namespace hst::coat
+{
+namespace
+{
+Color glyphColour(const PaintContext& rCtx, ControlState eState)
+{
+    const auto& p = rCtx.rPalette;
+    if (!(eState & ControlState::ENABLED))
+        return p.aDisabledText;
+    if (eState & ControlState::PRESSED)
+        return p.aAccent;
+    return eState & ControlState::ROLLOVER ? p.aText : p.aMuted;
+}
+
+/** The glyph of a button inside a field: field colour behind, a hover or pressed tint, a chevron. */
+void paintFieldButton(const PaintContext& rCtx, const tools::Rectangle& rBox, ControlState eState,
+                      Chevron eDirection)
+{
+    if (rBox.IsEmpty())
+        return;
+    const auto& p = rCtx.rPalette;
+    Color aFill = rCtx.FieldFill();
+    if (eState & ControlState::ENABLED)
+    {
+        if (eState & ControlState::PRESSED)
+            aFill = p.aPressed;
+        else if (eState & ControlState::ROLLOVER)
+            aFill = p.aHover;
+    }
+    rCtx.rDev.SetLineColor();
+    rCtx.rDev.SetFillColor(aFill);
+    rCtx.rDev.DrawRect(rBox);
+    DrawChevron(rCtx, rBox, eDirection, glyphColour(rCtx, eState));
+}
+}
+
+bool PaintField(const PaintContext& rCtx, ControlType eType, ControlPart ePart)
+{
+    if (ePart == ControlPart::ButtonDown)
+    {
+        if (eType != ControlType::Combobox && eType != ControlType::Listbox)
+            return false;
+        paintFieldButton(rCtx, rCtx.aRect, rCtx.eState, Chevron::Down);
+        return true;
+    }
+    if (ePart != ControlPart::Entire && ePart != ControlPart::ListboxWindow)
+        return false;
+
+    const auto& p = rCtx.rPalette;
+    Color aBorder = p.aFieldBorder;
+    double fBorder = rCtx.Px(hst::design::stroke::Border);
+    if (!rCtx.IsEnabled())
+        aBorder = p.aDisabledBorder;
+    else if (rCtx.IsFocused())
+    {
+        aBorder = p.aAccent;
+        fBorder = rCtx.Px(hst::design::FIELD_FOCUS_BORDER);
+    }
+    else if (rCtx.IsHover())
+        aBorder = p.aMuted;
+    // a list window holds rows up to its border: a small radius keeps the rows' corners inside
+    const double fRadius = ePart == ControlPart::ListboxWindow
+                               ? rCtx.Px(hst::design::radius::Check)
+                               : ControlRadius(rCtx, rCtx.aRect.GetHeight());
+    FillAndStroke(rCtx, rCtx.aRect, fRadius, rCtx.FieldFill(), aBorder, fBorder);
+
+    // a spin field draws its buttons in the same request on some platforms
+    if (eType == ControlType::Spinbox && !rCtx.aUpper.IsEmpty())
+        PaintSpinButtons(rCtx, ControlPart::AllButtons);
+    return true;
+}
+
+bool PaintSpinButtons(const PaintContext& rCtx, ControlPart ePart)
+{
+    if (ePart != ControlPart::AllButtons || rCtx.aUpper.IsEmpty() || rCtx.aLower.IsEmpty())
+        return false;
+    // up and down buttons stacked, or side by side (left: down, right: up)
+    const bool bStacked = rCtx.aUpper.Bottom() <= rCtx.aLower.Top();
+    paintFieldButton(rCtx, rCtx.aUpper, rCtx.eUpperState, bStacked ? Chevron::Up : Chevron::Right);
+    paintFieldButton(rCtx, rCtx.aLower, rCtx.eLowerState, bStacked ? Chevron::Down : Chevron::Left);
+    return true;
+}
+}
+
