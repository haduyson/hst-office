+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * This file is part of HST Office.
+ */
+
+#pragma once
+
+#include <rtl/string.hxx>
+#include <tools/color.hxx>
+#include <tools/gen.hxx>
+#include <vcl/dllapi.h>
+#include <vcl/salnativewidgets.hxx>
+
+class OutputDevice;
+class StyleSettings;
+
+/* The HST "coat": the native controls of every dialog (buttons, fields, check and radio boxes, tabs,
+   scroll bars...) drawn in the HST look from the design tokens of <vcl/hst/designtokens.hxx>.
+
+   Only the drawing changes: a part is drawn by the coat only where the platform already draws it
+   natively, and every size and content region still comes from the platform, so layouts are exactly
+   as without the coat. The coat is off in high-contrast mode and when switched off by the expert
+   setting org.openoffice.Office.HSTAppearance/UiCoat/Enabled or the environment variable
+   HST_UI_COAT=0 (read once per process). */
+namespace hst::coat
+{
+/** Draw a part of a native control in the HST look. rRegion and the rectangles inside rValue are in
+    rDev's logical coordinates, as given to OutputDevice::DrawNativeControl. Returns false when the coat
+    does not draw this part (switched off, high contrast, not covered, or no native look on this
+    platform): the caller then draws it as usual. */
+bool DrawNativeControl(OutputDevice& rDev, ControlType eType, ControlPart ePart,
+                       const tools::Rectangle& rRegion, ControlState eState,
+                       const ImplControlValue& rValue, const Color& rBackground);
+
+/** Whether the coat is switched on (setting and environment), not looking at high contrast. */
+VCL_PLUGIN_PUBLIC bool IsSwitchedOn();
+
+/** Whether the coat applies with these style settings: switched on and not in high-contrast mode. */
+VCL_PLUGIN_PUBLIC bool IsActive(const StyleSettings& rStyle);
+
+/** The GTK CSS of the coat for the welded (GTK-drawn) widgets, from the same tokens. It changes
+    colours, corner radii and focus marks only, never borders' widths, paddings or sizes. */
+VCL_PLUGIN_PUBLIC OString CreateGtkCss(bool bDark);
+
+/** Tests: draw every covered part even where the platform has no native look (the headless backend
+    has none), so the coat's drawing can be checked on a VirtualDevice. */
+VCL_DLLPUBLIC void ForceForTesting(bool bForce);
+
+/** Tests: read the switch (setting and environment) again on its next use. */
+VCL_DLLPUBLIC void ResetSwitchForTesting();
+}
+
