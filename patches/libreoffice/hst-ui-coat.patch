@@ -0,0 +1,100 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * This file is part of HST Office.
+ */
+
+#include "coat-paint.hxx"
+
+#include <basegfx/point/b2dpoint.hxx>
+#include <com/sun/star/drawing/LineCap.hpp>
+#include <vcl/hst/designtokens.hxx>
+#include <vcl/hst/drawhelpers.hxx>
+#include <vcl/outdev.hxx>
+#include <vcl/settings.hxx>
+
+#include <algorithm>
+#include <cmath>
+
+namespace hst::coat
+{
+Color PaintContext::FieldFill() const
+{
+    return aBackground == COL_AUTO ? rStyle.GetFieldColor() : aBackground;
+}
+
+double ControlRadius(const PaintContext& rCtx, tools::Long nHeight)
+{
+    return std::min(rCtx.Px(hst::design::radius::Control), nHeight / 5.0);
+}
+
+void FillAndStroke(const PaintContext& rCtx, const tools::Rectangle& rRect, double fRadius,
+                   const Color& rFill, const Color& rBorder, double fBorder)
+{
+    if (rRect.IsEmpty())
+        return;
+    hst::design::DrawRoundRect(rCtx.rDev, rRect, fRadius, rFill, COL_TRANSPARENT);
+    if (rBorder == COL_TRANSPARENT || fBorder <= 0)
+        return;
+    // whole-pixel rings from the edge inwards: a wide border (the focus border) stays crisp and
+    // inside rRect, where one wide stroke on the pixel centres would blur over three pixels and
+    // reach half a pixel outside
+    const tools::Long nRings = std::max<tools::Long>(1, std::lround(fBorder));
+    tools::Rectangle aPath(rRect);
+    for (tools::Long i = 0; i < nRings && !aPath.IsEmpty(); ++i)
+    {
+        hst::design::DrawRoundRect(rCtx.rDev, aPath, std::max(0.0, fRadius - i), COL_TRANSPARENT,
+                                   rBorder, 1.0);
+        aPath.shrink(1);
+    }
+}
+
+void StrokePolyLine(const PaintContext& rCtx, const basegfx::B2DPolygon& rLine, const Color& rColor,
+                    double fWidth)
+{
+    rCtx.rDev.SetFillColor();
+    rCtx.rDev.SetLineColor(rColor);
+    rCtx.rDev.DrawPolyLine(rLine, fWidth, basegfx::B2DLineJoin::Round,
+                           css::drawing::LineCap_ROUND);
+}
+
+void DrawChevron(const PaintContext& rCtx, const tools::Rectangle& rBox, Chevron eDirection,
+                 const Color& rColor)
+{
+    if (rBox.IsEmpty())
+        return;
+    // a chevron of 8 x 4 logical pixels, smaller when the box is
+    const double fHalf = std::min(rCtx.Px(4), std::min(rBox.GetWidth(), rBox.GetHeight()) / 3.0);
+    const double fDepth = fHalf / 2;
+    const basegfx::B2DPoint aCentre((rBox.Left() + rBox.Right() + 1) / 2.0,
+                                    (rBox.Top() + rBox.Bottom() + 1) / 2.0);
+    basegfx::B2DPolygon aLine;
+    switch (eDirection)
+    {
+        case Chevron::Down:
+            aLine.append({ aCentre.getX() - fHalf, aCentre.getY() - fDepth });
+            aLine.append({ aCentre.getX(), aCentre.getY() + fDepth });
+            aLine.append({ aCentre.getX() + fHalf, aCentre.getY() - fDepth });
+            break;
+        case Chevron::Up:
+            aLine.append({ aCentre.getX() - fHalf, aCentre.getY() + fDepth });
+            aLine.append({ aCentre.getX(), aCentre.getY() - fDepth });
+            aLine.append({ aCentre.getX() + fHalf, aCentre.getY() + fDepth });
+            break;
+        case Chevron::Right:
+            aLine.append({ aCentre.getX() - fDepth, aCentre.getY() - fHalf });
+            aLine.append({ aCentre.getX() + fDepth, aCentre.getY() });
+            aLine.append({ aCentre.getX() - fDepth, aCentre.getY() + fHalf });
+            break;
+        case Chevron::Left:
+            aLine.append({ aCentre.getX() + fDepth, aCentre.getY() - fHalf });
+            aLine.append({ aCentre.getX() - fDepth, aCentre.getY() });
+            aLine.append({ aCentre.getX() + fDepth, aCentre.getY() + fHalf });
+            break;
+    }
+    StrokePolyLine(rCtx, aLine, rColor, rCtx.Px(hst::design::stroke::CheckMark));
+}
+}
