--- a/vcl/source/hst/coat/coat-buttons.cxx
+++ b/vcl/source/hst/coat/coat-buttons.cxx
@@ -0,0 +1,145 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * This file is part of HST Office.
+ */
+
+/* Push buttons, check boxes and radio buttons. The label is drawn by the control itself, in the
+   theme's button text colour, so the fills behind it stay light in a light theme and dark in a
+   dark one: the accent only marks a default button's border, a checked box and a selected radio. */
+
+#include "coat-paint.hxx"
+
+#include <basegfx/point/b2dpoint.hxx>
+#include <basegfx/polygon/b2dpolygontools.hxx>
+#include <vcl/hst/designtokens.hxx>
+#include <vcl/outdev.hxx>
+
+#include <algorithm>
+
+namespace hst::coat
+{
+namespace
+{
+/** The square box of a check or radio mark, centred in the part's region. */
+tools::Rectangle markBox(const tools::Rectangle& rRegion)
+{
+    const tools::Long nSide = std::min(rRegion.GetWidth(), rRegion.GetHeight());
+    const Point aTopLeft(rRegion.Left() + (rRegion.GetWidth() - nSide) / 2,
+                         rRegion.Top() + (rRegion.GetHeight() - nSide) / 2);
+    return tools::Rectangle(aTopLeft, Size(nSide, nSide));
+}
+
+/** Fill and border of a check box or a radio button. */
+void markColours(const PaintContext& rCtx, bool bOn, Color& rFill, Color& rBorder)
+{
+    const auto& p = rCtx.rPalette;
+    if (!rCtx.IsEnabled())
+    {
+        rFill = bOn ? p.aDisabledBorder : p.aDisabledFill;
+        rBorder = p.aDisabledBorder;
+    }
+    else if (bOn)
+    {
+        rFill = rCtx.IsPressed() ? p.aAccentPressed : rCtx.IsHover() ? p.aAccentHover : p.aAccent;
+        rBorder = rFill;
+    }
+    else
+    {
+        rFill = rCtx.IsPressed() ? p.aPressed : rCtx.IsHover() ? p.aHover : rCtx.FieldFill();
+        rBorder = rCtx.IsHover() || rCtx.IsFocused() ? p.aAccent : p.aControlBorder;
+    }
+}
+}
+
+bool PaintPushButton(const PaintContext& rCtx, ControlPart ePart)
+{
+    if (ePart != ControlPart::Entire)
+        return false;
+    const auto& p = rCtx.rPalette;
+    Color aFill = p.aControlFill;
+    Color aBorder = p.aControlBorder;
+    double fBorder = rCtx.Px(hst::design::stroke::Border);
+    if (!rCtx.IsEnabled())
+    {
+        aFill = p.aDisabledFill;
+        aBorder = p.aDisabledBorder;
+    }
+    else
+    {
+        if (rCtx.IsPressed())
+            aFill = p.aPressed;
+        else if (rCtx.IsHover())
+            aFill = p.aHover;
+        if (rCtx.IsFocused())
+        {
+            aBorder = p.aAccent;
+            fBorder = rCtx.Px(hst::design::FIELD_FOCUS_BORDER);
+        }
+        else if (rCtx.eState & ControlState::DEFAULT)
+            aBorder = p.aAccent;
+    }
+    FillAndStroke(rCtx, rCtx.aRect, ControlRadius(rCtx, rCtx.aRect.GetHeight()), aFill, aBorder,
+                  fBorder);
+    return true;
+}
+
+bool PaintCheckBox(const PaintContext& rCtx, ControlPart ePart, ButtonValue eValue)
+{
+    if (ePart != ControlPart::Entire)
+        return false;
+    const tools::Rectangle aBox = markBox(rCtx.aRect);
+    const bool bOn = eValue == ButtonValue::On || eValue == ButtonValue::Mixed;
+    Color aFill, aBorder;
+    markColours(rCtx, bOn, aFill, aBorder);
+    FillAndStroke(rCtx, aBox, rCtx.Px(hst::design::radius::Check), aFill, aBorder,
+                  rCtx.Px(hst::design::stroke::Border));
+    if (!bOn)
+        return true;
+
+    const Color aMark = rCtx.IsEnabled() ? rCtx.rPalette.aOnAccent : rCtx.rPalette.aDisabledText;
+    const double fSide = aBox.GetWidth();
+    const double fX = aBox.Left();
+    const double fY = aBox.Top();
+    basegfx::B2DPolygon aLine;
+    if (eValue == ButtonValue::Mixed)
+    {
+        aLine.append({ fX + fSide * 0.28, fY + fSide * 0.5 });
+        aLine.append({ fX + fSide * 0.72, fY + fSide * 0.5 });
+    }
+    else
+    {
+        aLine.append({ fX + fSide * 0.26, fY + fSide * 0.52 });
+        aLine.append({ fX + fSide * 0.43, fY + fSide * 0.69 });
+        aLine.append({ fX + fSide * 0.75, fY + fSide * 0.34 });
+    }
+    StrokePolyLine(rCtx, aLine, aMark, rCtx.Px(hst::design::stroke::CheckMark));
+    return true;
+}
+
+bool PaintRadioButton(const PaintContext& rCtx, ControlPart ePart, ButtonValue eValue)
+{
+    if (ePart != ControlPart::Entire)
+        return false;
+    const tools::Rectangle aBox = markBox(rCtx.aRect);
+    const bool bOn = eValue == ButtonValue::On;
+    Color aFill, aBorder;
+    markColours(rCtx, bOn, aFill, aBorder);
+    // a circle is a rounded square of half its side
+    FillAndStroke(rCtx, aBox, aBox.GetWidth() / 2.0, aFill, aBorder,
+                  rCtx.Px(hst::design::stroke::Border));
+    if (!bOn)
+        return true;
+
+    const Color aDot = rCtx.IsEnabled() ? rCtx.rPalette.aOnAccent : rCtx.rPalette.aDisabledText;
+    const double fSide = aBox.GetWidth();
+    const basegfx::B2DPoint aCentre(aBox.Left() + fSide / 2, aBox.Top() + fSide / 2);
+    rCtx.rDev.SetLineColor();
+    rCtx.rDev.SetFillColor(aDot);
+    rCtx.rDev.DrawPolygon(basegfx::utils::createPolygonFromCircle(aCentre, fSide * 0.2));
+    return true;
+}
+}
+
