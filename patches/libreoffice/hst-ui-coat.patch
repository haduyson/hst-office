--- a/vcl/source/hst/coat/coat-tabs-scrollbars.cxx
+++ b/vcl/source/hst/coat/coat-tabs-scrollbars.cxx
@@ -0,0 +1,210 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * This file is part of HST Office.
+ */
+
+/* Tab controls and scroll bars.
+   Tabs: the tab row and the pages are one continuous surface in the control's own background colour
+   (a notebook bar's tint included), across the full width: the pages are outlined by a rounded border,
+   a tab is tinted under the mouse, and the selected tab carries an accent bar on the side facing its
+   page. No part fills a colour of its own, so no partial-width band can appear behind the tabs.
+   Scroll bars: a plain track, a pill-shaped thumb narrower than the bar, chevrons for the buttons. */
+
+#include "coat-paint.hxx"
+
+#include <vcl/hst/designtokens.hxx>
+#include <vcl/outdev.hxx>
+#include <vcl/settings.hxx>
+#include <vcl/wall.hxx>
+#include <vcl/window.hxx>
+
+#include <algorithm>
+
+namespace hst::coat
+{
+namespace
+{
+void fillRect(const PaintContext& rCtx, const tools::Rectangle& rRect, const Color& rColor)
+{
+    rCtx.rDev.SetLineColor();
+    rCtx.rDev.SetFillColor(rColor);
+    rCtx.rDev.DrawRect(rRect);
+}
+
+bool plainColour(const Wallpaper& rWallpaper, Color& rColour)
+{
+    if (rWallpaper.IsBitmap() || rWallpaper.IsGradient() || rWallpaper.GetColor() == COL_TRANSPARENT
+        || rWallpaper.GetColor() == COL_AUTO)
+        return false;
+    rColour = rWallpaper.GetColor();
+    return true;
+}
+
+/** The one colour of a tab control's surface: the colour the request carries, else the background
+    of the nearest window that paints one (a tab page is transparent: its tab control's), else the
+    dialog colour. */
+Color surfaceColour(const PaintContext& rCtx)
+{
+    if (rCtx.aBackground != COL_AUTO)
+        return rCtx.aBackground;
+    Color aColour;
+    if (const vcl::Window* pWindow = rCtx.rDev.GetOwnerWindow())
+    {
+        for (; pWindow; pWindow = pWindow->GetParent())
+        {
+            if (!pWindow->IsPaintTransparent() && pWindow->IsBackground()
+                && plainColour(pWindow->GetBackground(), aColour))
+                return aColour;
+        }
+    }
+    else if (rCtx.rDev.IsBackground() && plainColour(rCtx.rDev.GetBackground(), aColour))
+        return aColour;
+    return rCtx.rStyle.GetDialogColor();
+}
+
+/** The accent bar of the selected tab, on the side of rTab facing the page. */
+tools::Rectangle indicatorRect(const PaintContext& rCtx, const tools::Rectangle& rTab,
+                               TabBarPosition ePosition)
+{
+    const tools::Long nThick
+        = std::max<tools::Long>(1, std::lround(rCtx.Px(hst::design::size::TabIndicator)));
+    // the bar is inset from the tab's ends so it reads as a mark, not as a border
+    const tools::Long nInsetX = std::min<tools::Long>(rTab.GetWidth() / 4, std::lround(rCtx.Px(8)));
+    const tools::Long nInsetY = std::min<tools::Long>(rTab.GetHeight() / 4, std::lround(rCtx.Px(6)));
+    switch (ePosition)
+    {
+        case TabBarPosition::Top:
+            return tools::Rectangle(rTab.Left() + nInsetX, rTab.Bottom() - nThick + 1,
+                                    rTab.Right() - nInsetX, rTab.Bottom());
+        case TabBarPosition::Bottom:
+            return tools::Rectangle(rTab.Left() + nInsetX, rTab.Top(), rTab.Right() - nInsetX,
+                                    rTab.Top() + nThick - 1);
+        case TabBarPosition::Left:
+            return tools::Rectangle(rTab.Right() - nThick + 1, rTab.Top() + nInsetY, rTab.Right(),
+                                    rTab.Bottom() - nInsetY);
+        case TabBarPosition::Right:
+            return tools::Rectangle(rTab.Left(), rTab.Top() + nInsetY, rTab.Left() + nThick - 1,
+                                    rTab.Bottom() - nInsetY);
+    }
+    return rTab;
+}
+
+/** The thumb: a pill along the bar, a little narrower than the bar. */
+void paintThumb(const PaintContext& rCtx, bool bHorizontal)
+{
+    const auto& p = rCtx.rPalette;
+    const Color aFill = !rCtx.IsEnabled() ? p.aDisabledBorder
+                        : rCtx.IsPressed() ? p.aScrollThumbPressed
+                        : rCtx.IsHover()   ? p.aScrollThumbHover
+                                           : p.aScrollThumb;
+    fillRect(rCtx, rCtx.aRect, p.aScrollTrack);
+    tools::Rectangle aPill(rCtx.aRect);
+    const tools::Long nAcross = bHorizontal ? aPill.GetHeight() : aPill.GetWidth();
+    const tools::Long nInset = std::min<tools::Long>(nAcross / 4, std::lround(rCtx.Px(3)));
+    if (bHorizontal)
+    {
+        aPill.AdjustTop(nInset);
+        aPill.AdjustBottom(-nInset);
+        aPill.AdjustLeft(1);
+        aPill.AdjustRight(-1);
+    }
+    else
+    {
+        aPill.AdjustLeft(nInset);
+        aPill.AdjustRight(-nInset);
+        aPill.AdjustTop(1);
+        aPill.AdjustBottom(-1);
+    }
+    if (aPill.IsEmpty())
+        return;
+    const double fRadius = std::min(aPill.GetWidth(), aPill.GetHeight()) / 2.0;
+    FillAndStroke(rCtx, aPill, fRadius, aFill, COL_TRANSPARENT, 0);
+}
+}
+
+bool PaintTab(const PaintContext& rCtx, ControlType eType, ControlPart ePart,
+              const ImplControlValue& rValue)
+{
+    if (ePart != ControlPart::Entire)
+        return false;
+    const auto& p = rCtx.rPalette;
+    const Color aSurface = surfaceColour(rCtx);
+    switch (eType)
+    {
+        case ControlType::TabPane:
+            fillRect(rCtx, rCtx.aRect, aSurface);
+            FillAndStroke(rCtx, rCtx.aRect, rCtx.Px(hst::design::radius::Control), aSurface,
+                          p.aCardBorder, rCtx.Px(hst::design::stroke::Border));
+            return true;
+        case ControlType::TabBody:
+        case ControlType::TabHeader:
+            // the full rectangle, whatever part of the control it is
+            fillRect(rCtx, rCtx.aRect, aSurface);
+            return true;
+        case ControlType::TabItem:
+        {
+            // the tab bar is above the pages unless the request says otherwise
+            const TabBarPosition ePosition
+                = rValue.getType() == ControlType::TabItem
+                      ? static_cast<const TabitemValue&>(rValue).meTabBarPosition
+                      : TabBarPosition::Top;
+            const bool bSelected = bool(rCtx.eState & ControlState::SELECTED);
+            fillRect(rCtx, rCtx.aRect, aSurface);
+            if (rCtx.IsEnabled() && !bSelected && rCtx.IsHover())
+                FillAndStroke(rCtx, rCtx.aRect, rCtx.Px(hst::design::radius::Row), p.aHover,
+                              COL_TRANSPARENT, 0);
+            if (bSelected)
+                fillRect(rCtx, indicatorRect(rCtx, rCtx.aRect, ePosition),
+                         rCtx.IsEnabled() ? p.aTabIndicator : p.aDisabledBorder);
+            return true;
+        }
+        default:
+            return false;
+    }
+}
+
+bool PaintScrollBar(const PaintContext& rCtx, ControlPart ePart)
+{
+    const auto& p = rCtx.rPalette;
+    switch (ePart)
+    {
+        case ControlPart::DrawBackgroundHorz:
+        case ControlPart::DrawBackgroundVert:
+        case ControlPart::TrackHorzLeft:
+        case ControlPart::TrackHorzRight:
+        case ControlPart::TrackVertUpper:
+        case ControlPart::TrackVertLower:
+            fillRect(rCtx, rCtx.aRect, p.aScrollTrack);
+            return true;
+        case ControlPart::ThumbHorz:
+            paintThumb(rCtx, true);
+            return true;
+        case ControlPart::ThumbVert:
+            paintThumb(rCtx, false);
+            return true;
+        case ControlPart::ButtonUp:
+        case ControlPart::ButtonDown:
+        case ControlPart::ButtonLeft:
+        case ControlPart::ButtonRight:
+        {
+            fillRect(rCtx, rCtx.aRect, p.aScrollTrack);
+            const Color aGlyph = !rCtx.IsEnabled() ? p.aDisabledText
+                                 : rCtx.IsPressed() ? p.aAccent
+                                 : rCtx.IsHover()   ? p.aText
+                                                    : p.aMuted;
+            const Chevron eDirection = ePart == ControlPart::ButtonUp     ? Chevron::Up
+                                       : ePart == ControlPart::ButtonDown ? Chevron::Down
+                                       : ePart == ControlPart::ButtonLeft ? Chevron::Left
+                                                                          : Chevron::Right;
+            DrawChevron(rCtx, rCtx.aRect, eDirection, aGlyph);
+            return true;
+        }
+        default:
+            return false;
+    }
+}
+}
+
+/* vim:set shiftwidth=4 softtabstop=4 expandtab: */
--- a/vcl/source/hst/coat/coat.cxx
+++ b/vcl/source/hst/coat/coat.cxx
@@ -0,0 +1,195 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * This file is part of HST Office.
+ */
+
+#include <hst/coat.hxx>
+#include "coat-paint.hxx"
+
+#include <officecfg/Office/HSTAppearance.hxx>
+#include <sal/log.hxx>
+#include <vcl/hst/designtokens.hxx>
+#include <vcl/outdev.hxx>
+#include <vcl/rendercontext/AntialiasingFlags.hxx>
+#include <vcl/settings.hxx>
+
+#include <atomic>
+#include <cstdlib>
+#include <string_view>
+
+namespace hst::coat
+{
+namespace
+{
+// 0: not read yet, 1: off, 2: on
+std::atomic<int> g_nSwitch{ 0 };
+std::atomic<bool> g_bForced{ false };
+
+bool readSwitch()
+{
+    if (const char* pEnv = std::getenv("HST_UI_COAT"))
+        return std::string_view(pEnv) != "0";
+    try
+    {
+        return officecfg::Office::HSTAppearance::UiCoat::Enabled::get();
+    }
+    catch (const css::uno::Exception&)
+    {
+        // no configuration (e.g. very early in start-up): the coat's default
+        SAL_WARN("vcl.hst", "coat: the UiCoat/Enabled setting could not be read, using on");
+        return true;
+    }
+}
+
+/** Whether eType/ePart is one of the parts the coat draws. */
+bool isCovered(ControlType eType, ControlPart ePart)
+{
+    switch (eType)
+    {
+        case ControlType::Pushbutton:
+        case ControlType::Checkbox:
+        case ControlType::Radiobutton:
+            return ePart == ControlPart::Entire;
+        case ControlType::Editbox:
+        case ControlType::MultilineEditbox:
+        case ControlType::Spinbox:
+            return ePart == ControlPart::Entire
+                   || (eType == ControlType::Spinbox && ePart == ControlPart::AllButtons);
+        case ControlType::Combobox:
+        case ControlType::Listbox:
+            return ePart == ControlPart::Entire || ePart == ControlPart::ButtonDown
+                   || (eType == ControlType::Listbox && ePart == ControlPart::ListboxWindow);
+        case ControlType::SpinButtons:
+            return ePart == ControlPart::AllButtons;
+        case ControlType::TabItem:
+        case ControlType::TabPane:
+        case ControlType::TabHeader:
+        case ControlType::TabBody:
+            return ePart == ControlPart::Entire;
+        case ControlType::Scrollbar:
+            switch (ePart)
+            {
+                case ControlPart::DrawBackgroundHorz:
+                case ControlPart::DrawBackgroundVert:
+                case ControlPart::ButtonUp:
+                case ControlPart::ButtonDown:
+                case ControlPart::ButtonLeft:
+                case ControlPart::ButtonRight:
+                case ControlPart::ThumbHorz:
+                case ControlPart::ThumbVert:
+                case ControlPart::TrackHorzLeft:
+                case ControlPart::TrackHorzRight:
+                case ControlPart::TrackVertUpper:
+                case ControlPart::TrackVertLower:
+                    return true;
+                default:
+                    return false;
+            }
+        default:
+            return false;
+    }
+}
+
+bool paint(const PaintContext& rCtx, ControlType eType, ControlPart ePart,
+           const ImplControlValue& rValue)
+{
+    switch (eType)
+    {
+        case ControlType::Pushbutton:
+            return PaintPushButton(rCtx, ePart);
+        case ControlType::Checkbox:
+            return PaintCheckBox(rCtx, ePart, rValue.getTristateVal());
+        case ControlType::Radiobutton:
+            return PaintRadioButton(rCtx, ePart, rValue.getTristateVal());
+        case ControlType::Spinbox:
+        case ControlType::SpinButtons:
+            if (ePart == ControlPart::AllButtons)
+                return PaintSpinButtons(rCtx, ePart);
+            return PaintField(rCtx, eType, ePart);
+        case ControlType::Editbox:
+        case ControlType::MultilineEditbox:
+        case ControlType::Combobox:
+        case ControlType::Listbox:
+            return PaintField(rCtx, eType, ePart);
+        case ControlType::TabItem:
+        case ControlType::TabPane:
+        case ControlType::TabHeader:
+        case ControlType::TabBody:
+            return PaintTab(rCtx, eType, ePart, rValue);
+        case ControlType::Scrollbar:
+            return PaintScrollBar(rCtx, ePart);
+        default:
+            return false;
+    }
+}
+}
+
+bool IsSwitchedOn()
+{
+    int nSwitch = g_nSwitch.load(std::memory_order_relaxed);
+    if (nSwitch == 0)
+    {
+        nSwitch = readSwitch() ? 2 : 1;
+        g_nSwitch.store(nSwitch, std::memory_order_relaxed);
+    }
+    return nSwitch == 2;
+}
+
+bool IsActive(const StyleSettings& rStyle)
+{
+    return !rStyle.GetHighContrastMode() && IsSwitchedOn();
+}
+
+void ForceForTesting(bool bForce) { g_bForced.store(bForce, std::memory_order_relaxed); }
+
+void ResetSwitchForTesting() { g_nSwitch.store(0, std::memory_order_relaxed); }
+
+bool DrawNativeControl(OutputDevice& rDev, ControlType eType, ControlPart ePart,
+                       const tools::Rectangle& rRegion, ControlState eState,
+                       const ImplControlValue& rValue, const Color& rBackground)
+{
+    if (!isCovered(eType, ePart) || rRegion.IsEmpty())
+        return false;
+    const StyleSettings& rStyle = rDev.GetSettings().GetStyleSettings();
+    if (!IsActive(rStyle))
+        return false;
+    // only where the platform has a native look: elsewhere VCL's own drawing and metrics stay
+    if (!g_bForced.load(std::memory_order_relaxed) && !rDev.IsNativeControlSupported(eType, ePart))
+        return false;
+
+    PaintContext aCtx{ rDev,
+                       hst::design::GetPalette(rStyle),
+                       rStyle,
+                       std::max(1.0, double(rDev.GetDPIScaleFactor())),
+                       eState,
+                       rBackground,
+                       rDev.LogicToPixel(rRegion) };
+    if (rValue.getType() == ControlType::SpinButtons || rValue.getType() == ControlType::Spinbox)
+    {
+        const auto& rSpin = static_cast<const SpinbuttonValue&>(rValue);
+        aCtx.aUpper = rDev.LogicToPixel(rSpin.maUpperRect);
+        aCtx.aLower = rDev.LogicToPixel(rSpin.maLowerRect);
+        aCtx.eUpperState = rSpin.mnUpperState;
+        aCtx.eLowerState = rSpin.mnLowerState;
+    }
+
+    // Native controls are not recorded in metafiles; neither are the coat's shapes.
+    GDIMetaFile* pMetaFile = rDev.GetConnectMetaFile();
+    rDev.SetConnectMetaFile(nullptr);
+    const AntialiasingFlags eAntialiasing = rDev.GetAntialiasing();
+    rDev.Push(vcl::PushFlags::MAPMODE | vcl::PushFlags::LINECOLOR | vcl::PushFlags::FILLCOLOR);
+    rDev.EnableMapMode(false);
+    rDev.SetAntialiasing(eAntialiasing | AntialiasingFlags::Enable);
+
+    const bool bDrawn = paint(aCtx, eType, ePart, rValue);
+
+    rDev.Pop();
+    rDev.SetAntialiasing(eAntialiasing);
+    rDev.SetConnectMetaFile(pMetaFile);
+    return bDrawn;
+}
+}
+
