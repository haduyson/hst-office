@@ -0,0 +1,77 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * This file is part of HST Office.
+ */
+
+#include "hst-coat-gtk.hxx"
+
+#include <hst/coat.hxx>
+#include <sal/log.hxx>
+#include <vcl/hst/designtokens.hxx>
+#include <vcl/settings.hxx>
+
+namespace hst::coat
+{
+namespace
+{
+enum class Installed
+{
+    None,
+    Light,
+    Dark,
+};
+
+// main thread only (settings updates)
+GtkCssProvider* g_pProvider = nullptr;
+GdkScreen* g_pScreen = nullptr;
+Installed g_eInstalled = Installed::None;
+
+void removeProvider()
+{
+    if (!g_pProvider)
+        return;
+    if (g_pScreen)
+        gtk_style_context_remove_provider_for_screen(g_pScreen, GTK_STYLE_PROVIDER(g_pProvider));
+    g_object_unref(g_pProvider);
+    g_pProvider = nullptr;
+    g_pScreen = nullptr;
+    g_eInstalled = Installed::None;
+}
+}
+
+void ApplyGtkCoat(GdkScreen* pScreen, const StyleSettings& rStyle)
+{
+    if (!pScreen)
+        return;
+    const Installed eWanted = !IsActive(rStyle)                      ? Installed::None
+                              : hst::design::IsDark(rStyle) ? Installed::Dark
+                                                                     : Installed::Light;
+    if (eWanted == g_eInstalled && (eWanted == Installed::None || pScreen == g_pScreen))
+        return;
+    removeProvider();
+    if (eWanted == Installed::None)
+        return;
+
+    const OString aCss = CreateGtkCss(eWanted == Installed::Dark);
+    GtkCssProvider* pProvider = gtk_css_provider_new();
+    GError* pError = nullptr;
+    if (!gtk_css_provider_load_from_data(pProvider, aCss.getStr(), aCss.getLength(), &pError))
+    {
+        SAL_WARN("vcl.hst", "coat: GTK CSS rejected: " << (pError ? pError->message : "?"));
+        if (pError)
+            g_error_free(pError);
+        g_object_unref(pProvider);
+        return;
+    }
+    // above the theme and LibreOffice's own CSS, below the user's gtk.css
+    gtk_style_context_add_provider_for_screen(pScreen, GTK_STYLE_PROVIDER(pProvider),
+                                              GTK_STYLE_PROVIDER_PRIORITY_APPLICATION + 1);
+    g_pProvider = pProvider;
+    g_pScreen = pScreen;
+    g_eInstalled = eWanted;
+}
+}
