--- a/vcl/source/hst/coat/coat-gtk-css.cxx
+++ b/vcl/source/hst/coat/coat-gtk-css.cxx
@@ -0,0 +1,124 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * This file is part of HST Office.
+ */
+
+/* The coat for GTK-drawn dialogs: the same tokens as the VCL painters, written as GTK 3 CSS.
+   Only colours, corner radii and focus marks are set. Border widths, paddings, margins and minimum
+   sizes stay the theme's, so no widget changes size. A focused field gets its second border pixel
+   from an inset shadow, which takes no space. */
+
+#include <hst/coat.hxx>
+
+#include <rtl/ustrbuf.hxx>
+#include <vcl/hst/designtokens.hxx>
+
+#include <cmath>
+
+namespace hst::coat
+{
+namespace
+{
+OUString hex(const Color& rColor) { return u"#" + rColor.AsRGBHexString(); }
+
+OUString px(double fLength) { return OUString::number(std::lround(fLength)) + u"px"; }
+}
+
+OString CreateGtkCss(bool bDark)
+{
+    const hst::design::Palette& p = hst::design::GetPalette(bDark);
+    namespace d = hst::design;
+    const OUString aRadius = px(d::radius::Control / 2); // GTK's controls are small; see ControlRadius
+    const OUString aBorder = px(d::stroke::Border);
+
+    OUStringBuffer aCss(4096);
+    // push buttons, combo box buttons, spin buttons
+    aCss.append(u"button { background-image: none; background-color: " + hex(p.aControlFill)
+                + u"; border-color: " + hex(p.aControlBorder) + u"; border-radius: " + aRadius
+                + u"; box-shadow: none; text-shadow: none; }\n"
+                  u"button:hover { background-color: "
+                + hex(p.aHover) + u"; }\n"
+                  u"button:active, button:checked { background-color: "
+                + hex(p.aPressed) + u"; }\n"
+                  u"button:disabled { background-color: "
+                + hex(p.aDisabledFill) + u"; border-color: " + hex(p.aDisabledBorder)
+                + u"; color: " + hex(p.aDisabledText) + u"; }\n"
+                  u"button.default { border-color: "
+                + hex(p.aAccent) + u"; }\n"
+                  u"button:focus { border-color: "
+                + hex(p.aAccent) + u"; box-shadow: inset 0 0 0 " + aBorder + u" "
+                + hex(p.aAccent) + u"; }\n");
+    // flat buttons (toolbars, the buttons inside entries) keep no frame until hovered
+    aCss.append(u"button.flat { background-color: transparent; border-color: transparent; }\n"
+                u"button.flat:hover { background-color: "
+                + hex(p.aHover) + u"; }\n");
+    // entries, spin buttons and the entry of combo boxes
+    aCss.append(u"entry, spinbutton:not(.vertical), textview.view { border-color: "
+                + hex(p.aFieldBorder) + u"; border-radius: " + aRadius
+                + u"; background-image: none; box-shadow: none; }\n"
+                  u"entry:hover, spinbutton:not(.vertical):hover { border-color: "
+                + hex(p.aMuted) + u"; }\n"
+                  u"entry:focus, spinbutton:not(.vertical):focus { border-color: "
+                + hex(p.aAccent) + u"; box-shadow: inset 0 0 0 " + aBorder + u" "
+                + hex(p.aAccent) + u"; outline: none; }\n"
+                  u"entry:disabled, spinbutton:disabled { border-color: "
+                + hex(p.aDisabledBorder) + u"; color: " + hex(p.aDisabledText) + u"; }\n"
+                  u"spinbutton button, combobox entry + button { background-color: "
+                  u"transparent; border-color: transparent; }\n");
+    // check boxes and radio buttons
+    aCss.append(u"check, radio { background-image: none; background-color: "
+                + hex(p.aFieldFill) + u"; border-color: " + hex(p.aControlBorder)
+                + u"; color: " + hex(p.aOnAccent) + u"; box-shadow: none; }\n"
+                  u"check { border-radius: "
+                + px(d::radius::Check) + u"; }\n"
+                  u"check:hover, radio:hover { border-color: "
+                + hex(p.aAccent) + u"; }\n"
+                  u"check:checked, check:indeterminate, radio:checked { background-color: "
+                + hex(p.aAccent) + u"; border-color: " + hex(p.aAccent) + u"; }\n"
+                  u"check:checked:hover, check:indeterminate:hover, radio:checked:hover { "
+                  u"background-color: "
+                + hex(p.aAccentHover) + u"; }\n"
+                  u"check:disabled, radio:disabled { background-color: "
+                + hex(p.aDisabledFill) + u"; border-color: " + hex(p.aDisabledBorder)
+                + u"; color: " + hex(p.aDisabledText) + u"; }\n");
+    // notebooks: the page on a card, the selected tab marked by an accent bar
+    aCss.append(u"notebook > stack:not(:only-child) { background-color: " + hex(p.aCard)
+                + u"; }\n"
+                  u"notebook.frame { border-color: "
+                + hex(p.aCardBorder) + u"; border-radius: " + px(d::radius::Control)
+                + u"; }\n"
+                  u"notebook > header { background-color: transparent; border-color: "
+                + hex(p.aCardBorder) + u"; }\n"
+                  u"notebook > header tab { background-color: transparent; box-shadow: none; "
+                  u"border-color: transparent; }\n"
+                  u"notebook > header tab:hover { background-color: "
+                + hex(p.aHover) + u"; }\n"
+                  u"notebook > header.top tab:checked { box-shadow: inset 0 -"
+                + px(d::size::TabIndicator) + u" " + hex(p.aTabIndicator)
+                + u"; }\n"
+                  u"notebook > header.bottom tab:checked { box-shadow: inset 0 "
+                + px(d::size::TabIndicator) + u" " + hex(p.aTabIndicator)
+                + u"; }\n"
+                  u"notebook > header.left tab:checked { box-shadow: inset -"
+                + px(d::size::TabIndicator) + u" 0 " + hex(p.aTabIndicator)
+                + u"; }\n"
+                  u"notebook > header.right tab:checked { box-shadow: inset "
+                + px(d::size::TabIndicator) + u" 0 " + hex(p.aTabIndicator) + u"; }\n");
+    // scroll bars: a plain track, a pill thumb
+    aCss.append(u"scrollbar, scrollbar trough { background-color: " + hex(p.aScrollTrack)
+                + u"; background-image: none; }\n"
+                  u"scrollbar slider { background-color: "
+                + hex(p.aScrollThumb)
+                + u"; border-radius: 999px; }\n"
+                  u"scrollbar slider:hover { background-color: "
+                + hex(p.aScrollThumbHover)
+                + u"; }\n"
+                  u"scrollbar slider:active { background-color: "
+                + hex(p.aScrollThumbPressed) + u"; }\n");
+    return OUStringToOString(aCss, RTL_TEXTENCODING_UTF8);
+}
+}
+
