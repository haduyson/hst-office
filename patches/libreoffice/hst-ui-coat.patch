@@ -0,0 +1,387 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * SPDX-License-Identifier: LicenseRef-HST-Proprietary
+ *
+ * This file is part of HST Office.
+ */
+
+#include <test/bootstrapfixture.hxx>
+
+#include <comphelper/configuration.hxx>
+#include <officecfg/Office/HSTAppearance.hxx>
+#include <vcl/hst/designtokens.hxx>
+#include <vcl/salnativewidgets.hxx>
+#include <vcl/settings.hxx>
+#include <vcl/svapp.hxx>
+#include <vcl/virdev.hxx>
+
+#include <hst/coat.hxx>
+
+#include <cstdlib>
+
+namespace
+{
+// a colour the coat never paints: what is left of it was not painted
+constexpr Color MARKER(0xFF, 0x00, 0xFF);
+// a tab control's own background, e.g. a notebook bar's tint
+constexpr Color SURFACE(0xE4, 0xEE, 0xF8);
+
+/* The coat drawn on a VirtualDevice of the headless backend, which has no native look of its own:
+   ForceForTesting makes the coat draw there, so its shapes and colours can be probed pixel by
+   pixel. */
+class CoatTest : public test::BootstrapFixture
+{
+public:
+    CoatTest()
+        : test::BootstrapFixture(true, false)
+    {
+    }
+
+    void setUp() override
+    {
+        test::BootstrapFixture::setUp();
+        unsetenv("HST_UI_COAT");
+        setSwitch(true);
+        hst::coat::ForceForTesting(true);
+    }
+
+    void tearDown() override
+    {
+        hst::coat::ForceForTesting(false);
+        setSwitch(true);
+        test::BootstrapFixture::tearDown();
+    }
+
+protected:
+    static void setSwitch(bool bOn)
+    {
+        auto xChanges = comphelper::ConfigurationChanges::create();
+        officecfg::Office::HSTAppearance::UiCoat::Enabled::set(bOn, xChanges);
+        xChanges->commit();
+        hst::coat::ResetSwitchForTesting();
+    }
+
+    static ScopedVclPtr<VirtualDevice> makeDevice(const Size& rSize, bool bDark = false,
+                                                  bool bHighContrast = false)
+    {
+        ScopedVclPtr<VirtualDevice> pDev = VclPtr<VirtualDevice>::Create();
+        AllSettings aSettings = pDev->GetSettings();
+        StyleSettings aStyle = aSettings.GetStyleSettings();
+        aStyle.SetHighContrastMode(bHighContrast);
+        if (bDark)
+        {
+            aStyle.SetWindowColor(Color(0x20, 0x20, 0x20));
+            aStyle.SetFieldColor(Color(0x2A, 0x2A, 0x2A));
+            aStyle.SetDialogColor(Color(0x28, 0x28, 0x28));
+        }
+        else
+        {
+            aStyle.SetWindowColor(COL_WHITE);
+            aStyle.SetFieldColor(COL_WHITE);
+            aStyle.SetDialogColor(Color(0xF0, 0xF0, 0xF0));
+        }
+        aSettings.SetStyleSettings(aStyle);
+        pDev->SetSettings(aSettings);
+        pDev->SetOutputSizePixel(rSize);
+        pDev->SetBackground(Wallpaper(MARKER));
+        pDev->Erase();
+        return pDev;
+    }
+
+    static const hst::design::Palette& light() { return hst::design::GetPalette(false); }
+
+    static bool draw(VirtualDevice& rDev, ControlType eType, ControlPart ePart,
+                     ControlState eState, const ImplControlValue& rValue = ImplControlValue())
+    {
+        return rDev.DrawNativeControl(eType, ePart,
+                                      tools::Rectangle(Point(), rDev.GetOutputSizePixel()),
+                                      eState, rValue, OUString());
+    }
+
+    /** rExpected at (nX, nY), give or take the rounding of the anti-aliasing backend. */
+    static void assertPixel(const char* pWhat, const VirtualDevice& rDev, tools::Long nX,
+                            tools::Long nY, const Color& rExpected)
+    {
+        const Color aActual = rDev.GetPixel(Point(nX, nY));
+        const bool bClose = std::abs(aActual.GetRed() - rExpected.GetRed()) <= 2
+                            && std::abs(aActual.GetGreen() - rExpected.GetGreen()) <= 2
+                            && std::abs(aActual.GetBlue() - rExpected.GetBlue()) <= 2;
+        CPPUNIT_ASSERT_MESSAGE(OString(OString::Concat(pWhat) + ": expected "
+                                       + rExpected.AsRGBHexString().toUtf8() + " at "
+                                       + OString::number(nX) + "," + OString::number(nY)
+                                       + ", got " + aActual.AsRGBHexString().toUtf8())
+                                   .getStr(),
+                               bClose);
+    }
+
+    static constexpr ControlState ENABLED = ControlState::ENABLED;
+};
+
+CPPUNIT_TEST_FIXTURE(CoatTest, testPushButtonRoundedAndTokenColours)
+{
+    ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(80, 30));
+    CPPUNIT_ASSERT(draw(*pDev, ControlType::Pushbutton, ControlPart::Entire, ENABLED));
+    assertPixel("rounded corner left unpainted", *pDev, 0, 0, MARKER);
+    assertPixel("border", *pDev, 0, 15, light().aControlBorder);
+    assertPixel("fill", *pDev, 40, 15, light().aControlFill);
+}
+
+CPPUNIT_TEST_FIXTURE(CoatTest, testPushButtonStates)
+{
+    const auto& p = light();
+    {
+        ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(80, 30));
+        draw(*pDev, ControlType::Pushbutton, ControlPart::Entire, ENABLED | ControlState::ROLLOVER);
+        assertPixel("hover fill", *pDev, 40, 15, p.aHover);
+    }
+    {
+        ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(80, 30));
+        draw(*pDev, ControlType::Pushbutton, ControlPart::Entire, ENABLED | ControlState::PRESSED);
+        assertPixel("pressed fill", *pDev, 40, 15, p.aPressed);
+    }
+    {
+        ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(80, 30));
+        draw(*pDev, ControlType::Pushbutton, ControlPart::Entire, ControlState::NONE);
+        assertPixel("disabled fill", *pDev, 40, 15, p.aDisabledFill);
+        assertPixel("disabled border", *pDev, 0, 15, p.aDisabledBorder);
+    }
+    {
+        ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(80, 30));
+        draw(*pDev, ControlType::Pushbutton, ControlPart::Entire, ENABLED | ControlState::FOCUSED);
+        assertPixel("focus border, outer pixel", *pDev, 0, 15, p.aAccent);
+        assertPixel("focus border, inner pixel", *pDev, 1, 15, p.aAccent);
+        assertPixel("focused fill", *pDev, 40, 15, p.aControlFill);
+    }
+    {
+        ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(80, 30));
+        draw(*pDev, ControlType::Pushbutton, ControlPart::Entire, ENABLED | ControlState::DEFAULT);
+        assertPixel("default button border", *pDev, 0, 15, p.aAccent);
+        assertPixel("default button: one pixel", *pDev, 1, 15, p.aControlFill);
+    }
+}
+
+CPPUNIT_TEST_FIXTURE(CoatTest, testDarkPalette)
+{
+    ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(80, 30), true);
+    draw(*pDev, ControlType::Pushbutton, ControlPart::Entire, ENABLED);
+    assertPixel("dark fill", *pDev, 40, 15, hst::design::GetPalette(true).aControlFill);
+}
+
+CPPUNIT_TEST_FIXTURE(CoatTest, testFieldsKeepTheFieldColour)
+{
+    for (ControlType eType : { ControlType::Editbox, ControlType::Combobox, ControlType::Listbox })
+    {
+        ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(120, 26));
+        CPPUNIT_ASSERT(draw(*pDev, eType, ControlPart::Entire, ENABLED));
+        assertPixel("field corner", *pDev, 0, 0, MARKER);
+        assertPixel("field border", *pDev, 0, 13, light().aFieldBorder);
+        assertPixel("field fill is the theme's field colour", *pDev, 60, 13, COL_WHITE);
+    }
+    ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(120, 26));
+    draw(*pDev, ControlType::Editbox, ControlPart::Entire, ENABLED | ControlState::FOCUSED);
+    assertPixel("focused field, outer pixel", *pDev, 0, 13, light().aAccent);
+    assertPixel("focused field, inner pixel", *pDev, 1, 13, light().aAccent);
+    assertPixel("focused field, inside", *pDev, 2, 13, COL_WHITE);
+}
+
+CPPUNIT_TEST_FIXTURE(CoatTest, testDropDownButton)
+{
+    ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(20, 24));
+    CPPUNIT_ASSERT(draw(*pDev, ControlType::Listbox, ControlPart::ButtonDown, ENABLED));
+    assertPixel("drop button background", *pDev, 1, 1, COL_WHITE);
+    // the chevron's tip is below the centre, in the muted glyph colour
+    bool bGlyph = false;
+    for (tools::Long y = 10; y < 16 && !bGlyph; ++y)
+        bGlyph = pDev->GetPixel(Point(10, y)) != COL_WHITE;
+    CPPUNIT_ASSERT_MESSAGE("chevron drawn", bGlyph);
+}
+
+CPPUNIT_TEST_FIXTURE(CoatTest, testCheckBox)
+{
+    const auto& p = light();
+    {
+        ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(16, 16));
+        CPPUNIT_ASSERT(draw(*pDev, ControlType::Checkbox, ControlPart::Entire, ENABLED,
+                            ImplControlValue(ButtonValue::Off)));
+        assertPixel("unchecked border", *pDev, 0, 8, p.aControlBorder);
+        assertPixel("unchecked inside", *pDev, 8, 8, COL_WHITE);
+    }
+    {
+        ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(16, 16));
+        draw(*pDev, ControlType::Checkbox, ControlPart::Entire, ENABLED,
+             ImplControlValue(ButtonValue::On));
+        assertPixel("checked fill, away from the mark", *pDev, 3, 13, p.aAccent);
+        assertPixel("checked border", *pDev, 0, 8, p.aAccent);
+        // the middle of the mark's short stroke, in the on-accent colour
+        assertPixel("check mark", *pDev, 5, 9, p.aOnAccent);
+    }
+}
+
+CPPUNIT_TEST_FIXTURE(CoatTest, testRadioButton)
+{
+    const auto& p = light();
+    ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(16, 16));
+    CPPUNIT_ASSERT(draw(*pDev, ControlType::Radiobutton, ControlPart::Entire, ENABLED,
+                        ImplControlValue(ButtonValue::On)));
+    assertPixel("round: corner unpainted", *pDev, 1, 1, MARKER);
+    assertPixel("selected ring", *pDev, 3, 8, p.aAccent);
+    assertPixel("dot", *pDev, 8, 8, p.aOnAccent);
+}
+
+CPPUNIT_TEST_FIXTURE(CoatTest, testTabs)
+{
+    const auto& p = light();
+    {
+        ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(80, 28));
+        pDev->SetBackground(Wallpaper(SURFACE));
+        CPPUNIT_ASSERT(draw(*pDev, ControlType::TabItem, ControlPart::Entire,
+                            ENABLED | ControlState::SELECTED));
+        assertPixel("indicator on the page side", *pDev, 40, 27, p.aTabIndicator);
+        assertPixel("indicator thickness", *pDev, 40, 26, p.aTabIndicator);
+        assertPixel("tab face is the control's surface", *pDev, 40, 5, SURFACE);
+    }
+    {
+        ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(80, 28));
+        pDev->SetBackground(Wallpaper(SURFACE));
+        draw(*pDev, ControlType::TabItem, ControlPart::Entire, ENABLED);
+        assertPixel("unselected: no indicator", *pDev, 40, 27, SURFACE);
+    }
+    {
+        ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(80, 28));
+        pDev->SetBackground(Wallpaper(SURFACE));
+        draw(*pDev, ControlType::TabItem, ControlPart::Entire, ENABLED | ControlState::ROLLOVER);
+        assertPixel("hovered tab", *pDev, 40, 14, p.aHover);
+    }
+    {
+        ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(200, 120));
+        pDev->SetBackground(Wallpaper(SURFACE));
+        CPPUNIT_ASSERT(draw(*pDev, ControlType::TabPane, ControlPart::Entire, ENABLED));
+        assertPixel("pane corner: the same surface", *pDev, 0, 0, SURFACE);
+        assertPixel("pane border", *pDev, 0, 60, p.aCardBorder);
+        assertPixel("pane inside: the same surface", *pDev, 100, 60, SURFACE);
+    }
+}
+
+/* The tab row and the pages are one surface across the control's full width: a TabControl's paint
+   (pane, header over the full width, the tabs) leaves one colour from the first tab to the right
+   edge, with or without the platform drawing the header. */
+CPPUNIT_TEST_FIXTURE(CoatTest, testTabRowIsOneSurfaceAcrossTheFullWidth)
+{
+    constexpr tools::Long nWidth = 600, nRow = 28, nHeight = 120;
+    for (bool bHeader : { true, false })
+    {
+        ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(nWidth, nHeight));
+        pDev->SetBackground(Wallpaper(SURFACE));
+        pDev->Erase(); // the window's own erase before its paint
+        const ImplControlValue aValue;
+        CPPUNIT_ASSERT(pDev->DrawNativeControl(ControlType::TabPane, ControlPart::Entire,
+                                               tools::Rectangle(0, nRow, nWidth - 1, nHeight - 1),
+                                               ENABLED, aValue, OUString()));
+        if (bHeader)
+            CPPUNIT_ASSERT(pDev->DrawNativeControl(ControlType::TabHeader, ControlPart::Entire,
+                                                   tools::Rectangle(0, 0, nWidth - 1, nRow - 1),
+                                                   ENABLED, aValue, OUString()));
+        for (int i = 0; i < 3; ++i)
+        {
+            const ControlState eState = i == 1 ? ENABLED | ControlState::SELECTED : ENABLED;
+            CPPUNIT_ASSERT(pDev->DrawNativeControl(
+                ControlType::TabItem, ControlPart::Entire,
+                tools::Rectangle(4 + 80 * i, 0, 83 + 80 * i, nRow - 1), eState, aValue, OUString()));
+        }
+        for (tools::Long x = 4; x < nWidth; ++x)
+        {
+            assertPixel("header row", *pDev, x, 5, SURFACE);
+            // the bottom row is the surface except under the selected tab's accent bar
+            if (x < 84 || x > 163)
+                assertPixel("header bottom row", *pDev, x, nRow - 1, SURFACE);
+        }
+        for (tools::Long x = 1; x < nWidth - 1; ++x)
+            assertPixel("page row", *pDev, x, 70, SURFACE);
+    }
+}
+
+CPPUNIT_TEST_FIXTURE(CoatTest, testScrollBar)
+{
+    const auto& p = light();
+    {
+        ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(16, 60));
+        CPPUNIT_ASSERT(draw(*pDev, ControlType::Scrollbar, ControlPart::ThumbVert, ENABLED));
+        assertPixel("track beside the thumb", *pDev, 0, 30, p.aScrollTrack);
+        assertPixel("thumb", *pDev, 8, 30, p.aScrollThumb);
+        assertPixel("pill end", *pDev, 3, 1, p.aScrollTrack);
+    }
+    {
+        ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(16, 60));
+        draw(*pDev, ControlType::Scrollbar, ControlPart::ThumbVert,
+             ENABLED | ControlState::PRESSED);
+        assertPixel("pressed thumb", *pDev, 8, 30, p.aScrollThumbPressed);
+    }
+    {
+        ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(16, 60));
+        CPPUNIT_ASSERT(
+            draw(*pDev, ControlType::Scrollbar, ControlPart::TrackVertUpper, ENABLED));
+        assertPixel("track", *pDev, 8, 30, p.aScrollTrack);
+    }
+}
+
+CPPUNIT_TEST_FIXTURE(CoatTest, testHighContrastSwitchesTheCoatOff)
+{
+    ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(80, 30), false, true);
+    CPPUNIT_ASSERT(!draw(*pDev, ControlType::Pushbutton, ControlPart::Entire, ENABLED));
+    assertPixel("nothing painted", *pDev, 40, 15, MARKER);
+}
+
+CPPUNIT_TEST_FIXTURE(CoatTest, testSettingSwitchesTheCoatOff)
+{
+    setSwitch(false);
+    ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(80, 30));
+    CPPUNIT_ASSERT(!hst::coat::IsSwitchedOn());
+    CPPUNIT_ASSERT(!draw(*pDev, ControlType::Pushbutton, ControlPart::Entire, ENABLED));
+    assertPixel("nothing painted", *pDev, 40, 15, MARKER);
+}
+
+CPPUNIT_TEST_FIXTURE(CoatTest, testEnvironmentOverridesTheSetting)
+{
+    setenv("HST_UI_COAT", "0", 1);
+    hst::coat::ResetSwitchForTesting();
+    CPPUNIT_ASSERT(!hst::coat::IsSwitchedOn());
+    unsetenv("HST_UI_COAT");
+    hst::coat::ResetSwitchForTesting();
+    CPPUNIT_ASSERT(hst::coat::IsSwitchedOn());
+}
+
+CPPUNIT_TEST_FIXTURE(CoatTest, testOnlyWhereThePlatformHasANativeLook)
+{
+    // the headless backend draws no native controls: without the test override the coat must not
+    // either, or VCL's own drawing (and its sizes) would change there
+    hst::coat::ForceForTesting(false);
+    ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(80, 30));
+    CPPUNIT_ASSERT(!draw(*pDev, ControlType::Pushbutton, ControlPart::Entire, ENABLED));
+}
+
+CPPUNIT_TEST_FIXTURE(CoatTest, testUncoveredPartsAreLeftToThePlatform)
+{
+    ScopedVclPtr<VirtualDevice> pDev = makeDevice(Size(80, 30));
+    CPPUNIT_ASSERT(!draw(*pDev, ControlType::Pushbutton, ControlPart::Focus, ENABLED));
+    CPPUNIT_ASSERT(!draw(*pDev, ControlType::Progress, ControlPart::Entire, ENABLED));
+    assertPixel("nothing painted", *pDev, 40, 15, MARKER);
+}
+
+CPPUNIT_TEST_FIXTURE(CoatTest, testGtkCss)
+{
+    const OString aLight = hst::coat::CreateGtkCss(false);
+    const OString aDark = hst::coat::CreateGtkCss(true);
+    CPPUNIT_ASSERT(aLight.indexOf(OString("#" + light().aAccent.AsRGBHexString().toUtf8())) >= 0);
+    CPPUNIT_ASSERT(
+        aDark.indexOf(OString("#" + hst::design::GetPalette(true).aAccent.AsRGBHexString().toUtf8())) >= 0);
+    CPPUNIT_ASSERT(aLight != aDark);
+    // the coat must not change any widget's size
+    for (const char* pMetric : { "padding", "margin", "min-height", "min-width", "border-width",
+                                 "font" })
+        CPPUNIT_ASSERT_MESSAGE(pMetric, aLight.indexOf(pMetric) < 0);
+}
+}
+
+CPPUNIT_PLUGIN_IMPLEMENT();
