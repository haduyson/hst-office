+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+#pragma once
+
+#include <comphelper/comphelperdllapi.h>
+#include <rtl/string.hxx>
+#include <rtl/ustring.hxx>
+
+/** HST Office: small helpers that make a file write survive a power cut.
+
+    A file is durable when its data reached the disk before the rename that publishes it, and the
+    rename itself reached the disk (the directory entry). The helpers take file URLs.
+*/
+namespace comphelper::hst
+{
+/// fsync of an existing file (FlushFileBuffers on Windows). False when it cannot be opened or synced.
+COMPHELPER_DLLPUBLIC bool syncFile(const OUString& rFileURL);
+
+/// fsync of the directory that contains rFileURL, so a rename or unlink in it is durable.
+/// No-op on Windows (ReplaceFile/MoveFileEx with write-through cover it there).
+COMPHELPER_DLLPUBLIC void syncParentDirectory(const OUString& rFileURL);
+
+/** Replace rFileURL with rData: temporary file next to it, write, fsync, rename over the target,
+    fsync of the directory. Readers see the old or the new content, never a mix. */
+COMPHELPER_DLLPUBLIC bool writeFileAtomically(const OUString& rFileURL, const OString& rData);
+}
