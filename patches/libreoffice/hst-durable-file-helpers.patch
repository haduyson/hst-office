+
+// HST Office: durable small-file writes (see include/comphelper/hstdurablefile.hxx).
+
+#include <comphelper/hstdurablefile.hxx>
+
+#include <osl/file.hxx>
+#include <osl/thread.h>
+#include <sal/log.hxx>
+
+#ifdef UNX
+#include <fcntl.h>
+#include <unistd.h>
+#endif
+
+namespace comphelper::hst
+{
+bool syncFile(const OUString& rFileURL)
+{
+    osl::File aFile(rFileURL);
+    // a read-only descriptor is enough for fsync on Unix; Windows needs write access
+    if (aFile.open(osl_File_OpenFlag_Write | osl_File_OpenFlag_NoLock) != osl::FileBase::E_None
+        && aFile.open(osl_File_OpenFlag_Read | osl_File_OpenFlag_NoLock) != osl::FileBase::E_None)
+        return false;
+    const bool bOk = aFile.sync() == osl::FileBase::E_None;
+    aFile.close();
+    SAL_WARN_IF(!bOk, "comphelper", "hst: fsync failed for " << rFileURL);
+    return bOk;
+}
+
+void syncParentDirectory(const OUString& rFileURL)
+{
+#ifdef UNX
+    const sal_Int32 nSlash = rFileURL.lastIndexOf('/');
+    if (nSlash <= 0)
+        return;
+    OUString aDirPath;
+    if (osl::FileBase::getSystemPathFromFileURL(rFileURL.copy(0, nSlash), aDirPath)
+        != osl::FileBase::E_None)
+        return;
+    const OString aSys = OUStringToOString(aDirPath, osl_getThreadTextEncoding());
+    const int nFd = open(aSys.getStr(), O_RDONLY | O_CLOEXEC);
+    if (nFd < 0)
+        return;
+    if (fsync(nFd) != 0)
+        SAL_INFO("comphelper", "hst: directory fsync failed for " << aDirPath);
+    close(nFd);
+#else
+    (void)rFileURL;
+#endif
+}
+
+bool writeFileAtomically(const OUString& rFileURL, const OString& rData)
+{
+    const sal_Int32 nSlash = rFileURL.lastIndexOf('/');
+    if (nSlash <= 0)
+        return false;
+    OUString aDirURL = rFileURL.copy(0, nSlash);
+    oslFileHandle hFile = nullptr;
+    OUString aTempURL;
+    if (osl::FileBase::createTempFile(&aDirURL, &hFile, &aTempURL) != osl::FileBase::E_None)
+        return false;
+    sal_uInt64 nWritten = 0;
+    bool bOk = osl_writeFile(hFile, rData.getStr(), rData.getLength(), &nWritten)
+                   == osl_File_E_None
+               && nWritten == sal_uInt64(rData.getLength());
+    bOk = bOk && osl_syncFile(hFile) == osl_File_E_None;
+    bOk = osl_closeFile(hFile) == osl_File_E_None && bOk;
+    if (bOk)
+        bOk = osl::File::replace(aTempURL, rFileURL) == osl::FileBase::E_None;
+    if (!bOk)
+    {
+        osl::File::remove(aTempURL);
+        SAL_WARN("comphelper", "hst: atomic write failed for " << rFileURL);
+        return false;
+    }
+    syncParentDirectory(rFileURL);
+    return true;
+}
+}
