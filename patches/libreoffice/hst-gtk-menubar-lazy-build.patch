+
+void GtkSalMenu::BuildPendingMenuBar()
+{
+    maBuildMenuBarIdle.Stop();
+    if (!mbMenuBarBuildPending || !mpFrame || bUnityMode)
+        return;
+    MenuBar* pMenuBar = static_cast<MenuBar*>(mpVCLMenu.get());
+    if (!pMenuBar || pMenuBar->isDisposed() || !pMenuBar->IsDisplayable())
+        return; // stays pending: ShowMenuBar(true) starts the idle again
+    // The window of a document is shown only after the load, when the Tabbed UI has hidden the
+    // menubar; the idle can run before, inside a nested main loop of the load (clipboard).
+    if (!gtk_widget_get_visible(mpFrame->getWindow()))
+        return; // stays pending: FrameShown() starts the idle again
+    mbMenuBarBuildPending = false;
+    if ( PrepUpdate() )
+        UpdateFull();
+    // UpdateFull() can run a nested main loop (clipboard targets of the Paste entry): the menubar
+    // may have been hidden or detached from its frame meanwhile.
+    if (mpFrame && !bUnityMode && pMenuBar->IsDisplayable())
     {
         DestroyMenuBarWidget();
         CreateMenuBarWidget();
     }
 }
 
+IMPL_LINK_NOARG(GtkSalMenu, BuildMenuBarHandler, Timer *, void)
+{
+    BuildPendingMenuBar();
+}
+
+void GtkSalMenu::FrameShown()
+{
+    if (mbMenuBarBuildPending && !bUnityMode && mpVCLMenu
+        && static_cast<MenuBar*>(mpVCLMenu.get())->IsDisplayable())
+        maBuildMenuBarIdle.Start();
+}
