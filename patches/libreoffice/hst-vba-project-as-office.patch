+// HST: 2.3.4.2.2.3 and 2.3.4.2.2.4. MS-OVBA 2.3.5: the type library of a designer MUST be referenced
+// with a REFERENCECONTROL. The values are those of Office-made files; Office rebuilds the extended
+// type library (.exd) on each machine, so its path in the file does not need to exist.
+void writeMSFormsREFERENCE(SvStream& rStrm, const rtl_TextEncoding eTextEncoding)
+{
+    static constexpr std::u16string_view aOriginal
+        = u"*\\G{0D452EE1-E08F-101A-852E-02608C4D0BB4}#2.0#0#C:\\Windows\\SysWOW64\\FM20.DLL#Microsoft Forms 2.0 Object Library";
+    static constexpr std::u16string_view aTwiddled = u"*\\G{00000000-0000-0000-0000-000000000000}#0.0#0##";
+    static constexpr std::u16string_view aExtended
+        = u"*\\G{7A4F2C10-5B3E-4D61-9A27-3E1C8B6D0F42}#2.0#0#C:\\Windows\\Temp\\VBE\\MSForms.exd#Microsoft Forms 2.0 Object Library";
+    static constexpr sal_uInt8 aTypeLib[16] = { 0xE1, 0x2E, 0x45, 0x0D, 0x8F, 0xE0, 0x1A, 0x10,
+                                                0x85, 0x2E, 0x02, 0x60, 0x8C, 0x4D, 0x0B, 0xB4 };
+    writeREFERENCENAME(rStrm, u"MSForms"_ustr, eTextEncoding);
+    rStrm.WriteUInt16(0x0033); // REFERENCEORIGINAL
+    rStrm.WriteUInt32(aOriginal.size());
+    exportString(rStrm, aOriginal, eTextEncoding);
+    rStrm.WriteUInt16(0x002F); // REFERENCECONTROL
+    rStrm.WriteUInt32(aTwiddled.size() + 10);
+    rStrm.WriteUInt32(aTwiddled.size());
+    exportString(rStrm, aTwiddled, eTextEncoding);
+    rStrm.WriteUInt32(0x00000000);
+    rStrm.WriteUInt16(0x0000);
+    writeREFERENCENAME(rStrm, u"MSForms"_ustr, eTextEncoding);
+    rStrm.WriteUInt16(0x0030);
+    rStrm.WriteUInt32(aExtended.size() + 30);
+    rStrm.WriteUInt32(aExtended.size());
+    exportString(rStrm, aExtended, eTextEncoding);
+    rStrm.WriteUInt32(0x00000000);
+    rStrm.WriteUInt16(0x0000);
+    rStrm.WriteBytes(aTypeLib, sizeof aTypeLib);
+    rStrm.WriteUInt32(0x00000001); // cookie
+}
+
+// HST: 2.3.4.2.2.6 REFERENCEPROJECT: the Normal template, which every Word project refers to
+void writeNormalREFERENCE(SvStream& rStrm, const rtl_TextEncoding eTextEncoding)
+{
+    static constexpr std::u16string_view aNormal = u"*\\CNormal";
+    writeREFERENCENAME(rStrm, u"Normal"_ustr, eTextEncoding);
+    rStrm.WriteUInt16(0x000E);
+    rStrm.WriteUInt32(4 + aNormal.size() + 4 + aNormal.size() + 4 + 2);
+    rStrm.WriteUInt32(aNormal.size());
+    exportString(rStrm, aNormal, eTextEncoding);
+    rStrm.WriteUInt32(aNormal.size());
+    exportString(rStrm, aNormal, eTextEncoding);
+    rStrm.WriteUInt32(0x65FC7811); // major version, as in Word-made files
+    rStrm.WriteUInt16(0x0004);
+}
