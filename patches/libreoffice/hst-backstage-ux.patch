+msgstr "In"
+
+#. hstBS
+#: sfx2/uiconfig/ui/hstbackstage.ui
+msgctxt "hstbackstage|printprintnote"
+msgid "Choose the printer, the pages and the number of copies (Ctrl+P)."
+msgstr "Chọn máy in, các trang cần in và số bản (Ctrl+P)."
+
+#. hstBS
+#: sfx2/uiconfig/ui/hstbackstage.ui
+msgctxt "hstbackstage|printpreview"
+msgid "Print Preview"
+msgstr "Xem trước khi in"
+
+#. hstBS
+#: sfx2/uiconfig/ui/hstbackstage.ui
+msgctxt "hstbackstage|printpreviewnote"
+msgid "See the pages as they will be printed."
+msgstr "Xem các trang như khi in ra giấy."
+
+#. hstBS
+#: sfx2/uiconfig/ui/hstbackstage.ui
+msgctxt "hstbackstage|exporttitle"
+msgid "Export"
+msgstr "Xuất"
+
+#. hstBS
+#: sfx2/uiconfig/ui/hstbackstage.ui
+msgctxt "hstbackstage|exportpdf"
+msgid "Export as PDF…"
+msgstr "Xuất PDF"
+
+#. hstBS
+#: sfx2/uiconfig/ui/hstbackstage.ui
+msgctxt "hstbackstage|exportpdfnote"
+msgid "Choose the pages, image quality, password and more, then save the PDF."
+msgstr "Chọn trang, chất lượng ảnh, mật khẩu và các tùy chọn khác rồi lưu tệp PDF."
+
+#. hstBS
+#: sfx2/uiconfig/ui/hstbackstage.ui
+msgctxt "hstbackstage|exportpdfdirect"
+msgid "Export Directly as PDF"
+msgstr "Xuất PDF ngay"
+
+#. hstBS
+#: sfx2/uiconfig/ui/hstbackstage.ui
+msgctxt "hstbackstage|exportpdfdirectnote"
+msgid "Save the PDF at once with the last options."
+msgstr "Lưu ngay tệp PDF với các tùy chọn đã dùng lần trước."
+
+#. hstBS
+#: sfx2/uiconfig/ui/hstbackstage.ui
+msgctxt "hstbackstage|exportother"
+msgid "Images and Other Formats…"
+msgstr "Ảnh và định dạng khác"
+
+#. hstBS
+#: sfx2/uiconfig/ui/hstbackstage.ui
+msgctxt "hstbackstage|exportothernote"
+msgid "PNG, JPEG, SVG, HTML and other formats."
+msgstr "PNG, JPEG, SVG, HTML và các định dạng khác."
+
+#. hstBS
+#: sfx2/uiconfig/ui/hstbackstage.ui
+msgctxt "hstbackstage|exportminimize"
+msgid "Compress Presentation…"
+msgstr "Nén bản trình chiếu"
+
+#. hstBS
+#: sfx2/uiconfig/ui/hstbackstage.ui
+msgctxt "hstbackstage|exportminimizenote"
+msgid "Make the file smaller: compress images, remove unused slides and data."
+msgstr "Giảm dung lượng tệp: nén ảnh, bỏ các trang chiếu và dữ liệu không dùng."
+
+#. hstBS
 #: sfx2/inc/backstage/hstbackstage.hrc
 msgctxt "STR_HST_BS_MORNING"
 msgid "Good morning"
