+/// HST: write the document's current VBA-mode Basic code as the .doc "Macros" storage (like .docm
+/// and .xlsm), when it is new or was edited and the original project has no UserForms (which
+/// VbaExport cannot write; then the original is kept and the usual "modified Basic" warning shows).
+bool lcl_writeCurrentVBA( SfxObjectShell& rDoc, SotStorage& rStor, const OUString& rStorageName )
+{
+#if HAVE_FEATURE_SCRIPTING
+    try
+    {
+        uno::Reference< script::vba::XVBACompatibility > xVBA( rDoc.GetBasicContainer(), uno::UNO_QUERY );
+        uno::Reference< script::XLibraryContainer > xLibraries( xVBA, uno::UNO_QUERY );
+        if ( !xVBA.is() || !xVBA->getVBACompatibilityMode() )
+            return false;
+        const OUString aProject = xVBA->getProjectName();
+        if ( aProject.isEmpty() || !xLibraries->hasByName( aProject ) )
+            return false;
+        if ( !xLibraries->isLibraryLoaded( aProject ) )
+            xLibraries->loadLibrary( aProject );
+        uno::Reference< container::XNameAccess > xLibrary( xLibraries->getByName( aProject ), uno::UNO_QUERY );
+        if ( !xLibrary.is() || !xLibrary->hasElements() )
+            return false;
+
+        rtl::Reference< SotStorage > xOriginal;
+        try
+        {
+            uno::Reference< embed::XStorage > xDocStorage( rDoc.GetStorage() );
+            const OUString aOriginal( SvxImportMSVBasic::GetMSBasicStorageName() );
+            if ( xDocStorage.is() && xDocStorage->hasByName( aOriginal ) )
+                xOriginal = SotStorage::OpenOLEStorage( xDocStorage, aOriginal, StreamMode::STD_READ );
+        }
+        catch ( const uno::Exception& )
+        {
+            // no original VBA project (a new document)
+        }
+        if ( xOriginal.is() && !xOriginal->GetError() )
+        {
+            BasicManager* pBasicMan = rDoc.GetBasicManager();
+            if ( !pBasicMan || !pBasicMan->IsBasicModified() )
+                return false; // unchanged: copy the original project
+            SvStorageInfoList aElements;
+            xOriginal->FillInfoList( &aElements );
+            for ( const SvStorageInfo& rElement : aElements )
+                if ( rElement.IsStorage() && rElement.GetName() != "VBA" )
+                    return false; // UserForms
+        }
+
+        rtl::Reference< SotStorage > xMacros = rStor.OpenSotStorage( rStorageName, StreamMode::READWRITE | StreamMode::TRUNC );
+        VbaExport aExport( rDoc.GetModel() );
+        aExport.exportVBA( xMacros.get() );
+        xMacros->Commit();
+        return !xMacros->GetError();
+    }
+    catch ( const uno::Exception& )
+    {
+    }
+#else
+    (void)rDoc; (void)rStor; (void)rStorageName;
+#endif
+    return false;
+}
+}
+
 extern "C" SAL_DLLPUBLIC_EXPORT sal_uInt32 SaveOrDelMSVBAStorage_ww8( SfxObjectShell& rDoc, SotStorage& rStor, sal_Bool bSaveInto, const OUString& rStorageName )
 {
+    if ( bSaveInto && lcl_writeCurrentVBA( rDoc, rStor, rStorageName ) )
+        return sal_uInt32( ERRCODE_NONE );
     SvxImportMSVBasic aTmp( rDoc, rStor );
     return sal_uInt32(aTmp.SaveOrDelMSVBAStorage( bSaveInto, rStorageName ));
 }
