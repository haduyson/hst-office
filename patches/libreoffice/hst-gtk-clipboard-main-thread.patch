+#if !GTK_CHECK_VERSION(4, 0, 0)
+namespace
+{
+/// HST: the targets of a selection as the main thread last read them, asynchronously; every Paste state gets
+/// these and never waits. gtk_clipboard_wait_for_targets runs a nested loop of the default main context: off the
+/// main thread (a UNO client building a toolbar, menubar or ribbon, loading or closing a document) against the
+/// main thread, and both wait for good; on the main thread it releases the SolarMutex (gdk_threads_leave) while
+/// it polls, so a UNO client could close the document in the middle of a Paste state.
+struct HstClipboardTargets
+{
+    std::mutex aMutex;
+    std::vector<css::datatransfer::DataFlavor> aFlavors;
+    std::map<OUString, GdkAtom> aTypes;
+    bool bRequested = false;
+};
+
+HstClipboardTargets& hstTargets(ClipboardSelectionType eSelection)
+{
+    static HstClipboardTargets aTargets[2];
+    return aTargets[eSelection == ClipboardSelectionType::Clipboard ? 0 : 1];
+}
+
+void hstStoreTargets(ClipboardSelectionType eSelection, std::vector<css::datatransfer::DataFlavor> aFlavors,
+                     std::map<OUString, GdkAtom> aTypes)
+{
+    HstClipboardTargets& rTargets = hstTargets(eSelection);
+    std::scoped_lock aLock(rTargets.aMutex);
+    rTargets.aFlavors = std::move(aFlavors);
+    rTargets.aTypes = std::move(aTypes);
+}
+
+void hstRequestTargets(ClipboardSelectionType eSelection);
+}
+#endif
+
