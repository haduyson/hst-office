+
+#if !GTK_CHECK_VERSION(4, 0, 0)
+    /// HST: called on the main thread with the targets gtk_clipboard_request_targets read
+    void HstStoreTargets(GdkAtom* targets, gint n_targets)
+    {
+        std::vector<css::datatransfer::DataFlavor> aVector;
+        if (targets)
+            aVector = GtkTransferable::getTransferDataFlavorsAsVector(targets, n_targets);
+        hstStoreTargets(m_eSelection, std::move(aVector), m_aMimeTypeToGtkType);
+    }
+#endif
 };
+
+#if !GTK_CHECK_VERSION(4, 0, 0)
+namespace
+{
+void hstTargetsReceived(GtkClipboard*, GdkAtom* targets, gint n_targets, gpointer pData)
+{
+    const auto eSelection = static_cast<ClipboardSelectionType>(GPOINTER_TO_INT(pData));
+    rtl::Reference<GtkClipboardTransferable> xReader(new GtkClipboardTransferable(eSelection));
+    xReader->HstStoreTargets(targets, n_targets);
+}
+
+gboolean hstRequestTargetsIdle(gpointer pData)
+{
+    const auto eSelection = static_cast<ClipboardSelectionType>(GPOINTER_TO_INT(pData));
+    gtk_clipboard_request_targets(clipboard_get(eSelection), hstTargetsReceived, pData);
+    return G_SOURCE_REMOVE;
+}
+
+/// asks for the targets on the main thread without waiting: from an idle of the default main context, which only
+/// the main thread runs, and with the answer handled when it comes (no nested loop, no SolarMutex)
+void hstRequestTargets(ClipboardSelectionType eSelection)
+{
+    g_idle_add_full(G_PRIORITY_HIGH_IDLE, hstRequestTargetsIdle, GINT_TO_POINTER(static_cast<int>(eSelection)),
+                    nullptr);
+}
+}
+#endif
 
