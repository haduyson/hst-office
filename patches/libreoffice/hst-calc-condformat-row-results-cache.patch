+CPPUNIT_TEST_FIXTURE(TestCondformat, testCondFormatRowResultsInRowHeightPass)
+{
+    // During a row height pass a formula whose result cannot change with the column is evaluated
+    // once per row; formulas that depend on the column keep the per-cell evaluation.
+    m_pDoc->InsertTab(0, u"Test"_ustr);
+    for (SCROW nRow = 0; nRow < 20; ++nRow)
+        for (SCCOL nCol : { 0, 2 })
+            m_pDoc->SetValue(ScAddress(nCol, nRow, 0), 1.0);
+    auto lcl_entry = [this](const OUString& rFormula) {
+        return std::make_unique<ScConditionEntry>(ScConditionMode::Direct, rFormula, u""_ustr, *m_pDoc,
+                                                  ScAddress(0, 0, 0), u""_ustr, u""_ustr,
+                                                  formula::FormulaGrammar::GRAM_DEFAULT,
+                                                  formula::FormulaGrammar::GRAM_DEFAULT);
+    };
+    auto pAbsolute = lcl_entry(u"$B1>9"_ustr);          // kept per row
+    auto pAbsRange = lcl_entry(u"SUM($B1:$B2)>9"_ustr); // kept per row
+    auto pRelative = lcl_entry(u"B1>9"_ustr);           // B in column A, D in column C
+    auto pColumn = lcl_entry(u"$B1+COLUMN()>10"_ustr);  // depends on the column
+    for (SCROW nOffset : { 0, 5 })
+    {
+        for (SCROW nRow = 0; nRow < 20; ++nRow)
+        {
+            m_pDoc->SetValue(ScAddress(1, nRow, 0), nRow + nOffset);
+            m_pDoc->SetValue(ScAddress(3, nRow, 0), 100.0);
+        }
+        ScDocument::CondRowCacheScope aScope(*m_pDoc); // a new pass sees the changed values
+        CPPUNIT_ASSERT(m_pDoc->GetCondRowCacheId() != 0);
+        for (SCCOL nCol : { 0, 2 })
+            for (SCROW nRow = 0; nRow < 19; ++nRow)
+            {
+                const ScAddress aPos(nCol, nRow, 0);
+                ScRefCellValue aCell(*m_pDoc, aPos);
+                const double fB = nRow + nOffset;
+                CPPUNIT_ASSERT_EQUAL(fB > 9, pAbsolute->IsCellValid(aCell, aPos));
+                CPPUNIT_ASSERT_EQUAL(2 * fB + 1 > 9, pAbsRange->IsCellValid(aCell, aPos));
+                CPPUNIT_ASSERT_EQUAL(nCol == 2 || fB > 9, pRelative->IsCellValid(aCell, aPos));
+                CPPUNIT_ASSERT_EQUAL(fB + nCol + 1 > 10, pColumn->IsCellValid(aCell, aPos));
+            }
+    }
+    CPPUNIT_ASSERT_EQUAL(sal_uInt32(0), m_pDoc->GetCondRowCacheId());
+
+    m_pDoc->DeleteTab(0);
+}
