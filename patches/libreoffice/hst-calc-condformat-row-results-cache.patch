+    class CondRowCacheScope
+    {
+        ScDocument& mrDoc;
+        sal_uInt32 mnOld;
+    public:
+        explicit CondRowCacheScope(ScDocument& rDoc) : mrDoc(rDoc), mnOld(rDoc.mnCondRowCacheId)
+        {
