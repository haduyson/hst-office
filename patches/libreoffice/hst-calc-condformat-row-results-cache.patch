+/* HST Office: during a row height pass (ScDocument::CondRowCacheScope) the cells of one row ask every
+   conditional format entry for their result, one column after the other, and a formula with relative
+   references was evaluated again for every cell. When the formula cannot give another result in
+   another column of the same row, its result is kept per row for the rest of the pass: only references
+   with absolute columns (like $F2), values, operators and functions; no names, labels, table, database
+   or external references, no functions that look at the position or the interpreter state (ROW,
+   COLUMN, CELL, OFFSET, INDIRECT, SHEET, INFO, CURRENT, MULTIPLE.OPERATIONS) and nothing volatile. */
+static bool lcl_IsColumnIndependentCode( const ScTokenArray& rArr )
+{
+    if (rArr.IsRecalcModeAlways() || rArr.GetCodeError() != FormulaError::NONE)
+        return false;
+    for (const formula::FormulaToken* t : rArr.Tokens())
+    {
+        switch (t->GetType())
+        {
+            case formula::svByte:
+            case formula::svDouble:
+            case formula::svString:
+            case formula::svMissing:
+            case formula::svSep:
+            case formula::svJump:
+                break;
+            case formula::svSingleRef:
+                if (t->GetSingleRef()->IsColRel())
+                    return false;
+                break;
+            case formula::svDoubleRef:
+                if (t->GetDoubleRef()->Ref1.IsColRel() || t->GetDoubleRef()->Ref2.IsColRel())
+                    return false;
+                break;
+            default:
+                return false;
+        }
+        switch (t->GetOpCode())
+        {
+            case ocName: case ocColRowName: case ocTableRef: case ocDBArea: case ocMacro:
+            case ocExternal: case ocDde: case ocWebservice: case ocFilterXML:
+            case ocTableRefOpen: case ocTableRefClose: case ocTableRefItemAll:
+            case ocRow: case ocColumn: case ocCell: case ocOffset: case ocIndirect: case ocSheet:
+            case ocInfo: case ocCurrent: case ocTableOp:
+            case ocRandom: case ocGetActDate: case ocGetActTime:
+                return false;
+            default:
+                break;
+        }
+    }
+    return true;
+}
+
+static bool lcl_IsColumnFree( sal_Int8& rKnown, const ScTokenArray* pFormula )
+{
+    if (rKnown < 0)
+        rKnown = (pFormula && lcl_IsColumnIndependentCode(*pFormula)) ? 1 : 0;
+    return rKnown == 1;
+}
