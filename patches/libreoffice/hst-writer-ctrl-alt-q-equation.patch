+/// Ctrl+Alt+Q starts a new equation, as MathType's key in Word: the command of the Insert tab's equation
+/// button in each application (Writer and Sheets: InsertObjectStarMath, Slides and Draw: InsertMath).
+class HstEquationShortcutTest : public SwModelTestBase
+{
+public:
+    HstEquationShortcutTest()
+        : SwModelTestBase(u"/sw/qa/extras/hst/data/"_ustr)
+    {
+    }
+
+protected:
+    static OUString commandOfCtrlAltQ(const OUString& rModule)
+    {
+        uno::Reference<ui::XModuleUIConfigurationManagerSupplier> xSupplier
+            = ui::theModuleUIConfigurationManagerSupplier::get(comphelper::getProcessComponentContext());
+        uno::Reference<ui::XAcceleratorConfiguration> xShortcuts
+            = xSupplier->getUIConfigurationManager(rModule)->getShortCutManager();
+        awt::KeyEvent aKey;
+        aKey.KeyCode = awt::Key::Q;
+        aKey.Modifiers = awt::KeyModifier::MOD1 | awt::KeyModifier::MOD2;
+        try
+        {
+            return xShortcuts->getCommandByKeyEvent(aKey);
+        }
+        catch (const container::NoSuchElementException&)
+        {
+            return OUString(); // the key is not bound in this module
+        }
+    }
+};
+
+/// Turns the LibreOfficeKit mode on for one test, so the OLE object can go in-place active without a
+/// visible window, and off again even when an assertion fails.
+struct LokModeGuard
+{
+    LokModeGuard() { comphelper::LibreOfficeKit::setActive(true); }
+    ~LokModeGuard() { comphelper::LibreOfficeKit::setActive(false); }
+};
+
+CPPUNIT_TEST_FIXTURE(HstEquationShortcutTest, testCtrlAltQIsBoundInEveryApp)
+{
+    CPPUNIT_ASSERT_EQUAL(u".uno:InsertObjectStarMath"_ustr,
+                         commandOfCtrlAltQ(u"com.sun.star.text.TextDocument"_ustr));
+    CPPUNIT_ASSERT_EQUAL(u".uno:InsertObjectStarMath"_ustr,
+                         commandOfCtrlAltQ(u"com.sun.star.text.GlobalDocument"_ustr));
+    CPPUNIT_ASSERT_EQUAL(u".uno:InsertObjectStarMath"_ustr,
+                         commandOfCtrlAltQ(u"com.sun.star.sheet.SpreadsheetDocument"_ustr));
+    CPPUNIT_ASSERT_EQUAL(u".uno:InsertMath"_ustr,
+                         commandOfCtrlAltQ(u"com.sun.star.presentation.PresentationDocument"_ustr));
+    CPPUNIT_ASSERT_EQUAL(u".uno:InsertMath"_ustr,
+                         commandOfCtrlAltQ(u"com.sun.star.drawing.DrawingDocument"_ustr));
+}
+
+CPPUNIT_TEST_FIXTURE(HstEquationShortcutTest, testCtrlAltQInsertsNewEquation)
+{
+    LokModeGuard aLok;
+    createSwDoc();
+    emulateTyping(u"x = ");
+
+    // Ctrl+Alt+Q as GTK and macOS deliver it: the key code with both modifiers and the letter.
+    SwXTextDocument* pTextDoc = getSwTextDoc();
+    pTextDoc->postKeyEvent(LOK_KEYEVENT_KEYINPUT, 'q', KEY_Q | KEY_MOD1 | KEY_MOD2);
+    pTextDoc->postKeyEvent(LOK_KEYEVENT_KEYUP, 'q', KEY_Q | KEY_MOD1 | KEY_MOD2);
+    Scheduler::ProcessEventsToIdle();
+
+    // The key types nothing: the paragraph still holds only the typed text and the new object.
+    uno::Reference<text::XTextEmbeddedObjectsSupplier> xSupplier(mxComponent, uno::UNO_QUERY_THROW);
+    uno::Reference<container::XIndexAccess> xObjects(xSupplier->getEmbeddedObjects(), uno::UNO_QUERY_THROW);
+    // Without the binding the key did nothing: 0 objects.
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(1), xObjects->getCount());
+
+    // One new, empty formula, in the line at the cursor.
+    uno::Reference<beans::XPropertySet> xFrame(xObjects->getByIndex(0), uno::UNO_QUERY_THROW);
+    CPPUNIT_ASSERT_EQUAL(text::TextContentAnchorType_AS_CHARACTER,
+                         xFrame->getPropertyValue(u"AnchorType"_ustr).get<text::TextContentAnchorType>());
+    uno::Reference<document::XEmbeddedObjectSupplier2> xEmbedded(xFrame, uno::UNO_QUERY_THROW);
+    uno::Reference<lang::XServiceInfo> xFormula(xEmbedded->getEmbeddedObject(), uno::UNO_QUERY_THROW);
+    CPPUNIT_ASSERT(xFormula->supportsService(u"com.sun.star.formula.FormulaProperties"_ustr));
+    uno::Reference<beans::XPropertySet> xFormulaProps(xFormula, uno::UNO_QUERY_THROW);
+    CPPUNIT_ASSERT_EQUAL(OUString(), xFormulaProps->getPropertyValue(u"Formula"_ustr).get<OUString>());
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(-1), getParagraph(1)->getString().indexOf('q'));
+
+    // The equation editor is open on it.
+    uno::Reference<embed::XEmbeddedObject> xObject = xEmbedded->getExtendedControlOverEmbeddedObject();
+    const sal_Int32 nState = xObject->getCurrentState();
+    CPPUNIT_ASSERT_MESSAGE("the new equation is not open for editing",
+                           nState == embed::EmbedStates::INPLACE_ACTIVE
+                               || nState == embed::EmbedStates::UI_ACTIVE);
+
+    // Close the editor before the document goes away.
+    if (SfxInPlaceClient* pClient = getSwDocShell()->GetWrtShell()->GetView().GetIPClient())
+        pClient->DeactivateObject();
+    Scheduler::ProcessEventsToIdle();
+}
