+/// Ctrl+Alt+Q starts a new equation, as MathType's key in Word: the command of the Insert tab's equation
+/// button in each application (Writer and Sheets: InsertObjectStarMath, Slides and Draw: InsertMath).
+class HstEquationShortcutTest : public SwModelTestBase
+{
+public:
+    HstEquationShortcutTest()
+        : SwModelTestBase(u"/sw/qa/extras/hst/data/"_ustr)
+    {
+    }
+
+protected:
+    static OUString commandOfCtrlAltQ(const OUString& rModule)
+    {
+        uno::Reference<ui::XModuleUIConfigurationManagerSupplier> xSupplier
+            = ui::theModuleUIConfigurationManagerSupplier::get(comphelper::getProcessComponentContext());
+        uno::Reference<ui::XAcceleratorConfiguration> xShortcuts
+            = xSupplier->getUIConfigurationManager(rModule)->getShortCutManager();
+        awt::KeyEvent aKey;
+        aKey.KeyCode = awt::Key::Q;
+        aKey.Modifiers = awt::KeyModifier::MOD1 | awt::KeyModifier::MOD2;
+        try
+        {
+            return xShortcuts->getCommandByKeyEvent(aKey);
+        }
+        catch (const container::NoSuchElementException&)
+        {
+            return OUString(); // the key is not bound in this module
+        }
+    }
+};
+
+/// Records the formula commands that reach the document's frame and keeps them from running, so the test sees
+/// what the key dispatches without starting the in-place editor in a headless office. Every other command
+/// goes on to the frame.
+class FormulaCommandRecorder : public cppu::WeakImplHelper<frame::XDispatchProviderInterceptor, frame::XDispatch>
+{
+public:
+    std::vector<OUString> m_aDispatched;
+
+    // XDispatchProvider
+    uno::Reference<frame::XDispatch> SAL_CALL queryDispatch(const util::URL& rURL, const OUString& rTarget,
+                                                            sal_Int32 nFlags) override
+    {
+        if (rURL.Complete == ".uno:InsertObjectStarMath" || rURL.Complete == ".uno:InsertMath")
+            return this;
+        return m_xSlave.is() ? m_xSlave->queryDispatch(rURL, rTarget, nFlags) : nullptr;
+    }
+    uno::Sequence<uno::Reference<frame::XDispatch>>
+        SAL_CALL queryDispatches(const uno::Sequence<frame::DispatchDescriptor>& rRequests) override
+    {
+        uno::Sequence<uno::Reference<frame::XDispatch>> aResult(rRequests.getLength());
+        auto pResult = aResult.getArray();
+        for (sal_Int32 i = 0; i < rRequests.getLength(); ++i)
+            pResult[i] = queryDispatch(rRequests[i].FeatureURL, rRequests[i].FrameName,
+                                       rRequests[i].SearchFlags);
+        return aResult;
+    }
+
+    // XDispatchProviderInterceptor
+    uno::Reference<frame::XDispatchProvider> SAL_CALL getSlaveDispatchProvider() override { return m_xSlave; }
+    void SAL_CALL setSlaveDispatchProvider(const uno::Reference<frame::XDispatchProvider>& xSlave) override
+    {
+        m_xSlave = xSlave;
+    }
+    uno::Reference<frame::XDispatchProvider> SAL_CALL getMasterDispatchProvider() override { return m_xMaster; }
+    void SAL_CALL setMasterDispatchProvider(const uno::Reference<frame::XDispatchProvider>& xMaster) override
+    {
+        m_xMaster = xMaster;
+    }
+
+    // XDispatch
+    void SAL_CALL dispatch(const util::URL& rURL, const uno::Sequence<beans::PropertyValue>&) override
+    {
+        m_aDispatched.push_back(rURL.Complete);
+    }
+    void SAL_CALL addStatusListener(const uno::Reference<frame::XStatusListener>&, const util::URL&) override {}
+    void SAL_CALL removeStatusListener(const uno::Reference<frame::XStatusListener>&, const util::URL&) override
+    {
+    }
+
+private:
+    uno::Reference<frame::XDispatchProvider> m_xSlave;
+    uno::Reference<frame::XDispatchProvider> m_xMaster;
+};
+
+CPPUNIT_TEST_FIXTURE(HstEquationShortcutTest, testCtrlAltQIsBoundInEveryApp)
+{
+    CPPUNIT_ASSERT_EQUAL(u".uno:InsertObjectStarMath"_ustr,
+                         commandOfCtrlAltQ(u"com.sun.star.text.TextDocument"_ustr));
+    CPPUNIT_ASSERT_EQUAL(u".uno:InsertObjectStarMath"_ustr,
+                         commandOfCtrlAltQ(u"com.sun.star.text.GlobalDocument"_ustr));
+    CPPUNIT_ASSERT_EQUAL(u".uno:InsertObjectStarMath"_ustr,
+                         commandOfCtrlAltQ(u"com.sun.star.sheet.SpreadsheetDocument"_ustr));
+    CPPUNIT_ASSERT_EQUAL(u".uno:InsertMath"_ustr,
+                         commandOfCtrlAltQ(u"com.sun.star.presentation.PresentationDocument"_ustr));
+    CPPUNIT_ASSERT_EQUAL(u".uno:InsertMath"_ustr,
+                         commandOfCtrlAltQ(u"com.sun.star.drawing.DrawingDocument"_ustr));
+}
+
+CPPUNIT_TEST_FIXTURE(HstEquationShortcutTest, testCtrlAltQStartsNewEquation)
+{
+    createSwDoc();
+    emulateTyping(u"x = ");
+
+    uno::Reference<frame::XModel> xModel(mxComponent, uno::UNO_QUERY_THROW);
+    uno::Reference<frame::XDispatchProviderInterception> xFrame(
+        xModel->getCurrentController()->getFrame(), uno::UNO_QUERY_THROW);
+    rtl::Reference<FormulaCommandRecorder> pRecorder(new FormulaCommandRecorder);
+    xFrame->registerDispatchProviderInterceptor(pRecorder);
+
+    // Ctrl+Alt+Q in the text, as GTK and macOS deliver it: the key code with both modifiers and the letter.
+    SwXTextDocument* pTextDoc = getSwTextDoc();
+    pTextDoc->postKeyEvent(LOK_KEYEVENT_KEYINPUT, 'q', KEY_Q | KEY_MOD1 | KEY_MOD2);
+    pTextDoc->postKeyEvent(LOK_KEYEVENT_KEYUP, 'q', KEY_Q | KEY_MOD1 | KEY_MOD2);
+    Scheduler::ProcessEventsToIdle();
+    xFrame->releaseDispatchProviderInterceptor(pRecorder);
+
+    // The key runs the equation button's command once (without the binding: nothing, and a "q" was typed).
+    CPPUNIT_ASSERT_EQUAL(size_t(1), pRecorder->m_aDispatched.size());
+    CPPUNIT_ASSERT_EQUAL(u".uno:InsertObjectStarMath"_ustr, pRecorder->m_aDispatched[0]);
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(-1), getParagraph(1)->getString().indexOf('q'));
+}
+}
