+uno::Reference<word::XRange> SAL_CALL SwVbaComment::getRange()
+{
+    uno::Reference<text::XText> xText(mxAnnotation->getPropertyValue(u"TextRange"_ustr), uno::UNO_QUERY_THROW);
+    return uno::Reference<word::XRange>(
+        new SwVbaRange(this, mxContext, mxTextDocument, xText->getStart(), xText->getEnd(), xText));
+}
+
+uno::Reference<word::XRange> SAL_CALL SwVbaComment::getScope()
+{
+    uno::Reference<text::XTextContent> xContent(mxAnnotation, uno::UNO_QUERY_THROW);
+    uno::Reference<text::XTextRange> xAnchor = xContent->getAnchor();
+    return uno::Reference<word::XRange>(new SwVbaRange(this, mxContext, mxTextDocument, xAnchor->getStart(),
+                                                       xAnchor->getEnd(), xAnchor->getText()));
+}
+
+OUString SAL_CALL SwVbaComment::getAuthor()
+{
+    OUString aAuthor;
+    mxAnnotation->getPropertyValue(u"Author"_ustr) >>= aAuthor;
+    return aAuthor;
+}
+
+void SAL_CALL SwVbaComment::setAuthor(const OUString& rAuthor)
