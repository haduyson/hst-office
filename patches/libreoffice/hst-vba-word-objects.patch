+SwVbaComments::SwVbaComments(const uno::Reference<XHelperInterface>& xParent,
+                             const uno::Reference<uno::XComponentContext>& xContext,
+                             const rtl::Reference<SwXTextDocument>& xTextDocument)
+    : SwVbaComments_BASE(xParent, xContext, new CommentsIndexAccess(lcl_annotations(xTextDocument)))
+    , mxTextDocument(xTextDocument)
+{
+}
+
+uno::Reference<word::XComment> SAL_CALL SwVbaComments::Add(const uno::Reference<word::XRange>& rRange,
+                                                           const uno::Any& rText)
+{
+    OUString aText;
+    rText >>= aText;
+    uno::Reference<beans::XPropertySet> xAnnotation(
+        mxTextDocument->createInstance(u"com.sun.star.text.textfield.Annotation"_ustr), uno::UNO_QUERY_THROW);
+    SvtUserOptions aUserOptions;
+    xAnnotation->setPropertyValue(u"Author"_ustr, uno::Any(aUserOptions.GetFullName()));
+    xAnnotation->setPropertyValue(u"Initials"_ustr, uno::Any(aUserOptions.GetID()));
+    xAnnotation->setPropertyValue(u"Content"_ustr, uno::Any(aText));
+    uno::Reference<text::XTextRange> xTextRange = dynamic_cast<SwVbaRange&>(*rRange).getXTextRange();
+    uno::Reference<text::XTextContent> xContent(xAnnotation, uno::UNO_QUERY_THROW);
+    // absorb: the comment spans the range (Word's Comment.Scope)
+    xTextRange->getText()->insertTextContent(xTextRange, xContent, !xTextRange->getString().isEmpty());
+    return uno::Reference<word::XComment>(new SwVbaComment(mxParent, mxContext, mxTextDocument, xAnnotation));
+}
+
+uno::Type SwVbaComments::getElementType() { return cppu::UnoType<word::XComment>::get(); }
