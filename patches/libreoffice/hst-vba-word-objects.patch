+    , mxShape(std::move(xShape))
+    , mnLockAspectRatio(-1)
+{
+}
+
+float SAL_CALL SwVbaInlineShape::getWidth()
+{
+    sal_Int32 nWidth = 0;
+    mxShape->getPropertyValue(u"Width"_ustr) >>= nWidth;
+    return lcl_toPoints(nWidth);
+}
+
+void SAL_CALL SwVbaInlineShape::setWidth(float fWidth)
+{
+    sal_Int32 nOldWidth = 0, nOldHeight = 0;
+    mxShape->getPropertyValue(u"Width"_ustr) >>= nOldWidth;
+    mxShape->getPropertyValue(u"Height"_ustr) >>= nOldHeight;
+    const sal_Int32 nWidth = lcl_to100thMM(fWidth);
+    mxShape->setPropertyValue(u"Width"_ustr, uno::Any(nWidth));
+    if (mnLockAspectRatio != 0 && nOldWidth > 0)
+        mxShape->setPropertyValue(u"Height"_ustr,
+                                  uno::Any(static_cast<sal_Int32>(sal_Int64(nOldHeight) * nWidth / nOldWidth)));
+}
+
+float SAL_CALL SwVbaInlineShape::getHeight()
+{
+    sal_Int32 nHeight = 0;
+    mxShape->getPropertyValue(u"Height"_ustr) >>= nHeight;
+    return lcl_toPoints(nHeight);
+}
+
+void SAL_CALL SwVbaInlineShape::setHeight(float fHeight)
+{
+    sal_Int32 nOldWidth = 0, nOldHeight = 0;
+    mxShape->getPropertyValue(u"Width"_ustr) >>= nOldWidth;
+    mxShape->getPropertyValue(u"Height"_ustr) >>= nOldHeight;
+    const sal_Int32 nHeight = lcl_to100thMM(fHeight);
+    mxShape->setPropertyValue(u"Height"_ustr, uno::Any(nHeight));
+    if (mnLockAspectRatio != 0 && nOldHeight > 0)
+        mxShape->setPropertyValue(u"Width"_ustr,
+                                  uno::Any(static_cast<sal_Int32>(sal_Int64(nOldWidth) * nHeight / nOldHeight)));
+}
+
+sal_Int32 SAL_CALL SwVbaInlineShape::getLockAspectRatio() { return mnLockAspectRatio; }
+
+void SAL_CALL SwVbaInlineShape::setLockAspectRatio(sal_Int32 nLock) { mnLockAspectRatio = nLock == 0 ? 0 : -1; }
+
+sal_Int32 SAL_CALL SwVbaInlineShape::getType() { return word::WdInlineShapeType::wdInlineShapePicture; }
+
+uno::Reference<word::XRange> SAL_CALL SwVbaInlineShape::getRange()
+{
+    uno::Reference<text::XTextContent> xContent(mxShape, uno::UNO_QUERY_THROW);
+    uno::Reference<text::XTextRange> xAnchor = xContent->getAnchor();
+    return uno::Reference<word::XRange>(new SwVbaRange(this, mxContext, mxTextDocument, xAnchor->getStart(),
+                                                       xAnchor->getEnd(), xAnchor->getText()));
+}
+
+void SAL_CALL SwVbaInlineShape::Delete()
+{
+    uno::Reference<lang::XComponent> xComponent(mxShape, uno::UNO_QUERY_THROW);
+    xComponent->dispose();
+}
+
+void SAL_CALL SwVbaInlineShape::Select()
+{
+    uno::Reference<view::XSelectionSupplier> xSelection(mxTextDocument->getCurrentController(), uno::UNO_QUERY_THROW);
+    xSelection->select(uno::Any(mxShape));
+}
