+uno::Reference<word::XInlineShape> SAL_CALL
+SwVbaInlineShapes::AddPicture(const OUString& rFileName, const uno::Any& rLinkToFile,
+                              const uno::Any& /*rSaveWithDocument*/, const uno::Any& rRange)
+{
+    OUString aURL;
+    if (osl::FileBase::getFileURLFromSystemPath(rFileName, aURL) != osl::FileBase::E_None)
+        aURL = rFileName;
+    uno::Reference<graphic::XGraphicProvider> xProvider = graphic::GraphicProvider::create(mxContext);
+    uno::Sequence<beans::PropertyValue> aArgs{ comphelper::makePropertyValue(u"URL"_ustr, aURL) };
+    uno::Reference<graphic::XGraphic> xGraphic = xProvider->queryGraphic(aArgs);
+    if (!xGraphic.is())
+        throw uno::RuntimeException(u"Cannot load the picture "_ustr + rFileName);
+
+    uno::Reference<beans::XPropertySet> xShape(
+        mxTextDocument->createInstance(u"com.sun.star.text.TextGraphicObject"_ustr), uno::UNO_QUERY_THROW);
+    xShape->setPropertyValue(u"AnchorType"_ustr, uno::Any(text::TextContentAnchorType_AS_CHARACTER));
+    bool bLink = false;
+    rLinkToFile >>= bLink;
+    if (bLink)
+        xShape->setPropertyValue(u"GraphicURL"_ustr, uno::Any(aURL));
+    else
+        xShape->setPropertyValue(u"Graphic"_ustr, uno::Any(xGraphic));
+
+    // natural size of the picture (1/100 mm, else pixels at 96 dpi)
+    uno::Reference<beans::XPropertySet> xGraphicProps(xGraphic, uno::UNO_QUERY);
+    awt::Size aSize;
+    if (xGraphicProps.is())
+    {
+        xGraphicProps->getPropertyValue(u"Size100thMM"_ustr) >>= aSize;
+        if (aSize.Width <= 0 || aSize.Height <= 0)
+        {
+            xGraphicProps->getPropertyValue(u"SizePixel"_ustr) >>= aSize;
+            aSize.Width = aSize.Width * 2540 / 96;
+            aSize.Height = aSize.Height * 2540 / 96;
+        }
+    }
+    if (aSize.Width > 0 && aSize.Height > 0)
+        xShape->setPropertyValue(u"Size"_ustr, uno::Any(aSize));
+
+    uno::Reference<text::XTextRange> xTextRange;
+    uno::Reference<word::XRange> xRange;
+    if ((rRange >>= xRange) && xRange.is())
+        xTextRange = dynamic_cast<SwVbaRange&>(*xRange).getXTextRange();
+    else
+        xTextRange.set(word::getXTextViewCursor(mxTextDocument), uno::UNO_QUERY_THROW);
+    uno::Reference<text::XTextContent> xContent(xShape, uno::UNO_QUERY_THROW);
+    xTextRange->getText()->insertTextContent(xTextRange, xContent, false);
+    return uno::Reference<word::XInlineShape>(new SwVbaInlineShape(mxParent, mxContext, mxTextDocument, xShape));
+}
