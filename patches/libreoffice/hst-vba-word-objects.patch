+// points <-> 1/100 mm
+float lcl_toPoints(sal_Int32 n100thMM) { return static_cast<float>(n100thMM) * 72.0f / 2540.0f; }
+sal_Int32 lcl_to100thMM(float fPoints) { return static_cast<sal_Int32>(fPoints * 2540.0f / 72.0f + 0.5f); }
+
+std::vector<uno::Reference<beans::XPropertySet>>
+lcl_inlineGraphics(const rtl::Reference<SwXTextDocument>& xDoc)
+{
+    std::vector<uno::Reference<beans::XPropertySet>> aShapes;
+    uno::Reference<container::XIndexAccess> xGraphics(xDoc->getGraphicObjects(), uno::UNO_QUERY_THROW);
+    for (sal_Int32 i = 0; i < xGraphics->getCount(); ++i)
+    {
+        uno::Reference<beans::XPropertySet> xProps(xGraphics->getByIndex(i), uno::UNO_QUERY);
+        text::TextContentAnchorType eAnchor = text::TextContentAnchorType_AT_PARAGRAPH;
+        if (xProps.is() && (xProps->getPropertyValue(u"AnchorType"_ustr) >>= eAnchor)
+            && eAnchor == text::TextContentAnchorType_AS_CHARACTER)
+            aShapes.push_back(xProps);
+    }
+    return aShapes;
+}
+
+class InlineShapesIndexAccess : public ::cppu::WeakImplHelper<container::XIndexAccess>
+{
+    std::vector<uno::Reference<beans::XPropertySet>> maShapes;
+
+public:
+    explicit InlineShapesIndexAccess(std::vector<uno::Reference<beans::XPropertySet>>&& rShapes)
+        : maShapes(std::move(rShapes))
+    {
+    }
+    sal_Int32 SAL_CALL getCount() override { return static_cast<sal_Int32>(maShapes.size()); }
+    uno::Any SAL_CALL getByIndex(sal_Int32 nIndex) override
+    {
+        if (nIndex < 0 || nIndex >= getCount())
+            throw lang::IndexOutOfBoundsException();
+        return uno::Any(maShapes[nIndex]);
+    }
+    uno::Type SAL_CALL getElementType() override { return cppu::UnoType<beans::XPropertySet>::get(); }
+    sal_Bool SAL_CALL hasElements() override { return !maShapes.empty(); }
+};
+
+class InlineShapesEnumWrapper : public EnumerationHelper_BASE
+{
+    uno::Reference<XCollection> mxCollection;
+    sal_Int32 mnIndex = 0;
+
+public:
+    explicit InlineShapesEnumWrapper(uno::Reference<XCollection> xCollection)
+        : mxCollection(std::move(xCollection))
+    {
+    }
+    sal_Bool SAL_CALL hasMoreElements() override { return mnIndex < mxCollection->getCount(); }
+    uno::Any SAL_CALL nextElement() override
+    {
+        if (mnIndex < mxCollection->getCount())
+            return mxCollection->Item(uno::Any(++mnIndex), uno::Any());
+        throw container::NoSuchElementException();
+    }
+};
+}
