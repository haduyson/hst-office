+}
+
+void SAL_CALL SwVbaComment::setInitial(const OUString& rInitial)
+{
+    mxAnnotation->setPropertyValue(u"Initials"_ustr, uno::Any(rInitial));
+}
+
+void SAL_CALL SwVbaComment::Delete()
+{
+    uno::Reference<text::XTextContent> xContent(mxAnnotation, uno::UNO_QUERY_THROW);
+    xContent->getAnchor()->getText()->removeTextContent(xContent);
+}
