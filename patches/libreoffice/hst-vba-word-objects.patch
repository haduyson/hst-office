+std::vector<uno::Reference<beans::XPropertySet>> lcl_annotations(const rtl::Reference<SwXTextDocument>& xDoc)
+{
+    std::vector<uno::Reference<beans::XPropertySet>> aComments;
+    uno::Reference<container::XEnumerationAccess> xFields(xDoc->getTextFields());
+    uno::Reference<container::XEnumeration> xEnum = xFields->createEnumeration();
+    while (xEnum->hasMoreElements())
+    {
+        uno::Reference<lang::XServiceInfo> xInfo(xEnum->nextElement(), uno::UNO_QUERY);
+        if (xInfo.is() && xInfo->supportsService(u"com.sun.star.text.textfield.Annotation"_ustr))
+            aComments.emplace_back(xInfo, uno::UNO_QUERY_THROW);
+    }
+    return aComments;
+}
+
+class CommentsIndexAccess : public ::cppu::WeakImplHelper<container::XIndexAccess>
+{
+    std::vector<uno::Reference<beans::XPropertySet>> maComments;
+
+public:
+    explicit CommentsIndexAccess(std::vector<uno::Reference<beans::XPropertySet>>&& rComments)
+        : maComments(std::move(rComments))
+    {
+    }
+    sal_Int32 SAL_CALL getCount() override { return static_cast<sal_Int32>(maComments.size()); }
+    uno::Any SAL_CALL getByIndex(sal_Int32 nIndex) override
+    {
+        if (nIndex < 0 || nIndex >= getCount())
+            throw lang::IndexOutOfBoundsException();
+        return uno::Any(maComments[nIndex]);
+    }
+    uno::Type SAL_CALL getElementType() override { return cppu::UnoType<beans::XPropertySet>::get(); }
+    sal_Bool SAL_CALL hasElements() override { return !maComments.empty(); }
+};
+
+class CommentsEnumWrapper : public EnumerationHelper_BASE
+{
+    uno::Reference<XCollection> mxCollection;
+    sal_Int32 mnIndex = 0;
+
+public:
+    explicit CommentsEnumWrapper(uno::Reference<XCollection> xCollection)
+        : mxCollection(std::move(xCollection))
+    {
+    }
+    sal_Bool SAL_CALL hasMoreElements() override { return mnIndex < mxCollection->getCount(); }
+    uno::Any SAL_CALL nextElement() override
+    {
+        if (mnIndex < mxCollection->getCount())
+            return mxCollection->Item(uno::Any(++mnIndex), uno::Any());
+        throw container::NoSuchElementException();
+    }
+};
+}
