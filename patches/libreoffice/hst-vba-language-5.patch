Subject: [PATCH] VBA: Set evaluates its right side once, Type members Name and Parent, Err 9

The link for class events read the value before the assignment, which called
CreateObject a second time and left the variable empty. A Type can have members
called Name and Parent. A missing element thrown through invocation is Err 9.
---
--- a/basic/source/runtime/runtime.cxx
+++ b/basic/source/runtime/runtime.cxx
@@ -1936,29 +1936,6 @@
         }
         // Handle withevents
         bool bWithEvents = refVar->IsSet( SbxFlagBits::WithEvents );
-        // HST: for RaiseEvent: an object of a class module set to a variable whose module has handlers
-        if( bVBAEnabled )
-        {
-            if( SbxObject* pSource = dynamic_cast<SbClassModuleObject*>( refVal->GetObject() ) )
-            {
-                SbxObjectRef xOwner = refVar->GetParent();
-                const OUString aPrefix = refVar->GetName() + "_";
-                bool bHandlers = false;
-                if( SbModule* pOwner = dynamic_cast<SbModule*>( xOwner.get() ) )
-                {
-                    SbxArrayRef xMethods = pOwner->GetMethods();
-                    for( sal_uInt32 i = 0, nCount = xMethods->Count(); i < nCount && !bHandlers; ++i )
-                        bHandlers = xMethods->Get( i )->GetName().startsWithIgnoreAsciiCase( aPrefix );
-                }
-                if( bHandlers )
-                {
-                    auto& rLinks = GetSbData()->aClassEventLinks;
-                    const OUString aVarName = refVar->GetName();
-                    std::erase_if( rLinks, [&]( const auto& r ) { return std::get<1>( r ).get() == xOwner.get() && std::get<2>( r ) == aVarName; } );
-                    rLinks.emplace_back( pSource, xOwner, aVarName );
-                }
-            }
-        }
         if ( bWithEvents )
         {
             Reference< XInterface > xComListener;
@@ -1987,6 +1964,29 @@
         {
             *refVar = *refVal;
         }
+        // HST: for RaiseEvent: an object of a class module set to a variable whose module has handlers
+        if( bVBAEnabled && !dynamic_cast<SbProcedureProperty*>( refVar.get() ) )
+        {
+            if( SbxObject* pSource = dynamic_cast<SbClassModuleObject*>( refVar->GetObject() ) )
+            {
+                SbxObjectRef xOwner = refVar->GetParent();
+                const OUString aPrefix = refVar->GetName() + "_";
+                bool bHandlers = false;
+                if( SbModule* pOwner = dynamic_cast<SbModule*>( xOwner.get() ) )
+                {
+                    SbxArrayRef xMethods = pOwner->GetMethods();
+                    for( sal_uInt32 i = 0, nCount = xMethods->Count(); i < nCount && !bHandlers; ++i )
+                        bHandlers = xMethods->Get( i )->GetName().startsWithIgnoreAsciiCase( aPrefix );
+                }
+                if( bHandlers )
+                {
+                    auto& rLinks = GetSbData()->aClassEventLinks;
+                    const OUString aVarName = refVar->GetName();
+                    std::erase_if( rLinks, [&]( const auto& r ) { return std::get<1>( r ).get() == xOwner.get() && std::get<2>( r ) == aVarName; } );
+                    rLinks.emplace_back( pSource, xOwner, aVarName );
+                }
+            }
+        }
         if ( bDimAsNew )
         {
             if( dynamic_cast<const SbxObject*>( refVar.get() ) == nullptr )
