     </array>
 
-    <!-- HST Office: LSHandlerRank Default (not Owner) for the ODF/OpenOffice.org types, so installing HST
-         next to LibreOffice leaves LibreOffice the default for them until the user chooses otherwise. -->
     <key>CFBundleDocumentTypes</key>
     <array>
         <dict>
