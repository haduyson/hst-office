+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This file is part of the LibreOffice project.
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+// GROUPBY and PIVOTBY of the leading spreadsheet application, on the callable
+// machinery of LAMBDA: the function argument is a built-in function passed as a
+// value (SUM, AVERAGE, COUNTA, PERCENTOF, ARRAYTOTEXT...) or a LAMBDA. It gets the
+// values of one group as a one-column array; a function of two required
+// parameters (PERCENTOF, LAMBDA(x,y,...)) also gets the values it is relative to.
+//
+// field_headers: 0 none, 1 present and not shown, 2 none but generated, 3 present
+// and shown; omitted means present and shown when the first row of values is text
+// and the second holds a number. total_depth: 0 none, 1 grand total (default),
+// 2 grand total and subtotals, negative puts them above. sort_order: one or more
+// 1-based column indexes, negative for descending. field_relationship: 0 hierarchy
+// (default), 1 table (no subtotals).
+
+#include <interpre.hxx>
+
+#include <callable.hxx>
+#include <groupbyaxis.hxx>
+#include <global.hxx>
+#include <scmatrix.hxx>
+#include <unotools/collatorwrapper.hxx>
+
+#include <algorithm>
+#include <map>
+#include <vector>
+
+using namespace formula;
+
+namespace
+{
+// Ascending order of the reference application: numbers, text, logical
+// values, errors, then empty elements.
+int lcl_Rank(const ScMatrix& rMat, SCSIZE nC, SCSIZE nR)
+{
+    if (rMat.IsEmpty(nC, nR))
+        return 4;
+    if (rMat.IsBoolean(nC, nR))
+        return 2;
+    if (rMat.IsValue(nC, nR))
+        return rMat.GetError(nC, nR) != FormulaError::NONE ? 3 : 0;
+    return 1;
+}
+
+int lcl_Compare(const ScMatrix& rA, SCSIZE nAC, SCSIZE nAR, const ScMatrix& rB, SCSIZE nBC, SCSIZE nBR)
+{
+    int nRankA = lcl_Rank(rA, nAC, nAR), nRankB = lcl_Rank(rB, nBC, nBR);
+    if (nRankA != nRankB)
+        return nRankA < nRankB ? -1 : 1;
+    switch (nRankA)
+    {
+        case 0:
+        case 2:
+        {
+            double fA = rA.GetDouble(nAC, nAR), fB = rB.GetDouble(nBC, nBR);
+            return fA < fB ? -1 : (fA > fB ? 1 : 0);
+        }
+        case 1:
+            return ScGlobal::GetCollator().compareString(rA.GetString(nAC, nAR).getString(),
+                                                         rB.GetString(nBC, nBR).getString());
+        case 3:
+        {
+            int nA = static_cast<int>(rA.GetError(nAC, nAR)), nB = static_cast<int>(rB.GetError(nBC, nBR));
+            return nA < nB ? -1 : (nA > nB ? 1 : 0);
+        }
+        default:
+            return 0;
+    }
+}
+
+}
+
+int ScGroupByCompare(const ScMatrix& rA, SCSIZE nAC, SCSIZE nAR, const ScMatrix& rB, SCSIZE nBC, SCSIZE nBR)
+{
+    return lcl_Compare(rA, nAC, nAR, rB, nBC, nBR);
+}
+
+namespace
+{
+void lcl_CopyElement(const ScMatrix& rSrc, SCSIZE nSC, SCSIZE nSR, ScMatrix& rDst, SCSIZE nDC, SCSIZE nDR)
+{
+    if (rSrc.IsEmpty(nSC, nSR))
+        rDst.PutEmpty(nDC, nDR);
+    else if (rSrc.IsBoolean(nSC, nSR))
+        rDst.PutBoolean(rSrc.GetDouble(nSC, nSR) != 0.0, nDC, nDR);
+    else if (rSrc.IsValue(nSC, nSR))
+    {
+        FormulaError nErr = rSrc.GetError(nSC, nSR);
+        if (nErr != FormulaError::NONE)
+            rDst.PutError(nErr, nDC, nDR);
+        else
+            rDst.PutDouble(rSrc.GetDouble(nSC, nSR), nDC, nDR);
+    }
+    else
+        rDst.PutString(rSrc.GetString(nSC, nSR), nDC, nDR);
+}
+}
+
+ScGroupByAxis::ScGroupByAxis(const ScMatrixRef& pKeys)
+    : mpKeys(pKeys)
+{
+}
+
+std::vector<SCSIZE> ScGroupByAxis::GetParentRows(const ScGroupByEntry& rEntry,
+                                                 const std::vector<SCSIZE>& rAll) const
+{
+    if (rEntry.mnLevels <= 1)
+        return rAll;
+    std::vector<SCSIZE> aRows;
+    for (SCSIZE nRow : rAll)
+        if (SameKeys(nRow, rEntry.mnKeyRow, rEntry.mnLevels - 1))
+            aRows.push_back(nRow);
+    return aRows;
+}
+
+bool ScGroupByAxis::SameKeys(SCSIZE nRowA, SCSIZE nRowB, SCSIZE nLevels) const
+{
+    for (SCSIZE c = 0; c < nLevels; ++c)
+        if (lcl_Compare(*mpKeys, c, nRowA, *mpKeys, c, nRowB) != 0)
+            return false;
+    return true;
+}
+
+void ScGroupByAxis::Build(const std::vector<SCSIZE>& rRows, sal_Int32 nDepth, bool bTable,
+                          const std::vector<sal_Int32>& rSort, const ValueSortFn& rValueSort)
+{
+    SCSIZE nKeys, nR;
+    mpKeys->GetDimensions(nKeys, nR);
+    maEntries.clear();
+    const bool bSubtotals = !bTable && nKeys > 1 && (nDepth == 2 || nDepth == -2);
+    if (nDepth < 0)
+        maEntries.push_back({ rRows, 0, rRows.front() });
+    if (bTable)
+        AddLevel(rRows, nKeys, nKeys, rSort, rValueSort, false, nDepth);
+    else
+        AddLevel(rRows, 0, nKeys, rSort, rValueSort, bSubtotals, nDepth);
+    if (nDepth > 0)
+        maEntries.push_back({ rRows, 0, rRows.front() });
+}
+
+void ScGroupByAxis::AddLevel(const std::vector<SCSIZE>& rRows, SCSIZE nLevel, SCSIZE nKeys,
+                             const std::vector<sal_Int32>& rSort, const ValueSortFn& rValueSort,
+                             bool bSubtotals, sal_Int32 nDepth)
+{
+    // A table groups by every key at once (nLevel == nKeys), a hierarchy one
+    // level at a time; both keep the order of first occurrence until sorted.
+    const bool bTable = (nLevel == nKeys);
+    const SCSIZE nUpTo = bTable ? nKeys : nLevel + 1;
+    std::vector<std::vector<SCSIZE>> aGroups;
+    for (SCSIZE nRow : rRows)
+    {
+        auto it = std::find_if(aGroups.begin(), aGroups.end(), [&](const std::vector<SCSIZE>& rG) {
+            return bTable ? SameKeys(rG.front(), nRow, nKeys)
+                          : lcl_Compare(*mpKeys, nLevel, rG.front(), *mpKeys, nLevel, nRow) == 0;
+        });
+        if (it == aGroups.end())
+            aGroups.push_back({ nRow });
+        else
+            it->push_back(nRow);
+    }
+
+    // Sort keys relevant to this level: the key column itself (a table uses
+    // all of them) or a value column; nothing relevant means ascending keys.
+    std::vector<sal_Int32> aSort;
+    for (sal_Int32 n : rSort)
+    {
+        SCSIZE nAbs = static_cast<SCSIZE>(std::abs(n));
+        if (nAbs > nKeys || (bTable ? nAbs >= 1 : nAbs == nLevel + 1))
+            aSort.push_back(n);
+    }
+    if (aSort.empty())
+    {
+        if (bTable)
+            for (SCSIZE c = 1; c <= nKeys; ++c)
+                aSort.push_back(static_cast<sal_Int32>(c));
+        else
+            aSort.push_back(static_cast<sal_Int32>(nLevel + 1));
+    }
+    std::stable_sort(aGroups.begin(), aGroups.end(),
+                     [&](const std::vector<SCSIZE>& rA, const std::vector<SCSIZE>& rB) {
+                         for (sal_Int32 n : aSort)
+                         {
+                             SCSIZE nAbs = static_cast<SCSIZE>(std::abs(n));
+                             int nCmp = (nAbs <= nKeys)
+                                 ? lcl_Compare(*mpKeys, nAbs - 1, rA.front(), *mpKeys, nAbs - 1, rB.front())
+                                 : (rValueSort ? rValueSort(nAbs - nKeys - 1, rA, rB) : 0);
+                             if (nCmp != 0)
+                                 return n > 0 ? nCmp < 0 : nCmp > 0;
+                         }
+                         return false;
+                     });
+
+    for (const std::vector<SCSIZE>& rGroup : aGroups)
+    {
+        if (bTable || nLevel + 1 == nKeys)
+        {
+            maEntries.push_back({ rGroup, nKeys, rGroup.front() });
+            continue;
+        }
+        if (bSubtotals && nDepth < 0)
+            maEntries.push_back({ rGroup, nUpTo, rGroup.front() });
+        AddLevel(rGroup, nLevel + 1, nKeys, rSort, rValueSort, bSubtotals, nDepth);
+        if (bSubtotals && nDepth > 0)
+            maEntries.push_back({ rGroup, nUpTo, rGroup.front() });
+    }
+}
+
+void ScGroupByAxis::PutKeys(const ScGroupByEntry& rEntry, ScMatrix& rDst, SCSIZE nDstCol, SCSIZE nDstRow,
+                            bool bByRow, svl::SharedStringPool& rPool) const
+{
+    SCSIZE nKeys, nR;
+    mpKeys->GetDimensions(nKeys, nR);
+    for (SCSIZE k = 0; k < nKeys; ++k)
+    {
+        SCSIZE nC = bByRow ? nDstCol + k : nDstCol, nRw = bByRow ? nDstRow : nDstRow + k;
+        if (rEntry.mnLevels == 0)
+        {
+            if (k == 0)
+                rDst.PutString(rPool.intern(u"Total"_ustr), nC, nRw);
+            else
+                rDst.PutEmpty(nC, nRw);
+        }
+        else if (k < rEntry.mnLevels)
+            lcl_CopyElement(*mpKeys, k, rEntry.mnKeyRow, rDst, nC, nRw);
+        else
+            rDst.PutEmpty(nC, nRw);
+    }
+}
+
+bool ScInterpreter::GroupByCallableHasTwoArgs(const formula::FormulaCallableRef& pCallable)
+{
+    if (pCallable->GetOpCode() == ocPercentOf)
+        return true;
+    if (auto pFunction = dynamic_cast<const ScFormulaFunction*>(pCallable.get()))
+        return pFunction->GetNumRequiredParams() == 2;
+    return false;
+}
+
+void ScInterpreter::GroupByAggregate(const formula::FormulaCallableRef& pCallable, bool bTwoArgs,
+                                     const ScMatrixRef& pValues, SCSIZE nCol,
+                                     const std::vector<SCSIZE>& rRows, const std::vector<SCSIZE>& rAll,
+                                     const ScMatrixRef& pResult, SCSIZE nResCol, SCSIZE nResRow)
+{
+    auto makeArg = [&](const std::vector<SCSIZE>& rFrom) -> formula::FormulaConstTokenRef {
+        ScMatrixRef pArg = GetNewMat(1, rFrom.size(), /*bEmpty*/ true);
+        if (!pArg)
+            return nullptr;
+        for (SCSIZE i = 0; i < rFrom.size(); ++i)
+            lcl_CopyElement(*pValues, nCol, rFrom[i], *pArg, 0, i);
+        return new ScMatrixToken(pArg);
+    };
+    std::vector<formula::FormulaConstTokenRef> aArgs{ makeArg(rRows) };
+    if (bTwoArgs)
+        aArgs.push_back(makeArg(rAll));
+    if (std::any_of(aArgs.begin(), aArgs.end(), [](const auto& p) { return !p; }))
+    {
+        pResult->PutError(FormulaError::MatrixSize, nResCol, nResRow);
+        return;
+    }
+    ScCall(pCallable, aArgs);
+    PutMatrixValue(PopToken(), pResult, nResCol, nResRow);
+    // Keep a group's error in its own cell only.
+    nGlobalError = FormulaError::NONE;
+}
+
