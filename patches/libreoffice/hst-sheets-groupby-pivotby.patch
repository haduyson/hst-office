+/// Groups the rows of a key array (one column per field) into the ordered
+/// entries of GROUPBY's rows or of one PIVOTBY axis.
+class ScGroupByAxis
+{
+public:
+    /// Compares two groups by the aggregate of a value column.
+    using ValueSortFn
+        = std::function<int(SCSIZE nValueCol, const std::vector<SCSIZE>&, const std::vector<SCSIZE>&)>;
+
+    explicit ScGroupByAxis(const ScMatrixRef& pKeys);
+    void Build(const std::vector<SCSIZE>& rRows, sal_Int32 nDepth, bool bTable,
+               const std::vector<sal_Int32>& rSort, const ValueSortFn& rValueSort);
+    const std::vector<ScGroupByEntry>& GetEntries() const { return maEntries; }
+    /// Rows of rAll that share the first nLevels keys of rEntry (the parent group).
+    std::vector<SCSIZE> GetParentRows(const ScGroupByEntry& rEntry, const std::vector<SCSIZE>& rAll) const;
+    void PutKeys(const ScGroupByEntry& rEntry, ScMatrix& rDst, SCSIZE nDstCol, SCSIZE nDstRow, bool bByRow,
+                 svl::SharedStringPool& rPool) const;
+
+private:
+    bool SameKeys(SCSIZE nRowA, SCSIZE nRowB, SCSIZE nLevels) const;
+    void AddLevel(const std::vector<SCSIZE>& rRows, SCSIZE nLevel, SCSIZE nKeys,
+                  const std::vector<sal_Int32>& rSort, const ValueSortFn& rValueSort, bool bSubtotals,
+                  sal_Int32 nDepth);
+
+    ScMatrixRef mpKeys;
+    std::vector<ScGroupByEntry> maEntries;
+};
