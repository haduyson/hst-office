+
+// The GROUPBY and PIVOTBY entry points: arguments, header rows, output layout.
+// Grouping, sorting and the function calls are in interpr_groupby.cxx.
+
+#include <interpre.hxx>
+
+#include <groupbyaxis.hxx>
+#include <scmatrix.hxx>
+
+#include <algorithm>
+#include <cmath>
+#include <map>
+#include <tuple>
+#include <vector>
+
+using namespace formula;
+
+namespace
+{
+bool lcl_ValidDepth(sal_Int32 n) { return n >= -2 && n <= 2; }
+
+std::vector<SCSIZE> lcl_Intersect(const std::vector<SCSIZE>& rA, const std::vector<SCSIZE>& rB)
+{
+    std::vector<SCSIZE> aRes;
+    std::set_intersection(rA.begin(), rA.end(), rB.begin(), rB.end(), std::back_inserter(aRes));
+    return aRes;
+}
+}
+
+ScMatrixRef ScInterpreter::GetOptionalGroupByMatrix()
+{
+    if (IsMissing())
+    {
+        Pop();
+        return nullptr;
+    }
+    ScMatrixRef pMat = GetMatrix();
+    if (!pMat && nGlobalError == FormulaError::NONE)
+        SetError(FormulaError::NoValue);
+    return pMat;
+}
+
+bool ScInterpreter::GetGroupBySortOrder(std::vector<sal_Int32>& rSort)
+{
+    ScMatrixRef pMat = GetOptionalGroupByMatrix();
+    if (nGlobalError != FormulaError::NONE)
+        return false;
+    if (!pMat)
+        return true;
+    SCSIZE nC, nR;
+    pMat->GetDimensions(nC, nR);
+    for (SCSIZE r = 0; r < nR; ++r)
+        for (SCSIZE c = 0; c < nC; ++c)
+        {
+            if (!pMat->IsValue(c, r) || pMat->GetError(c, r) != FormulaError::NONE)
+                return false;
+            double f = std::trunc(pMat->GetDouble(c, r));
+            if (f == 0.0 || std::abs(f) > 1e6)
+                return false;
+            rSort.push_back(static_cast<sal_Int32>(f));
+        }
+    return true;
+}
+
+bool ScInterpreter::GetGroupByRows(const ScMatrixRef& pFilter, SCSIZE nRows, SCSIZE nFirst,
+                                   std::vector<SCSIZE>& rRows)
+{
+    if (pFilter)
+    {
+        SCSIZE nFC, nFR;
+        pFilter->GetDimensions(nFC, nFR);
+        if (nFC != 1 || nFR != nRows)
+            return false;
+    }
+    for (SCSIZE r = nFirst; r < nRows; ++r)
+    {
+        if (pFilter)
+        {
+            if (!pFilter->IsValue(0, r) || pFilter->GetError(0, r) != FormulaError::NONE)
+                return false;
+            if (pFilter->GetDouble(0, r) == 0.0)
+                continue;
+        }
+        rRows.push_back(r);
+    }
+    return true;
+}
+
+sal_Int32 ScInterpreter::GroupByHeaderMode(sal_Int32 nHeaders, const ScMatrixRef& pValues)
+{
+    if (nHeaders >= 0)
+        return nHeaders;
+    // Automatic: headers when the first row of values is text and the second
+    // holds a number.
+    SCSIZE nC, nR;
+    pValues->GetDimensions(nC, nR);
+    if (nR < 2)
+        return 0;
+    bool bText = true, bNumber = false;
+    for (SCSIZE c = 0; c < nC; ++c)
+    {
+        bText = bText && pValues->IsStringOrEmpty(c, 0) && !pValues->IsEmpty(c, 0);
+        bNumber = bNumber || (pValues->IsValue(c, 1) && !pValues->IsBoolean(c, 1));
+    }
+    return (bText && bNumber) ? 3 : 0;
+}
+
+void ScInterpreter::PutGroupByHeader(ScMatrix& rDst, SCSIZE nC, SCSIZE nR, bool bHasHeader,
+                                     const ScMatrixRef& pSrc, SCSIZE nSrcCol, const char* pGenerated,
+                                     SCSIZE nNumber)
+{
+    if (!bHasHeader)
+    {
+        rDst.PutString(mrStrPool.intern(OUString::createFromAscii(pGenerated) + OUString::number(nNumber)), nC, nR);
+        return;
+    }
+    if (pSrc->IsStringOrEmpty(nSrcCol, 0) && !pSrc->IsEmpty(nSrcCol, 0))
+        rDst.PutString(pSrc->GetString(nSrcCol, 0), nC, nR);
+    else if (pSrc->IsValue(nSrcCol, 0))
+        rDst.PutDouble(pSrc->GetDouble(nSrcCol, 0), nC, nR);
+    else
+        rDst.PutEmpty(nC, nR);
+}
+
+void ScInterpreter::ScGroupBy()
+{
+    sal_uInt8 nParamCount = GetByte();
+    if (!MustHaveParamCount(nParamCount, 3, 8))
+        return;
+    sal_Int32 nRelation = 0, nDepth = 1, nHeaders = -1;
+    ScMatrixRef pFilter;
+    std::vector<sal_Int32> aSort;
+    bool bSortOk = true;
+    if (nParamCount >= 8)
+        nRelation = GetInt32WithDefault(0);
+    if (nParamCount >= 7)
+        pFilter = GetOptionalGroupByMatrix();
+    if (nParamCount >= 6)
+        bSortOk = GetGroupBySortOrder(aSort);
+    if (nParamCount >= 5)
+        nDepth = GetInt32WithDefault(1);
+    if (nParamCount >= 4)
+        nHeaders = GetInt32WithDefault(-1);
+    formula::FormulaCallableRef pFunc = GetCallable();
+    ScMatrixRef pValues = GetMatrix();
+    ScMatrixRef pKeys = GetMatrix();
+    if (nGlobalError != FormulaError::NONE)
+    {
+        PushError(nGlobalError);
+        return;
+    }
+    SCSIZE nKC = 0, nKR = 0, nVC = 0, nVR = 0;
+    if (pKeys)
+        pKeys->GetDimensions(nKC, nKR);
+    if (pValues)
+        pValues->GetDimensions(nVC, nVR);
+    if (!pFunc || !pKeys || !pValues || !bSortOk || nKR != nVR || nKR == 0 || (nRelation != 0 && nRelation != 1)
+        || !lcl_ValidDepth(nDepth) || nHeaders < -1 || nHeaders > 3
+        || std::any_of(aSort.begin(), aSort.end(), [&](sal_Int32 n) { return std::abs(n) > sal_Int32(nKC + nVC); }))
+    {
+        PushError(FormulaError::NoValue);
+        return;
+    }
+    const sal_Int32 nMode = GroupByHeaderMode(nHeaders, pValues);
+    const bool bHasHeader = nMode == 1 || nMode == 3, bShowHeader = nMode == 2 || nMode == 3;
+    std::vector<SCSIZE> aRows;
+    if (!GetGroupByRows(pFilter, nKR, bHasHeader ? 1 : 0, aRows))
+    {
+        PushError(FormulaError::NoValue);
+        return;
+    }
+    if (aRows.empty())
+    {
+        PushError(FormulaError::NoValue);  // the reference application gives #CALC!
+        return;
+    }
+    const bool bTwoArgs = GroupByCallableHasTwoArgs(pFunc);
+
+    // Sorting by a value column compares the groups' aggregates.
+    std::map<std::tuple<SCSIZE, SCSIZE, SCSIZE>, ScMatrixRef> aCache;
+    auto aggregate = [&](SCSIZE nCol, const std::vector<SCSIZE>& rG) {
+        auto aKey = std::make_tuple(nCol, rG.front(), rG.size());
+        auto it = aCache.find(aKey);
+        if (it != aCache.end())
+            return it->second;
+        ScMatrixRef pOne = GetNewMat(1, 1, /*bEmpty*/ true);
+        GroupByAggregate(pFunc, bTwoArgs, pValues, nCol, rG, aRows, pOne, 0, 0);
+        aCache.emplace(aKey, pOne);
+        return pOne;
+    };
+    ScGroupByAxis::ValueSortFn aValueSort = [&](SCSIZE nCol, const std::vector<SCSIZE>& rA,
+                                                const std::vector<SCSIZE>& rB) {
+        ScMatrixRef pA = aggregate(nCol, rA), pB = aggregate(nCol, rB);
+        return ScGroupByCompare(*pA, 0, 0, *pB, 0, 0);
+    };
+    ScGroupByAxis aAxis(pKeys);
+    aAxis.Build(aRows, nDepth, nRelation == 1, aSort, aValueSort);
+    const auto& rEntries = aAxis.GetEntries();
+
+    const SCSIZE nTop = bShowHeader ? 1 : 0;
+    ScMatrixRef pRes = GetNewMat(nKC + nVC, nTop + rEntries.size(), /*bEmpty*/ true);
+    if (!pRes)
+    {
+        PushError(FormulaError::MatrixSize);
+        return;
+    }
+    if (bShowHeader)
+    {
+        for (SCSIZE k = 0; k < nKC; ++k)
+            PutGroupByHeader(*pRes, k, 0, bHasHeader, pKeys, k, "Row Field ", k + 1);
+        for (SCSIZE v = 0; v < nVC; ++v)
+            PutGroupByHeader(*pRes, nKC + v, 0, bHasHeader, pValues, v, "Value ", v + 1);
+    }
+    for (SCSIZE i = 0; i < rEntries.size(); ++i)
+    {
+        aAxis.PutKeys(rEntries[i], *pRes, 0, nTop + i, /*bByRow*/ true, mrStrPool);
+        for (SCSIZE v = 0; v < nVC; ++v)
+            GroupByAggregate(pFunc, bTwoArgs, pValues, v, rEntries[i].maRows, aRows, pRes, nKC + v, nTop + i);
+    }
+    PushMatrix(pRes);
+}
+
+void ScInterpreter::ScPivotBy()
+{
+    sal_uInt8 nParamCount = GetByte();
+    if (!MustHaveParamCount(nParamCount, 4, 11))
+        return;
+    sal_Int32 nRelative = 0, nColDepth = 1, nRowDepth = 1, nHeaders = -1;
+    ScMatrixRef pFilter;
+    std::vector<sal_Int32> aRowSort, aColSort;
+    bool bSortOk = true;
+    if (nParamCount >= 11)
+        nRelative = GetInt32WithDefault(0);
+    if (nParamCount >= 10)
+        pFilter = GetOptionalGroupByMatrix();
+    if (nParamCount >= 9)
+        bSortOk = GetGroupBySortOrder(aColSort);
+    if (nParamCount >= 8)
+        nColDepth = GetInt32WithDefault(1);
+    if (nParamCount >= 7)
+        bSortOk = GetGroupBySortOrder(aRowSort) && bSortOk;
+    if (nParamCount >= 6)
+        nRowDepth = GetInt32WithDefault(1);
+    if (nParamCount >= 5)
+        nHeaders = GetInt32WithDefault(-1);
+    formula::FormulaCallableRef pFunc = GetCallable();
+    ScMatrixRef pValues = GetMatrix();
+    ScMatrixRef pColKeys = GetMatrix();
+    ScMatrixRef pRowKeys = GetMatrix();
+    if (nGlobalError != FormulaError::NONE)
+    {
+        PushError(nGlobalError);
+        return;
+    }
+    SCSIZE nRC = 0, nRR = 0, nCC = 0, nCR = 0, nVC = 0, nVR = 0;
+    if (pRowKeys)
+        pRowKeys->GetDimensions(nRC, nRR);
+    if (pColKeys)
+        pColKeys->GetDimensions(nCC, nCR);
+    if (pValues)
+        pValues->GetDimensions(nVC, nVR);
+    auto badSort = [](const std::vector<sal_Int32>& r, SCSIZE nMax) {
+        return std::any_of(r.begin(), r.end(), [&](sal_Int32 n) { return std::abs(n) > sal_Int32(nMax); });
+    };
+    if (!pFunc || !pRowKeys || !pColKeys || !pValues || !bSortOk || nRR != nVR || nCR != nVR || nVR == 0
+        || !lcl_ValidDepth(nRowDepth) || !lcl_ValidDepth(nColDepth) || nHeaders < -1 || nHeaders > 3
+        || nRelative < 0 || nRelative > 4 || badSort(aRowSort, nRC) || badSort(aColSort, nCC))
+    {
+        PushError(FormulaError::NoValue);
+        return;
+    }
+    const sal_Int32 nMode = GroupByHeaderMode(nHeaders, pValues);
+    const bool bHasHeader = nMode == 1 || nMode == 3, bShowHeader = nMode == 2 || nMode == 3;
+    std::vector<SCSIZE> aRows;
+    if (!GetGroupByRows(pFilter, nVR, bHasHeader ? 1 : 0, aRows) || aRows.empty())
+    {
+        PushError(FormulaError::NoValue);
+        return;
+    }
+    const bool bTwoArgs = GroupByCallableHasTwoArgs(pFunc);
+    ScGroupByAxis aRowAxis(pRowKeys), aColAxis(pColKeys);
+    aRowAxis.Build(aRows, nRowDepth, false, aRowSort, nullptr);
+    aColAxis.Build(aRows, nColDepth, false, aColSort, nullptr);
+    const auto& rRowEntries = aRowAxis.GetEntries();
+    const auto& rColEntries = aColAxis.GetEntries();
+
+    // Column field rows on top, then a row of value names when there are
+    // several value columns or headers are shown.
+    const bool bNameRow = nVC > 1 || bShowHeader;
+    const SCSIZE nTop = nCC + (bNameRow ? 1 : 0);
+    ScMatrixRef pRes = GetNewMat(nRC + rColEntries.size() * nVC, nTop + rRowEntries.size(), /*bEmpty*/ true);
+    if (!pRes)
+    {
+        PushError(FormulaError::MatrixSize);
+        return;
+    }
+    for (SCSIZE c = 0; c < rColEntries.size(); ++c)
+    {
+        aColAxis.PutKeys(rColEntries[c], *pRes, nRC + c * nVC, 0, /*bByRow*/ false, mrStrPool);
+        for (SCSIZE v = 0; bNameRow && v < nVC; ++v)
+            PutGroupByHeader(*pRes, nRC + c * nVC + v, nCC, bHasHeader, pValues, v, "Value ", v + 1);
+    }
+    for (SCSIZE k = 0; bShowHeader && k < nRC; ++k)
+        PutGroupByHeader(*pRes, k, nTop - 1, bHasHeader, pRowKeys, k, "Row Field ", k + 1);
+
+    for (SCSIZE r = 0; r < rRowEntries.size(); ++r)
+    {
+        const ScGroupByEntry& rRowEntry = rRowEntries[r];
+        aRowAxis.PutKeys(rRowEntry, *pRes, 0, nTop + r, /*bByRow*/ true, mrStrPool);
+        for (SCSIZE c = 0; c < rColEntries.size(); ++c)
+        {
+            const ScGroupByEntry& rColEntry = rColEntries[c];
+            std::vector<SCSIZE> aCell = lcl_Intersect(rRowEntry.maRows, rColEntry.maRows);
+            if (aCell.empty())
+                continue;
+            std::vector<SCSIZE> aAll;
+            switch (nRelative)
+            {
+                case 0: aAll = rColEntry.maRows; break;
+                case 1: aAll = rRowEntry.maRows; break;
+                case 2: aAll = aRows; break;
+                case 3: aAll = lcl_Intersect(rRowEntry.maRows, aColAxis.GetParentRows(rColEntry, aRows)); break;
+                default: aAll = lcl_Intersect(aRowAxis.GetParentRows(rRowEntry, aRows), rColEntry.maRows); break;
+            }
+            for (SCSIZE v = 0; v < nVC; ++v)
+                GroupByAggregate(pFunc, bTwoArgs, pValues, v, aCell, aAll, pRes, nRC + c * nVC + v, nTop + r);
+        }
+    }
+    PushMatrix(pRes);
+}
