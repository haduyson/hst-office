+/// The slide shown in the main view (normal, notes or slide sorter); null for masters and other pages.
+SdPage* CurrentSlide(ViewShellBase& rBase)
+{
+    const std::shared_ptr<ViewShell> pMain = rBase.GetMainViewShell();
+    SdPage* pPage = pMain ? pMain->GetActualPage() : nullptr;
+    if (!pPage || pPage->GetPageKind() != PageKind::Standard || pPage->IsMasterPage())
+        return nullptr;
+    return pPage;
+}
+
+uno::Reference<drawing::XDrawPage> UnoPage(SdPage& rPage)
+{
+    return uno::Reference<drawing::XDrawPage>(rPage.getUnoPage(), uno::UNO_QUERY);
+}
+
+/// SlideTransitionPane's TransitionEffect::applyTo with nothing ambiguous: every setting of rFrom.
+void CopyTransition(const SdPage& rFrom, SdPage& rTo)
+{
+    rTo.setTransitionType(rFrom.getTransitionType());
+    rTo.setTransitionSubtype(rFrom.getTransitionSubtype());
+    rTo.setTransitionDirection(rFrom.getTransitionDirection());
+    rTo.setTransitionFadeColor(rFrom.getTransitionFadeColor());
+    rTo.setTransitionDuration(rFrom.getTransitionDuration());
+    rTo.SetTime(rFrom.GetTime());
+    rTo.SetPresChange(rFrom.GetPresChange());
+    rTo.SetStopSound(rFrom.IsStopSound());
+    rTo.SetSound(!rFrom.IsStopSound() && rFrom.IsSoundOn());
+    if (!rFrom.IsStopSound() && rFrom.GetSoundFile() != rTo.GetSoundFile())
+    {
+        rTo.SetSoundFile(rFrom.GetSoundFile());
+        rTo.SetSoundAllowed(true);
+    }
+    rTo.SetLoopSound(rFrom.IsLoopSound());
+}
+
+bool ApplyTransitionToAll(ViewShellBase& rBase)
+{
+    DrawDocShell* pDocSh = rBase.GetDocShell();
+    SdDrawDocument* pDoc = pDocSh ? pDocSh->GetDoc() : nullptr;
+    const SdPage* pFrom = CurrentSlide(rBase);
+    if (!pDoc || !pFrom || pDocSh->IsReadOnly())
+        return false;
+    const sal_uInt16 nCount = pDoc->GetSdPageCount(PageKind::Standard);
+    // one undo action for all the slides, as the Slide Transition deck records it
+    if (SfxUndoManager* pManager = pDocSh->GetUndoManager())
+    {
+        const OUString aComment(SdResId(STR_UNDO_SLIDE_PARAMS));
+        pManager->EnterListAction(aComment, aComment, 0, rBase.GetViewShellId());
+        auto pGroup = std::make_unique<SdUndoGroup>(*pDoc);
+        pGroup->SetComment(aComment);
+        for (sal_uInt16 i = 0; i < nCount; ++i)
+            if (SdPage* pPage = pDoc->GetSdPage(i, PageKind::Standard))
+                pGroup->AddAction(new UndoTransition(*pDoc, pPage));
+        pManager->AddUndoAction(std::move(pGroup));
+        pManager->LeaveListAction();
+    }
+    for (sal_uInt16 i = 0; i < nCount; ++i)
+        if (SdPage* pPage = pDoc->GetSdPage(i, PageKind::Standard); pPage && pPage != pFrom)
+            CopyTransition(*pFrom, *pPage);
+    pDocSh->SetModified();
+    return true;
+}
+
+/// The selected slides of the slide pane or sorter, else the current slide (as HstTransitionApply.cxx).
+std::vector<SdPage*> SelectedSlides(ViewShellBase& rBase)
+{
+    std::vector<SdPage*> aPages;
+    if (slidesorter::SlideSorterViewShell* pSorter = slidesorter::SlideSorterViewShell::GetSlideSorter(rBase))
+    {
+        if (const std::shared_ptr<slidesorter::SlideSorterViewShell::PageSelection> pSelection
+            = pSorter->GetPageSelection())
+            aPages.assign(pSelection->begin(), pSelection->end());
+    }
+    if (aPages.empty())
+        if (SdPage* pPage = CurrentSlide(rBase))
+            aPages.push_back(pPage);
+    std::erase_if(aPages, [](const SdPage* pPage) {
+        return !pPage || pPage->GetPageKind() != PageKind::Standard || pPage->IsMasterPage();
+    });
+    return aPages;
+}
+
+/// Duration (bAdvance false, nMs > 0) or automatic advance (bAdvance true, nMs < 0: on mouse click)
+/// of the selected slides, as one undo action.
+bool SetTiming(ViewShellBase& rBase, bool bAdvance, sal_Int32 nMs)
+{
+    DrawDocShell* pDocSh = rBase.GetDocShell();
+    SdDrawDocument* pDoc = pDocSh ? pDocSh->GetDoc() : nullptr;
+    const std::vector<SdPage*> aPages = SelectedSlides(rBase);
+    if (!pDoc || pDocSh->IsReadOnly() || aPages.empty() || (!bAdvance && nMs <= 0))
+        return false;
+    if (SfxUndoManager* pManager = pDocSh->GetUndoManager())
+    {
+        const OUString aComment(SdResId(STR_UNDO_SLIDE_PARAMS));
+        pManager->EnterListAction(aComment, aComment, 0, rBase.GetViewShellId());
+        auto pGroup = std::make_unique<SdUndoGroup>(*pDoc);
+        pGroup->SetComment(aComment);
+        for (SdPage* pPage : aPages)
+            pGroup->AddAction(new UndoTransition(*pDoc, pPage));
+        pManager->AddUndoAction(std::move(pGroup));
+        pManager->LeaveListAction();
+    }
+    for (SdPage* pPage : aPages)
+    {
+        if (!bAdvance)
+            pPage->setTransitionDuration(nMs / 1000.0);
+        else if (nMs < 0)
+            pPage->SetPresChange(PresChange::Manual);
+        else
+        {
+            pPage->SetPresChange(PresChange::Auto);
+            pPage->SetTime(nMs / 1000.0);
+        }
+    }
+    pDocSh->SetModified();
+    rBase.GetViewFrame().GetBindings().Invalidate(bAdvance ? SID_HST_TRANSITION_ADVANCE : SID_HST_TRANSITION_DURATION);
+    return true;
+}
+
+bool PreviewTransition(ViewShellBase& rBase)
+{
+    SdPage* pPage = CurrentSlide(rBase);
+    if (!pPage || pPage->getTransitionType() == 0)
+        return false;
+    return SlideShow::StartPreview(rBase, UnoPage(*pPage), uno::Reference<animations::XAnimationNode>());
+}
+
+/// CustomAnimationPane::onPreview with no effect selected: the slide's whole animation node.
+bool PreviewAnimation(ViewShellBase& rBase)
+{
+    SdPage* pPage = CurrentSlide(rBase);
+    if (!pPage || !pPage->hasAnimationNode())
+        return false;
+    uno::Reference<animations::XTimeContainer> xRoot
+        = animations::ParallelTimeContainer::create(comphelper::getProcessComponentContext());
+    uno::Reference<animations::XAnimationNode> xRootNode(xRoot, uno::UNO_QUERY_THROW);
+    xRootNode->setUserData({ { u"node-type"_ustr,
+                               uno::Any(presentation::EffectNodeType::TIMING_ROOT) } });
+    xRoot->appendChild(pPage->getAnimationNode());
+    return SlideShow::StartPreview(rBase, UnoPage(*pPage), xRootNode);
+}
+}
+
+void ExecuteSlideEffectCommand(ViewShellBase& rBase, SfxRequest& rRequest)
+{
+    bool bDone = false;
+    switch (rRequest.GetSlot())
+    {
+        case SID_HST_TRANSITION_APPLY_ALL:
+            bDone = ApplyTransitionToAll(rBase);
+            break;
+        case SID_HST_TRANSITION_PREVIEW:
+            bDone = !comphelper::LibreOfficeKit::isActive() && PreviewTransition(rBase);
+            break;
+        case SID_HST_ANIMATION_PREVIEW:
+            bDone = !comphelper::LibreOfficeKit::isActive() && PreviewAnimation(rBase);
+            break;
+        case SID_HST_TRANSITION_DURATION:
+        case SID_HST_TRANSITION_ADVANCE:
+        {
+            const SfxItemSet* pArgs = rRequest.GetArgs();
+            const SfxInt32Item* pMs = pArgs ? pArgs->GetItem<SfxInt32Item>(rRequest.GetSlot()) : nullptr;
+            bDone = pMs && SetTiming(rBase, rRequest.GetSlot() == SID_HST_TRANSITION_ADVANCE, pMs->GetValue());
+            break;
+        }
+        default:
+            break;
+    }
+    if (bDone)
+        rRequest.Done();
+    else
+        rRequest.Ignore();
+}
+
+void GetSlideEffectCommandState(ViewShellBase& rBase, SfxItemSet& rSet)
+{
+    const SdPage* pPage = CurrentSlide(rBase);
+    const DrawDocShell* pDocSh = rBase.GetDocShell();
+    const bool bLok = comphelper::LibreOfficeKit::isActive();
+    if (SfxItemState::DEFAULT == rSet.GetItemState(SID_HST_TRANSITION_APPLY_ALL)
+        && (!pPage || !pDocSh || pDocSh->IsReadOnly()))
+        rSet.DisableItem(SID_HST_TRANSITION_APPLY_ALL);
+    if (SfxItemState::DEFAULT == rSet.GetItemState(SID_HST_TRANSITION_PREVIEW)
+        && (bLok || !pPage || pPage->getTransitionType() == 0))
+        rSet.DisableItem(SID_HST_TRANSITION_PREVIEW);
+    if (SfxItemState::DEFAULT == rSet.GetItemState(SID_HST_ANIMATION_PREVIEW)
+        && (bLok || !pPage || !pPage->hasAnimationNode()))
+        rSet.DisableItem(SID_HST_ANIMATION_PREVIEW);
+    // the current slide's timing in milliseconds; the advance is -1 when the slide waits for a click
+    for (const sal_uInt16 nSlot : { SID_HST_TRANSITION_DURATION, SID_HST_TRANSITION_ADVANCE })
+    {
+        if (SfxItemState::DEFAULT != rSet.GetItemState(nSlot))
+            continue;
+        if (!pPage || !pDocSh || pDocSh->IsReadOnly())
+            rSet.DisableItem(nSlot);
+        else if (nSlot == SID_HST_TRANSITION_DURATION)
+            rSet.Put(SfxInt32Item(nSlot, static_cast<sal_Int32>(pPage->getTransitionDuration() * 1000.0 + 0.5)));
+        else
+            rSet.Put(SfxInt32Item(nSlot, pPage->GetPresChange() == PresChange::Auto
+                                             ? static_cast<sal_Int32>(pPage->GetTime() * 1000.0 + 0.5)
+                                             : -1));
+    }
+}
+}
