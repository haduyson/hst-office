+#pragma once
+
+class SfxItemSet;
+class SfxRequest;
+
+namespace sd
+{
+class ViewShellBase;
+}
+
+/** HST Office: the ribbon commands of the Slides Transitions and Animations tabs that the
+    sidebar decks offer as buttons:
+    - .uno:HstApplyTransitionToAll (SID_HST_TRANSITION_APPLY_ALL): the current slide's transition,
+      duration, advance and sound go to every slide, as the Slide Transition deck's "Apply
+      Transition to All Slides" does, as one undo action;
+    - .uno:HstPreviewTransition (SID_HST_TRANSITION_PREVIEW): plays the current slide's transition,
+      as the deck's "Play" button;
+    - .uno:HstPreviewAnimation (SID_HST_ANIMATION_PREVIEW): plays the current slide's animations,
+      as the Animation deck's "Play" button with nothing selected;
+    - .uno:HstSetTransitionDuration?Duration:long=<ms> (SID_HST_TRANSITION_DURATION) and
+      .uno:HstSetTransitionAdvance?Advance:long=<ms> (SID_HST_TRANSITION_ADVANCE, -1: on mouse click)
+      set the transition duration and the automatic advance of the selected slides (the current
+      slide in normal view), as one undo action each, as the deck's "Duration" and "Advance Slide"
+      controls do. Their state is the current slide's value (HstTransitionTimingControls.cxx). */
+namespace sd::hst
+{
+/// FuTemporary handler of the three slots.
+void ExecuteSlideEffectCommand(ViewShellBase& rBase, SfxRequest& rRequest);
+
+/// GetMenuState handler of the three slots: disabled without a slide, a read-only document
+/// (apply), without a transition or animation to play, or in LibreOfficeKit (preview).
+void GetSlideEffectCommandState(ViewShellBase& rBase, SfxItemSet& rSet);
+}
