+class HstTransitionAdvanceWindow final : public HstTimingWindow
+{
+public:
+    static constexpr OUString ImplementationName = u"com.sun.star.comp.sd.HstTransitionAdvanceControl"_ustr;
+
+    HstTransitionAdvanceWindow(vcl::Window* pParent, const uno::Reference<frame::XFrame>& rFrame)
+        : HstTimingWindow(pParent, u"modules/simpress/ui/hsttransitionadvance.ui"_ustr,
+                          u"TransitionAdvanceBox"_ustr, rFrame, u".uno:HstSetTransitionAdvance"_ustr,
+                          u"Advance"_ustr)
+        , m_xAuto(m_xBuilder->weld_check_button(u"auto"_ustr))
+        , m_xSeconds(m_xBuilder->weld_spin_button(u"seconds"_ustr))
+    {
+        InitControlBase(m_xAuto.get());
+        SetUpSeconds(*m_xSeconds, 0, 360000, 100); // up to an hour, steps of one second
+        SetMilliseconds(*m_xSeconds, 5000);
+        m_xAuto->connect_toggled(LINK(this, HstTransitionAdvanceWindow, ToggledHdl));
+        m_xSeconds->connect_value_changed(LINK(this, HstTransitionAdvanceWindow, ValueChangedHdl));
+        m_xSeconds->set_sensitive(false);
+        SetSizePixel(get_preferred_size());
+    }
+
+    ~HstTransitionAdvanceWindow() override { disposeOnce(); }
+
+    void dispose() override
+    {
+        m_xAuto.reset();
+        m_xSeconds.reset();
+        InterimItemWindow::dispose();
+    }
+
+    void SetState(sal_Int32 nMilliseconds) override
+    {
+        if (!m_xAuto || !m_xSeconds)
+            return;
+        m_bUpdating = true;
+        m_xAuto->set_active(nMilliseconds >= 0);
+        m_xSeconds->set_sensitive(nMilliseconds >= 0);
+        if (nMilliseconds >= 0 && nMilliseconds != Milliseconds(*m_xSeconds))
+            SetMilliseconds(*m_xSeconds, nMilliseconds);
+        m_bUpdating = false;
+    }
+
+private:
+    void Send()
+    {
+        m_xSeconds->set_sensitive(m_xAuto->get_active());
+        Dispatch(m_xAuto->get_active() ? Milliseconds(*m_xSeconds) : -1);
+    }
+
+    DECL_LINK(ToggledHdl, weld::Toggleable&, void);
+    DECL_LINK(ValueChangedHdl, weld::SpinButton&, void);
+
+    std::unique_ptr<weld::CheckButton> m_xAuto;
+    std::unique_ptr<weld::SpinButton> m_xSeconds;
+};
+
+IMPL_LINK_NOARG(HstTransitionAdvanceWindow, ToggledHdl, weld::Toggleable&, void) { Send(); }
+
+IMPL_LINK_NOARG(HstTransitionAdvanceWindow, ValueChangedHdl, weld::SpinButton&, void)
+{
+    if (m_xAuto->get_active())
+        Send();
+}
