+bool Enabled(DrawViewShell& rShell)
+{
+    DrawDocShell* pDocSh = rShell.GetDocSh();
+    return pDocSh && !pDocSh->IsReadOnly() && rShell.GetDoc()->GetDocumentType() == DocumentType::Draw
+           && rShell.GetPageKind() == PageKind::Standard && rShell.GetEditMode() == EditMode::Page;
+}
+
+/// The selected pages of the page pane, else the current page.
+std::vector<SdPage*> SelectedPages(DrawViewShell& rShell)
+{
+    std::vector<SdPage*> aPages;
+    if (slidesorter::SlideSorterViewShell* pSorter
+        = slidesorter::SlideSorterViewShell::GetSlideSorter(rShell.GetViewShellBase()))
+    {
+        if (const std::shared_ptr<slidesorter::SlideSorterViewShell::PageSelection> pSelection
+            = pSorter->GetPageSelection())
+            aPages.assign(pSelection->begin(), pSelection->end());
+    }
+    if (aPages.empty() && rShell.GetActualPage())
+        aPages.push_back(rShell.GetActualPage());
+    std::erase_if(aPages, [](const SdPage* pPage) {
+        return !pPage || pPage->GetPageKind() != PageKind::Standard || pPage->IsMasterPage();
+    });
+    return aPages;
+}
+
+/// Turns one page and its objects by 90° (bLeft: counter-clockwise), with undo actions in rUndo.
+void RotatePage(SdDrawDocument& rDoc, SdPage& rPage, bool bLeft, SfxUndoManager* pUndo)
+{
+    const Size aOld(rPage.GetSize());
+    const sal_Int32 nL = rPage.GetLeftBorder(), nR = rPage.GetRightBorder();
+    const sal_Int32 nT = rPage.GetUpperBorder(), nB = rPage.GetLowerBorder();
+    // SdrObject::Rotate about the page's top left corner (RotatePoint: 90° maps (x, y) to (y, -x),
+    // 270° to (-y, x)), then the move that brings the page back to the origin
+    const Degree100 nAngle(bLeft ? 9000 : 27000);
+    const double fSin = bLeft ? 1.0 : -1.0;
+    const Size aMove = bLeft ? Size(0, aOld.Width()) : Size(aOld.Height(), 0);
+    for (const rtl::Reference<SdrObject>& pObj : rPage)
+    {
+        if (!pObj)
+            continue;
+        if (pUndo)
+            pUndo->AddUndoAction(rDoc.GetSdrUndoFactory().CreateUndoGeoObject(*pObj));
+        pObj->Rotate(Point(0, 0), nAngle, fSin, 0.0);
+        pObj->Move(aMove);
+    }
+    const Size aNew(aOld.Height(), aOld.Width());
+    // the margins turn with the page
+    const sal_Int32 nNewL = bLeft ? nT : nB, nNewT = bLeft ? nR : nL;
+    const sal_Int32 nNewR = bLeft ? nB : nT, nNewB = bLeft ? nL : nR;
+    const Orientation eNew = aNew.Width() > aNew.Height() ? Orientation::Landscape : Orientation::Portrait;
+    if (pUndo)
+        pUndo->AddUndoAction(std::make_unique<SdPageFormatUndoAction>(
+            rDoc, &rPage, aOld, nL, nR, nT, nB, rPage.GetOrientation(), rPage.GetPaperBin(),
+            rPage.IsBackgroundFullSize(), aNew, nNewL, nNewR, nNewT, nNewB, false, eNew,
+            rPage.GetPaperBin(), rPage.IsBackgroundFullSize()));
+    rPage.SetSize(aNew);
+    rPage.SetBorder(nNewL, nNewT, nNewR, nNewB);
+    rPage.SetOrientation(eNew);
+}
+
+/// The view follows the current page's new size, as DrawViewShell::SwitchPage does for pages of
+/// different sizes.
+void UpdateView(DrawViewShell& rShell)
+{
+    SdPage* pPage = rShell.GetActualPage();
+    ::sd::View* pView = rShell.GetView();
+    if (!pPage || !pView)
+        return;
+    const Size aSize(pPage->GetSize());
+    const Point aPageOrg(aSize.Width(), aSize.Height() / 2);
+    const Size aViewSize(aSize.Width() * 3, aSize.Height() * 2);
+    rShell.GetDoc()->SetMaxObjSize(aViewSize);
+    rShell.InitWindows(aPageOrg, aViewSize, Point(-1, -1), true);
+    pView->SetWorkArea(::tools::Rectangle(Point() - aPageOrg, aViewSize));
+    rShell.UpdateScrollBars();
+    if (SdrPageView* pPageView = pView->GetSdrPageView())
+        pPageView->SetPageOrigin(Point(pPage->GetLeftBorder(), pPage->GetUpperBorder()));
+    SfxViewFrame* pFrame = rShell.GetViewFrame();
+    if (pFrame)
+    {
+        pFrame->GetBindings().Invalidate(SID_RULER_NULL_OFFSET);
+        pFrame->GetDispatcher()->Execute(SID_SIZE_PAGE, SfxCallMode::ASYNCHRON);
+    }
+}
+}
+
+void ExecuteRotatePage(DrawViewShell& rShell, SfxRequest& rRequest)
+{
+    const std::vector<SdPage*> aPages = Enabled(rShell) ? SelectedPages(rShell) : std::vector<SdPage*>();
+    if (aPages.empty())
+    {
+        rRequest.Ignore();
+        return;
+    }
+    if (rShell.GetView())
+        rShell.GetView()->SdrEndTextEdit();
+    const bool bLeft = rRequest.GetSlot() == SID_HST_ROTATE_PAGE_LEFT;
+    SdDrawDocument& rDoc = *rShell.GetDoc();
+    SfxUndoManager* pUndo = rShell.GetDocSh()->GetUndoManager();
+    const OUString aComment(SdResId(STR_UNDO_CHANGE_PAGEFORMAT));
+    if (pUndo)
+        pUndo->EnterListAction(aComment, aComment, 0, rShell.GetViewShellBase().GetViewShellId());
+    for (SdPage* pPage : aPages)
+        RotatePage(rDoc, *pPage, bLeft, pUndo);
+    if (pUndo)
+        pUndo->LeaveListAction();
+    rShell.GetDocSh()->SetModified();
+    UpdateView(rShell);
+    rRequest.Done();
+}
+
+void GetRotatePageState(DrawViewShell& rShell, SfxItemSet& rSet)
+{
+    if (Enabled(rShell))
+        return;
+    rSet.DisableItem(SID_HST_ROTATE_PAGE_LEFT);
+    rSet.DisableItem(SID_HST_ROTATE_PAGE_RIGHT);
+}
+}
