@@ -0,0 +1,269 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This file is part of the LibreOffice project.
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+// HST Office: the transition timing of the Slides ribbon (tab "Chuyển tiếp"), as Office's Timing group:
+// - "Thời lượng" (.uno:HstSetTransitionDuration?Duration:long=<ms>): a spin field in seconds;
+// - "Tự chuyển sau" (.uno:HstSetTransitionAdvance?Advance:long=<ms>, -1: on mouse click): a check box
+//   and a spin field in seconds.
+// Each change is one undoable command on the selected slides (HstSlideEffectCommands.cxx); the fields
+// show the current slide's values. The toolbox items of the two commands get these controls
+// (Controller.xcu), built as HstTransitionGallery.cxx builds the transitions gallery.
+
+#include <com/sun/star/frame/XFrame.hpp>
+#include <com/sun/star/lang/XServiceInfo.hpp>
+#include <comphelper/dispatchcommand.hxx>
+#include <comphelper/propertyvalue.hxx>
+#include <comphelper/unique_unlock.hxx>
+#include <cppuhelper/implbase.hxx>
+#include <cppuhelper/supportsservice.hxx>
+#include <svtools/toolboxcontroller.hxx>
+#include <toolkit/helper/vclunohelper.hxx>
+#include <vcl/InterimItemWindow.hxx>
+#include <vcl/svapp.hxx>
+#include <vcl/weld/Builder.hxx>
+#include <vcl/weld/CheckButton.hxx>
+#include <vcl/weld/SpinButton.hxx>
+
+#include <cmath>
+
+using namespace css;
+
+namespace
+{
+// the spin fields show seconds with two decimals: their integer value is in hundredths of a second
+sal_Int32 Milliseconds(const weld::SpinButton& rSeconds) { return static_cast<sal_Int32>(rSeconds.get_value() * 10); }
+
+void SetMilliseconds(weld::SpinButton& rSeconds, sal_Int32 nMilliseconds)
+{
+    rSeconds.set_value(std::lround(nMilliseconds / 10.0));
+}
+
+void SetUpSeconds(weld::SpinButton& rSeconds, sal_Int64 nMin, sal_Int64 nMax, sal_Int64 nStep)
+{
+    rSeconds.set_digits(2);
+    rSeconds.set_range(nMin, nMax);
+    rSeconds.set_increments(nStep, nStep * 4);
+}
+
+/// The item window of one timing command: dispatches the command with its milliseconds argument.
+class HstTimingWindow : public InterimItemWindow
+{
+public:
+    HstTimingWindow(vcl::Window* pParent, const OUString& rUIXMLDescription, const OUString& rID,
+                    uno::Reference<frame::XFrame> xFrame, OUString aCommand, OUString aArgument)
+        : InterimItemWindow(pParent, rUIXMLDescription, rID, true)
+        , m_xFrame(std::move(xFrame))
+        , m_aCommand(std::move(aCommand))
+        , m_aArgument(std::move(aArgument))
+    {
+    }
+
+    /// The current slide's value from the command state (milliseconds; -1 for "on mouse click").
+    virtual void SetState(sal_Int32 nMilliseconds) = 0;
+
+protected:
+    void Dispatch(sal_Int32 nMilliseconds)
+    {
+        if (!m_bUpdating && m_xFrame.is())
+            comphelper::dispatchCommand(m_aCommand, m_xFrame,
+                                        { comphelper::makePropertyValue(m_aArgument, nMilliseconds) });
+    }
+
+    uno::Reference<frame::XFrame> m_xFrame;
+    OUString m_aCommand;
+    OUString m_aArgument;
+    bool m_bUpdating = false;
+};
+
+class HstTransitionDurationWindow final : public HstTimingWindow
+{
+public:
+    static constexpr OUString ImplementationName = u"com.sun.star.comp.sd.HstTransitionDurationControl"_ustr;
+
+    HstTransitionDurationWindow(vcl::Window* pParent, const uno::Reference<frame::XFrame>& rFrame)
+        : HstTimingWindow(pParent, u"modules/simpress/ui/hsttransitionduration.ui"_ustr,
+                          u"TransitionDurationBox"_ustr, rFrame, u".uno:HstSetTransitionDuration"_ustr,
+                          u"Duration"_ustr)
+        , m_xDuration(m_xBuilder->weld_spin_button(u"duration"_ustr))
+    {
+        InitControlBase(m_xDuration.get());
+        SetUpSeconds(*m_xDuration, 1, 6000, 25); // 0.01 to 60 seconds, steps of 0.25
+        SetMilliseconds(*m_xDuration, 2000);
+        m_xDuration->connect_value_changed(LINK(this, HstTransitionDurationWindow, ValueChangedHdl));
+        SetSizePixel(get_preferred_size());
+    }
+
+    ~HstTransitionDurationWindow() override { disposeOnce(); }
+
+    void dispose() override
+    {
+        m_xDuration.reset();
+        InterimItemWindow::dispose();
+    }
+
+    void SetState(sal_Int32 nMilliseconds) override
+    {
+        if (!m_xDuration || nMilliseconds <= 0 || nMilliseconds == Milliseconds(*m_xDuration))
+            return;
+        m_bUpdating = true;
+        SetMilliseconds(*m_xDuration, nMilliseconds);
+        m_bUpdating = false;
+    }
+
+private:
+    DECL_LINK(ValueChangedHdl, weld::SpinButton&, void);
+
+    std::unique_ptr<weld::SpinButton> m_xDuration;
+};
+
+IMPL_LINK(HstTransitionDurationWindow, ValueChangedHdl, weld::SpinButton&, rSpin, void)
+{
+    if (Milliseconds(rSpin) > 0)
+        Dispatch(Milliseconds(rSpin));
+}
