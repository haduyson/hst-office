+/// Module of a notebookbar .ui path ("modules/swriter/ui/notebookbar.ui" -> "swriter"), or empty.
+inline std::string_view moduleOf(std::string_view path)
+{
+    for (std::string_view module : { "swriter", "scalc", "simpress", "sdraw" })
+    {
+        const size_t pos = path.find(module);
+        if (pos != std::string_view::npos && pos > 0 && path[pos - 1] == '/'
+            && pos + module.size() < path.size() && path[pos + module.size()] == '/')
+            return module;
+    }
+    return {};
+}
+
+/// Preferred tip of a command or menu button on a tab: the familiar suite's letters there, marked with '!' so that
+/// prioritise() lets them win, else the general table, else empty (a free letter).
+inline std::string preferred(std::string_view module, std::string_view tab, std::string_view id)
+{
+    std::string key;
+    key.append(module).append("/").append(tab).append("/").append(id);
+    const std::string_view office = lookup(std::begin(OFFICE_KEYS), std::end(OFFICE_KEYS), key);
+    if (!office.empty())
+        return "!" + std::string(office);
+    return std::string(lookup(std::begin(COMMAND_KEYS), std::end(COMMAND_KEYS), id));
+}
+
+/// The tips for assign(): the '!' marks are dropped, and a general tip that clashes (prefix) with a marked one on the
+/// same level is cleared, so that the familiar letters win and that command gets a free letter.
+inline std::vector<std::string> prioritise(const std::vector<std::string>& preferred)
+{
+    std::vector<std::string> marked;
+    for (const std::string& tip : preferred)
+        if (tip.starts_with('!'))
+            marked.push_back(tip.substr(1));
+    std::vector<std::string> result;
+    result.reserve(preferred.size());
+    for (const std::string& tip : preferred)
+    {
+        if (tip.starts_with('!'))
+            result.push_back(tip.substr(1));
+        else if (std::any_of(marked.begin(), marked.end(), [&tip](const std::string& other) {
+                     return !tip.empty() && (other.starts_with(tip) || tip.starts_with(other));
+                 }))
+            result.emplace_back();
+        else
+            result.push_back(tip);
+    }
+    return result;
+}
+}
