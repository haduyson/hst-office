{
  "name": "hst-office",
  "version": "0.1.0",
  "private": true,
  "description": "HST Office — Vietnamese plugins and templates for ONLYOFFICE Desktop Editors (plugin-first)",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "esbuild": "0.25.9",
    "eslint": "9.35.0",
    "globals": "16.4.0"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "node --test 'tests/unit/*.test.js'",
    "test:python": "for f in tests/brand/test-*.py; do .venv/bin/python \"$f\" || exit 1; done",
    "check:lines": "node scripts/check-source-lines.js",
    "check:notices": "node scripts/check-notices.js dist/plugins",
    "check:offline": "node scripts/check-offline-assets.js dist/plugins",
    "check:docs": "python3 scripts/check-doc-links.py",
    "build:plugins": "node scripts/build-plugins.js",
    "check:plugins": "node scripts/check-plugins.js dist/plugins",
    "qa:runtime": "scripts/runtime/run-offline.sh node scripts/runtime/qa-admin-documents.js"
  }
}
