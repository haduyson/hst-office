{
  "schemaVersion": 1,
  "note": "LibreOffice number format codes for locale vi-VN (language tag vi-VN). Underlying cell values never change; only display format. Verify rendering in runtime QA.",
  "locale": "vi-VN",
  "formats": {
    "date": { "code": "DD/MM/YYYY", "example": "05/02/2026" },
    "vnd": { "code": "#,##0 [$₫-42A]", "example": "1.234.567 ₫", "decimals": 0 },
    "percent": { "code": "0.00%", "example": "12,50%" },
    "integer": { "code": "#,##0", "example": "1.234.567" }
  },
  "csv": {
    "defaultEncoding": "UTF-8",
    "acceptBom": true,
    "delimiters": [",", ";", "\t"],
    "defaultColumnType": "text",
    "formulaLikePrefixes": ["=", "+", "-", "@"],
    "limits": { "maxBytes": 10485760, "maxRows": 50000, "maxColumns": 200 }
  }
}
