{
  "schemaVersion": 1,
  "note": "LibreOffice number format codes written in en-US syntax ('.' decimal, ',' grouping). Register them for vi-VN with XNumberFormats.addNewConverted(code, Locale('en','US',''), Locale('vi','VN','')); registering them verbatim for vi-VN misreads the separators. Underlying cell values never change.",
  "locale": "vi-VN",
  "formats": {
    "date": {
      "code": "DD/MM/YYYY",
      "example": "05/02/2026"
    },
    "vnd": {
      "code": "#,##0 [$₫-42A]",
      "example": "1.234.567 ₫",
      "decimals": 0
    },
    "percent": {
      "code": "0.00%",
      "example": "12,50%"
    },
    "integer": {
      "code": "#,##0",
      "example": "1.234.567"
    }
  },
  "csv": {
    "defaultEncoding": "UTF-8",
    "acceptBom": true,
    "delimiters": [
      ",",
      ";",
      "\t"
    ],
    "defaultColumnType": "text",
    "formulaLikePrefixes": [
      "=",
      "+",
      "-",
      "@"
    ],
    "limits": {
      "maxBytes": 10485760,
      "maxRows": 50000,
      "maxColumns": 200
    }
  }
}
