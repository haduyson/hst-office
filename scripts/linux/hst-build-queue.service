# Dispatcher of the local build queue (scripts/build-queue.sh dispatch). Install:
#   sudo install -m 644 scripts/linux/hst-build-queue.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now hst-build-queue
# It runs from the deployed version /data/hst-build/infra-current (symlink to infra-<sha>), never from a development
# worktree. Deploy/update (atomic switch, dispatcher restart, running builds untouched):
#   sudo scripts/linux/build-infra-deploy.sh <commit|branch>
[Unit]
Description=HST Office local build queue dispatcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/data/hst-build
ExecStart=/usr/bin/python3 -I /data/hst-build/infra-current/scripts/build-queue.py dispatch
Environment=HST_QUEUE_ROOT=/data/hst-build-queue HST_BUILD_ROOT=/data/hst-build
Restart=on-failure
RestartSec=30
KillMode=process
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
