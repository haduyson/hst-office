{
  "schemaVersion": 1,
  "id": "thong-ke",
  "module": "sheets",
  "license": "CC-BY-4.0",
  "sheetName": "Thống kê",
  "title": "THỐNG KÊ",
  "period": "[Kỳ báo cáo / tuần / tháng / năm]",
  "guidance": "Kế hoạch bằng 0 cho tỷ lệ bằng 0; cần diễn giải riêng các chỉ tiêu không có kế hoạch. Ô xanh nhạt có công thức; sao chép công thức khi thêm dòng. Có thể bật bảo vệ trang tính sau khi rà soát.",
  "columns": [
    {
      "title": "Chỉ tiêu",
      "type": "text",
      "placeholder": "[Chỉ tiêu]"
    },
    {
      "title": "Kế hoạch",
      "type": "integer"
    },
    {
      "title": "Thực hiện",
      "type": "integer"
    },
    {
      "title": "Hoàn thành",
      "type": "percent",
      "formula": "IF([.B{row}]>0;[.C{row}]/[.B{row}];0)"
    },
    {
      "title": "Chênh lệch",
      "type": "integer",
      "formula": "[.C{row}]-[.B{row}]"
    }
  ],
  "rows": 5,
  "totals": {
    "B": "SUM([.B5:.B9])",
    "C": "SUM([.C5:.C9])",
    "D": "IF([.B10]>0;[.C10]/[.B10];0)",
    "E": "[.C10]-[.B10]"
  }
}
