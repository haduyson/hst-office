  "sheetName": "Danh sách",
  "title": "DANH SÁCH",
  "period": "[Kỳ báo cáo / tuần / tháng / năm]",
  "guidance": "Mã lưu dạng văn bản để giữ số 0 đầu; tổng đếm những tên đã được thay khỏi placeholder. Ô xanh nhạt có công thức; sao chép công thức khi thêm dòng. Có thể bật bảo vệ trang tính sau khi rà soát.",
  "columns": [
    {
      "title": "Mã",
      "type": "text",
      "placeholder": "[Mã dạng văn bản]"
    },
    {
      "title": "Họ và tên",
      "type": "text",
      "placeholder": "[Họ và tên]"
    },
    {
      "title": "Ngày",
      "type": "date"
    },
    {
      "title": "Đơn vị",
      "type": "text",
      "placeholder": "[Đơn vị]"
    },
    {
      "title": "Ghi chú",
      "type": "text",
      "placeholder": "[Ghi chú]"
    },
    {
      "title": "Đã điền tên",
      "type": "integer",
      "formula": "IF([.B{row}]=\"[Họ và tên]\";0;IF([.B{row}]=\"\";0;1))"
    }
  ],
  "rows": 5,
  "totals": {
    "F": "SUM([.F5:.F9])"
  }
}
