{
  "schemaVersion": 1,
  "id": "du-toan",
  "module": "sheets",
  "license": "CC-BY-4.0",
  "sheetName": "Dự toán",
  "title": "DỰ TOÁN",
  "period": "[Kỳ báo cáo / tuần / tháng / năm]",
  "guidance": "Tự nhập đơn giá và tỷ lệ dự phòng; không bao gồm giả định thuế hoặc định mức pháp lý. Ô xanh nhạt có công thức; sao chép công thức khi thêm dòng. Có thể bật bảo vệ trang tính sau khi rà soát.",
  "columns": [
    {
      "title": "Hạng mục",
      "type": "text",
      "placeholder": "[Hạng mục]"
    },
    {
      "title": "Đơn vị",
      "type": "text",
      "placeholder": "[Đơn vị tính]"
    },
    {
      "title": "Số lượng",
      "type": "integer"
    },
    {
      "title": "Đơn giá",
      "type": "vnd"
    },
    {
      "title": "Dự phòng",
      "type": "percent"
    },
    {
      "title": "Thành tiền",
      "type": "vnd",
      "formula": "[.C{row}]*[.D{row}]"
    },
    {
      "title": "Tiền dự phòng",
      "type": "vnd",
      "formula": "[.F{row}]*[.E{row}]"
    },
    {
      "title": "Tổng",
      "type": "vnd",
      "formula": "SUM([.F{row}:.G{row}])"
    }
  ],
  "rows": 5,
  "totals": {
    "F": "SUM([.F5:.F9])",
    "G": "SUM([.G5:.G9])",
    "H": "SUM([.H5:.H9])"
  }
}
