# Exec= lines use the placeholder launcher `hst-office` (packaging finalizes the real entry point; see docs/BRAND.md).
[Desktop Entry]
Version=1.0
Type=Application
Name=HST Office
Name[vi]=HST Office
GenericName=Office Suite
GenericName[vi]=Bộ ứng dụng văn phòng
Comment=Create and edit documents, spreadsheets and presentations.
Comment[vi]=Soạn thảo văn bản, bảng tính và trình chiếu.
Icon=hst-office
Exec=hst-office %U
Terminal=false
StartupNotify=true
Categories=Office;
Keywords=office;document;spreadsheet;presentation;HST;
Keywords[vi]=văn phòng;văn bản;bảng tính;trình chiếu;HST;

Actions=Writer;Sheets;Slides;

[Desktop Action Writer]
Name=HST Writer
Name[vi]=HST Writer
Exec=hst-office --writer

[Desktop Action Sheets]
Name=HST Sheets
Name[vi]=HST Sheets
Exec=hst-office --calc

[Desktop Action Slides]
Name=HST Slides
Name[vi]=HST Slides
Exec=hst-office --impress
